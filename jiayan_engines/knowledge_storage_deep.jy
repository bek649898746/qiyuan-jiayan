#include <stdio.h>

整 主(空) {
    输出(";========================================\n");
    输出(";  Storage Class Deep Penetration\n");
    输出(";  已吸收 31_存储类深度穿透研究.md\n");
    输出(";  1830行完整吸收\n");
    输出(";========================================\n\n");
    
    输出("┌─ 存储类本质─────────────────────\n");
    输出("│存储类 = (位置, 生命周期, 可见性) 三元组\n");
    输出("│L∈{Reg/Cache/RAM/SSD/HDD/Remote}\n");
    输出("│T∈{Expr/Block/Func/Thread/Prog}\n");
    输出("│V∈{Block/File/Class/Glob/XProc}\n");
    输出("│auto=(RAM,Func,Block) | static=(RAM,Prog,File)\n");
    输出("│extern=(RAM,Prog,Global)\n\n");
    
    输出("┌─ 存储层次 ───────────────────────\n");
    输出("│单调性 层级↑容量↓延迟↓成本↑\n");
    输出("│Reg:1KB/0.3ns L1:64K/1ns L2:512K/4ns\n");
    输出("│L3:8M/15ns RAM:64G/100ns SSD:2T/10us\n");
    输出("│局部性 时间(重复访问) 空间(连续访问)\n");
    输出("│缓存效果: 前层缓存→搜索I/O减至1次\n\n");
    
    输出("┌─ MESI协议 ───────────────────────\n");
    输出("│M(改)/E(独)/S(共)/I(失)\n");
    输出("│PrRd/PrWr/BusRd/BusRdX/BusUpgr\n");
    输出("│M+BusRd→S(Flush) M+BusRdX→I(Flush)\n");
    输出("│E+PrWr→M E+BusRd→S E+BusRdX→I\n");
    输出("│I+PrRd→E(无共享)或S(有共享)\n\n");
    
    输出("┌─ B+Tree磁盘引擎 ─────────────────\n");
    输出("│每个节点1页(4KB) 内部:order×(key+ptr)≤页\n");
    输出("│搜索:树高次I/O 插入:树高+1次I/O\n");
    输出("│100万条→树高≈4 搜索I/O≤3-5次\n");
    输出("│LSM:写优化(顺序追加) vs BTree:读优化\n");
    输出("│写密集用LSM 读密集用BTree\n\n");
    
    输出("┌─ Bloom Filter ───────────────────\n");
    输出("│最优位大小:m=-n·ln(p)/(ln2)²\n");
    输出("│最优哈希:k=(m/n)·ln2\n");
    输出("│误判率:(1-e^{-kn/m})^k\n");
    输出("│作用:提前过滤不存在键→减少无效IO\n\n");
    
    输出("┌─ 一人公司应用───────────────────\n");
    输出("│SQLite=BTree引擎 | LevelDB/RocksDB=LSM\n");
    输出("│理解存储层级=优化数据库查询性能\n");
    输出("│缓存效果=好的查询缓存命中率95%%\n");
    输出("│知识库 storage_deep | 完整文件吸收\n");
    返 0;
}
