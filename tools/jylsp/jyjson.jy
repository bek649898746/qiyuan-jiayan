/*
 * jyjson.jy — 甲言 JSON 库 v1.0
 * 立单：启元 · 2026-10-14 · 用于 LSP 协议（解析请求 / 生成响应）
 * 纪律：不动编译器（qcc_zh.jy 一行未碰）· 纯甲言 · 零外部依赖
 * 用法：#include "jyjson.jy"  ⟹  JSON重置() / JSON解析(文) / JSON取(对,键) / JSON串(节) 等
 */
#define 节容 30000
#define 串容 262144

/* 节点类 */
#define 类空 0
#define 类真 1
#define 类假 2
#define 类数 3
#define 类串 4
#define 类组 5
#define 类对 6

typedef 构 {
    整 节类;
    整 首子;
    整 后弟;
    整 键起;
    整 键长;
    整 值起;
    整 值长;
    双 数值;
} 节型;

静 节型 节[节容];
静 字 串池[串容];
静 整 节数;
静 整 串用;
静 常 字 *解源;
静 字 暂存一[65536];
静 整 解位;
静 整 解错;

/* ============ 基础 ============ */
静 空 JSON重置() { 节数 = 0; 串用 = 0; 解位 = 0; 解错 = 0; }

静 整 新节() {
    整 i;
    若 (节数 >= 节容) { 解错 = 1; 返 -1; }
    i = 节数; 节数++;
    节[i].节类 = 类空; 节[i].首子 = -1; 节[i].后弟 = -1;
    节[i].键起 = 0; 节[i].键长 = 0; 节[i].值起 = 0; 节[i].值长 = 0; 节[i].数值 = 0.0;
    返 i;
}

静 整 存串(常 字 *s, 整 n) {
    整 起;
    若 (串用 + n + 1 > 串容) { 解错 = 1; 返 -1; }
    起 = 串用;
    遍 (整 i = 0; i < n; i++) { 串池[串用] = s[i]; 串用++; }
    串池[串用] = 0; 串用++;
    返 起;
}

静 空 跳白() {
    循环 (解源[解位] == 32 || 解源[解位] == 9 || 解源[解位] == 10 || 解源[解位] == 13) 解位++;
}

/* ============ 字符串（含转义）============ */
静 整 解串(字 *出, 整 出容) {
    整 n = 0;
    若 (解源[解位] != 34) { 解错 = 1; 出[0] = 0; 返 0; }
    解位++;
    循环 (解源[解位] != 0 && 解源[解位] != 34) {
        字 c = 解源[解位];
        若 (c == 92) {
            解位++;
            字 e = 解源[解位];
            若 (e == 110) c = 10;
            否 若 (e == 116) c = 9;
            否 若 (e == 114) c = 13;
            否 若 (e == 98) c = 8;
            否 若 (e == 102) c = 12;
            否 若 (e == 47) c = 47;
            否 若 (e == 34) c = 34;
            否 若 (e == 92) c = 92;
            否 若 (e == 117) {
                /* \uXXXX：BMP → UTF-8 */
                整 cp = 0; 整 k = 0;
                循环 (k < 4) {
                    解位++;
                    c = 解源[解位];
                    整 d = 0;
                    若 (c >= 48 && c <= 57) d = c - 48;
                    否 若 (c >= 97 && c <= 102) d = c - 97 + 10;
                    否 若 (c >= 65 && c <= 70) d = c - 65 + 10;
                    cp = cp * 16 + d;
                    k++;
                }
                若 (cp < 128) { 若 (n < 出容 - 1) 出[n] = (字)cp; 若 (n < 出容 - 1) n++; }
                否 若 (cp < 2048) {
                    若 (n < 出容 - 2) { 出[n] = (字)(192 + (cp >> 6)); n++; 出[n] = (字)(128 + (cp & 63)); n++; }
                }
                否 {
                    若 (n < 出容 - 3) {
                        出[n] = (字)(224 + (cp >> 12)); n++;
                        出[n] = (字)(128 + ((cp >> 6) & 63)); n++;
                        出[n] = (字)(128 + (cp & 63)); n++;
                    }
                }
                解位++;
                续;
            }
            否 { 解位--; }
            若 (n < 出容 - 1) { 出[n] = c; n++; }
            解位++;
            续;
        }
        若 (n < 出容 - 1) { 出[n] = c; n++; }
        解位++;
    }
    若 (解源[解位] != 34) { 解错 = 1; }
    解位++;
    出[n] = 0;
    返 n;
}

/* ============ 值 ============ */
静 整 解深 = 0;
静 整 解值();

静 整 解组() {
    整 r = 新节();
    整 尾 = -1;
    若 (r < 0) 返 -1;
    节[r].节类 = 类组;
    解位++;  /* [ */
    跳白();
    若 (解源[解位] == 93) { 解位++; 返 r; }
    循环 (1) {
        跳白();
        整 v = 解值();
        若 (v < 0) 返 r;
        若 (尾 < 0) 节[r].首子 = v; 否 节[尾].后弟 = v;
        尾 = v;
        跳白();
        若 (解源[解位] == 44) { 解位++; 续; }
        若 (解源[解位] == 93) { 解位++; 断; }
        解错 = 1; 断;
    }
    返 r;
}

静 整 解对() {
    整 r = 新节();
    整 尾 = -1;
    若 (r < 0) 返 -1;
    节[r].节类 = 类对;
    解位++;  /* { */
    跳白();
    若 (解源[解位] == 125) { 解位++; 返 r; }
    循环 (1) {
        字 键[512];
        整 kl;
        跳白();
        若 (解源[解位] != 34) { 解错 = 1; 返 r; }
        kl = 解串(键, 512);
        跳白();
        若 (解源[解位] != 58) { 解错 = 1; 返 r; }
        解位++;
        跳白();
        整 v = 解值();
        若 (v < 0) 返 r;
        节[v].键起 = 存串(键, kl);
        节[v].键长 = kl;
        若 (尾 < 0) 节[r].首子 = v; 否 节[尾].后弟 = v;
        尾 = v;
        跳白();
        若 (解源[解位] == 44) { 解位++; 续; }
        若 (解源[解位] == 125) { 解位++; 断; }
        解错 = 1; 断;
    }
    返 r;
}

静 整 解值() {
    若 (解深 > 200) { 解错 = 1; 返 -1; }
    解深++;
    跳白();
    字 c = 解源[解位];
    若 (c == 34) {
                整 n = 解串(暂存一, 65536);
        整 r = 新节();
        若 (r < 0) 返 -1;
        节[r].节类 = 类串;
        节[r].值起 = 存串(暂存一, n);
        节[r].值长 = n;
        返 r;
    }
    若 (c == 123) 返 解对();
    若 (c == 91) 返 解组();
    若 (c == 116) { 解位 += 4; 整 r = 新节(); 若 (r >= 0) 节[r].节类 = 类真; 返 r; }
    若 (c == 102) { 解位 += 5; 整 r = 新节(); 若 (r >= 0) 节[r].节类 = 类假; 返 r; }
    若 (c == 110) { 解位 += 4; 整 r = 新节(); 若 (r >= 0) 节[r].节类 = 类空; 返 r; }
    若 (c == 45 || (c >= 48 && c <= 57)) {
        双 整部 = 0.0; 双 小部 = 0.0; 双 因 = 1.0;
        整 负 = 0; 整 小 = 0;
        若 (c == 45) { 负 = 1; 解位++; }
        循环 (解源[解位] >= 48 && 解源[解位] <= 57) { 整部 = 整部 * 10.0 + (双)(解源[解位] - 48); 解位++; }
        若 (解源[解位] == 46) {
            解位++; 小 = 1;
            循环 (解源[解位] >= 48 && 解源[解位] <= 57) {
                小部 = 小部 * 10.0 + (双)(解源[解位] - 48);
                因 = 因 * 10.0;
                解位++;
            }
        }
        整 指 = 0;
        若 (解源[解位] == 101 || 解源[解位] == 69) {
            整 负指 = 0;
            解位++;
            若 (解源[解位] == 43) 解位++;
            否 若 (解源[解位] == 45) { 负指 = 1; 解位++; }
            循环 (解源[解位] >= 48 && 解源[解位] <= 57) { 指 = 指 * 10 + (解源[解位] - 48); 解位++; }
            若 (负指) 指 = 0 - 指;
        }
        双 结果值 = 整部;
        若 (小) 结果值 = 整部 + 小部 / 因;
        若 (指 > 0) { 整 k = 0; 循环 (k < 指) { 结果值 = 结果值 * 10.0; k++; } }
        否 若 (指 < 0) { 整 k = 0; 循环 (k < 0 - 指) { 结果值 = 结果值 / 10.0; k++; } }
        若 (负) 结果值 = 0.0 - 结果值;
        整 r = 新节();
        若 (r < 0) 返 -1;
        节[r].节类 = 类数;
        节[r].数值 = 结果值;
        返 r;
    }
    解错 = 1;
    返 -1;
}

/* 解析入口：返根节点号（<0 = 错） */
静 整 JSON解析(常 字 *文) {
    JSON重置();
    解源 = 文;
    整 r = 解值();
    跳白();
    若 (解源[解位] != 0) 解错 = 1;
    返 r;
}

/* ============ 取用 ============ */
静 整 JSON取(整 对, 常 字 *键) {
    整 c;
    若 (对 < 0 || 对 >= 节数) 返 -1;
    若 (节[对].节类 != 类对) 返 -1;
    c = 节[对].首子;
    循环 (c >= 0) {
        若 (节[c].键长 > 0) {
            常 字 *k = 串池 + 节[c].键起;
            整 i = 0; 整 同 = 1;
            循环 (键[i] != 0 || k[i] != 0) {
                若 (k[i] != 键[i]) { 同 = 0; 断; }
                i++;
            }
            若 (同) 返 c;
        }
        c = 节[c].后弟;
    }
    返 -1;
}

静 整 JSON长(整 组) {
    整 c; 整 n = 0;
    若 (组 < 0) 返 0;
    c = 节[组].首子;
    循环 (c >= 0) { n++; c = 节[c].后弟; }
    返 n;
}

静 整 JSON子(整 组, 整 i) {
    整 c;
    若 (组 < 0) 返 -1;
    c = 节[组].首子;
    循环 (c >= 0 && i > 0) { c = 节[c].后弟; i--; }
    返 c;
}

静 常 字 *JSON串(整 n) { 若 (n < 0) 返 ""; 返 串池 + 节[n].值起; }
静 整 JSON串长(整 n) { 若 (n < 0) 返 0; 返 节[n].值长; }
静 双 JSON数(整 n) { 若 (n < 0) 返 0.0; 返 节[n].数值; }
静 整 JSON类(整 n) { 若 (n < 0) 返 -1; 返 节[n].节类; }
静 整 JSON错() { 返 解错; }

/* ============ 生成 ============ */
静 整 出位;
静 字 *暂存二;
静 整 出容;
静 整 出溢;

静 空 出字(字 c) { 若 (出位 < 出容 - 1) { 暂存二[出位] = c; 出位++; } 否 出溢 = 1; }
静 空 出文(常 字 *s) { 整 i = 0; 循环 (s[i] != 0) { 出字(s[i]); i++; } }

静 空 出串转义(常 字 *s, 整 n) {
    出字(34);
    遍 (整 i = 0; i < n; i++) {
        字 c = s[i];
        若 (c == 34) { 出字(92); 出字(34); }
        否 若 (c == 92) { 出字(92); 出字(92); }
        否 若 (c == 10) { 出字(92); 出字(110); }
        否 若 (c == 13) { 出字(92); 出字(114); }
        否 若 (c == 9) { 出字(92); 出字(116); }
        否 出字(c);
    }
    出字(34);
}

静 空 出数(双 v) {
    /* 统一走 %.10g：整数自动无小数点（LSP 里大量整数字段） */
    字 序[512];
    格式化到串(序, "%.10g", v);
    出文(序);
}

静 空 出值(整 n) {
    若 (n < 0) { 出文("null"); 返; }
    若 (节[n].节类 == 类空) { 出文("null"); 返; }
    若 (节[n].节类 == 类真) { 出文("true"); 返; }
    若 (节[n].节类 == 类假) { 出文("false"); 返; }
    若 (节[n].节类 == 类数) { 出数(节[n].数值); 返; }
    若 (节[n].节类 == 类串) { 出串转义(串池 + 节[n].值起, 节[n].值长); 返; }
    若 (节[n].节类 == 类组) {
        整 c = 节[n].首子; 整 首 = 1;
        出字(91);
        循环 (c >= 0) {
            若 (!首) 出字(44);
            首 = 0;
            出值(c);
            c = 节[c].后弟;
        }
        出字(93);
        返;
    }
    若 (节[n].节类 == 类对) {
        整 c = 节[n].首子; 整 首 = 1;
        出字(123);
        循环 (c >= 0) {
            若 (!首) 出字(44);
            首 = 0;
            出串转义(串池 + 节[c].键起, 节[c].键长);
            出字(58);
            出值(c);
            c = 节[c].后弟;
        }
        出字(125);
        返;
    }
    出文("null");
}

/* 生成入口：返写入长度（含结尾 0 之前的内容长度） */
静 整 JSON生成(整 根, 字 *出, 整 容量) {
    暂存二 = 出; 出容 = 容量; 出位 = 0; 出溢 = 0;
    出值(根);
    若 (出位 < 出容) { 暂存二[出位] = 0; } 否 { 暂存二[出容 - 1] = 0; }
    返 出位;
}

/* 便捷：新建对象/数组/字符串/数字/布尔（供生成侧构造） */
静 整 JSON新对() { 整 r = 新节(); 若 (r >= 0) 节[r].节类 = 类对; 返 r; }
静 整 JSON新组() { 整 r = 新节(); 若 (r >= 0) 节[r].节类 = 类组; 返 r; }
静 整 JSON新串(常 字 *s, 整 n) {
    整 r = 新节();
    若 (r < 0) 返 -1;
    节[r].节类 = 类串;
    节[r].值起 = 存串(s, n);
    节[r].值长 = n;
    返 r;
}
静 整 JSON新数(双 v) { 整 r = 新节(); 若 (r >= 0) { 节[r].节类 = 类数; 节[r].数值 = v; } 返 r; }
静 整 JSON新真() { 整 r = 新节(); 若 (r >= 0) 节[r].节类 = 类真; 返 r; }

/* 添加成员（对象：带键；数组：键长=0） */
静 空 JSON加(整 父, 常 字 *键, 整 子) {
    整 尾;
    若 (父 < 0 || 子 < 0) 返;
    若 (键 != 0) {
        整 n = 0;
        循环 (键[n] != 0) n++;
        节[子].键起 = 存串(键, n);
        节[子].键长 = n;
    }
    若 (节[父].首子 < 0) { 节[父].首子 = 子; 返; }
    尾 = 节[父].首子;
    循环 (节[尾].后弟 >= 0) 尾 = 节[尾].后弟;
    节[尾].后弟 = 子;
}
