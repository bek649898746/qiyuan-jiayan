/*
 * jy_stat.jy — 甲言诊断统计器（用甲言写 · 供"按族攻坚"用）
 * 立单：启元 · 2026-10-14 · 纪律：不动编译器
 * 用途：吃一批 jsonl（每行一个 `--dj` 的 JSON）⟹ 统计【错误码分布 + 文件分布】
 *   ⟹ 直接支撑虾米的「缺陷族」排序（哪个码最多 = 下一刀打哪）
 *
 * 输入格式（每行一个 JSON 对象，形如 --dj 的输出）：
 *   {"diagnostics":[{...},{...}]}
 *   （多行拼接也可：本器按「行」逐条解析）
 *
 * 用法：jy_stat.exe <jsonl 文件> [topN]
 */
#include <stdio.h>
#include "jyjson.jy"

#define 码容 128
静 字 码名[码容][24];
静 整 码计[码容];
静 整 码数;
静 字 全[2097152];
静 字 行[1048576];

静 整 找码(常 字 *码) {
    整 i = 0;
    循环 (i < 码数) {
        整 j = 0; 整 同 = 1;
        循环 (码[j] != 0 || 码名[i][j] != 0) {
            若 (码[j] != 码名[i][j]) { 同 = 0; 断; }
            j++;
        }
        若 (同) 返 i;
        i++;
    }
    若 (码数 >= 码容) 返 -1;
    整 k = 0;
    循环 (码[k] != 0 && k < 22) { 码名[码数][k] = 码[k]; k++; }
    码名[码数][k] = 0;
    码计[码数] = 0;
    码数++;
    返 码数 - 1;
}

静 空 统计文(常 字 *文) {
    整 根 = JSON解析(文);
    若 (JSON错() || 根 < 0) 返;
    整 dl = JSON取(根, "diagnostics");
    若 (dl < 0) 返;
    整 n = JSON长(dl);
    遍 (整 i = 0; i < n; i++) {
        整 d = JSON子(dl, i);
        若 (d < 0) 续;
        整 cn = JSON取(d, "code");
        若 (cn < 0) 续;
        整 ix = 找码(JSON串(cn));
        若 (ix >= 0) 码计[ix]++;
    }
}

整 主(整 数, 字 **参) {
    若 (数 < 2) { 输出("用法: jy_stat.exe <jsonl> [topN]\n"); 返 2; }
    整 topN = 20;
    若 (数 >= 3) topN = atoi(参[2]);
    FILE *f = 打开文件(参[1], "rb");
    若 (f == 0) { 格式化打印("[ERR] 打不开 %s\n", 参[1]); 返 2; }

    /* 读全文（fgetc 逐字节，比 读行/fgets 可靠） */
    整 全n = 0; 整 ch;
    循环 ((ch = fgetc(f)) >= 0 && 全n < 2097150) { 全[全n] = (字)ch; 全n++; }
    全[全n] = 0;
    fclose(f);

    /* 手动按 \n 切行 */
    整 总 = 0; 整 有效行 = 0; 整 p = 0;
    循环 (p < 全n) {
        整 q = p;
        循环 (q < 全n && 全[q] != 10 && 全[q] != 13) q++;
        整 m = q - p;
        若 (m >= 2 && 全[p] == 123) {   /* 行以 { 开头 = JSON 行 */
            整 k = 0;
            循环 (k < m && k < 1048570) { 行[k] = 全[p + k]; k++; }
            行[k] = 0;
            有效行++;
            统计文(行);
        }
        p = q;
        循环 (p < 全n && (全[p] == 10 || 全[p] == 13)) p++;
    }

    遍 (整 i = 0; i < 码数; i++) 总 += 码计[i];

    输出("========================================\n");
    格式化打印("甲言诊断统计 · %d 个 JSON 行 · 共 %d 条诊断\n", 有效行, 总);
    输出("========================================\n");
    若 (总 == 0) { 输出("（无诊断）\n"); 返 0; }

    /* 选择排序（码数少，简单排） */
    遍 (整 i = 0; i < 码数; i++) {
        整 最 = i;
        遍 (整 j = i + 1; j < 码数; j++) 若 (码计[j] > 码计[最]) 最 = j;
        若 (最 != i) {
            整 t = 码计[i]; 码计[i] = 码计[最]; 码计[最] = t;
            字 tmp[24]; 整 k = 0;
            循环 (码名[i][k] != 0 || 码名[最][k] != 0) { tmp[k] = 码名[i][k]; 码名[i][k] = 码名[最][k]; 码名[最][k] = tmp[k]; k++; }
        }
    }
    遍 (整 i = 0; i < 码数 && i < topN; i++) {
        整 千 = 码计[i] * 1000 / 总;
        格式化打印("  %-8s %5d 条  (%d.%d%%)\n", 码名[i], 码计[i], 千 / 10, 千 % 10);
    }
    格式化打印("----------------------------------------\n共 %d 个错误码 · %d 条诊断\n", 码数, 总);
    返 0;
}
