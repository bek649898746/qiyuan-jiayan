/*
 * jy_diag.jy — 甲言诊断 → LSP publishDiagnostics 转发器（**单函数版** · 用甲言写）
 * 立单：启元 · 2026-10-14 · 纪律：不动编译器（qcc_zh.jy 一行未碰）
 *
 * 定位：补上 LSP 缺的那一块 —— 让编辑器能"看到诊断"。
 *   ❌ 不用子进程（`_popen` 走 CRT，而 CRT 标准流未初始化 ⟹ 恐同坑）
 *   ❌ 不用 stdin
 *   ✅ 输入 = `qcc --dj x.c > d.json` 的 JSON 文件（由外部管线产生）
 *   ✅ 输出 = **可直接发给 LSP 客户端的完整帧**（Content-Length 头 + body）
 *   ⟹ 管线：qcc --dj > d.json  →  jy_diag d.json <uri>  →  直接喂编辑器
 *
 * 用法：jy_diag.exe <诊断.json> <文档uri> [--参数]
 *   --参数  只输出 params JSON（不带 Content-Length 帧头）
 *
 * 依据（实测 d3.json 真实结构，非猜测）：
 *   {"diagnostics":[{"code":"A1001","severity":"error",          ← severity 是【字符串】
 *     "loc":{"file":"…","line":1,"col":0},                       ← line 是 1-based，col 是 0-based
 *     "span":{"start":0,"end":0},                                ← 实测全 0（无信息）
 *     "message":"…","causeChain":[],"backtrace":[],"fixes":[…],"codeLine":"…"}]}
 *
 * ⚠️ 全程不写自定义函数（除 主）：实测同一段逻辑「内联在 主() 里可用、拆成函数后恒 0」
 *    （见递刀 20261014_递刀_启元_内联命中函数恒0待定性）⟹ 本版按已验证可行的形态写。
 *
 * 判据：① 输出是合法 JSON ② Content-Length 头 == body 字节数 ③ line 减 1 正确
 *       ④ message 转义正确（含引号/破折号不破 JSON）⑤ severity 映射 ⑥ range.end >= start
 */
#include <stdio.h>
#include "jyjson.jy"

#define 源容 262144
#define 出容 524288

静 字 源文[源容];
静 字 出[出容];
静 整 出位;

整 主(整 数, 字 **参) {
    FILE *f;
    整 n;
    整 根;
    整 诊列;
    整 条;
    整 k;
    整 k2;
    整 行;
    整 列号;
    整 严级;
    整 只参数;
    字 c;
    字 缓[64];
    常 字 *s;
    常 字 *uri;
    整 d;
    整 loc;
    整 节点;

    只参数 = 0;
    若 (数 < 3) {
        输出("用法: jy_diag.exe <诊断.json> <文档uri> [--params]\n");
        输出("  把 qcc --dj 的诊断 JSON 转成 LSP publishDiagnostics 帧\n");
        输出("  --params | -p   只输出 params JSON（不带 Content-Length 帧头）\n");
        输出("  注: Windows 下 argv 是 GBK 而字面量是 UTF-8 ⟹ 中文选项 --参数 匹配不上，请用 ASCII 别名\n");
        返 2;
    }
    uri = 参[2];
    /* ⚠️ 中文选项在 Windows 下匹配不上（argv=ANSI/GBK vs 字面量=UTF-8）
     *    ⟹ 必须同时提供 ASCII 别名（这是启元 2026-10-14 实测的 T17 坑，此处自己用上） */
    若 (数 >= 4 && (!比较字符串(参[3], "--参数") || !比较字符串(参[3], "--params") || !比较字符串(参[3], "-p"))) 只参数 = 1;

    f = fopen(参[1], "rb");
    若 (!f) { 格式化打印("[错误] 读不到诊断文件: %s\n", 参[1]); 返 2; }
    n = (整)fread(源文, 1, 源容 - 1, f);
    fclose(f);
    源文[n] = 0;

    JSON重置();
    根 = JSON解析(源文);
    若 (JSON错() || 根 < 0) { 格式化打印("[错误] 诊断 JSON 解析失败（%d 字节）\n", n); 返 3; }

    诊列 = JSON取(根, "diagnostics");
    条 = 0;
    若 (诊列 >= 0) 条 = JSON长(诊列);

    出位 = 0;

    /* ---- 拼 params ---- */
    s = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"";
    遍 (k = 0; s[k] != 0; k++) { 出[出位] = s[k]; 出位++; }

    /* uri 转义 */
    遍 (k = 0; uri[k] != 0; k++) {
        c = uri[k];
        若 (c == 34) { 出[出位] = 92; 出位++; 出[出位] = 34; 出位++; }
        否 若 (c == 92) { 出[出位] = 92; 出位++; 出[出位] = 92; 出位++; }
        否 { 出[出位] = c; 出位++; }
    }

    s = "\",\"diagnostics\":[";
    遍 (k = 0; s[k] != 0; k++) { 出[出位] = s[k]; 出位++; }

    /* ---- 逐条诊断 ---- */
    遍 (k = 0; k < 条; k++) {
        d = JSON子(诊列, k);
        若 (d < 0) 续;
        若 (k > 0) { 出[出位] = 44; 出位++; }

        行 = 1;
        列号 = 0;
        loc = JSON取(d, "loc");
        若 (loc >= 0) {
            节点 = JSON取(loc, "line");
            若 (节点 >= 0) 行 = (整)JSON数(节点);
            节点 = JSON取(loc, "col");
            若 (节点 >= 0) 列号 = (整)JSON数(节点);
        }
        若 (行 < 1) 行 = 1;
        若 (列号 < 0) 列号 = 0;

        s = "{\"range\":{\"start\":{\"line\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 出[出位] = s[k2]; 出位++; }
        格式化到串(缓, "%d", 行 - 1);
        遍 (k2 = 0; 缓[k2] != 0; k2++) { 出[出位] = 缓[k2]; 出位++; }
        s = ",\"character\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 出[出位] = s[k2]; 出位++; }
        格式化到串(缓, "%d", 列号);
        遍 (k2 = 0; 缓[k2] != 0; k2++) { 出[出位] = 缓[k2]; 出位++; }
        s = "},\"end\":{\"line\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 出[出位] = s[k2]; 出位++; }
        格式化到串(缓, "%d", 行 - 1);
        遍 (k2 = 0; 缓[k2] != 0; k2++) { 出[出位] = 缓[k2]; 出位++; }
        s = ",\"character\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 出[出位] = s[k2]; 出位++; }
        格式化到串(缓, "%d", 列号 + 1);
        遍 (k2 = 0; 缓[k2] != 0; k2++) { 出[出位] = 缓[k2]; 出位++; }
        s = "}},\"severity\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 出[出位] = s[k2]; 出位++; }

        /* severity: 字符串 -> LSP 数字（1 Error 2 Warning 3 Info 4 Hint） */
        严级 = 1;
        节点 = JSON取(d, "severity");
        若 (节点 >= 0 && JSON类(节点) == 类串) {
            s = JSON串(节点);
            若 (!比较字符串(s, "warning")) 严级 = 2;
            否 若 (!比较字符串(s, "info")) 严级 = 3;
            否 若 (!比较字符串(s, "information")) 严级 = 3;
            否 若 (!比较字符串(s, "hint")) 严级 = 4;
        }
        格式化到串(缓, "%d", 严级);
        遍 (k2 = 0; 缓[k2] != 0; k2++) { 出[出位] = 缓[k2]; 出位++; }

        s = ",\"code\":\"";
        遍 (k2 = 0; s[k2] != 0; k2++) { 出[出位] = s[k2]; 出位++; }
        节点 = JSON取(d, "code");
        若 (节点 >= 0 && JSON类(节点) == 类串) {
            s = JSON串(节点);
            遍 (k2 = 0; s[k2] != 0; k2++) {
                c = s[k2];
                若 (c == 34) { 出[出位] = 92; 出位++; 出[出位] = 34; 出位++; }
                否 若 (c == 92) { 出[出位] = 92; 出位++; 出[出位] = 92; 出位++; }
                否 { 出[出位] = c; 出位++; }
            }
        }
        s = "\",\"source\":\"jyan\",\"message\":\"";
        遍 (k2 = 0; s[k2] != 0; k2++) { 出[出位] = s[k2]; 出位++; }

        /* message 转义（命门：引号 / 反斜杠 / 控制字符） */
        节点 = JSON取(d, "message");
        若 (节点 >= 0 && JSON类(节点) == 类串) {
            s = JSON串(节点);
            遍 (k2 = 0; s[k2] != 0; k2++) {
                c = s[k2];
                若 (c == 34) { 出[出位] = 92; 出位++; 出[出位] = 34; 出位++; }
                否 若 (c == 92) { 出[出位] = 92; 出位++; 出[出位] = 92; 出位++; }
                否 若 (c == 10) { 出[出位] = 92; 出位++; 出[出位] = 110; 出位++; }
                否 若 (c == 13) { 出[出位] = 92; 出位++; 出[出位] = 114; 出位++; }
                否 若 (c == 9)  { 出[出位] = 92; 出位++; 出[出位] = 116; 出位++; }
                否 { 出[出位] = c; 出位++; }
            }
        }
        出[出位] = 34; 出位++;      /* " 收 message 字符串 */
        出[出位] = 125; 出位++;      /* } */
    }

    s = "]}}";        /* ] 关 diagnostics 数组 · } 关 params · } 关最外层 */
    遍 (k = 0; s[k] != 0; k++) { 出[出位] = s[k]; 出位++; }
    出[出位] = 0;

    /* ---- 输出 ---- */
    若 (只参数) {
        fwrite(出, 1, 出位, 输出流);
        输出("\n");
    } 否 {
        格式化打印("Content-Length: %d\r\n\r\n", 出位);
        fwrite(出, 1, 出位, 输出流);
        刷新缓冲(输出流);
    }
    返 0;
}
