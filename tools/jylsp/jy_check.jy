/*
 * jy_check.jy — 甲言诊断美化器（用甲言写 · 不需要 stdin · 不需要子进程）
 * 立单：启元 · 2026-10-14 · 纪律：不动编译器
 * 用途：把 `qcc --dj x.c 2> d.json` 的 JSON 诊断，变成人类可读的中文报告
 *   （= LSP 的「命令行降级版」；stdin 修好后 LSP 可复用本文件的渲染逻辑）
 * 用法：jy_check.exe d.json [源文件路径]
 */
#include <stdio.h>
#include "jyjson.jy"

/* 从 URL/路径里取文件名部分（纯展示用） */
静 常 字 *短名(常 字 *p) {
    整 n = 0; 整 i = 0; 整 末 = 0;
    循环 (p[n] != 0) n++;
    循环 (i < n) { 若 (p[i] == 92 || p[i] == 47) 末 = i + 1; i++; }
    返 p + 末;
}

静 空 渲染一条(整 d, 整 序) {
    整 码 = JSON取(d, "code");
    整 级 = JSON取(d, "severity");
    整 位 = JSON取(d, "loc");
    整 息 = JSON取(d, "message");
    整 行 = -1; 整 列 = -1;
    常 字 *文 = "";
    若 (位 >= 0) {
        整 ln = JSON取(位, "line");
        整 cn = JSON取(位, "col");
        若 (ln >= 0) 行 = (整)JSON数(ln);
        若 (cn >= 0) 列 = (整)JSON数(cn);
    }
    若 (息 >= 0) 文 = JSON串(息);
    格式化打印("[%d] %s", 序, (级 >= 0 && JSON串(级)[0] == 119) ? "警告" : "错误");
    若 (码 >= 0) 格式化打印(" %s", JSON串(码));
    若 (行 >= 0) 格式化打印("  @%d:%d", 行, 列);
    格式化打印("\n    %s\n", 文);
    /* 修复建议 */
    整 修 = JSON取(d, "fixes");
    若 (修 >= 0) {
        整 n = JSON长(修);
        若 (n > 0) {
            格式化打印("    建议：");
            遍 (整 k = 0; k < n; k++) {
                整 e = JSON子(修, k);
                若 (e >= 0) 格式化打印("%s%s", (k > 0) ? " / " : "", JSON串(e));
            }
            格式化打印("\n");
        }
    }
    /* 源码行 */
    整 cl = JSON取(d, "codeLine");
    若 (cl >= 0) 格式化打印("    源码：%s\n", JSON串(cl));
    格式化打印("\n");
}

整 主(整 数, 字 **参) {
    字 文[1048576];
    若 (数 < 2) { 输出("用法: jy_check.exe <诊断.json> [源文件]\n"); 返 2; }
    FILE *f = 打开文件(参[1], "rb");
    若 (f == 0) { 格式化打印("[ERR] 打不开 %s\n", 参[1]); 返 2; }
    整 n = 0; 整 c;
    循环 ((c = fgetc(f)) >= 0 && n < 1048570) { 文[n] = (字)c; n++; }
    文[n] = 0;
    fclose(f);
    若 (n == 0) { 输出("（诊断文件为空）\n"); 返 0; }

    整 根 = JSON解析(文);
    若 (JSON错() || 根 < 0) {
        格式化打印("[ERR] 诊断 JSON 解析失败（%d 字节）—— 原文前 200 字：\n%s\n", n, 文);
        返 3;
    }

    字 源名[512];
    源名[0] = 0;
    若 (数 >= 3) {
        整 k = 0;
        循环 (参[2][k] != 0 && k < 500) { 源名[k] = 参[2][k]; k++; }
        源名[k] = 0;
    } 否 {
        /* 从诊断里取 file */
        整 dl = JSON取(根, "diagnostics");
        若 (dl >= 0) {
            整 d0 = JSON子(dl, 0);
            若 (d0 >= 0) {
                整 lo = JSON取(d0, "loc");
                若 (lo >= 0) {
                    整 fi = JSON取(lo, "file");
                    若 (fi >= 0) {
                        整 k = 0; 常 字 *p = 短名(JSON串(fi));
                        循环 (p[k] != 0 && k < 500) { 源名[k] = p[k]; k++; }
                        源名[k] = 0;
                    }
                }
            }
        }
    }

    整 dl = JSON取(根, "diagnostics");
    整 条 = 0;
    若 (dl >= 0) 条 = JSON长(dl);

    输出("========================================\n");
    格式化打印("甲言诊断报告 · %s · 共 %d 条\n", (源名[0] ? 源名 : "(未命名)"), 条);
    输出("========================================\n\n");

    若 (条 == 0) {
        输出("✅ 无错误无警告\n");
        返 0;
    }
    遍 (整 i = 0; i < 条; i++) {
        整 d = JSON子(dl, i);
        若 (d >= 0) 渲染一条(d, i + 1);
    }
    格式化打印("----------------------------------------\n共 %d 条\n", 条);
    返 (条 > 0) ? 1 : 0;
}
