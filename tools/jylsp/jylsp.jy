/*
 * jylsp.jy — 甲言 LSP 服务器 v0.2（帧层改用 Win32 直读）
 * 立单：启元 · 2026-10-14 · 纪律：不动编译器（qcc_zh.jy 一行未碰）
 * 依赖：jyjson.jy（JSON 解析）
 *
 * v0.2 关键改动（依据本轮实测 p_s3 / p_s5 / p_s6）：
 *   🔴 甲言产物【不跑 CRT 标准流初始化】⟹ stdin/stdout/stderr 三个 FILE* 全为 0
 *   ⟹ `fgetc(输入流)` 拿 NULL 返 -1（旧版死在这里）
 *   ⟹ `_setmode(_fileno(输入流),…)` 同样不可用（_fileno(NULL) 无意义）
 *   ✅ 但 `GetStdHandle(-10)` + `ReadFile` 实测【完全可用】：连续读正确、EOF=ERROR_BROKEN_PIPE(109)
 *   ✅ 写侧：甲言把 fwrite/fprintf 内建化成 Win32 写（不碰 FILE*）⟹ 写帧照旧可用
 *   ⟹ 本版：读走 ReadFile（自带 64KB 缓冲）· 写走内建 fwrite · 删掉 切二进制()
 *
 * 用法：
 *   jylsp.exe                       # 从 stdin 读 LSP 帧，往 stdout 写 LSP 帧
 *   type req.bin | jylsp.exe        # 手工喂一帧（跨行无关，读的是原始字节）
 *
 * 判据（握手）：
 *   ① 能解析 Content-Length 帧
 *   ② 能解析 JSON 请求
 *   ③ 响应的 Content-Length 头 == 实际 body 字节数（逐字节可核）
 *   ④ id 原样回传（数字/字符串）
 *   ⑤ initialize 回 capabilities；shutdown 回 null；exit 退出；未知方法回 -32601
 */
#include <stdio.h>
#include "jyjson.jy"

/* ---- Win32 直读（LSP 二进制帧的生死线）---- */
外部 空 *GetStdHandle(整 n);
外部 整 ReadFile(空 *句, 空 *缓冲, 整 数, 整 *已读, 空 *重叠);

#define 帧头容 512
#define 帧体容 1048576
#define 入缓容 65536

静 字 帧体[帧体容];
静 整 帧长;
静 整 应停止;

静 空 *入句;
静 字 入缓[入缓容];
静 整 入位;
静 整 入余;

/* ============ 读侧：Win32 直读 + 64KB 缓冲 ============ */

静 整 读一字节() {
    整 已读 = 0;
    若 (入余 <= 0) {
        若 (!ReadFile(入句, 入缓, 入缓容, &已读, 0)) 返 -1;
        若 (已读 <= 0) 返 -1;
        入位 = 0;
        入余 = 已读;
    }
    入余--;
    返 (无符号 整)((无符号 字)入缓[入位++]);
}

/* ============ 帧层 ============ */

静 空 写帧(常 字 *体, 整 体长) {
    格式化打印("Content-Length: %d\r\n\r\n", 体长);
    若 (体长 > 0) { fwrite(体, 1, 体长, 输出流); }
    刷新缓冲(输出流);
}

/* 读一帧：返体长；-1 = EOF/错 */
静 整 读帧() {
    字 头[帧头容];
    整 n = 0;
    整 c;
    整 体长 = 0;
    整 i;
    整 逗 = -1;
    循环 (1) {
        c = 读一字节();
        若 (c < 0) 返 -1;
        若 (n >= 帧头容 - 1) 返 -1;
        头[n] = (字)c;
        n++;
        若 (n >= 4 && 头[n-4] == 13 && 头[n-3] == 10 && 头[n-2] == 13 && 头[n-1] == 10) 断;
    }
    头[n] = 0;
    /* 解析 Content-Length: N */
    i = 0;
    循环 (i + 15 < n) {
        若 (头[i] == 67 && 头[i+1] == 111 && 头[i+2] == 110 && 头[i+3] == 116 &&
            头[i+4] == 101 && 头[i+5] == 110 && 头[i+6] == 116 && 头[i+7] == 45 &&
            头[i+8] == 76 && 头[i+9] == 101 && 头[i+10] == 110 && 头[i+11] == 103 &&
            头[i+12] == 116 && 头[i+13] == 104 && 头[i+14] == 58) {
            i = i + 15;
            循环 (头[i] == 32) i++;
            循环 (头[i] >= 48 && 头[i] <= 57) { 体长 = 体长 * 10 + (头[i] - 48); i++; }
            逗 = 1;
            断;
        }
        i++;
    }
    若 (逗 < 0) 返 -1;
    若 (体长 < 0 || 体长 >= 帧体容) 返 -1;
    遍 (i = 0; i < 体长; i++) {
        c = 读一字节();
        若 (c < 0) 返 -1;
        帧体[i] = (字)c;
    }
    帧体[体长] = 0;
    帧长 = 体长;
    返 体长;
}

/* ============ 出帧（手工拼 JSON ⟹ 完全确定 · 零 API 风险）============ */

静 空 拼入(字 *出, 整 *位, 常 字 *s) {
    整 k = *位;
    遍 (整 j = 0; s[j] != 0; j++) { 出[k] = s[j]; k++; }
    *位 = k;
}

静 空 发响应(常 字 *id文本, 常 字 *结果json) {
    字 合并[131072];
    整 k = 0;
    拼入(合并, &k, "{\"jsonrpc\":\"2.0\",\"id\":");
    拼入(合并, &k, id文本);
    拼入(合并, &k, ",\"result\":");
    拼入(合并, &k, 结果json);
    拼入(合并, &k, "}");
    合并[k] = 0;
    写帧(合并, k);
}

静 空 发错响应(常 字 *id文本, 整 误码, 常 字 *消息) {
    字 合并[8192];
    字 码串[32];
    整 k = 0;
    格式化到串(码串, "%d", 误码);
    拼入(合并, &k, "{\"jsonrpc\":\"2.0\",\"id\":");
    拼入(合并, &k, id文本);
    拼入(合并, &k, ",\"error\":{\"code\":");
    拼入(合并, &k, 码串);
    拼入(合并, &k, ",\"message\":\"");
    拼入(合并, &k, 消息);
    拼入(合并, &k, "\"}}");
    合并[k] = 0;
    写帧(合并, k);
}

静 空 发通知(常 字 *方法, 常 字 *参数json) {
    字 合并[131072];
    整 k = 0;
    拼入(合并, &k, "{\"jsonrpc\":\"2.0\",\"method\":\"");
    拼入(合并, &k, 方法);
    拼入(合并, &k, "\",\"params\":");
    拼入(合并, &k, 参数json);
    拼入(合并, &k, "}");
    合并[k] = 0;
    写帧(合并, k);
}

/* ============ 请求辅助 ============ */

/* id 原文（数字或带引号字符串）—— 返回静态缓冲，须立即使用 */
静 常 字 *请求标识(整 根) {
    静 字 缓甲[128];
    整 idn = JSON取(根, "id");
    若 (idn < 0) { 缓甲[0] = 48; 缓甲[1] = 0; 返 缓甲; }
    若 (JSON类(idn) == 类数) { 格式化到串(缓甲, "%d", (整)JSON数(idn)); 返 缓甲; }
    格式化到串(缓甲, "\"%s\"", JSON串(idn));
    返 缓甲;
}

/* ============ LSP 能力（最小可用集）============ */

静 常 字 *能力文本() {
    返 "{\"capabilities\":{\"textDocumentSync\":1,"
           "\"completionProvider\":{\"triggerCharacters\":[\".\",\"(\"]},"
           "\"definitionProvider\":true,\"hoverProvider\":false},"
           "\"serverInfo\":{\"name\":\"jylsp\",\"version\":\"0.4.0\"}}";
}

/* ============ T4' · 诊断（约定文件驱动 · v0.3 新增）============
 * 分工（职责清晰）：
 *   · 编辑器壳（JS）负责跑 `qcc --dj` —— **子进程是壳的强项**（也是唯一能绕开 CRT 未初始化的干净位置）
 *   · 甲言侧负责**协议与转换**：从约定文件读诊断 → 转成标准 LSP publishDiagnostics 帧
 * 约定：诊断文件 = <源文件本地路径>.jyan.json
 * 文件不存在 ⟹ 发**空数组**（LSP 的正确清空语义）
 *
 * ⚠️ 陷阱（已规避）：本函数内会 JSON重置() 并重新解析诊断文件，
 *    那会清空 jyjson 的串池 ⟹ **传进来的 uri 指针会失效** ⟹ 必须先拷进自己的缓冲 */
静 字 诊出[131072];
静 字 我U[1024];

/* ============ v0.4 · 符号能力（补全 / 跳转）============
 * 数据来源：① didOpen/didChange 送来的【文档全文】② 核心关键字硬表
 * ⚠️ 文档文本必须【拷进静态缓冲】：请求树会在下一次 JSON重置 时失效 */
静 字 文档文[524288];
静 字 文档uri[1024];
静 整 有文档;
静 字 补出[262144];
静 整 补位;
静 字 候选[512][64];
静 字 数缓[64];      /* 本文件自己的数字格式化缓冲（别借用别的文件的）*/
/* v0.5 跨文件跳转 */
静 字 定uri[1200];    /* 跳转目标的 uri（默认=当前文档）*/
静 字 目录路[1024];
静 字 扫名一[260];
静 字 全路[1300];
静 字 本名[260];
/* 跨文件跳转的【结果暂存】—— 搜索在主内做（函数内扫目录在此环境不可靠，见递刀「函数内 vs 主内」）
 *   实测：同一段 UTF-16→UTF-8 转码，在 主() 内读出 [工具库-1.3.5] 完全正确；
 *         在 发定义() 内却只剩低字节 ⟹ 差异在代码位置，不在写法 */
静 整 跨命中;
静 整 跨定行;
静 整 跨定列;
静 字 跨定uri[3200];       /* v0.10：路径要经 URL 编码输出（中文 1 字节→3 字符）⟹ 容量按 3 倍预留 */
静 整 需跨文;            /* 由 发定义 设置：本文件没找到 ⟹ 请求【主内】搜索 */
静 字 跨求名[64];        /* 要跨文件找的名字 */
静 整 跨求长;            /* 其字节长度（预先算好，不用 取字长）*/

/* v0.5 跨文件跳转要用目录扫描（Win32 W 版）
 * ⚠️ 这些是【本文件自己的】声明 —— 别借用 jy_pkg.jy 里的同名物（跨文件串味已犯两次：出缓 / 宽模）*/
外部 空 *FindFirstFileW(常 短 *模式, 空 *数据);
外部 整 FindNextFileW(空 *句, 空 *数据);
外部 整 FindClose(空 *句);
/* ⚠️ 读文件也要走 Win32：CRT 的 fopen 期望 ANSI(GBK) 路径，
 *    而 LSP 的 uri 经 JSON 进来是【UTF-8】⟹ 中文路径 fopen 必失败（实测 = 0）*/
外部 空 *CreateFileW(常 短 *名, 无符号 整 访问, 无符号 整 共享, 空 *安, 无符号 整 建, 无符号 整 旗, 空 *模);
外部 整 ReadFile(空 *句, 空 *缓冲, 整 数, 整 *已读, 空 *重叠);
外部 整 CloseHandle(空 *句);

/* v0.8 读文件通路（2026-10-14 实测结论）：
 * ⚠️ 上面三条【静态导入】的 CreateFileW 恒返 -1 + err=87（与参数完全无关，5 变体铁证）
 * ✅ 但用甲言【内置】的 加载库/取函数 动态取地址的那一份【完全可用】⟹ 宽字符，中文路径通吃
 *    技术先例：qcc_rt.c L1060 __qcc_map_create 就是这套技术的官方实现 */
typedef 整 (*创型)(短 *, 无符号 整, 无符号 整, 空 *, 无符号 整, 无符号 整, 空 *);
typedef 整 (*读型)(整, 空 *, 无符号 整, 无符号 整 *, 空 *);
typedef 整 (*关型)(整);
静 空 *跨库;
静 创型 跨f创;
静 读型 跨f读;
静 关型 跨f关;
静 整 跨读;

typedef 构 {
    整 属性;
    整 时一[2];
    整 时二[2];
    整 时三[2];
    整 大小高;
    整 大小低;
    整 保留零;
    整 保留一;
    短 文件名[260];
    短 别名[14];
} 找数据型;

静 找数据型 找据;
静 短 宽模[600];

/* 从请求的 params.textDocument 取 uri 与 text，拷进静态缓冲 */
静 空 取文档(整 根) {
    整 参二 = JSON取(根, "params");
    整 td;
    整 u;
    整 t;
    常 字 *s;
    整 k;
    若 (参二 < 0) 返;
    td = JSON取(参二, "textDocument");
    若 (td < 0) 返;
    u = JSON取(td, "uri");
    若 (u >= 0 && JSON类(u) == 类串) {
        s = JSON串(u);
        遍 (k = 0; s[k] != 0 && k < 1000; k++) 文档uri[k] = s[k];
        文档uri[k] = 0;
    }
    t = JSON取(td, "text");
    若 (t >= 0 && JSON类(t) == 类串) {
        s = JSON串(t);
        遍 (k = 0; s[k] != 0 && k < 524000; k++) 文档文[k] = s[k];
        文档文[k] = 0;
        有文档 = 1;
    }
}

/* 发补全：从文档全文里提取标识符（中文/字母/数字/下划线），去重后作为候选 */
静 空 发补全(常 字 *id文本) {
    整 i = 0;
    整 k;
    整 k2;
    整 起;
    整 段长;
    整 找否;
    整 候数 = 0;
    无符号 字 c;
    字 缓[64];
    常 字 *s;

    循环 (文档文[i] != 0 && 候数 < 512) {
        c = (无符号 字)文档文[i];
        若 (c >= 128 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
            起 = i;
            循环 (1) {
                c = (无符号 字)文档文[i];
                若 (c >= 128 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
                    (c >= 48 && c <= 57) || c == 95) i++;
                否 断;
            }
            段长 = i - 起;
            若 (段长 > 0 && 段长 < 64) {
                遍 (k = 0; k < 段长; k++) 缓[k] = 文档文[起 + k];
                缓[段长] = 0;
                找否 = 0;
                遍 (k = 0; k < 候数; k++) {
                    若 (!比较字符串(候选[k], 缓)) { 找否 = 1; 断; }
                }
                若 (!找否) {
                    复制字符串(候选[候数], 缓);
                    候数++;
                }
            }
        } 否 i++;
    }

    补位 = 0;
    s = "{\"jsonrpc\":\"2.0\",\"id\":";
    遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
    遍 (k2 = 0; id文本[k2] != 0; k2++) { 补出[补位] = id文本[k2]; 补位++; }
    s = ",\"result\":[";
    遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
    遍 (k = 0; k < 候数; k++) {
        若 (k > 0) { 补出[补位] = 44; 补位++; }
        s = "{\"label\":\"";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
        遍 (k2 = 0; 候选[k][k2] != 0; k2++) { 补出[补位] = 候选[k][k2]; 补位++; }
        s = "\",\"kind\":6}";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
    }
    s = "]}";
    遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
    补出[补位] = 0;
    写帧(补出, 补位);
}

/* 发定义：取请求 position.line 行的第一个标识符，在文档里找「该名后紧跟 (」的位置 */
静 空 发定义(常 字 *id文本, 整 根) {
    整 参二;
    整 pos;
    整 行节;
    整 行号;
    整 i;
    整 k;
    整 k2;
    整 行起;
    整 行止;
    整 起;
    整 段长;
    整 定行;
    整 定列;
    整 k3;
    整 后二;
    整 行计;
    整 w;
    整 末斜;
    整 找句;
    整 续找;
    整 名位;
    整 略位;
    整 n2;
    整 源位2;
    整 宽位2;
    整 段长2;
    无符号 字 ww;
    字 *字节基;
    FILE *fp;
    无符号 字 c;
    字 名求[64];
    常 字 *s;

    复制字符串(定uri, 文档uri);

    参二 = JSON取(根, "params");
    行号 = 0;
    若 (参二 >= 0) {
        pos = JSON取(参二, "position");
        若 (pos >= 0) {
            行节 = JSON取(pos, "line");
            若 (行节 >= 0) 行号 = (整)JSON数(行节);
        }
    }
    若 (行号 < 0) 行号 = 0;

    /* 定位该行在文档文里的字节范围 */
    行起 = 0;
    i = 0;
    k = 0;
    循环 (文档文[i] != 0 && k < 行号) {
        若 (文档文[i] == 10) k++;
        i++;
    }
    行起 = i;
    行止 = i;
    循环 (文档文[行止] != 0 && 文档文[行止] != 10) 行止++;

    /* 逐个取该行的标识符，谁在文档里有「名 (」就跳到谁
     * （不能只取第 1/第 2 个：类型词与变量都会排在函数名前面，如 `整 丁 = 乘法(3,4);`）*/
    定行 = -1;
    定列 = 0;
    i = 行起;
    循环 (i < 行止 && 定行 < 0) {
        c = (无符号 字)文档文[i];
        若 (c >= 128 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
            起 = i;
            循环 (i < 行止) {
                c = (无符号 字)文档文[i];
                若 (c >= 128 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
                    (c >= 48 && c <= 57) || c == 95) i++;
                否 断;
            }
            段长 = i - 起;
            若 (段长 > 0 && 段长 < 60) {
                遍 (k2 = 0; k2 < 段长; k2++) 名求[k2] = 文档文[起 + k2];
                名求[段长] = 0;
                /* 全文找「名求 后紧跟 (」 */
                k3 = 0;
                循环 (文档文[k3] != 0 && 定行 < 0) {
                    若 (!比前n(文档文 + k3, 名求, 段长)) {
                        后二 = k3 + 段长;
                        若 (文档文[后二] == 40) {
                            /* ⚠️ 跳过「调用」：名( 前面（跳过空白）是 '=' ⟹ 那是赋值右侧，不是定义 */
                            略位 = k3 - 1;
                            循环 (略位 >= 0 && (文档文[略位] == 32 || 文档文[略位] == 9)) 略位--;
                            若 (!(略位 >= 0 && 文档文[略位] == 61)) {
                                行计 = 0;
                                w = 0;
                                循环 (w < k3) { 若 (文档文[w] == 10) 行计++; w++; }
                                定行 = 行计;
                                定列 = 0;
                                w = k3;
                                循环 (w > 0 && 文档文[w - 1] != 10) { 定列++; w--; }
                            }
                        }
                    }
                    k3++;
                }
            }
        } 否 i++;
    }

    /* ---- 跨文件：搜索结果由 主 在【主内】填好（见文件头注释与递刀）---- */
    若 (定行 < 0 && 跨命中) {
        定行 = 跨定行;
        定列 = 跨定列;
        复制字符串(定uri, 跨定uri);
    }

    /* ---- 本文件没找到、主内也还没结果 ⟹ 设标志请【主内】搜一轮，本函数不输出 ----
     *    （不在本函数里扫目录：实测「函数内」读全局结构体会失真，见递刀）*/
    若 (定行 < 0 && !需跨文 && !跨命中) {
        复制字符串(跨求名, 名求);
        跨求长 = 段长;
        需跨文 = 1;
        返;
    }

    补位 = 0;
    s = "{\"jsonrpc\":\"2.0\",\"id\":";
    遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
    遍 (k2 = 0; id文本[k2] != 0; k2++) { 补出[补位] = id文本[k2]; 补位++; }
    若 (定行 >= 0) {
        s = ",\"result\":{\"uri\":\"";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
        遍 (k2 = 0; 定uri[k2] != 0; k2++) { 补出[补位] = 定uri[k2]; 补位++; }
        s = "\",\"range\":{\"start\":{\"line\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
        格式化到串(数缓, "%d", 定行);
        遍 (k2 = 0; 数缓[k2] != 0; k2++) { 补出[补位] = 数缓[k2]; 补位++; }
        s = ",\"character\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
        格式化到串(数缓, "%d", 定列);
        遍 (k2 = 0; 数缓[k2] != 0; k2++) { 补出[补位] = 数缓[k2]; 补位++; }
        s = "},\"end\":{\"line\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
        格式化到串(数缓, "%d", 定行);
        遍 (k2 = 0; 数缓[k2] != 0; k2++) { 补出[补位] = 数缓[k2]; 补位++; }
        s = ",\"character\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
        格式化到串(数缓, "%d", 定列 + 1);
        遍 (k2 = 0; 数缓[k2] != 0; k2++) { 补出[补位] = 数缓[k2]; 补位++; }
        s = "}}}";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
    } 否 {
        s = ",\"result\":null}";
        遍 (k2 = 0; s[k2] != 0; k2++) { 补出[补位] = s[k2]; 补位++; }
    }
    补出[补位] = 0;
    写帧(补出, 补位);
}

/* 取 params.textDocument.uri（返回串池指针 —— 只在【调用发诊断时】使用，发诊断开头即拷贝）*/
静 常 字 *取文档uri(整 根) {
    整 参二 = JSON取(根, "params");
    整 td;
    整 u;
    若 (参二 < 0) 返 "";
    td = JSON取(参二, "textDocument");
    若 (td < 0) 返 "";
    u = JSON取(td, "uri");
    若 (u < 0 || JSON类(u) != 类串) 返 "";
    返 JSON串(u);
}

静 空 发诊断(常 字 *uri) {
    字 路[1024];
    整 k;
    整 i;
    整 出位;
    整 n;
    整 根;
    整 诊列;
    整 条;
    整 严级;
    整 k2;
    字 c;
    字 缓[64];
    常 字 *s;
    FILE *f;
    整 d;
    整 loc;
    整 节点;
    整 行;
    整 列号;

    /* --- 0. 先把 uri 拷进自己的缓冲（关键：之后 JSON重置 会让原指针失效）--- */
    i = 0;
    循环 (uri[i] != 0 && i < 1000) { 我U[i] = uri[i]; i++; }
    我U[i] = 0;

    /* --- 1. uri -> 本地路径（去 file:/// 或 file://）--- */
    i = 0;
    若 (我U[0] == 102 && 我U[1] == 105 && 我U[2] == 108 && 我U[3] == 101 && 我U[4] == 58) {
        若 (我U[5] == 47 && 我U[6] == 47 && 我U[7] == 47) i = 8;
        否 若 (我U[5] == 47 && 我U[6] == 47) i = 7;
    }
    k = 0;
    循环 (我U[i] != 0 && k < 1000) { 路[k] = 我U[i]; k++; i++; }
    /* --- 2. 加后缀 .jyan.json --- */
    s = ".jyan.json";
    遍 (k2 = 0; s[k2] != 0; k2++) { 路[k] = s[k2]; k++; }
    路[k] = 0;

    /* --- 3. 拼 body 头部 --- */
    出位 = 0;
    s = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"";
    遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }
    遍 (k2 = 0; 我U[k2] != 0; k2++) { 诊出[出位] = 我U[k2]; 出位++; }
    s = "\",\"diagnostics\":[";
    遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }

    /* --- 4. 读诊断文件并逐条转换（不存在 ⟹ 空数组）--- */
    条 = 0;
    f = fopen(路, "rb");
    若 (f) {
        n = (整)fread(帧体, 1, 帧体容 - 1, f);
        fclose(f);
        帧体[n] = 0;
        JSON重置();
        根 = JSON解析(帧体);
        若 (!JSON错() && 根 >= 0) {
            诊列 = JSON取(根, "diagnostics");
            若 (诊列 >= 0) 条 = JSON长(诊列);
            遍 (k = 0; k < 条; k++) {
                d = JSON子(诊列, k);
                若 (d < 0) 续;
                若 (k > 0) { 诊出[出位] = 44; 出位++; }
                行 = 1;
                列号 = 0;
                loc = JSON取(d, "loc");
                若 (loc >= 0) {
                    节点 = JSON取(loc, "line");
                    若 (节点 >= 0) 行 = (整)JSON数(节点);
                    节点 = JSON取(loc, "col");
                    若 (节点 >= 0) 列号 = (整)JSON数(节点);
                }
                若 (行 < 1) 行 = 1;
                若 (列号 < 0) 列号 = 0;

                s = "{\"range\":{\"start\":{\"line\":";
                遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }
                格式化到串(缓, "%d", 行 - 1);
                遍 (k2 = 0; 缓[k2] != 0; k2++) { 诊出[出位] = 缓[k2]; 出位++; }
                s = ",\"character\":";
                遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }
                格式化到串(缓, "%d", 列号);
                遍 (k2 = 0; 缓[k2] != 0; k2++) { 诊出[出位] = 缓[k2]; 出位++; }
                s = "},\"end\":{\"line\":";
                遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }
                格式化到串(缓, "%d", 行 - 1);
                遍 (k2 = 0; 缓[k2] != 0; k2++) { 诊出[出位] = 缓[k2]; 出位++; }
                s = ",\"character\":";
                遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }
                格式化到串(缓, "%d", 列号 + 1);
                遍 (k2 = 0; 缓[k2] != 0; k2++) { 诊出[出位] = 缓[k2]; 出位++; }
                s = "}},\"severity\":";
                遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }

                严级 = 1;
                节点 = JSON取(d, "severity");
                若 (节点 >= 0 && JSON类(节点) == 类串) {
                    s = JSON串(节点);
                    若 (!比较字符串(s, "warning")) 严级 = 2;
                    否 若 (!比较字符串(s, "info")) 严级 = 3;
                    否 若 (!比较字符串(s, "information")) 严级 = 3;
                    否 若 (!比较字符串(s, "hint")) 严级 = 4;
                }
                格式化到串(缓, "%d", 严级);
                遍 (k2 = 0; 缓[k2] != 0; k2++) { 诊出[出位] = 缓[k2]; 出位++; }

                s = ",\"code\":\"";
                遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }
                节点 = JSON取(d, "code");
                若 (节点 >= 0 && JSON类(节点) == 类串) {
                    s = JSON串(节点);
                    遍 (k2 = 0; s[k2] != 0; k2++) {
                        c = s[k2];
                        若 (c == 34) { 诊出[出位] = 92; 出位++; 诊出[出位] = 34; 出位++; }
                        否 若 (c == 92) { 诊出[出位] = 92; 出位++; 诊出[出位] = 92; 出位++; }
                        否 { 诊出[出位] = c; 出位++; }
                    }
                }
                s = "\",\"source\":\"jyan\",\"message\":\"";
                遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }

                节点 = JSON取(d, "message");
                若 (节点 >= 0 && JSON类(节点) == 类串) {
                    s = JSON串(节点);
                    遍 (k2 = 0; s[k2] != 0; k2++) {
                        c = s[k2];
                        若 (c == 34) { 诊出[出位] = 92; 出位++; 诊出[出位] = 34; 出位++; }
                        否 若 (c == 92) { 诊出[出位] = 92; 出位++; 诊出[出位] = 92; 出位++; }
                        否 若 (c == 10) { 诊出[出位] = 92; 出位++; 诊出[出位] = 110; 出位++; }
                        否 若 (c == 13) { 诊出[出位] = 92; 出位++; 诊出[出位] = 114; 出位++; }
                        否 若 (c == 9)  { 诊出[出位] = 92; 出位++; 诊出[出位] = 116; 出位++; }
                        否 { 诊出[出位] = c; 出位++; }
                    }
                }
                诊出[出位] = 34; 出位++;      /* " 收 message */
                诊出[出位] = 125; 出位++;     /* } 收本条 */
            }
        }
    }

    s = "]}}";
    遍 (k2 = 0; s[k2] != 0; k2++) { 诊出[出位] = s[k2]; 出位++; }
    诊出[出位] = 0;
    写帧(诊出, 出位);
}

/* ============ 主循环 ============ */

整 主() {

    入句 = GetStdHandle(-10);
    入位 = 0;
    入余 = 0;
    应停止 = 0;

    循环 (!应停止) {
        整 n = 读帧();
        整 根;
        整 m;
        常 字 *法;
        若 (n < 0) 断;                       /* EOF 或坏帧 ⟹ 退出 */

        JSON重置();
        根 = JSON解析(帧体);
        若 (JSON错() || 根 < 0) 续;          /* 坏 JSON ⟹ 跳过本帧 */
        m = JSON取(根, "method");
        若 (m < 0) 续;                       /* 响应类消息（无 method）⟹ 忽略 */

        法 = JSON串(m);

        若 (!比较字符串(法, "initialize")) {
            发响应(请求标识(根), 能力文本());
            续;
        }
        若 (!比较字符串(法, "initialized")) 续;                 /* 通知，无响应 */

         /* --- v0.3/v0.4：文档事件 ⟹ 接管全文 ⟹ 读约定诊断文件 ⟹ 发 publishDiagnostics --- */
        若 (!比较字符串(法, "textDocument/didOpen") ||
             !比较字符串(法, "textDocument/didChange")) {
            取文档(根);                 /* ★ 先接管文档全文（发诊断会 JSON重置 ⟹ 之后请求树不可用）*/
            发诊断(取文档uri(根));
            续;
        }
        若 (!比较字符串(法, "textDocument/didSave")) {
            发诊断(取文档uri(根));
            续;
        }

         /* --- v0.4：符号能力 --- */
        若 (!比较字符串(法, "textDocument/completion")) {
            发补全(请求标识(根));
            续;
        }
        若 (!比较字符串(法, "textDocument/definition")) {
            需跨文 = 0;
            跨命中 = 0;
            发定义(请求标识(根), 根);   /* 本文件命中则直接输出；否则只设标志 */
            若 (需跨文) {
                /* ---- 【主内】跨文件搜索：同一段转码在主内可靠（函数内会失真，见递刀）---- */
                字 跨路[1024];
                字 跨名一[260];
                字 跨全[1300];
                字 跨本名[260];
                短 跨模[600];
                短 跨宽路[700];
                整 跨i;
                整 跨位;
                整 跨宽;
                整 跨段;
                整 跨句;
                整 跨续;
                整 跨名位;
                整 跨k;
                整 跨略;
                整 跨末斜;
                整 跨n2;
                整 跨行;
                整 跨列;
                整 跨w;
                整 跨后;
                无符号 整 跨c;      /* ⚠️ 必须是【整】不是【字】：UTF-8→UTF-16 累加要 16 位，用 8 位会把中文截断 */
                无符号 整 跨ww;
                FILE *跨文;
                整 跨文句;      /* ⚠️ 独立变量：绝不与 跨句(FindFirst 句柄) 混用 —— 判据 AS */
                整 高;          /* v0.10：%XX 解码的高位半字节 */
                整 低;          /* v0.10：%XX 解码的低位半字节 */
                无符号 整 字值;  /* v0.10：URL 编码时逐字节判断 —— ⚠️ 不能叫 `字节`，那是甲言保留类型词（撞词家族第 4 例）*/

                /* 1. 文档uri → 目录路径 */
                跨i = 0;
                若 (文档uri[0] == 102 && 文档uri[1] == 105 && 文档uri[2] == 108 && 文档uri[3] == 101 && 文档uri[4] == 58) {
                    若 (文档uri[5] == 47 && 文档uri[6] == 47 && 文档uri[7] == 47) 跨i = 8;
                    否 若 (文档uri[5] == 47 && 文档uri[6] == 47) 跨i = 7;
                }
                跨k = 0;
                循环 (文档uri[跨i] != 0 && 跨k < 900) {
                    /* v0.10 入口：uri 里的 %XX 要还原成原始字节（VSCode 发中文路径时是百分号编码的）*/
                    若 (文档uri[跨i] == 37 && 文档uri[跨i + 1] != 0 && 文档uri[跨i + 2] != 0) {
                        高 = 0;
                        若 (文档uri[跨i + 1] >= 48 && 文档uri[跨i + 1] <= 57) 高 = 文档uri[跨i + 1] - 48;
                        否 若 (文档uri[跨i + 1] >= 65 && 文档uri[跨i + 1] <= 70) 高 = 文档uri[跨i + 1] - 55;
                        否 若 (文档uri[跨i + 1] >= 97 && 文档uri[跨i + 1] <= 102) 高 = 文档uri[跨i + 1] - 87;
                        低 = 0;
                        若 (文档uri[跨i + 2] >= 48 && 文档uri[跨i + 2] <= 57) 低 = 文档uri[跨i + 2] - 48;
                        否 若 (文档uri[跨i + 2] >= 65 && 文档uri[跨i + 2] <= 70) 低 = 文档uri[跨i + 2] - 55;
                        否 若 (文档uri[跨i + 2] >= 97 && 文档uri[跨i + 2] <= 102) 低 = 文档uri[跨i + 2] - 87;
                        跨路[跨k] = (字)(高 * 16 + 低); 跨k++; 跨i = 跨i + 3;
                    } 否 { 跨路[跨k] = 文档uri[跨i]; 跨k++; 跨i++; }
                }
                跨路[跨k] = 0;
                跨末斜 = -1;
                遍 (跨i = 0; 跨i < 跨k; 跨i++) 若 (跨路[跨i] == 47) 跨末斜 = 跨i;
                若 (跨末斜 < 0) 跨末斜 = 跨k;
                遍 (跨i = 0; 跨路[跨末斜 + 1 + 跨i] != 0 && 跨i < 250; 跨i++) 跨本名[跨i] = 跨路[跨末斜 + 1 + 跨i];
                跨本名[跨i] = 0;
                跨路[跨末斜] = 0;

                /* 2. 目录 + \*.jy → UTF-16 模式 */
                跨位 = 0; 跨宽 = 0;
                循环 (跨路[跨位] != 0 && 跨宽 < 500) {
                    跨c = (无符号 字)跨路[跨位];
                    跨段 = 1;
                    若 (跨c >= 240) { 跨c = 跨c & 7; 跨段 = 4; }
                    否 若 (跨c >= 224) { 跨c = 跨c & 15; 跨段 = 3; }
                    否 若 (跨c >= 192) { 跨c = 跨c & 31; 跨段 = 2; }
                    遍 (跨k = 1; 跨k < 跨段; 跨k++) {
                        跨位++;
                        若 (跨路[跨位] == 0) 断;
                        跨c = (跨c << 6) | ((无符号 字)跨路[跨位] & 63);
                    }
                    跨位++;
                    跨模[跨宽] = (短)跨c; 跨宽++;
                }
                跨模[跨宽] = 47; 跨宽++;      /* 统一 '/' */
                跨模[跨宽] = 42; 跨宽++;
                跨模[跨宽] = 46; 跨宽++;
                跨模[跨宽] = 106; 跨宽++;
                跨模[跨宽] = 121; 跨宽++;
                跨模[跨宽] = 0;

                /* 3. 扫目录，逐个 .jy 找「名 后紧跟 (」（且前面不是 '=' ⟹ 非调用）*/
                跨句 = (整)FindFirstFileW(跨模, &找据);
                若 (跨句 != -1) {
                    跨续 = 1;
                    循环 (跨续 && !跨命中) {
                        若 ((找据.属性 & 16) == 0) {
                            跨名位 = 0;
                            遍 (跨k = 0; 找据.文件名[跨k] != 0 && 跨名位 < 250; 跨k++) {
                                跨ww = (无符号 短)找据.文件名[跨k];
                                若 (跨ww < 128) { 跨名一[跨名位] = (字)跨ww; 跨名位++; }
                                否 若 (跨ww < 2048) {
                                    跨名一[跨名位] = (字)(192 | (跨ww >> 6)); 跨名位++;
                                    跨名一[跨名位] = (字)(128 | (跨ww & 63)); 跨名位++;
                                } 否 {
                                    跨名一[跨名位] = (字)(224 | (跨ww >> 12)); 跨名位++;
                                    跨名一[跨名位] = (字)(128 | ((跨ww >> 6) & 63)); 跨名位++;
                                    跨名一[跨名位] = (字)(128 | (跨ww & 63)); 跨名位++;
                                }
                            }
                            跨名一[跨名位] = 0;
                            跨略 = 0;
                            若 (!比较字符串(跨名一, 跨本名)) 跨略 = 1;
                            若 (!跨略) {
                                跨k = 0;
                                遍 (跨i = 0; 跨路[跨i] != 0 && 跨k < 900; 跨i++) { 跨全[跨k] = 跨路[跨i]; 跨k++; }
                                跨全[跨k] = 47; 跨k++;      /* 统一用 '/' —— 混用 '\' 会让 fopen 失败（实测）*/
                                遍 (跨i = 0; 跨名一[跨i] != 0 && 跨k < 1200; 跨i++) { 跨全[跨k] = 跨名一[跨i]; 跨k++; }
                                跨全[跨k] = 0;
                                /* 用 CreateFileW 读（fopen 对 UTF-8 中文路径必失败）*/
                                跨宽 = 0;
                                跨位 = 0;
                                循环 (跨全[跨位] != 0 && 跨宽 < 600) {
                                    跨c = (无符号 字)跨全[跨位];
                                    跨段 = 1;
                                    若 (跨c >= 240) { 跨c = 跨c & 7; 跨段 = 4; }
                                    否 若 (跨c >= 224) { 跨c = 跨c & 15; 跨段 = 3; }
                                    否 若 (跨c >= 192) { 跨c = 跨c & 31; 跨段 = 2; }
                                    遍 (跨k = 1; 跨k < 跨段; 跨k++) {
                                        跨位++;
                                        若 (跨全[跨位] == 0) 断;
                                        跨c = (跨c << 6) | ((无符号 字)跨全[跨位] & 63);
                                    }
                                    跨位++;
                                    跨宽路[跨宽] = (短)跨c; 跨宽++;                                }
                                跨宽路[跨宽] = 0;
                                /* v0.8：动态直调【宽字符】CreateFileW（静态导入的那份恒 err=87） */
                                若 (!跨f创) {
                                    跨库 = 加载库("kernel32.dll");
                                    跨f创 = (创型)取函数(跨库, "CreateFileW");
                                    跨f读 = (读型)取函数(跨库, "ReadFile");
                                    跨f关 = (关型)取函数(跨库, "CloseHandle");
                                }
                                跨文句 = 跨f创(跨宽路, 2147483648, 1, 0, 3, 128, 0);
                                跨读 = 0;
                                若 (跨文句 != -1 && 跨文句 != 0) {
                                    跨f读(跨文句, 帧体, 帧体容 - 1, (无符号 整 *)&跨读, 0);
                                    跨f关(跨文句);
                                    跨n2 = 跨读;
                                } 否 { 跨n2 = -1; }
                                若 (跨n2 >= 0) {
                                    帧体[跨n2] = 0;
                                    跨k = 0;
                                    循环 (跨k < 跨n2 && !跨命中) {
                                        若 (!比前n(帧体 + 跨k, 跨求名, 跨求长)) {
                                            跨后 = 跨k + 跨求长;
                                            若 (帧体[跨后] == 40) {
                                                跨略 = 跨k - 1;
                                                循环 (跨略 >= 0 && (帧体[跨略] == 32 || 帧体[跨略] == 9)) 跨略--;
                                                若 (!(跨略 >= 0 && 帧体[跨略] == 61)) {
                                                    跨行 = 0; 跨w = 0;
                                                    循环 (跨w < 跨k) { 若 (帧体[跨w] == 10) 跨行++; 跨w++; }
                                                    跨列 = 0; 跨w = 跨k;
                                                    循环 (跨w > 0 && 帧体[跨w - 1] != 10) { 跨列++; 跨w--; }
                                                    跨定行 = 跨行;
                                                    跨定列 = 跨列;
                                                    跨w = 0;
                                                    跨定uri[跨w] = 102; 跨w++; 跨定uri[跨w] = 105; 跨w++; 跨定uri[跨w] = 108; 跨w++; 跨定uri[跨w] = 101; 跨w++;
                                                    跨定uri[跨w] = 58; 跨w++; 跨定uri[跨w] = 47; 跨w++; 跨定uri[跨w] = 47; 跨w++; 跨定uri[跨w] = 47; 跨w++;
                                                    遍 (跨i = 0; 跨路[跨i] != 0 && 跨w < 2900; 跨i++) {
                                                        /* v0.10 出口：非 ASCII 与 '%' 要百分号编码（VSCode 要求合法 URI）*/
                                                        字值 = (无符号 整)(无符号 字)跨路[跨i];
                                                        若 (字值 > 127 || 字值 == 37) {
                                                            跨定uri[跨w] = 37; 跨w++;
                                                            跨定uri[跨w] = (字)(((字值 / 16) < 10) ? (48 + (字值 / 16)) : (55 + (字值 / 16))); 跨w++;
                                                            跨定uri[跨w] = (字)(((字值 % 16) < 10) ? (48 + (字值 % 16)) : (55 + (字值 % 16))); 跨w++;
                                                        } 否 { 跨定uri[跨w] = 跨路[跨i]; 跨w++; }
                                                    }
                                                    跨定uri[跨w] = 47; 跨w++;
                                                    遍 (跨i = 0; 跨名一[跨i] != 0 && 跨w < 3100; 跨i++) {
                                                        字值 = (无符号 整)(无符号 字)跨名一[跨i];
                                                        若 (字值 > 127 || 字值 == 37) {
                                                            跨定uri[跨w] = 37; 跨w++;
                                                            跨定uri[跨w] = (字)(((字值 / 16) < 10) ? (48 + (字值 / 16)) : (55 + (字值 / 16))); 跨w++;
                                                            跨定uri[跨w] = (字)(((字值 % 16) < 10) ? (48 + (字值 % 16)) : (55 + (字值 % 16))); 跨w++;
                                                        } 否 { 跨定uri[跨w] = 跨名一[跨i]; 跨w++; }
                                                    }
                                                    跨定uri[跨w] = 0;
                                                    跨命中 = 1;
                                                }
                                            }
                                        }
                                        跨k++;
                                    }
                                }
                            }
                        }
                        跨续 = FindNextFileW(跨句, &找据);
                        若 (跨续 == 0) 断;
                    }
                    FindClose(跨句);
                }

                /* 4. 再调一次 发定义：它会用 跨命中 的结果输出 */
                发定义(请求标识(根), 根);
            }
            续;
        }

        若 (!比较字符串(法, "shutdown")) {
            发响应(请求标识(根), "null");
            续;
        }
        若 (!比较字符串(法, "exit")) { 应停止 = 1; 续; }
        若 (!比较字符串(法, "$/cancelRequest")) 续;             /* 忽略 */

        发错响应(请求标识(根), -32601, "方法未实现");
    }
    返 0;
}
