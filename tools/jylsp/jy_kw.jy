/*
 * jy_kw.jy — 甲言关键字/保留名提取器 v2（**单函数版** · 用甲言写）
 * 立单：启元 · 2026-10-14 · 纪律：不动编译器（qcc_zh.jy 一行未碰）
 *
 * 双用途：
 *   ① 给 IDE / VSCode 生成语法高亮关键字表
 *   ② 产出【用户保留名清单】（启元实测撞词 4 次：类(字段名)·长(变量名)·取串(函数名)·错(变量名)）
 *
 * 原理：甲言编译器自己就用 `比较字符串(词名表[词位], "关键字")` 判定关键字
 *       ⟹ 从编译器源码**直接提取**字面量 = 权威来源（文档会漂，源码不会）
 *
 * ⚠️ 为什么写成"全部逻辑塞进 主()"这种不好看的形态（**如实说明**）：
 *    最小探针 p_kw1 实测：**同样的逐字节搜索，内联在 `主()` 里命中（3 处），
 *    写成独立函数后恒 0**（三个修法都试过：绕开取字长 / 变量移出循环 / 内联匹配）。
 *    ⟹ 本版按"**已验证可行的形态**"实现，先把结果拿到；
 *    ⟹ 该现象**另立待办做成最小复现递刀**（疑为甲言的一个真缺陷）。
 *
 * 用法：jy_kw.exe <甲言源码.jy>
 */
#include <stdio.h>

#define 词容 6000
#define 词长 64
#define 文容 8388608

静 字 文[文容];
静 字 词表[词容][词长];
静 整 词次[词容];
静 整 词数;
静 字 模式[64];

整 主(整 数, 字 **参) {
    FILE *f;
    整 n;
    整 i;
    整 j;
    整 k;
    整 k2;
    整 k3;
    整 命中;
    整 停扫;
    整 起;
    整 词长一;
    整 轮;
    整 计;
    整 中文;
    整 找否;
    字 c;
    字 缓[词长];

    若 (数 < 2) { 输出("用法: jy_kw.exe <甲言源码.jy>\n"); 返 2; }
    f = fopen(参[1], "rb");
    若 (!f) { 输出("[错误] 打不开源码\n"); 返 2; }
    n = (整)fread(文, 1, 文容 - 1, f);
    fclose(f);
    文[n] = 0;

    格式化打印("=== 甲言关键字/保留名提取 ===\n源码: %s\n字节: %d\n\n", 参[1], n);

    词数 = 0;

    /* 两轮：轮0 = 关键字族（词名表）· 轮1 = 选项族（整劣） */
    遍 (轮 = 0; 轮 < 2; 轮++) {
        若 (轮 == 0) 复制字符串(模式, "比较字符串(词名表");
        否 复制字符串(模式, "比较字符串(整劣");

        i = 0;
        循环 (i + 8 < n) {
            /* ---- 内联逐字节匹配（照抄 p_kw1 已验证的成功写法）---- */
            命中 = 1;
            k = 0;
            循环 (模式[k] != 0) {
                若 (文[i + k] != 模式[k]) { 命中 = 0; 断; }
                k++;
            }
            若 (!命中) { i++; 续; }

            j = i + k;
            停扫 = 0;
            循环 (j < n && 停扫 == 0) {
                c = 文[j];
                若 (c == 10 || c == 13) 停扫 = 1;
                否 若 (c == 44) {
                    j++;
                    循环 (文[j] == 32 || 文[j] == 9) j++;
                    若 (文[j] == 34) {
                        j++;
                        起 = j;
                        循环 (文[j] != 0 && 文[j] != 34 && (j - 起) < 词长 - 1) j++;
                        词长一 = j - 起;
                        若 (词长一 > 0 && 词长一 < 词长) {
                            /* ---- 收词（内联）---- */
                            遍 (k2 = 0; k2 < 词长一; k2++) 缓[k2] = 文[起 + k2];
                            缓[词长一] = 0;
                            找否 = 0;
                            遍 (k3 = 0; k3 < 词数; k3++) {
                                若 (!比较字符串(词表[k3], 缓)) { 找否 = 1; 词次[k3]++; 断; }
                            }
                            若 (!找否 && 词数 < 词容) {
                                遍 (k2 = 0; k2 <= 词长一; k2++) 词表[词数][k2] = 缓[k2];
                                词次[词数] = 1;
                                词数++;
                            }
                        }
                    }
                    停扫 = 1;
                } 否 j++;
            }
            i = j;
        }
        格式化打印("[轮 %d] 累计不重复词 = %d\n", 轮 + 1, 词数);
    }

    /* ---- 打清单：中文 / ASCII / 全量 ---- */
    遍 (轮 = 0; 轮 < 3; 轮++) {
        若 (轮 == 0) { 输出("\n--- 中文关键字（用户最易撞的保留名）---\n"); }
        否 若 (轮 == 1) { 输出("\n--- ASCII 词（英文别名 / 兼容 C 侧）---\n"); }
        否 { 输出("\n--- 全量（去重后）---\n"); }
        计 = 0;
        遍 (i = 0; i < 词数; i++) {
            中文 = ((无符号 字)词表[i][0] >= 0x80) ? 1 : 0;
            若 (轮 == 0 && 中文 != 1) 续;
            若 (轮 == 1 && 中文 != 0) 续;
            格式化打印("%s\t%d\n", 词表[i], 词次[i]);
            计++;
        }
        格式化打印("[小计] %d\n", 计);
    }

    格式化打印("\n=== 合计 %d 个不重复词 ===\n", 词数);
    返 0;
}
