/*
 * jy_fam.jy — 甲言语料闸日志「缺陷族」统计器（用甲言写）
 * 立单：启元 · 2026-10-14 · 纪律：不动编译器
 * 用途：吃语料闸日志（PARALLEL GIT CORPUS GATE 格式）⟹ 输出【错误码族分布 + 明细 + 误报族判别】
 *   ⟹ 直接给「按族攻坚」排序用；并自动区分 R707 误报族（行内带 `OK:` 前缀 = 产物完整但 rc≠0）
 *
 * 用法：jy_fam.exe <闸日志>
 */
#include <stdio.h>
#include "jyjson.jy"

#define 族容 64
静 字 族码[族容][16];
静 整 族计[族容];
静 整 族真[族容];     /* 其中「真失败」（无 OK: 前缀）*/
静 整 族误[族容];     /* 其中「误报」（有 OK: 前缀 = R707 族）*/
静 整 族数;

静 整 找族(常 字 *码) {
    整 i = 0;
    循环 (i < 族数) {
        整 j = 0; 整 同 = 1;
        循环 (码[j] != 0 || 族码[i][j] != 0) {
            若 (码[j] != 族码[i][j]) { 同 = 0; 断; }
            j++;
        }
        若 (同) 返 i;
        i++;
    }
    若 (族数 >= 族容) 返 -1;
    整 k = 0;
    循环 (码[k] != 0 && k < 14) { 族码[族数][k] = 码[k]; k++; }
    族码[族数][k] = 0;
    族计[族数] = 0; 族真[族数] = 0; 族误[族数] = 0;
    族数++;
    返 族数 - 1;
}

整 主(整 数, 字 **参) {
    若 (数 < 2) { 输出("用法: jy_fam.exe <闸日志>\n"); 返 2; }
    FILE *f = 打开文件(参[1], "rb");
    若 (f == 0) { 格式化打印("[ERR] 打不开 %s\n", 参[1]); 返 2; }
    静 字 全[8388608];
    整 n = 0; 整 c;
    循环 ((c = fgetc(f)) >= 0 && n < 8388000) { 全[n] = (字)c; n++; }
    全[n] = 0;
    fclose(f);

    /* ★ UTF-16 LE 归一：若「每两字节的第二个恒为 0」则压缩成单字节（日志常见格式）
       —— 否则按字节扫描将永远找不到 [ERR]（实测踩过的坑） */
    整 是UTF16 = 0;
    若 (n > 8) {
        整 odd0 = 0;
        整 k = 3;   /* 跳过 BOM（字节 0,1）后，奇数字节应为 0 */
        循环 (k < 44 && k < n) { 若 (全[k] != 0) odd0++; k += 2; }
        若 (odd0 == 0) 是UTF16 = 1;
    }
    若 (是UTF16) {
        整 w = 0; 整 q = 0;
        /* 跳过 BOM（FF FE）*/
        若 (n >= 2 && (全[0] == 0 - 1 || 全[0] == 0xFF) && 全[1] == 0) q = 2;
        循环 (q + 1 < n) { 全[w] = 全[q]; w++; q += 2; }
        全[w] = 0;
        n = w;
    }

    整 总FAIL = 0; 整 误报数 = 0; 整 i = 0;
    循环 (i < n) {
        /* 找行首（或换行后）*/
        整 p = i;
        循环 (p < n && 全[p] != 10 && 全[p] != 13) p++;
        整 m = p - i;
        若 (m > 4) {
            /* 行内是否含 [ERR]？ */
            整 j = 0; 整 有ERR = 0; 整 有OK = 0;
            循环 (j + 4 < m) {
                若 (全[i+j] == 91 && 全[i+j+1] == 69 && 全[i+j+2] == 82 && 全[i+j+3] == 82 && 全[i+j+4] == 93) 有ERR = 1;
                若 (j + 1 < m && 全[i+j] == 79 && 全[i+j+1] == 75 && j + 2 < m && 全[i+j+2] == 58) 有OK = 1;
                j++;
            }
            若 (有ERR) {
                总FAIL++;
                若 (有OK) 误报数++;
                /* 提取错误码：找 'A' + 4 位数字 */
                整 k = 0; 整 得码 = 0;
                循环 (k + 4 < m) {
                    若 (全[i+k] == 65 && 全[i+k+1] >= 48 && 全[i+k+1] <= 57 &&
                        全[i+k+2] >= 48 && 全[i+k+2] <= 57 && 全[i+k+3] >= 48 && 全[i+k+3] <= 57 &&
                        全[i+k+4] >= 48 && 全[i+k+4] <= 57) {
                        字 码[16]; 码[0] = 65; 码[1] = 全[i+k+1]; 码[2] = 全[i+k+2];
                        码[3] = 全[i+k+3]; 码[4] = 全[i+k+4]; 码[5] = 0;
                        整 ix = 找族(码);
                        若 (ix >= 0) { 族计[ix]++; 若 (有OK) 族误[ix]++; 否 族真[ix]++; }
                        得码 = 1;
                        断;
                    }
                    k++;
                }
                若 (!得码) {
                    整 ix = 找族("PAREN/OTHER");
                    若 (ix >= 0) { 族计[ix]++; 若 (有OK) 族误[ix]++; 否 族真[ix]++; }
                }
            }
        }
        i = p;
        循环 (i < n && (全[i] == 10 || 全[i] == 13)) i++;
    }

    输出("========================================\n");
    格式化打印("甲言语料闸 · 缺陷族分布（FAIL 行 %d）\n", 总FAIL);
    输出("========================================\n");
    格式化打印("  误报族（产物完整、仅 rc≠0）: %d 条\n", 误报数);
    格式化打印("  真失败                      : %d 条\n", 总FAIL - 误报数);
    输出("----------------------------------------\n");
    输出("  错误码    总数   真失败   误报\n");
    输出("  --------  -----  ------  -----\n");
    /* 排序：按总数降序 */
    遍 (整 a = 0; a < 族数; a++) {
        整 最 = a;
        遍 (整 b = a + 1; b < 族数; b++) 若 (族计[b] > 族计[最]) 最 = b;
        若 (最 != a) {
            整 t = 族计[a]; 族计[a] = 族计[最]; 族计[最] = t;
            t = 族真[a]; 族真[a] = 族真[最]; 族真[最] = t;
            t = 族误[a]; 族误[a] = 族误[最]; 族误[最] = t;
            字 tmp[16]; 整 k = 0;
            循环 (k < 15) { tmp[k] = 族码[a][k]; 族码[a][k] = 族码[最][k]; 族码[最][k] = tmp[k]; 若 (族码[a][k] == 0) 断; k++; }
        }
    }
    遍 (整 a = 0; a < 族数; a++) {
        格式化打印("  %-8s  %5d  %6d  %5d\n", 族码[a], 族计[a], 族真[a], 族误[a]);
    }
    格式化打印("----------------------------------------\n  共 %d 个族\n", 族数);
    返 0;
}
