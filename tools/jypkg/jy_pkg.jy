/*
 * jy_pkg.jy — 甲言包管理器 v0.2（用甲言写 · 不需要 stdin · 不需要子进程）
 * 立单：启元 · 2026-10-14 · 纪律：不动编译器（qcc_zh.jy 一行未碰）
 *
 * v0.2 新增：**SHA-256 完整性校验** —— 用【甲言自带的 jylib_sha256】源码包含进本文件
 *   （jylib_sha256.c 零依赖：连 <string.h> 都已剥离，用 jy_memcpy_/jy_memset_ 手写替换）
 *   ⟹ 单文件编译，无需链接，无外部依赖 ✓
 *
 * 用法：
 *   jy_pkg.exe <清单.json>              # 锁（= v0.1 兼容形态）
 *   jy_pkg.exe 锁   <清单.json>          # 同上，显式
 *   jy_pkg.exe 校验 <清单.json>          # v0.2：对带「文件」+「摘要」的包做 SHA-256 校验
 *
 * 判据：
 *   ① 幂等        —— 同清单两次运行，锁文件逐字节一致
 *   ② 拓扑正确    —— 每个包的依赖都排在它之前
 *   ③ 环检测      —— 循环依赖响亮报错并拒绝出锁（rc=4）
 *   ④ 缺引用      —— 依赖了未定义的包名 ⟹ 响亮报错拒绝出锁（rc=4）
 *   ⑤ 版本冲突    —— 同名包两版本 ⟹ 响亮警告（保留首个 = 确定性）rc=0
 *   ⑥ SHA-256 向量 —— 内容 "abc" 的文件摘要必须 = FIPS 180-4 标准向量（rc=0）
 *   ⑦ 摘要不符    —— 篡改/摘要错 ⟹ 响亮报错拒绝通过（rc=5）
 *   ⑧ 文件缺失    —— 清单声明了文件但不存在 ⟹ 响亮报错（rc=5）
 */
#include <stdio.h>
#include "jyjson.jy"
#include "jylib_sha256.c"

#define 包容 256
#define 依容 4096
#define 名长 64
#define 版长 32
#define 路长 512
#define 文容 262144

typedef 构 {
    字 名[名长];
    字 版本[版长];
    字 文件[路长];
    字 摘要[80];
    整 依赖起;
    整 依赖数;
    整 状态;   /* 0=未访问 1=访问中（灰） 2=已完成（黑） */
} 包型;

/* ====== v0.3 目录扫描（Win32 W 版）======
 * 为什么用 W 版而不是 A 版：A 版返回 ANSI(GBK) 文件名 ⟹ 转 UTF-8 需要 GBK 大表；
 *   而 W 版两个方向（UTF-8→UTF-16 传参 · UTF-16→UTF-8 收名）**都只是算术**，无表 ⟹ 更简单且支持中文 ✓ */
外部 空 *FindFirstFileW(常 短 *模式, 空 *数据);
外部 整 FindNextFileW(空 *句, 空 *数据);
外部 整 FindClose(空 *句);

typedef 构 {
    整 属性;
    整 时一[2];
    整 时二[2];
    整 时三[2];
    整 大小高;
    整 大小低;
    整 保留零;
    整 保留一;
    短 文件名[260];
    短 别名[14];
} 找数据型;

静 找数据型 找据;
静 短 宽模[600];
静 短 宽全[600];
静 字 索引出[262144];
静 整 索位;

/* v0.4 版本约束求解：依赖（名+约束）必须先拷进这里 —— 因为 jyjson 是【单池】，
 * 解析索引会清掉清单那棵树 ⟹ 只能两阶段（先拷出、再重置、再解析索引）*/
静 字 依名[64][128];
静 字 依约[64][64];
静 整 依数;

/* v0.5 全链（装）：仓库扫描结果与已选版本（扫描直接写数组 ⟹ 不经 JSON）*/
静 字 仓名[512][128];
静 字 仓版[512][64];
静 整 仓数;
静 字 已选版[64][64];
静 字 根包名[128];

/* v0.7 核锁：锁里的「名-版本」清单（读锁时拷出来）*/
静 字 锁名[64][128];
静 字 锁版[64][64];
静 整 锁条数;

/* v0.6 拓扑序：每个依赖自己的「依赖名列表」⟹ 求解后按依赖图排拓扑序（依赖在前）*/
静 字 依赖名[64][8][64];
静 整 依赖个数[64];
静 整 访态[64];
静 整 拓扑序[64];
静 整 拓扑数;
静 整 有环;

/* 后序 DFS ⟹ 依赖自然先入序（= 拓扑序）；灰节点 ⟹ 有环
 * ⚠️ 与 v0.1 的 `深访` 分开命名：那个走的是 `包表/依赖池`，这个走 `依名/依赖名` */
静 空 深访包(整 i) {
    整 q;
    整 j;
    整 找;
    若 (i < 0 || i >= 依数) 返;
    若 (访态[i] == 1) { 有环 = 1; 返; }
    若 (访态[i] == 2) 返;
    访态[i] = 1;
    遍 (q = 0; q < 依赖个数[i]; q++) {
        找 = -1;
        遍 (j = 0; j < 依数; j++) {
            若 (!比较字符串(依名[j], 依赖名[i][q])) { 找 = j; 断; }
        }
        若 (找 >= 0) 深访包(找);
    }
    访态[i] = 2;
    若 (拓扑数 < 64) { 拓扑序[拓扑数] = i; 拓扑数++; }
}

静 包型 包表[包容];
静 整 包数;
静 整 依赖池[依容];
静 整 依池用;
静 整 拓扑[包容];
静 整 拓扑数;
静 整 有环;
静 整 缺引;
静 整 冲突;
静 字 源文[文容];
静 字 出缓[文容];
静 整 出位;
静 整 摘要对;
静 整 摘要错;
静 整 文件缺;

/* ============ 小工具 ============ */

静 空 拼(常 字 *s) {
    遍 (整 k = 0; s[k] != 0 && 出位 < 文容 - 64; k++) { 出缓[出位] = s[k]; 出位++; }
    出缓[出位] = 0;
}

静 空 拼数(整 v) {
    字 t[32];
    格式化到串(t, "%d", v);
    拼(t);
}

静 整 读全文(常 字 *路) {
    FILE *f = fopen(路, "rb");
    整 n;
    若 (!f) 返 -1;
    n = (整)fread(源文, 1, 文容 - 1, f);
    fclose(f);
    源文[n] = 0;
    返 n;
}

静 整 找包(常 字 *名) {
    遍 (整 i = 0; i < 包数; i++) 若 (!比较字符串(包表[i].名, 名)) 返 i;
    返 -1;
}

静 整 登包(常 字 *名, 常 字 *版本) {
    整 i = 找包(名);
    若 (i >= 0) {
        若 (比较字符串(包表[i].版本, 版本)) {
            格式化打印("[冲突] 包 '%s' 出现两个版本: '%s' 与 '%s' —— 保留首个（确定性）\n",
                       名, 包表[i].版本, 版本);
            冲突++;
        }
        返 i;
    }
    若 (包数 >= 包容) { 输出("[错误] 包数超出上限\n"); 缺引++; 返 -1; }
    i = 包数; 包数++;
    复制字符串(包表[i].名, 名);
    复制字符串(包表[i].版本, 版本);
    包表[i].文件[0] = 0;
    包表[i].摘要[0] = 0;
    包表[i].依赖起 = 0;
    包表[i].依赖数 = 0;
    包表[i].状态 = 0;
    返 i;
}

静 空 抄串(整 节, 字 *出, 整 容) {
    出[0] = 0;
    若 (节 < 0) 返;
    若 (JSON类(节) != 类串) 返;
    {
        常 字 *p = JSON串(节);
        整 k = 0;
        循环 (p[k] != 0 && k < 容 - 1) { 出[k] = p[k]; k++; }
        出[k] = 0;
    }
}

/* ============ v0.2: SHA-256 ============ */

/* 大小写不敏感比较（十六进制摘要用） */
静 整 同十六(常 字 *a, 常 字 *b) {
    整 i = 0;
    循环 (a[i] != 0 && b[i] != 0) {
        字 ca = a[i];
        字 cb = b[i];
        若 (ca >= 97 && ca <= 122) ca = ca - 32;
        若 (cb >= 97 && cb <= 122) cb = cb - 32;
        若 (ca != cb) 返 0;
        i++;
    }
    返 (a[i] == 0 && b[i] == 0) ? 1 : 0;
}

/* 算文件摘要（流式，8KB 块；返回 0 成功 / -1 打不开） */
静 整 算摘要(常 字 *路, 字 *出) {
    FILE *f = fopen(路, "rb");
    jy_sha256_ctx ctx;
    unsigned char 块[8192];
    unsigned char d[32];
    整 n;
    出[0] = 0;
    若 (!f) 返 -1;
    jy_sha256_init(&ctx);
    循环 (1) {
        n = (整)fread(块, 1, 8192, f);
        若 (n <= 0) 断;
        jy_sha256_update(&ctx, 块, (unsigned long)n);
    }
    fclose(f);
    jy_sha256_final(&ctx, d);
    jy_sha256_hex(d, 出);
    返 0;
}

/* ============ 依赖接线 ============ */

静 空 接依赖(整 包序, 整 数组节) {
    整 n; 整 k;
    若 (包序 < 0) 返;
    若 (数组节 < 0) { 包表[包序].依赖起 = 依池用; 包表[包序].依赖数 = 0; 返; }
    n = JSON长(数组节);
    包表[包序].依赖起 = 依池用;
    包表[包序].依赖数 = 0;
    遍 (k = 0; k < n; k++) {
        整 e = JSON子(数组节, k);
        常 字 *名;
        整 j;
        若 (e < 0) 续;
        名 = JSON串(e);
        若 (JSON类(e) != 类串) { 格式化打印("[错误] 依赖项必须是字符串: 第 %d 项\n", k); 缺引++; 续; }
        j = 找包(名);
        若 (j < 0) { 格式化打印("[错误] 依赖引用了未定义的包: '%s'\n", 名); 缺引++; 续; }
        若 (依池用 < 依容) { 依赖池[依池用] = j; 依池用++; 包表[包序].依赖数++; }
    }
}

静 整 装包(整 根) {
    整 表 = JSON取(根, "包表");
    整 n; 整 k; 整 根名; 整 根版; 整 r;
    若 (表 < 0) { 输出("[错误] 清单缺少 '包表' 数组\n"); 返 -1; }
    n = JSON长(表);

    /* 阶段 1: 先登记全部包（依赖可以引用后文定义的包） */
    遍 (k = 0; k < n; k++) {
        整 e = JSON子(表, k);
        整 名节;
        整 版节;
        整 我;
        若 (e < 0) 续;
        名节 = JSON取(e, "名");
        若 (名节 < 0) { 格式化打印("[错误] 包表 第 %d 项缺少 '名'\n", k + 1); 缺引++; 续; }
        版节 = JSON取(e, "版本");
        我 = 登包(JSON串(名节), (版节 >= 0) ? JSON串(版节) : "0.0.0");
        若 (我 >= 0) {
            抄串(JSON取(e, "文件"), 包表[我].文件, 路长);
            抄串(JSON取(e, "摘要"), 包表[我].摘要, 80);
        }
    }

    /* 阶段 2: 再接线（此时全表已登记） */
    遍 (k = 0; k < n; k++) {
        整 e = JSON子(表, k);
        整 名节;
        整 我;
        若 (e < 0) 续;
        名节 = JSON取(e, "名");
        若 (名节 < 0) 续;
        我 = 找包(JSON串(名节));
        接依赖(我, JSON取(e, "依赖"));
    }

    /* 根包（清单本身）作为虚拟节点入表 */
    根名 = JSON取(根, "包");
    根版 = JSON取(根, "版本");
    r = 登包((根名 >= 0) ? JSON串(根名) : "根", (根版 >= 0) ? JSON串(根版) : "0.0.0");
    接依赖(r, JSON取(根, "依赖"));
    返 r;
}

/* ============ 拓扑排序 + 环检测（后序 DFS ⟹ 依赖必在前）============ */

静 空 深访(整 i) {
    整 k;
    若 (i < 0 || i >= 包数) 返;
    若 (包表[i].状态 == 1) {
        有环 = 1;
        格式化打印("[错误] 检测到循环依赖：回边指向包 '%s'\n", 包表[i].名);
        返;
    }
    若 (包表[i].状态 == 2) 返;
    包表[i].状态 = 1;
    遍 (k = 0; k < 包表[i].依赖数; k++) 深访(依赖池[包表[i].依赖起 + k]);
    包表[i].状态 = 2;
    若 (拓扑数 < 包容) { 拓扑[拓扑数] = i; 拓扑数++; }
}

/* ============ 出锁 ============ */

静 空 出锁(整 根Idx) {
    整 k;
    出位 = 0; 出缓[0] = 0;
    拼("{\"锁版本\":1,\"根\":\"");
    拼(包表[根Idx].名);
    拼("\",\"根版本\":\"");
    拼(包表[根Idx].版本);
    拼("\",\"包数\":");
    拼数(拓扑数);
    拼(",\"生成序\":[");
    遍 (k = 0; k < 拓扑数; k++) {
        整 p = 拓扑[k];
        若 (k > 0) 拼(",");
        拼("\n  {\"序\":");
        拼数(k + 1);
        拼(",\"名\":\"");
        拼(包表[p].名);
        拼("\",\"版本\":\"");
        拼(包表[p].版本);
        拼("\"");
        若 (包表[p].摘要[0]) { 拼(",\"摘要\":\""); 拼(包表[p].摘要); 拼("\""); }
        拼("}");
    }
    若 (拓扑数 > 0) 拼("\n");
    拼("]}\n");
    输出(出缓);
}

/* ============ 子命令: 锁 ============ */

静 整 做锁(常 字 *路) {
    整 n; 整 根; 整 r; 整 冲突旧;
    n = 读全文(路);
    若 (n < 0) { 格式化打印("[错误] 读不到清单文件: %s\n", 路); 返 2; }

    JSON重置();
    根 = JSON解析(源文);
    若 (JSON错() || 根 < 0) { 格式化打印("[错误] 清单 JSON 解析失败（%d 字节）\n", n); 返 3; }

    冲突旧 = 冲突;
    r = 装包(根);
    若 (r < 0) 返 3;
    深访(r);

    若 (有环) { 输出("[错误] 依赖图存在环 —— 拒绝生成锁文件\n"); 返 4; }
    若 (缺引) { 格式化打印("[错误] 存在 %d 处未定义依赖引用 —— 拒绝生成锁文件\n", 缺引); 返 4; }

    出锁(r);
    若 (冲突 > 冲突旧) 格式化打印("[警告] %d 处版本冲突（已保留首个版本）\n", 冲突 - 冲突旧);
    格式化打印("[OK] 包数 %d · 拓扑序长度 %d\n", 包数, 拓扑数);
    返 0;
}

/* ============ 子命令: 校验（v0.2）============ */

静 整 做校验(常 字 *路) {
    整 n; 整 根; 整 表; 整 项; 整 k;
    n = 读全文(路);
    若 (n < 0) { 格式化打印("[错误] 读不到清单文件: %s\n", 路); 返 2; }

    JSON重置();
    根 = JSON解析(源文);
    若 (JSON错() || 根 < 0) { 格式化打印("[错误] 清单 JSON 解析失败（%d 字节）\n", n); 返 3; }

    表 = JSON取(根, "包表");
    若 (表 < 0) { 输出("[错误] 清单缺少 '包表' 数组\n"); 返 3; }
    项 = JSON长(表);

    输出("========================================\n");
    格式化打印("甲言包管理器 · SHA-256 完整性校验 · %d 项\n", 项);
    输出("========================================\n");

    遍 (k = 0; k < 项; k++) {
        整 e = JSON子(表, k);
        字 名[名长];
        字 文[路长];
        字 期[80];
        字 实[80];
        整 rc;
        若 (e < 0) 续;
        抄串(JSON取(e, "名"), 名, 名长);
        抄串(JSON取(e, "文件"), 文, 路长);
        抄串(JSON取(e, "摘要"), 期, 80);
        若 (!文[0]) { 格式化打印("  [跳过] %s —— 未声明『文件』\n", 名); 续; }
        若 (!期[0]) { 格式化打印("  [跳过] %s —— 未声明『摘要』\n", 名); 续; }
        rc = 算摘要(文, 实);
        若 (rc != 0) {
            格式化打印("  [失败] %s · 文件不存在或不可读: %s\n", 名, 文);
            文件缺++;
            续;
        }
        若 (同十六(期, 实)) {
            格式化打印("  [通过] %s · %s · %s\n", 名, 文, 实);
            摘要对++;
        } 否 {
            格式化打印("  [失败] %s · 摘要不符\n", 名);
            格式化打印("         期望 %s\n", 期);
            格式化打印("         实得 %s\n", 实);
            摘要错++;
        }
    }

    输出("----------------------------------------\n");
    格式化打印("通过 %d · 不符 %d · 缺文件 %d\n", 摘要对, 摘要错, 文件缺);
    若 (摘要对 == 0 && 摘要错 == 0 && 文件缺 == 0) {
        输出("[提示] 清单里没有任何可校验项（需同时给出『文件』与『摘要』）\n");
        返 6;
    }
    若 (摘要错 > 0 || 文件缺 > 0) { 输出("[错误] 完整性校验未通过\n"); 返 5; }
    输出("[OK] 完整性校验全部通过\n");
    返 0;
}

/* ============ 主 ============ */

静 空 用法() {
    输出("用法: jy_pkg.exe <清单.json>            # 生成锁文件\n");
    输出("      jy_pkg.exe lock  <清单.json>       # 同上（ASCII 子命令，见下）\n");
    输出("      jy_pkg.exe check <清单.json>       # SHA-256 完整性校验\n");
    输出("      jy_pkg.exe index <目录>            # v0.3 扫描包目录 → 生成索引 JSON\n");
    输出("      jy_pkg.exe install <清单> <仓库>   # v0.5 全链：扫仓库 → 约束求解 → 出锁\n");
    输出("      jy_pkg.exe verify <锁> <仓库>      # v0.7 核锁：锁要求的版本仓库里是否都有\n");
    输出("      jy_pkg.exe select <清单> <索引>     # v0.4 版本约束求解\n");
    输出("      jy_pkg.exe 锁   <清单.json>        # 中文子命令（依赖终端 argv 编码为 UTF-8）\n");
    输出("      jy_pkg.exe 校验 <清单.json>        # 同上\n");
    输出("      jy_pkg.exe 索引 <目录>             # 同上\n");
    输出("注: Windows 的 argv 是 ANSI(GBK) 编码，而源码字面量是 UTF-8 ⟹ 中文子命令在 cmd 下匹配不上；\n");
    输出("    故同时提供 ASCII 别名 lock / check —— 命令行请优先用 ASCII 版。\n");
}

整 主(整 数, 字 **参) {
    若 (数 < 2) { 用法(); 返 2; }
    若 (!比较字符串(参[1], "索引") || !比较字符串(参[1], "index")) {
        整 源位;
        整 宽位;
        整 找句;
        整 续找;
        整 条目;
        整 k;
        整 k2;
        整 名位;
        整 分隔位;
        整 段长;
        无符号 整 c;
        无符号 整 w;
        字 名一[260];
        字 包名一[128];
        字 版本一[64];
        字 缓[64];
        常 字 *s;

        若 (数 < 3) { 用法(); 返 2; }

        /* --- 1. UTF-8 目录路径 → UTF-16 模式串（尾部加 \* ）--- */
        源位 = 0; 宽位 = 0;
        循环 (参[2][源位] != 0 && 宽位 < 500) {
            c = (无符号 字)参[2][源位];
            段长 = 1;
            若 (c >= 240) { c = c & 7; 段长 = 4; }
            否 若 (c >= 224) { c = c & 15; 段长 = 3; }
            否 若 (c >= 192) { c = c & 31; 段长 = 2; }
            遍 (k = 1; k < 段长; k++) {
                源位++;
                若 (参[2][源位] == 0) 断;
                c = (c << 6) | ((无符号 字)参[2][源位] & 63);
            }
            源位++;
            宽模[宽位] = (短)c; 宽位++;
        }
        宽模[宽位] = 92; 宽位++;      /* \ */
        宽模[宽位] = 42; 宽位++;      /* * */
        宽模[宽位] = 0;

        /* --- 2. 扫描 --- */
        索位 = 0;
        条目 = 0;
        s = "{\"目录\":\"";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        遍 (k2 = 0; 参[2][k2] != 0; k2++) { 索引出[索位] = 参[2][k2]; 索位++; }
        s = "\",\"包\":[";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }

        找句 = (整)FindFirstFileW(宽模, &找据);
        若 (找句 == -1) { 格式化打印("[错误] 打不开目录: %s\n", 参[2]); 返 2; }

        续找 = 1;
        循环 (续找) {
            /* 只要目录 · 跳过 . 与 .. （首字符 46 = '.'）*/
            若 (找据.文件名[0] != 46 && (找据.属性 & 16) != 0) {
                /* UTF-16 → UTF-8（算术，无表）*/
                名位 = 0;
                遍 (k = 0; 找据.文件名[k] != 0 && 名位 < 250; k++) {
                    w = (无符号 短)找据.文件名[k];
                    若 (w < 128) { 名一[名位] = (字)w; 名位++; }
                    否 若 (w < 2048) {
                        名一[名位] = (字)(192 | (w >> 6)); 名位++;
                        名一[名位] = (字)(128 | (w & 63)); 名位++;
                    } 否 {
                        名一[名位] = (字)(224 | (w >> 12)); 名位++;
                        名一[名位] = (字)(128 | ((w >> 6) & 63)); 名位++;
                        名一[名位] = (字)(128 | (w & 63)); 名位++;
                    }
                }
                名一[名位] = 0;

                /* 解析「名-版本」—— 按最后一个 '-'（45）切 */
                分隔位 = -1;
                遍 (k = 0; 名一[k] != 0; k++) 若 (名一[k] == 45) 分隔位 = k;
                若 (分隔位 > 0) {
                    遍 (k = 0; k < 分隔位; k++) 包名一[k] = 名一[k];
                    包名一[分隔位] = 0;
                    遍 (k = 0; 名一[分隔位 + 1 + k] != 0 && k < 60; k++) 版本一[k] = 名一[分隔位 + 1 + k];
                    版本一[k] = 0;
                } 否 {
                    复制字符串(包名一, 名一);
                    复制字符串(版本一, "0.0.0");
                }

                /* 拼条目 */
                若 (条目 > 0) { 索引出[索位] = 44; 索位++; }
                s = "{\"名\":\"";
                遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
                遍 (k2 = 0; 包名一[k2] != 0; k2++) { 索引出[索位] = 包名一[k2]; 索位++; }
                s = "\",\"版本\":\"";
                遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
                遍 (k2 = 0; 版本一[k2] != 0; k2++) { 索引出[索位] = 版本一[k2]; 索位++; }
                s = "\",\"目录\":\"";
                遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
                遍 (k2 = 0; 名一[k2] != 0; k2++) { 索引出[索位] = 名一[k2]; 索位++; }
                s = "\"}";
                遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
                条目++;
            }
            续找 = FindNextFileW(找句, &找据);
            若 (续找 == 0) 断;
        }
        FindClose(找句);

        s = "],\"包数\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        格式化到串(缓, "%d", 条目);
        遍 (k2 = 0; 缓[k2] != 0; k2++) { 索引出[索位] = 缓[k2]; 索位++; }
        索引出[索位] = 125; 索位++;      /* } */
        索引出[索位] = 10; 索位++;       /* \n */
        索引出[索位] = 0;

        输出(索引出);
        格式化打印("[OK] 扫描到 %d 个包目录（跳过以 . 开头的）\n", 条目);
        返 0;
    }

    /* ===== v0.4：版本约束求解 =====
     * 用法：jy_pkg.exe 选 <清单.json> <索引.json>
     * 约束语法：^1.2.3（同主版本且>=） ~1.2.3（同主同次且>=） >=X >X <=X <X =X  裸版本=精确  *或空=任意
     * ⚠️ jyjson 单池 ⟹ 清单与索引不能同时持有 ⟹ 两阶段：先拷依赖，再重置，再解析索引 */
    /* ===== v0.7：锁反向校验（核锁）=====
     * 用法：jy_pkg.exe 核锁 <锁.json> <仓库目录>
     * 拿锁去核仓库：锁里每个「名-版本」在仓库里是否存在 ⟹ 这是「可复现安装」的判据 */
    若 (!比较字符串(参[1], "核锁") || !比较字符串(参[1], "verify")) {
        整 n1;
        整 根1;
        整 序节;
        整 条;
        整 k;
        整 k2;
        整 k3;
        整 名节;
        整 版节;
        整 源位;
        整 宽位;
        整 找句;
        整 续找;
        整 名位;
        整 分隔位;
        整 段长;
        整 m;
        整 缺数;
        整 找;
        字 名一[260];
        字 包名一[128];
        字 版本一[64];
        无符号 整 c;
        无符号 整 w;
        常 字 *s;

        若 (数 < 4) { 用法(); 返 2; }

        /* ---- 1. 读锁，把生成序拷进数组 ---- */
        n1 = 读全文(参[2]);
        若 (n1 < 0) { 格式化打印("[错误] 读不到锁文件: %s\n", 参[2]); 返 2; }
        JSON重置();
        根1 = JSON解析(源文);
        若 (JSON错() || 根1 < 0) { 输出("[错误] 锁 JSON 解析失败\n"); 返 3; }
        序节 = JSON取(根1, "生成序");
        若 (序节 < 0) { 输出("[错误] 锁缺少 '生成序'\n"); 返 3; }
        条 = JSON长(序节);
        锁条数 = 0;
        遍 (k = 0; k < 条 && 锁条数 < 64; k++) {
            整 e = JSON子(序节, k);
            若 (e < 0) 续;
            名节 = JSON取(e, "名");
            版节 = JSON取(e, "版本");
            若 (名节 >= 0 && 版节 >= 0 && JSON类(名节) == 类串 && JSON类(版节) == 类串) {
                s = JSON串(名节);
                遍 (k2 = 0; s[k2] != 0 && k2 < 120; k2++) 锁名[锁条数][k2] = s[k2];
                锁名[锁条数][k2] = 0;
                s = JSON串(版节);
                遍 (k2 = 0; s[k2] != 0 && k2 < 60; k2++) 锁版[锁条数][k2] = s[k2];
                锁版[锁条数][k2] = 0;
                锁条数++;
            }
        }

        /* ---- 2. 扫仓库（同 装 的扫描，直接写数组）---- */
        源位 = 0; 宽位 = 0;
        循环 (参[3][源位] != 0 && 宽位 < 500) {
            c = (无符号 字)参[3][源位];
            段长 = 1;
            若 (c >= 240) { c = c & 7; 段长 = 4; }
            否 若 (c >= 224) { c = c & 15; 段长 = 3; }
            否 若 (c >= 192) { c = c & 31; 段长 = 2; }
            遍 (k3 = 1; k3 < 段长; k3++) {
                源位++;
                若 (参[3][源位] == 0) 断;
                c = (c << 6) | ((无符号 字)参[3][源位] & 63);
            }
            源位++;
            宽模[宽位] = (短)c; 宽位++;
        }
        宽模[宽位] = 92; 宽位++;
        宽模[宽位] = 42; 宽位++;
        宽模[宽位] = 0;

        仓数 = 0;
        找句 = (整)FindFirstFileW(宽模, &找据);
        若 (找句 == -1) { 格式化打印("[错误] 打不开仓库目录: %s\n", 参[3]); 返 2; }
        续找 = 1;
        循环 (续找) {
            若 (找据.文件名[0] != 46 && (找据.属性 & 16) != 0) {
                名位 = 0;
                遍 (k3 = 0; 找据.文件名[k3] != 0 && 名位 < 250; k3++) {
                    w = (无符号 短)找据.文件名[k3];
                    若 (w < 128) { 名一[名位] = (字)w; 名位++; }
                    否 若 (w < 2048) {
                        名一[名位] = (字)(192 | (w >> 6)); 名位++;
                        名一[名位] = (字)(128 | (w & 63)); 名位++;
                    } 否 {
                        名一[名位] = (字)(224 | (w >> 12)); 名位++;
                        名一[名位] = (字)(128 | ((w >> 6) & 63)); 名位++;
                        名一[名位] = (字)(128 | (w & 63)); 名位++;
                    }
                }
                名一[名位] = 0;
                分隔位 = -1;
                遍 (k3 = 0; 名一[k3] != 0; k3++) 若 (名一[k3] == 45) 分隔位 = k3;
                若 (分隔位 > 0) {
                    遍 (k3 = 0; k3 < 分隔位; k3++) 包名一[k3] = 名一[k3];
                    包名一[分隔位] = 0;
                    遍 (k3 = 0; 名一[分隔位 + 1 + k3] != 0 && k3 < 60; k3++) 版本一[k3] = 名一[分隔位 + 1 + k3];
                    版本一[k3] = 0;
                } 否 {
                    复制字符串(包名一, 名一);
                    复制字符串(版本一, "0.0.0");
                }
                若 (仓数 < 512) {
                    复制字符串(仓名[仓数], 包名一);
                    复制字符串(仓版[仓数], 版本一);
                    仓数++;
                }
            }
            续找 = FindNextFileW(找句, &找据);
            若 (续找 == 0) 断;
        }
        FindClose(找句);

        /* ---- 3. 逐条核对 ---- */
        缺数 = 0;
        遍 (k = 0; k < 锁条数; k++) {
            找 = 0;
            遍 (m = 0; m < 仓数; m++) {
                若 (!比较字符串(仓名[m], 锁名[k]) && !比较字符串(仓版[m], 锁版[k])) { 找 = 1; 断; }
            }
            若 (!找) {
                缺数++;
                格式化打印("[缺失] 锁要求 %s %s —— 仓库里没有\n", 锁名[k], 锁版[k]);
            } 否 {
                格式化打印("[在]   %s %s\n", 锁名[k], 锁版[k]);
            }
        }
        格式化打印("---\n锁条目 %d · 仓库 %d 个包目录 · 缺失 %d\n", 锁条数, 仓数, 缺数);
        若 (缺数 > 0) { 格式化打印("[错误] 锁与仓库不符 —— 无法复现安装\n"); 返 8; }
        输出("[OK] 锁与仓库完全吻合\n");
        返 0;
    }

    /* ===== v0.5：全链打通（装）=====
     * 用法：jy_pkg.exe 装 <清单.json> <仓库目录>
     * 一条命令走完：读清单 → 扫仓库 → 版本约束求解 → 出锁文件
     * 设计：扫描结果直接写进【数组】而不经过 JSON ⟹ 避开 jyjson 单池约束，且少一次序列化 ✓ */
    若 (!比较字符串(参[1], "装") || !比较字符串(参[1], "install")) {
        整 n1;
        整 根1;
        整 表1;
        整 e;
        整 k;
        整 k2;
        整 名节;
        整 约节;
        整 根节;
        整 源位;
        整 宽位;
        整 找句;
        整 续找;
        整 名位;
        整 分隔位;
        整 段长;
        整 d;
        整 m;
        整 dd;
        整 依节;
        整 依个;
        整 q;
        整 依项;
        常 字 *依串;
        整 三段[3];
        整 约段[3];
        整 佳段[3];
        整 i;
        整 v;
        整 kk;
        整 满足;
        整 选中;
        整 失败;
        字 名一[260];
        字 包名一[128];
        字 版本一[64];
        字 佳版[64];
        字 缓[64];
        无符号 整 c;
        无符号 整 w;
        常 字 *s;
        常 字 *约束串;
        常 字 *版本串;

        若 (数 < 4) { 用法(); 返 2; }

        /* ---- 阶段 1：读清单，把「名 + 约束」拷进数组（记录根包名）---- */
        n1 = 读全文(参[2]);
        若 (n1 < 0) { 格式化打印("[错误] 读不到清单: %s\n", 参[2]); 返 2; }
        JSON重置();
        根1 = JSON解析(源文);
        若 (JSON错() || 根1 < 0) { 输出("[错误] 清单 JSON 解析失败\n"); 返 3; }
        根包名[0] = 0;
        根节 = JSON取(根1, "包");
        若 (根节 >= 0 && JSON类(根节) == 类串) {
            s = JSON串(根节);
            遍 (k2 = 0; s[k2] != 0 && k2 < 120; k2++) 根包名[k2] = s[k2];
            根包名[k2] = 0;
        }
        表1 = JSON取(根1, "包表");
        若 (表1 < 0) { 输出("[错误] 清单缺少 '包表'\n"); 返 3; }
        n1 = JSON长(表1);
        依数 = 0;
        遍 (k = 0; k < n1 && 依数 < 64; k++) {
            e = JSON子(表1, k);
            若 (e < 0) 续;
            名节 = JSON取(e, "名");
            约节 = JSON取(e, "约束");
            若 (名节 >= 0 && 约节 >= 0 && JSON类(名节) == 类串 && JSON类(约节) == 类串) {
                s = JSON串(名节);
                遍 (k2 = 0; s[k2] != 0 && k2 < 120; k2++) 依名[依数][k2] = s[k2];
                依名[依数][k2] = 0;
                s = JSON串(约节);
                遍 (k2 = 0; s[k2] != 0 && k2 < 60; k2++) 依约[依数][k2] = s[k2];
                依约[依数][k2] = 0;
                /* 拷本包的依赖名列表（拓扑序用）*/
                依赖个数[依数] = 0;
                依节 = JSON取(e, "依赖");
                若 (依节 >= 0) {
                    依个 = JSON长(依节);
                    遍 (q = 0; q < 依个 && q < 8; q++) {
                        依项 = JSON子(依节, q);
                        若 (依项 < 0) 续;
                        依串 = JSON串(依项);
                        遍 (k2 = 0; 依串[k2] != 0 && k2 < 60; k2++) 依赖名[依数][q][k2] = 依串[k2];
                        依赖名[依数][q][k2] = 0;
                        依赖个数[依数]++;
                    }
                }
                依数++;
            }
        }

        /* ---- 阶段 2：扫仓库目录 ⟹ 直接写数组 ---- */
        源位 = 0; 宽位 = 0;
        循环 (参[3][源位] != 0 && 宽位 < 500) {
            c = (无符号 字)参[3][源位];
            段长 = 1;
            若 (c >= 240) { c = c & 7; 段长 = 4; }
            否 若 (c >= 224) { c = c & 15; 段长 = 3; }
            否 若 (c >= 192) { c = c & 31; 段长 = 2; }
            遍 (k = 1; k < 段长; k++) {
                源位++;
                若 (参[3][源位] == 0) 断;
                c = (c << 6) | ((无符号 字)参[3][源位] & 63);
            }
            源位++;
            宽模[宽位] = (短)c; 宽位++;
        }
        宽模[宽位] = 92; 宽位++;
        宽模[宽位] = 42; 宽位++;
        宽模[宽位] = 0;

        仓数 = 0;
        找句 = (整)FindFirstFileW(宽模, &找据);
        若 (找句 == -1) { 格式化打印("[错误] 打不开仓库目录: %s\n", 参[3]); 返 2; }
        续找 = 1;
        循环 (续找) {
            若 (找据.文件名[0] != 46 && (找据.属性 & 16) != 0) {
                名位 = 0;
                遍 (k = 0; 找据.文件名[k] != 0 && 名位 < 250; k++) {
                    w = (无符号 短)找据.文件名[k];
                    若 (w < 128) { 名一[名位] = (字)w; 名位++; }
                    否 若 (w < 2048) {
                        名一[名位] = (字)(192 | (w >> 6)); 名位++;
                        名一[名位] = (字)(128 | (w & 63)); 名位++;
                    } 否 {
                        名一[名位] = (字)(224 | (w >> 12)); 名位++;
                        名一[名位] = (字)(128 | ((w >> 6) & 63)); 名位++;
                        名一[名位] = (字)(128 | (w & 63)); 名位++;
                    }
                }
                名一[名位] = 0;
                分隔位 = -1;
                遍 (k = 0; 名一[k] != 0; k++) 若 (名一[k] == 45) 分隔位 = k;
                若 (分隔位 > 0) {
                    遍 (k = 0; k < 分隔位; k++) 包名一[k] = 名一[k];
                    包名一[分隔位] = 0;
                    遍 (k = 0; 名一[分隔位 + 1 + k] != 0 && k < 60; k++) 版本一[k] = 名一[分隔位 + 1 + k];
                    版本一[k] = 0;
                } 否 {
                    复制字符串(包名一, 名一);
                    复制字符串(版本一, "0.0.0");
                }
                若 (仓数 < 512) {
                    复制字符串(仓名[仓数], 包名一);
                    复制字符串(仓版[仓数], 版本一);
                    仓数++;
                }
            }
            续找 = FindNextFileW(找句, &找据);
            若 (续找 == 0) 断;
        }
        FindClose(找句);

        /* ---- 阶段 3：版本约束求解（数据源 = 扫描数组）---- */
        失败 = 0;
        遍 (d = 0; d < 依数; d++) {
            选中 = 0;
            佳版[0] = 0;
            佳段[0] = 0; 佳段[1] = 0; 佳段[2] = 0;
            已选版[d][0] = 0;
            遍 (m = 0; m < 仓数; m++) {
                若 (比较字符串(仓名[m], 依名[d])) 续;
                版本串 = 仓版[m];
                三段[0] = 0; 三段[1] = 0; 三段[2] = 0;
                i = 0; v = 0; kk = 0;
                循环 (版本串[i] != 0 && kk < 3) {
                    若 (版本串[i] >= 48 && 版本串[i] <= 57) v = v * 10 + (版本串[i] - 48);
                    否 若 (版本串[i] == 46) { 三段[kk] = v; kk++; v = 0; }
                    否 断;
                    i++;
                }
                若 (kk < 3) 三段[kk] = v;

                约束串 = 依约[d];
                i = 0;
                若 (约束串[0] == 94 || 约束串[0] == 126 || 约束串[0] == 62 || 约束串[0] == 60 || 约束串[0] == 61) i = 1;
                若 (约束串[i] == 61) i++;
                约段[0] = 0; 约段[1] = 0; 约段[2] = 0;
                v = 0; kk = 0;
                循环 (约束串[i] != 0 && kk < 3) {
                    若 (约束串[i] >= 48 && 约束串[i] <= 57) v = v * 10 + (约束串[i] - 48);
                    否 若 (约束串[i] == 46) { 约段[kk] = v; kk++; v = 0; }
                    否 断;
                    i++;
                }
                若 (kk < 3) 约段[kk] = v;

                满足 = 0;
                若 (约束串[0] == 0 || 约束串[0] == 42) 满足 = 1;
                否 若 (约束串[0] == 94) {
                    若 (三段[0] == 约段[0] && (三段[1] > 约段[1] || (三段[1] == 约段[1] && 三段[2] >= 约段[2]))) 满足 = 1;
                }
                否 若 (约束串[0] == 126) {
                    若 (三段[0] == 约段[0] && 三段[1] == 约段[1] && 三段[2] >= 约段[2]) 满足 = 1;
                }
                否 若 (约束串[0] == 62) {
                    若 (约束串[1] == 61) {
                        若 (三段[0] > 约段[0] || (三段[0] == 约段[0] && (三段[1] > 约段[1] || (三段[1] == 约段[1] && 三段[2] >= 约段[2])))) 满足 = 1;
                    } 否 {
                        若 (三段[0] > 约段[0] || (三段[0] == 约段[0] && (三段[1] > 约段[1] || (三段[1] == 约段[1] && 三段[2] > 约段[2])))) 满足 = 1;
                    }
                }
                否 若 (约束串[0] == 60) {
                    若 (约束串[1] == 61) {
                        若 (三段[0] < 约段[0] || (三段[0] == 约段[0] && (三段[1] < 约段[1] || (三段[1] == 约段[1] && 三段[2] <= 约段[2])))) 满足 = 1;
                    } 否 {
                        若 (三段[0] < 约段[0] || (三段[0] == 约段[0] && (三段[1] < 约段[1] || (三段[1] == 约段[1] && 三段[2] < 约段[2])))) 满足 = 1;
                    }
                }
                否 若 (约束串[0] == 61) {
                    若 (三段[0] == 约段[0] && 三段[1] == 约段[1] && 三段[2] == 约段[2]) 满足 = 1;
                }
                否 {
                    若 (三段[0] == 约段[0] && 三段[1] == 约段[1] && 三段[2] == 约段[2]) 满足 = 1;
                }
                若 (!满足) 续;
                若 (!选中 || 三段[0] > 佳段[0] || (三段[0] == 佳段[0] && (三段[1] > 佳段[1] || (三段[1] == 佳段[1] && 三段[2] > 佳段[2])))) {
                    佳段[0] = 三段[0]; 佳段[1] = 三段[1]; 佳段[2] = 三段[2];
                    复制字符串(佳版, 版本串);
                    选中 = 1;
                }
            }
            若 (选中) 复制字符串(已选版[d], 佳版);
            否 {
                失败++;
                格式化打印("[错误] 仓库里无版本满足约束: %s %s\n", 依名[d], 依约[d]);
            }
        }

        格式化打印("[仓库] %s 扫到 %d 个包目录 · [依赖] %d 个\n", 参[3], 仓数, 依数);
        若 (失败 > 0) { 格式化打印("[错误] %d 个依赖无解 —— 拒绝出锁\n", 失败); 返 7; }

        /* ---- 阶段 3.5：拓扑排序（依赖在前）---- */
        拓扑数 = 0;
        有环 = 0;
        遍 (k = 0; k < 依数; k++) 访态[k] = 0;
        遍 (k = 0; k < 依数; k++) 深访包(k);
        若 (有环) { 输出("[错误] 依赖图存在环 —— 拒绝出锁\n"); 返 7; }
        格式化打印("[拓扑] %d 个依赖已按依赖序排列\n", 拓扑数);

        /* ---- 阶段 4：出锁（按拓扑序 · 手工拼 · 确定）---- */
        索位 = 0;
        s = "{\"锁版本\":1,\"根\":\"";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        遍 (k2 = 0; 根包名[k2] != 0; k2++) { 索引出[索位] = 根包名[k2]; 索位++; }
        s = "\",\"仓库\":\"";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        遍 (k2 = 0; 参[3][k2] != 0; k2++) { 索引出[索位] = 参[3][k2]; 索位++; }
        s = "\",\"包数\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        格式化到串(出缓, "%d", 依数);
        遍 (k2 = 0; 出缓[k2] != 0; k2++) { 索引出[索位] = 出缓[k2]; 索位++; }
        s = ",\"生成序\":[";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        遍 (d = 0; d < 拓扑数; d++) {
            dd = 拓扑序[d];
            若 (d > 0) { 索引出[索位] = 44; 索位++; }
            s = "\n  {\"序\":";
            遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
            格式化到串(出缓, "%d", d + 1);
            遍 (k2 = 0; 出缓[k2] != 0; k2++) { 索引出[索位] = 出缓[k2]; 索位++; }
            s = ",\"名\":\"";
            遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
            遍 (k2 = 0; 依名[dd][k2] != 0; k2++) { 索引出[索位] = 依名[dd][k2]; 索位++; }
            s = "\",\"约束\":\"";
            遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
            遍 (k2 = 0; 依约[dd][k2] != 0; k2++) { 索引出[索位] = 依约[dd][k2]; 索位++; }
            s = "\",\"版本\":\"";
            遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
            遍 (k2 = 0; 已选版[dd][k2] != 0; k2++) { 索引出[索位] = 已选版[dd][k2]; 索位++; }
            s = "\"}";
            遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        }
        s = "\n]}\n";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        索引出[索位] = 0;
        输出(索引出);
        格式化打印("[OK] 全链完成：%d 个依赖已解析并出锁\n", 依数);
        返 0;
    }

    若 (!比较字符串(参[1], "选") || !比较字符串(参[1], "select")) {
        整 n1;
        整 根1;
        整 表1;
        整 n2;
        整 根2;
        整 索包;
        整 d;
        整 k;
        整 k2;
        整 名节;
        整 约节;
        整 e;
        整 em;
        整 三段[3];
        整 约段[3];
        整 佳段[3];
        整 i;
        整 v;
        整 kk;
        整 满足;
        整 选中;
        整 失败;
        字 佳版[64];
        常 字 *s;
        常 字 *约束串;
        常 字 *版本串;

        若 (数 < 4) { 用法(); 返 2; }

        /* ---- 阶段 1：读清单，把「名 + 约束」拷进静态数组 ---- */
        n1 = 读全文(参[2]);
        若 (n1 < 0) { 格式化打印("[错误] 读不到清单: %s\n", 参[2]); 返 2; }
        JSON重置();
        根1 = JSON解析(源文);
        若 (JSON错() || 根1 < 0) { 输出("[错误] 清单 JSON 解析失败\n"); 返 3; }
        表1 = JSON取(根1, "包表");
        若 (表1 < 0) { 输出("[错误] 清单缺少 '包表'\n"); 返 3; }
        n2 = JSON长(表1);
        依数 = 0;
        遍 (k = 0; k < n2 && 依数 < 64; k++) {
            e = JSON子(表1, k);
            若 (e < 0) 续;
            名节 = JSON取(e, "名");
            约节 = JSON取(e, "约束");
            若 (名节 >= 0 && 约节 >= 0 && JSON类(名节) == 类串 && JSON类(约节) == 类串) {
                s = JSON串(名节);
                遍 (k2 = 0; s[k2] != 0 && k2 < 120; k2++) 依名[依数][k2] = s[k2];
                依名[依数][k2] = 0;
                s = JSON串(约节);
                遍 (k2 = 0; s[k2] != 0 && k2 < 60; k2++) 依约[依数][k2] = s[k2];
                依约[依数][k2] = 0;
                依数++;
            }
        }

        /* ---- 阶段 2：重置后读索引 ---- */
        n1 = 读全文(参[3]);
        若 (n1 < 0) { 格式化打印("[错误] 读不到索引: %s\n", 参[3]); 返 2; }
        JSON重置();
        根2 = JSON解析(源文);
        若 (JSON错() || 根2 < 0) { 输出("[错误] 索引 JSON 解析失败\n"); 返 3; }
        索包 = JSON取(根2, "包");
        若 (索包 < 0) { 输出("[错误] 索引缺少 '包'\n"); 返 3; }
        n2 = JSON长(索包);

        /* ---- 阶段 3：逐依赖挑「最高匹配版本」---- */
        索位 = 0;
        s = "{\"依赖数\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        格式化到串(出缓, "%d", 依数);
        遍 (k2 = 0; 出缓[k2] != 0; k2++) { 索引出[索位] = 出缓[k2]; 索位++; }
        s = ",\"已选\":[";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }

        失败 = 0;
        遍 (d = 0; d < 依数; d++) {
            选中 = 0;
            佳版[0] = 0;
            佳段[0] = 0; 佳段[1] = 0; 佳段[2] = 0;

            遍 (k = 0; k < n2; k++) {
                em = JSON子(索包, k);
                若 (em < 0) 续;
                名节 = JSON取(em, "名");
                若 (名节 < 0 || JSON类(名节) != 类串) 续;
                若 (比较字符串(JSON串(名节), 依名[d])) 续;      /* 名字不符 ⟹ 跳 */
                约节 = JSON取(em, "版本");
                若 (约节 < 0 || JSON类(约节) != 类串) 续;
                版本串 = JSON串(约节);

                /* --- 解析版本三段 --- */
                三段[0] = 0; 三段[1] = 0; 三段[2] = 0;
                i = 0; v = 0; kk = 0;
                循环 (版本串[i] != 0 && kk < 3) {
                    若 (版本串[i] >= 48 && 版本串[i] <= 57) v = v * 10 + (版本串[i] - 48);
                    否 若 (版本串[i] == 46) { 三段[kk] = v; kk++; v = 0; }
                    否 断;
                    i++;
                }
                若 (kk < 3) 三段[kk] = v;

                /* --- 解析约束里的版本（跳前缀）--- */
                约束串 = 依约[d];
                i = 0;
                若 (约束串[0] == 94 || 约束串[0] == 126 || 约束串[0] == 62 || 约束串[0] == 60 || 约束串[0] == 61) i = 1;
                若 (约束串[i] == 61) i++;
                约段[0] = 0; 约段[1] = 0; 约段[2] = 0;
                v = 0; kk = 0;
                循环 (约束串[i] != 0 && kk < 3) {
                    若 (约束串[i] >= 48 && 约束串[i] <= 57) v = v * 10 + (约束串[i] - 48);
                    否 若 (约束串[i] == 46) { 约段[kk] = v; kk++; v = 0; }
                    否 断;
                    i++;
                }
                若 (kk < 3) 约段[kk] = v;

                /* --- 判约束 --- */
                满足 = 0;
                若 (约束串[0] == 0 || 约束串[0] == 42) 满足 = 1;
                否 若 (约束串[0] == 94) {      /* ^  同主版本 且 >= */
                    若 (三段[0] == 约段[0] && (三段[1] > 约段[1] || (三段[1] == 约段[1] && 三段[2] >= 约段[2]))) 满足 = 1;
                }
                否 若 (约束串[0] == 126) {     /* ~  同主同次 且 >= */
                    若 (三段[0] == 约段[0] && 三段[1] == 约段[1] && 三段[2] >= 约段[2]) 满足 = 1;
                }
                否 若 (约束串[0] == 62) {      /* > */
                    若 (约束串[1] == 61) {
                        若 (三段[0] > 约段[0] || (三段[0] == 约段[0] && (三段[1] > 约段[1] || (三段[1] == 约段[1] && 三段[2] >= 约段[2])))) 满足 = 1;
                    } 否 {
                        若 (三段[0] > 约段[0] || (三段[0] == 约段[0] && (三段[1] > 约段[1] || (三段[1] == 约段[1] && 三段[2] > 约段[2])))) 满足 = 1;
                    }
                }
                否 若 (约束串[0] == 60) {      /* < */
                    若 (约束串[1] == 61) {
                        若 (三段[0] < 约段[0] || (三段[0] == 约段[0] && (三段[1] < 约段[1] || (三段[1] == 约段[1] && 三段[2] <= 约段[2])))) 满足 = 1;
                    } 否 {
                        若 (三段[0] < 约段[0] || (三段[0] == 约段[0] && (三段[1] < 约段[1] || (三段[1] == 约段[1] && 三段[2] < 约段[2])))) 满足 = 1;
                    }
                }
                否 若 (约束串[0] == 61) {      /* = */
                    若 (三段[0] == 约段[0] && 三段[1] == 约段[1] && 三段[2] == 约段[2]) 满足 = 1;
                }
                否 {                            /* 裸版本 = 精确 */
                    若 (三段[0] == 约段[0] && 三段[1] == 约段[1] && 三段[2] == 约段[2]) 满足 = 1;
                }
                若 (!满足) 续;

                /* --- 比最高 --- */
                若 (!选中 || 三段[0] > 佳段[0] || (三段[0] == 佳段[0] && (三段[1] > 佳段[1] || (三段[1] == 佳段[1] && 三段[2] > 佳段[2])))) {
                    佳段[0] = 三段[0]; 佳段[1] = 三段[1]; 佳段[2] = 三段[2];
                    遍 (k2 = 0; 版本串[k2] != 0 && k2 < 60; k2++) 佳版[k2] = 版本串[k2];
                    佳版[k2] = 0;
                    选中 = 1;
                }
            }

            /* --- 输出该依赖的解析结果 --- */
            若 (d > 0) { 索引出[索位] = 44; 索位++; }   /* 逗号只加在【第 2 条起】—— 用条目计数，别用缓冲区位置 */
            s = "{\"名\":\"";
            遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
            遍 (k2 = 0; 依名[d][k2] != 0; k2++) { 索引出[索位] = 依名[d][k2]; 索位++; }
            s = "\",\"约束\":\"";
            遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
            遍 (k2 = 0; 依约[d][k2] != 0; k2++) { 索引出[索位] = 依约[d][k2]; 索位++; }
            s = "\",\"选中\":";
            遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
            若 (选中) {
                索引出[索位] = 34; 索位++;
                遍 (k2 = 0; 佳版[k2] != 0; k2++) { 索引出[索位] = 佳版[k2]; 索位++; }
                索引出[索位] = 34; 索位++;
            } 否 {
                索引出[索位] = 110; 索位++;   /* n */
                索引出[索位] = 117; 索位++;   /* u */
                索引出[索位] = 108; 索位++;   /* l */
                索引出[索位] = 108; 索位++;   /* l */
                失败++;
                格式化打印("[错误] 无版本满足约束: %s %s\n", 依名[d], 依约[d]);
            }
            索引出[索位] = 125; 索位++;       /* } */
        }

        s = "],\"失败\":";
        遍 (k2 = 0; s[k2] != 0; k2++) { 索引出[索位] = s[k2]; 索位++; }
        格式化到串(出缓, "%d", 失败);
        遍 (k2 = 0; 出缓[k2] != 0; k2++) { 索引出[索位] = 出缓[k2]; 索位++; }
        索引出[索位] = 125; 索位++;          /* } */
        索引出[索位] = 10; 索位++;
        索引出[索位] = 0;

        输出(索引出);
        若 (失败 > 0) { 格式化打印("[错误] %d 个依赖无解 —— 拒绝出锁\n", 失败); 返 7; }
        格式化打印("[OK] %d 个依赖全部解析成功\n", 依数);
        返 0;
    }

    若 (!比较字符串(参[1], "校验") || !比较字符串(参[1], "check")) {
        若 (数 < 3) { 用法(); 返 2; }
        返 做校验(参[2]);
    }
    若 (!比较字符串(参[1], "锁") || !比较字符串(参[1], "lock")) {
        若 (数 < 3) { 用法(); 返 2; }
        返 做锁(参[2]);
    }
    返 做锁(参[1]);
}
