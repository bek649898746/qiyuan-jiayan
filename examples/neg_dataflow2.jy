#包含 <stdio.h>
#包含 <string.h>

判别 字段型 于 { 数值(整 v), 文本(字 *s), 无值() };

函数 错误 可空 整 切分(常 字 *行, 字 *出[], 整 上限) {
    若 (行 == 0)     错 2;
    若 (行[0] == 0)  返 空;
    数据流 整 总长 = (整)strlen(行);
    总长 = 5;
    整 段 = 0, 起 = 0, i = 0;
    循环 (i <= 总长) {
        若 (i == 总长 || 行[i] == 44) {
            若 (段 >= 上限) 错 1;
            出[段] = (字 *)(行 + 起);
            段 = 段 + 1;
            起 = i + 1;
        }
        i = i + 1;
    }
    返 段;
}

函数 字段型 判型(字 *p, 整 止) {
    字段型 果;
    若 (止 <= 0) { 果.tag = 字段型_无值; 返 果; }
    整 k = 0, 全数 = 1;
    循环 (k < 止) {
        若 (p[k] < 48 || p[k] > 57) 全数 = 0;
        k = k + 1;
    }
    若 (全数) { 果.tag = 字段型_数值; 果.v = 止; 返 果; }
    果.tag = 字段型_文本;  果.s = p;
    返 果;
}

函数 整 主(空) {
    常 字 *行集[5] = { "10,abc,30", "7,,9", "x,y,z", "", 0 };
    字 *片[8];
    整 v = -1, t = -1, r = 0;
    整 总行 = 0, 总段 = 0, 空行 = 0, 错行 = 0;
    借用 行集;
    循环 (r < 5) {
        解构(v, t) = 切分(行集[r], 片, 8);
        若 (t == 0) { 总行 = 总行 + 1; 总段 = 总段 + v; }
        否 若 (t == 2) { 空行 = 空行 + 1; }
        否 { 错行 = 错行 + 1; }
        r = r + 1;
    }
    格式化 "非空行 %d · 总段 %d · 空行 %d · 错行 %d\n", 总行, 总段, 空行, 错行;

    字段型 a = 判型("12", 2);
    字段型 b = 判型("ab", 2);
    字段型 c = 判型("", 0);
    整 结 = 0;
    依据 结, a.tag 穷尽 字段型 对照 数值(v): v, 文本(s): 1, 无值(): 0;
    整 结2 = 0;
    依据 结2, b.tag 穷尽 字段型 对照 数值(v): v, 文本(s): 2, 无值(): 0;
    整 结3 = 0;
    依据 结3, c.tag 穷尽 字段型 对照 数值(v): v, 文本(s): 1, 无值(): 3;
    格式化 "判别分派 %d %d %d\n", 结, 结2, 结3;
    返 0;
}
