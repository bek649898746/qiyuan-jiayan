#包含 <stdio.h>

/* 三件事：C 和 Go 都会放过，甲言编译不过。
   本文件是**正例**（全部合法），三个反例各自单独成文件：
     examples/neg_exhaustive.jy   -> A6016 模式匹配非穷尽
     examples/neg_borrow.jy       -> A3001 借用检查 (NLL)
     examples/neg_dataflow.jy     -> A6090 数据流单赋值
*/

结构体 点 { 整 x; };
判别 形 于 { 折(点 *p), 数(整 n), 空无() };

函数 整 面积(形 a) {
    整 r = 0;
    依据 r, a.tag 穷尽 形 对照 折(p): p->x, 数(n): n, 空无(): 0;
    返 r;
}

函数 整 主(空) {
    形 a;  a.tag = 形_数;  a.n = 42;
    格式化 "穷尽分派 : %d\n", 面积(a);

    整 x = 7;
    整 *r = &x;              /* 未写 `借用 x;` => 普通指针，不在 NLL 检查范围（故 x=9 合法） */
    x = 9;
    格式化 "普通指针   : %d\n", *r;

    数据流 整 甲 = 10;        /* 单赋值：此后不可再写 */
    格式化 "单赋值     : %d\n", 甲;

    返 0;
}
