#包含 <stdio.h>
#包含 <string.h>

/* ① C 库直接进安全体系：strstr 的 NULL 就是甲言的可空 —— 零包装、零分配 */
函数 可空 字* 找子串(常 字 *串, 常 字 *子) { 返 strstr(串, 子); }

/* ② 错误联合三态：C 风格签名，Rust 的结果语义 */
函数 错误 可空 整 求长(常 字 *串) {
    若 (串 == 0)     错 2;
    若 (串[0] == 0)  返 空;
    返 (整)strlen(串);
}

函数 整 主(空) {
    常 字 *句 = "道可道，非常道";
    整 v = -1, t = -1;

    可空 字* p = 找子串(句, "非");
    解包 p;
    格式化 "① strstr(中文子串) : %s\n", p;

    解构(v, t) = 求长(句);
    格式化 "② 求长(非空串)     : v=%d t=%d\n", v, t;

    解构(v, t) = 求长("");
    格式化 "③ 求长(空串)       : v=%d t=%d\n", v, t;

    解构(v, t) = 求长(0);
    格式化 "④ 求长(空指针)     : v=%d t=%d\n", v, t;

    返 0;
}
