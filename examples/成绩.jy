/* 学生成绩管理 — 中文生态示例 (单文件)
   纯甲言: 中文关键字 + jystd 中文标准库
   编译: jycc -o 成绩.exe 成绩.jy
   功能: 录入成绩 → 统计 → 分数榜
   seed=828 | 2026-08-06 */
#include <stdio.h>
#include "srclib/jystd.h"

构 学生 { 字 姓名[16]; 整 分数; };

整 主() {
    构 学生 班级[5];
    整 分数[5];
    /* 录入 (字拷 + struct 字段) */
    字拷(班级[0].姓名, "张三"); 班级[0].分数 = 88;
    字拷(班级[1].姓名, "李四"); 班级[1].分数 = 95;
    字拷(班级[2].姓名, "王五"); 班级[2].分数 = 58;
    字拷(班级[3].姓名, "赵六"); 班级[3].分数 = 72;
    字拷(班级[4].姓名, "孙七"); 班级[4].分数 = 100;
    遍 (整 i = 0; i < 5; i++) 分数[i] = 班级[i].分数;
    /* 统计 (中文函数 + 循环) */
    整 最 = 0, 总和 = 0, 及格 = 0;
    遍 (整 i = 0; i < 5; i++) {
        若 (分数[i] > 最) 最 = 分数[i];
        总和 += 分数[i];
        若 (分数[i] >= 60) 及格++;
    }
    printf("最高分: %d\n", 最);
    printf("平均分: %d\n", 总和 / 5);
    printf("及格数: %d/5\n", 及格);
    /* 分数榜 (冒泡降序) */
    遍 (整 i = 0; i < 5; i++) {
        遍 (整 j = 0; j < 5 - 1 - i; j++) {
            若 (分数[j] < 分数[j + 1]) {
                整 暂存 = 分数[j];
                分数[j] = 分数[j + 1];
                分数[j + 1] = 暂存;
            }
        }
    }
    printf("分数榜:\n");
    遍 (整 i = 0; i < 5; i++) {
        printf("  %d. %d 分\n", i + 1, 分数[i]);
    }
    返 0;
}
