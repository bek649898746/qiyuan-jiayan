#包含 <stdio.h>

/* 线程运行时（真实场景换成 pthread_create / CreateThread） */
静 整 累计 = 0;
静 空 干活(整 v) { 累计 += v; }
静 空 thread_create(整 *t, 空 (*fn)(整), 整 arg) { (空)t; fn(arg); }
静 空 thread_join(整 *t) { (空)t; }

函数 整 主(空) {
    整 a = 0, b = 0, c = 0, x = 0, y = 0, 缺省 = 0;

    /* ① 有界通道 FIFO */
    通道 q, 4;
    送 q, 10;  送 q, 20;  送 q, 30;
    收 q, a;   收 q, b;   收 q, c;
    格式化 "通道 FIFO     : %d %d %d\n", a, b, c;

    /* ② select 多路复用：s1 有数据 ⟹ 例0 命中 */
    通道 s1, 4;  通道 s2, 4;
    送 s1, 99;
    择收(就绪(s1), 就绪(s2)) {
        例 0: 收 s1, x;
        例 1: 收 s2, y;
        缺: 缺省++;
    }
    格式化 "select 命中   : x=%d  缺省=%d\n", x, 缺省;

    /* ③ 两通道都空 ⟹ 缺省分支（非阻塞，不会卡住） */
    择收(就绪(s1), 就绪(s2)) {
        例 0: 收 s1, x;
        例 1: 收 s2, y;
        缺: 缺省++;
    }
    格式化 "select 全空   : 缺省=%d（非阻塞）\n", 缺省;

    /* ④ 结构化并发：块退出自动 join 全部子线程 */
    结构化并发 {
        线程 t1 跑 干活, 10;
        线程 t2 跑 干活, 20;
    }
    格式化 "结构化并发    : 累计=%d（块退出已 join）\n", 累计;

    返 0;
}
