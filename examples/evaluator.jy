#包含 <stdio.h>
#包含 <string.h>

/* ============ 表达式求值器（完整优先级链 10 层） ============
   词法 -> 递归下降 -> 三态返回
   运算符编码：单字符用 ASCII；双字符用 1000+
     1001 <<   1002 >>   1003 <=   1004 >=   1005 ==   1006 !=
   ========================================================= */

静 常 字 *源;
静 整 位;

静 空 跳空(空) { 循环 (源[位] == 32 || 源[位] == 9) 位 = 位 + 1; }

/* 取运算符编码；返回 -1 表示没有运算符 */
函数 整 探符(空) {
    跳空();
    字 c = 源[位];
    若 (c == 0) 返 -1;
    字 d = 源[位 + 1];
    若 (c == 60 && d == 60) 返 1001;
    若 (c == 62 && d == 62) 返 1002;
    若 (c == 60 && d == 61) 返 1003;
    若 (c == 62 && d == 61) 返 1004;
    若 (c == 61 && d == 61) 返 1005;
    若 (c == 33 && d == 61) 返 1006;
    返 (整)c;
}
静 空 消符(空) {
    字 c = 源[位];
    字 d = 源[位 + 1];
    若 ((c == 60 && (d == 60 || d == 61)) || (c == 62 && (d == 62 || d == 61)) || ((c == 61 || c == 33) && d == 61)) 位 = 位 + 2;
    否 位 = 位 + 1;
}

/* ---- ① 原级：数 / 括号 ---- */
函数 整 原级(整 *坏) {
    跳空();
    若 (源[位] == 40) {                      /* '(' */
        位 = 位 + 1;
        整 v = 0;  /* 前向声明靠占位 */
        返 0;   /* 由 加层 覆盖，占位 */
    }
    若 (源[位] < 48 || 源[位] > 57) { *坏 = 1; 返 0; }
    整 v = 0;
    循环 (源[位] >= 48 && 源[位] <= 57) { v = v * 10 + (源[位] - 48); 位 = 位 + 1; }
    返 v;
}

/* 前向：加层（供括号内递归） */
函数 整 加层(整 *坏);

函数 整 原级2(整 *坏) {
    跳空();
    若 (源[位] == 40) {
        位 = 位 + 1;
        整 v = 加层(坏);
        跳空();
        若 (源[位] != 41) { *坏 = 2; 返 0; }
        位 = 位 + 1;
        返 v;
    }
    若 (源[位] < 48 || 源[位] > 57) { *坏 = 1; 返 0; }
    整 v = 0;
    循环 (源[位] >= 48 && 源[位] <= 57) { v = v * 10 + (源[位] - 48); 位 = 位 + 1; }
    返 v;
}

/* ---- ② 乘除余 ---- */
函数 整 乘层(整 *坏) {
    整 v = 原级2(坏);
    若 (*坏) 返 0;
    循环 (1) {
        整 op = 探符();
        若 (op != 42 && op != 47 && op != 37) 断;
        消符();
        整 r = 原级2(坏);
        若 (*坏) 返 0;
        若 (op == 42)      v = v * r;
        否 若 (op == 47)   v = v / r;
        否                 v = v % r;
    }
    返 v;
}

/* ---- ③ 加减 ---- */
函数 整 加层(整 *坏) {
    整 v = 乘层(坏);
    若 (*坏) 返 0;
    循环 (1) {
        整 op = 探符();
        若 (op != 43 && op != 45) 断;
        消符();
        整 r = 乘层(坏);
        若 (*坏) 返 0;
        若 (op == 43) v = v + r;  否 v = v - r;
    }
    返 v;
}

/* ---- ④ 移位 ---- */
函数 整 移层(整 *坏) {
    整 v = 加层(坏);
    若 (*坏) 返 0;
    循环 (1) {
        整 op = 探符();
        若 (op != 1001 && op != 1002) 断;
        消符();
        整 r = 加层(坏);
        若 (*坏) 返 0;
        若 (op == 1001) v = v << r;  否 v = v >> r;
    }
    返 v;
}

/* ---- ⑤ 关系 ---- */
函数 整 关层(整 *坏) {
    整 v = 移层(坏);
    若 (*坏) 返 0;
    循环 (1) {
        整 op = 探符();
        若 (op != 60 && op != 62 && op != 1003 && op != 1004) 断;
        消符();
        整 r = 移层(坏);
        若 (*坏) 返 0;
        若 (op == 60)        v = (v < r);
        否 若 (op == 62)     v = (v > r);
        否 若 (op == 1003)   v = (v <= r);
        否                   v = (v >= r);
    }
    返 v;
}

/* ---- ⑥ 相等 ---- */
函数 整 等层(整 *坏) {
    整 v = 关层(坏);
    若 (*坏) 返 0;
    循环 (1) {
        整 op = 探符();
        若 (op != 1005 && op != 1006) 断;
        消符();
        整 r = 关层(坏);
        若 (*坏) 返 0;
        若 (op == 1005) v = (v == r);  否 v = (v != r);
    }
    返 v;
}

/* ---- ⑦ 与 ---- */
函数 整 与层(整 *坏) {
    整 v = 等层(坏);
    若 (*坏) 返 0;
    循环 (1) {
        整 op = 探符();
        若 (op != 38) 断;
        消符();
        整 r = 等层(坏);
        若 (*坏) 返 0;
        v = v & r;
    }
    返 v;
}

/* ---- ⑧ 异或 ---- */
函数 整 异层(整 *坏) {
    整 v = 与层(坏);
    若 (*坏) 返 0;
    循环 (1) {
        整 op = 探符();
        若 (op != 94) 断;
        消符();
        整 r = 与层(坏);
        若 (*坏) 返 0;
        v = v ^ r;
    }
    返 v;
}

/* ---- ⑨ 或 ---- */
函数 整 或层(整 *坏) {
    整 v = 异层(坏);
    若 (*坏) 返 0;
    循环 (1) {
        整 op = 探符();
        若 (op != 124) 断;
        消符();
        整 r = 异层(坏);
        若 (*坏) 返 0;
        v = v | r;
    }
    返 v;
}

函数 错误 可空 整 求值(常 字 *式) {
    若 (式 == 0)      错 2;
    若 (式[0] == 0)   返 空;
    源 = 式;  位 = 0;
    整 坏 = 0;
    整 v = 或层(&坏);
    跳空();
    若 (坏 != 0)      错 3;
    若 (源[位] != 0)  错 4;
    返 v;
}

判别 归类 于 { 布尔型(), 数值型(整 v), 出错型(整 码) };

函数 归类 分类(整 v, 整 t) {
    归类 果;
    若 (t != 0) { 果.tag = 归类_出错型; 果.码 = v; 返 果; }
    若 (v >= 0 && v <= 1) { 果.tag = 归类_布尔型; 返 果; }
    果.tag = 归类_数值型;  果.v = v;
    返 果;
}

函数 整 主(空) {
    常 字 *集[10] = {
        "1+2*3",            /* 7 */
        "(1+2)*3",          /* 9 */
        "10-4-3",           /* 3  (左结合) */
        "16>>1+1",          /* 4  (移位低于加) */
        "1<<3",             /* 8 */
        "5&3",              /* 1 */
        "5|3",              /* 7 */
        "5^3",              /* 6 */
        "1+2<4",            /* 1  (比较最低之一) */
        "2*(3+",            /* 错：括号未闭合 */
    };
    整 k = 0, v = -1, t = -1;
    循环 (k < 10) {
        解构(v, t) = 求值(集[k]);
        若 (t == 0)      格式化 "%-12s = %d\\n", 集[k], v;
        否 若 (t == 2)   { 格式化 "%-12s = <空>\\n", 集[k], 0; }
        否               { 格式化 "%-12s = <错 码=%d>\\n", 集[k], v; }
        k = k + 1;
    }
    /* 穷尽分派统计：漏一个变体编译不过 */
    整 数 = 0, 布 = 0, 出 = 0, m = 0, vv = -1, tt = -1;
    循环 (m < 10) {
        解构(vv, tt) = 求值(集[m]);
        归类 gg = 分类(vv, tt);
        整 码位 = 0;
        依据 码位, gg.tag 穷尽 归类 对照 布尔型(): 1, 数值型(x): 2, 出错型(c): 3;
        若 (码位 == 1)      布 = 布 + 1;
        否 若 (码位 == 2)   数 = 数 + 1;
        否                  出 = 出 + 1;
        m = m + 1;
    }
    格式化 "统计：数值 %d · 布尔 %d · 出错 %d\n", 数, 布, 出;
    返 0;
}
