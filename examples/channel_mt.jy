# 跨线程通道示例 —— 两个线程通过同一个通道传 100 个数
#
# 这个示例证明的是通道的阻塞语义真的可用：
#   生产者送满 8 个后，送 会阻塞等待；消费者每收一个就唤醒它继续。
#   如果阻塞语义是坏的（旧版自旋忙等），这个程序会死锁而不是跑完。
#
# 关键前提：通道必须声明在**文件级**（不带 静 也可以，但必须在函数外）。
#   函数内声明的 通道 是栈上内联环形缓冲，无法跨线程；
#   那种情况下送满会立刻报 [ERR] A5007（无消费者），这是有意的安全阀。
#
# 跑法：
#   qcc_zh_seed.exe examples/channel_mt.jy -o channel_mt.exe
#   ./channel_mt.exe
#   # 期望输出：MT100 OK

#包含 <stdio.h>

通道 数, 8;                     /* 文件级：运行期对象，可跨线程 */

静 整 产(空 *p) {               /* 生产者：送 0..99 */
    遍 (整 i = 0; i < 100; i++) { 送 数, i; }
    返 0;
}

静 整 消(空 *p) {               /* 消费者：收 0..99 并逐个校验顺序 */
    遍 (整 i = 0; i < 100; i++) {
        循环 (就绪(数) == 0) { }    /* 等到有数据 */
        整 v = -1;
        收 数, v;
        若 (v != i) { 格式化 "BAD %d %d\n", i, v; 返 1; }
    }
    返 0;
}

函数 整 主(空) {
    线程池 池, 2;
    提交 池, 产, (空 *)0;
    提交 池, 消, (空 *)0;
    等待池 池;
    格式化 "MT100 OK\n", 0;
    返 0;
}