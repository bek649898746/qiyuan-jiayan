    jmp_rel(-1); patch_label(cp-4, lwidth, 2);
    set_label(lwd_nondigit); /* fix 2026-08-23 t35g: 宽度后非数字 — 长度前缀(l/h/z/I)继续, '.' 精度, 其余转换符 */
