    asm_emit("    取反 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xDB); /* neg ebx (fix 2026-08-23 t35g: 无 REX, 有 REX.B=0x41 → neg r11d 破坏 r11 死循环) */
