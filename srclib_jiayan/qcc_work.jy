    set_label(lG);
    mov_r_imm(0, 'E'); mov_mbrp_reg(scratch_base - cur_frame_sz + 236, 0);
    mov_r_imm(0, 1); mov_mbrp_reg(scratch_base - cur_frame_sz + 24, 0);
    jmp_rel(-1); patch_label(cp - 4, lfgt, 2);
    set_label(lfgt);
    emit_fmt_float(lfmt);
/* ---- %f 的 inf/NaN 输出 (fix 2026-08-26): 符号已输出, 只输出 "inf"/"nan" ---- */
    set_label(lfsp);
    { 整 scx = scratch_base - cur_frame_sz; /* 重新加载 |v| (%f 路径已改 xmm0) */
      movsd_xmm0_mbrp(scx + 192);
      asm_emit("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x66); b(0x48); b(0x0F); b(0x7E); b(0xC0); /* movq rax, xmm0 */
      b(0x48); b(0xC1); b(0xE0); b(12);                   /* shl rax, 12: 尾数移高, 符号+指数移出 */
      b(0x48); b(0x85); b(0xC0);                          /* test rax, rax: 尾数非 0 → NaN */
      b(0x0F); b(0x85); b4(0); patch_label(cp - 4, lfnan, 9); /* jnz lfnan */
      mov_r_imm(0, 'i'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, 'n'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, 'f'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      jmp_rel(-1); patch_label(cp - 4, lfmt, 2);
      set_label(lfnan);
      mov_r_imm(0, 'n'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, 'a'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, 'n'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, '('); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, 'i'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, 'n'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, 'd'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      mov_r_imm(0, ')'); mov_r12_al();
      asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
      jmp_rel(-1); patch_label(cp - 4, lfmt, 2);
    }
/* %d->lfmt, %f->fractional path */
    返 ldone;
}

/* %e/%E/%g/%G: scientific / general float formatting (fix 2026-08-25 支持矩阵补全).
   is_g(sc+24) 与 letter(sc+236) 由 emit_fmt_loop 分发存根在运行时设置.
   Emitted machine code shares the %f sign/rounding patterns but adds decimal-exponent
   normalization. scale/fracN use 64-bit arithmetic so %.16g/%.17g (SQLite) work.
   Precision N from sc+224 (default 6). Width/zero-pad ignored for float formats.
   Slot map (all inside the printf scratch area, sc = scratch_base - cur_frame_sz):
     sc+8:   scale (int64)          sc+192: |v| (double)
     sc+16:  strip counter (int32)  sc+200: mantissa/frac (double)
     sc+20:  style flag (0=f-style 1=e-style)   sc+208: fracN (int64)
     sc+24:  is_g (0=%e/%E 1=%g/%G)  sc+216: 0.5 (double)
     sc+224: N_frac (int32)         sc+228: exp (int32)
     sc+236: exponent letter        sc+240: 10.0 (double, 8字节 sc+240..247 — 勿与其他槽重叠)
   Register discipline: r11=fmt r12=dest r13=args; r8/r9 scratch; emit_u64_digits
   digit temp spans ~sc+242..259 (downward from [rbp+sc+260]), so nothing below
   sc+240 may be live across a call to it (style flag at sc+20 / is_g at sc+24 因此安全). */
静 空 emit_fmt_float(整 tail) {
    整 l_sgn = new_label(), l_zero = new_label(), l_big = new_label();
    整 l_sp = new_label(), l_nanx = new_label(); /* fix 2026-08-26: inf/NaN 特殊输出 (原归一化循环死循环) */
    整 l_sml = new_label(), l_sml2 = new_label(), l_norm = new_label();
    整 l_efmt = new_label(), l_nfok = new_label();
    整 l_scale = new_label(), l_scale_l = new_label(), l_scdone = new_label();
    整 l_carry_e = new_label(), l_carry_done = new_label(), l_nocarry = new_label();
    整 l_num = new_label(), l_dot = new_label(), l_digl = new_label(), l_digd = new_label();
    整 l_print_e = new_label();
    整 l_exp = new_label(), l_pl = new_label(), l_expdig = new_label(), l_expcopy = new_label();
    整 l_g_ok = new_label(), l_nfadj = new_label(), l_strip_skip = new_label();
    整 l_strip_l = new_label(), l_strip_div = new_label(), l_strip_d = new_label(), l_strip_done = new_label();
    整 l_sstrip = new_label();
    整 sc = scratch_base - cur_frame_sz;

    /* consume the double arg */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past spec char) */
    movsd_xmm0_mr13();
    若 (fmt_va_forward) { asm_emit("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3, 0, 5); b(8); }
    否 { asm_emit("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); }

    /* ---- sign (same pattern as %f: IEEE sign bit) ---- */
    movsd_mbrp_xmm0(sc + 192);       /* save v */
    movsd_xmm0_mbrp(sc + 192);
    asm_emit("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x66); b(0x48); b(0x0F); b(0x7E); b(0xC0); /* movq rax, xmm0 */
    asm_emit("    测试位 r0, 63\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,0,0,0); b(0x0F); b(0xBA); b(0xE0); b(0x3F); /* bt rax, 63 */
    b(0x0F); b(0x83); b4(0); patch_label(cp - 4, l_sgn, 7); /* jae l_sgn: sign clear, keep */
    mov_r_imm(0, '-'); mov_r12_al(); /* mov [r12], '-' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    movsd_xmm1_mbrp(sc + 192);       /* xmm1 = v */
    mov_r_imm(0, 0); cvtsi2sd_xmm0_eax(); /* xmm0 = 0.0 */
    subsd_xmm0_xmm1();               /* xmm0 = 0.0 - v = -v */
    movsd_mbrp_xmm0(sc + 192);       /* save |v| */
    set_label(l_sgn);

    /* fix 2026-08-26: inf/NaN 检测 — 原归一化循环对 inf (v/10 恒 inf) 与 NaN (comisd 无序 CF=1, NaN<1 恒真) 死循环。
       指数位全 1 (0x7FF) → 跳 l_sp 输出 "inf"/"nan"; 正常值 fall-through (xmm0 未被 clobber). */
    asm_emit("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x66); b(0x48); b(0x0F); b(0x7E); b(0xC0); /* movq rax, xmm0 */
    b(0x48); b(0xC1); b(0xE8); b(52);                /* shr rax, 52 */
    b(0x25); b4(0x7FF);                              /* and eax, 0x7FF */
    b(0x3D); b4(0x7FF);                              /* cmp eax, 0x7FF */
    b(0x0F); b(0x84); b4(0); patch_label(cp - 4, l_sp, 8); /* je l_sp (inf/NaN) */

    /* exp = 0 */
    mov_r_imm(0, 0); mov_mbrp_reg(sc + 228, 0);

    /* zero check (normalization would loop forever on 0) */
    mov_r_imm(0, 0); cvtsi2sd_xmm1_eax(); /* xmm1 = 0.0 */
    comisd_xmm0_xmm1();
    b(0x0F); b(0x84); b4(0); patch_label(cp - 4, l_zero, 1); /* je l_zero: v == 0 */

    /* ---- normalize |v| to [1,10): exp counts powers of 10 ---- */
    mov_r_imm(0, 10); cvtsi2sd_xmm1_eax();  /* xmm1 = 10.0 */
    movsd_xmm0_xmm1(); movsd_mbrp_xmm0(sc + 240); /* [sc+240] = 10.0 (8字节 sc+240..247 — is_g 在 sc+24 不重叠) */
    movsd_xmm0_mbrp(sc + 192);          /* restore xmm0 = v (movsd_xmm0_xmm1 clobbered it) */
    set_label(l_big);
    comisd_xmm0_xmm1();                 /* CF = (v < 10) */
    b(0x0F); b(0x82); b4(0); patch_label(cp - 4, l_sml, 8); /* jb l_sml: v < 10 */
    divsd_xmm0_xmm1();                  /* v /= 10 */
    mov_reg_mbrp(0, sc + 228); mov_r_imm(1, 1); alu_rr(T_PK, 0, 1); mov_mbrp_reg(sc + 228, 0); /* exp++ */
    jmp_rel(-1); patch_label(cp - 4, l_big, 2);
    set_label(l_sml);
    set_label(l_sml2);
    mov_r_imm(0, 1); cvtsi2sd_xmm1_eax();  /* xmm1 = 1.0 (reload each iteration — mulsd clobbers it with 10.0) */
    comisd_xmm0_xmm1();                 /* CF = (v < 1) */
    b(0x0F); b(0x83); b4(0); patch_label(cp - 4, l_norm, 7); /* jae l_norm: v >= 1 */
    movsd_xmm1_mbrp(sc + 240);          /* xmm1 = 10.0 */
    mulsd_xmm0_xmm1();                  /* v *= 10 */
    mov_reg_mbrp(0, sc + 228); mov_r_imm(1, 1); alu_rr(T_MK, 0, 1); mov_mbrp_reg(sc + 228, 0); /* exp-- */
    jmp_rel(-1); patch_label(cp - 4, l_sml2, 2);
    set_label(l_norm);
    /* xmm0 = mantissa in [1,10), exp at sc+228, |v| at sc+192 — 运行时 is_g(sc+24) 分支 */
    mov_reg_mbrp(0, sc + 24); test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, l_efmt, 3); /* is_g==0 → 直接 e-style */
    /* %g: precision 0 -> 1 (C standard: zero precision treated as one) */
    mov_reg_mbrp(0, sc + 224); test_rr(0, 0); jnz_rel(-1); patch_label(cp - 4, l_g_ok, 3);
    mov_r_imm(0, 1); mov_mbrp_reg(sc + 224, 0);
    set_label(l_g_ok);
    /* %g style decision: e-style iff exp < -4 or exp >= N (default N=6) */
    mov_reg_mbrp(0, sc + 228); mov_r_imm(1, -4); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8C); b4(0); patch_label(cp - 4, l_efmt, 10); /* cmp eax,-4; jl l_efmt */
    mov_reg_mbrp(1, sc + 224); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8D); b4(0); patch_label(cp - 4, l_efmt, 5); /* cmp eax,ecx; jge l_efmt */
    /* ---- f-style ---- */
    mov_reg_mbrp(0, sc + 224);
    mov_r_imm(1, 1); alu_rr(T_MK, 0, 1);           /* eax = N-1 */
    mov_reg_mbrp(1, sc + 228); alu_rr(T_MK, 0, 1); /* eax = N-1-exp */
    mov_mbrp_reg(sc + 224, 0);                     /* N_frac */
    mov_r_imm(0, 0); mov_mbrp_reg(sc + 20, 0);     /* style = 0 (f-style) */
    movsd_xmm0_mbrp(sc + 192);                     /* xmm0 = v */
    cvttsd2si_rax_xmm0();                          /* rax = (int64)v */
    mov_rr64(3, 0);                                /* rbx = int part */
    mov_rr64(0, 3); b(0xF2); b(0x48); b(0x0F); b(0x2A); b(0xC0); /* cvtsi2sd xmm0, rax */
    movsd_xmm1_xmm0();                             /* xmm1 = (double)int */
    movsd_xmm0_mbrp(sc + 192);
    subsd_xmm0_xmm1();                             /* xmm0 = v - int */
    movsd_mbrp_xmm0(sc + 200);                     /* frac */
    jmp_rel(-1); patch_label(cp - 4, l_scale, 2);
    set_label(l_zero);
    /* v == 0: exp stays 0, mantissa = 0 — jump back through the %g style decision
       (exp=0 -> f-style -> "0"/"-0"; %e/%E is_g==0 jumps straight to l_efmt anyway) */
    jmp_rel(-1); patch_label(cp - 4, l_norm, 2);
    set_label(l_efmt);
    /* ---- e-style ---- */
    movsd_mbrp_xmm0(sc + 200);                         /* save mantissa (0 or [1,10)) */
    /* 运行时 is_g: %g e-style 用 N-1 位小数 (%e 保持 N) */
    mov_reg_mbrp(0, sc + 24); test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, l_nfadj, 3);
    mov_reg_mbrp(0, sc + 224); mov_r_imm(1, 1); alu_rr(T_MK, 0, 1); mov_mbrp_reg(sc + 224, 0); /* N_frac = N-1 */
    set_label(l_nfadj);
    /* guard N_frac >= 0 */
    mov_reg_mbrp(0, sc + 224); mov_r_imm(1, 0); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8D); b4(0); patch_label(cp - 4, l_nfok, 5); /* cmp eax,0; jge l_nfok */
    mov_r_imm(0, 0); mov_mbrp_reg(sc + 224, 0);
    set_label(l_nfok);
    /* mantissa int digit (0-9) */
    movsd_xmm0_mbrp(sc + 200);
    cvttsd2si_eax_xmm0();
    mov_rr(3, 0);                                      /* ebx = digit */
    mov_rr(0, 3); cvtsi2sd_xmm0_eax();                 /* xmm0 = (double)digit */
    movsd_xmm1_xmm0();
    movsd_xmm0_mbrp(sc + 200);
    subsd_xmm0_xmm1();                                 /* xmm0 = mantissa - digit */
    movsd_mbrp_xmm0(sc + 200);                         /* frac */
    mov_r_imm(0, 1); mov_mbrp_reg(sc + 20, 0);         /* style = 1 (e-style) */
    set_label(l_scale);
    /* ---- shared: scale = 10^N_frac (64-bit) ---- */
    mov_r_imm(0, 1); mov_mbrp_reg64(sc + 8, 0);        /* scale = 1 */
    mov_reg_mbrp(9, sc + 224);                         /* r9d = N_frac */
    set_label(l_scale_l);
    test_rr(9, 9); jz_rel(-1); patch_label(cp - 4, l_scdone, 1);
    mov_reg_mbrp64(0, sc + 8);                         /* rax = scale */
    mov_r_imm(1, 10);                                  /* ecx = 10 */
    b(0x48); b(0xF7); b(0xE1);                         /* mul rcx: rdx:rax = scale*10 */
    mov_mbrp_reg64(sc + 8, 0);                         /* scale = rax */
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9d */
    jmp_rel(-1); patch_label(cp - 4, l_scale_l, 2);
    set_label(l_scdone);
    /* ---- shared: fracN = trunc(frac * scale + 0.5) ---- */
    mov_r_imm(0, 1); cvtsi2sd_xmm0_eax();              /* xmm0 = 1.0 */
    mov_r_imm(0, 2); cvtsi2sd_xmm1_eax();              /* xmm1 = 2.0 */
    divsd_xmm0_xmm1();                                 /* xmm0 = 0.5 (1.0/2.0) */
    movsd_mbrp_xmm0(sc + 216);                         /* save 0.5 */
    mov_reg_mbrp64(0, sc + 8);                         /* rax = scale */
    b(0xF2); b(0x48); b(0x0F); b(0x2A); b(0xC8);       /* cvtsi2sd xmm1, rax (scale) */
    movsd_xmm0_mbrp(sc + 200);                         /* xmm0 = frac */
    mulsd_xmm0_xmm1();                                 /* xmm0 = frac*scale */
    movsd_xmm1_mbrp(sc + 216);                         /* xmm1 = 0.5 */
    addsd_xmm0_xmm1();                                 /* xmm0 = frac*scale + 0.5 */
    cvttsd2si_rax_xmm0();                              /* rax = fracN */
    /* carry: fracN >= scale -> fracN = 0, adjust mantissa/int */
    mov_reg_mbrp64(1, sc + 8);                         /* rcx = scale */
    b(0x48); b(0x39); modrm(3, 1, 0);                  /* cmp rax, rcx */
    b(0x0F); b(0x82); b4(0); patch_label(cp - 4, l_nocarry, 8); /* jb l_nocarry: fracN < scale */
    mov_reg_mbrp(0, sc + 20); test_rr(0, 0); jnz_rel(-1); patch_label(cp - 4, l_carry_e, 3); /* style 0? */
    b(0xFF); b(0xC3);                                  /* inc ebx (f-style int part) */
    jmp_rel(-1); patch_label(cp - 4, l_carry_done, 2);
    set_label(l_carry_e);
    b(0xFF); b(0xC3);                                  /* inc ebx (mantissa digit) */
    mov_r_imm(1, 10); alu_rr(T_QK, 3, 1);              /* cmp ebx, 10 */
    b(0x0F); b(0x8C); b4(0); patch_label(cp - 4, l_carry_done, 10); /* jl l_carry_done: digit < 10 */
    mov_r_imm(3, 1);                                   /* ebx = 1 */
    mov_reg_mbrp(0, sc + 228); mov_r_imm(1, 1); alu_rr(T_PK, 0, 1); mov_mbrp_reg(sc + 228, 0); /* exp++ */
    set_label(l_carry_done);
    mov_r_imm(0, 0);                                   /* fracN = 0 */
    set_label(l_nocarry);
    mov_mbrp_reg64(sc + 208, 0);                       /* save fracN */
    /* ---- strip trailing zeros (only %g; 运行时 is_g 判断) ---- */
    mov_reg_mbrp(0, sc + 24); test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, l_strip_skip, 3);
    {
        mov_r_imm(0, 0); mov_mbrp_reg(sc + 16, 0);     /* strip = 0 */
        set_label(l_strip_l);
        mov_reg_mbrp64(0, sc + 208);                   /* rax = fracN */
        b(0x48); b(0x85); b(0xC0);                     /* test rax, rax */
        jnz_rel(-1); patch_label(cp - 4, l_strip_div, 3);
        mov_r_imm(0, 0); mov_mbrp_reg(sc + 224, 0);    /* N_eff = 0 */
        jmp_rel(-1); patch_label(cp - 4, l_strip_done, 2);
        set_label(l_strip_div);
        mov_r_imm(1, 10); asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
        b(0x48); b(0xF7); modrm(3, 6, 1);              /* div rcx: rax=fracN/10, rdx=rem */
        test_rr(2, 2); jnz_rel(-1); patch_label(cp - 4, l_strip_d, 3); /* rem != 0 -> done */
        mov_mbrp_reg64(sc + 208, 0);                   /* fracN /= 10 */
        mov_reg_mbrp(0, sc + 16); mov_r_imm(1, 1); alu_rr(T_PK, 0, 1); mov_mbrp_reg(sc + 16, 0); /* strip++ */
        jmp_rel(-1); patch_label(cp - 4, l_strip_l, 2);
        set_label(l_strip_d);
        /* N_eff = N - strip */
        mov_reg_mbrp(0, sc + 16); mov_reg_mbrp(1, sc + 224); alu_rr(T_MK, 1, 0); mov_mbrp_reg(sc + 224, 1);
        /* scale_eff = scale / 10^strip (64-bit) */
        mov_reg_mbrp64(0, sc + 8); mov_reg_mbrp(1, sc + 16); /* rax=scale, ecx=strip */
        set_label(l_sstrip);
        test_rr(1, 1); jz_rel(-1); patch_label(cp - 4, l_strip_done, 1);
        mov_r_imm(2, 10); mov_rr(8, 2);                /* r8 = 10 (divisor — 不能放 scale 自身, 会 scale/scale=1) */
        asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
        b(0x49); b(0xF7); b(0xF0);                     /* div r8: rax = scale/10 */
        mov_mbrp_reg64(sc + 8, 0);                     /* scale /= 10 */
        mov_reg_mbrp(1, sc + 16); b(0xFF); b(0xC9); mov_mbrp_reg(sc + 16, 1); /* strip-- */
        jmp_rel(-1); patch_label(cp - 4, l_sstrip, 2);
        set_label(l_strip_done);
    }
    set_label(l_strip_skip);  /* is_g==0: 跳过 strip, fracN/N/scale 原样 */
    /* ---- print mantissa/int part (style flag sc+20 运行时分支) ---- */
    mov_reg_mbrp(0, sc + 20); test_rr(0, 0); jnz_rel(-1); patch_label(cp - 4, l_print_e, 3);
    emit_u64_digits(sc + 260, l_num);              /* f-style: print rbx (int), jmp l_num */
    set_label(l_print_e);
    /* e-style: single mantissa digit (0-9) */
    mov_rr(0, 3);
    asm_emit("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC0); b(0x30); /* add al, '0' */
    mov_r12_al();
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    jmp_rel(-1); patch_label(cp - 4, l_num, 2);
    /* ---- fraction digits: '.' + N_eff digits of fracN, divisor = scale/10 ---- */
    set_label(l_num);
    mov_reg_mbrp(0, sc + 224); test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, l_dot, 1); /* N==0: skip '.' */
    mov_r_imm(0, '.'); mov_r12_al();
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    set_label(l_dot);
    mov_reg_mbrp64(0, sc + 8);                         /* rax = scale */
    mov_r_imm(1, 10); asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    b(0x48); b(0xF7); modrm(3, 6, 1);                  /* div rcx: rax = scale/10 */
    mov_rr64(8, 0);                                    /* r8 = divisor */
    mov_reg_mbrp(9, sc + 224);                         /* r9d = N (digit count) */
    set_label(l_digl);
    test_rr(9, 9); jz_rel(-1); patch_label(cp - 4, l_digd, 1);
    mov_reg_mbrp64(0, sc + 208);                       /* rax = fracN */
    asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    b(0x49); b(0xF7); b(0xF0);                         /* div r8: rax=digit, rdx=rem */
    asm_emit("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC0); b(0x30); /* add al, '0' */
    mov_r12_al();
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_mbrp_reg64(sc + 208, 2);                       /* fracN = rdx */
    mov_rr64(0, 8);                                    /* rax = divisor */
    mov_r_imm(1, 10); asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    b(0x48); b(0xF7); modrm(3, 6, 1);                  /* div rcx: rax = divisor/10 */
    mov_rr64(8, 0);                                    /* r8 = divisor/10 */
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9d */
    jmp_rel(-1); patch_label(cp - 4, l_digl, 2);
    set_label(l_digd);
    /* exit: style 0 -> tail, style 1 -> l_exp (exponent print) */
    mov_reg_mbrp(0, sc + 20); test_rr(0, 0); jnz_rel(-1); patch_label(cp - 4, l_exp, 3);
    jmp_rel(-1); patch_label(cp - 4, tail, 2);
    /* ---- exponent: letter(sc+236) + sign + at least 2 digits ---- */
    set_label(l_exp);
    mov_reg_mbrp(0, sc + 236); mov_r12_al();           /* letter */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_reg_mbrp(0, sc + 228); mov_r_imm(1, 0); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8D); b4(0); patch_label(cp - 4, l_pl, 5); /* cmp eax,0; jge l_pl */
    mov_r_imm(0, '-'); mov_r12_al();
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_reg_mbrp(0, sc + 228); mov_r_imm(1, 0); alu_rr(T_MK, 1, 0); mov_mbrp_reg(sc + 228, 1); /* exp = 0 - exp */
    jmp_rel(-1); patch_label(cp - 4, l_expdig, 2);
    set_label(l_pl);
    mov_r_imm(0, '+'); mov_r12_al();
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    set_label(l_expdig);
    mov_reg_mbrp(0, sc + 228); mov_r_imm(1, 10); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8D); b4(0); patch_label(cp - 4, l_expcopy, 5); /* cmp eax,10; jge l_expcopy */
    mov_r_imm(0, '0'); mov_r12_al();                   /* pad '0' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_reg_mbrp(0, sc + 228);
    asm_emit("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC0); b(0x30); /* add al, '0' */
    mov_r12_al();
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    jmp_rel(-1); patch_label(cp - 4, tail, 2);
    set_label(l_expcopy);
    /* multi-digit exponent (>= 2 digits): rbx = |exp| */
    mov_reg_mbrp(0, sc + 228); mov_rr64(3, 0);
    emit_u64_digits(sc + 260, tail);

    /* ---- inf/NaN 输出 (fix 2026-08-26): 符号已由符号处理输出 '-' — 只输出 "inf"/"nan" ---- */
    set_label(l_sp);
    movsd_xmm0_mbrp(sc + 192);                          /* 重新加载 |v| (归一化循环已改 xmm0) */
    asm_emit("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x66); b(0x48); b(0x0F); b(0x7E); b(0xC0); /* movq rax, xmm0 */
    b(0x48); b(0xC1); b(0xE0); b(12);                   /* shl rax, 12: 尾数移到高 52 位 (符号+指数移出) */
    b(0x48); b(0x85); b(0xC0);                          /* test rax, rax: 尾数非 0 → NaN */
    b(0x0F); b(0x85); b4(0); patch_label(cp - 4, l_nanx, 9); /* jnz l_nanx */
    mov_r_imm(0, 'i'); mov_r12_al();                    /* 'i' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, 'n'); mov_r12_al();                    /* 'n' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, 'f'); mov_r12_al();                    /* 'f' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    jmp_rel(-1); patch_label(cp - 4, tail, 2);
    set_label(l_nanx);
    mov_r_imm(0, 'n'); mov_r12_al();                    /* 'n' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, 'a'); mov_r12_al();                    /* 'a' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, 'n'); mov_r12_al();                    /* 'n' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, '('); mov_r12_al();                    /* '(' (fix step29: 对齐 msvcrt/gcc "nan(ind)") */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, 'i'); mov_r12_al();                    /* 'i' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, 'n'); mov_r12_al();                    /* 'n' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, 'd'); mov_r12_al();                    /* 'd' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_r_imm(0, ')'); mov_r12_al();                    /* ')' */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    jmp_rel(-1); patch_label(cp - 4, tail, 2);
}

/* print rbx (unsigned 64-bit) as decimal to [r12], then jmp tail.
   digit temp buffer at [rbp+temp_end-12 .. temp_end] (12 bytes, plenty for 64-bit).
   fix 2026-08-25 支持矩阵补全: shared by emit_fmt_float (int part + exponent). */
静 空 emit_u64_digits(整 temp_end, 整 tail) {
    整 ldig = new_label(), lcpd = new_label();
    lea_r_mbrp(8, temp_end);               /* r8 = temp end */
    mov_rr64(9, 8);                        /* r9 = temp end (advancing) */
    set_label(ldig);
    mov_rr64(0, 3);                        /* rax = value */
    asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 10);
    b(0x48); b(0xF7); modrm(3, 6, 1);      /* div rcx: rax=quot, rdx=rem */
    mov_rr64(3, 0);                        /* rbx = quot */
    asm_emit("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    b(0x48); b(0x85); modrm(3, 3, 3);      /* test rbx, rbx */
    jnz_rel(-1); patch_label(cp - 4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al();
    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp - 4, lcpd, 3);
    jmp_rel(-1); patch_label(cp - 4, tail, 2);
}

/* sprintf(dest=rcx, fmt=rdx, args...): format into dest buffer, return chars written.
   No kernel32 calls, so no stack alignment juggling. r14=dest r11=fmt r12=adv r13=args.
   argstart = index of the first VALUE arg in the pushed stack (2 for sprintf,
   3 for snprintf which carries a size arg). */
静 空 emit_sprintf(整 nargs, 整 argstart) {
    lea_r_mrsp(13, 8 * (nargs - 1 - argstart)); /* r13 = &first value arg */
    mov_rr64(14, 1);  /* r14 = dest (rcx = arg0) */
    mov_rr64(11, 2);  /* r11 = fmt (rdx = arg1) */
    mov_rr64(12, 14); /* r12 = dest advancing */
    整 ldone = emit_fmt_loop(0); /* sprintf/snprintf：用户缓冲，不设界（标准语义） */
    set_label(ldone);
    /* NUL-terminate the dest buffer — sprintf MUST write the terminator (fix 2026-08-03: emit_fmt_loop
       leaves it off because printf/fprintf write a known-length blob; self-host -S text was corrupted
       with stale-buffer residue after the first asm_emit call). */
    asm_emit("    存字节0r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xC6); b(0x04); b(0x24); b(0); /* mov byte [r12], 0 */
    mov_rr64(0, 12); asm_emit("    减64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,0); b(0x29); modrm(3, 6, 0); /* rax = r12 - r14 = count */
}

/* vsnprintf(buf=rcx, size=rdx, fmt=r8, ap=r9): builtin - format the varargs pointed to by
   va_list ap into an internal buffer, copy at most size-1 bytes into buf (NUL-terminated),
   and return the length that would have been written. fix 2026-08-23 t35e: vsnprintf was
   unregistered (no msvcrt IAT import) -> undefined-function fallback returned 0 -> git's
   strbuf_addf/vsnprintf chain silently emitted nothing (diff header lost its prefix etc.).
   va_list is char* (custom stdarg.h stub), r13=ap matches emit_fmt_loop's 8-byte arg table. */
静 空 emit_vsnprintf(空) {
    整 lcap = new_label();
    mov_rr64(3, 1);  /* rbx = buf (rcx) */
    mov_rr64(15, 2); /* r15 = size (rdx) */
    push_r(3);        /* save buf */
    push_r(15);       /* save size */
    mov_rr64(11, 8);  /* r11 = fmt (r8) */
    mov_rr64(13, 9);  /* r13 = ap (r9) = va_list; fmt_va_forward makes fmt_loop walk UP */
    fmt_va_forward = 1;
    lea_r_mbrp(12, scratch_base - cur_frame_sz - 4096); /* r12 = internal buffer */
    mov_rr64(14, 12); /* r14 = buffer start */
    整 ldone = emit_fmt_loop(-272);
    fmt_va_forward = 0;
    set_label(ldone);
    /* len = r12 - r14 */
    mov_rr64(0, 12); asm_emit("    sub64 rax, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,0); b(0x29); modrm(3, 6, 0);
    mov_mbrp_reg(scratch_base - cur_frame_sz + 224, 0); /* save len (sc+224 free after fmt_loop) */
    pop_r(15); /* size */
    pop_r(3);  /* buf */
    /* r9 = min(len, size-1) */
    mov_rr64(9, 15); mov_r_imm(1, 1); alu_rr(T_MK, 9, 1); /* r9d = size - 1 */
    mov_reg_mbrp(1, scratch_base - cur_frame_sz + 224); /* ecx = len */
    alu_rr(T_QK, 9, 1); b(0x0F); b(0x8E); b4(0); patch_label(cp-4, lcap, 6); /* cmp r9d,ecx; jle lcap */
    mov_rr64(9, 1); /* r9 = len */
    set_label(lcap);
    /* rep movsb: rcx=count, rsi=src, rdi=buf */
    mov_rr64(1, 9);  /* rcx = count */
    mov_rr64(6, 14); /* rsi = r14 (internal buffer start; r8 clobbered by fmt_loop) */
    mov_rr64(7, 3);  /* rdi = buf */
    asm_emit("    rep movsb\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF3); b(0xA4);
    asm_emit("    mov byte [rdi], 0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xC6); b(0x07); b(0); /* mov byte [rdi], 0 (rdi=7, no REX needed) */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 224); /* eax = len (needed length) */
}

/* _va_alloc(size=rcx) �?VirtualAlloc(NULL, size, MEM_RESERVE|MEM_COMMIT, PAGE_READWRITE) */
静 空 emit_va_alloc(空) {
    mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* align */
    sub_rsp_imm(32); /* shadow space only (4 args, rsp%16==0 at call) — fix 2026-08-03: was 40 (rsp%16==8) */
    mov_rr64(2, 1);       /* rdx = size */
    mov_ri_ext(1, 0);     /* rcx = lpAddress NULL */
    mov_ri_ext(8, 0x3000); /* r8 = MEM_RESERVE|MEM_COMMIT */
    mov_ri_ext(9, 0x4);   /* r9 = PAGE_READWRITE */
    call_iat(4);          /* VirtualAlloc */
    add_rsp_imm(32);
    mov_rr64(4, 15);
}

/* _setpos(handle=rcx, pos=rdx, method=r8) �?SetFilePointer(handle, pos, NULL, method) */
静 空 emit_setpos(空) {
    mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
    sub_rsp_imm(32);
    mov_rr64(9, 8);  /* r9 = method */
    mov_ri_ext(8, 0); /* r8 = NULL (lpDistanceToMoveHigh) */
    call_iat(5);     /* SetFilePointer */
    add_rsp_imm(32);
    mov_rr64(4, 15);
}

/* _getpos(handle=rcx) �?SetFilePointer(handle, 0, NULL, FILE_CURRENT=1) */
静 空 emit_getpos(空) {
    mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
    sub_rsp_imm(32);
    mov_ri_ext(2, 0); /* rdx = 0 */
    mov_ri_ext(8, 0); /* r8 = NULL */
    mov_ri_ext(9, 1); /* r9 = FILE_CURRENT */
    call_iat(5);
    add_rsp_imm(32);
    mov_rr64(4, 15);
}

/* _exit_proc(code=rcx) �?ExitProcess(code) �?never returns */
静 空 emit_exit_proc(空) {
    mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
    sub_rsp_imm(32);
    call_iat(6); /* ExitProcess */
}

/* fopen/fread/fwrite: real file I/O via kernel32 (CreateFileA/ReadFile/WriteFile).
   Args arrive in rcx/rdx/r8/r9 (call machinery). All kernel32 calls need rsp 16-aligned
   and the 5th+ args at [rsp+32+8k] �?align with r15 and restore. */
静 空 emit_fileio(常 字 *fname) {
    若 (!strcmp(fname, "fopen")) {
        /* fopen(path=rcx, mode=rdx): parse mode[0], call CreateFileA */
        mov_rr64(10, 1); /* r10 = path */
        mov_rr64(11, 2); /* r11 = mode */
        mov_rr64(15, 4); /* mov r15, rsp */
        asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp, -16 */
        sub_rsp_imm(64); /* shadow 32 + 3 stack args 24 + pad 8  �? rsp%16==0 at call */
        /* defaults for 'w': GENERIC_WRITE (rdx = arg2!) + CREATE_ALWAYS */
        mov_r_imm(0, 3); mov_rr(8, 0);   /* r8 = share 3 (READ|WRITE) */
        mov_r_imm(0, 0); mov_rr(9, 0);   /* r9 = security NULL */
        mov_r_imm(0, 2); mov_mrsp_reg64(32, 0);  /* [rsp+32] = CREATE_ALWAYS */
        mov_r_imm(0, 0x80); mov_mrsp_reg64(40, 0); /* [rsp+40] = FILE_ATTRIBUTE_NORMAL */
        mov_r_imm(0, 0); mov_mrsp_reg64(48, 0);  /* [rsp+48] = template NULL */
        mov_r_imm(2, 0x40000000);              /* rdx = GENERIC_WRITE (default) */
        /* mode[0] */
        asm_emit("    零扩展 eax, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 0, 3); /* movzx eax, byte[r11] */
        整 lr = new_label(), la = new_label(), ldone = new_label();
        asm_emit("    比较字节即 r0, 0x72\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x3C); b('r'); jz_rel(-1); patch_label(cp-4, lr, 1); /* 'r' �?read */
        asm_emit("    比较字节即 r0, 0x61\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x3C); b('a'); jz_rel(-1); patch_label(cp-4, la, 1); /* 'a' �?append */
        jmp_rel(-1); patch_label(cp-4, ldone, 2); /* 'w' defaults already set */
        set_label(lr);
        mov_r_imm(2, 0x80000000);              /* rdx = GENERIC_READ */
        mov_r_imm(0, 3); mov_mrsp_reg64(32, 0);  /* [rsp+32] = OPEN_EXISTING */
        jmp_rel(-1); patch_label(cp-4, ldone, 2);
        set_label(la);
        mov_r_imm(2, 0x4);                 /* rdx = FILE_APPEND_DATA �?闁告劖鐟﹀鍫熸交濠婂棙鍎?EOF */
        mov_r_imm(0, 4); mov_mrsp_reg64(32, 0);  /* [rsp+32] = OPEN_ALWAYS */
        set_label(ldone);
        mov_rr64(1, 10); /* rcx = path */
        call_iat(2);     /* CreateFileA */
        add_rsp_imm(64);
        mov_rr64(4, 15); /* mov rsp, r15 */
        /* fix 2026-08-18: CreateFileA 失败返回 INVALID_HANDLE_VALUE(-1) 而非 0!
           caller 的 if(fp) 只判 0 → 打开失败被当成功 → 对不存在的 .git/config 启动
           解析 → git init "bad config line 1"。将 -1 归一为 NULL(0)。 */
        { 整 lf_ok = new_label();
          asm_emit("    cmp rax, -1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xF8); b(0xFF);
          jnz_rel(-1); patch_label(cp - 4, lf_ok, 1);
          mov_r_imm(0, 0); /* rax = NULL */
          set_label(lf_ok); }
    } 否 若 (!strcmp(fname, "fread")) {
        /* fread(ptr=rcx, size=rdx, nmemb=r8, stream=r9): ReadFile */
        mov_rr64(10, 9); /* r10 = handle */
        mov_rr64(11, 1); /* r11 = ptr */
        mov_rr64(14, 2); /* r14 = size (rdx) — 保存用于返回值 bytes/size (fix 2026-08-24 t35v) */
        mov_rr64(0, 2);  /* rax = size */
        asm_emit("    乘64 r0, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,0,0,1); b(0x0F); b(0xAF); modrm(3, 0, 0); /* imul rax, r8 */
        mov_rr64(8, 0);  /* r8 = count */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &read */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* align */
        sub_rsp_imm(48); /* shadow 32 + 1 stack arg 8 + pad 8  �? rsp%16==0 at call */
        mov_rr64(1, 10); /* rcx = handle */
        mov_rr64(2, 11); /* rdx = ptr */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL */
        call_iat(3);     /* ReadFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes read */
        /* fix 2026-08-24 t35v: C fread 返回元素数 = bytes/size (原返回字节数 → files-backend.c nread=fread(buf,cnt,1,f) 得 403≠1 → "cannot read 403 bytes" → rev-parse HEAD@{1} 失败) */
        mov_rr(9, 14); /* r9d = size */
        asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
        asm_emit("    无符号除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xF7); modrm(3, 6, 1); /* DIV r9d */
    } 否 若 (!strcmp(fname, "fwrite")) {
        /* fwrite(ptr=rcx, size=rdx, nmemb=r8, stream=r9): WriteFile
           stream==0 → stdout (git 的 FILE* stdout/stderr 值为 0; fix 2026-08-20:
           git ls-files write_name fputs/stdout 全打进无效句柄 0 → 无输出) */
        整 lfw0 = new_label(), lfw1 = new_label();
        mov_mbrp_reg(scratch_base + 224 - cur_frame_sz, 1); /* 保存 ptr(rcx) — GetStdHandle 破坏 rcx (fix 2026-08-20: 原 GetStdHandle 后 mov rcx→r11 读到垃圾 → strlen/WriteFile 错) */
        mov_rr64(11, 9); test_rr(11, 11); jz_rel(-1); patch_label(cp - 4, lfw0, 1);
        mov_rr64(10, 11); /* r10 = stream (HANDLE) */
        jmp_rel(-1); patch_label(cp - 4, lfw1, 2);
        set_label(lfw0);
        mov_r_imm(1, -11); sub_rsp_imm(32); call_iat(0); add_rsp_imm(32); /* GetStdHandle(STD_OUTPUT) */
        mov_rr64(10, 0); /* r10 = handle */
        set_label(lfw1);
        mov_reg_mbrp(11, scratch_base + 224 - cur_frame_sz); /* 恢复 ptr */
        mov_rr64(0, 2);  /* rax = size */
        asm_emit("    乘64 r0, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,0,0,1); b(0x0F); b(0xAF); modrm(3, 0, 0); /* imul rax, r8 */
        mov_rr64(8, 0);  /* r8 = count */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48); /* shadow 32 + stack arg 8 + pad 8 (rsp%16==0 at call) — fix 2026-08-03: was 40, ABI misaligned */
        mov_rr64(1, 10); mov_rr64(2, 11);
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0);
        call_iat(1);     /* WriteFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes written */
    } 否 若 (!strcmp(fname, "fgetc")) {
        /* fgetc(stream=rcx): ReadFile(handle, &byte, 1, &read, NULL) → eax = byte; EOF → -1
           (fix 2026-08-18: 原非数学 builtin 落 else → mov_r_imm(0,0) 恒返 0 → git config 读取全 0
           → "bad config line 1"; 编译器 fopen 返回 CreateFileA HANDLE, 必须用 ReadFile 而非 msvcrt fgetc) */
        mov_rr64(10, 1); /* r10 = handle */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
        sub_rsp_imm(48); /* shadow 32 + 1 stack arg 8 + pad 8 */
        mov_rr64(1, 10); /* rcx = handle */
        lea_r_mbrp(2, scratch_base + 232 - cur_frame_sz); /* rdx = &byte */
        mov_ri_ext(8, 1); /* r8 = 1 byte */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &read */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL */
        call_iat(3);     /* ReadFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        { 整 lf_eof = new_label(), lf_done = new_label();
        mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes read */
        test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, lf_eof, 1); /* read==0 → EOF */
        /* fix 2026-08-18: 读到的字节须 8 位零扩展 (movzbl eax, byte [scratch+232]) — 原 32 位 mov_reg_mbrp
           把 byte 缓冲的高 24 位栈残留一并返回 (ReadFile 只写 1 字节) → 高字节垃圾 (如 0x0b30d10a) →
           get_next_char 返回垃圾字符 → config 解析 isspace 查表越界 SEGV (git init 0xC0000005) */
        { 整 d = scratch_base + 232 - cur_frame_sz;
          若 (d >= -128 && d <= 127) { b(0x0F); b(0xB6); b(0x45); b((无 字)d); }
          否 { b(0x0F); b(0xB6); b(0x85); b4(d); } }
        jmp_rel(-1); patch_label(cp - 4, lf_done, 2);
        set_label(lf_eof);
        mov_r_imm(0, -1); /* EOF */
        set_label(lf_done); }
    } 否 若 (!strcmp(fname, "fseek")) {
        /* fseek(stream=rcx, offset=rdx, origin=r8) → SetFilePointer(handle, offset, NULL, origin)
           stream==0 (stdin/stdout) → return 0 (fix 2026-08-24 t35t: reflog 反向读取 fseek(句柄)
           原走 msvcrt 需 FILE* 而 emit_fileio fopen 返回 HANDLE → reflog 崩) */
        整 lfs0 = new_label(), lfs1 = new_label();
        mov_rr64(10, 1); test_rr(10, 10); jz_rel(-1); patch_label(cp - 4, lfs0, 1);
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48);
        mov_rr64(1, 10); /* rcx = handle */
        /* rdx = offset (参数原样) */
        mov_rr64(9, 8); /* r9 = origin — 必须在 r8 覆盖前保存 (fix 2026-08-24 t35v: 原 r8 先被 high=NULL 覆盖 → r9=0 (FILE_BEGIN) → fseek(SEEK_END) 移到文件头 → ftell=0 → reflog 反向读取空 → rev-parse HEAD@{1} "log is empty") */
        mov_ri_ext(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL (high) */
        call_iat(5); /* SetFilePointer */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_r_imm(0, 0); /* return 0 */
        jmp_rel(-1); patch_label(cp - 4, lfs1, 2);
        set_label(lfs0);
        mov_r_imm(0, 0); /* stream==0 → 0 */
        set_label(lfs1);
    } 否 若 (!strcmp(fname, "ftell")) {
        /* ftell(stream=rcx) → SetFilePointer(handle, 0, NULL, FILE_CURRENT=1)
           (fix 2026-08-24 t35t: 原走 msvcrt 拿句柄当 FILE* 崩) */
        整 lft0 = new_label(), lft1 = new_label();
        mov_rr64(10, 1); test_rr(10, 10); jz_rel(-1); patch_label(cp - 4, lft0, 1);
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48);
        mov_rr64(1, 10);
        mov_r_imm(2, 0);
        mov_ri_ext(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0);
        mov_ri_ext(9, 1); /* r9 method (mov_r_imm 不支持 r9, fix 2026-08-24 t35t) */ /* FILE_CURRENT */
        call_iat(5);
        add_rsp_imm(48);
        mov_rr64(4, 15);
        jmp_rel(-1); patch_label(cp - 4, lft1, 2);
        set_label(lft0);
        mov_r_imm(0, 0);
        set_label(lft1);
    } 否 若 (!strcmp(fname, "feof")) {
        /* feof(stream=rcx): cur=SetFilePointer(h,0,NULL,CUR); size=SetFilePointer(h,0,NULL,END);
           恢复 cur; return (cur >= size) — 句柄语义下无缓冲 EOF 标志, 用位置比较
           (fix 2026-08-24 t35t: strbuf_getwholeline 的 feof(句柄) 原走 msvcrt 崩) */
        整 lfe0 = new_label(), lfe1 = new_label();
        mov_rr64(10, 1); test_rr(10, 10); jz_rel(-1); patch_label(cp - 4, lfe0, 1);
        /* cur */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48);
        mov_rr64(1, 10); mov_r_imm(2, 0);
        mov_ri_ext(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0);
        mov_ri_ext(9, 1); /* r9 method (mov_r_imm 不支持 r9, fix 2026-08-24 t35t) */ call_iat(5);
        add_rsp_imm(48); mov_rr64(4, 15);
        mov_mbrp_reg(scratch_base + 240 - cur_frame_sz, 0); /* 存 cur */
        /* size */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48);
        mov_rr64(1, 10); mov_r_imm(2, 0);
        mov_ri_ext(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0);
        mov_ri_ext(9, 2); /* r9 method (mov_r_imm 不支持 r9) */ call_iat(5); /* FILE_END */
        add_rsp_imm(48); mov_rr64(4, 15);
        mov_mbrp_reg(scratch_base + 248 - cur_frame_sz, 0); /* 存 size */
        /* 恢复 cur */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48);
        mov_rr64(1, 10);
        mov_reg_mbrp(2, scratch_base + 240 - cur_frame_sz);
        mov_ri_ext(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0);
        mov_ri_ext(9, 0); /* r9 method (mov_r_imm 不支持 r9) */ call_iat(5); /* FILE_BEGIN */
        add_rsp_imm(48); mov_rr64(4, 15);
        /* return (cur >= size) */
        mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = cur */
        push_r(0);
        mov_reg_mbrp(0, scratch_base + 248 - cur_frame_sz); /* eax = size */
        pop_r(3); /* ebx = cur */
        asm_emit("    比较 r3, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x39); modrm(3, 0, 3); /* cmp rbx, rax → rbx-rax = cur-size */
        b(0x0F); b(0x93); modrm(3, 0, 0); /* setae al (cur >= size → EOF) */
        movzx_eax_al();
        jmp_rel(-1); patch_label(cp - 4, lfe1, 2);
        set_label(lfe0);
        mov_r_imm(0, 0); /* stream==0 → 0 (非 EOF) */
        set_label(lfe1);
    } 否 若 (!strcmp(fname, "fputc")) {
        /* fputc(c=rcx, stream=rdx): WriteFile(handle, &byte, 1, &written, NULL)
           stream==0 → stdout (fix 2026-08-20) */
        整 lfc0 = new_label(), lfc1 = new_label();
        mov_mbrp_reg(scratch_base + 232 - cur_frame_sz, 1); /* 先存 c(rcx) — GetStdHandle 破坏 rcx (fix 2026-08-20: 原 GetStdHandle 后存 c 读到垃圾字节) */
        mov_rr64(11, 2); test_rr(11, 11); jz_rel(-1); patch_label(cp - 4, lfc0, 1);
        mov_rr64(10, 11); /* r10 = stream */
        jmp_rel(-1); patch_label(cp - 4, lfc1, 2);
        set_label(lfc0);
        mov_r_imm(1, -11); sub_rsp_imm(32); call_iat(0); add_rsp_imm(32); /* GetStdHandle(STD_OUTPUT) */
        mov_rr64(10, 0); /* r10 = handle */
        set_label(lfc1);
        /* [scratch+232] 已存 c */
        lea_r_mbrp(11, scratch_base + 232 - cur_frame_sz); /* r11 = &byte */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* align */
        sub_rsp_imm(48); /* shadow 32 + stack arg 8 + pad 8 */
        mov_rr64(1, 10); /* rcx = handle */
        mov_rr64(2, 11); /* rdx = &byte */
        mov_ri_ext(8, 1); /* r8 = 1 byte (mov_r_imm can't address high regs!) */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL */
        call_iat(1);     /* WriteFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_r_imm(0, 1); /* return c (positive) */
    } 否 若 (!strcmp(fname, "fputs")) {
        /* fputs(str=rcx, stream=rdx): WriteFile(handle, str, strlen(str), &written, NULL)
           stream==0 → stdout (fix 2026-08-20) */
        整 lfs0 = new_label(), lfs1 = new_label();
        mov_mbrp_reg(scratch_base + 224 - cur_frame_sz, 1); /* 先存 str(rcx) — GetStdHandle 破坏 rcx (fix 2026-08-20: 原 GetStdHandle 后 mov rcx→r11 读到垃圾 → strlen 扫描垃圾地址 → WriteFile 失败) */
        mov_rr64(11, 2); test_rr(11, 11); jz_rel(-1); patch_label(cp - 4, lfs0, 1);
        mov_rr64(10, 11); /* r10 = stream */
        jmp_rel(-1); patch_label(cp - 4, lfs1, 2);
        set_label(lfs0);
        mov_r_imm(1, -11); sub_rsp_imm(32); call_iat(0); add_rsp_imm(32); /* GetStdHandle(STD_OUTPUT) */
        mov_rr64(10, 0); /* r10 = handle */
        set_label(lfs1);
        mov_reg_mbrp(11, scratch_base + 224 - cur_frame_sz); /* 恢复 str */
        mov_rr64(8, 11); /* r8 = scan */
        mov_r_imm(0, 0); /* eax = len */
        整 lps = new_label(), lpd = new_label();
        set_label(lps);
        asm_emit("    零扩展 ecx, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0x0F); b(0xB6); modrm(0, 1, 0); /* movzx ecx,byte[r8] */
        test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lpd, 1);
        asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,0); /* inc r8 */
        asm_emit("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xFF); b(0xC0); /* inc eax */
        jmp_rel(-1); patch_label(cp-4, lps, 2);
        set_label(lpd);
        mov_rr64(8, 0); /* r8 = len */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* align */
        sub_rsp_imm(48);
        mov_rr64(1, 10); /* rcx = handle */
        mov_rr64(2, 11); /* rdx = str */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL */
        call_iat(1);     /* WriteFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_r_imm(0, 0); /* return 0 */
    } 否 若 (!strcmp(fname, "fflush")) {
        /* fflush(stream): 句柄 IO 无缓冲 → no-op (fix 2026-08-24 t35t) */
        mov_r_imm(0, 0);
    } 否 若 (!strcmp(fname, "ferror")) {
        /* ferror(stream): 句柄语义无错误跟踪 → 0 (fix 2026-08-24 t35t) */
        mov_r_imm(0, 0);
    } 否 若 (!strcmp(fname, "rewind")) {
        /* rewind(stream) = fseek(stream, 0, SEEK_SET=0) (fix 2026-08-24 t35t) */
        整 lrw0 = new_label(), lrw1 = new_label();
        mov_rr64(10, 1); test_rr(10, 10); jz_rel(-1); patch_label(cp - 4, lrw0, 1);
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48);
        mov_rr64(1, 10);
        mov_r_imm(2, 0);
        mov_ri_ext(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0);
        mov_ri_ext(9, 0); /* r9 method (mov_r_imm 不支持 r9) */ /* FILE_BEGIN */
        call_iat(5);
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_r_imm(0, 0);
        jmp_rel(-1); patch_label(cp - 4, lrw1, 2);
        set_label(lrw0);
        mov_r_imm(0, 0);
        set_label(lrw1);
    } 否 若 (!strcmp(fname, "fclose")) {
        /* fclose(stream): stream==0 (stdin/stdout) → 0; 否则无 CloseHandle IAT 槽 →
           先 no-op (句柄由进程退出回收; fix 2026-08-24 t35t: 原走 msvcrt 拿句柄当 FILE* 崩) */
        mov_r_imm(0, 0);
    } 否 若 (!strcmp(fname, "fgets")) {
        /* fgets(str=rcx, size=rdx, stream=r8): 逐字符 ReadFile 到 '\n'/EOF/容量; 返回 str/NULL
           stream==0 → stdin (fix 2026-08-24 t35t: 原走 msvcrt 拿句柄当 FILE* 崩; mailmap/shallow 读文件行触发) */
        整 l0 = new_label(), l1 = new_label(), lloop = new_label(), ldone = new_label(), leof = new_label(), lret = new_label();
        mov_rr64(10, 1); /* r10 = str */
        mov_rr64(11, 2); /* r11 = size */
        mov_mbrp_reg64(scratch_base + 220 - cur_frame_sz, 10); /* 原始 str */
        mov_mbrp_reg64(scratch_base + 224 - cur_frame_sz, 10); /* 当前 str */
        /* size-1 → scratch+236 */
        mov_rr64(0, 11);
        asm_emit("    减 r0, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x83); modrm(3, 5, 0); b(1); /* sub eax,1 */
        mov_mbrp_reg(scratch_base + 236 - cur_frame_sz, 0);
        /* handle: r13 = stream==0 ? STD_INPUT : stream */
        mov_rr64(13, 8); test_rr(13, 13); jz_rel(-1); patch_label(cp - 4, l0, 1);
        jmp_rel(-1); patch_label(cp - 4, l1, 2);
        set_label(l0);
        mov_r_imm(1, -10); sub_rsp_imm(32); call_iat(0); add_rsp_imm(32); /* GetStdHandle(STD_INPUT) */
        mov_rr64(13, 0);
        set_label(l1);
        mov_mbrp_reg64(scratch_base + 244 - cur_frame_sz, 13); /* handle */
        mov_r_imm(0, 0); mov_mbrp_reg(scratch_base + 252 - cur_frame_sz, 0); /* count = 0 */
        set_label(lloop);
        /* count >= size-1 → done */
        mov_reg_mbrp(0, scratch_base + 252 - cur_frame_sz); push_r(0);
        mov_reg_mbrp(0, scratch_base + 236 - cur_frame_sz); pop_r(3);
        asm_emit("    比较 r3, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x39); modrm(3, 0, 3);
        b(0x0F); b(0x93); modrm(3, 0, 0); movzx_eax_al(); /* count >= size-1 */
        test_rr(0, 0); jnz_rel(-1); patch_label(cp - 4, ldone, 1);
        /* ReadFile(handle, &byte, 1, &read, NULL) */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48);
        mov_reg_mbrp64(1, scratch_base + 244 - cur_frame_sz); /* rcx = handle */
        lea_r_mbrp(2, scratch_base + 232 - cur_frame_sz); /* &byte */
        mov_ri_ext(8, 1); /* r8 = 1 */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* &read */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0);
        call_iat(3); /* ReadFile */
        add_rsp_imm(48); mov_rr64(4, 15);
        mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* read */
        test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, leof, 1); /* read==0 → EOF */
        /* str[count] = byte; eax 符号扩展 byte (movzx) */
        mov_reg_mbrp64(3, scratch_base + 224 - cur_frame_sz); /* rbx = 当前 str */
        { 整 d = scratch_base + 232 - cur_frame_sz;
          若 (d >= -128 && d <= 127) { b(0x0F); b(0xB6); b(0x45); b((无 字)d); }
          否 { b(0x0F); b(0xB6); b(0x85); b4(d); } } /* movzx eax, byte[scratch+232] */
        mov_mbrp_reg(scratch_base + 232 - cur_frame_sz, 0); /* 保存 byte 值 (供 '\n' 检查) */
        asm_emit("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 0); b(0x88); modrm(0, 0, 3); /* mov [rbx], al */
        /* str++ */
        mov_reg_mbrp64(0, scratch_base + 224 - cur_frame_sz);
        asm_emit("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xFF); modrm(3, 0, 0);
        mov_mbrp_reg64(scratch_base + 224 - cur_frame_sz, 0);
        /* count++ */
        mov_reg_mbrp(0, scratch_base + 252 - cur_frame_sz);
        asm_emit("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xFF); b(0xC0);
        mov_mbrp_reg(scratch_base + 252 - cur_frame_sz, 0);
        /* byte == '\n' → done */
        mov_reg_mbrp(0, scratch_base + 232 - cur_frame_sz);
        asm_emit("    比较字节即 r0, 0x0a\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x3C); b(0x0A);
        jz_rel(-1); patch_label(cp - 4, ldone, 1);
        jmp_rel(-1); patch_label(cp - 4, lloop, 2);
        set_label(ldone);
        /* *str = 0 */
        mov_reg_mbrp64(3, scratch_base + 224 - cur_frame_sz);
        mov_r_imm(0, 0);
        asm_emit("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 0); b(0x88); modrm(0, 0, 3);
        mov_reg_mbrp64(0, scratch_base + 220 - cur_frame_sz); /* return 原始 str */
        jmp_rel(-1); patch_label(cp - 4, lret, 2);
        set_label(leof);
        /* EOF: 有字符 → 返回 str (需先 *str=0), 无字符 → NULL */
        mov_reg_mbrp(0, scratch_base + 252 - cur_frame_sz);
        test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, lret, 1); /* count==0 → 0 */
        mov_reg_mbrp64(3, scratch_base + 224 - cur_frame_sz);
        mov_r_imm(0, 0);
        asm_emit("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 0); b(0x88); modrm(0, 0, 3);
        mov_reg_mbrp64(0, scratch_base + 220 - cur_frame_sz);
        jmp_rel(-1); patch_label(cp - 4, lret, 2);
        set_label(lret);
    }
}

/* struct 逐块拷贝: rax=源地址, rbx=目标地址, csz 字节 (8/4 块; fix 2026-08-06 struct 值赋值)
   每步带 asm_emit 文本 —— 否则 -S 缺指令, H1==H2 崩 (fix 2026-08-06 route_learn 四核验证抓到) */
静 空 cg_struct_copy(整 csz) {
    整 k = 0;
    循环 (csz - k >= 8) {
        mov_reg_mreg64(1, 0); /* rcx = [rax] */
        asm_emit("    存64 [r3], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        rex(1, 0, 0, 0); b(0x89); modrm(0, 1, 3); /* mov [rbx], rcx */
        add_rax_imm8(8);
        asm_emit("    加即64 r3, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        rex(1, 0, 0, 0); b(0x83); modrm(3, 0, 3); b(8); /* add rbx, 8 (64 位) */
        k += 8;
    }
    若 (csz - k >= 4) {
        mov_reg_mreg(1, 0); /* ecx = [rax] */
        asm_emit("    存零 [r3], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        b(0x89); modrm(0, 1, 3); /* mov [rbx], ecx (去冗余 REX 0x40, 与存零文本一致) */
        add_rax_imm8(4);
        asm_emit("    加即64 r3, 4\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        rex(1, 0, 0, 0); b(0x83); modrm(3, 0, 3); b(4);
        k += 4;
    }
}

/* int RHS → 64 位目标: 有符号 32 位值符号扩展 movsxd rax,eax
   (fix 2026-08-06: long long v=-7 存 64 位槽时零扩展 → 4294967289; 正数/unsigned/已 LL 不动) */
静 空 ll_ext32(整 rhs) {
    若 (rhs >= 0 && !nll[rhs] && !nuns[rhs]) {
        若 (nt[rhs] == 1 && (var_pesz((字*)(nn+rhs)) > 0 || var_arrsz((字*)(nn+rhs)) > 0)) 返; /* 指针/数组值不扩展 */
        asm_emit("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        b(0x48); b(0x63); modrm(3, 0, 0);
    }
}

/* fix 2026-08-11 汇编本身: __asm("指令") 字符串汇编编码器 (bin_mode).
   支持内核常用指令: hlt/nop/ret/sti/cli/int3/iretq + push/pop + mov/add/sub/cmp 寄存器/立即数.
   Intel 语法 "mov rax, 0x10" / "mov rax, rbx". */
静 整 asm_reg_id(常 字 *s) {
    构 { 常 字 *n; 整 id; } regs[] = {
        {"rax",0},{"rcx",1},{"rdx",2},{"rbx",3},{"rsp",4},{"rbp",5},{"rsi",6},{"rdi",7},
        {"eax",0},{"ecx",1},{"edx",2},{"ebx",3},{"esp",4},{"ebp",5},{"esi",6},{"edi",7},
        {"al",0},{"cl",1},{"dl",2},{"bl",3},{"spl",4},{"bpl",5},{"sil",6},{"dil",7},
        {"r8",8},{"r9",9},{"r10",10},{"r11",11},{"r12",12},{"r13",13},{"r14",14},{"r15",15},
        {"r8d",8},{"r9d",9},{"r10d",10},{"r11d",11},{"r12d",12},{"r13d",13},{"r14d",14},{"r15d",15},
    };
    遍 (整 i = 0; i < (整)(大小(regs)/大小((regs)[0])); i++) 若 (!strcmp(s, regs[i].n)) 返 regs[i].id;
    返 -1;
}
静 空 asm_enc_string(常 字 *asmtext) {
    字 buf[256]; strncpy(buf, asmtext, 255); buf[255] = 0;
    字 *op = buf; 循环 (*op == ' ' || *op == '\t') op++;
    字 *rest = op; 循环 (*rest && *rest != ' ' && *rest != '\t' && *rest != ',') rest++;
    字 opc[64]; 整 opl = rest - op; 若 (opl > 31) opl = 31; memcpy(opc, op, opl); opc[opl] = 0;
    循环 (*rest == ' ' || *rest == '\t' || *rest == ',') rest++;
    字 *arg1 = rest; 循环 (*arg1 == ' ' || *arg1 == '\t') arg1++;
    /* 单操作数或无操作数指令 */
    若 (!strcmp(opc, "hlt")) { b(0xF4); 返; }
    若 (!strcmp(opc, "nop")) { b(0x90); 返; }
    若 (!strcmp(opc, "ret") || !strcmp(opc, "retq")) { b(0xC3); 返; }
    若 (!strcmp(opc, "sti")) { b(0xFB); 返; }
    若 (!strcmp(opc, "cli")) { b(0xFA); 返; }
    若 (!strcmp(opc, "int3")) { b(0xCC); 返; }
    若 (!strcmp(opc, "iretq")) { b(0x48); b(0xCF); 返; }
    /* push/pop reg */
    若 (!strcmp(opc, "push") || !strcmp(opc, "pop")) {
        字 *a1 = arg1; 循环 (*a1 == '%') a1++;
        整 r = asm_reg_id(a1);
        若 (r >= 0) {
            若 (r < 8) {
                若 (!strcmp(opc, "push")) b(0x50 + r); 否 b(0x58 + r);
            } 否 {
                整 lo = r - 8;
                若 (!strcmp(opc, "push")) { b(0x41); b(0x50 + lo); }
                否 { b(0x41); b(0x58 + lo); }
            }
            返;
        }
    }
    /* 双操作数: mov/add/sub/cmp dst, src */
    字 *comma = arg1; 循环 (*comma && *comma != ',') comma++;
    若 (*comma == ',') {
        *comma = 0; comma++;
        循环 (*comma == ' ' || *comma == '\t') comma++;
        字 *dst = arg1; 循环 (*dst == '%') dst++;
        字 *src = comma; 循环 (*src == '%') src++;
        整 dr = asm_reg_id(dst), sr = asm_reg_id(src);
        /* 立即数: 0xNN 或 数字 */
        整 imm = 0; 整 is_imm = (src[0] == '$') || (src[0] >= '0' && src[0] <= '9');
        若 (is_imm) {
            若 (src[0] == '$') src++;
            若 (src[0] == '0' && (src[1] == 'x' || src[1] == 'X')) imm = (整)strtol(src, 0, 16);
            否 imm = atoi(src);
            若 (dr >= 0) {
                整 is64 = dst[0] == 'r';
                若 (!strcmp(opc, "mov")) {
                    若 (dr < 8) { 若 (is64) b(0x48); b(0xC7); b(0xC0 + dr); b4(imm); }
                    否 { b(0x49); b(0xC7); b(0xC0 + dr - 8); b4(imm); }
                    返;
                }
                若 (!strcmp(opc, "add")) {
                    若 (dr < 8) { 若 (is64) b(0x48); b(0x81); b(0xC0 + dr); b4(imm); }
                    否 { b(0x49); b(0x81); b(0xC0 + dr - 8); b4(imm); }
                    返;
                }
                若 (!strcmp(opc, "sub")) {
                    若 (dr < 8) { 若 (is64) b(0x48); b(0x81); b(0xE8 + dr); b4(imm); }
                    否 { b(0x49); b(0x81); b(0xE8 + dr - 8); b4(imm); }
                    返;
                }
                若 (!strcmp(opc, "cmp")) {
                    若 (dr < 8) { 若 (is64) b(0x48); b(0x81); b(0xF8 + dr); b4(imm); }
                    否 { b(0x49); b(0x81); b(0xF8 + dr - 8); b4(imm); }
                    返;
                }
            }
        }
        /* reg, reg */
        若 (dr >= 0 && sr >= 0) {
            整 d64 = dst[0] == 'r';
            若 (!strcmp(opc, "mov")) {
                若 (dr < 8 && sr < 8) {
                    若 (d64) b(0x48);
                    b(0x89); b(0xC0 + sr * 8 + dr);
                } 否 若 (dr >= 8 && sr < 8) { b(0x4D); b(0x89); b(0xC0 + sr * 8 + (dr - 8)); }
                否 若 (dr < 8 && sr >= 8) { b(0x4C); b(0x89); b(0xC0 + (sr - 8) * 8 + dr); }
                否 { b(0x4D); b(0x89); b(0xC0 + (sr - 8) * 8 + (dr - 8)); }
                返;
            }
            若 (!strcmp(opc, "add") || !strcmp(opc, "sub") || !strcmp(opc, "cmp")) {
                整 base = !strcmp(opc, "add") ? 0x01 : (!strcmp(opc, "sub") ? 0x29 : 0x39);
                若 (dr < 8 && sr < 8) { 若 (d64) b(0x48); b(base); b(0xC0 + sr * 8 + dr); }
                否 若 (dr >= 8 && sr < 8) { b(0x4D); b(base); b(0xC0 + sr * 8 + (dr - 8)); }
                否 若 (dr < 8 && sr >= 8) { b(0x4C); b(base); b(0xC0 + (sr - 8) * 8 + dr); }
                否 { b(0x4D); b(base); b(0xC0 + (sr - 8) * 8 + (dr - 8)); }
                返;
            }
        }
    }
    fprintf(stderr, "[ERR] __asm 未编码: %s\n", asmtext);
}

/* 指针表达式节点的元素大小 (T* → sizeof(T); 数组名 → 元素宽; 非指针 → 0)
   fix 2026-08-20: 成员访问 p->field 也是指针 — 原指针运算只识别 cast/纯变量名,
   `d.entries + 1` 不缩放 (步进 1 字节 → 全错位), `dst - d.entries` 不识别 →
   prune_directory `dir->nr = dst - dir->entries` 算错 → git add 丢全部文件. */
静 整 mem_ty_peek(整 n) { /* query member-chain field struct si (pure query, no codegen) - t49e fix */
    若 (n < 0) 返 -1;
    整 t = nt[n];
    若 (t == 1) { 字 *vn = (字*)(nn + n); 返 var_stidx(vn); }
    若 (t == 13 || t == 15) {
        整 base = mem_ty_peek(n0[n]);
        若 (base < 0) 返 -1;
        字 *fn = (字*)(nn + n);
        返 st_field_ty_idx(stypes[base].name, fn);
    }
    若 (t == 11) 返 mem_ty_peek(n0[n]); /* &expr */
    若 (t == 12) 返 mem_ty_peek(n0[n]); /* *ptr */
    返 -1;
}
静 整 node_psz(整 n) {
    若 (n < 0) 返 0;
    若 (nt[n] == 2) { /* binary op node: ptr +/- expr (t49c4 fix) */
        若 (nv[n] == 5 || nv[n] == 6) {
            整 l = node_psz(n0[n]);
            若 (l > 0) 返 l;
            返 node_psz(n1[n]);
        }
    }
    若 (pesz[n] < 0) 返 0; /* t35k 2026-08-23: 非指针整数 cast (uintptr_t/size_t) 哨兵 → 指针算术不缩放 (原 (uintptr_t)p-1 按 node_psz=4 缩放 → cb_node_of p-4 → cbtree 崩) */
    若 (pesz[n] > 0) 返 pesz[n]; /* (T*) cast 元素大小 (fix 2026-08-19) — 必须先于 nt==11 结构推断: (char*)&arr[i] 的 cast 在操作数上写 pesz=1, 取址推断不得覆盖 (fix 2026-08-25 step20 回归: regress_cmdlist/regress_struct_align) */
    若 (nt[n] == 11) { /* &expr: 取址数组元素 → 指针元素大小 = 基数组元素大小 (fix 2026-08-25 step20: &arr[i]-&arr[j] 缩放; 变量指针差 p-q 已修, 取址下标差值是最后缺口; 只有下标操作数才缩放, 其他取址返回 0 保持原行为) */
        整 op = n0[n];
        若 (op >= 0 && nt[op] == 14) 返 node_psz(n0[op]); /* &arr[i] → 数组/指针基元素大小 (int arr→4, double da→8, struct pa→sizeof, char→1 无缩放) */
        返 0;
    }
    若 (nt[n] == 10) 返 node_psz(n0[n]); /* 复合赋值 (p += N): 返回左操作数元素大小 (fix 2026-08-25 step17: ((p+=8)-8) 减法 lpsz 原=0 无缩放 → int 指针/double 指针差错位; char 指针碰巧对) */
    若 (nt[n] == 1) { /* 变量名: 数组名→元素宽, T** 指针→arr_esz(8), T*→p_esz */
        字 *vn = (字*)(nn + n);
        遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
            若 (!strcmp(vars[vi].name, vn) && var_codegen_visible(vi)) {
                若 (getenv("QCC_DBG_NS")) fprintf(stderr, "[NPSZ] var '%s' arr_sz=%d arr_esz=%d p_esz=%d\n", vn, vars[vi].arr_sz, vars[vi].arr_esz, vars[vi].p_esz); /* tmp diag */
                若 (vars[vi].arr_esz > 0) 返 vars[vi].arr_esz; /* 数组行/T** 元素 (T** 的 arr_esz=8, p_esz=4 — fix 2026-08-20: 原优先 p_esz → dst-entries 按 4 缩放错) */
                返 vars[vi].p_esz;
            }
        返 0;
    }
    若 (nt[n] == 13 || nt[n] == 15) { /* s.field / p->field: 指针字段的元素大小 */
        整 mc = n;
        字 *fn = (字*)(nn + mc);
        整 si2 = mem_ty_peek(n0[mc]); /* fix 2026-08-23 t49e: (&expr)->field base */
        若 (si2 >= 0) {
            整 fidx = st_fidx(si2, fn);
            若 (fidx >= 0 && stypes[si2].fptrs[fidx])
                返 stypes[si2].fpels[fidx] ? stypes[si2].fpels[fidx] : 8;
            /* fix 2026-08-22 #42d: 数组字段的指针算术缩放 — int lens[320] + n 原返回 0
               → 不缩放 → st->lens+hlit 步进 1 字节 → inflate 动态表 dist 表指针错位
               → 垃圾 maxbits 崩. 数组字段 (fels!=fsizes 或 flex) 返回元素大小. */
            若 (fidx >= 0 && st_field_is_array_idx(si2, fn))
                返 st_field_el(si2, fn);
        }
        返 0;
    }
    返 0;
}

/* ==== Phase 3 IR 骨架 v3 (阶段B) ==== */
#define IR_MAX 2000000
静 整 ir_op[IR_MAX], ir_a[IR_MAX], ir_b[IR_MAX], ir_c[IR_MAX];
静 整 ir_n;
静 空 graph_record_call(常 字 *to); /* -graph 旁路: 调用关系记录 (定义在 main 前, 前向声明供 case4 使用) */
静 空 ir_emit(整 op, 整 a, 整 b, 整 c) {
    若 (ir_n >= IR_MAX) { fprintf(stderr, "[IR-OVERFLOW] ir_n=%d\n", ir_n); exit(1); }
    ir_op[ir_n] = op; ir_a[ir_n] = a; ir_b[ir_n] = b; ir_c[ir_n] = c; ir_n++;
}
#define I_MOV_IMM 1    /* a=reg, b=imm32 */
#define I_MOV_IMM_LL 2 /* a=reg, b=lo, c=hi */
#define I_JMP_LBL 3    /* a=label */
#define I_LABEL 4      /* a=label */
#define I_TEST_JZ 5    /* a=label: test eax,eax; jz label */
#define I_TEST_JNZ 6   /* a=label: test eax,eax; jnz label */
#define I_PUSH_RAX 7   /* push rax */
#define I_ALU_RBX 8    /* a=op: pop rbx; alu_rr(op, 3, 0); mov rax, rbx (32位) */
#define I_LOAD_RBP 9   /* a=reg, b=disp, c=signext: mov reg, [rbp+disp] (32位) (+符号扩展) */
#define I_PUSH_R64_RAX 10 /* push_r64(0): sub rsp,8; mov [rsp],rax */
#define I_MOV_RBX_RAX64 11 /* mov rbx, rax */
#define I_ALU64_OP 12    /* a=op: pop_r64(0); add/sub/imul64 rax,rbx */
#define I_STORE_RBP 13  /* a=disp: mov [rbp+disp], eax (32位存储) */
#define I_PUSH_XMM0 14 /* push_xmm0() */
#define I_DBL_BIN 15   /* a=op: movsd xmm1,xmm0; pop_xmm0; addsd/subsd/mulsd/divsd */
#define I_LOAD_RIP32 16 /* a=off, b=k, c=signext: mov eax,[rip+coff_static_disp(off,k)] */
#define I_LOAD_RIP64 17 /* a=off, b=k: mov rax,[rip+coff_static_disp(off,k)-1] */
#define I_LEA_RIP 18    /* a=off, b=k: lea rax,[rip+coff_static_disp(off,k)-1] */
#define I_CALL_LBL 19   /* a=label, b=add_rsp_imm: call_rel(0); patch_label; add_rsp_imm(b) */
#define I_SUB_RSP_IMM 20 /* a=imm: sub_rsp_imm(imm) */
#define I_LOAD_RSP_GPR 21 /* a=gpr, b=disp: mov_reg_mrsp64(0,disp); mov_rr64(gpr,0) */
#define I_LOAD_XMM_RSP 22 /* a=idx, b=disp: movsd_xmmreg_mrsp64(idx,disp) */
#define I_LEA_RBP_GPR 23 /* a=gpr, b=disp: lea_r_mbrp(gpr,disp) */
#define I_CALL_FNPTR 24 /* a=add_rsp_imm: mov r10,rax; call r10; add_rsp_imm(a) */
#define I_ALU_EBX 25    /* a=op: alu_rr(op, 0, 1) — eax op ebx */
#define I_CVTT2SI 26    /* cvttsd2si eax, xmm0: (int)double 截断 */
/* ==== Phase 3 case15 成员访问 IR 指令 (2026-08-25, 直译全等字节级一致) ==== */
#define I_ADD_RAX_IMM8 27 /* a=v: add_rax_imm8(v) — 字段偏移 (imm8/imm32 自动) */
#define I_DEREF64 28      /* mov_reg_mreg64(0,0): mov rax, [rax] — 64 位指针/ll 字段解引用 */
#define I_DEREF32 29      /* mov_reg_mreg(0,0): mov eax, [rax] — 32 位 int 字段解引用 */
#define I_MOVZX_RAX_BYTE 30 /* movzx eax, byte [rax] — char 字段解引用 (零扩展) */
#define I_MOVZX_RAX_WORD 31 /* movzx eax, word [rax] — short 字段解引用 (零扩展) */
#define I_MOVSX_RAX_WORD 34 /* movsx eax, word [rax] — signed short 字段解引用 (符号扩展, fix 2026-08-25 bug#33) */
#define I_LOAD_RBP64 32    /* a=reg, b=disp: mov_reg_mbrp64(reg, disp) — 64 位局部读 (指针/ll 字段) */
#define I_LOAD_XMM0_RBP 33 /* a=disp: movsd_xmm0_mbrp(disp) — double 字段读 (movsd xmm0, [rbp+disp]) */
/* ==== Phase 3 case10 赋值存储 IR 指令 (2026-08-25, 直译全等字节级一致) ==== */
#define I_STORE_RAX_BYTE 35 /* MOV [rax], bl — char 字段存储 (rex; b(0x88); modrm(0,3,0)) */
#define I_STORE_RAX_WORD 36 /* MOV [rax], bx — short 字段存储 (rex; b(0x66); b(0x89); modrm(0,3,0)) */
#define I_STORE_RAX32 37    /* MOV [rax], ebx — int 字段存储 (rex; b(0x89); modrm(0,3,0)) */
#define I_STORE_RAX64 38    /* MOV [rax], rbx — LL/指针字段存储 (rex(1); b(0x89); modrm(0,3,0)) */
#define I_STORE_XMM0_RAX 39 /* movsd [rax], xmm0 — double 字段存储 (b(0xF2); b(0x0F); b(0x11); modrm(0,0,0)) */
#define I_ADD_EAX_IMM8 40  /* alu_ri(T_PK,0,v): add eax, imm (32位, 无 REX.W) — 嵌套链赋值偏移 */
#define I_STORE_RBP64 41   /* mov_mbrp_reg64(disp,0): mov [rbp+disp], rax (rex1; b(0x89); modrm(1/2,0,5)) */
#define I_STORE_XMM0_RBP 42 /* movsd_mbrp_xmm0(disp): movsd [rbp+disp], xmm0 (b(0xF2);b(0x0F);b(0x11); modrm(1/2,0,5)) */
#define I_LEA_RIP_OFF 43   /* lea_rax_rip(coff_static_disp(a,b)+c-1) — static 字段写地址含 foff */
#define I_IMUL_R11_R9 44  /* IMUL r11d, r9d (rex(0,1,0,1); 0F AF; modrm(3,3,1)) — arr[i]=expr 索引缩放 */
#define I_ADD_RAX_R11 45  /* ADD rax, r11 (rex(1,1,0,0); 01; modrm(3,3,0)) — 地址+=索引 */
#define I_SHL_R11_IMM 46  /* SHL r11d, imm (rex(0,0,0,1); C1; modrm(3,4,3); imm) — 索引缩放 */
#define I_MOVSXD_R11 47   /* MOVSXD r11, r11d (4D 63 DB) — 32位索引符号扩展 */
#define I_MOV_R9_IMM 48   /* MOV r9d, imm (41 B9 imm32) — 缩放因子加载 */
#define I_STORE_RBX_BYTE 49  /* MOV [rbx], al (rex; b(0x88); modrm(0,0,3)) — *ptr=expr char */
#define I_STORE_RBX_WORD 50  /* MOV word [rbx], ax (b(0x66); b(0x89); modrm(0,0,3)) */
#define I_STORE_RBX32 51     /* MOV [rbx], eax (rex; b(0x89); modrm(0,0,3)) */
#define I_STORE_RBX64 52     /* MOV [rbx], rax (rex1; b(0x89); modrm(0,0,3)) */
#define I_STORE_XMM0_RBX 53  /* MOVSD [rbx], xmm0 (b(0xF2);b(0x0F);b(0x11); modrm(0,0,3)) */
#define I_STORE_RBP_BYTE 54  /* MOV byte [rbp+disp], al (b(0x88); modrm(1/2,0,5)) */
#define I_STORE_RBP_WORD 55  /* MOV word [rbp+disp], ax (b(0x66);b(0x89); modrm(1/2,0,5)) */
#define I_STORE_XMM0_RIP 56  /* MOVSD [rip+disp], xmm0 (b(0xF2);b(0x0F);b(0x11);b(0x05);b4) — static double 写 */
#define I_STORE_RIP_RAX64 57 /* MOV [rip+disp], rax (rex1;b(0x89);b(0x05);b4) — static 64写 */
#define I_STORE_RIP_EAX32 58 /* MOV [rip+disp], eax (b(0x89);b(0x05);b4) — static 32写 */
#define I_MOVZX_EAX_RBP 59   /* movzx eax, byte [rbp+disp] (0F B6 85 disp32) — char 局部读 */
#define I_MOVZX_EAX_RBP_W 60 /* movzx eax, word [rbp+disp] (0F B7 85 disp32) — short 零扩展读 */
#define I_MOVSX_EAX_RBP_W 61 /* movsx eax, word [rbp+disp] (0F BF 85 disp32) — short 符号扩展读 */
#define I_TEST_SETE 62       /* test eax,eax; sete al; movzx eax,al — !expr */
#define I_NOT_EAX 63         /* NOT eax (F7 D0) — ~expr */
#define I_ALU_EAX_EBX 64     /* alu_rr(op, 0, 1): eax op ebx (无 pop!) — ++/-- 用 */
#define I_CMP_SETCC32 65     /* pop rbx; cmp ebx,eax; setcc/setcc_u; movzx eax,al — 32位比较 */
#define I_CMP64_SETCC 66     /* pop r64; cmp rax,rbx; setcc/setcc_u; movzx eax,al — 64位比较 */
#define I_DBL_CMP_SETCC 67   /* movsd xmm1,xmm0; pop xmm0; comisd; setcc(浮点cc); movzx — double 比较 */
#define I_MOV_ECX_EAX 68     /* mov_rr(1, 0): ecx = eax — 移位计数 */
#define I_SHIFT64 69         /* a=kind(0=shl,1=sar,2=shr): pop r64; shl/sar/shr rax, cl */
#define I_ALU64_BIT 70       /* a=op(25/46=and,47=or,48=xor): pop r64; and/or/xor rax, rbx */
#define I_IMUL64_RBX_RCX 71  /* imul rbx, rcx (rex1;0F AF;modrm(3,3,1)) — LL 指针缩放 */
#define I_ALU64_FULL 72      /* a=op, b=uns: pop r64; add/sub/imul/div/mod rax, rbx (含除/取模) */
#define I_POP_RBX 73         /* pop_r(3): rbx = [rsp] — 32位指针缩放路径 */
#define I_IMUL32_SCALE 74    /* a=pscale: mov r10d,eax; mov eax,imm; imul eax,r10 — 32位指针缩放 */
#define I_ALU_RBX_RES 75     /* a=op, b=uns: g_uns设置; alu_rr(op,3,0); mov_rr(0,3) — 缩放/除/移位后 */
#define I_PSUB_DIV 76        /* a=psub_div: mov ecx,imm; cdq; idiv ecx — 指针差除元素大小 */
#define I_PSUB_DIV64 77      /* a=psub64: mov rcx,imm; cqo; idiv rcx — 64位指针差除元素大小 */
/* ==== Phase 3 阶段C: pass 框架 + 定律接口位 ==== */
静 空 (*ir_pass_cb)(整 *op, 整 *a, 整 *b, 整 *c) __attribute__((unused)) = 0; /* pass 回调, 默认不激活 (0=直译全等) */
#define LAW_LINEAR 1  /* 定律接口位: 线性资源 (move/borrow/lifetime) — 不激活 */
#define LAW_SUM 2     /* 定律接口位: 和类型 (tagged union) — 不激活 */
#define LAW_LATTICE 4 /* 定律接口位: 类型格 (上下界/约束) — 不激活 */
静 整 st_types_attr[256] __attribute__((unused)); /* 定律接口位 per-struct (bitmask, 全 0=不激活 → 编译产物不变) */
静 空 ir_flush(空) {
    若 (ir_pass_cb) { 遍 (整 i = 0; i < ir_n; i++) ir_pass_cb(&ir_op[i], &ir_a[i], &ir_b[i], &ir_c[i]); } /* Phase3-C: pass 遍历 (默认空) */
    遍 (整 i = 0; i < ir_n; i++) {
        择 (ir_op[i]) {
            例 I_MOV_IMM: mov_r_imm(ir_a[i], ir_b[i]); 断;
            例 I_MOV_IMM_LL: mov_rax_imm64(((长 长)(无 整)ir_b[i]) | (((长 长)(无 整)ir_c[i]) << 32)); 断;
            例 I_JMP_LBL: jmp_rel(-1); patch_label(cp - 4, ir_a[i], 2); 断;
            例 I_LABEL: set_label(ir_a[i]); 断;
            例 I_TEST_JZ: test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, ir_a[i], 1); 断;
            例 I_TEST_JNZ: test_rr(0, 0); jnz_rel(-1); patch_label(cp - 4, ir_a[i], 3); 断;
            例 I_PUSH_RAX: push_r(0); 断;
            例 I_LOAD_RBP: mov_reg_mbrp(ir_a[i], ir_b[i]); 若 (ir_c[i]) { asm_emit("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x63); modrm(3, 0, 0); } 断;
            例 I_PUSH_R64_RAX: push_r64(0); 断;
            例 I_MOV_RBX_RAX64: mov_rr64(3, 0); 断;
            例 I_STORE_RBP: mov_mbrp_reg(ir_a[i], 0); 断;
            例 I_PUSH_XMM0: push_xmm0(); 断;
            例 I_LOAD_RIP32: mov_eax_rip(coff_static_disp(ir_a[i], ir_b[i])); 若 (ir_c[i]) { asm_emit("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x63); modrm(3, 0, 0); } 断;
            例 I_LOAD_RIP64: mov_rax_rip64(coff_static_disp(ir_a[i], ir_b[i]) - 1); 断;
            例 I_LEA_RIP: lea_rax_rip(coff_static_disp(ir_a[i], ir_b[i]) - 1); 断;
            例 I_CALL_LBL: call_rel(0); patch_label(cp - 4, ir_a[i], 0); add_rsp_imm(ir_b[i]); 断;
            例 I_SUB_RSP_IMM: sub_rsp_imm(ir_a[i]); 断;
            例 I_LOAD_RSP_GPR: mov_reg_mrsp64(0, ir_b[i]); mov_rr64(ir_a[i], 0); 断;
            例 I_LOAD_XMM_RSP: movsd_xmmreg_mrsp64(ir_a[i], ir_b[i]); 断;
            例 I_LEA_RBP_GPR: lea_r_mbrp(ir_a[i], ir_b[i]); 断;
            例 I_CALL_FNPTR: mov_rr64(10, 0); asm_emit("    调 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 1); b(0xFF); modrm(3, 2, 2); add_rsp_imm(ir_a[i]); 断;
            例 I_ALU_EBX: alu_rr(ir_a[i], 0, 1); 断;
            例 I_CVTT2SI: cvttsd2si_eax_xmm0(); 断;
            例 I_ADD_RAX_IMM8: add_rax_imm8(ir_a[i]); 断;
            例 I_DEREF64: mov_reg_mreg64(0, 0); 断;
            例 I_DEREF32: mov_reg_mreg(0, 0); 断;
            例 I_MOVZX_RAX_BYTE: asm_emit("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB6); modrm(0, 0, 0); 断;
            例 I_MOVZX_RAX_WORD: asm_emit("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB7); modrm(0, 0, 0); 断;
            例 I_MOVSX_RAX_WORD: asm_emit("    符号扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xBF); modrm(0, 0, 0); 断;
            例 I_LOAD_RBP64: mov_reg_mbrp64(ir_a[i], ir_b[i]); 断;
            例 I_LOAD_XMM0_RBP: movsd_xmm0_mbrp(ir_a[i]); 断;
            例 I_STORE_RAX_BYTE: rex(0, 0, 0, 0); b(0x88); modrm(0, 3, 0); 断;
            例 I_STORE_RAX_WORD: rex(0, 0, 0, 0); b(0x66); b(0x89); modrm(0, 3, 0); 断;
            例 I_STORE_RAX32: rex(0, 0, 0, 0); b(0x89); modrm(0, 3, 0); 断;
            例 I_STORE_RAX64: rex(1, 0, 0, 0); b(0x89); modrm(0, 3, 0); 断;
            例 I_STORE_XMM0_RAX: b(0xF2); b(0x0F); b(0x11); modrm(0, 0, 0); 断;
            例 I_ADD_EAX_IMM8: rex(0, 0, 0, 0); 若 (ir_a[i] >= -128 && ir_a[i] <= 127) { b(0x83); modrm(3, 0, 0); b(ir_a[i]); } 否 { b(0x81); modrm(3, 0, 0); b4(ir_a[i]); } 断;
            例 I_STORE_RBP64: rex(1, 0, 0, 0); b(0x89); 若 (ir_a[i] < 128 && ir_a[i] >= -128) { modrm(1, 0, 5); b(ir_a[i]); } 否 { modrm(2, 0, 5); b4(ir_a[i]); } 断;
            例 I_STORE_XMM0_RBP: b(0xF2); b(0x0F); b(0x11); 若 (ir_a[i] < 128 && ir_a[i] >= -128) { modrm(1, 0, 5); b(ir_a[i]); } 否 { modrm(2, 0, 5); b4(ir_a[i]); } 断;
            例 I_LEA_RIP_OFF: lea_rax_rip(coff_static_disp(ir_a[i], ir_b[i]) + ir_c[i] - 1); 断;
            例 I_IMUL_R11_R9: rex(0, 1, 0, 1); b(0x0F); b(0xAF); modrm(3, 3, 1); 断;
            例 I_ADD_RAX_R11: rex(1, 1, 0, 0); b(0x01); modrm(3, 3, 0); 断;
            例 I_SHL_R11_IMM: rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(ir_a[i]); 断;
            例 I_MOVSXD_R11: b(0x4D); b(0x63); b(0xDB); 断;
            例 I_MOV_R9_IMM: b(0x41); b(0xB9); b4(ir_a[i]); 断;
            例 I_STORE_RBX_BYTE: rex(0, 0, 0, 0); b(0x88); modrm(0, 0, 3); 断;
            例 I_STORE_RBX_WORD: b(0x66); b(0x89); modrm(0, 0, 3); 断;
            例 I_STORE_RBX32: rex(0, 0, 0, 0); b(0x89); modrm(0, 0, 3); 断;
            例 I_STORE_RBX64: rex(1, 0, 0, 0); b(0x89); modrm(0, 0, 3); 断;
            例 I_STORE_XMM0_RBX: b(0xF2); b(0x0F); b(0x11); modrm(0, 0, 3); 断;
            例 I_STORE_RBP_BYTE: b(0x88); 若 (ir_a[i] < 128 && ir_a[i] >= -128) { modrm(1, 0, 5); b(ir_a[i]); } 否 { modrm(2, 0, 5); b4(ir_a[i]); } 断;
            例 I_STORE_RBP_WORD: b(0x66); b(0x89); 若 (ir_a[i] < 128 && ir_a[i] >= -128) { modrm(1, 0, 5); b(ir_a[i]); } 否 { modrm(2, 0, 5); b4(ir_a[i]); } 断;
            例 I_STORE_XMM0_RIP: movsd_rip_xmm0(coff_static_disp(ir_a[i], ir_b[i]) - 2); 断;
            例 I_STORE_RIP_RAX64: mov_rip_rax64(coff_static_disp(ir_a[i], ir_b[i]) - 1); 断;
            例 I_STORE_RIP_EAX32: mov_rip_eax(coff_static_disp(ir_a[i], ir_b[i])); 断;
            例 I_MOVZX_EAX_RBP: b(0x0F); b(0xB6); b(0x85); b4(ir_a[i]); 断;
            例 I_MOVZX_EAX_RBP_W: b(0x0F); b(0xB7); b(0x85); b4(ir_a[i]); 断;
            例 I_MOVSX_EAX_RBP_W: b(0x0F); b(0xBF); b(0x85); b4(ir_a[i]); 断;
            例 I_TEST_SETE: test_rr(0, 0); b(0x0F); b(0x94); modrm(3, 0, 0); movzx_eax_al(); 断;
            例 I_NOT_EAX: b(0xF7); b(0xD0); 断;
            例 I_ALU_EAX_EBX: alu_rr(ir_a[i], 0, 1); 断;
            例 I_CMP_SETCC32: pop_r(3); alu_rr(T_QK, 3, 0); 若 (ir_b[i]) setcc_u(ir_a[i]); 否 setcc(ir_a[i]); movzx_eax_al(); 断;
            例 I_CMP64_SETCC: pop_r64(0); asm_emit("    比较64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x39); modrm(3, 3, 0); 若 (ir_b[i]) setcc_u(ir_a[i]); 否 setcc(ir_a[i]); movzx_eax_al(); 断;
            例 I_DBL_CMP_SETCC: movsd_xmm1_xmm0(); pop_xmm0(); comisd_xmm0_xmm1();
                若 (ir_a[i] == T_LK) { asm_emit("    置低 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0x92); modrm(3, 0, 0); movzx_eax_al(); }      /* setb: xmm0 < xmm1 */
                否 若 (ir_a[i] == T_GK) { asm_emit("    置高 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0x97); modrm(3, 0, 0); movzx_eax_al(); } /* seta */
                否 若 (ir_a[i] == T_QK) { asm_emit("    置等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0x94); modrm(3, 0, 0); movzx_eax_al(); } /* sete */
                否 若 (ir_a[i] == T_XK) { asm_emit("    置不等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0x95); modrm(3, 0, 0); movzx_eax_al(); } /* setne */
                否 若 (ir_a[i] == T_HK) { asm_emit("    置低等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0x96); modrm(3, 0, 0); movzx_eax_al(); } /* setbe */
                否 { asm_emit("    置高等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0x93); modrm(3, 0, 0); movzx_eax_al(); }                /* setae: >= */
                断;
            例 I_MOV_ECX_EAX: mov_rr(1, 0); 断;
            例 I_SHIFT64: pop_r64(0);
                若 (ir_a[i] == 2) { asm_emit("    逻辑右移64 r0, cl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0xD3); modrm(3, 5, 0); }
                否 若 (ir_a[i] == 1) { asm_emit("    算术右移64 r0, cl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0xD3); modrm(3, 7, 0); }
                否 { asm_emit("    左移64 r0, cl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0xD3); modrm(3, 4, 0); }
                断;
            例 I_ALU64_BIT: pop_r64(0);
                若 (ir_a[i] == 25 || ir_a[i] == 46) { asm_emit("    与64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x21); modrm(3, 3, 0); }
                否 若 (ir_a[i] == 47) { asm_emit("    或64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x09); modrm(3, 3, 0); }
                否 { asm_emit("    异或64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x31); modrm(3, 3, 0); }
                断;
            例 I_IMUL64_RBX_RCX: rex(1, 0, 0, 0); b(0x0F); b(0xAF); modrm(3, 3, 1); 断;
            例 I_ALU64_FULL: pop_r64(0);
                若 (ir_a[i] == PK) { asm_emit("    加64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x01); modrm(3, 3, 0); }
                否 若 (ir_a[i] == MK) { asm_emit("    减64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x29); modrm(3, 3, 0); }
                否 若 (ir_a[i] == DK) { asm_emit("    乘64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x0F); b(0xAF); modrm(3, 0, 3); }
                否 若 (ir_a[i] == DV) {
                    若 (ir_b[i]) { asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); asm_emit("    无符号除64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0xF7); modrm(3, 6, 3); }
                    否 { asm_emit("    除64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x99); b(0x48); b(0xF7); modrm(3, 7, 3); }
                }
                否 { /* MD */
                    若 (ir_b[i]) { asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); asm_emit("    无符号除余64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0xF7); modrm(3, 6, 3); mov_rr64(0, 2); }
                    否 { asm_emit("    除余64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x99); b(0x48); b(0xF7); modrm(3, 7, 3); mov_rr64(0, 2); }
                }
                断;
            例 I_POP_RBX: pop_r(3); 断;
            例 I_IMUL32_SCALE: mov_rr(10, 0); mov_r_imm(0, ir_a[i]); asm_emit("    乘 r0, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0x0F); b(0xAF); modrm(3, 0, 2); 断;
            例 I_ALU_RBX_RES:
                若 (ir_a[i] == T_SR) g_uns_shift = ir_b[i];
                否 若 (ir_a[i] == T_DV || ir_a[i] == T_MD) g_uns_div = ir_b[i];
                alu_rr(ir_a[i], 3, 0); mov_rr(0, 3);
                断;
            例 I_PSUB_DIV: mov_r_imm(1, ir_a[i]); asm_emit("    除 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x99); b(0xF7); modrm(3, 7, 1); 断;
            例 I_PSUB_DIV64: mov_r_imm(1, ir_a[i]); asm_emit("    除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x99); rex(1, 0, 0, 0); b(0xF7); modrm(3, 7, 1); 断;
            例 I_DBL_BIN: movsd_xmm1_xmm0(); pop_xmm0();
                若 (ir_a[i] == PK) addsd_xmm0_xmm1();
                否 若 (ir_a[i] == MK) subsd_xmm0_xmm1();
                否 若 (ir_a[i] == DK) mulsd_xmm0_xmm1();
                否 divsd_xmm0_xmm1();
                断;
            例 I_ALU64_OP: pop_r64(0);
                若 (ir_a[i] == PK) { asm_emit("    加64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x01); modrm(3, 3, 0); }
                否 若 (ir_a[i] == MK) { asm_emit("    减64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x29); modrm(3, 3, 0); }
                否 { asm_emit("    乘64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x0F); b(0xAF); modrm(3, 0, 3); }
                断;
            例 I_ALU_RBX: pop_r(3); g_uns_shift = 0; g_uns_div = 0; alu_rr(ir_a[i], 3, 0); mov_rr(0, 3); 断;
            缺: fprintf(stderr, "[IR-UNKNOWN] op=%d\n", ir_op[i]); exit(1);
        }
    }
    ir_n = 0;
}

静 空 cg(整 n) {
    若 (n < 0) 返;
    若 (n >= nc) { fprintf(stderr, "[CG-BAD] n=%d nc=%d\n", n, nc); abort(); }
    整 t = nt[n];
    若 (t < 0 || t > 65) { fprintf(stderr, "[CG-BADTYPE] n=%d nt=%d nc=%d\n", n, t, nc); abort(); }
    择 (nt[n]) {
        例 0: 若 (nll[n]) { ir_emit(I_MOV_IMM_LL, 0, nv[n], nll_hi[n]); ir_flush(); } 否 { ir_emit(I_MOV_IMM, 0, nv[n], 0); ir_flush(); } 断;
        例 19: cg_f(n0[n]); 若 (nll[n]) cvttsd2si_rax_xmm0(); 否 { ir_emit(I_CVTT2SI, 0, 0, 0); ir_flush(); } 断; /* fix 2026-08-25 bug#26: (long long)double 64位 */
        例 STR: { /* string literal ??placeholder, patched after codegen */
            整 si = nv[n];
            str_place(si); /* ensure string is in data buffer */
            若 (asm_out && asm_pass == 2 && gen_final) {
                /* STR marker uses the COMPACT index (position among PLACED strings),
                   matching asm_zh's .字串 directive order. Some IDs are parsed but
                   never placed (str_offs=-1), so the raw ID misaligns str_offs2. */
                整 compact = 0;
                遍 (整 j = 0; j < si; j++) 若 (str_offs[j] >= 0) compact++;
                asm_emit("    移动 r0, STR%d\n", (字*)(长 长)(compact), (字*)(长 长)0, (字*)(长 长)0);
                b(0xB8); b4(0); /* mov eax, 0 (bare; mov_r_imm would double-emit ASM) */
            } 否 {
                mov_r_imm(0, 0);
            }
            若 (strpn >= 32768) { fprintf(stderr, "[STRPATCH-OVERFLOW] strpn=%d\n", strpn); abort(); }
            str_patches[strpn].patch_at = cp - 4; /* position of imm32 */
            str_patches[strpn].str_idx = si;
            strpn++;
        } 断;
        例 FP: { /* double literal: movsd xmm0, [rip + dbl_const] (patched) */
            整 di = nv[n];
            dbl_place(di);
            若 (asm_out && asm_pass == 2 && gen_final) {
                asm_emit("    浮取静 xmm0, [rip+DBL%d]\n", (字*)(长 长)(di), (字*)(长 长)0, (字*)(长 长)0);
                b(0xF2); b(0x0F); b(0x10); b(0x05); b4(0); /* movsd xmm0,[rip+0] bare */
            } 否 {
                movsd_xmm0_rip(0);
            }
            若 (dbl_patch_n >= 2048) { fprintf(stderr, "[DBLPATCH-OVERFLOW] dbl_patch_n=%d\n", dbl_patch_n); abort(); }
            dbl_patches[dbl_patch_n].patch_at = cp - 4;
            dbl_patches[dbl_patch_n].dbl_idx = di;
            dbl_patch_n++;
        } 断;
        例 1: { /* variable ????????????? */
            整 off = var_lookup((字*)(nn + n));
            若 (off == -1) { /* fix 2026-08-06: off<-1 是 extern 负槽, 走 static 读生成外部符号; 只有 -1 (未定义) 才走函数/参数 */
                若 (!strcmp((字*)(nn + n), "stderr") || !strcmp((字*)(nn + n), "stdout") || !strcmp((字*)(nn + n), "stdin")) { mov_r_imm(0, 0); 断; } /* msvcrt FILE* globals are unavailable as imports; NULL lets fflush(NULL) flush all streams (fix 2026-08-15 vreportf fflush(stderr) garbage arg) */
                整 ffi = func_find((字*)(nn + n));
                若 (ffi >= 0 && func_tbl[ffi].defined) {
                    /* function name as value �?absolute VA (patched in PE output) */
                    asm_emit("    移动 r0, FN:%s\n", (字*)(nn + n), (字*)(长 长)0, (字*)(长 长)0); /* fn-address marker for the -S/asm_zh path (fix 2026-08-03: emit ONE text+bytes pair — mov_r_imm would add a second "移动 r0, 0" text) */
                    b(0xB8); b4(0); /* mov eax, 0 (manual bytes, NOT mov_r_imm: it prints its own text) */
                    若 (fnpn >= 2048) { fprintf(stderr, "[FNPATCH-OVERFLOW] fnpn=%d\n", fnpn); abort(); }
                    fn_patches[fnpn].patch_at = cp - 4;
                    fn_patches[fnpn].label = func_tbl[ffi].label;
                    fnpn++;
                } 否 若 (ffi >= 0 && !coff_is_qcc_internal((字*)(nn + n)) && strcmp((字*)(nn + n), "stderr") && strcmp((字*)(nn + n), "stdout") && strcmp((字*)(nn + n), "stdin")) {
                    /* fix 2026-08-14: coff_mode 下 extern 函数取地址 → sec=0 符号 (jyld 链接解析); 单文件模式才报错
                       fix 2026-08-19: builtin (strcmp/memset/memcpy 等) 取地址也走 coff 符号 → jyld msvcrt 导入 — 原被 coff_is_builtin 排除 → 落到 load_param_val → 0 → git string_list cmp 函数指针 NULL → status SEGV */
                    若 (coff_mode) {
                        b(0xB8); b4(0); /* mov eax, 0 */
                        coff_crel(cp - 4, 0x0002, coff_func_name_sym((字*)(nn + n)), 0);
                    } 否 若 (coff_is_builtin((字*)(nn + n))) {
                        mov_r_imm(0, 0); /* 单文件 builtin (内联发射, 无真实函数体): 确定性 NULL (fix 2026-08-19: 原 load_param_val 不发射 → rax 残留垃圾 → 测试靠运气) */
                    } 否 {
                        fprintf(stderr, "[ERR] 未定义函数 '%s' 不能取地址 — 多文件请用 qcc -c + jyld 链接\n", (字*)(nn + n)); exit(1);
                    }
                } 否 {
                    load_param_val((字*)(nn + n)); /* eax = param (reg or [rbp+disp]) */
                }
            } 否 {
                字 *vn = (字*)(nn + n);
                若 (var_isstatic(vn)) { /* static: .data via RIP-relative — IR */
                    若 (var_arrsz(vn) != 0) { ir_emit(I_LEA_RIP, off, 1, 0); ir_flush(); }
                    否 若 (var_pesz(vn) > 0) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); }
                    否 若 (var_small_struct(vn)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); }
                    否 若 (var_is_ll(vn)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); nll[n] = 1; }
                    否 { ir_emit(I_LOAD_RIP32, off, 0, (nll[n] && !nuns[n]) ? 1 : 0); ir_flush(); }
                } 否 {
                    /* check if array �?LEA. MUST resolve to the SAME var var_lookup found:
                       the forward search matched any same-named array (e.g. a `char fn[64]`
                       field-local shadowing the parse's `int fn`), turning the int into a
                       LEA of its own address. Search BACKWARD (latest = resolved) and stop. */
                    整 is_arr = 0; 整 base = off; 整 vi_found = -1;
                    遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                        若 (!strcmp(vars[vi].name, vn) && var_codegen_visible(vi)) {
                            若 (vars[vi].arr_sz != 0 || vars[vi].vla_dim > 0) { is_arr = 1; vi_found = vi; 整 esz = vars[vi].arr_esz ? vars[vi].arr_esz : 4; base = off - vars[vi].arr_sz * esz; } /* fix step31: VLA (arr_sz==0) 也是数组 */
                            断;
                        }
                    若 (is_arr) { 若 (vi_found >= 0 && (vars[vi_found].alignN > 0 || vars[vi_found].vla_dim > 0)) { mov_reg_mbrp64(0, off - cur_frame_sz); } /* fix step30/31: 对齐数组/VLA — 地址槽存运行时基址 */ 否 lea_r_mbrp(0, base - cur_frame_sz); }
                    否 若 (var_pesz(vn) > 0) { mov_reg_mbrp64(0, off - cur_frame_sz); } /* pointer: full 64-bit */
                    否 若 (var_is_ll(vn)) { mov_reg_mbrp64(0, off - cur_frame_sz); nll[n] = 1; } /* long long: full 64-bit (fix 2026-08-05) */
                    否 若 (var_is_dbl(vn)) { movsd_xmm0_mbrp(off - cur_frame_sz); } /* double value → xmm0 */
                    否 若 (var_small_struct(vn)) { mov_reg_mbrp64(0, var_sbase(vn, off) - cur_frame_sz); } /* struct value: full 8 bytes (≤8B struct) */
                    否 若 (var_is_char(vn)) { movzx_eax_mbrp(off - cur_frame_sz); } /* fix 2026-08-25 bug#28b: 局部 char 1 字节零扩展读 (原 32 位 → 负值/高位非零错) */
                    否 若 (var_is_short(vn)) { 若 (var_is_uns(vn)) movzx_eax_mbrp_w(off - cur_frame_sz); 否 movsx_eax_mbrp_w(off - cur_frame_sz); 若 (nll[n]) { asm_emit("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x63); modrm(3, 0, 0); } } /* fix 2026-08-25 bug#31b: 局部 short 16 位读; nll 时 movsxd 64 位扩展 (t42 (unsigned long long)short) */
                    否 { ir_emit(I_LOAD_RBP, 0, off - cur_frame_sz, (nll[n] && !nuns[n]) ? 1 : 0); ir_flush(); } /* Phase3-IR: 局部 int 读 */
                }
            }
        } 断;
        例 2: { /* binary op */
            整 o = nv[n];
            若 (o == CK) { cg(n0[n]); cg(n1[n]); 断; } /* comma: evaluate left (side effects), result = right */
            若 ((n0[n] >= 0 && expr_is_double(n0[n])) || (n1[n] >= 0 && expr_is_double(n1[n]))) { /* fix 2026-08-25 bug#27: 用 expr_is_double (覆盖 double 变量) 替代裸 ndbl */
                /* floating-point arithmetic / comparison (result in xmm0) */
                若 (o == PK || o == MK || o == DK || o == DV) {
                    cg_f(n0[n]); ir_emit(I_PUSH_XMM0, 0, 0, 0); ir_flush();
                    cg_f(n1[n]); ir_emit(I_DBL_BIN, o, 0, 0); ir_flush();
                    ndbl[n] = 1;
                    断;
                }
                若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) {
                    cg_f(n0[n]); ir_emit(I_PUSH_XMM0, 0, 0, 0); ir_flush();
                    cg_f(n1[n]); ir_emit(I_DBL_CMP_SETCC, o, 0, 0); ir_flush();
                    断;
                }
                /* other ops on doubles: fall through to integer (best-effort) */
            }
            若 (nll[n] || (n0[n] >= 0 && nll[n0[n]]) || (n1[n] >= 0 && nll[n1[n]])) {
                /* 64-bit long long arithmetic / comparison (fix 2026-08-05); fix 2026-08-25 bug#32: +nll[n] — (long long)cast 标记的节点本身也走 64 位 ((long long)(-5) 一元负) */
                若 (o == PK || o == MK || o == DK || o == DV || o == MD) { /* MD=% 64-bit remainder (fix 2026-08-05) */
                    { 整 pel64 = node_psz(n0[n]);
                      整 psub64 = 0; /* fix 2026-08-25: (long)(p-q) cast 走 64 位路径但缺指针差除法 → p-a 返回字节差 */
                      若 (pel64 > 0 && o == T_MK) { 整 rpsz64 = node_psz(n1[n]); 若 (rpsz64 == pel64) { psub64 = pel64; pel64 = 0; } }
                      若 (pel64 <= 0 && psub64 <= 0 && (o == PK || o == MK || o == DK)) { /* Phase3-IR: LL 64位 PK/MK/DK 无指针缩放 */
                        cg(n0[n]); ll_ext32(n0[n]); ir_emit(I_PUSH_R64_RAX, 0, 0, 0); ir_flush();
                        cg(n1[n]); ll_ext32(n1[n]); ir_emit(I_MOV_RBX_RAX64, 0, 0, 0); ir_flush();
                        ir_emit(I_ALU64_OP, o, 0, 0); ir_flush();
                      } 否 {
                        cg(n0[n]); ll_ext32(n0[n]); ir_emit(I_PUSH_R64_RAX, 0, 0, 0); ir_flush();
                        cg(n1[n]); ll_ext32(n1[n]); ir_emit(I_MOV_RBX_RAX64, 0, 0, 0); ir_flush();
                        若 (pel64 > 0 && !nll[n0[n]] && (o == PK || o == MK)) { ir_emit(I_MOV_IMM, 1, pel64, 0); ir_emit(I_IMUL64_RBX_RCX, 0, 0, 0); ir_flush(); }
                        ir_emit(I_ALU64_FULL, o, (expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n])) ? 1 : 0, 0); ir_flush();
