            若 (sret_si < 0 && !fn_ret_name_has(fname) && fi >= 0 && fi < 8192) sret_si = fn_ret_si_map[fi]; /* fix 2026-08-18: 名表优先 — func_tbl 索引在 pass 2 重排, fn_ret_si_map[fi] 会取到别的函数的返回类型; 仅当名表确无此函数时才回退索引表 (int 返回函数名表有记录 ret_si=-1, 不得回退到错位索引) */
            整 sret_ptr = fn_ret_name_get_ptr(fname);
            整 sret_discard = (sret_si >= 0 && stypes[sret_si].sz > 8 && cg_sret_off == 0 && !sret_ptr); /* fix 2026-08-30 csmith s16: discarded sret call (bare f(); no target) still uses sret ABI with a stack temp */
            整 is_sret = (sret_si >= 0 && stypes[sret_si].sz > 8 && (cg_sret_off != 0 || sret_discard) && !sret_ptr);
            整 sret_extra = nargs > 3 ? nargs - 3 : 0;
            /* function pointer variable or expression callee (indirect call). NOTE: no
               `||` short-circuit dependency — the self-host compiler evaluates BOTH
               sides of ||, so func_tbl[fi] with fi=-1 (expression callee) would read
               func_tbl[-1] and crash. Use if/else instead. */
            整 fnptr;
            若 (nt[fn] != 1) fnptr = 1;
            否 若 (var_lookup(fname) >= 0 && (fi < 0 || !func_tbl[fi].defined)) fnptr = 1; /* fp(a,b): callee is a (fnptr) VARIABLE, not a function */
            否 fnptr = 0;
            /* fix 2026-08-30 探雷雷3: 未声明函数检查 — C99 废除隐式声明. 名字调用既无定义
               (defined)、无原型 (declared)、非函数指针变量 (fnptr)、非内置 → [ERR]
               (原静默 stub 返回 0, AI 拿到假结果) */
            若 (nt[fn] == 1 && fi >= 0 && !func_tbl[fi].defined && !func_tbl[fi].declared
                && !fnptr && !is_qcc_builtin(fname)) {
                整 _pr = 0; /* fix 2026-08-30 探雷雷3 修正: 原型/声明独立表 (decl_names, 跨 gen_code 保留) - int foo(void); 只有原型没定义在 -c 多文件合法 */
                遍 (整 _di = 0; _di < decl_cnt && !_pr; _di++) 若 (!strcmp(decl_names[_di], fname)) _pr = 1;
                若 (!_pr) { sprintf(g_errbuf, "未声明函数 '%s' — 调用前需定义或声明原型 (v3.0, C99 隐式声明已废除)", fname);
                emit_error("A1001", g_errbuf);
            }
            }
