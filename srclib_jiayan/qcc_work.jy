静 整 fn_ret_si_map[1024]; /* return-struct index per func index; survives gen_code's func_n=0 reset (fix 2026-08-07: 512→1024 对齐 func_tbl) */
静 整 fn_ret_ptr_map[1024]; /* 函数返回 struct 指针（不是 sret）标记 */
/* return-struct type per FUNCTION NAME — func_tbl indexes are REASSIGNED by
   gen_code's func_n=0 reset, so index-based fn_ret_si_map misaligns whenever a
   program adds/removes functions (e.g. printf) between parse and codegen. */
静 构 { 字 name[64]; 整 ret_si; 整 ret_ptr; } fn_ret_name_map[512]; 静 整 fn_ret_name_n;
静 整 fn_ret_name_get(常 字 *name) {
    遍 (整 i = 0; i < fn_ret_name_n; i++) 若 (!strcmp(fn_ret_name_map[i].name, name)) 返 fn_ret_name_map[i].ret_si;
    返 -1;
}
静 整 fn_ret_name_get_ptr(常 字 *name) {
    遍 (整 i = 0; i < fn_ret_name_n; i++) 若 (!strcmp(fn_ret_name_map[i].name, name)) 返 fn_ret_name_map[i].ret_ptr;
    返 0;
}
静 空 fn_ret_name_put(常 字 *name, 整 ret_si, 整 ret_ptr) {
