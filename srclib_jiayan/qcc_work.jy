                    返 -1;
                }
                若 (cast_arresz > 0) { /* (int[N]){...} 或 (int[]){...} — 显式数组后缀走数组路径, dims 由 compound_literal 推断 */
                    返 compound_literal(0, -1, 1, cast_arrn, cast_arresz);
                }
                /* 标量 (int){5} 或 struct (已在上方处理): 走普通标量路径 */
                返 compound_literal(0, -1, 0, 0, 0);
