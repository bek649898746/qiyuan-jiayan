        { 整 d = Nd(7); memcpy((字*)(nn + d), rrname, 32); Nc(d, e_r); Nc(blk, d); } /* int __rr = rows; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), ccname, 32); Nc(d, e_c); Nc(blk, d); } /* int __cc = cols; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), rname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __tr = 0; */
