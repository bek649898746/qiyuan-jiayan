                                否 若 (fsz == 1) { ir_emit(I_STORE_RAX_BYTE, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: static 存 char */
                否 若 (fsz == 2) { ir_emit(I_STORE_RAX_WORD, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: static 存 short */
                                否 { ir_emit(I_STORE_RAX32, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: static 存 32 */
                                mov_rr(0, 3); /* eax = stored value (chained assignments) */
                              }
                            }
                        } 否 若 (var_big_param(vname)) {
                            /* big-struct param field write: load copy ptr, +foff, store */
                            cg(n1[n]); 若 (fsz == 8) ll_ext32(n1[n]); push_r(0); /* fix 2026-08-31 csmith s13: big_param int64 field sign-extend */
                            若 (var_isstatic(vname)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); } 否 { ir_emit(I_LOAD_RBP64, 0, off - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case10: big_param 字段写 copy ptr */
                            若 (foff != 0) { ir_emit(I_ADD_RAX_IMM8, foff, 0, 0); ir_flush(); } /* Phase3-IR case10: big_param 字段偏移 */
                            pop_r(3);
                            若 (bf_store(stypes[si].name, fname)) { /* bit-field RMW store (fix 2026-08-05) */ }
