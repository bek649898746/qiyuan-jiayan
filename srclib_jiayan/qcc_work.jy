/* ========== 编译期执行完整 CTFE (2026-08-28 type-root-16 #76): 编译期 f(常量...) — 用户纯函数编译期求值 ========== */
静 构 { 字 name[64]; 整 body0; 整 body1; } ctfe_fns[2048]; 静 整 ctfe_fns_n = 0; /* 函数体 token 范围 (函数定义时记录) */
静 整 ctfe_find(常 字 *n) { 遍 (整 i = 0; i < ctfe_fns_n; i++) 若 (!strcmp(ctfe_fns[i].name, n)) 返 i; 返 -1; }
静 字 ctfe_names[64][64]; 静 整 ctfe_vals[64]; 静 整 ctfe_n = 0; /* CTFE 求值帧 (参数+局部, 栈式嵌套) */
静 整 ctfe_lookup(常 字 *n) { 遍 (整 i = ctfe_n - 1; i >= 0; i--) 若 (!strcmp(ctfe_names[i], n)) 返 ctfe_vals[i]; 返 0x80000000; }
静 字 cur_parse_fn[64]; /* 2026-08-28 P1 #11: 当前解析的函数名 (悬垂引用检测用) */
/* ========== 过程宏 (2026-08-29 P2 #172): 编译期跑函数生成代码 — CTFE 字符串返回 + 调用点 token 拼接 ==========
   语义: 过程宏 函数名; 注册 (函数须先定义, CTFE 需函数体 token 范围); 调用点 宏名(常量...)
   → ctfe_call_str 解释函数体得生成代码串 → pm_tokenize 落位 → memmove 就地拼接 → 续解析。 */
静 字 pm_names[256][64]; 静 整 pm_n = 0; /* 已注册过程宏函数名表 (parse 重置) */
静 整 pm_find(常 字 *n) { 遍 (整 i = 0; i < pm_n; i++) 若 (!strcmp(pm_names[i], n)) 返 1; 返 0; }
静 字 ctfe_isstr[64]; /* CTFE 帧槽是否存字符串 (int/串 双态) */
