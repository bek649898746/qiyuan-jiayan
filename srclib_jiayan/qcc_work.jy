/* 外部数学函数 → IAT slot 8-23（非 coff 模式；fix 2026-08-06 BUG-1） */
静 整 fn_math_iat(常 字 *n) {
    若 (!strcmp(n, "pow")) 返 8;
    若 (!strcmp(n, "atan2")) 返 9;
    若 (!strcmp(n, "fmod")) 返 10;
    若 (!strcmp(n, "sqrt")) 返 11;
    若 (!strcmp(n, "cos")) 返 12;
    若 (!strcmp(n, "sin")) 返 13;
    若 (!strcmp(n, "tan")) 返 14;
    若 (!strcmp(n, "acos")) 返 15;
    若 (!strcmp(n, "asin")) 返 16;
    若 (!strcmp(n, "atan")) 返 17;
    若 (!strcmp(n, "log")) 返 18;
    若 (!strcmp(n, "log10")) 返 19;
    若 (!strcmp(n, "exp")) 返 20;
    若 (!strcmp(n, "floor")) 返 21;
    若 (!strcmp(n, "ceil")) 返 22;
    若 (!strcmp(n, "fabs")) 返 23;
    返 -1;
}

