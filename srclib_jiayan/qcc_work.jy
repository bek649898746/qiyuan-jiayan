          整 d = Nd(7); memcpy((字*)(nn + d), avname, 32); Nc(d, div); Nc(blk, d); } /* int __va = __vm/__vn; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), svname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __vs = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), siname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __vi = 0; (重置) */
        整 wh2 = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), siname, 32);
          整 v_sn = Nd(1); memcpy((字*)(nn + v_sn), snname, 32);
          整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, v_sn); Nc(wh2, cmp); }
        整 bd2 = Nd(5);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), siname, 32);
          整 idx = Nd(14); Nc(idx, v_r); Nc(idx, v_i); /* arr[__vi] */
          { 整 v_a = Nd(1); memcpy((字*)(nn + v_a), avname, 32);
            整 sub = Nd(2); nv[sub] = MK; Nc(sub, idx); Nc(sub, v_a); /* arr[__vi]-__va */
            整 d = Nd(7); memcpy((字*)(nn + d), dfname, 32); Nc(d, sub); Nc(bd2, d); } /* int __vd = arr[__vi]-__va; */
          { 整 v_d = Nd(1); memcpy((字*)(nn + v_d), dfname, 32);
            整 v_d2 = Nd(1); memcpy((字*)(nn + v_d2), dfname, 32);
            整 mul = Nd(2); nv[mul] = DK; Nc(mul, v_d); Nc(mul, v_d2); /* __vd*__vd */
            { 整 v_s = Nd(1); memcpy((字*)(nn + v_s), svname, 32);
              整 add = Nd(2); nv[add] = PK; Nc(add, v_s); Nc(add, mul);
              整 asg = Nd(10); Nc(asg, v_s); Nc(asg, add); Nc(bd2, asg); } } } /* __vs += __vd*__vd; */
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), siname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i2); Nc(asg, pl); Nc(bd2, asg); }
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd2, setl); nv[wh2] = cl + 1; }
        Nc(wh2, bd2);
        Nc(blk, wh2);
        { 整 v_s = Nd(1); memcpy((字*)(nn + v_s), svname, 32);
          整 v_sn = Nd(1); memcpy((字*)(nn + v_sn), snname, 32);
          整 div = Nd(2); nv[div] = DV; Nc(div, v_s); Nc(div, v_sn);
          整 asg = Nd(10); Nc(asg, v_v); Nc(asg, div); Nc(blk, asg); } /* v = __vs/__vn; */
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "累积")) { /* 接入 2026-08-27 前缀和 (scan): 累积 dst, src, n, acc; → { acc=0; __sc=0; while(__sc<n){ acc = acc+src[__sc]; dst[__sc]=acc; __sc++; } } — 前缀和, acc 须已声明 */
        tk++; /* 累积 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        字 accn[64]; strcpy(accn, tn[tk]); tk++; /* 累加器 (须已声明) */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 sc_seq = 0; 字 iname[64]; sprintf(iname, "__sc_%d_", sc_seq++);
        var_offset(iname);
        整 blk = Nd(5);
        整 v_a = Nd(1); memcpy((字*)(nn + v_a), accn, 32);
        { 整 z = Nd(0); nv[z] = 0; 整 asg = Nd(10); Nc(asg, v_a); Nc(asg, z); Nc(blk, asg); } /* acc = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __sc = 0; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__sc < n) */
        整 bd = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, v_i); /* src[__sc] */
          整 add = Nd(2); nv[add] = PK; Nc(add, v_a); Nc(add, idx_s); /* acc + src[__sc] */
          整 asg = Nd(10); Nc(asg, v_a); Nc(asg, add); Nc(bd, asg); /* acc = acc + src[__sc]; */
          整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
          整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_i2); /* dst[__sc] */
          整 asg2 = Nd(10); Nc(asg2, idx_d); Nc(asg2, v_a); Nc(bd, asg2); /* dst[__sc] = acc; */
        }
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i2); Nc(asg, pl); Nc(bd, asg); } /* __sc++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "累积积")) { /* 接入 2026-08-28 前缀积 (scan product): 累积积 dst, src, n, acc; → { acc=1; __cp=0; while(__cp<n){ acc=acc*src[__cp]; dst[__cp]=acc; __cp++; } } — 复用累积模式 (乘代替加) */
        tk++; /* 累积积 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        字 accn[64]; strcpy(accn, tn[tk]); tk++; /* 累加器 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 cp_seq = 0; 字 iname[64]; sprintf(iname, "__cp_%d_", cp_seq++);
        var_offset(iname);
        整 blk = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
