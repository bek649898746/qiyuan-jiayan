静 整 Nd(整 t);
静 空 Nc(整 p, 整 c);
静 整 expr(空);
/* Brace initializer: walk struct si's fields, consuming values from the token
   stream ({ a, b, c }) and emitting assignments against the base expression
   (a Nd(1) var or a Nd(15) nested-member node). Nested struct fields recurse;
   array fields expand per element. Returns a block of assignment nodes. */
静 整 brace_fields(整 si, 整 base) {
    整 blk = Nd(5);
    整 fidx = 0;
    循环 (tt[tk] != UK && tt[tk] != EK) { /* 到 } 为止 — 乱序指定初始化器时 fidx 可能超 fn (fix 2026-08-05) */
        若 (tt[tk] == CK || tt[tk] == SK) { tk++; 续; } /* skip comma between values */
        若 (tt[tk] == UK) 断;
        若 (tt[tk] == DT && tt[tk + 1] == VR) { /* 指定初始化器: .field = expr */
            tk++; /* . */
            字 fld[32]; strcpy(fld, tn[tk]); tk++; /* 字段名 */
            若 (tt[tk] == AK) tk++; /* = */
            整 tgt = -1;
            遍 (整 j = 0; j < stypes[si].fn; j++) 若 (!strcmp(stypes[si].fnames[j], fld)) { tgt = j; 断; }
            若 (tgt < 0) { 循环 (tt[tk] != CK && tt[tk] != UK && tt[tk] != EK) tk++; 续; }
            fidx = tgt; /* 跳到指定字段（可能回退） */
            续;
        }
        若 (fidx >= stypes[si].fn) { expr(); fidx++; 续; } /* 字段耗尽: 丢弃多余值 */
        字 fname[32]; strcpy(fname, stypes[si].fnames[fidx]);
        整 fty = stypes[si].ftypes[fidx];
        整 fsz2 = stypes[si].fsizes[fidx];
        整 frow2 = stypes[si].frows[fidx];
        整 mem = Nd(15); memcpy((字*)(nn + mem), fname, 32); nv[mem] = 0;
        Nc(mem, base);
        若 (fty >= 0) { /* nested struct field: recurse into its fields */
            若 (tt[tk] == FK) tk++; /* explicit nested braces { ... } */
            整 sub = brace_fields(fty, mem);
            若 (tt[tk] == UK) tk++; /* skip closing } */
            遍 (整 k = 0; k < 256; k++) { 整 c = child_i(sub, k); 若 (c > 0) Nc(blk, c); }
        } 否 若 (frow2 > 0 && fsz2 > frow2) { /* array field: per element */
            整 nfield = fsz2 / frow2;
            遍 (整 ei = 0; ei < nfield; ei++) {
                若 (tt[tk] == CK || tt[tk] == SK) tk++;
                若 (tt[tk] == UK) 断;
                整 acc = Nd(14); Nc(acc, mem);
                整 idx = Nd(0); nv[idx] = ei; Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc); Nc(asgn, expr()); Nc(blk, asgn);
            }
        } 否 { /* scalar field */
            整 asgn = Nd(10); Nc(asgn, mem); Nc(asgn, expr()); Nc(blk, asgn);
        }
        fidx++;
    }
    返 blk;
}

静 整 kw(常 字 *s) {
    /* 甲言中文关键字已在 lexer 改写成英文 (tn), 此处只认英文 */
    若 (!strcmp(s, "struct") || !strcmp(s, "union")) 返 ST; /* union shares the struct machinery (offset-0 fields) */
    若 (!strcmp(s, "extern")) 返 VK;
    若 (!strcmp(s, "static")) 返 VK; /* treat as type modifier */
    若 (!strcmp(s, "const")) 返 VK;
    若 (!strcmp(s, "volatile")) 返 VK; /* 类型修饰符（fix 2026-08-06: 内核 MMIO 需要） */
    若 (!strcmp(s, "void")) 返 VK;
    若 (!strcmp(s, "FILE") || !strcmp(s, "long")) 返 VK; /* builtin types used by self-host */
    若 (!strcmp(s, "enum")) 返 EN;
    若 (!strcmp(s, "return")) 返 RK;
    若 (!strcmp(s, "if")) 返 IK;
    若 (!strcmp(s, "else")) 返 ZK;
    若 (!strcmp(s, "while")) 返 WK;
    若 (!strcmp(s, "do")) 返 DW;
    若 (!strcmp(s, "goto")) 返 GT;
    若 (!strcmp(s, "for")) 返 JK;
    若 (!strcmp(s, "break")) 返 BR;
    若 (!strcmp(s, "continue")) 返 CN;
    若 (!strcmp(s, "switch")) 返 SW;
    若 (!strcmp(s, "case")) 返 CA;
    若 (!strcmp(s, "default")) 返 DF;
    若 (!strcmp(s, "unsigned")) 返 VK;
    若 (!strcmp(s, "int") || !strcmp(s, "double")) 返 VK;
    若 (!strcmp(s, "char")) 返 VK;
    若 (!strcmp(s, "short")) 返 VK; /* fix 2026-08-06: 镜像 qcc_x86.c — short 缺词法分类 → struct 字段当标识符注册成幻影字段 (回归测试 regress_struct_align 暴露) */
    若 (!strcmp(s, "void")) 返 VK;
    若 (!strcmp(s, "sizeof")) 返 BK;
    返 NK;
}

静 空 lex(常 字 *s) {
    整 i = 0; ti = 0; tk = 0;
    /* 跳过 UTF-8 BOM（EF BB BF）：否则第一个 token 是 BOM 字节，parse 全灭。
       用嵌套 if 而非 && 链：qcc_x86 编本文件时对复杂条件链生成"自比较"错码 */
    若 (s[0] == (字)0xEF) {
        若 (s[1] == (字)0xBB) {
            若 (s[2] == (字)0xBF) i = 3;
        }
    }
    循环 (s[i] && ti < TS) {
        循环 (s[i] == ' ' || s[i] == '\n' || s[i] == '\t' || s[i] == '\r') i++;
        若 (!s[i]) 断;
        若 (if_skip && s[i] != '#') { 循环 (s[i] && s[i] != '\n') i++; 续; } /* 假分支跳过整行（fix 2026-08-05） */
        若 (s[i] == '/' && s[i + 1] == '/') { 循环 (s[i] && s[i] != '\n') i++; 续; }
        若 (s[i] == '/' && s[i + 1] == '*') { i += 2; 循环 (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++; 若 (s[i]) i += 2; 续; }
        若 (s[i] == '#') { /* #define / #include / 条件编译（fix 2026-08-05） */
            整 is_def = (s[i + 1] == 'd' && !strncmp(s + i, "#define", 7));
            整 is_ifdef = !strncmp(s + i, "#ifdef", 6);
            整 is_ifndef = !strncmp(s + i, "#ifndef", 7);
            整 is_if = !strncmp(s + i, "#if", 3) && !is_ifdef && !is_ifndef;
            整 is_elif = !strncmp(s + i, "#elif", 5);
            整 is_else = !strncmp(s + i, "#else", 5);
            整 is_endif = !strncmp(s + i, "#endif", 6);
            整 is_undef = !strncmp(s + i, "#undef", 6);
            整 is_error = !strncmp(s + i, "#error", 6);
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = if_skip;
                字 expr[512]; 整 ei = 0;
                若 (is_if || is_elif) {
                    整 p = i;
                    若 (is_if) p += 3; 否 p += 5;
                    循环 (s[p] == ' ' || s[p] == '\t') p++;
                    循环 (s[p] && s[p] != '\n' && ei < 510) { expr[ei] = s[p]; ei++; p++; }
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--; /* trim trailing (fix 2026-08-05: "#if VER > 1" left "VER " → macro lookup failed) */
                }
                expr[ei] = 0;
                整 cond = 0;
                若 (is_ifdef || is_ifndef) { /* #ifdef NAME / #ifndef NAME — 直接从 s[] 读宏名 */
                    字 nm[32]; 整 ni = 0;
                    整 p2 = i + (is_ifdef ? 6 : 7);
                    循环 (s[p2] == ' ' || s[p2] == '\t') p2++;
                    循环 (isalnum(s[p2]) || s[p2] == '_' || ((无 字)s[p2] >= 0x80)) { 若 (ni < 31) { nm[ni] = s[p2]; ni++; } p2++; }
                    nm[ni] = 0;
                    整 def = macro_exists(nm); /* fix 2026-08-06: 原 macro_find>=0 判假 */
                    cond = is_ifdef ? def : !def;
                } 否 若 (is_if || is_elif) {
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (if_n < 64) {
                        if_parent_skip[if_n] = parent;
                        若 (is_if || is_ifdef || is_ifndef) { if_taken[if_n] = cond && !parent; if_skip = parent || !cond; }
                        if_n++;
                    }
                } 否 若 (is_elif) {
                    若 (if_n > 0) {
                        若 (!if_taken[if_n - 1] && !if_parent_skip[if_n - 1]) { if_taken[if_n - 1] = cond; if_skip = if_parent_skip[if_n - 1] || !cond; }
                        否 if_skip = 1;
                    }
                } 否 若 (is_else) {
                    若 (if_n > 0) {
                        若 (!if_taken[if_n - 1] && !if_parent_skip[if_n - 1]) { if_taken[if_n - 1] = 1; if_skip = if_parent_skip[if_n - 1]; }
                        否 if_skip = 1;
                    }
                } 否 若 (is_endif) {
                    若 (if_n > 0) { if_n--; if_skip = if_n > 0 ? if_parent_skip[if_n - 1] : 0; }
                }
                循环 (s[i] && s[i] != '\n') { 若 (s[i] == '\\' && s[i + 1] == '\n') i += 2; 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') i += 3; 否 i++; }
                续;
            }
            若 (if_skip) { /* 假分支：跳过所有行（含 #define/#include）直到 #endif/#elif/#else */
                循环 (s[i] && s[i] != '\n') { 若 (s[i] == '\\' && s[i + 1] == '\n') i += 2; 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') i += 3; 否 i++; }
                续;
            }
            若 (is_undef) { /* #undef NAME — 从三个宏表删除（fix 2026-08-05） */
                整 p = i + 6;
                循环 (s[p] == ' ' || s[p] == '\t') p++;
                字 un[32]; 整 ui = 0;
                循环 (isalnum(s[p]) || s[p] == '_' || ((无 字)s[p] >= 0x80)) { 若 (ui < 31) un[ui++] = s[p]; p++; }
                un[ui] = 0;
                若 (ui > 0) macro_remove(un);
                循环 (s[i] && s[i] != '\n') i++;
                续;
            }
            若 (is_error) { /* #error msg — 硬诊断（fix 2026-08-05） */
                整 p = i + 6;
                循环 (s[p] == ' ' || s[p] == '\t') p++;
                字 em[512]; 整 ei = 0;
                循环 (s[p] && s[p] != '\n' && ei < 510) em[ei++] = s[p++];
                em[ei] = 0;
                fprintf(stderr, "[ERR] #error: %s\n", em);
                exit(1);
            }
            若 (is_def) {
                i += 7;
                循环 (s[i] == ' ' || s[i] == '\t') i++;
                字 mname[32]; 整 mi2 = 0;
                循环 (isalnum(s[i]) || s[i] == '_' || ((无 字)s[i] >= 0x80)) { 若 (mi2 < 31) mname[mi2++] = s[i]; i++; }
                mname[mi2] = 0;
                循环 (s[i] == ' ' || s[i] == '\t') i++;
                若 (s[i] == '(') { /* function-like macro �?skip definition */
                    循环 (s[i] && s[i] != '\n') { 若 (s[i] == '\\' && s[i + 1] == '\n') i += 2; 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') i += 3; 否 i++; }
                    续;
                }
                整 mval = 0;
                整 msign = 1; /* fix 2026-08-06: #define NEG -5 负号丢弃 → NEG=0 (镜像 qcc_x86.c) */
                若 (s[i] == '-') { msign = -1; i++; }
                若 (s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) { i += 2; 循环 (isxdigit(s[i])) { 整 c = s[i]; 若 (c >= '0' && c <= '9') mval = mval * 16 + (c - '0'); 否 若 (c >= 'a' && c <= 'f') mval = mval * 16 + (c - 'a' + 10); 否 mval = mval * 16 + (c - 'A' + 10); i++; } }
                否 { 循环 (isdigit(s[i])) { mval = mval * 10 + (s[i++] - '0'); } }
                macro_add(mname, msign * mval);
            }
            循环 (s[i] && s[i] != '\n') { 若 (s[i] == '\\' && s[i + 1] == '\n') i += 2; 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') i += 3; 否 i++; } /* skip line incl. \ continuations */
            续;
        }
        若 (s[i] == '\'') { /* char literal 'c' */
            i++;
            整 cval = 0;
            若 (s[i] == '\\') { i++; cval = s[i]=='n'?10:s[i]=='t'?9:s[i]=='r'?13:s[i]=='0'?0:s[i]=='\\'?92:s[i]=='\''?39:s[i]; i++; }
            否 { cval = s[i]; i++; }
            若 (s[i] == '\'') i++;
            tt[ti] = NK; tv[ti] = cval; ti++; 续;
        }
        若 (isdigit(s[i])) { tt[ti] = NK; tv[ti] = 0; tuns[ti] = 0; tll_hi[ti] = 0; 长 长 v64 = 0; /* 64 位累加器：大 LL 字面量（fix 2026-08-05） */
            若 (s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
                i += 2;
                /* 十六进制浮点字面量 0x1.8p3 / 0x1p3 (C99; fix 2026-08-05) */
                整 j = i; 循环 (isxdigit((无 字)s[j])) j++;
                整 is_hexfp = 0;
                若 (s[j] == '.' && isxdigit((无 字)s[j + 1])) is_hexfp = 1;
                否 若 (s[j] == 'p' || s[j] == 'P') is_hexfp = 1;
                若 (is_hexfp) {
                    整 fhi, flo;
                    hexfp_parse(s, &i, &fhi, &flo);
                    若 (dbl_n >= 1024) { fprintf(stderr, "[ERR] double 字面量表满 (fix 2026-08-06 M3)\n"); exit(1); } dbl_hi[dbl_n] = fhi; dbl_lo[dbl_n] = flo;
                    tt[ti] = FP; tv[ti] = dbl_n; dbl_n++;
                    ti++; 续;
                }
                循环 (isxdigit(s[i])) { 整 c = s[i]; 若 (c >= '0' && c <= '9') v64 = v64 * 16 + (c - '0'); 否 若 (c >= 'a' && c <= 'f') v64 = v64 * 16 + (c - 'a' + 10); 否 v64 = v64 * 16 + (c - 'A' + 10); i++; }
            } 否 {
                /* floating literal? digits '.' digits  or digits e[+-]digits */
                整 j = i; 循环 (isdigit(s[j])) j++;
                整 is_fp = 0;
                若 (s[j] == '.' && isdigit(s[j + 1])) is_fp = 1;
                否 若 ((s[j] == 'e' || s[j] == 'E')) is_fp = 1;
                若 (is_fp) {
                    整 fhi, flo;
                    fp_parse(s, &i, &fhi, &flo);
                    若 (s[i] == 'f' || s[i] == 'F') i++; /* 浮点后缀 1.5f → double（C 原版 1466） */
                    若 (dbl_n >= 1024) { fprintf(stderr, "[ERR] double 字面量表满 (fix 2026-08-06 M3)\n"); exit(1); } dbl_hi[dbl_n] = fhi; dbl_lo[dbl_n] = flo; /* 不去重（C 原版 1467）：自举对齐 */
                    tt[ti] = FP; tv[ti] = dbl_n; dbl_n++;
                    ti++; 续;
                }
                if (is_fp) {
                    整 fhi, flo;
                    fp_parse(s, &i, &fhi, &flo);
                    若 (s[i] == 'f' || s[i] == 'F') i++; /* 浮点后缀 1.5f → double（C 原版 1466） */
                    若 (dbl_n >= 1024) { fprintf(stderr, "[ERR] double 字面量表满 (fix 2026-08-06 M3)\n"); exit(1); } dbl_hi[dbl_n] = fhi; dbl_lo[dbl_n] = flo; /* 不去重（C 原版 1467）：自举对齐 */
                    tt[ti] = FP; tv[ti] = dbl_n; dbl_n++;
                    ti++; 续;
                }
                若 (s[i] == '0' && s[i + 1] >= '0' && s[i + 1] <= '7') { /* 八进制 0755 = 493 (fix 2026-08-05: was decimal → 755) */
                    循环 (s[i] >= '0' && s[i] <= '7') v64 = v64 * 8 + (s[i++] - '0');
                } 否 {
                    循环 (isdigit(s[i])) v64 = v64 * 10 + (s[i++] - '0');
                }
            }
            tv[ti] = (整)v64; tll_hi[ti] = (整)(v64 >> 32); /* 低/高 32（fix 2026-08-05） */
            若 (s[i] == 'u' || s[i] == 'U') { tuns[ti] = 1; i++; } /* unsigned 后缀 0xFFFFFFFFu (fix 2026-08-05) */
            若 (s[i] == 'l' || s[i] == 'L') { 循环 (s[i] == 'l' || s[i] == 'L') i++; tll[ti] = 1; } /* long long 后缀（fix 2026-08-05） */
            ti++; 续; }
        若 (isalpha(s[i]) || s[i] == '_' || ((无 字)s[i] >= 0x80)) { 整 j = 0; 循环 (isalnum(s[i]) || s[i] == '_' || ((无 字)s[i] >= 0x80)) { 若 (j < 31) tn[ti][j++] = s[i]; i++; } tn[ti][j] = 0;
            /* 甲言库函数: 中文名 → 英文名 (输出→printf, 分配→malloc ...) */
            若 (!strcmp(tn[ti], "输出")) strcpy(tn[ti], "printf");
            否 若 (!strcmp(tn[ti], "输入")) strcpy(tn[ti], "scanf");
            否 若 (!strcmp(tn[ti], "分配")) strcpy(tn[ti], "malloc");
            否 若 (!strcmp(tn[ti], "释放")) strcpy(tn[ti], "free");
            否 若 (!strcmp(tn[ti], "字长")) strcpy(tn[ti], "strlen");
            否 若 (!strcmp(tn[ti], "字比")) strcpy(tn[ti], "strcmp");
            否 若 (!strcmp(tn[ti], "字拷")) strcpy(tn[ti], "strcpy");
            否 若 (!strcmp(tn[ti], "内存拷")) strcpy(tn[ti], "memcpy");
            否 若 (!strcmp(tn[ti], "内存置")) strcpy(tn[ti], "memset");
            否 若 (!strcmp(tn[ti], "打开")) strcpy(tn[ti], "fopen");
            否 若 (!strcmp(tn[ti], "读取")) strcpy(tn[ti], "fread");
            否 若 (!strcmp(tn[ti], "写入")) strcpy(tn[ti], "fwrite");
            /* 甲言关键字: 中文 → 英文名 (解析器二次 strcmp 判断需要英文 tn) */
            否 若 (!strcmp(tn[ti], "构")) strcpy(tn[ti], "struct");
            否 若 (!strcmp(tn[ti], "联")) strcpy(tn[ti], "union");
            否 若 (!strcmp(tn[ti], "枚")) strcpy(tn[ti], "enum");
            否 若 (!strcmp(tn[ti], "返")) strcpy(tn[ti], "return");
            否 若 (!strcmp(tn[ti], "若")) strcpy(tn[ti], "if");
            否 若 (!strcmp(tn[ti], "否")) strcpy(tn[ti], "else");
            否 若 (!strcmp(tn[ti], "循环")) strcpy(tn[ti], "while");
            否 若 (!strcmp(tn[ti], "做")) strcpy(tn[ti], "do");
            否 若 (!strcmp(tn[ti], "遍")) strcpy(tn[ti], "for");
            否 若 (!strcmp(tn[ti], "断")) strcpy(tn[ti], "break");
            否 若 (!strcmp(tn[ti], "续")) strcpy(tn[ti], "continue");
            否 若 (!strcmp(tn[ti], "择")) strcpy(tn[ti], "switch");
            否 若 (!strcmp(tn[ti], "例")) strcpy(tn[ti], "case");
            否 若 (!strcmp(tn[ti], "缺")) strcpy(tn[ti], "default");
            否 若 (!strcmp(tn[ti], "跳")) strcpy(tn[ti], "goto");
            否 若 (!strcmp(tn[ti], "整")) strcpy(tn[ti], "int");
            否 若 (!strcmp(tn[ti], "双")) strcpy(tn[ti], "double");
            否 若 (!strcmp(tn[ti], "单")) strcpy(tn[ti], "double");
            否 若 (!strcmp(tn[ti], "float")) strcpy(tn[ti], "double"); /* float → double（8 字节 SSE）（fix 2026-08-05） */
            否 若 (!strcmp(tn[ti], "字")) strcpy(tn[ti], "char");
            否 若 (!strcmp(tn[ti], "空")) strcpy(tn[ti], "void");
            否 若 (!strcmp(tn[ti], "短")) strcpy(tn[ti], "short");
            否 若 (!strcmp(tn[ti], "长")) strcpy(tn[ti], "long");
            否 若 (!strcmp(tn[ti], "常")) strcpy(tn[ti], "const");
            否 若 (!strcmp(tn[ti], "静")) strcpy(tn[ti], "static");
            否 若 (!strcmp(tn[ti], "无")) strcpy(tn[ti], "unsigned");
            否 若 (!strcmp(tn[ti], "大小")) strcpy(tn[ti], "sizeof");
            整 k = kw(tn[ti]);            若 (k == NK) { 字 *sm = str_macro_find(tn[ti]); 若 (sm) { 若 (str_cnt >= 1024) { fprintf(stderr, "[STR-OVERFLOW]\n"); abort(); } 整 k2 = 0; 循环 (sm[k2] && k2 < 2046) { str_tbl[str_cnt][k2] = sm[k2]; k2++; } 若 (k2 >= 2046 && sm[k2]) { fprintf(stderr, "[ERR] 字符串宏值超过 2046 字符 (fix 2026-08-06)\n"); exit(1); } str_tbl[str_cnt][k2] = 0; tt[ti] = STR; tv[ti] = str_cnt; str_cnt++; ti++; 续; } 整 found_num = 0, nvv = 0; 遍 (整 mi = 0; mi < macro_n; mi++) 若 (!strcmp(macros[mi].name, tn[ti])) { found_num = 1; nvv = macros[mi].val; 断; } 若 (found_num) { tt[ti] = NK; tv[ti] = nvv; ti++; 续; } /* fix 2026-08-06: 字符串宏优先; 数值宏含负值 */ tt[ti] = VR; } 否 tt[ti] = k; ti++; 续; }
        若 (s[i] == '"') { i++; 整 j = 0; 循环 (1) { /* 相邻字面量拼接 "a" "b" -> "ab" (fix 2026-08-06) */ 循环 (s[i] && s[i] != '"' && j < 2046) { 若 (s[i] == '\\' && s[i + 1]) { i++; 若 (s[i] == 'n') str_tbl[str_cnt][j++] = '\n'; 否 若 (s[i] == 't') str_tbl[str_cnt][j++] = '\t'; 否 若 (s[i] == '0') str_tbl[str_cnt][j++] = 0; 否 str_tbl[str_cnt][j++] = s[i]; } 否 str_tbl[str_cnt][j++] = s[i]; i++; } 若 (j >= 2046 && s[i] != '"') { fprintf(stderr, "[ERR] 字符串字面量超过 2046 字符上限 (fix 2026-08-06)\n"); exit(1); } i++; 整 ni = i; 循环 (s[ni] == ' ' || s[ni] == '\t' || s[ni] == '\n' || s[ni] == '\r') ni++; 若 (s[ni] == '"') { i = ni + 1; 续; } 断; } str_tbl[str_cnt][j] = 0; tt[ti] = STR; tv[ti] = str_cnt; ti++; str_cnt++; 续; }
        若 (s[i] == '\'') { /* char literal 'x' �?NK */
            i++; 整 cv = s[i];
            若 (cv == '\\' && s[i + 1]) { i++; cv = (s[i] == 'n') ? '\n' : (s[i] == 't') ? '\t' : (s[i] == '0') ? 0 : s[i]; i++; }
            否 i++;
            若 (s[i] == '\'') i++;
            tt[ti] = NK; tv[ti] = cv; ti++; 续;
        }
        择 (s[i]) { 例 '+': tt[ti] = s[i + 1] == '+' ? (i++, PP) : s[i + 1] == '=' ? (i++, PA) : PK; 断; 例 '-': tt[ti] = s[i + 1] == '>' ? (i++, AR) : s[i + 1] == '-' ? (i++, MM) : s[i + 1] == '=' ? (i++, MA) : MK; 断; 例 '*': tt[ti] = s[i + 1] == '=' ? (i++, DA) : DK; 断; 例 '/': tt[ti] = s[i + 1] == '=' ? (i++, SA) : DV; 断; 例 '%': tt[ti] = s[i + 1] == '=' ? (i++, MS) : MD; 断; 例 '&': tt[ti] = s[i + 1] == '=' ? (i++, AA) : s[i + 1] == '&' ? (i++, LA) : PT; 断; 例 '|': tt[ti] = s[i + 1] == '=' ? (i++, OA) : s[i + 1] == '|' ? (i++, LO) : OR; 断; 例 '^': tt[ti] = s[i + 1] == '=' ? (i++, XA) : XR; 断; 例 '~': tt[ti] = BN; 断; 例 '?': tt[ti] = QU; 断; 例 '.': tt[ti] = DT; 断; 例 '=': tt[ti] = s[i + 1] == '=' ? (i++, QK) : AK; 断; 例 '<': tt[ti] = s[i + 1] == '<' ? (s[i + 2] == '=' ? (i += 2, SHL) : (i++, SH)) : s[i + 1] == '=' ? (i++, HK) : LK; 断; 例 '>': tt[ti] = s[i + 1] == '>' ? (s[i + 2] == '=' ? (i += 2, SHR) : (i++, SR)) : s[i + 1] == '=' ? (i++, YK) : GK; 断; 例 '!': tt[ti] = s[i + 1] == '=' ? (i++, XK) : NT; 断; 例 ';': tt[ti] = SK; 断; 例 ',': tt[ti] = CK; 断; 例 '(': tt[ti] = OK; 断; 例 ')': tt[ti] = KK; 断; 例 '{': tt[ti] = FK; 断; 例 '}': tt[ti] = UK; 断; 例 '[': tt[ti] = LB; 断; 例 ']': tt[ti] = RB; 断; 例 ':': tt[ti] = CL; 断; 缺: 断; } ti++; i++;
