                }
                slot_n++;
            }
            /* fix 2026-08-30 csmith s16: discarded sret call (no assignment target) --
               allocate a temp hidden-pointer area on the stack; callee writes there,
               reclaimed by the call's add_rsp. offset includes total_h so it points at
               the temp bottom (sarg path missing total_h is a separate latent bug). */
            若 (sret_discard) {
                整 ds_tmp_sz = ((stypes[sret_si].sz + 7) / 8) * 8;
                sub_rsp_imm(ds_tmp_sz);
                total_h += ds_tmp_sz;
                cg_sret_off = -cur_frame_sz - total_h;
                cg_sret_static = 0;
            }
            /* fix 2026-08-07 Gate-1: Win64 ABI 调用点 rsp≡0(mod16)。基帧已 ≡0，
               压入 total_h/8 个槽后奇偶 = (total_h/8 + extra) & 1，奇数补 8 对齐。
               sret/user 的参数槽读取发生在 shadow sub 之后 → argbase 须随 pad 下移。 */
            整 shadow_pad = 0;
            若 (is_sret) shadow_pad = 8 * (((total_h / 8) + sret_extra) & 1);
            否 若 (is_user) shadow_pad = 8 * (((total_h / 8) + extra) & 1);
            否 若 (fnptr) shadow_pad = 8 * (((total_h / 8) + (nargs > 4 ? nargs - 4 : 0)) & 1);
            若 (is_sret || (is_user && !fnptr)) argbase += shadow_pad;
            若 (is_sret) {
                若 (sret_extra > 0) ir_emit(I_SUB_RSP_IMM, 32 + 8 * sret_extra + shadow_pad, 0, 0); 否 ir_emit(I_SUB_RSP_IMM, 32 + shadow_pad, 0, 0); ir_flush(); /* Phase3-IR */
            } 否 若 (is_user && !fnptr) {
                若 (extra > 0) ir_emit(I_SUB_RSP_IMM, 32 + 8 * extra + shadow_pad, 0, 0); 否 ir_emit(I_SUB_RSP_IMM, 32 + shadow_pad, 0, 0); ir_flush(); /* Phase3-IR */
            }
