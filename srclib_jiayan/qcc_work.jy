                        若 (getenv("QCC_DBG_NS")) 若 (strstr(ename, "ref_namespace")) fprintf(stderr, "[NS] extern '%s' e_stidx=%d e_esz=%d e_cnt=%d arr_sz=%d arr_esz=%d\n", ename, e_stidx, e_esz, e_cnt, vars[vi].arr_sz, vars[vi].arr_esz);
