                                ir_emit(I_LEA_RIP_OFF, off, 1, foff); ir_flush(); /* Phase3-IR case10: static 字段写地址 */
                                pop_r(3); /* ebx = rhs */
                                若 (bf_store(stypes[si].name, fname)) { /* bit-field RMW store (fix 2026-08-05) */ }
