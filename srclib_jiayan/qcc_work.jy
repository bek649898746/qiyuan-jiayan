                    整 esz = var_esz(vname);
                    mov_rr(11, 0); /* r11d = index */
                    若 (esz == 4) { asm_emit("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(2); }
                    否 若 (esz == 2) { asm_emit("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(1); }
                    否 若 (esz > 4) { mov_r_imm(0, esz); mov_rr(9, 0); asm_emit("    乘 r11, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 1, 0, 1); b(0x0F); b(0xAF); modrm(3, 3, 1); } /* IMUL r11d, r9d */
                    load_ptr_slot(off, vname); /* rax = ptr (static → RIP, else frame) */
                    movsxd_r11(); /* 32 位索引符号扩展 (fix 2026-08-19) */
                    asm_emit("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 1, 0, 0); b(0x01); modrm(3, 3, 0); /* ADD rax,r11 */
                    若 (!cg_no_deref) {
                        若 (var_pdbl(vname)) { asm_emit("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); modrm(0,0,0); } /* double* elem → xmm0 */
                        否 若 (esz == 1) { asm_emit("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB6); modrm(0, 0, 0); } /* movzx eax,byte[rax] */
                        否 若 (esz > 8) { /* row of a pointer-to-array (char (*)[N], N>8): leave the ADDRESS (C decay) */ }
                        否 若 (esz == 8) { mov_reg_mreg64(0, 0); } /* char** / int**: load the 8-byte pointer element */
                        否 若 (esz == 2) { asm_emit("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB7); modrm(0, 0, 0); } /* movzx eax, word [rax] fix 2026-08-08 */
                        否 { mov_reg_mreg(0, 0); }
                    }
                    did = 1;
                }
                若 (!did && var_isstatic(vname)) { /* static array: base = .data + idx*esz */
                    整 esz = 4, is_struct_elem = 0, is_row = 0;
                    遍 (整 vi = 0; vi < vs_n(); vi++)
                        若 (!strcmp(vars[vi].name, vname) && vars[vi].is_static && vars[vi].arr_esz > 0) {
                            esz = vars[vi].arr_esz;
                            is_row = (vars[vi].p_esz > 0 && vars[vi].arr_esz > vars[vi].p_esz); /* 2D+ array: a[i] is a ROW (array), decays to ADDRESS (fix 2026-08-16: secnames[i] 源被当 8 字节值 load → memcpy 源 0) */
                            { 整 pointee = vars[vi].p_inner ? vars[vi].p_inner : (vars[vi].is_char ? 1 : (vars[vi].is_ll ? 8 : (vars[vi].is_dbl ? 8 : 4))); cg_mem_frow = (vars[vi].arr_esz == 8 && !vars[vi].is_ll && !vars[vi].is_dbl && vars[vi].st_idx < 0) ? pointee : (vars[vi].p_esz ? vars[vi].p_esz : (vars[vi].arr_esz <= 8 ? vars[vi].arr_esz : 8)); } /* ELEMENT byte size for outer [j] scale; fix 2026-08-18: 静态指针数组 (int *nx[8]) 外维 [j] 按指向元素缩放; fix 2026-08-23 t35j: p_inner 优先 */
                            /* ADDRESS for: struct arrays, 2D rows (esz>8), and 2D rows where
                               arr_esz > element size (char buf[4][8]: esz=8, elem=1).
                               8-byte POINTER arrays (char *names[3]: esz=8, elem=8) load 64-bit. */
                            若 (esz > 4 && (vars[vi].st_idx >= 0 || esz > 8 || vars[vi].arr_esz > vars[vi].p_esz || vars[vi].p_esz == 0)) is_struct_elem = 1;
                            若 (cg_no_deref && vars[vi].arr_esz == 8 && !vars[vi].is_ll && !vars[vi].is_dbl && vars[vi].st_idx < 0 && !is_row) cg_mem_ptr = 1; /* 静态指针数组元素 (int *nx[8]): 嵌套 base 返回槽地址, 外层 [j] 先加载指针 (fix 2026-08-18: 原缺 → 第二维索引进指针数组槽本身, 自举 CG-BAD; fix step26: !is_row — int M2D[2][2] 的 arr_esz=8 是行大小非指针数组, 原误判 → 外层 mov (%rax),%rax 读行内容当指针 → 2D 数组写地址=4 崩) */
                            cg_mem_dbl = (var_is_dbl(vname) || var_pdbl(vname)) ? 1 : 0; /* static double array base → outer [i] movsd */
                            cg_fdepth = 1; 遍 (整 fk = 0; fk < 4; fk++) cg_frows[fk] = vars[vi].frows[fk]; /* per-dim rows: static arrays too (fix 2026-08-05: leftover fdepth/frows polluted nested field-array scale) */
                            cg_fdepth_max = 1; 遍 (整 fk = 0; fk < 4; fk++) 若 (vars[vi].frows[fk] > 0) cg_fdepth_max = fk + 1; /* dim count */
                            断;
                        }
                    mov_rr(11, 0); /* r11d = index */
                    若 (esz == 2) { asm_emit("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(1); }
                    否 若 (esz == 4) { asm_emit("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(2); }
                    否 若 (esz > 4) { mov_r_imm(0, esz); mov_rr(9, 0); asm_emit("    乘 r11, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 1, 0, 1); b(0x0F); b(0xAF); modrm(3, 3, 1); } /* IMUL r11d, r9d */
                    lea_rax_rip(coff_static_disp(off, 1) - 1); /* rax = &static[0] (lea is 7 bytes: stc_disp assumes 6) */
                    movsxd_r11(); /* 32 位索引符号扩展 (fix 2026-08-19: 负索引零扩展 → ptr+4GB → SEGV) */
                asm_emit("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 1, 0, 0); b(0x01); modrm(3, 3, 0); /* ADD rax, r11 */
                    若 (!cg_no_deref) {
                        若 (var_is_dbl(vname)) { asm_emit("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); modrm(0,0,0); } /* double array elem → xmm0 (NOT fnptr arrays) */
                        否 若 (is_row) { /* 2D+ row: leave ADDRESS (C decay) — don't deref the row bytes (fix 2026-08-16) */ }
                        否 若 (is_struct_elem) { /* address mode for member access */
                            若 (esz <= 8) { 若 (esz == 8) { mov_reg_mreg64(0, 0); } 否 { mov_reg_mreg(0, 0); } } /* fix 2026-08-06: ≤8 字节 struct 元素作值 → 解引用 (原留地址 → x = arr[1] 存地址 4207368) */
                        } 否 若 (esz == 1) { asm_emit("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB6); modrm(0, 0, 0); }
                        否 若 (esz == 8) { mov_reg_mreg64(0, 0); } /* char* / pointer element: 64-bit */
                        否 若 (esz == 2) { asm_emit("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB7); modrm(0, 0, 0); } /* movzx eax, word [rax] fix 2026-08-08 */
                        否 { mov_reg_mreg(0, 0); }
                    }
                    did = 1;
                }
            } 否 {
                /* pointer param arr[i] OR generic base (address-of / cast expr):
                   index in r11 (r9 may be the param reg).
                   fix 2026-08-09: (&buf[0])[2] crashed — a node-11 base fell into
                   load_param_val("") → garbage ptr. Generic base: cg the base to get
                   its address, element size from pesz (cast) or cg_mem_frow (set by
                   the address-of child's case-14 cg). */
                整 is_gen = (nt[n0[n]] == 11 || vname[0] == 0);
                整 peszp = 4;
                若 (is_gen) {
                    /* element size from the address-of child (fix 2026-08-09:
                       cg_mem_frow is p_esz-based → 4 for char arrays; var_esz is right) */
                    若 (nt[n0[n]] == 11) {
                        整 kid = n0[n0[n]];
                        若 (nt[kid] == 14) peszp = var_esz((字*)(nn + n0[kid])); /* &arr[i]: element = array's arr_esz */
                        否 若 (nt[kid] == 1) peszp = var_esz((字*)(nn + kid)); /* &var */
                        否 peszp = cg_mem_frow ? cg_mem_frow : 4;
                        整 save_nd = cg_no_deref; cg(n0[n]); cg_no_deref = save_nd; /* case 11 clobbers the flag; restore (fix 2026-08-09: store path wrote to the VALUE not the address) */
                        push_r(0);
                    } 否 {
                        /* 先 cg 基址 (case-12 解引用设 cg_mem_frow=元素宽度), 再取 peszp (fix 2026-08-20:
                           原先读陈旧 cg_mem_frow → (*argv)[1] 缩放 4 + 4字节加载 → 取到 0 → strchr(NULL) git -c 崩) */
                        整 save_nd = cg_no_deref; cg(n0[n]); cg_no_deref = save_nd;
                        peszp = cg_mem_frow ? cg_mem_frow : 4;
                        push_r(0);
                    }
                }
                否 peszp = var_esz(vname);
                { 整 save_idx_noderef = cg_no_deref; cg_no_deref = 0; cg(n1[n]); cg_no_deref = save_idx_noderef; } /* index → eax */
                mov_rr(11, 0); /* r11d = index */
                若 (peszp == 4) { asm_emit("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(2); }
                否 若 (peszp == 2) { asm_emit("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(1); }
                否 若 (peszp > 4) { mov_r_imm(0, peszp); mov_rr(9, 0); asm_emit("    乘 r11, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 1, 0, 1); b(0x0F); b(0xAF); modrm(3, 3, 1); } /* IMUL r11d, r9d */
                若 (is_gen) { pop_r(0); } /* rax = base address (saved) */
                否 load_param_val(vname); /* eax = ptr (reg or [rbp+disp]) */
                movsxd_r11(); /* 32 位索引符号扩展 (fix 2026-08-19: 负索引零扩展 → ptr+4GB → SEGV) */
                asm_emit("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 1, 0, 0); b(0x01); modrm(3, 3, 0); /* ADD rax, r11 */
                若 (!cg_no_deref) {
                    若 (var_pdbl(vname)) { asm_emit("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); modrm(0,0,0); } /* double* param elem → xmm0 */
                    否 若 (peszp == 1) { asm_emit("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB6); modrm(0, 0, 0); } /* movzx eax,byte[rax] */
                    否 若 (peszp > 4) { mov_reg_mreg64(0, 0); }         /* mov rax,[rax] (char** ?ptr / struct*) */
                    否 若 (peszp == 2) { asm_emit("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB7); modrm(0, 0, 0); } /* movzx eax, word [rax] fix 2026-08-08 */
                    否 { mov_reg_mreg(0, 0); } /* mov eax, [rax] */
                }
            }
        } 断;
    }
}
/* str */
/* string data */
静 无 字 *sdat; 静 整 sdp, sdc;

静 整 dbl_offs[1024]; /* byte offset of each double literal in sdat; -1 = not placed */
静 整 dbl_place(整 idx) {
    若 (dbl_offs[idx] >= 0) 返 dbl_offs[idx];
    循环 (sdp % 8 != 0) { 若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); } sdat[sdp++] = 0; }
    dbl_offs[idx] = sdp;
    整 lo = dbl_lo[idx], hi = dbl_hi[idx];
    遍 (整 k = 0; k < 4; k++) { 若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); } sdat[sdp++] = (无 字)((lo >> (8 * k)) & 0xff); }
    遍 (整 k = 0; k < 4; k++) { 若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); } sdat[sdp++] = (无 字)((hi >> (8 * k)) & 0xff); }
    返 dbl_offs[idx];
}

静 整 str_place(整 idx) {
    若 (str_offs[idx] >= 0) 返 str_offs[idx];
    str_offs[idx] = sdp;
    常 字 *s = str_tbl[idx];
    循环 (*s) { 若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); } sdat[sdp++] = (无 字)*s++; }
    若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); }
    sdat[sdp++] = 0; /* NUL terminator */
    返 str_offs[idx];
}
静 空 w4(FILE *f, 整 v) { fputc(v & 0xff, f); fputc((v >> 8) & 0xff, f); fputc((v >> 16) & 0xff, f); fputc((v >> 24) & 0xff, f); }
静 空 w8(FILE *f, 整 v) { w4(f, v); w4(f, 0); } /* 64-bit write: high word ALWAYS 0. The self-host has no real long long; `v >> 32` on a 32-bit value masks the shift count to 0 and re-writes v, so all w8 callers pass <4GB values. */
静 空 w2(FILE *f, 整 v) { fputc(v & 0xff, f); fputc((v >> 8) & 0xff, f); }
静 空 pad(FILE *f, 整 n) { 循环 (n-- > 0) fputc(0, f); }

/* fix 2026-08-12: 分块写零替代逐字节 fputc — 自宿主的 fputc builtin 每字节一次 WriteFile
   syscall, 52MB .data 填充 85s; fwrite 整块写 → 4KB 块 ≈ 20ms (快 ~4000 倍). */
静 空 pad_zero(FILE *f, 整 n) {
    字 zb[4096]; memset(zb, 0, 大小(zb));
    循环 (n > 0) { 整 c = n > 4096 ? 4096 : n; fwrite(zb, 1, c, f); n -= c; }
}

/* fix 2026-08-12 自举收敛 (根因): .data 覆盖范围必须 ≥ statics + bump 堆 + 自切栈.
   旧公式 max(cp*84, 0x800000) 只按输出代码量估算 — 自举时 cp*84≈83.7MB,
   但 statics ≈46MB + bump 堆 ≈42MB (tt/tv/tn/nn/tuns/tll/tll_hi 34MB + code 4MB + 源缓冲 ~1.5MB + sdat/misc ~3MB)
   ≈ 88MB > 83.7MB → stk_top 落进 tll_hi (v1: 0x52B15D8 = heap_start+33.6MB, tll_hi 在 +33.2..+35.2MB)
   → 栈帧向下写穿 token 数组 → 运行时 tll 垃圾 → 伪 nll=1 → 628 movabs → v1≠v2 2-cycle.
   新公式: statics 终点 (DATA_RVA_OFF + 4*stc_n + 2560) 之上加 0x4800000
   (堆上限 0x4000000=64MB + 栈余量 0x800000=8MB; 实测栈深 ≥2MB, 递归 parse/codegen 取 8MB),
   fix 2026-08-13: 44MB 不够 — 编译 revision.c (Git) 时 bump 堆实测 55.2MB (token 35MB
   + 源/宏展开缓冲 ~15MB + obj out 1.5MB), 越界 ~2MB 写穿栈帧 → obj_macro_expand 局部 s
   被覆盖 → 0xC0000005. 提到 64MB 留 ~9MB 余量,
   与 cp*84 取大者 — 小程序的 8MB 地板不变. */
静 整 data_extent(空) {
    整 e = cp * 84 > 0x800000 ? cp * 84 : 0x800000;
    /* fix 2026-08-16 alias.c: bump heap needed 0x490626D (> 0x4800000) while
       expanding fn-macro args, so the counter walked past the image end and the
       very next byte store faulted (0xC0000005). Give the shared heap+stack
       region 128MiB instead of 72MiB. */
    /* fix 2026-08-16 根因E attr.c: fn-macro 展开实测把 bump 堆推到 165MiB+136MiB≈300MiB,
       超 128MiB 预算 → counter 越过 heap 终点+image 末尾 (0x11E98000) → malloc 指针越界写崩。
       预算 128→192MiB 留余量 (attr.c 需 ~136MiB)。image 相应增大 (v1 ~+64MB)。 */
    /* fix 2026-08-16 根因E attr.c: fn-macro 展开实测把 bump 堆推到 165MiB+136MiB≈300MiB,
       超 128MiB 预算 → counter 越过 heap 终点+image 末尾 (0x11E98000) → malloc 指针越界写崩。
       预算 128→192MiB 留余量 (attr.c 需 ~136MiB)。image 相应增大 (v1 ~+64MB)。 */
    /* fix 2026-08-17 block-sha1/sha1.c: 80 轮宏展开 (SHA_ROUND×80) 全量展开需 >192MiB
       (踩坑库: sha1.c 编译需 214MB 堆) → counter 走穿镜像尾 → out 指针越界写崩。
       预算 192→256MiB (0xC000000→0x10000000)。 */
    /* fix 2026-08-27 step7 (v1.2 §二B): str_tbl 分块动态化后 stc_n 不再含 384MB 静态
       str_tbl (4 亿槽), heap_top 从 ~658MB 跌到 ~257MB → 自举新编译器运行时 stk_top
       过低, 自切栈区与 bump 堆/code buffer 重叠 → 编 qcc 自身 SEGV (0x5f1937 跳栈区).
       预算 256→512MiB (0x10000000→0x20000000) 恢复 stk_top 高位, 与布局解耦. */
    整 heap_top = DATA_RVA_OFF + 4 * stc_n + 2560 + 0x20000000;
    返 e > heap_top ? e : heap_top;
}

静 空 write_pe(FILE *f, 整 entry_rva) {
    整 text_rva = 0x1000, text_size = ((cp + 4095) & ~4095);
    若 (text_size < 512) text_size = 512;
    /* Fix 2026-08-03: the Windows loader rejects a PE whose .text end does not
       abut .data (ERROR_BAD_EXE_FORMAT 193). data_rva_base is sized from pass-1
       cp, which can round one page past the pass-2 final cp -> a 0x1000 hole.
       Make .text always end exactly where .data begins. */
    整 need = data_rva_base - text_rva;
    若 (text_size < need) text_size = need;
    整 text_foff = FILE_ALIGNMENT;
    整 data_rva = data_rva_base; /* dynamic .data base (text may exceed 4KB) */
    整 data_vsize = (data_extent() + 0x100000 + 4095) & ~4095; /* fix 2026-08-12: 随 extent 动态 — 自举 stk_top≈97MB 超旧固定 96MB; +1MB 余量, 覆盖栈底之下 */
    若 (data_vsize < 0x6000000) data_vsize = 0x6000000; /* 保持旧 96MB 地板 (fix 2026-08-11: str_tbl 2048 后 statics 46MB + bump 43MB ≈ 89MB > 80MB → 扩容到 96MB) */
    整 image_size = data_rva + data_vsize + 0x1000; /* SizeOfImage */

    /* DOS Header (64 bytes) */
    fputc('M', f); fputc('Z', f); pad(f, 58);
    w4(f, 64); /* e_lfanew = 64 */

    /* PE Signature */
    fputc('P', f); fputc('E', f); fputc(0, f); fputc(0, f);

    /* COFF Header (20 bytes) */
    w2(f, 0x8664);  /* Machine: x86-64 */
    w2(f, 2);       /* NumberOfSections �?.text + .data */
    w4(f, 0);       /* TimeDateStamp */
    w4(f, 0);       /* PointerToSymbolTable */
    w4(f, 0);       /* NumberOfSymbols */
    w2(f, 0xF0);    /* SizeOfOptionalHeader = 240 (PE32+ with 16 data dirs) */
    w2(f, 0x22E);   /* Characteristics: EXE + large address aware */

    /* Optional Header PE32+ (112 bytes + 16*8 data dirs = 240) */
    w2(f, 0x020B);  /* Magic: PE32+ */
    fputc(0, f); fputc(0, f); /* LinkerVersion */
    w4(f, text_size); /* SizeOfCode */
    w4(f, 8);       /* SizeOfInitializedData �?heap counter */
    w4(f, 0);       /* SizeOfUninitializedData */
    w4(f, entry_rva); /* AddressOfEntryPoint */
    w4(f, text_rva);  /* BaseOfCode */
    w8(f, IMAGE_BASE); /* ImageBase �?low address for 32-bit pointers */
    w4(f, 0x1000);  /* SectionAlignment */
    w4(f, FILE_ALIGNMENT);   /* FileAlignment */
    w2(f, 6); w2(f, 0); /* OSVersion */
    w2(f, 0); w2(f, 0); /* ImageVersion */
    w2(f, 6); w2(f, 0); /* SubsystemVersion */
    w4(f, 0);       /* Win32VersionValue */
    w4(f, image_size); /* SizeOfImage */
    w4(f, FILE_ALIGNMENT);   /* SizeOfHeaders */
    w4(f, 0);       /* CheckSum */
    w2(f, 3);       /* Subsystem: CONSOLE */
    w2(f, 0x8100);  /* DllCharacteristics: NX + TERMINAL_SERVER_AWARE (no DYNAMIC_BASE) */
    w8(f, 0x400000); /* SizeOfStackReserve — 自举递归需>64KB; 必须>=StackCommit (CI windows-latest 严格校验) */
    w8(f, 0x400000); /* SizeOfStackCommit */
    w8(f, 0x100000); /* SizeOfHeapReserve */
    w8(f, 0x1000);   /* SizeOfHeapCommit */
    w4(f, 0);       /* LoaderFlags */
    w4(f, 16);      /* NumberOfRvaAndSizes */
    /* data directory 0: exports (none) */
    w4(f, 0); w4(f, 0);
    /* data directory 1: import table (kernel32) */
    w4(f, data_rva_base + 0x458); w4(f, 60); /* RVA of import descriptors + size (fix 2026-08-06 BUG-1; step9: 0x428; step10: 0x458) */ /* RVA of import descriptors + size (fix 2026-08-06 BUG-1: 新布局 desc@+0x1A8, 2 dll) */
    /* data directories 2-15: none */
    遍 (整 di = 2; di < 16; di++) { w4(f, 0); w4(f, 0); }

    /* Section Header (40 bytes) */
    fwrite(".text", 1, 5, f); pad(f, 3); /* 8-byte section name ".text\0\0\0" — split write: the \0 escape is dropped by str_place (while(*s) stops at the embedded null), so a single 8-byte literal would be truncated (fix 2026-08-03) */
    w4(f, text_size);  /* VirtualSize */
    w4(f, text_rva);   /* VirtualAddress */
    w4(f, text_size);  /* SizeOfRawData */
    w4(f, text_foff);  /* PointerToRawData */
    w4(f, 0);          /* PointerToRelocations */
    w4(f, 0);          /* PointerToLinenumbers */
    w2(f, 0);          /* NumberOfRelocations */
    w2(f, 0);          /* NumberOfLinenumbers */
    w4(f, 0x60000020); /* .text: code + execute + read */

    /* .data section header */
    整 data_foff = text_foff + text_size; /* MUST follow .text �?was 0x400, which overlapped code �?12B */
    fwrite(".data", 1, 5, f); pad(f, 3); /* ".data\0\0\0" — split write (see .text note) */
    w4(f, data_vsize);  /* VirtualSize �?80MB: statics + bump heap */
    w4(f, data_rva);    /* VirtualAddress */
    w4(f, DATA_RAW_SZ);  /* SizeOfRawData — BSS分离: 只写导入表+heap counter, 堆/栈由 loader 清零 (fix 2026-08-25) */
    w4(f, data_foff);   /* PointerToRawData */
    w4(f, 0); w4(f, 0); w2(f, 0); w2(f, 0);
    w4(f, 0xC0000040);  /* initialized data + read + write */

    /* Pad to text file offset */
    整 pos = (整)ftell(f);
    循环 (pos < text_foff) { fputc(0, f); pos++; }

    /* Write .text */
    fwrite(code, 1, cp, f);

    /* Pad section to raw size */
    整 end = text_foff + text_size;
    pos = (整)ftell(f);
    循环 (pos < end) { fputc(0, f); pos++; }

    /* .data section: write heap counter, then import table
       布局（fix 2026-08-06 BUG-1）：每个 DLL 的 IAT/ILT 独立且以 0 终止
       IAT1@+0x08 (8 kernel32 + term=72B) IAT2@+0x50 (59 msvcrt + term=480B)
       ILT1@+0x230 (9*8B=72B) ILT2@+0x278 (60*8B=480B) desc@+0x458 (3*20=60B) names@+0x4B0
       (fix 2026-08-19: IAT2 16→17; math21: 17→22; math24: 22→25; step5: 25→34; step8: 34→46; step9: 46→54; step10: 54→59 加 strcoll/strxfrm/strncat/strncpy/strtod; ILT thunk 8B 按 PE64 计) */
    fseek(f, data_foff, SEEK_SET);
    整 heap_start = IMAGE_BASE + data_rva + DATA_RVA_OFF + 4 * stc_n + 2560; /* argv[64]+tokens then heap */
    heap_start = (heap_start + 7) & ~7; /* fix 2026-08-12 BLOCKER-3: bump heap BASE 8-byte aligned — 布局变化 (data_rva_base/__pad0 尺寸) 不得影响堆对齐 (tll[tk] 错位读 → 伪 nll=1 → 2-cycle) */
    w4(f, heap_start); /* heap counter initialized */
    w4(f, 0);          /* padding */
    静 常 字 *knames[8] = { "GetStdHandle", "WriteFile", "CreateFileA", "ReadFile", "VirtualAlloc", "SetFilePointer", "ExitProcess", "GetCommandLineA" };
    静 常 字 *mnames[59] = { "pow", "atan2", "fmod", "sqrt", "cos", "sin", "tan", "acos", "asin", "atan", "log", "log10", "exp", "floor", "ceil", "fabs", "cosh", "sinh", "tanh", "_copysign", "_hypot", "frexp", "ldexp", "modf", "_write", "_time64", "difftime", "_localtime64", "_gmtime64", "_mktime64", "strftime", "clock", "asctime", "ctime", "strtok", "strrchr", "strnlen", "strpbrk", "memcmp", "toupper", "isalnum", "isxdigit", "isspace", "rand", "srand", "abs", "islower", "isupper", "iscntrl", "isgraph", "isprint", "ispunct", "labs", "atof", "strcoll", "strxfrm", "strncat", "strncpy", "strtod" };
    整 iat1 = 0x08, iat2 = 0x50, ilt1 = 0x230, ilt2 = 0x278, desc_off = 0x458, name_off = 0x4B0; /* step10: IAT2 54→59 槽 (60*8=480B→0x230); ILT1@0x230 (72B→0x278), ILT2@0x278 (480B→0x458), desc@0x458 (60B→0x494), names@0x4B0 (至 ~0x750 < DATA_RVA_OFF 0x800) */
    整 n_off[67];
    /* IAT/ILT 占位 */
    fseek(f, data_foff + iat1, SEEK_SET); 遍 (整 i = 0; i < 9; i++) w8(f, 0);
    fseek(f, data_foff + iat2, SEEK_SET); 遍 (整 i = 0; i < 60; i++) w8(f, 0);
    fseek(f, data_foff + ilt1, SEEK_SET); 遍 (整 i = 0; i < 9; i++) w8(f, 0);
    fseek(f, data_foff + ilt2, SEEK_SET); 遍 (整 i = 0; i < 60; i++) w8(f, 0);
    /* names（hint 2B + name + \0） */
    fseek(f, data_foff + name_off, SEEK_SET);
    遍 (整 i = 0; i < 8; i++) { n_off[i] = (整)ftell(f) - data_foff; w2(f, 0); fputs(knames[i], f); fputc(0, f); }
    遍 (整 i = 0; i < 59; i++) { n_off[8 + i] = (整)ftell(f) - data_foff; w2(f, 0); fputs(mnames[i], f); fputc(0, f); }
    整 kdll = (整)ftell(f) - data_foff; fputs("kernel32.dll", f); fputc(0, f);
    整 mdll = (整)ftell(f) - data_foff; fputs("msvcrt.dll", f); fputc(0, f);
    /* 回填 IAT1（8 + term） */
    fseek(f, data_foff + iat1, SEEK_SET);
    遍 (整 i = 0; i < 8; i++) w8(f, data_rva_base + n_off[i]);
    w8(f, 0);
    /* 回填 IAT2（59 + term） */
    fseek(f, data_foff + iat2, SEEK_SET);
    遍 (整 i = 0; i < 59; i++) w8(f, data_rva_base + n_off[8 + i]);
    w8(f, 0);
    /* 回填 ILT1/ILT2 */
    fseek(f, data_foff + ilt1, SEEK_SET);
    遍 (整 i = 0; i < 8; i++) w8(f, data_rva_base + n_off[i]);
    w8(f, 0);
    fseek(f, data_foff + ilt2, SEEK_SET);
    遍 (整 i = 0; i < 59; i++) w8(f, data_rva_base + n_off[8 + i]);
    w8(f, 0);
    /* import descriptors: kernel32 (IAT1/ILT1), msvcrt (IAT2/ILT2) */
    fseek(f, data_foff + desc_off, SEEK_SET);
    w4(f, data_rva_base + ilt1);  /* kernel32 OriginalFirstThunk */
    w4(f, 0); w4(f, 0);
    w4(f, data_rva_base + kdll);  /* Name */
    w4(f, data_rva_base + iat1);  /* FirstThunk */
    w4(f, data_rva_base + ilt2);  /* msvcrt OriginalFirstThunk */
    w4(f, 0); w4(f, 0);
    w4(f, data_rva_base + mdll);  /* Name */
    w4(f, data_rva_base + iat2);  /* FirstThunk */
    遍 (整 di = 0; di < 5; di++) w4(f, 0); /* terminator descriptor */
    /* pad .data to raw size */
    fseek(f, data_foff + DATA_RVA_OFF, SEEK_SET);
    pos = (整)ftell(f);
    整 data_end = data_foff + DATA_RAW_SZ; /* BSS分离: 只写导入表+heap counter (fix 2026-08-25) */
    pad_zero(f, data_end - pos); /* fix 2026-08-12: 原逐字节 fputc, 自宿主 52MB 填充 85s → 分块 fwrite */
}

/* ?????? ??????????? */
/* MOV r32, imm32 for high registers (r8-r15): B8+reg only encodes 0-7, so prefix REX.B. */
静 空 mov_ri_ext(整 reg, 整 imm) { asm_emit("    移动 r%d, %d\n", (字*)(长 长)(reg), (字*)(长 长)(imm), (字*)(长 长)0); 若 (reg & 8) b(0x41); b(0xB8 | (reg & 7)); b4(imm); }

/* Mini-CRT entry stub (hand-emitted): GetCommandLineA �?copy-tokenize argv into a
   static .data area (argv[64] at statics, token strings right after) �?call
   main(argc, argv) �?ExitProcess.
   Registers: r10=cmdline r11=scan idx r12=&argv[0] r13=&token_area(advancing)
   r14=argc r8=token_start r15=saved rsp. Each token is NUL-terminated in the copy. */
静 空 emit_crt_stub(空) {
    整 argv_va = IMAGE_BASE + data_rva_base + DATA_RVA_OFF + 4 * stc_n; /* .data static area for argv[64] */
    crt_entry_off = cp; /* entry point = start of this stub */
    /* 自切栈：立即�?rsp 切到 .data 内的高地址区（62MB 偏移处），完全脱�?loader �?
       （loader 把主线程栈放在镜�?SizeOfImage 内部 ~91.6-92.6MB，页面不可靠 �?
       deep parse 帧读 SIGSEGV）。固�?62MB 偏移：栈向下 1MB 仍在 .data 段内�?
       且高�?heap 终点（~48MB）；被编译程序没�?__stack 静态，不能用静态末尾�?*/
    整 stk_top = IMAGE_BASE + data_rva_base + data_extent(); /* fix 2026-08-12 自举收敛根因: 栈顶必须在 bump 堆终点之上 — 旧 max(cp*84,8MB) 自举时落进 tll_hi → 栈帧写穿 token 数组 → 2-cycle. 实测 v1g: stk_top=0x52B15D8=heap_start+33.6MB, tll_hi 在 +33.2..+35.2MB. data_extent = statics_end + 堆44MB + 栈8MB */
    mov_rr64(3, 4);         /* rbx = rsp (保存 loader 栈 — fix 2026-08-17 CI 根因: Server 2025 ntdll LdrShutdownProcess 清理路径 _chkstk 按 TEB 栈探测, 自切栈 rsp 脱离 TEB → SIGSEGV; 退出前切回 loader 栈) */
    mov_ri_ext(4, stk_top);     /* mov rsp, stk_top (32位 imm，零扩展) */
    /* fix 2026-08-25 step5: TEB 栈边界改为自切栈 — msvcrt _tzset/_setjmpex/_chkstk 按 TEB 栈探测,
       自切栈 rsp 脱离 loader 栈 → localtime/gmtime SEGV (_setjmpex: test %r11b,(%r11)).
       x64 TEB 基址=gs:0, StackBase=TEB+0x08 (高地址), StackLimit=TEB+0x10 (低地址) */
    mov_ri_ext(0, stk_top);     /* rax = stk_top */
    asm_emit("    改 TEB 栈基\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x65); b(0x48); b(0x89); b(0x04); b(0x25); b4(0x08); /* mov gs:[0x08], rax */
    mov_ri_ext(0, stk_top - 0x1000000); /* rax = stk_top - 16MB (栈向下预算) */
    asm_emit("    改 TEB 栈限\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x65); b(0x48); b(0x89); b(0x04); b(0x25); b4(0x10); /* mov gs:[0x10], rax */
    mov_ri_ext(12, argv_va);          /* r12 = &argv[0] */
    mov_ri_ext(13, argv_va + 512);    /* r13 = token area start */
    /* GetCommandLineA() */
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
    sub_rsp_imm(32);
    call_iat(7);            /* GetCommandLineA �?rax */
    add_rsp_imm(32);
    mov_rr64(10, 0);        /* r10 = cmdline */
    mov_ri_ext(4, stk_top); /* rsp = stk_top (自切栈顶 — 不用 r15, r15 已让位) */
    mov_ri_ext(11, 0);      /* r11 = i (scan idx) */
    mov_ri_ext(14, 0);      /* r14 = argc */
    mov_ri_ext(15, 0);      /* r15 = in-quote flag (fix 2026-08-19: argv tokenizer 引号支持 — 原只按空格分割, git commit -m "first commit" 被拆成 "first + commit" → pathspec 'commit"' 错) */
    整 louter = new_label(), lcopy = new_label(), lend_s = new_label(), lend_n = new_label(), lrec = new_label(), lskip = new_label(), ldone = new_label(), lqstart = new_label(), lquote = new_label(), lspc = new_label();
    set_label(louter);
    asm_emit("    零扩展 SIB\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x43); b(0x0F); b(0xB6); b(0x04); b(0x1A);
    mov_rr(1, 0);           /* ecx = c */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ldone, 1);
    mov_r_imm(0, 0x20); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lskip, 1); /* cmp ecx,' ' */
    mov_r_imm(0, 0x22); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lqstart, 1); /* cmp ecx,'"' → 引号 token 起点 */
    mov_rr64(8, 13);        /* r8 = token_start (r13) */
    set_label(lcopy);
    asm_emit("    零扩展 SIB\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x43); b(0x0F); b(0xB6); b(0x04); b(0x1A); /* movzx eax, byte [r10+r11] */
    mov_rr(1, 0);           /* ecx = c */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lend_n, 1);
    mov_r_imm(0, 0x22); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lquote, 1); /* cmp ecx,'"' → 翻转引号状态 */
    mov_r_imm(0, 0x20); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lspc, 1); /* cmp ecx,' ' */
    asm_emit("    存字节帧 [r13+0], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0x88); modrm(1, 1, 5); b(0);
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 3);
    asm_emit("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 5);
    jmp_rel(-1); patch_label(cp-4, lcopy, 2);
    set_label(lqstart); /* 引号 token 起点: 跳过 "，置 in-quote=1，token 从当前位置开始 */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 3); /* inc r11 (skip ") */
    mov_ri_ext(15, 1); /* in-quote = 1 */
    mov_rr64(8, 13);    /* r8 = token_start */
    jmp_rel(-1); patch_label(cp-4, lcopy, 2);
    set_label(lspc); /* 空格: 引号内复制, 引号外结束 token */
    test_rr(15, 15); jz_rel(-1); patch_label(cp-4, lend_s, 1); /* in-quote==0 → 结束 */
    asm_emit("    存字节帧 [r13+0], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0x88); modrm(1, 1, 5); b(0); /* 引号内空格: 复制 */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 3);
    asm_emit("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 5);
    jmp_rel(-1); patch_label(cp-4, lcopy, 2);
    set_label(lquote); /* 翻转引号状态: 跳过 "，不写入 token */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 3); /* inc r11 (skip ") */
    asm_emit("    异或 r15, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0x83); b(0xF7); b(0x01); /* xor r15d, 1 */
    jmp_rel(-1); patch_label(cp-4, lcopy, 2);
    set_label(lend_s); /* token ended at a space: NUL-terminate, skip the space */
    asm_emit("    存字节0 [r13+0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xC6); modrm(1, 0, 5); b(0); b(0);
    asm_emit("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 5);
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 3);
    jmp_rel(-1); patch_label(cp-4, lrec, 2);
    set_label(lend_n); /* token ended at NUL: terminate; outer loop will finish */
    asm_emit("    存字节0 [r13+0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xC6); modrm(1, 0, 5); b(0); b(0);
    set_label(lrec);
    asm_emit("    存栈索引 [r12+r14*8], r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x4F); b(0x89); b(0x04); b(0xF4);
    asm_emit("    自增 r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 6);
    jmp_rel(-1); patch_label(cp-4, louter, 2);
    set_label(lskip); /* space between tokens */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x41); b(0xFF); modrm(3, 0, 3);
    jmp_rel(-1); patch_label(cp-4, louter, 2);
    set_label(ldone);
    mov_rr64(1, 14);        /* rcx = argc */
    mov_rr64(2, 12);        /* rdx = &argv[0] */
    mov_ri_ext(4, stk_top); /* rsp = stk_top (自切栈顶; argv lives in .data; frame may grow over old stack) */
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
    sub_rsp_imm(32);        /* shadow space */
    {
        整 mi = func_find("main");
        若 (mi < 0 || !func_tbl[mi].defined) mi = func_find("主"); /* 甲言: 主() = main() */
        call_rel(0);
        patch_label(cp - 4, func_tbl[mi].label, 0); /* call main */
    }
    add_rsp_imm(32);
    mov_rr(1, 0);           /* ecx = main's return code */
    mov_rr64(4, 3);         /* rsp = rbx (loader 栈 — Server 2025 ntdll LdrShutdownProcess _chkstk 需 TEB 栈区) */
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
    sub_rsp_imm(32);
    call_iat(6);            /* ExitProcess �?never returns */
}

/* two-pass generation support: root_global/g_lc_save/g_rsp_save/entry_rva_global at file scope */
空 gen_code(空) {
    /* reset codegen state for two-pass (pass 1 estimates .data base, pass 2 real) */
    cp = 0; patch_n = 0; strpn = 0; fnpn = 0; dbl_patch_n = 0; sdp = 0; gfn = 0;
    coff_ginit_done = 0;
    func_n = 0; /* MUST re-register all functions in pass 2 with FRESH labels �?
                   otherwise pass-2 new_label() numbers overlap the pass-1 function
                   labels and epilogue/return jumps resolve to the wrong functions. */
    lc = g_lc_save; rsp_used = g_rsp_save;
    遍 (整 i = 0; i < str_cnt; i++) { str_offs[i] = -1; } /* fix 2026-08-11: 镜像 1090 字符串 > 1024, str_offs 扩容 2048; fix 2026-08-27 step7: 清 str_cnt 全量 (原 2048 残留 — str_offs 扩 65536 后 str_cnt>2048 时旧值残留 → 字符串地址错) */
    遍 (整 i = 0; i < 1024; i++) { dbl_offs[i] = -1; } /* fix 2026-08-03: was 512 — strings with ID>=512 kept pass-1 offsets, so pass-2 pool missed them and string refs pointed past the pool */
    遍 (整 i = 0; i < MAX_LABELS; i++) { label_pos[i] = 0; label_set[i] = 0; }
    /* Pre-place ALL strings and doubles in ID order (fix 2026-08-03): str_place/
       dbl_place are normally lazy (first-reference order), which can deviate from
       lex order (a "" literal lexed early but referenced late, static-init
       strings, etc.) → H1's sdat layout ≠ the .字串/.浮点 ID-order emission →
       route_learn's string/double pool drifted and H1≠H2. Pre-placing in ID order
       makes the sdat layout deterministic and ID-ordered, matching asm_zh. */
    遍 (整 i = 0; i < str_cnt; i++) str_place(i);
    遍 (整 i = 0; i < dbl_n; i++) dbl_place(i);

    /* generate code */
    /* pre-mark all function labels as defined so calls before the definition
       (forward declaration) resolve as user calls, not builtins */
    遍 (整 i = 0; i < fdef_n; i++) {
        整 c = fdef_list[i];
        若 (c <= 0) 续;
        { 静 整 pcnt2 = 0; pcnt2++; (空)pcnt2; }
        整 fi = func_find((字*)(nn + c));
        func_tbl[fi].defined = 1;
    }
    fnpn = 0;
    parse_base = 0; /* codegen lookups use vs_end (=fve[gfn]), not the parse-time floor */
    /* per-function LOCAL frames (root-cause 2026-08-03): recomputed in the loop below */

    遍 (整 i = 0; i < fdef_n; i++) {
        整 c = fdef_list[i];
        若 (c <= 0) 续;

        /* function definition */
        字 *fname = (字*)(nn + c);
        整 fi = func_find(fname);
        strcpy(cur_fn_name, fname); /* for case-6 double-return routing */
        set_label(func_tbl[fi].label);
        asm_emit("\n; === %s ===\n%s:\n", fname, fname, (字*)(长 长)0);
        func_tbl[fi].defined = 1;
        cur_ret_si = fn_ret_name_get(fname);
        若 (cur_ret_si < 0 && !fn_ret_name_has(fname) && fi >= 0 && fi < 8192) cur_ret_si = fn_ret_si_map[fi]; /* fix 2026-08-18: 名表优先 (同上 — int 返回函数名表有记录, 不得回退错位索引表) */
        { 整 cur_ret_ptr = fn_ret_name_get_ptr(fname);
          cur_fn_sret = (cur_ret_si >= 0 && stypes[cur_ret_si].sz > 8 && !cur_ret_ptr); } /* sret fn: params shift (rcx = hidden ptr); struct pointer return is NOT sret */
        cur_va_home = fn_va_get(fname);

        /* local frame — single source of truth: `off` is the GLOBAL parse-time rsp_off,
           fr_start[gfn] this function's baseline. disp = off - cur_frame_sz
           = (off - fr_start) - fn_frame, so each var lands at [rsp + (off - fr_start)]
           right after `sub rsp, fn_frame`. fr_end-fr_start is always 16-aligned and
           272 = 17*16, so fn_frame keeps ABI alignment at OS-call sites. */
        整 fn_frame = (fr_end[gfn] - fr_start[gfn]) + 4368 + 8; /* fix 2026-08-07 Gate-1: +8 → fn_frame≡8(mod16)。入口 rsp≡8(标准) → 2 push(rbp,rbx) 仍 ≡8 → 帧后 rsp≡0 → 调用点 Win64 ABI 16 对齐（gcc sqlite3 混链 movaps 崩溃根因）。fr_end-fr_start 恒 16 对齐 */
        cur_frame_sz = fr_start[gfn] + fn_frame; /* 51 sites `off - cur_frame_sz` untouched */
        scratch_base = cur_frame_sz - 272; /* 状态区 [rbp-272..]，printf 缓冲在其下 [rbp-4368..rbp-273]（emit_print 里 lea -4096） */
        sret_ptr_off = cur_frame_sz - 4376; /* sret slot at [rbp-4376] — 内联 printf 格式解释器把 [rbp-8] 当 '#' 标志/清零 scratch (emit_print 状态位), 与 sret 槽冲突 → sret 函数内调 printf 后返回指针被毁 → rcx 垃圾写崩 (fix 2026-08-27 第三批#2: feat_sret10 makeA 崩 0xC0000005). 移入局部区与 printf 缓冲间的恒空闲 +8 填充 (fn_frame 必含 +8), 局部区顶 [rbp-4376) 永不被占用 */

        /* fix 2026-08-08 -bin: _start 设裸机栈 + 正常序言 (完整帧, 函数体帧访问有效) */
        整 no_frame = (bin_mode && i == 0 && !strcmp(fname, "_start"));
        整 is_isr = (bin_mode && !strncmp(fname, "__isr_", 6)); /* __isr_xxx: 裸中断函数 — 无帧、iretq */
        若 (no_frame) {
            mov_ri_ext(4, 0x200000); /* mov rsp, 0x200000 — 内核栈 (裸机无栈) */
            mov_rr64(15, 4);         /* r15 = rsp */
            push_r(5);  /* push rbp */
            push_r(3);  /* push rbx */
            mov_rr64(5, 4); /* mov rbp, rsp */
            sub_rsp_imm(fn_frame); /* 完整帧 */
        } 否 若 (is_isr) {
            /* 裸中断函数: 无栈帧, iretq 退出 (CPU 已压入 SS:RSP:RFLAGS:CS:RIP) */
            (空)0; /* no prologue */
        } 否 {
            push_r(5);  /* push rbp */
            push_r(3);  /* push rbx */
            mov_rr64(5, 4); /* mov rbp, rsp */
            sub_rsp_imm(fn_frame); /* shadow space + locals */
        }
        若 (cur_fn_sret) mov_mbrp_reg64(sret_ptr_off - cur_frame_sz, 1); /* save the hidden sret pointer (rcx) — inner calls clobber it */

        /* copy incoming params into frame slots (reg params from rcx/rdx/r8/r9,
           stack params from [rbp+pdisp]) �?params live in slots, so recursive /
           nested calls can't clobber the parameter registers.
           Pointer params (p_esz>0) are copied 64-bit to keep full addresses.
           Only THIS function's vars [fvb[gfn], fve[gfn]) �?all 109 functions share
           vars[], copying every param into every prologue would clobber live slots. */
        整 fv0 = fvb[gfn], fv1 = fve[gfn];
        vs_end = fv1; /* scope var lookups to this function during codegen */
        cg_blk_end = fv1; /* default block bound = whole function; nested case-5 blocks tighten it (fix 2026-08-16) */
        cg_blk_start = fv1; /* fix 2026-08-19: 默认块下界 = 函数末尾 (宽松, 顶层块变量可见; case-5 进入块时收紧) */
        整 bin_no_params = (bin_mode && i == 0) || is_isr; /* -bin 入口函数或 ISR: 跳过参数复制 */
        遍 (整 vi = fv0; vi < fv1; vi++) {
            若 (vars[vi].is_param && !bin_no_params) {
                若 (vars[vi].is_dbl) {
                    /* double param: xmm[preg→xmm] (reg) or [rbp+pdisp] (stack). 8 bytes. */
                    若 (vars[vi].pstk) { movsd_xmm0_mbrp(vars[vi].pdisp); movsd_mbrp_xmm0(vars[vi].rsp_off - cur_frame_sz); }
                    否 若 (cur_fn_sret) movsd_mbrp_xmmreg(vars[vi].rsp_off - cur_frame_sz, vars[vi].pslot); /* sret fn: double param k lives in xmm[k] */
                    否 movsd_mbrp_xmmreg(vars[vi].rsp_off - cur_frame_sz, preg_to_xmm(vars[vi].preg));
                } 否 若 (vars[vi].pstk) {
                    若 (vars[vi].p_esz > 0 || (vars[vi].st_idx >= 0 && vars[vi].st_sz > 0 && vars[vi].st_sz <= 8) || vars[vi].is_ll) { mov_reg_mbrp64(0, vars[vi].pdisp); mov_mbrp_reg64(vars[vi].rsp_off - cur_frame_sz, 0); }
                    否 { mov_reg_mbrp(0, vars[vi].pdisp); mov_mbrp_reg(vars[vi].rsp_off - cur_frame_sz, 0); }
                } 否 若 (vars[vi].p_esz > 0 || (vars[vi].st_idx >= 0 && vars[vi].st_sz > 0 && vars[vi].st_sz <= 8) || vars[vi].is_ll) mov_mbrp_reg64(vars[vi].rsp_off - cur_frame_sz, vars[vi].preg);
                否 mov_mbrp_reg(vars[vi].rsp_off - cur_frame_sz, vars[vi].preg);
            }
        }

        /* fix step30: 局部 _Alignas(>16) 数组 — 固定 rbp 帧 rbp%N ∈ {8,24} 编译期未知, 静态 [rbp+disp]
           无法保证 >16 对齐; 候选区运行时对齐, 对齐地址存地址槽 (cg case1 数组 decay 读槽). */
        遍 (整 vi = fv0; vi < fv1 && !bin_no_params; vi++) {
            若 (vars[vi].alignN > 0 && vars[vi].vla_dim <= 0) { /* fix step31: VLA 的 alignN=1 只是地址槽标记, 不是 _Alignas 对齐数组 — 跳过, 动态分配在声明处 */
                整 _an = vars[vi].alignN;
                
                lea_r_mbrp(0, vars[vi].align_base - cur_frame_sz);  /* rax = 候选区基址 */
                b(0x48); b(0x81); b(0xC0); b4(_an - 1);             /* add rax, N-1 */
                b(0x48); b(0x25); b4(-_an);                         /* and rax, -N */
                mov_mbrp_reg64(vars[vi].rsp_off - cur_frame_sz, 0); /* 地址槽 = 对齐地址 */
            }
        }

        /* variadic functions: spill the four integer-argument registers into the
           Win64 home area so va_start/va_arg (and msvcrt _vsnprintf) can walk a
           contiguous vararg list. Home base = rbp+24 (see var_param pdisp math).
           Fixed named params are still copied above; the spill only adds the
           home-area view needed by va_list. */
        若 (cur_va_home >= 0 && !bin_no_params) {
            mov_mbrp_reg64(24, 1); /* rcx -> home[0] */
            mov_mbrp_reg64(32, 2); /* rdx -> home[1] */
            mov_mbrp_reg64(40, 8); /* r8  -> home[2] */
            mov_mbrp_reg64(48, 9); /* r9  -> home[3] */
        }

        /* epilogue label: return jumps here */
        epi_label = new_label();

        若 (coff_mode && ginit_n > 0) { /* fix 2026-08-17: coff 模式 ginit 用专用子程序 + 每函数守卫调用 —
                                            原只在最后一个函数内联发射, 若该函数不被调用 (git setup.o
                                            validate_ref_storage_format --help 路径不调) 则初始化永不执行;
                                            初版每函数内联 ginit body → 大 .o 代码缓冲溢出 (sequencer.o) */
            若 (ginit_flag_slot < 0) { ginit_flag_slot = var_static("__qcc_ginit_flag", 0); var_file_static[vcnt - 1] = 1; } /* 每 .o 独立局部符号 (scl=3), 防链接重复 */
            若 (ginit_sub_label < 0) ginit_sub_label = new_label();
            整 lg = new_label();
            mov_eax_rip(coff_static_disp(ginit_flag_slot, 0)); /* flag 已置位? */
            test_rr(0, 0);
            jnz_rel(-1); patch_label(cp - 4, lg, 3);            /* 已初始化 → skip */
            call_rel(0); patch_label(cp - 4, ginit_sub_label, 0); /* call ginit 子程序 (coff 前向重定位) */
            set_label(lg);
            coff_ginit_done = 1;
        } 否 若 ((!coff_mode && (!strcmp(fname, "main") || !strcmp(fname, "主"))) || (bin_mode && !strcmp(fname, "_start"))) { /* bin 模式: ginit 在 _start 发射 (裸机无 CRT) */
            cg_ginit_ctx = 1; /* ginit decls must NOT be skipped by case-7's local-static check */
            遍 (整 gi = 0; gi < ginit_n; gi++) cg(ginit[gi]);
            cg_ginit_ctx = 0;
            coff_ginit_done = 1;
        }

        cg(n0[c]); /* function body */

        /* epilogue label: return jumps here — 提前到 gfn++ 前 (defer cg 需当前函数 vs_end, 原 gfn++ 后 vs_end 指向下一函数 → defer 变量"不能取地址" fix 2026-08-27 defer 接入) */
        set_label(epi_label);
        若 (n1[c] >= 0) { /* defer: 延迟语句 LIFO 逆序执行 — return 跳这里先清理再 epilogue; rax 保存/恢复 — defer 内调用会 clobber return 值 (fix 2026-08-27 defer 接入) */
            sub_rsp_imm(16); /* 对齐 + 临时槽 */
            asm_emit("    存指64 [rsp], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x89); modrm(0, 0, 4); b(0x24); /* mov [rsp], rax */
            cg(n1[c]);
            asm_emit("    取指64 r0, [rsp]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x8B); modrm(0, 0, 4); b(0x24); /* mov rax, [rsp] */
            add_rsp_imm(16);
        }
        gfn++; /* next function's var range */

        若 (is_isr) {
            /* iretq: 从中断返回 (CPU 自动弹出 RIP:CS:RFLAGS:RSP:SS) */
            asm_emit("    iretq\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
            b(0x48); b(0xCF);
        } 否 {
            整 _has_vla = 0; /* fix step31: VLA 动态 sub rsp 后 rsp 不在 rbp-fn_frame — 用 mov rsp,rbp 直接丢弃 VLA 栈区 */
            遍 (整 _vk = fv0; _vk < fv1; _vk++) 若 (vars[_vk].vla_dim > 0) { _has_vla = 1; 断; }
            若 (_has_vla) mov_rr64(4, 5); /* mov rsp, rbp */
            否 add_rsp_imm(fn_frame);
            pop_r(3); /* pop rbx */
            pop_r(5); /* pop rbp */
            ret();
        }
    }
    若 (coff_mode && ginit_sub_label >= 0) { /* fix 2026-08-17: ginit 专用子程序 (每函数守卫调用, 正文只在末尾一次) */
        set_label(ginit_sub_label);
        /* fix 2026-08-19: set flag=1 BEFORE running the initializer body so the
           ginit body can safely call guarded functions in the SAME .o (userdiff.c
           builtin_drivers init calls the IPATTERN/PATTERNS stubs). With the flag
           set only at the end, the callee's guard sees flag==0 and calls the
           ginit sub again -> A<->B mutual recursion -> stack overflow 0xC00000FD. */
        mov_r_imm(0, 1); mov_rip_eax(coff_static_disp(ginit_flag_slot, 0)); /* flag = 1 FIRST: ginit re-entrant */
        cg_ginit_ctx = 1;

        遍 (整 gi = 0; gi < ginit_n; gi++) cg(ginit[gi]);
        cg_ginit_ctx = 0;
        b(0xC3); /* ret */
    }
    若 (coff_mode) {
        /* -c 模式：跳过 CRT 与补丁烘焙；str/fn/dbl 补丁改为 COFF 重定位 */
        遍 (整 i = 0; i < strpn; i++) {
            整 si = str_patches[i].str_idx;
            若 (!coff_str_sym) coff_str_sym = csym_add(".rdata$str", 0, 2, 3, 0);
            整 off = str_offs[si];
            b4_at(str_patches[i].patch_at, off);
            coff_crel(str_patches[i].patch_at, 0x0002, coff_str_sym, off);
        }
        遍 (整 i = 0; i < fnpn; i++) {
            整 fs = coff_func_label_sym(fn_patches[i].label);
            若 (fs >= 0) {
                b4_at(fn_patches[i].patch_at, 0);
                coff_crel(fn_patches[i].patch_at, 0x0002, fs, 0);
            }
        }
        /* 计算字符串数据总大小 — dbl_offs 值包含 sdat 前缀（字符串）偏移，
           但 COFF .rdbl 节只有 double 数据（从 0 开始），reloc addend 必须减去前缀。 */
        整 str_bytes = 0;
        遍 (整 i = 0; i < str_cnt; i++) 若 (str_offs[i] >= 0) {
            整 sz = (整)strlen(str_tbl[i]) + 1;
            若 (str_offs[i] + sz > str_bytes) str_bytes = str_offs[i] + sz;
        }
        若 (str_bytes > sdp) str_bytes = sdp;
        遍 (整 i = 0; i < dbl_patch_n; i++) {
            整 di = dbl_patches[i].dbl_idx;
            若 (!coff_dbl_sym) coff_dbl_sym = csym_add(".rdata$dbl", 0, 3, 3, 0);
            整 off = dbl_offs[di] - str_bytes; /* .rdbl 节内偏移（去掉字符串前缀） */
            b4_at(dbl_patches[i].patch_at, off);
            coff_crel(dbl_patches[i].patch_at, 0x0004, coff_dbl_sym, off);
        }
        若 (sdp > 0) {
            coff_str_add(sdat, str_bytes);
            若 (sdp > str_bytes) coff_dbl_add(sdat + str_bytes, sdp - str_bytes);
        }
        /* 内部跳转重定位的 addend = 最终 label_pos（前向跳转在 patch 时未知）。
           COFF addend 在指令字节中（jyld 从指令读），必须写回最终值。 */
        遍 (整 i = 0; i < crel_n; i++) 若 (crel[i].is_label) {
            crel[i].addend = label_pos[crel[i].label];
            b4_at(crel[i].site, label_pos[crel[i].label]);
        }
        返;
    }

    /* mini-CRT entry stub: provides argc/argv, calls main, exits with its code.
       Emitted in BOTH passes (pass 2 overwrites pass 1 identically).
       -bin 模式: 无 CRT (内核自备 Multiboot2 header + 入口, fix 2026-08-08) */
    若 (!bin_mode) {
        asm_emit("\n; === CRT ===\n_入口:\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        emit_crt_stub();
    }

    /* ????????? */
    resolve_patches();

    /* ??????????? patch imm32 in mov_r_imm ??actual VA (ImageBase + RVA) */
    整 code_end = cp;
    遍 (整 i = 0; i < strpn; i++) {
        整 si = str_patches[i].str_idx;
        整 off = str_offs[si]; /* byte offset within string data */
        整 rva = (bin_mode ? 0x104000 : IMAGE_BASE) + 0x1000 + code_end + off; /* bin: 内核加载基址 0x104000 (拼接引导后) + code区 + off */
        b4_at(str_patches[i].patch_at, rva);
    }
    /* patch function-address imm32s (fn ptr assignment) to actual VA */
    遍 (整 i = 0; i < fnpn; i++) {
        整 rva = (bin_mode ? 0x104000 : IMAGE_BASE) + 0x1000 + label_pos[fn_patches[i].label];
        b4_at(fn_patches[i].patch_at, rva);
    }
    /* patch double-literal rip-relative disp32s: target VA = text_rva + code_end + dbl_off.
       movsd xmm0,[rip+disp32] is 8 bytes (F2 0F 10 05 + disp4); disp sits at patch_at
       (4 bytes into the instruction), so the RIP base is patch_at+4 (end of instruction). */
    遍 (整 i = 0; i < dbl_patch_n; i++) {
        整 di = dbl_patches[i].dbl_idx;
        整 off = dbl_offs[di];
        整 base = (bin_mode ? 0x104000 : IMAGE_BASE);
        整 rva = base + 0x1000 + code_end + off;
        b4_at(dbl_patches[i].patch_at, rva - (base + 0x1000 + dbl_patches[i].patch_at + 4));
    }
    /* ????????????????????*/
    若 (sdp > 0) {
        循环 (cp + sdp >= CODE_BUF_CAP) { 无 字 *nc = realloc(code, CODE_BUF_CAP+4096); /* code 缓冲上限（fix 2026-08-06: 误用 IMAGE_BASE 语义，H1） */ 若 (!nc) { fprintf(stderr, "qcc_x86: OOM at code buffer %d bytes\n", IMAGE_BASE+4096); exit(1); } code = nc; }
        memcpy(code + cp, sdat, sdp);
        cp += sdp;
    }

    /* data section ASM directives for round-trip */
    asm_emit("\n; === .data ===\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    整 dbl_di = 0;
    /* .字串 in ID order (= sdat placement order), .浮点 INTERLEAVED at its sdat
       position - qcc places doubles mid-sdat during codegen, so dumping all
       .浮点 at the end made asm_zh's string-pool layout differ. */
    遍 (整 i = 0; i < str_cnt; i++) {
        整 off = str_offs[i];
        循环 (dbl_di < dbl_n) {
            整 doff = dbl_offs[dbl_di];
            若 (doff < 0) { dbl_di++; 续; }
            若 (off >= 0 && doff < off) {
                整 lo = dbl_lo[dbl_di], hi = dbl_hi[dbl_di];
                无 字 db[8];
                db[0]=lo&0xff;db[1]=(lo>>8)&0xff;db[2]=(lo>>16)&0xff;db[3]=(lo>>24)&0xff;
                db[4]=hi&0xff;db[5]=(hi>>8)&0xff;db[6]=(hi>>16)&0xff;db[7]=(hi>>24)&0xff;
                双 v; memcpy(&v, db, 8);
                asm_emit_dbl(".浮点 %f\n", v);
                dbl_di++;
            } 否 断;
        }
        若 (off >= 0) {
            /* escape quotes/backslashes/newlines: strings like "%s":" start with a
               quote, which asm_zh's .字串 parser took as the closing quote */
            asm_emit(".字串 \"", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
            遍 (常 字 *cc = str_tbl[i]; *cc; cc++) {
                若 (*cc == '"') asm_emit("\\\"", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*cc == '\\') asm_emit("\\\\", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*cc == '\n') asm_emit("\\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*cc == '\t') asm_emit("\\t", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 asm_emit("%c", (字*)(长 长)(*cc), (字*)(长 长)0, (字*)(长 长)0);
            }
            asm_emit("\"\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        }
    }
    循环 (dbl_di < dbl_n) {
        若 (dbl_offs[dbl_di] >= 0) {
            整 lo = dbl_lo[dbl_di], hi = dbl_hi[dbl_di];
            无 字 db[8];
            db[0]=lo&0xff;db[1]=(lo>>8)&0xff;db[2]=(lo>>16)&0xff;db[3]=(lo>>24)&0xff;
            db[4]=hi&0xff;db[5]=(hi>>8)&0xff;db[6]=(hi>>16)&0xff;db[7]=(hi>>24)&0xff;
            双 v; memcpy(&v, db, 8);
            asm_emit_dbl(".浮点 %f\n", v);
        }
        dbl_di++;
    }
    /* static-slot count for the heap counter (asm_zh cannot know stc_n) */
    asm_emit("\n.堆计 %d\n", (字*)(长 长)(stc_n), (字*)(长 长)0, (字*)(长 长)0);
    /* tell asm_zh the exact code_end (before sdat) so it can align its layout */
    asm_emit(".布局 code_end=%d data_base=0x%X\n", (字*)(长 长)(cp - sdp), (字*)(长 长)(data_rva_base), (字*)(长 长)0);
    /* fix 2026-08-12 H2 对等: 告诉 asm_zh 直发的 .data 段尺寸 (data_extent 修复后 vsize/raw 是动态的,
       asm_zh 旧写死 0x5000000/0x4000 → H2 产物 .data 段 ≠ 直发 → H2 对等失败) */
    { 整 lvsize = (data_extent() + 0x100000 + 4095) & ~4095; 若 (lvsize < 0x6000000) lvsize = 0x6000000; /* 96MB 地板 (write_pe 同) */
      asm_emit(".段 data_vsize=0x%X data_raw=0x%X\n", (字*)(长 长)lvsize, (字*)(长 长)(DATA_RAW_SZ), (字*)(长 长)0); }

    /* ??main ???????? �?mini-CRT stub is the real entry (it calls main) */
    整 entry_rva = 0x1000 + crt_entry_off;
    若 (bin_mode) {
        /* -bin 入口 = _start (用户主函数) 的 label 偏移, 非 CRT stub (bin 跳过 CRT) — fix 2026-08-08 */
        整 si = func_find("_start");
        若 (si < 0 || !func_tbl[si].defined) si = func_find("主");
        若 (si >= 0 && func_tbl[si].defined) entry_rva = 0x1000 + label_pos[func_tbl[si].label]; /* bin 偏移 = code区(0x1000) + 函数偏移 */
        fprintf(stderr, "[BIN] _start entry offset: 0x%X (code=%d)\n", entry_rva, cp);
    }
    entry_rva_global = entry_rva;
}

/* Read a file into a malloc'd NUL-terminated string (NULL on failure).
   REAL function, NOT a macro: the lexer skips function-like macro definitions
   (#define F(x) ...), so a macro call would compile as an undefined function
   and the self-hosted compiler could never read its input. */
静 字 *read_file(常 字 *path) {
    若 (bare_metal) { /* fix 2026-08-10 Gate 9: ������ļ�ϵͳ -> �ڴ�� */
        若 (!strcmp(path, "srclib/qcc_rt.c") || !strcmp(path, "qcc_rt.c")) {
            返 (字 *)BIN_RT_ADDR; /* ����ʱ */
        }
        返 (字 *)BIN_SRC_ADDR;  /* ��Դ�� */
    }

    字 *b = NULL;
    FILE *f;
    整 sz;
    f = fopen(path, "rb");
    若 (f) {
        fseek(f, 0, 2); /* SEEK_END */
        sz = ftell(f);
        rewind(f);
        若 (sz < 0) { fclose(f); 返 NULL; } /* fix 2026-08-09 BUG-12: ftell 失败(-1L 非 seekable)显式检查 */
        若 (sz > 0 && sz <= 16777216) { /* fix 2026-08-24 t35u: 1048576→2097152 — qcc_x86.c 自身 t35u 后 1.05MB 超 1MB 上限 → H1 链自举编译自身 "cannot open" */
            b = malloc((sz + 4) & ~3); /* fix 2026-08-11 BLOCKER-3: round to 4 — unaligned bump sizes misalign tt..tll -> tll[tk] garbage -> spurious nll=1 -> 2-cycle */
            fread(b, 1, sz, f);
            b[sz] = 0;
            /* skip UTF-8 BOM (EF BB BF): qcc lexed it as a CJK identifier
               (e.g. "主"), corrupting the first token and swallowing main
               (fix 2026-08-06: `unsigned a>=b; if(...){printf;return;}` crashed) */
            若 (sz >= 3 && (无 字)b[0] == 0xEF && (无 字)b[1] == 0xBB && (无 字)b[2] == 0xBF) {
                memmove(b, b + 3, sz - 3);
                b[sz - 3] = 0;
            }
        }
        fclose(f);
    }
    返 b;
}

/* 自切栈：loader 把主线程栈放在镜�?SizeOfImage 内部（~91.6-92.6MB），页面不可�?
   （deep parse 帧读 SIGSEGV）。本数组必须是【最后一个文件级静态】：CRT stub 入口
   �?rsp 切到这里，栈�?= heap 起点，栈向下增长、heap 向上增长，背靠背互不侵犯�?*/
__attribute__((unused))
静 字 __stack[0x100000];

/* ---------- COFF 对象写入（-c 模式） ---------- */
静 空 w2f(FILE *f, 整 v) { fputc(v & 0xFF, f); fputc((v >> 8) & 0xFF, f); }
静 空 w4f(FILE *f, 整 v) { fputc(v & 0xFF, f); fputc((v >> 8) & 0xFF, f); fputc((v >> 16) & 0xFF, f); fputc((v >> 24) & 0xFF, f); }

/* 全局 brace 初始化器静态落盘：把 brace_arr_init/brace_fields 生成的
   常量赋值（sane_ctype[256]、commands[] 等）直接写进 .data，多文件链接时
   ginit 不会执行，不能依赖运行时代码。左值必须是文件级/函数级 static。 */
静 字 *coff_lval_root_name(整 n) {
    循环 (n >= 0 && (nt[n] == 14 || nt[n] == 15 || nt[n] == 13)) n = n0[n];
    若 (n >= 0 && nt[n] == 1) 返 (字*)(nn + n);
    返 NULL;
}
静 整 coff_static_var_index(常 字 *n) {
    遍 (整 i = vcnt - 1; i >= 0; i--)
        若 (!strcmp(vars[i].name, n) && vars[i].is_static && vars[i].rsp_off >= 0)
            返 i;
    返 -1;
}
/* 计算 static 左值表达式在 .data 内的字节偏移（相对其基变量槽）。
   *esz_out = 该位置要写入的字节数；*si_out = 结构体类型（成员链续接用，-1 表示非结构体）。 */
静 整 coff_lval_byte(整 n, 整 *base_slot_out, 整 *esz_out, 整 *si_out) {
    若 (n < 0) 返 -1;
    若 (nt[n] == 1) {
        整 idx = coff_static_var_index((字*)(nn + n));
        若 (idx < 0) 返 -1;
        *base_slot_out = vars[idx].rsp_off;
        整 si = vars[idx].st_idx;
        整 esz = 4;
        若 (vars[idx].arr_esz > 0) esz = vars[idx].arr_esz;
        否 若 (vars[idx].p_esz > 0) esz = 8;
        否 若 (vars[idx].is_ll || vars[idx].is_dbl) esz = 8;
        否 若 (si >= 0) esz = stypes[si].sz;
        *esz_out = esz;
        *si_out = si;
        返 0;
    }
    若 (nt[n] == 14) {
        整 c = n1[n]; /* fix 2026-08-16 根治: 数组访问节点索引子节点可能为 -1 (非法/解析产物), nt[-1]/nv[-1] 越界读 — qcc 三元急切求值两分支都算, host(gcc 分支式) 靠布局侥幸不崩, v1 必崩 (add-patch.c 0xC0000005) */
        整 idx = (c >= 0 && nt[c] == 0) ? nv[c] : -1;
        若 (idx < 0) 返 -1;
        整 bs = 0, esz = 0, si = -1;
        整 bb = coff_lval_byte(n0[n], &bs, &esz, &si);
        若 (bb < 0 || esz <= 0) 返 -1;
        整 out_esz = esz;
        整 out_si = si;
        若 (si < 0) { /* 数组元素：下一层的字节大小取数组基变量的标量元素大小 */
            字 *root = coff_lval_root_name(n);
            整 ridx = root ? coff_static_var_index(root) : -1;
            若 (ridx >= 0) {
                out_esz = vars[ridx].p_esz > 0 ? vars[ridx].p_esz :
                          (vars[ridx].arr_esz > 0 ? vars[ridx].arr_esz : 4);
            }
        }
        *base_slot_out = bs;
        *esz_out = out_esz;
        *si_out = out_si;
        返 bb + idx * esz;
    }
    若 (nt[n] == 15 || nt[n] == 13) {
        若 (nv[n] != 0) 返 -1; /* 指针箭头成员（->）不在全局静态初始化器中出现 */
        字 *fn = (字*)(nn + n);
        整 bs = 0, esz = 0, si = -1;
        整 bb = coff_lval_byte(n0[n], &bs, &esz, &si);
        若 (bb < 0 || si < 0) 返 -1;
        整 fo = st_off(stypes[si].name, fn);
        若 (fo < 0) 返 -1;
        整 fsz = st_field_size(stypes[si].name, fn);
        整 fty = st_field_ty_idx(stypes[si].name, fn);
        若 (fty >= 0 && stypes[fty].sz != fsz) fty = -1; /* struct 指针字段：不是值嵌入 */
        *base_slot_out = bs;
        *esz_out = fsz;
        *si_out = fty;
        返 bb + fo;
    }
    返 -1;
}
/* fix 2026-08-21: 全局 const 初始化器的常量表达式 (GIT_SHA1_HEXSZ=(2*RAW) 等) 编译期折叠 —
   原 coff_write_lval_value 只认 NK 字面量, 表达式节点走 ginit 运行时赋值 → 跨 .o 时 ginit 触发晚
   (object-name.o 读 hash_algos 时 object-file.o 的 ginit 未跑) → cat-file/commit oid 解析失败 (Not a valid object name) */
静 整 ginit_const_fold(整 n, 整 *ok) {
    若 (n < 0) { *ok = 0; 返 0; }
    若 (nt[n] == 0) { *ok = 1; 返 nv[n]; }
    若 (nt[n] == 2) {
        整 o = nv[n];
        整 ok1 = 0, ok2 = 0;
        整 a = ginit_const_fold(n0[n], &ok1);
        整 b = ginit_const_fold(n1[n], &ok2);
        若 (!ok1 || !ok2) { *ok = 0; 返 0; }
        若 (o == T_DK) { *ok = 1; 返 a * b; }
        若 (o == T_PK) { *ok = 1; 返 a + b; }
        若 (o == T_MK) { *ok = 1; 返 a - b; }
        若 (o == T_DV) { 若 (b == 0) { *ok = 0; 返 0; } *ok = 1; 返 a / b; }
        若 (o == T_MD) { 若 (b == 0) { *ok = 0; 返 0; } *ok = 1; 返 a % b; }
        *ok = 0; 返 0;
    }
    *ok = 0; 返 0;
}
静 空 coff_write_lval_value(uint8_t *ddata, 整 data_off, 整 esz, 整 rhs) {
    若 (rhs < 0) 返;
    若 (nt[rhs] == 0) {
        整 v = nv[rhs];
        若 (esz == 1) { ddata[data_off] = (无 字)v; }
        否 若 (esz == 2) { ddata[data_off] = (无 字)(v & 0xff); ddata[data_off + 1] = (无 字)((v >> 8) & 0xff); }
        否 若 (esz == 4) { memcpy(ddata + data_off, &v, 4); }
        否 若 (esz == 8) {
            长 长 lv = (长 长)(无 整)v;
            若 (nll[rhs]) lv |= ((长 长)(无 整)nll_hi[rhs]) << 32;
            memcpy(ddata + data_off, &lv, 8);
        }
        返;
    }
    若 (nt[rhs] == 2) { /* 常量表达式编译期折叠: (2 * GIT_SHA1_RAWSZ) → 40 (fix 2026-08-21: 原跳过 → .data 槽 0 → 跨 .o ginit 未跑时读 0) */
        整 ok = 0;
        整 v = ginit_const_fold(rhs, &ok);
        若 (!ok) 返;
        若 (esz == 1) { ddata[data_off] = (无 字)v; }
        否 若 (esz == 2) { ddata[data_off] = (无 字)(v & 0xff); ddata[data_off + 1] = (无 字)((v >> 8) & 0xff); }
        否 若 (esz == 4) { memcpy(ddata + data_off, &v, 4); }
        否 若 (esz == 8) { 长 长 lv = (长 长)v; memcpy(ddata + data_off, &lv, 8); }
        返;
    }
    若 (nt[rhs] == 11 && n0[rhs] >= 0 && nt[n0[rhs]] == 1) { /* &target: 8 字节指针槽 ADDR64 重定位 (fix 2026-08-21: brace init 的 & 自引用 (tempfile_list = {&list,&list}) 原跳过 → .data 槽 0 → volatile_list_del head=垃圾 → commit 崩) */
        字 *tgt = (字*)(nn + n0[rhs]);
        整 toff = var_lookup(tgt);
        整 tsym = toff >= 0 ? coff_slot_sym(toff) : -1;
        若 (tsym >= 0) { memset(ddata + data_off, 0, 8); coff_data_crel(data_off, 0x0001, tsym, 0); }
        返;
    }
    若 (nt[rhs] == STR) {
        整 si = nv[rhs];
        若 (!coff_str_sym) coff_str_sym = csym_add(".rstr", 0, 2, 3, 0);
        整 addend = (si >= 0 && si < str_cnt && str_offs[si] >= 0) /* fix 2026-08-27 step7: si<str_cnt (原 2048 残留 — str_offs 扩 65536 配套) */ ? str_offs[si] : 0;
        
        coff_data_crel(data_off, 0x0002, coff_str_sym, addend);
        返;
    }
    若 (nt[rhs] == 1) {
        字 *tn = (字*)(nn + rhs);
        整 s = csym_find(tn);
        若 (s < 0) s = csym_add(tn, 0, 0, 2, 0x20);
        coff_data_crel(data_off, 0x0002, s, 0);
        返;
    }
}
静 空 coff_emit_ginit(整 gn, uint8_t *ddata) {
    若 (gn < 0) 返;
    若 (nt[gn] == 5) {
        遍 (整 k = 0; k < 256; k++) {
            整 c = child_i(gn, k);
            若 (c > 0) coff_emit_ginit(c, ddata);
        }
        返;
    }
    若 (nt[gn] == 10) {
        整 lv = n0[gn], rhs = n1[gn];
        
        若 (lv < 0 || rhs < 0) 返;
        整 bs = 0, esz = 0, si = -1;
        整 boff = coff_lval_byte(lv, &bs, &esz, &si);
        
        若 (boff < 0 || bs < 0) 返;
        整 data_off = 4 * bs + boff;
        若 (data_off < 0 || esz <= 0 || data_off + (esz > 4 ? 8 : esz) > stc_n * 4) 返;
        coff_write_lval_value(ddata, data_off, esz, rhs);
    }
}

静 空 write_coff_obj(FILE *f) {
    /* 节内容 */
    构 { 字 name[16]; 整 size; uint8_t *data; 整 chars; } secs[4];
    memset(secs, 0, 大小(secs));
    strcpy(secs[0].name, ".text"); secs[0].size = cp; secs[0].data = code; secs[0].chars = 0x60000020;
    strcpy(secs[1].name, ".rstr"); secs[1].size = coff_str_len; secs[1].data = coff_str_data; secs[1].chars = 0x40300040;
    strcpy(secs[2].name, ".rdbl"); secs[2].size = coff_dbl_len; secs[2].data = coff_dbl_data; secs[2].chars = 0x40300040;
    /* Task 5.1 (fix 2026-08-06): 全局初始值入 .data — 原 .bss 无内容, 常量初始值 (ginit) 在 -c 多 .o 链接时
       挂在第一个函数入口不执行 → counter=100 丢成 0。改 .data 段含初始值; 未初始化全局写 0 (语义等价 .bss 清零) */
    strcpy(secs[3].name, ".data"); secs[3].size = stc_n * 4; secs[3].chars = 0xC0300080;
    uint8_t *ddata = (uint8_t*)malloc((stc_n ? stc_n : 1) * 4);
    memset(ddata, 0, (stc_n ? stc_n : 1) * 4); /* fix 2026-08-17: bump calloc does NOT zero; write_coff_obj .data needs clean buffer */

    secs[3].data = ddata;
    遍 (整 gi = 0; gi < ginit_n; gi++) { /* 常量全局初始值 (g = 立即数) 直接写 .data — case 7 decl+init (值在 n0), case 10 assign (值在 n1) */
        整 gn = ginit[gi];
        整 val_node = -1;
        若 (gn >= 0 && nt[gn] == 7 && n0[gn] >= 0 && nt[n0[gn]] == 0) val_node = n0[gn];
        否 若 (gn >= 0 && nt[gn] == 10 && n1[gn] >= 0 && nt[n1[gn]] == 0) val_node = n1[gn];
        /* fix 2026-08-17: &var 地址常量 → .data ADDR32 重定位 (coff 多 .o 时 ginit 子程序不被 main 所在 .o 调用 → 全局指针 = &x 保持 0 崩; 单文件非 coff 走 ginit 正常) */
        否 若 (coff_mode && gn >= 0 && nt[gn] == 7 && n0[gn] >= 0 && nt[n0[gn]] == 11 && n0[n0[gn]] >= 0 && nt[n0[n0[gn]]] == 1) val_node = n0[gn];
        否 若 (coff_mode && gn >= 0 && nt[gn] == 10 && n1[gn] >= 0 && nt[n1[gn]] == 11 && n0[n1[gn]] >= 0 && nt[n0[n1[gn]]] == 1) val_node = n1[gn];
        /* fix 2026-08-21: 字符串字面量初始化器 (const char *g = "str") → .data 槽写字符串地址 reloc。
           原只匹配数值/&var 节点, STR 节点 (nt=STR) 跳过 → 槽 0 → blob_type/commit_type 等 NULL → hash-object/commit 崩 */
        否 若 (coff_mode && gn >= 0 && nt[gn] == 7 && n0[gn] >= 0 && nt[n0[gn]] == STR) val_node = n0[gn];
        否 若 (coff_mode && gn >= 0 && nt[gn] == 10 && n1[gn] >= 0 && nt[n1[gn]] == STR) val_node = n1[gn];
        若 (val_node >= 0) {
            字 *vn = (字*)(nn + gn);
            整 off = var_lookup(vn);
            若 (off >= 0 && off < stc_n) {
                若 (nt[val_node] == 11) { /* &target: 8 字节指针槽 0 占位 + ADDR64 重定位 (fix 2026-08-17: 原 4 字节 + REL32_3(0x0006) 错类型 → 链接后垃圾地址) */
                    字 *tgt = (字*)(nn + n0[val_node]);
                    整 toff = var_lookup(tgt);
                    整 tsym = toff >= 0 ? coff_slot_sym(toff) : -1;
                    若 (tsym >= 0) { memset(ddata + 4 * off, 0, 8); coff_data_crel(4 * off, 0x0001, tsym, 0); }
                } 否 若 (nt[val_node] == STR) { /* 字符串字面量: 8 字节指针槽 → .rstr 段 ADDR32 重定位 */
                    memset(ddata + 4 * off, 0, 8);
                    coff_write_lval_value(ddata, 4 * off, 8, val_node);
                } 否 {
                    整 v = nv[val_node];
                    若 (var_is_ll(vn)) { 长 长 lv = (长 长)v; memcpy(ddata + 4 * off, &lv, 8); } /* ll 全局常量: 符号扩展 8 字节 (fix 2026-08-06: 原 4 字节 → 高 4 字节 0, -5 变 4294967291) */
                    否 memcpy(ddata + 4 * off, &v, 4);
                }
            }
        }
    }
    若 (!coff_text_sym) coff_text_sym = csym_add(".text", 0, 1, 3, 0);
    若 (!coff_str_sym) coff_str_sym = csym_add(".rstr", 0, 2, 3, 0);
    若 (!coff_dbl_sym) coff_dbl_sym = csym_add(".rdbl", 0, 3, 3, 0);
    若 (!coff_bss_sym) coff_bss_sym = csym_add(".data", 0, 4, 3, 0); /* fix 2026-08-06: .bss→.data (全局初始值入 .data) */
    遍 (整 i = 0; i < func_n; i++) {
        若 (func_tbl[i].defined) {
            整 fsc = (fn_static_is(func_tbl[i].name) || coff_is_builtin(func_tbl[i].name)) ? 3 : 2; /* static/内建 → 局部符号 scl=3 (fix 2026-08-06: 多 .o 头库不冲突) */
            整 s = csym_find(func_tbl[i].name);
            若 (s < 0) {
                s = csym_add(func_tbl[i].name, label_pos[func_tbl[i].label], 1, fsc, 0x20);
            } 否 {
                /* fix 2026-08-15: 同名未定义符号先入表（函数体之前被引用）→ 定义被跳过，符号值停在 0 → strbuf_add 跳到对象首函数 */
                csym[s].value = label_pos[func_tbl[i].label];
                csym[s].sec = 1;
                csym[s].sc = fsc;
                csym[s].type = 0x20;
            }
        }
    }
    遍 (整 i = 0; i < vcnt; i++) {
        若 (vars[i].is_static && vars[i].rsp_off >= 0) { /* extern (rsp_off<0) 不生成 .bss 定义符号 — 由 coff_slot_sym 生成 sec=0 未定义 (fix 2026-08-06) */
            整 vsc = (var_static_kw[i] || var_file_static[i]) ? 3 : 2;
            整 s = csym_find(vars[i].name);
            若 (s < 0) s = csym_add(vars[i].name, 4 * vars[i].rsp_off, 4, vsc, 0); /* fix 2026-08-06: 函数内 static → scl=3 局部; fix 2026-08-14: 文件级 static 也 scl=3 */
            否 {
                /* fix 2026-08-15: 同名符号先以未定义/错误值入表 → 更新为真实 .data 槽 */
                csym[s].value = 4 * vars[i].rsp_off;
                csym[s].sec = 4;
                csym[s].sc = vsc;
                csym[s].type = 0;
            }
        }
    }

    /* -c 多 .o 链接: 把「函数/全局变量地址」类静态初始化器直接落成 .data ADDR32 重定位。
       否则它们只存在于 ginit 运行时代码，而 ginit 只挂在对象最后一个函数入口，
       多文件链接后不会执行 → 静态函数指针槽保持 0（usage_routine/die_routine 崩）。 */
    遍 (整 gi = 0; gi < ginit_n; gi++) {
        整 gn = ginit[gi];
        若 (gn < 0 || nt[gn] != 7 || n0[gn] < 0) 续;
        若 (nt[n0[gn]] != 1) 续; /* 仅处理函数/全局变量地址初始化 */
        字 *vn = (字*)(nn + gn);
        整 off = -1;
        遍 (整 vi = vcnt - 1; vi >= 0; vi--)
            若 (!strcmp(vars[vi].name, vn) && vars[vi].is_static && vars[vi].rsp_off >= 0) { off = vars[vi].rsp_off; 断; }
        若 (off < 0) 续;
        字 *tn = (字*)(nn + n0[gn]);
        整 s = csym_find(tn);
        若 (s < 0) 续;
        coff_data_crel(4 * off, 0x0002, s, 0);
    }

    /* 全局 brace 数组/结构体初始化：把静态可确定的元素/字段值写入 .data。
       覆盖 sane_ctype[256]、commands[] 等（fix 2026-08-16: 多文件链接 ginit 不执行，
       原 .data 全零 → isspace/isalnum 宏全假、命令分发表空）。 */
    遍 (整 gi = 0; gi < ginit_n; gi++) {
        整 gn = ginit[gi];
        若 (gn >= 0 && nt[gn] == 5) coff_emit_ginit(gn, ddata);
    }

    /* 每节重定位 */
    整 nrel[4] = {0,0,0,0};
    遍 (整 i = 0; i < crel_n; i++) {
        /* 重定位按 site 所在节分组（不是目标符号的节） */
        整 site = crel[i].site;
        整 rsec = 0;
        若 (site >= COFF_DATA_SITE_BASE) rsec = 3;
        否 若 (site >= cp) {
            若 (site < cp + coff_str_len) rsec = 1;
            否 rsec = 2;
        }
        nrel[rsec]++;
    }
    整 *rva[4], *rsym[4], *rtyp[4];
    整 ridx[4] = {0,0,0,0};
    遍 (整 i = 0; i < 4; i++) {
        rva[i] = calloc(nrel[i] ? nrel[i] : 1, 4);
        rsym[i] = calloc(nrel[i] ? nrel[i] : 1, 4);
        rtyp[i] = calloc(nrel[i] ? nrel[i] : 1, 4);
    }
    遍 (整 i = 0; i < crel_n; i++) {
        整 site = crel[i].site;
        整 rsec = 0;
        若 (site >= COFF_DATA_SITE_BASE) rsec = 3;
        否 若 (site >= cp) {
            若 (site < cp + coff_str_len) rsec = 1;
            否 rsec = 2;
        }
        整 b2 = ridx[rsec]++;
        rva[rsec][b2] = (rsec == 3) ? (crel[i].site - COFF_DATA_SITE_BASE) : crel[i].site;
        rsym[rsec][b2] = crel[i].sym;
        rtyp[rsec][b2] = crel[i].type;
    }

    /* fix 2026-08-18: ADDR32/ADDR64 .data 重定位的 addend 必须写进 .data 站点 —
       COFF 的 addend 存在节数据里 (链接器读站点字节加符号地址); 原只记 reloc 表不写 addend
       → 全局指针 = 字符串 (special_refs[]={"FETCH_HEAD",...}) 的 addend 全 0 →
       指针指向 .rstr 偏移 0 ("SUDO_UID") → is_special_ref strcmp 垃圾 → git init SEGV */
    遍 (整 i = 0; i < crel_n; i++) {
        若 (crel[i].site >= COFF_DATA_SITE_BASE && (crel[i].type == 0x0002 || crel[i].type == 0x0001)) {
            整 off = crel[i].site - COFF_DATA_SITE_BASE;
            
            若 (off >= 0 && off + 8 <= stc_n * 4) {
                整 a = crel[i].addend;
                若 (crel[i].type == 0x0001) { 长 长 la = (长 长)(无 整)a; memcpy(ddata + off, &la, 8); }
                否 memcpy(ddata + off, &a, 4);
            }
        }
    }

    /* COFF header */
    w2f(f, 0x8664); w2f(f, 4); w4f(f, 0);
    整 sym_off_pos = (整)ftell(f);
    w4f(f, 0); w4f(f, 0);
    w2f(f, 0); w2f(f, 0);

    /* 节表 + 计算 raw offsets */
    整 raw_off = 20 + 40 * 4;
    整 rel_offs[4];
    遍 (整 i = 0; i < 4; i++) {
        字 nm[9]; memset(nm, 0, 9); memcpy(nm, secs[i].name, 8);
        fwrite(nm, 1, 8, f);
        w4f(f, 0); w4f(f, 0);
        w4f(f, secs[i].size);
        w4f(f, raw_off); raw_off += secs[i].size;
        /* reloc offset 先占位，写完数据后回填 */
        rel_offs[i] = -1;
        w4f(f, 0); w4f(f, 0);
        w2f(f, nrel[i]); w2f(f, 0);
        w4f(f, secs[i].chars);
    }

    /* 节数据 */
    遍 (整 i = 0; i < 4; i++) {
        若 (secs[i].data && secs[i].size > 0) fwrite(secs[i].data, 1, secs[i].size, f);
    }
    /* 重定位表（对象重定位偏移 = 文件绝对偏移） */
    整 rel_base = (整)ftell(f);
    遍 (整 i = 0; i < 4; i++) {
        rel_offs[i] = nrel[i] ? rel_base : 0;
        遍 (整 j = 0; j < nrel[i]; j++) {
            w4f(f, rva[i][j]);
            w4f(f, rsym[i][j]);
            w2f(f, rtyp[i][j]);
        }
        rel_base += nrel[i] * 10;
    }
    /* 回填节表 PointerToRelocations（第 i 项 +24） */
    遍 (整 i = 0; i < 4; i++) {
        fseek(f, 20 + 40 * i + 24, SEEK_SET);
        w4f(f, rel_offs[i]);
    }

    /* 符号表 */
    整 sym_off = rel_base + (nrel[0] + nrel[1] + nrel[2] + nrel[3]) * 10;
    fseek(f, sym_off, SEEK_SET);
    整 strtab_size = 4;
    遍 (整 i = 0; i < csym_n; i++) 若 ((整)strlen(csym[i].name) > 8) strtab_size += (整)strlen(csym[i].name) + 1;
    遍 (整 i = 0; i < csym_n; i++) {
        常 字 *nm = csym[i].name;
        整 len = (整)strlen(nm);
        若 (len <= 8) {
            字 nbuf[8]; memset(nbuf, 0, 8); memcpy(nbuf, nm, len);
            fwrite(nbuf, 1, 8, f);
        } 否 {
            整 o = 4;
            遍 (整 k = 0; k < i; k++) 若 ((整)strlen(csym[k].name) > 8) o += (整)strlen(csym[k].name) + 1;
            fputc(0,f); fputc(0,f); fputc(0,f); fputc(0,f); /* 4 zero + 4 offset = 8 字节名字段 */
            w4f(f, o);
        }
        w4f(f, csym[i].value);
        w2f(f, csym[i].sec);
        w2f(f, csym[i].type);
        fputc(csym[i].sc, f);
        fputc(0, f);
    }
    /* 字符串表 */
    w4f(f, strtab_size);
    遍 (整 i = 0; i < csym_n; i++) {
        若 ((整)strlen(csym[i].name) > 8) { fputs(csym[i].name, f); fputc(0, f); }
    }
    /* 回填符号表指针 */
    fseek(f, sym_off_pos, SEEK_SET);
    w4f(f, sym_off);
    w4f(f, csym_n);
}

/* ==== Phase 3 阶段 C: IR 工程预埋区 (v1.4 §11.2 定义态 · 宏门内零占用) ====
   语义依据: 《甲言_逆向定律库_IR工程预埋全景.md》§12 优先级 (类型宽度第一)
   纪律: IR_PREBED_ACTIVE 未定义 → 结构定义不参与编译 → 产物零影响 → 自举不变 (85af2ba4)
   激活: Phase 7 打开宏 + 引用 → 必须过预埋尺 (v1.4 §7.2) + 差异测试双闸 */
#ifdef IR_PREBED_ACTIVE
/* 1. IR3 三地址码 (v1.4 §2.1, LLVM 值模型定律 §6) — 类型宽度第一优先 */
typedef 构 { 整 op; 整 ty; 整 d; 整 s1; 整 s2; 整 s3; } IR3;
/* ty 编码: 低 8 位类型 (i8=1 i16=2 i32=3 i64=4 u8=5 u16=6 u32=7 u64=8 f32=9 f64=10 ptr=11),
   高 8 位值级属性位 (LAW_LINEAR/SUM/LATTICE) */
#define IR3_CAP 1000000  /* 预埋初始值: 激活前按编译 Git 全量最坏规模实测校准 (2026-08-25 启元审计) */
静 IR3 ir3[IR3_CAP]; 静 整 ir3_n;

/* 2. 块表/CFG (v1.4 §3, LLVM CFG 定律 §7) — 只存 succ 反向算 pred (LLVM 定律 2) */
typedef 构 { 整 start; 整 end; 整 npred; 整 nsucc; 整 preds[8]; 整 succs[8]; } BLK;
#define BLK_CAP 100000  /* 预埋初始值: 激活前按 Git 全量函数数 × 最坏基本块数实测校准 (2026-08-25 启元审计) */
静 BLK blks[BLK_CAP]; 静 整 blk_n;

/* 3. 值级 side-tables (v1.4 §10.1, 逆向定律库 §1-3/§5) */
#define VT_CAP 1000000  /* 预埋初始值: 激活前按编译 Git 全量最坏规模实测校准 (2026-08-25 启元审计) */
静 整 vt_lifetime[VT_CAP];      /* 所有权状态机: 0=普通 1=move后 2=不可变借用 3=可变借用 (int 一次给够, 对齐逆向定律库 §1) */
静 整 vt_lifetime_id[VT_CAP];   /* lifetime 域编号: 0=函数级 1..N=显式 'a 域 */
静 整 vt_tag[VT_CAP];           /* 和类型判别式: 0..N-1 */
静 整 vt_tyvar[VT_CAP];         /* 类型变量编号: 0=非泛型 >0=第 N 个 */
静 整 vt_trunc[VT_CAP];         /* 截断标记: 0=无 1=赋值截断 2=cast 截断 3=扩展 */

/* 4. 类型级 side-tables (逆向定律库 §4, 不内联 stypes — §11.1 冻结) */
#define STYPES_CAP 4096  /* 与 stypes[4096] 对齐; stypes 扩容时同步 (2026-08-25 启元审计) */
静 整 stypes_lo[STYPES_CAP];    /* 范围下界 (-1=无界) */
静 整 stypes_hi[STYPES_CAP];    /* 范围上界 (-1=无界) */
静 整 stypes_super[STYPES_CAP]; /* 父类型 id (-1=无) */

/* 5. 分析结果缓存 (逆向定律库 §8, LLVM NewPM 定律 2) — 任意变换后全失效 (实战定) */
typedef 构 { 整 id; 整 *result; 整 result_n; 整 invalidated; } IR_ANALYSIS;
#define ANALYSIS_CAP 64 /* 预埋初始值: 激活前按 Git 全量 pass/分析类型数实测校准 (2026-08-25 启元审计) */
静 IR_ANALYSIS ir_analysis[ANALYSIS_CAP]; 静 整 analysis_n;
静 整 analysis_store[ANALYSIS_CAP][64]; /* result 指向 store 行 (固定容量, 无 malloc) */

/* 6. loopback 回边标记 (逆向定律库 §11) — 待大哥拍板, 拍板后加进 BLK: int loopback; */
#endif /* IR_PREBED_ACTIVE */

/* ==== -graph 旁路导出 (P0 工具侧闭环: graph_query.py 查询, 2026-08-25) ====
   旁路: 不插桩不影响编译行为, 仅编译完成后遍历 func_tbl/stypes + 调用记录导出 JSON */
静 整 graph_mode = 0; 静 字 graph_out[512] = "";
#define GRAPH_CALLS_CAP 20000
静 字 graph_calls_from[GRAPH_CALLS_CAP][64]; 静 字 graph_calls_to[GRAPH_CALLS_CAP][64]; 静 整 graph_calls_n;
静 空 graph_record_call(常 字 *to) {
    若 (!graph_mode || !cur_fn_name[0] || graph_calls_n >= GRAPH_CALLS_CAP) 返;
    遍 (整 i = 0; i < graph_calls_n; i++) /* 去重: 同一 from→to 只记一次 (防 4000 上限被重复调用占满截断, 2026-08-25) */
        若 (!strcmp(graph_calls_from[i], cur_fn_name) && !strcmp(graph_calls_to[i], to)) 返;
    strcpy(graph_calls_from[graph_calls_n], cur_fn_name);
    strcpy(graph_calls_to[graph_calls_n], to);
    graph_calls_n++;
}
静 空 graph_export(空) {
    若 (!graph_mode || !graph_out[0]) 返;
    FILE *f = fopen(graph_out, "wb");
    若 (!f) { fprintf(stderr, "qcc_x86: cannot write graph %s\n", graph_out); 返; }
    整 first = 1;
    fprintf(f, "{\n\"entities\": [\n");
    遍 (整 i = 0; i < func_n; i++) { 若 (!first) { fprintf(f, ",\n"); } first = 0; fprintf(f, "{\"id\":\"fn:%s\",\"name\":\"%s\",\"kind\":\"function\",\"line\":0}", func_tbl[i].name, func_tbl[i].name); }
    遍 (整 i = 0; i < st_n; i++) {
        若 (!first) { fprintf(f, ",\n"); } first = 0;
        fprintf(f, "{\"id\":\"st:%s\",\"name\":\"%s\",\"kind\":\"struct\",\"line\":0,\"fields\":[", stypes[i].name, stypes[i].name);
        遍 (整 j = 0; j < stypes[i].fn; j++)
            fprintf(f, "\"%s\"%s", stypes[i].fnames[j], j + 1 < stypes[i].fn ? "," : "");
        fprintf(f, "]}");
    }
    fprintf(f, "\n],\n\"relations\": [\n");
    first = 1;
    遍 (整 i = 0; i < graph_calls_n; i++) { 若 (!first) { fprintf(f, ",\n"); } first = 0; fprintf(f, "{\"from\":\"fn:%s\",\"to\":\"fn:%s\",\"kind\":\"calls\"}", graph_calls_from[i], graph_calls_to[i]); }
    fprintf(f, "\n],\n\"layout_sensitive\": [\n");
    first = 1;
    遍 (整 i = 0; i < st_n; i++) {
        若 (!first) { fprintf(f, ",\n"); } first = 0;
        常 字 *risk; /* risk 阈值 (2026-08-25 审计定): 字段≥8 或 大小≥64 = high; 字段≥4 或 大小≥32 = medium; 否则 low */
        若 (stypes[i].fn >= 8 || stypes[i].sz >= 64) risk = "high";
        否 若 (stypes[i].fn >= 4 || stypes[i].sz >= 32) risk = "medium";
        否 risk = "low";
        fprintf(f, "{\"type\":\"st:%s\",\"name\":\"%s\",\"fields\":%d,\"risk\":\"%s\"}", stypes[i].name, stypes[i].name, stypes[i].fn, risk);
    }
    fprintf(f, "\n]\n}\n");
    fclose(f);
    fprintf(stderr, "[graph] %s 导出完成 (fn:%d st:%d calls:%d)\n", graph_out, func_n, st_n, graph_calls_n);
}

/* ==== Phase 4 哈希审判: SHA-256 自举自证 (编译器编译完自动算产物哈希对账不动点, fail-closed; 补记13 法官上岗) ==== */
静 无 整 sha256_k[64] = {0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
静 无 整 sha256_rotr(无 整 x, 整 n) { 返 (x >> n) | (x << (32 - n)); }
静 空 sha256_block(无 整 h[8], 常 无 字 *p) {
    无 整 w[64], a, b, c, d, e, f, g, hh, i, t1, t2;
    遍 (i = 0; i < 16; i++) w[i] = ((无 整)p[i*4] << 24) | ((无 整)p[i*4+1] << 16) | ((无 整)p[i*4+2] << 8) | p[i*4+3];
    遍 (i = 16; i < 64; i++) w[i] = w[i-16] + (sha256_rotr(w[i-15], 7) ^ sha256_rotr(w[i-15], 18) ^ (w[i-15] >> 3)) + w[i-7] + (sha256_rotr(w[i-2], 17) ^ sha256_rotr(w[i-2], 19) ^ (w[i-2] >> 10));
    a = h[0]; b = h[1]; c = h[2]; d = h[3]; e = h[4]; f = h[5]; g = h[6]; hh = h[7];
    遍 (i = 0; i < 64; i++) {
        t1 = hh + (sha256_rotr(e, 6) ^ sha256_rotr(e, 11) ^ sha256_rotr(e, 25)) + ((e & f) ^ (~e & g)) + sha256_k[i] + w[i];
        t2 = (sha256_rotr(a, 2) ^ sha256_rotr(a, 13) ^ sha256_rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
        hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
    }
    h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
}
静 空 sha256_file(常 字 *path, 字 out[65]) {
    无 整 h[8]; 无 字 buf[64], pad[128]; 整 i, j, n, pn;
    无 长 长 total = 0, bits; FILE *f = fopen(path, "rb");
    h[0]=0x6a09e667; h[1]=0xbb67ae85; h[2]=0x3c6ef372; h[3]=0xa54ff53a; h[4]=0x510e527f; h[5]=0x9b05688c; h[6]=0x1f83d9ab; h[7]=0x5be0cd19;
    若 (!f) { out[0] = 0; 返; }
    循环 ((n = (整)fread(buf, 1, 64, f)) == 64) { sha256_block(h, buf); total += 64; }
    memcpy(pad, buf, n); pn = n; pad[pn++] = 0x80;
    循环 ((pn & 63) != 56) pad[pn++] = 0;
    bits = (total + (无 长 长)n) * 8;
    遍 (i = 0; i < 8; i++) pad[pn++] = (无 字)(bits >> (56 - 8 * i));
    遍 (i = 0; i < pn; i += 64) sha256_block(h, pad + i);
    fclose(f);
    遍 (i = 0; i < 8; i++) 遍 (j = 0; j < 4; j++) {
        无 整 b8 = (h[i] >> (24 - 8 * j)) & 0xFF;
        out[i * 8 + j * 2] = "0123456789abcdef"[b8 >> 4];
        out[i * 8 + j * 2 + 1] = "0123456789abcdef"[b8 & 15];
    }
    out[64] = 0;
}


整 main(整 argc, 字 **argv) {
    常 字 *src = "int main() { return 42; }";
    常 字 *outf = NULL;
    整 argi = 1;
    整 asm_mode = 0;
    字 *hdrs = NULL; 整 hdr_len = 0, hdr_cap = 0;
    字 *all_src = NULL; 整 all_len = 0;
    整 is_compat_stat_c = 0;

    /* fix 2026-08-10 Gate 9: ������ "__bare__" ��Ǳ������������ */
    遍 (整 bi = 1; bi < argc; bi++) { 若 (argv[bi] && !strcmp(argv[bi], "__bare__")) { bare_metal = 1; 断; } }
    循环 (argc > argi) {
        若 (strcmp(argv[argi], "--help") == 0) {
            printf("甲言 qcc_x86 v5.0 · 铸基 郑宇和 · 自举 郑启元 · 审计 郑启灵 · 种子 828\nUsage: qcc_x86 [-S] [-I header.h] [-o out.exe] file.c [file2.c ...]\n  -S  output asm text\n");
            返 0;
        }
        若 (strcmp(argv[argi], "--test") == 0) { printf("qcc_x86 selftest PASS · 铸基 郑宇和 · 自举 郑启元 · 审计 郑启灵 · 种子 828\n"); 返 0; }
        若 (strcmp(argv[argi], "-S") == 0) { asm_mode = 1; argi++; 续; }
        若 (strcmp(argv[argi], "-c") == 0) { coff_mode = 1; argi++; 续; }
        若 (strcmp(argv[argi], "-bin") == 0) { bin_mode = 1; argi++; 续; } /* fix 2026-08-08: 裸二进制 (内核) */
        若 (strcmp(argv[argi], "-o") == 0 && argc > argi + 1) { outf = argv[argi + 1]; argi += 2; 续; }
        若 (strcmp(argv[argi], "-D") == 0 && argc > argi + 1) { /* -D NAME=VALUE (fix 2026-08-13: Git 编译需要 C99 环境宏 __STDC_VERSION__ 等) */
            常 字 *dp = argv[argi + 1]; 常 字 *eq = dp;
            循环 (*eq && *eq != '=') eq++;
            若 (eq > dp && eq - dp < 32) {
                字 nm[64]; 整 dl = (整)(eq - dp);
                memcpy(nm, dp, dl); nm[dl] = 0;
                若 (*eq == '=') macro_add(nm, atoi(eq + 1)); 否 macro_add(nm, 1);
            }
            argi += 2; 续;
        }
        若 (strcmp(argv[argi], "--selfcheck") == 0 && argc > argi + 1) { strncpy(selfcheck_sha, argv[argi + 1], 64); selfcheck_sha[64] = 0; argi += 2; 续; }
若 (strcmp(argv[argi], "-graph") == 0 && argc > argi + 1) { graph_mode = 1; strncpy(graph_out, argv[argi + 1], 511); graph_out[511] = 0; argi += 2; 续; } /* -graph 旁路导出 (P0 工具侧) */
        若 (strcmp(argv[argi], "-I") == 0 && argc > argi + 1) {
            字 *hb = read_file(argv[argi + 1]);
            若 (hb) {
                整 hl = (整)strlen(hb);
                若 (hdr_len + hl + 2 >= hdr_cap) { hdr_cap = hdr_len + hl + 4096; hdrs = realloc(hdrs, hdr_cap); }
                memcpy(hdrs + hdr_len, hb, hl); hdr_len += hl;
                hdrs[hdr_len++] = '\n'; hdrs[hdr_len] = 0;
                free(hb);
            }
            argi += 2; 续;
        }
        /* input file */
        字 *fb = read_file(argv[argi]);
        若 (!fb) { fprintf(stderr, "qcc_x86: cannot open %s\n", argv[argi]); 返 1; }
        dir_of_path(argv[argi], g_src_dir, 大小(g_src_dir)); /* fix 2026-08-13 Phase3: 记录源文件目录, 供子目录 #include 相对搜索 */
        { 常 字 *pp2 = argv[argi];
          若 (strstr(pp2, "compat/stat.c") || strstr(pp2, "compat\\stat.c")) is_compat_stat_c = 1; }
        整 fl = (整)strlen(fb);
        all_src = realloc(all_src, (all_len + fl + 5) & ~3); /* fix 2026-08-12 UB-cleanup: realloc is a REAL bump alloc (not no-op)! all_len+fl+2 non-4-multiple -> tt..tll misaligned -> tll[tk] garbage -> spurious nll=1; +5=(needed+3)&~3: +4 under-allocates 1 byte when (all_len+fl)%4==3 -> all_src[all_len]=0 OOB */
        memcpy(all_src + all_len, fb, fl); all_len += fl;
        all_src[all_len++] = '\n'; all_src[all_len] = 0;
        free(fb);
        argi++;
    }
    若 (is_compat_stat_c) macro_add("QCC_COMPAT_STAT_C", 1); /* compat/stat.c 禁用 prelude 的 stat/lstat/fstat 自映射 */
    若 (all_len > 0) {
        整 total = hdr_len + all_len + 2;
        字 *combined = malloc((total + 3) & ~3); /* fix 2026-08-11 BLOCKER-3: round to 4 */
        整 pos = 0;
        若 (hdr_len > 0) { memcpy(combined, hdrs, hdr_len); pos = hdr_len; }
        memcpy(combined + pos, all_src, all_len); pos += all_len;
        combined[pos] = 0;
        src = combined;
        free(all_src);
    }
    free(hdrs);
    若 (!outf) {
        静 字 of[512]; strcpy(of, "a.exe"); outf = of;
    }

    若 (asm_mode) {
        字 af[512]; strcpy(af, outf);
        strcat(af, ".asm"); /* fix 2026-08-05: was stripping ".exe" then appending → `qcc -S f.c` wrote a.asm but printed a.exe.asm (misleading); now always outf+".asm" */
        strcpy(asm_name, af); /* fix 2026-08-06: 最终代越界重稳定时需截断重开 asm 文件 */
        asm_out = fopen(af, "wb");
    }

    /* prepend the self-host runtime (qcc_rt.c): heap realloc, fseek/ftell/rewind,
       exit/abort, strcpy/strncmp/isdigit/isalpha shadow the broken inline stubs.
       Every compiled program gets it, so stage2 is self-contained.
       NOTE: copy from src (the combined buffer), NOT all_src �?all_src is already
       free()d by the combined block above (use-after-free). */
    若 (!coff_mode)
    {
        字 *rtb = read_file("srclib/qcc_rt.c");
        若 (!rtb) rtb = read_file("qcc_rt.c");
        若 (!rtb && argc > 1) { /* cwd 无关: 基于源码路径推导运行时 (fix 2026-08-05: 原相对 cwd, 非根目录编译静默缺运行时) */
            字 sp[1024];
            strncpy(sp, argv[1], 1023); sp[1023] = 0;
            字 *sl = strrchr(sp, '/');
            字 *bs = strrchr(sp, '\\');
            字 *last = sl && bs ? (sl > bs ? sl : bs) : (sl ? sl : bs);
            若 (last) {
                *last = 0;
                strcat(sp, "/srclib/qcc_rt.c");
                rtb = read_file(sp);
            }
        }
        若 (!rtb && argc > 0) { /* fix 2026-08-26: 从编译器自身路径推导 — rt 在编译器目录不在源码目录; 原从 argv[1](源码) 推导 → 语料目录编译时 rt 静默缺失 → strncmp/strcspn/strspn/strdup 未定义恒 0/崩 (diff_gate strlib/math 85 差异) */
            字 sp[1024];
            strncpy(sp, argv[0], 1023); sp[1023] = 0;
            字 *sl = strrchr(sp, '/');
            字 *bs = strrchr(sp, '\\');
            字 *last = sl && bs ? (sl > bs ? sl : bs) : (sl ? sl : bs);
            若 (last) {
                *last = 0;
                字 sp2[1024];
                strcpy(sp2, sp); strcat(sp2, "/srclib/qcc_rt.c");
                rtb = read_file(sp2);
                若 (!rtb) { strcpy(sp2, sp); strcat(sp2, "/qcc_rt.c"); rtb = read_file(sp2); }
            }
        }
        若 (rtb) {
            整 rl = (整)strlen(rtb);
            整 al = (整)strlen(src);
            macro_add("QCC_RT_PREPENDED", 1); /* 修复 2026-08-25: 标记 rt 已预置 — qcc_rt.c 守卫改为认此宏而非 __GNUC__ (diff_gate -D __GNUC__=5 曾把 rt 实现全部剃光 → strcspn/strspn/strncmp/strdup 恒返 0) */
            rt_line_skip = 1; 遍 (整 rk = 0; rk < rl; rk++) 若 (rtb[rk] == '\n') rt_line_skip++; /* fix 2026-08-06 Task 5.3: 行号校正 */
            字 *combined2 = malloc((rl + al + 5) & ~3); /* fix 2026-08-11 BLOCKER-3: round to 4 — rl+al+2 misaligned the bump counter -> tt..tll misaligned -> tll[tk] reads garbage -> spurious nll=1 -> 2-cycle */
            memcpy(combined2, rtb, rl);
            combined2[rl] = '\n';
            memcpy(combined2 + rl + 1, src, al);
            combined2[rl + 1 + al] = 0;
            src = combined2;
            free(rtb);
        }
    }

    /* ????????*/
    tt = calloc(TS, 4); tv = calloc(TS, 4); tn = calloc(TS, 64); nn = calloc(ASZ, 64);
    tuns = calloc(TS, 4); /* unsigned-suffix flags (fix 2026-08-05) */
    tll = calloc(TS, 4); /* long-long-suffix flags (fix 2026-08-05) */
    tll_hi = calloc(TS, 4); /* long-long literal high 32 bits (fix 2026-08-05) */
    nt = _va_alloc(ASZ * 4); nv = _va_alloc(ASZ * 4); n0 = _va_alloc(ASZ * 4); n1 = _va_alloc(ASZ * 4);
    遍 (整 xi = 0; xi < 256; xi++) nx[xi] = _va_alloc(ASZ * 4); /* 扩展子槽 n256..n511 (fix 2026-08-18: 大型函数体 > 256 语句) */
    nchain = _va_alloc(ASZ * 4); 遍 (整 ci = 0; ci < ASZ; ci++) nchain[ci] = -1; /* 溢出链指针 (fix 2026-08-18) */
    n2 = _va_alloc(ASZ * 4); n3 = _va_alloc(ASZ * 4); n4 = _va_alloc(ASZ * 4); n5 = _va_alloc(ASZ * 4);
    n6 = _va_alloc(ASZ * 4); n7 = _va_alloc(ASZ * 4); n8 = _va_alloc(ASZ * 4); n9 = _va_alloc(ASZ * 4);
    n10 = _va_alloc(ASZ * 4); n11 = _va_alloc(ASZ * 4); n12 = _va_alloc(ASZ * 4); n13 = _va_alloc(ASZ * 4);
    n14 = _va_alloc(ASZ * 4); n15 = _va_alloc(ASZ * 4); n16 = _va_alloc(ASZ * 4); n17 = _va_alloc(ASZ * 4);
    n18 = _va_alloc(ASZ * 4); n19 = _va_alloc(ASZ * 4);
    n20 = _va_alloc(ASZ * 4); n21 = _va_alloc(ASZ * 4); n22 = _va_alloc(ASZ * 4); n23 = _va_alloc(ASZ * 4); n24 = _va_alloc(ASZ * 4); n25 = _va_alloc(ASZ * 4); n26 = _va_alloc(ASZ * 4); n27 = _va_alloc(ASZ * 4);
    n28 = _va_alloc(ASZ * 4); n29 = _va_alloc(ASZ * 4); n30 = _va_alloc(ASZ * 4); n31 = _va_alloc(ASZ * 4); n32 = _va_alloc(ASZ * 4); n33 = _va_alloc(ASZ * 4); n34 = _va_alloc(ASZ * 4); n35 = _va_alloc(ASZ * 4);
    n36 = _va_alloc(ASZ * 4); n37 = _va_alloc(ASZ * 4); n38 = _va_alloc(ASZ * 4); n39 = _va_alloc(ASZ * 4); n40 = _va_alloc(ASZ * 4); n41 = _va_alloc(ASZ * 4); n42 = _va_alloc(ASZ * 4); n43 = _va_alloc(ASZ * 4);
    n44 = _va_alloc(ASZ * 4); n45 = _va_alloc(ASZ * 4); n46 = _va_alloc(ASZ * 4); n47 = _va_alloc(ASZ * 4); n48 = _va_alloc(ASZ * 4); n49 = _va_alloc(ASZ * 4); n50 = _va_alloc(ASZ * 4); n51 = _va_alloc(ASZ * 4);
    n52 = _va_alloc(ASZ * 4); n53 = _va_alloc(ASZ * 4); n54 = _va_alloc(ASZ * 4); n55 = _va_alloc(ASZ * 4); n56 = _va_alloc(ASZ * 4); n57 = _va_alloc(ASZ * 4); n58 = _va_alloc(ASZ * 4); n59 = _va_alloc(ASZ * 4);
    n60 = _va_alloc(ASZ * 4); n61 = _va_alloc(ASZ * 4); n62 = _va_alloc(ASZ * 4); n63 = _va_alloc(ASZ * 4); n64 = _va_alloc(ASZ * 4); n65 = _va_alloc(ASZ * 4); n66 = _va_alloc(ASZ * 4); n67 = _va_alloc(ASZ * 4);
    n68 = _va_alloc(ASZ * 4); n69 = _va_alloc(ASZ * 4); n70 = _va_alloc(ASZ * 4); n71 = _va_alloc(ASZ * 4); n72 = _va_alloc(ASZ * 4); n73 = _va_alloc(ASZ * 4); n74 = _va_alloc(ASZ * 4); n75 = _va_alloc(ASZ * 4);
    n76 = _va_alloc(ASZ * 4); n77 = _va_alloc(ASZ * 4); n78 = _va_alloc(ASZ * 4); n79 = _va_alloc(ASZ * 4); n80 = _va_alloc(ASZ * 4); n81 = _va_alloc(ASZ * 4); n82 = _va_alloc(ASZ * 4); n83 = _va_alloc(ASZ * 4);
    n84 = _va_alloc(ASZ * 4); n85 = _va_alloc(ASZ * 4); n86 = _va_alloc(ASZ * 4); n87 = _va_alloc(ASZ * 4); n88 = _va_alloc(ASZ * 4); n89 = _va_alloc(ASZ * 4); n90 = _va_alloc(ASZ * 4); n91 = _va_alloc(ASZ * 4);
    n92 = _va_alloc(ASZ * 4); n93 = _va_alloc(ASZ * 4); n94 = _va_alloc(ASZ * 4); n95 = _va_alloc(ASZ * 4); n96 = _va_alloc(ASZ * 4); n97 = _va_alloc(ASZ * 4); n98 = _va_alloc(ASZ * 4); n99 = _va_alloc(ASZ * 4);
    n100 = _va_alloc(ASZ * 4); n101 = _va_alloc(ASZ * 4); n102 = _va_alloc(ASZ * 4); n103 = _va_alloc(ASZ * 4); n104 = _va_alloc(ASZ * 4); n105 = _va_alloc(ASZ * 4); n106 = _va_alloc(ASZ * 4); n107 = _va_alloc(ASZ * 4);
    n108 = _va_alloc(ASZ * 4); n109 = _va_alloc(ASZ * 4); n110 = _va_alloc(ASZ * 4); n111 = _va_alloc(ASZ * 4); n112 = _va_alloc(ASZ * 4); n113 = _va_alloc(ASZ * 4); n114 = _va_alloc(ASZ * 4); n115 = _va_alloc(ASZ * 4);
    n116 = _va_alloc(ASZ * 4); n117 = _va_alloc(ASZ * 4); n118 = _va_alloc(ASZ * 4); n119 = _va_alloc(ASZ * 4); n120 = _va_alloc(ASZ * 4); n121 = _va_alloc(ASZ * 4); n122 = _va_alloc(ASZ * 4); n123 = _va_alloc(ASZ * 4);
    n124 = _va_alloc(ASZ * 4); n125 = _va_alloc(ASZ * 4); n126 = _va_alloc(ASZ * 4); n127 = _va_alloc(ASZ * 4); n128 = _va_alloc(ASZ * 4); n129 = _va_alloc(ASZ * 4); n130 = _va_alloc(ASZ * 4); n131 = _va_alloc(ASZ * 4);
    n132 = _va_alloc(ASZ * 4); n133 = _va_alloc(ASZ * 4); n134 = _va_alloc(ASZ * 4); n135 = _va_alloc(ASZ * 4); n136 = _va_alloc(ASZ * 4); n137 = _va_alloc(ASZ * 4); n138 = _va_alloc(ASZ * 4); n139 = _va_alloc(ASZ * 4);
    n140 = _va_alloc(ASZ * 4); n141 = _va_alloc(ASZ * 4); n142 = _va_alloc(ASZ * 4); n143 = _va_alloc(ASZ * 4); n144 = _va_alloc(ASZ * 4); n145 = _va_alloc(ASZ * 4); n146 = _va_alloc(ASZ * 4); n147 = _va_alloc(ASZ * 4);
    n148 = _va_alloc(ASZ * 4); n149 = _va_alloc(ASZ * 4); n150 = _va_alloc(ASZ * 4); n151 = _va_alloc(ASZ * 4); n152 = _va_alloc(ASZ * 4); n153 = _va_alloc(ASZ * 4); n154 = _va_alloc(ASZ * 4); n155 = _va_alloc(ASZ * 4);
    n156 = _va_alloc(ASZ * 4); n157 = _va_alloc(ASZ * 4); n158 = _va_alloc(ASZ * 4); n159 = _va_alloc(ASZ * 4); n160 = _va_alloc(ASZ * 4); n161 = _va_alloc(ASZ * 4); n162 = _va_alloc(ASZ * 4); n163 = _va_alloc(ASZ * 4);
    n164 = _va_alloc(ASZ * 4); n165 = _va_alloc(ASZ * 4); n166 = _va_alloc(ASZ * 4); n167 = _va_alloc(ASZ * 4); n168 = _va_alloc(ASZ * 4); n169 = _va_alloc(ASZ * 4); n170 = _va_alloc(ASZ * 4); n171 = _va_alloc(ASZ * 4);
    n172 = _va_alloc(ASZ * 4); n173 = _va_alloc(ASZ * 4); n174 = _va_alloc(ASZ * 4); n175 = _va_alloc(ASZ * 4); n176 = _va_alloc(ASZ * 4); n177 = _va_alloc(ASZ * 4); n178 = _va_alloc(ASZ * 4); n179 = _va_alloc(ASZ * 4);
    n180 = _va_alloc(ASZ * 4); n181 = _va_alloc(ASZ * 4); n182 = _va_alloc(ASZ * 4); n183 = _va_alloc(ASZ * 4); n184 = _va_alloc(ASZ * 4); n185 = _va_alloc(ASZ * 4); n186 = _va_alloc(ASZ * 4); n187 = _va_alloc(ASZ * 4);
    n188 = _va_alloc(ASZ * 4); n189 = _va_alloc(ASZ * 4); n190 = _va_alloc(ASZ * 4); n191 = _va_alloc(ASZ * 4); n192 = _va_alloc(ASZ * 4); n193 = _va_alloc(ASZ * 4); n194 = _va_alloc(ASZ * 4); n195 = _va_alloc(ASZ * 4);
    n196 = _va_alloc(ASZ * 4); n197 = _va_alloc(ASZ * 4); n198 = _va_alloc(ASZ * 4); n199 = _va_alloc(ASZ * 4); n200 = _va_alloc(ASZ * 4); n201 = _va_alloc(ASZ * 4); n202 = _va_alloc(ASZ * 4); n203 = _va_alloc(ASZ * 4);
    n204 = _va_alloc(ASZ * 4); n205 = _va_alloc(ASZ * 4); n206 = _va_alloc(ASZ * 4); n207 = _va_alloc(ASZ * 4); n208 = _va_alloc(ASZ * 4); n209 = _va_alloc(ASZ * 4); n210 = _va_alloc(ASZ * 4); n211 = _va_alloc(ASZ * 4);
    n212 = _va_alloc(ASZ * 4); n213 = _va_alloc(ASZ * 4); n214 = _va_alloc(ASZ * 4); n215 = _va_alloc(ASZ * 4); n216 = _va_alloc(ASZ * 4); n217 = _va_alloc(ASZ * 4); n218 = _va_alloc(ASZ * 4); n219 = _va_alloc(ASZ * 4);
    n220 = _va_alloc(ASZ * 4); n221 = _va_alloc(ASZ * 4); n222 = _va_alloc(ASZ * 4); n223 = _va_alloc(ASZ * 4); n224 = _va_alloc(ASZ * 4); n225 = _va_alloc(ASZ * 4); n226 = _va_alloc(ASZ * 4); n227 = _va_alloc(ASZ * 4);
    n228 = _va_alloc(ASZ * 4); n229 = _va_alloc(ASZ * 4); n230 = _va_alloc(ASZ * 4); n231 = _va_alloc(ASZ * 4); n232 = _va_alloc(ASZ * 4); n233 = _va_alloc(ASZ * 4); n234 = _va_alloc(ASZ * 4); n235 = _va_alloc(ASZ * 4);
    n236 = _va_alloc(ASZ * 4); n237 = _va_alloc(ASZ * 4); n238 = _va_alloc(ASZ * 4); n239 = _va_alloc(ASZ * 4); n240 = _va_alloc(ASZ * 4); n241 = _va_alloc(ASZ * 4); n242 = _va_alloc(ASZ * 4); n243 = _va_alloc(ASZ * 4);
    n244 = _va_alloc(ASZ * 4); n245 = _va_alloc(ASZ * 4); n246 = _va_alloc(ASZ * 4); n247 = _va_alloc(ASZ * 4); n248 = _va_alloc(ASZ * 4); n249 = _va_alloc(ASZ * 4); n250 = _va_alloc(ASZ * 4); n251 = _va_alloc(ASZ * 4);
    n252 = _va_alloc(ASZ * 4); n253 = _va_alloc(ASZ * 4); n254 = _va_alloc(ASZ * 4); n255 = _va_alloc(ASZ * 4);

    code = malloc(CODE_BUF_CAP); /* 4MB pre-alloc: self-host never reallocs (kills the bump-leak) */ 若 (!code) { fprintf(stderr, "qcc_x86: OOM at init\n"); 返 1; } cp = 0; lc = 0;
    sdc = 256; sdat = malloc(sdc); sdp = 0; strpn = 0;
    memset(str_offs, -1, 大小(str_offs));

    整 root = parse(src); /* fn_macro 收集+展开已在 parse 内 include 展开之后执行 (fix 2026-08-07: 头文件函数宏可见) */
    若 (root < 0) { fprintf(stderr, "qcc_x86: parse failed\n"); 返 1; }
    root_global = root;


    /* two-pass generation: pass 1 estimates text size �?.data base; pass 2 real */
    g_lc_save = lc; g_rsp_save = rsp_used;
    data_rva_base = 0x2000;
    若 (bin_mode) {
        /* -bin 模式: 裸二进制 (内核). data_rva_base 动态=代码后对齐 (RIP 相对 disp 位置无关),
           迭代稳定 (数据紧跟代码, 任意加载基址正确) */
        data_rva_base = 0x2000;
        遍 (整 it = 0; it < 8; it++) {
            asm_pass = 2;
            gen_final = (it == 7);
            gen_code();
            gen_final = 0;
            整 nb = (0x1000 + cp + 4095) & ~4095;
            若 (nb < 0x2000) nb = 0x2000;
            若 (nb == data_rva_base) 断;
            data_rva_base = nb;
        }
        asm_pass = 0;
    } 否 若 (coff_mode) {
        /* -c 模式：对象可重定位，只跑 pass 2（避免重定位/数据重复记录） */
        asm_pass = 2;
        gen_code();
        asm_pass = 0;
    } 否 {
        asm_pass = 1;
        gen_code();
        data_rva_base = (0x1000 + cp + 4095) & ~4095;
        若 (data_rva_base < 0x2000) data_rva_base = 0x2000;
        asm_pass = 2;
        gen_final = 0;
        gen_code();
        /* fix 2026-08-05: pass-2 code can GROW past the pass-1 estimate (data-ref
           encodings shift with the .data base), rounding text past data_rva_base →
           .text/.data overlap → ERROR_BAD_EXE_FORMAT 193. Recompute the base from
           the pass-2 cp and re-generate until stable. Intermediate passes are
           silent (gen_final=0) so the -S asm file holds exactly one code copy. */
        遍 (整 it = 0; it < 8; it++) {
            整 nb = (0x1000 + cp + 4095) & ~4095;
            若 (nb < 0x2000) nb = 0x2000;
            若 (nb == data_rva_base) 断;
            data_rva_base = nb;
            gen_code();
        }
        若 (asm_name[0]) { /* fix 2026-08-24 Phase2: -S 模式需要 final (写 asm 文本) — gen_final=1 时 asm_emit 才写 */
            gen_final = 1;
            gen_code();
            gen_final = 0;
            遍 (整 it = 0; it < 8; it++) {
                整 nb = (0x1000 + cp + 4095) & ~4095;
                若 (nb < 0x2000) nb = 0x2000;
                若 (nb == data_rva_base) 断;
                data_rva_base = nb;
                gen_code();
                gen_final = 1;
                若 (asm_out) { fclose(asm_out); asm_out = fopen(asm_name, "wb"); }
                gen_code();
                gen_final = 0;
            }
        } 否 {
            /* fix 2026-08-24 Phase2 (飞轮提速): 非 -S 模式跳过 final — pass2 稳定代即可写 exe,
               gen_final 仅影响 -S 文本, 不影响机器码正确性. 省 1/3 gen_code 时间.
               实验: 跳过 final 产物能自举, 自举不动点收敛到同一值. */
        }
        asm_pass = 0;
    }

    /* ??PE / COFF 对象 */
    /* fix 2026-08-10 Gate 9: �������������ڴ� (���ļ�ϵͳ) */
    整 bin_out_len = 0;
    无 字 *ob = (无 字*)BIN_OUT_ADDR;
    整 oi = 0;
    若 (bare_metal) {
        若 (bin_hdr_n > 0) {
            memcpy(ob, bin_hdr, bin_hdr_n); oi = bin_hdr_n;
        } 否 {
            整 code_off = 0x1000;
            若 (oi < code_off) { memset(ob+oi, 0, code_off-oi); oi = code_off; }
            memcpy(ob+oi, code, cp); oi += cp;
            若 (oi < data_rva_base) { memset(ob+oi, 0, data_rva_base-oi); oi = data_rva_base; }
            /* heap counter / IAT stub / ��̬�� */
            *(整*)(ob+oi) = 0; oi += 4;
            *(整*)(ob+oi) = 0; oi += 4;
            整 stub_off = data_rva_base + 0x300 + 4 + 4 * stc_n;
            整 stub_va = 0x100000 + stub_off;
            遍 (整 i = 8; i < 0x300; i += 8) { *(整*)(ob+oi) = stub_va; *(整*)(ob+oi+4) = 0; oi += 8; }
            遍 (整 i = 0; i < stc_n; i++) { *(整*)(ob+oi) = 0; oi += 4; }
            ob[oi++] = 0xEB; ob[oi++] = 0xFE;
        }
        bin_out_len = oi;
        *(整*)BIN_OUT_LEN_ADDR = bin_out_len;
        printf("OK: bin -> mem (code=%d out=%d)\n", cp, bin_out_len);
    } 否 {
        FILE *f = fopen(outf, "wb");
        若 (!f) { fprintf(stderr, "qcc_x86: cannot write %s\n", outf); 返 1; }
        若 (bin_mode) {
            若 (bin_hdr_n > 0) {
                fwrite(bin_hdr, 1, bin_hdr_n, f);
            } 否 {
                整 code_off = 0x1000;
                整 cur = 0;
                若 (cur < code_off) { 遍 (整 i = cur; i < code_off; i++) fputc(0, f); cur = code_off; }
                fwrite(code, 1, cp, f);
                cur += cp;
                若 (cur < data_rva_base) { 遍 (整 i = cur; i < data_rva_base; i++) fputc(0, f); }
                /* .data: heap counter / IAT / ��̬�� */
                w4(f, 0); w4(f, 0);
                整 stub_off2 = data_rva_base + 0x300 + 4 + 4 * stc_n;
                整 stub_va2 = 0x100000 + stub_off2;
                遍 (整 i = 8; i < 0x300; i += 8) { w4(f, stub_va2); w4(f, 0); }
                遍 (整 i = 0; i < stc_n; i++) w4(f, 0);
                fputc(0xEB, f); fputc(0xFE, f);
            }
        } 否 若 (coff_mode) {
            write_coff_obj(f);
        } 否 {
            write_pe(f, entry_rva_global);
        }
        若 (fflush(f) != 0 || ferror(f)) { fprintf(stderr, "qcc_x86: I/O error writing %s (disk full? handle lost?)\n", outf); fclose(f); 返 1; } /* fix 2026-08-11 QA-1: fwrite 不检查返回值 → v2 截断静默成功 */
        fclose(f);
    }

    若 (asm_out) { fclose(asm_out); asm_out = NULL; }
    若 (graph_mode) graph_export(); /* -graph 旁路导出 (产物写完后, 2026-08-25) */

    若 (asm_mode) { printf("OK: %s + %s.asm (%d bytes code)\n", outf, outf, cp); } 否 { printf("OK: %s (%d bytes code)\n", outf, cp); }
    若 (selfcheck_sha[0]) { /* Phase4 哈希审判: 编译产物 SHA256 对账不动点, fail-closed */
        字 sh[65]; sha256_file(outf, sh);
        若 (strcmp(sh, selfcheck_sha) != 0) {
            fprintf(stderr, "[SELFCHECK] FAIL: %s != %s (不动点对账失败, 哈希审判 fail-closed)\n", sh, selfcheck_sha);
            返 1;
        }
        fprintf(stderr, "[SELFCHECK] OK: %s\n", sh);
    }
    若 (expect_sha[0]) { /* #expect 源码内期望原语: 产物哈希对账 (Phase4), 与 --selfcheck 同级 */
        字 eh[65]; sha256_file(outf, eh);
        若 (strcmp(eh, expect_sha) != 0) {
            fprintf(stderr, "[EXPECT] FAIL: %s != %s (期望原语对账失败)\n", eh, expect_sha);
            返 1;
        }
        fprintf(stderr, "[EXPECT] OK: %s\n", eh);
    }
    返 0;
}
