静 空 budget_fail(常 字 *tbl, 整 cap) { fprintf(stderr, "[ERR] A5001 资源护栏: 表 '%s' 满 (容量 %d), 编译确定性拒绝 — 请扩容对应容量宏 (可吞清单 P0-9b, AI原生 #9b)\n", tbl, cap); exit(1); } /* 接入 2026-08-28 资源护栏: 超限走确定性降级 — 替代静默丢弃/满员返-1 (历史教训: sqlite 对象宏 2048 静默丢 → parse 断链; 镜像 func_n 静默残留 → extern 报错) */
静 整 parse_depth = 0; /* 资源护栏 9b (2026-08-28): 表达式/块递归深度 — 防深嵌套栈溢出 0xC0000005, 超限 A5001 确定性拒绝 */
静 空 macro_add_full(常 字 *n, 整 v, 整 uns, 整 ll, 整 ll_hi) { 若 (macro_n < 4096) { strcpy(macros[macro_n].name, n); macros[macro_n].val = v; macro_uns[macro_n] = (字)uns; macro_ll[macro_n] = (字)ll; macro_ll_hi[macro_n] = ll_hi; macro_n++; } 否 budget_fail("宏表 macros", 4096); } /* fix 2026-08-15: 上限 1024→4096 对齐数组容量 — fsmonitor--daemon.c 头链数值宏超 1024, SIMPLE_IPC_QUIT 被丢 → undefined; 2026-08-28 资源护栏: 满→确定性拒绝 (原静默丢弃) */
静 空 macro_add(常 字 *n, 整 v) { macro_add_full(n, v, 0, 0, 0); }
