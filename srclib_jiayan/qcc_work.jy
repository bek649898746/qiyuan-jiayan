静 整 pm_tokenize(常 字 *s, 整 at); /* fwd: 生成代码 token 化 */
静 整 fn_tco_label[8192]; /* 接入 2026-08-29 P2 #152 TCO (重试): 每函数参数复制点标签 (尾递归 jmp 目标, 跳过 prologue 栈分配) */
静 字 cur_fn_tco[65536]; /* #152 TCO: 当前函数是否显式 尾调用优化; (qcc 自身源码不用 → 自举不触发 TCO → 收敛稳定) */
静 整 ctfe_call(常 字 *fname, 整 *out); /* fwd: 编译期 f(常量...) 求值 (定义在 const_expr 区, prim 需前向) */
静 整 *tuns; /* per-token unsigned-suffix flag (0xFFFFFFFFu) — fix 2026-08-05 */
