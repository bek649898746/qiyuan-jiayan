    若 (tt[tk] == VR && !strcmp(tn[tk], "均值")) { /* 接入 2026-08-28 均值 (mean): 均值 m, arr, n; → { __sn=n; __sm=0; __si=0; while(__si<__sn){ __sm+=arr[__si]; __si++; } m=__sm/__sn; } — 复用求和 + 除法, n 存内部变量防多父 */
