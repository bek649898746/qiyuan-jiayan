          整 v_hi = Nd(1); memcpy((字*)(nn + v_hi), hiname, 32);
          整 c1 = Nd(2); nv[c1] = T_LK; Nc(c1, add1); Nc(c1, v_hi); /* < __sl_hi */
          { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
