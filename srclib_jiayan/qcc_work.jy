        若 (tt[tk] == CK) tk++; /* , */
        整 e_nb = expr(); /* b 长度 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 mg_seq = 0; 字 iname[64]; sprintf(iname, "__mi_%d_", mg_seq++);
        静 整 mg_seq2 = 0; 字 jname[64]; sprintf(jname, "__mj_%d_", mg_seq2++);
        静 整 mg_seq3 = 0; 字 kname[64]; sprintf(kname, "__mk_%d_", mg_seq3++);
        var_offset(iname); var_offset(jname); var_offset(kname); /* 三指针 */
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __mi = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), jname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __mj = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), kname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __mk = 0; */
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_a = Nd(1); memcpy((字*)(nn + v_a), an2, 32);
        整 v_b = Nd(1); memcpy((字*)(nn + v_b), bn2, 32);
        /* 主 while: __mi < na */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_na); Nc(wh, cmp); }
        整 bd = Nd(5);
        /* if (__mj < nb) { if (a[__mi] < b[__mj]) { 取a } else { 取b } } else { 取a } */
        { 整 v_j = Nd(1); memcpy((字*)(nn + v_j), jname, 32);
          整 cmpj = Nd(2); nv[cmpj] = T_LK; Nc(cmpj, v_j); Nc(cmpj, e_nb); /* __mj < nb */
          整 if_j = Nd(8); Nc(if_j, cmpj);
          整 if_j_t = Nd(5);
          { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 idx_a = Nd(14); Nc(idx_a, v_a); Nc(idx_a, v_i2); /* a[__mi] */
            整 v_j2 = Nd(1); memcpy((字*)(nn + v_j2), jname, 32);
            整 idx_b = Nd(14); Nc(idx_b, v_b); Nc(idx_b, v_j2); /* b[__mj] */
            整 cmpl = Nd(2); nv[cmpl] = T_LK; Nc(cmpl, idx_a); Nc(cmpl, idx_b); /* a[__mi] < b[__mj] */
            整 if_a = Nd(8); Nc(if_a, cmpl);
            整 if_a_t = Nd(5);
            { 整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
