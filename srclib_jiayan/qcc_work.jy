                循环 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "double")) td_isdbl = 1; tk++; } /* skip all base keywords: int/char/const/unsigned/... (fix 2026-08-05: was 1 only → `typedef const char X` lost the alias) */
            } 否 若 (tt[tk] == ST) {
