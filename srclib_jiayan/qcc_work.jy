                    整 asg = Nd(10); Nc(asg, base2); Nc(asg, idx2r); Nc(wbd, asg); /* arr[..] = arr[n-1-__rc]; */
                    整 asg2 = Nd(10); Nc(asg2, idx2r); Nc(asg2, v_t); Nc(wbd, asg2); } /* arr[n-1-__rc] = __rw; */
                }
