                循环 (tk < TS && tt[tk] != UK) {
                    整 fsz = 4; 整 frow = 1; 整 dims = 0; 整 first = 1; 整 fdbl = 0;
                    若 (tt[tk] == VK) {
                        循环 (tt[tk] == VK && (!strcmp(tn[tk], "const") || !strcmp(tn[tk], "volatile"))) tk++; /* fix 2026-08-19: 限定符可多个 (const char * const key) — 原只吃一个 const → 指针后 const 被当独立字段类型 → key 注册 4B → trace_key 布局错 → get_trace_fd 读错位 → git add getenv(NULL) 崩 */
                        若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char")) fsz = 1; 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; fdbl = 1; } tk++; }
                        循环 (tt[tk] == DK) { fsz = 8; tk++; 循环 (tt[tk] == VK && (!strcmp(tn[tk], "const") || !strcmp(tn[tk], "volatile"))) tk++; } /* 每级指针后可跟 const/volatile (char * const p / const struct entry * const *) */
                    } /* funs: unsigned prefix marks the bit-field (fix 2026-08-05) */
                    循环 (tt[tk] == DK) { fsz = 8; tk++; } /* pointer field: int *p / char *s / void **pp — 8-byte on 64-bit (fix: DK was unhandled → infinite loop) */
                    若 (tt[tk] == ST) { /* nested struct field (maybe self-ref) */
                        tk++;
                        若 (tt[tk] == FK) { /* 匿名 struct/union: struct { fields } name[N]; — 解析 body 算大小 + 注册字段 + 消费数组维度 (fix 2026-08-26 lua: lstrlib struct cD { char c; union { lua_Number n; ... } u; } — 原 { 不被消费 → 字段循环死锁) */
                            整 anon_si = st_add("");
                            整 sub_union = !strcmp(tn[tk - 1], "union");
                            tk++; /* { */
                            循环 (tk < TS && tt[tk] != UK) {
                                整 nk0 = tk; /* 安全前进 */
                                整 nsz = 4, nrow = 1, ndims = 0, nfirst = 1, npel2 = 0, nbase = 4;
                                若 (tt[tk] == VK) { 循环 (tt[tk] == VK && !strcmp(tn[tk], "const")) tk++; 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) nsz = 1; 否 若 (!strcmp(tn[tk], "double")) nsz = 8; 否 若 (!strcmp(tn[tk], "long") && tt[tk + 1] == VK && !strcmp(tn[tk + 1], "long")) nsz = 8; 若 (!(tt[tk] == ST || tt[tk] == EN)) tk++; nbase = nsz; 循环 (tt[tk] == DK) { nsz = 8; npel2++; tk++; } }
                                否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { 整 nty = st_find(tn[tk]); 若 (nty >= 0 && stypes[nty].sz > 0) { nsz = stypes[nty].sz; nrow = nsz; } tk++; } 若 (tt[tk] == FK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == FK) d++; 否 若 (tt[tk] == UK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } 循环 (tt[tk] == DK) { nsz = 8; npel2++; tk++; } }
                                否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == FK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == FK) d++; 否 若 (tt[tk] == UK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } 若 (tt[tk] == UK) tk++; }
                                否 若 (tt[tk] == VR && td_is(tn[tk])) { 整 tdv2 = tdef_lookup(tn[tk]); 若 (tdv2 >= 0 && tdefs[tdv2].sz > 0) { nsz = tdefs[tdv2].sz; nrow = nsz; } tk++; 循环 (tt[tk] == DK) { nsz = 8; npel2++; tk++; } }
                                若 (tt[tk] == VR) {
                                    字 nf[64]; strcpy(nf, tn[tk]); tk++;
                                    循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { 若 (ndims == 0) nfirst = tv[tk]; ndims++; nsz *= tv[tk]; tk++; } 否 若 (tt[tk] == VR) { 整 evc2 = e_lookup(tn[tk]); 若 (evc2 == 0x80000000) evc2 = macro_find(tn[tk]); 若 (evc2 != 0x80000000 && evc2 != -1) { 若 (ndims == 0) nfirst = evc2; ndims++; nsz *= evc2; } tk++; } 若 (tt[tk] == RB) tk++; }
                                    若 (ndims >= 1) nrow = nsz / nfirst; 否 nrow = nsz;
                                    若 (sub_union) st_union_field(anon_si, nf, nsz); 否 st_field_sz_r(anon_si, nf, nsz, nrow);
                                    若 (npel2 > 0) { 整 nfi = stypes[anon_si].fn - 1; stypes[anon_si].fptrs[nfi] = 1; stypes[anon_si].fpels[nfi] = npel2 > 1 ? 8 : nbase; stypes[anon_si].ffins[nfi] = nbase; stypes[anon_si].fdeep[nfi] = (字)npel2; }
                                }
                                若 (tt[tk] == CK) tk++;
                                若 (tt[tk] == SK) tk++;
                                若 (tk == nk0) tk++;
                            }
                            若 (tt[tk] == UK) tk++; /* } */
