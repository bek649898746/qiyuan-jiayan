            遍 (整 i = 19; i >= 0; i--) { 整 c = child_i(n, i); 若 (c >= 0) { fn = c; 断; } }
            若 (fn < 0) 断;
            若 (nt[fn] == 12) fn = n0[fn]; /* (*fp)(x): deref of a fnptr decays back to the pointer (C rule) */

