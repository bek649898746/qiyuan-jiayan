    mov_r_imm(1, 16); /* ecx = 16 */
    asm_emit("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0xF7); modrm(3, 6, 1); /* div rcx */
    asm_emit("    比较字节即 r2, 10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xFA); b(10); /* cmp dl, 10 */
    b(0x0F); b(0x82); b4(0); patch_label(cp-4, l0a, 8); /* jb l0a (dl is 0-15 unsigned) */
    若 (upper) { asm_emit("    加字节 r2, 0x37\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x37); /* add dl, 0x37 = 'A'-10 (%llX) */ }
    否 { asm_emit("    加字节 r2, 0x57\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x57); /* add dl, 0x57 = 'a'-10 */ }
    jmp_rel(-1); patch_label(cp-4, lchx, 2);
    set_label(l0a);
    asm_emit("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    set_label(lchx);
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    asm_emit("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x85); modrm(3, 0, 0); /* test rax, rax */
    jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
