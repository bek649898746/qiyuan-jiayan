静 整 *nt, *nv, *n0, *n1, *n2, *n3, *n4, *n5, *n6, *n7, *n8, *n9, *n10, *n11, *n12, *n13, *n14, *n15, *n16, *n17, *n18, *n19, *n20, *n21, *n22, *n23, *n24, *n25, *n26, *n27, *n28, *n29, *n30, *n31, *n32, *n33, *n34, *n35, *n36, *n37, *n38, *n39, *n40, *n41, *n42, *n43, *n44, *n45, *n46, *n47, *n48, *n49, *n50, *n51, *n52, *n53, *n54, *n55, *n56, *n57, *n58, *n59, *n60, *n61, *n62, *n63, *n64, *n65, *n66, *n67, *n68, *n69, *n70, *n71, *n72, *n73, *n74, *n75, *n76, *n77, *n78, *n79, *n80, *n81, *n82, *n83, *n84, *n85, *n86, *n87, *n88, *n89, *n90, *n91, *n92, *n93, *n94, *n95, *n96, *n97, *n98, *n99, *n100, *n101, *n102, *n103, *n104, *n105, *n106, *n107, *n108, *n109, *n110, *n111, *n112, *n113, *n114, *n115, *n116, *n117, *n118, *n119, *n120, *n121, *n122, *n123, *n124, *n125, *n126, *n127, *n128, *n129, *n130, *n131, *n132, *n133, *n134, *n135, *n136, *n137, *n138, *n139, *n140, *n141, *n142, *n143, *n144, *n145, *n146, *n147, *n148, *n149, *n150, *n151, *n152, *n153, *n154, *n155, *n156, *n157, *n158, *n159, *n160, *n161, *n162, *n163, *n164, *n165, *n166, *n167, *n168, *n169, *n170, *n171, *n172, *n173, *n174, *n175, *n176, *n177, *n178, *n179, *n180, *n181, *n182, *n183, *n184, *n185, *n186, *n187, *n188, *n189, *n190, *n191, *n192, *n193, *n194, *n195, *n196, *n197, *n198, *n199, *n200, *n201, *n202, *n203, *n204, *n205, *n206, *n207, *n208, *n209, *n210, *n211, *n212, *n213, *n214, *n215, *n216, *n217, *n218, *n219, *n220, *n221, *n222, *n223, *n224, *n225, *n226, *n227, *n228, *n229, *n230, *n231, *n232, *n233, *n234, *n235, *n236, *n237, *n238, *n239, *n240, *n241, *n242, *n243, *n244, *n245, *n246, *n247, *n248, *n249, *n250, *n251, *n252, *n253, *n254, *n255, nc;

/* walk an array-access/member chain (case-14/15 nodes) down to the base NAME node.
   For m[i][j] the outer node's n0 is an inner case-14 node, NOT a name node —
   (char*)(nn + n0[n]) would read garbage. Returns the base node index. */
静 整 arr_base_node(整 n) {
    整 b = n;
    循环 (b >= 0 && (nt[b] == 14 || nt[b] == 15)) b = n0[b];
    返 b;
}
/* does this expression subtree yield an unsigned value? (fix 2026-08-05) */
静 整 expr_is_unsigned(整 n) {
    若 (n < 0) 返 0;
    若 (nt[n] == 1) 返 var_is_uns((字*)(nn + n)); /* unsigned var */
    若 (nt[n] == 0) 返 nuns[n];                       /* 0xFFFFFFFFu literal */
    若 (nt[n] == 2) { /* binary op: 结果类型按 C 通常算术转换 (fix 2026-08-06 M1 传播: (u-1)>0 判 unsigned) */
        整 o = nv[n];
        若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) 返 0; /* 比较 -> int 0/1 */
        若 (o == LA || o == LO) 返 0; /* && || -> int */
        若 (o == T_SR || o == T_SH) 返 expr_is_unsigned(n0[n]); /* 移位: 结果类型=左操作数 */
        返 expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n]); /* + - * / % & | ^: 任一 unsigned */
    }
    若 (nt[n] == 14) 返 expr_is_unsigned(n0[n]); /* arr[i]: 结果类型=数组元素类型 */
    返 0;
}

/* does this expression subtree yield a 64-bit (long long) value?
   STATIC type check: does not rely on the codegen-time nll[] array, so a
   parent binary op can see a 64-bit child (e.g. (long long)x << 32) that
   hasn't been codegen'd yet (fix 2026-08-22 #31: ((long long)hi << 32) + lo
   compiled the outer + as 32-bit -> high 32 bits lost -> git --date=relative
   now=2009 "in the future"). */
静 整 expr_is_ll(整 n) {
    若 (n < 0) 返 0;
    若 (nll[n]) 返 1; /* cast (long long)x / literal / pre-marked */
    若 (nt[n] == 1) 返 var_is_ll((字*)(nn + n)); /* long long var */
    若 (nt[n] == 0) 返 tll[n]; /* 1000000000LL literal */
    若 (nt[n] == 4) { /* function call returning long long (fix #27) */
            遍 (整 sci = 0; sci < 20; sci++) {
                整 scc = -1; 择 (sci) { 例 0: scc = n0[n]; 断; 例 1: scc = n1[n]; 断; 例 2: scc = n2[n]; 断; 例 3: scc = n3[n]; 断; 例 4: scc = n4[n]; 断; 例 5: scc = n5[n]; 断; 例 6: scc = n6[n]; 断; 例 7: scc = n7[n]; 断; 例 8: scc = n8[n]; 断; 例 9: scc = n9[n]; 断; 例 10: scc = n10[n]; 断; 例 11: scc = n11[n]; 断; 例 12: scc = n12[n]; 断; 例 13: scc = n13[n]; 断; 例 14: scc = n14[n]; 断; 例 15: scc = n15[n]; 断; 例 16: scc = n16[n]; 断; 例 17: scc = n17[n]; 断; 例 18: scc = n18[n]; 断; 缺: scc = n19[n]; 断; }
            若 (scc >= 0 && nt[scc] == 1) 返 fn_ll_get_ret((字*)(nn + scc));
        }
        返 0;
    }
    若 (nt[n] == 2) {
        整 o = nv[n];
        若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK || o == LA || o == LO) 返 0;
        若 (o == T_SR || o == T_SH) 返 expr_is_ll(n0[n]); /* shift: result type = LHS */
        返 expr_is_ll(n0[n]) || expr_is_ll(n1[n]); /* + - * / % & | ^ */
    }
    若 (nt[n] == 14) 返 expr_is_ll(n0[n]); /* arr[i]: result = element type */
    若 (nt[n] == 12) 返 expr_is_ll(n0[n]); /* *p: element type */
    返 0;
}


/* helper: access AST node child i (replaces (int[]){...}[i] compound literals) */
/* Generate rax = ADDRESS of a member chain (o.a.b / p->x.y), handling `->` by
   dereferencing the pointer at that point (n1.next->val loads n1.next's pointer
   value, then offsets val). *fsz_out = final field byte size; *si_out = the
   chain's resulting struct type (for further field lookup). 0 on success. */
静 空 cg(整 n); /* forward decl: mem_addr recurses through array-access codegen (case-14 base) */
/* type-only chain resolver: struct index of the VALUE at node n (no codegen).
   Mirrors mem_addr's struct resolution. -1 if not a struct value.
   fix 2026-08-22 #41: &p->parent[i].oid 的 mem_addr case-14 基是成员链
   (nt[n0[n]]==15), 原用 var_stidx(基名字) 把字段名 "parent" 当变量查 → -1 →
   地址表达式静默丢弃 → oidcpy 目标=残留寄存器 → root commit 摘要 emit_path 崩. */
静 整 mem_ty(整 n) {
    若 (n < 0) 返 -1;
    若 (nt[n] == 1) 返 var_stidx((字*)(nn + n));
    若 (nt[n] == 12) 返 mem_ty(n0[n]);
    若 (nt[n] == 13 || nt[n] == 15) {
        整 sub = mem_ty(n0[n]);
        若 (sub < 0) 返 -1;
        返 st_field_ty_idx(stypes[sub].name, (字*)(nn + n));
    }
    若 (nt[n] == 14) {
        整 b = n0[n];
        若 (b >= 0 && (nt[b] == 15 || nt[b] == 13 || nt[b] == 12 || nt[b] == 14))
            返 mem_ty(b);      /* 成员链基 (p->parent[i]): 元素 struct = 基字段的 struct */
        若 (b >= 0) 返 var_stidx((字*)(nn + b)); /* 普通数组/指针变量基 */
    }
    返 -1;
}
/* Phase3-IR case15: mem_addr 前置 IR 前向声明 (骨架区 9139 定义, 相同值重复定义安全) */
静 空 ir_emit(整 op, 整 a, 整 b, 整 c);
静 空 ir_flush(空);
#ifndef I_LEA_RIP
#define I_LEA_RIP 18
#define I_LEA_RBP_GPR 23
#define I_DEREF64 28
#define I_ADD_RAX_IMM8 27
#endif
静 整 mem_addr(整 n, 整 *fsz_out, 整 *si_out) {
    若 (nt[n] == 5 || nt[n] == 6) { /* PK(+) / MK(-): 指针算术表达式回收操作数元素大小 (t49c4 fix: (recs+nrec)-1 外层 -1 应缩放) */
        整 l = node_psz(n0[n]);
        若 (l > 0) 返 l;
        返 node_psz(n1[n]);
    }
    若 (nt[n] == 1) { /* root identifier */
        字 *vn = (字*)(nn + n);
        整 off = var_lookup(vn);
        若 (off < 0 && !(coff_mode && var_isstatic(vn))) 返 -1; /* fix 2026-08-18: extern 全局 (off<0 负槽) 允许 — coff 符号重定位 (var_isstatic=1); 原拒绝对外引用 → 嵌套链 the_repository->hash_algo->null_oid 根节点失败 → return 表达式静默丢弃 → null_oid() 返垃圾 → git init create_symref 崩 (简单箭头 case-15 早已允许, mem_addr 缺) */
        *fsz_out = 4;
        *si_out = var_stidx(vn);
        若 (var_isstatic(vn)) { ir_emit(I_LEA_RIP, off, 1, 0); ir_flush(); } /* Phase3-IR case15: mem_addr root 静态地址 */
        否 若 (var_pesz(vn) > 0) { ir_emit(I_LEA_RBP_GPR, 0, off - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case15: mem_addr root 指针变量 */
        否 { ir_emit(I_LEA_RBP_GPR, 0, var_sbase(vn, off) - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case15: mem_addr root 局部 */
        返 0;
    }
    若 (nt[n] == 14) { /* arr[i]: rax = &arr[i]; element struct type from the array var (fix 2026-08-03: nested member chains with an array root, e.g. items[i].p.x, previously returned -1 → stores/loads silently dropped → stack corruption) */
        /* fix 2026-08-22 #41: 成员链基 (p->parent[i]) 的元素 struct 类型用 mem_ty 解析
           (原 var_stidx(基名字) 把字段名当变量 → -1 → 地址表达式静默丢弃) */
        整 si = mem_ty(n);
        若 (si < 0) 返 -1;
        cg_no_deref = 1; cg(n); cg_no_deref = 0; /* rax = &arr[i] (struct array / struct ptr) */
        *fsz_out = stypes[si].sz;
        *si_out = si;
        返 0;
    }
    若 (nt[n] == 12 || nt[n] == 13) { /* *ptr 作链基 (e.g. (*e)->next): 委托 + 一次解引用取操作数值 — 外层 is_arrow 再解引用得到 *e (fix 2026-08-18: 原只委托不解引用 → 少一层 → &(*e)->next 编成 &e 的值 → hashmap 链遍历死循环 → git init 读取 config 挂起) */
        若 (mem_addr(n0[n], fsz_out, si_out) < 0) 返 -1;
        /* fix 2026-08-22 t46: *ptr 作 struct 值 (dst = *ptr / p->dm = *ptr) — deref 后 fsz 应为指向 struct 的大小
           (原保持基变量的默认 4 → 赋值 _fok2 检查 _rfsz==_fcs2 失败 → 落标量存储只存 4 字节 → ref->objectname=*oid 只存 hash 前 4 字节 → git branch "missing object") */
        若 (*si_out >= 0 && stypes[*si_out].sz > 8 && *fsz_out == 4) *fsz_out = stypes[*si_out].sz;
        ir_emit(I_DEREF64, 0, 0, 0); ir_flush(); /* Phase3-IR case15: mem_addr *ptr 解引用 — rax = [rax] = 操作数值 */
        返 0;
    }
    若 (nt[n] == 15) {
        字 *fn = (字*)(nn + n);
        整 is_arrow = (nt[n] == 15 && nv[n] == 1);
        整 sub_si = -1, sub_fsz = 4;
        若 (mem_addr(n0[n], &sub_fsz, &sub_si) < 0) 返 -1;
        若 (sub_si < 0) 返 -1;
        若 (is_arrow) { ir_emit(I_DEREF64, 0, 0, 0); ir_flush(); } /* Phase3-IR case15: mem_addr 箭头解引用 — rax = [rax] (the struct pointer) */
        整 fo = st_off(stypes[sub_si].name, fn);
        若 (fo < 0) 返 -1;
        若 (fo != 0) { ir_emit(I_ADD_RAX_IMM8, fo, 0, 0); ir_flush(); } /* Phase3-IR case15: mem_addr 字段偏移 */
        cg_mem_chain_si = sub_si; /* 最终字段所在结构体 (fix 2026-08-18: 指针字段作数组基判定需要 containing struct) */
        *fsz_out = st_field_size(stypes[sub_si].name, fn);
        *si_out = st_field_ty_idx(stypes[sub_si].name, fn);
        若 (*si_out < 0 && st_field_bitw(stypes[sub_si].name, fn) > 0) *si_out = sub_si; /* bit-field: report the CONTAINING struct so callers can extract/store (fix 2026-08-05) */
        st_field_2d_setup(sub_si, fn); /* fix 2026-08-19: 原只设 cg_mem_frow 不重置 cg_fdepth/cg_frows[] — 陈旧全局污染数组缩放 (dir->internal.exclude_list_group[i] 的 16 被前置 codegen 的 1/4/8 覆盖 → group 垃圾指针 → git status match_pathname 崩); st_field_2d_setup 设新鲜 cg_fdepth=0/cg_frows[0]=row/cg_frows[1]=el/cg_mem_frow=el */
        返 0;
    }
    返 -1;
}

