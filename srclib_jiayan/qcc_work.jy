        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __sl = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), loname, 32); Nc(d, e_lo); Nc(blk, d); } /* int __sl_lo = lo; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), hiname, 32); Nc(d, e_hi); Nc(blk, d); } /* int __sl_hi = hi; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), nname, 32); Nc(d, e_n); Nc(blk, d); } /* int __sl_n = n; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
