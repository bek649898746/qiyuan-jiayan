    jmp_rel(-1); patch_label(cp-4, lflag, 2); /* 继续解析 (fix 2026-08-23: 返 lflag 直接检查 - lflags 会 inc r11 跳过 'I' 导致 %*I64u 的 '6''4' 被当宽度数字, ll_cnt 为失) */
