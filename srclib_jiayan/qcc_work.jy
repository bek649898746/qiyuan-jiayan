静 构 { 字 fn[64]; 整 pre_stmt; 整 pre_root; 整 post_root; 整 post_str; 整 has_post; } contracts[256]; 静 整 contract_cnt; 静 整 cur_contract; 静 整 contract_find(常 字 *fn); 静 长 长 contract_const_eval(整 n, 常 字 **argnames, 常 长 长 *argvals, 整 argc, 整 *known); /* 接入 2026-08-28 可吞清单 P0-7/P1: 契约表 + 编译期常量前置审判 (声明在此, prim/调用点用; 函数定义在契约表区) */
#define QCC_CACHE_VER "43B4EBE5" /* 接入 2026-08-28 AI原生 #5: 文件级哈希增量编译 — 缓存键版本签名 (每站与不动点同号 bump, 编译器升级→旧缓存自动失效) */
