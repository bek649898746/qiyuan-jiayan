    mov_r_imm(0, 2); mov_mbrp_reg(scratch_base - cur_frame_sz + 244, 0); /* ll_cnt = 2 (64-bit) */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past 'I') */
    asm_emit("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
    mov_r_imm(0, '6'); alu_rr(T_QK, 1, 0); jnz_rel(-1); patch_label(cp-4, lflags, 1); /* not '6' → back to flag loop */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past '6') */
    asm_emit("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
    mov_r_imm(0, '4'); alu_rr(T_QK, 1, 0); jnz_rel(-1); patch_label(cp-4, lflags, 1); /* not '4' → back */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past '4') */
    jmp_rel(-1); patch_label(cp-4, lflag, 2);
