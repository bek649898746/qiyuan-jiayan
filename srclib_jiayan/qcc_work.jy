            } 否 若 (nt[n0[n]] == 14) { /* arr[i] = expr */
                整 ac = n0[n]; 字*vn=(字*)(nn+arr_base_node(ac));

                整 asi_el = var_stidx(vn);
                /* struct 数组元素赋值 班级[j] = 班级[j+1] (fix 2026-08-06).
