           at the switch's end; the trailing break exits the wrapper. */
        整 sw_wh = Nd(9); { 整 t = Nd(0); nv[t] = 1; Nc(sw_wh, t); }
        整 sw_bd = Nd(5); Nc(sw_bd, decl); 若 (chain >= 0) Nc(sw_bd, chain);
        Nc(sw_bd, Nd(16)); /* break; -- leave the wrapper after the chain */
        Nc(sw_wh, sw_bd);
        返 sw_wh;
    }
    若 (tt[tk] == FK) 返 blk();
    若 (tt[tk] == BR) { tk++; 整 r = Nd(16); tk++; 返 r; } /* break; */
    若 (tt[tk] == CN) { tk++; 整 r = Nd(21); tk++; 返 r; } /* continue; */
    整 e = expr(); tk++; 返 e;
}

/* 常量整数表达式求值 (数组维度用): 支持整数/枚举/宏常量、括号、+-*\/%<>^&| 与一元 +-~。
   左到右求值 (维度表达式几乎都是单运算符, 优先级差异可忽略)。成功置 *val 并推进 tk, 返回 1; 失败不推进, 返回 0。
   (fix 2026-08-14: hash_algos[GIT_HASH_NALGOS] 展开成 [(2 + 1)] — 原数组维度只认单 NK/VR token, `(` 卡住 → 维度=0 → 后续 null_oid 定义被吞 undefined) */
静 整 const_expr_eval(整 *val); /* fwd */
静 整 const_expr_prim(整 *val) {
    若 (tt[tk] == NK) { *val = tv[tk]; tk++; 返 1; }
    若 (tt[tk] == BK) { /* sizeof 常量维度: char tmp[sizeof "..."] (fix 2026-08-15: inet_ntop.c tp 未注册 undefined) */
        tk++; 若 (tt[tk] == OK) tk++; /* sizeof( */
        整 sz = 4;
        若 (tt[tk] == STR) { sz = (整)strlen(str_tbl[tv[tk]]) + 1; tk++; }
        否 若 (tt[tk] == VK) { 若 (!strcmp(tn[tk],"char")||!strcmp(tn[tk],"_Bool")) sz=1; 否 若 (!strcmp(tn[tk],"double")) sz=8; 否 若 (!strcmp(tn[tk],"short")) sz=2; tk++; 循环 (tt[tk] == DK) { sz = 8; tk++; } }
        否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { 整 si = st_find(tn[tk]); 若 (si >= 0) sz = stypes[si].sz; tk++; } }
        否 若 (tt[tk] == DK) { sz = 8; tk++; 若 (tt[tk] == VR) tk++; }
        否 若 (tt[tk] == VR) { 整 si = var_stidx(tn[tk]); tk++; 若 ((tt[tk] == AR || tt[tk] == DT) && tt[tk + 1] == VR) { 若 (si >= 0) { 整 fs = st_field_size(stypes[si].name, tn[tk + 1]); 若 (fs > 0) sz = fs; } tk += 2; } }
        若 (tt[tk] == KK) tk++;
        *val = sz; 返 1;
    }
    若 (tt[tk] == VR) { 整 ev = e_lookup(tn[tk]); 若 (ev == 0x80000000) ev = macro_find(tn[tk]); 若 (ev != 0x80000000 && ev != -1) { *val = ev; tk++; 返 1; } 返 0; }
    若 (tt[tk] == OK) { tk++; 若 (!const_expr_eval(val)) 返 0; 若 (tt[tk] == KK) tk++; 返 1; }
    若 (tt[tk] == MK) { tk++; 若 (!const_expr_prim(val)) 返 0; *val = -*val; 返 1; }
    若 (tt[tk] == PK) { tk++; 返 const_expr_prim(val); }
    若 (tt[tk] == BN) { tk++; 若 (!const_expr_prim(val)) 返 0; *val = ~*val; 返 1; }
    返 0;
}
静 整 const_expr_eval(整 *val) {
    若 (!const_expr_prim(val)) 返 0;
    遍 (;;) {
        整 op = tt[tk];
        若 (op == PK || op == MK || op == DK || op == DV || op == MD || op == SH || op == SR || op == PT || op == OR || op == XR) {
            tk++; 整 r; 若 (!const_expr_prim(&r)) 返 0;
            择 (op) { 例 PK: *val += r; 断; 例 MK: *val -= r; 断; 例 DK: *val *= r; 断;
                例 DV: 若 (r) *val /= r; 断; 例 MD: 若 (r) *val %= r; 断; 例 SH: *val <<= r; 断;
                例 SR: *val >>= r; 断; 例 PT: *val &= r; 断; 例 OR: *val |= r; 断; 例 XR: *val ^= r; 断; }
        } 否 断;
    }
    返 1;
}

静 整 skip_global_init(整 tk) {
    /* 跳过全局/文件级声明中的初始化器: = expr / = { ... } / = ( ... )
       到顶层逗号或分号停止 (不消费逗号/分号)。 (fix 2026-08-15: *local_packs = NULL, *altodb_packs = NULL) */
    若 (tt[tk] != AK) 返 tk;
    tk++;
    整 d = 0;
    循环 (tk < TS && tt[tk] != EK) {
        若 (tt[tk] == FK || tt[tk] == OK || tt[tk] == LB) d++;
        否 若 (tt[tk] == UK || tt[tk] == KK || tt[tk] == RB) { d--; 若 (d < 0) d = 0; }
        否 若 (d == 0 && (tt[tk] == CK || tt[tk] == SK)) 断;
        tk++;
    }
    返 tk;
}

静 整 parse(常 字 *s) {
    tk = 0; nc = 1; vcnt = 0; rsp_used = 32; /* reserve shadow space */
    fdef_n = 0; /* fix 2026-08-06: 每次 parse 重置顶层函数列表 */
    memset(ndbl, 0, 大小(ndbl)); /* per-node double flags must not leak across compiles */
    memset(nuns, 0, 大小(nuns)); /* per-node unsigned flags (fix 2026-08-05) */
    fvn = 0; /* reset per-function var-range table */
    memset(tt, 0, TS * 4);
    字 *exp_src = pp_include_expand(s, 0); /* #include 预展开（fix 2026-08-06） */
    若 (getenv("QCC_STAGE")) fprintf(stderr, "[STAGE] include expand done len=%d\n", (整)strlen(exp_src));
    fn_macro_collect(exp_src); /* fix 2026-08-07: 移到 include 展开之后 — 头文件里的函数宏才能被收集展开 */
    obj_macro_collect(exp_src); /* fix 2026-08-13: 对象宏收集 (lex 前, Git hash-ll.h) */
    若 (fn_macro_n > 0) {
        字 *msrc = fn_macro_expand(exp_src);
        若 (msrc && msrc[0]) { free(exp_src); exp_src = msrc; }
    }
    若 (obj_macro_n > 0) { /* fix 2026-08-13: 对象宏文本层展开 (lex 前) */
        字 *osrc = obj_macro_expand(exp_src);
        若 (osrc && osrc[0]) { free(exp_src); exp_src = osrc; }
    }
    若 (fn_macro_n > 0) { /* fix 2026-08-15: 对象宏值里嵌套的函数宏需第二遍展开 (STRMAP_INIT → HASHMAP_INIT) — 否则 jyld undefined symbol */
        字 *msrc2 = fn_macro_expand(exp_src);
        若 (msrc2 && msrc2[0]) { free(exp_src); exp_src = msrc2; }
    }
    pp_guard_n = 0; /* fix 2026-08-13 Phase3: lex 阶段 #if defined(X) 走 macro 表(lex 自己的 #define); 清 pp_guard 防 fn_macro_collect 污染 → #if !defined(XTYPES_H) 被误判已定义跳过 xtypes.h typedef */
    若 (getenv("QCC_STAGE")) fprintf(stderr, "[STAGE] macro expand done, lexing...\n");
    lex(exp_src);
    若 (getenv("QCC_STAGE")) fprintf(stderr, "[STAGE] lex done ti=%d\n", ti);
    free(exp_src);
    若 (getenv("QCC_DUMP")) { 遍 (整 di = 5215; di < ti && di < 5250; di++) fprintf(stderr, "[TK] %d: tt=%d tn='%s'\n", di, tt[di], tn[di]); }
    若 (getenv("QCC_DUMP")) { 遍 (整 di = 1755; di < ti && di < 1800; di++) fprintf(stderr, "[TK] %d: tt=%d tn='%s'\n", di, tt[di], tn[di]); }
    若 (getenv("QCC_DUMP")) { 遍 (整 di = 1755; di < ti && di < 1800; di++) fprintf(stderr, "[TK] %d: tt=%d tn='%s'\n", di, tt[di], tn[di]); }
    若 (ti >= TS) { fprintf(stderr, "[ERR] token overflow\n"); 返 -1; }
    整 p = Nd(3); 若 (p < 0) 返 -1;
    
    循环 (tk < TS && tt[tk] != EK) {
        若 (tt[tk] == VR && (!strcmp(tn[tk], "__asm__") || !strcmp(tn[tk], "__asm"))) { /* 顶层内联汇编 (__attribute__ 误解析致函数体落到顶层): 跳过 */
            tk++;
            若 (tt[tk] == VR && (!strcmp(tn[tk], "__volatile__") || !strcmp(tn[tk], "volatile"))) tk++;
            若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } }
            若 (tt[tk] == SK) tk++;
            续;
        }
        /* struct definition: struct Name { fields; }; or struct { fields; } var; */
        若 (tt[tk] == ST || (tt[tk] == VK && !strcmp(tn[tk], "static") && tt[tk + 1] == ST)) {
            整 st_static = (tt[tk] == VK); /* fix 2026-08-15: static struct X {...} */
            整 st_orig = tk;
            若 (st_static) tk++;
            整 st_save = tk;
            整 is_union = !strcmp(tn[tk], "union");
            tk++; /* skip struct */
            若 (tt[tk] == VR || (tt[tk] == VK && !strcmp(tn[tk], "FILE"))) { /* tagged: keep the tag as the struct name (FILE 被 kw() 归为 VK, 但 `struct FILE;` 前向声明必须识别 — fix 2026-08-15: transport_connect undefined 根因) */
                整 si = st_find(tn[tk]); 若 (si < 0) si = st_add(tn[tk]); /* fix 2026-08-05: `struct S s;` (no body) re-added an EMPTY S → st_find later hit the wrong index → global struct field reads/writes broke */
                tk++; /* struct name */
                若 (tt[tk] == SK) { tk++; 续; } /* struct X; 前向声明 (无 body 无变量) — 原回退到 decl 分支后落函数检测 break 截断 parse (fix 2026-08-13 Phase3: regex_internal.h struct re_dfa_t;) */
                若 (tt[tk] == FK) { /* { */
                    tk++;
                    整 funs = 0; /* unsigned bit-field marker (fix 2026-08-05) */
                    循环 (tk < TS && tt[tk] != UK) {
                        整 tk0 = tk; /* 安全前进守卫: 未识别字段类型时强制 +1, 防死循环 (fix 2026-08-13) */
                        整 fsz = 4; 整 frow = 1; 整 dims = 0; 整 first = 1; 整 fdbl = 0; 整 fll = 0; /* fll: long long 字段 (fix 2026-08-06) */
                        若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { fsz = 1; } 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; fdbl = 1; } 否 若 (!strcmp(tn[tk], "long")) { 若 (tt[tk+1] == VK && !strcmp(tn[tk+1], "long")) { fsz = 8; frow = 8; fll = 1; } } 否 若 (!strcmp(tn[tk], "short")) { fsz = 2; frow = 2; } tk++;
                            若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++; /* 消费 long long 的第二个 long (fix 2026-08-06) */ }
                        循环 (tt[tk] == DK) { fsz = 8; tk++; } /* pointer field */
                        若 (tt[tk] == ST) { /* nested struct field: struct Inner in; (or struct Node *next — self ref) */
                            tk++; /* struct */
                            若 (tt[tk] == FK) { /* 匿名 struct/union: union { ... } opr; — 跳过 body 但注册字段名(8字节近似) (fix 2026-08-13 Phase3: regex re_token_t union opr) */
                                整 d = 1; tk++;
                                循环 (tk < TS && d > 0) { 若 (tt[tk] == FK) d++; 否 若 (tt[tk] == UK) d--; tk++; }
                                若 (tt[tk] == VR) { 字 ufn[64]; strcpy(ufn, tn[tk]); tk++; st_field_sz_r(si, ufn, 8, 8); } /* 字段名 opr — 8 字节近似 union 大小, 防后续字段偏移错位 */
                                若 (tt[tk] == SK) tk++; /* ; */
                                续;
                            }
                            若 (tt[tk] == VR) {
                                字 iname[64]; strcpy(iname, tn[tk]); tk++; /* Inner */
                                整 inner_si = st_find(iname);
                                若 (tt[tk] == FK) { /* inline definition body: struct B { int y; } — parse + register (fix 2026-08-05: was unhandled `{` → infinite loop) */
                                    整 ni = inner_si < 0 ? st_add(iname) : inner_si;
                                    tk++; /* { */
                                    整 ifuns = 0; /* unsigned bit-field marker (fix 2026-08-05) */
                                    循环 (tk < TS && tt[tk] != UK) {
                                        整 ifsz = 4, ifrow = 1, ifdims = 0, ifirst = 1;
                                        循环 (tt[tk] == DK) tk++; /* 指针字段续行: struct entry *next, *previous; 的 *previous (fix 2026-08-14: 原 DK 无分支消费 → 死循环) */
                                        若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) ifuns = 1; 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) ifsz = 1; 否 若 (!strcmp(tn[tk], "double")) ifsz = 8; tk++; 循环 (tt[tk] == DK) tk++; } /* fix 2026-08-13: 指针字段 * 未消费 → 死循环 (object_array_entry char *name) */
                                        否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == FK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == FK) d++; 否 若 (tt[tk] == UK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } 否 若 (tt[tk] == VR) { tk++; 若 (tt[tk] == FK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == FK) d++; 否 若 (tt[tk] == UK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } } 若 (tt[tk] == DK) tk++; } /* fix 2026-08-13: 三层嵌套 struct X { ... } *field; 定义 body 未消费 → 死循环 (pathspec_item.attr_match) */
                                        否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == FK) { tk++; 整 ev = 0; 循环 (tk < TS && tt[tk] != UK && tt[tk] != EK) { 整 tk0 = tk; 若 (tt[tk] == VR) { 字 enm[64]; memcpy(enm, tn[tk], 64); tk++; 若 (tt[tk] == AK) { tk++; 整 neg = 0; 若 (tt[tk] == MK) { neg = 1; tk++; } 若 (tt[tk] == NK) { ev = neg ? -tv[tk] : tv[tk]; tk++; } } e_reg(enm, ev); ev++; } 若 (tt[tk] == CK) tk++; 若 (tk == tk0) tk++; } 若 (tt[tk] == UK) tk++; } } /* fix 2026-08-13: 匿名 enum 字段 (内层嵌套 struct body); fix 2026-08-15: 注册常量 REV_CMD_PARENTS_ONLY undefined */
                                        若 (tt[tk] == CL) { /* unnamed bit-field (fix 2026-08-05) */
                                            tk++; 整 ubw = 0;
                                            若 (tt[tk] == NK) { ubw = tv[tk]; tk++; }
                                            st_field_bit_anon(ni, ubw);
                                            ifuns = 0;
                                        }
                                        若 (tt[tk] == VR) {
                                            字 fn[64]; strcpy(fn, tn[tk]); tk++;
                                            整 ibw = 0;
                                            若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) { ibw = tv[tk]; tk++; } } /* : N bit-field (fix 2026-08-05: inline nested struct loop) */
                                            若 (ibw > 0) { st_field_bit(ni, fn, ifsz, ifsz, ibw, ifuns); ifuns = 0; }
                                            否 {
                                            循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { 若 (ifdims == 0) ifirst = tv[tk]; ifdims++; ifsz *= tv[tk]; tk++; } 否 若 (tt[tk] == VR) { 整 evc = e_lookup(tn[tk]); 若 (evc == 0x80000000) evc = macro_find(tn[tk]); 若 (evc != 0x80000000) { 若 (ifdims == 0) ifirst = evc; ifdims++; ifsz *= evc; } tk++; } 若 (tt[tk] == PK || tt[tk] == MK) { 整 op = tt[tk]; tk++; 若 (tt[tk] == NK) { 若 (op == PK) ifsz += tv[tk]; 否 ifsz -= tv[tk]; tk++; } } /* char d_name[NAME_MAX + 1]: 维度算术 +1/-1 (fix 2026-08-14: 原 + 无分支消费 → 死循环) */ 若 (tt[tk] == RB) tk++; }
                                            若 (ifdims >= 1) ifrow = ifsz / ifirst; 否 ifrow = ifsz;
                                            st_field_sz_r(ni, fn, ifsz, ifrow);
                                            }
                                        }
                                        若 (tt[tk] == CK) tk++;
                                        若 (tt[tk] == SK) tk++;
                                    }
                                    若 (tt[tk] == UK) tk++; /* } */
                                    inner_si = ni;
                                }
                                整 fptr = 0;
                                若 (tt[tk] == DK) { fptr = 1; tk++; } /* struct Node *next: * sits BEFORE the name */
                                若 (inner_si >= 0 && tt[tk] == VR) {
                                    字 fn[64]; strcpy(fn, tn[tk]); tk++;
                                    若 (is_union) st_union_field(si, fn, fptr ? 8 : stypes[inner_si].sz);
                                    否 { st_field_sz_r(si, fn, fptr ? 8 : stypes[inner_si].sz, fptr ? 8 : 1); st_field_ty(si, fn, inner_si); } /* fix 2026-08-07: 指针字段 frow=8 → 偏移 8 对齐 (原 frow=1 → align=1 → struct LNode* next 偏移 4, 读 [&b+4] 错位) */
                                    循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 否 若 (tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++; } /* fix 2026-08-13: 柔性数组 parent[] 未消费 → 死循环 (commit_graft) */
                                }
                            }
                            若 (tt[tk] == SK) tk++;
                            续;
                        }
                        否 若 (tt[tk] == OK && tt[tk + 1] == DK) { /* fnptr field: int (*cb)(int,int); / (*cb[3]) — 8-byte pointer field (fix 2026-08-03: unhandled '(' stuck the loop) */
                            tk++; tk++; /* skip ( * */
                            若 (tt[tk] == VR) {
                                字 fn[64]; strcpy(fn, tn[tk]); tk++;
                                整 fsz8 = 8, first = 1, fdims = 0;
                                循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { 若 (fdims == 0) first = tv[tk]; fdims++; fsz8 *= tv[tk]; tk++; } 否 若 (tt[tk] == VR) { 整 evc = e_lookup(tn[tk]); 若 (evc == 0x80000000) evc = macro_find(tn[tk]); 若 (evc != 0x80000000 && evc != -1) { 若 (fdims == 0) first = evc; fdims++; fsz8 *= evc; } tk++; } /* fix 2026-08-13: 维度标识符 (原 VR 死循环) */ 若 (tt[tk] == RB) tk++; }
                                若 (is_union) st_union_field(si, fn, fsz8);
                                否 { st_field_sz_r(si, fn, fdims >= 1 ? fsz8 : 8, fdims >= 1 ? fsz8 / first : 8); st_field_ty(si, fn, -2); } /* mark fnptr field (fix 2026-08-07: 单 fnptr frow=8 — 原 1 触发 brace_fields 数组路径) */
                                若 (tt[tk] == KK) tk++; /* skip ) closing (*cb) */
                                若 (tt[tk] == OK) { 整 depth = 0; 循环 (tk < TS && tt[tk] != EK) { 若 (tt[tk] == OK) depth++; 否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } } tk++; } }
                            }
                            若 (tt[tk] == CK) tk++;
                            若 (tt[tk] == SK) tk++;
                            续;
                        }
                        否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == FK) { /* 匿名 enum { A, B = 5 } field; — 注册常量 (fix 2026-08-14: SINGLETON undefined — 原只跳过 body 不注册常量) */
                            tk++; /* { */
                            整 ev = 0;
                            循环 (tk < TS && tt[tk] != UK && tt[tk] != EK) {
                                整 tk0 = tk;
                                若 (tt[tk] == VR) {
                                    字 enm[64]; memcpy(enm, tn[tk], 64); tk++;
                                    若 (tt[tk] == AK) { tk++; 整 neg = 0; 若 (tt[tk] == MK) { neg = 1; tk++; } 若 (tt[tk] == NK) { ev = neg ? -tv[tk] : tv[tk]; tk++; } }
                                    e_reg(enm, ev);
                                    ev++;
                                }
                                若 (tt[tk] == CK) tk++;
                                若 (tk == tk0) tk++;
                            }
                            若 (tt[tk] == UK) tk++;
                        } } /* enum field: `enum Color c;` / 匿名 `enum { A } c;` → int (fix 2026-08-13: 匿名 enum body 卡在 { 死循环, merge-recursive.h detect_directory_renames) */
                        否 若 (tt[tk] == VR && (td_is(tn[tk]) || st_find(tn[tk]) >= 0)) tk++; /* typedef type */
                        若 (tt[tk] == CL) { /* unnamed bit-field (fix 2026-08-05) */
                            tk++; 整 ubw = 0;
                            若 (tt[tk] == NK) { ubw = tv[tk]; tk++; }
                            st_field_bit_anon(si, ubw);
                            funs = 0; /* unsigned marker must not leak past an unnamed bit-field (fix 2026-08-05) */
                        }
                        若 (tt[tk] == VR) {
                            字 fn[64]; strcpy(fn, tn[tk]); tk++;
                            整 bitw = 0;
                            若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) { bitw = tv[tk]; tk++; } } /* : N bit-field (fix 2026-08-05: was unhandled → infinite loop; upgraded from width-skip to real packing) */
                            若 (bitw > 0) {
                                st_field_bit(si, fn, fsz, fsz, bitw, funs); /* bit-field: packed into shared int slots */
                                若 (fdbl) st_field_dbl(si, fn);
                                funs = 0;
                            } 否 {
                            整 unsized = 0; /* 柔性数组 int arr[] (fix 2026-08-05: was sized 4 → sizeof overcounted) */
                            整 fel = fsz; /* fix 2026-08-07: 数组字段元素大小 */
                            循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { 若 (dims == 0) first = tv[tk]; dims++; fsz *= tv[tk]; tk++; } 否 若 (tt[tk] == VR) { 整 evc = e_lookup(tn[tk]); 若 (evc == 0x80000000) evc = macro_find(tn[tk]); 若 (evc != 0x80000000 && evc != -1) { 若 (dims == 0) first = evc; dims++; fsz *= evc; } 否 unsized = 1; tk++; } 否 { unsized = 1; dims++; 整 bd = 1; 循环 (tk < TS && bd > 0) { 若 (tt[tk] == LB) bd++; 否 若 (tt[tk] == RB) { bd--; 若 (bd == 0) { tk++; 断; } } tk++; } } 若 (tt[tk] == RB) tk++; /* NK/VR 后消费 ] (fix 2026-08-13 Phase3: 复杂维度 else 已跳过 ] 此句为 no-op) */ }
                            若 (dims >= 1) frow = fsz / first; /* element/row byte size (same as anon branch) */
                            否 frow = fsz; /* scalar field: row = its own byte size (frow==fsz → not an array) */
                            若 (unsized) { fsz = 0; frow = 4; } /* 柔性数组: 不占 struct 空间, 元素大小保留 */
                            若 (is_union) st_union_field(si, fn, fsz);
                            否 { st_field_sz_r(si, fn, fsz, frow); stypes[si].fels[stypes[si].fn - 1] = fel; } /* fix 2026-08-07 */
                            若 (fdbl) st_field_dbl(si, fn);
                            若 (fll) st_field_ty(si, fn, -3); /* long long 字段标记: 64 位访问 (fix 2026-08-06) */
                            }
                        }
                        若 (tt[tk] == CK) tk++; /* comma between fields */
                        若 (tt[tk] == SK) tk++;
                        若 (tk == tk0) tk++; /* 安全前进守卫 */
                    }
                    若 (tt[tk] == UK) tk++; /* } */
                    st_finalize(si); /* fix 2026-08-06: 尾部填充 round up */
                    /* instance variable(s): struct Item {...} items[4]; / *ptr */
                    若 (tt[tk] == DK) { 循环 (tt[tk] == DK) tk++; 若 (tt[tk] == VR) { var_static(tn[tk], 4); vars[vcnt - 1].st_idx = si; 若 (st_static) var_file_static[vcnt - 1] = 1; tk++; tk = skip_global_init(tk); } } /* fix 2026-08-15: **entries — 多级指针实例只吃一个 * → cmd_mktree 被吞; = NULL 初始化器 */
                    否 若 (tt[tk] == VR) {
                        整 cnt = 1;
                        若 (tt[tk + 1] == LB) { 整 tix = tk + 1; 循环 (tt[tix] == LB) { tix++; 若 (tt[tix] == NK) cnt *= tv[tix]; 若 (tt[tix] == RB) tix++; } }
                        var_static_struct(tn[tk], si, cnt);
                        若 (st_static) var_file_static[vcnt - 1] = 1;
                        tk++;
                        循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 否 若 (tt[tk] == VR) tk++; /* fix 2026-08-13: 维度标识符跳过 */ 若 (tt[tk] == RB) tk++; }
                        若 (tt[tk] == AK && tt[tk + 1] == FK) { 整 n = 1, d0 = 0; tk += 2; 循环 (tk < TS && !(tt[tk] == UK && d0 == 0)) { 若 (tt[tk] == FK || tt[tk] == OK || tt[tk] == LB) d0++; 否 若 (tt[tk] == UK || tt[tk] == KK || tt[tk] == RB) d0--; 否 若 (tt[tk] == CK && d0 == 0) n++; tk++; } 若 (cnt == 1 && n > 1) vars[vcnt - 1].arr_sz = n; 若 (tt[tk] == UK) tk++; }
                        否 tk = skip_global_init(tk); /* = expr 初始化器 (fix 2026-08-15) */
                    }
                    循环 (tt[tk] == CK) { tk++; 整 ip2 = 0; 循环 (tt[tk] == DK) { ip2 = 1; tk++; } 若 (tt[tk] == VR) { 若 (ip2) { var_static(tn[tk], 4); vars[vcnt - 1].st_idx = si; } 否 var_static_struct(tn[tk], si, 1); 若 (st_static) var_file_static[vcnt - 1] = 1; tk++; tk = skip_global_init(tk); } }
