/* walk an array-access/member chain (case-14/15 nodes) down to the base NAME node.
   For m[i][j] the outer node's n0 is an inner case-14 node, NOT a name node —
   (char*)(nn + n0[n]) would read garbage. Returns the base node index. */
静 整 arr_base_node(整 n) {
    整 b = n;
    循环 (b >= 0 && (nt[b] == 14 || nt[b] == 15)) b = n0[b];
    返 b;
}
/* does this expression subtree yield an unsigned value? (fix 2026-08-05) */
静 整 expr_is_unsigned(整 n) {
    若 (n < 0) 返 0;
    若 (nt[n] == 1) 返 var_is_uns((字*)(nn + n)); /* unsigned var */
    若 (nt[n] == 0) 返 nuns[n];                       /* 0xFFFFFFFFu literal */
    若 (nt[n] == 2) { /* binary op: 结果类型按 C 通常算术转换 (fix 2026-08-06 M1 传播: (u-1)>0 判 unsigned) */
        整 o = nv[n];
        若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) 返 0; /* 比较 -> int 0/1 */
        若 (o == LA || o == LO) 返 0; /* && || -> int */
        若 (o == T_SR || o == T_SH) 返 expr_is_unsigned(n0[n]); /* 移位: 结果类型=左操作数 */
        返 expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n]); /* + - * / % & | ^: 任一 unsigned */
    }
    若 (nt[n] == 14) 返 expr_is_unsigned(n0[n]); /* arr[i]: 结果类型=数组元素类型 */
    返 0;
}

/* helper: access AST node child i (replaces (int[]){...}[i] compound literals) */
/* Generate rax = ADDRESS of a member chain (o.a.b / p->x.y), handling `->` by
   dereferencing the pointer at that point (n1.next->val loads n1.next's pointer
   value, then offsets val). *fsz_out = final field byte size; *si_out = the
   chain's resulting struct type (for further field lookup). 0 on success. */
静 空 cg(整 n); /* forward decl: mem_addr recurses through array-access codegen (case-14 base) */
静 整 mem_addr(整 n, 整 *fsz_out, 整 *si_out) {
    若 (nt[n] == 1) { /* root identifier */
        字 *vn = (字*)(nn + n);
        整 off = var_lookup(vn);
        若 (off < 0) 返 -1;
        *fsz_out = 4;
        *si_out = var_stidx(vn);
        若 (var_isstatic(vn)) lea_rax_rip(coff_static_disp(off, 1) - 1);
        否 若 (var_pesz(vn) > 0) lea_r_mbrp(0, off - cur_frame_sz); /* fix 2026-08-07: 指针变量 root (q->next->v) — lea &q; var_sbase 对 st_idx 减 struct 大小 → 错位 (q 解引用读垃圾) */
        否 lea_r_mbrp(0, var_sbase(vn, off) - cur_frame_sz);
        返 0;
    }
    若 (nt[n] == 14) { /* arr[i]: rax = &arr[i]; element struct type from the array var (fix 2026-08-03: nested member chains with an array root, e.g. items[i].p.x, previously returned -1 → stores/loads silently dropped → stack corruption) */
        字 *av = (字*)(nn + n0[n]);
        整 si = var_stidx(av);
        若 (si < 0) 返 -1;
        cg_no_deref = 1; cg(n); cg_no_deref = 0; /* rax = &arr[i] (struct array / struct ptr) */
        *fsz_out = stypes[si].sz;
        *si_out = si;
        返 0;
    }
    若 (nt[n] == 15 || nt[n] == 13) {
        字 *fn = (字*)(nn + n);
        整 is_arrow = (nt[n] == 15 && nv[n] == 1);
        整 sub_si = -1, sub_fsz = 4;
        若 (mem_addr(n0[n], &sub_fsz, &sub_si) < 0) 返 -1;
        若 (sub_si < 0) 返 -1;
        若 (is_arrow) mov_reg_mreg64(0, 0); /* deref: rax = [rax] (the struct pointer) */
        整 fo = st_off(stypes[sub_si].name, fn);
        若 (fo < 0) 返 -1;
        若 (fo != 0) add_rax_imm8(fo);
        *fsz_out = st_field_size(stypes[sub_si].name, fn);
        *si_out = st_field_ty_idx(stypes[sub_si].name, fn);
        若 (*si_out < 0 && st_field_bitw(stypes[sub_si].name, fn) > 0) *si_out = sub_si; /* bit-field: report the CONTAINING struct so callers can extract/store (fix 2026-08-05) */
        cg_mem_frow = st_field_row(stypes[sub_si].name, fn); /* array field: element size for a following [i] */
        返 0;
    }
    返 -1;
}

