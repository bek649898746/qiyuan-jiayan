/* simple #define NAME VALUE macros (constant numbers) */
静 构 { 字 name[32]; 整 val; } macros[64]; 静 整 macro_n;
静 空 macro_add(常 字 *n, 整 v) { 若 (macro_n < 64) { strcpy(macros[macro_n].name, n); macros[macro_n].val = v; macro_n++; } }
静 整 macro_find(常 字 *n) { 遍 (整 i = 0; i < macro_n; i++) 若 (!strcmp(macros[i].name, n)) 返 macros[i].val; 返 -1; }
/* string macros: #define NAME "value" (fix 2026-08-05: 与 C 版对齐 — 此前 jy 版缺失 str_macro_find，defined() 引用未定义函数但自举路径不触发) */
静 构 { 字 name[32]; 字 val[2048]; } str_macros[64]; /* fix 2026-08-06 */ 静 整 str_macro_n;
静 字 *str_macro_find(常 字 *n) { 遍 (整 i = 0; i < str_macro_n; i++) 若 (!strcmp(str_macros[i].name, n)) 返 str_macros[i].val; 返 0; }
/* function-like macros: #define NAME(p1,p2) body — collect 定义, fn_macro_expand 在 lex 前展开调用 (fix 2026-08-05; _va_alloc 是 qcc 内置机制不能展开) */
静 构 { 字 name[32]; 字 params[8][16]; 整 pn; 字 body[512]; } fn_macros[64]; 静 整 fn_macro_n;
静 整 macro_exists(常 字 *n) { /* fix 2026-08-06: 区分「未找到」(-1) 与「负值宏」— macro_find 的 -1 哨兵与负值混淆 (镜像 qcc_x86.c) */
    遍 (整 i = 0; i < macro_n; i++) 若 (!strcmp(macros[i].name, n)) 返 1;
    遍 (整 i = 0; i < str_macro_n; i++) 若 (!strcmp(str_macros[i].name, n)) 返 1;
    遍 (整 i = 0; i < fn_macro_n; i++) 若 (!strcmp(fn_macros[i].name, n)) 返 1;
    返 0;
}
/* #undef：从数字/字符串/函数三个宏表删除（fix 2026-08-05） */
静 空 macro_remove(常 字 *n) {
    遍 (整 i = 0; i < macro_n; i++) 若 (!strcmp(macros[i].name, n)) { 遍 (整 j = i; j < macro_n - 1; j++) macros[j] = macros[j + 1]; macro_n = macro_n - 1; 返; }
    遍 (整 i = 0; i < str_macro_n; i++) 若 (!strcmp(str_macros[i].name, n)) { 遍 (整 j = i; j < str_macro_n - 1; j++) str_macros[j] = str_macros[j + 1]; str_macro_n = str_macro_n - 1; 返; }
    遍 (整 i = 0; i < fn_macro_n; i++) 若 (!strcmp(fn_macros[i].name, n)) { 遍 (整 j = i; j < fn_macro_n - 1; j++) fn_macros[j] = fn_macros[j + 1]; fn_macro_n = fn_macro_n - 1; 返; }
}

静 空 fn_macro_collect(常 字 *s) {
    fn_macro_n = 0;
    遍 (整 i = 0; s[i]; i++) {
        若 (s[i] == '/' && s[i+1] == '*') { i += 2; 循环 (s[i] && !(s[i] == '*' && s[i+1] == '/')) i++; i++; 续; }
        若 (s[i] == '/' && s[i+1] == '/') { 循环 (s[i] && s[i] != '\n') i++; 续; }
        若 (s[i] == '"') { i++; 循环 (s[i] && s[i] != '"') { 若 (s[i] == '\\') i++; i++; } 续; }
        若 (s[i] == '\'') { i++; 循环 (s[i] && s[i] != '\'') { 若 (s[i] == '\\') i++; i++; } 续; }
        若 (s[i] == '#' && !strncmp(s + i, "#define", 7)) {
            整 p = i + 7;
            循环 (s[p] == ' ' || s[p] == '\t') p++;
            字 nm[32]; 整 ni = 0;
            循环 (isalnum((无 字)s[p]) || s[p] == '_') { 若 (ni < 31) nm[ni++] = s[p]; p++; }
            nm[ni] = 0;
            循环 (s[p] == ' ' || s[p] == '\t') p++;
            若 (s[p] == '(' && fn_macro_n < 64 && strcmp(nm, "_va_alloc")) {
                strcpy(fn_macros[fn_macro_n].name, nm);
                p++;
                整 pi = 0;
                循环 (s[p] && s[p] != ')' && pi < 8) {
                    循环 (s[p] == ' ' || s[p] == '\t' || s[p] == ',') p++;
                    若 (s[p] == ')') 断;
                    整 qi = 0;
                    循环 (isalnum((无 字)s[p]) || s[p] == '_') { 若 (qi < 15) fn_macros[fn_macro_n].params[pi][qi++] = s[p]; p++; }
                    fn_macros[fn_macro_n].params[pi][qi] = 0;
                    pi++;
                }
                fn_macros[fn_macro_n].pn = pi;
                若 (s[p] == ')') p++;
                循环 (s[p] == ' ' || s[p] == '\t') p++;
                整 bi = 0;
                循环 (s[p] && s[p] != '\n' && bi < 511) {
                    若 (s[p] == '\\' && (s[p + 1] == '\n' || (s[p + 1] == '\r' && s[p + 2] == '\n'))) { /* 多行 body: \ 续行 → 空格 (fix 2026-08-05) */
                        若 (bi < 511) fn_macros[fn_macro_n].body[bi++] = ' ';
                        p++;
                        若 (s[p] == '\r') p++;
                        若 (s[p] == '\n') p++;
                        续;
                    }
                    fn_macros[fn_macro_n].body[bi++] = s[p++];
                }
                fn_macros[fn_macro_n].body[bi] = 0;
                fn_macro_n++;
            }
        }
    }
}
静 字 *g_mout; 静 整 g_mo; 静 整 g_mcap; /* 函数式宏展开的全局输出缓冲 (fix 2026-08-05: 避免甲言指针-指针不可靠) */

静 空 fn_macro_expand_to(常 字 *seg) {
    遍 (整 i = 0; seg[i]; ) {
        若 (isalnum((无 字)seg[i]) || seg[i] == '_') {
            字 nm[32]; 整 ni = 0;
            循环 (isalnum((无 字)seg[i]) || seg[i] == '_') { 若 (ni < 31) nm[ni++] = seg[i]; i++; }
            nm[ni] = 0;
            整 fmi = -1;
            遍 (整 k = 0; k < fn_macro_n; k++) 若 (!strcmp(fn_macros[k].name, nm)) { fmi = k; 断; }
            若 (fmi >= 0 && seg[i] == '(') {
                字 args[8][128]; 整 an = 0;
                i++;
                整 depth = 1, aj = 0;
                循环 (seg[i] && depth > 0) {
                    若 (seg[i] == '(') depth++;
                    否 若 (seg[i] == ')') { depth--; 若 (depth == 0) 断; }
                    若 (seg[i] == ',' && depth == 1) { args[an][aj] = 0; an++; aj = 0; i++; 续; }
                    若 (aj < 127) args[an][aj++] = seg[i];
                    i++;
                }
                args[an][aj] = 0; an++;
                若 (seg[i] == ')') i++;
                字 tmp[1024]; 整 ti2 = 0;
                常 字 *body = fn_macros[fmi].body;
                遍 (整 b = 0; body[b]; ) {
                    若 (isalnum((无 字)body[b]) || body[b] == '_') {
                        字 pn2[32]; 整 pi2 = 0;
                        循环 (isalnum((无 字)body[b]) || body[b] == '_') { 若 (pi2 < 31) pn2[pi2++] = body[b]; b++; }
                        pn2[pi2] = 0;
                        整 matched = -1;
                        遍 (整 p2 = 0; p2 < fn_macros[fmi].pn; p2++) 若 (!strcmp(fn_macros[fmi].params[p2], pn2)) { matched = p2; 断; }
                        若 (matched >= 0 && matched < an) {
                            遍 (整 k = 0; args[matched][k] && ti2 < 1022; k++) tmp[ti2++] = args[matched][k];
                        } 否 {
                            遍 (整 k = 0; k < pi2 && ti2 < 1022; k++) tmp[ti2++] = pn2[k];
                        }
                    } 否 {
                        若 (ti2 < 1022) tmp[ti2++] = body[b++];
                    }
                }
                tmp[ti2] = 0;
                fn_macro_expand_to(tmp); /* 递归: body 可能含嵌套宏 */
                续;
            }
            若 (g_mo + ni + 1 > g_mcap) { g_mcap += 65536; g_mout = realloc(g_mout, g_mcap); }
            遍 (整 k = 0; k < ni; k++) { g_mout[g_mo] = nm[k]; g_mo++; }
        } 否 {
            若 (g_mo + 1 > g_mcap) { g_mcap += 65536; g_mout = realloc(g_mout, g_mcap); }
            g_mout[g_mo] = seg[i]; g_mo++; i++;
        }
    }
}

静 字 *fn_macro_expand(常 字 *s) {
    g_mcap = 1048576; g_mout = malloc(g_mcap); g_mo = 0;
    fn_macro_expand_to(s);
    g_mout[g_mo] = 0;
    返 g_mout;
}

/* 条件编译栈（fix 2026-08-05） */
静 整 if_parent_skip[64]; 静 整 if_taken[64]; 静 整 if_n; 静 整 if_skip;
/* #if 表达式求值：defined(X)、数字、宏值、!、&&、||、比较 */
静 整 pp_eval(常 字 *e) {
    循环 (*e == ' ') e++;
    整 elen = (整)strlen(e);
    循环 (elen > 0 && e[elen-1] == ' ') elen--;
    /* 只剥首尾匹配的整体括号（fix 2026-08-06 M7: 原看首尾字符，(1<2)&&(2<3) 被误剥） */
    若 (elen >= 2 && e[0] == '(') {
        整 dd = 0, mm = -1;
        遍 (整 ii = 0; ii < elen; ii++) {
            若 (e[ii] == '(') dd++;
            否 若 (e[ii] == ')') { dd--; 若 (dd == 0) { mm = ii; 断; } }
        }
        若 (mm == elen - 1) {
            字 inner[512]; memcpy(inner, e+1, elen-2); inner[elen-2] = 0;
            返 pp_eval(inner);
        }
    }
    若 (!strncmp(e, "defined", 7) && e[7] == '(') { /* defined(X) */
        字 nm[32]; 整 ni = 0; 整 p = 8;
        循环 (isalnum(e[p]) || e[p] == '_' || ((无 字)e[p] >= 0x80)) { 若 (ni < 31) nm[ni++] = e[p]; p++; }
        nm[ni] = 0;
        返 macro_exists(nm) ? 1 : 0; /* fix 2026-08-06: 原 macro_find>=0 对负值宏判假 */
    }
    若 (e[0] == '!') 返 pp_eval(e + 1) ? 0 : 1;
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '|' && e[i+1] == '|') {
            字 a[512]; 字 b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 2);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 (pp_eval(a) || pp_eval(b)) ? 1 : 0;
        }
    }
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '&' && e[i+1] == '&') {
            字 a[512]; 字 b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 2);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 (pp_eval(a) && pp_eval(b)) ? 1 : 0;
        }
    }
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        整 op = 0; 整 ol = 0;
        若 (dp == 0 && e[i] == '=' && e[i+1] == '=') { op = 1; ol = 2; }
        否 若 (dp == 0 && e[i] == '!' && e[i+1] == '=') { op = 2; ol = 2; }
        否 若 (dp == 0 && e[i] == '<' && e[i+1] == '=') { op = 3; ol = 2; }
        否 若 (dp == 0 && e[i] == '>' && e[i+1] == '=') { op = 4; ol = 2; }
        否 若 (dp == 0 && e[i] == '<') { op = 5; ol = 1; }
        否 若 (dp == 0 && e[i] == '>') { op = 6; ol = 1; }
        若 (op) {
            字 a[512]; 字 b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + ol);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            整 x = pp_eval(a); 整 y = pp_eval(b);
            若 (op == 1) 返 x == y;
            若 (op == 2) 返 x != y;
            若 (op == 3) 返 x <= y;
            若 (op == 4) 返 x >= y;
            若 (op == 5) 返 x < y;
            若 (op == 6) 返 x > y;
        }
    }
    整 negv = 0; /* fix 2026-08-06: 支持负数字面量 #if -5 < 0 (镜像 qcc_x86.c) */
    若 (e[0] == '-') { negv = 1; e++; }
    若 (e[0] == '0' && (e[1] == 'x' || e[1] == 'X')) {
        整 v = 0; 整 p = 2; 循环 (isxdigit((无 字)e[p])) { 整 c = e[p]; v = v * 16 + (c >= '0' && c <= '9' ? c - '0' : (c >= 'a' && c <= 'f' ? c - 'a' + 10 : c - 'A' + 10)); p++; }
        返 negv ? -v : v;
    }
    若 (isdigit((无 字)e[0])) { 整 v = 0; 整 p = 0; 循环 (isdigit((无 字)e[p])) v = v * 10 + (e[p++] - '0'); 返 negv ? -v : v; }
    若 (negv) 返 0; /* -名字: 不支持 */
    若 (macro_exists(e)) 返 macro_find(e); /* fix 2026-08-06: 原 mv>=0 把负值宏当未找到 → 0 */
    返 0;
}

/* #include "file" — 预处理器包含展开（lex 前；条件编译感知；fix 2026-08-06） */
静 字 *pp_include_expand(常 字 *src, 整 depth) {
    若 (depth > 8) { fprintf(stderr, "[ERR] #include 嵌套超过 8 层\n"); exit(1); }
    整 cap = strlen(src) + 16384;
    字 *out = malloc(cap); 整 oi = 0;
    常 字 *p = src;
    整 if_skip = 0, if_n = 0;
    整 if_parent_skip[64], if_taken[64];
    循环 (*p) {
        常 字 *le = p; 循环 (*le && *le != '\n') le++;
        整 llen = le - p;
        若 (*p == '#') {
            整 is_ifdef = !strncmp(p, "#ifdef", 6);
            整 is_ifndef = !strncmp(p, "#ifndef", 7);
            整 is_if = !strncmp(p, "#if", 3) && !is_ifdef && !is_ifndef;
            整 is_elif = !strncmp(p, "#elif", 5);
            整 is_else = !strncmp(p, "#else", 5);
            整 is_endif = !strncmp(p, "#endif", 6);
            整 is_include = !strncmp(p, "#include", 8);
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = if_skip; 整 cond = 0;
                若 (is_ifdef || is_ifndef) {
                    字 nm[32]; 整 ni = 0; 常 字 *q = p + (is_ifdef ? 6 : 7);
                    循环 (*q == ' ' || *q == '\t') q++;
                    循环 (isalnum(*q) || *q == '_' || ((无 字)*q >= 0x80)) { 若 (ni < 31) nm[ni++] = *q; q++; }
                    nm[ni] = 0;
                    整 def = macro_exists(nm); /* fix 2026-08-06: 原 macro_find>=0 对负值宏判假 */
                    cond = is_ifdef ? def : !def;
                } 否 若 (is_if || is_elif) {
                    字 expr[512]; 整 ei = 0; 常 字 *q = p + (is_if ? 3 : 5);
                    循环 (*q == ' ' || *q == '\t') q++;
                    循环 (*q && *q != '\n' && ei < 510) expr[ei++] = *q++;
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--;
                    expr[ei] = 0;
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (if_n < 64) { if_parent_skip[if_n] = parent; if_taken[if_n] = cond && !parent; if_skip = parent || !cond; if_n++; }
                } 否 若 (is_elif) {
                    若 (if_n > 0) { 若 (!if_taken[if_n-1] && !if_parent_skip[if_n-1]) { if_taken[if_n-1] = cond; if_skip = if_parent_skip[if_n-1] || !cond; } 否 if_skip = 1; }
                } 否 若 (is_else) {
                    若 (if_n > 0) { 若 (!if_taken[if_n-1] && !if_parent_skip[if_n-1]) { if_taken[if_n-1] = 1; if_skip = if_parent_skip[if_n-1]; } 否 if_skip = 1; }
                } 否 若 (is_endif) {
                    若 (if_n > 0) { if_n--; if_skip = if_n > 0 ? if_parent_skip[if_n-1] : 0; }
                }
                整 k; 遍 (k = 0; k <= llen; k++) { out[oi] = p[k]; oi++; }
            } 否 若 (is_include && !if_skip) {
                常 字 *q = p + 8;
                循环 (*q == ' ' || *q == '\t') q++;
                若 (*q != '"') { 整 k; 遍 (k = 0; k <= llen; k++) { out[oi] = p[k]; oi++; } } /* <系统头> 跳过（自包含） */
                否 {
                    字 fname[512]; 整 fi = 0;
                    q++; 循环 (*q && *q != '"' && fi < 510) fname[fi++] = *q++;
                    fname[fi] = 0;
                    若 (fi > 0) {
                        字 *fc = read_file(fname);
                        若 (!fc) { fprintf(stderr, "[ERR] #include: 找不到文件 '%s'\n", fname); exit(1); }
                        字 *exp = pp_include_expand(fc, depth + 1);
                        free(fc);
                        整 el = strlen(exp);
                        若 (oi + el + 2 >= cap) { cap = oi + el + 16384; out = realloc(out, cap); }
                        整 k; 遍 (k = 0; k < el; k++) { out[oi] = exp[k]; oi++; }
                        out[oi] = '\n'; oi++;
                        free(exp);
                    }
                }
            } 否 {
                整 k; 遍 (k = 0; k <= llen; k++) { out[oi] = p[k]; oi++; }
            }
        } 否 {
            整 k; 遍 (k = 0; k <= llen; k++) { out[oi] = p[k]; oi++; }
        }
        若 (oi >= cap - 4096) { cap += 32768; out = realloc(out, cap); }
        p = *le ? le + 1 : le;
    }
    out[oi] = 0;
    返 out;
}

静 整 rsp_used;           /* ????????? */

/* ?????? struct ??????????? */
静 构 { 字 name[32]; 字 fnames[32][32]; 整 foffs[32]; 整 fsizes[32]; 整 frows[32]; 整 ftypes[32]; 整 fbits[32]; 整 fbitof[32]; 字 fdbls[32]; 字 fsgn[32]; 整 fn; 整 sz; 整 algn; } stypes[64]; /* algn: struct 最大对齐（fix 2026-08-06） */ 静 整 st_n;

静 整 bit_slot = -1, bit_pos = 0; /* 位域打包状态：当前 int 槽 foffs + 槽内位偏移（fix 2026-08-05） */
静 整 st_find(常 字 *n) {
    遍 (整 i = 0; i < st_n; i++) 若 (!strcmp(stypes[i].name, n)) 返 i;
    返 -1;
}
静 空 st_finalize(整 si) { /* fix 2026-08-06: struct 总大小按最大对齐 round up (镜像 qcc_x86.c) */
    若 (si >= 0 && stypes[si].algn > 1 && stypes[si].sz % stypes[si].algn)
        stypes[si].sz += stypes[si].algn - (stypes[si].sz % stypes[si].algn);
}
静 整 st_add(常 字 *n) {
    若 (st_n >= 64) 返 -1;
    strcpy(stypes[st_n].name, n); stypes[st_n].fn = 0; stypes[st_n].sz = 0; stypes[st_n].algn = 1;
    bit_slot = -1; bit_pos = 0; /* 新结构体重置位域打包 */
    返 st_n++;
}
静 空 st_field_sz_r(整 si, 常 字 *fn, 整 fsz, 整 frow) {
    若 (stypes[si].fn >= 32) { fprintf(stderr, "[ERR] struct 字段超过 32 上限 (fix 2026-08-06 M2)\n"); exit(1); }
    整 idx = stypes[si].fn;
    /* fix 2026-08-06: struct 字段对齐填充（char+int 应 8 非 5）。对齐单位由 frow（元素/行大小）推导:
       frow>=8 → 8 (double/LL/指针); frow>=4 → 4 (int/float); frow>=2 → 2 (short)。数组字段 frow=元素大小。 */
    整 align = 1;
    若 (frow >= 8) align = 8;
    否 若 (frow >= 4) align = 4;
    否 若 (frow >= 2) align = 2;
    若 (stypes[si].sz % align) stypes[si].sz += align - (stypes[si].sz % align); /* pad 字段偏移到对齐 */
    strcpy(stypes[si].fnames[idx], fn);
    stypes[si].foffs[idx] = stypes[si].sz;
    stypes[si].fsizes[idx] = fsz;
    stypes[si].frows[idx] = frow;
    stypes[si].ftypes[idx] = -1; /* not a struct field by default */
    stypes[si].fbits[idx] = 0; stypes[si].fbitof[idx] = 0; /* 非位域（fix 2026-08-05） */
    stypes[si].fsgn[idx] = 0; /* 非位域：符号位无关（fix 2026-08-05） */
    bit_slot = -1; bit_pos = 0; /* 非位域终止任何进行中的位域段 */
    stypes[si].sz += fsz;
    若 (align > stypes[si].algn) stypes[si].algn = align; /* 记录 struct 最大对齐（总大小 round up） */
    stypes[si].fn = stypes[si].fn + 1;
}
静 空 st_field_bit(整 si, 常 字 *fn, 整 fsz, 整 frow, 整 bitw, 整 uns) {
    /* 真实位域语义：连续位域打包进共享 int 槽。
       foffs = 槽字节偏移；fbitof = 槽内位偏移；fbits = 位宽。
       uns = 1 为 `unsigned` 位域（读取不符号扩展）；int → signed。 */
    若 (stypes[si].fn >= 32) { fprintf(stderr, "[ERR] struct 字段超过 32 上限 (fix 2026-08-06 M2)\n"); exit(1); }
    整 idx = stypes[si].fn;
    strcpy(stypes[si].fnames[idx], fn);
    若 (bit_slot < 0 || bit_pos + bitw > 32) { bit_slot = stypes[si].sz; stypes[si].sz += 4; bit_pos = 0; }
    stypes[si].foffs[idx] = bit_slot;
    stypes[si].fsizes[idx] = fsz;
    stypes[si].frows[idx] = frow;
    stypes[si].ftypes[idx] = -1;
    stypes[si].fbits[idx] = bitw;
    stypes[si].fbitof[idx] = bit_pos;
    stypes[si].fsgn[idx] = uns;
    bit_pos += bitw;
    stypes[si].fn = stypes[si].fn + 1;
}
静 空 st_field_bit_anon(整 si, 整 bitw) {
    /* 无名位域 ": N" — 占位但不注册字段（fix 2026-08-05）。
       : 0 强制下一个具名位域开新 int 槽（C 规则）。 */
    若 (bitw > 0) {
        若 (bit_slot < 0 || bit_pos + bitw > 32) { bit_slot = stypes[si].sz; stypes[si].sz += 4; bit_pos = 0; }
        bit_pos += bitw;
    } 否 {
        bit_slot = -1; bit_pos = 0; /* 零宽：下一字段开新槽 */
    }
}
静 空 st_field_ty(整 si, 常 字 *fn, 整 ty) {
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { stypes[si].ftypes[i] = ty; 返; }
}
静 整 st_field_ty_idx(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 -1;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) 返 stypes[si].ftypes[i];
    返 -1;
}
静 空 st_field_dbl(整 si, 常 字 *fn) { /* mark a struct field as double (8-byte movsd access) */
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { stypes[si].fdbls[i] = 1; 返; }
}
静 整 st_field_is_dbl(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) 返 stypes[si].fdbls[i];
    返 0;
}
静 空 st_field_sz(整 si, 常 字 *fn, 整 fsz) { st_field_sz_r(si, fn, fsz, 1); }
/* union field: offset 0, size = MAX of all fields */
静 空 st_union_field(整 si, 常 字 *fn, 整 fsz) {
    若 (stypes[si].fn >= 32) { fprintf(stderr, "[ERR] struct 字段超过 32 上限 (fix 2026-08-06 M2)\n"); exit(1); }
    整 idx = stypes[si].fn;
    strcpy(stypes[si].fnames[idx], fn);
    stypes[si].foffs[idx] = 0;
    stypes[si].fsizes[idx] = fsz;
    stypes[si].frows[idx] = 1;
    stypes[si].ftypes[idx] = -1;
    stypes[si].fbits[idx] = 0; stypes[si].fbitof[idx] = 0; stypes[si].fsgn[idx] = 0; /* union 字段：绝不位域（fix 2026-08-05） */
    若 (fsz > stypes[si].sz) stypes[si].sz = fsz;
    stypes[si].fn = stypes[si].fn + 1;
}
__attribute__((unused))
静 空 st_field(整 si, 常 字 *fn) { st_field_sz(si, fn, 4); }
静 整 st_field_row(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) 返 stypes[si].frows[i];
    返 0;
}
静 整 st_off(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 -1;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) 返 stypes[si].foffs[i];
    返 -1;
}
静 整 st_sz(常 字 *sn) { 整 si = st_find(sn); 返 si >= 0 ? stypes[si].sz : 0; }
静 整 st_field_size(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) 返 stypes[si].fsizes[i];
    返 0;
}
静 整 st_field_bitw(常 字 *sn, 常 字 *fn) { /* 位域位宽，0 = 非位域（fix 2026-08-05） */
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) 返 stypes[si].fbits[i];
    返 0;
}
静 整 st_field_bitof(常 字 *sn, 常 字 *fn) { /* 槽内位偏移（fix 2026-08-05） */
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) 返 stypes[si].fbitof[i];
    返 0;
}
静 整 st_field_is_uns(常 字 *sn, 常 字 *fn) { /* 1 = unsigned 位域（读取不符号扩展）（fix 2026-08-05） */
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) 返 stypes[si].fsgn[i] != 0;
    返 0;
}

