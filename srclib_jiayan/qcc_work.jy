                ir_flush(); /* rcx = &target */
                遍 (整 k = 0; k < nargs && k < 3; k++) {
                    整 gpr;
                    若 (k == 0) gpr = 2; 否 若 (k == 1) gpr = 8; 否 gpr = 9;
                    若 (fn_dbl_get(fname, k)) { ir_emit(I_LOAD_XMM_RSP, k, argbase + total_h - slot_h[k] - 8, 0); }
                    否 { ir_emit(I_LOAD_RSP_GPR, gpr, argbase + total_h - slot_h[k] - 8, 0); }
                    ir_flush();
                }
                遍 (整 k = 3; k < nargs; k++) {
                    若 (fn_dbl_get(fname, k)) { ir_emit(I_LOAD_XMM_RSP, k, argbase + total_h - slot_h[k] - 8, 0); ir_flush(); movsd_mrsp64_xmmreg(32 + 8 * (k - 3), 0); }
                    否 { ir_emit(I_LOAD_RSP_GPR, 0, argbase + total_h - slot_h[k] - 8, 0); ir_flush(); mov_mrsp_reg64(32 + 8 * (k - 3), 0); }
                }
            } 否 若 (is_user && fi >= 0) {
                /* user call with double args (Win64): position k goes in xmm[k], int in GPR[k] — IR */
                遍 (整 k = 0; k < nargs && k < 4; k++) {
                    整 gpr;
                    若 (k == 0) gpr = 1; 否 若 (k == 1) gpr = 2; 否 若 (k == 2) gpr = 8; 否 gpr = 9;
                    若 (fn_dbl_get(fname, k)) { ir_emit(I_LOAD_XMM_RSP, k, argbase + total_h - slot_h[k] - 8, 0); }
                    否 { ir_emit(I_LOAD_RSP_GPR, gpr, argbase + total_h - slot_h[k] - 8, 0); }
                    ir_flush();
                }
            } 否 若 (fnptr) {
