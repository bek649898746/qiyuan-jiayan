/* C99 compound literal: (T){ init } — 匿名自动存储期临时对象 (fix 2026-08-11 Phase 2-3).
   cast 分支在 ')' 后见 FK 时调用。注册 _cl<N> 临时变量, 复用 brace_fields/brace_arr_init 填充,
   初始化块挂到 cl_blk (blk() 当前块), 返回临时对象的地址节点 (Nd(1)). */
静 整 cl_cnt = 0;
静 整 compound_literal(整 is_struct, 整 si, 整 is_array, 整 arr_n, 整 arr_esz) {
    字 vn[64]; snprintf(vn, 32, "_cl%d", cl_cnt++);
    整 b = Nd(5); /* block: decl + init assigns */
    整 d = Nd(7); memcpy((字*)(nn + d), vn, 32); /* decl node */
    整 init_blk = Nd(5); /* init assignments (挂到 cl_blk) */
    若 (is_array) {
        若 (arr_n <= 0) { /* (T[]){} : 数 FK 内顶层元素数推断 dims */
            整 save_tk = tk; 整 cnt = 0; 整 depth0 = 1; tk++; /* skip { */
            循环 (tk < TS && depth0 > 0) {
                若 (tt[tk] == FK) depth0++;
                否 若 (tt[tk] == UK) { depth0--; 若 (depth0 == 0) 断; }
                否 若 (tt[tk] == CK && depth0 == 1) cnt++;
                tk++;
            }
            arr_n = cnt + 1;
            tk = save_tk;
        }
        var_array(vn, arr_n, arr_esz);
        Nc(b, d); /* declare */
        整 idn = Nd(1); memcpy((字*)(nn + idn), vn, 32);
        整 dims[1]; dims[0] = arr_n;
        tk++; /* skip { */
        brace_arr_init(init_blk, idn, dims, 1, 0, arr_esz);
    } 否 若 (is_struct) {
        var_struct(vn, si);
        Nc(b, d);
        整 idn = Nd(1); memcpy((字*)(nn + idn), vn, 32);
        tk++; /* skip { 先跳 FK (brace_fields 从 FK 后开始) */
        整 bi = brace_fields(si, idn);
        Nc(init_blk, bi);
        若 (tt[tk] == UK) tk++; /* } */
    } 否 { /* scalar: (T){5} → 临时 = 5 (C99: 标量 compound literal 是值, 非地址) */
        tk++; /* skip { */
        整 val = expr(); /* { 后的表达式值 */
        若 (tt[tk] == UK) tk++; /* } */
        /* 标量不需要临时变量 — 直接返回值 */
        返 val;
    }
    /* 声明挂当前块, 初始化挂 cl_blk (compound literal 语义: 初始化在包含语句前执行) */
    若 (cl_blk >= 0) Nc(cl_blk, b);
    若 (cl_blk >= 0) Nc(cl_blk, init_blk);
    整 n = Nd(1); memcpy((字*)(nn + n), vn, 32); /* 返回临时对象地址 */
    返 n;
}
