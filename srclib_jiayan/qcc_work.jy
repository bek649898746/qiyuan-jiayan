                            循环 (tt[tk] == LB) { tk++; 整 cdim = 0; 若 (const_expr_eval(&cdim)) { 若 (dims == 0) first = cdim; dims++; fsz *= cdim > 0 ? cdim : 1; } 否 { dims++; 循环 (tk < TS && tt[tk] != RB && tt[tk] != EK) tk++; } 若 (tt[tk] == RB) tk++; } /* t35k 2026-08-23: sizeof(匿名 struct) 数组维度整体表达式求值 (原 NK/VR/PK/MK 手写分支) */
                            若 (dims >= 1) frow = fsz / first; 否 frow = fsz;
                            st_field_sz_r(si, fn, fsz, frow);
                            若 (funs) stypes[si].fsgn[stypes[si].fn - 1] = 1; /* fix 2026-08-25 bug#33: 记录普通字段 unsigned (short 字段符号扩展判断, 原 fsgn 只给位域) */
                            stypes[si].fels[stypes[si].fn - 1] = fel; /* fix 2026-08-07 */
                            若 (fdbl) st_field_dbl(si, fn);
                        }
                    }
                    若 (tt[tk] == CK) tk++;
                    若 (tt[tk] == SK) tk++;
                }
                若 (tt[tk] == UK) tk++; /* } */
                若 (stypes[si].algn > 1) { 整 m = stypes[si].sz % stypes[si].algn; 若 (m) stypes[si].sz += stypes[si].algn - m; } /* fix 2026-08-06: struct 总大小 round up 到最大对齐 */
                整 sz = stypes[si].sz;
                若 (tt[tk] == KK) tk++; /* ) */
                整 n = Nd(0); nv[n] = sz; 返 n;
            }
        }
        若 (tt[tk] == VR && td_is(tn[tk])) { /* sizeof(TypedefName) — typedef'd struct/double (fix 2026-08-03: was 4) */
            整 tdi = tdef_lookup(tn[tk]);
            若 (tdi >= 0 && tdefs[tdi].is_struct) {
                整 sz = st_sz(tdefs[tdi].st_name); tk++;
                若 (tt[tk] == KK) tk++; /* ) */
                若 (tdefs[tdi].arr_n > 0) sz *= tdefs[tdi].arr_n; /* fix 2026-08-27 特性#2: struct typedef 数组 sizeof(PairArr)=16 */
                整 n = Nd(0); nv[n] = sz; 返 n;
            }
            若 (tdi >= 0 && tdefs[tdi].is_dbl && !tdefs[tdi].is_struct) { /* sizeof(typedef double) → 8 (fix 2026-08-05) */
                tk++;
                若 (tt[tk] == KK) tk++;
                整 n = Nd(0); nv[n] = 8; 返 n;
            }
            若 (tdi >= 0 && !tdefs[tdi].is_struct && !tdefs[tdi].is_dbl) { /* sizeof(标量 typedef) — size_t=8 (fix 2026-08-19: 原落 varname 路径 sz=4 → bitsizeof 错 → st_mult 溢出误报); typedef 数组 arr_n>0 → sz*arr_n (fix 2026-08-27 特性#2: sizeof(arr_t)=12) */
                tk++;
                若 (tt[tk] == KK) tk++;
                整 tszx = tdefs[tdi].sz;
                若 (tdefs[tdi].arr_n > 0) tszx = tdefs[tdi].sz * tdefs[tdi].arr_n;
                整 n = Nd(0); nv[n] = tszx; 返 n;
            }
            若 (tdi < 0) { /* fix 2026-08-27 特性#1: <stdint.h> 被跳过未注册的类型名兜底 — sizeof(int16_t)=4 根因 */
                整 tsz = 4;
                常 字 *tyn = tn[tk];
                若 (!strcmp(tyn, "int8_t") || !strcmp(tyn, "uint8_t")) tsz = 1;
                否 若 (!strcmp(tyn, "int16_t") || !strcmp(tyn, "uint16_t")) tsz = 2;
                否 若 (!strcmp(tyn, "int64_t") || !strcmp(tyn, "uint64_t") || !strcmp(tyn, "size_t") || !strcmp(tyn, "uintptr_t") || !strcmp(tyn, "intptr_t") || !strcmp(tyn, "ptrdiff_t") || !strcmp(tyn, "off_t") || !strcmp(tyn, "time_t")) tsz = 8;
                tk++;
                若 (tt[tk] == KK) tk++;
                整 n = Nd(0); nv[n] = tsz; 返 n;
            }
        }
        若 (tt[tk] == VR) { /* sizeof(varname): array -> N*esz, double -> 8, char -> 1, ptr -> 8, else 4 */
            整 sz = 4;
            整 esz = 4; /* element size, for sizeof(varname[0]) (fix 2026-08-17) */
            整 base_si = -1; /* struct type of the base var (for sizeof(e->field)) */
            遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                若 (!strcmp(vars[vi].name, tn[tk]) && var_codegen_visible(vi)) {
                    若 (vars[vi].arr_sz > 0) { 整 e = vars[vi].arr_esz ? vars[vi].arr_esz : 4; esz = e; 整 es = vars[vi].p_esz > 0 ? vars[vi].p_esz : e; sz = vars[vi].arr_sz * es; } /* fix 2026-08-28: esz=行大小 (sizeof(A[0])), sz=总字节用标量元素 (sizeof(A)) */
                    否 若 (vars[vi].is_dbl) { esz = 8; sz = 8; }
                    否 若 (vars[vi].is_char) { esz = 1; sz = 1; }
                    否 若 (vars[vi].is_short) { esz = 2; sz = 2; } /* fix 2026-08-27 特性#1: sizeof(short 变量/元素) 原 4 */
                    否 若 (vars[vi].is_ll) { esz = 8; sz = 8; } /* long long / size_t 变量 (fix 2026-08-19: 原落 else sz=4 → sizeof(size_t 参数)=4 → bitsizeof 错 → st_mult 溢出误报) */
                    否 若 (vars[vi].p_esz != 0) { esz = vars[vi].p_esz; sz = 8; } /* pointer: p_esz=element size, slot is 8 bytes */
                    否 若 (vars[vi].st_idx >= 0) { esz = st_sz(stypes[vars[vi].st_idx].name); sz = esz; } /* struct 变量: sizeof = struct 大小 (fix 2026-08-19: init_repository_format memcpy(dst,&fresh,sizeof(fresh)) 原 sz=4 只拷 version → v1_only_extensions.nr/items 栈垃圾 → verify_repository_format 误入 v1-only 错误路径 → git status 死循环/崩溃) */
                    否 { esz = 4; sz = 4; }
                    base_si = vars[vi].st_idx;
                    断;
                }
            tk++; /* skip varname */
            循环 (tt[tk] == DT || tt[tk] == AR) { /* -> / . member chain: sizeof(e->p->name) — 跟随后续成员直到最后字段 (fix 2026-08-15: precompose_utf8 sizeof(prec_dir->dirent_nfc->d_name) 原只跟一级 → d_name 泄漏 undefined) */
                tk++; /* skip ->/. */
                若 (tt[tk] == VR) {
                    若 (base_si >= 0) { 整 fs = st_field_size(stypes[base_si].name, tn[tk]); 若 (fs > 0) sz = fs; 整 el2 = st_field_el(base_si, tn[tk]); 若 (el2 > 0) esz = el2; 整 fty = st_field_ty_idx(stypes[base_si].name, tn[tk]); 若 (fty >= 0) base_si = fty; 否 base_si = -1; }
                    tk++;
                }
            }
            若 (tt[tk] == LB) { /* sizeof(varname[0]): element size (fix 2026-08-17: [0] was left dangling -> postfix index on the const-size node -> deref of const base, 0xC0000005 in regress_const_structarr) */
                tk++; 若 (tt[tk] == NK || tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++;
                sz = esz;
            }
            若 (tt[tk] == KK) tk++; /* ) */
            整 n = Nd(0); nv[n] = sz; 返 n;
        }
        若 (tt[tk] == DK) { /* sizeof(*ptr) — 指针 deref: 指向类型大小 (fix 2026-08-13: 原 return -1 → token 错位, 镜像 v4 0xC0000005; hash-ll.h Clone memcpy(dst,src,sizeof(*dst))) */
            tk++; /* * */
            整 sz = 8;
            整 si = -1;
            整 np2 = 0;
            循环 (tt[tk] == OK) { np2++; tk++; } /* fix 2026-08-19: 宏展开冗余括号 sizeof(*((src->items))) — COPY_ARRAY 的 sizeof(*(src)) 代入实参带括号 → 原见 ( 不解析直接返 8 → st_mult 收到 8 → status 崩 */
            若 (tt[tk] == VR) {
                遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                    若 (!strcmp(vars[vi].name, tn[tk]) && var_codegen_visible(vi)) {
                        若 (vars[vi].p_esz > 0) sz = vars[vi].p_esz;
                        si = vars[vi].st_idx;
                        断;
                    }
                tk++; /* var name */
                /* fix 2026-08-19: sizeof(*src->items) — 成员链解引用 (COPY_ARRAY(dst->items, src->items, dst->nr)
                   → memcpy(..., st_mult(sizeof(*src->items), n)))。原只处理 *varname, src->items 悬空 →
                   parse 错位 → st_mult 收到垃圾 → status 崩。沿链解析: 指针字段 → 指向大小; struct 字段 → 下钻 */
                循环 (tt[tk] == DT || tt[tk] == AR) {
                    tk++; /* -> / . */
                    若 (tt[tk] == VR) {
                        若 (si >= 0) {
                            整 fty = st_field_ty_idx(stypes[si].name, tn[tk]);
                            若 (st_field_is_ptr(si, tn[tk])) {
                                整 pel = st_field_pel(si, tn[tk]);
                                若 (pel > 0) sz = pel; /* 指针字段: sizeof(*p->field) = 指向元素/结构大小 */
                                si = fty >= 0 ? fty : -1;
                            } 否 若 (fty >= 0) {
                                si = fty; sz = stypes[si].sz; /* struct 字段: 下钻, 中间值=结构大小 */
                            } 否 {
                                整 fs2 = st_field_size(stypes[si].name, tn[tk]);
                                若 (fs2 > 0) sz = fs2; /* 标量字段: sizeof(*p->ch) = 1 */
                                si = -1;
                            }
                        }
                        tk++;
                    } 否 断;
                }
            }
            循环 (tt[tk] == KK && np2 > 0) { np2--; tk++; } /* 内层闭合括号 (计数配对 — fix 2026-08-19) */
            若 (tt[tk] == KK) tk++; /* sizeof 自身的外层 ) */
            整 n = Nd(0); nv[n] = sz; 返 n;
        }
        返 -1;
    }
    若 (tt[tk] == NK) { 整 n = Nd(0); nv[n] = tv[tk]; 若 (tuns[tk]) nuns[n] = 1; 若 (tll[tk]) { nll[n] = 1; nll_hi[n] = tll_hi[tk]; } tk++; 返 n; } /* u-/LL-suffix literals → flags (fix 2026-08-05) */
    若 (tt[tk] == FP) { 整 n = Nd(0); nv[n] = tv[tk]; nt[n] = FP; ndbl[n] = 1; tk++; 返 n; } /* double literal */
    若 (tt[tk] == VR) {
        /* 过程宏调用 (2026-08-29 P2 #172): 注册名 + ( → 编译期执行函数 → 生成代码文本 → token 化就地拼接 → 续解析表达式 */
        若 (pm_find(tn[tk]) && tt[tk + 1] == OK) {
            整 mstart = tk;
            字 mfn[64]; strcpy(mfn, tn[tk]);
            tk += 2; /* 跳过 宏名 ( — ctfe_call_str 期望 tk 在实参开始 */
            静 字 pm_gen[65536]; /* ⚠️ 静态缓冲 (fix 2026-08-29 #172): 64KB 栈局部会让 prim 帧 +64KB — parse 深递归叠加 serve_loop 1.75MB 栈帧 → 栈溢出 0xC00000FD (serve 崩基线不崩) */
            pm_gen[0] = 0;
            若 (!ctfe_call_str(mfn, pm_gen, 大小(pm_gen))) {
                循环 (tk < TS && tt[tk] != KK && tt[tk] != EK) { tk++; } 若 (tt[tk] == KK) tk++;
                sprintf(g_errbuf, "过程宏: %s 展开失败 (函数须已定义且返回字符串, 参数须编译期常量, 函数体须 CTFE 可解释纯函数)", mfn);
                emit_error("A9101", g_errbuf);
                整 n0x = Nd(0); nv[n0x] = 0; 返 n0x;
            }
            整 p_end = tk; /* ) 之后 */
            整 tail = ti - p_end;
            /* ⚠️ 拼接顺序 (fix 2026-08-29 #172): 尾部 [p_end, p_end+tail) 必须先备份 —
               pm_tokenize 落位 [mstart, mstart+gn) 在 gn 大于消费区时会覆盖尾部源,
               (平方和(3,4)→'(3*3)+(4*4)' 11>6 token → 尾部读成 '(' '4' → 表达式错乱成 call) */
            静 整 pm_tail_tt[4096]; 静 整 pm_tail_tv[4096]; 静 整 pm_tail_tl[4096];
            静 整 pm_tail_tu[4096]; 静 整 pm_tail_tll[4096]; 静 整 pm_tail_th[4096];
            静 字 pm_tail_tn[4096][64];
            整 tcap = tail; 若 (tcap > 4096) tcap = 4096;
            遍 (整 _t = 0; _t < tcap; _t++) { pm_tail_tt[_t] = tt[p_end + _t]; pm_tail_tv[_t] = tv[p_end + _t]; pm_tail_tl[_t] = tline[p_end + _t]; pm_tail_tu[_t] = tuns[p_end + _t]; pm_tail_tll[_t] = tll[p_end + _t]; pm_tail_th[_t] = tll_hi[p_end + _t]; memcpy(pm_tail_tn[_t], tn[p_end + _t], 64); }
            整 gn = pm_tokenize(pm_gen, mstart); /* 生成代码落位 [mstart, mstart+gn) */
            若 (gn <= 0) {
                sprintf(g_errbuf, "过程宏: %s 生成代码含非法字符 (token 化失败)", mfn);
                emit_error("A9102", g_errbuf);
                整 n0y = Nd(0); nv[n0y] = 0; 返 n0y;
            }
            整 dst = mstart + gn;
            若 (dst + tail >= TS) { fprintf(stderr, "[ERR] 过程宏展开后 token 溢出\n"); exit(1); }
            遍 (整 _t = 0; _t < tcap; _t++) { tt[dst + _t] = pm_tail_tt[_t]; tv[dst + _t] = pm_tail_tv[_t]; tline[dst + _t] = pm_tail_tl[_t]; tuns[dst + _t] = pm_tail_tu[_t]; tll[dst + _t] = pm_tail_tll[_t]; tll_hi[dst + _t] = pm_tail_th[_t]; memcpy(tn[dst + _t], pm_tail_tn[_t], 64); }
            ti = dst + tail;
            tk = mstart;
            返 prim(); /* 递归解析生成代码 (作表达式) */
        }
        /* NULL = 0 (fix 2026-08-03: the self-host lexer has no preprocessor, so
           <stddef.h>'s #define NULL never reaches the parser — it fell through to
           an undefined identifier and compiled to a stale-register store) */
        若 (!strcmp(tn[tk], "NULL")) { tk++; 整 n = Nd(0); nv[n] = 0; 返 n; }
        若 (!strcmp(tn[tk], "__builtin_constant_p")) { /* GCC builtin: 编译期常量判断 → 返回 0 走运行时分支 (fix 2026-08-14: bswap.h 用, 原当函数调用 → undefined symbol) */
            tk++; /* 函数名 */
            若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } /* 跳过 (args) */
            整 n = Nd(0); nv[n] = 0; 返 n;
        }
        若 (!strcmp(tn[tk], "__builtin_types_compatible_p")) { /* GCC builtin: 类型兼容判断 → 返回 0 (保守: 不兼容 → copyable=1 → BARF_UNLESS_COPYABLE 通过) (fix 2026-08-20: COPY_ARRAY 宏的 copyable 用 — 原当函数调用 → 括号/参数解析错乱 → copy_array 调用只压 1 参 → preprocess_options memcpy 参数错位 → git log 崩) */
            tk++; /* 函数名 */
            若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } /* 跳过 (typeof(...), char) — 不解析 typeof, 防括号配对破坏 */
            整 n = Nd(0); nv[n] = 0; 返 n;
        }
        若 (!strcmp(tn[tk], "offsetof")) { /* offsetof(TYPE, MEMBER) = 成员字节偏移 (fix 2026-08-14: <stddef.h> 跳过 → offsetof 未展开当函数调用 → undefined symbol; fix 2026-08-15: __typeof__(*e) 嵌套括号 + const 前缀 → ent 泄漏 undefined) */
            tk++; /* offsetof */
            若 (tt[tk] == OK) {
                tk++; /* ( */
                整 osi = -1;
                循环 (tt[tk] == VK) tk++; /* const/volatile 前缀 */
                若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { osi = st_find(tn[tk]); tk++; } } /* struct Tag */
                否 若 (tt[tk] == VR) { osi = st_find(tn[tk]); 若 (osi < 0) osi = td_st_index(tn[tk]); tk++; } /* typedef 名 — fix 2026-08-20: offsetof(z_stream, m) typedef 名≠struct名(z_stream vs z_stream_s) → st_find 失败 → off=0 → git-zlib z_stream 字段全 0 → deflate Z_MEM_ERROR */
                { 整 d = 0; 循环 (tk < TS && tt[tk] != EK) { /* 跳过剩余类型 token 到顶层逗号 (__typeof__(*e) 嵌套括号) */
                    若 (tt[tk] == CK && d == 0) 断;
                    若 (tt[tk] == KK && d == 0) 断;
                    若 (tt[tk] == OK || tt[tk] == LB) d++;
                    否 若 (tt[tk] == KK || tt[tk] == RB) d--;
                    tk++;
                } }
                整 off = 0;
                若 (tt[tk] == CK) tk++; /* , */
                若 (osi >= 0 && tt[tk] == VR) { off = st_off(stypes[osi].name, tn[tk]); tk++; } /* 字段名 */
                { 整 d = 0; 循环 (tk < TS && tt[tk] != EK) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { 若 (d <= 0) { tk++; 断; } d--; } tk++; } } /* 跳到匹配 ) */
                整 n = Nd(0); nv[n] = off; 返 n;
            }
            tk++; 整 n2 = Nd(0); nv[n2] = 0; 返 n2;
        }
        /* enum constant? */
        整 ev = e_lookup(tn[tk]);
        若 (ev != 0x80000000) { tk++; 整 n = Nd(0); nv[n] = ev; 返 n; } /* fix 2026-08-09: != 哨兵而非 >= 0 (负值常量 RED=-2) */
        若 (is_moved(tn[tk])) { 若 (asgn_lhs_parsing) { 若 (lv_moved_n < 8) { strcpy(lv_moved[lv_moved_n++], tn[tk]); } } 否 若 (!move_dst_parsing) { sprintf(g_errbuf, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能读取 (v3.0 #5)", tn[tk]); emit_error("A3101", g_errbuf); } } /* 接入 2026-08-28 机制层 #5: 移动后源彻底失效 — 右值读即 [ERR]; 左值解析期(asgn_lhs_parsing)记入缓冲由 asgn 事后判定 (赋值=重新初始化放行/非赋值=右值读报错); 移入目标(dst)是写跳过 */
        若 (uninit_has(tn[tk])) { 若 (asgn_lhs_parsing && !addr_of_parsing) { 若 (lv_uninit_n < 8) { strcpy(lv_uninit[lv_uninit_n++], tn[tk]); } } 否 若 (!move_dst_parsing && !addr_of_parsing) { sprintf(g_errbuf, "明确初始化: 变量 '%s' 未初始化就读取 (声明须初始化或先赋值, v3.0 #78)", tn[tk]); emit_error("A4001", g_errbuf); } } /* 接入 2026-08-28 机制层 #78: 读取未初始化变量 = C 头号隐蔽 bug → 编译期拦截 (赋值左值记缓冲由 asgn 事后判定/移入目标跳过); fix 2026-08-30 探雷雷6: &x 取地址不读值, addr_of_parsing 时豁免 (直接报错 + lv_uninit 缓冲登记都不做) */
        若 (borrow_mode_of(tn[tk]) == 1) { sprintf(g_errbuf, "借用检查: 变量 '%s' 被可变借用 (独占), 不能读取 (v3.0 #3)", tn[tk]); emit_error("A3001", g_errbuf); } /* 接入 2026-08-28 机制层 #3: 可变借用期间原变量冻结 */
        若 (!asgn_lhs_parsing && !move_dst_parsing) { 遍 (整 _bl = 0; _bl < borrowed_cnt; _bl++) 若 (!strcmp(borrowed_names[_bl], tn[tk])) { borrowed_lastuse[_bl] = tk; 断; } } /* 2026-08-28 type-root-3 NLL: record last-read pos */
        { 整 _cf = const_find(tn[tk]); 若 (_cf >= 0) { tk++; 整 ncf = Nd(0); nv[ncf] = const_vals[_cf]; cnst_node[ncf] = 1; 返 ncf; } } /* type-root-10 #278 const read marked */
        整 n = Nd(1); refs_record(tn[tk], tline[tk]); memcpy((字*)(nn + n), tn[tk], 64); tk++; /* 引用收集 (2026-08-28 可吞清单 P1): 变量/函数名 token 处记录 (读/写/调用统一路径) */
        若 (nullable_has(tn[tk - 1]) && (tt[tk] == AR || tt[tk] == LB)) { sprintf(g_errbuf, "可空类型: 变量 '%s' 未解包就解引用 (箭头/下标) — 先 解包 %s; (类型根治①, v3.0 #75)", tn[tk - 1], tn[tk - 1]); emit_error("A8001", g_errbuf); } /* 类型根治① (2026-08-28): 可空变量未解包解引用 → 编译期拦截 (变量在解引用符前: p->x / p[0]; 前缀 *p 在 L5412 DK 分支单独拦 — 原含 DK 条件会误伤 `可空 int x; x*2` 乘法; 判空/赋值/传参不拦, 解引用才拦) */
