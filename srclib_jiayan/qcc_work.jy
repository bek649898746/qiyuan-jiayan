静 整 str_place(整 idx);
静 整 dbl_place(整 idx);


/* printf/fprintf/putstr: build output into a frame scratch buffer, then WriteFile.
   r10=handle r11=fmt r12=buf(advancing) r14=buf(start) r13=next-format-arg ptr.
   No calls until the final WriteFile, so volatile registers are safe throughout. */
静 整 emit_fmt_loop(整 bound_disp);
/* fix 2026-08-25 支持矩阵补全: %e/%E/%g/%G 科学/通用浮点格式化 (letter 在 sc+236, is_g 在 sc+24
   由 emit_fmt_loop 分发存根在运行时设置; 每 printf 调用只发射一份核心). 64-bit scale/fracN 支持 %.16g. */
静 空 emit_fmt_float(整 tail);
静 空 emit_u64_digits(整 temp_end, 整 tail);
/* fix 2026-08-23 t35e: vsnprintf walks its va_list UP (ap, ap+8, ...); printf/sprintf walk
   the pushed arg table DOWN. emit_vsnprintf sets this so the fmt_loop advances r13 by +8. */
静 整 fmt_va_forward = 0;
静 空 mov_ri_ext(整 reg, 整 imm); /* high-reg immediate mov (defined near CRT stub) */
/* bit-field codegen helpers (real bit semantics, fix 2026-08-05).
   A bit-field lives inside a shared 32-bit slot: foffs = slot byte offset,
   fbitof = bit offset in the slot, fbits = width. All slot traffic is 4-byte. */
静 空 bf_shl_imm(整 reg, 整 cnt) { /* shl r32, cl  (cnt compile-time 0..31) */
    若 (cnt <= 0) 返;
    mov_ri_ext(9, cnt);
    mov_rr(1, 9); /* ecx = cnt */
    asm_emit("    左移 r%d, cl\n", (字*)(长 长)(reg), (字*)(长 长)0, (字*)(长 长)0);
    rex(0, 0, 0, reg & 8); b(0xD3); modrm(3, 4, reg & 7);
}
静 空 bf_extract(常 字 *sn, 常 字 *fn) {
    /* eax = whole slot value → eax = field value (shr + and; signed fields sign-extend). */
    整 bw = st_field_bitw(sn, fn);
    若 (bw <= 0) 返;
    整 bitof = st_field_bitof(sn, fn);
    整 mask = bw >= 32 ? -1 : (1u << bw) - 1; /* fix 2026-08-09 审计: 1<<31 是有符号溢出 UB, 改 1u */
    若 (bitof == 0) { mov_ri_ext(9, mask); alu_rr(25, 0, 9); } /* eax &= mask */
    否 {
        mov_rr(10, 0); /* r10d = slot value */
        mov_ri_ext(9, bitof);
        mov_rr(0, 9); /* eax = bit offset (shift count) */
        g_uns_shift = 1;
        alu_rr(T_SR, 10, 0); /* r10d >>= cl (logical) */
        mov_rr(0, 10); /* eax = shifted field value */
        mov_ri_ext(9, mask);
        alu_rr(25, 0, 9); /* eax &= mask */
    }
    若 (bw < 32 && !st_field_is_uns(sn, fn)) { /* signed bit-field: sign-extend (fix 2026-08-05) */
        mov_rr(10, 0); /* r10d = masked field value */
        mov_ri_ext(9, 32 - bw);
        mov_rr(0, 9); /* eax = 32-bw (shift count) */
        alu_rr(T_SH, 10, 0); /* r10d <<= cl → sign bit lands in bit 31 */
        g_uns_shift = 0; /* arithmetic shift for signed fields */
        alu_rr(T_SR, 10, 0); /* r10d >>= cl (sar) → sign-extended */
        mov_rr(0, 10); /* eax = result */
    }
}
静 整 bf_store(常 字 *sn, 常 字 *fn) {
    /* rax = &slot, ebx = rhs value → read-modify-write the field bits.
       Returns 1 when handled (a bit-field), 0 for a plain field.
       NEVER write eax here: eax is the low 32 bits of rax, and rax holds the
       slot ADDRESS — writing eax zeroes the upper half and loses the address. */
    整 bw = st_field_bitw(sn, fn);
    若 (bw <= 0) 返 0;
    整 bitof = st_field_bitof(sn, fn);
    整 fm = bw >= 32 ? -1 : ((1u << bw) - 1) << bitof; /* fix 2026-08-09 审计: 1u 防有符号溢出 */
    mov_reg_mreg(10, 0); /* r10d = [rax] = old slot (rax keeps the address) */
    mov_rr(11, 3); /* r11d = rhs */
    bf_shl_imm(11, bitof); /* r11d <<= bitof */
    mov_ri_ext(9, fm);
    alu_rr(25, 11, 9); /* r11d &= field-bits mask */
    mov_ri_ext(9, ~fm);
    alu_rr(25, 10, 9); /* r10d &= ~field-bits mask (clear field bits) */
    alu_rr(47, 10, 11); /* r10d |= r11d */
    asm_emit("    存32rax r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 1, 0, 0); b(0x89); modrm(0, 2, 0); /* MOV [rax], r10d */
    返 1;
}
静 空 emit_print(常 字 *fname, 整 nargs) {
    整 is_fprintf = !strcmp(fname, "fprintf");
    整 is_putstr = !strcmp(fname, "putstr");
    整 fargoff = is_fprintf ? 2 : 1;
    /* kernel32 (WriteFile) requires rsp 16-byte aligned at the call (SSE).
       Compute the format-arg pointer from the PRE-alignment rsp (the pushed args sit
       at the pre-alignment position); r15 is callee-saved so kernel32 preserves it. */
    lea_r_mrsp(13, 8 * (nargs - 1 - fargoff)); /* r13 = &first format arg (pre-alignment rsp) */
    mov_rr64(15, 4); /* mov r15, rsp */
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp, -16 */
    /* save fmt BEFORE GetStdHandle clobbers rcx. The fmt slot is at the PRE-alignment
       position: for printf it's arg0 (still in rcx); for fprintf it's arg1 = [r13+8]
       (r13 is a pre-alignment address, immune to the `and rsp,-16` shift).
       IMPORTANT: the fmt must NOT be parked in the stack shadow space ([rsp+8..32]
       at the call) �?kernel32 owns that region and clobbers it. rbx is callee-saved,
       preserved by GetStdHandle, and restored by the epilogue, so it's a safe slot. */
    若 (is_fprintf) {
        asm_emit("    取64 r0, [r13+8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x45); b(8); /* mov rax, [r13+8] = fmt (arg1) */
        mov_rr64(3, 0);    /* rbx = fmt (callee-saved, survives calls) */
        /* fix 2026-08-19: fprintf 必须写 FILE* 而非 stdout — git create_symref_locked
           fprintf(get_lock_file_fp(&lock->lk), "ref: %s\n", target) 曾全部打进 stdout
           → HEAD.lock 空/HEAD 空/残留 .lock。分派 (r10=目标, sc+248=is_fd 标志):
           fp==0 → stdout (self-host 的 stderr 值被置 0, 保持旧行为);
           fp<0x10000 → qcc fopen 的 HANDLE → WriteFile(fp,...);
           fp≥0x10000 → msvcrt fdopen 的 CRT FILE* → 取 _iobuf._file(fd)@+28 → _write(fd,...). */
        整 lfp_nz = new_label(), lfp_h = new_label(), lfp_done = new_label();
        mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 248, 0); /* is_fd = 0 — 必须先存 (mov_r_imm 会清 rax) */
        asm_emit("    取64 r0, [r13+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x45); b(16); /* mov rax, [r13+16] = fp (arg0; [r13]=首变参, [r13+8]=fmt) */
        test_rr(0, 0); jnz_rel(-1); patch_label(cp - 4, lfp_nz, 3);
        /* fp == 0 → stdout */
        mov_r_imm(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
        sub_rsp_imm(32);
        call_iat(0);       /* GetStdHandle */
        add_rsp_imm(32);
        mov_rr64(10, 0);   /* r10 = handle */
        jmp_rel(-1); patch_label(cp - 4, lfp_done, 2);
        set_label(lfp_nz);
        asm_emit("    比较64 r0, 0x10000\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x3D); b4(0x10000); /* cmp rax, 0x10000 */
        b(0x0F); b(0x82); b4(0); patch_label(cp - 4, lfp_h, 8); /* jb → HANDLE */
        /* CRT FILE* (msvcrt fdopen): _iobuf._file (fd) @ +28 (实测 msvcrt _iob: off=28 val=fd; UCRT 才是 24 — git 链 msvcrt; fix 2026-08-19) */
        b(0x8B); b(0x40); b(28); /* mov eax, [rax+28] */
        mov_rr64(10, 0);   /* r10 = fd */
        mov_r_imm(0, 1); mov_mbrp_reg(scratch_base - cur_frame_sz + 248, 0); /* is_fd = 1 */
        jmp_rel(-1); patch_label(cp - 4, lfp_done, 2);
        set_label(lfp_h);
        mov_rr64(10, 0);   /* r10 = fp (qcc fopen HANDLE) */
        set_label(lfp_done);
    } 否 {
        mov_rr64(0, 1); /* rax = rcx = fmt (arg0) */
        mov_rr64(3, 0);    /* rbx = fmt (callee-saved — survives GetStdHandle) */
        mov_r_imm(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
        sub_rsp_imm(32);   /* shadow space for GetStdHandle — fix 2026-08-03: was missing (ABI requires 32B) */
        call_iat(0);       /* eax = handle */
        add_rsp_imm(32);
        mov_rr64(10, 0);   /* r10 = handle */
    }
    mov_rr64(11, 3);   /* r11 = fmt */
    lea_r_mbrp(12, scratch_base - cur_frame_sz - 4096); /* r12 = buf — 缓冲下移到状态区之下 [rbp-4368] (fix 2026-08-06: 原与状态槽/&written 重叠) */
    mov_rr64(14, 12);  /* r14 = buf start */
    整 ldone;
    若 (is_putstr) {
        整 lcp = new_label();
        ldone = new_label();
        set_label(lcp);
        asm_emit("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
        test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ldone, 1);
        mov_r12_cl(); /* mov [r12], cl */
        asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
        asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
        jmp_rel(-1); patch_label(cp-4, lcp, 2);
    } 否 {
        ldone = emit_fmt_loop(-272); /* printf/putstr 链：%s 拷贝以 rbp-272 为界（H2 fix 2026-08-06） */
    }
    set_label(ldone);
    /* len = r12 - r14 */
    mov_rr64(0, 12); asm_emit("    减64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,0); b(0x29); modrm(3, 6, 0); /* sub rax, r14 */
    mov_rr(8, 0); /* r8 = len */
    若 (bin_mode) { /* fix 2026-08-10 Gate 9: bin printf -> ���� COM1 0x3F8, �� kernel32 */
        整 lbin_loop = new_label(), lbin_wait = new_label(), lbin_done = new_label();
        set_label(lbin_loop);
        test_rr(8, 8); jz_rel(-1); patch_label(cp-4, lbin_done, 1);
        set_label(lbin_wait);
        mov_r_imm(2, 0x3FD); /* THR status reg */
        asm_emit("    ���˿� al, dx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xEC); /* in al, dx */
        b(0xA8); b(0x20); /* test al, 0x20 (THRE) */
        jz_rel(-1); patch_label(cp-4, lbin_wait, 1);
        rex(0,0,0,1); b(0x8A); modrm(0, 0, 6); /* mov al, [r14] */
        mov_r_imm(2, 0x3F8);
        asm_emit("    д�˿� dx, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xEE); /* out dx, al */
        asm_emit("    ���� r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 6); /* inc r14 */
        rex(0,0,0,1); b(0xFF); modrm(3, 1, 0); /* dec r8d */
        jmp_rel(-1); patch_label(cp-4, lbin_loop, 2);
        set_label(lbin_done);
    } 否 {
    sub_rsp_imm(32);
    整 lwdone2 = -1;
    若 (is_fprintf) {
        /* is_fd(sc+248)==1 -> msvcrt _write(fd, buf, len); else WriteFile(handle, buf, len, &written, NULL) (fix 2026-08-19) */
        整 lwf = new_label();
        lwdone2 = new_label();
        mov_reg_mbrp(0, scratch_base - cur_frame_sz + 248); /* eax = is_fd */
        test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, lwf, 1);
        sub_rsp_imm(32); /* shadow space for _write */
        mov_rr64(1, 10); /* rcx = fd */
        mov_rr64(2, 14); /* rdx = buf */
        /* r8 = len already */
        若 (coff_mode) {
            b(0xE8); b4(0); /* call rel32 - jyld resolves _write -> msvcrt import */
            coff_crel(cp - 4, 0x0004, coff_func_name_sym("_write"), 0);
        } 否 {
            call_iat(41); /* _write IAT slot (msvcrt, 2026-08-28 P1 #246: kernel32 15→17 → _write 39→41) */
        }
        add_rsp_imm(32);
        jmp_rel(-1); patch_label(cp - 4, lwdone2, 2);
        set_label(lwf);
    }
    mov_rr64(1, 10); /* rcx = handle */
    mov_rr64(2, 14); /* rdx = buf */
    lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
    mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = 0 (8-byte NULL overlapped - arg5 at [rsp+32] per real ABI) */
    call_iat(1);       /* WriteFile */
    add_rsp_imm(32);
    若 (is_fprintf) set_label(lwdone2);
    }
    mov_rr64(4, 15); /* mov rsp, r15 �?restore original stack position */
}
静 空 emit_vfprintf(整 nargs) {
    
    /* fix 2026-08-23 t49e: vfprintf(fp, fmt, args) - fp is the qcc standard stream
       (0=stdout/stderr macro) -> route through WriteFile(GetStdHandle) exactly like the
       fprintf builtin. Direct msvcrt vfprintf(fp=0) crashes inside RtlEnterCriticalSection
       (color_vfprintf -> vfprintf(s->fp=stdout=0) -> status --short SEGV).
       Args already pushed (qcc right-to-left: args, fmt, fp) so the pre-aligned rsp holds
       [rsp]=fp, [rsp+8]=fmt, [rsp+16]=args. r15 is callee-saved (kernel32 preserves it). */
    整 lfp_nz = new_label(), lfp_h = new_label(), lfp_done = new_label();
    mov_rr64(15, 4); /* mov r15, rsp (pre-alignment) */
    若 (nargs == 3) {
        /* va_list case (color_vfprintf -> vfprintf(fp, fmt, args)): qcc pushes arg0 first (highest addr)
           -> [r15+16]=fp, [r15+8]=fmt, [r15]=args */
        asm_emit("    \xe5\x8f\x96 64 r0, [r15+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x47); b(16); /* mov rax, [r15+16] = fp */
        asm_emit("    \xe5\x8f\x96 64 r0, [r15]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x47); b(0); /* mov rax, [r15] = args */
        mov_rr64(13, 0); /* r13 = args (va_list) */
    } 否 {
        /* varargs call: [r15+8*(nargs-1)]=fp, [r15+8*(nargs-2)]=fmt, varargs start at [r15+8*(nargs-3)] */
        asm_emit("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (nargs - 1)), (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x47); b(8 * (nargs - 1) & 0xff); /* mov rax, [r15+8*(nargs-1)] = fp */
        lea_r_mrsp(13, 8 * (nargs - 3)); /* r13 = &first vararg */
    }
    asm_emit("    \xe5\xaf\xb9\xe9\xbd\x90\xe6\xa0\x88\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp, -16 */
    /* fmt -> rbx (callee-saved, survives GetStdHandle); fp stays in rax for dispatch */
    若 (nargs == 3) {
        asm_emit("    \xe5\x8f\x96 64 r0, [r15+8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x47); b(8); /* mov rax, [r15+8] = fmt */
        mov_rr64(3, 0); /* rbx = fmt */
        asm_emit("    \xe5\x8f\x96 64 r0, [r15+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x47); b(16); /* mov rax, [r15+16] = fp */
    } 否 {
        asm_emit("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (nargs - 2)), (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x47); b(8 * (nargs - 2) & 0xff); /* mov rax, [r15+8*(nargs-2)] = fmt */
        mov_rr64(3, 0); /* rbx = fmt */
        asm_emit("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (nargs - 1)), (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x47); b(8 * (nargs - 1) & 0xff); /* mov rax, [r15+8*(nargs-1)] = fp */
    }
    /* fp dispatch: fp==0 -> stdout (GetStdHandle); fp<0x10000 -> qcc fopen HANDLE; else CRT FILE* -> _file fd */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 248, 0); /* is_fd = 0 */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp - 4, lfp_nz, 3);
    mov_r_imm(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
    sub_rsp_imm(32); call_iat(0); add_rsp_imm(32); /* GetStdHandle */
    mov_rr64(10, 0); /* r10 = handle */
    jmp_rel(-1); patch_label(cp - 4, lfp_done, 2);
    set_label(lfp_nz);
    asm_emit("    \xe6\xaf\x94\xe8\xbe\x83 64 r0, 0x10000\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x3D); b4(0x10000); /* cmp rax, 0x10000 */
    b(0x0F); b(0x82); b4(0); patch_label(cp - 4, lfp_h, 8); /* jb -> HANDLE */
    b(0x8B); b(0x40); b(28); /* mov eax, [rax+28] = _file fd */
    mov_rr64(10, 0); /* r10 = fd */
    mov_r_imm(0, 1); mov_mbrp_reg(scratch_base - cur_frame_sz + 248, 0); /* is_fd = 1 */
    jmp_rel(-1); patch_label(cp - 4, lfp_done, 2);
    set_label(lfp_h);
    mov_rr64(10, 0); /* r10 = fp (HANDLE) */
    set_label(lfp_done);
    mov_rr64(11, 3); /* r11 = fmt */
    lea_r_mbrp(12, scratch_base - cur_frame_sz - 4096); /* r12 = buf */
    mov_rr64(14, 12); /* r14 = buf start */
    整 ldone = emit_fmt_loop(-272);
    set_label(ldone);
    /* len = r12 - r14 */
    mov_rr64(0, 12); asm_emit("    \xe5\x87\x8f 64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,0); b(0x29); modrm(3, 6, 0); /* sub rax, r14 */
    mov_rr(8, 0); /* r8 = len */
    sub_rsp_imm(32);
    整 lwf = new_label();
    整 lwdone2 = new_label();
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 248); /* eax = is_fd */
    test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, lwf, 1);
    sub_rsp_imm(32); /* shadow space for _write */
    mov_rr64(1, 10); /* rcx = fd */
    mov_rr64(2, 14); /* rdx = buf */
    若 (coff_mode) { b(0xE8); b4(0); coff_crel(cp - 4, 0x0004, coff_func_name_sym("_write"), 0); }
    否 call_iat(41); /* _write (2026-08-28 P1 #246: 39→41) */
    add_rsp_imm(32);
    jmp_rel(-1); patch_label(cp - 4, lwdone2, 2);
    set_label(lwf);
    mov_rr64(1, 10); /* rcx = handle */
    mov_rr64(2, 14); /* rdx = buf */
    lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
    mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = 0 overlapped */
    call_iat(1); /* WriteFile */
    add_rsp_imm(32);
    set_label(lwdone2);
    mov_rr64(4, 15); /* mov rsp, r15 */
}


/* fix 2026-08-12 scanf: args already pushed (fmt first, then &a, &b...).
   Read stdin (GetStdHandle(-10) + ReadFile) into [rbp-4368] buf, then call
   _scanf_rt(fmt, args, buf, len) from qcc_rt.c to parse fmt and write back.
   Returns count of converted items in eax. */
静 空 emit_scanf(整 nargs) {
    整 ffi = func_find("_scanf_rt");
    lea_r_mrsp(13, 8 * (nargs - 1)); /* r13 = &fmt (arg0, pushed first = deepest; args at [r13+8..]) */
    mov_rr64(15, 4); /* r15 = pre-alignment rsp */
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp, -16 */
    mov_r_imm(1, -10); /* ecx = -10 = STD_INPUT_HANDLE */
    sub_rsp_imm(32);
    call_iat(0); /* eax = stdin handle */
    add_rsp_imm(32);
    mov_rr64(10, 0); /* r10 = handle */
    lea_r_mbrp(12, scratch_base - cur_frame_sz - 4096); /* r12 = buf (callee-saved — ReadFile clobbers r11, 同 printf) */
    lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz);   /* r9 = &read */
    sub_rsp_imm(48);
    mov_rr64(1, 10); mov_rr64(2, 12);
    mov_ri_ext(8, 4096);
    mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = 0 (overlapped) */
    call_iat(3); /* ReadFile */
    add_rsp_imm(48);
    mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes read */
    mov_rr64(9, 0); /* r9 = len */
    asm_emit("    取64 r1, [r13]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x4D); b(0); /* rcx = fmt */
    /* 构造正序 args 数组到 [rbp+aoff]: args[k] = [r13-8-8k] 槽值 (参数按 fmt,&a,&b 压栈 → &a 在 [r13-8], &b 在 [r13-16]...).
       负索引 args[-argi] 在 qcc 编译会丢符号 (2026-08-12) → 显式正序拷贝. */
    { 整 aoff = -(272 + 8 * nargs);
      遍 (整 k = 0; k < nargs - 1; k++) {
          asm_emit("    取64 r0, [r13%+d]\n", (字*)(长 长)(-(8 + 8 * k)), (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x45); b(-(8 + 8 * k)); /* mov rax, [r13-8-8k] */
          asm_emit("    存64 [rbp%+d], r0\n", (字*)(长 长)(aoff + 8 * k), (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x89); modrm(2, 0, 5); b4(aoff + 8 * k); /* mov [rbp+aoff+8k], rax */
      }
      lea_r_mbrp(2, aoff); /* rdx = args 数组 */
    }
    mov_rr64(8, 12); /* r8 = buf */
    若 (ffi >= 0) { /* _scanf_rt(fmt=rcx, args=rdx, buf=r8, len=r9, consumed=NULL) */
        sub_rsp_imm(48); /* shadow 32 + 5th arg 8 + pad 8 */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL (consumed 不需要 — scanf 无续读) */
        call_rel(0);
        patch_label(cp - 4, func_tbl[ffi].label, 0);
        add_rsp_imm(48);
    }
    mov_rr64(4, 15); /* rsp = r15 (restore pre-alignment) */
}

/* sscanf(str, fmt, &a, ...): buf=arg0, fmt=arg1, args=arg2.. — 复用 _scanf_rt(fmt,args,buf,len) (fix 2026-08-25 step11) */
静 空 emit_sscanf(整 nargs) {
    整 ffi = func_find("_scanf_rt");
    整 abase = 8 * (nargs - 1); /* arg0 槽偏移 (rsp 相对): 参数从栈深向浅 arg0=[rsp+abase], arg1=[rsp+abase-8], arg2+k=[rsp+abase-16-8k] */
    mov_rr64(15, 4); /* r15 = pre-alignment rsp */
    mov_reg_mrsp64(8, abase);      /* r8 = arg0 (str/buf) */
    /* r9 = strlen(str): r8 扫描到 \0 */
    mov_rr64(11, 8); /* r11 = buf 保存 */
    mov_r_imm(0, 0); /* eax = 0 (len) */
    整 ls2 = new_label(), ld2 = new_label();
    set_label(ls2);
    asm_emit("    零扩展 ecx, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0x0F); b(0xB6); modrm(0, 1, 0); /* movzx ecx, byte [r8] */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ld2, 1);
    asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 1); b(0xFF); modrm(3, 0, 0); /* inc r8 */
    asm_emit("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xFF); b(0xC0); /* inc eax */
    jmp_rel(-1); patch_label(cp-4, ls2, 2);
    set_label(ld2);
    mov_rr64(9, 0);  /* r9 = len */
    mov_rr64(8, 11); /* r8 = buf (恢复) */
    mov_reg_mrsp64(1, abase - 8);  /* rcx = arg1 (fmt) */
    /* args 数组: arg2+k = [rsp+abase-16-8k] → [rbp+aoff+8k] */
    { 整 aoff = -(272 + 8 * (nargs - 2));
      遍 (整 k = 0; k < nargs - 2; k++) {
          mov_reg_mrsp64(0, abase - 16 - 8 * k); /* rax = arg2+k */
          asm_emit("    存64 [rbp%+d], r0\n", (字*)(长 长)(aoff + 8 * k), (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x89); modrm(2, 0, 5); b4(aoff + 8 * k); /* mov [rbp+aoff+8k], rax */
      }
      lea_r_mbrp(2, aoff); /* rdx = args */
    }
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
    sub_rsp_imm(48);
    mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL (consumed — sscanf 无续读) */
    若 (ffi >= 0) { call_rel(0); patch_label(cp - 4, func_tbl[ffi].label, 0); }
    add_rsp_imm(48);
    mov_rr64(4, 15); /* rsp = r15 */
}

/* fscanf(fp, fmt, &a, ...): 从 FILE*(HANDLE) 读 4096 字节到 buf, 复用 _scanf_rt (fix 2026-08-25 step12)
   续读 (fix step23): _scanf_rt 报告 consumed, 未消费部分 SetFilePointer 回退 — 多次 fscanf 同 FILE* 连续解析 */
静 空 emit_fscanf(整 nargs) {
    整 ffi = func_find("_scanf_rt");
    整 abase = 8 * (nargs - 1); /* arg0 = fp, arg1 = fmt, arg2+k = args (rsp 相对) */
    mov_reg_mrsp64(0, abase); /* rax = arg0 (fp/handle) */
    mov_rr64(10, 0);          /* r10 = handle */
    mov_mbrp_reg64(scratch_base + 260 - cur_frame_sz, 10); /* 保存 handle 到 scratch (8B, 独立槽 — 原 252 与 consumed@256 重叠高32位被污染) */
    lea_r_mbrp(12, scratch_base - cur_frame_sz - 4096); /* r12 = buf */
    lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz);   /* r9 = &read */
    mov_rr64(15, 4);
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
    sub_rsp_imm(48); /* shadow 32 + 1 stack arg 8 + pad 8 */
    mov_rr64(1, 10); mov_rr64(2, 12);
    mov_ri_ext(8, 4096);
    mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL (overlapped) */
    call_iat(3); /* ReadFile */
    add_rsp_imm(48);
    mov_rr64(4, 15);
    mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes read */
    asm_emit("    存32 [rbp%+d], eax\n", (字*)(长 长)(scratch_base + 248 - cur_frame_sz), (字*)(长 长)0, (字*)(长 长)0); b(0x89); modrm(2, 0, 5); b4(scratch_base + 248 - cur_frame_sz); /* 存 bytes_read 供回退计算 (fix step23; modrm rm=5=rbp 非 rax) */
    mov_rr64(9, 0);  /* r9 = len */
    mov_rr64(8, 12); /* r8 = buf */
    mov_reg_mrsp64(1, abase - 8);  /* rcx = fmt (arg1) */
    { 整 aoff = -(272 + 8 * (nargs - 2));
      遍 (整 k = 0; k < nargs - 2; k++) {
          mov_reg_mrsp64(0, abase - 16 - 8 * k); /* rax = arg2+k */
          asm_emit("    存64 [rbp%+d], r0\n", (字*)(长 长)(aoff + 8 * k), (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x89); modrm(2, 0, 5); b4(aoff + 8 * k); /* mov [rbp+aoff+8k], rax */
      }
      lea_r_mbrp(2, aoff); /* rdx = args */
    }
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
    sub_rsp_imm(48);
    lea_r_mbrp(0, scratch_base + 256 - cur_frame_sz); mov_mrsp_reg64(32, 0); /* [rsp+32] = &consumed (5th arg, fix step23) */
    若 (ffi >= 0) { call_rel(0); patch_label(cp - 4, func_tbl[ffi].label, 0); }
    add_rsp_imm(48);
    /* 保存 fscanf 返回值 (eax=argi) — 后续回退计算会破坏 eax (fix step23: 原 n=0 / SetFilePointer 返回值覆盖) */
    asm_emit("    存32 [rbp%+d], eax\n", (字*)(长 长)(scratch_base + 244 - cur_frame_sz), (字*)(长 长)0, (字*)(长 长)0); b(0x89); modrm(2, 0, 5); b4(scratch_base + 244 - cur_frame_sz);
    /* 续读回退: leftover = bytes_read - consumed; leftover>0 时 SetFilePointer(handle, -leftover, NULL, FILE_CURRENT=1) — 未消费字节下次 fscanf 重新读到 (fix step23) */
    mov_reg_mbrp64(0, scratch_base + 260 - cur_frame_sz); mov_rr64(10, 0); /* r10 = handle (从独立槽重载 — r10 易失且对齐后栈槽偏移) */
    mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes_read */
    mov_reg_mbrp(1, scratch_base + 256 - cur_frame_sz); /* ecx = consumed */
    asm_emit("    减 r0, r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x29); modrm(3, 1, 0); /* sub eax, ecx → leftover */
    { 整 lskip = new_label();
      test_rr(0, 0); jz_rel(-1); patch_label(cp - 4, lskip, 1); /* leftover==0 → 跳过回退 */
      asm_emit("    取反 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xD8); /* neg eax → -leftover */
      mov_rr64(1, 10);  /* rcx = handle */
      mov_rr64(2, 0);   /* rdx = -leftover (回退距离) */
      mov_ri_ext(8, 0); /* r8 = NULL (lpDistanceToMoveHigh) */
      mov_ri_ext(9, 1); /* r9 = FILE_CURRENT */
      asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
      sub_rsp_imm(32);
      call_iat(5); /* SetFilePointer */
      add_rsp_imm(32);
      set_label(lskip);
    }
    mov_reg_mbrp(0, scratch_base + 244 - cur_frame_sz); /* eax = 恢复 fscanf 返回值 (fix step23) */
    mov_rr64(4, 15); /* rsp = r15 */
}

/* shared %d/%s/%c/%% format loop: r11=fmt r12=out(advancing) r13=next-arg ptr.
   Returns the ldone label the caller must set_label() after the loop. */
/* shared decimal-digit emitter: prints |ebx| (with '-' sign) into the r12 buffer,
   then jumps to `tail`. Used by %d (tail=lfmt) and %f (tail=lfnum fractional path). */
静 空 emit_digits(整 tail) {
    整 lsign = new_label(), lplus1 = new_label(), ldig = new_label(), lcpd = new_label(); /* fix 2026-08-23 t35g */
    lea_r_mbrp(8, scratch_base + 248 + 12 - cur_frame_sz); /* r8 = digit temp end */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 4); /* eax = sign_done (fix 2026-08-23 t35g: ld 已提前输出) */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, lsign, 1); /* sign 已输出 → 直接数字 */
    test_rr(3, 3); b(0x0F); b(0x89); b4(0); patch_label(cp-4, lplus1, 4); /* jns: + 标志检查 (fix 2026-08-23 t35g) */
    mov_r_imm(0, '-'); mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_rr(0, 3); asm_emit("    取反 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xD8); mov_rr(3, 0); /* eax = -value; ebx = -value */
    jmp_rel(-1); patch_label(cp-4, lsign, 2);
    set_label(lplus1);
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 0); /* eax = plus flag */
    test_rr(0, 0); jz_rel(-1); patch_label(cp-4, lsign, 1);
    mov_r_imm(0, '+'); mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    set_label(lsign);
    mov_rr(0, 3); /* eax = value (positive) */
    set_label(ldig);
    asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 10); /* ecx = 10 */
    asm_emit("    整除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xF9); /* idiv ecx: eax=quot, edx=rem */
    asm_emit("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
