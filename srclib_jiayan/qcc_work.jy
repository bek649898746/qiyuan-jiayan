                    若 (first_var) 遍 (整 pk = save_tk; pk < tk; pk++) 若 (tt[pk] == DK) lead_ptr++; /* fix 2026-08-16 根因D: 循环变量 p 遮蔽 parse 根节点 p (L4760 int p=Nd(3)), qcc 按名复用槽 → 循环写坏根 p → fdef 全挂错节点 → 解析树成环 → oidmap 无限递归。改名 pk 隔离作用域。 */
                    循环 (tt[tk] == DK) { lead_ptr++; tk++; }
