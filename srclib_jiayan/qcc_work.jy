否 若 (fsz == 2) { 若 (st_field_is_uns(stypes[s].name, fn)) ir_emit(I_MOVZX_RAX_WORD, 0, 0, 0); 否 ir_emit(I_MOVSX_RAX_WORD, 0, 0, 0); ir_flush(); } /* Phase3-IR case15: static short (fix bug#33) */
                    否 { ir_emit(I_DEREF32, 0, 0, 0); ir_flush(); 若 (st_field_bitw(stypes[s].name, fn) > 0) bf_extract(stypes[s].name, fn); 若 (st_field_is_uns(stypes[s].name, fn)) nuns[n] = 1; } /* Phase3-IR case15: static dword + bit-field — fix 2026-08-30 csmith t5: unsigned 字段 nuns (s35 g_275.f0 uint32 传 uint64 参数被 movsxd 符号扩展) */
