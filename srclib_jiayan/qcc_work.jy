    asm_emit("    减字节 r1, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xE9); b('0'); /* sub cl, '0' -> digit */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 232); /* eax = W */
