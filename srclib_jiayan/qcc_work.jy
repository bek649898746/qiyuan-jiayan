    若 (tt[tk] == VR && !strcmp(tn[tk], "反转")) { /* 接入 2026-08-27 反转 (reverse 数组): 反转 arr, n; → { __rv=0; while(__rv<n/2){ 交换 arr[__rv], arr[n-1-__rv]; __rv++; } } — 就地反转, 内联三步交换 */
