            整 td_isdbl = 0; /* typedef double real — remember base type for globals/locals */
            整 td_isuns = 0; /* typedef unsigned ... — 基类型 unsigned 标记 (fix 2026-08-18: size_t = unsigned long long → is_uns 传播) */
