    若 (tt[tk] == VR && (!strcmp(tn[tk], "置位") || !strcmp(tn[tk], "清位") || !strcmp(tn[tk], "翻位") || !strcmp(tn[tk], "读位"))) { /* 接入 2026-08-28 位操作 (bit ops): 置位 x, i → x|=1<<i; 清位 x, i → x&=~(1<<i); 翻位 x, i → x^=1<<i; 读位 b, x, i → b=(x>>i)&1 — 位操作语法糖 */
