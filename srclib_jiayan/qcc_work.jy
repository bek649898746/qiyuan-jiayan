                循环 (tt[tk] == DT || tt[tk] == AR) {
                    tk++; /* -> / . */
                    若 (tt[tk] == VR) {
                        若 (si >= 0) {
                            整 fty = st_field_ty_idx(stypes[si].name, tn[tk]);
                            若 (st_field_is_ptr(si, tn[tk])) {
                                整 pel = st_field_pel(si, tn[tk]);
                                若 (pel > 0) sz = pel; /* 指针字段: sizeof(*p->field) = 指向元素/结构大小 */
                                si = fty >= 0 ? fty : -1;
                            } 否 若 (fty >= 0) {
                                si = fty; sz = stypes[si].sz; /* struct 字段: 下钻, 中间值=结构大小 */
                            } 否 {
                                整 fs2 = st_field_size(stypes[si].name, tn[tk]);
                                若 (fs2 > 0) sz = fs2; /* 标量字段: sizeof(*p->ch) = 1 */
                                si = -1;
                            }
                        }
                        tk++;
                    } 否 断;
                }
            }
            循环 (tt[tk] == KK && np2 > 0) { np2--; tk++; } /* 内层闭合括号 (计数配对 — fix 2026-08-19) */
            若 (tt[tk] == KK) tk++; /* sizeof 自身的外层 ) */
            整 n = Nd(0); nv[n] = sz; 返 n;
        }
        返 -1;
    }
    若 (tt[tk] == NK) { 整 n = Nd(0); nv[n] = tv[tk]; 若 (tuns[tk]) nuns[n] = 1; 若 (tll[tk]) { nll[n] = 1; nll_hi[n] = tll_hi[tk]; } tk++; 返 n; } /* u-/LL-suffix literals → flags (fix 2026-08-05) */
    若 (tt[tk] == FP) { 整 n = Nd(0); nv[n] = tv[tk]; nt[n] = FP; ndbl[n] = 1; tk++; 返 n; } /* double literal */
    若 (tt[tk] == VR) {
        /* NULL = 0 (fix 2026-08-03: the self-host lexer has no preprocessor, so
           <stddef.h>'s #define NULL never reaches the parser — it fell through to
           an undefined identifier and compiled to a stale-register store) */
        若 (!strcmp(tn[tk], "NULL")) { tk++; 整 n = Nd(0); nv[n] = 0; 返 n; }
        若 (!strcmp(tn[tk], "__builtin_constant_p")) { /* GCC builtin: 编译期常量判断 → 返回 0 走运行时分支 (fix 2026-08-14: bswap.h 用, 原当函数调用 → undefined symbol) */
            tk++; /* 函数名 */
            若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } /* 跳过 (args) */
            整 n = Nd(0); nv[n] = 0; 返 n;
        }
        若 (!strcmp(tn[tk], "__builtin_types_compatible_p")) { /* GCC builtin: 类型兼容判断 → 返回 0 (保守: 不兼容 → copyable=1 → BARF_UNLESS_COPYABLE 通过) (fix 2026-08-20: COPY_ARRAY 宏的 copyable 用 — 原当函数调用 → 括号/参数解析错乱 → copy_array 调用只压 1 参 → preprocess_options memcpy 参数错位 → git log 崩) */
            tk++; /* 函数名 */
            若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } /* 跳过 (typeof(...), char) — 不解析 typeof, 防括号配对破坏 */
            整 n = Nd(0); nv[n] = 0; 返 n;
        }
        若 (!strcmp(tn[tk], "offsetof")) { /* offsetof(TYPE, MEMBER) = 成员字节偏移 (fix 2026-08-14: <stddef.h> 跳过 → offsetof 未展开当函数调用 → undefined symbol; fix 2026-08-15: __typeof__(*e) 嵌套括号 + const 前缀 → ent 泄漏 undefined) */
            tk++; /* offsetof */
            若 (tt[tk] == OK) {
                tk++; /* ( */
                整 osi = -1;
                循环 (tt[tk] == VK) tk++; /* const/volatile 前缀 */
                若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { osi = st_find(tn[tk]); tk++; } } /* struct Tag */
                否 若 (tt[tk] == VR) { osi = st_find(tn[tk]); 若 (osi < 0) osi = td_st_index(tn[tk]); tk++; } /* typedef 名 — fix 2026-08-20: offsetof(z_stream, m) typedef 名≠struct名(z_stream vs z_stream_s) → st_find 失败 → off=0 → git-zlib z_stream 字段全 0 → deflate Z_MEM_ERROR */
                { 整 d = 0; 循环 (tk < TS && tt[tk] != EK) { /* 跳过剩余类型 token 到顶层逗号 (__typeof__(*e) 嵌套括号) */
                    若 (tt[tk] == CK && d == 0) 断;
                    若 (tt[tk] == KK && d == 0) 断;
                    若 (tt[tk] == OK || tt[tk] == LB) d++;
                    否 若 (tt[tk] == KK || tt[tk] == RB) d--;
                    tk++;
                } }
                整 off = 0;
