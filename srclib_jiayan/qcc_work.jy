静 整 stc_disp(整 idx) { 返 (data_rva_base + DATA_RVA_OFF + 4 * idx) - (0x1000 + cp + 6); }
/* IAT entry (kernel32): slot 0=GetStdHandle at .data+8, 1=WriteFile at .data+0x10 */
静 整 iat_disp_at(整 at, 整 slot) { 整 iat_off = slot < 8 ? (8 + 8 * slot) : (0x50 + 8 * (slot - 8)); 返 (data_rva_base + iat_off) - (0x1000 + at + 6); } /* IAT1@+0x08 kernel32 / IAT2@+0x50 msvcrt（fix 2026-08-06 BUG-1） */
静 空 call_iat(整 slot) {
    asm_emit("    调系统 %d\n", (字*)(长 长)(slot), (字*)(长 长)0, (字*)(长 长)0);
    整 at = cp; /* instruction start (FF 15 + disp32 = 6 bytes) */
    b(0xFF); b(0x15);
    若 (coff_mode) {
        静 常 字 *impn[25] = { "__imp_GetStdHandle", "__imp_WriteFile", "__imp_CreateFileA",
            "__imp_ReadFile", "__imp_VirtualAlloc", "__imp_SetFilePointer", "__imp_ExitProcess", "__imp_GetCommandLineA",
            "__imp_pow", "__imp_atan2", "__imp_fmod", "__imp_remainder", "__imp_sqrt", "__imp_cbrt", "__imp_cos", "__imp_sin",
            "__imp_tan", "__imp_acos", "__imp_asin", "__imp_atan", "__imp_log", "__imp_log10", "__imp_exp", "__imp_floor",
            "__imp__write" };
        b4(0);
        coff_crel(at + 2, 0x0004, coff_func_name_sym(impn[slot]), 0);
        返;
    }
    b4(iat_disp_at(at, slot));
}
/* 外部数学函数 → IAT slot 8-31（非 coff 模式；fix 2026-08-06 BUG-1; 2026-08-25 math24: 16→24, frexp/ldexp/modf 走混合 ABI 专用分支） */
静 整 fn_math_iat(常 字 *n) {
    静 常 字 *maths[24] = { "pow","atan2","fmod","sqrt","cos","sin","tan","acos","asin","atan","log","log10","exp","floor","ceil","fabs","cosh","sinh","tanh","copysign","hypot","frexp","ldexp","modf" };
    遍 (整 i = 0; i < 24; i++) 若 (!strcmp(maths[i], n)) 返 8 + i;
    返 -1;
