    若 (tt[tk] == VR && !strcmp(tn[tk], "归并")) { /* 接入 2026-08-27 归并 (merge 有序数组合并): 归并 dst, a, na, b, nb; → 双指针合并两个有序数组到 dst (升序, 输出数组须够大). 结构: 主 while(__mi<na){ if(__mj<nb && a[__mi]<b[__mj]) 取a else 取b } + 剩余 a + 剩余 b */
        tk++; /* 归并 */
