                    i++;
                    整 j = 0;
                    循环 (s[i] && s[i] != '"' && j < 2046) {
                        若 (s[i] == '\\' && s[i + 1]) { i++; 若 (s[i] == 'n') str_macros[str_macro_n].val[j++] = '\n'; 否 若 (s[i] == 't') str_macros[str_macro_n].val[j++] = '\t'; 否 若 (s[i] == '0') str_macros[str_macro_n].val[j++] = 0; 否 str_macros[str_macro_n].val[j++] = s[i]; }
                        否 str_macros[str_macro_n].val[j++] = s[i];
                        i++;
                    }
                    str_macros[str_macro_n].val[j] = 0;
                    若 (s[i] == '"') i++;
                    strcpy(str_macros[str_macro_n].name, mname);
                    str_macro_n++;
                    循环 (s[i] && s[i] != '\n') i++; /* skip rest of line */
                    续;
                }
                整 msign = 1;
                若 (s[i] == '-') { msign = -1; i++; } /* fix 2026-08-06: #define NEG -5 负号被丢弃 → NEG 注册为 0 (#if NEG < 0 假) */
                若 (s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) { i += 2; 循环 (isxdigit(s[i])) { 整 c = s[i]; 若 (c >= '0' && c <= '9') mval = mval * 16 + (c - '0'); 否 若 (c >= 'a' && c <= 'f') mval = mval * 16 + (c - 'a' + 10); 否 mval = mval * 16 + (c - 'A' + 10); i++; } }
                否 若 (s[i] == '0' && s[i + 1] >= '0' && s[i + 1] <= '7') { /* 八进制 0170000 = 61440 (fix 2026-08-17: 原无八进制 → git S_IFMT 0170000 存成十进制 170000 → S_IS* 模式检查全错, is_directory 恒 false) */
                    循环 (s[i] >= '0' && s[i] <= '7') { mval = mval * 8 + (s[i++] - '0'); }
                }
                否 { 循环 (isdigit(s[i])) { mval = mval * 10 + (s[i++] - '0'); } }
                { 整 muns = 0, mll = 0;
                  若 (s[i] == 'u' || s[i] == 'U') { muns = 1; i++; 循环 (s[i] == 'l' || s[i] == 'L') { mll = 1; i++; } }
                  否 若 (s[i] == 'l' || s[i] == 'L') { 循环 (s[i] == 'l' || s[i] == 'L') { mll = 1; i++; } 若 (s[i] == 'u' || s[i] == 'U') { muns = 1; i++; } }
                  macro_add_full(mname, msign * (整)mval, muns, mll, (整)(mval >> 32)); }
            }
            循环 (s[i] && s[i] != '\n') { 若 (s[i] == '/' && s[i + 1] == '*') { i += 2; 循环 (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++; 若 (s[i]) i += 2; 续; } 若 (s[i] == '/' && s[i + 1] == '/') { 循环 (s[i] && s[i] != '\n') i++; 续; } 若 (s[i] == '\\' && s[i + 1] == '\n') { i += 2; 续; } 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') { i += 3; 续; } i++; } /* skip directive line incl. backslash continuations and multi-line block comments (fix 2026-08-15) */
            续;
        }
        若 (s[i] == '\'') { /* char literal 'c' */
            i++;
            整 cval = 0;
            若 (s[i] == '\\') {
                i++;
                若 (s[i] == 'x') { i++; 整 hv = 0; 循环 (isxdigit((无 字)s[i])) { 整 c = s[i]; hv = hv * 16 + (c >= '0' && c <= '9' ? c - '0' : (c >= 'a' && c <= 'f' ? c - 'a' + 10 : c - 'A' + 10)); i++; } cval = hv; }
                否 若 (s[i] >= '0' && s[i] <= '7') { /* 八进制转义 '\033' — 原只吃 1 位, 剩余 33' 重新 lex → token 错位, non_ascii 函数体吞掉后续顶层函数 (fix 2026-08-15: pretty.c len undefined) */
                    整 ov = 0, nd = 0;
                    循环 (nd < 3 && s[i] >= '0' && s[i] <= '7') { ov = ov * 8 + (s[i] - '0'); i++; nd++; }
                    cval = ov;
                }
                否 { cval = s[i]=='n'?10:s[i]=='t'?9:s[i]=='r'?13:s[i]=='v'?11:s[i]=='f'?12:s[i]=='0'?0:s[i]=='\\'?92:s[i]=='\''?39:s[i]; i++; }
