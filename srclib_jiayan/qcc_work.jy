                遍 (整 ti2 = save_tk; ti2 < tk; ti2++) 若 (tt[ti2] == VK && !strcmp(tn[ti2], "signed")) { 遍 (整 tj2 = ti2 + 1; tj2 < tk; tj2++) 若 (tt[tj2] == VK && !strcmp(tn[tj2], "char")) { g_is_csgn = 1; } }
                若 (!g_is_csgn) { 整 tdi_gc = g_tdef >= 0 ? g_tdef : tdef_lookup(tn[save_tk]); 若 (tdi_gc >= 0 && !tdefs[tdi_gc].is_struct && !tdefs[tdi_gc].is_fnptr && !tdefs[tdi_gc].is_dbl && tdefs[tdi_gc].sz == 1 && !tdefs[tdi_gc].is_uns) g_is_csgn = 1; } /* typedef signed char 全局 (int8_t) */
                整 g_is_short = 0; /* fix 2026-08-19: 全局 short 数组元素 2 字节 (原 4 → FindFirstFileW pattern 步长错) */
