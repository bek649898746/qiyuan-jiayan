                            cg_frows[0] = pel;
                            cg_frows[1] = st_field_ffin(s, fn); /* fix 2026-08-22 t41b: 双指针字段第二维缩放 */
                            cg_fdepth_max = (st_field_fdeep(s, fn) >= 2) ? 2 : 1; /* fix 2026-08-30 csmith: 单指针字段也须 deref (m->table[i] — fdeep 回退 1 时双指针漏设 → case-14 不 deref 返回地址) */
