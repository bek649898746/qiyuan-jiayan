   >4 for struct/array fields → address semantics). Returns 0 on success. */
静 整 mem_addr(整 n, 整 *fsz_out, 整 *si_out);


静 整 var_arrsz(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].arr_sz;
    返 0;
