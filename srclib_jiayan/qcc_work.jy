                若 (v1 >= 0 && nt[v1] == 0) { 整 cv = nv[v1]; 遍 (整 j = 0; j < ncase; j++) { 若 (guard_vals[j] < 0 && ((vals[j] >= 0 && nt[vals[j]] == 0 && nv[vals[j]] == cv) || (or_vals[j] >= 0 && nt[or_vals[j]] == 0 && nv[or_vals[j]] == cv))) { fprintf(stderr, "[ERR] 冗余模式: 值 #%d 已被前臂匹配 (不可达分支, v3.0 #142)\n", cv); exit(1); } } }
                若 (v2 >= 0 && nt[v2] == 0) { 整 cv2 = nv[v2]; 遍 (整 j = 0; j < ncase; j++) { 若 (guard_vals[j] < 0 && ((vals[j] >= 0 && nt[vals[j]] == 0 && nv[vals[j]] == cv2) || (or_vals[j] >= 0 && nt[or_vals[j]] == 0 && nv[or_vals[j]] == cv2))) { fprintf(stderr, "[ERR] 冗余模式: 值 #%d 已被前臂匹配 (不可达分支, v3.0 #142)\n", cv2); exit(1); } } }
                vals[ncase] = v1; ress[ncase] = res; or_vals[ncase] = v2; guard_vals[ncase] = guard;
                bind_ref[ncase] = is_bind; strcpy(bind_names[ncase], bind_name);
                ncase++;
            } 否 { 若 (tt[tk] == SK) tk++; 断; }
            若 (tt[tk] == CK) { tk++; 续; }
            若 (tt[tk] == SK) { tk++; 断; }
            断;
        }
        /* 穷尽性检查 (接入 2026-08-28 #141): case 常量值覆盖 0..vcnt-1 — 缺变体 → [ERR] fail-closed */
        若 (exh_vcnt > 0) {
            字 covered[64]; 遍 (整 i = 0; i < 64; i++) covered[i] = 0;
            遍 (整 i = 0; i < ncase; i++) 若 (vals[i] >= 0 && nt[vals[i]] == 0) { 整 v = nv[vals[i]]; 若 (v >= 0 && v < 64 && v < exh_vcnt) covered[v] = 1; }
            遍 (整 i = 0; i < exh_vcnt; i++) 若 (!covered[i]) { fprintf(stderr, "[ERR] 模式匹配非穷尽: 判别 '%s' 缺变体 #%d (穷尽性检查, v3.0 #141)\n", exh_name, i); exit(1); }
        }
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); Nc(d, e_sel); Nc(blk, d); } /* int __sw = x; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), rn2, 32);
          若 (has_def) Nc(d, e_def); 否 { 整 zero = Nd(0); nv[zero] = 0; Nc(d, zero); }
          Nc(blk, d); } /* int __sr = 其他值/0; */
        静 整 sw_seq3 = 0; 字 mname[64]; sprintf(mname, "__sm_%d_", sw_seq3++);
        var_offset(mname);
        { 整 d = Nd(7); memcpy((字*)(nn + d), mname, 32); 整 z = Nd(0); nv[z] = 0; Nc(d, z); Nc(blk, d); } /* int __sm = 0; 已匹配标志 (2026-08-28 P1 #133: 防守卫命中后后续臂覆盖) */
        { 整 i;
          遍 (i = 0; i < ncase; i++) {
              整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
              整 cmp;
              若 (bind_ref[i]) { cmp = Nd(2); nv[cmp] = T_QK; Nc(cmp, v_i); Nc(cmp, v_i); } /* #138 引用模式: __sw == __sw 恒真 (绑定臂) */
              否 { cmp = Nd(2); nv[cmp] = T_QK; Nc(cmp, v_i); Nc(cmp, vals[i]); } /* __sw == v1 */
              若 (rng_lo[i] >= 0) { /* 2026-08-28 P2 #144: 区间模式 (__sw >= lo && __sw <= hi) */
                  整 c_lo = Nd(2); nv[c_lo] = T_YK; Nc(c_lo, v_i); Nc(c_lo, rng_lo[i]); /* __sw >= lo */
                  整 c_hi = Nd(2); nv[c_hi] = T_HK; Nc(c_hi, v_i); Nc(c_hi, rng_hi[i]); /* __sw <= hi */
                  整 andr = Nd(2); nv[andr] = LA; Nc(andr, c_lo); Nc(andr, c_hi);
                  cmp = andr;
              }
              若 (or_vals[i] >= 0) { /* 2026-08-28 P1 #132: || (__sw == v2) — or 模式多值合一 */
                  整 cmp2 = Nd(2); nv[cmp2] = T_QK; Nc(cmp2, v_i); Nc(cmp2, or_vals[i]);
                  整 orn = Nd(2); nv[orn] = LO; Nc(orn, cmp); Nc(orn, cmp2);
                  cmp = orn;
