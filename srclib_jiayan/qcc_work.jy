静 整 *nt, *nv, *n0, *n1, *n2, *n3, *n4, *n5, *n6, *n7, *n8, *n9, *n10, *n11, *n12, *n13, *n14, *n15, *n16, *n17, *n18, *n19, *n20, *n21, *n22, *n23, *n24, *n25, *n26, *n27, *n28, *n29, *n30, *n31, *n32, *n33, *n34, *n35, *n36, *n37, *n38, *n39, *n40, *n41, *n42, *n43, *n44, *n45, *n46, *n47, *n48, *n49, *n50, *n51, *n52, *n53, *n54, *n55, *n56, *n57, *n58, *n59, *n60, *n61, *n62, *n63, *n64, *n65, *n66, *n67, *n68, *n69, *n70, *n71, *n72, *n73, *n74, *n75, *n76, *n77, *n78, *n79, *n80, *n81, *n82, *n83, *n84, *n85, *n86, *n87, *n88, *n89, *n90, *n91, *n92, *n93, *n94, *n95, *n96, *n97, *n98, *n99, *n100, *n101, *n102, *n103, *n104, *n105, *n106, *n107, *n108, *n109, *n110, *n111, *n112, *n113, *n114, *n115, *n116, *n117, *n118, *n119, *n120, *n121, *n122, *n123, *n124, *n125, *n126, *n127, *n128, *n129, *n130, *n131, *n132, *n133, *n134, *n135, *n136, *n137, *n138, *n139, *n140, *n141, *n142, *n143, *n144, *n145, *n146, *n147, *n148, *n149, *n150, *n151, *n152, *n153, *n154, *n155, *n156, *n157, *n158, *n159, *n160, *n161, *n162, *n163, *n164, *n165, *n166, *n167, *n168, *n169, *n170, *n171, *n172, *n173, *n174, *n175, *n176, *n177, *n178, *n179, *n180, *n181, *n182, *n183, *n184, *n185, *n186, *n187, *n188, *n189, *n190, *n191, *n192, *n193, *n194, *n195, *n196, *n197, *n198, *n199, *n200, *n201, *n202, *n203, *n204, *n205, *n206, *n207, *n208, *n209, *n210, *n211, *n212, *n213, *n214, *n215, *n216, *n217, *n218, *n219, *n220, *n221, *n222, *n223, *n224, *n225, *n226, *n227, *n228, *n229, *n230, *n231, *n232, *n233, *n234, *n235, *n236, *n237, *n238, *n239, *n240, *n241, *n242, *n243, *n244, *n245, *n246, *n247, *n248, *n249, *n250, *n251, *n252, *n253, *n254, *n255, nc;

/* 表达式子树是否产生 unsigned 值? (fix 2026-08-05) */
静 整 expr_is_unsigned(整 idx) {
    若 (idx < 0) 返 0;
    若 (nt[idx] == 1) 返 var_is_uns((字*)(nn + idx)); /* unsigned 变量 */
    若 (nt[idx] == 0) 返 nuns[idx];                       /* 0xFFFFFFFFu 字面量 */
    若 (nt[idx] == 2) { /* 二元运算: C 通常算术转换 (fix 2026-08-06 M1 传播) */
        整 o = nv[idx];
        若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) 返 0;
        若 (o == LA || o == LO) 返 0;
        若 (o == T_SR || o == T_SH) 返 expr_is_unsigned(n0[idx]); /* 移位: 结果类型=左操作数 */
        返 expr_is_unsigned(n0[idx]) || expr_is_unsigned(n1[idx]);
    }
    若 (nt[idx] == 14) 返 expr_is_unsigned(n0[idx]); /* arr[i]: 数组元素类型 */
    返 0;
}

/* walk an array-access/member chain (case-14/15 nodes) down to the base NAME node.
   For m[i][j] the outer node's n0 is an inner case-14 node, NOT a name node —
   (char*)(nn + n0[n]) would read garbage. Returns the base node index. */
静 整 arr_base_node(整 n) {
    整 b = n;
    循环 (b >= 0 && (nt[b] == 14 || nt[b] == 15)) b = n0[b];
    返 b;
}

/* helper: access AST node child i (replaces (int[]){...}[i] compound literals) */
/* Generate rax = ADDRESS of a member chain (o.a.b / p->x.y), handling `->` by
   dereferencing the pointer at that point (n1.next->val loads n1.next's pointer
   value, then offsets val). *fsz_out = final field byte size; *si_out = the
   chain's resulting struct type (for further field lookup). 0 on success. */
静 整 mem_addr(整 n, 整 *fsz_out, 整 *si_out) {
    若 (nt[n] == 1) { /* root identifier */
        字 *vn = (字*)(nn + n);
        整 off = var_lookup(vn);
        若 (off < 0) 返 -1;
        *fsz_out = 4;
        *si_out = var_stidx(vn);
        若 (var_isstatic(vn)) lea_rax_rip(stc_disp(off) - 1);
        否 lea_r_mbrp(0, var_sbase(vn, off) - cur_frame_sz);
        返 0;
    }
    若 (nt[n] == 14) { /* arr[i]: rax = &arr[i]; element struct type from the array var (fix 2026-08-05: port C mem_addr nt==14 — nested member chains with an array root, e.g. items[i].p.x, previously returned -1 → stores/loads silently dropped → stack corruption) */
        字 *av = (字*)(nn + n0[n]);
        整 si = var_stidx(av);
        若 (si < 0) 返 -1;
        cg_no_deref = 1; cg(n); cg_no_deref = 0; /* rax = &arr[i] (struct array / struct ptr) */
        *fsz_out = stypes[si].sz;
        *si_out = si;
        返 0;
    }
    若 (nt[n] == 15 || nt[n] == 13) {
        字 *fn = (字*)(nn + n);
        整 is_arrow = (nt[n] == 15 && nv[n] == 1);
        整 sub_si = -1, sub_fsz = 4;
        若 (mem_addr(n0[n], &sub_fsz, &sub_si) < 0) 返 -1;
        若 (sub_si < 0) 返 -1;
        若 (is_arrow) mov_reg_mreg64(0, 0); /* deref: rax = [rax] (the struct pointer) */
        整 fo = st_off(stypes[sub_si].name, fn);
        若 (fo < 0) 返 -1;
        若 (fo != 0) add_rax_imm8(fo);
        *fsz_out = st_field_size(stypes[sub_si].name, fn);
        *si_out = st_field_ty_idx(stypes[sub_si].name, fn);
        若 (*si_out < 0 && st_field_bitw(stypes[sub_si].name, fn) > 0) *si_out = sub_si; /* bit-field: report the CONTAINING struct so callers can extract/store (fix 2026-08-05) */
        cg_mem_frow = st_field_row(stypes[sub_si].name, fn); /* array field: element size for a following [i] */
        返 0;
    }
    返 -1;
}

