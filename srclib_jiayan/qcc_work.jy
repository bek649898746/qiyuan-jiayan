    返 -1;
}
静 整 lbl_reg(常 字 *n) {
    遍 (整 i = 0; i < lbl_n; i++) 若 (!strcmp(lbl_tbl[i].name, n)) 返 lbl_tbl[i].id;
    若 (lbl_n >= 512) 返 -1;
    strcpy(lbl_tbl[lbl_n].name, n);
    lbl_tbl[lbl_n].id = new_label();
    返 lbl_tbl[lbl_n++].id;
}
