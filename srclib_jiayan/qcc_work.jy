                                若(foff!=0){ ir_emit(I_ADD_EAX_IMM8, foff, 0, 0); ir_flush(); } /* Phase3-IR case10: 偏移 */
                                pop_xmm0(); /* xmm0 = rhs */
                                ir_emit(I_STORE_XMM0_RAX, 0, 0, 0); ir_flush(); /* Phase3-IR case10: ptr->field 存 double */
                        } 否 {

                                cg(n1[n]); 若 (st_field_ty_idx(stypes[si].name, fname) == -3) ll_ext32(n1[n]); push_r(0); /* save rhs on stack; ll 字段 int RHS 符号扩展 (fix 2026-08-07: 箭头字段 p->v = -100 存 64 位零扩展 → 4294967196) */
若(off>=0 || (coff_mode && var_isstatic(vname))){ 若 (var_isstatic(vname)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); } 否 { ir_emit(I_LOAD_RBP, 0, off - cur_frame_sz, 0); ir_flush(); } } /* Phase3-IR case10: rax = ptr */
                                否 {mov_r_imm(0,0);} /* ptr=0 if not found */
                                若(foff!=0){ ir_emit(I_ADD_EAX_IMM8, foff, 0, 0); ir_flush(); } /* Phase3-IR case10: 偏移 */
                                pop_r(3); /* ebx = rhs */
                                若 (bf_store(stypes[si].name, fname)) { /* bit-field RMW store (fix 2026-08-05) */ }
                                否 若 (fsz == 8) { ir_emit(I_STORE_RAX64, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: ptr->field 存 64 */
                                否 若 (fsz == 1) { ir_emit(I_STORE_RAX_BYTE, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: ptr->field 存 char */
                否 若 (fsz == 2) { ir_emit(I_STORE_RAX_WORD, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: ptr->field 存 short */
                                否 { ir_emit(I_STORE_RAX32, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: ptr->field 存 32 */
                            mov_rr(0, 3); /* eax = stored value (chained assignments) */
                            }
                        } 否 若 (var_isstatic(vname)) {
                            /* static struct member write */
                            { 整 _fty = st_field_ty_idx(stypes[si].name, fname);
                              整 _fcs = (!st_field_is_ptr(si, fname) && _fty >= 0 && stypes[_fty].sz > 8) ? stypes[_fty].sz : 0; /* fix 2026-08-22 t46: static struct 字段整体赋值 (oi.oid = ref->objectname — 文件级 static expand_data 的 object_id 成员) — 原无 _fok 逻辑 → fsz=36 落 else 只存 4 字节 → branch "missing object" */
                              整 _fok = 0;
                              若 (_fcs > 0 && n1[n] >= 0) {
                                  若 (nt[n1[n]] == 1) {
                                      若 (var_stidx((字*)(nn + n1[n])) == _fty && var_pesz((字*)(nn + n1[n])) == 0 && var_arrsz((字*)(nn + n1[n])) == 0) _fok = 1;
                                  } 否 {
                                      整 _rfsz = 0, _rsi = -1;
                                      若 (mem_addr(n1[n], &_rfsz, &_rsi) == 0 && _rfsz == _fcs) _fok = 1;
                                  }
                              }
                              若 (_fok) {
                                ir_emit(I_LEA_RIP_OFF, off, 1, foff); ir_flush(); /* Phase3-IR case10: static 字段写地址 */
                                  push_r(0); /* &dst */
                                  若 (nt[n1[n]] == 1) {
                                      字 *_srn = (字*)(nn + n1[n]);
                                      整 _sro = var_lookup(_srn);
                                      若 (var_isstatic(_srn)) { ir_emit(I_LEA_RIP, _sro, 1, 0); ir_flush(); } 否 { ir_emit(I_LEA_RBP_GPR, 0, var_sbase(_srn, _sro) - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case10: static 大结构 RHS 取址 */
                                  } 否 {
                                      整 _rfsz2 = 0, _rsi2 = -1;
                                      mem_addr(n1[n], &_rfsz2, &_rsi2); /* re-emit &RHS after lea &dst (probe above emitted early) */
                                  }
                                  pop_r(3); /* rbx = &dst, rax = &src */
                                  cg_struct_copy(_fcs);
                              } 否 若 (st_field_is_dbl(stypes[si].name, fname)) {
                                cg_f(n1[n]); push_xmm0(); /* save rhs */
                                ir_emit(I_LEA_RIP_OFF, off, 1, foff); ir_flush(); /* Phase3-IR case10: static 字段写地址 */
                                pop_xmm0();
                                ir_emit(I_STORE_XMM0_RAX, 0, 0, 0); ir_flush(); /* Phase3-IR case10: static 存 double */
                              } 否 {
                                cg(n1[n]); push_r(0); /* save rhs */
                                ir_emit(I_LEA_RIP_OFF, off, 1, foff); ir_flush(); /* Phase3-IR case10: static 字段写地址 */
                                pop_r(3); /* ebx = rhs */
                                若 (bf_store(stypes[si].name, fname)) { /* bit-field RMW store (fix 2026-08-05) */ }
                                否 若 (fsz == 8) { ir_emit(I_STORE_RAX64, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: static 存 64 */
                                否 若 (fsz == 1) { ir_emit(I_STORE_RAX_BYTE, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: static 存 char */
                否 若 (fsz == 2) { ir_emit(I_STORE_RAX_WORD, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: static 存 short */
                                否 { ir_emit(I_STORE_RAX32, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: static 存 32 */
                                mov_rr(0, 3); /* eax = stored value (chained assignments) */
                              }
                            }
                        } 否 若 (var_big_param(vname)) {
                            /* big-struct param field write: load copy ptr, +foff, store */
                            cg(n1[n]); push_r(0);
                            若 (var_isstatic(vname)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); } 否 { ir_emit(I_LOAD_RBP64, 0, off - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case10: big_param 字段写 copy ptr */
                            若 (foff != 0) { ir_emit(I_ADD_RAX_IMM8, foff, 0, 0); ir_flush(); } /* Phase3-IR case10: big_param 字段偏移 */
                            pop_r(3);
                            若 (bf_store(stypes[si].name, fname)) { /* bit-field RMW store (fix 2026-08-05) */ }
                            否 若 (fsz == 8) { ir_emit(I_STORE_RAX64, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: big_param 存 64 */
                            否 若 (fsz == 1) { ir_emit(I_STORE_RAX_BYTE, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: big_param 存 char */
                否 若 (fsz == 2) { ir_emit(I_STORE_RAX_WORD, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: big_param 存 short */
                            否 { ir_emit(I_STORE_RAX32, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: big_param 存 32 */
                        } 否 {
                            整 _fty = st_field_ty_idx(stypes[si].name, fname);
                            整 _fcs = (!st_field_is_ptr(si, fname) && _fty >= 0 && stypes[_fty].sz > 8) ? stypes[_fty].sz : 0; /* fix 2026-08-22 t45: 排除指针字段 (r.rev = e — rev 是 entry*, ty_idx 解析成 entry 24B → 原 _fcs=24 → 数组名当 struct 值拷 24B → r.rev=0 崩) — 同步 t44 箭头分支修复 */
                            整 _fok = 0; /* fix 2026-08-22 #30: >8B struct field assign (pp.date_mode = rev->date_mode). RHS must be a same-type lvalue; else fall back to scalar path (safe, matches pre-fix behavior) */
                            若 (_fcs > 0 && n1[n] >= 0) {
                                若 (nt[n1[n]] == 1) {
                                    若 (var_stidx((字*)(nn + n1[n])) == _fty && var_pesz((字*)(nn + n1[n])) == 0 && var_arrsz((字*)(nn + n1[n])) == 0) _fok = 1; /* fix 2026-08-22 t45: 数组名 RHS 排除 — 数组 decay 为指针, 不是 struct 值 */
                                } 否 {
                                    整 _rfsz = 0, _rsi = -1;
                                    若 (mem_addr(n1[n], &_rfsz, &_rsi) == 0 && _rfsz == _fcs) _fok = 1;
                                }
                            }
                            若 (_fok) {
                                ir_emit(I_LEA_RBP_GPR, 0, var_sbase(vname, off) + foff - cur_frame_sz, 0); ir_flush();
                                push_r(0); /* &dst */
                                若 (nt[n1[n]] == 1) {
                                    字 *_srn = (字*)(nn + n1[n]);
                                    整 _sro = var_lookup(_srn);
                                    若 (var_isstatic(_srn)) { ir_emit(I_LEA_RIP, _sro, 1, 0); ir_flush(); } 否 { ir_emit(I_LEA_RBP_GPR, 0, var_sbase(_srn, _sro) - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case10: RHS 取址 */
                                } 否 {
                                    整 _rfsz2 = 0, _rsi2 = -1;
                                    mem_addr(n1[n], &_rfsz2, &_rsi2); /* re-emit &RHS after lea &dst (probe above emitted early) */
                                }
                                pop_r(3); /* rbx = &dst, rax = &src */
                                cg_struct_copy(_fcs);
                            } 否 若 (st_field_is_dbl(stypes[si].name, fname)) {
                                cg_f(n1[n]); /* double rhs → xmm0 */
                                ir_emit(I_STORE_XMM0_RBP, var_sbase(vname, off) + foff - cur_frame_sz, 0, 0); ir_flush(); /* Phase3-IR case10: 局部 double 写 */
                            } 否 {
                                cg(n1[n]);
                                若 (st_field_bitw(stypes[si].name, fname) > 0) { push_r(0); ir_emit(I_LEA_RBP_GPR, 0, var_sbase(vname, off) + foff - cur_frame_sz, 0); ir_flush(); pop_r(3); bf_store(stypes[si].name, fname); } /* Phase3-IR case10: 局部 bit-field */
                                否 若 (fsz == 8) { 若 (st_field_ty_idx(stypes[si].name, fname) == -3) ll_ext32(n1[n]); ir_emit(I_STORE_RBP64, var_sbase(vname, off) + foff - cur_frame_sz, 0, 0); ir_flush(); } /* Phase3-IR case10: 局部 ll 写 */
                                否 若 (fsz == 1) { push_r(0); ir_emit(I_LEA_RBP_GPR, 0, var_sbase(vname, off) + foff - cur_frame_sz, 0); ir_flush(); pop_r(3); ir_emit(I_STORE_RAX_BYTE, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: 局部 char 写 */
                否 若 (fsz == 2) { push_r(0); ir_emit(I_LEA_RBP_GPR, 0, var_sbase(vname, off) + foff - cur_frame_sz, 0); ir_flush(); pop_r(3); ir_emit(I_STORE_RAX_WORD, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: 局部 short 写 */
                                否 { ir_emit(I_STORE_RBP, var_sbase(vname, off) + foff - cur_frame_sz, 0, 0); ir_flush(); } /* Phase3-IR case10: 局部 dword 写 */
                            }
                        }
                    }
                }
                /* arrow write with non-struct pointer var */
                若 (is_arrow && si < 0) {
                    整 fo = -1, si2 = -1;
                    遍 (整 i = 0; i < st_n; i++) { fo = st_off(stypes[i].name, fname); 若 (fo >= 0) { si2 = i; 断; } }
                    整 _fcs3 = 0; /* fix 2026-08-22 #34b: 参数指针 struct 字段整体赋值 p->dm = t — 原标量路径只存首4字节 */
                    若 (si2 >= 0 && n1[n] >= 0) {
                        整 _fti3 = st_field_ty_idx(stypes[si2].name, fname);
                        若 (!st_field_is_ptr(si2, fname) && _fti3 >= 0 && stypes[_fti3].sz > 8) _fcs3 = stypes[_fti3].sz; /* fix 2026-08-22 t44: 排除指针字段 (rec->next 是 xrecord_t*) — 原 _fcs3=24 → cg_struct_copy(24) 覆盖 rec->ptr */
                    }
                    若 (_fcs3 > 0 && n1[n] >= 0 && (nt[n1[n]] == 1 || nt[n1[n]] == 12 || nt[n1[n]] == 15)) {
                        /* struct 拷贝路径: rax = &p->fname, rbx = &rhs */
                        若 (nt[n0[mc]] == 11 || nt[n0[mc]] == 12) {
                            cg_no_deref = 1; cg(n0[mc]); cg_no_deref = 0; /* rax = 基指针值 */
                        }
                        否 若 (off >= 0) { 若 (var_isstatic(vname)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); } 否 若 (var_pesz(vname) > 0) { ir_emit(I_LOAD_RBP64, 0, off - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case10 */ 否 { ir_emit(I_LOAD_RBP, 0, off - cur_frame_sz, 0); ir_flush(); } }
                        否 若 (off < 0) { load_param_val(vname); } /* param in register or stack */
                        否 { mov_r_imm(0, 0); }
                        若 (fo != 0) { ir_emit(I_ADD_RAX_IMM8, fo, 0, 0); ir_flush(); } /* Phase3-IR case10: ARROWFALL 偏移 */
                        push_r(0); /* &dst */
                        若 (nt[n1[n]] == 1) {
                            字 *_srn3 = (字*)(nn + n1[n]);
                            整 _sro3 = var_lookup(_srn3);
                            若 (_sro3 >= 0) { 若 (var_isstatic(_srn3)) { ir_emit(I_LEA_RIP, _sro3, 1, 0); ir_flush(); } 否 { ir_emit(I_LEA_RBP_GPR, 0, var_sbase(_srn3, _sro3) - cur_frame_sz, 0); ir_flush(); } } /* Phase3-IR case10: ARROWFALL RHS 取址 */
                            否 mov_r_imm(0, 0);
                        } 否 {
                            整 _rfsz3 = 0, _rsi3 = -1;
                            mem_addr(n1[n], &_rfsz3, &_rsi3); /* re-emit &RHS */
                        }
                        pop_r(3); /* rbx = &dst, rax = &src */
                        cg_struct_copy(_fcs3);
                    } 否 {
                        cg(n1[n]); push_r(0); /* save rhs on stack */
                        若 (nt[n0[mc]] == 11 || nt[n0[mc]] == 12) {
                            /* 表达式基: (ptr)->field 的 ptr 是取址/解引用表达式 (fix 2026-08-19:
                               链式赋值 (&t->list)->next = (&t->list)->prev = &t->list 的基是 case-11 取址 —
                               原 load_param_val(vname='') 不发码 → 沿用内层赋值残留 rax 当写地址 → 写错位/写 NULL.
                               INIT_LIST_HEAD 的 next 字段从未写 → git status tempfile 链表节点 next=0 → SEGV) */
                            cg_no_deref = 1; cg(n0[mc]); cg_no_deref = 0; /* rax = 基指针值 */
                        }
                        否 若 (off >= 0) { 若 (var_isstatic(vname)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); } 否 若 (var_pesz(vname) > 0) { ir_emit(I_LOAD_RBP64, 0, off - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case10 */ 否 { ir_emit(I_LOAD_RBP, 0, off - cur_frame_sz, 0); ir_flush(); } }
                        否 若 (off < 0) { load_param_val(vname); } /* param in register or stack */
                        否 { mov_r_imm(0, 0); }
                        若 (fo != 0) { ir_emit(I_ADD_RAX_IMM8, fo, 0, 0); ir_flush(); } /* Phase3-IR case10: ARROWFALL 偏移 */
                        pop_r(3); /* ebx = rhs */
                        若 (si2 >= 0 && bf_store(stypes[si2].name, fname)) { /* bit-field RMW store (fix 2026-08-05) */ }
                        否 { ir_emit(I_STORE_RAX32, 0, 0, 0); ir_flush(); } /* Phase3-IR case10: ARROWFALL 存 32 */
                        mov_rr(0, 3); /* eax = stored value (chained assignments) */
                    }
                }
                } /* end var.field else */
            } 否 若 (nt[n0[n]] == 14) { /* arr[i] = expr */
                整 ac = n0[n]; 字*vn=(字*)(nn+arr_base_node(ac));

                整 asi_el = var_stidx(vn);
                /* struct 数组元素赋值 班级[j] = 班级[j+1] (fix 2026-08-06).
                   守卫: 仅当 LHS 是直接 arr[i] (n0[n] 的基是名字节点 nt==1)。
                   tbl[0].name[0] = 'X' 的基是 case-15 字段链 → 不能当整结构体拷贝 (fix 2026-08-06: probe_sg 崩)。
                   sz>=8: 8 字节 struct 元素拷贝同样要整块 (原 >8 走标量路径 → 存的是元素地址, fix 2026-08-06) */
                若 (asi_el >= 0 && var_pesz(vn) == 0 && var_esz(vn) == stypes[asi_el].sz && stypes[asi_el].sz >= 8 && n0[n] >= 0 && n0[n0[n]] >= 0 && nt[n0[n0[n]]] == 1) { /* struct 数组元素赋值 班级[j] = 班级[j+1] (fix 2026-08-06; fix 2026-08-16 根因J: n0[n]>=0 && n0[n0[n]]>=0 守卫; fix 2026-08-17: var_pesz==0 排除指针数组 struct T *arr[] — 元素是指针(8B) 非结构体值, 原当 struct 拷贝 → NULL 元素从地址 0 拷 → 崩) */
                    整 csz = stypes[asi_el].sz;
                    cg_no_deref = 1; cg(n0[n]); cg_no_deref = 0; /* rax = &arr[i] (目标) */
                    push_r(0);
                    若 (n1[n] >= 0 && nt[n1[n]] == 1) { /* 源是变量: &var (case 1 cg_no_deref 会读值非地址!) (fix 2026-08-16: n1[n]>=0 守卫 — parse 失败时缺源 n1=-1, 原直接读 nt[-1] 越界) */
                        字 *srn = (字*)(nn + n1[n]);
                        整 sro = var_lookup(srn);
                        若 (var_isstatic(srn)) { ir_emit(I_LEA_RIP, sro, 1, 0); ir_flush(); } 否 { ir_emit(I_LEA_RBP_GPR, 0, var_sbase(srn, sro) - cur_frame_sz, 0); ir_flush(); } /* Phase3-IR case10: 大结构 RHS 取址 */
                    } 否 {
                        cg_no_deref = 1; cg(n1[n]); cg_no_deref = 0; /* rax = &rhs (源) */
                    }
                    pop_r(3); /* rbx = 目标, rax = 源 */
                    cg_struct_copy(csz);
                } 否 {
                /* double array, or double* POINTER VAR (p_dbl). NOT fnptr arrays: p_dbl there
                   means double-return, elements are pointers (64-bit stores). */
                整 arr_dbl = var_is_dbl(vn) || (var_pdbl(vn) && var_arrsz(vn) == 0);
                若 (arr_dbl) { cg_f(n1[n]); push_xmm0(); } /* double array element write */
                否 { cg(n1[n]); ir_flush(); 若 (var_is_ll(vn)) ll_ext32(n1[n]); push_r(0); } /* Phase3-IR case10: RHS 编译后清残留 IR */
                cg(n1[ac]); ir_flush(); /* Phase3-IR case10: index 编译后清残留 IR */
                /* NOTE: pop_r(3) is DELAYED into each store branch — the base-address
                   expression (cg(n0[ac]), e.g. `vars[vcnt-1]`) may itself use r3 for a
                   `var - const` subtraction and would CLOBBER the RHS (fix 2026-08-05:
                   vars[vcnt-1].frows[dims-1] = esz compiled to storing vcnt-1). */
                整 off=var_lookup(vn);
                整 peszl=var_pesz(vn);
                若 (nt[n0[ac]] == 15 || nt[n0[ac]] == 14 || nt[n0[ac]] == 12) {
                    /* NESTED base store: u.c[0]=v / arr[i].field[k]=v — base is a member/array
                       chain (vname is a FIELD name, must NOT be resolved as a variable).
                       fix 2026-08-18: 含 case-12 (解引用 base) — (*out)[i]=x 的 base 是 *out (case 12),
                       arr_base_node 返回空名 → 原落最终兜底 4 字节缩放 → store_key 4 字节间隔 → config 写坏 */
                    cg_mem_frow = 0; /* set by cg(n0[ac]) if it reads a static-struct array member */
                    cg_mem_ptr = 0; /* set by cg(n0[ac]) if it is a pointer-array element (int *rva[4]) needing one deref before the second subscript (fix 2026-08-16) */
                    mov_rr(11, 0); /* r11d = outer index */
                    push_r(11); /* cg may clobber r11 */
                    整 base_is_ptrfield = 0;
                    整 pf_el_sz = 0; /* fix 2026-08-17: 指针字段作数组基时的指向元素大小 (p->buf[i] 的 i 缩放/存储宽度) */
                    若 (nt[n0[ac]] == 15) { 整 mc2 = n0[ac]; 字 *bvn = (字*)(nn + n0[mc2]); 字 *bfn = (字*)(nn + mc2); 整 bsi = var_stidx(bvn); 若 (bsi >= 0) { 整 bfty = st_field_ty_idx(stypes[bsi].name, bfn); 若 (bfty == -1 && st_field_el(bsi, bfn) == 8) base_is_ptrfield = 1; pf_el_sz = st_field_pel(bsi, bfn); } }
                    若 (base_is_ptrfield) { cg(n0[ac]); cg_mem_frow = pf_el_sz > 0 ? pf_el_sz : 8; } /* pointer field: base is the POINTER VALUE, not the field address (fix 2026-08-16: sb->buf[0]=0 原覆盖了指针字段本身 → xstrfmt buf=0); fix 2026-08-17: 补设 cg_mem_frow — 原未设 → 存储宽度默认字节 → char **out 元素赋值只存低字节 (git init 目录参数丢) */
                    否 { cg_no_deref = 1; cg(n0[ac]); cg_no_deref = 0; } /* array/struct field: base address */
