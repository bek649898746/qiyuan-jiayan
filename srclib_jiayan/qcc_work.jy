        { 整 one = Nd(0); nv[one] = 1; 整 asg = Nd(10); Nc(asg, v_a); Nc(asg, one); Nc(blk, asg); } /* acc = 1; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __cp = 0; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__cp < n) */
        整 bd = Nd(5);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, v_i); /* src[__cp] */
          { 整 v_a2 = Nd(1); memcpy((字*)(nn + v_a2), accn, 32);
            整 mul = Nd(2); nv[mul] = DK; Nc(mul, v_a2); Nc(mul, idx_s); /* acc*src */
            整 asg = Nd(10); Nc(asg, v_a2); Nc(asg, mul); Nc(bd, asg); } } /* acc = acc*src; */
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
          整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_i2); /* dst[__cp] */
          { 整 v_a3 = Nd(1); memcpy((字*)(nn + v_a3), accn, 32);
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, v_a3); Nc(bd, asg); } } /* dst[__cp]=acc; */
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i2); Nc(asg, pl); Nc(bd, asg); } /* __cp++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "替换")) { /* 接入 2026-08-27 就地替换元素: 替换 arr, n, old, new; → { __rp=0; while(__rp<n){ if(arr[__rp]==old){ arr[__rp]=new; } __rp++; } } — 复用等值比较+包块机制 */
        tk++; /* 替换 */
