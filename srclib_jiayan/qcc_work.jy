静 整 dbl_hi[512]; 静 整 dbl_lo[512]; 静 整 dbl_n;
静 整 parse_dbl_n; /* parse 后的 double 数；gen_code 每遍从它重置（negate 会在 codegen 中新增 double，两遍必须同起点） */
静 无 字 dbl_used[512]; /* -S 数据发射: 按偏移序标记已发射的 double（处理共享槽位） */

/* parse a floating literal at s[*i] (digits [ . digits] [e[+-]digits]) into its
   IEEE-754 bit pattern; advances *i past the literal. Self-host has NO real
   long long (it's a 32-bit int), so the 8-byte pattern is returned as two
   ints (hi/lo) read out of the double's frame-slot bytes via a char*. */
静 空 fp_parse(常 字 *s, 整 *pi, 整 *out_hi, 整 *out_lo) {
    双 v = 0; 整 i = *pi;
    循环 (s[i] >= '0' && s[i] <= '9') { v = v * 10 + (s[i] - '0'); i++; }
    若 (s[i] == '.') { i++; 双 fr = 0, sc = 1; 循环 (s[i] >= '0' && s[i] <= '9') { fr = fr * 10 + (s[i] - '0'); sc *= 10; i++; } v += fr / sc; } /* fix 2026-08-06: 整数累加+单次除法，避免 fr*=0.1 累加误差 */
    若 (s[i] == 'e' || s[i] == 'E') {
        i++; 整 es = 1;
        若 (s[i] == '+' || s[i] == '-') { 若 (s[i] == '-') es = -1; i++; }
        整 e = 0; 循环 (s[i] >= '0' && s[i] <= '9') { e = e * 10 + (s[i] - '0'); i++; }
        双 p10 = 1; 遍 (整 k = 0; k < e; k++) p10 *= 10;
        若 (es > 0) v *= p10; 否 v /= p10;
    }
    *pi = i;
    字 *vp = (字 *)&v;
    整 lo = (vp[0] & 0xff) | ((vp[1] & 0xff) << 8) | ((vp[2] & 0xff) << 16) | ((vp[3] & 0xff) << 24);
    整 hi = (vp[4] & 0xff) | ((vp[5] & 0xff) << 8) | ((vp[6] & 0xff) << 16) | ((vp[7] & 0xff) << 24);
    *out_lo = lo; *out_hi = hi;
}

/* 十六进制浮点字面量: 0x1.8p3 = 1.5*2^3 = 12.0 (C99; fix 2026-08-05: 曾被当 hex 整数解析) */
静 空 hexfp_parse(常 字 *s, 整 *pi, 整 *out_hi, 整 *out_lo) {
    双 v = 0; 整 i = *pi; /* s[i] = 第一个 hex 数字 (0x 之后) */
    循环 (isxdigit((无 字)s[i])) { 整 c = s[i] | 0x20; v = v * 16 + (c <= '9' ? c - '0' : c - 'a' + 10); i++; }
    若 (s[i] == '.') {
        i++;
        双 fr = 1.0 / 16;
        循环 (isxdigit((无 字)s[i])) { 整 c = s[i] | 0x20; 双 d = c <= '9' ? c - '0' : c - 'a' + 10; v += d * fr; fr /= 16; i++; }
    }
    若 (s[i] == 'p' || s[i] == 'P') {
        i++; 整 es = 1;
        若 (s[i] == '+' || s[i] == '-') { 若 (s[i] == '-') es = -1; i++; }
        整 e = 0; 循环 (s[i] >= '0' && s[i] <= '9') { e = e * 10 + (s[i] - '0'); i++; }
        双 p2 = 1; 遍 (整 k = 0; k < e; k++) p2 *= 2;
        若 (es > 0) v *= p2; 否 v /= p2;
    }
    *pi = i;
    字 *vp = (字 *)&v;
    整 lo = (vp[0] & 0xff) | ((vp[1] & 0xff) << 8) | ((vp[2] & 0xff) << 16) | ((vp[3] & 0xff) << 24);
    整 hi = (vp[4] & 0xff) | ((vp[5] & 0xff) << 8) | ((vp[6] & 0xff) << 16) | ((vp[7] & 0xff) << 24);
    *out_lo = lo; *out_hi = hi;
}

