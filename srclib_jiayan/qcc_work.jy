        { 整 _et = tk + 1; 循环 (tt[_et] == VK) _et++; 若 (tt[_et] == ST) { _et++; 若 (tt[_et] == VR) _et++; } 若 (tt[_et] == EN) { _et++; 若 (tt[_et] == VR) _et++; } 若 (tt[_et] == VR && td_is(tn[_et])) _et++; 循环 (tt[_et] == DK || (tt[_et] == VK && !strcmp(tn[_et], "const"))) _et++; 若 (tt[_et] == VR && tt[_et + 1] == OK) { 整 _et2 = _et + 2, _ed = 1; 循环 (_et2 < TS && _ed > 0) { 若 (tt[_et2] == OK) _ed++; 否 若 (tt[_et2] == KK) _ed--; _et2++; } 若 (_et2 < TS && tt[_et2] == FK) qex_def = 1; } }
        若 (tt[tk] == VK && !strcmp(tn[tk], "extern") && !qex_def) {
