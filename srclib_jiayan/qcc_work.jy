                                若 (evc != 0x80000000) {
                                    若 (gcnt == 0) { gfirst = evc; gcnt = 1; }
                                    gcnt *= evc;
                                    若 (gdim_n < 8) { gdims[gdim_n] = evc; gdim_n++; }
