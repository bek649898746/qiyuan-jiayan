            }否 若(tt[tk]==DF){ /* default: */
                tk++;若(tt[tk]==CK)tk++;
                整 body=Nd(5);
                循环(tt[tk]!=BR&&tt[tk]!=UK&&tt[tk]!=EK){
                    若(tt[tk]==SK){tk++;续;}
                    Nc(body,stmt());
                }
                若(tt[tk]==BR){tk++;若(tt[tk]==SK)tk++;}
                整 t=Nd(0);nv[t]=1;
                整 ifn=Nd(8);Nc(ifn,t);Nc(ifn,body);
                若(prev>=0){
                    n2[prev] = ifn; /* else branch */
                    prev=ifn;
                }否{chain=ifn;prev=ifn;}
