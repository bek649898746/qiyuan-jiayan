/* %o: unsigned octal digits into [r12] (ebx = value, base 8). fix 2026-08-22 t47:
   %o was an unknown spec → swallowed (no output, no arg consume) → 参数表错位 →
   git ls-files -s 的 "%s%06o %s %d" 后续 %s 读到 mode 当指针 strlen → SEGV. */
静 空 emit_octal_digits(整 tail) {
    整 ldig = new_label(), lcpd = new_label();
    lea_r_mbrp(8, scratch_base + 248 + 12 - cur_frame_sz); /* r8 = digit temp end */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    set_label(ldig);
    asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 8); /* ecx = 8 */
    asm_emit("    无符号除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xF1); /* div ecx: eax=quot, edx=rem */
    asm_emit("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, ldig, 3);
    /* fix 2026-08-23 t35d: %06o 宽度/零填充 — W=sc+232, zero-flag=sc+264 (diff-tree/ls-files mode) */
    { 整 lpdone = new_label(), lpad = new_label(), lsp = new_label(), lch0 = new_label();
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 232); /* eax = W */
    test_rr(0, 0); jz_rel(-1); patch_label(cp-4, lpdone, 1); /* W==0 -> 无填充 */
    mov_rr64(0, 8); asm_emit("    减64 r0, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,0); b(0x29); modrm(3,1,0); /* rax = r8 - r9 = len (r8=temp end, r9=数字开头) */
    mov_mbrp_reg(scratch_base - cur_frame_sz + 240, 0); /* 存 len (sc+240 临时) */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 232); /* eax = W */
    mov_reg_mbrp(2, scratch_base - cur_frame_sz + 240); /* edx = len */
    asm_emit("    减32 r0, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x29); modrm(3, 2, 0); /* eax = W - len = pad */
    mov_rr(2, 0); /* edx = pad count */
