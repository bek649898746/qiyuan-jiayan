            若 (fnptr && nt[fn] != 1 && nt[fn] != 12) { /* expression callee (tbl[i], (*fp) handled above): check the BASE array's p_dbl */
                整 bn = arr_base_node(fn);
                若 (bn >= 0 && nt[bn] == 1 && var_pdbl((字*)(nn + bn))) ndbl[n] = 1;
            }
            (空)0; /* arr_base_node inline guard: nt access must stay within the node table */
            整 argbase = is_sret ? 32 + 8 * sret_extra : ((is_user && !fnptr) ? 32 + 8 * extra : 0);
            /* push each arg; >8B struct args are copied to the stack and passed BY ADDRESS
               (their slot holds a pointer to the copy — Win64 >16B convention). Record
               each arg's slot height (from the top) so the loader can find it. */
            整 slot_h[20]; 整 slot_n = 0; 整 total_h = 0;
            整 is_math_mixed = (!strcmp(fname, "frexp") || !strcmp(fname, "ldexp") || !strcmp(fname, "modf")); /* 混合 ABI: 第二参是 int/指针, 不能强制 double 压栈 (fix 2026-08-25 step4) */
            遍 (整 i = 0; i < 20; i++) {
                整 c = kids[i];
                若 (c == fn || c < 0) { 续; }
                整 bigsz = 0;
                整 bigarr = 0; /* struct array ELEMENT (h[i]) passed by value → r10 = &h[i] (fix 2026-08-03: only identifiers triggered the bigsz copy, so h[i] was passed as a 4-byte read) */
                若 (nt[c] == 1) {
                    字 *an = (字*)(nn + c);
                    整 asi = var_stidx(an);
                    
                    /* struct ARRAY name decays to a pointer (fix 2026-08-03: without the arr_sz guard, a >8B struct array was copied by value and the callee wrote to a dead copy) */
                    /* var_pesz==0 excludes POINTER vars whose st_idx is the pointed-to struct (fix 2026-08-03: EngineStat* e passed to memset was copied as a 132B value) */
                    /* fix 2026-08-07: 去掉 !var_isstatic — 静态单结构体按值传参也要 bigsz 拷贝（原被排除 → 当 4 字节 int 传 → 崩） */
                    若 (asi >= 0 && stypes[asi].sz > 8 && var_arrsz(an) == 0 && var_pesz(an) == 0) bigsz = stypes[asi].sz;
                } 否 若 (nt[c] == 14) {
                    字 *an = (字*)(nn + n0[c]); /* array variable name */
                    整 asi = var_stidx(an);
                    /* fix 2026-08-07: 去掉 !var_isstatic — 静态数组元素按值传参也走 bigarr 拷贝 (原被排除 → 留地址捷径 → 被调方改的是原数组 = 别名 bug) */
                    /* fix 2026-08-22 #40: 双指针/指针数组基 (T** pp / T *arr[N]) 的 arr[i] 是指针元素 (8B),
                       原仅查 st_idx 命中被指 struct → bigsz=40 → 按 40B struct 按值拷贝 → 传垃圾栈指针 →
                       root commit 摘要 oid_object_info_convert die 崩. 元素尺寸必须等于 struct 大小才按
                       struct 元素处理 (T* p 单指针 p[i] 仍是 struct, var_esz==sz 保留). */
                    若 (asi >= 0 && stypes[asi].sz > 8 && var_esz(an) == stypes[asi].sz) { bigsz = stypes[asi].sz; bigarr = 1; }
                }
                若 (bigsz > 0) {
                    整 aoff = var_lookup((字*)(nn + c));
                    整 nblk = (bigsz + 7) / 8;
                    若 (var_big_param((字*)(nn + c))) {
                        mov_reg_mbrp64(10, aoff - cur_frame_sz); /* r10 = copy ptr (param slot holds the address) */
                    } 否 若 (bigarr) {
                        cg_no_deref = 1; cg(c); cg_no_deref = 0; /* rax = &h[i] (struct array element) */
                        mov_rr64(10, 0); /* r10 = &h[i] */
                    } 否 若 (var_isstatic((字*)(nn + c))) {
                        lea_rax_rip(coff_static_disp(aoff, 1) - 1); mov_rr64(10, 0); /* static struct var → r10 = .data addr (fix 2026-08-07) */
                    } 否 {
                        lea_r_mbrp(10, var_sbase((字*)(nn + c), aoff) - cur_frame_sz); /* r10 = &local struct data */
                    }
                    slot_h[slot_n] = total_h + nblk * 8; /* the ADDRESS slot sits above the copy blocks */
                    若 (getenv("QCC_DBG_ARG")) fprintf(stderr, "[ARG] bigsz=%d slot_h[%d]=%d total_h=%d fname=%s\n", bigsz, slot_n, slot_h[slot_n], total_h, fname);
                    遍 (整 k2 = nblk - 1; k2 >= 0; k2--) {
                        asm_emit("    取64 r0, [r10+%d]\n", (字*)(长 长)(k2 * 8), (字*)(长 长)0, (字*)(长 长)0); /* mov rax, [r10+k2*8] (fix 2026-08-03: bare emission had no -S text → H2 pushed uninit rax) */
                        b(0x49); b(0x8B); b(0x42); b(k2 * 8); /* mov rax, [r10 + k2*8] */
                        push_r(0);
                    }
                    asm_emit("    取址 r0, [rsp+0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x8D); modrm(1, 0, 4); b(0x24); b(0); /* lea rax, [rsp+0] = copy start (fix 2026-08-03: bare lea rax,[rsp] had no -S text; disp8 form matches asm_zh 取址) */
                    push_r(0); /* arg slot = address of the copy */
                    total_h += (nblk + 1) * 8;
                } 否 {
                    /* fix 2026-08-21 #25: 参数是 sret 调用 (>8B struct 返回, 非指针) — 栈上分配临时,
                       sret 写入, 按 bigsz 传地址 (原走普通 32 位压栈 → callee 写垃圾 rcx 崩) */
                    整 sarg_si = -1, sarg_ptr = 0;
                    若 (nt[c] == 4) {
                        字 *scfn = NULL;
                        遍 (整 sci = 19; sci >= 0; sci--) { 整 scc = child_i(c, sci); 若 (scc >= 0 && nt[scc] == 1) { scfn = (字*)(nn + scc); 断; } }
                        若 (scfn) { sarg_si = fn_ret_name_get(scfn); sarg_ptr = fn_ret_name_get_ptr(scfn); }
                    }
                    若 (sarg_si >= 0 && stypes[sarg_si].sz > 8 && !sarg_ptr) {
                        整 sarg_sz = stypes[sarg_si].sz;
                        整 sarg_blk = (sarg_sz + 7) / 8;
                        sub_rsp_imm(sarg_blk * 8);      /* 腾出 struct 副本区 */
                        total_h += sarg_blk * 8;
                        整 sarg_off = -cur_frame_sz - sarg_blk * 8; /* rbp 相对临时地址 */
                        cg_sret_off = sarg_off; cg_sret_static = 0; /* fix 2026-08-30: 临时非 static 重置 */
                        cg(c);                           /* case-4 sret 调用: rcx=&tmp, callee 写入 */
                        cg_sret_off = 0;
                        lea_r_mbrp(0, sarg_off);         /* rax = &tmp */
                        push_r(0);                       /* arg slot = address of the temp */
                        slot_h[slot_n] = total_h;
                        total_h += 8;
                        slot_n++;
                        续;
                    }
                    slot_h[slot_n] = total_h;
                    若 (ndbl[c] || fn_dbl_get(fname, slot_n) || (fn_math_iat(fname) >= 0 && !(is_math_mixed && slot_n >= 1))) { cg_f(c); ir_emit(I_PUSH_XMM0, 0, 0, 0); ir_flush(); } /* Phase3-IR; fix 2026-08-25 step4: frexp/ldexp/modf 第二参非 double, 按 int/指针压栈 */
                    否 若 (nll[c] || fn_ll_get(fname, slot_n)) { cg(c); 若 (!nll[c]) ll_ext32(c); ir_emit(I_PUSH_R64_RAX, 0, 0, 0); ir_flush(); } /* Phase3-IR; fix 2026-08-25 bug#30: int 实参→ll 形参符号扩展 (add5(1,255,255,255,-5) 的 -5) */
                    否 { cg(c); ir_emit(I_PUSH_RAX, 0, 0, 0); ir_flush(); } /* Phase3-IR */
