    cl_blk = cl_prev; /* 恢复外层块 (compound literal, fix 2026-08-11) */
    返 b_root;
}

静 整 stmt(空) {
    若 (tt[tk] == VR && (!strcmp(tn[tk], "__asm__") || !strcmp(tn[tk], "__asm"))) { /* 内联汇编语句 (bswap.h git_bswap32 的 else 分支): 跳过 (fix 2026-08-14: stmt() 无 __asm__ 处理 → 当函数调用 → undefined symbol) */
