静 整 var_lookup(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) {
        若 (vars[i].rsp_off < 0) { /* extern 标记: 优先找同文件定义 (fix 2026-08-06) */
            遍 (整 j = i - 1; j >= 0; j--) 若 (!strcmp(vars[j].name, n) && vars[j].rsp_off >= 0 && var_codegen_visible(j)) 返 vars[j].rsp_off;
            返 vars[i].rsp_off; /* 无定义: extern 槽 (coff_mode 外部符号) */
        }
        返 vars[i].rsp_off; /* backward: latest shadows */
    }
    /* fix 2026-08-28 可重入: --repeat 第二次 REUSE 复用的变量 (blk_end==-1) 可能超出 fve[gfn]
       (REUSE 不新增 vcnt → fve 只到 <REUSE索引>) — var_lookup 主循环 [0, fve) 找不到 → DCL-MISS.
       兜底: 搜 blk_end==-1 (函数级可见) 且索引 >= fvb[gfn] 的变量 (当前函数或之后的 REUSE 槽) */
    若 (vs_end) { 遍 (整 i = vcnt - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].blk_end == -1 && vars[i].rsp_off >= 0 && i >= fvb[gfn]) 返 vars[i].rsp_off; }
    /* fix 2026-08-12: codegen 时 vs_n()=vs_end 是当前函数 var 上限 — 声明在 vs_end 之后的
       file-scope static (kw=0) 全局可见却被上限排除 (镜像 func_n 场景, 原静默残留; extern 报错后暴露).
       局部变量 (kw=1/非static) 仍受 vs_end/fvb 限制, 不跨函数泄漏 (BLOCKER-1). */
    若 (vs_end) 遍 (整 i = vcnt - 1; i >= vs_end; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i] && var_codegen_visible(i)) 返 vars[i].rsp_off;
    返 -1;
}
静 整 var_stidx(常 字 *n) {
    /* fix 2026-08-22 t46: 循环下界 0 — 原 parse_base 起 (函数内 floor) 排除全局 static (parse_base 前),
       sizeof(*全局指针) 查不到 st_idx → sz=8 → REALLOC_ARRAY(used_atom) size=cnt*8 → 数组重叠 → git branch 崩。
       var_codegen_visible 已兜底: parse 阶段非 static 需 i>=parse_base, 全局 static 始终可见. */
    遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].st_idx;
    返 -1;
}
