                若 (_is_decl) { /* fix 2026-08-26 cpython/curl: 声明启发式误伤 — `int CURL_DEPRECATED(7.56.0, "") curl_formget(...)` 的宏调用前有 int, 但实参是字面量 (数字/字符串) 而非类型 → 是调用不是原型 (curl.h 的 CURL_DEPRECATED(version,message) 属性宏); 原型首实参必是类型 (git 案例 `int error(const char *fmt,...)` 不受影响) */
                    整 _fa = i; /* i 指向 ( */
                    循环 (seg[_fa] && (seg[_fa] == '(' || seg[_fa] == ' ' || seg[_fa] == '\t' || seg[_fa] == '\r' || seg[_fa] == '\n')) _fa++;
                    若 (seg[_fa] == '"' || seg[_fa] == '\'' || (seg[_fa] >= '0' && seg[_fa] <= '9')) _is_decl = 0;
                }
                若 (_is_decl) { 若 (*o + ni + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; } 遍 (整 k = 0; k < ni; k++) out[(*o)++] = nm[k]; 续; }
                整 in_stack = 0; 遍 (整 s = 0; s < fn_exp_n; s++) 若 (fn_exp_stack[s] == fmi) { in_stack = 1; 断; } /* fix 2026-08-13: 展开栈 — 互递归 A→B→A 防重入 (原 self_fmi 只防直接自递归) */
                若 (in_stack) { /* 已在展开栈: 保留函数调用 (C 蓝色油漆语义) */
                    若 (*o + ni + 1 > *cap) { *cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
                    遍 (整 k = 0; k < ni; k++) out[(*o)++] = nm[k];
                    续;
                }
                fn_exp_stack[fn_exp_n++] = fmi; /* 压栈 */
                字 *args = (字 *)fn_arena_alloc(16 * 4096); 整 an = 0; /* fix 2026-08-14: 256→1024, Git 超长 help_patch_text 宏实参 ~280 字符被 255 截断 → 字符串未闭合死链; fix 2026-08-26 cpython: 1024→4096 — PyDoc_STR(sys_doc) 实参 1354 字符; 2026-08-26: 栈→堆竞技场 (块链表); fix 2026-08-30 H1==H2: char* 平铺替代 char (*)[4096] — qcc codegen 局部数组指针初始化 store 丢失+步长错 8 → 宏展开崩 (verify_h1h2_full 5 文件) */
                字 *fn_arena_mark = (字 *)args; /* fix 2026-08-26: mark=args 起始 (块链表块永不移动, 裸指针有效) — 释放到 args 连 exp_args 一起回收 */
                i++;
                整 depth = 1, aj = 0, ain_str = 0;
                循环 (seg[i] && depth > 0) {
                    若 (seg[i] == '"' && !ain_str) ain_str = 1;
                    否 若 (seg[i] == '"' && ain_str && !quote_escaped(seg, i)) ain_str = 0; /* fix 2026-08-14: \\" 两反斜杠后 " 应结束 */
                    若 (seg[i] == '\'' && !ain_str) { /* 字符字面量 '"' 在宏实参内 — 跳过, 防 " 翻转 ain_str (fix 2026-08-14) */
                        若 (aj < 4095) args[an * 4096 + aj++] = seg[i++]; /* opening ' */
                        循环 (seg[i] && (seg[i] != '\'' || quote_escaped(seg, i))) { 若 (aj < 4095) args[an * 4096 + aj++] = seg[i]; i++; }
                        若 (seg[i]) { 若 (aj < 4095) args[an * 4096 + aj++] = seg[i]; i++; }
                        续;
                    }
                    若 (!ain_str) {
                        若 (seg[i] == '(') depth++;
                        否 若 (seg[i] == ')') { depth--; 若 (depth == 0) 断; }
                        若 (seg[i] == ',' && depth == 1) { /* fix 2026-08-07: 串内逗号不拆参 */
                            args[an * 4096 + aj] = 0;
                            若 (an < 15) { an++; aj = 0; }
                            否 { 若 (aj < 4095) args[an * 4096 + aj++] = ','; 若 (aj < 4095) args[an * 4096 + aj++] = ' '; } /* 超限: 并入末槽 (变参) */
                            i++; 循环 (seg[i] == ' ' || seg[i] == '\t') i++; 续; /* fix 2026-08-14: 跳逗号后前导空格 — DECLARE_PROC_ADDR(..., strftime) 的 strftime 前带空格 → ## 拼接 proc_addr_ strftime 有空隙 */
                        }
                    }
                    若 (aj < 4095) args[an * 4096 + aj++] = seg[i];
                    i++;
                }
                args[an * 4096 + aj] = 0; an++;
                若 (seg[i] == ')') i++;
                /* fix 2026-08-13: C 宏替换 — 普通实参完全展开 (蓝色油漆不含实参: ADD(MUL(2,3),TWICE(4)) 的 TWICE→ADD 应展开),
                   #/## 参数不展开 (用原样 args)。参数展开用独立栈 (外层宏不入栈)。 */
