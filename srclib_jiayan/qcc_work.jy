        若 (depth == 0 && !has_nested) {
            遍 (整 i = nd - 1; i >= 0; i--) {
                gi_idx[i]++;
                若 (gi_idx[i] < dims[i]) 断;
                gi_idx[i] = 0;
            }
        } 否 {
            gi_idx[depth]++;
