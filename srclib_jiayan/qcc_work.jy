                            若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) fsz = 1; 否 若 (!strcmp(tn[tk], "double")) fsz = 8; tk++; }
                            循环 (tt[tk] == DK) { fsz = 8; tk++; }
