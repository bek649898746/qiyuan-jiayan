                                brace_arr_init(b, idn, adimv, 1, 0, is_ptr ? 8 : stypes[si].sz); /* t49f: ptr array elem = 8B */
                                若 (tt[tk] == UK) tk++;
                            } 否 {
                                tk++; 整 bi = brace_fields(si, idn); 若 (tt[tk] == UK) tk++; 整 bt = Nd(5); Nc(bt, bi); Nc(b, bt); b_cnt++;
                            }
                        }
                        否 Nc(d, expr());
                    }
                    Nc(b, d); b_cnt++;
                    循环 (tt[tk] == CK) { /* 逗号指针 `struct Tag *a, *b;` */
                        tk++;
                        整 ip2 = 0; 整 ip2d = 0; 循环 (tt[tk] == DK) { ip2 = 1; ip2d++; tk++; } /* fix 2026-08-21: 记录逗号变量指针层级 — struct X **b 原只记布尔 ip2 → 走单指针 p_esz=sizeof(X) → prune_directory src/dst 步进/缩放 4 → add 丢文件 */
                        若 (tt[tk] == VR) {
                            字 vn2[64]; strcpy(vn2, tn[tk]); tk++;
                            整 d2 = Nd(7); memcpy((字*)(nn + d2), vn2, 32);
                            若 (tt[tk] == LB) {
                                整 cnt2 = 1;
                                循环 (tt[tk] == LB) {
                                    tk++; 整 cdim = 0;
                                    若 (const_expr_eval(&cdim)) { cnt2 *= cdim > 0 ? cdim : 1; }
                                    否 { 循环 (tk < TS && tt[tk] != RB && tt[tk] != EK) tk++; }
                                    若 (tt[tk] == RB) tk++;
                                }
                                若 (is_static) {
                                    若 (ip2) var_static_arr(vn2, 0, 8, cnt2);
                                    否 若 (si >= 0) var_static_struct(vn2, si, cnt2);
                                    否 var_static_arr(vn2, 0, 4, cnt2);
                                } 否 {
                                    var_array(vn2, cnt2, ip2 ? 8 : (si >= 0 ? stypes[si].sz : 4));
                                }
                                vars[vcnt - 1].st_idx = si;
                            } 否 若 (ip2) {
                                若 (is_static) var_static(vn2, 4);
                                否 若 (ip2d >= 2) var_offset_ptr(vn2, 8); /* fix 2026-08-21: struct X ** 逗号变量 p_esz=8 (原按 sizeof(struct)=4 → prune_directory src/dst 指针算术 4 → add 丢文件) */
                                否 var_offset_ptr(vn2, stypes[si].sz); /* fix 2026-08-20: struct 单指针 p_esz=sizeof(struct) */
                                vars[vcnt - 1].st_idx = si;
                                若 (ip2d >= 2) vars[vcnt - 1].arr_esz = 8;
                                否 { vars[vcnt - 1].p_depth = 1; vars[vcnt - 1].p_inner = stypes[si].sz; }
                            } 否 若 (si >= 0) {
