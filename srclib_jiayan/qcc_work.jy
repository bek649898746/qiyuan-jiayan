                循环 (s[i] && s[i] != '\n') { 若 (s[i] == '\\' && s[i + 1] == '\n') i += 2; 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') i += 3; 否 i++; } /* fix 2026-08-26 lua: 续行感知 (同上) */
                续;
            }
            若 (is_def) {
            { 字 dnm[64]; 整 dv = 0; pp_def_parse(s + i, dnm, &dv); 若 (dnm[0]) pp_guard_add(dnm, dv); } /* fix 2026-08-07: 任何 #define 都记入顺序表 (含数值, #if MODE==2 用真值) */
            整 p = d + 6;
            循环 (s[p] == ' ' || s[p] == '\t') p++;
