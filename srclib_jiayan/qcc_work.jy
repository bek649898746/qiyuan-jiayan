                tk++; /* skip { */
                整 sub = brace_fields(si, node2);
                若 (sub >= 0) { 遍 (整 k = 0; k < 256; k++) { 整 c = child_i(sub, k); 若 (c > 0) arr_chain_add(c); } }
                若 (tt[tk] == UK) tk++; /* closing } */
                若 (depth == 0 && !has_nested) { 遍 (整 i = nd - 1; i >= 0; i--) { gi_idx[i]++; 若 (gi_idx[i] < dims[i]) 断; gi_idx[i] = 0; } } 否 { gi_idx[depth]++; }
                续;
            }
            整 d2 = 1; tk++;
            循环 (tk < TS && d2 > 0) { 若 (tt[tk] == FK) d2++; 否 若 (tt[tk] == UK) { d2--; 若 (d2 <= 0) { tk++; 断; } } tk++; }
            若 (depth == 0 && !has_nested) { 遍 (整 i = nd - 1; i >= 0; i--) { gi_idx[i]++; 若 (gi_idx[i] < dims[i]) 断; gi_idx[i] = 0; } } 否 { gi_idx[depth]++; }
            续;
        }
        整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32);
        整 node = idn;
        遍 (整 i = 0; i < nd; i++) {
            整 acc = Nd(14); Nc(acc, node);
            整 idx = Nd(0); nv[idx] = gi_idx[i];
            Nc(acc, idx);
            node = acc;
        }
        整 asgn = Nd(10); Nc(asgn, node); Nc(asgn, expr());
        arr_chain_add(asgn);
