            }
            若 (len < row_sz) { /* NUL-terminate (C: the rest of the char row is zeroed) */
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = len;
                Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc);
                整 cn = Nd(0); nv[cn] = 0;
                Nc(asgn, cn);
                arr_chain_add(asgn);
            }
            str_row++;
            续;
        }
        /* leaf: a[gi_idx[0]][gi_idx[1]]...[gi_idx[nd-1]] = expr */
        若 (tt[tk] == FK) { /* struct element initializer { ... }: parse into elem fields (fix 2026-08-15: commands[] global array of structs was skipped -> get_builtin found nothing) */
            整 si = (parse_base == 0) ? var_stidx((字*)(nn + d)) : -1; /* only global aggregate init uses this path; local struct arrays keep the old skip behavior (fix 2026-08-15: color.c local attrs[] parse break) */
            若 (si >= 0) {
                整 idn2 = Nd(1); memcpy((字*)(nn + idn2), (字*)(nn + d), 32);
                整 node2 = idn2;
                遍 (整 i = 0; i < nd; i++) {
                    整 acc2 = Nd(14); Nc(acc2, node2);
                    整 idx2 = Nd(0); nv[idx2] = gi_idx[i];
                    Nc(acc2, idx2);
                    node2 = acc2;
