            若 (str_cnt >= 65536) { fprintf(stderr, "[STR-OVERFLOW]\n"); abort(); }
            若 (!str_tbl[str_cnt]) str_tbl[str_cnt] = str_slot_alloc();
            strcpy(str_tbl[str_cnt], "范围越界\n");
            整 call_p = Nd(4); { 整 sn_r = Nd(0); nv[sn_r] = str_cnt; nt[sn_r] = STR; Nc(call_p, sn_r); } { 整 en_r = Nd(1); memcpy((字*)(nn + en_r), "printf", 7); Nc(call_p, en_r); } /* printf("范围越界\n") — 参数先挂, callee 最后 (同管道/断言/解包) */
            str_cnt++;
            Nc(b_r, call_p);
            整 call_x = Nd(4); { 整 one = Nd(0); nv[one] = 1; Nc(call_x, one); } { 整 en_x = Nd(1); memcpy((字*)(nn + en_x), "exit", 5); Nc(call_x, en_x); } /* exit(1) */
            Nc(b_r, call_x);
            Nc(if_r, b_r);
            Nc(blk_r, if_r);
        }
        返 blk_r;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "夹取")) { /* 接入 2026-08-27: 甲言 夹取 (clamp, 范围修正): 夹取 x, 1, 10; → if (x < 1) x = 1; if (x > 10) x = 10; — 越界修正不回退 (与范围检查"越界终止"互补); 复用 T_LK/T_GK 比较 + Nd(10) 赋值 */
        tk++; /* 夹取 */
        整 e_v = expr(); /* 变量/左值 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_lo = expr(); /* 下界 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_hi = expr(); /* 上界 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 blk_c = Nd(5);
        遍 (整 ci = 0; ci < 2; ci++) { /* 0=低于下界→赋下界, 1=高于上界→赋上界 */
            整 cmp_c = Nd(2); nv[cmp_c] = (ci == 0) ? T_LK : T_GK; /* < 或 > */
            Nc(cmp_c, e_v); Nc(cmp_c, (ci == 0) ? e_lo : e_hi);
            整 if_c = Nd(8); Nc(if_c, cmp_c);
            整 asg_c = Nd(10); Nc(asg_c, e_v); Nc(asg_c, (ci == 0) ? e_lo : e_hi); /* var = lo/hi */
            Nc(if_c, asg_c);
            Nc(blk_c, if_c);
        }
        返 blk_c;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "格式化")) { /* 接入 2026-08-27 字符串插值 (模板字符串): 格式化 "x={} y={}", x, y; → printf("x=%d y=%d", x, y); — {} 占位符按参数类型自动转格式符 (%d/%u/%f/%lld/%c/%s), 先解析参数收集类型再拼新格式串 */
        tk++; /* 格式化 */
        若 (tt[tk] != STR) { 整 nz = Nd(0); nv[nz] = 0; 返 nz; } /* 缺格式串: 空 */
        字 *fmts = str_tbl[tv[tk]]; tk++; /* 格式串字面量 */
        整 args[16]; 整 an = 0; /* 参数列表 */
        循环 (tt[tk] == CK && an < 16) { tk++; args[an++] = expr(); } /* 逗号分隔参数 */
        若 (tt[tk] == SK) tk++; /* ; */
        字 nfmt[512]; 整 ni = 0; 整 ai = 0; /* 新格式串缓冲 */
        遍 (字 *p = fmts; *p && ni < 500; p++) {
            若 (p[0] == '{' && p[1] == '}') { /* 占位符 → 参数类型格式符 */
                常 字 *ff = "%d";
                整 ty = (ai < an) ? expr_type_of(args[ai]) : 0;
                若 (ty == 5) ff = "%u"; 否 若 (ty == 4) ff = "%f"; 否 若 (ty == 3) ff = "%lld"; 否 若 (ty == 1) ff = "%c"; 否 若 (ty == 6) ff = "%s";
                ai++;
                循环 (*ff && ni < 500) nfmt[ni++] = *ff++;
                p++; /* 跳过 } */
            } 否 nfmt[ni++] = *p;
        }
        nfmt[ni] = 0;
        若 (str_cnt >= 65536) { fprintf(stderr, "[STR-OVERFLOW]\n"); abort(); }
        若 (!str_tbl[str_cnt]) str_tbl[str_cnt] = str_slot_alloc();
        strcpy(str_tbl[str_cnt], nfmt);
        整 nfmt_idx = str_cnt; str_cnt++;
        整 call = Nd(4);
        { 整 sn = Nd(0); nv[sn] = nfmt_idx; nt[sn] = STR; Nc(call, sn); } /* 新格式串 */
        遍 (整 i = 0; i < an; i++) Nc(call, args[i]); /* 参数 */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "printf", 7); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "投递")) { /* 接入 2026-08-27 actor 消息投递 (Erlang 风格, 同送/收模式): 投递 m, v; → actor_send(&m, v); — 用户定义 actor_send/actor_recv (邮箱+类型分派) */
        tk++; /* 投递 */
        整 e_m = expr(); /* 邮箱表达式 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_v = expr(); /* 消息表达式 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 call = Nd(4);
        { 整 addr = Nd(11); Nc(addr, e_m); Nc(call, addr); } /* &m */
        Nc(call, e_v); /* v */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "actor_send", 11); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "接收")) { /* 接入 2026-08-27 actor 消息接收: 接收 m, v; → actor_recv(&m, &v); — 双取址, callee 最后 */
        tk++; /* 接收 */
        整 e_m = expr(); /* 邮箱表达式 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_v = expr(); /* 目标表达式 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 call = Nd(4);
        { 整 addr1 = Nd(11); Nc(addr1, e_m); Nc(call, addr1); } /* &m */
        { 整 addr2 = Nd(11); Nc(addr2, e_v); Nc(call, addr2); } /* &v */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "actor_recv", 11); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "线程")) { /* 接入 2026-08-27 线程创建 (库级语法糖, 同通道模式): 线程 t 跑 work, arg; → thread_create(&t, work, arg); — 用户定义 thread_create/thread_join (确定性单线程模拟) */
        tk++; /* 线程 */
        字 tvar[64]; strcpy(tvar, tn[tk]); tk++; /* 线程变量 */
        若 (tt[tk] == VR && !strcmp(tn[tk], "跑")) tk++; /* 跑 */
        整 e_fn = expr(); /* 任务函数 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_arg = expr(); /* 参数 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 call = Nd(4);
        { 整 tv = Nd(1); memcpy((字*)(nn + tv), tvar, 32); 整 addr = Nd(11); Nc(addr, tv); Nc(call, addr); } /* &t */
        Nc(call, e_fn); /* work */
        Nc(call, e_arg); /* arg */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "thread_create", 14); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "等待")) { /* 接入 2026-08-27 线程等待 (库级语法糖): 等待 t; → thread_join(&t); */
        tk++; /* 等待 */
        整 e_t = expr(); /* 线程变量 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 call = Nd(4);
        { 整 addr = Nd(11); Nc(addr, e_t); Nc(call, addr); } /* &t */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "thread_join", 12); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "推导")) { /* 接入 2026-08-27 列表推导 (Python/Haskell 推导式, 区间映射): 推导 dst, x*x 于 x 遍 0 到 5; → { __ci=0; x=0; while(x<5){ dst[__ci]=x*x; __ci++; x++; } } — 目标数组 + 迭代变量均须已声明 */
        tk++; /* 推导 */
        字 darr[64]; strcpy(darr, tn[tk]); tk++; /* 目标数组名 */
        若 (tt[tk] == CK) tk++; /* , */
        整 elem_e = expr(); /* 元素表达式 (停在 于) */
        若 (tt[tk] == VR && !strcmp(tn[tk], "于")) tk++; /* 于 */
        字 ivar[64]; strcpy(ivar, tn[tk]); tk++; /* 迭代变量 */
        若 (tt[tk] == JK) tk++; /* 遍 — lexer 映射到 for/JK (非 VR, fix 2026-08-27) */
        整 lo_e = expr(); /* 下界 (停在 到) */
        若 (tt[tk] == VR && !strcmp(tn[tk], "到")) tk++; /* 到 */
        整 hi_e = expr(); /* 上界 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 dc_seq = 0; 字 ciname[64]; sprintf(ciname, "__ci_%d_", dc_seq++);
        var_offset(ciname); /* 内部计数器 */
        整 blk_d = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), ciname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk_d, d); } /* int __ci = 0; */
        整 v_iv = Nd(1); memcpy((字*)(nn + v_iv), ivar, 32);
        { 整 asg0 = Nd(10); Nc(asg0, v_iv); Nc(asg0, lo_e); Nc(blk_d, asg0); } /* x = lo; */
        整 wh_d = Nd(9);
        { 整 cmp_d = Nd(2); nv[cmp_d] = T_LK; Nc(cmp_d, v_iv); Nc(cmp_d, hi_e); Nc(wh_d, cmp_d); } /* while (x < hi) */
        整 bd_d = Nd(5);
        整 v_ci = Nd(1); memcpy((字*)(nn + v_ci), ciname, 32);
        整 v_da = Nd(1); memcpy((字*)(nn + v_da), darr, 32);
        整 idx_d = Nd(14); Nc(idx_d, v_da); Nc(idx_d, v_ci); /* dst[__ci] */
        { 整 asg_d = Nd(10); Nc(asg_d, idx_d); Nc(asg_d, elem_e); Nc(bd_d, asg_d); } /* dst[__ci] = elem; */
        { 整 pl_d = Nd(2); nv[pl_d] = PK; Nc(pl_d, v_ci); { 整 one = Nd(0); nv[one] = 1; Nc(pl_d, one); } 整 asg_ci = Nd(10); Nc(asg_ci, v_ci); Nc(asg_ci, pl_d); Nc(bd_d, asg_ci); } /* __ci = __ci + 1; */
        { 整 pl_x = Nd(2); nv[pl_x] = PK; Nc(pl_x, v_iv); { 整 one = Nd(0); nv[one] = 1; Nc(pl_x, one); } 整 asg_x = Nd(10); Nc(asg_x, v_iv); Nc(asg_x, pl_x); Nc(bd_d, asg_x); } /* x = x + 1; */
        Nc(wh_d, bd_d);
        Nc(blk_d, wh_d);
        返 blk_d;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "重载")) { /* 接入 2026-08-27 运算符重载注册: 重载 + 点 = 点_add; → ov 表注册 (运算符 + 类型名 → 函数名), add() 分派 — 用户先定义普通函数再注册 */
        tk++; /* 重载 */
        整 op_r = 0;
        若 (tt[tk] == PK) { op_r = PK; tk++; } /* + */
        否 若 (tt[tk] == MK) { op_r = MK; tk++; } /* - */
        字 ty_r[64] = ""; 若 (tt[tk] == VR) { strcpy(ty_r, tn[tk]); tk++; } /* 类型名 */
        若 (tt[tk] == AK) tk++; /* = */
        字 fn_r[64] = ""; 若 (tt[tk] == VR) { strcpy(fn_r, tn[tk]); tk++; } /* 函数名 */
        若 (tt[tk] == SK) tk++; /* ; */
        若 (ov_n < 32 && op_r && ty_r[0] && fn_r[0]) { ov_op[ov_n] = (字)op_r; strcpy(ov_ty[ov_n], ty_r); strcpy(ov_fn[ov_n], fn_r); ov_n++; }
        返 Nd(5);
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "送")) { /* 接入 2026-08-27: 甲言 通道发送 (Go channel send 语法糖): 送 ch, v; → chan_send(&ch, v); — 参数先挂, callee (chan_send) 最后 (同管道/断言) */
        tk++; /* 送 */
        整 e_ch = expr(); /* 通道表达式 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_v = expr(); /* 值表达式 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 call = Nd(4);
        { 整 addr = Nd(11); Nc(addr, e_ch); Nc(call, addr); } /* &ch */
        Nc(call, e_v); /* v */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "chan_send", 10); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "收")) { /* 接入 2026-08-27: 甲言 通道接收 (Go channel recv 语法糖): 收 ch, v; → chan_recv(&ch, &v); — 两参都取址, callee 最后 */
        tk++; /* 收 */
        整 e_ch = expr(); /* 通道表达式 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_v = expr(); /* 目标表达式 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 call = Nd(4);
        { 整 addr1 = Nd(11); Nc(addr1, e_ch); Nc(call, addr1); } /* &ch */
        { 整 addr2 = Nd(11); Nc(addr2, e_v); Nc(call, addr2); } /* &v */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "chan_recv", 10); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == SK) { tk++; 返 Nd(5); } /* 空语句 ; — 返回空块节点 (codegen 无输出). fix 2026-08-19: 原落 expr() 兜底返回 -1 (不消费) → stmt() 挂 -1 给 if 空体 → case-8 codegen n1=-1 错乱 → `if (c) ; else ...` else 链无条件执行 (commit.c handle_ignored_arg strcmp(NULL) SEGV) */
    
    { 整 e = expr(); tk++; 返 e; }
}
/* 常量整数表达式求值 (数组维度用): 支持整数/枚举/宏常量、括号、+-*\/%<>^&| 与一元 +-~。
   左到右求值 (维度表达式几乎都是单运算符, 优先级差异可忽略)。成功置 *val 并推进 tk, 返回 1; 失败不推进, 返回 0。
   (fix 2026-08-14: hash_algos[GIT_HASH_NALGOS] 展开成 [(2 + 1)] — 原数组维度只认单 NK/VR token, `(` 卡住 → 维度=0 → 后续 null_oid 定义被吞 undefined) */
静 整 const_expr_eval(整 *val); /* fwd */
静 整 const_expr_prim(整 *val) {
    若 (tt[tk] == NK) { *val = tv[tk]; tk++; 返 1; }
    若 (tt[tk] == AL) { /* _Alignof 常量求值 (fix 2026-08-25 支持矩阵补全 step1) */
        tk++; 若 (tt[tk] == OK) tk++;
        *val = alignof_type();
        若 (tt[tk] == KK) tk++;
        返 1;
    }
    若 (tt[tk] == BK) { /* sizeof 常量维度: char tmp[sizeof "..."] (fix 2026-08-15: inet_ntop.c tp 未注册 undefined) */
        tk++; 若 (tt[tk] == OK) tk++; /* sizeof( */
        整 sz = 4;
        /* fix 2026-08-17: sizeof((arr)[idx]) — 括号数组元素 (ARRAY_SIZE(paths) 展开成
           sizeof(paths)/sizeof((paths)[0])): (paths) 括号后跟 [0] 下标, 原代码既不进
           VR 分支也不被 OK 分支消费 → sz 错 + token 残留 → 数组维度求值错 →
           brace_arr_init 越界崩 (diff-no-index.c to_free 0xC0000005). */
        若 (tt[tk] == OK && tt[tk + 1] == VR && tt[tk + 2] == KK && tt[tk + 3] == LB) {
            整 pe = var_esz(tn[tk + 1]); 若 (pe > 0) sz = pe;
            tk += 4; 循环 (tk < TS && tt[tk] != RB && tt[tk] != EK) tk++; 若 (tt[tk] == RB) tk++;
            若 (tt[tk] == KK) tk++; /* 末尾 ) */
            *val = sz; 返 1;
        }
        若 (tt[tk] == STR) { sz = (整)strlen(str_tbl[tv[tk]]) + 1; tk++; }
        否 若 (tt[tk] == VK) { 若 (!strcmp(tn[tk],"char")||!strcmp(tn[tk],"_Bool")) sz=1; 否 若 (!strcmp(tn[tk],"double")) sz=8; 否 若 (!strcmp(tn[tk],"short")) sz=2; tk++; 循环 (tt[tk] == DK) { sz = 8; tk++; } }
        否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { 整 si = st_find(tn[tk]); 若 (si >= 0) sz = stypes[si].sz; tk++; } }
        否 若 (tt[tk] == DK) { sz = 8; tk++; 若 (tt[tk] == VR) tk++; }
        否 若 (tt[tk] == VR) { 整 si = var_stidx(tn[tk]);
            若 (si < 0 && td_is(tn[tk])) { 整 tdi = tdef_lookup(tn[tk]); 若 (tdi >= 0 && tdefs[tdi].sz > 0) { sz = tdefs[tdi].sz; tk++; } } /* fix 2026-08-20: typedef 名 sizeof (sizeof(uint64_t) 原 4 → csprng_bytes(&v,sizeof(v)) 只填低 4 字节 → mkstemp 随机后缀高 4 字节垃圾 → 乱码文件名) */
            否 tk++;
            若 ((tt[tk] == AR || tt[tk] == DT) && tt[tk + 1] == VR) { 若 (si >= 0) { 整 fs = st_field_size(stypes[si].name, tn[tk + 1]); 若 (fs > 0) sz = fs; } tk += 2; }
            /* fix 2026-08-17: sizeof(裸数组名) 返回数组总字节数 (arr_sz * esz) — 原默认 4 →
               ARRAY_SIZE(arr) 展开 sizeof(arr) 除错 → 数组维度求值错 (diff-no-index.c to_free).
               仅当是数组变量 (arr_sz>0) 才覆盖, 普通变量保持默认 4. */
            否 { 整 an = var_arrsz(tn[tk - 1]); 若 (an > 0) sz = an * var_esz(tn[tk - 1]); 否 { 整 vsz = var_sizeof(tn[tk - 1]); 若 (vsz > 0) sz = vsz; } } } /* fix 2026-08-20: 普通变量 sizeof (long long v → 8; 原 4) */
        若 (tt[tk] == KK) tk++;
        *val = sz; 返 1;
    }
    若 (tt[tk] == VR) { 整 ev = e_lookup(tn[tk]); 若 (ev == 0x80000000) ev = macro_find(tn[tk]); 若 (ev != 0x80000000 && ev != -1) { *val = ev; tk++; 返 1; } 返 0; }
    若 (tt[tk] == OK) { tk++; 若 (!const_expr_eval(val)) 返 0; 若 (tt[tk] == KK) tk++; 返 1; }
    若 (tt[tk] == MK) { tk++; 若 (!const_expr_prim(val)) 返 0; *val = -*val; 返 1; }
    若 (tt[tk] == PK) { tk++; 返 const_expr_prim(val); }
    若 (tt[tk] == BN) { tk++; 若 (!const_expr_prim(val)) 返 0; *val = ~*val; 返 1; }
    返 0;
}
静 整 const_expr_eval(整 *val) {
    若 (!const_expr_prim(val)) 返 0;
    遍 (;;) {
        整 op = tt[tk];
        若 (op == PK || op == MK || op == DK || op == DV || op == MD || op == SH || op == SR || op == PT || op == OR || op == XR || op == QK || op == XK || op == LK || op == GK || op == HK || op == YK) {
            tk++; 整 r; 若 (!const_expr_prim(&r)) 返 0;
            择 (op) { 例 PK: *val += r; 断; 例 MK: *val -= r; 断; 例 DK: *val *= r; 断;
                例 DV: 若 (r) *val /= r; 断; 例 MD: 若 (r) *val %= r; 断; 例 SH: *val <<= r; 断;
                例 SR: *val >>= r; 断; 例 PT: *val &= r; 断; 例 OR: *val |= r; 断; 例 XR: *val ^= r; 断;
                例 QK: *val = (*val == r); 断; 例 XK: *val = (*val != r); 断; 例 LK: *val = (*val < r); 断;
                例 GK: *val = (*val > r); 断; 例 HK: *val = (*val <= r); 断; 例 YK: *val = (*val >= r); 断; /* fix 2026-08-25: _Static_assert 比较运算符 */ }
        } 否 断;
    }
    返 1;
}

静 整 skip_global_init(整 tk) {
    /* 跳过全局/文件级声明中的初始化器: = expr / = { ... } / = ( ... )
       到顶层逗号或分号停止 (不消费逗号/分号)。 (fix 2026-08-15: *local_packs = NULL, *altodb_packs = NULL) */
    若 (tt[tk] != AK) 返 tk;
    tk++;
    整 d = 0;
    循环 (tk < TS && tt[tk] != EK) {
        若 (tt[tk] == FK || tt[tk] == OK || tt[tk] == LB) d++;
        否 若 (tt[tk] == UK || tt[tk] == KK || tt[tk] == RB) { d--; 若 (d < 0) d = 0; }
        否 若 (d == 0 && (tt[tk] == CK || tt[tk] == SK)) 断;
        tk++;
    }
    返 tk;
}

静 整 parse(常 字 *s) {
    tk = 0; nc = 1; vcnt = 0; rsp_used = 32; /* reserve shadow space */
    遍 (整 _vi = 0; _vi < 16384; _vi++) { vars[_vi].alignN = 0; vars[_vi].align_base = 0; vars[_vi].vla_dim = 0; } /* fix step30/31: 静态 vars 数组跨编译残留清零 — 对齐间接/VLA 标记必须每编译重置 */
    fdef_n = 0; /* fix 2026-08-06: 每次 parse 重置顶层函数列表 */
    memset(ndbl, 0, 大小(ndbl)); /* per-node double flags must not leak across compiles */
    memset(nuns, 0, 大小(nuns)); /* per-node unsigned flags (fix 2026-08-05) */
    fvn = 0; /* reset per-function var-range table */
    memset(tt, 0, TS * 4);
    字 *exp_src = pp_include_expand(s, 0); /* #include 预展开（fix 2026-08-06） */
    
     
    fn_macro_collect(exp_src); /* fix 2026-08-07: 移到 include 展开之后 — 头文件里的函数宏才能被收集展开 */
     
    obj_macro_collect(exp_src); /* fix 2026-08-13: 对象宏收集 (lex 前, Git hash-ll.h) */
     
    若 (fn_macro_n > 0) {
        字 *msrc = fn_macro_expand(exp_src);
         
        若 (msrc && msrc[0]) { free(exp_src); exp_src = msrc; }
    }
    若 (obj_macro_n > 0) { /* fix 2026-08-13: 对象宏文本层展开 (lex 前) */
         
        字 *osrc = obj_macro_expand(exp_src);
        若 (osrc && osrc[0]) { free(exp_src); exp_src = osrc; }
    }
    若 (fn_macro_n > 0) { /* fix 2026-08-15: 对象宏值里嵌套的函数宏需第二遍展开 (STRMAP_INIT → HASHMAP_INIT) — 否则 jyld undefined symbol */
        字 *msrc2 = fn_macro_expand(exp_src);
        若 (msrc2 && msrc2[0]) { free(exp_src); exp_src = msrc2; }
    }
    pp_guard_n = 0; /* fix 2026-08-13 Phase3: lex 阶段 #if defined(X) 走 macro 表(lex 自己的 #define); 清 pp_guard 防 fn_macro_collect 污染 → #if !defined(XTYPES_H) 被误判已定义跳过 xtypes.h typedef */
    
     
    lex(exp_src);
    
    free(exp_src);
    若 (ti >= TS) { fprintf(stderr, "[ERR] token overflow\n"); 返 -1; }
    整 p = Nd(3); 若 (p < 0) 返 -1;
    nc_root_p = p; /* fix 2026-08-18: 记录根节点 → Nc 子节点硬上限豁免 (根子槽仅 256, 函数>256 由 fdef_list 保留) */
    
    循环 (tk < TS && tt[tk] != EK) {
        alignas_pending = 0; ag_struct = 0; /* fix 2026-08-25 step21: 每顶层语句清残留 — 变量前 _Alignas 不消费也不毒害后续 struct; step25: ag_struct 同步清 */
        若 (tt[tk] == AG) { 整 agv = tv[tk]; tk++; 若 (tt[tk] == ST) { ag_struct = agv; alignas_pending = 0; } 否 alignas_pending = agv; } /* fix 2026-08-25 step21: 顶层 _Alignas(N) — struct 前修饰 struct 变量 (step25), 否则给变量 (下一轮清理) */
        
        若 (tt[tk] == VR && (!strcmp(tn[tk], "__asm__") || !strcmp(tn[tk], "__asm"))) { /* 顶层内联汇编 (__attribute__ 误解析致函数体落到顶层): 跳过 */
            tk++;
            若 (tt[tk] == VR && (!strcmp(tn[tk], "__volatile__") || !strcmp(tn[tk], "volatile"))) tk++;
            若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } }
            若 (tt[tk] == SK) tk++;
            续;
        }
        /* _Static_assert(expr, "msg"); — C11 编译期断言 (fix 2026-08-25 支持矩阵补全) */
        若 (tt[tk] == VR && (!strcmp(tn[tk], "_Static_assert") || !strcmp(tn[tk], "static_assert"))) {
            tk++; /* skip name */
            若 (tt[tk] == OK) tk++; /* ( */
            整 sval = 0;
            const_expr_eval(&sval);
            循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++; /* 跳到分号 (跳过 , "msg" ) ) */
            若 (tt[tk] == SK) tk++;
            若 (!sval) { fprintf(stderr, "[ERR] _Static_assert 失败\n"); 返 -1; }
            续;
        }
        /* struct definition: struct Name { fields; }; or struct { fields; } var; */
        若 (tt[tk] == ST || (tt[tk] == VK && !strcmp(tn[tk], "static") && tt[tk + 1] == ST)) {
            整 st_static = (tt[tk] == VK); /* fix 2026-08-15: static struct X {...} */
            整 st_orig = tk;
            若 (st_static) tk++;
            整 st_save = tk;
            整 is_union = !strcmp(tn[tk], "union");
            tk++; /* skip struct */
            若 (tt[tk] == VR || (tt[tk] == VK && !strcmp(tn[tk], "FILE"))) { /* tagged: keep the tag as the struct name (FILE 被 kw() 归为 VK, 但 `struct FILE;` 前向声明必须识别 — fix 2026-08-15: transport_connect undefined 根因) */
                整 si = st_find(tn[tk]); 若 (si < 0) si = st_add(tn[tk]); /* fix 2026-08-05: `struct S s;` (no body) re-added an EMPTY S → st_find later hit the wrong index → global struct field reads/writes broke */
                若 (getenv("QCC_DBG_NS")) 若 (!strcmp(tn[tk], "ref_namespace_info")) { fprintf(stderr, "[NS] main-parser struct tag='%s' si=%d next_tt=%d next='%s'\n", tn[tk], si, tk + 1 < TS ? tt[tk + 1] : -1, tk + 1 < TS ? tn[tk + 1] : "-"); 遍 (整 _dt = tk + 1; _dt < tk + 12 && _dt < TS; _dt++) fprintf(stderr, "[NS]   tok[%d] tt=%d '%s'\n", _dt, tt[_dt], tn[_dt]); }
                tk++; /* struct name */
                若 (tt[tk] == SK) { tk++; 续; } /* struct X; 前向声明 (无 body 无变量) — 原回退到 decl 分支后落函数检测 break 截断 parse (fix 2026-08-13 Phase3: regex_internal.h struct re_dfa_t;) */
                若 (tt[tk] == FK) { /* { */
                    tk++;
                    整 funs = 0; /* unsigned bit-field marker (fix 2026-08-05) */
                    整 fsz = 4; 整 frow = 1; 整 fdbl = 0; 整 fll = 0; 整 ffnptr = 0; 整 fpel_persist = 4; 整 sty_persist = -1; /* fix 2026-08-16 根因E: 字段类型状态提循环外 — 逗号声明 `char p_dbl, is_char, is_uns, is_ll;` 的后续字段必须继承类型 (原每次迭代重置 fsz=4 → char 字段算成 int → vars 结构 136 算成 152 → 变量表步长错位 → Git 大文件崩); fpel_persist: 逗号继承的指针指向元素大小 (fix 2026-08-17); sty_persist: 逗号续行 struct 字段继承类型索引 (fix 2026-08-18: struct list_head *next, *prev — 续行 *prev 原缺 st_field_ty → st_field_ty_idx=-1 → mem_addr 链 head.prev->next 失败 → 存储丢弃+无配对 push → git init list_add_tail 崩) */
                    循环 (tk < TS && tt[tk] != UK) {
                        若 (tt[tk] == AG) { alignas_pending = tv[tk]; tk++; 续; } /* fix 2026-08-25 step21: 字段 _Alignas(N) → st_field_sz_r 消费 */
                        若 (getenv("QCC_DBG_NS")) 若 (stypes[si].name[0] == 0 || strstr(stypes[si].name, "ref_namespace")) fprintf(stderr, "[NS]  body-tok %d tt=%d '%s'\n", tk, tt[tk], tn[tk]);
                        整 tk0 = tk; /* 安全前进守卫: 未识别字段类型时强制 +1, 防死循环 (fix 2026-08-13) */
                        整 dims = 0; 整 first = 1; /* dims/first 数组维度每次迭代独立 */
                        整 tdfield_si = -1; /* fix 2026-08-19: typedef struct 字段的 struct 类型索引 (z_stream z; → 注册后 st_field_ty) — 原缺 → 嵌套链 gz.z.avail_in 断 */
                        整 type_seen = 0; /* fix 2026-08-17: 本次迭代是否确定新类型 (char* 的 pointee 捕获依据) */
                        整 tkw = 0; /* fix 2026-08-19: 本次迭代是否消费过类型关键字 — 已见基类型时后续 VR 是字段名 (char *ref; 的 ref 撞 remote.h struct ref 标签被当类型吞掉) */
                        若 (tt[tk] == VK) { tkw = 1; 循环 (tt[tk] == VK && !strcmp(tn[tk], "const")) tk++; /* fix 2026-08-18: `const char *name` — 原只消费第一个 VK (const) → char 留在 token 流 → 后续字段解析错 */ 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { fsz = 1; frow = 1; type_seen = 1; } 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; frow = 8; fdbl = 1; type_seen = 1; } 否 若 (!strcmp(tn[tk], "long")) { 若 (tt[tk+1] == VK && !strcmp(tn[tk+1], "long")) { fsz = 8; frow = 8; fll = 1; } type_seen = 1; } 否 若 (!strcmp(tn[tk], "short")) { fsz = 2; frow = 2; type_seen = 1; } 若 (!(tt[tk] == ST || tt[tk] == EN)) tk++; /* fix 2026-08-18: const 后跟 struct/enum (`const struct ref_storage_be *be`) 不能吞关键字 — 原无条件 tk++ 吃掉 struct → 字段类型索引丢失 (ty_idx=-1) → 多级成员链 (refs->be->init_db) 断 → call *refs SEGV; 让 5114 ST 分支正常解析 */
                            若 (tt[tk] == VK && !strcmp(tn[tk], "long")) { 若 (fll == 0 && tt[tk+1] == VK && !strcmp(tn[tk+1], "long")) { fsz = 8; frow = 8; fll = 1; } tk++; } /* 第二个 long: unsigned long long 场景 — unsigned 后第一个 long 未设 8B, 第二个 long 补设 (fix 2026-08-17: 原只消费不设 → unsigned long long 字段 4B) */ }
                        整 npel = 0; /* 指针地块数 (指针字段标记, fix 2026-08-18: ctx->argv++ char** 需按 8 缩放) */
                        整 fpel = type_seen ? fsz : fpel_persist; /* fix 2026-08-17: 指针字段的指向元素大小 (char *buf → 1); 逗号继承 (char *p, *q) 用 fpel_persist */
                        整 fsz_base = fsz; /* fix 2026-08-18: 指针字段前的基类型大小 (unsigned *seen, x → x 是 unsigned 4B 非 8B) — 逗号续行用 fsz_base 恢复 */
                        { 循环 (tt[tk] == DK) { fsz = 8; frow = 8; npel++; tk++; 循环 (tt[tk] == VK && (!strcmp(tn[tk], "const") || !strcmp(tn[tk], "volatile"))) tk++; } 若 (npel > 1) fpel = 8; } /* pointer field (fix 2026-08-16: frow=8 — 逗号后指针字段继承); 多级指针 → pointee 8; fix 2026-08-19: 每级指针后吞 const/volatile (`const char * const key`) — 原 const 残留 → 字段名被当类型吞掉 → trace_key key 字段丢失 → get_trace_fd 错位 → git add getenv(NULL) 崩 */
                        若 (getenv("QCC_DBG_NS")) 若 (stypes[si].name[0] == 0 || strstr(stypes[si].name, "ref_namespace")) fprintf(stderr, "[NS]  post-ptr tok=%d tt=%d '%s' fsz=%d frow=%d npel=%d is_union=%d\n", tk, tt[tk], tn[tk], fsz, frow, npel, is_union);
                        若 (tt[tk] == ST) { /* nested struct field: struct Inner in; (or struct Node *next — self ref) */
                            整 sub_is_union = !strcmp(tn[tk], "union");
                            tk++; /* struct */
                            若 (tt[tk] == FK) { /* 匿名 struct/union body: union { ... } u; — 解析字段到匿名类型 (fix 2026-08-18: 原跳过 body 注册 8 字节近似 → config_source union{FILE*; struct config_buf{...}buf;}u 记 8B 无类型 → conf->u.file 链无类型可查 → config_file_fgetc 丢函数体返 0 → git config 解析全 0 → "bad config line 1"/SEGV) */
                                整 u_is_union = sub_is_union;
                                字 uan[64]; sprintf(uan, "__anon_%d", st_n);
                                整 u_si = st_add(uan);
                                tk++; /* { */
                                循环 (tk < TS && tt[tk] != UK) {
                                    整 utk0 = tk;
                                    整 ufsz = 4, ufdbl = 0, ufll = 0, u_npel = 0;
                                    若 (tt[tk] == VK) {
                                        循环 (tt[tk] == VK && !strcmp(tn[tk], "const")) tk++; /* fix 2026-08-18: `const char *buf` — 原只消费第一个 VK (const) → char 留在 token 流 → 字段名丢失 → config_buf 布局错 */
                                        若 (!strcmp(tn[tk], "unsigned")) { /* ignore */ }
                                        否 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { ufsz = 1; }
                                        否 若 (!strcmp(tn[tk], "double")) { ufsz = 8; ufdbl = 1; }
                                        否 若 (!strcmp(tn[tk], "short")) { ufsz = 2; }
                                        否 若 (!strcmp(tn[tk], "long")) { ufsz = 8; ufll = 1; }
                                        若 (!(tt[tk] == ST || tt[tk] == EN)) tk++; /* fix 2026-08-18: const 后跟 struct/enum 不能吞关键字 */
                                        若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++;
                                    }
                                    循环 (tt[tk] == DK) { ufsz = 8; u_npel++; tk++; }
                                    整 u2_si = -1; 整 u2_union = 0;
                                    若 (tt[tk] == ST) { /* 嵌套 struct/union 成员 (含内联 body): struct config_buf {...} buf; / struct align align; */
                                        u2_union = !strcmp(tn[tk], "union");
                                        tk++;
                                        若 (tt[tk] == VR) { u2_si = st_find(tn[tk]); tk++; }
                                        循环 (tt[tk] == DK) { ufsz = 8; u_npel++; tk++; } /* fix 2026-08-23 t35d: `struct X *name` — struct 类型后指针原被拆成两次迭代 (第二次 u2_si 重置 -1) → union 成员 ftypes 未设 → mem_addr 链 (ma->u.attr->attr_nr) 失败 → diff 崩 */
                                        若 (tt[tk] == FK) { /* 内联 body: 解析到新匿名类型 (完整成员语法: enum/位域/typedef/嵌套结构) */
                                            字 u2an[64]; sprintf(u2an, "__anon_%d", st_n);
                                            整 u2 = st_add(u2an);
                                            tk++; /* { */
                                                整 v2t_si_persist = -1; /* fix 2026-08-24 t35v: 逗号续行 struct 字段继承类型 (struct object_id ooid, noid; — v2t_si 每次迭代重置 → 续行 noid 无类型 → 布局 36+4 错 → git reflog 无输出) */
                                            循环 (tk < TS && tt[tk] != UK) {
                                                整 v2k0 = tk;
                                                整 v2sz = 4, v2dbl = 0, v2ll = 0;
                                                若 (tt[tk] == VK) {
                                                    循环 (tt[tk] == VK && !strcmp(tn[tk], "const")) tk++; /* fix 2026-08-18: `const char *` — 原只消费第一个 VK (const) → char 留在 token 流 → 字段名丢失 → config_buf 布局错 (config_source u.buf.len/pos 偏移错) */
                                                    若 (!strcmp(tn[tk], "unsigned")) { /* ignore */ }
                                                    否 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { v2sz = 1; }
                                                    否 若 (!strcmp(tn[tk], "double")) { v2sz = 8; v2dbl = 1; }
                                                    否 若 (!strcmp(tn[tk], "short")) { v2sz = 2; }
                                                    否 若 (!strcmp(tn[tk], "long")) { v2sz = 8; v2ll = 1; }
                                                    若 (!(tt[tk] == ST || tt[tk] == EN)) tk++; /* fix 2026-08-18: const 后跟 struct/enum 不能吞关键字 */
                                                    若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++;
                                                }
                                                否 若 (tt[tk] == VR && td_is(tn[tk])) { 整 tdv = tdef_lookup(tn[tk]); 若 (tdv >= 0 && tdefs[tdv].sz > 0) { v2sz = tdefs[tdv].sz; } tk++; } /* typedef 成员 (size_t=8B) */
                                                循环 (tt[tk] == DK) { v2sz = 8; tk++; }
                                                整 v2t_si = -1;
                                                若 (tt[tk] == ST) { /* 嵌套 struct/union 成员 */
                                                    tk++;
                                                    若 (tt[tk] == VR) { v2t_si = st_find(tn[tk]); tk++; 若 (v2t_si >= 0) v2t_si_persist = v2t_si; } /* fix 2026-08-24 t35v */
                                                    若 (tt[tk] == FK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == FK) d++; 否 若 (tt[tk] == UK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } /* 三层内联 body: 跳过 (尺寸近似 8) */
                                                    若 (tt[tk] == DK) tk++;
                                                }
                                                否 若 (tt[tk] == EN) { /* enum 成员: enum {...} option; */
                                                    tk++; 若 (tt[tk] == VR) tk++;
                                                    若 (tt[tk] == FK) { tk++; 整 ev = 0; 循环 (tk < TS && tt[tk] != UK && tt[tk] != EK) { 整 tk0 = tk; 若 (tt[tk] == VR) { 字 enm[64]; memcpy(enm, tn[tk], 64); tk++; 若 (tt[tk] == AK) { tk++; 整 evv = 0; 若 (const_expr_eval(&evv)) ev = evv; } e_reg(enm, ev); ev++; } 若 (tt[tk] == CK) tk++; 若 (tk == tk0) tk++; } 若 (tt[tk] == UK) tk++; }
                                                }
                                                若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) tk++; } /* 无名位域 */
                                                若 (tt[tk] == VR) {
                                                    字 v2f[64]; strcpy(v2f, tn[tk]); tk++;
                                                    整 v2bw = 0;
                                                    若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) { v2bw = tv[tk]; tk++; } }
                                                    整 v2sz2 = (v2t_si >= 0) ? stypes[v2t_si].sz : ((v2t_si_persist >= 0) ? stypes[v2t_si_persist].sz : v2sz); /* fix 2026-08-24 t35v: 逗号续行 struct 字段继承大小 */
                                                    整 v2dims = 0, v2first = 1;
                                                    循环 (tt[tk] == LB) { tk++; 整 cdim = 0; 若 (const_expr_eval(&cdim)) { 若 (v2dims == 0) v2first = cdim; v2dims++; v2sz2 *= cdim > 0 ? cdim : 1; } 否 { v2dims++; 循环 (tk < TS && tt[tk] != RB && tt[tk] != EK) tk++; } 若 (tt[tk] == RB) tk++; } /* t35k 2026-08-23: u2 嵌套内联字段数组维度整体表达式求值 */
                                                    若 (v2bw > 0) v2sz2 = 4;
                                                    若 (u2_union) { st_union_field(u2, v2f, v2sz2); 若 (v2t_si >= 0) st_field_ty(u2, v2f, v2t_si); }
                                                    否 { 整 v2row2 = v2dims >= 1 ? v2sz2 / v2first : v2sz2; st_field_sz_r(u2, v2f, v2sz2, v2row2); 若 (v2t_si >= 0) st_field_ty(u2, v2f, v2t_si);  /* fix 2026-08-20: struct 数组字段按元素 struct algn 校正偏移 — st_field_sz_r 只按 frow 大小推对齐 (frow=16→align 8), 元素纯 int struct (algn=4) 时应对齐 4 (exclude_group[3] 应 off 4 实 8) */ 若 (v2dims >= 1 && v2t_si >= 0 && stypes[v2t_si].algn > 1) { 整 eal5 = stypes[v2t_si].algn; 整 fidx5 = stypes[u2].fn - 1; 整 foff5 = stypes[u2].foffs[fidx5]; 整 fsz5 = stypes[u2].fsizes[fidx5]; 若 (foff5 % eal5) { 整 noff5 = foff5 + (eal5 - (foff5 % eal5)); stypes[u2].foffs[fidx5] = noff5; stypes[u2].sz = noff5 + fsz5; } } }
                                                    若 (v2ll) st_field_ty(u2, v2f, -3);
                                                    若 (v2dbl) st_field_dbl(u2, v2f);
                                                }
                                                若 (tt[tk] == CK) tk++;
                                                若 (tt[tk] == SK) tk++;
                                                若 (tk == v2k0) tk++;
                                            }
                                            若 (tt[tk] == UK) tk++; /* } */
                                            u2_si = u2;
                                        }
                                    }
                                    否 若 (tt[tk] == EN) { /* enum 成员: enum Color c; / 匿名 enum {A} c; */
                                        tk++; 若 (tt[tk] == VR) tk++;
                                        若 (tt[tk] == FK) { tk++; 整 ev = 0; 循环 (tk < TS && tt[tk] != UK && tt[tk] != EK) { 整 tk0 = tk; 若 (tt[tk] == VR) { 字 enm[64]; memcpy(enm, tn[tk], 64); tk++; 若 (tt[tk] == AK) { tk++; 整 evv = 0; 若 (const_expr_eval(&evv)) ev = evv; } e_reg(enm, ev); ev++; } 若 (tt[tk] == CK) tk++; 若 (tk == tk0) tk++; } 若 (tt[tk] == UK) tk++; }
                                    }
                                    否 若 (tt[tk] == VR && td_is(tn[tk])) { 整 tdv = tdef_lookup(tn[tk]); 若 (tdv >= 0 && tdefs[tdv].sz > 0) { ufsz = tdefs[tdv].sz; } tk++; } /* typedef 成员 */
                                    若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) tk++; } /* 无名位域 */
                                    若 (tt[tk] == VR) { /* 成员名 */
                                        字 mf[64]; strcpy(mf, tn[tk]); tk++;
                                        整 bitw = 0;
