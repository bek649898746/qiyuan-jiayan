            否 若 (!strcmp(tn[ti], "L") && (s[i] == '"' || s[i] == '\'')) { 续; } /* 宽字符串/宽字符 L"..." / L'x' — L 前缀跳过 (fix 2026-08-14: mingw.c normalize_ntpath L"\\??\\"; fix 2026-08-15: fsm-listen L'/' 泄漏 L undefined) */
            否 若 (!strcmp(tn[ti], "__attribute__") || !strcmp(tn[ti], "__declspec")) { /* fix 2026-08-08: GCC attr __attribute__((...)) in decl position hung the parser (bin_test.c) - lexer swallows the balanced-paren block, emits no token; fix 2026-08-26 cpython: __declspec(dllimport/dllexport) MSVC 等价 (pyconfig.h/pymem.h Windows 导出宏) — 同法吞掉, 不发 token */
                整 aj = i; 循环 (s[aj] == ' ' || s[aj] == '\t' || s[aj] == '\r' || s[aj] == '\n') aj++;
                若 (s[aj] == '(') { i = aj; 整 ad = 0; 循环 (s[i]) { 若 (s[i] == '"') { i++; 循环 (s[i] && s[i] != '"') { 若 (s[i] == '\\') i++; i++; } 续; } 若 (s[i] == '(') ad++; 否 若 (s[i] == ')') { ad--; 若 (ad <= 0) { i++; 断; } } i++; } }
                续; /* fix 2026-08-14: 空宏 #define __attribute__(x) 展开后 __attribute__ 无 ((...)) 也要吞掉 — 否则变 tt=SK 分号 token, 劈开 void die(...) → die undefined */
            }
            否 若 (!strcmp(tn[ti], "__extension__") || !strcmp(tn[ti], "__MINGW_EXTENSION")) { 续; } /* fix 2026-08-22 #29: GCC __extension__ prefix (time.h __MINGW_EXTENSION typedef) was not swallowed -> parse broke, struct tm lost (sizeof=0) */
            否 若 (!strcmp(tn[ti], "可空")) { qcc_nullable_pending = 1; qcc_nullable_pending_tok = ti; 续; } /* 2026-08-28 type-root-fix: pending_tok=ti (next token slot) - lexer prescans, bind pos */ /* 接入 2026-08-28 类型根治① (v3.0 #75): 可空 T x — 置 pending, 下一个声明登记可空 (原词法层直接吞=等价普通声明, 无真类型; 现在未解包解引用编译期拦截 A8001) */
            否 若 (!strcmp(tn[ti], "错误")) { qcc_err_pending = 1; qcc_err_pending_tok = ti; 续; } /* 2026-08-28 type-root-2: error-union pending */ /* 接入 2026-08-28 机制层 #72 error union: 错误 类型标记吞掉 (错误 T f = T f, 显式错误码返回 — Go 式 error union, 配 错 N; return N) */
            否 若 (!strcmp(tn[ti], "泛型")) { /* 接入 2026-08-28 机制层: 泛型函数宏 (#96, v3.0) — 泛型 名字(参数) = 体; → 注册 fn_macro (文本级模板, 调用按实参类型展开): 泛型 最大值(x, y) = ((x) > (y) ? (x) : (y)); — lexer 层注册, 调用 最大值(a,b) 在 lex 时展开 (fn_macro 机制), 天然多类型 */
                整 gp = i; 循环 (s[gp] == ' ' || s[gp] == '\t') gp++;
                字 gnm[64]; 整 gq = 0; 循环 ((isalnum((无 字)s[gp]) || s[gp] == '_' || (无 字)s[gp] >= 0x80) && gq < 63) gnm[gq++] = s[gp++]; gnm[gq] = 0;
                若 (!gnm[0]) { /* 无名字: 当普通标识符 泛型 发射 */ }
                否 {
                    整 gdup = 0; 遍 (整 gi = 0; gi < fn_macro_n; gi++) 若 (!strcmp(fn_macros[gi].name, gnm)) { gdup = 1; 断; }
                    /* 无条件推进 gp (参数+体) 跳过定义行 — 即使 dup 也要到行尾 (fix 2026-08-28: gdup 时残留定义行 → 最大值(x,y) 被 fn_macro 展开破坏) */
                    整 gpi = 0;
                    若 (s[gp] == '(') { gp++; 循环 (s[gp] && s[gp] != ')' && gpi < 16) {
                            循环 (s[gp] == ' ' || s[gp] == '\t' || s[gp] == ',') gp++;
                            若 (s[gp] == ')') 断;
                            整 gq2 = 0; 循环 ((isalnum((无 字)s[gp]) || s[gp] == '_') && gq2 < 63) fn_macros[fn_macro_n].params[gpi][gq2++] = s[gp++];
                            fn_macros[fn_macro_n].params[gpi][gq2] = 0;
                            gpi++; /* fix 2026-08-28: 每次参数后 ++ */
                            若 (s[gp] == ')') 断;
                        }
                        若 (s[gp] == ')') gp++;
                    }
                    循环 (s[gp] == ' ' || s[gp] == '\t') gp++;
                    若 (s[gp] == '=') { gp++; 循环 (s[gp] == ' ' || s[gp] == '\t') gp++; } /* 泛型 名字(x) = 体; — 跳过 = */
                    整 gb = 0;
                    循环 (s[gp] && s[gp] != '\n' && s[gp] != ';' && gb < 16383) { fn_macros[fn_macro_n].body[gb++] = s[gp++]; } /* body 到 ; 停 (fix 2026-08-28) */
                    fn_macros[fn_macro_n].body[gb] = 0;
                    若 (!gdup && fn_macro_n < 2048) { /* 预扫描已注册则只跳过 (注册信息预扫描已填) */
                        strcpy(fn_macros[fn_macro_n].name, gnm);
                        fn_macro_multiline[fn_macro_n] = 0;
                        fn_macros[fn_macro_n].pn = gpi;
                        fn_macro_n++;
                    }
                    i = gp; /* 跳过定义行 */
                }
                续; /* 不发射 token */
            }
            否 若 (!strcmp(tn[ti], "_Alignas")) { /* fix 2026-08-25 step21: C11 对齐声明 — 吐 AG token 携带对齐值 (原吞掉无语义; 语义在 st_field_sz_r 消费: 字段/struct 级显式对齐) */
                整 av = 0;
                整 aj = i; 循环 (s[aj] == ' ' || s[aj] == '\t' || s[aj] == '\r' || s[aj] == '\n') aj++;
                若 (s[aj] == '(') {
                    整 al = aj + 1;
                    循环 (s[al] == ' ' || s[al] == '\t' || s[al] == '\r' || s[al] == '\n') al++;
                    循环 (s[al] >= '0' && s[al] <= '9') { av = av * 10 + (s[al] - '0'); al++; }
                    整 ad = 0;
                    循环 (s[aj]) { 若 (s[aj] == '(') ad++; 否 若 (s[aj] == ')') { ad--; 若 (ad <= 0) { aj++; 断; } } aj++; }
                }
                tt[ti] = AG; tv[ti] = av; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } i = aj; 续;
            }
            否 若 (!strcmp(tn[ti], "大小")) strcpy(tn[ti], "sizeof");
            否 若 (!strcmp(tn[ti], "原串") && (s[i] == '"' || s[i] == '#')) { /* 接入 2026-08-28 原始/多行字符串 (蓝图 §五 字面量扩展): 原串"..." 或 原串#"..."# (N 个 # 定界) — 不处理转义 (\n 保持字面), 可跨行, 内部可含定界符 */
                整 nh = 0;
                循环 (s[i] == '#') { nh++; i++; }
                若 (s[i] != '"') { /* 非原始字符串形态, 原串 当普通标识符 */ }
                否 {
                    i++; /* 跳过 " */
                    若 (str_cnt >= 65536) { fprintf(stderr, "[STR-OVERFLOW]\n"); abort(); }
                    若 (!str_tbl[str_cnt]) str_tbl[str_cnt] = str_slot_alloc();
                    整 j = 0;
                    循环 (1) {
                        若 (!s[i]) { fprintf(stderr, "[ERR] 原始字符串未闭合 (fix 2026-08-28)\n"); exit(1); }
                        若 (s[i] == '"') {
                            整 ok = 1;
                            遍 (整 h = 0; h < nh; h++) 若 (s[i + 1 + h] != '#') { ok = 0; 断; }
                            若 (ok) { i += 1 + nh; 断; }
                        }
                        若 (j < 12286) str_tbl[str_cnt][j++] = s[i];
                        i++;
                    }
                    str_tbl[str_cnt][j] = 0;
                    { 整 _iu = -1; 遍 (整 _ki = 0; _ki < str_cnt; _ki++) 若 (!strcmp(str_tbl[_ki], str_tbl[str_cnt])) { _iu = _ki; 断; } 若 (_iu >= 0) { tt[ti] = STR; tv[ti] = _iu; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } 续; } } /* interning 同普通字符串 */
                    tt[ti] = STR; tv[ti] = str_cnt; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } str_cnt++; 续;
                }
            }
            整 k = kw(tn[ti]);            若 (k == NK) { 字 *sm = str_macro_find(tn[ti]); 若 (sm) { 若 (str_cnt >= 65536) { fprintf(stderr, "[STR-OVERFLOW]\n"); abort(); } 若 (!str_tbl[str_cnt]) str_tbl[str_cnt] = str_slot_alloc(); 整 k2 = 0; 循环 (sm[k2] && k2 < 2046) { str_tbl[str_cnt][k2] = sm[k2]; k2++; } 若 (k2 >= 2046 && sm[k2]) { fprintf(stderr, "[ERR] 字符串宏值超过 2046 字符 (fix 2026-08-06)\n"); exit(1); } str_tbl[str_cnt][k2] = 0; 若 (ti > 0 && tt[ti - 1] == STR) { 整 pj = (整)strlen(str_tbl[tv[ti - 1]]); 若 (pj + k2 < 12286) { memcpy(str_tbl[tv[ti - 1]] + pj, str_tbl[str_cnt], k2 + 1); 续; } } tt[ti] = STR; tv[ti] = str_cnt; str_cnt++; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } 续; } 整 found_num = 0, nvv = 0, found_mi = -1; 遍 (整 mi = 0; mi < macro_n; mi++) 若 (!strcmp(macros[mi].name, tn[ti])) { found_num = 1; nvv = macros[mi].val; found_mi = mi; 断; } 若 (found_num) { tt[ti] = NK; tv[ti] = nvv; tuns[ti] = macro_uns[found_mi]; tll[ti] = macro_ll[found_mi]; tll_hi[ti] = macro_ll_hi[found_mi]; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } 续; } /* fix 2026-08-12: num-macro NK must clear tll/tuns - stale calloc junk -> spurious nll -> 2-cycle */ /* fix 2026-08-12: num-macro NK must clear tll/tuns - stale calloc junk -> spurious nll -> 2-cycle */ /* fix 2026-08-06: 字符串宏优先; 数值宏含负值 (macro_find 的 -1 哨兵不可用于存在性判断) */ tt[ti] = VR; } 否 tt[ti] = k; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } 续; }
        若 (s[i] == '"') { 若 (str_cnt >= 65536) { fprintf(stderr, "[STR-OVERFLOW]\n"); abort(); } 若 (!str_tbl[str_cnt]) str_tbl[str_cnt] = str_slot_alloc(); i++; 整 j = 0; 循环 (1) { /* 相邻字面量拼接 "a" "b" -> "ab" (fix 2026-08-06) */ 循环 (s[i] && s[i] != '"' && j < 12286) { 若 (s[i] == '\\' && s[i + 1]) { i++; 若 (s[i] == 'n') str_tbl[str_cnt][j++] = '\n'; 否 若 (s[i] == 't') str_tbl[str_cnt][j++] = '\t'; 否 若 (s[i] == '0') str_tbl[str_cnt][j++] = 0; 否 若 (s[i] == 'r') str_tbl[str_cnt][j++] = '\r'; 否 若 (s[i] == 'f') str_tbl[str_cnt][j++] = '\f'; 否 若 (s[i] == 'v') str_tbl[str_cnt][j++] = '\v'; 否 str_tbl[str_cnt][j++] = s[i]; } 否 str_tbl[str_cnt][j++] = s[i]; i++; } 若 (j >= 12286 && s[i] != '"') { fprintf(stderr, "[ERR] 字符串字面量超过 12286 字符上限 j=%d cnt=%d strt='%.50s' around='%.40s' (fix 2026-08-13 全量链接: Git 超长拼接 help 文本; fix 2026-08-26 cpython)\n", j, str_cnt, str_tbl[str_cnt], s + i - j); exit(1); } i++; 整 ni = i; 循环 (s[ni] == ' ' || s[ni] == '\t' || s[ni] == '\n' || s[ni] == '\r') ni++; 若 (s[ni] == '"') { i = ni + 1; 续; } 断; } str_tbl[str_cnt][j] = 0; 若 (ti > 0 && tt[ti - 1] == STR) { 整 pj = (整)strlen(str_tbl[tv[ti - 1]]); 若 (pj + j < 12286) { memcpy(str_tbl[tv[ti - 1]] + pj, str_tbl[str_cnt], j + 1); i = i; 续; } } { 整 _iu = -1; 遍 (整 _ki = 0; _ki < str_cnt; _ki++) 若 (!strcmp(str_tbl[_ki], str_tbl[str_cnt])) { _iu = _ki; 断; } 若 (_iu >= 0) { tt[ti] = STR; tv[ti] = _iu; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } 续; } } /* fix step27: 字符串字面量 interning — 相同内容复用 si (gcc 合并相同字面量 → 指针比较/差一致; 原每字面量独立 si → strchr("hello",104)-"hello" 差 -6) */ tt[ti] = STR; tv[ti] = str_cnt; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } str_cnt++; i = i; 续; }
        若 (s[i] == '\'') { /* char literal 'x' �?NK */
            i++; 整 cv = s[i];
            若 (cv == '\\' && s[i + 1]) {
                i++;
                若 (s[i] >= '0' && s[i] <= '7') { /* 八进制转义 '\033' — 原只吃 1 位, 剩余 33' 重新 lex → token 错位, non_ascii 函数体吞掉后续顶层函数 (fix 2026-08-15: pretty.c len undefined) */
                    整 ov = 0, nd = 0;
                    循环 (nd < 3 && s[i] >= '0' && s[i] <= '7') { ov = ov * 8 + (s[i] - '0'); i++; nd++; }
                    cv = ov;
                } 否 {
                    cv = (s[i] == 'n') ? '\n' : (s[i] == 't') ? '\t' : (s[i] == '0') ? 0 : (s[i] == 'r') ? '\r' : (s[i] == 'f') ? '\f' : (s[i] == 'v') ? '\v' : s[i]; i++; /* fix 2026-08-23 t35d: \r \f \v 转义未处理 → blank=" \t\n\r\f\v" 编译成 'r''f''v' → strcspn 找不到空白 → attr.c parse_attr_line namelen 错 → "]bina" 警告 */
                }
            }
            否 i++;
            若 (s[i] == '\'') i++;
            tt[ti] = NK; tv[ti] = cv; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } 续;
        }
        择 (s[i]) { 例 '+': tt[ti] = s[i + 1] == '+' ? (i++, PP) : s[i + 1] == '=' ? (i++, PA) : PK; 断; 例 '-': tt[ti] = s[i + 1] == '>' ? (i++, AR) : s[i + 1] == '-' ? (i++, MM) : s[i + 1] == '=' ? (i++, MA) : MK; 断; 例 '*': tt[ti] = s[i + 1] == '=' ? (i++, DA) : DK; 断; 例 '/': tt[ti] = s[i + 1] == '=' ? (i++, SA) : DV; 断; 例 '%': tt[ti] = s[i + 1] == '=' ? (i++, MS) : MD; 断; 例 '&': tt[ti] = s[i + 1] == '=' ? (i++, AA) : s[i + 1] == '&' ? (i++, LA) : PT; 断; 例 '|': tt[ti] = s[i + 1] == '>' ? (i++, PIPE) : s[i + 1] == '=' ? (i++, OA) : s[i + 1] == '|' ? (i++, LO) : OR; 断; /* 接入 2026-08-27 管道操作符: | > → PIPE (a |> f = f(a)) */ 例 '^': tt[ti] = s[i + 1] == '=' ? (i++, XA) : XR; 断; 例 '~': tt[ti] = BN; 断; 例 '?': tt[ti] = (s[i + 1] == '.') ? (i++, QA) : QU; 断; /* ?. 可选链 → QA (接入 2026-08-28); 普通 ? → QU 三目 */ 例 '.': 若 (s[i + 1] == '?') { i++; tt[ti] = QA; } /* 可选链 ?. → QA (接入 2026-08-28: a?.b = a 非空 ? a->b : 0) */ 否 若 (s[i + 1] >= '0' && s[i + 1] <= '9') { 整 fhi2, flo2; fp_parse(s, &i, &fhi2, &flo2); 若 (s[i] == 'f' || s[i] == 'F') i++; 若 (dbl_n >= 8192) { fprintf(stderr, "[ERR] double tbl full\n"); exit(1); } dbl_hi[dbl_n] = fhi2; dbl_lo[dbl_n] = flo2; tt[ti] = FP; tv[ti] = dbl_n; dbl_n++; { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } 续; } tt[ti] = DT; 断; 例 '=': tt[ti] = s[i + 1] == '=' ? (i++, QK) : AK; 断; 例 '<': tt[ti] = s[i + 1] == '<' ? (s[i + 2] == '=' ? (i += 2, SHL) : (i++, SH)) : s[i + 1] == '=' ? (i++, HK) : LK; 断; 例 '>': tt[ti] = s[i + 1] == '>' ? (s[i + 2] == '=' ? (i += 2, SHR) : (i++, SR)) : s[i + 1] == '=' ? (i++, YK) : GK; 断; 例 '!': tt[ti] = s[i + 1] == '=' ? (i++, XK) : NT; 断; 例 ';': tt[ti] = SK; 断; 例 ',': tt[ti] = CK; 断; 例 '(': tt[ti] = OK; 断; 例 ')': tt[ti] = KK; 断; 例 '{': tt[ti] = FK; 断; 例 '}': tt[ti] = UK; 断; 例 '[': tt[ti] = LB; 断; 例 ']': tt[ti] = RB; 断; 例 ':': tt[ti] = CL; 断; 缺: unknown_chars++; i++; 续; } { tline[ti] = cur_line; cur_token_line = cur_line; ti++; } i++; /* fix 2026-08-13 Phase3: default 不发射 token (原 ti++ 留下 tt=0=EK 幽灵 token 截断 parse) */
    }
    若 (unknown_chars) fprintf(stderr, "[WARN] lex: %d 未知字符被忽略为空白 (fix 2026-08-09 BUG-5)\n", unknown_chars);
}

静 空 Nc(整 p, 整 c) { 若 (c < 0) 返;
