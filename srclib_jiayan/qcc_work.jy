        { 整 v_j5 = Nd(1); memcpy((字*)(nn + v_j5), jname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_j5); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_j5); Nc(asg, pl); Nc(bd_j, asg); } /* __md_j++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd_j, setl); nv[wh_j] = cl + 1; }
        Nc(wh_j, bd_j);
        Nc(bd_i, wh_j);
        { /* if (less <= k && less+eq > k) { m = arr[i]; } */
          整 v_l2 = Nd(1); memcpy((字*)(nn + v_l2), lessname, 32);
          整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
