                        若 (tt[tk] == VK) { fdflt = 4; 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char")) fdflt = 1; 否 若 (!strcmp(tn[tk], "double")) fdflt = 8; tk++; } /* reset default per field (fix 2026-08-03: fdflt leaked from a char field into the next int field) */
                        循环 (tt[tk] == DK) { fdflt = 8; tk++; } /* pointer field */
