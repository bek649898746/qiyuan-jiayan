        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __sp = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), knm, 32); Nc(d, e_k); Nc(blk, d); } /* int __sp_k = k; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), nnm, 32); Nc(d, e_n); Nc(blk, d); } /* int __sp_n = n; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 v_k = Nd(1); memcpy((字*)(nn + v_k), knm, 32);
          整 c1 = Nd(2); nv[c1] = T_LK; Nc(c1, v_i); Nc(c1, v_k); /* __sp < __sp_k */
          { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 v_n = Nd(1); memcpy((字*)(nn + v_n), nnm, 32);
            整 c2 = Nd(2); nv[c2] = T_LK; Nc(c2, v_i2); Nc(c2, v_n); /* __sp < __sp_n */
            整 both = Nd(2); nv[both] = LA; Nc(both, c1); Nc(both, c2);
            Nc(wh, both); } }
        整 bd = Nd(5);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_i); /* dst[__sp] */
          { 整 v_si = Nd(1); memcpy((字*)(nn + v_si), iname, 32);
            整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, v_si); /* src[__sp] */
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(bd, asg); } } /* dst[__sp]=src[__sp]; */
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i); Nc(asg, pl); Nc(bd, asg); } /* __sp++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "切片后缀")) { /* 接入 2026-08-29 P2 #143 切片模式-后缀: 切片后缀 dst, src, n, k; → { __ss=0; __ss_k=k; __ss_n=n; while(__ss+__ss_k<__ss_n){ dst[__ss]=src[__ss+__ss_k]; __ss++; } } — 取 src[k..n) 到 dst (k>=n 得空) */
        tk++; /* 切片后缀 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_k = expr(); /* 后缀起点 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 ss_seq = 0; 字 iname[64]; sprintf(iname, "__ss_%d_", ss_seq++);
        静 整 ss_seq2 = 0; 字 knm[64]; sprintf(knm, "__ss_k_%d_", ss_seq2++);
        静 整 ss_seq3 = 0; 字 nnm[64]; sprintf(nnm, "__ss_n_%d_", ss_seq3++);
        var_offset(iname); var_offset(knm); var_offset(nnm);
        整 blk = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __ss = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), knm, 32); Nc(d, e_k); Nc(blk, d); } /* int __ss_k = k; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), nnm, 32); Nc(d, e_n); Nc(blk, d); } /* int __ss_n = n; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 v_k = Nd(1); memcpy((字*)(nn + v_k), knm, 32);
          整 add1 = Nd(2); nv[add1] = PK; Nc(add1, v_i); Nc(add1, v_k); /* __ss+__ss_k */
          整 v_n = Nd(1); memcpy((字*)(nn + v_n), nnm, 32);
          整 c1 = Nd(2); nv[c1] = T_LK; Nc(c1, add1); Nc(c1, v_n); /* < __ss_n */
          Nc(wh, c1); }
        整 bd = Nd(5);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_i); /* dst[__ss] */
          { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 v_k = Nd(1); memcpy((字*)(nn + v_k), knm, 32);
            整 add = Nd(2); nv[add] = PK; Nc(add, v_i2); Nc(add, v_k); /* __ss+__ss_k */
            整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, add); /* src[__ss+__ss_k] */
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(bd, asg); } } /* dst[__ss]=src[__ss+__ss_k]; */
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i); Nc(asg, pl); Nc(bd, asg); } /* __ss++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "切片")) { /* 接入 2026-08-28 切片复制 (slice): 切片 dst, src, n, lo, hi; → { __sl=0; __sl_lo=lo; __sl_hi=hi; __sl_n=n; while(__sl+__sl_lo<__sl_hi && __sl+__sl_lo<__sl_n){ dst[__sl]=src[__sl+__sl_lo]; __sl++; } } — 复制 src[lo..hi) 到 dst; lo/hi/n 存内部变量防多父 */
        tk++; /* 切片 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_lo = expr(); /* 起 (含) */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_hi = expr(); /* 止 (不含) */
        若 (tt[tk] == SK) tk++; /* ; */
