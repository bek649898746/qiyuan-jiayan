                            cg_fdepth_max = (st_field_fdeep(cg_mem_chain_si, fn) >= 2) ? 2 : 1; /* fix 2026-08-30 csmith: 同简单字段 — 单指针字段须 deref */
                            若 (st_field_fdeep(cg_mem_chain_si, fn) >= 2) cg_mem_ptr_need = 1; /* 双指针字段单层取值需解引用 (fix 2026-08-22 t41b); 单指针 char* match 直接索引 — 原无条件设 → items[i].match[j] 多解引用 → git add 崩 */
