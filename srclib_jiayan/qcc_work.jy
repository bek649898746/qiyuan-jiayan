        若 (tt[tk] == VK && !strcmp(tn[tk], "extern")) {
            tk++; /* skip extern */
            整 e_char = 0, e_dbl = 0, e_ll = 0, e_pesz = 0, e_stidx = -1;
            循环 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) e_char = 1; 否 若 (!strcmp(tn[tk], "double")) e_dbl = 1; 否 若 (!strcmp(tn[tk], "long")) e_ll = 1; tk++; } /* fix 2026-08-14: 循环消费所有 VK — extern const char * 的 const+char 两个 VK 原只吃一个 → char 残留 → 变量未注册 */
