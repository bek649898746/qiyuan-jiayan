    若 (tt[tk] == VR && !strcmp(tn[tk], "转置")) { /* 接入 2026-08-28 矩阵转置 (transpose): 转置 dst, src, rows, cols; → { __rr=rows; __cc=cols; __tr=0; while(__tr<__rr){ __tc=0; while(__tc<__cc){ dst[__tc*__rr+__tr]=src[__tr][__tc]; __tc++; } __tr++; } } — dst 是 cols×rows 平铺视图, src 是 rows×cols 二维; 复用展平两级下标 */
