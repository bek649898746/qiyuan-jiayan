   off - sz); by-value struct params register the START. Returns an rbp offset. */
静 整 var_sbase(常 字 *n, 整 off) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) {
        若 (vars[i].arr_sz > 0) { /* struct ARRAY: base = off - arr_sz*esz (fix 2026-08-03) */
            整 esz = vars[i].arr_esz ? vars[i].arr_esz : 4;
            返 off - vars[i].arr_sz * esz;
        }
        若 (vars[i].st_idx >= 0) {
            整 sz = vars[i].st_sz > 0 ? vars[i].st_sz : stypes[vars[i].st_idx].sz;
            返 vars[i].is_param ? off : off - sz;
        }
