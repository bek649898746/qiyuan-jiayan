                    否 var_array(vnp2, cntp2, esz_p);
                    vars[vcnt - 1].st_idx = si;
                    若 (is_ptr) { vars[vcnt - 1].p_depth = ptr_depth; vars[vcnt - 1].p_inner = si >= 0 ? stypes[si].sz : 4; }
                    整 d3 = Nd(7); memcpy((字*)(nn + d3), vnp2, 32);
                    Nc(b, d3); b_cnt++;
                    循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                    若 (tt[tk] == SK) tk++;
                    续;
                }
                若 (tt[tk] == VR) {
                    字 vn[64]; strcpy(vn, tn[tk]); tk++;
                    整 d = Nd(7); memcpy((字*)(nn + d), vn, 32);
                    整 scnt = 1;
                    整 is_arr = 0; /* 数组声明标记 (fix 2026-08-18: static struct 数组误走栈帧 var_array → .data 槽全 0 → path.c pathname_array gitdir 乱码) */
                    若 (tt[tk] == LB) { /* struct Tag *arr[N] / struct Tag arr[N] */
                        is_arr = 1;
                        scnt = 1;
                        整 unsized = 0;
                        循环 (tt[tk] == LB) {
                            tk++; 整 cdim = 0;
                            若 (const_expr_eval(&cdim)) { scnt *= cdim > 0 ? cdim : 1; }
                            否 { 若 (tt[tk] == RB) unsized = 1; 否 { 循环 (tk < TS && tt[tk] != RB && tt[tk] != EK) tk++; } }
                            若 (tt[tk] == RB) tk++;
                        }
                        若 (unsized && tt[tk] == AK && tt[tk + 1] == FK) { /* struct Tag a[] = { {..}, .. } 未定长: 推断元素数 (fix 2026-08-18: fsck.c fsck_describe_object bufs[] — 原 scnt=1 → 只分配 1 元素槽 → bufs[1..3] 越界写坏邻 .data 槽) */
                            整 save_u = tk; 整 n = 1, d0 = 0; tk += 1; /* 落外层 { (镜像具名分支推断) */
                            循环 (tk < TS) {
                                若 (tt[tk] == FK) { /* 跳过内层初始化器 { ... } — struct 元素内部逗号不算分隔 (fix step25: 原把 {1,0} 内逗号数进 → SA[] 推断 2 而非 3 → 槽分配少 → 邻变量重叠) */
                                    整 sd = 1; tk++;
                                    循环 (tk < TS && sd > 0) { 若 (tt[tk] == FK) sd++; 否 若 (tt[tk] == UK) { sd--; 若 (sd <= 0) { tk++; 断; } } tk++; }
                                    续;
                                }
                                若 (tt[tk] == OK || tt[tk] == LB) d0++;
                                否 若 (tt[tk] == KK || tt[tk] == RB) { d0--; 若 (d0 == 0) { tk++; 断; } }
                                否 若 (tt[tk] == UK && d0 == 0) { tk++; 断; } /* 外层 } 结束 */
                                否 若 (tt[tk] == CK && d0 == 0 && tt[tk + 1] != UK) n++; /* 顶层元素逗号, 尾逗号不计 */
                                tk++;
                            }
                            tk = save_u;
                            scnt = n;
                        }
                        若 (is_static) { /* fix 2026-08-18: 原无条件 var_array → 栈帧局部, .data 槽 0 + 函数返回后失效 */
                            若 (is_ptr) var_static_arr(vn, 0, 8, scnt); /* static struct Tag *arr[N]: 8B 指针元素 */
                            否 若 (si >= 0) var_static_struct(vn, si, scnt); /* static struct Tag arr[N] */
                            否 var_static_arr(vn, 0, 4, scnt);
                        } 否 {
                            var_array(vn, scnt, is_ptr ? 8 : (si >= 0 ? stypes[si].sz : 4));
                        }
                        vars[vcnt - 1].st_idx = si; /* fix 2026-08-20: T** 数组 st_idx 保留 si — mem_addr 链需要 pointee 结构体类型 */
                    } 否 若 (is_ptr) {
                        若 (ptr_depth >= 2) { /* struct X **: 元素=指针 8B (p_esz/arr_esz=8), 但 st_idx 保留 si — mem_addr 链 (*e)->next 需要 pointee 结构体类型 (fix 2026-08-20: st_idx=-1 → mem_addr sub_si<0 → &(*e)->next 空转 → hashmap 链遍历死循环) */
                            若 (is_static) var_static(vn, 4);
                            否 var_offset_ptr(vn, 8);
                            vars[vcnt - 1].st_idx = si; vars[vcnt - 1].arr_esz = 8;
                        } 否 {
                            
                            若 (is_static) var_static(vn, 4);
                            否 var_offset_ptr(vn, stypes[si].sz); /* fix 2026-08-20: struct 单指针 p_esz=sizeof(struct) 原固定 4 + arr_esz=8 → var_esz=8 → 指针算术 i*8 → preprocess_options memcpy 参数错位 → git log 崩 */
                            vars[vcnt - 1].st_idx = si; vars[vcnt - 1].p_depth = 1; vars[vcnt - 1].p_inner = stypes[si].sz;
                        }
                    } 否 若 (si >= 0) {
                        若 (is_static) var_static_struct(vn, si, 1);
                        否 var_struct(vn, si);
                    } 否 {
                        若 (is_static) var_static(vn, 0);
                        否 var_offset(vn);
                    }
                    若 (tt[tk] == AK) { /* = expr / = { ... } 初始化器 */
                        tk++;
                        若 (is_static && ginit_n < 4096) {
                            /* 函数内 static struct 变量/数组: 初始化在 main 入口跑一次 (ginit, C 语义),
                               镜像普通变量 static 路径 (fix 2026-08-18: 原挂运行时语句 → .data 槽全 0) */
                            若 (tt[tk] == FK && si >= 0 && !is_ptr) {
                                若 (is_arr) { /* static struct Tag arr[N] = { {...}, ... } — brace_arr_init 进 ginit */
                                    整 blk = Nd(5);
                                    Nc(blk, d); /* declare first */
                                    遍 (整 i = 0; i < 8; i++) gi_idx[i] = 0;
                                    str_row = 0;
                                    整 adimv[8] = {0}; adimv[0] = scnt;
                                    brace_arr_init(blk, d, adimv, 1, 0, stypes[si].sz);
                                    若 (ginit_n < 4096) ginit[ginit_n++] = blk;
                                    vars[vcnt - 1].pdisp = ginit_n - 1;
                                    若 (tt[tk] == UK) tk++;
                                } 否 { /* static struct Tag s = { a, b }; — brace_fields 进 ginit */
                                    整 idn = Nd(1); memcpy((字*)(nn + idn), vn, 32); tk++;
                                    整 blkinit = brace_fields(si, idn);
                                    若 (tt[tk] == UK) tk++;
                                    若 (ginit_n < 4096) ginit[ginit_n++] = blkinit;
                                    vars[vcnt - 1].pdisp = ginit_n - 1;
                                }
                            } 否 {
                                整 decl = Nd(7); memcpy((字*)(nn + decl), vn, 32);
                                Nc(decl, expr());
                                若 (ginit_n < 4096) ginit[ginit_n++] = decl;
                                vars[vcnt - 1].pdisp = ginit_n - 1;
                            }
                        } 否 若 (tt[tk] == FK && si >= 0 && (is_arr || !is_ptr)) { /* fix 2026-08-23 t49f: is_ptr array ({ NULL, }) was excluded -> Nc(d,expr()) scalar -> elements garbage -> status oneway_diff src[1] crash */
                            整 idn = Nd(1); memcpy((字*)(nn + idn), vn, 32);
                            若 (is_arr) { /* 局部 struct Tag arr[N] = { {...} } — 数组用 brace_arr_init (fix 2026-08-18: 原 brace_fields 遇多元素 { 解析错) */
                                遍 (整 i = 0; i < 8; i++) gi_idx[i] = 0;
