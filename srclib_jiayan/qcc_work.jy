/* RIP-relative .data access for static vars: [rip+disp] */
静 空 mov_eax_rip(整 disp) { asm_emit("    取静32 eax, [rip%+d]\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); b(0x8B); b(0x05); b4(disp); }            /* mov eax, [rip+disp] */
静 空 mov_rip_eax(整 disp) { asm_emit("    存静32 [rip%+d], eax\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); b(0x89); b(0x05); b4(disp); }            /* mov [rip+disp], eax */
静 空 mov_rax_rip64(整 disp) { asm_emit("    取静64 rax, [rip%+d]\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x8B); b(0x05); b4(disp); } /* mov rax, [rip+disp] */
静 空 mov_rip_rax64(整 disp) { asm_emit("    存静64 [rip%+d], rax\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x89); b(0x05); b4(disp); } /* mov [rip+disp], rax */
静 空 lea_rax_rip(整 disp) { asm_emit("    取静址 rax, [rip%+d]\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x8D); b(0x05); b4(disp); }   /* lea rax, [rip+disp] */
/* MOV byte [rip+disp], imm8 — 7 bytes (C6 05 disp32 imm8). stc_disp() assumes a
   6-byte instruction, so callers must pass stc_disp()-1 (the 7-byte RIP base is
   one byte further). Non-coff only (fix 2026-08-05: global char arr = "lit"). */
静 空 mov_byte_rip_imm(整 disp, 整 imm) {
    asm_emit("    存静字节 [rip%+d], %d\n", (字*)(长 长)(disp), (字*)(长 长)(imm), (字*)(长 长)0);
    b(0xC6); b(0x05); b4(disp); b(imm & 0xFF);
}
/* ADD rax, imm8 (64-bit �?for pointer+offset) */
静 空 add_rax_imm8(整 v) {
    asm_emit("    加指针 rax, %d\n", (字*)(长 长)(v), (字*)(长 长)0, (字*)(长 长)0);
    若 (v >= -128 && v <= 127) { rex(1, 0, 0, 0); b(0x83); modrm(3, 0, 0); b(v & 0xff); }
    否 { rex(1, 0, 0, 0); b(0x05); b4(v); } /* add rax, imm32 (offsets > 127, e.g. stypes[si].fn at 736) */
}
/* MOV reg32, [reg64] ??dereference */
静 空 mov_reg_mreg(整 reg, 整 mreg) {
    asm_emit("    取值 r%d, [r%d]\n", (字*)(长 长)(reg), (字*)(长 长)(mreg), (字*)(长 长)0);
    rex(0, reg & 8, 0, mreg & 8); b(0x8B);
    若 (mreg == 4 || mreg == 12) { modrm(0, reg & 7, mreg & 7); b(0x24); }
    否 modrm(0, reg & 7, mreg & 7);
}
/* MOV reg64, [reg64] �?full-width deref (char** argv[i] �?8-byte pointer) */
静 空 mov_reg_mreg64(整 reg, 整 mreg) {
    asm_emit("    取64 r%d, [r%d]\n", (字*)(长 长)(reg), (字*)(长 长)(mreg), (字*)(长 长)0);
    rex(1, reg & 8, 0, mreg & 8); b(0x8B);
    若 (mreg == 4 || mreg == 12) { modrm(0, reg & 7, mreg & 7); b(0x24); }
    否 modrm(0, reg & 7, mreg & 7);
}
/* MOV [reg64], reg32 ??used by struct member store (cg case 13) */
__attribute__((unused))
静 空 mov_mreg_reg(整 mreg, 整 reg) {
    asm_emit("    存值 [r%d], r%d\n", (字*)(长 长)(mreg), (字*)(长 长)(reg), (字*)(长 长)0);
    rex(0, reg & 8, 0, mreg & 8); b(0x89);
    若 (mreg == 4 || mreg == 12) { modrm(0, reg & 7, mreg & 7); b(0x24); }
    否 modrm(0, reg & 7, mreg & 7);
}
/* JMP rel32 / conditional jumps */
静 空 jmp_rel(整 rel) { b(0xE9); b4(rel); }
静 空 jz_rel(整 rel) { b(0x0F); b(0x84); b4(rel); }
__attribute__((unused))
静 空 jnz_rel(整 rel) { b(0x0F); b(0x85); b4(rel); }
/* SETcc ??op is token type (T_LK/T_GK/T_QK/T_XK/T_HK/T_YK) */
静 空 setcc(整 op) {
    无 字 cc;
    若 (op == T_QK) { cc = 0x94; asm_emit("    置等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_XK) { cc = 0x95; asm_emit("    置不等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_LK) { cc = 0x9C; asm_emit("    置小 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_GK) { cc = 0x9F; asm_emit("    置大 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_HK) { cc = 0x9E; asm_emit("    置小等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_YK) { cc = 0x9D; asm_emit("    置大等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 { cc = 0x94; asm_emit("    置条件 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    b(0x0F); b(cc); modrm(3, 0, 0);
}
/* unsigned setcc (fix 2026-08-06 M1): < → setb(0x92), > → seta(0x97), <= → setbe(0x96), >= → setae(0x93) */
静 空 setcc_u(整 op) {
    无 字 cc;
    若 (op == T_QK) { cc = 0x94; asm_emit("    置等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_XK) { cc = 0x95; asm_emit("    置不等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_LK) { cc = 0x92; asm_emit("    置低 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_GK) { cc = 0x97; asm_emit("    置高 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_HK) { cc = 0x96; asm_emit("    置低等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (op == T_YK) { cc = 0x93; asm_emit("    置高等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 { cc = 0x94; asm_emit("    置条件 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    b(0x0F); b(cc); modrm(3, 0, 0);
}
/* MOVZX eax, al */
静 空 movzx_eax_al(空) { asm_emit("    零扩展 eax, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB6); modrm(3, 0, 0); }
/* ADD rsp, imm32 �?imm8 (0x83) sign-extends and breaks for frame sizes �?0x80 */
静 空 add_rsp_imm(整 v) { asm_emit("    加栈 %d\n", (字*)(长 长)(v), (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x81); b(0xC4); b4(v); }
/* SUB rsp, imm32 �?imm8 (0x83) sign-extends and breaks for frame sizes �?0x80 */
静 空 sub_rsp_imm(整 v) { asm_emit("    减栈 %d\n", (字*)(长 长)(v), (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x81); b(0xEC); b4(v); }

/* push/pop r64 (sub rsp,8; mov [rsp],r64) — 64-bit temporaries, nesting-safe (fix 2026-08-05: mov [rsp+0] clobbered across nested LL ops) */
静 空 push_r64(整 reg) {
    sub_rsp_imm(8);
    asm_emit("    存栈64 [rsp+0], r%d\n", (字*)(长 长)(reg), (字*)(长 长)0, (字*)(长 长)0);
    rex(1, reg & 8, 0, 0); b(0x89); modrm(1, reg & 7, 4); b(0x24); b(0);
}
静 空 pop_r64(整 reg) {
    asm_emit("    取栈64 r%d, [rsp+0]\n", (字*)(长 长)(reg), (字*)(长 长)0, (字*)(长 长)0);
    rex(1, reg & 8, 0, 0); b(0x8B); modrm(1, reg & 7, 4); b(0x24); b(0);
    add_rsp_imm(8);
}

/* b4_at: write 4 bytes at absolute position */
静 空 b4_at(整 pos, 整 v) { code[pos] = v & 0xff; code[pos+1] = (v>>8)&0xff; code[pos+2] = (v>>16)&0xff; code[pos+3] = (v>>24)&0xff; }

/* ?????? ??????: ???????????????????? */
#define ASZ 262144
#define MAX_LABELS 32768
静 整 label_pos[MAX_LABELS];
静 整 label_set[MAX_LABELS];
静 构 { 整 patch_at; 整 target_label; 整 is_jmp; } patches[65536]; 整 patch_n; /* fix 2026-08-06: 16384→65536 — qcc_work.jy 编译 patch_n=16380 贴上限, 加 STR 下标后缀链后超 4 个溢出; 自举大文件余量 */
静 构 { 整 patch_at; 整 str_idx; } str_patches[2048]; 整 strpn;
静 构 { 整 patch_at; 整 dbl_idx; } dbl_patches[2048]; 整 dbl_patch_n; /* double-literal rip-relative disp32 patches */
静 构 { 整 patch_at; 整 label; } fn_patches[2048]; 整 fnpn; /* function-address imm32 patches */
静 整 ginit[4096]; 静 整 ginit_n; /* global variable initializer nodes (emitted at main entry); fix 2026-08-06: 128→4096 + 溢出报错（原 >128 静默丢初始值） */
静 整 ndbl[ASZ]; /* per-node flag: expression yields a double (floating) */
静 整 nll[ASZ]; /* per-node flag: expression is a 64-bit long long (fix 2026-08-05) */
静 整 nll_hi[ASZ]; /* per-node high 32 bits of a long-long literal (fix 2026-08-05) */
静 整 pesz[ASZ]; /* per-node flag: (T*) pointer-cast element byte size (1/2/4/8) - fix 2026-08-08 width bug: cast no-op drops type info, *((T*)x) width fell to 1 byte; keep target element size for case-12/10 */
静 整 nuns[ASZ]; /* per-node flag: expression is unsigned (u suffix literal / unsigned var) — >> must be logical SHR (fix 2026-08-05) */

/* ==================== COFF 对象输出（-c 模式） ==================== */
静 整 stc_disp(整 idx);
静 构 { 字 name[64]; 整 label; 整 defined; 整 ret_si; } func_tbl[2048]; /* fix 2026-08-06: 512 满 → main 等后注册函数被拒 (func_find 返 -1) → 编译产物无 main 崩; 2026-08-09 审计#2: 1024→2048; 2026-08-15 name 32→64 长函数名截断碰撞 (reftable min_update_index/_void) */
/* static 函数名映射 (gen_code 重置 func_n, 用名字; fix 2026-08-06 Task 5.3: 多 .o 时 static 函数应 scl=3 局部符号, 否则 jystd 等头库每 .o 重复导出冲突) */
静 字 fn_static_names[512][64]; 静 整 fn_static_n;
静 空 fn_static_mark(常 字 *n) { 遍 (整 i = 0; i < fn_static_n; i++) 若 (!strcmp(fn_static_names[i], n)) 返; 若 (fn_static_n < 512) { strcpy(fn_static_names[fn_static_n++], n); } }
静 整 fn_static_is(常 字 *n) { 遍 (整 i = 0; i < fn_static_n; i++) 若 (!strcmp(fn_static_names[i], n)) 返 1; 返 0; }
静 空 fn_static_unmark(常 字 *n) { 遍 (整 i = 0; i < fn_static_n; i++) 若 (!strcmp(fn_static_names[i], n)) { 遍 (整 j = i; j < fn_static_n - 1; j++) strcpy(fn_static_names[j], fn_static_names[j + 1]); fn_static_n--; 返; } }
静 整 func_n = 0;
静 整 coff_mode = 0;
静 /* fix 2026-08-10 Gate 9: ������� (bare_metal) + �ڴ�����/�����ַ */
整 bare_metal = 0; /* Gate 9: ��������������� (main ��� __bare__ ��������) */
#define BIN_SRC_ADDR 0x3800000
#define BIN_RT_ADDR 0x3900000
#define BIN_OUT_ADDR 0x3A00000
#define BIN_OUT_LEN_ADDR 0x3B00000
整 bin_mode = 0; /* -bin: 裸二进制输出 (内核: 无 PE 头/无 CRT/无 .data), fix 2026-08-08 */
静 整 coff_ginit_done = 0; /* -c: ginit emitted once per object */
#define MAX_CREL 131072
#define COFF_DATA_SITE_BASE 0x30000000 /* .data 重定位 site 哨兵：write_coff_obj 按 rsec=3 分组 */
静 构 { 整 site; 整 type; 整 sym; 整 addend; 整 is_label; 整 label; } crel[MAX_CREL];
静 整 crel_n;
#define MAX_CSYM 16384
静 构 { 字 name[64]; 整 value; 整 sec; 整 sc; 整 type; } csym[MAX_CSYM];
静 整 csym_n;
静 uint8_t *coff_str_data; 静 整 coff_str_len, coff_str_cap;
静 uint8_t *coff_dbl_data; 静 整 coff_dbl_len, coff_dbl_cap;
静 整 coff_text_sym, coff_str_sym, coff_dbl_sym, coff_bss_sym;

静 整 csym_find(常 字 *name) {
    遍 (整 i = 0; i < csym_n; i++) 若 (!strcmp(csym[i].name, name)) 返 i;
    返 -1;
}
静 整 csym_add(常 字 *name, 整 value, 整 sec, 整 sc, 整 type) {
    若 (csym_n >= MAX_CSYM) { fprintf(stderr, "qcc: csym overflow\n"); abort(); }
    整 i = csym_n++;
    strncpy(csym[i].name, name, 63); csym[i].name[63] = 0;
    csym[i].value = value; csym[i].sec = sec; csym[i].sc = sc; csym[i].type = type;
    返 i;
}
静 空 coff_crel(整 site, 整 type, 整 sym, 整 addend) {
    若 (crel_n >= MAX_CREL) { fprintf(stderr, "qcc: crel overflow\n"); abort(); }
    crel[crel_n].site = site; crel[crel_n].type = type;
    crel[crel_n].sym = sym; crel[crel_n].addend = addend;
    crel[crel_n].is_label = 0; crel[crel_n].label = -1;
    crel_n++;
}
/* .data 槽重定位：site 以 COFF_DATA_SITE_BASE 为基（write_coff_obj 识别为 secs[3]） */
静 空 coff_data_crel(整 data_off, 整 type, 整 sym, 整 addend) {
    coff_crel(COFF_DATA_SITE_BASE + data_off, type, sym, addend);
}
静 整 coff_counter_sym = -1;
静 整 coff_counter_sym_get(空) {
    若 (coff_counter_sym < 0) coff_counter_sym = csym_add("__qcc_heap_counter", 0, 0, 2, 0);
    返 coff_counter_sym;
}
静 空 coff_mov_eax_counter(空) {
    asm_emit("    读堆计数器 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    b(0x8B); b(0x05); b4(0); /* mov eax, [rip+0] */
    coff_crel(cp - 4, 0x0004, coff_counter_sym_get(), 0);
}
静 空 coff_mov_counter_eax(空) {
    asm_emit("    写堆计数器 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    b(0x89); b(0x05); b4(0); /* mov [rip+0], eax */
    coff_crel(cp - 4, 0x0004, coff_counter_sym_get(), 0);
}
静 空 coff_str_add(常 uint8_t *p, 整 n) {
    若 (coff_str_len + n > coff_str_cap) {
        整 nc = coff_str_cap ? coff_str_cap * 2 : 4096;
        循环 (nc < coff_str_len + n) nc *= 2;
        coff_str_data = realloc(coff_str_data, nc); coff_str_cap = nc;
    }
    memcpy(coff_str_data + coff_str_len, p, n); coff_str_len += n;
}
静 空 coff_dbl_add(常 uint8_t *p, 整 n) {
    若 (coff_dbl_len + n > coff_dbl_cap) {
        整 nc = coff_dbl_cap ? coff_dbl_cap * 2 : 4096;
        循环 (nc < coff_dbl_len + n) nc *= 2;
        coff_dbl_data = realloc(coff_dbl_data, nc); coff_dbl_cap = nc;
    }
    memcpy(coff_dbl_data + coff_dbl_len, p, n); coff_dbl_len += n;
}
静 整 coff_slot_sym(整 slot) {
    遍 (整 i = vcnt - 1; i >= 0; i--) { /* fix 2026-08-15: 原 vs_n()=vs_end 限制导致文件级 static slot 找不到 */
        若 (vars[i].rsp_off == slot) {
            整 s = csym_find(vars[i].name);
            若 (s < 0) {
                若 (slot < 0) s = csym_add(vars[i].name, 0, 0, 2, 0); /* extern: sec=0 未定义, scl=2 全局 (fix 2026-08-06 多 .o 链接) */
                否 s = csym_add(vars[i].name, 4 * slot, 4, (var_static_kw[i] || var_file_static[i]) ? 3 : 2, 0); /* fix 2026-08-06: 函数内 static → scl=3; fix 2026-08-14: 文件级 static 也 scl=3 */
            }
            返 s;
        }
    }
    返 -1;
}
静 整 coff_is_builtin(常 字 *n); /* 前向声明 (fix 2026-08-06) */
静 整 coff_func_label_sym(整 label) {
    遍 (整 i = 0; i < func_n; i++) {
        若 (func_tbl[i].label == label) {
            整 s = csym_find(func_tbl[i].name);
            若 (s < 0) {
                整 fsc = (fn_static_is(func_tbl[i].name) || coff_is_builtin(func_tbl[i].name)) ? 3 : 2; /* fix 2026-08-06: static/内建 → 局部符号 */
                s = csym_add(func_tbl[i].name, func_tbl[i].defined ? label_pos[label] : 0,
                             func_tbl[i].defined ? 1 : 0, fsc, 0x20);
            }
            返 s;
        }
    }
    返 -1;
}
静 整 coff_func_name_sym(常 字 *name) {
    整 s = csym_find(name);
    若 (s < 0) s = csym_add(name, 0, 0, 2, 0x20);
    返 s;
}
/* -c 模式：builtin 名（编译器内联发射，不是外部函数） */
静 整 coff_is_builtin(常 字 *n) {
    静 常 字 *bn[] = { "printf", "fprintf", "sprintf", "snprintf", "putstr", "scanf",
        "fopen", "fread", "fwrite", "fputc", "fputs", "fclose", "fseek", "ftell", "rewind",
        "_va_alloc", "host_va_alloc", "_setpos", "_getpos", "_exit_proc", "__qcc_va_start",
        "memset", "memcpy", "strlen", "strcmp", "strcpy", "strncpy",
        "malloc", "calloc", "free", "realloc", "isalnum", "isalpha", "exit", "abort", "inb", "outb", "inl", "outl", "__asm" };
    遍 (整 i = 0; i < (整)(大小(bn)/大小(bn[0])); i++) 若 (!strcmp(bn[i], n)) 返 1;
    返 0;
}
静 整 coff_static_disp(整 idx, 整 k) {
    若 (coff_mode) {
        整 s = coff_slot_sym(idx);
        若 (s >= 0) coff_crel(cp + 2 + k, 0x0004, s, 0);
        返 k;
    }
    若 (idx < 0) { /* extern 无定义: 单文件编译无法解析 (fix 2026-08-06) */
        遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (vars[i].rsp_off == idx) { fprintf(stderr, "[ERR] extern 变量 '%s' 无定义 — 多文件请用 qcc -c + jyld 链接\n", vars[i].name); exit(1); }
        fprintf(stderr, "[ERR] extern 变量无定义\n"); exit(1);
    }
    返 stc_disp(idx);
}

静 整 new_label(空) { 若 (lc >= MAX_LABELS) { fprintf(stderr, "[LABEL-OVERFLOW] lc=%d\n", lc); abort(); } 整 l = lc++; label_set[l] = 0; 返 l; }
静 空 set_label(整 l) { label_pos[l] = cp; label_set[l] = 1; asm_emit(".L%d:\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0); }
静 空 patch_label(整 at, 整 l, 整 is_jmp) {
    若 (coff_mode) {
        整 fs = coff_func_label_sym(l);
        若 (fs >= 0) {
            coff_crel(at, 0x0004, fs, 0);
        } 否 {
            若 (!coff_text_sym) coff_text_sym = csym_add(".text", 0, 1, 3, 0);
            coff_crel(at, 0x0004, coff_text_sym, 0);
            crel[crel_n - 1].is_label = 1;
            crel[crel_n - 1].label = l;
        }
        返;
    }
    若 (patch_n >= 65536) { fprintf(stderr, "[PATCH-OVERFLOW] patch_n=%d (at label %d)\n", patch_n, l); abort(); }
    /* Emit the jump mnemonic into the asm text using the REAL label id (l),
       not the placeholder rel value. Fix 2026-08-03: -S output previously
       used jz_rel's rel (always 1 for forward refs), so asm_zh could never
       resolve jump targets -> H1!=H2. */
    若 (is_jmp == 0) asm_emit("    调用 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 1) asm_emit("    为零跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 2) asm_emit("    跳转 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 3) asm_emit("    非零跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 4) asm_emit("    非负跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 5) asm_emit("    大于等跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 6) asm_emit("    小于等跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 7) asm_emit("    高于等跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 8) asm_emit("    低于跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 9) asm_emit("    高于跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 10) asm_emit("    小跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0); /* jl (fix 2026-08-06 %lld) */
    否 若 (is_jmp == 11) asm_emit("    大跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0); /* jg (fix 2026-08-06) */
    patches[patch_n].patch_at = at;
    patches[patch_n].target_label = l;
    patches[patch_n].is_jmp = is_jmp;
    patch_n++;
}
静 空 resolve_patches(空) {
    遍 (整 i = 0; i < patch_n; i++) {
        整 at = patches[i].patch_at;
        整 target = label_pos[patches[i].target_label];
        整 is_jmp = patches[i].is_jmp;

        若 (is_jmp == 0) {
            /* CALL rel32: E8 already emitted, at points to rel32 bytes */
            整 tgt = target - (at + 4);
            b4_at(at, tgt);
        } 否 若 (is_jmp == 2) {
            /* JMP rel32 */
            整 tgt = target - (at + 4);
            b4_at(at, tgt);
        } 否 若 (is_jmp == 1 || (is_jmp >= 3 && is_jmp <= 11)) {
            /* Jcc rel32 (jz/jnz/jns/jge/jle/jae/jb/ja/jl/jg) */
            整 tgt = target - (at + 4);
            code[at] = tgt & 0xff;
            code[at + 1] = (tgt >> 8) & 0xff;
            code[at + 2] = (tgt >> 16) & 0xff;
            code[at + 3] = (tgt >> 24) & 0xff;
        }
    }
}
/* codegen-time var visibility (root-cause 2026-08-03): during codegen, lookups run
   with parse_base=0 over [0, fve[gfn]), so a name that is BOTH a file-scope static
   AND an earlier function's local would resolve to the LOCAL (later index) — e.g.
   gen_code's `lc = g_lc_save` picked up cg()'s local `lc`, emitting a frame access
   whose rsp_off lay ~1KB below gen_code's frame. The global frame hid this (the
   write stayed in-frame); local frames expose it (stack corruption). The parse-time
   rule is: non-static vars are visible only within their own function
   [fvb[gfn], fve[gfn]); statics are visible everywhere. Enforce it during codegen. */
静 整 var_codegen_visible(整 i) {
    若 (vars[i].is_static) {
        若 (!vs_end) 返 1;            /* parse: statics visible (parse_base floor already blocks prior fns) */
        若 (cg_ginit_ctx) 返 1;       /* ginit: emitted at main entry, ALL statics visible (fix 2026-08-11 BLOCKER-3) */
        若 (var_static_kw[i]) 返 (i >= fvb[gfn]); /* fn-local static: ONLY its own function (fix 2026-08-11 BLOCKER-3) */
        返 1;                         /* global static: visible from any function */
    }
    若 (!vs_end) 返 (i >= parse_base); /* parse phase: ONLY current function body (parse_base floor).
                                              fix 2026-08-11 BLOCKER-1: 原 return 1 导致跨函数同名变量泄漏 —
                                              var_is_dbl 等从其他函数找到同名变量 → ndbl[] 误标 → codegen 差异 (布局敏感根因) */
    返 (i >= fvb[gfn]);            /* codegen: only THIS function's locals/params */
}
静 整 var_is_dbl(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_dbl;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_dbl; /* 全局 double (fix 2026-08-13: parse 期 parse_base 排除全局 → 全局 double 算术丢 64 位) */
    返 0;
}
/* long long var: 64-bit int loads/stores (fix 2026-08-05) */
静 整 var_is_ll(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_ll;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_ll; /* 全局 long long (fix 2026-08-13: 全局 LL 算术被当 32 位, b_global 6000000000→低32) */
    返 0;
}
/* unsigned variable: >> must use SHR (logical), not SAR (fix 2026-08-05) */
静 整 var_is_uns(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_uns;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_uns; /* 全局 unsigned (fix 2026-08-13) */
    返 0;
}
/* pointer-to-double (double *p): p[i] reads/writes 8-byte doubles (movsd) */
静 整 var_pdbl(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].p_dbl;
    返 0;
}
/* 8-byte frame slot for a local double */
静 整 var_ll(常 字 *n) { /* long long: 8-byte int slot (fix 2026-08-05) */
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].arr_sz == 0 && var_codegen_visible(i)) { vars[i].is_ll = 1; 返 vars[i].rsp_off; }
    若 (vcnt >= 16000) { fprintf(stderr, "[ERR] 变量表满 vcnt=%d\n", vcnt); exit(1); }
    strcpy(vars[vcnt].name, n);
    rsp_used += 8; rsp_used = (rsp_used + 15) & ~15;
    vars[vcnt].rsp_off = rsp_used - 8;
    vars[vcnt].is_param = 0;
    vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0; vars[vcnt].p_esz = 0; vars[vcnt].pstk = 0; vars[vcnt].pdisp = 0; vars[vcnt].is_dbl = 0; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = 0; vars[vcnt].is_uns = 0; vars[vcnt].is_static = 0;
    vars[vcnt].is_ll = 1;
    返 vars[vcnt++].rsp_off;
}
