        整 idx_d = Nd(14); Nc(idx_d, v_d); { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32); Nc(idx_d, v_i2); } /* dst[__mi] */
        整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, call); Nc(bd, asg); /* dst[__mi] = fn(...); */
        { 整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); } 整 asg_i = Nd(10); Nc(asg_i, v_i); Nc(asg_i, pl); Nc(bd, asg_i); } /* __mi = __mi + 1; */
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "重载")) { /* 接入 2026-08-27 运算符重载注册: 重载 + 点 = 点_add; → ov 表注册 (运算符 + 类型名 → 函数名), add() 分派 — 用户先定义普通函数再注册 */ /* 2026-08-28 P2 #257/#258: 重载 * 智能 = fn (解引用), 重载 () 函子 = fn (调用) */
        tk++; /* 重载 */
        整 op_r = 0;
        若 (tt[tk] == PK) { op_r = PK; tk++; } /* + */
        否 若 (tt[tk] == MK) { op_r = MK; tk++; } /* - */
        否 若 (tt[tk] == DK) { op_r = DK; tk++; } /* #257 * 解引用重载 */
        否 若 (tt[tk] == OK) { op_r = OK; tk++; 若 (tt[tk] == KK) tk++; } /* #258 () 调用重载 */
        字 ty_r[64] = ""; 若 (tt[tk] == VR) { strcpy(ty_r, tn[tk]); tk++; } /* 类型名 */
        若 (tt[tk] == AK) tk++; /* = */
        字 fn_r[64] = ""; 若 (tt[tk] == VR) { strcpy(fn_r, tn[tk]); tk++; } /* 函数名 */
        若 (tt[tk] == SK) tk++; /* ; */
        若 (ov_n < 32 && op_r && ty_r[0] && fn_r[0]) { ov_op[ov_n] = (字)op_r; strcpy(ov_ty[ov_n], ty_r); strcpy(ov_fn[ov_n], fn_r); ov_n++; }
        返 Nd(5);
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "通道")) { /* 接入 2026-08-28 机制层: 有界通道声明 (Go channel, 环形缓冲): 通道 q, n; → { int __ch_q_buf[n]; int __ch_q_cap=n; int __ch_q_h=0; int __ch_q_t=0; int __ch_q_c=0; } — 送/收 内联环形队列 (非阻塞) */
        tk++; /* 通道 */
        字 qn[64]; strcpy(qn, tn[tk]); tk++; /* 通道名 */
        若 (tt[tk] == CK) tk++; /* , */
        整 cap = 4;
        const_expr_eval(&cap); /* 容量 (常量; 失败默认 4) */
        若 (tt[tk] == SK) tk++; /* ; */
        字 bname[80], hname[80], tname[80], cname[80], pname[80];
        sprintf(bname, "__ch_%s_buf", qn); sprintf(hname, "__ch_%s_h", qn);
        sprintf(tname, "__ch_%s_t", qn); sprintf(cname, "__ch_%s_c", qn); sprintf(pname, "__ch_%s_cap", qn);
        var_array(bname, cap, 4); /* int __ch_q_buf[cap]; (内部数组, 4 字节元素) */
        var_offset(hname); var_offset(tname); var_offset(cname); var_offset(pname);
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), pname, 32); 整 cv = Nd(0); nv[cv] = cap; Nc(d, cv); Nc(blk, d); } /* int __ch_q_cap = cap; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), hname, 32); 整 z = Nd(0); nv[z] = 0; Nc(d, z); Nc(blk, d); } /* int __ch_q_h = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), tname, 32); 整 z = Nd(0); nv[z] = 0; Nc(d, z); Nc(blk, d); } /* int __ch_q_t = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), cname, 32); 整 z = Nd(0); nv[z] = 0; Nc(d, z); Nc(blk, d); } /* int __ch_q_c = 0; */
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "送")) { /* 接入 2026-08-28 机制层: 通道发送 (有界环形缓冲, 非阻塞) — 送 q, v; → { if (__ch_q_c < __ch_q_cap) { __ch_q_buf[__ch_q_t]=v; __ch_q_t=(__ch_q_t+1)%__ch_q_cap; __ch_q_c++; } }; 通道未声明时回退旧语法糖 chan_send(&ch, v) */
        tk++; /* 送 */
        字 qn[64]; strcpy(qn, tn[tk]);
        字 bname[80]; sprintf(bname, "__ch_%s_buf", qn);
        若 (var_lookup(bname) >= 0) { /* 通道已声明 (通道 q, n;) → 内联环形缓冲 */
            tk++; /* 通道名 */
            若 (tt[tk] == CK) tk++; /* , */
            整 e_v = expr(); /* 值 */
            若 (tt[tk] == SK) tk++; /* ; */
            字 hname[80], tname[80], cname[80], pname[80];
            sprintf(hname, "__ch_%s_h", qn); sprintf(tname, "__ch_%s_t", qn);
            sprintf(cname, "__ch_%s_c", qn); sprintf(pname, "__ch_%s_cap", qn);
            整 blk = Nd(5);
            整 v_c = Nd(1); memcpy((字*)(nn + v_c), cname, 32);
            整 v_p = Nd(1); memcpy((字*)(nn + v_p), pname, 32);
            整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_c); Nc(cmp, v_p); /* __ch_q_c < __ch_q_cap */
            整 ifn = Nd(8); Nc(ifn, cmp);
            整 ibd = Nd(5);
            { 整 v_b = Nd(1); memcpy((字*)(nn + v_b), bname, 32);
              整 v_t = Nd(1); memcpy((字*)(nn + v_t), tname, 32);
              整 idx = Nd(14); Nc(idx, v_b); Nc(idx, v_t);
              整 asg = Nd(10); Nc(asg, idx); Nc(asg, e_v); Nc(ibd, asg); } /* __ch_q_buf[__ch_q_t] = v; */
            { 整 v_t2 = Nd(1); memcpy((字*)(nn + v_t2), tname, 32);
              整 one = Nd(0); nv[one] = 1;
              整 add = Nd(2); nv[add] = PK; Nc(add, v_t2); Nc(add, one);
              整 v_p2 = Nd(1); memcpy((字*)(nn + v_p2), pname, 32);
              整 md = Nd(2); nv[md] = MD; Nc(md, add); Nc(md, v_p2);
              整 asg = Nd(10); Nc(asg, v_t2); Nc(asg, md); Nc(ibd, asg); } /* __ch_q_t = (__ch_q_t+1) % __ch_q_cap; */
            { 整 v_c2 = Nd(1); memcpy((字*)(nn + v_c2), cname, 32);
              整 one = Nd(0); nv[one] = 1;
              整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_c2); Nc(pl, one);
              整 asg = Nd(10); Nc(asg, v_c2); Nc(asg, pl); Nc(ibd, asg); } /* __ch_q_c++; */
            Nc(ifn, ibd);
            Nc(blk, ifn);
            返 blk;
        }
        /* 回退: 旧语法糖 chan_send(&ch, v) */
        整 e_ch = expr(); /* 通道表达式 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_v = expr(); /* 值表达式 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 call = Nd(4);
        { 整 addr = Nd(11); Nc(addr, e_ch); Nc(call, addr); } /* &ch */
        Nc(call, e_v); /* v */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "chan_send", 10); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "收")) { /* 接入 2026-08-28 机制层: 通道接收 (有界环形缓冲, 非阻塞) — 收 q, v; → { if (__ch_q_c > 0) { v = __ch_q_buf[__ch_q_h]; __ch_q_h = (__ch_q_h+1)%__ch_q_cap; __ch_q_c--; } }; 通道未声明时回退旧语法糖 chan_recv(&ch, &v) */
        tk++; /* 收 */
        字 qn[64]; strcpy(qn, tn[tk]);
        字 bname[80]; sprintf(bname, "__ch_%s_buf", qn);
        若 (var_lookup(bname) >= 0) { /* 通道已声明 → 内联环形缓冲 */
            tk++; /* 通道名 */
            若 (tt[tk] == CK) tk++; /* , */
            字 vn[64]; strcpy(vn, tn[tk]); tk++; /* 目标变量 */
            若 (tt[tk] == SK) tk++; /* ; */
            字 hname[80], tname[80], cname[80], pname[80];
            sprintf(hname, "__ch_%s_h", qn); sprintf(tname, "__ch_%s_t", qn);
            sprintf(cname, "__ch_%s_c", qn); sprintf(pname, "__ch_%s_cap", qn);
            整 blk = Nd(5);
            整 v_c = Nd(1); memcpy((字*)(nn + v_c), cname, 32);
            整 z = Nd(0); nv[z] = 0;
            整 cmp = Nd(2); nv[cmp] = T_GK; Nc(cmp, v_c); Nc(cmp, z); /* __ch_q_c > 0 */
            整 ifn = Nd(8); Nc(ifn, cmp);
            整 ibd = Nd(5);
            { 整 v_b = Nd(1); memcpy((字*)(nn + v_b), bname, 32);
              整 v_h = Nd(1); memcpy((字*)(nn + v_h), hname, 32);
              整 idx = Nd(14); Nc(idx, v_b); Nc(idx, v_h);
              整 v_r = Nd(1); memcpy((字*)(nn + v_r), vn, 32);
              整 asg = Nd(10); Nc(asg, v_r); Nc(asg, idx); Nc(ibd, asg); } /* v = __ch_q_buf[__ch_q_h]; */
            { 整 v_h2 = Nd(1); memcpy((字*)(nn + v_h2), hname, 32);
              整 one = Nd(0); nv[one] = 1;
              整 add = Nd(2); nv[add] = PK; Nc(add, v_h2); Nc(add, one);
              整 v_p = Nd(1); memcpy((字*)(nn + v_p), pname, 32);
              整 md = Nd(2); nv[md] = MD; Nc(md, add); Nc(md, v_p);
              整 asg = Nd(10); Nc(asg, v_h2); Nc(asg, md); Nc(ibd, asg); } /* __ch_q_h = (__ch_q_h+1) % __ch_q_cap; */
            { 整 v_c2 = Nd(1); memcpy((字*)(nn + v_c2), cname, 32);
              整 one = Nd(0); nv[one] = 1;
              整 sub = Nd(2); nv[sub] = MK; Nc(sub, v_c2); Nc(sub, one);
              整 asg = Nd(10); Nc(asg, v_c2); Nc(asg, sub); Nc(ibd, asg); } /* __ch_q_c--; */
            Nc(ifn, ibd);
            Nc(blk, ifn);
            返 blk;
        }
        /* 回退: 旧语法糖 chan_recv(&ch, &v) */
        整 e_ch = expr(); /* 通道表达式 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_v = expr(); /* 目标表达式 */
        若 (tt[tk] == SK) tk++; /* ; */
        整 call = Nd(4);
        { 整 addr1 = Nd(11); Nc(addr1, e_ch); Nc(call, addr1); } /* &ch */
        { 整 addr2 = Nd(11); Nc(addr2, e_v); Nc(call, addr2); } /* &v */
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "chan_recv", 10); Nc(call, fn); } /* callee 最后 */
        返 call;
    }
    若 (tt[tk] == SK) { tk++; 返 Nd(5); } /* 空语句 ; — 返回空块节点 (codegen 无输出). fix 2026-08-19: 原落 expr() 兜底返回 -1 (不消费) → stmt() 挂 -1 给 if 空体 → case-8 codegen n1=-1 错乱 → `if (c) ; else ...` else 链无条件执行 (commit.c handle_ignored_arg strcmp(NULL) SEGV) */
    
    { 整 e = expr(); err_union_check(e); tk++; 返 e; }
}
/* 常量整数表达式求值 (数组维度用): 支持整数/枚举/宏常量、括号、+-*\/%<>^&| 与一元 +-~。
   左到右求值 (维度表达式几乎都是单运算符, 优先级差异可忽略)。成功置 *val 并推进 tk, 返回 1; 失败不推进, 返回 0。
   (fix 2026-08-14: hash_algos[GIT_HASH_NALGOS] 展开成 [(2 + 1)] — 原数组维度只认单 NK/VR token, `(` 卡住 → 维度=0 → 后续 null_oid 定义被吞 undefined) */
静 整 const_expr_eval(整 *val); /* fwd */
静 整 const_expr_prim(整 *val) {
    若 (tt[tk] == NK) { *val = tv[tk]; tk++; 返 1; }
    若 (tt[tk] == AL) { /* _Alignof 常量求值 (fix 2026-08-25 支持矩阵补全 step1) */
        tk++; 若 (tt[tk] == OK) tk++;
        *val = alignof_type();
        若 (tt[tk] == KK) tk++;
        返 1;
    }
    若 (tt[tk] == BK) { /* sizeof 常量维度: char tmp[sizeof "..."] (fix 2026-08-15: inet_ntop.c tp 未注册 undefined) */
        tk++; 若 (tt[tk] == OK) tk++; /* sizeof( */
        整 sz = 4;
        /* fix 2026-08-17: sizeof((arr)[idx]) — 括号数组元素 (ARRAY_SIZE(paths) 展开成
           sizeof(paths)/sizeof((paths)[0])): (paths) 括号后跟 [0] 下标, 原代码既不进
           VR 分支也不被 OK 分支消费 → sz 错 + token 残留 → 数组维度求值错 →
           brace_arr_init 越界崩 (diff-no-index.c to_free 0xC0000005). */
        若 (tt[tk] == OK && tt[tk + 1] == VR && tt[tk + 2] == KK && tt[tk + 3] == LB) {
            整 pe = var_esz(tn[tk + 1]); 若 (pe > 0) sz = pe;
            tk += 4; 循环 (tk < TS && tt[tk] != RB && tt[tk] != EK) tk++; 若 (tt[tk] == RB) tk++;
            若 (tt[tk] == KK) tk++; /* 末尾 ) */
            *val = sz; 返 1;
        }
        若 (tt[tk] == STR) { sz = (整)strlen(str_tbl[tv[tk]]) + 1; tk++; }
        否 若 (tt[tk] == VK) { 若 (!strcmp(tn[tk],"char")||!strcmp(tn[tk],"_Bool")) sz=1; 否 若 (!strcmp(tn[tk],"double")) sz=8; 否 若 (!strcmp(tn[tk],"short")) sz=2; tk++; 循环 (tt[tk] == DK) { sz = 8; tk++; } }
        否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { 整 si = st_find(tn[tk]); 若 (si >= 0) sz = stypes[si].sz; tk++; } }
        否 若 (tt[tk] == DK) { sz = 8; tk++; 若 (tt[tk] == VR) tk++; }
        否 若 (tt[tk] == VR) { 整 si = var_stidx(tn[tk]);
            若 (si < 0 && td_is(tn[tk])) { 整 tdi = tdef_lookup(tn[tk]); 若 (tdi >= 0 && tdefs[tdi].sz > 0) { sz = tdefs[tdi].sz; tk++; } } /* fix 2026-08-20: typedef 名 sizeof (sizeof(uint64_t) 原 4 → csprng_bytes(&v,sizeof(v)) 只填低 4 字节 → mkstemp 随机后缀高 4 字节垃圾 → 乱码文件名) */
            否 tk++;
            若 ((tt[tk] == AR || tt[tk] == DT) && tt[tk + 1] == VR) { 若 (si >= 0) { 整 fs = st_field_size(stypes[si].name, tn[tk + 1]); 若 (fs > 0) sz = fs; } tk += 2; }
            /* fix 2026-08-17: sizeof(裸数组名) 返回数组总字节数 (arr_sz * esz) — 原默认 4 →
               ARRAY_SIZE(arr) 展开 sizeof(arr) 除错 → 数组维度求值错 (diff-no-index.c to_free).
               仅当是数组变量 (arr_sz>0) 才覆盖, 普通变量保持默认 4. */
            否 { 整 vsz = var_sizeof(tn[tk - 1]); 若 (vsz > 0) sz = vsz; } } /* fix 2026-08-20: 普通变量 sizeof (long long v → 8; 原 4); fix 2026-08-28: 数组总字节统一走 var_sizeof (2D 用标量元素大小, sizeof(int[2][2])=16 非 32) */
        若 (tt[tk] == KK) tk++;
        *val = sz; 返 1;
    }
    若 (tt[tk] == VR) { 整 ev = e_lookup(tn[tk]); 整 evf = (ev != 0x80000000 && ev != -1); 若 (!evf) { ev = macro_find(tn[tk]); evf = (ev != 0x80000000 && ev != -1); } /* e_lookup 缺失=0x80000000, macro_find 缺失=-1 — 两者都算未找到 */ 若 (!evf && ctfe_n > 0) { 整 ev2 = ctfe_lookup(tn[tk]); 若 (ev2 != 0x80000000) { ev = ev2; evf = 1; } } /* 2026-08-28 type-root-16 #76: CTFE 帧内变量 (参数/局部); fix 2026-08-29 #172: 帧内查到 -1 (负参数) 必须接受, 不能当"未找到"拒绝 */ 若 (evf) { *val = ev; tk++; 返 1; } 返 0; }
    若 (tt[tk] == OK) { tk++; 若 (!const_expr_eval(val)) 返 0; 若 (tt[tk] == KK) tk++; 返 1; }
    若 (tt[tk] == MK) { tk++; 若 (!const_expr_prim(val)) 返 0; *val = -*val; 返 1; }
    若 (tt[tk] == PK) { tk++; 返 const_expr_prim(val); }
    若 (tt[tk] == BN) { tk++; 若 (!const_expr_prim(val)) 返 0; *val = ~*val; 返 1; }
    返 0;
}
静 整 const_expr_eval(整 *val) {
    若 (!const_expr_prim(val)) 返 0;
    遍 (;;) {
        整 op = tt[tk];
        若 (op == PK || op == MK || op == DK || op == DV || op == MD || op == SH || op == SR || op == PT || op == OR || op == XR || op == QK || op == XK || op == LK || op == GK || op == HK || op == YK) {
            tk++; 整 r; 若 (!const_expr_prim(&r)) 返 0;
            择 (op) { 例 PK: *val += r; 断; 例 MK: *val -= r; 断; 例 DK: *val *= r; 断;
                例 DV: 若 (r) *val /= r; 断; 例 MD: 若 (r) *val %= r; 断; 例 SH: *val <<= r; 断;
                例 SR: *val >>= r; 断; 例 PT: *val &= r; 断; 例 OR: *val |= r; 断; 例 XR: *val ^= r; 断;
                例 QK: *val = (*val == r); 断; 例 XK: *val = (*val != r); 断; 例 LK: *val = (*val < r); 断;
                例 GK: *val = (*val > r); 断; 例 HK: *val = (*val <= r); 断; 例 YK: *val = (*val >= r); 断; /* fix 2026-08-25: _Static_assert 比较运算符 */ }
        } 否 断;
    }
    返 1;
}

/* ========== 编译期执行完整 CTFE 解释器 (2026-08-28 type-root-16 #76) ==========
   在 [body0, body1) 解释纯函数体 (调用方把全局 tk 设为 body0, 用完恢复).
   支持: 声明/赋值/if/while/for/return/块; 纯算术表达式 (const_expr_eval + CTFE 帧).
   返回: 1=解释完成 0=无法解释 (known=0 安全跳过). */
静 空 ctfe_bind(常 字 *n, 整 v) { /* 帧绑定: 同名更新, 新名压栈 */
    遍 (整 i = ctfe_n - 1; i >= 0; i--) 若 (!strcmp(ctfe_names[i], n)) { ctfe_vals[i] = v; ctfe_isstr[i] = 0; 返; }
    若 (ctfe_n < 64) { strcpy(ctfe_names[ctfe_n], n); ctfe_vals[ctfe_n] = v; ctfe_isstr[ctfe_n] = 0; ctfe_n++; }
}
静 空 ctfe_bind_str(常 字 *n, 常 字 *v) { /* 字符串帧绑定: 同名覆盖类型, 新名压栈 */
    遍 (整 i = ctfe_n - 1; i >= 0; i--) 若 (!strcmp(ctfe_names[i], n)) { ctfe_isstr[i] = 1; strncpy(ctfe_str_vals[i], v, 4095); ctfe_str_vals[i][4095] = 0; 返; }
    若 (ctfe_n < 64) { strcpy(ctfe_names[ctfe_n], n); ctfe_isstr[ctfe_n] = 1; strncpy(ctfe_str_vals[ctfe_n], v, 4095); ctfe_str_vals[ctfe_n][4095] = 0; ctfe_n++; }
}
静 整 ctfe_str_of(常 字 *n, 字 *out, 整 outsz) { /* 读字符串帧值; 返回 1=是字符串 */
    遍 (整 i = ctfe_n - 1; i >= 0; i--) 若 (!strcmp(ctfe_names[i], n) && ctfe_isstr[i]) { strncpy(out, ctfe_str_vals[i], outsz - 1); out[outsz - 1] = 0; 返 1; }
    返 0;
}
静 整 ctfe_is_str(常 字 *n) { /* 帧槽是否字符串 */
    遍 (整 i = ctfe_n - 1; i >= 0; i--) 若 (!strcmp(ctfe_names[i], n) && ctfe_isstr[i]) 返 1;
    返 0;
}
静 整 ctfe_str_expr(字 *out, 整 outsz) { /* 求值字符串表达式: 字面量 / 串变量 / 串(n) 数字转串 / + 拼接; 消费成功返回 1 (失败恢复 tk) */
    整 save = tk;
    字 buf[4096]; buf[0] = 0;
    若 (tt[tk] == STR) { strncpy(buf, str_tbl[tv[tk]], 4095); buf[4095] = 0; tk++; }
    否 若 (tt[tk] == VR && ctfe_is_str(tn[tk])) { ctfe_str_of(tn[tk], buf, 大小(buf)); tk++; }
    否 若 (tt[tk] == VR && !strcmp(tn[tk], "串")) { /* 串(n): int → 十进制串 (作首操作数) */
        tk++; 若 (tt[tk] == OK) tk++;
        整 v = 0; 若 (!const_expr_eval(&v)) { tk = save; 返 0; }
        字 tmp[32]; sprintf(tmp, "%d", v);
        strncpy(buf, tmp, 4095); buf[4095] = 0;
        若 (tt[tk] == KK) tk++;
    }
    否 返 0;
    循环 (tt[tk] == PK) { /* + 拼接 (lexer: 二元加=PK, +=复合=PA) */
        tk++;
        若 (tt[tk] == STR) { strncat(buf, str_tbl[tv[tk]], 4095 - (整)strlen(buf)); tk++; }
        否 若 (tt[tk] == VR && ctfe_is_str(tn[tk])) { 字 tmp[4096]; ctfe_str_of(tn[tk], tmp, 大小(tmp)); strncat(buf, tmp, 4095 - (整)strlen(buf)); tk++; }
        否 若 (tt[tk] == VR && !strcmp(tn[tk], "串")) { /* 串(n): int → 十进制串 */
            tk++; 若 (tt[tk] == OK) tk++;
            整 v = 0; 若 (!const_expr_eval(&v)) { tk = save; 返 0; }
            字 tmp[32]; sprintf(tmp, "%d", v);
            strncat(buf, tmp, 4095 - (整)strlen(buf));
            若 (tt[tk] == KK) tk++;
        }
        否 { tk = save; 返 0; }
    }
    strncpy(out, buf, outsz); out[outsz - 1] = 0;
    返 1;
}
静 整 ctfe_failed = 0; /* CTFE 解释失败标志 (无法解释/副作用) — 区分 return 发生 vs 无法解释 */
静 整 ctfe_skip_block(空) { /* tk 指向 {, 跳到匹配 } 之后; 返回 1 成功 */
    整 d = 0;
    循环 (tk < TS) { 若 (tt[tk] == FK) d++; 否 若 (tt[tk] == UK) { d--; 若 (d == 0) { tk++; 返 1; } } tk++; }
    返 0;
}
静 整 ctfe_skip_to_semicolon(空) { /* 跳到顶层 ; (消费); 返回 1 成功 */
    整 d = 0;
    循环 (tk < TS) { 若 (tt[tk] == OK || tt[tk] == FK || tt[tk] == LB) d++; 否 若 (tt[tk] == KK || tt[tk] == UK || tt[tk] == RB) { 若 (d > 0) d--; } 否 若 (tt[tk] == SK && d == 0) { tk++; 返 1; } tk++; }
    返 0;
}
静 整 ctfe_step(整 *v); /* fwd: for-step 解析 */
静 整 ctfe_step_end(空) { /* 定位 for-step 结束位置 (不执行, 从 tk 扫到顶层 KK/SK) — step 在循环尾才执行 */
    整 d = 0; 整 j = tk;
    循环 (j < TS) {
        若 (tt[j] == OK) d++;
        否 若 (tt[j] == KK) { 若 (d == 0) 返 j; d--; }
        否 若 (tt[j] == SK && d == 0) 返 j;
        j++;
    }
    返 j;
}
静 整 ctfe_stmt(整 *ret) { /* 解释单条语句; 返回 1=继续 0=终止 (return 或块尾或无法解释 — 无法解释时 ctfe_failed=1) */
    若 (tk >= TS) { ctfe_failed = 1; 返 0; }
    若 (tt[tk] == SK) { tk++; 返 1; } /* 空语句 */
    若 (tt[tk] == FK) { /* 块 */
        tk++;
        循环 (tk < TS && tt[tk] != UK) { 若 (!ctfe_stmt(ret)) { 若 (tt[tk] == UK) tk++; 返 0; } }
        若 (tt[tk] == UK) tk++;
        返 1;
    }
    若 (tt[tk] == RK) { /* return expr; — int 或 字符串 (过程宏代码生成 #172) */
        tk++;
        字 sret[8192];
        若 (ctfe_str_expr(sret, 大小(sret))) { /* 字符串返回 */
            strncpy(ctfe_ret_str, sret, 8191); ctfe_ret_str[8191] = 0; ctfe_ret_is_str = 1;
            若 (tt[tk] == SK) tk++;
            返 0;
        }
        整 v = 0;
        若 (!const_expr_eval(&v)) { ctfe_failed = 1; 返 0; }
        若 (tt[tk] == SK) tk++;
        *ret = v;
        返 0;
    }
    若 (tt[tk] == VK) { /* 声明: int x = expr [, y = expr]; — CTFE 支持标量 int + 字符串 (过程宏 #172) */
        循环 (tt[tk] == VK || (tt[tk] == VR && td_is(tn[tk]))) tk++; /* 类型 (int/char/.../typedef 名) */
        循环 (tt[tk] == DK) tk++; /* 指针: 跳过 (字符串变量即 char* 声明) */
        遍 (;;) {
            若 (tt[tk] != VR) { ctfe_failed = 1; 返 0; }
            字 vn[64]; strcpy(vn, tn[tk]); tk++;
            若 (tt[tk] == AK) { tk++; 字 sv[8192]; 若 (ctfe_str_expr(sv, 大小(sv))) { ctfe_bind_str(vn, sv); } 否 { 整 v = 0; 若 (!const_expr_eval(&v)) { ctfe_failed = 1; 返 0; } ctfe_bind(vn, v); } }
            否 { ctfe_failed = 1; 返 0; } /* 无初始化 → 未知 */
            若 (tt[tk] == CK) { tk++; 续; }
            断;
        }
        若 (tt[tk] == SK) tk++;
        返 1;
    }
    若 (tt[tk] == IK) { /* if (cond) stmt [else stmt] */
        tk++; 若 (tt[tk] == OK) tk++;
        整 cv = 0; 若 (!const_expr_eval(&cv)) { ctfe_failed = 1; 返 0; }
        若 (tt[tk] == KK) tk++;
        若 (cv) {
            若 (!ctfe_stmt(ret)) { /* then 执行, return 结束: 若 else 存在则跳过其体 */
                若 (tt[tk] == ZK) { tk++; 若 (tt[tk] == FK) ctfe_skip_block(); 否 ctfe_skip_to_semicolon(); }
                返 0;
            }
            若 (tt[tk] == ZK) { tk++; 若 (tt[tk] == FK) ctfe_skip_block(); 否 ctfe_skip_to_semicolon(); } /* then 未 return: 跳过 else 体 */
        } 否 {
            若 (tt[tk] == FK) ctfe_skip_block(); 否 ctfe_skip_to_semicolon(); /* cv=0: 跳过 then 体 */
            若 (tt[tk] == ZK) { tk++; 若 (!ctfe_stmt(ret)) 返 0; }
        }
        返 1;
    }
    若 (tt[tk] == WK) { /* while (cond) stmt — 真循环 (上限防死循环) */
        tk++; 若 (tt[tk] == OK) tk++;
        整 cond_pos = tk; 整 body_pos = 0; 整 iters = 0;
        遍 (;;) {
            tk = cond_pos; 整 cv = 0;
            若 (!const_expr_eval(&cv)) { ctfe_failed = 1; 返 0; }
            若 (tt[tk] == KK) tk++;
            body_pos = tk;
            若 (!cv) 断;
            若 (++iters > 1000000) { ctfe_failed = 1; 返 0; } /* 防死循环 */
            tk = body_pos;
            若 (tt[tk] == FK) { tk++; 循环 (tk < TS && tt[tk] != UK) { 若 (!ctfe_stmt(ret)) { 若 (tt[tk] == UK) tk++; 返 0; } } 若 (tt[tk] == UK) tk++; }
            否 { 若 (!ctfe_stmt(ret)) 返 0; }
        }
        tk = body_pos;
        若 (tt[tk] == FK) ctfe_skip_block(); 否 ctfe_skip_to_semicolon();
        返 1;
    }
    若 (tt[tk] == JK) { /* for (init; cond; step) stmt — CTFE: init 为 int 声明/赋值 (ctfe_stmt 消费 ;), cond/step 常量表达式 */
        tk++; 若 (tt[tk] == OK) tk++;
        若 (!ctfe_stmt(NULL)) 返 0; /* init (声明/赋值, 消费 ;) — 失败已由 ctfe_failed 标记 */
        整 cond_pos = tk; 整 body_pos = 0; 整 step_pos = 0; 整 step_end = 0; 整 iters = 0;
        遍 (;;) {
            tk = cond_pos; 整 cv = 0;
            若 (tt[tk] == SK) cv = 1; /* for(;;) 无条件 */
            否 若 (!const_expr_eval(&cv)) { ctfe_failed = 1; 返 0; }
            若 (tt[tk] == SK) tk++;
            step_pos = tk; step_end = tk;
            若 (tt[tk] == KK) { tk++; body_pos = tk; } /* 无 step: for(;;cond;) — 直接到 ) */
            否 { step_end = ctfe_step_end(); tk = step_end; 若 (tt[tk] == KK) tk++; body_pos = tk; } /* 只定位 step 结束, 不执行 (循环尾才执行) */
            若 (!cv) { 若 (tt[tk] == FK) ctfe_skip_block(); 否 ctfe_skip_to_semicolon(); 断; } /* cond 假: 跳过 body 到 for 结束 (tk 停在 body 开始, 不跳则外层误解释 body) */
            若 (++iters > 1000000) { ctfe_failed = 1; 返 0; } /* 防死循环 */
            tk = body_pos;
            若 (tt[tk] == FK) { tk++; 循环 (tk < TS && tt[tk] != UK) { 若 (!ctfe_stmt(ret)) { 若 (tt[tk] == UK) tk++; 返 0; } } 若 (tt[tk] == UK) tk++; }
            否 { 若 (!ctfe_stmt(ret)) 返 0; }
            tk = step_pos; /* 循环尾执行 step (重新解释到 step_end) */
            若 (tk < step_end) { 整 sv = 0; 若 (!ctfe_step(&sv)) { ctfe_failed = 1; 返 0; } }
        }
        返 1;
    }
    若 (tt[tk] == VR) { /* x = expr; 或 x++; x--; x += n; — 赋值支持字符串 (过程宏 #172) */
        字 vn[64]; strcpy(vn, tn[tk]); tk++;
        若 (tt[tk] == AK) { tk++; 字 sv[8192]; 若 (ctfe_str_expr(sv, 大小(sv))) { ctfe_bind_str(vn, sv); 若 (tt[tk] == SK) tk++; 返 1; } 整 v = 0; 若 (!const_expr_eval(&v)) { ctfe_failed = 1; 返 0; } 若 (ctfe_lookup(vn) == 0x80000000) { ctfe_failed = 1; 返 0; } ctfe_bind(vn, v); 若 (tt[tk] == SK) tk++; 返 1; }
        若 (tt[tk] == PP) { tk++; 整 cur = ctfe_lookup(vn); 若 (cur == 0x80000000) { ctfe_failed = 1; 返 0; } ctfe_bind(vn, cur + 1); 若 (tt[tk] == SK) tk++; 返 1; }
        若 (tt[tk] == MM) { tk++; 整 cur = ctfe_lookup(vn); 若 (cur == 0x80000000) { ctfe_failed = 1; 返 0; } ctfe_bind(vn, cur - 1); 若 (tt[tk] == SK) tk++; 返 1; }
        若 (tt[tk] == PA || tt[tk] == MA || tt[tk] == DA || tt[tk] == SA || tt[tk] == OA) { 整 op = tt[tk]; tk++; 整 r = 0; 若 (!const_expr_eval(&r)) { ctfe_failed = 1; 返 0; } 整 cur = ctfe_lookup(vn); 若 (cur == 0x80000000) { ctfe_failed = 1; 返 0; } 若 (op == PA) cur += r; 否 若 (op == MA) cur -= r; 否 若 (op == DA) cur *= r; 否 若 (op == SA) { 若 (!r) { ctfe_failed = 1; 返 0; } cur /= r; } 否 { 若 (!r) { ctfe_failed = 1; 返 0; } cur %= r; } ctfe_bind(vn, cur); 若 (tt[tk] == SK) tk++; 返 1; }
        ctfe_failed = 1; 返 0; /* 函数调用等其他语句 → 无法解释 */
    }
    ctfe_failed = 1; 返 0;
}
静 整 ctfe_step(整 *v) { /* for-step: i++ / i-- / i+=n / i-=n / i*=n / i=n (无分号) */
    若 (tt[tk] == VR) {
        字 vn[64]; strcpy(vn, tn[tk]); tk++;
        若 (tt[tk] == PP) { tk++; 整 cur = ctfe_lookup(vn); 若 (cur == 0x80000000) 返 0; ctfe_bind(vn, cur + 1); 返 1; }
        若 (tt[tk] == MM) { tk++; 整 cur = ctfe_lookup(vn); 若 (cur == 0x80000000) 返 0; ctfe_bind(vn, cur - 1); 返 1; }
        若 (tt[tk] == AK) { tk++; 整 r = 0; 若 (!const_expr_eval(&r)) 返 0; ctfe_bind(vn, r); 返 1; }
        若 (tt[tk] == PA || tt[tk] == MA || tt[tk] == DA || tt[tk] == SA || tt[tk] == OA) { 整 op = tt[tk]; tk++; 整 r = 0; 若 (!const_expr_eval(&r)) 返 0; 整 cur = ctfe_lookup(vn); 若 (cur == 0x80000000) 返 0; 若 (op == PA) cur += r; 否 若 (op == MA) cur -= r; 否 若 (op == DA) cur *= r; 否 若 (op == SA) { 若 (!r) 返 0; cur /= r; } 否 { 若 (!r) 返 0; cur %= r; } ctfe_bind(vn, cur); 返 1; }
    }
    返 0;
}
静 整 ctfe_call(常 字 *fname, 整 *out) { /* 编译期 f(常量...): 解析实参 (全常量) → 绑定参数帧 → 解释函数体 → *out=结果; 返回 1 成功 0 无法 */
    整 fi = ctfe_find(fname);
    若 (fi < 0) 返 0;
    整 pmi = fn_param_find(fname);
    若 (pmi < 0) 返 0;
    整 base = ctfe_n;
    ctfe_failed = 0;
    /* 解析实参 (tk 已在 '(' 后): 常量表达式, 逗号分隔, 到 ) */
    整 argc = 0; 整 args[32];
    若 (tt[tk] != KK) {
        遍 (;;) {
            若 (argc >= 32) { ctfe_n = base; 返 0; }
            整 av = 0;
            若 (!const_expr_eval(&av)) { ctfe_n = base; 返 0; } /* 实参非常量 → 无法 */
            args[argc++] = av;
            若 (tt[tk] == CK) { tk++; 续; }
            断;
        }
    }
    若 (tt[tk] != KK) { ctfe_n = base; 返 0; }
    tk++; /* ) */
    遍 (整 i = 0; i < argc; i++) ctfe_bind(fn_param_map[pmi].pnames[i], args[i]);
    /* 解释函数体 */
    整 save_tk = tk;
    tk = ctfe_fns[fi].body0; /* 指向 { */
    整 rv = 0; 整 got_ret = 0;
    若 (tt[tk] == FK) tk++; /* 跳过 { */
    循环 (tk < TS && tt[tk] != UK && tk < ctfe_fns[fi].body1 && !ctfe_failed) {
        若 (!ctfe_stmt(&rv)) { got_ret = 1; 断; } /* return 或失败 */
    }
    整 ok = !ctfe_failed;
    若 (ok && !got_ret) rv = 0; /* 函数体自然结束 (无 return → 隐式 0) — return 后 rv 有效, 不覆盖 */
    ctfe_n = base;
    tk = save_tk;
    若 (!ok) 返 0;
    *out = rv;
    返 1;
}

静 整 ctfe_call_str(常 字 *fname, 字 *out, 整 outsz) { /* 过程宏 #172: 同 ctfe_call 但期望字符串返回 → out; 返回 1 成功 */
    整 fi = ctfe_find(fname);
    若 (fi < 0) 返 0;
    整 pmi = fn_param_find(fname);
    若 (pmi < 0) 返 0;
    整 base = ctfe_n;
    ctfe_failed = 0;
    ctfe_ret_is_str = 0; ctfe_ret_str[0] = 0;
    整 argc = 0; 整 args[32];
    若 (tt[tk] != KK) {
        遍 (;;) {
            若 (argc >= 32) { ctfe_n = base; 返 0; }
            整 av = 0;
            若 (!const_expr_eval(&av)) { ctfe_n = base; 返 0; }
            args[argc++] = av;
            若 (tt[tk] == CK) { tk++; 续; }
            断;
        }
    }
    若 (tt[tk] != KK) { ctfe_n = base; 返 0; }
    tk++; /* ) */
    遍 (整 i = 0; i < argc; i++) ctfe_bind(fn_param_map[pmi].pnames[i], args[i]);
    整 save_tk = tk;
    tk = ctfe_fns[fi].body0; /* 指向 { */
    整 rv = 0;
    若 (tt[tk] == FK) tk++;
    循环 (tk < TS && tt[tk] != UK && tk < ctfe_fns[fi].body1 && !ctfe_failed) {
        若 (!ctfe_stmt(&rv)) 断; /* return (int 或字符串) 或解释失败 */
    }
    整 ok = !ctfe_failed;
    ctfe_n = base;
    tk = save_tk;
    若 (!ok) 返 0;
    若 (!ctfe_ret_is_str) 返 0; /* 未返回字符串 → 非代码生成宏 */
    strncpy(out, ctfe_ret_str, outsz - 1); out[outsz - 1] = 0;
    返 1;
}

静 整 skip_global_init(整 tk) {
    /* 跳过全局/文件级声明中的初始化器: = expr / = { ... } / = ( ... )
       到顶层逗号或分号停止 (不消费逗号/分号)。 (fix 2026-08-15: *local_packs = NULL, *altodb_packs = NULL) */
    若 (tt[tk] != AK) 返 tk;
    tk++;
    整 d = 0;
    循环 (tk < TS && tt[tk] != EK) {
        若 (tt[tk] == FK || tt[tk] == OK || tt[tk] == LB) d++;
        否 若 (tt[tk] == UK || tt[tk] == KK || tt[tk] == RB) { d--; 若 (d < 0) d = 0; }
        否 若 (d == 0 && (tt[tk] == CK || tt[tk] == SK)) 断;
        tk++;
    }
    返 tk;
}

/* ========== 宏系统 (2026-08-28 type-root-12 #167: AST 级安全宏 — lex 后 parse 前 token 级展开) ========== */
静 构 { 字 name[64]; 整 ppos[16]; 整 pn; 整 body0; 整 body1; } jm_macros[512]; /* #168 2026-09-01: 参数存 token 坐标 (qcc char 数组乘式索引缺陷: params[16][64] 拷贝读空) */
静 整 jm_n = 0;
静 整 jm_decl0[512]; 静 整 jm_decl1[512]; /* 宏声明 token 区间 (展开时跳过) */
静 整 jm_find(常 字 *n) { 遍 (整 i = 0; i < jm_n; i++) 若 (!strcmp(jm_macros[i].name, n)) 返 i; 返 -1; }

静 整 *jm_tt2; 静 整 *jm_tv2; 静 整 *jm_tline2; 静 整 *jm_tuns2; 静 整 *jm_tll2; 静 整 *jm_tll_hi2;
静 字 (*jm_tn2)[64];
静 整 jm_out; 静 整 jm_depth;
/* 嵌套宏展开帧栈: 每帧记录 宏索引 + 原始实参 token 切片 (调用者上下文惰性展开, 替换时括号包裹) */
静 整 jm_stk_mi[24]; 静 整 jm_stk_an[24]; 静 整 jm_stk_raw[24][16][2];

static void jm_overflow(void); /* fwd (定义在 jm_emit_hyg 之后) */
/* 接入 2026-09-01 #168 卫生宏: 函数宏体内局部变量声明在每次展开时 gensym 改名 (_hyg<序>_<原名>),
   与调用点同名变量隔离 (无变量捕获). 卫栈按展开深度嵌套; 实参展开在调用者上下文, 用调用者帧. */
静 字 hyg_orig[32][32][64];
/* #173 注解/属性 (2026-09-01): 注解 名 = 值; 顶层元数据标注 — 注解表 (名→值), 编译期可查 */
静 构 { 字 name[64]; 字 value[256]; } annot_tbl[256];
静 整 annot_n = 0;

静 整 annot_get(常 字 *n, 字 *v) { 遍 (整 i = 0; i < annot_n; i++) 若 (!strcmp(annot_tbl[i].name, n)) { strcpy(v, annot_tbl[i].value); 返 1; } 返 0; } 静 字 hyg_new[32][32][80]; 静 整 hyg_cnt[32]; 静 整 hyg_depth = 0; 静 整 hyg_seq = 0;
静 字 hyg_buf[32][64];

静 整 hyg_find(常 字 *name, 字 *out) {
    遍 (整 l = hyg_depth - 1; l >= 0; l--) {
        遍 (整 k = 0; k < hyg_cnt[l]; k++)
            若 (!strcmp(hyg_orig[l][k], name)) { strcpy(out, hyg_new[l][k]); 返 1; }
    }
    返 0;
}

静 整 hyg_scan(整 a, 整 b, 整 mi) {
    /* 扫描宏体 token [a,b) 识别局部变量声明: <类型词|typedef名> <变量名> 且 后跟 =/;/,[ 且 非宏参数 */
    整 n = 0; 整 i = a;
    循环 (i < b) {
        整 is_type = (tt[i] == VK) || (tt[i] == VR && (tdef_lookup(tn[i]) >= 0 || !strcmp(tn[i], "typedef")));
        若 (is_type) {
            整 s = i + 1;
            循环 (s < b && (tt[s] == VK || (tt[s] == VR && tdef_lookup(tn[s]) >= 0))) s++;
            整 np = -1;
            若 (s < b && tt[s] == VR) {
                np = s;
                若 (tdef_lookup(tn[s]) >= 0 && s + 1 < b && tt[s + 1] == VR) np = s + 1; /* typedef 类型名后才是变量 */
            }
            若 (np >= 0) {
                整 aft = np + 1;
                若 (aft < b && (tt[aft] == AK || tt[aft] == SK || tt[aft] == CK || tt[aft] == LB)) {
                    整 is_p = 0;
                    遍 (整 k = 0; k < jm_macros[mi].pn && k < 16; k++) 若 (!strcmp(tn[jm_macros[mi].ppos[k]], tn[np])) { is_p = 1; 断; }
                    若 (!is_p && n < 32) { strcpy(hyg_buf[n], tn[np]); n++; }
                }
            }
            i = (np >= 0) ? (np + 1) : (s > i ? s : i + 1);
            续;
        }
        i++;
    }
    返 n;
}

静 空 jm_emit_hyg(整 i) { /* #168: 输出 token, 命中卫栈则输出 gensym 新名 */
    字 out[80]; 字 *wn = tn[i];
    若 (tt[i] == VR && hyg_depth > 0 && hyg_find(tn[i], out)) wn = out;
    若 (jm_out >= TS) jm_overflow();
    jm_tt2[jm_out] = tt[i]; jm_tv2[jm_out] = tv[i]; strcpy(jm_tn2[jm_out], wn);
    jm_tline2[jm_out] = tline[i]; jm_tuns2[jm_out] = tuns[i]; jm_tll2[jm_out] = tll[i]; jm_tll_hi2[jm_out] = tll_hi[i];
    jm_out++;
}

静 空 jm_overflow(空) { fprintf(stderr, "[ERR] A9008 宏展开超限: token 数超上限\n"); exit(1); }

静 空 jm_emit_paren(整 type) { /* 合成 ( ) token 用于实参括号包裹 */
    若 (jm_out >= TS) jm_overflow();
    jm_tt2[jm_out] = type; jm_tv2[jm_out] = 0; strcpy(jm_tn2[jm_out], type == OK ? "(" : ")");
    jm_tline2[jm_out] = 0; jm_tuns2[jm_out] = 0; jm_tll2[jm_out] = 0; jm_tll_hi2[jm_out] = 0;
    jm_out++;
}

静 整 jm_param_of(整 i, 整 *frame_out, 整 *param_out) { /* 最内层活动帧的参数匹配 (词法遮蔽) */
    遍 (整 f = jm_depth - 1; f >= 0; f--) {
        整 mi = jm_stk_mi[f];
        遍 (整 q = 0; q < jm_macros[mi].pn; q++)
            若 (!strcmp(tn[jm_macros[mi].ppos[q]], tn[i])) { *frame_out = f; *param_out = q; 返 1; }
    }
    返 0;
}

/* 展开原 token 区间 [a,b) 到输出: 嵌套宏调用展开 + 活动帧参数替换 (实参在调用者上下文惰性展开+括号包裹) */
静 空 jm_emit_orig(整 a, 整 b);

静 空 jm_emit_arg(整 fr, 整 q) { /* 帧 fr 的第 q 个实参, 在调用者上下文 (帧 0..fr-1) 展开 — 保存/恢复被隐藏帧槽位 (嵌套调用会复用槽位) */
    整 saved = jm_depth;
    整 saved_hyg = hyg_depth; hyg_depth = fr; /* #168 卫生宏: 实参在调用者上下文展开, 用调用者帧 (0..fr-1) 的卫栈, 屏蔽本宏帧 */
    整 s_mi = jm_stk_mi[fr]; 整 s_an = jm_stk_an[fr]; 整 s_raw[16][2];
    遍 (整 k = 0; k < 16; k++) { s_raw[k][0] = jm_stk_raw[fr][k][0]; s_raw[k][1] = jm_stk_raw[fr][k][1]; }
    jm_depth = fr;
    jm_emit_paren(OK);
    jm_emit_orig(jm_stk_raw[fr][q][0], jm_stk_raw[fr][q][1]);
    jm_emit_paren(KK);
    hyg_depth = saved_hyg;
    jm_depth = saved;
    jm_stk_mi[fr] = s_mi; jm_stk_an[fr] = s_an;
    遍 (整 k = 0; k < 16; k++) { jm_stk_raw[fr][k][0] = s_raw[k][0]; jm_stk_raw[fr][k][1] = s_raw[k][1]; }
}

静 空 jm_emit_orig(整 a, 整 b) {
    整 i = a;
    循环 (i < b) {
        若 (tt[i] == VR && !strcmp(tn[i], "宏")) {
            整 dk = -1; 遍 (整 k = 0; k < jm_n; k++) 若 (jm_decl0[k] == i) { dk = k; 断; }
            若 (dk >= 0) { i = jm_decl1[dk]; 续; }
        }
        若 (tt[i] == VR) {
            整 f0, q0;
            若 (jm_param_of(i, &f0, &q0)) { jm_emit_arg(f0, q0); i++; 续; }
        }
        整 mi = (tt[i] == VR) ? jm_find(tn[i]) : -1;
        若 (tt[i] == VR && i + 1 < ti && tt[i + 1] == OK && mi >= 0 && jm_depth < 24) {
            整 ce = i + 2; 整 d = 1;
            循环 (ce < ti && d > 0) { 若 (tt[ce] == OK) d++; 否 若 (tt[ce] == KK) { d--; 若 (d == 0) 断; } ce++; }
            整 raw[16][2]; 整 an = 0; 整 p0 = i + 2; 整 pd = 0;
            遍 (整 p = i + 2; p < ce; p++) {
                若 (tt[p] == OK) pd++;
                否 若 (tt[p] == KK) { 若 (pd > 0) pd--; }
                否 若 (tt[p] == CK && pd == 0) { 若 (an < 16) { raw[an][0] = p0; raw[an][1] = p; } an++; p0 = p + 1; }
            }
            若 (p0 < ce && an < 16) { raw[an][0] = p0; raw[an][1] = ce; an++; } /* 空括号 an=0 */
            若 (an != jm_macros[mi].pn) { tk = i; emit_error("A9007", "宏参数个数不匹配: 调用与声明参数数不一致"); }
            整 fr = jm_depth;
            jm_stk_mi[fr] = mi; jm_stk_an[fr] = an;
            遍 (整 k = 0; k < an; k++) { jm_stk_raw[fr][k][0] = raw[k][0]; jm_stk_raw[fr][k][1] = raw[k][1]; }
            jm_depth++;
            { 整 hyg_base = hyg_depth;
              若 (hyg_depth < 32) {
                  整 hn = hyg_scan(jm_macros[mi].body0, jm_macros[mi].body1, mi);
                  若 (hn > 0) {
                      遍 (整 k = 0; k < hn; k++) {
                          strcpy(hyg_orig[hyg_depth][k], hyg_buf[k]);
                          sprintf(hyg_new[hyg_depth][k], "_hyg%d_%s", hyg_seq++, hyg_buf[k]);
                      }
                  }
                  hyg_cnt[hyg_depth] = hn; hyg_depth++; /* 每帧压一层 (无局部变量也压空层), 保证 hyg_depth==帧号 对应 */
              }
              jm_emit_orig(jm_macros[mi].body0, jm_macros[mi].body1); /* 整个体连续展开 — 内部游标自动越过嵌套调用 (逐 token 调用会把嵌套调用内部 token 重复处理) */
              hyg_depth = hyg_base;
            }
            jm_depth--;
            i = ce + 1;
        } 否 {
            jm_emit_hyg(i); i++;
        }
    }
}

静 空 tok_delete(整 pos) { /* #279: 删除一个 token, 后续前移; 末尾清 EK 防残留 */
    遍 (整 i = pos; i < ti - 1; i++) {
        tt[i] = tt[i + 1]; tv[i] = tv[i + 1];
        memmove(tn[i], tn[i + 1], 64);
        tline[i] = tline[i + 1]; tuns[i] = tuns[i + 1]; tll[i] = tll[i + 1]; tll_hi[i] = tll_hi[i + 1];
    }
    若 (ti - 1 >= 0) { tt[ti - 1] = EK; tn[ti - 1][0] = 0; }
    ti--;
}

静 空 ns_expand(空) { /* #279 名称空间/模块完整 (2026-09-01): 名称空间 名 { ... } 词元级展开
    — 块内顶层符号加前缀 名_, 名::符号 合并为 名_符号, 名称空间 名 { 和 } 删除 */
    整 i = 0;
    循环 (i < ti) {
        若 (tt[i] == VR && !strcmp(tn[i], "名称空间")) {
            若 (i + 2 < ti && tt[i + 1] == VR && tt[i + 2] == FK) {
                字 prefix[80]; sprintf(prefix, "%s_", tn[i + 1]);
                整 start = i + 2; 整 end = start; 整 depth = 0;
                循环 (end < ti) { 若 (tt[end] == FK) depth++; 否 若 (tt[end] == UK) { depth--; 若 (depth == 0) { end++; 断; } } end++; }
                若 (end > start + 1 && end <= ti) {
                    整 scan = start + 1;
                    循环 (scan < end - 1) {
                        /* 名::符号 合并 */
                        若 (tt[scan] == VR && scan + 3 < end - 1 && tt[scan + 1] == CL && tt[scan + 2] == CL && tt[scan + 3] == VR) {
                            字 n1[64], n2[64]; strcpy(n1, tn[scan]); strcpy(n2, tn[scan + 3]);
                            sprintf(tn[scan], "%s_%s", n1, n2);
                            tok_delete(scan + 1); tok_delete(scan + 1); tok_delete(scan + 1);
                            end -= 3;
                            scan += 1; 续;
                        }
                        /* 声明: VK [VK]* 名字 */
                        若 (tt[scan] == VK) {
                            整 np = scan + 1;
                            循环 (np < end - 1 && tt[np] == VK) np++;
                            若 (np < end - 1 && tt[np] == VR) {
                                整 aft = np + 1;
                                若 (aft < end - 1 && (tt[aft] == OK || tt[aft] == AK || tt[aft] == SK || tt[aft] == CK || tt[aft] == LB || tt[aft] == FK)) {
                                    字 old[64]; strcpy(old, tn[np]);
                                    若 (strncmp(old, prefix, strlen(prefix)) != 0) sprintf(tn[np], "%s%s", prefix, old);
                                    若 (tt[aft] == OK) { /* 函数: 参数内结构体/枚举标签加前缀, 跳参数列表+函数体 */
                                        整 ps = aft; 整 pd = 0;
                                        循环 (ps < end - 1) {
                                            若 (tt[ps] == OK) pd++;
                                            否 若 (tt[ps] == KK) { pd--; 若 (pd == 0) { ps++; 断; } }
                                            否 若 (pd == 1 && (tt[ps] == ST || tt[ps] == EN) && ps + 1 < end - 1 && tt[ps + 1] == VR) {
                                                字 old2[64]; strcpy(old2, tn[ps + 1]);
                                                若 (strncmp(old2, prefix, strlen(prefix)) != 0) sprintf(tn[ps + 1], "%s%s", prefix, old2);
                                                ps++;
                                            }
                                            ps++;
                                        }
                                        若 (ps < end - 1 && tt[ps] == FK) {
                                            整 bd = 0; 整 bs = ps;
                                            循环 (bs < end - 1) { 若 (tt[bs] == FK) bd++; 否 若 (tt[bs] == UK) { bd--; 若 (bd == 0) { bs++; 断; } } bs++; }
                                            scan = bs; 续;
                                        }
                                    }
                                }
                            }
                            scan = np; 续;
                        }
                        /* 结构/联合/枚举 标签 */
                        若 (tt[scan] == ST || tt[scan] == EN) {
                            整 np = scan + 1;
                            若 (np < end - 1 && tt[np] == VR) {
                                整 aft = np + 1;
                                若 (aft < end - 1 && (tt[aft] == FK || tt[aft] == SK || tt[aft] == CK || tt[aft] == VR)) {
                                    字 old[64]; strcpy(old, tn[np]);
                                    若 (strncmp(old, prefix, strlen(prefix)) != 0) sprintf(tn[np], "%s%s", prefix, old);
                                    若 (tt[aft] == FK && tt[scan] == ST) { /* 结构体定义体: 字段不改, 跳过 */
                                        整 bd = 0; 整 bs = aft;
                                        循环 (bs < end - 1) { 若 (tt[bs] == FK) bd++; 否 若 (tt[bs] == UK) { bd--; 若 (bd == 0) { bs++; 断; } } bs++; }
                                        scan = bs; 续;
                                    }
                                }
                            }
                            scan = np + 1; 续;
                        }
                        /* typedef 类型名 */
                        若 (tt[scan] == VR && !strcmp(tn[scan], "typedef")) {
                            整 np = scan + 1;
                            循环 (np < end - 1 && (tt[np] == VK || (tt[np] == VR && tdef_lookup(tn[np]) >= 0))) np++;
                            若 (np < end - 1 && tt[np] == VR) {
                                字 old[64]; strcpy(old, tn[np]);
                                若 (strncmp(old, prefix, strlen(prefix)) != 0) sprintf(tn[np], "%s%s", prefix, old);
                            }
                            scan = np; 续;
                        }
                        scan++;
                    }
                }
                /* 删除 名称空间 名 { 三个 token */
                tok_delete(i); tok_delete(i); tok_delete(i);
                /* 删除 } (原 end-1, 删 3 后 = end-4) */
                若 (end - 4 >= 0 && end - 4 < ti && tt[end - 4] == UK) tok_delete(end - 4);
                i = end - 4; 续;
            }
        }
        /* 全局 名::符号 合并 (块外引用) */
        若 (tt[i] == VR && i + 3 < ti && tt[i + 1] == CL && tt[i + 2] == CL && tt[i + 3] == VR) {
            字 n1[64], n2[64]; strcpy(n1, tn[i]); strcpy(n2, tn[i + 3]);
            sprintf(tn[i], "%s_%s", n1, n2);
            tok_delete(i + 1); tok_delete(i + 1); tok_delete(i + 1);
            续;
        }
        i++;
    }
}

静 空 jiayan_macro_expand(空) {
    整 i = 0;
    jm_n = 0;
    循环 (i < ti) {
        若 (tt[i] == VR && !strcmp(tn[i], "宏") && i + 2 < ti && tt[i + 1] == VR && tt[i + 2] == OK) {
            整 pend = i + 2; 整 pd = 0; 整 pend_i = -1;
            循环 (pend < ti) { 若 (tt[pend] == OK) pd++; 否 若 (tt[pend] == KK) { pd--; 若 (pd == 0) { pend_i = pend; 断; } } pend++; }
            若 (pend_i > 0 && jm_n < 512) {
                整 mn = jm_n;
                strcpy(jm_macros[mn].name, tn[i + 1]);
                jm_macros[mn].pn = 0;
                { 整 qd = 0; 遍 (整 q = i + 2; q < pend_i; q++) { 若 (tt[q] == OK) qd++; 否 若 (tt[q] == KK) qd--; 否 若 (tt[q] == VR && qd == 1 && jm_macros[mn].pn < 16) { jm_macros[mn].ppos[jm_macros[mn].pn] = q; jm_macros[mn].pn = jm_macros[mn].pn + 1; } } }
                整 b0 = -1; 整 b1 = -1; 整 decl_end = pend_i + 1;
                若 (pend_i + 1 < ti && tt[pend_i + 1] == AK) { /* = expr ; */
                    b0 = pend_i + 2; 整 d = 0; 整 j = pend_i + 2;
                    循环 (j < ti) { 若 (tt[j] == OK || tt[j] == FK || tt[j] == LB) d++; 否 若 (tt[j] == KK || tt[j] == UK || tt[j] == RB) { 若 (d > 0) d--; } 否 若 (tt[j] == SK && d == 0) { b1 = j; decl_end = j + 1; 断; } j++; }
                } 否 若 (pend_i + 1 < ti && tt[pend_i + 1] == FK) { /* { ... } */
                    b0 = pend_i + 1; 整 d = 0; 整 j = pend_i + 1;
                    循环 (j < ti) { 若 (tt[j] == FK) d++; 否 若 (tt[j] == UK) { d--; 若 (d == 0) { b1 = j + 1; decl_end = j + 1; 断; } } j++; }
                }
                若 (b0 >= 0 && b1 >= b0) {
                    jm_macros[mn].body0 = b0; jm_macros[mn].body1 = b1;
                    jm_decl0[mn] = i; jm_decl1[mn] = decl_end;
                    jm_n++;
                    i = decl_end; 续;
                }
            }
        }
        i++;
    }
    若 (jm_n == 0) 返;
    jm_tt2 = calloc(TS, 4); jm_tv2 = calloc(TS, 4); jm_tline2 = calloc(TS, 4);
    jm_tuns2 = calloc(TS, 4); jm_tll2 = calloc(TS, 4); jm_tll_hi2 = calloc(TS, 4);
    jm_tn2 = calloc(TS, 64);
    若 (!jm_tt2 || !jm_tv2 || !jm_tline2 || !jm_tuns2 || !jm_tll2 || !jm_tll_hi2 || !jm_tn2) { fprintf(stderr, "[ERR] 宏展开内存不足\n"); exit(1); }
    jm_out = 0; jm_depth = 0;
    jm_emit_orig(0, ti);
    free(tt); free(tv); free(tn); free(tline); free(tuns); free(tll); free(tll_hi);
    tt = jm_tt2; tv = jm_tv2; tn = jm_tn2; tline = jm_tline2; tuns = jm_tuns2; tll = jm_tll2; tll_hi = jm_tll_hi2;
    ti = jm_out;
}
/* fix 2026-08-30 探雷报告 雷1: 括号配对验证 — token 级统一扫 (lex+宏展开后, parser 前),
   任何不平衡立即报错 (带行号), 不再静默吞残缺语法 (原 blk() EK 静默退出 + 顶层孤立 } 忽略).
   C 括号严格嵌套, 纯栈式匹配即正确; 字符串/字符/注释已由 lex 处理为单 token, 不干扰. */
静 整 paren_balance_check(空) {
    整 stk[8192]; 整 stk_ln[8192]; 整 sp = 0;
    遍 (整 i = 0; i < TS && tt[i] != EK; i++) {
        整 t = tt[i];
        若 (t == OK || t == LB || t == FK) {
            若 (sp >= 8192) { fprintf(stderr, "[ERR] 括号嵌套过深 行 %d (paren_balance)\n", tline[i]); 返 -1; }
            stk[sp] = t; stk_ln[sp] = tline[i]; sp++;
        } 否 若 (t == KK || t == RB || t == UK) {
            若 (sp <= 0) { fprintf(stderr, "[ERR] 多余右括号 '%c' 行 %d (paren_balance)\n", t == KK ? ')' : (t == RB) ? ']' : '}', tline[i]); 返 -1; }
            整 want = (t == KK) ? OK : (t == RB) ? LB : FK;
            若 (stk[sp - 1] != want) {
                字 o = (stk[sp - 1] == OK) ? '(' : (stk[sp - 1] == LB) ? '[' : '{';
                字 c = (t == KK) ? ')' : (t == RB) ? ']' : '}';
                fprintf(stderr, "[ERR] 括号不匹配 '%c' vs '%c' (开 行 %d, 闭 行 %d) (paren_balance)\n", o, c, stk_ln[sp - 1], tline[i]);
                返 -1;
            }
            sp--;
        }
    }
    若 (sp > 0) {
        fprintf(stderr, "[ERR] 缺右括号: %d 个未闭合 (首个开括号 '%c' 行 %d) (paren_balance)\n", sp, (stk[0] == OK) ? '(' : (stk[0] == LB) ? '[' : '{', stk_ln[0]);
        返 -1;
    }
    返 0;
}

静 整 parse(常 字 *s) {
    tk = 0; nc = 1; vcnt = 0; rsp_used = 32; /* reserve shadow space */
    遍 (整 _vi = 0; _vi < 16384; _vi++) { vars[_vi].alignN = 0; vars[_vi].align_base = 0; vars[_vi].vla_dim = 0; } /* fix step30/31: 静态 vars 数组跨编译残留清零 — 对齐间接/VLA 标记必须每编译重置 */
    fdef_n = 0; /* fix 2026-08-06: 每次 parse 重置顶层函数列表 */
    memset(ndbl, 0, 大小(ndbl)); /* per-node double flags must not leak across compiles */
    memset(nuns, 0, 大小(nuns)); /* per-node unsigned flags (fix 2026-08-05) */
    memset(nll, 0, 大小(nll)); /* fix 2026-08-31 csmith s61: nll 数组从未清零 - 跨编译残留 */
    memset(cast32, 0, 大小(cast32)); /* fix 2026-08-31 csmith s61: cast32 表清零 */
    fvn = 0; /* reset per-function var-range table */
    pm_n = 0; /* 过程宏注册表每编译重置 (嵌入模式多文件编译防残留) */
    memset(tt, 0, TS * 4);
    字 *exp_src = pp_include_expand(s, 0); /* #include 预展开（fix 2026-08-06） */
    
     
    fn_macro_collect(exp_src); /* fix 2026-08-07: 移到 include 展开之后 — 头文件里的函数宏才能被收集展开 */
     
    obj_macro_collect(exp_src); /* fix 2026-08-13: 对象宏收集 (lex 前, Git hash-ll.h) */
    generic_prepass(exp_src); /* 泛型定义预扫描 (接入 2026-08-28 #96): 无条件执行, 注册 泛型 fn_macro (lex 前, 展开调用) */
     
    若 (fn_macro_n > 0) {
        字 *msrc = fn_macro_expand(exp_src);
         
        若 (msrc && msrc[0]) { free(exp_src); exp_src = msrc; }
    }
    若 (obj_macro_n > 0) { /* fix 2026-08-13: 对象宏文本层展开 (lex 前) */
         
        字 *osrc = obj_macro_expand(exp_src);
        若 (osrc && osrc[0]) { free(exp_src); exp_src = osrc; }
    }
    若 (fn_macro_n > 0) { /* fix 2026-08-15: 对象宏值里嵌套的函数宏需第二遍展开 (STRMAP_INIT → HASHMAP_INIT) — 否则 jyld undefined symbol */
        字 *msrc2 = fn_macro_expand(exp_src);
        若 (msrc2 && msrc2[0]) { free(exp_src); exp_src = msrc2; }
    }
    pp_guard_n = 0; /* fix 2026-08-13 Phase3: lex 阶段 #if defined(X) 走 macro 表(lex 自己的 #define); 清 pp_guard 防 fn_macro_collect 污染 → #if !defined(XTYPES_H) 被误判已定义跳过 xtypes.h typedef */
    
     
lex(exp_src);
    若 (g_rt_len > 0) { rt_exp_lines = 1; 遍 (整 _re = 0; _re < g_rt_len && _re < (整)strlen(exp_src); _re++) 若 (exp_src[_re] == '\n') rt_exp_lines++; } /* 2026-08-28 loc.line: exp_src 中 rt 部分实际行数 (展开后, 比 rt_line_skip 准) */
    ns_expand(); /* #279 名称空间 (2026-09-01) */
    jiayan_macro_expand(); /* 宏系统 (2026-08-28 type-root-12 #167): lex 后 parse 前 token 级展开 — 宏 名(参数) = expr; 或 宏 名(参数) { 语句 } */

    { 字 _cl[96]; sprintf(_cl, "{\"cp\":\"lex\",\"tokens\":%d}", ti); cp_line(_cl); } /* 编译检查点 (2026-08-28 AI原生 #6): lex 完成快照 */
    dag_hash_tokens(); /* 编译 DAG (可吞清单 P0-9): token 流阶段哈希 (tt/tv/tn/tline 入链) */

    
    free(exp_src);
    若 (ti >= TS) { fprintf(stderr, "[ERR] token overflow\n"); 返 -1; }
