否 若 (bsz == 2) { 若 (st_field_is_uns(stypes[s].name, fn)) { asm_emit("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xB7); modrm(0, 0, 0); } 否 { asm_emit("    符号扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x0F); b(0xBF); modrm(0, 0, 0); } } /* big-param short (fix 2026-08-30 csmith s172: int16_t 字段 movsx — 原恒 movzx) */
