                            否 若 (tt[tk] == UK || tt[tk] == KK || tt[tk] == RB) { depth--; 若 (tt[tk] == RB && in_des) in_des = 0; }
                            否 若 (tt[tk] == CK && depth == 0) { n++; prev_comma = 1; }
