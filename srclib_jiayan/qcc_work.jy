    asm_emit("    左移 r0, 3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 0); b(0xC1); modrm(3, 4, 0); b(3);    /* shl eax, 3 -> W*8 */
    asm_emit("    左移 r2, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 0); b(0xC1); modrm(3, 4, 2); b(1);    /* shl edx, 1 -> W*2 */
