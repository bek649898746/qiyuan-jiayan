                    整 gpr;
                    若 (k == 0) gpr = 1; 否 若 (k == 1) gpr = 2; 否 若 (k == 2) gpr = 8; 否 gpr = 9;
                    若 (fn_dbl_get(fname, k)) { ir_emit(I_LOAD_XMM_RSP, k, argbase + total_h - slot_h[k] - 8, 0); }
                    否 { ir_emit(I_LOAD_RSP_GPR, gpr, argbase + total_h - slot_h[k] - 8, 0); }
                    ir_flush();
                }
            } 否 若 (fnptr) {
                /* fnptr call: position k loads xmm[k] for double args (ndbl), GPR[k] for int.
                   slot_h[] is indexed by ARGUMENT position (the callee is skipped in both
                   the push loop and here), so walk kids skipping fn to find each arg node. */
                整 ak = 0;
                遍 (整 i = 0; i < 20 && ak < 4; i++) {
                    整 c = kids[i];
                    若 (c == fn || c < 0) 续;
                    整 gpr;
                    若 (ak == 0) gpr = 1; 否 若 (ak == 1) gpr = 2; 否 若 (ak == 2) gpr = 8; 否 gpr = 9;
                    若 (ndbl[c]) movsd_xmmreg_mrsp64(ak, argbase + total_h - slot_h[ak] - 8);
                    否 { mov_reg_mrsp64(0, argbase + total_h - slot_h[ak] - 8); mov_rr64(gpr, 0); }
                    ak++;
                }
            } 否 {
            /* builtin (printf/memcpy/...): fmt/int args load rcx/rdx/r8/r9; doubles read the pushed slots via r13 */
            若 (nargs >= 1) { mov_reg_mrsp64(0, argbase + total_h - slot_h[0] - 8); mov_rr64(1, 0); }
            若 (nargs >= 2) { mov_reg_mrsp64(0, argbase + total_h - slot_h[1] - 8); mov_rr64(2, 0); }
            若 (nargs >= 3) { mov_reg_mrsp64(0, argbase + total_h - slot_h[2] - 8); mov_rr64(8, 0); }
            若 (nargs >= 4) { mov_reg_mrsp64(0, argbase + total_h - slot_h[3] - 8); mov_rr64(9, 0); }
            }
            /* real ABI: arg5 at [rsp+32]. USER CALLS ONLY: builtins/fnptr read the pushed
               slots directly (emit_print via r13), and [rsp+32..] overlaps the pushed
               arg1/arg2/arg3 slots �?relocating would destroy e.g. a 5+-arg fprintf's fmt. */
            若 (is_user && !fnptr) 遍 (整 k = 4; k < nargs; k++) {
                若 (fi >= 0 && fn_dbl_get(fname, k)) {
                    movsd_xmmreg_mrsp64(0, argbase + total_h - slot_h[k] - 8);
                    movsd_mrsp64_xmmreg(32 + 8 * (k - 4), 0); /* arg5+ at call-rsp+32 (Win64 shadow 32B; 被调者读 [rbp+0x38+8*(k-5)] 因 rbp=call_rsp-24) */
                } 否 { mov_reg_mrsp64(0, argbase + total_h - slot_h[k] - 8); mov_mrsp_reg64(32 + 8 * (k - 4), 0); }
            }

            若 (is_sret) {
                graph_record_call(func_tbl[fi].name); /* -graph 旁路: 调用关系记录 */
                    ir_emit(I_CALL_LBL, func_tbl[fi].label, argbase + total_h, 0); ir_flush(); /* Phase3-IR */
            } 否 若 (fnptr) { /* fnptr 优先于 is_user (fix 2026-08-15: write_block undefined) */
                /* function pointer indirect call: params already in rcx/rdx/r8/r9 */
                整 fp_extra = nargs > 4 ? nargs - 4 : 0;
                若 (fp_extra > 0) ir_emit(I_SUB_RSP_IMM, 32 + 8 * fp_extra + shadow_pad, 0, 0); 否 ir_emit(I_SUB_RSP_IMM, 32 + shadow_pad, 0, 0); ir_flush(); /* Phase3-IR */
                /* relocate 5th+ args to their real ABI slots ([rsp+32+8k]): they were pushed
                   at [rsp+0..], now shifted down by the shadow sub */
                遍 (整 k = 4; k < nargs; k++) {
                    mov_reg_mrsp64(0, 32 + 8 * fp_extra + shadow_pad + 8 * (nargs - 1 - k)); /* fix 2026-08-07: +pad */
                    mov_mrsp_reg64(32 + 8 * (k - 4), 0);
                }
                cg(fn); /* fp value �?eax */
                ir_emit(I_CALL_FNPTR, 32 + 8 * fp_extra + shadow_pad + total_h, 0, 0); ir_flush(); /* Phase3-IR */
                /* Phase3-IR: mov r10,rax; call r10; add_rsp 由 I_CALL_FNPTR 落码 */
                /* (原三行删除) */
            } 否 若 (is_user && fi >= 0) {
                graph_record_call(func_tbl[fi].name); /* -graph 旁路: 调用关系记录 */
                    ir_emit(I_CALL_LBL, func_tbl[fi].label, argbase + total_h, 0); ir_flush(); /* Phase3-IR */
            } 否 若 (!strcmp(fname, "memset")) {
                /* dst=rcx, val=rdx, n=r8d */
                mov_rr(10, 8); /* r10d = n */
                mov_rr(9, 2); /* r9 = rdx = val */
                mov_rr(8, 1); /* r8 = rcx = dst */
                整 ls2 = new_label(), ld2 = new_label();
                set_label(ls2);
                test_rr(10, 10); jz_rel(-1); patch_label(cp-4, ld2, 1);
                asm_emit("    写字节 [r8], r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,1,0,1);b(0x88);modrm(0,1,0); /* MOV [r8], r9b */
                asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,0); /* inc r8 */
                asm_emit("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,1,2); /* dec r10 */
                jmp_rel(-1); patch_label(cp-4, ls2, 2);
                set_label(ld2);
                mov_rr(0, 1); /* eax = orig dst */
            } 否 若 (!strcmp(fname, "memcpy")) {
                /* dst=rcx(1), src=rdx(2), n=r8d(8) */
                mov_rr(10, 8); /* r10d = n */
                mov_rr(9, 2);  /* r9 = src */
                mov_rr(8, 1);  /* r8 = dst */
                /* copy 1 byte */
                整 ls = new_label(), ld = new_label();
                set_label(ls);
                test_rr(10, 10); jz_rel(-1); patch_label(cp-4, ld, 1);
                asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0x8A);modrm(0,0,1); /* mov al, [r9] */
                asm_emit("    写字节 [r8], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0x88);modrm(0,0,0); /* mov [r8], al */
                asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,0); /* inc r8 */
                asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,1); /* inc r9 */
                asm_emit("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,1,2); /* dec r10 */
                jmp_rel(-1); patch_label(cp-4, ls, 2);
                set_label(ld);
                mov_rr(0, 1); /* eax = rcx = original dst */
            } 否 若 (!strcmp(fname, "strcmp")) {
                /* a=rcx, b=rdx */
                mov_rr(8, 1); /* r8 = a */
                mov_rr(9, 2); /* r9 = b */
                整 lss = new_label(), lds = new_label(), lzs = new_label(), leq = new_label();
                set_label(lss);
                asm_emit("    读字节 r0, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0x8A);modrm(0,0,0); /* mov al, [r8] */
                asm_emit("    读字节 r2, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0x8A);modrm(0,2,1); /* mov dl, [r9] (use r10b?) */
                /* cmp al, dl */
                asm_emit("    比较字节 al, dl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x38);modrm(3,2,0); /* cmp al, dl */
                jz_rel(-1); patch_label(cp-4, lzs, 1);
                /* differ: movzx eax, al; movzx edx, dl; sub */
                asm_emit("    零扩展空 eax, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,0);b(0x0F);b(0xB6);b(0xC0); /* movzx eax, al */
                asm_emit("    零扩展空 edx, dl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,0);b(0x0F);b(0xB6);b(0xD2); /* movzx edx, dl */
                asm_emit("    减无 r0, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x29);modrm(3,2,0); /* sub eax, edx */
                jmp_rel(-1); patch_label(cp-4, lds, 2);
                set_label(lzs);
                asm_emit("    测试al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x84); b(0xC0); /* test al, al */
                jz_rel(-1); patch_label(cp-4, leq, 1); /* null terminator �?equal */
                asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,0); /* inc r8 */
                asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,1); /* inc r9 */
                jmp_rel(-1); patch_label(cp-4, lss, 2);
                set_label(leq);
                mov_r_imm(0, 0); /* equal �?return 0 */
                set_label(lds);
            } 否 若 (!strcmp(fname, "calloc")) {
                若 (coff_mode) {
                    coff_mov_eax_counter();        /* mov eax, [rip+counter] */
                    mov_rr(11, 0); /* r11d = old counter (对齐) */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7); /* add r11d, 7 */
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8); /* and r11d, 0xFFFFFFF8 — bump allocator 8 字节对齐 (fix 2026-08-22 t44: 原 counter 不对齐 → xdl_malloc recs 数组未对齐 → xrecord_t* 未对齐读 → rec=0 → commit 摘要 diff SEGV) */
                    mov_rr(8, 11); /* r8d = 对齐起始 (return) */
                    mov_rr(10, 1); /* r10d = n */
                    asm_emit("    乘 r10, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,2,0,0); b(0x0F); b(0xAF); modrm(3,2,2); /* IMUL r10d, edx */
                    asm_emit("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,1,0,1); b(0x01); modrm(3,2,3); /* ADD r11d, r10d (REX.R=1: reg=r10) */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(0, 11); /* eax = 新 counter */
                    coff_mov_counter_eax();       /* store back */
                    /* fix 2026-08-20: calloc 必须清零 (C 语义) — bump allocator 原不清 →
                       git xcalloc 返回 .data 区垃圾 (attr_stack +24=0x72657355 "User") → attr 解析崩溃 */
                    mov_r_imm(0, 0); /* eax = 0 */
                    mov_rr(11, 8);   /* r11 = 返回地址 */
                    { 整 lzc = new_label(), lzd = new_label();
                    set_label(lzc);
                    test_rr(10, 10); jz_rel(-1); patch_label(cp - 4, lzd, 1);
                    rex(0, 0, 0, 1); b(0x88); modrm(0, 0, 3); /* mov [r11], al — REX.B(r11=rbx) */
                    rex(0, 0, 0, 1); b(0xFF); modrm(3, 0, 3); /* inc r11d */
                    rex(0, 0, 0, 1); b(0xFF); modrm(3, 1, 2); /* dec r10d — REX.B(r10=rdx), reg=1(/1=dec) */
                    jmp_rel(-1); patch_label(cp - 4, lzc, 2);
                    set_label(lzd);
                    mov_rr(0, 8); } /* 清零循环用 eax 存 0 覆盖了返回地址 — 恢复 r8 到 rax (fix 2026-08-20) */
                } 否 {
                    /* RIP-relative: load counter from .data section (RVA data_rva_base).
                       Mnemonic emitters for complete -S output (fix 2026-08-03). */
                    整 rel_load = data_rva_base - 0x1000 - cp - 6;
                    mov_eax_rip(rel_load);        /* mov eax, [rip+rel] */
                    mov_rr(11, 0); /* r11d = old counter (对齐) */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(8, 11); /* r8d = 对齐起始 (header) — fix 2026-08-22 t45: 原 mov_rr(8,0) 取 counter 原值 + mov_rr(11,8) 覆盖对齐 → header 未对齐 → 自举产物分配错 → git init 路径损坏 */
                    mov_rr(11, 8); /* r11d = header */
                    asm_emit("    加 r11, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(8); /* 数据区 (fix 2026-08-22 t45: single-file calloc header 同 coff) */
                    /* compute n*size: n=rcx, size=rdx */
                    mov_rr(10, 1); /* r10d = n */
                    /* IMUL r10d, edx */
                    asm_emit("    乘 r10, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,2,0,0); b(0x0F); b(0xAF); modrm(3,2,2); /* IMUL r10d, edx */
                    asm_emit("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,1,0,1); b(0x01); modrm(3,2,3); /* ADD r11d, r10d */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(0, 11); /* eax = 新 counter */
                    整 rel_store = data_rva_base - 0x1000 - cp - 6;
                    mov_rip_eax(rel_store);       /* mov [rip+rel], eax */
                    asm_emit("    存32 [r8], r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,0,0,1); b(0x89); modrm(0,2,0); /* mov [r8], r10d — header = n*size */
                    /* 清零数据区 (fix 2026-08-22 t45: single-file calloc 也清零+header) */
                    mov_r_imm(0, 0); /* eax = 0 */
                    mov_rr(11, 8);   /* r11 = header */
                    asm_emit("    加 r11, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(8);
                    { 整 lzc = new_label(), lzd = new_label();
                    set_label(lzc);
                    test_rr(10, 10); jz_rel(-1); patch_label(cp - 4, lzd, 1);
                    rex(0, 0, 0, 1); b(0x88); modrm(0, 0, 3); /* mov [r11], al */
                    rex(0, 0, 0, 1); b(0xFF); modrm(3, 0, 3); /* inc r11d */
                    rex(0, 0, 0, 1); b(0xFF); modrm(3, 1, 2); /* dec r10d */
                    jmp_rel(-1); patch_label(cp - 4, lzc, 2);
                    set_label(lzd); }
                    mov_rr(0, 8);                 /* return header */
                    asm_emit("    加 r0, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x83); modrm(3,0,0); b(8); /* 数据区 */
                }
            } 否 若 (!strcmp(fname, "malloc")) {
                若 (coff_mode) {
                    coff_mov_eax_counter();          /* mov eax, [rip+counter] */
                    mov_rr(11, 0);                /* r11d = old counter (对齐) */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7); /* add r11d, 7 */
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8); /* and r11d, 0xFFFFFFF8 — 8 字节对齐 (fix 2026-08-22 t44 同 calloc) */
                    mov_rr(8, 11);                /* r8d = 对齐起始 (return value) */
                    mov_rr(10, 1);                /* r10d = n (rcx) */
                    asm_emit("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,1,0,1); b(0x01); modrm(3,2,3); /* ADD r11d, r10d (REX.R=1: reg=r10) */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(0, 11);
                    coff_mov_counter_eax();          /* store back */
                    mov_rr(0, 8);                 /* return 对齐起始 */
                } 否 {
                    /* bump allocator (same .data counter as calloc), n in rcx.
                       Rewritten with mnemonic emitters so -S output is complete
                       (fix 2026-08-03: bare-byte RIP loads had no ASM text,
                       breaking H1==H2 on the 3-stage path). */
                    整 rel_m1 = data_rva_base - 0x1000 - cp - 6;
                    mov_eax_rip(rel_m1);          /* mov eax, [rip+counter] */
                    mov_rr(11, 0);                /* r11d = old counter (对齐) */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(8, 11);                /* r8d = 对齐起始 (header) */
                    asm_emit("    加 r11, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(8); /* 数据区 (fix 2026-08-22 t45: single-file 同 coff header) */
                    mov_rr(10, 1);                /* r10d = n (rcx) */
                    asm_emit("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,1,0,1); b(0x01); modrm(3,2,3); /* ADD r11d, r10d */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(0, 11);                /* eax = 新 counter */
                    整 rel_m2 = data_rva_base - 0x1000 - cp - 6;
                    mov_rip_eax(rel_m2);          /* store back */
                    asm_emit("    存32 [r8], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x89); modrm(0,1,0); /* mov [r8], ecx — header = n */
                    mov_rr(0, 8);                 /* return header */
