            整 ce = prim(); /* cast operand is a UNARY expr — prim() not expr(): (long long)1<<32 must shift the 64-bit cast, not parse as (long long)(1<<32) (fix 2026-08-05) */
            /* (int) on a double expr: real truncation via node 19 (cg: cvttsd2si).
               expr_is_double covers double-returning CALLS whose ndbl is set only at
               codegen (root-cause 2026-08-03: ndbl[ce] alone missed them → no-op cast). */
            若 (cast_ty && !strcmp(cast_ty, "int") && (ndbl[ce] || expr_is_double(ce))) { 整 m = Nd(19); Nc(m, ce); ndbl[m] = 0; 返 m; }
            若 (cast_ty && !strcmp(cast_ty, "long") && ce >= 0) nll[ce] = 1; /* (long long)x -> 64-bit operand (fix 2026-08-05) */
            /* 后缀链: (cast)->field / (cast)[i] / (cast)(args) (fix 2026-08-06: 原直接 return, ((T*)0)->i 的 ->i 悬空 → offsetof 惯用法 &((T*)0)->m = 0) */
            循环 (1) {
                若 (tt[tk] == LB) {
                    tk++; 整 m = Nd(14); Nc(m, ce); Nc(m, expr()); 若 (tt[tk] == RB) tk++; ce = m;
                } 否 若 (tt[tk] == DT || tt[tk] == AR) {
                    整 ar = (tt[tk] == AR); tk++;
                    若 (tt[tk] == VR) { 整 m = Nd(15); Nc(m, ce); nv[m] = ar; memcpy((字*)(nn + m), tn[tk], 64); tk++; ce = m; } 否 断;
                } 否 若 (tt[tk] == OK) { tk++; 整 c = Nd(4); 循环 (tt[tk] != KK && tt[tk] != EK) { 整 t0 = tk; 若 (tt[tk] == CK) tk++; Nc(c, expr()); 若 (tk == t0) 断; } 若 (tt[tk] == KK) tk++; Nc(c, ce); ce = c; }
                否 若 (tt[tk] == PP || tt[tk] == MM) { /* fix 2026-08-08: (cast)++ 后缀同样补齐 */
                    整 is_dec = (tt[tk] == MM); tk++;
                    整 m = Nd(23); nv[m] = is_dec;
                    Nc(m, ce); ce = m;
                }
                否 断;
            }
            若 (cast_nstar >= 1) { /* fix 2026-08-08 width bug: (T*) cast no-op drops type info, *((T*)x) width by target element size */
                整 cpe = 0;
                若 (cast_nstar >= 2) cpe = 8; /* T** -> pointer */
                否 若 (cast_ty && (!strcmp(cast_ty, "char") || !strcmp(cast_ty, "_Bool"))) cpe = 1;
                否 若 (cast_ty && !strcmp(cast_ty, "short")) cpe = 2;
                否 若 (cast_ty && !strcmp(cast_ty, "unsigned")) { cpe = 4; 若 (cast_ty2 && (!strcmp(cast_ty2, "char") || !strcmp(cast_ty2, "_Bool"))) cpe = 1; 否 若 (cast_ty2 && !strcmp(cast_ty2, "short")) cpe = 2; 否 若 (cast_ty2 && !strcmp(cast_ty2, "long")) cpe = 8; }
                否 若 (cast_ty && !strcmp(cast_ty, "int")) cpe = 4;
                否 若 (cast_ty && !strcmp(cast_ty, "long")) cpe = 8;
                否 若 (cast_ty && !strcmp(cast_ty, "double")) cpe = 8;
                若 (cpe) pesz[ce] = cpe; /* struct/typedef/void ptr: cpe=0 -> keep old behavior */
            }
            返 ce; /* cast is no-op: value unchanged */
        }
        tk++; 整 n = expr();
        /* comma operator inside parens: (a, b, c) �?needed for (i++, PP) in the
           lexer's switch ternaries. NOT added to expr() itself: function args
           (f(a, b)) must stay separate (the call parser consumes the CK). */
        循环 (tt[tk] == CK) { tk++; 整 a = Nd(2); nv[a] = CK; Nc(a, n); Nc(a, expr()); n = a; }
        tk++;
        /* 后缀链: (expr)->field / (expr)[i] / (expr)(args) (fix 2026-08-06: 原只处理 (expr)(args), ((T*)0)->i 的 ->i 悬空 → offsetof 惯用法 &((T*)0)->m 错) */
        循环 (1) {
            若 (tt[tk] == LB) { tk++; 整 m = Nd(14); Nc(m, n); Nc(m, expr()); 若 (tt[tk] == RB) tk++; n = m; }
            否 若 (tt[tk] == DT || tt[tk] == AR) {
                整 ar = (tt[tk] == AR); tk++;
                若 (tt[tk] == VR) { 整 m = Nd(15); Nc(m, n); nv[m] = ar; memcpy((字*)(nn + m), tn[tk], 64); tk++; n = m; } 否 断;
            } 否 若 (tt[tk] == OK) { 整 callee = n; tk++; 整 c = Nd(4); 循环 (tt[tk] != KK && tt[tk] != EK) { 整 t0 = tk; 若 (tt[tk] == CK) tk++; Nc(c, expr()); 若 (tk == t0) 断; } 若 (tt[tk] == KK) tk++; Nc(c, n); n = c;
                若 (nt[callee] == 1 && fn_dbl_get_ret((字*)(nn + callee))) ndbl[c] = 1; /* fix 2026-08-06: double 返回调用 parse 时标记 (镜像 2737) */
            } 否 若 (tt[tk] == PP || tt[tk] == MM) { /* fix 2026-08-08: (expr)++ 后缀被吞 → fn_macro `out[(*o)++]` 的 *o 不推进 (展开为空). 与变量后缀链一致 */
                整 is_dec = (tt[tk] == MM); tk++;
                整 m = Nd(23); nv[m] = is_dec;
                Nc(m, n); n = m;
            }
            否 断;
        }
        返 n;
    }
    若 (tt[tk] == PT) { tk++; 整 n = Nd(11); Nc(n, prim()); 返 n; }
    若 (tt[tk] == DK) { tk++; 整 n = Nd(12); Nc(n, prim());
        整 dop = n0[n]; 若 (dop >= 0 && nt[dop] == 1 && var_pdbl((字*)(nn + dop))) ndbl[n] = 1; /* *double-p → xmm0 */
        返 n; }
    若 (tt[tk] == NT) { tk++; 整 n = Nd(17); Nc(n, prim()); 返 n; }
    若 (tt[tk] == BN) { tk++; 整 n = Nd(18); Nc(n, prim()); 返 n; } /* ~expr */
    若 (tt[tk] == MK) { /* unary minus: -expr */
        tk++;
        /* -double-literal: flip the IEEE sign bit at PARSE time (keeps -0.0 as a
           real negative zero; a runtime 0.0 - x would round -0.0 to +0.0) */
        若 (tt[tk] == FP) {
            整 idx = tv[tk];
            若 (dbl_n < 1024) { dbl_hi[dbl_n] = dbl_hi[idx]; dbl_lo[dbl_n] = dbl_lo[idx]; dbl_hi[dbl_n] ^= 0x80000000; } /* fix 2026-08-07: 512→1024 对齐镜像 (dbl_n∈[512,1024) 时原静默不写却 dbl_n++ → 垃圾 double) */
            若 (dbl_n >= 1024) { fprintf(stderr, "[ERR] double 字面量表满 (fix 2026-08-06 M3)\n"); exit(1); }
            整 n = Nd(FP); nv[n] = dbl_n; ndbl[n] = 1; dbl_n++; tk++; /* -double-literal: must be marked ndbl (fix 2026-08-06) */
            返 n;
        }
        整 n = Nd(2); nv[n] = MK; Nc(n, Nd(0)); nv[n0[n]] = 0; Nc(n, prim()); 返 n;
    }
    若 (tt[tk] == STR) { 整 n = Nd(0); nv[n] = tv[tk]; /* str index → treated as immediate for codegen */ nt[n] = STR; tk++;
        循环 (tt[tk] == LB) { /* 字符串字面量下标 "abc"[i] (fix 2026-08-06: 原 STR 分支无 suffix chain → 实参 `f("A"[0])` 解析卡在 `[` 死循环; 赋值场景留下未消费的 `[` 生成垃圾值) */
            tk++; /* [ */
            整 m = Nd(14); Nc(m, n); Nc(m, expr()); 若 (tt[tk] == RB) tk++; /* ] */
            n = m;
        }
        返 n; }
    返 -1;
}

静 整 mul(空) { 整 n = prim(); 循环 (tt[tk] == DK || tt[tk] == DV || tt[tk] == MD || tt[tk] == SH || tt[tk] == SR) { 整 o = tt[tk++]; 整 a = Nd(2); nv[a] = o; 整 r = prim(); Nc(a, n); Nc(a, r); 若 ((o == DK || o == DV) && (ndbl[n] || ndbl[r])) ndbl[a] = 1; n = a; } 返 n; }
静 整 add(空) { 整 n = mul(); 循环 (tt[tk] == PK || tt[tk] == MK || tt[tk] == PT || tt[tk] == OR || tt[tk] == XR) { 整 o = tt[tk++]; 整 a = Nd(2); nv[a] = o; 整 r = mul(); Nc(a, n); Nc(a, r); 若 ((o == PK || o == MK) && (ndbl[n] || ndbl[r])) ndbl[a] = 1; n = a; } 返 n; }
静 整 cmp(空) { 整 n = add(); 循环 (tt[tk] == LK || tt[tk] == GK || tt[tk] == QK || tt[tk] == XK || tt[tk] == HK || tt[tk] == YK) { 整 o = tt[tk++]; 整 a = Nd(2); nv[a] = o; Nc(a, n); Nc(a, add()); n = a; } 返 n; }
静 整 land(空) { 整 n = cmp(); 循环 (tt[tk] == LA) { tk++; 整 a = Nd(2); nv[a] = LA; Nc(a, n); Nc(a, cmp()); n = a; } 返 n; }
静 整 lor(空) { 整 n = land(); 循环 (tt[tk] == LO) { tk++; 整 a = Nd(2); nv[a] = LO; Nc(a, n); Nc(a, land()); n = a; } 返 n; }
静 整 tern(空) { 整 n = lor(); 若 (tt[tk] == QU) { tk++; 整 t = lor(); 若 (tt[tk] == CL) tk++; 整 f = tern(); 整 a = Nd(22); Nc(a, n); Nc(a, t); Nc(a, f); 返 a; } 返 n; }
静 整 asgn(空) { 整 n = tern(); 若 (tt[tk] == AK) { tk++; 整 a = Nd(10); Nc(a, n); Nc(a, asgn()); 返 a; }
    若 (tt[tk] == PA || tt[tk] == MA || tt[tk] == DA || tt[tk] == SA || tt[tk] == OA || tt[tk] == AA || tt[tk] == XA || tt[tk] == SHR || tt[tk] == SHL || tt[tk] == MS) {
        整 o = tt[tk++];
        整 op = (o == PA) ? PK : (o == MA) ? MK : (o == DA) ? DK : (o == SA) ? DV : (o == OA) ? OR : (o == AA) ? AN : (o == XA) ? XR : (o == SHR) ? SR : (o == MS) ? MD : SH; /* fix 2026-08-05: MS=%= → MD (remainder); was SA→DV so %= divided */
        整 a = Nd(10); 整 bin = Nd(2); nv[bin] = op;
        Nc(a, n); Nc(bin, n); Nc(bin, asgn()); Nc(a, bin); /* a op= b �?a = a op b */
        返 a;
    } 返 n; }
静 整 expr(空) { 返 asgn(); }

/* local ARRAY brace init: int a[3]={1,2,3}; -> a[0]=1; a[1]=2; a[2]=3; */
静 整 gi_idx[8];  /* 全局多维初始化游标 (fix 2026-08-05) */
静 整 str_row = 0; /* string-init row counter: char rows filled in order (fix 2026-08-05) */

静 整 arr_blk = -1; 静 整 arr_blk_root = -1; 静 整 arr_blk_cnt = 0; /* fix 2026-08-06: 数组初始化器块链（每块 ≤200 赋值, 链子块; arr_blk_root=首块） */
静 空 arr_chain_add(整 asgn) {
    若 (arr_blk < 0) { arr_blk = Nd(5); arr_blk_root = arr_blk; arr_blk_cnt = 0; }
    若 (arr_blk_cnt >= 200) { 整 nb = Nd(5); Nc(arr_blk, nb); arr_blk = nb; arr_blk_cnt = 0; }
    Nc(arr_blk, asgn);
    arr_blk_cnt++;
}
静 空 brace_arr_init(整 b, 整 d, 整 *dims, 整 nd, 整 depth, 整 esz) {
    /* 递归初始化器: int a[2][3] = {1,2,3,4,5,6} 或 {{1,2,3},{4,5,6}}
       gi_idx[0..nd-1] = 完整多维游标。遇 { 下钻深度, 遇值生成 a[i][j]... = expr。
       顶层扁平(无内层 {)用低位进位; 嵌套行递归只推进本层列, 行由外层 FK 推进。
       本函数自管 { } 配平 (fix 2026-08-05) */
    若 (depth == 0) { arr_blk = -1; arr_blk_root = -1; arr_blk_cnt = 0; } /* fix 2026-08-06 */
    若 (tt[tk] == FK) tk++; /* 本层 '{' */
    整 has_nested = (tt[tk] == FK); /* 本层是否为嵌套行模式 */
    循环 (tt[tk] != UK) {
        若 (tt[tk] == CK || tt[tk] == SK) { tk++; 续; }
        若 (tt[tk] == UK) 断;
        若 (tt[tk] == LB) { /* Phase 2: designated initializer [idx] = expr (fix 2026-08-11) */
            整 dsubs[8]; 整 dn_cnt = 0;
            循环 (tt[tk] == LB) { /* 支持多维 [i][j] 设计器 */
                tk++; /* [ */
                整 dn = expr();
                整 didx = (dn > 0 && nt[dn] == 0) ? nv[dn] : -1; /* 常量下标: expr() 返回 Nd(0) 节点, nv 存值 */
                若 (didx < 0) { 循环 (tt[tk] != CK && tt[tk] != UK && tt[tk] != EK) tk++; 续; }
                若 (tt[tk] == RB) tk++; /* ] */
                若 (dn_cnt < 8) dsubs[dn_cnt++] = didx;
            }
            若 (tt[tk] == AK) tk++; /* = */
            /* 跳到指定下标: 顶层扁平 → gi_idx[0..dn_cnt-1]=dsubs (其余维清零); 嵌套行 → 本层 depth */
            若 (depth == 0) {
                遍 (整 i = 0; i < nd; i++) gi_idx[i] = 0;
                遍 (整 i = 0; i < dn_cnt; i++) gi_idx[i] = dsubs[i];
            } 否 {
                gi_idx[depth] = dsubs[0];
            }
            /* 落 leaf 消费值 (C99: [2]=9 后随值落 a[3] — leaf 的 ++ 推进保持语义) */
        }
        若 (tt[tk] == FK && depth < nd - 1) { /* nested row { ... } */
            gi_idx[depth + 1] = 0; /* reset the child cursor (fix: next row continued from the previous row's column) */
            brace_arr_init(b, d, dims, nd, depth + 1, esz); /* 递归开头统一吃 '{' (fix 2026-08-05: FK also tk++'d → double-ate on 3D) */
            gi_idx[depth]++; /* 行推进 */
            续;
        }
        若 (tt[tk] == STR && esz <= 1) { /* char 行 = 字符串: char s[2][4] = {"ab","cd"} — copy the string BYTES into the row (fix 2026-08-05: was stored as a string ADDRESS → garbage); fix 2026-08-13: 指针数组 char *arr[] = {"A"} esz=8 → 走 leaf 存地址 (原 copy bytes → 元素=字符 → 解引用崩溃) */
            整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32);
            字 *sval = str_tbl[tv[tk]]; tk++;
            整 row_sz = dims[nd - 1] ? dims[nd - 1] : 1;
            /* 行号 → 前 nd-1 维索引（从次内层展开，独立于嵌套 depth） */
            整 rem = str_row;
            整 idxs[8];
            遍 (整 i = nd - 2; i >= 0; i--) { idxs[i] = rem % (dims[i] ? dims[i] : 1); rem /= (dims[i] ? dims[i] : 1); }
            整 node = idn;
            遍 (整 i = 0; i < nd - 1; i++) {
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = idxs[i];
                Nc(acc, idx);
                node = acc;
            }
            整 len = (整)strlen(sval);
            若 (len > row_sz) len = row_sz;
            遍 (整 k = 0; k < len; k++) {
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = k;
                Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc);
                整 cn = Nd(0); nv[cn] = (无 字)sval[k];
                Nc(asgn, cn);
