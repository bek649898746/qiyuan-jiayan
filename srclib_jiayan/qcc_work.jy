                ir_emit(I_PSUB_DIV, psub_div, 0, 0); ir_flush();
            }
        } 断;
        例 3: 遍 (整 i = 0; i < 256; i++) { 整 c = child_i(n, i); 若 (c > 0) cg(c); } 断;
        例 4: { /* function call */
            整 fn = -1;
            整 math_done = 0; /* external math fn IAT call already cleaned rsp (fix 2026-08-06 BUG-1) */
