#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2
#define T_PK 5   /* + */
#define T_MK 6   /* - */
#define T_DK 7   /* * */
#define T_QK 8   /* == */
#define T_LK 11  /* < */
#define T_GK 21  /* > */
#define T_XK 10  /* != */
#define T_HK 22  /* <= */
#define T_YK 23  /* >= */
#define T_DV 42  /* / */
#define T_MD 43  /* % */
#define T_SH 44  /* << */
#define T_SR 45  /* >> */
/* NULL 必须定义为对象宏 0：否则 `X = NULL;` 的初始化器被当作未定义标识符
   静默丢弃（复用前一个变量的寄存器值），连续声明时第二个变量初始化丢失。 */
#define NULL 0
/* ASM text emission for -S mode */
静 空 asm_emit(常 字 *fmt, 字 *a, 字 *b, 字 *c) {
    若 (asm_out && asm_pass == 2 && gen_final) {
        字 abuf[512];
        sprintf(abuf, fmt, a, b, c);
        fwrite(abuf, 1, strlen(abuf), asm_out);
    }
}
静 空 asm_emit_dbl(常 字 *fmt, 双 v) {
    若 (asm_out && asm_pass == 2 && gen_final) {
        字 abuf[512];
        sprintf(abuf, fmt, v);
        fwrite(abuf, 1, strlen(abuf), asm_out);
    }
}

静 空 b(无 字 v) {
    /* 4MB 预分配后无需增长检查（C 原版 296：`code[cp++] = v` 裸写）。
       qcc 对 `cc=N;...` 的全局写会丢（存到局部），若保留 cc 增长判断会误判 → 每次 realloc → bump 泄漏 75MB 撞栈。 */
    code[cp++] = v;
}
静 空 b4(整 v) { b(v & 0xff); b((v >> 8) & 0xff); b((v >> 16) & 0xff); b((v >> 24) & 0xff); }

/* ModR/M: mod=0(reg,[reg+disp])/1(reg,[reg+disp8])/2(reg,[reg+disp32])/3(reg,reg) */
静 空 modrm(整 mod, 整 reg, 整 rm) { b((mod << 6) | ((reg & 7) << 3) | (rm & 7)); }
/* REX prefix: W=64bit, R=reg ext, X=index ext, B=rm ext */
静 空 rex(整 w, 整 r, 整 x, 整 bval) { b(0x40 | (w ? 8 : 0) | (r ? 4 : 0) | (x ? 2 : 0) | (bval ? 1 : 0)); }

/* MOV reg32, imm32 (zero-extends to 64-bit in x86-64) */
静 空 mov_r_imm(整 reg, 整 imm) { asm_emit("    移动 r%d, %d\n", (字*)(长)(整)reg, (字*)(长)(整)imm, 0); 若 (reg & 8) b(0x41); b(0xB8 | (reg & 7)); b4(imm); }
/* MOV rax, sign-extended-imm32（48 C7 C0 imm32）— long long 字面量（fix 2026-08-05） */
静 空 mov_rax_imm32(整 imm) {
    asm_emit("    移动64 r0, %d\n", (字*)(长)(整)imm, 0, 0);
    b(0x48); b(0xC7); b(0xC0); b4(imm);
}
/* MOV rax, imm64（48 B8 imm64）— 大 long long 字面量（>2^31，fix 2026-08-05） */
静 空 mov_rax_imm64(长 长 imm) {
    整 lo = (整)(imm & 0xFFFFFFFF);
    整 hi = (整)(imm >> 32);
    asm_emit("    移动64 r0, %d, %d\n", (字*)(长)(整)lo, (字*)(长)(整)hi, 0); /* asm_zh 需要高 32 位（fix 2026-08-05） */
    b(0x48); b(0xB8); b4(lo); b4(hi);
}
/* push/pop r64 定义在 sub_rsp_imm/add_rsp_imm（815 行）之后 */
/* MOV [rsp+disp], reg32 */
__attribute__((unused))
静 空 mov_mrsp_reg(整 disp, 整 reg) {
    asm_emit("    存栈32 [rsp+%d], r%d\n", (字*)(长)(整)disp, (字*)(长)(整)reg, 0);
    rex(0, reg & 8, 0, 0); b(0x89);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
/* MOV reg32, [rsp+disp] */
__attribute__((unused))
静 空 mov_reg_mrsp(整 reg, 整 disp) {
    asm_emit("    取栈32 r%d, [rsp+%d]\n", (字*)(长)(整)reg, (字*)(长)(整)disp, 0);
    rex(0, reg & 8, 0, 0); b(0x8B);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
/* MOV reg64, reg64 */
静 空 mov_rr64(整 dst, 整 src) { asm_emit("    移64 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0); rex(1, src & 8, 0, dst & 8); b(0x89); modrm(3, src & 7, dst & 7); }
/* MOV reg32, reg32 */
静 空 mov_rr(整 dst, 整 src) { asm_emit("    移32 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0); rex(0, src & 8, 0, dst & 8); b(0x89); modrm(3, src & 7, dst & 7); }

静 整 g_uns_shift; /* cg() 在 alu_rr 前设置: T_SR 操作数是 unsigned → SHR (fix 2026-08-05) */
静 整 g_uns_div;   /* fix 2026-08-06 M1: T_DV/T_MD 操作数 unsigned → DIV */

/* ADD/SUB/IMUL/CMP reg32, reg32 ??op is token type (PK/MK/DK/QK) */
静 空 alu_rr(整 op, 整 dst, 整 src) {
    若 (op == T_PK) asm_emit("    加 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0);
    否 若 (op == T_MK) asm_emit("    减 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0);
    否 若 (op == T_DK) asm_emit("    乘 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0);
    否 若 (op == T_QK) asm_emit("    比较 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0);
    否 若 (op == 25 || op == 46) asm_emit("    与 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0); /* &：PT(25) 来自 a&b，AN(46) 来自 a&=b——fix 2026-08-05 */
    否 若 (op == 47) asm_emit("    或 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0);
    否 若 (op == 48) asm_emit("    异或 r%d, r%d\n", (字*)(长)(整)dst, (字*)(长)(整)src, 0);
    若 (op == T_SH || op == T_SR) {
        mov_rr(1, 0); /* ecx = shift count */
        若 (op == T_SH) asm_emit("    左移 r%d, cl\n", (字*)(长)(整)dst, 0, 0);
        否 asm_emit("    右移 r%d, cl\n", (字*)(长)(整)dst, 0, 0);
        /* unsigned 操作数 >> → SHR (逻辑)；signed → SAR (fix 2026-08-05: 恒 SAR) */
        若 (op == T_SR) {
            若 (g_uns_shift) { asm_emit("    逻辑右移 r%d, cl\n", (字*)(长)(整)dst, 0, 0); rex(0, 0, 0, dst & 8); b(0xD3); modrm(3, 5, dst & 7); }
            否 { asm_emit("    算术右移 r%d, cl\n", (字*)(长)(整)dst, 0, 0); rex(0, 0, 0, dst & 8); b(0xD3); modrm(3, 7, dst & 7); }
            g_uns_shift = 0;
            返;
        }
        rex(0, 0, 0, dst & 8); b(0xD3); modrm(3, 4, dst & 7);
        返;
    }
    若 (op == 25 || op == 46) { rex(0, src & 8, 0, dst & 8); b(0x21); modrm(3, src & 7, dst & 7); 返; } /* &（fix 2026-08-05：AN=46 来自 &=） */
    若 (op == 47) { rex(0, src & 8, 0, dst & 8); b(0x09); modrm(3, src & 7, dst & 7); 返; } /* | */
    若 (op == 48) { rex(0, src & 8, 0, dst & 8); b(0x31); modrm(3, src & 7, dst & 7); 返; } /* ^ */
    若 (op == T_DK) {
        /* IMUL: reg=destination, rm=source */
        rex(0, dst & 8 ? 1 : 0, 0, src & 8 ? 1 : 0);
        b(0x0F); b(0xAF); modrm(3, dst & 7, src & 7);
        返;
    }
    若 (op == T_DV || op == T_MD) {
        整 use_udiv = g_uns_div; g_uns_div = 0; /* fix 2026-08-06 M1 */
        mov_rr(9, 0); /* r9d = divisor */
        mov_rr(0, dst); /* eax = dividend */
        若 (use_udiv) {
            asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); /* xor edx, edx */
            asm_emit("    无符号除 r9\n", 0, 0, 0); rex(0, 0, 0, 1); b(0xF7); modrm(3, 6, 1); /* DIV r9d */
        } 否 {
            asm_emit("    扩展符号\n", 0, 0, 0); b(0x99); /* CDQ (fix 2026-08-06 M1: 原 48 99=CQO 查 RAX 位63，32位负值高32位为0 → 变无符号除法!) */
            asm_emit("    整除 r9\n", 0, 0, 0); rex(0, 0, 0, 1); b(0xF7); modrm(3, 7, 1); /* IDIV r9d */
        }
        若 (op == T_MD) mov_rr(0, 2); /* remainder �?eax */
        mov_rr(dst, 0); /* result �?dst for mov_rr(0,dst) in caller */
        返;
    }
    rex(0, src & 8, 0, dst & 8);
    若 (op == T_PK) { b(0x01); modrm(3, src & 7, dst & 7); }
    否 若 (op == T_MK) { b(0x29); modrm(3, src & 7, dst & 7); }
    否 若 (op == T_QK) { b(0x39); modrm(3, src & 7, dst & 7); }
}
/* ADD/SUB reg32, imm8/imm32 */
静 空 alu_ri(整 op, 整 reg, 整 imm) {
    asm_emit("    运即 r%d, %d\n", (字*)(长)(整)reg, (字*)(长)(整)imm, 0);
    rex(0, 0, 0, reg & 8);
    若 (op == T_PK) {
        若 (imm >= -128 && imm <= 127) { b(0x83); modrm(3, 0, reg & 7); b(imm); }
        否 { b(0x81); modrm(3, 0, reg & 7); b4(imm); }
    }
    否 若 (op == T_MK) {
        若 (imm >= -128 && imm <= 127) { b(0x83); modrm(3, 5, reg & 7); b(imm); }
        否 { b(0x81); modrm(3, 5, reg & 7); b4(imm); }
    }
}
/* TEST reg32, reg32 ??set ZF */
静 空 test_rr(整 r1, 整 r2) { asm_emit("    测试 r%d, r%d\n", (字*)(长)(整)r1, (字*)(长)(整)r2, 0); rex(0, r2 & 8, 0, r1 & 8); b(0x85); modrm(3, r2 & 7, r1 & 7); }
/* PUSH/POP reg64 ??always 64-bit in long mode, REX only needed for R8-R15 */
静 空 push_r(整 r) { asm_emit("    压栈 r%d\n", (字*)(长)(整)r, 0, 0); 若 (r & 8) b(0x41); b(0x50 | (r & 7)); }
静 空 pop_r(整 r) { asm_emit("    弹栈 r%d\n", (字*)(长)(整)r, 0, 0); 若 (r & 8) b(0x41); b(0x58 | (r & 7)); }
/* CALL rel32（文本由 patch_label 统一发射） */
静 空 call_rel(整 rel) { b(0xE8); b4(rel); }
/* RET */
静 空 ret(空) { asm_emit("    返回\n", 0, 0, 0); b(0xC3); }
/* LEA reg64, [rsp+disp] */
__attribute__((unused))
静 空 lea_r_mrsp(整 reg, 整 disp) {
    asm_emit("    取栈址 r%d, [rsp+%d]\n", (字*)(长)(整)reg, (字*)(长)(整)disp, 0);
    rex(1, reg & 8, 0, 0); b(0x8D);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
/* RBP-relative variants: [rbp+disp] �?stable during nested calls / temporary sub rsp.
   Frame slot at [rsp+off] == [rbp + off - cur_frame_sz] (rbp = rsp + frame at entry). */
静 空 mov_mbrp_reg(整 disp, 整 reg) {
    asm_emit("    存帧32 [rbp+%d], r%d\n", (字*)(长)(整)disp, (字*)(长)(整)reg, 0);
    rex(0, reg & 8, 0, 0); b(0x89);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
静 空 mov_reg_mbrp(整 reg, 整 disp) {
    asm_emit("    取帧32 r%d, [rbp+%d]\n", (字*)(长)(整)reg, (字*)(长)(整)disp, 0);
    rex(0, reg & 8, 0, 0); b(0x8B);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
静 空 lea_r_mbrp(整 reg, 整 disp) {
    asm_emit("    取帧址 r%d, [rbp+%d]\n", (字*)(长)(整)reg, (字*)(长)(整)disp, 0);
    rex(1, reg & 8, 0, 0); b(0x8D);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
/* 64-bit variants: preserve full pointer values in registers/slots */
静 空 mov_mbrp_reg64(整 disp, 整 reg) {
    asm_emit("    存帧64 [rbp+%d], r%d\n", (字*)(长)(整)disp, (字*)(长)(整)reg, 0);
    rex(1, reg & 8, 0, 0); b(0x89);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
静 空 mov_reg_mbrp64(整 reg, 整 disp) {
    asm_emit("    取帧64 r%d, [rbp+%d]\n", (字*)(长)(整)reg, (字*)(长)(整)disp, 0);
    rex(1, reg & 8, 0, 0); b(0x8B);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
/* ---- SSE double (xmm0) helpers ---- */
静 空 sub_rsp_imm(整 v);
静 空 add_rsp_imm(整 v);
静 空 movsd_xmm0_mbrp(整 disp) { asm_emit("    浮取帧 xmm0, [rbp+%d]\n", (字*)(长)(整)disp, 0, 0); b(0xF2); b(0x0F); b(0x10); 若 (disp < 128 && disp >= -128) { modrm(1, 0, 5); b(disp); } 否 { modrm(2, 0, 5); b4(disp); } }
静 空 movsd_mbrp_xmm0(整 disp) { asm_emit("    浮存帧 [rbp+%d], xmm0\n", (字*)(长)(整)disp, 0, 0); b(0xF2); b(0x0F); b(0x11); 若 (disp < 128 && disp >= -128) { modrm(1, 0, 5); b(disp); } 否 { modrm(2, 0, 5); b4(disp); } }
静 空 movsd_xmm1_xmm0(空) { asm_emit("    浮移 xmm1, xmm0\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x10); b(0xC8); }
静 空 movsd_xmm0_xmm1(空) { asm_emit("    浮移 xmm0, xmm1\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x10); b(0xC1); }
静 空 movsd_xmm0_mr13(空) { asm_emit("    浮取参 xmm0, [r13]\n", 0, 0, 0); b(0xF2); b(0x41); b(0x0F); b(0x10); b(0x45); b(0x00); } /* movsd xmm0, [r13] — REX MUST follow the F2 mandatory prefix (F2 41 0F 10), else the CPU ignores it and reads [rbp+0]! */
静 空 movsd_xmm1_mbrp(整 disp) { asm_emit("    浮取帧 xmm1, [rbp+%d]\n", (字*)(长)(整)disp, 0, 0); b(0xF2); b(0x0F); b(0x10); 若 (disp < 128 && disp >= -128) { modrm(1, 1, 5); b(disp); } 否 { modrm(2, 1, 5); b4(disp); } }
静 空 cvtsi2sd_xmm1_eax(空) { asm_emit("    整转浮 xmm1, eax\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x2A); b(0xC8); }
/* double function params (Win64): arg i goes in xmm[i] (i<4) / [rsp+32+8i] (i>=4) */
静 空 movsd_xmmreg_mrsp64(整 reg, 整 disp) { /* movsd xmmN, [rsp+disp] */
    asm_emit("    浮取栈 xmm%d, [rsp+%d]\n", (字*)(长)(整)reg, (字*)(长)(整)disp, 0);
    b(0xF2); b(0x0F); b(0x10);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
静 空 movsd_mrsp64_xmmreg(整 disp, 整 reg) { /* movsd [rsp+disp], xmmN */
    asm_emit("    浮存栈 [rsp+%d], xmm%d\n", (字*)(长)(整)disp, (字*)(长)(整)reg, 0);
    b(0xF2); b(0x0F); b(0x11);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
静 空 movsd_mbrp_xmmreg(整 disp, 整 reg) { /* movsd [rbp+disp], xmmN */
    asm_emit("    浮存帧 [rbp+%d], xmm%d\n", (字*)(长)(整)disp, (字*)(长)(整)reg, 0);
    b(0xF2); b(0x0F); b(0x11);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
静 整 preg_to_xmm(整 preg) { 若 (preg == 1) 返 0; 若 (preg == 2) 返 1; 若 (preg == 8) 返 2; 返 3; }
静 空 addsd_xmm0_xmm1(空) { asm_emit("    浮加 xmm0, xmm1\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x58); b(0xC1); }
静 空 subsd_xmm0_xmm1(空) { asm_emit("    浮减 xmm0, xmm1\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x5C); b(0xC1); }
静 空 mulsd_xmm0_xmm1(空) { asm_emit("    浮乘 xmm0, xmm1\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x59); b(0xC1); }
静 空 divsd_xmm0_xmm1(空) { asm_emit("    浮除 xmm0, xmm1\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x5E); b(0xC1); }
静 空 cvtsi2sd_xmm0_eax(空) { asm_emit("    整转浮 xmm0, eax\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x2A); b(0xC0); }
静 空 cvttsd2si_eax_xmm0(空) { asm_emit("    浮转整 eax, xmm0\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x2C); b(0xC0); }
静 空 push_xmm0(空) { asm_emit("    压浮 xmm0\n", 0, 0, 0); b(0x48); b(0x81); b(0xEC); b4(8); b(0xF2); b(0x0F); b(0x11); modrm(0, 0, 4); b(0x24); } /* sub rsp,8; movsd [rsp], xmm0（sub 裸发：压浮文本已含 sub，防双发） */
静 空 pop_xmm0(空) { asm_emit("    弹浮 xmm0\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x10); modrm(0, 0, 4); b(0x24); b(0x48); b(0x81); b(0xC4); b4(8); } /* movsd xmm0, [rsp]; add rsp,8（add 裸发：弹浮文本已含 add） */
静 空 comisd_xmm0_xmm1(空) { asm_emit("    浮比较 xmm0, xmm1\n", 0, 0, 0); b(0x66); b(0x0F); b(0x2F); b(0xC1); } /* set flags: xmm0 vs xmm1 */
静 空 movsd_xmm0_rip(整 disp) { b(0xF2); b(0x0F); b(0x10); b(0x05); b4(disp); } /* movsd xmm0, [rip+disp]（文本由调用点按 DBL/数值发射） */
静 空 movsd_rip_xmm0(整 disp) { asm_emit("    浮存静 [rip+%d], xmm0\n", (字*)(长)(整)disp, 0, 0); b(0xF2); b(0x0F); b(0x11); b(0x05); b4(disp); } /* movsd [rip+disp], xmm0 */
静 空 mov_mrsp_reg64(整 disp, 整 reg) {
    asm_emit("    存栈64 [rsp+%d], r%d\n", (字*)(长)(整)disp, (字*)(长)(整)reg, 0);
    rex(1, reg & 8, 0, 0); b(0x89);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
静 空 mov_reg_mrsp64(整 reg, 整 disp) {
    asm_emit("    取栈64 r%d, [rsp+%d]\n", (字*)(长)(整)reg, (字*)(长)(整)disp, 0);
    rex(1, reg & 8, 0, 0); b(0x8B);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
/* RIP-relative .data access for static vars: [rip+disp] */
静 空 mov_eax_rip(整 disp) { asm_emit("    取静32 eax, [rip+%d]\n", (字*)(长)(整)disp, 0, 0); b(0x8B); b(0x05); b4(disp); }            /* mov eax, [rip+disp] */
静 空 mov_rip_eax(整 disp) { asm_emit("    存静32 [rip+%d], eax\n", (字*)(长)(整)disp, 0, 0); b(0x89); b(0x05); b4(disp); }            /* mov [rip+disp], eax */
静 空 mov_rax_rip64(整 disp) { asm_emit("    取静64 rax, [rip+%d]\n", (字*)(长)(整)disp, 0, 0); rex(1, 0, 0, 0); b(0x8B); b(0x05); b4(disp); } /* mov rax, [rip+disp] */
静 空 mov_rip_rax64(整 disp) { asm_emit("    存静64 [rip+%d], rax\n", (字*)(长)(整)disp, 0, 0); rex(1, 0, 0, 0); b(0x89); b(0x05); b4(disp); } /* mov [rip+disp], rax */
静 空 lea_rax_rip(整 disp) { asm_emit("    取静址 rax, [rip+%d]\n", (字*)(长)(整)disp, 0, 0); rex(1, 0, 0, 0); b(0x8D); b(0x05); b4(disp); }   /* lea rax, [rip+disp] */
/* MOV byte [rip+disp], imm8 — 7 bytes (C6 05 disp32 imm8)。stc_disp() 按 6 字节指令假设，调用方需传 stc_disp()-1 */
静 空 mov_byte_rip_imm(整 disp, 整 imm) {
    asm_emit("    存静字节 [rip+%d], %d\n", (字*)(长)(整)disp, (字*)(长)(整)imm, 0);
    b(0xC6); b(0x05); b4(disp); b(imm & 0xFF);
}
/* char arr[N] = "lit": 把字符串一个字节存入 [rbp+disp]（C6 /0 = MOV r/m8, imm8）——曾缺定义，隐式声明致局部 char 数组=字符串初始化消失（fix 2026-08-05） */
静 空 mov_byte_mbrp_imm(整 disp, 整 imm) {
    asm_emit("    存字节 [rbp%+d], %d\n", (字*)(长)(整)disp, (字*)(长)(整)imm, 0);
    b(0xC6);
    若 (disp < 128 && disp >= -128) { modrm(1, 0, 5); b(disp); }
    否 { modrm(2, 0, 5); b4(disp); }
    b(imm & 0xFF);
}
/* ADD rax, imm8/imm32 (64-bit — for pointer+offset) */
静 空 add_rax_imm8(整 v) {
    asm_emit("    加指针 rax, %d\n", (字*)(长)(整)v, 0, 0);
    若 (v >= -128 && v <= 127) { rex(1, 0, 0, 0); b(0x83); modrm(3, 0, 0); b(v & 0xff); }
    否 { rex(1, 0, 0, 0); b(0x05); b4(v); } /* add rax, imm32 (offsets > 127, e.g. stypes[si].fn at 736) */
}
/* MOV reg32, [reg64] ??dereference */
静 空 mov_reg_mreg(整 reg, 整 mreg) {
    asm_emit("    取值 r%d, [r%d]\n", (字*)(长)(整)reg, (字*)(长)(整)mreg, 0);
    rex(0, reg & 8, 0, mreg & 8); b(0x8B);
    若 (mreg == 4 || mreg == 12) { modrm(0, reg & 7, mreg & 7); b(0x24); }
    否 modrm(0, reg & 7, mreg & 7);
}
/* MOV reg64, [reg64] �?full-width deref (char** argv[i] �?8-byte pointer) */
静 空 mov_reg_mreg64(整 reg, 整 mreg) {
    asm_emit("    取64 r%d, [r%d]\n", (字*)(长)(整)reg, (字*)(长)(整)mreg, 0);
    rex(1, reg & 8, 0, mreg & 8); b(0x8B);
    若 (mreg == 4 || mreg == 12) { modrm(0, reg & 7, mreg & 7); b(0x24); }
    否 modrm(0, reg & 7, mreg & 7);
}
/* MOV [reg64], reg32 ??used by struct member store (cg case 13) */
__attribute__((unused))
静 空 mov_mreg_reg(整 mreg, 整 reg) {
    asm_emit("    存32 [r%d], r%d\n", (字*)(长)(整)mreg, (字*)(长)(整)reg, 0);
    rex(0, reg & 8, 0, mreg & 8); b(0x89);
    若 (mreg == 4 || mreg == 12) { modrm(0, reg & 7, mreg & 7); b(0x24); }
    否 modrm(0, reg & 7, mreg & 7);
}
/* JMP rel32 / conditional jumps（文本由 patch_label 统一发射） */
静 空 jmp_rel(整 rel) { b(0xE9); b4(rel); }
静 空 jz_rel(整 rel) { b(0x0F); b(0x84); b4(rel); }
__attribute__((unused))
静 空 jnz_rel(整 rel) { b(0x0F); b(0x85); b4(rel); }
/* SETcc ??op is token type (T_LK/T_GK/T_QK/T_XK/T_HK/T_YK) */
静 空 setcc(整 op) {
    无 字 cc;
    若 (op == T_QK) { cc = 0x94; asm_emit("    置等 al\n", 0, 0, 0); }      /* SETE */
    否 若 (op == T_XK) { cc = 0x95; asm_emit("    置不等 al\n", 0, 0, 0); } /* SETNE */
    否 若 (op == T_LK) { cc = 0x9C; asm_emit("    置小 al\n", 0, 0, 0); }   /* SETL */
    否 若 (op == T_GK) { cc = 0x9F; asm_emit("    置大 al\n", 0, 0, 0); }   /* SETG */
    否 若 (op == T_HK) { cc = 0x9E; asm_emit("    置小等 al\n", 0, 0, 0); } /* SETLE */
    否 若 (op == T_YK) { cc = 0x9D; asm_emit("    置大等 al\n", 0, 0, 0); } /* SETGE */
    否 { cc = 0x94; asm_emit("    置条件 al\n", 0, 0, 0); }
    b(0x0F); b(cc); modrm(3, 0, 0);
}
/* unsigned setcc (fix 2026-08-06 M1): < → setb(0x92), > → seta(0x97), <= → setbe(0x96), >= → setae(0x93) */
静 空 setcc_u(整 op) {
    无 字 cc;
    若 (op == T_QK) { cc = 0x94; asm_emit("    置等 al\n", 0, 0, 0); }
    否 若 (op == T_XK) { cc = 0x95; asm_emit("    置不等 al\n", 0, 0, 0); }
    否 若 (op == T_LK) { cc = 0x92; asm_emit("    置低 al\n", 0, 0, 0); }
    否 若 (op == T_GK) { cc = 0x97; asm_emit("    置高 al\n", 0, 0, 0); }
    否 若 (op == T_HK) { cc = 0x96; asm_emit("    置低等 al\n", 0, 0, 0); }
    否 若 (op == T_YK) { cc = 0x93; asm_emit("    置高等 al\n", 0, 0, 0); }
    否 { cc = 0x94; asm_emit("    置条件 al\n", 0, 0, 0); }
    b(0x0F); b(cc); modrm(3, 0, 0);
}
/* MOVZX eax, al */
静 空 movzx_eax_al(空) { asm_emit("    零扩展 eax, al\n", 0, 0, 0); b(0x0F); b(0xB6); modrm(3, 0, 0); }
/* ADD rsp, imm32 �?imm8 (0x83) sign-extends and breaks for frame sizes �?0x80 */
静 空 add_rsp_imm(整 v) { asm_emit("    加栈 %d\n", (字*)(长)(整)v, 0, 0); b(0x48); b(0x81); b(0xC4); b4(v); }
/* SUB rsp, imm32 �?imm8 (0x83) sign-extends and breaks for frame sizes �?0x80 */
静 空 sub_rsp_imm(整 v) { asm_emit("    减栈 %d\n", (字*)(长)(整)v, 0, 0); b(0x48); b(0x81); b(0xEC); b4(v); }

/* push/pop r64（sub rsp,8; mov [rsp],r64）— 64 位临时，嵌套安全（fix 2026-08-05: mov [rsp+0] 跨嵌套 LL 运算被覆盖） */
静 空 push_r64(整 reg) {
    sub_rsp_imm(8);
    asm_emit("    存栈64 [rsp+0], r%d\n", (字*)(长)(整)reg, 0, 0);
    rex(1, reg & 8, 0, 0); b(0x89); modrm(1, reg & 7, 4); b(0x24); b(0);
}
静 空 pop_r64(整 reg) {
    asm_emit("    取栈64 r%d, [rsp+0]\n", (字*)(长)(整)reg, 0, 0);
    rex(1, reg & 8, 0, 0); b(0x8B); modrm(1, reg & 7, 4); b(0x24); b(0);
    add_rsp_imm(8);
}

/* b4_at: write 4 bytes at absolute position */
静 空 b4_at(整 pos, 整 v) { code[pos] = v & 0xff; code[pos+1] = (v>>8)&0xff; code[pos+2] = (v>>16)&0xff; code[pos+3] = (v>>24)&0xff; }

/* ?????? ??????: ???????????????????? */
#define ASZ 262144
#define MAX_LABELS 16384
静 整 label_pos[MAX_LABELS];
静 整 label_set[MAX_LABELS];
静 构 { 整 patch_at; 整 target_label; 整 is_jmp; } patches[65536]; 整 patch_n; /* fix 2026-08-06: 16384→65536 镜像 qcc_x86.c — qcc_work.jy 编译贴上限 */
静 构 { 整 patch_at; 整 str_idx; } str_patches[2048]; 整 strpn;
静 构 { 整 patch_at; 整 dbl_idx; } dbl_patches[2048]; 整 dbl_patch_n; /* double-literal rip-relative disp32 patches */
静 构 { 整 patch_at; 整 label; } fn_patches[2048]; 整 fnpn; /* function-address imm32 patches */
静 整 ginit[4096]; 静 整 ginit_n; /* fix 2026-08-06: 128→4096 + 溢出报错 */ /* global variable initializer nodes (emitted at main entry) */
静 整 coff_mode = 0; /* -c 模式（COFF 对象输出）标记——曾缺定义，隐式 extern 垃圾值 1 → 全局/局部 char 数组 = 字符串初始化被跳过（fix 2026-08-05） */
静 整 ndbl[262144]; /* per-node flag: expression yields a double (floating) */
静 整 nll[262144]; /* per-node flag: expression is a 64-bit long long（fix 2026-08-05） */
静 整 *nll_hi; /* per-node long long 字面量高 32 — 动态分配（静态 1MB 数组使 cf_1 .data 超限，fix 2026-08-05） */
静 整 nuns[262144]; /* per-node flag: expression is unsigned (u suffix literal / unsigned var) — >> must be logical SHR (fix 2026-08-05) */

静 整 new_label(空) { 若 (lc >= MAX_LABELS) { fprintf(stderr, "[LABEL-OVERFLOW] lc=%d\n", lc); abort(); } 整 l = lc++; label_set[l] = 0; 返 l; }
静 空 set_label(整 l) { label_pos[l] = cp; label_set[l] = 1; asm_emit(".L%d:\n", (字*)(长)(整)l, 0, 0); }
静 空 patch_label(整 at, 整 l, 整 is_jmp) {
    若 (patch_n >= 65536) { fprintf(stderr, "[PATCH-OVERFLOW] patch_n=%d\n", patch_n); abort(); }
    /* 跳转文本由 patch_label 统一发射（带真实标签号 .L%d，asm_zh 才能解析） */
    若 (is_jmp == 0) asm_emit("    调用 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 1) asm_emit("    为零跳 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 2) asm_emit("    跳转 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 3) asm_emit("    非零跳 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 4) asm_emit("    非负跳 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 5) asm_emit("    大于等跳 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 6) asm_emit("    小于等跳 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 7) asm_emit("    高于等跳 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 8) asm_emit("    低于跳 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 9) asm_emit("    高于跳 .L%d\n", (字*)(长)(整)l, 0, 0);
    否 若 (is_jmp == 10) asm_emit("    小跳 .L%d\n", (字*)(长)(整)l, 0, 0); /* jl (fix 2026-08-06 %lld) */
    否 若 (is_jmp == 11) asm_emit("    大跳 .L%d\n", (字*)(长)(整)l, 0, 0); /* jg (fix 2026-08-06) */
    patches[patch_n].patch_at = at;
    patches[patch_n].target_label = l;
    patches[patch_n].is_jmp = is_jmp;
    patch_n++;
}
静 空 resolve_patches(空) {
    遍 (整 i = 0; i < patch_n; i++) {
        整 at = patches[i].patch_at;
        整 target = label_pos[patches[i].target_label];
        /* CALL/JMP/Jcc 统一解析：rel32 = target - (at + 4)。is_jmp 类型只影响 -S 文本助记符 */
        整 tgt = target - (at + 4);
        b4_at(at, tgt);
    }
}
/* 规则：非静态变量只在自身函数 [fvb[gfn], fve[gfn]) 内可见；静态变量处处可见。codegen 时强制执行（C 原版 614 移植） */
静 整 var_codegen_visible(整 i) {
    若 (vars[i].is_static) 返 1;   /* .data slot: 任意函数可见 */
    若 (!vs_end) 返 1;             /* parse 阶段：调用方 parse_base 下限生效 */
    返 (i >= fvb[gfn]);            /* codegen：只允许当前函数的 locals/params */
}
静 整 var_is_dbl(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_dbl;
    返 0;
}
/* long long 变量: 64 位整加载/存储（fix 2026-08-05） */
静 整 var_is_ll(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_ll;
    返 0;
}
/* unsigned 变量: >> 必须用逻辑右移 SHR（fix 2026-08-05） */
静 整 var_is_uns(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_uns;
    返 0;
}
/* pointer-to-double (double *p): p[i] reads/writes 8-byte doubles (movsd) */
静 整 var_pdbl(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].p_dbl;
    返 0;
}
/* 8-byte frame slot for a local double */
静 整 var_ll(常 字 *n) { /* long long: 8 字节整槽（fix 2026-08-05） */
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].arr_sz == 0 && var_codegen_visible(i)) { vars[i].is_ll = 1; 返 vars[i].rsp_off; }
    若 (vcnt >= 4000) exit(1);
    strcpy(vars[vcnt].name, n);
    rsp_used += 8; rsp_used = (rsp_used + 15) & ~15;
    vars[vcnt].rsp_off = rsp_used - 8;
    vars[vcnt].is_param = 0;
    vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0; vars[vcnt].p_esz = 0; vars[vcnt].pstk = 0; vars[vcnt].pdisp = 0; vars[vcnt].is_dbl = 0; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = 0; vars[vcnt].is_uns = 0; vars[vcnt].is_static = 0;
    vars[vcnt].is_ll = 1;
    返 vars[vcnt++].rsp_off;
}
静 整 var_double(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].arr_sz == 0 && var_codegen_visible(i)) { vars[i].is_dbl = 1; 返 vars[i].rsp_off; }
    若 (vcnt >= 4000) exit(1);
    strcpy(vars[vcnt].name, n);
    rsp_used += 8; rsp_used = (rsp_used + 15) & ~15;
    vars[vcnt].rsp_off = rsp_used - 8;
    vars[vcnt].is_param = 0;
    vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0;
    vars[vcnt].p_esz = 0; vars[vcnt].pstk = 0; vars[vcnt].pdisp = 0; vars[vcnt].is_dbl = 0; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = 0; vars[vcnt].is_uns = 0; vars[vcnt].is_static = 0;
    vars[vcnt].is_dbl = 1;
    返 vars[vcnt++].rsp_off;
}
静 整 var_offset(常 字 *n) {
    /* do NOT reuse a same-named ARRAY entry: a `char fn[32]` field-local from another
       function must not shadow/absorb a plain `int fn` here (it would turn the int
       into a LEA of its own address). Match only non-array entries. During parse the
       search floor is parse_base (this function's var start) so an unrelated function's
       same-named param/local can't be silently reused either. */
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].arr_sz == 0 && var_codegen_visible(i)) 返 vars[i].rsp_off;
    若 (vcnt >= 4000) { fprintf(stderr, "[ERR] too many vars\n"); exit(1); }
    strcpy(vars[vcnt].name, n);
    rsp_used += 4; rsp_used = (rsp_used + 15) & ~15;
    vars[vcnt].rsp_off = rsp_used - 4; /* point to start, not aligned end */
    vars[vcnt].is_param = 0;
    vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0;
    vars[vcnt].p_esz = 0; vars[vcnt].pstk = 0; vars[vcnt].pdisp = 0; vars[vcnt].is_dbl = 0; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = 0; vars[vcnt].is_uns = 0; vars[vcnt].is_static = 0;
    返 vars[vcnt++].rsp_off;
}
静 整 var_offset_ptr(常 字 *n, 整 pesz) {
    /* 8-byte slot so full 64-bit pointer fits */
    整 off;
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].arr_sz == 0 && var_codegen_visible(i)) { off = vars[i].rsp_off; vars[i].p_esz = pesz; 返 off; }
    若 (vcnt >= 4000) { fprintf(stderr, "[ERR] too many vars\n"); exit(1); }
    strcpy(vars[vcnt].name, n);
    rsp_used += 8; rsp_used = (rsp_used + 15) & ~15;
    vars[vcnt].rsp_off = rsp_used - 8;
    vars[vcnt].is_param = 0;
    vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0;
    vars[vcnt].p_esz = pesz; vars[vcnt].pstk = 0; vars[vcnt].pdisp = 0; vars[vcnt].is_dbl = 0; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = 0; vars[vcnt].is_uns = 0; vars[vcnt].is_static = 0;
    off = vars[vcnt].rsp_off;
    vcnt++;
    返 off;
}
/* static var: slot in .data (RVA data_rva+8+4*idx), zero-initialised, survives calls */
静 整 var_static(常 字 *n, 整 pesz) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && var_codegen_visible(i)) 返 vars[i].rsp_off; /* fix 2026-08-05: 只应遮蔽既有 STATIC 全局 — qcc_rt.c 前置的库函数局部变量会撞名（atof 的 `s` 等）导致输入全局变量永不注册 */
    若 (vcnt >= 4000 || stc_n >= 8388608) exit(1);
    strcpy(vars[vcnt].name, n);
    vars[vcnt].rsp_off = stc_n; stc_n += (pesz > 0 ? 2 : 1); /* pointers take 8-byte slots (64-bit stores) */
    vars[vcnt].is_param = 0;
    vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0;
    vars[vcnt].p_esz = pesz; vars[vcnt].pstk = 0; vars[vcnt].pdisp = -1; vars[vcnt].is_dbl = 0; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = 0; vars[vcnt].is_uns = 0; vars[vcnt].is_static = 1;
    返 vars[vcnt++].rsp_off;
}
/* extern 全局变量声明: 负槽标记 (rsp_off<0), 无 .data 分配, is_static=1 走 RIP 相对 codegen;
   coff_mode 下 coff_slot_sym 生成 sec=0 未定义符号 + REL32 重定位 (Task 5.1 多 .o, 镜像 qcc_x86.c) */
静 整 var_extern(常 字 *n, 整 is_char, 整 is_dbl, 整 pesz, 整 is_ll) {
    静 整 extern_n = 2;
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].rsp_off < 0 && var_codegen_visible(i)) 返 vars[i].rsp_off;
    若 (vcnt >= 4000) exit(1);
    strcpy(vars[vcnt].name, n);
    vars[vcnt].rsp_off = -extern_n; extern_n++;
    vars[vcnt].is_param = 0; vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
