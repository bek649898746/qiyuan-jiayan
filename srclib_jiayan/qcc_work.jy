静 字 *pp_include_expand(常 字 *src, 整 depth) {
    若 (depth > 32) { fprintf(stderr, "[ERR] #include 嵌套超过 32 层\n"); exit(1); } /* fix 2026-08-26 ffmpeg: 8→32 — FFmpeg 头链深 (config.h→libavutil/xxx.h→common.h→mem.h→... 15+ 层), 原 8 层爆 */
    若 (depth == 0) { pp_guard_n = 0; inc_dir_n = 0; 若 (g_src_dir[0]) { strcpy(inc_dir_stack[inc_dir_n], g_src_dir); inc_dir_n++; } } /* fix 2026-08-13 Phase3: 顶层源文件目录入栈 */
    整 cap = (整)strlen(src) + 16384;
    字 *out = malloc(cap); 若 (!out) { fprintf(stderr, "[ERR] OOM malloc\n"); exit(1); } 整 oi = 0;
    常 字 *p = src;
    整 if_skip = 0, if_n = 0;
    整 if_parent_skip[64], if_taken[64];
    循环 (*p) {
        常 字 *le = p; 循环 (*le && *le != '\n') le++;
        整 llen = (整)(le - p);
        若 (*p == '#') {
            常 字 *pd = p + 1; 循环 (*pd == ' ' || *pd == '\t') pd++; /* fix 2026-08-26 libpng: 缩进指令 #  include "pngconf.h" (png.h) — 原不跳 # 后空白 → include 未处理 → pngconf.h 宏定义全缺 → PNG_EXPORT/PNG_CALLBACK 未展开 → 解析挂死 */
            整 is_ifdef = !strncmp(pd, "ifdef", 5) && (pd[5] == 0 || pd[5] == ' ' || pd[5] == '\t' || pd[5] == '\r' || pd[5] == '\n');
            整 is_ifndef = !strncmp(pd, "ifndef", 6) && (pd[6] == 0 || pd[6] == ' ' || pd[6] == '\t' || pd[6] == '\r' || pd[6] == '\n');
            整 is_if = !strncmp(pd, "if", 2) && !is_ifdef && !is_ifndef && (pd[2] == 0 || pd[2] == ' ' || pd[2] == '\t' || pd[2] == '\r' || pd[2] == '\n');
            整 is_elif = !strncmp(pd, "elif", 4) && (pd[4] == 0 || pd[4] == ' ' || pd[4] == '\t' || pd[4] == '\r' || pd[4] == '\n');
            整 is_else = !strncmp(pd, "else", 4) && (pd[4] == 0 || pd[4] == ' ' || pd[4] == '\t' || pd[4] == '\r' || pd[4] == '\n');
            整 is_endif = !strncmp(pd, "endif", 5) && (pd[5] == 0 || pd[5] == ' ' || pd[5] == '\t' || pd[5] == '\r' || pd[5] == '\n');
            整 is_include = !strncmp(pd, "include", 7) && (pd[7] == 0 || pd[7] == ' ' || pd[7] == '\t' || pd[7] == '\r' || pd[7] == '\n');
            整 is_expect = !strncmp(pd, "expect", 6) && (pd[6] == 0 || pd[6] == ' ' || pd[6] == '\t' || pd[6] == '\r' || pd[6] == '\n'); /* Phase4 期望原语: #expect <sha256> 声明产物哈希 */
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = if_skip; 整 cond = 0;
                若 (is_ifdef || is_ifndef) {
                    字 nm[64]; 整 ni = 0; 常 字 *q = pd + (is_ifdef ? 5 : 6);
                    循环 (*q == ' ' || *q == '\t') q++;
                    循环 (isalnum(*q) || *q == '_' || ((无 字)*q >= 0x80)) { 若 (ni < 63) nm[ni++] = *q; q++; }
                    nm[ni] = 0;
                    整 def = pp_guard_exists(nm); /* fix 2026-08-07: 原 macro_exists 在 include 阶段为空 → 守卫永远假 → 重复头重复展开内部 #include */
                    cond = is_ifdef ? def : !def;
                } 否 若 (is_if || is_elif) {
                    字 expr[512]; 整 ei = 0; 常 字 *q = pd + (is_if ? 2 : 4);
                    循环 (*q == ' ' || *q == '\t') q++;
                    循环 (*q && ei < 510) { 若 (*q == '\\' && (q[1] == '\n' || (q[1] == '\r' && q[2] == '\n'))) { q += (q[1] == '\r' ? 3 : 2); expr[ei++] = ' '; 续; } 若 (*q == '\n') 断; expr[ei++] = *q++; } /* fix 2026-08-26 pngtest: #if 表达式反斜杠续行 (同 lexer/collect — pngtest.c 版本检查跨 5 行, 原只读首行 → 尾反斜杠进表达式 → 条件求值错) */
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--;
                    expr[ei] = 0;
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (if_n < 64) { if_parent_skip[if_n] = parent; if_taken[if_n] = cond && !parent; if_skip = parent || !cond; if_n++; } 否 budget_fail("预处理条件栈 if_n", 64);
                } 否 若 (is_elif) {
                    若 (if_n > 0) { 若 (!if_taken[if_n-1] && !if_parent_skip[if_n-1]) { if_taken[if_n-1] = cond; if_skip = if_parent_skip[if_n-1] || !cond; } 否 if_skip = 1; }
                } 否 若 (is_else) {
                    若 (if_n > 0) { 若 (!if_taken[if_n-1] && !if_parent_skip[if_n-1]) { if_taken[if_n-1] = 1; if_skip = if_parent_skip[if_n-1]; } 否 if_skip = 1; }
                } 否 若 (is_endif) {
                    若 (if_n > 0) { if_n--; if_skip = if_n > 0 ? !if_taken[if_n-1] : 0; } /* fix 2026-08-13 Phase3: 嵌套假分支恢复用 !taken 而非 parent */
                }
                memcpy(out + oi, p, llen + 1); oi += llen + 1;
            } 否 若 (is_expect && !if_skip) { /* #expect <sha256>: 绝对断言, 编译完对账产物哈希 (Phase4) */
                常 字 *q = pd + 6;
                循环 (*q == ' ' || *q == '\t') q++;
                整 xi = 0;
                循环 ((*q >= '0' && *q <= '9') || (*q >= 'a' && *q <= 'f') || (*q >= 'A' && *q <= 'F')) { 若 (xi < 64) expect_sha[xi++] = *q; q++; }
                expect_sha[xi] = 0;
            } 否 若 (is_include && !if_skip) {
                常 字 *q = pd + 7;
                循环 (*q == ' ' || *q == '\t') q++;
                若 (*q != '"') {
                    /* <system header>: try stub/file first (fix 2026-08-23 t35e:
                       <stdarg.h> now resolves to a builtin custom implementation via
                       pp_read_file_inc; not found -> skip, self-contained). */
                    字 fname3[512]; 整 fi3 = 0;
                    常 字 *q3 = q + 1;
                    循环 (*q3 && *q3 != '>' && fi3 < 510) fname3[fi3++] = *q3++;
                    fname3[fi3] = 0;
                    字 *fc3 = fi3 > 0 ? pp_read_file_inc(fname3) : 0;
                    若 (fc3) {
                        字 fdir3[512]; dir_of_path(fname3, fdir3, 大小(fdir3));
                        字 newdir3[1024]; newdir3[0] = 0;
                        若 (inc_dir_n > 0 && inc_dir_stack[inc_dir_n - 1][0]) {
                            strcpy(newdir3, inc_dir_stack[inc_dir_n - 1]);
                            若 (fdir3[0]) { strcat(newdir3, "/"); strcat(newdir3, fdir3); }
                        } 否 { strcpy(newdir3, fdir3); }
                        若 (inc_dir_n < 16) { strcpy(inc_dir_stack[inc_dir_n], newdir3); inc_dir_n++; } 否 budget_fail("include目录栈 inc_dir", 16);
                        字 *exp3 = pp_include_expand(fc3, depth + 1);
                        inc_dir_n--;
                        free(fc3);
                        整 el3 = (整)strlen(exp3);
                        若 (oi + el3 + 2 >= cap) { cap = oi + el3 + 16384; out = realloc(out, cap); }
                        memcpy(out + oi, exp3, el3); oi += el3;
                        out[oi++] = '\n';
                        free(exp3);
                    } 否 {
                        memcpy(out + oi, p, llen + 1); oi += llen + 1; /* not found: skip */
                    }
                }
                否 {
                    字 fname[512]; 整 fi = 0;
                    q++; 循环 (*q && *q != '"' && fi < 510) fname[fi++] = *q++;
                    fname[fi] = 0;
                    若 (fi > 0) {
                        字 *fc = pp_read_file_inc(fname);
                        若 (!fc) { fprintf(stderr, "[ERR] 第%d行 #include: 找不到文件 '%s'\n", line_at(src, (整)(p - src)), fname); exit(1); } /* fix 2026-08-06 Task 5.3: 行号定位 */
                        字 fdir[512]; dir_of_path(fname, fdir, 大小(fdir)); /* fix 2026-08-13 Phase3: 子目录 include 相对当前源文件目录 */
                        字 newdir[1024]; newdir[0] = 0;
                        strcpy(newdir, g_inc_found_dir); /* fix 2026-08-26 ffmpeg: 基于实际找到的目录 (父链回溯命中), 再拼 fname 子目录 — 原从 inc_dir_stack 拼接 (父链找到的头记错位置 → 头内相对 include 解析错); libavutil/common.h 经父链在根找到, 实际目录=根+libavutil */
                        若 (fdir[0]) { strcat(newdir, "/"); strcat(newdir, fdir); }
                        若 (inc_dir_n < 16) { strcpy(inc_dir_stack[inc_dir_n], newdir); inc_dir_n++; } 否 budget_fail("include目录栈 inc_dir", 16);
                        字 *exp = pp_include_expand(fc, depth + 1);
                        inc_dir_n--;
                        free(fc);
                        整 el = (整)strlen(exp);
                        若 (oi + el + 2 >= cap) { cap = oi + el + 16384; out = realloc(out, cap); }
                        memcpy(out + oi, exp, el); oi += el;
                        out[oi++] = '\n';
                        free(exp);
                    }
                }
            } 否 {
                /* fix 2026-08-07: 注册 #define 名 → include 守卫生效; #undef 移除 */
                整 is_def = !strncmp(pd, "define", 6) && (pd[6] == 0 || pd[6] == ' ' || pd[6] == '\t' || pd[6] == '\r' || pd[6] == '\n');
                整 is_undef = !strncmp(pd, "undef", 5) && (pd[5] == 0 || pd[5] == ' ' || pd[5] == '\t' || pd[5] == '\r' || pd[5] == '\n');
                若 (is_def && !if_skip) {
                    字 mnm[64]; 整 mval = 0;
                    pp_def_parse(p, mnm, &mval); /* fix 2026-08-07: 名字+数值都记 */
                    若 (mnm[0]) pp_guard_add(mnm, mval);
                } 否 若 (is_undef) {
                    常 字 *q = pd + 5;
                    循环 (*q == ' ' || *q == '\t') q++;
                    字 mnm[64]; 整 mi = 0;
                    循环 (isalnum((无 字)*q) || *q == '_' || ((无 字)*q >= 0x80)) { 若 (mi < 63) mnm[mi++] = *q; q++; }
                    mnm[mi] = 0;
                    若 (mi > 0) pp_guard_del(mnm);
                }
                memcpy(out + oi, p, llen + 1); oi += llen + 1;
            }
        } 否 {
            memcpy(out + oi, p, llen + 1); oi += llen + 1;
        }
        若 (oi >= cap - 4096) { cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +32768 (bump realloc 泄漏) */; out = realloc(out, cap); }
        p = *le ? le + 1 : le;
    }
    out[oi] = 0;
    返 out;
}

静 整 rsp_used;           /* ????????? */

/* ?????? struct ??????????? */
/* #231 repr 控制 (2026-09-01): 打包 构 名 { } — 结构体紧凑布局 (字段无对齐填充, 尺寸不轮 up) */
静 整 packed_flag[4096]; /* 结构体打包标志 (0/1) */
静 整 packed_pending = 0; /* 顶层 打包 前缀暂存 (st_add 消费) */
静 构 { 字 name[64]; 字 fnames[1024][64]; 整 foffs[1024]; 整 fsizes[1024]; 整 frows[1024]; 整 ftypes[1024]; 整 fbits[1024]; 整 fbitof[1024]; 字 fdbls[1024]; 字 fsgn[1024]; 整 fels[1024]; 整 fpels[1024]; 字 fptrs[1024]; 整 ffins[1024]; 字 fdeep[1024]; 字 fcsgn[1024]; 整 fn; 整 sz; 整 algn; } stypes[4096]; /* fels: 数组字段元素大小 (fix 2026-08-07) */ 静 整 st_n; /* algn: struct 最大对齐（fix 2026-08-06）; fix 2026-08-13 字段表 64→128 (diff_options 71 字段); fix 2026-08-14 128→256 (rev_info 130+ 字段); ffins/fdeep (fix 2026-08-22 t41b): 指针字段最终元素大小 + 指针层级 — T** 双指针字段双层下标 (slab[i][j]) 第二维缩放; fcsgn (fix 2026-08-29 csmith): signed char 字段标记 (int8_t 字段读 movsx, s3/s137 静默) */

静 整 st_find(常 字 *n) {
    遍 (整 i = 0; i < st_n; i++) 若 (!strcmp(stypes[i].name, n)) { 若 (getenv("QCC_DBG_NS")) 若 (strstr(n, "ref_namespace")) fprintf(stderr, "[NS] st_find '%s' -> %d sz=%d algn=%d fn=%d\n", n, i, stypes[i].sz, stypes[i].algn, stypes[i].fn); 返 i; }
    若 (getenv("QCC_DBG_NS")) 若 (strstr(n, "ref_namespace")) fprintf(stderr, "[NS] st_find '%s' -> -1\n", n);
    返 -1;
}
静 整 bit_slot = -1, bit_pos = 0;  /* bit-field packing state: current int-slot foffs + bit offset inside it */
静 空 st_finalize(整 si) { /* fix 2026-08-06: struct 总大小按最大对齐 round up — 原只记 algn 未应用, SC{int,char}=5 应为 8 (数组 stride/sret 一致性) */
    若 (si >= 0 && stypes[si].algn > 1 && stypes[si].sz % stypes[si].algn)
        stypes[si].sz += stypes[si].algn - (stypes[si].sz % stypes[si].algn);
}
静 空 st_pend_backfill(整 new_si); /* fwd: 前向声明 struct Tag *field 的类型回填 (fix 2026-08-18) */
静 整 st_cur_struct_align = 1; /* fix 2026-08-19: struct 类型成员的对齐暂存 — 注册处设, st_field_sz_r 消费 (FILETIME=4 → WIN32_FIND_DATAW 布局对齐 Windows SDK) */
静 整 alignas_pending = 0; /* fix 2026-08-25 step21: _Alignas(N) 显式对齐暂存 — parser 在 AG token 处设, st_field_sz_r 消费 (字段级对齐, 并抬升 struct 最大对齐) */
静 整 ag_struct = 0; /* fix 2026-08-25 step25: _Alignas(N) struct 前 — 修饰 struct 变量 (gcc: `_Alignas(16) struct S v;` 对齐 v, 不修饰类型/字段); var_struct 消费 */
静 整 st_add(常 字 *n) {
    若 (st_n >= 4096) { fprintf(stderr, "[ERR] struct 表满 4096 (fix 2026-08-17 审计: 满则硬退, 绝不返 -1 — 原返 -1 调用方未检查 → stypes[-1] 越界写)\n"); exit(1); }
    strcpy(stypes[st_n].name, n); stypes[st_n].fn = 0; stypes[st_n].sz = 0; stypes[st_n].algn = 1;
    bit_slot = -1; bit_pos = 0; /* reset bit-field packing for the new struct */
    st_cur_struct_align = 1; /* fix 2026-08-20: 新 struct 开始时重置 struct 对齐暂存 — 原跨 struct 泄漏 (eg_a algn=8 残留 → eg_b 字段被 8 对齐 → di_b 数组字段偏移 8 错 (应 4)) */
    整 ns = st_n++;
    packed_flag[ns] = packed_pending; packed_pending = 0; /* #231: 消费顶层打包前缀 */
    若 (getenv("QCC_DBG_NS")) 若 (1) fprintf(stderr, "[NS] st_add name='%s' ns=%d\n", n, ns); /* tmp diag ALL */
    若 (strstr(n, "pathspec")) fprintf(stderr, "[NSA!] st_add name='%s' ns=%d\n", n, ns); /* tmp diag */
    st_pend_backfill(ns); /* 新结构体定义 (或首次引用即创建) → 回填引用它的 pending 指针字段 (fix 2026-08-18) */
    返 ns;
}
静 空 st_field_sz_r(整 si, 常 字 *fn, 整 fsz, 整 frow) {
    若 (stypes[si].fn >= 1024) { fprintf(stderr, "[ERR] struct '%s' 字段超过 1024 上限\n", stypes[si].name); exit(1); }
     
    若 (getenv("QCC_DBG_NS")) 若 (!strcmp(stypes[si].name, "gz3") || !strcmp(stypes[si].name, "z_stream_s") || !strcmp(stypes[si].name, "git_zstream") || strstr(stypes[si].name, "z_stream") || !strcmp(stypes[si].name, "config_set") || !strcmp(stypes[si].name, "hashmap") || !strcmp(stypes[si].name, "configset_list") || !strcmp(stypes[si].name, "string_list")) fprintf(stderr, "[FLD] struct '%s' fld='%s' fsz=%d frow=%d idx=%d\n", stypes[si].name, fn, fsz, frow, stypes[si].fn); /* tmp diag */
    整 idx = stypes[si].fn;
    /* fix 2026-08-06: struct 字段对齐填充（char+int 应 8 非 5）。对齐单位由 frow（元素/行大小）推导:
       frow>=8 → 8 (double/LL/指针); frow>=4 → 4 (int/float); frow>=2 → 2 (short)。数组字段 frow=元素大小。
       fix 2026-08-07: fsz>=8 也 8 对齐 — 指针字段 (struct LNode* next) 调用传 frow=1 → 原 align=1 → 偏移错位 (读 [&b+4] 而非 +8) */
    整 align = 1;
    若 (st_cur_struct_align > 1) { align = st_cur_struct_align; st_cur_struct_align = 1; } /* fix 2026-08-19: struct 类型成员按结构体自身对齐 (FILETIME=4 非按大小 8 → WIN32_FIND_DATAW cFileName@44 非 48 — Windows SDK 布局) */
    否 若 (frow != fsz) { /* 数组字段: 对齐按元素大小 (frow), 非总大小 — fix 2026-08-19: wchar_t cFileName[260] fsz=520 → 原 align=8 → 偏移 48 错 (应 44, wchar_t 对齐 2) */
        若 (frow >= 8) align = 8;
        否 若 (frow >= 4) align = 4;
        否 若 (frow >= 2) align = 2;
    }
    否 若 (frow >= 8 || fsz >= 8) align = 8;
    否 若 (frow >= 4 || fsz >= 4) align = 4;
    否 若 (frow >= 2 || fsz >= 2) align = 2;
    若 (alignas_pending > 0) { /* fix 2026-08-25 step21: _Alignas(N) 显式对齐覆盖自然对齐 (只增不减); 消费后清零 — struct A1 {_Alignas(8) char} → sizeof 8, A4 {char,_Alignas(8) int} → i@8 sizeof 16 */
        若 (alignas_pending > align) align = alignas_pending;
        alignas_pending = 0;
    }
    若 (packed_flag[si]) align = 1; /* #231: 打包结构体字段紧凑 (无对齐填充); max_align 保持 1 → 尺寸不轮 up */
    若 (stypes[si].sz % align) stypes[si].sz += align - (stypes[si].sz % align); /* pad 字段偏移到对齐 */
    strcpy(stypes[si].fnames[idx], fn);
    stypes[si].foffs[idx] = stypes[si].sz;
    stypes[si].fsizes[idx] = fsz;
    memcpy(&stypes[si].frows[idx], &frow, 4); /* fix 2026-08-05: direct frows[idx]=frow made nested-store scale read the OLD st_field_row -> self-referential garbage on self-host; &arr[i] scales by the fixed element size */
    stypes[si].ftypes[idx] = -1; /* not a struct field by default */
    stypes[si].fbits[idx] = 0; stypes[si].fbitof[idx] = 0; /* non bit-field */
    stypes[si].fsgn[idx] = 0; /* non bit-field: signedness irrelevant (fix 2026-08-05) */
    stypes[si].fptrs[idx] = 0; /* 指针字段标记: 字段解析处按 npel 设置 (fix 2026-08-18) */
    bit_slot = -1; bit_pos = 0; /* a non-bit-field ends any pending bit run */
    stypes[si].sz += fsz;
    若 (align > stypes[si].algn) stypes[si].algn = align; /* 记录 struct 最大对齐（总大小 round up） */
    若 (getenv("QCC_DBG_NS")) 若 (stypes[si].name[0] == 0 || strstr(stypes[si].name, "ref_namespace") || strstr(stypes[si].name, "pathspec")) fprintf(stderr, "[NS] fld '%s' field='%s' si=%d idx=%d foffs=%d fsz=%d frow=%d\n", stypes[si].name, fn, si, idx, stypes[si].foffs[idx], fsz, frow);
    若 (strstr(stypes[si].name, "pathspec")) fprintf(stderr, "[NS!] fld '%s' field='%s' si=%d idx=%d foffs=%d fsz=%d frow=%d\n", stypes[si].name, fn, si, idx, stypes[si].foffs[idx], fsz, frow); /* tmp diag */
    stypes[si].fn = stypes[si].fn + 1;
}
静 整 st_fidx(整 si, 常 字 *fn) { 遍 (整 i = 0; i < stypes[si].fn; i++) 若 (!strcmp(stypes[si].fnames[i], fn)) 返 i; 返 -1; }
静 整 st_field_el(整 si, 常 字 *fn) { 整 idx = st_fidx(si, fn); 返 (idx >= 0 && stypes[si].fels[idx] > 0) ? stypes[si].fels[idx] : (idx >= 0 ? stypes[si].frows[idx] : 1); } /* 数组字段元素大小; 未设置→frow (标量) */
静 整 st_field_pel(整 si, 常 字 *fn) { 整 idx = st_fidx(si, fn);  若 (idx >= 0 && stypes[si].fpels[idx] > 0) 返 stypes[si].fpels[idx]; /* fix 2026-08-21: fpels 未设置/为 0 — 前向声明 struct T *field 的指向元素大小未回填 (L5634 inner_si>=0 分支用未完成 struct 的 sz=0, 且不注册 pend) → fallback 到字段类型的 st_sz (config_set* → 72) */ 若 (idx >= 0) { 整 tsi = -1; memcpy(&tsi, &stypes[si].ftypes[idx], 4); 若 (tsi >= 0 && tsi < 4096) { 整 tsz = stypes[tsi].sz; 若 (tsz > 0) 返 tsz; } } 返 4; } /* 指针字段的指向元素大小 (fix 2026-08-17: char *buf → 1, int * → 4; 未设置→4) */
静 整 st_field_ffin(整 si, 常 字 *fn) { /* fix 2026-08-22 t41b: 指针字段最终元素大小 — T** 双层下标第二维 (slab[i][j] 元素 sizeof(T)); 单指针 T* 返回 sizeof(T) 等同 fpels */ 整 idx = st_fidx(si, fn); 若 (idx >= 0 && stypes[si].ffins[idx] > 0) 返 stypes[si].ffins[idx]; 若 (idx >= 0) { 整 tsi = -1; memcpy(&tsi, &stypes[si].ftypes[idx], 4); 若 (tsi >= 0 && tsi < 4096) { 整 tsz = stypes[tsi].sz; 若 (tsz > 0) 返 tsz; } } 返 st_field_pel(si, fn); }
静 整 st_field_fdeep(整 si, 常 字 *fn) { /* fix 2026-08-22 t41b: 指针字段层级 (T*=1, T**=2) — 决定数组基的最大下标层数 */ 整 idx = st_fidx(si, fn); 若 (idx >= 0 && stypes[si].fdeep[idx] > 0) 返 stypes[si].fdeep[idx]; 若 (idx >= 0 && stypes[si].fptrs[idx] != 0) 返 1; 返 0; }
静 整 st_field_is_ptr(整 si, 常 字 *fn) { 整 idx = st_fidx(si, fn); 返 idx >= 0 && stypes[si].fptrs[idx] != 0; } /* 指针字段标记 (struct X 星号 等; fix 2026-08-18: 指针字段作数组基判定 — 原 fty==-1 漏判 struct 指针字段) */
静 整 st_field_is_array_idx(整 si, 常 字 *fn) { 整 idx = st_fidx(si, fn); 若 (idx >= 0 && stypes[si].fptrs[idx]) 返 0; 若 (idx < 0) 返 0; 若 (stypes[si].fels[idx] > 0) 返 stypes[si].fels[idx] != stypes[si].fsizes[idx]; 返 stypes[si].fsizes[idx] == 0; } /* 数组字段: fels>0 且 fels(元素大小) != fsizes(总大小); fels==0 时 fsizes==0 → flex/空数组 char name[0] 也是数组 → 成员访问取地址 (fix 2026-08-20: dir_entry.name[FLEX_ARRAY=0] fsz=0 原落 4 字节标量加载 → "hell" 当地址 → add_files %s 崩); fnptr 字段 fels==0, 标量 fels==fsize (fix 2026-08-16); fix 2026-08-19: 指针字段 (fptrs=1) 的 fels=指向元素大小≠fsizes=指针大小 → 被误判为内联数组 → s->next_out[i] 保留字段地址+按 frow(8) 缩放 → qcc_deflate_emit 拷贝写坏 z_stream (next_out=7a/avail_out=-1) */
静 整 st_field_row(常 字 *sn, 常 字 *fn); /* fwd */
静 整 st_field_is_dbl(常 字 *sn, 常 字 *fn); /* fwd */
静 空 st_field_2d_setup(整 si, 常 字 *fn) { /* fix 2026-08-07: struct 数组字段 → 布好 2D 深度状态 (第一维行大小, 第二维元素大小) */
    整 row = st_field_row(stypes[si].name, fn);
    整 el = st_field_el(si, fn);
    cg_mem_frow = el;                /* deref 用元素大小 */
    cg_fdepth = 0;
    cg_frows[0] = row;               /* 第一维 (行) 缩放 */
    cg_frows[1] = el;                /* 第二维 (列) 缩放 */
    cg_fdepth_max = (row > el) ? 2 : 1; /* 2D 字段: 第二维后才 deref; 1D: 第一维后 */
    cg_mem_dbl = st_field_is_dbl(stypes[si].name, fn) ? 1 : 0;
}
静 空 st_field_bit(整 si, 常 字 *fn, 整 fsz, 整 frow, 整 bitw, 整 uns) {
    /* real bit-field semantics: pack consecutive bit-fields into shared int slots.
       foffs = slot byte offset; fbitof = bit offset inside the slot; fbits = width.
       uns = 1 for `unsigned` bit-fields (no sign extension on read); int → signed. */
    若 (stypes[si].fn >= 1024) { fprintf(stderr, "[ERR] struct 字段超过 1024 上限\n"); exit(1); }
    整 idx = stypes[si].fn;
    strcpy(stypes[si].fnames[idx], fn);
    若 (bit_slot < 0 || bit_pos + bitw > 32) { bit_slot = stypes[si].sz; stypes[si].sz += 4; bit_pos = 0; }
    stypes[si].foffs[idx] = bit_slot;
    stypes[si].fsizes[idx] = fsz;
    memcpy(&stypes[si].frows[idx], &frow, 4);
    stypes[si].ftypes[idx] = -1;
    stypes[si].fbits[idx] = bitw;
    stypes[si].fbitof[idx] = bit_pos;
    stypes[si].fsgn[idx] = uns;
    bit_pos += bitw;
    若 (getenv("QCC_DBG_NS")) 若 (stypes[si].name[0] == 0 || strstr(stypes[si].name, "ref_namespace")) fprintf(stderr, "[NS] bit '%s' field='%s' si=%d idx=%d foffs=%d bitof=%d bw=%d uns=%d\n", stypes[si].name, fn, si, idx, stypes[si].foffs[idx], stypes[si].fbitof[idx], bitw, uns);
    stypes[si].fn = stypes[si].fn + 1;
}
静 空 st_field_bit_anon(整 si, 整 bitw) {
    /* unnamed bit-field ": N" — occupies bits but registers no field (fix 2026-08-05).
       : 0 forces the next named bit-field into a fresh int slot (C rule). */
    若 (bitw > 0) {
        若 (bit_slot < 0 || bit_pos + bitw > 32) { bit_slot = stypes[si].sz; stypes[si].sz += 4; bit_pos = 0; }
        bit_pos += bitw;
    } 否 {
        bit_slot = -1; bit_pos = 0; /* zero-width: next field starts a new slot */
    }
}
静 空 st_field_ty(整 si, 常 字 *fn, 整 ty) {
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { stypes[si].ftypes[i] = ty; 返; }
}
/* 前向声明 struct Tag *field 的标签回填 (fix 2026-08-18):
   ref_iterator 的 vtable 字段 — struct ref_iterator_vtable 定义在后 (git refs-internal.h 320 vs 478) →
   字段解析时 inner_si=-1 走"未知标签指针字段"分支 (无 st_field_ty) → st_field_ty_idx=-1 →
   mem_addr 链 iter->vtable->advance 断 → 函数指针调用目标塌缩成 iter → call *iter → git init SEGV.
   Tag 结构体定义时 (st_add / 定义体完成) 回填 ftypes 索引 (字段大小/偏移早已按 8 字节指针就位). */
静 字 pend_ftag[4096][64]; 静 整 pend_fsi[4096]; 静 字 pend_ffn[4096][64]; 静 整 pend_n;
静 空 st_pend_add(常 字 *tag, 整 si, 常 字 *fn) {
    若 (pend_n >= 4096) { fprintf(stderr, "[ERR] pending 结构体标签表满 4096\n"); exit(1); }
    strcpy(pend_ftag[pend_n], tag); pend_fsi[pend_n] = si; strcpy(pend_ffn[pend_n], fn); pend_n++;
}
静 空 st_pend_backfill(整 new_si) {
    整 newsz = stypes[new_si].sz;
    遍 (整 i = 0; i < pend_n; i++)
        若 (!strcmp(pend_ftag[i], stypes[new_si].name)) {
            st_field_ty(pend_fsi[i], pend_ffn[i], new_si);
            /* fix 2026-08-21: 前向声明 struct T *field 的 fpels 也要回填 — 原只回填类型索引, fpels=0 → st_field_pel 默认 4 → CALLOC_ARRAY(repo->config,1) 的 sizeof(*(repo->config))=4 → config_set 只分 4 字节 → git_configset_init 越界写 → hashmap 崩 */
            若 (newsz > 0) { 整 pidx = st_fidx(pend_fsi[i], pend_ffn[i]); 若 (pidx >= 0 && stypes[pend_fsi[i]].fpels[pidx] <= 0) stypes[pend_fsi[i]].fpels[pidx] = newsz; 若 (pidx >= 0 && stypes[pend_fsi[i]].ffins[pidx] <= 0) stypes[pend_fsi[i]].ffins[pidx] = newsz; } /* fix 2026-08-22 t41b: ffins 同步回填 */
        }
}
静 整 st_field_ty_idx(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 -1;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v; memcpy(&v, &stypes[si].ftypes[i], 4); 返 v; }
    返 -1;
}
静 空 st_field_dbl(整 si, 常 字 *fn) { /* mark a struct field as double (8-byte movsd access) */
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { stypes[si].fdbls[i] = 1; 返; }
}
静 整 st_field_is_dbl(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v = 0; memcpy(&v, &stypes[si].fdbls[i], 1); 返 v != 0; } /* fix 2026-08-05: `int v; memcpy(&v,...,1)` left 3 garbage bytes → self-host flagged plain fields as double → comparisons went fp; v=0 zeroes the slot first */
    返 0;
}
静 整 st_field_is_dbl_si(整 si, 常 字 *fn) { /* fix 2026-08-27 特性#5: 按索引查 dbl — 匿名 struct/union 名="" 时 st_find 失败/错配 (u.c.r 链) */
    若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v = 0; memcpy(&v, &stypes[si].fdbls[i], 1); 返 v != 0; }
    返 0;
}
静 空 st_field_sz(整 si, 常 字 *fn, 整 fsz) { st_field_sz_r(si, fn, fsz, 1); }
/* union field: offset 0, size = MAX of all fields */
静 空 st_union_field(整 si, 常 字 *fn, 整 fsz, 整 frow) {
    若 (stypes[si].fn >= 1024) { fprintf(stderr, "[ERR] struct 字段超过 1024 上限\n"); exit(1); }
    整 idx = stypes[si].fn;
    strcpy(stypes[si].fnames[idx], fn);
    stypes[si].foffs[idx] = 0;
    stypes[si].fsizes[idx] = fsz;
    stypes[si].frows[idx] = frow; /* fix 2026-08-29 csmith: 标量 frow=fsz (原恒 1 → brace_fields `fsz>frow` 误判 nested(memset) → 初始化值丢, seed64/18); 数组字段 frow=元素大小 (原 fsz → c[4] 按 4 缩放 → regress_union 回归) */
    stypes[si].ftypes[idx] = -1;
    stypes[si].fbits[idx] = 0; stypes[si].fbitof[idx] = 0; stypes[si].fsgn[idx] = 0; /* union fields: never bit-fields (fix 2026-08-05) */
    若 (fsz > stypes[si].sz) stypes[si].sz = fsz;
    stypes[si].fn = stypes[si].fn + 1;
}
__attribute__((unused))
静 空 st_field(整 si, 常 字 *fn) { st_field_sz(si, fn, 4); }
静 整 st_field_row(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v; memcpy(&v, &stypes[si].frows[i], 4); 返 v; }
