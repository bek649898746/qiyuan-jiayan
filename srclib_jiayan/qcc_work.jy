        var_offset(iname);
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); Nc(d, e_a); Nc(blk, d); } /* int __mc = a; */
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 zero = Nd(0); nv[zero] = 0;
          整 neq = Nd(2); nv[neq] = T_XK; Nc(neq, v_i); Nc(neq, zero);
          整 ifn = Nd(8); Nc(ifn, neq);
          整 ibd = Nd(5); /* 多语句体包块 */
          { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 asg = Nd(10); Nc(asg, v_d); Nc(asg, v_i2); Nc(ibd, asg); } /* x = __mc; */
          Nc(ifn, ibd);
          Nc(blk, ifn); } /* if (__mc != 0) */
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
