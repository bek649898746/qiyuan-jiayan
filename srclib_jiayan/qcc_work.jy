        整 is_mut = !strcmp(tn[tk], "可变借用");
        tk++;
        字 bn[64]; strcpy(bn, tn[tk]); tk++;
        若 (tt[tk] == DT) { /* #33 借用分裂: 借用 s.x — 点成员路径 (字段级, . = DT token) */
            tk++; /* . */
            字 bp[160]; snprintf(bp, 160, "%s.%s", bn, tn[tk]); strcpy(bn, bp); tk++; /* s.x */
        } 否 若 (tt[tk] == LB && tt[tk + 1] == NK && tt[tk + 2] == RB) { /* #34 切片分裂: 借用 a[0] — 静态下标路径 (元素级) */
            字 bp[160]; snprintf(bp, 160, "%s[%d]", bn, tv[tk + 1]); strcpy(bn, bp); tk += 3; /* a[0] */
        }
        若 (tt[tk] == SK) tk++;
        若 (is_rel) {
            borrow_release(bn); /* 放还: 解除借用 (借用幂等注册 → 一次全清, mode 一并清) */
        } 否 {
            若 (is_moved(bn)) { sprintf(g_errbuf, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能借用 (v3.0 #10)", bn); emit_error("A3103", g_errbuf); } /* 接入 2026-08-28 机制层 #10: moved 变量不能借用 (所有权已转移) */
            整 bi = -1; 遍 (整 i = 0; i < borrowed_cnt; i++) 若 (!strcmp(borrowed_names[i], bn)) { bi = i; 断; }
            若 (bi >= 0 && is_mut && borrowed_mode[bi] == 0 && borrowed_lastuse[bi] < tk) { borrow_release(bn); bi = -1; } /* 2026-08-28 type-root-3 NLL: read-only borrow last-use passed, auto-yield to mut borrow */
            若 (bi >= 0) { /* 已有借用 → 独占互斥 (v3.0 #3) */
                若 (is_mut) { sprintf(g_errbuf, "借用检查: 变量 '%s' 已被借用, 不能可变借用 (独占, v3.0 #3)", bn); emit_error("A3002", g_errbuf); }
                若 (borrowed_mode[bi] == 1) { sprintf(g_errbuf, "借用检查: 变量 '%s' 已被可变借用 (独占), 不能再借用 (v3.0 #3)", bn); emit_error("A3003", g_errbuf); }
                /* 只读借用可叠加 (多读单写, 现有语义) */
            }
            若 (bi < 0 && borrowed_cnt < 256) { strcpy(borrowed_names[borrowed_cnt], bn); borrowed_mode[borrowed_cnt] = is_mut ? 1 : 0; borrowed_scope[borrowed_cnt] = borrow_depth; borrowed_lastuse[borrowed_cnt] = -1; borrowed_cnt++; } /* 2026-08-28 type-root-3 NLL: lastuse init -1 (unread) */ /* #4: 记录借用声明时块深度, 块退出自动放还 */
        }
        返 Nd(5);
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "编译期断言")) { /* 接入 2026-08-28 P1 #176/#190 编译期断言族: 编译期断言(expr); → 编译期求值, 非真/非常量 → [ERR] fail-closed (static_assert 甲言版) */
        tk++; /* 编译期断言 */
        若 (tt[tk] == OK) tk++; /* ( */
        整 cv = 0;
        整 ok = const_expr_eval(&cv); /* 从当前 token 编译期常量求值 (消费表达式) */
        若 (tt[tk] == KK) tk++; /* ) */
        若 (tt[tk] == SK) tk++; /* ; */
        若 (!ok) { fprintf(stderr, "[ERR] 编译期断言: 表达式不是编译期常量 (v3.0 #176)\n"); exit(1); }
        若 (cv == 0) { fprintf(stderr, "[ERR] 编译期断言失败: 表达式非真 (v3.0 #176)\n"); exit(1); }
        返 Nd(5); /* 断言通过: 无运行时代码 */
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "恐慌")) { /* 接入 2026-08-28 P1 #88: 恐慌机制 (panic) — 恐慌 "消息"; → { if (钩子) 钩子(); printf("消息\n"); exit(1); } 致命错误路径, 确定性终止 */ /* 2026-08-28 P2 #162: 恐慌钩子 (panic hook) — 恐慌钩子 fn; 注册, 恐慌时先调钩子再终止 */
        tk++; /* 恐慌 */
        字 msg[200]; strcpy(msg, "恐慌\n"); /* 默认消息 */
        若 (tt[tk] == STR) { 字 *m0 = str_tbl[tv[tk]]; 若 (m0) snprintf(msg, 200, "%s\n", m0); tk++; } /* 自定义消息 */
        若 (tt[tk] == SK) tk++;
        整 blk = Nd(5);
        若 (panic_hook_fn[0]) { /* #162: 恐慌钩子 — 先调钩子 (确定性: 钩子=资源收尾) */
            整 call_h = Nd(4); { 整 fn = Nd(1); memcpy((字*)(nn + fn), panic_hook_fn, 64); Nc(call_h, fn); }
            Nc(blk, call_h);
        }
        若 (str_cnt >= 65536) { fprintf(stderr, "[STR-OVERFLOW]\n"); abort(); }
        若 (!str_tbl[str_cnt]) str_tbl[str_cnt] = str_slot_alloc();
        strcpy(str_tbl[str_cnt], msg);
        整 call_p = Nd(4); { 整 sn = Nd(0); nv[sn] = str_cnt; nt[sn] = STR; Nc(call_p, sn); } { 整 en = Nd(1); memcpy((字*)(nn + en), "printf", 7); Nc(call_p, en); } /* printf("消息\n") — 参数先挂, callee 最后 */
        str_cnt++;
        Nc(blk, call_p);
        整 call_x = Nd(4); { 整 one = Nd(0); nv[one] = 1; Nc(call_x, one); } { 整 en2 = Nd(1); memcpy((字*)(nn + en2), "exit", 5); Nc(call_x, en2); } /* exit(1) */
        Nc(blk, call_x);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "恐慌钩子")) { /* 接入 2026-08-28 P2 #162 恐慌捕获/处理钩子: 恐慌钩子 fn; → 注册钩子, 恐慌时先调用 */
        tk++; /* 恐慌钩子 */
        字 hf[64]; strcpy(hf, tn[tk]); tk++;
        若 (tt[tk] == SK) tk++;
        strcpy(panic_hook_fn, hf);
        返 Nd(5);
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "声明")) { /* 接入 2026-08-28 declare 声明先行 (AI启动单/MoonBit#1): 声明 名字(参数) 返回 类型; → 注册签名, 实现后补(stub), 缺失=警告非错误 */
        tk++; /* 声明 */
        字 dname[64]; strcpy(dname, tn[tk]); tk++; /* 函数名 */
        若 (decl_cnt < 256) strcpy(decl_names[decl_cnt++], dname); /* 声明表注册 (独立于 func_tbl, gen_code 重置 func_n) */
        整 ddep = 0; /* 跳过 (参数) 返回 类型 到 ; */
        循环 (tk < TS && tt[tk] != EK && tt[tk] != SK) {
            若 (tt[tk] == OK) ddep++;
            否 若 (tt[tk] == KK) { ddep--; 若 (ddep <= 0) { tk++; 续; } }
            tk++;
        }
        若 (tt[tk] == SK) tk++; /* ; */
        返 Nd(5);
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "守卫")) { /* 接入 2026-08-28 机制层 #8 RAII 完整(析构): 守卫 x, 析构名; → 登记(变量,析构,块深度), 块退出自动调用 析构名(x) (作用域退出自动释放, Rust 式 drop) */
        tk++; /* 守卫 */
        字 gv[64]; strcpy(gv, tn[tk]); tk++; /* 变量名 */
        若 (tt[tk] == CK) tk++; /* , */
        字 gf[64]; strcpy(gf, tn[tk]); tk++; /* 析构函数名 */
        若 (tt[tk] == SK) tk++; /* ; */
        若 (guard_cnt < 64) { strcpy(guard_vars[guard_cnt], gv); strcpy(guard_fns[guard_cnt], gf); guard_scope[guard_cnt] = borrow_depth; guard_ready[guard_cnt] = !uninit_has(gv); guard_cnt++; } /* 2026-08-28 P1 #15 Drop 标记: 守卫时变量未初始化 → 跳过析构 (块退出只析构已初始化守卫) */
        返 Nd(5);
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "忘记")) { /* 接入 2026-08-28 P2 #20 泄漏逃生口 (mem::forget): 忘记 x; → 变量标记 moved 但守卫析构不执行 (有意泄漏, 所有权转交给运行时/调用者) */
        tk++; /* 忘记 */
        字 dn[64]; strcpy(dn, tn[tk]); tk++;
        若 (tt[tk] == SK) tk++;
        若 (is_moved(dn)) { sprintf(g_errbuf, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能忘记 (v3.0 #20)", dn); emit_error("A3102", g_errbuf); }
        若 (borrow_mode_of(dn) >= 0) { sprintf(g_errbuf, "借用检查: 变量 '%s' 被借用, 不能忘记 (借用期所有权不可转移, v3.0 #20)", dn); emit_error("A3004", g_errbuf); }
        遍 (整 gi = 0; gi < guard_cnt; gi++) 若 (guard_vars[gi][0] != 0 && !strcmp(guard_vars[gi], dn)) { guard_vars[gi][0] = 0; guard_ready[gi] = 0; } /* 注销守卫: 不析构 (泄漏) */
        若 (moved_cnt < 256) strcpy(moved_names[moved_cnt++], dn); /* 标记 moved: 生命周期移交, 后续读取 A3101 */
        返 Nd(5);
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "丢弃")) { /* 接入 2026-08-28 P1 #25 显式丢弃: 丢弃 x; → 主动消费值结束生命周期 (Rust drop(x)) — 守卫析构立即执行+守卫注销 (块退出不二次析构), 变量标记 moved (后续读取 A3101); 借用中/已移动 = [ERR] (所有权不可在借用期转移) */
        tk++; /* 丢弃 */
        字 dn[64]; strcpy(dn, tn[tk]); tk++; /* 变量名 */
        若 (tt[tk] == SK) tk++; /* ; */
        若 (is_moved(dn)) { sprintf(g_errbuf, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能丢弃 (v3.0 #25)", dn); emit_error("A3102", g_errbuf); } /* 已移动不能再消费 (同移入 #10) */
        若 (borrow_mode_of(dn) >= 0) { sprintf(g_errbuf, "借用检查: 变量 '%s' 被借用, 不能丢弃 (借用期所有权不可转移, v3.0 #25)", dn); emit_error("A3004", g_errbuf); } /* 借用期间不能消费 (同移入) */
        整 blk_d = Nd(5);
        遍 (整 gi = 0; gi < guard_cnt; gi++) 若 (guard_vars[gi][0] != 0 && !strcmp(guard_vars[gi], dn) && guard_ready[gi]) { /* 守卫已登记且已初始化 → 立即析构 (主动消费=资源现在释放) */
            整 call = Nd(4); { 整 arg = Nd(1); memcpy((字*)(nn + arg), dn, 64); Nc(call, arg); } { 整 fn = Nd(1); memcpy((字*)(nn + fn), guard_fns[gi], 64); Nc(call, fn); }
            Nc(blk_d, call);
            guard_vars[gi][0] = 0; /* 注销守卫 → 块退出压缩时跳过, 不二次析构 */
        }
        若 (moved_cnt < 256) strcpy(moved_names[moved_cnt++], dn); /* 标记 moved: 生命周期结束, 后续读取 A3101 */
        返 blk_d;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "移入")) { /* 接入 2026-08-28 机制层 #1/#5/#13: 所有权 move — 移入 dst, src; → { dst = src; src 标记已移动 }; #13 覆写: 移入 dst, src 覆写 钩子名; → { 钩子名(&dst, &src); src 标记已移动 } (可覆写移动, 替代按位) */
        tk++; /* 移入 */
        move_dst_parsing = 1; /* #5: dst 是写目标, 跳过 moved 读检查 (dst 可为已移动变量重新赋值) */
        整 e_d = expr(); /* 目标 (左值: 变量/数组元素/成员) */
        move_dst_parsing = 0;
        若 (tt[tk] == CK) tk++; /* , */
        整 e_s = expr(); /* 源 (变量/数组元素/成员) — 已 moved 时 L5014 读检查 [ERR] */
        整 override = 0; 字 ofn[64] = "";
        若 (tt[tk] == VR && !strcmp(tn[tk], "覆写")) { tk++; strcpy(ofn, tn[tk]); tk++; override = 1; } /* #13: 可覆写移动钩子 */
        若 (tt[tk] == SK) tk++; /* ; */
        若 (e_s >= 0 && nt[e_s] == 1) { /* moved 登记: 源是简单变量时跟踪 */
            字 *srcn = (字*)(nn + e_s);
            若 (borrow_mode_of(srcn) >= 0) { sprintf(g_errbuf, "借用检查: 变量 '%s' 被借用, 不能移动 (借用期所有权不可转移, v3.0 #10)", srcn); emit_error("A3004", g_errbuf); } /* 接入 2026-08-28 机制层 #10: 借用期间不能 move (只读借用在此拦, 可变借用 L5014 已拦) */
            整 mi; 遍 (mi = 0; mi < moved_cnt; mi++) 若 (!strcmp(moved_names[mi], srcn)) 断;
            若 (mi < moved_cnt) { sprintf(g_errbuf, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能再次移动", srcn); emit_error("A3102", g_errbuf); }
            若 (moved_cnt < 256) strcpy(moved_names[moved_cnt++], srcn);
        } 否 若 (e_s >= 0 && nt[e_s] == 15) { /* 2026-08-28 P1 #17 部分移动: 源是字段 (s.x) — 登记字段路径 moved, 其余字段仍可用 */
            字 *fname = (字*)(nn + e_s);
            整 base = n0[e_s];
            若 (base >= 0 && nt[base] == 1) {
                字 path[64]; sprintf(path, "%s.%s", (字*)(nn + base), fname);
                若 (moved_cnt < 256) strcpy(moved_names[moved_cnt++], path);
            }
        }
        borrow_write_policy(e_d); /* 借用自动化 (2026-08-28 完善): 移入 dst = 写目标 → 只读借用自动放还, 可变借用 [ERR] (原此路径无 dst 借用检查) */
        { 整 rvd = e_d; 整 depd = 0; 循环 (rvd >= 0 && depd < 8 && (nt[rvd] == 14 || (nt[rvd] == 15 && nv[rvd] == 0))) { rvd = n0[rvd]; depd++; } 若 (rvd >= 0 && nt[rvd] == 1) { uninit_remove((字*)(nn + rvd)); moved_release((字*)(nn + rvd)); } } /* #78 完善 (2026-08-28 fix #78回归): 移入 dst = 初始化/重新绑定 → 解除 dst 的未初始化/已移动状态 (与 asgn 赋值同记账) */
        整 blk = Nd(5);
        若 (override) { /* #13: 覆写移动 → 调用钩子 钩子名(&dst, &src) (Nd(11)=取地址, callee 最后 Nc) */
            整 call = Nd(4);
            { 整 ad = Nd(11); Nc(ad, e_d); Nc(call, ad); }
            { 整 as2 = Nd(11); Nc(as2, e_s); Nc(call, as2); }
            { 整 fn = Nd(1); memcpy((字*)(nn + fn), ofn, 64); Nc(call, fn); }
            Nc(blk, call);
        } 否 {
            { 整 asg = Nd(10); Nc(asg, e_d); Nc(asg, e_s); Nc(blk, asg); } /* dst = src; */
        }
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "互斥锁")) { /* 接入 2026-08-28 机制层: 互斥锁声明 (内建自旋锁状态): 互斥锁 m; → { int __mtx_m = 0; } — 0=未锁, 1=锁定; 锁住 m {..} 用真原子 CAS 自旋 */
        tk++; /* 互斥锁 */
        字 mn[64]; strcpy(mn, tn[tk]); tk++; /* 锁名 */
        若 (tt[tk] == SK) tk++; /* ; */
        字 mname[80]; sprintf(mname, "__mtx_%s", mn);
        var_offset(mname);
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), mname, 32); 整 z = Nd(0); nv[z] = 0; Nc(d, z); Nc(blk, d); } /* int __mtx_m = 0; */
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "信号量")) { /* 接入 2026-08-28 P1 #56: 信号量声明 — 信号量 sem, n; → { int __sem_sem = n; } 计数信号量 (n=初始许可数); 获取/放行 用真原子 CAS/xadd */
        tk++; /* 信号量 */
        字 sn[64]; strcpy(sn, tn[tk]); tk++; /* 名 */
        若 (tt[tk] == CK) tk++; /* , */
        整 initv = 0; 若 (tt[tk] == NK) { initv = tv[tk]; tk++; }
        若 (tt[tk] == SK) tk++; /* ; */
        字 sname[80]; sprintf(sname, "__sem_%s", sn);
        var_offset(sname);
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), sname, 32); 整 z = Nd(0); nv[z] = initv; Nc(d, z); Nc(blk, d); } /* int __sem_sem = n; */
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "获取")) { /* 接入 2026-08-28 P1 #56: 信号量 P 操作 — 获取 sem; → __qcc_sem_wait(&__sem_sem) 忙等到许可 */
        tk++; /* 获取 */
        字 sn[64]; strcpy(sn, tn[tk]); tk++;
        若 (tt[tk] == SK) tk++;
        字 sname[80]; sprintf(sname, "__sem_%s", sn);
