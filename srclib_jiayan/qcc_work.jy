          { 整 v_j = Nd(1); memcpy((字*)(nn + v_j), iname, 32);
            整 c2 = Nd(2); nv[c2] = T_LK; Nc(c2, v_j); Nc(c2, e_n); /* __tq < n */
            整 both = Nd(2); nv[both] = LA; Nc(both, c1); Nc(both, c2);
            Nc(wh, both); } }
        整 bd = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
