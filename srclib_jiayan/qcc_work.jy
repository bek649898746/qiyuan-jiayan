静 整 var_array(常 字 *n, 整 count, 整 esz) {
    整 _pa = var_align(); /* fix step25: _Alignas(N) 变量级 */
    /* always allocate */
    若 (vcnt >= 65536) { fprintf(stderr, "[ERR] 变量表满 vcnt=%d\n", vcnt); exit(1); }
    strcpy(vars[vcnt].name, n);
    整 sz = count * esz;
    rsp_used += sz; rsp_used = (rsp_used + 15) & ~15;
    若 (_pa >= 16) rsp_used += 8; /* fix step25: rsp_off ≡ 8 mod 16 → 数组地址 = rbp-(frame-rsp_off) ≡ 0 mod 16 (rbp%16=8) */
