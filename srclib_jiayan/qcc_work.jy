                    lea_rax_rip(stc_disp(off) - 1); /* rax = &static[0] (lea is 7 bytes: stc_disp assumes 6) */
                    asm_emit("    加64\n", 0, 0, 0); rex(1, 1, 0, 0); b(0x01); modrm(3, 3, 0); /* ADD rax, r11 */
                    若 (!cg_no_deref) {
                        若 (var_is_dbl(vname)) { b(0xF2); b(0x0F); b(0x10); modrm(0,0,0); } /* double array elem → xmm0 (NOT fnptr arrays) */
                        否 若 (is_struct_elem) { /* address mode for member access */
                        } 否 若 (esz == 1) { asm_emit("    零扩展 eax, [rax]\n", 0, 0, 0); b(0x0F); b(0xB6); modrm(0, 0, 0); }
                        否 若 (esz == 8) { mov_reg_mreg64(0, 0); } /* char* / pointer element: 64-bit */
                        否 { mov_reg_mreg(0, 0); }
                    }
                    did = 1;
                }
            } 否 {
                /* pointer param arr[i]: index in r11 (r9 may be the param reg) */
                整 peszp = var_esz(vname);
                cg(n1[n]); /* index �?eax */
                mov_rr(11, 0); /* r11d = index */
                若 (peszp == 4) { asm_emit("    左移 r11, 2\n", 0, 0, 0); rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(2); }
                否 若 (peszp == 2) { asm_emit("    左移 r11, 1\n", 0, 0, 0); rex(0, 0, 0, 1); b(0xC1); modrm(3, 4, 3); b(1); }
                否 若 (peszp > 4) { mov_r_imm(0, peszp); mov_rr(9, 0); asm_emit("    乘 r11, r9\n", 0, 0, 0); rex(0, 1, 0, 1); b(0x0F); b(0xAF); modrm(3, 3, 1); } /* IMUL r11d, r9d */
                load_param_val(vname); /* eax = ptr (reg or [rbp+disp]) */
                asm_emit("    加64\n", 0, 0, 0); rex(1, 1, 0, 0); b(0x01); modrm(3, 3, 0); /* ADD rax, r11 */
                若 (!cg_no_deref) {
                    若 (var_pdbl(vname)) { b(0xF2); b(0x0F); b(0x10); modrm(0,0,0); } /* double* param elem → xmm0 */
                    否 若 (peszp == 1) { asm_emit("    零扩展 eax, [rax]\n", 0, 0, 0); b(0x0F); b(0xB6); modrm(0, 0, 0); } /* movzx eax,byte[rax] */
                    否 若 (peszp > 4) { mov_reg_mreg64(0, 0); }         /* mov rax,[rax] (char** ?ptr / struct*) */
                    否 { mov_reg_mreg(0, 0); } /* mov eax, [rax] */
                }
            }
        } 断;
    }
}
/* str */
/* string data */
静 无 字 *sdat; 静 整 sdp, sdc;
静 整 str_offs[1024]; /* RVA offset for each string (str_tbl 上限 1024，必须匹配) */

静 整 dbl_offs[1024]; /* byte offset of each double literal in sdat; -1 = not placed */
静 整 dbl_place(整 idx) {
    若 (dbl_offs[idx] >= 0) 返 dbl_offs[idx];
    /* 不去重（C 原版 4858 同）：自举对齐要求 sdat 布局逐字节一致，去重会让 hello 少 8 字节 */
    循环 (sdp % 8 != 0) { 若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); } sdat[sdp++] = 0; }
    dbl_offs[idx] = sdp;
    整 lo = dbl_lo[idx], hi = dbl_hi[idx];
    遍 (整 k = 0; k < 4; k++) { 若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); } sdat[sdp++] = (无 字)((lo >> (8 * k)) & 0xff); }
    遍 (整 k = 0; k < 4; k++) { 若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); } sdat[sdp++] = (无 字)((hi >> (8 * k)) & 0xff); }
    返 dbl_offs[idx];
}

静 整 str_place(整 idx) {
    若 (str_offs[idx] >= 0) 返 str_offs[idx];
    str_offs[idx] = sdp;
    常 字 *s = str_tbl[idx];
    循环 (*s) { 若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); } sdat[sdp++] = (无 字)*s++; }
    若 (sdp >= sdc - 4) { sdc += 256; sdat = realloc(sdat, sdc); }
    sdat[sdp++] = 0; /* NUL terminator */
    返 str_offs[idx];
}
静 空 w4(FILE *f, 整 v) { fputc(v & 0xff, f); fputc((v >> 8) & 0xff, f); fputc((v >> 16) & 0xff, f); fputc((v >> 24) & 0xff, f); }
静 空 w8(FILE *f, 整 v) { w4(f, v); w4(f, 0); } /* 64-bit write: high word ALWAYS 0. The self-host has no real long long; `v >> 32` on a 32-bit value masks the shift count to 0 and re-writes v, so all w8 callers pass <4GB values. */
静 空 w2(FILE *f, 整 v) { fputc(v & 0xff, f); fputc((v >> 8) & 0xff, f); }
静 空 pad(FILE *f, 整 n) { 循环 (n-- > 0) fputc(0, f); }

静 空 write_pe(FILE *f, 整 entry_rva) {
    整 text_rva = 0x1000, text_size = ((cp + 4095) & ~4095);
    若 (text_size < 512) text_size = 512;
    整 text_foff = FILE_ALIGNMENT;
    整 data_rva = data_rva_base; /* dynamic .data base (text may exceed 4KB) */
    整 data_vsize = 0x5000000;   /* .data 80MB virtual: statics + bump heap (compiler needs ~70MB) */
    整 image_size = data_rva + data_vsize + 0x1000; /* SizeOfImage */

    /* DOS Header (64 bytes) */
    fputc('M', f); fputc('Z', f); pad(f, 58);
    w4(f, 64); /* e_lfanew = 64 */

    /* PE Signature */
    fputc('P', f); fputc('E', f); fputc(0, f); fputc(0, f);

    /* COFF Header (20 bytes) */
    w2(f, 0x8664);  /* Machine: x86-64 */
    w2(f, 2);       /* NumberOfSections �?.text + .data */
    w4(f, 0);       /* TimeDateStamp */
    w4(f, 0);       /* PointerToSymbolTable */
    w4(f, 0);       /* NumberOfSymbols */
    w2(f, 0xF0);    /* SizeOfOptionalHeader = 240 (PE32+ with 16 data dirs) */
    w2(f, 0x22E);   /* Characteristics: EXE + large address aware */

    /* Optional Header PE32+ (112 bytes + 16*8 data dirs = 240) */
    w2(f, 0x020B);  /* Magic: PE32+ */
    fputc(0, f); fputc(0, f); /* LinkerVersion */
    w4(f, text_size); /* SizeOfCode */
    w4(f, 8);       /* SizeOfInitializedData �?heap counter */
    w4(f, 0);       /* SizeOfUninitializedData */
    w4(f, entry_rva); /* AddressOfEntryPoint */
    w4(f, text_rva);  /* BaseOfCode */
    w8(f, IMAGE_BASE); /* ImageBase �?low address for 32-bit pointers */
    w4(f, 0x1000);  /* SectionAlignment */
    w4(f, FILE_ALIGNMENT);   /* FileAlignment */
    w2(f, 6); w2(f, 0); /* OSVersion */
    w2(f, 0); w2(f, 0); /* ImageVersion */
    w2(f, 6); w2(f, 0); /* SubsystemVersion */
    w4(f, 0);       /* Win32VersionValue */
    w4(f, image_size); /* SizeOfImage */
    w4(f, FILE_ALIGNMENT);   /* SizeOfHeaders */
    w4(f, 0);       /* CheckSum */
    w2(f, 3);       /* Subsystem: CONSOLE */
    w2(f, 0x8100);  /* DllCharacteristics: NX + TERMINAL_SERVER_AWARE (no DYNAMIC_BASE) */
    w8(f, 0x100000); /* SizeOfStackReserve */
    w8(f, IMAGE_BASE); /* SizeOfStackCommit �?the self-hosted parse recursion (0x2400 frames) needs far more than 64KB */
    w8(f, 0x100000); /* SizeOfHeapReserve */
    w8(f, 0x1000);   /* SizeOfHeapCommit */
    w4(f, 0);       /* LoaderFlags */
    w4(f, 16);      /* NumberOfRvaAndSizes */
    /* data directory 0: exports (none) */
    w4(f, 0); w4(f, 0);
    /* data directory 1: import table (kernel32) */
    w4(f, data_rva_base + 0x1A8); w4(f, 60); /* RVA of import descriptors + size (fix 2026-08-06 BUG-1: 新布局 desc@+0x1A8, 2 dll) */
    /* data directories 2-15: none */
    遍 (整 di = 2; di < 16; di++) { w4(f, 0); w4(f, 0); }

    /* Section Header (40 bytes) —— 节名逐字节（qcc 截断内嵌 NUL） */
    fputc('.', f); fputc('t', f); fputc('e', f); fputc('x', f); fputc('t', f); fputc(0, f); fputc(0, f); fputc(0, f);
    w4(f, text_size);  /* VirtualSize */
    w4(f, text_rva);   /* VirtualAddress */
    w4(f, text_size);  /* SizeOfRawData */
    w4(f, text_foff);  /* PointerToRawData */
    w4(f, 0);          /* PointerToRelocations */
    w4(f, 0);          /* PointerToLinenumbers */
    w2(f, 0);          /* NumberOfRelocations */
    w2(f, 0);          /* NumberOfLinenumbers */
    w4(f, 0x60000020); /* .text: code + execute + read */

    /* .data section header */
    整 data_foff = text_foff + text_size; /* MUST follow .text �?was 0x400, which overlapped code �?12B */
    fputc('.', f); fputc('d', f); fputc('a', f); fputc('t', f); fputc('a', f); fputc(0, f); fputc(0, f); fputc(0, f);
    w4(f, data_vsize);  /* VirtualSize �?80MB: statics + bump heap */
    w4(f, data_rva);    /* VirtualAddress */
    w4(f, 0x4000);      /* SizeOfRawData �?import table + pad only; loader zero-fills the rest */
    w4(f, data_foff);   /* PointerToRawData */
    w4(f, 0); w4(f, 0); w2(f, 0); w2(f, 0);
    w4(f, 0xC0000040);  /* initialized data + read + write */

    /* Pad to text file offset */
    整 pos = (整)ftell(f);
    循环 (pos < text_foff) { fputc(0, f); pos++; }

    /* Write .text */
    fwrite(code, 1, cp, f);

    /* Pad section to raw size */
    整 end = text_foff + text_size;
    pos = (整)ftell(f);
    循环 (pos < end) { fputc(0, f); pos++; }

    /* .data section: write heap counter, then import table
       布局（fix 2026-08-06 BUG-1）：每个 DLL 的 IAT/ILT 独立且以 0 终止
       IAT1@+0x08 (8 kernel32 + term=72B) IAT2@+0x50 (16 msvcrt + term=136B)
       ILT1@+0xD8 (8+term) ILT2@+0x120 (16+term) desc@+0x1A8 (3*20=60B) names@+0x1E4 */
    fseek(f, data_foff, SEEK_SET);
    整 heap_start = IMAGE_BASE + data_rva + DATA_RVA_OFF + 4 * stc_n + 2560; /* argv[64]+tokens then heap */
    w4(f, heap_start); /* heap counter initialized */
    w4(f, 0);          /* padding */
    整 iat1 = 0x08, iat2 = 0x50, ilt1 = 0xD8, ilt2 = 0x120, desc_off = 0x1A8, name_off = 0x1E4;
    整 n_off[24];
    /* IAT/ILT 占位 */
    fseek(f, data_foff + iat1, SEEK_SET); 遍 (整 i = 0; i < 9; i++) w8(f, 0);
    fseek(f, data_foff + iat2, SEEK_SET); 遍 (整 i = 0; i < 17; i++) w8(f, 0);
    fseek(f, data_foff + ilt1, SEEK_SET); 遍 (整 i = 0; i < 9; i++) w8(f, 0);
    fseek(f, data_foff + ilt2, SEEK_SET); 遍 (整 i = 0; i < 17; i++) w8(f, 0);
    /* names（hint 2B + name + \0）：逐个写（避免函数内静态数组 codegen bug） */
    fseek(f, data_foff + name_off, SEEK_SET);
    n_off[0] = (整)ftell(f) - data_foff; w2(f, 0); fputs("GetStdHandle", f); fputc(0, f);
    n_off[1] = (整)ftell(f) - data_foff; w2(f, 0); fputs("WriteFile", f); fputc(0, f);
    n_off[2] = (整)ftell(f) - data_foff; w2(f, 0); fputs("CreateFileA", f); fputc(0, f);
    n_off[3] = (整)ftell(f) - data_foff; w2(f, 0); fputs("ReadFile", f); fputc(0, f);
    n_off[4] = (整)ftell(f) - data_foff; w2(f, 0); fputs("VirtualAlloc", f); fputc(0, f);
    n_off[5] = (整)ftell(f) - data_foff; w2(f, 0); fputs("SetFilePointer", f); fputc(0, f);
    n_off[6] = (整)ftell(f) - data_foff; w2(f, 0); fputs("ExitProcess", f); fputc(0, f);
    n_off[7] = (整)ftell(f) - data_foff; w2(f, 0); fputs("GetCommandLineA", f); fputc(0, f);
    n_off[8] = (整)ftell(f) - data_foff; w2(f, 0); fputs("pow", f); fputc(0, f);
    n_off[9] = (整)ftell(f) - data_foff; w2(f, 0); fputs("atan2", f); fputc(0, f);
    n_off[10] = (整)ftell(f) - data_foff; w2(f, 0); fputs("fmod", f); fputc(0, f);
    n_off[11] = (整)ftell(f) - data_foff; w2(f, 0); fputs("sqrt", f); fputc(0, f);
    n_off[12] = (整)ftell(f) - data_foff; w2(f, 0); fputs("cos", f); fputc(0, f);
    n_off[13] = (整)ftell(f) - data_foff; w2(f, 0); fputs("sin", f); fputc(0, f);
    n_off[14] = (整)ftell(f) - data_foff; w2(f, 0); fputs("tan", f); fputc(0, f);
    n_off[15] = (整)ftell(f) - data_foff; w2(f, 0); fputs("acos", f); fputc(0, f);
    n_off[16] = (整)ftell(f) - data_foff; w2(f, 0); fputs("asin", f); fputc(0, f);
    n_off[17] = (整)ftell(f) - data_foff; w2(f, 0); fputs("atan", f); fputc(0, f);
    n_off[18] = (整)ftell(f) - data_foff; w2(f, 0); fputs("log", f); fputc(0, f);
    n_off[19] = (整)ftell(f) - data_foff; w2(f, 0); fputs("log10", f); fputc(0, f);
    n_off[20] = (整)ftell(f) - data_foff; w2(f, 0); fputs("exp", f); fputc(0, f);
    n_off[21] = (整)ftell(f) - data_foff; w2(f, 0); fputs("floor", f); fputc(0, f);
    n_off[22] = (整)ftell(f) - data_foff; w2(f, 0); fputs("ceil", f); fputc(0, f);
    n_off[23] = (整)ftell(f) - data_foff; w2(f, 0); fputs("fabs", f); fputc(0, f);
    整 kdll = (整)ftell(f) - data_foff; fputs("kernel32.dll", f); fputc(0, f);
    整 mdll = (整)ftell(f) - data_foff; fputs("msvcrt.dll", f); fputc(0, f);
    /* 回填 IAT1（8 + term） */
    fseek(f, data_foff + iat1, SEEK_SET);
    遍 (整 i = 0; i < 8; i++) w8(f, data_rva_base + n_off[i]);
    w8(f, 0);
    /* 回填 IAT2（16 + term） */
    fseek(f, data_foff + iat2, SEEK_SET);
    遍 (整 i = 0; i < 16; i++) w8(f, data_rva_base + n_off[8 + i]);
    w8(f, 0);
    /* 回填 ILT1/ILT2 */
    fseek(f, data_foff + ilt1, SEEK_SET);
    遍 (整 i = 0; i < 8; i++) w8(f, data_rva_base + n_off[i]);
    w8(f, 0);
    fseek(f, data_foff + ilt2, SEEK_SET);
    遍 (整 i = 0; i < 16; i++) w8(f, data_rva_base + n_off[8 + i]);
    w8(f, 0);
    /* import descriptors: kernel32 (IAT1/ILT1), msvcrt (IAT2/ILT2) */
    fseek(f, data_foff + desc_off, SEEK_SET);
    w4(f, data_rva_base + ilt1);  /* kernel32 OriginalFirstThunk */
    w4(f, 0); w4(f, 0);
    w4(f, data_rva_base + kdll);  /* Name */
    w4(f, data_rva_base + iat1);  /* FirstThunk */
    w4(f, data_rva_base + ilt2);  /* msvcrt OriginalFirstThunk */
    w4(f, 0); w4(f, 0);
    w4(f, data_rva_base + mdll);  /* Name */
    w4(f, data_rva_base + iat2);  /* FirstThunk */
    遍 (整 di = 0; di < 5; di++) w4(f, 0); /* terminator descriptor */
    /* pad .data to raw size */
    fseek(f, data_foff + DATA_RVA_OFF, SEEK_SET);
    pos = (整)ftell(f);
    整 data_end = data_foff + 0x4000;
    循环 (pos < data_end) { fputc(0, f); pos++; }
}

