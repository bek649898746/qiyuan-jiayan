静 整 var_stidx(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].st_idx;
    返 -1;
}
静 整 var_pesz(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].p_esz;
    返 0;
}
/* ginit slot index for a function-local static with an initializer (emitted at main
