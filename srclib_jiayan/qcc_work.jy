                              整 _fcs = (!st_field_is_ptr(si, fname) && _fty >= 0 && stypes[_fty].sz > 8) ? stypes[_fty].sz : 0; /* fix 2026-08-22 t46: static struct 字段整体赋值 (oi.oid = ref->objectname — 文件级 static expand_data 的 object_id 成员) — 原无 _fok 逻辑 → fsz=36 落 else 只存 4 字节 → branch "missing object" */
