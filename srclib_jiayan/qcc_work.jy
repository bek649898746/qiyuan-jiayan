/* MOV r32, imm32 for high registers (r8-r15): B8+reg only encodes 0-7, so prefix REX.B. */
静 空 mov_ri_ext(整 reg, 整 imm) { asm_emit("    移动 r%d, %d\n", (字*)(长)(整)reg, (字*)(长)(整)imm, 0); 若 (reg & 8) b(0x41); b(0xB8 | (reg & 7)); b4(imm); }

/* Mini-CRT entry stub (hand-emitted): GetCommandLineA �?copy-tokenize argv into a
   static .data area (argv[64] at statics, token strings right after) �?call
   main(argc, argv) �?ExitProcess.
   Registers: r10=cmdline r11=scan idx r12=&argv[0] r13=&token_area(advancing)
   r14=argc r8=token_start r15=saved rsp. Each token is NUL-terminated in the copy. */
静 空 emit_crt_stub(空) {
    asm_emit("\n; === CRT ===\n_入口:\n", 0, 0, 0);
    整 argv_va = IMAGE_BASE + data_rva_base + DATA_RVA_OFF + 4 * stc_n; /* .data static area for argv[64] */
    crt_entry_off = cp; /* entry point = start of this stub */
    /* 自切栈：立即�?rsp 切到 .data 内的高地址区（62MB 偏移处），完全脱�?loader �?
       （loader 把主线程栈放在镜�?SizeOfImage 内部 ~91.6-92.6MB，页面不可靠 �?
       deep parse 帧读 SIGSEGV）。固�?62MB 偏移：栈向下 1MB 仍在 .data 段内�?
       且高�?heap 终点（~48MB）；被编译程序没�?__stack 静态，不能用静态末尾�?*/
    整 stk_top = IMAGE_BASE + data_rva_base + 0x4400000;
    mov_ri_ext(4, stk_top);     /* mov rsp, stk_top (32�?imm，零扩展) */
    mov_rr64(15, 4);        /* r15 = rsp (自切栈顶) */
    mov_ri_ext(12, argv_va);          /* r12 = &argv[0] */
    mov_ri_ext(13, argv_va + 512);    /* r13 = token area start */
    /* GetCommandLineA() */
    asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
    sub_rsp_imm(32);
    call_iat(7);            /* GetCommandLineA �?rax */
    add_rsp_imm(32);
    mov_rr64(10, 0);        /* r10 = cmdline */
    mov_rr64(4, 15);        /* rsp = r15 */
    mov_ri_ext(11, 0);      /* r11 = i (scan idx) */
    mov_ri_ext(14, 0);      /* r14 = argc */
    整 louter = new_label(), lcopy = new_label(), lend_s = new_label(), lend_n = new_label(), lrec = new_label(), lskip = new_label(), ldone = new_label();
    set_label(louter);
    asm_emit("    零扩展 SIB\n", 0, 0, 0); b(0x43); b(0x0F); b(0xB6); b(0x04); b(0x1A); /* movzx eax, byte [r10+r11] */
    mov_rr(1, 0);           /* ecx = c */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ldone, 1);
    mov_r_imm(0, 0x20); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lskip, 1); /* cmp ecx,' ' */
    mov_rr64(8, 13);        /* r8 = token_start (r13) */
    set_label(lcopy);
    asm_emit("    零扩展 SIB\n", 0, 0, 0); b(0x43); b(0x0F); b(0xB6); b(0x04); b(0x1A); /* movzx eax, byte [r10+r11] */
    mov_rr(1, 0);           /* ecx = c */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lend_n, 1);
    mov_r_imm(0, 0x20); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lend_s, 1); /* cmp ecx,' ' */
    asm_emit("    存字节帧\n", 0, 0, 0); b(0x41); b(0x88); modrm(1, 1, 5); b(0); /* mov byte [r13+0], cl */
    asm_emit("    自增 r11\n", 0, 0, 0); b(0x41); b(0xFF); modrm(3, 0, 3); /* inc r11d */
    asm_emit("    自增 r13\n", 0, 0, 0); b(0x41); b(0xFF); modrm(3, 0, 5); /* inc r13d */
    jmp_rel(-1); patch_label(cp-4, lcopy, 2);
    set_label(lend_s); /* token ended at a space: NUL-terminate, skip the space */
    asm_emit("    存字节0\n", 0, 0, 0); b(0x41); b(0xC6); modrm(1, 0, 5); b(0); b(0); /* mov byte [r13+0], 0 (imm8!) */
    asm_emit("    自增 r13\n", 0, 0, 0); b(0x41); b(0xFF); modrm(3, 0, 5); /* inc r13d */
    asm_emit("    自增 r11\n", 0, 0, 0); b(0x41); b(0xFF); modrm(3, 0, 3); /* inc r11d */
    jmp_rel(-1); patch_label(cp-4, lrec, 2);
    set_label(lend_n); /* token ended at NUL: terminate; outer loop will finish */
    asm_emit("    存字节0\n", 0, 0, 0); b(0x41); b(0xC6); modrm(1, 0, 5); b(0); b(0); /* mov byte [r13+0], 0 (imm8!) */
    set_label(lrec);
    asm_emit("    存栈索引\n", 0, 0, 0); b(0x4F); b(0x89); b(0x04); b(0xF4); /* mov [r12+r14*8], r8 (REX.W+R+X+B) */
    asm_emit("    自增 r14\n", 0, 0, 0); b(0x41); b(0xFF); modrm(3, 0, 6); /* inc r14d */
    jmp_rel(-1); patch_label(cp-4, louter, 2);
    set_label(lskip); /* space between tokens */
    asm_emit("    自增 r11\n", 0, 0, 0); b(0x41); b(0xFF); modrm(3, 0, 3); /* inc r11d */
    jmp_rel(-1); patch_label(cp-4, louter, 2);
    set_label(ldone);
    mov_rr64(1, 14);        /* rcx = argc */
    mov_rr64(2, 12);        /* rdx = &argv[0] */
    mov_rr64(4, 15);        /* rsp = r15 (argv lives in .data; frame may grow over old stack) */
    asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
    sub_rsp_imm(32);        /* shadow space */
    {
        整 mi = func_find("main");
        若 (mi < 0 || !func_tbl[mi].defined) mi = func_find("主"); /* 甲言: 主() = main() */
        call_rel(0);
        patch_label(cp - 4, func_tbl[mi].label, 0); /* call main */
    }
    add_rsp_imm(32);
    mov_rr(1, 0);           /* ecx = main's return code */
    asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0);
    sub_rsp_imm(32);
    call_iat(6);            /* ExitProcess �?never returns */
}

/* two-pass generation support: root_global/g_lc_save/g_rsp_save/entry_rva_global at file scope */
空 gen_code(空) {
    /* reset codegen state for two-pass (pass 1 estimates .data base, pass 2 real) */
    cp = 0; patch_n = 0; strpn = 0; fnpn = 0; dbl_patch_n = 0; sdp = 0; gfn = 0;
    若 (asm_pass == 1) dbl_n = parse_dbl_n; /* 两遍同起点；pass2 保持 pass1 的最终 dbl_n（negate 去重后不再新增）*/
    func_n = 0; /* MUST re-register all functions in pass 2 with FRESH labels �?
                   otherwise pass-2 new_label() numbers overlap the pass-1 function
                   labels and epilogue/return jumps resolve to the wrong functions. */
    lc = g_lc_save; rsp_used = g_rsp_save;
    memset(str_offs, -1, 1024 * 4);;
    memset(dbl_offs, -1, 1024 * 4);;
    /* label_pos/label_set MUST be cleared per pass: pass 2 re-uses pass 1's label
       IDs (lc = g_lc_save) but a label that pass 2 never re-sets would keep a stale
       pass-1 position, and resolve_patches would emit a jump to the wrong function
       (e.g. into macro_find's body -> strcmp with a NULL name -> SIGSEGV). */
    memset(label_pos, 0, MAX_LABELS * 4);;
    memset(label_set, 0, MAX_LABELS * 4);;

    /* generate code */
    /* pre-mark all function labels as defined so calls before the definition
       (forward declaration) resolve as user calls, not builtins */
    遍 (整 i = 0; i < 256; i++) {
        整 c = child_i(root_global, i);
        若 (c <= 0) 续;
        { 静 整 pcnt2 = 0; pcnt2++; (空)pcnt2; }
        整 fi = func_find((字*)(nn + c));
        func_tbl[fi].defined = 1;
    }
    fnpn = 0;
    parse_base = 0; /* codegen lookups use vs_end (=fve[gfn]), not the parse-time floor */
    /* 每函数独立局部帧（root-cause 2026-08-03 从 C 原版 5169-5176 移植）：
       帧大小 = 本函数 vars 足迹 (fr_end[gfn]-fr_start[gfn]) + 272（影子区+scratch+sret），
       各 var 落在 [rsp + (off-fr_start)]。避免全局累计帧导致超大栈帧 → 深递归栈溢出。 */


    遍 (整 i = 0; i < 256; i++) {
        整 c = child_i(root_global, i);
        若 (c <= 0) 续;

        /* function definition */
        字 *fname = (字*)(nn + c);
        整 fi = func_find(fname);
        strcpy(cur_fn_name, fname); /* for case-6 double-return routing */
        set_label(func_tbl[fi].label);
        asm_emit("\n; === %s ===\n%s:\n", fname, fname, 0); /* 函数名标签，供 FN:name 补丁解析 */
        func_tbl[fi].defined = 1;
        cur_ret_si = (fi >= 0 && fi < 512 && fn_ret_si_map[fi] >= 0) ? fn_ret_si_map[fi] : fn_ret_name_get(fname); /* sret return handling in case-6 (name-keyed: func_tbl indexes renumber in pass 2) */
        cur_fn_sret = (cur_ret_si >= 0 && stypes[cur_ret_si].sz > 8); /* sret fn: params shift (rcx = hidden ptr); double param k in xmm[k] */

        整 fn_frame = (fr_end[gfn] - fr_start[gfn]) + 4368; /* fix 2026-08-06: 272 状态区 + 4096 printf 缓冲（审计 P1），16 对齐 */ /* fix 2026-08-06: 272→4096，审计 P1：printf scratch 扩到 4KB（16 对齐） */ /* 本函数局部帧 (C 原版 5172) */
        cur_frame_sz = fr_start[gfn] + fn_frame; /* 51 处 `off - cur_frame_sz` 不变 */
        scratch_base = cur_frame_sz - 272; /* fix 2026-08-06: 状态区 [rbp-272..]，printf 缓冲在其下 */
        sret_ptr_off = cur_frame_sz - 8;   /* sret 槽在 [rbp-8] */

        push_r(5);  /* push rbp */
        push_r(3);  /* push rbx (callee-saved �?used as cross-call temp) */
        mov_rr64(5, 4); /* mov rbp, rsp */
        sub_rsp_imm(fn_frame); /* shadow space + locals */
        若 (cur_fn_sret) mov_mbrp_reg64(sret_ptr_off - cur_frame_sz, 1); /* save the hidden sret pointer (rcx) — inner calls clobber it */

        /* copy incoming params into frame slots (reg params from rcx/rdx/r8/r9,
           stack params from [rbp+pdisp]) �?params live in slots, so recursive /
           nested calls can't clobber the parameter registers.
           Pointer params (p_esz>0) are copied 64-bit to keep full addresses.
           Only THIS function's vars [fvb[gfn], fve[gfn]) �?all 109 functions share
           vars[], copying every param into every prologue would clobber live slots. */
        整 fv0 = fvb[gfn], fv1 = fve[gfn];
        vs_end = fv1; /* scope var lookups to this function during codegen */
        遍 (整 vi = fv0; vi < fv1; vi++) {
            若 (vars[vi].is_param) {
                若 (vars[vi].is_dbl) {
                    /* double param: xmm[preg→xmm] (reg) or [rbp+pdisp] (stack). 8 bytes. */
                    若 (vars[vi].pstk) { movsd_xmm0_mbrp(vars[vi].pdisp); movsd_mbrp_xmm0(vars[vi].rsp_off - cur_frame_sz); }
                    否 若 (cur_fn_sret) movsd_mbrp_xmmreg(vars[vi].rsp_off - cur_frame_sz, vars[vi].pslot); /* sret fn: double param k lives in xmm[k] */
                    否 movsd_mbrp_xmmreg(vars[vi].rsp_off - cur_frame_sz, preg_to_xmm(vars[vi].preg));
                } 否 若 (vars[vi].pstk) {
                    若 (vars[vi].p_esz > 0 || (vars[vi].st_idx >= 0 && vars[vi].st_sz > 0 && vars[vi].st_sz <= 8) || vars[vi].is_ll) { mov_reg_mbrp64(0, vars[vi].pdisp); mov_mbrp_reg64(vars[vi].rsp_off - cur_frame_sz, 0); }
                    否 { mov_reg_mbrp(0, vars[vi].pdisp); mov_mbrp_reg(vars[vi].rsp_off - cur_frame_sz, 0); }
                } 否 若 (vars[vi].p_esz > 0 || (vars[vi].st_idx >= 0 && vars[vi].st_sz > 0 && vars[vi].st_sz <= 8) || vars[vi].is_ll) mov_mbrp_reg64(vars[vi].rsp_off - cur_frame_sz, vars[vi].preg); /* long long 参数: 64 位保存（fix 2026-08-05） */
                否 mov_mbrp_reg(vars[vi].rsp_off - cur_frame_sz, vars[vi].preg);
            }
        }

        /* epilogue label: return jumps here */
        epi_label = new_label();

        若 (!strcmp(fname, "main") || !strcmp(fname, "主")) { /* emit global initializers at program entry (甲言: 主() = main()) */
            cg_ginit_ctx = 1; /* ginit decls must NOT be skipped by case-7's local-static check */
            遍 (整 gi = 0; gi < ginit_n; gi++) cg(ginit[gi]);
            cg_ginit_ctx = 0;
        }

        cg(n0[c]); /* function body */
        gfn++; /* next function's var range */

        /* epilogue */
        set_label(epi_label);
        add_rsp_imm(fn_frame);
        pop_r(3); /* pop rbx */
        pop_r(5); /* pop rbp */
        ret();
    }

    /* mini-CRT entry stub: provides argc/argv, calls main, exits with its code.
       Emitted in BOTH passes (pass 2 overwrites pass 1 identically). */
    emit_crt_stub();

    /* ????????? */
    resolve_patches();

    /* 重建 sdat：字符串先、double 后，均按索引序（C 原版 5137-5138：字符串在前！）。
       asm_zh 按 .浮点 发射位次填充 dbl_offs2[]、引用按索引解析，
       故必须保证 dbl_offs[di]/str_offs[si] 随索引单调递增（放置序==索引序），
       -S 发射序（偏移序）== 索引序，H2 位次解析 == H1 直接引用。 */
    sdp = 0;
    memset(str_offs, -1, 1024 * 4);
    memset(dbl_offs, -1, 1024 * 4);
    遍 (整 si = 0; si < str_cnt; si++) str_place(si); /* 字符串先（C 原版 5137） */
    遍 (整 di = 0; di < dbl_n; di++) dbl_place(di);   /* double 后 */

    /* ??????????? patch imm32 in mov_r_imm ??actual VA (ImageBase + RVA) */
    整 code_end = cp;
    遍 (整 i = 0; i < strpn; i++) {
        整 si = str_patches[i].str_idx;
        整 off = str_offs[si]; /* byte offset within string data */
        整 rva = IMAGE_BASE + 0x1000 + code_end + off; /* ImageBase(IMAGE_BASE) + text_rva + code + off */
        b4_at(str_patches[i].patch_at, rva);
    }
    /* patch function-address imm32s (fn ptr assignment) to actual VA */
    遍 (整 i = 0; i < fnpn; i++) {
        整 rva = IMAGE_BASE + 0x1000 + label_pos[fn_patches[i].label];
        b4_at(fn_patches[i].patch_at, rva);
    }
    /* patch double-literal rip-relative disp32s: target VA = text_rva + code_end + dbl_off.
       movsd xmm0,[rip+disp32] is 8 bytes (F2 0F 10 05 + disp4); disp sits at patch_at
       (4 bytes into the instruction), so the RIP base is patch_at+4 (end of instruction). */
    遍 (整 i = 0; i < dbl_patch_n; i++) {
        整 di = dbl_patches[i].dbl_idx;
        整 off = dbl_offs[di];
        整 rva = IMAGE_BASE + 0x1000 + code_end + off;
        b4_at(dbl_patches[i].patch_at, rva - (IMAGE_BASE + 0x1000 + dbl_patches[i].patch_at + 4));
    }
    /* ????????????????????*/
    若 (sdp > 0) {
        循环 (cp + sdp >= IMAGE_BASE) { cc += 4096; code = realloc(code, cc); } /* C 原版 5259：与 4MB 常量比较，不依赖 cc 全局写 */
        memcpy(code + cp, sdat, sdp);
        cp += sdp;
    }

    /* data section ASM directives for round-trip（C 原版 5265：.data 标记） */
    asm_emit("\n; === .data ===\n", 0, 0, 0);

    /* -S 模式: 发射数据指令（.字串/.浮点/.堆计/.布局），对齐 qcc_x86.c 5264-5313。
       .浮点 按 sdat 偏移序发射（double 可能共享早期槽位，索引序会错位）。 */
    遍 (整 kk = 0; kk < dbl_n; kk++) dbl_used[kk] = 0;
    遍 (整 si = 0; si < str_cnt; si++) {
        整 off = str_offs[si];
        /* 在 string 前发射所有偏移更小且未发射的 double（按偏移序） */
        遍 (整 iter = 0; iter < dbl_n; iter++) {
            整 best = -1; 整 best_off = off;
            遍 (整 di = 0; di < dbl_n; di++) {
                若 (dbl_used[di] == 0 && dbl_offs[di] >= 0 && dbl_offs[di] < off && dbl_offs[di] < best_off) { best = di; best_off = dbl_offs[di]; }
            }
            若 (best < 0) 断;
            dbl_used[best] = 1;
            整 lo = dbl_lo[best]; 整 hi = dbl_hi[best];
            无 字 db[8];
            db[0] = lo & 0xff; db[1] = (lo >> 8) & 0xff; db[2] = (lo >> 16) & 0xff; db[3] = (lo >> 24) & 0xff;
            db[4] = hi & 0xff; db[5] = (hi >> 8) & 0xff; db[6] = (hi >> 16) & 0xff; db[7] = (hi >> 24) & 0xff;
            双 v; memcpy(&v, db, 8);
            asm_emit_dbl(".浮点 %f\n", v);
        }
        若 (off >= 0) {
            asm_emit(".字串 \"", 0, 0, 0);
            整 k = 0; 循环 (k < 511 && str_tbl[si][k] != 0) {
                整 ch = str_tbl[si][k];
                若 (ch == '"') asm_emit("\\\"", 0, 0, 0);
                否 若 (ch == '\\') asm_emit("\\\\", 0, 0, 0);
                否 若 (ch == '\n') asm_emit("\\n", 0, 0, 0);
                否 若 (ch == '\t') asm_emit("\\t", 0, 0, 0);
                否 asm_emit("%c", (字*)(整)(整)ch, 0, 0);
                k = k + 1;
            }
            asm_emit("\"\n", 0, 0, 0);
        }
    }
    /* 尾部: 发射剩余未发射的 double（按偏移序） */
    遍 (整 iter2 = 0; iter2 < dbl_n; iter2++) {
        整 best = -1; 整 best_off = 0x7fffffff;
        遍 (整 di = 0; di < dbl_n; di++) {
            若 (dbl_used[di] == 0 && dbl_offs[di] >= 0 && dbl_offs[di] < best_off) { best = di; best_off = dbl_offs[di]; }
        }
        若 (best < 0) 断;
        dbl_used[best] = 1;
        整 lo = dbl_lo[best]; 整 hi = dbl_hi[best];
        无 字 db[8];
        db[0] = lo & 0xff; db[1] = (lo >> 8) & 0xff; db[2] = (lo >> 16) & 0xff; db[3] = (lo >> 24) & 0xff;
        db[4] = hi & 0xff; db[5] = (hi >> 8) & 0xff; db[6] = (hi >> 16) & 0xff; db[7] = (hi >> 24) & 0xff;
        双 v; memcpy(&v, db, 8);
        asm_emit_dbl(".浮点 %f\n", v);
    }
    asm_emit("\n.堆计 %d\n", (字*)(整)(整)stc_n, 0, 0);
    /* 告诉 asm_zh 精确 code_end 与 data_base（C 原版 5313） */
    asm_emit(".布局 code_end=%d data_base=0x%X\n", (字*)(整)(整)(cp - sdp), (字*)(整)(整)data_rva_base, 0);

    /* ??main ???????? �?mini-CRT stub is the real entry (it calls main) */
    整 entry_rva = 0x1000 + crt_entry_off;
    entry_rva_global = entry_rva;
}

/* Read a file into a malloc'd NUL-terminated string (NULL on failure).
   REAL function, NOT a macro: the lexer skips function-like macro definitions
   (#define F(x) ...), so a macro call would compile as an undefined function
   and the self-hosted compiler could never read its input. */
静 字 *read_file(常 字 *path) {
    字 *b = NULL;
    FILE *f;
    整 sz;
    f = fopen(path, "rb");
    若 (f) {
        fseek(f, 0, 2); /* SEEK_END */
        sz = ftell(f);
        rewind(f);
        若 (sz > 0 && sz <= 1048576) {
            b = malloc(sz + 1);
            fread(b, 1, sz, f);
            b[sz] = 0;
        }
        fclose(f);
    }
    返 b;
}

/* 自切栈：loader 把主线程栈放在镜�?SizeOfImage 内部（~91.6-92.6MB），页面不可�?
   （deep parse 帧读 SIGSEGV）。本数组必须是【最后一个文件级静态】：CRT stub 入口
   �?rsp 切到这里，栈�?= heap 起点，栈向下增长、heap 向上增长，背靠背互不侵犯�?*/
__attribute__((unused))
静 字 __stack[0x100000];

整 main(整 argc, 字 **argv) {
    /* 内置标准宏：NULL 必须 = 0。qcc_work 忽略 #include，源文件的 NULL
       （来自 stdio.h 等）若不注册会被当作未定义标识符→隐式函数地址，
       导致 `X = NULL;` 初始化器静默丢失。 */
    macro_add("NULL", 0);
    常 字 *src = "int main() { return 42; }";
    常 字 *outf = NULL;
    整 argi = 1;
    字 *hdrs = NULL; 整 hdr_len = 0, hdr_cap = 0;
    字 *all_src = NULL; 整 all_len = 0;

    循环 (argc > argi) {
        若 (strcmp(argv[argi], "--help") == 0) {
            printf("qcc_x86 v5.0\nUsage: qcc_x86 [-I header.h] [-o out.exe] file.c [file2.c ...]\n");
            返 0;
        }
        若 (strcmp(argv[argi], "--test") == 0) { printf("qcc_x86 selftest PASS\n"); 返 0; }
        若 (strcmp(argv[argi], "-S") == 0) { asm_mode = 1; argi++; 续; }
        若 (strcmp(argv[argi], "-o") == 0 && argc > argi + 1) { outf = argv[argi + 1]; argi += 2; 续; }
        若 (strcmp(argv[argi], "-I") == 0 && argc > argi + 1) {
            字 *hb = read_file(argv[argi + 1]);
            若 (hb) {
                整 hl = (整)strlen(hb);
                若 (hdr_len + hl + 2 >= hdr_cap) { hdr_cap = hdr_len + hl + 4096; hdrs = realloc(hdrs, hdr_cap); }
                memcpy(hdrs + hdr_len, hb, hl); hdr_len += hl;
                hdrs[hdr_len++] = '\n'; hdrs[hdr_len] = 0;
                free(hb);
            }
            argi += 2; 续;
        }
        /* input file */
        字 *fb = read_file(argv[argi]);
        若 (!fb) { fprintf(stderr, "qcc_x86: cannot open %s\n", argv[argi]); 返 1; }
        整 fl = (整)strlen(fb);
        all_src = realloc(all_src, all_len + fl + 2);
        memcpy(all_src + all_len, fb, fl); all_len += fl;
        all_src[all_len++] = '\n'; all_src[all_len] = 0;
        free(fb);
        argi++;
    }
    若 (all_len > 0) {
        整 total = hdr_len + all_len + 2;
        字 *combined = malloc(total);
        整 pos = 0;
        若 (hdr_len > 0) { memcpy(combined, hdrs, hdr_len); pos = hdr_len; }
        memcpy(combined + pos, all_src, all_len); pos += all_len;
        combined[pos] = 0;
        src = combined;
        free(all_src);
    }
    free(hdrs);
    若 (!outf) {
        静 字 of[512]; strcpy(of, "a.exe"); outf = of;
    }

    若 (asm_mode) {
        字 af[512]; strcpy(af, outf);
        strcat(af, ".asm"); /* fix 2026-08-05：原去掉 .exe 再拼 .asm → `qcc -S f.c` 写 a.asm 却打印 a.exe.asm；现统一 outf+".asm" */
        asm_out = fopen(af, "wb");
    }

    /* prepend the self-host runtime (qcc_rt.c): heap realloc, fseek/ftell/rewind,
       exit/abort, strcpy/strncmp/isdigit/isalpha shadow the broken inline stubs.
       Every compiled program gets it, so stage2 is self-contained.
       NOTE: copy from src (the combined buffer), NOT all_src �?all_src is already
       free()d by the combined block above (use-after-free). */
    {
        字 *rtb = read_file("srclib/qcc_rt.c");
        若 (!rtb) rtb = read_file("qcc_rt.c");
        若 (!rtb && argc > 1) { /* cwd 无关: 基于源码路径推导运行时 (fix 2026-08-05: 原相对 cwd, 非根目录编译静默缺运行时) */
            字 sp[1024];
            strncpy(sp, argv[1], 1023); sp[1023] = 0;
            字 *sl = strrchr(sp, '/');
            字 *bs = strrchr(sp, '\\');
            字 *last = sl && bs ? (sl > bs ? sl : bs) : (sl ? sl : bs);
            若 (last) {
                *last = 0;
                strcat(sp, "/srclib/qcc_rt.c");
                rtb = read_file(sp);
            }
        }
        若 (rtb) {
            整 rl = (整)strlen(rtb);
            整 al = (整)strlen(src);
            字 *combined2 = malloc(rl + al + 2);
            memcpy(combined2, rtb, rl);
            combined2[rl] = '\n';
            memcpy(combined2 + rl + 1, src, al);
            combined2[rl + 1 + al] = 0;
            src = combined2;
            free(rtb);
        }
    }

    fn_macro_collect(src); /* 函数式宏: 收集定义, lex 前展开调用 (fix 2026-08-05) */
    若 (fn_macro_n > 0) { /* 无函数式宏时跳过 expand —— 避免大源码复制 */
        字 *msrc = fn_macro_expand(src);
        若 (msrc && msrc[0]) { src = msrc; }
    }

    tt = calloc(TS, 4); tv = calloc(TS, 4); tn = calloc(TS, 32); nn = calloc(ASZ, 32); tuns = calloc(TS, 4); tll = calloc(TS, 4); tll_hi = calloc(TS, 4); /* unsigned/LL 后缀/LL 字面量高32 标记（fix 2026-08-05） */
    nll_hi = _va_alloc(ASZ * 4); /* per-node LL 字面量高32（动态：静态 1MB 数组使 cf_1 .data 超限，fix 2026-08-05） */
    nt = _va_alloc(ASZ * 4); nv = _va_alloc(ASZ * 4); n0 = _va_alloc(ASZ * 4); n1 = _va_alloc(ASZ * 4);
    n2 = _va_alloc(ASZ * 4); n3 = _va_alloc(ASZ * 4); n4 = _va_alloc(ASZ * 4); n5 = _va_alloc(ASZ * 4);
    n6 = _va_alloc(ASZ * 4); n7 = _va_alloc(ASZ * 4); n8 = _va_alloc(ASZ * 4); n9 = _va_alloc(ASZ * 4);
