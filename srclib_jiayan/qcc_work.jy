否 若 (afsz == 2) { 若 (st_field_is_uns(stypes[s].name, fn)) ir_emit(I_MOVZX_RAX_WORD, 0, 0, 0); 否 ir_emit(I_MOVSX_RAX_WORD, 0, 0, 0); ir_flush(); } /* Phase3-IR case15: ptr->field short (fix 2026-08-29 csmith: 原恒 movzx — int16 字段零扩展) */
                    否 { ir_emit(I_DEREF32, 0, 0, 0); ir_flush(); 若 (st_field_bitw(stypes[s].name, fn) > 0) bf_extract(stypes[s].name, fn); 若 (st_field_is_uns(stypes[s].name, fn)) nuns[n] = 1; } /* Phase3-IR case15: ptr->field dword + bit-field — fix 2026-08-30: unsigned 字段 nuns */
                } 否 若 (var_isstatic(vn)) {
