    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "挤压")) { /* 接入 2026-08-27 压缩删除匹配 (compact/remove): 挤压 dst, src, n, cond; → { __sq=0; __sj=0; while(__sj<n){ if(cond(src[__sj])!=0){ dst[__sq]=src[__sj]; __sq++; } __sj++; } } — 删除 cond 为真的元素, 剩余依次前移 (与过滤互补) */
        tk++; /* 挤压 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_cond = expr(); /* 删除条件 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 sq_seq = 0; 字 iname[64]; sprintf(iname, "__sq_%d_", sq_seq++);
