静 整 dbl_place(整 idx);

静 空 cgc(整 n) {
    cg(n0[n]); /* lhs ??eax */
    push_r(0); /* save lhs on stack (nesting- and call-safe) */
    cg(n1[n]); /* rhs ??eax */
    pop_r(3);  /* ebx = lhs */
    alu_rr(T_QK, 3, 0); /* cmp ebx(lhs), eax(rhs) ??flags = lhs - rhs */
    整 o = nv[n];
    若 (expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n])) setcc_u(o); 否 setcc(o); /* fix 2026-08-06 M1 */
    movzx_eax_al();
}

/* printf/fprintf/putstr: build output into a frame scratch buffer, then WriteFile.
   r10=handle r11=fmt r12=buf(advancing) r14=buf(start) r13=next-format-arg ptr.
   No calls until the final WriteFile, so volatile registers are safe throughout. */
静 整 emit_fmt_loop(整 bound_disp);
静 空 mov_ri_ext(整 reg, 整 imm); /* high-reg immediate mov (defined near CRT stub) */
/* bit-field codegen helpers (real bit semantics, fix 2026-08-05). */
静 空 bf_shl_imm(整 reg, 整 cnt) { /* shl r32, cl  (cnt compile-time 0..31) */
    若 (cnt <= 0) 返;
    mov_ri_ext(9, cnt);
    mov_rr(1, 9); /* ecx = cnt */
    rex(0, 0, 0, reg & 8); b(0xD3); modrm(3, 4, reg & 7);
}
静 空 bf_extract(常 字 *sn, 常 字 *fn) {
    /* eax = whole slot value → eax = field value (shr + and; signed fields sign-extend). */
    整 bw = st_field_bitw(sn, fn);
    若 (bw <= 0) 返;
    整 bitof = st_field_bitof(sn, fn);
    整 mask = bw >= 32 ? -1 : (1 << bw) - 1;
    若 (bitof == 0) { mov_ri_ext(9, mask); alu_rr(25, 0, 9); } /* eax &= mask */
    否 {
        mov_rr(10, 0); /* r10d = slot value */
        mov_ri_ext(9, bitof);
        mov_rr(0, 9); /* eax = bit offset (shift count) */
        g_uns_shift = 1;
        alu_rr(T_SR, 10, 0); /* r10d >>= cl (logical) */
        mov_rr(0, 10); /* eax = shifted field value */
        mov_ri_ext(9, mask);
        alu_rr(25, 0, 9); /* eax &= mask */
    }
    若 (bw < 32 && !st_field_is_uns(sn, fn)) { /* signed 位域：符号扩展（fix 2026-08-05） */
        mov_rr(10, 0); /* r10d = masked field value */
        mov_ri_ext(9, 32 - bw);
        mov_rr(0, 9); /* eax = 32-bw (shift count) */
        alu_rr(T_SH, 10, 0); /* r10d <<= cl → 符号位到 bit31 */
        g_uns_shift = 0; /* 算术右移（signed） */
        alu_rr(T_SR, 10, 0); /* r10d >>= cl (sar) → 符号扩展 */
        mov_rr(0, 10); /* eax = 结果 */
    }
}
静 整 bf_store(常 字 *sn, 常 字 *fn) {
    /* rax = &slot, ebx = rhs value → read-modify-write the field bits.
       Returns 1 when handled (a bit-field), 0 for a plain field.
       NEVER write eax here: eax is the low 32 bits of rax, and rax holds the
       slot ADDRESS — writing eax zeroes the upper half and loses the address. */
    整 bw = st_field_bitw(sn, fn);
    若 (bw <= 0) 返 0;
    整 bitof = st_field_bitof(sn, fn);
    整 fm = bw >= 32 ? -1 : ((1 << bw) - 1) << bitof;
    mov_reg_mreg(10, 0); /* r10d = [rax] = old slot (rax keeps the address) */
    mov_rr(11, 3); /* r11d = rhs */
    bf_shl_imm(11, bitof); /* r11d <<= bitof */
    mov_ri_ext(9, fm);
    alu_rr(25, 11, 9); /* r11d &= field-bits mask */
    mov_ri_ext(9, ~fm);
    alu_rr(25, 10, 9); /* r10d &= ~field-bits mask (clear field bits) */
    alu_rr(47, 10, 11); /* r10d |= r11d */
    asm_emit("    存32rax r10\n", 0, 0, 0); rex(0, 1, 0, 0); b(0x89); modrm(0, 2, 0); /* MOV [rax], r10d */
    返 1;
}
静 空 emit_print(常 字 *fname, 整 nargs) {
    整 is_fprintf = !strcmp(fname, "fprintf");
    整 is_putstr = !strcmp(fname, "putstr");
    整 fargoff = is_fprintf ? 2 : 1;
    /* kernel32 (WriteFile) requires rsp 16-byte aligned at the call (SSE).
       Compute the format-arg pointer from the PRE-alignment rsp (the pushed args sit
       at the pre-alignment position); r15 is callee-saved so kernel32 preserves it. */
    lea_r_mrsp(13, 8 * (nargs - 1 - fargoff)); /* r13 = &first format arg (pre-alignment rsp) */
    mov_rr64(15, 4); /* mov r15, rsp */
    asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp, -16 */
    /* save fmt BEFORE GetStdHandle clobbers rcx. The fmt slot is at the PRE-alignment
       position: for printf it's arg0 (still in rcx); for fprintf it's arg1 = [r13+8]
       (r13 is a pre-alignment address, immune to the `and rsp,-16` shift).
       IMPORTANT: the fmt must NOT be parked in the stack shadow space ([rsp+8..32]
       at the call) �?kernel32 owns that region and clobbers it. rbx is callee-saved,
       preserved by GetStdHandle, and restored by the epilogue, so it's a safe slot. */
    若 (is_fprintf) { asm_emit("    取64 r0, [r13+8]\n", 0, 0, 0); b(0x49); b(0x8B); b(0x45); b(8); } /* mov rax, [r13+8] = fmt */
    否 mov_rr64(0, 1); /* rax = rcx = fmt (arg0) */
    mov_rr64(3, 0);    /* rbx = fmt (callee-saved �?survives GetStdHandle) */
    mov_r_imm(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
    sub_rsp_imm(32);   /* GetStdHandle 影子区（C 原版 3234：原缺失，ABI 要求 32B） */
    call_iat(0);       /* eax = handle */
    add_rsp_imm(32);
    mov_rr64(10, 0);   /* r10 = handle */
    mov_rr64(11, 3);   /* r11 = fmt */
    lea_r_mbrp(12, scratch_base - cur_frame_sz - 4096); /* r12 = buf — 缓冲下移到状态区之下 [rbp-4368] (fix 2026-08-06) */
    mov_rr64(14, 12);  /* r14 = buf start */
    整 ldone;
    若 (is_putstr) {
        整 lcp = new_label();
        ldone = new_label();
        set_label(lcp);
        asm_emit("    零扩展 ecx, [r11]\n", 0, 0, 0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
        test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ldone, 1);
        mov_r12_cl(); /* mov [r12], cl */
        asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
        asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
        jmp_rel(-1); patch_label(cp-4, lcp, 2);
    } 否 {
        ldone = emit_fmt_loop(-272); /* printf/putstr 链：%s 以 rbp-272 为界 (fix 2026-08-06) */
    }
    set_label(ldone);
    /* len = r12 - r14 */
    mov_rr64(0, 12); asm_emit("    减64 r0, r14\n", 0, 0, 0); rex(1,1,0,0); b(0x29); modrm(3, 6, 0); /* sub rax, r14 */
    mov_rr(8, 0); /* r8 = len */
    sub_rsp_imm(32);
    mov_rr64(1, 10); /* rcx = handle */
    mov_rr64(2, 14); /* rdx = buf */
    lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
    mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = 0 (8-byte NULL overlapped �?arg5 at [rsp+32] per real ABI) */
    call_iat(1);       /* WriteFile */
    add_rsp_imm(32);
    mov_rr64(4, 15); /* mov rsp, r15 �?restore original stack position */
}

/* shared %d/%s/%c/%% format loop: r11=fmt r12=out(advancing) r13=next-arg ptr.
   Returns the ldone label the caller must set_label() after the loop. */
/* %lld: 64-bit decimal digits emitter: prints |rbx| (with '-' sign) into r12 buffer,
   then jumps to `tail`. div rcx (unsigned 64-bit) — fix 2026-08-06 */
静 空 emit_ll_digits(整 tail) {
    整 lsign = new_label(), ldig = new_label(), lcpd = new_label();
    lea_r_mbrp(8, scratch_base + 192 + 24 - cur_frame_sz); /* r8 = ll temp end [rbp-56] */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    asm_emit("    测试64 r3, r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x85); modrm(3, 3, 3); /* test rbx, rbx (fix 2026-08-06: REX.B 必须 0，否则 rm=3 变 r11) */
    b(0x0F); b(0x89); b4(0); patch_label(cp-4, lsign, 4); /* jns: skip sign */
    mov_r_imm(0, '-'); mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    取反64 r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0xF7); modrm(3, 3, 3); /* neg rbx (fix 2026-08-06: REX.B 必须 0，49 F7 DB 是 neg r11 → div 商溢出 #DE 崩溃) */
    set_label(lsign);
    mov_rr64(0, 3); /* rax = value (positive) */
    set_label(ldig);
    asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 10); /* ecx = 10 */
    asm_emit("    无符号除64 r1\n", 0, 0, 0); b(0x48); b(0xF7); modrm(3, 6, 1); /* div rcx */
    asm_emit("    加字节 r2, 0x30\n", 0, 0, 0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", 0, 0, 0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    asm_emit("    测试64 r0, r0\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x85); modrm(3, 0, 0); /* test rax, rax */
    jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", 0, 0, 0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", 0, 0, 0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
/* %llu: 64-bit unsigned decimal digits into [r12], then jmp tail（fix 2026-08-06）。
   No sign handling（rbx 为 unsigned long long）；div rcx 无符号 64 位。 */
静 空 emit_ll_unsigned_digits(整 tail) {
    整 ldig = new_label(), lcpd = new_label();
    lea_r_mbrp(8, scratch_base + 192 + 24 - cur_frame_sz); /* r8 = temp end（复用 ll 临时区 [rbp-56]） */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    set_label(ldig);
    asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 10); /* ecx = 10 */
    asm_emit("    无符号除64 r1\n", 0, 0, 0); b(0x48); b(0xF7); modrm(3, 6, 1); /* div rcx */
    asm_emit("    加字节 r2, 0x30\n", 0, 0, 0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", 0, 0, 0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    asm_emit("    测试64 r0, r0\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x85); modrm(3, 0, 0); /* test rax, rax */
    jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", 0, 0, 0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", 0, 0, 0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
/* shared decimal-digit emitter: prints |ebx| (with '-' sign) into the r12 buffer,
   then jumps to `tail`. Used by %d (tail=lfmt) and %f (tail=lfnum fractional path). */
静 空 emit_digits(整 tail) {
    整 lsign = new_label(), ldig = new_label(), lcpd = new_label();
    lea_r_mbrp(8, scratch_base + 248 + 12 - cur_frame_sz); /* r8 = digit temp end */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    test_rr(3, 3); b(0x0F); b(0x89); b4(0); patch_label(cp-4, lsign, 4); /* jns: skip sign */
    mov_r_imm(0, '-'); mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_rr(0, 3); asm_emit("    取反 r0\n", 0, 0, 0); b(0xF7); b(0xD8); mov_rr(3, 0); /* eax = -value; ebx = -value */
    set_label(lsign);
    mov_rr(0, 3); /* eax = value (positive) */
    set_label(ldig);
    asm_emit("    清零\n", 0, 0, 0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 10); /* ecx = 10 */
    asm_emit("    整除 r1\n", 0, 0, 0); b(0xF7); b(0xF9); /* idiv ecx: eax=quot, edx=rem */
    asm_emit("    加字节 r2, 0x30\n", 0, 0, 0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", 0, 0, 0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", 0, 0, 0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", 0, 0, 0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
/* %x/%X：无符号十六进制数字输出到 [r12]（ebx=值，基 16，小写 a-f）（fix 2026-08-05） */
/* %u: unsigned 十进制（无符号，无负号处理，div 而非 idiv — fix 2026-08-05: %u 曾是未知 spec 被吞掉） */
静 空 emit_unsigned_digits(整 tail) {
    整 ldig = new_label(), lcpd = new_label();
    lea_r_mbrp(8, scratch_base + 248 + 12 - cur_frame_sz); /* r8 = digit temp end */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    set_label(ldig);
    asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 10); /* ecx = 10 */
    asm_emit("    无符号除 ecx\n", 0, 0, 0); b(0xF7); b(0xF1); /* div ecx: eax=quot, edx=rem */
    asm_emit("    加字节 r2, 0x30\n", 0, 0, 0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", 0, 0, 0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", 0, 0, 0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", 0, 0, 0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
静 空 emit_hex_digits(整 tail, 整 upper) {
    整 ldig = new_label(), lcpd = new_label(), l0a = new_label(), lchx = new_label();
    lea_r_mbrp(8, scratch_base + 248 + 12 - cur_frame_sz); /* r8 = temp end */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    set_label(ldig);
    asm_emit("    清零\n", 0, 0, 0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 16); /* ecx = 16 */
    asm_emit("    无符号除 r1\n", 0, 0, 0); b(0xF7); b(0xF1); /* div ecx: eax=quot, edx=rem */
    asm_emit("    比较字节即 r2, 10\n", 0, 0, 0); b(0x80); b(0xFA); b(10); /* cmp dl, 10（fix 2026-08-05：原 比较字节 在 asm_zh 生成 38 D0 → H2 错位） */
    b(0x0F); b(0x82); b4(0); patch_label(cp-4, l0a, 8); /* jb l0a（dl 0-15 无符号，jb==jl；is_jmp=8=低于跳 与 asm_zh 的 0F 82 一致——fix 2026-08-05） */
    若 (upper) { asm_emit("    加字节 r2, 0x37\n", 0, 0, 0); b(0x80); b(0xC2); b(0x37); /* add dl, 0x37 = 'A'-10 (%X) */ }
    否 { asm_emit("    加字节 r2, 0x57\n", 0, 0, 0); b(0x80); b(0xC2); b(0x57); /* add dl, 0x57 = 'a'-10 */ }
    jmp_rel(-1); patch_label(cp-4, lchx, 2);
    set_label(l0a);
    asm_emit("    加字节 r2, 0x30\n", 0, 0, 0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    set_label(lchx);
    asm_emit("    自减 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", 0, 0, 0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", 0, 0, 0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", 0, 0, 0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
/* %llx/%llX: 64-bit unsigned hex digits into [r12] (rbx = value, base 16, lowercase a-f),
   then jmp tail（fix 2026-08-06）。div rcx 无符号 64 位。 */
静 空 emit_ll_hex_digits(整 tail, 整 upper) {
    整 ldig = new_label(), lcpd = new_label(), l0a = new_label(), lchx = new_label();
    lea_r_mbrp(8, scratch_base + 192 + 24 - cur_frame_sz); /* r8 = temp end（复用 ll 临时区 [rbp-56]） */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    set_label(ldig);
    asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 16); /* ecx = 16 */
    asm_emit("    无符号除64 r1\n", 0, 0, 0); b(0x48); b(0xF7); modrm(3, 6, 1); /* div rcx */
    asm_emit("    比较字节即 r2, 10\n", 0, 0, 0); b(0x80); b(0xFA); b(10); /* cmp dl, 10 */
    b(0x0F); b(0x82); b4(0); patch_label(cp-4, l0a, 8); /* jb l0a (dl is 0-15 unsigned) */
    若 (upper) { asm_emit("    加字节 r2, 0x37\n", 0, 0, 0); b(0x80); b(0xC2); b(0x37); /* add dl, 0x37 = 'A'-10 (%X) */ }
    否 { asm_emit("    加字节 r2, 0x57\n", 0, 0, 0); b(0x80); b(0xC2); b(0x57); /* add dl, 0x57 = 'a'-10 */ }
    jmp_rel(-1); patch_label(cp-4, lchx, 2);
    set_label(l0a);
    asm_emit("    加字节 r2, 0x30\n", 0, 0, 0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    set_label(lchx);
    asm_emit("    自减 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", 0, 0, 0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    asm_emit("    测试64 r0, r0\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x85); modrm(3, 0, 0); /* test rax, rax */
    jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", 0, 0, 0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", 0, 0, 0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}

静 整 emit_fmt_loop(整 bound_disp) {
    整 ld = new_label(), ls = new_label(), lch = new_label(), lpct = new_label(), lcp = new_label(), lfmt = new_label(), ldone = new_label(), lf = new_label(), lx = new_label(), lsnoprec = new_label();
    整 lfnum = new_label(), lfrac = new_label(), lfrac2 = new_label(), lfsgn = new_label();
    /* specifier-prefix parse + %f precision（C 原版 3305 移植） */
    整 lflag = new_label(), lflags = new_label(), lwidth = new_label(), lprec = new_label();
    整 ldot = new_label(), ldig = new_label(), lspec = new_label();
    整 lu = new_label(); /* %u unsigned 十进制 (fix 2026-08-05) */
    整 lscale = new_label(), lscdone = new_label(), ldigl = new_label(), ldigd = new_label();
    整 lfdot = new_label(); /* %.0f: N==0 时不输出 '.' */
    整 lpfmt = new_label(); /* %% -> 字面 '%' */
    整 lcnt = new_label(), lcnt2 = new_label(), lcntd = new_label(), lpad = new_label(), lwdone = new_label(); /* %Nd 宽度填充 */
    整 lminus = new_label(), ldleft = new_label(), lleft = new_label(), llpad = new_label(); /* '-' 左对齐 flag + 数字后 padding（fix 2026-08-06） */
    整 ll_cnt = new_label(), lld32 = new_label(), lu32 = new_label(), lx32 = new_label(), lxU = new_label(), lxU32 = new_label(); /* fix 2026-08-06: %lld/%llu/%llx/%llX 64 位 (ll_cnt=计数, *32=32 位回退; lxU=%X 大写) */
    set_label(lfmt);
    asm_emit("    零扩展 ecx, [r11]\n", 0, 0, 0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ldone, 1);
    mov_r_imm(0, '%'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lpct, 1);
    mov_r12_cl(); /* mov [r12], cl */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
    jmp_rel(-1); patch_label(cp-4, lfmt, 2);
    set_label(lpct);
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past '%') */
    /* specifier-prefix parse: flags/width/precision（C 原版 3320 移植）。默认精度 6，宽度 0 */
    mov_r_imm(0, 6); mov_mbrp_reg(scratch_base - cur_frame_sz + 224, 0);
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 232, 0); /* width W = 0 */
    mov_mbrp_reg(scratch_base - cur_frame_sz + 236, 0); /* 显式精度标志 = 0（fix 2026-08-05） */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 244, 0); /* LL 计数器 = 0（fix 2026-08-06 %lld; mov_mbrp_reg 第二参是寄存器号，必须先清零 eax） */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 252, 0); /* '-' 左对齐 flag = 0（fix 2026-08-06） */
    set_label(lflag);
    asm_emit("    零扩展 ecx, [r11]\n", 0, 0, 0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
    mov_r_imm(0, '-'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lminus, 1); /* '-' flag: 左对齐（fix 2026-08-06） */
    mov_r_imm(0, '+'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lflags, 1);
    mov_r_imm(0, ' '); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lflags, 1);
    mov_r_imm(0, '0'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lflags, 1);
    mov_r_imm(0, '#'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lflags, 1);
    mov_r_imm(0, 'l'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, ll_cnt, 1); /* 长度前缀: 计数 'l'（fix 2026-08-06 %lld） */
    mov_r_imm(0, 'h'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lflags, 1);
    mov_r_imm(0, 'L'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lflags, 1);
    jmp_rel(-1); patch_label(cp-4, lwidth, 2);
    set_label(ll_cnt); /* 'l' 长度前缀：sc+244++（fix 2026-08-06） */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 244); /* eax = ll_cnt */
    mov_r_imm(1, 1); alu_rr(T_PK, 0, 1); /* eax++ */
    mov_mbrp_reg(scratch_base - cur_frame_sz + 244, 0);
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
    jmp_rel(-1); patch_label(cp-4, lflag, 2);
    set_label(lminus); /* '-' 左对齐 flag: sc+252 = 1（fix 2026-08-06） */
    mov_r_imm(0, 1); mov_mbrp_reg(scratch_base - cur_frame_sz + 252, 0);
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
    jmp_rel(-1); patch_label(cp-4, lflag, 2);
    set_label(lflags); /* 跳过 flag 字符 */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
    jmp_rel(-1); patch_label(cp-4, lflag, 2);
    set_label(lwidth); /* 宽度数字：累加到 sc+232（%5d -> 5） */
    asm_emit("    零扩展 ecx, [r11]\n", 0, 0, 0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
    mov_r_imm(0, '0'); alu_rr(T_QK, 1, 0); b(0x0F); b(0x82); b4(0); patch_label(cp-4, lprec, 8); /* cmp cl,'0'; jb lprec */
    mov_r_imm(0, '9'); alu_rr(T_QK, 1, 0); b(0x0F); b(0x87); b4(0); patch_label(cp-4, lprec, 9); /* cmp cl,'9'; ja lprec */
    asm_emit("    减字节 r1, 0x30\n", 0, 0, 0); b(0x80); b(0xE9); b('0'); /* sub cl, '0' -> digit */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 232); /* eax = W */
    mov_rr(2, 0);                                       /* edx = W */
    asm_emit("    左移 r0, 3\n", 0, 0, 0); rex(0, 0, 0, 0); b(0xC1); modrm(3, 4, 0); b(3);    /* shl eax, 3 -> W*8 */
    asm_emit("    左移 r2, 1\n", 0, 0, 0); rex(0, 0, 0, 0); b(0xC1); modrm(3, 4, 2); b(1);    /* shl edx, 1 -> W*2 */
    alu_rr(T_PK, 0, 2);                                 /* eax = W*10 */
    alu_rr(T_PK, 0, 1);                                 /* eax += digit */
    mov_mbrp_reg(scratch_base - cur_frame_sz + 232, 0); /* W = eax */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
    jmp_rel(-1); patch_label(cp-4, lwidth, 2);
    set_label(lprec);
    mov_r_imm(0, '.'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, ldot, 1);
    jmp_rel(-1); patch_label(cp-4, lspec, 2);
    set_label(ldot); /* .N —— 精度累加到 sc+224 */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past '.') */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 224, 0);
    mov_r_imm(0, 1); mov_mbrp_reg(scratch_base - cur_frame_sz + 236, 0); /* 显式精度标志（fix 2026-08-05） */
    set_label(ldig);
    asm_emit("    零扩展 ecx, [r11]\n", 0, 0, 0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
    mov_r_imm(0, '0'); alu_rr(T_QK, 1, 0); b(0x0F); b(0x82); b4(0); patch_label(cp-4, lspec, 8);
    mov_r_imm(0, '9'); alu_rr(T_QK, 1, 0); b(0x0F); b(0x87); b4(0); patch_label(cp-4, lspec, 9);
    asm_emit("    减字节 r1, 0x30\n", 0, 0, 0); b(0x80); b(0xE9); b('0'); /* sub cl, '0' */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 224); /* eax = N */
    mov_rr(2, 0);                                       /* edx = N */
    asm_emit("    左移 r0, 3\n", 0, 0, 0); rex(0, 0, 0, 0); b(0xC1); modrm(3, 4, 0); b(3);    /* shl eax, 3 -> N*8 */
    asm_emit("    左移 r2, 1\n", 0, 0, 0); rex(0, 0, 0, 0); b(0xC1); modrm(3, 4, 2); b(1);    /* shl edx, 1 -> N*2 */
    alu_rr(T_PK, 0, 2);                                 /* eax = N*10 */
    alu_rr(T_PK, 0, 1);                                 /* eax += digit */
    mov_mbrp_reg(scratch_base - cur_frame_sz + 224, 0); /* N = eax */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
    jmp_rel(-1); patch_label(cp-4, ldig, 2);
    set_label(lspec); /* 按转换字符分发 (ecx) */
    mov_r_imm(0, 'd'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, ld, 1);
    mov_r_imm(0, 's'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, ls, 1);
    mov_r_imm(0, 'c'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lch, 1);
    mov_r_imm(0, 'f'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lf, 1);
    mov_r_imm(0, 'x'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lx, 1); /* %x 十六进制（fix 2026-08-05） */
    mov_r_imm(0, 'X'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lxU, 1); /* %X 大写十六进制（fix 2026-08-06） */
    mov_r_imm(0, 'u'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lu, 1); /* %u unsigned 十进制 (fix 2026-08-05) */
    mov_r_imm(0, '%'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lpfmt, 1); /* %% -> 字面 % */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11: unknown spec, skip */
    jmp_rel(-1); patch_label(cp-4, lfmt, 2);
    set_label(lpfmt); /* %% ：输出字面 '%'，跳过第 2 个 % */
    mov_r12_cl(); /* mov [r12], cl —— cl 仍是 '%' */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past 2nd %) */
    jmp_rel(-1); patch_label(cp-4, lfmt, 2);
    /* %c: emit char arg */
    set_label(lch);
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past spec char) */
    mov_eax_mr13(); /* eax = [r13] */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    jmp_rel(-1); patch_label(cp-4, lfmt, 2);
    /* %s: copy string arg */
    set_label(ls);
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past spec char) */
    mov_rax_mr13(); /* rax = [r13] (64-bit ptr) */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr64(8, 0); /* r8 = string */
    /* %.Ns 精度：有限拷贝（fix 2026-08-05）。sc+236 = 显式精度标志；置位则最多拷 N 字节 */
    mov_reg_mbrp(1, scratch_base - cur_frame_sz + 236); /* ecx = has_explicit_prec */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lsnoprec, 1); /* 无显式精度 → 不限 */
    mov_reg_mbrp(1, scratch_base - cur_frame_sz + 224); /* ecx = N */
    jmp_rel(-1); patch_label(cp-4, lcp, 2);
    set_label(lsnoprec);
    mov_r_imm(1, 0x7FFFFFFF); /* ecx = 极大（实际不限） */
    /* H2 fix 2026-08-06: %s 缓冲上限检查 — 仅 printf/putstr 链（bound_disp != 0，= rbp-272 状态区起点）：
       r9 预载 [rbp+bound_disp]，r12 达界即停（缓冲 4096B [rbp-4368..rbp-273]，不碰状态区/&written）。
       sprintf 链 bound_disp=0 → 不设界（用户缓冲，标准 C 语义）。 */
    若 (bound_disp) { lea_r_mbrp(9, bound_disp); } /* lea r9, [rbp+bound_disp] */
    set_label(lcp);
    若 (bound_disp) {
        asm_emit("    比较64 r12, r9\n", 0, 0, 0); rex(1, 1, 0, 1); b(0x39); modrm(3, 1, 4); /* cmp r12, r9 */
        b(0x0F); b(0x83); b4(0); patch_label(cp-4, lfmt, 7); /* jae lfmt (高于等跳): r12 >= 界 -> stop */
    }
    asm_emit("    零扩展 eax, [r8]\n", 0, 0, 0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 0, 0); /* movzx eax, byte[r8] */
    test_rr(0, 0); jz_rel(-1); patch_label(cp-4, lfmt, 1);
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lfmt, 1); /* 计数耗尽 */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    自增 r8\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 0); /* inc r8 */
    asm_emit("    自减 r1\n", 0, 0, 0); b(0xFF); b(0xC9); /* dec ecx */
    jmp_rel(-1); patch_label(cp-4, lcp, 2);
    /* %d: decimal int arg */
    set_label(ld);
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past spec char) */
    /* %lld: 64-bit decimal（fix 2026-08-06）— sc+244 >= 2 → 64 位路径 */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 244); /* eax = ll_cnt */
    mov_r_imm(1, 2); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8C); b4(0); patch_label(cp-4, lld32, 10); /* cmp eax,2; jl lld32 (小跳) */
    mov_rax_mr13(); /* rax = [r13] (64-bit) */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr64(3, 0); /* rbx = 64-bit value */
    emit_ll_digits(lfmt); /* %lld: print rbx 64 位, return to fmt loop */
    set_label(lld32);
    mov_eax_mr13(); /* eax = [r13] */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr(3, 0); /* ebx = value (saved) */
    /* %Nd 右对齐：emit_digits 前补 (W - len) 个空格（C 原版 3410 移植） */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 232); /* eax = width W */
    test_rr(0, 0); jz_rel(-1); patch_label(cp-4, lwdone, 1); /* W==0 -> no padding */
    mov_ri_ext(9, 0); /* r9d = 0 (length) */
    mov_rr(0, 3); /* eax = value */
    mov_r_imm(1, 0); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8D); b4(0); patch_label(cp-4, lcnt, 5); /* cmp eax,0; jge lcnt */
    asm_emit("    自增 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9d: sign digit */
    asm_emit("    取反 r0\n", 0, 0, 0); b(0xF7); b(0xD8); /* neg eax */
    set_label(lcnt);
    mov_rr(8, 0); /* r8d = |value| */
    set_label(lcnt2); /* do-while: value 0 也计 1 位 */
    mov_rr(0, 8); mov_r_imm(1, 10); asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); asm_emit("    除32 ecx\n", 0, 0, 0); b(0xF7); b(0xF1); /* div ecx: eax = temp/10 */
    mov_rr(8, 0); /* r8 = quotient */
    asm_emit("    自增 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9d */
    test_rr(8, 8); jnz_rel(-1); patch_label(cp-4, lcnt2, 3); /* temp != 0 -> loop */
    set_label(lcntd);
    mov_mbrp_reg(scratch_base - cur_frame_sz + 228, 9); /* save len（fix 2026-08-06: emit_digits 破坏 r9, 左对齐 padding 要重取） */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 232); /* eax = W */
    mov_rr(2, 9); /* edx = len */
    alu_rr(T_MK, 0, 2); /* eax = W - len */
    mov_r_imm(1, 0); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8E); b4(0); patch_label(cp-4, lwdone, 6); /* cmp eax,0; jle lwdone */
    mov_rr(2, 0); /* edx = pad count（保存到 edx, eax 可被 flag 检查覆盖） */
    /* 左对齐 (sc+252): 先数字后补空格; 右对齐: 先空格后数字。
       fix 2026-08-06: 不能用 r10 当临时 — r10 是 printf 内建的 handle, 破坏后 WriteFile 空输出 */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 252); /* eax = left flag */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, ldleft, 3); /* jnz ldleft: 左对齐走数字先行路径 */
    set_label(lpad);
    mov_r_imm(0, ' '); mov_r12_al(); /* mov [r12], ' ' */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    自减 r2\n", 0, 0, 0); b(0xFF); b(0xCA); /* dec edx */
    jnz_rel(-1); patch_label(cp-4, lpad, 3);
    set_label(lwdone);
    emit_digits(lfmt); /* %d: print ebx, return to fmt loop */
    set_label(ldleft); /* 左对齐: 先打印数字, 再补 (W-len) 空格 */
    emit_digits(lleft);
    set_label(lleft);
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 232); /* eax = W */
    mov_reg_mbrp(2, scratch_base - cur_frame_sz + 228); /* edx = len */
    alu_rr(T_MK, 0, 2); /* eax = W - len */
    mov_r_imm(1, 0); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8E); b4(0); patch_label(cp-4, lfmt, 6); /* cmp eax,0; jle lfmt: 无需补 */
    mov_rr(2, 0); /* edx = pad */
    set_label(llpad);
    mov_r_imm(0, ' '); mov_r12_al(); /* mov [r12], ' ' */
    asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    自减 r2\n", 0, 0, 0); b(0xFF); b(0xCA); /* dec edx */
    jnz_rel(-1); patch_label(cp-4, llpad, 3);
    jmp_rel(-1); patch_label(cp-4, lfmt, 2);
    set_label(lx); /* %x：无符号十六进制小写（fix 2026-08-05） */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past spec char) */
    /* %llx: 64-bit unsigned hex（fix 2026-08-06）— sc+244 >= 2 → 64 位路径 */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 244); /* eax = ll_cnt */
    mov_r_imm(1, 2); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8C); b4(0); patch_label(cp-4, lx32, 10); /* cmp eax,2; jl lx32 (小跳) */
    mov_rax_mr13(); /* rax = [r13] (64-bit) */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr64(3, 0); /* rbx = 64-bit value */
    emit_ll_hex_digits(lfmt, 0); /* %llx 小写 */
    set_label(lx32);
    mov_eax_mr13(); /* eax = [r13] */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr(3, 0); /* ebx = value */
    emit_hex_digits(lfmt, 0);
    set_label(lxU); /* %X：无符号十六进制大写（fix 2026-08-06） */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past spec char) */
    /* %llX: 64-bit uppercase hex */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 244); /* eax = ll_cnt */
    mov_r_imm(1, 2); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8C); b4(0); patch_label(cp-4, lxU32, 10); /* cmp eax,2; jl lxU32 */
    mov_rax_mr13(); /* rax = [r13] (64-bit) */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr64(3, 0); /* rbx = 64-bit value */
    emit_ll_hex_digits(lfmt, 1); /* %llX 大写 */
    set_label(lxU32);
    mov_eax_mr13(); /* eax = [r13] */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr(3, 0); /* ebx = value */
    emit_hex_digits(lfmt, 1); /* %X 大写 32 位回退 */
    /* %f: double arg → int part via ldnum, then '.' + 6 fractional digits */
    set_label(lu); /* %u: unsigned 十进制 (fix 2026-08-05) */
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past spec char) */
    /* %llu: 64-bit unsigned decimal（fix 2026-08-06）— sc+244 >= 2 → 64 位路径 */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 244); /* eax = ll_cnt */
    mov_r_imm(1, 2); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8C); b4(0); patch_label(cp-4, lu32, 10); /* cmp eax,2; jl lu32 (小跳) */
    mov_rax_mr13(); /* rax = [r13] (64-bit) */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr64(3, 0); /* rbx = 64-bit value */
    emit_ll_unsigned_digits(lfmt); /* %llu: print rbx 64 位 unsigned, return to fmt loop */
    set_label(lu32);
    mov_eax_mr13(); /* eax = [r13] */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    mov_rr(3, 0); /* ebx = value */
    emit_unsigned_digits(lfmt);
    set_label(lf);
    asm_emit("    自增 r11\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past 'f') */
    movsd_xmm0_mr13(); /* movsd xmm0, [r13] (REX.B — [rbp+0] would read the saved rbp!) */
    asm_emit("    减即 r13, 8\n", 0, 0, 0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */
    {
        整 sc = scratch_base - cur_frame_sz;
        movsd_mbrp_xmm0(sc + 192);      /* save v */
        /* negative v (incl. -0.0): print '-' then negate. comisd treats -0.0==0.0, so
           check the IEEE sign bit instead: movq rax,xmm0; bt rax,63 → CF = sign */
        movsd_xmm0_mbrp(sc + 192);      /* xmm0 = v */
        asm_emit("    取浮标 r0, xmm0\n", 0, 0, 0); b(0x66); b(0x48); b(0x0F); b(0x7E); b(0xC0); /* movq rax, xmm0 */
        asm_emit("    测试位 r0, 63\n", 0, 0, 0); rex(1,0,0,0); b(0x0F); b(0xBA); b(0xE0); b(0x3F); /* bt rax, 63 */
        b(0x0F); b(0x83); b4(0); patch_label(cp - 4, lfsgn, 7); /* jae lfsgn: sign clear, keep */
        mov_r_imm(0, '-'); mov_r12_al(); /* mov [r12], '-' */
        asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
        movsd_xmm1_mbrp(sc + 192);       /* xmm1 = v */
        mov_r_imm(0, 0); cvtsi2sd_xmm0_eax(); /* xmm0 = 0.0 */
        subsd_xmm0_xmm1();               /* xmm0 = 0.0 - v = -v */
        movsd_mbrp_xmm0(sc + 192);       /* save |v| */
        set_label(lfsgn);
        asm_emit("    浮转整\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x2C); b(0xC0); /* cvttsd2si eax, xmm0 → int part */
        mov_rr(3, 0);                    /* ebx = int part */
        mov_rr(0, 3); cvtsi2sd_xmm0_eax(); /* xmm0 = (double)int */
        movsd_xmm1_xmm0();               /* xmm1 = (double)int */
        movsd_xmm0_mbrp(sc + 192);       /* xmm0 = v */
        subsd_xmm0_xmm1();               /* xmm0 = v - int = frac (signed) */
        movsd_mbrp_xmm0(sc + 200);       /* save frac */
        mov_r_imm(0, 0); cvtsi2sd_xmm0_eax(); /* xmm0 = 0.0 */
        movsd_xmm1_xmm0();               /* xmm1 = 0.0 */
        movsd_xmm0_mbrp(sc + 200);       /* xmm0 = frac */
        comisd_xmm0_xmm1();              /* flags: frac vs 0 (CF = frac < 0) */
        b(0x0F); b(0x83); b4(0); patch_label(cp - 4, lfrac, 7); /* jae lfrac: frac >= 0, keep */
        movsd_xmm0_xmm1();               /* xmm0 = 0.0 */
        movsd_xmm1_mbrp(sc + 200);       /* xmm1 = frac */
        subsd_xmm0_xmm1();               /* xmm0 = -frac */
        set_label(lfrac);
        movsd_mbrp_xmm0(sc + 200);       /* save |frac| */
        /* rounded 6-digit fraction: frac6 = trunc(|frac|*1e6 + 0.5); carry into int part */
        movsd_xmm0_mbrp(sc + 200);
        /* 按精度 N 计算 scale=10^N（C 原版 3478 移植：原硬编码 1e6） */
        mov_r_imm(0, 1); mov_mbrp_reg(sc + 228, 0); /* scale = 1 */
        mov_reg_mbrp(1, sc + 224); /* ecx = N */
        set_label(lscale);
        test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lscdone, 1);
        mov_reg_mbrp(0, sc + 228); mov_r_imm(2, 10); asm_emit("    乘32 r0, r2\n", 0, 0, 0); b(0xF7); b(0xE2); /* mul edx: eax = scale*10 */
        mov_mbrp_reg(sc + 228, 0); /* scale = eax */
        asm_emit("    自减 r1\n", 0, 0, 0); b(0xFF); b(0xC9); /* dec ecx */
        jmp_rel(-1); patch_label(cp-4, lscale, 2);
        set_label(lscdone);
        mov_reg_mbrp(0, sc + 228); cvtsi2sd_xmm1_eax(); /* xmm1 = (double)scale */
        mulsd_xmm0_xmm1();
        movsd_mbrp_xmm0(sc + 208);       /* save scaled */
        mov_r_imm(0, 1); cvtsi2sd_xmm0_eax();   /* xmm0 = 1.0 */
        mov_r_imm(0, 2); cvtsi2sd_xmm1_eax();   /* xmm1 = 2.0 */
        divsd_xmm0_xmm1();               /* xmm0 = 0.5 */
        movsd_mbrp_xmm0(sc + 216);       /* save 0.5 */
        movsd_xmm0_mbrp(sc + 208);
        movsd_xmm1_mbrp(sc + 216);
        addsd_xmm0_xmm1();
        asm_emit("    浮转整\n", 0, 0, 0); b(0xF2); b(0x0F); b(0x2C); b(0xC0); /* cvttsd2si eax, xmm0 → fracN (可能 = scale) */
        mov_reg_mbrp(1, sc + 228); /* ecx = scale */
        asm_emit("    比较无 r0, r1\n", 0, 0, 0); b(0x39); modrm(3, 1, 0);         /* cmp eax, ecx (CF = eax < ecx → jb = no carry) */
        b(0x0F); b(0x82); b4(0); patch_label(cp - 4, lfrac2, 8); /* jb lfrac2: no carry */
        mov_r_imm(0, 0);                 /* frac6 = 0 */
        asm_emit("    自增 r3\n", 0, 0, 0); b(0xFF); b(0xC3);                /* inc ebx (int part + 1) */
        set_label(lfrac2);
        mov_mbrp_reg(sc + 208, 0);       /* save frac6 as int */
        emit_digits(lfnum);              /* print int part -> fractional path */
        /* fractional path: '.' then N digits of fracN（前导零）。C 原版 3509 移植：循环 N 次，除数 scale/10 */
        set_label(lfnum);
        mov_reg_mbrp(0, sc + 224); /* eax = N */
        test_rr(0, 0); jz_rel(-1); patch_label(cp-4, lfdot, 1); /* N==0: 无小数位，跳过 '.' */
        mov_r_imm(0, '.'); mov_r12_al();
        asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
        set_label(lfdot);
        mov_reg_mbrp(0, sc + 228); mov_r_imm(1, 10); asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); asm_emit("    除32 r1\n", 0, 0, 0); b(0xF7); b(0xF1); /* div ecx: eax = scale/10 */
        mov_rr(8, 0);                    /* r8d = divisor */
        mov_reg_mbrp(9, sc + 224);       /* r9d = N (digit count) */
        set_label(ldigl);
        test_rr(9, 9); jz_rel(-1); patch_label(cp-4, ldigd, 1);
        mov_reg_mbrp(0, sc + 208);       /* eax = fracN */
        asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2);                /* xor edx, edx */
        asm_emit("    除32 r8\n", 0, 0, 0); rex(0,0,0,1); b(0xF7); modrm(3, 6, 0); /* div r8d: eax=digit, edx=rem */
        asm_emit("    加字节 r0, 0x30\n", 0, 0, 0); b(0x80); b(0xC0); b(0x30); mov_r12_al(); /* add al,'0'; mov [r12], al */
        asm_emit("    自增 r12\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
        mov_mbrp_reg(sc + 208, 2);       /* fracN = edx (rem) */
        mov_rr(0, 8); mov_r_imm(1, 10); asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); asm_emit("    除32 r1\n", 0, 0, 0); b(0xF7); b(0xF1); /* div ecx: eax = divisor/10 */
        mov_rr(8, 0);                    /* r8d = divisor/10 */
        asm_emit("    自减 r9\n", 0, 0, 0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9d */
        jmp_rel(-1); patch_label(cp-4, ldigl, 2);
        set_label(ldigd);
        jmp_rel(-1); patch_label(cp - 4, lfmt, 2);
    }
/* %d→lfmt, %f→fractional path */
    返 ldone;
}

/* sprintf(dest=rcx, fmt=rdx, args...): format into dest buffer, return chars written.
   No kernel32 calls, so no stack alignment juggling. r14=dest r11=fmt r12=adv r13=args. */
静 空 emit_sprintf(整 nargs, 整 argstart) {
    lea_r_mrsp(13, 8 * (nargs - 1 - argstart)); /* r13 = &第一个值参数（sprintf=2, snprintf=3） */
    mov_rr64(14, 1);  /* r14 = dest (rcx = arg0) */
    mov_rr64(11, 2);  /* r11 = fmt (rdx = arg1) */
    mov_rr64(12, 14); /* r12 = dest advancing */
    整 ldone = emit_fmt_loop(0); /* sprintf/snprintf：用户缓冲，不设界 */
    set_label(ldone);
    /* NUL 终止 dest 缓冲区 —— sprintf 必须写终止符（C 原版 3548：否则 -S 文本残留脏数据） */
    asm_emit("    存字节0r12\n", 0, 0, 0); b(0x41); b(0xC6); b(0x04); b(0x24); b(0); /* mov byte [r12], 0 */
    mov_rr64(0, 12); asm_emit("    减64 r0, r14\n", 0, 0, 0); rex(1,1,0,0); b(0x29); modrm(3, 6, 0); /* rax = r12 - r14 = count */
}

/* _va_alloc(size=rcx) �?VirtualAlloc(NULL, size, MEM_RESERVE|MEM_COMMIT, PAGE_READWRITE) */
静 空 emit_va_alloc(空) {
    mov_rr64(15, 4); asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* align */
    sub_rsp_imm(32); /* 仅影子区（4 参，rsp%16==0）—— C 原版 3557：原 40 是 rsp%16==8 的旧 bug */
    mov_rr64(2, 1);       /* rdx = size */
    mov_ri_ext(1, 0);     /* rcx = lpAddress NULL */
    mov_ri_ext(8, 0x3000); /* r8 = MEM_RESERVE|MEM_COMMIT */
    mov_ri_ext(9, 0x4);   /* r9 = PAGE_READWRITE */
    call_iat(4);          /* VirtualAlloc */
    add_rsp_imm(32);
    mov_rr64(4, 15);
}

/* _setpos(handle=rcx, pos=rdx, method=r8) �?SetFilePointer(handle, pos, NULL, method) */
静 空 emit_setpos(空) {
    mov_rr64(15, 4); asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0);
    sub_rsp_imm(32);
    mov_rr64(9, 8);  /* r9 = method */
    mov_ri_ext(8, 0); /* r8 = NULL (lpDistanceToMoveHigh) */
    call_iat(5);     /* SetFilePointer */
    add_rsp_imm(32);
    mov_rr64(4, 15);
}

/* _getpos(handle=rcx) �?SetFilePointer(handle, 0, NULL, FILE_CURRENT=1) */
静 空 emit_getpos(空) {
    mov_rr64(15, 4); asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0);
    sub_rsp_imm(32);
    mov_ri_ext(2, 0); /* rdx = 0 */
    mov_ri_ext(8, 0); /* r8 = NULL */
    mov_ri_ext(9, 1); /* r9 = FILE_CURRENT */
    call_iat(5);
    add_rsp_imm(32);
    mov_rr64(4, 15);
}

/* _exit_proc(code=rcx) �?ExitProcess(code) �?never returns */
静 空 emit_exit_proc(空) {
    mov_rr64(15, 4); asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0);
    sub_rsp_imm(32);
    call_iat(6); /* ExitProcess */
}

/* fopen/fread/fwrite: real file I/O via kernel32 (CreateFileA/ReadFile/WriteFile).
   Args arrive in rcx/rdx/r8/r9 (call machinery). All kernel32 calls need rsp 16-aligned
   and the 5th+ args at [rsp+32+8k] �?align with r15 and restore. */
静 空 emit_fileio(常 字 *fname) {
    若 (!strcmp(fname, "fopen")) {
        /* fopen(path=rcx, mode=rdx): parse mode[0], call CreateFileA */
        mov_rr64(10, 1); /* r10 = path */
        mov_rr64(11, 2); /* r11 = mode */
        mov_rr64(15, 4); /* mov r15, rsp */
        asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp, -16 */
        sub_rsp_imm(64); /* shadow 32 + 3 stack args 24 + pad 8  �? rsp%16==0 at call */
        /* defaults for 'w': GENERIC_WRITE (rdx = arg2!) + CREATE_ALWAYS */
        mov_r_imm(0, 3); mov_rr(8, 0);   /* r8 = share 3 (READ|WRITE) */
        mov_r_imm(0, 0); mov_rr(9, 0);   /* r9 = security NULL */
        mov_r_imm(0, 2); mov_mrsp_reg64(32, 0);  /* [rsp+32] = CREATE_ALWAYS */
        mov_r_imm(0, 0x80); mov_mrsp_reg64(40, 0); /* [rsp+40] = FILE_ATTRIBUTE_NORMAL（64 位写，C 原版 3613） */
        mov_r_imm(0, 0); mov_mrsp_reg64(48, 0);  /* [rsp+48] = template NULL */
        mov_r_imm(2, 0x40000000);              /* rdx = GENERIC_WRITE (default) */
        /* mode[0] */
        asm_emit("    零扩展 eax, [r11]\n", 0, 0, 0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 0, 3); /* movzx eax, byte[r11] */
        整 lr = new_label(), la = new_label(), ldone = new_label();
        asm_emit("    比较字节即 r0, 0x72\n", 0, 0, 0); b(0x3C); b('r'); jz_rel(-1); patch_label(cp-4, lr, 1); /* 'r' read */
        asm_emit("    比较字节即 r0, 0x61\n", 0, 0, 0); b(0x3C); b('a'); jz_rel(-1); patch_label(cp-4, la, 1); /* 'a' append */
        jmp_rel(-1); patch_label(cp-4, ldone, 2); /* 'w' defaults already set */
        set_label(lr);
        mov_r_imm(2, 0x80000000);              /* rdx = GENERIC_READ */
        mov_r_imm(0, 3); mov_mrsp_reg64(32, 0);  /* [rsp+32] = OPEN_EXISTING */
        jmp_rel(-1); patch_label(cp-4, ldone, 2);
        set_label(la);
        mov_r_imm(2, 0x4);                 /* rdx = FILE_APPEND_DATA �?闁告劖鐟﹀鍫熸交濠婂棙鍎?EOF */
        mov_r_imm(0, 4); mov_mrsp_reg64(32, 0);  /* [rsp+32] = OPEN_ALWAYS */
        set_label(ldone);
        mov_rr64(1, 10); /* rcx = path */
        call_iat(2);     /* CreateFileA */
        add_rsp_imm(64);
        mov_rr64(4, 15); /* mov rsp, r15 */
    } 否 若 (!strcmp(fname, "fread")) {
        /* fread(ptr=rcx, size=rdx, nmemb=r8, stream=r9): ReadFile */
        mov_rr64(10, 9); /* r10 = handle */
        mov_rr64(11, 1); /* r11 = ptr */
        mov_rr64(0, 2);  /* rax = size */
        asm_emit("    乘64 r0, r8\n", 0, 0, 0); rex(1,0,0,1); b(0x0F); b(0xAF); modrm(3, 0, 0); /* imul rax, r8 */
        mov_rr64(8, 0);  /* r8 = count */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &read */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* align */
        sub_rsp_imm(48); /* shadow 32 + 1 stack arg 8 + pad 8  �? rsp%16==0 at call */
        mov_rr64(1, 10); /* rcx = handle */
        mov_rr64(2, 11); /* rdx = ptr */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL */
        call_iat(3);     /* ReadFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes read */
    } 否 若 (!strcmp(fname, "fwrite")) {
        /* fwrite(ptr=rcx, size=rdx, nmemb=r8, stream=r9): WriteFile */
        mov_rr64(10, 9); /* r10 = handle */
        mov_rr64(11, 1); /* r11 = ptr */
        mov_rr64(0, 2);  /* rax = size */
        asm_emit("    乘64 r0, r8\n", 0, 0, 0); rex(1,0,0,1); b(0x0F); b(0xAF); modrm(3, 0, 0); /* imul rax, r8 */
        mov_rr64(8, 0);  /* r8 = count */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0);
        sub_rsp_imm(48); /* shadow 32 + stack arg 8 + pad 8（C 原版 3660：原 40，ABI 错位） */
        mov_rr64(1, 10); mov_rr64(2, 11);
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0);
        call_iat(1);     /* WriteFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes written */
    } 否 若 (!strcmp(fname, "fputc")) {
        /* fputc(c=rcx, stream=rdx): WriteFile(handle, &byte, 1, &written, NULL) */
        mov_rr64(10, 2); /* r10 = handle */
        mov_mbrp_reg(scratch_base + 232 - cur_frame_sz, 1); /* [scratch+232] = c (low byte) */
        lea_r_mbrp(11, scratch_base + 232 - cur_frame_sz); /* r11 = &byte */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* align */
        sub_rsp_imm(48); /* shadow 32 + stack arg 8 + pad 8 */
        mov_rr64(1, 10); /* rcx = handle */
        mov_rr64(2, 11); /* rdx = &byte */
        mov_ri_ext(8, 1); /* r8 = 1 byte (mov_r_imm can't address high regs!) */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL */
        call_iat(1);     /* WriteFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_r_imm(0, 1); /* return c (positive) */
    } 否 若 (!strcmp(fname, "fputs")) {
        /* fputs(str=rcx, stream=rdx): WriteFile(handle, str, strlen(str), &written, NULL) */
        mov_rr64(10, 2); /* r10 = handle */
        mov_rr64(11, 1); /* r11 = str */
        mov_rr64(8, 11); /* r8 = scan */
        mov_r_imm(0, 0); /* eax = len */
        整 lps = new_label(), lpd = new_label();
        set_label(lps);
        asm_emit("    零扩展 ecx, [r8]\n", 0, 0, 0); rex(0, 0, 0, 1); b(0x0F); b(0xB6); modrm(0, 1, 0); /* movzx ecx,byte[r8] */
        test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lpd, 1);
        asm_emit("    自增 r8\n", 0, 0, 0); rex(0,0,0,1);b(0xFF);modrm(3,0,0); /* inc r8 */
        asm_emit("    自增 r0\n", 0, 0, 0); b(0xFF); b(0xC0); /* inc eax */
        jmp_rel(-1); patch_label(cp-4, lps, 2);
        set_label(lpd);
        mov_rr64(8, 0); /* r8 = len */
        mov_rr64(15, 4); asm_emit("    对齐栈\n", 0, 0, 0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* align */
        sub_rsp_imm(48);
        mov_rr64(1, 10); /* rcx = handle */
        mov_rr64(2, 11); /* rdx = str */
        lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
        mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = NULL */
        call_iat(1);     /* WriteFile */
        add_rsp_imm(48);
        mov_rr64(4, 15);
        mov_r_imm(0, 0); /* return 0 */
    }
}

静 空 cg(整 n) {
    若 (n < 0) 返;
    若 (n >= nc) { fprintf(stderr, "[CG-BAD] n=%d nc=%d\n", n, nc); abort(); }
    整 t = nt[n];
    若 (t < 0 || t > 65) { fprintf(stderr, "[CG-BADTYPE] n=%d nt=%d nc=%d\n", n, t, nc); abort(); }
    择 (nt[n]) {
        例 0: 若 (nll[n]) mov_rax_imm64(((长 长)(无 整)nv[n]) | (((长 长)(无 整)nll_hi[n]) << 32)); 否 mov_r_imm(0, nv[n]); 断; /* LL 立即数：无符号低32 | 高32<<32（fix 2026-08-05：符号扩展弄坏 0xFFFFFFFFLL） */ /* imm → eax/rax（LL: 64 位，fix 2026-08-05） */
        例 19: cg_f(n0[n]); cvttsd2si_eax_xmm0(); 断; /* (int)double: truncate xmm0 to eax */
        例 STR: { /* string literal — placeholder, patched after codegen */
            整 si = nv[n];
            str_place(si); /* ensure string is in data buffer */
            asm_emit("    移动 r0, STR%d\n", (字*)(长)(整)si, 0, 0);
            b(0xB8); b4(0); /* placeholder: B8 00 00 00 00 (mov eax, 0) */
            若 (strpn >= 2048) { fprintf(stderr, "[STRPATCH-OVERFLOW] strpn=%d\n", strpn); abort(); }
            str_patches[strpn].patch_at = cp - 4; /* position of imm32 */
            str_patches[strpn].str_idx = si;
            strpn++;
        } 断;
        例 FP: { /* double literal: movsd xmm0, [rip + dbl_const] (patched) */
            整 di = nv[n];
            dbl_place(di);
            asm_emit("    浮取静 xmm0, [rip+DBL%d]\n", (字*)(长)(整)di, 0, 0); movsd_xmm0_rip(0); /* F2 0F 10 05 disp32 */
            若 (dbl_patch_n >= 2048) { fprintf(stderr, "[DBLPATCH-OVERFLOW] dbl_patch_n=%d\n", dbl_patch_n); abort(); }
            dbl_patches[dbl_patch_n].patch_at = cp - 4;
            dbl_patches[dbl_patch_n].dbl_idx = di;
            dbl_patch_n++;
        } 断;
        例 1: { /* variable ????????????? */
            整 off = var_lookup((字*)(nn + n));
            若 (off == -1) { /* fix 2026-08-06: off<-1 是 extern 负槽, 走 static 读 (镜像 qcc_x86.c) */
                整 ffi = func_find((字*)(nn + n));
                若 (ffi >= 0 && func_tbl[ffi].defined) {
                    /* function name as value — absolute VA (patched in PE output) */
                    asm_emit("    移动 r0, FN:%s\n", (字*)(nn + n), 0, 0);
                    b(0xB8); b4(0); /* placeholder */
                    若 (fnpn >= 2048) { fprintf(stderr, "[FNPATCH-OVERFLOW] fnpn=%d\n", fnpn); abort(); }
                    fn_patches[fnpn].patch_at = cp - 4;
                    fn_patches[fnpn].label = func_tbl[ffi].label;
                    fnpn++;
                } 否 {
                    load_param_val((字*)(nn + n)); /* eax = param (reg or [rbp+disp]) */
                }
            } 否 {
                字 *vn = (字*)(nn + n);
                若 (var_isstatic(vn)) { /* static: .data via RIP-relative */
                    若 (var_arrsz(vn) > 0) lea_rax_rip(stc_disp(off) - 1); /* static ARRAY name: its address (lea is 7B, stc_disp assumes 6) */
                    否 若 (var_pesz(vn) > 0) mov_rax_rip64(stc_disp(off) - 1);
                    否 若 (var_small_struct(vn)) mov_rax_rip64(stc_disp(off) - 1); /* struct value: full 8 bytes */
                    否 若 (var_is_ll(vn)) { mov_rax_rip64(stc_disp(off) - 1); nll[n] = 1; } /* long long: 全 64 位静态读取（fix 2026-08-05） */
                    否 { mov_eax_rip(stc_disp(off)); 若 (nll[n] && !nuns[n]) { asm_emit("    符号扩展 r0, r0\n", 0, 0, 0); b(0x48); b(0x63); modrm(3, 0, 0); } } /* (long long)static int: sign-extend（fix 2026-08-06: 必须花括号，否则 若 落在 否 外无条件执行 → LL 全局被 movsxd 覆盖） */
                } 否 {
                    /* check if array �?LEA. MUST resolve to the SAME var var_lookup found:
                       the forward search matched any same-named array (e.g. a `char fn[32]`
                       field-local shadowing the parse's `int fn`), turning the int into a
                       LEA of its own address. Search BACKWARD (latest = resolved) and stop. */
                    整 is_arr = 0; 整 base = off;
                    遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                        若 (!strcmp(vars[vi].name, vn) && var_codegen_visible(vi)) {
                            若 (vars[vi].arr_sz > 0) { is_arr = 1; 整 esz = vars[vi].arr_esz ? vars[vi].arr_esz : 4; base = off - vars[vi].arr_sz * esz; }
                            断;
                        }
                    若 (is_arr) { lea_r_mbrp(0, base - cur_frame_sz); }
                    否 若 (var_pesz(vn) > 0) { mov_reg_mbrp64(0, off - cur_frame_sz); } /* pointer: full 64-bit */
                    否 若 (var_is_ll(vn)) { mov_reg_mbrp64(0, off - cur_frame_sz); nll[n] = 1; } /* long long: full 64-bit（fix 2026-08-05） */
                    否 若 (var_is_dbl(vn)) { movsd_xmm0_mbrp(off - cur_frame_sz); } /* double value → xmm0 */
                    否 若 (var_small_struct(vn)) { mov_reg_mbrp64(0, var_sbase(vn, off) - cur_frame_sz); } /* struct value: full 8 bytes (≤8B struct) */
                    否 { mov_reg_mbrp(0, off - cur_frame_sz); 若 (nll[n] && !nuns[n]) { asm_emit("    符号扩展 r0, r0\n", 0, 0, 0); b(0x48); b(0x63); modrm(3, 0, 0); } } /* (long long)int: sign-extend 32→64（fix 2026-08-06: 原 mov eax 零扩展） */
                }
            }
        } 断;
        例 2: { /* binary op */
            整 o = nv[n];
            若 (o == CK) { cg(n0[n]); cg(n1[n]); 断; } /* comma: evaluate left (side effects), result = right */
            若 (ndbl[n0[n]] || ndbl[n1[n]]) {
                /* floating-point arithmetic / comparison (result in xmm0) */
                若 (o == PK || o == MK || o == DK || o == DV) {
                    cg_f(n0[n]); push_xmm0();
                    cg_f(n1[n]); movsd_xmm1_xmm0(); pop_xmm0();
                    若 (o == PK) addsd_xmm0_xmm1();
                    否 若 (o == MK) subsd_xmm0_xmm1();
                    否 若 (o == DK) mulsd_xmm0_xmm1();
                    否 若 (o == DV) divsd_xmm0_xmm1();
                    ndbl[n] = 1;
                    断;
                }
                若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) {
                    cg_f(n0[n]); push_xmm0();
                    cg_f(n1[n]); movsd_xmm1_xmm0(); pop_xmm0();
                    comisd_xmm0_xmm1(); /* flags: CF/ZF (unordered compare) */
                    若 (o == T_LK) { asm_emit("    置低 al\n", 0, 0, 0); b(0x0F); b(0x92); modrm(3, 0, 0); movzx_eax_al(); }      /* setb: xmm0 < xmm1 */
                    否 若 (o == T_GK) { asm_emit("    置高 al\n", 0, 0, 0); b(0x0F); b(0x97); modrm(3, 0, 0); movzx_eax_al(); } /* seta */
                    否 若 (o == T_QK) { asm_emit("    置等 al\n", 0, 0, 0); b(0x0F); b(0x94); modrm(3, 0, 0); movzx_eax_al(); } /* sete */
                    否 若 (o == T_XK) { asm_emit("    置不等 al\n", 0, 0, 0); b(0x0F); b(0x95); modrm(3, 0, 0); movzx_eax_al(); } /* setne */
                    否 若 (o == T_HK) { asm_emit("    置低等 al\n", 0, 0, 0); b(0x0F); b(0x96); modrm(3, 0, 0); movzx_eax_al(); } /* setbe */
                    否 { asm_emit("    置高等 al\n", 0, 0, 0); b(0x0F); b(0x93); modrm(3, 0, 0); movzx_eax_al(); }                /* setae: >= */
                    断;
                }
                /* other ops on doubles: fall through to integer (best-effort) */
            }
            若 (nll[n0[n]] || nll[n1[n]]) {
                /* 64 位 long long 算术/比较（fix 2026-08-05） */
                若 (o == PK || o == MK || o == DK || o == DV || o == MD) { /* MD=% 64 位余数（fix 2026-08-05） */
                    cg(n0[n]); push_r64(0); /* 保存 lhs（rax 64 位，嵌套安全） */
                    cg(n1[n]); mov_rr64(3, 0);       /* rbx = rhs */
                    pop_r64(0);                      /* rax = lhs */
                    若 (o == PK) { asm_emit("    加64 r0, r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x01); modrm(3, 3, 0); } /* add rax, rbx */
                    否 若 (o == MK) { asm_emit("    减64 r0, r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x29); modrm(3, 3, 0); } /* sub rax, rbx */
                    否 若 (o == DK) { asm_emit("    乘64 r0, r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x0F); b(0xAF); modrm(3, 0, 3); } /* imul rax, rbx（reg=dest, r/m=src） */
                    否 若 (o == DV) { 若 (expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n])) { asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); asm_emit("    无符号除64 r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0xF7); modrm(3, 6, 3); } 否 { asm_emit("    除64 r3\n", 0, 0, 0); b(0x48); b(0x99); b(0x48); b(0xF7); modrm(3, 7, 3); } } /* xor edx,edx; div rbx (unsigned M1) / cqo; idiv rbx */
                    否 若 (o == MD) { 若 (expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n])) { asm_emit("    清零 r2\n", 0, 0, 0); b(0x31); b(0xD2); asm_emit("    无符号除余64 r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0xF7); modrm(3, 6, 3); mov_rr64(0, 2); } 否 { asm_emit("    除余64 r3\n", 0, 0, 0); b(0x48); b(0x99); b(0x48); b(0xF7); modrm(3, 7, 3); mov_rr64(0, 2); } } /* cqo; idiv rbx; rax = rdx */
                    nll[n] = 1;
                    断;
                }
                若 (o == T_SH || o == T_SR) { /* 64 位移位：shl/sar/shr r64, cl（fix 2026-08-05） */
                    cg(n0[n]); push_r64(0); /* 保存 lhs */
                    cg(n1[n]); mov_rr(1, 0); /* ecx = 移位次数（cl = 低 8） */
                    pop_r64(0); /* rax = lhs */
                    若 (o == T_SR) { 整 use_shr = expr_is_unsigned(n0[n]); 若 (use_shr) { asm_emit("    逻辑右移64 r0, cl\n", 0, 0, 0); rex(1, 0, 0, 0); b(0xD3); modrm(3, 5, 0); } 否 { asm_emit("    算术右移64 r0, cl\n", 0, 0, 0); rex(1, 0, 0, 0); b(0xD3); modrm(3, 7, 0); } }
                    否 { asm_emit("    左移64 r0, cl\n", 0, 0, 0); rex(1, 0, 0, 0); b(0xD3); modrm(3, 4, 0); }
                    nll[n] = 1;
                    断;
                }
                若 (o == 25 || o == 46 || o == 47 || o == 48) { /* 64 位按位 & | ^（fix 2026-08-05） */
                    cg(n0[n]); push_r64(0);
                    cg(n1[n]); mov_rr64(3, 0); /* rbx = rhs */
                    pop_r64(0); /* rax = lhs */
                    若 (o == 25 || o == 46) { asm_emit("    与64 r0, r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x21); modrm(3, 3, 0); } /* and rax, rbx */
                    否 若 (o == 47) { asm_emit("    或64 r0, r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x09); modrm(3, 3, 0); } /* or rax, rbx */
                    否 { asm_emit("    异或64 r0, r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x31); modrm(3, 3, 0); } /* xor rax, rbx */
                    nll[n] = 1;
                    断;
                }
                若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) {
                    cg(n0[n]); push_r64(0);
                    cg(n1[n]); mov_rr64(3, 0);
                    pop_r64(0);
                    asm_emit("    比较64 r0, r3\n", 0, 0, 0); rex(1, 0, 0, 0); b(0x39); modrm(3, 3, 0); /* cmp rax, rbx（fix 2026-08-05：rex 已含 48，双 REX 破坏 H1==H2） */
                    若 (expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n])) setcc_u(o); 否 setcc(o); /* fix 2026-08-06 M1: 修正旧文本-字节不配对 */
                    movzx_eax_al();
                    断;
                }
            }
            若 (o == LA) { /* && short-circuit */
                整 lf = new_label(), le = new_label();
                cg(n0[n]); test_rr(0, 0); jz_rel(-1); patch_label(cp-4, lf, 1);
                cg(n1[n]); test_rr(0, 0); jz_rel(-1); patch_label(cp-4, lf, 1);
                mov_r_imm(0, 1); jmp_rel(-1); patch_label(cp-4, le, 2);
                set_label(lf); mov_r_imm(0, 0); set_label(le);
                断;
            }
            若 (o == LO) { /* || */
                cg(n0[n]); test_rr(0,0);
                asm_emit("    置不等 al\n", 0, 0, 0); b(0x0F); b(0x95); modrm(3,0,0); movzx_eax_al(); /* SETNE al; movzx eax,al */
                push_r(0);
                cg(n1[n]); test_rr(0,0);
                asm_emit("    置不等 al\n", 0, 0, 0); b(0x0F); b(0x95); modrm(3,0,0); movzx_eax_al(); /* SETNE al; movzx eax,al */
                pop_r(3);
                asm_emit("    或 r3, r0\n", 0, 0, 0); rex(0,0,0,0); b(0x09); modrm(3,0,3); /* OR ebx, eax */
                mov_rr(0,3);
                断;
            }
            若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) { cgc(n); 断; }
            /* pointer arithmetic: `ptr + int` scales the int by the element size
               (int *p: p+1 → +4; char *s: s+1 → +1; char *names[]: +8).
               `ptr - ptr` divides the byte difference by the element size
               (fix 2026-08-05: was p - q*esz → garbage). */
            整 pscale = 0;
            整 psub_div = 0; /* 指针-指针: (p-q) 再除以元素大小 */
            若 ((o == PK || o == T_MK) && nt[n0[n]] == 1) {
                字 *pv = (字*)(nn + n0[n]);
                遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                    若 (!strcmp(vars[vi].name, pv) && var_codegen_visible(vi)) {
                        若 (vars[vi].arr_esz > 0) pscale = vars[vi].arr_esz;   /* array row / pointer element */
                        否 若 (vars[vi].p_esz > 0) pscale = vars[vi].p_esz;  /* int* → 4, char* → 1 */
                        若 (o == T_MK && pscale > 0 && nt[n1[n]] == 1) { /* p - q: q 是同元素指针? */
                            字 *qv = (字*)(nn + n1[n]);
                            遍 (整 vj = vs_n() - 1; vj >= 0; vj--)
                                若 (!strcmp(vars[vj].name, qv) && var_codegen_visible(vj)) {
                                    若 (vars[vj].arr_sz == 0 && vars[vj].p_esz == vars[vi].p_esz) { psub_div = pscale; pscale = 0; }
                                    断;
                                }
                        }
                        断;
                    }
            }
            cg(n0[n]); push_r(0); cg(n1[n]); pop_r(3);
            若 (pscale > 1) { mov_rr(10, 0); mov_r_imm(0, pscale); asm_emit("    乘 r0, r10\n", 0, 0, 0); rex(0, 0, 0, 1); b(0x0F); b(0xAF); modrm(3, 0, 2); } /* eax = index * row size */
            若 (o == T_SR) g_uns_shift = expr_is_unsigned(n0[n]); /* unsigned >> → SHR (fix 2026-08-05) */
            若 (o == T_DV || o == T_MD) g_uns_div = expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n]); /* fix 2026-08-06 M1 */
            alu_rr(o, 3, 0); mov_rr(0, 3);
            若 (psub_div > 1) { /* eax = (p - q) / 元素大小 (idiv: edx:eax / ecx) */
                mov_r_imm(1, psub_div);
                asm_emit("    除 r1\n", 0, 0, 0);
                b(0x99); b(0xF7); modrm(3, 7, 1); /* cdq; idiv ecx */
