        择 (s[i]) { 例 '+': tt[ti] = s[i + 1] == '+' ? (i++, PP) : s[i + 1] == '=' ? (i++, PA) : PK; 断; 例 '-': tt[ti] = s[i + 1] == '>' ? (i++, AR) : s[i + 1] == '-' ? (i++, MM) : s[i + 1] == '=' ? (i++, MA) : MK; 断; 例 '*': tt[ti] = s[i + 1] == '=' ? (i++, DA) : DK; 断; 例 '/': tt[ti] = s[i + 1] == '=' ? (i++, SA) : DV; 断; 例 '%': tt[ti] = s[i + 1] == '=' ? (i++, MS) : MD; 断; 例 '&': tt[ti] = s[i + 1] == '=' ? (i++, AA) : s[i + 1] == '&' ? (i++, LA) : PT; 断; 例 '|': tt[ti] = s[i + 1] == '=' ? (i++, OA) : s[i + 1] == '|' ? (i++, LO) : OR; 断; 例 '^': tt[ti] = s[i + 1] == '=' ? (i++, XA) : XR; 断; 例 '~': tt[ti] = BN; 断; 例 '?': tt[ti] = QU; 断; 例 '.': tt[ti] = DT; 断; 例 '=': tt[ti] = s[i + 1] == '=' ? (i++, QK) : AK; 断; 例 '<': tt[ti] = s[i + 1] == '<' ? (s[i + 2] == '=' ? (i += 2, SHL) : (i++, SH)) : s[i + 1] == '=' ? (i++, HK) : LK; 断; 例 '>': tt[ti] = s[i + 1] == '>' ? (s[i + 2] == '=' ? (i += 2, SHR) : (i++, SR)) : s[i + 1] == '=' ? (i++, YK) : GK; 断; 例 '!': tt[ti] = s[i + 1] == '=' ? (i++, XK) : NT; 断; 例 ';': tt[ti] = SK; 断; 例 ',': tt[ti] = CK; 断; 例 '(': tt[ti] = OK; 断; 例 ')': tt[ti] = KK; 断; 例 '{': tt[ti] = FK; 断; 例 '}': tt[ti] = UK; 断; 例 '[': tt[ti] = LB; 断; 例 ']': tt[ti] = RB; 断; 例 ':': tt[ti] = CL; 断; 缺: unknown_chars++; i++; 续; } ti++; i++; /* fix 2026-08-13 Phase3: default 不发射 token (原 ti++ 留下 tt=0=EK 幽灵 token 截断 parse) */
    }
    若 (unknown_chars) fprintf(stderr, "[WARN] lex: %d 未知字符被忽略为空白 (fix 2026-08-09 BUG-5)\n", unknown_chars);
}

