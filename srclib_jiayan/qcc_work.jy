                循环 (tt[tk] == DK) { is_ptr = 1; tk++; } /* 多级指针 **argp */
                整 d = Nd(7);
                若 (tt[tk] == VR) {
                    字 vn[64]; strcpy(vn, tn[tk]); tk++;
                    若 (is_ptr) var_offset_ptr(vn, is_char ? 1 : 4); 否 var_offset(vn);
                    memcpy((字*)(nn + d), vn, 32);
                    若 (tt[tk] == AK) { tk++; Nc(d, expr()); }
