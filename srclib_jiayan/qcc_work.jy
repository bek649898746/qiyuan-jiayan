            若 (brace_init_blk >= 0) { Nc(b, brace_init_blk); b_cnt++; } /* 延迟挂 struct brace init 块 (fix 2026-08-15: merge.c autogen 逗号声明) */
            循环 (tt[tk] == CK) { /* comma-separated: int a = 0, b = 0; */
                tk++;
