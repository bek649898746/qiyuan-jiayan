        var_offset(iname); var_offset(jname); /* 输出/遍历 双计数器 */
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __sq = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), jname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __sj = 0; */
        整 wh = Nd(9);
        { 整 v_j = Nd(1); memcpy((字*)(nn + v_j), jname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_j); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__sj < n) */
        整 bd = Nd(5);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        整 v_j = Nd(1); memcpy((字*)(nn + v_j), jname, 32);
        整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, v_j); /* src[__sj] */
        整 condc = Nd(4); Nc(condc, idx_s); Nc(condc, e_cond); /* cond(src[__sj]) — 参数先挂 callee 最后 */
        整 notc = Nd(2); nv[notc] = T_QK; Nc(notc, condc); { 整 zero = Nd(0); nv[zero] = 0; Nc(notc, zero); } /* cond(...) == 0 为假才保留 (删除 cond 为真) */
        整 ifn = Nd(8); Nc(ifn, notc); /* if (cond(...)!=0) 为真则跳过 */
        整 ibd = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
        整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_i); /* dst[__sq] */
        整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(ibd, asg); /* dst[__sq] = src[__sj]; */
        { 整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); } 整 asg_i = Nd(10); Nc(asg_i, v_i); Nc(asg_i, pl); Nc(ibd, asg_i); } /* __sq++; */
        Nc(ifn, ibd);
        Nc(bd, ifn);
        { 整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_j); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); } 整 asg_j = Nd(10); Nc(asg_j, v_j); Nc(asg_j, pl); Nc(bd, asg_j); } /* __sj++; */
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "旋转")) { /* 接入 2026-08-27 循环右移 (rotate): 旋转 arr, n, k; → { __rt=k%n; if(__rt<0){__rt+=n;} if(__rt!=0){ 三次反转 } } — 三次反转法 O(n), 就地; k 负=左移, k>=n 取模 */
        tk++; /* 旋转 */
