                    续;
                }
                若 (tt[tk] == OK && tt[tk + 1] == VR && tt[tk + 2] == KK) { /* 旧式 fnptr 参数: type (name)(args) — 括号包名后跟参数列表 (fix 2026-08-26 redis: dict.h void dictEmpty(dict *d, void(callback)(dict*)) — 原 OK VR OK 只认 (fn(args)) 不认 (fn)(args) → 死锁) */
                    字 fnm[64]; strcpy(fnm, tn[tk + 1]);
                    tk += 3; /* ( name ) */
                    var_param(fnm, pr, 4, 8, -1, 0, 0); pr++; /* 8 字节函数指针槽 */
                    若 (tt[tk] == OK) { 整 depth = 0; 循环 (tk < TS && tt[tk] != EK) { 若 (tt[tk] == OK) depth++; 否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } } tk++; } } /* (args) 参数列表 — 深度跳过已含闭括号, 勿再消费外层 ) */
                    续;
                }
                若 (tt[tk] == LB) { /* 匿名数组参数: uint32_t[5] 无参数名 (fix 2026-08-13 Phase3: 原无此分支 → LB 卡住死循环, sha1.h sha1_compression_states) */
                    循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 否 若 (tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++; }
                    续;
                }
                若 (tt[tk] == VR) {
                    若 (tt[tk + 1] == VR && tt[tk + 2] != OK) { tk++; } /* 未知类型参数: `mode_t native_mode` — 类型未注册 (系统头被跳过) 时 VR VR 两连, 第一个是类型名非参数名; 原把类型注册成参数占掉 rcx 槽 → 真参数绑到 rdx → 调用方传 rcx 读到垃圾 (fix 2026-08-19: git compat/stat.c mode_t 未注册 → mode_native_to_git 读错槽 → S_ISREG 判定错 → git status 把 HEAD 当目录 → SEGV) */
                    若 (p_fptr) { /* typedef'd fnptr param: fp_t cb — 8-byte pointer slot (fix 2026-08-03) */
                        var_param(tn[tk], pr, 4, 8, -1, 0, 0);
                        若 (p_fptr_dbl) vars[vcnt - 1].p_dbl = 1;
                        tk++; pr++;
                        循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 否 若 (tt[tk] == VR) tk++; /* fix 2026-08-13: 维度标识符跳过 */ 若 (tt[tk] == RB) tk++; } /* skip [N] */
                        若 (tt[tk] == CK) tk++;
                        若 (tt[tk] == DT) { 循环 (tt[tk] == DT) tk++; } /* variadic ellipsis */
                        续;
                    }
                    整 esz = 0;
                    若 (ptr_depth > 1) esz = 8;                    /* T**: 元素是指针 8B — 含 struct** (fix 2026-08-18: 原 struct** esz=struct 大小 → arr_esz=72 → case 12 *pp 不匹配 8/4/2 落到 movzbl 字节加载 → 指针截断低字节 → rename_tempfile tempfile=0x90 → close_tempfile_gently SEGV) */
                    否 若 (p_stidx >= 0) esz = stypes[p_stidx].sz;     /* struct / struct* param: element size = struct size */
                    否 若 (pis_dbl && ptr_depth > 0) esz = 8;       /* double*: 8-byte elements */
                    否 若 (pis_char) esz = 1;                        /* char* */
                    否 若 (pis_void) esz = 1;                        /* t35o: void* 元素 1 字节 (GCC 扩展) */
                    否 若 (ptr_depth > 0) esz = 4;                   /* int* */
                    若 (tt[tk + 1] == LB) { /* array param: int arr[4]; / char *argv[] — decays to a pointer */
                        pis_ptr = 1;
                        若 (ptr_depth > 0) esz = 8; /* pointer array: char *argv[] → 8-byte elements (fix 2026-08-03: was esz=1, argv[1] read a byte instead of a pointer) */
                        否 若 (esz == 0) esz = 4; /* element size for arr[i] scaling */
                    }
                    var_param(tn[tk], pr, pis_ptr ? (ptr_depth > 1 ? 8 : 4) : 0, esz, p_stidx, pis_dbl && !pis_ptr, pis_ll && !pis_ptr); /* fix 2026-08-11: 指针参数 p_esz 原硬编码 4 - 多级指针(char pp / int pp)应 8 */
                    若 (ptr_depth > 0) { vars[vcnt - 1].p_depth = ptr_depth; vars[vcnt - 1].p_inner = p_stidx >= 0 ? stypes[p_stidx].sz : (pis_char ? 1 : (pis_void ? 1 : (pis_dbl ? 8 : (pis_ll ? 8 : 4)))); } /* fix 2026-08-18: (*X)[i] 元素大小/解引用宽度 — char** 参数原 p_esz=8 信息丢失 (store_key 元素 1); t35o: void* p_inner=1 */
                    若 (pis_char && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_char = 1; /* sizeof(char param) (fix 2026-08-05) */
                    若 (pis_short && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_short = 1; /* fix 2026-08-25 bug#31b: short/uint16_t 参数 2 字节槽 */
                    若 (pis_uns && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_uns = 1; /* unsigned param: >> logical (fix 2026-08-05) */
                    若 (pis_ll && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_ll = 1; /* long long param: 8-byte slot (fix 2026-08-05) */
                    若 (pis_dbl && pis_ptr) vars[vcnt - 1].p_dbl = 1; /* double* param */
                    fn_dbl_put((字*)(nn + fdef), pr, pis_dbl && !pis_ptr); /* caller routes scalar doubles to xmm */
                    fn_ll_put((字*)(nn + fdef), pr, pis_ll && !pis_ptr); /* fix 2026-08-25 bug#30: 记录 ll 形参 (int 实参→符号扩展) */
                    tk++; pr++;
                    循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 否 若 (tt[tk] == VR) tk++; /* fix 2026-08-13: 维度标识符跳过 */ 若 (tt[tk] == RB) tk++; } /* skip [N] */
                }
                若 (tt[tk] == CK) tk++;
                若 (tt[tk] == DT) { fn_is_va = 1; 循环 (tt[tk] == DT) tk++; } /* variadic ellipsis ... (dots lex as DT) */
            }
            若 (fn_is_va) {
                整 va_home;
                若 (cur_fn_sret) va_home = (pr < 3) ? 32 + 8 * pr : 56 + 8 * (pr - 3);
                否 va_home = (pr < 4) ? 24 + 8 * pr : 56 + 8 * (pr - 4);
                fn_va_put((字*)(nn + fdef), va_home);
            }
            若 (tt[tk] == SK) { parse_base = 0; tk++; 续; } /* fix 2026-08-12: 无括号声明误判为 fn 也重置 parse_base (同原型泄漏); no-paren decl misparsed as fn: static unsigned char *code; */
            tk++; /* skip ) */
            若 (tt[tk] == VR && !strcmp(tn[tk], "__attribute__")) { tk++; 若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } } /* 声明尾真实 __attribute__((format(...))) 跳过 (空宏后 __attribute__ 是 tt=SK 的「分号」, 不能跳 — 否则原型判定丢失) */
            若 (fdef_is_fnptr_ret) { /* fnptr-return: skip ) closing (*pick) and the trailing (int) before the body */
                若 (tt[tk] == KK) tk++;
                若 (tt[tk] == OK) {
                    整 depth = 0;
                    循环 (tk < TS && tt[tk] != EK) {
                        若 (tt[tk] == OK) depth++;
                        否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                        tk++;
                    }
                }
            }
            若 (tt[tk] == SK) { fn_dbl_set_ret((字*)(nn + fdef), fn_ret_dbl); fn_ll_set_ret((字*)(nn + fdef), fn_ret_ll); parse_base = 0; tk++; 续; } /* fix 2026-08-12: 函数原型后必须重置 parse_base — 否则下一个文件级声明在 parse_base>0 下 var_static 注册 → var_static_kw=1 (误标函数局部 static) → 全局变量从 main 不可见 → printf 参数加载缺失 (b_global) */
            lbl_n = 0; /* fix 2026-08-18: 标签表按函数隔离 — 原跨函数共享同一 id (refs.c 两个 out:), goto out 跳到后一函数 out 标签 → 用垃圾栈执行 ref_transaction_free → 调用栈地址 SEGV (git init check_refname_format) */
            cur_fn_defer_idx = fvn; defer_cnt[fvn] = 0; /* 接入 2026-08-27 defer: 当前函数 defer 收集目标 */
            Nc(fdef, blk()); /* 函数体 (n0) */
            若 (defer_cnt[fvn] > 0) { /* 接入 2026-08-27 defer: LIFO 逆序打包 defer 语句 → n1[fdef] — return/函数尾跳 epi_label 处先执行 */
                整 cb = Nd(5);
                遍 (整 di = defer_cnt[fvn] - 1; di >= 0; di--) Nc(cb, defer_stmts[fvn][di]);
                Nc(fdef, cb); /* n1[fdef] = defer 清理块 (逆序) */
            }
            若 (fvn >= 65536) { fprintf(stderr, "[ERR] 函数体表超过 65536 上限 (fix 2026-08-26 sqlite: 512→8192)\n"); exit(1); }
            fve[fvn] = vcnt; fvn++; /* record var-range end; order == root attach order */
            fr_end[fvn - 1] = rsp_used; /* frame-bound end (vars only; statics inside the body don't touch rsp_used) */
            parse_base = 0; /* back to file scope for the next top-level item */
            Nc(p, fdef);
            若 (fdef_n < 1024) fdef_list[fdef_n++] = fdef; /* fix 2026-08-06: 根子槽只 256 个, 超出的函数用扁平列表保留 (否则 main 被丢) */
        } 否 {  断; } 
    }
    返 p;
}

