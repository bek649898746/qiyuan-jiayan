                        循环 (body[b] == ' ' || body[b] == '\t') b++;
                        续;
                    }
                    若 (body[b] == '#') { /* #param 字符串化 → "转义后的参数" (fix 2026-08-07) */
                        b++;
                        循环 (body[b] == ' ' || body[b] == '\t') b++;
                        字 pn2[64]; 整 pi2 = 0;
                        循环 (isalnum((无 字)body[b]) || body[b] == '_') { 若 (pi2 < 63) pn2[pi2++] = body[b]; b++; }
                        pn2[pi2] = 0;
                        整 matched = -1;
                        遍 (整 p2 = 0; p2 < fn_macros[fmi].pn; p2++) 若 (!strcmp(fn_macros[fmi].params[p2], pn2)) { matched = p2; 断; }
                        若 (matched >= 0 && matched < an) {
                            若 (ti2 < 16382) tmp[ti2++] = '"';
                            整 va_end = !strcmp(pn2, "__VA_ARGS__") ? an : matched + 1; /* fix 2026-08-14: 只有 #__VA_ARGS__ 才逗号连接余参, 普通 #param 只字符串化一个参数 (原 #dll 把所有参数连接 → "secur32.dll, BOOL, ..." 错) */
                            遍 (整 ai = matched; ai < va_end && ti2 < 16380; ai++) {
                                若 (ai > matched) { tmp[ti2++] = ','; 若 (ti2 < 16381) tmp[ti2++] = ' '; }
                                常 字 *src = args[ai];
                                整 sk = 0, sp = 0;
                                循环 (src[sk] && (src[sk] == ' ' || src[sk] == '\t')) sk++; /* 去首空白 */
                                整 sl = 0; 循环 (src[sk + sl]) sl++; 循环 (sl > 0 && (src[sk + sl - 1] == ' ' || src[sk + sl - 1] == '\t')) sl--; /* 去尾空白 */
                                遍 (整 k = sk; k < sk + sl && ti2 < 16380; k++) {
                                    若 ((src[k] == ' ' || src[k] == '\t') && sp) 续; /* 内部连续空白 → 单空格 */
                                    sp = (src[k] == ' ' || src[k] == '\t');
                                    若 (src[k] == '\\' || src[k] == '"') { 若 (ti2 < 16380) tmp[ti2++] = '\\'; } /* 转义 \ 与 " */
                                    tmp[ti2++] = src[k];
                                }
                            }
                            若 (ti2 < 16382) tmp[ti2++] = '"';
                        } 否 { /* 非参数: 原样输出 # + 名字 (畸形宏, 不崩) */
                            若 (ti2 < 16382) tmp[ti2++] = '#';
                            遍 (整 k = 0; k < pi2 && ti2 < 16382; k++) tmp[ti2++] = pn2[k];
                        }
                        续;
                    }
                    若 (isalnum((无 字)body[b]) || body[b] == '_') {
                        字 pn2[64]; 整 pi2 = 0;
                        循环 (isalnum((无 字)body[b]) || body[b] == '_') { 若 (pi2 < 63) pn2[pi2++] = body[b]; b++; }
                        pn2[pi2] = 0;
                        整 matched = -1;
                        遍 (整 p2 = 0; p2 < fn_macros[fmi].pn; p2++) 若 (!strcmp(fn_macros[fmi].params[p2], pn2)) { matched = p2; 断; }
                        若 (matched >= 0 && !strcmp(pn2, "__VA_ARGS__")) { /* 变参: 余参逗号连接 (可空, fix 2026-08-07) */
                            遍 (整 ai = matched; ai < an && ti2 < 16380; ai++) {
                                若 (ai > matched) { tmp[ti2++] = ','; 若 (ti2 < 16381) tmp[ti2++] = ' '; }
                                遍 (整 k = 0; exp_args[ai][k] && ti2 < 16380; k++) tmp[ti2++] = exp_args[ai][k];
                            }
                        } 否 若 (matched >= 0 && matched < an) {
                            遍 (整 k = 0; exp_args[matched][k] && ti2 < 16380; k++) tmp[ti2++] = exp_args[matched][k];
                        } 否 {
                            遍 (整 k = 0; k < pi2 && ti2 < 16382; k++) tmp[ti2++] = pn2[k];
                        }
                    } 否 {
                        若 (ti2 < 16382) tmp[ti2++] = body[b++];
                    }
                }
                tmp[ti2] = 0;
                fn_macro_expand_to(tmp, outp, o, cap, fmi); /* recurse: body may contain nested macro calls */
                fn_exp_n--; /* 弹栈 (fix 2026-08-13) */
                out = *outp;
                续;
            }
            /* plain identifier */
            若 (*o + ni + 1 > *cap) { *cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
            遍 (整 k = 0; k < ni; k++) out[(*o)++] = nm[k];
        } 否 {
            若 (*o + 1 > *cap) { *cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
            out[(*o)++] = seg[i++];
        }
    }
    *outp = out;
}

静 字 *fn_macro_expand(常 字 *s) {
    整 cap = (整)strlen(s) * 2 + 1024;
    字 *out = malloc(cap);
    整 o = 0;
    fn_exp_n = 0; /* fix 2026-08-13: 重置展开栈 */
    fn_macro_expand_to(s, &out, &o, &cap, -1);
    若 (o + 1 > cap) { cap = o + 1; out = realloc(out, cap); }
    out[o] = 0;
    返 out;
}
/* conditional compilation stack (fix 2026-08-05) */
静 整 if_parent_skip[64]; 静 整 if_taken[64]; 静 整 if_n; 静 整 if_skip;
/* #if expression evaluator: defined(X), numbers, macro values, !, &&, ||, comparisons */
静 整 pp_eval(常 字 *e) {
    /* strip outer parens — only if the FIRST ( matches the LAST ) (fix 2026-08-06 M7:
       原只看首尾字符，(1<2)&&(2<3) 被误剥成 1<2)&&(2<3 → 括号失衡) */
    循环 (*e == ' ') e++;
    整 len = (整)strlen(e);
    循环 (len > 0 && e[len-1] == ' ') len--;
    若 (len >= 2 && e[0] == '(') {
        整 d = 0, m = -1;
        遍 (整 i = 0; i < len; i++) {
            若 (e[i] == '(') d++;
            否 若 (e[i] == ')') { d--; 若 (d == 0) { m = i; 断; } }
        }
        若 (m == len - 1) {
            字 inner[512]; memcpy(inner, e+1, len-2); inner[len-2] = 0;
            返 pp_eval(inner);
        }
    }
    若 (e[0] == '!') 返 pp_eval(e + 1) ? 0 : 1;
    /* split on || (lowest precedence), then &&, then ==/!=/< <= > >= — paren-aware (fix 2026-08-06 M7: 原在括号内错拆，(A||B)&&C 拆错) */
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '|' && e[i+1] == '|') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 2);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 (pp_eval(a) || pp_eval(b)) ? 1 : 0;
        }
    }
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '&' && e[i+1] == '&') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 2);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 (pp_eval(a) && pp_eval(b)) ? 1 : 0;
        }
    }
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        字 op = 0; 整 ol = 0;
        若 (dp == 0 && e[i] == '=' && e[i+1] == '=') { op = 1; ol = 2; }
        否 若 (dp == 0 && e[i] == '!' && e[i+1] == '=') { op = 2; ol = 2; }
        否 若 (dp == 0 && e[i] == '<' && e[i+1] == '=') { op = 3; ol = 2; }
        否 若 (dp == 0 && e[i] == '>' && e[i+1] == '=') { op = 4; ol = 2; }
        否 若 (dp == 0 && e[i] == '<') { op = 5; ol = 1; }
        否 若 (dp == 0 && e[i] == '>') { op = 6; ol = 1; }
        若 (op) {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + ol);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            整 x = pp_eval(a), y = pp_eval(b);
            若 (op == 1) 返 x == y;
            若 (op == 2) 返 x != y;
            若 (op == 3) 返 x <= y;
            若 (op == 4) 返 x >= y;
            若 (op == 5) 返 x < y;
            若 (op == 6) 返 x > y;
        }
    }
    /* arithmetic +/- (fix 2026-08-13: git-compat-util.h 的 __STDC_VERSION__ - 0 < 199901L;
       原整串当宏名 → 0 → #error. 优先级低于比较: 比较先拆, 算术在更内层) */
    遍 (整 i = 1, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && (e[i] == '-' || e[i] == '+')) {
            字 a[512], b[512];
            整 la = i;
            循环 (la > 0 && (e[la-1] == ' ' || e[la-1] == '\t')) la--;
            memcpy(a, e, la); a[la] = 0;
            strcpy(b, e + i + 1);
            整 x = pp_eval(a), y = pp_eval(b);
            返 e[i] == '-' ? x - y : x + y;
        }
    }
    /* number or macro name (fix 2026-08-06: 支持负数字面量 #if -5 < 0; 原 -5 落到 macro_find 失败 → 0) */
    整 neg = 0;
    若 (e[0] == '-') { neg = 1; e++; }
    若 (e[0] == '0' && (e[1] == 'x' || e[1] == 'X')) {
        整 v = 0, p = 2; 循环 (isxdigit((无 字)e[p])) { 整 c = e[p]; v = v * 16 + (c >= '0' && c <= '9' ? c - '0' : (c >= 'a' && c <= 'f' ? c - 'a' + 10 : c - 'A' + 10)); p++; }
        返 neg ? -v : v;
    }
    若 (isdigit((无 字)e[0])) { 整 v = 0, p = 0; 循环 (isdigit((无 字)e[p])) v = v * 10 + (e[p++] - '0'); 返 neg ? -v : v; }
    若 (neg) 返 0; /* -名字: 不支持 */
    若 (!strncmp(e, "defined", 7) && e[7] == '(') { /* defined(X) 原子: 逻辑/比较拆分后到达 (fix 2026-08-15: defined(A)||defined(B) 原早退只算 A) */
        字 nm[64]; 整 ni = 0; 整 p = 8;
        循环 (isalnum((无 字)e[p]) || e[p] == '_' || ((无 字)e[p] >= 0x80)) { 若 (ni < 63) nm[ni++] = e[p]; p++; }
        nm[ni] = 0;
        返 (macro_exists(nm) || pp_guard_exists(nm)) ? 1 : 0; /* fix 2026-08-06: 原 macro_find>=0 对负值宏判假; 2026-08-07: 顺序定义表也算 */
    }
    若 (macro_exists(e)) 返 macro_find(e); /* fix 2026-08-06: 原 mv>=0 把负值宏当未找到 → 0 */
    返 pp_guard_val_of(e); /* fix 2026-08-07: 顺序定义表的值 (#define MODE 2 → #if MODE==1 用真值而非存在性) */
}

/* include 目录栈: #include "x.h" 先相对当前源文件所在目录搜索, 再相对 cwd (fix 2026-08-13 Phase3) */
静 字 inc_dir_stack[16][512]; 静 整 inc_dir_n;
静 字 g_src_dir[512]; /* 顶层源文件目录 */
静 空 dir_of_path(常 字 *path, 字 *out, 整 cap) {
    整 i = 0, last = -1;
    循环 (path[i]) { 若 (path[i] == '/' || path[i] == '\\') last = i; i++; }
    若 (last > 0) { 整 n = last < cap - 1 ? last : cap - 1; memcpy(out, path, n); out[n] = 0; }
    否 out[0] = 0;
}
静 字 *pp_read_file_inc(常 字 *fname);

/* #include "file" — 预处理器包含展开（lex 前；条件编译感知；fix 2026-08-06） */
静 字 *pp_read_file(常 字 *path) {
    FILE *f = fopen(path, "rb");
    若 (!f) 返 0;
    fseek(f, 0, SEEK_END); 长 sz = ftell(f); fseek(f, 0, SEEK_SET);
    若 (sz < 0) { fclose(f); 返 0; }
    若 (sz > 4 * 1024 * 1024) { fclose(f); fprintf(stderr, "[ERR] #include 文件超过 4MB 上限 (fix 2026-08-06 M8: 原无大小上限，编译不可信源码=任意大文件读取面)\n"); exit(1); }
    字 *buf = malloc((size_t)sz + 1);
    若 (!buf) { fclose(f); 返 0; }
    size_t rd = fread(buf, 1, (size_t)sz, f);
    buf[rd] = 0; fclose(f);
    返 buf;
}
静 字 *pp_read_file_inc(常 字 *fname) {
    若 (!strcmp(fname, "accctrl.h") || !strcmp(fname, "aclapi.h")) {
        /* Windows SDK 头文件不在源码树内; compat_prelude.h 已提供 ipc-win32.c 所需的类型/宏/API stub (fix 2026-08-15: ipc_get_active_state undefined) */
        字 *stub = malloc(2);
        若 (stub) stub[0] = 0;
        返 stub;
    }
    若 (inc_dir_n > 0 && inc_dir_stack[inc_dir_n - 1][0]) {
        字 full[1024];
        strcpy(full, inc_dir_stack[inc_dir_n - 1]);
        strcat(full, "/");
        strcat(full, fname);
        字 *fc = pp_read_file(full);
        若 (fc) 返 fc;
    }
    返 pp_read_file(fname);
}
/* 第N行: 计算源码 pos 处的行号 (fix 2026-08-06 Task 5.3 中文诊断) */
静 整 rt_line_skip = 0; /* prepend 的 qcc_rt.c 行数 (用户源码行号校正) */
静 整 line_at(常 字 *s, 整 pos) {
    整 ln = 1;
    遍 (整 k = 0; k < pos && s[k]; k++) 若 (s[k] == '\n') ln++;
    返 ln - rt_line_skip;
}
静 字 *pp_include_expand(常 字 *src, 整 depth) {
    若 (depth > 8) { fprintf(stderr, "[ERR] #include 嵌套超过 8 层\n"); exit(1); }
    若 (depth == 0) { pp_guard_n = 0; inc_dir_n = 0; 若 (g_src_dir[0]) { strcpy(inc_dir_stack[inc_dir_n], g_src_dir); inc_dir_n++; } } /* fix 2026-08-13 Phase3: 顶层源文件目录入栈 */
    整 cap = (整)strlen(src) + 16384;
    字 *out = malloc(cap); 若 (!out) { fprintf(stderr, "[ERR] OOM malloc\n"); exit(1); } 整 oi = 0;
    常 字 *p = src;
    整 if_skip = 0, if_n = 0;
    整 if_parent_skip[64], if_taken[64];
    循环 (*p) {
        常 字 *le = p; 循环 (*le && *le != '\n') le++;
        整 llen = (整)(le - p);
        若 (*p == '#') {
            整 is_ifdef = !strncmp(p, "#ifdef", 6);
            整 is_ifndef = !strncmp(p, "#ifndef", 7);
            整 is_if = !strncmp(p, "#if", 3) && !is_ifdef && !is_ifndef;
            整 is_elif = !strncmp(p, "#elif", 5);
            整 is_else = !strncmp(p, "#else", 5);
            整 is_endif = !strncmp(p, "#endif", 6);
            整 is_include = !strncmp(p, "#include", 8);
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = if_skip; 整 cond = 0;
                若 (is_ifdef || is_ifndef) {
                    字 nm[64]; 整 ni = 0; 常 字 *q = p + (is_ifdef ? 6 : 7);
                    循环 (*q == ' ' || *q == '\t') q++;
                    循环 (isalnum(*q) || *q == '_' || ((无 字)*q >= 0x80)) { 若 (ni < 63) nm[ni++] = *q; q++; }
                    nm[ni] = 0;
                    整 def = pp_guard_exists(nm); /* fix 2026-08-07: 原 macro_exists 在 include 阶段为空 → 守卫永远假 → 重复头重复展开内部 #include */
                    cond = is_ifdef ? def : !def;
                } 否 若 (is_if || is_elif) {
                    字 expr[512]; 整 ei = 0; 常 字 *q = p + (is_if ? 3 : 5);
                    循环 (*q == ' ' || *q == '\t') q++;
                    循环 (*q && *q != '\n' && ei < 510) expr[ei++] = *q++;
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--;
                    expr[ei] = 0;
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (if_n < 64) { if_parent_skip[if_n] = parent; if_taken[if_n] = cond && !parent; if_skip = parent || !cond; if_n++; }
                } 否 若 (is_elif) {
                    若 (if_n > 0) { 若 (!if_taken[if_n-1] && !if_parent_skip[if_n-1]) { if_taken[if_n-1] = cond; if_skip = if_parent_skip[if_n-1] || !cond; } 否 if_skip = 1; }
                } 否 若 (is_else) {
                    若 (if_n > 0) { 若 (!if_taken[if_n-1] && !if_parent_skip[if_n-1]) { if_taken[if_n-1] = 1; if_skip = if_parent_skip[if_n-1]; } 否 if_skip = 1; }
                } 否 若 (is_endif) {
                    若 (if_n > 0) { if_n--; if_skip = if_n > 0 ? !if_taken[if_n-1] : 0; } /* fix 2026-08-13 Phase3: 嵌套假分支恢复用 !taken 而非 parent */
                }
                memcpy(out + oi, p, llen + 1); oi += llen + 1;
            } 否 若 (is_include && !if_skip) {
                常 字 *q = p + 8;
                循环 (*q == ' ' || *q == '\t') q++;
                若 (*q != '"') { memcpy(out + oi, p, llen + 1); oi += llen + 1; } /* <系统头> 跳过（自包含） */
                否 {
                    字 fname[512]; 整 fi = 0;
                    q++; 循环 (*q && *q != '"' && fi < 510) fname[fi++] = *q++;
                    fname[fi] = 0;
                    若 (fi > 0) {
                        字 *fc = pp_read_file_inc(fname);
                        若 (!fc) { fprintf(stderr, "[ERR] 第%d行 #include: 找不到文件 '%s'\n", line_at(src, (整)(p - src)), fname); exit(1); } /* fix 2026-08-06 Task 5.3: 行号定位 */
                        字 fdir[512]; dir_of_path(fname, fdir, 大小(fdir)); /* fix 2026-08-13 Phase3: 子目录 include 相对当前源文件目录 */
                        字 newdir[1024]; newdir[0] = 0;
                        若 (inc_dir_n > 0 && inc_dir_stack[inc_dir_n - 1][0]) {
                            strcpy(newdir, inc_dir_stack[inc_dir_n - 1]); /* 继承父目录 */
                            若 (fdir[0]) { strcat(newdir, "/"); strcat(newdir, fdir); }
                        } 否 {
                            strcpy(newdir, fdir);
                        }
                        若 (inc_dir_n < 16) { strcpy(inc_dir_stack[inc_dir_n], newdir); inc_dir_n++; }
                        字 *exp = pp_include_expand(fc, depth + 1);
                        inc_dir_n--;
                        free(fc);
                        整 el = (整)strlen(exp);
                        若 (oi + el + 2 >= cap) { cap = oi + el + 16384; out = realloc(out, cap); }
                        memcpy(out + oi, exp, el); oi += el;
                        out[oi++] = '\n';
                        free(exp);
                    }
                }
            } 否 {
                /* fix 2026-08-07: 注册 #define 名 → include 守卫生效; #undef 移除 */
                整 is_def = !strncmp(p, "#define", 7);
                整 is_undef = !strncmp(p, "#undef", 6);
                若 (is_def && !if_skip) {
                    字 mnm[64]; 整 mval = 0;
                    pp_def_parse(p, mnm, &mval); /* fix 2026-08-07: 名字+数值都记 */
                    若 (mnm[0]) pp_guard_add(mnm, mval);
                } 否 若 (is_undef) {
                    常 字 *q = p + 6;
                    循环 (*q == ' ' || *q == '\t') q++;
                    字 mnm[64]; 整 mi = 0;
                    循环 (isalnum((无 字)*q) || *q == '_' || ((无 字)*q >= 0x80)) { 若 (mi < 63) mnm[mi++] = *q; q++; }
                    mnm[mi] = 0;
                    若 (mi > 0) pp_guard_del(mnm);
                }
                memcpy(out + oi, p, llen + 1); oi += llen + 1;
            }
        } 否 {
            memcpy(out + oi, p, llen + 1); oi += llen + 1;
        }
        若 (oi >= cap - 4096) { cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +32768 (bump realloc 泄漏) */; out = realloc(out, cap); }
        p = *le ? le + 1 : le;
    }
    out[oi] = 0;
    返 out;
}

静 整 rsp_used;           /* ????????? */

/* ?????? struct ??????????? */
静 构 { 字 name[64]; 字 fnames[256][64]; 整 foffs[256]; 整 fsizes[256]; 整 frows[256]; 整 ftypes[256]; 整 fbits[256]; 整 fbitof[256]; 字 fdbls[256]; 字 fsgn[256]; 整 fels[256]; 整 fn; 整 sz; 整 algn; } stypes[256]; /* fels: 数组字段元素大小 (fix 2026-08-07) */ 静 整 st_n; /* algn: struct 最大对齐（fix 2026-08-06）; fix 2026-08-13 字段表 64→128 (diff_options 71 字段); fix 2026-08-14 128→256 (rev_info 130+ 字段) */

静 整 st_find(常 字 *n) {
    遍 (整 i = 0; i < st_n; i++) 若 (!strcmp(stypes[i].name, n)) 返 i;
    返 -1;
}
静 整 bit_slot = -1, bit_pos = 0;  /* bit-field packing state: current int-slot foffs + bit offset inside it */
静 空 st_finalize(整 si) { /* fix 2026-08-06: struct 总大小按最大对齐 round up — 原只记 algn 未应用, SC{int,char}=5 应为 8 (数组 stride/sret 一致性) */
    若 (si >= 0 && stypes[si].algn > 1 && stypes[si].sz % stypes[si].algn)
        stypes[si].sz += stypes[si].algn - (stypes[si].sz % stypes[si].algn);
}
静 整 st_add(常 字 *n) {
    若 (st_n >= 256) 返 -1;
    strcpy(stypes[st_n].name, n); stypes[st_n].fn = 0; stypes[st_n].sz = 0; stypes[st_n].algn = 1;
    bit_slot = -1; bit_pos = 0; /* reset bit-field packing for the new struct */
    返 st_n++;
}
静 空 st_field_sz_r(整 si, 常 字 *fn, 整 fsz, 整 frow) {
    若 (stypes[si].fn >= 256) { fprintf(stderr, "[ERR] struct '%s' 字段超过 256 上限\n", stypes[si].name); exit(1); }
    整 idx = stypes[si].fn;
    /* fix 2026-08-06: struct 字段对齐填充（char+int 应 8 非 5）。对齐单位由 frow（元素/行大小）推导:
       frow>=8 → 8 (double/LL/指针); frow>=4 → 4 (int/float); frow>=2 → 2 (short)。数组字段 frow=元素大小。
       fix 2026-08-07: fsz>=8 也 8 对齐 — 指针字段 (struct LNode* next) 调用传 frow=1 → 原 align=1 → 偏移错位 (读 [&b+4] 而非 +8) */
    整 align = 1;
    若 (frow >= 8 || fsz >= 8) align = 8;
    否 若 (frow >= 4 || fsz >= 4) align = 4;
    否 若 (frow >= 2 || fsz >= 2) align = 2;
    若 (stypes[si].sz % align) stypes[si].sz += align - (stypes[si].sz % align); /* pad 字段偏移到对齐 */
    strcpy(stypes[si].fnames[idx], fn);
    stypes[si].foffs[idx] = stypes[si].sz;
    stypes[si].fsizes[idx] = fsz;
    memcpy(&stypes[si].frows[idx], &frow, 4); /* fix 2026-08-05: direct frows[idx]=frow made nested-store scale read the OLD st_field_row -> self-referential garbage on self-host; &arr[i] scales by the fixed element size */
    stypes[si].ftypes[idx] = -1; /* not a struct field by default */
    stypes[si].fbits[idx] = 0; stypes[si].fbitof[idx] = 0; /* non bit-field */
    stypes[si].fsgn[idx] = 0; /* non bit-field: signedness irrelevant (fix 2026-08-05) */
    bit_slot = -1; bit_pos = 0; /* a non-bit-field ends any pending bit run */
    stypes[si].sz += fsz;
    若 (align > stypes[si].algn) stypes[si].algn = align; /* 记录 struct 最大对齐（总大小 round up） */
    stypes[si].fn = stypes[si].fn + 1;
}
静 整 st_fidx(整 si, 常 字 *fn) { 遍 (整 i = 0; i < stypes[si].fn; i++) 若 (!strcmp(stypes[si].fnames[i], fn)) 返 i; 返 -1; }
静 整 st_field_el(整 si, 常 字 *fn) { 整 idx = st_fidx(si, fn); 返 (idx >= 0 && stypes[si].fels[idx] > 0) ? stypes[si].fels[idx] : (idx >= 0 ? stypes[si].frows[idx] : 1); } /* 数组字段元素大小; 未设置→frow (标量) */
静 整 st_field_row(常 字 *sn, 常 字 *fn); /* fwd */
静 整 st_field_is_dbl(常 字 *sn, 常 字 *fn); /* fwd */
静 空 st_field_2d_setup(整 si, 常 字 *fn) { /* fix 2026-08-07: struct 数组字段 → 布好 2D 深度状态 (第一维行大小, 第二维元素大小) */
    整 row = st_field_row(stypes[si].name, fn);
    整 el = st_field_el(si, fn);
    cg_mem_frow = el;                /* deref 用元素大小 */
    cg_fdepth = 0;
    cg_frows[0] = row;               /* 第一维 (行) 缩放 */
    cg_frows[1] = el;                /* 第二维 (列) 缩放 */
    cg_fdepth_max = (row > el) ? 2 : 1; /* 2D 字段: 第二维后才 deref; 1D: 第一维后 */
    cg_mem_dbl = st_field_is_dbl(stypes[si].name, fn) ? 1 : 0;
}
静 空 st_field_bit(整 si, 常 字 *fn, 整 fsz, 整 frow, 整 bitw, 整 uns) {
    /* real bit-field semantics: pack consecutive bit-fields into shared int slots.
       foffs = slot byte offset; fbitof = bit offset inside the slot; fbits = width.
       uns = 1 for `unsigned` bit-fields (no sign extension on read); int → signed. */
    若 (stypes[si].fn >= 256) { fprintf(stderr, "[ERR] struct 字段超过 256 上限\n"); exit(1); }
    整 idx = stypes[si].fn;
    strcpy(stypes[si].fnames[idx], fn);
    若 (bit_slot < 0 || bit_pos + bitw > 32) { bit_slot = stypes[si].sz; stypes[si].sz += 4; bit_pos = 0; }
    stypes[si].foffs[idx] = bit_slot;
    stypes[si].fsizes[idx] = fsz;
    memcpy(&stypes[si].frows[idx], &frow, 4);
    stypes[si].ftypes[idx] = -1;
    stypes[si].fbits[idx] = bitw;
    stypes[si].fbitof[idx] = bit_pos;
    stypes[si].fsgn[idx] = uns;
    bit_pos += bitw;
    stypes[si].fn = stypes[si].fn + 1;
}
静 空 st_field_bit_anon(整 si, 整 bitw) {
    /* unnamed bit-field ": N" — occupies bits but registers no field (fix 2026-08-05).
       : 0 forces the next named bit-field into a fresh int slot (C rule). */
    若 (bitw > 0) {
        若 (bit_slot < 0 || bit_pos + bitw > 32) { bit_slot = stypes[si].sz; stypes[si].sz += 4; bit_pos = 0; }
        bit_pos += bitw;
    } 否 {
        bit_slot = -1; bit_pos = 0; /* zero-width: next field starts a new slot */
    }
}
静 空 st_field_ty(整 si, 常 字 *fn, 整 ty) {
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { stypes[si].ftypes[i] = ty; 返; }
}
静 整 st_field_ty_idx(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 -1;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v; memcpy(&v, &stypes[si].ftypes[i], 4); 返 v; }
    返 -1;
}
静 空 st_field_dbl(整 si, 常 字 *fn) { /* mark a struct field as double (8-byte movsd access) */
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { stypes[si].fdbls[i] = 1; 返; }
}
静 整 st_field_is_dbl(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v = 0; memcpy(&v, &stypes[si].fdbls[i], 1); 返 v != 0; } /* fix 2026-08-05: `int v; memcpy(&v,...,1)` left 3 garbage bytes → self-host flagged plain fields as double → comparisons went fp; v=0 zeroes the slot first */
    返 0;
}
静 空 st_field_sz(整 si, 常 字 *fn, 整 fsz) { st_field_sz_r(si, fn, fsz, 1); }
/* union field: offset 0, size = MAX of all fields */
静 空 st_union_field(整 si, 常 字 *fn, 整 fsz) {
    若 (stypes[si].fn >= 256) { fprintf(stderr, "[ERR] struct 字段超过 256 上限\n"); exit(1); }
    整 idx = stypes[si].fn;
    strcpy(stypes[si].fnames[idx], fn);
    stypes[si].foffs[idx] = 0;
    stypes[si].fsizes[idx] = fsz;
    stypes[si].frows[idx] = 1;
    stypes[si].ftypes[idx] = -1;
    stypes[si].fbits[idx] = 0; stypes[si].fbitof[idx] = 0; stypes[si].fsgn[idx] = 0; /* union fields: never bit-fields (fix 2026-08-05) */
    若 (fsz > stypes[si].sz) stypes[si].sz = fsz;
    stypes[si].fn = stypes[si].fn + 1;
}
__attribute__((unused))
静 空 st_field(整 si, 常 字 *fn) { st_field_sz(si, fn, 4); }
静 整 st_field_row(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v; memcpy(&v, &stypes[si].frows[i], 4); 返 v; }
    返 0;
}
静 整 st_off(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 -1;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v; memcpy(&v, &stypes[si].foffs[i], 4); 返 v; }
    返 -1;
}
静 整 st_field_bitw(常 字 *sn, 常 字 *fn) { /* bit-field width, 0 = not a bit-field (fix 2026-08-05) */
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v; memcpy(&v, &stypes[si].fbits[i], 4); 返 v; }
    返 0;
}
静 整 st_field_bitof(常 字 *sn, 常 字 *fn) { /* bit offset inside the slot (fix 2026-08-05) */
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v; memcpy(&v, &stypes[si].fbitof[i], 4); 返 v; }
    返 0;
}
静 整 st_field_is_uns(常 字 *sn, 常 字 *fn) { /* 1 = unsigned bit-field (no sign-extend on read) (fix 2026-08-05) */
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v = 0; memcpy(&v, &stypes[si].fsgn[i], 1); 返 v != 0; }
    返 0;
}
静 整 st_sz(常 字 *sn) { 整 si = st_find(sn); 返 si >= 0 ? stypes[si].sz : 0; }
静 整 st_field_size(常 字 *sn, 常 字 *fn) {
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v; memcpy(&v, &stypes[si].fsizes[i], 4); 返 v; }
    返 0;
}

/* ?????? typedef ??????????? */
静 构 { 字 name[64]; 整 is_struct; 字 st_name[64]; 字 is_dbl;
                 字 is_fnptr; 字 fnptr_dbl; } tdefs[512]; 静 整 tdef_n;

__attribute__((unused))
静 整 tdef_lookup(常 字 *n) {
    遍 (整 i = 0; i < tdef_n; i++) 若 (!strcmp(tdefs[i].name, n)) 返 i;
    返 -1;
}
/* struct type index for a typedef name that aliases a struct (else -1) */
静 整 td_st_index(常 字 *n) {
    整 i = tdef_lookup(n);
    若 (i >= 0 && tdefs[i].is_struct) 返 st_find(tdefs[i].st_name);
    返 -1;
}
__attribute__((unused))
静 空 tdef_add(常 字 *n, 整 is_st, 常 字 *sn, 整 is_dbl) {
    若 (tdef_n >= 512) 返;
    /* check for duplicate */
    遍 (整 i = 0; i < tdef_n; i++) 若 (!strcmp(tdefs[i].name, n)) 返;
    strcpy(tdefs[tdef_n].name, n);
    tdefs[tdef_n].is_struct = is_st;
    tdefs[tdef_n].is_dbl = (字)is_dbl;
    tdefs[tdef_n].is_fnptr = 0;
    tdefs[tdef_n].fnptr_dbl = 0;
    若 (sn) strcpy(tdefs[tdef_n].st_name, sn);
    tdef_n++;
}
/* fnptr typedef: typedef int (*fp_t)(int,int); — 8-byte element, never a double slot */
静 空 tdef_add_fnptr(常 字 *n, 整 ret_dbl) {
    若 (tdef_n >= 512) 返;
    遍 (整 i = 0; i < tdef_n; i++) 若 (!strcmp(tdefs[i].name, n)) 返;
    strcpy(tdefs[tdef_n].name, n);
    tdefs[tdef_n].is_struct = 0;
    tdefs[tdef_n].is_dbl = 0; /* fnptr is a POINTER, not a double value */
    tdefs[tdef_n].is_fnptr = 1;
    tdefs[tdef_n].fnptr_dbl = (字)(ret_dbl ? 1 : 0); /* double-returning fnptr: fp(x) yields xmm0 */
    tdefs[tdef_n].st_name[0] = 0;
    tdef_n++;
}

/* 闁冲厜鍋撻柍鍏夊亾闁冲厜�?typedef lexer�? 婵炲鍔岄崬浠嬪礆椤愩垺�?�?blk/parse濞戞挾鎹奷_is闁告帇鍊栭弻?闁冲厜鍋撻柍鍏夊亾闁冲厜�?*/
静 字 tdn[512][64]; 静 整 tdn_n;
静 空 td_reg(常 字 *n) {
    遍 (整 i = 0; i < tdn_n; i++) 若 (!strcmp(tdn[i], n)) 返;
    若 (tdn_n < 512) { strcpy(tdn[tdn_n], n); tdn_n++; }
}
静 整 td_is(常 字 *n) {
    遍 (整 i = 0; i < tdn_n; i++) 若 (!strcmp(tdn[i], n)) 返 1;
    返 0;
}

/* 闁冲厜鍋撻柍鍏夊亾闁冲厜�?enum 閻㈩垱鎮傞崳铏规�?闁冲厜鍋撻柍鍏夊亾闁冲厜�?*/
静 构 { 字 name[64]; 整 val; } evals[8192]; 静 整 eval_n; /* fix 2026-08-15: 256→8192 — builtin/add.c 等大文件 include 链注册 enum 常量超 256, CMIT_FMT_EMAIL 被静默丢弃 → jyld undefined */
静 空 e_reg(常 字 *n, 整 v) {
    若 (eval_n >= 8192) 返;
    strcpy(evals[eval_n].name, n); evals[eval_n].val = v; eval_n++;
}
静 整 e_lookup(常 字 *n) {
    遍 (整 i = 0; i < eval_n; i++) 若 (!strcmp(evals[i].name, n)) 返 evals[i].val;
    返 0x80000000; /* ENUM_NOT_FOUND (fix 2026-08-09: 原 -1 与负值 enum 常量冲突 → RED=-2 被当未找到 → 当变量用=0) */
}

/* ?????????? double ??????????? */
静 整 dbl_hi[1024]; 静 整 dbl_lo[1024]; 静 整 dbl_n;
静 整 g_uns_shift; /* set by cg() before alu_rr: T_SR operand is unsigned → SHR (fix 2026-08-05) */
静 整 g_uns_div;   /* set by cg() before alu_rr: T_DV/T_MD operand(s) unsigned → DIV (fix 2026-08-06 M1) */
/* parse a floating literal at s[*i] (digits [ . digits] [e[+-]digits]) into its
   IEEE-754 bit pattern; advances *i past the literal. Self-host has NO real
   long long (it's a 32-bit int), so the 8-byte pattern is returned as two
   ints (hi/lo) read out of the double's frame-slot bytes via a char*. */
静 空 fp_parse(常 字 *s, 整 *pi, 整 *out_hi, 整 *out_lo) {
    双 v = 0; 整 i = *pi;
    循环 (s[i] >= '0' && s[i] <= '9') { v = v * 10 + (s[i] - '0'); i++; }
    若 (s[i] == '.') { i++; 双 fr = 0, sc = 1; 循环 (s[i] >= '0' && s[i] <= '9') { fr = fr * 10 + (s[i] - '0'); sc *= 10; i++; } v += fr / sc; } /* fix 2026-08-06: 整数累加+单次除法，避免 fr*=0.1 累加误差（0.015625 等精确） */
    若 (s[i] == 'e' || s[i] == 'E') {
        i++; 整 es = 1;
        若 (s[i] == '+' || s[i] == '-') { 若 (s[i] == '-') es = -1; i++; }
        整 e = 0; 循环 (s[i] >= '0' && s[i] <= '9') { e = e * 10 + (s[i] - '0'); i++; }
        双 p10 = 1; 遍 (整 k = 0; k < e; k++) p10 *= 10;
        若 (es > 0) v *= p10; 否 v /= p10;
    }
    *pi = i;
    字 *vp = (字 *)&v;
    整 lo = (vp[0] & 0xff) | ((vp[1] & 0xff) << 8) | ((vp[2] & 0xff) << 16) | ((vp[3] & 0xff) << 24);
    整 hi = (vp[4] & 0xff) | ((vp[5] & 0xff) << 8) | ((vp[6] & 0xff) << 16) | ((vp[7] & 0xff) << 24);
    *out_lo = lo; *out_hi = hi;
}

/* hex float literal: 0x1.8p3 = 1.5*2^3 = 12.0 (C99; fix 2026-08-05: was parsed as hex int then junk) */
静 空 hexfp_parse(常 字 *s, 整 *pi, 整 *out_hi, 整 *out_lo) {
    双 v = 0; 整 i = *pi; /* s[i] = first hex digit (after 0x) */
    循环 (isxdigit((无 字)s[i])) { 整 c = s[i] | 0x20; v = v * 16 + (c <= '9' ? c - '0' : c - 'a' + 10); i++; }
    若 (s[i] == '.') {
        i++;
        双 fr = 1.0 / 16;
        循环 (isxdigit((无 字)s[i])) { 整 c = s[i] | 0x20; 双 d = c <= '9' ? c - '0' : c - 'a' + 10; v += d * fr; fr /= 16; i++; }
    }
    若 (s[i] == 'p' || s[i] == 'P') {
        i++; 整 es = 1;
        若 (s[i] == '+' || s[i] == '-') { 若 (s[i] == '-') es = -1; i++; }
        整 e = 0; 循环 (s[i] >= '0' && s[i] <= '9') { e = e * 10 + (s[i] - '0'); i++; }
        双 p2 = 1; 遍 (整 k = 0; k < e; k++) p2 *= 2;
        若 (es > 0) v *= p2; 否 v /= p2;
    }
    *pi = i;
    字 *vp = (字 *)&v;
    整 lo = (vp[0] & 0xff) | ((vp[1] & 0xff) << 8) | ((vp[2] & 0xff) << 16) | ((vp[3] & 0xff) << 24);
    整 hi = (vp[4] & 0xff) | ((vp[5] & 0xff) << 8) | ((vp[6] & 0xff) << 16) | ((vp[7] & 0xff) << 24);
    *out_lo = lo; *out_hi = hi;
}

/* ?????? token type constants (must precede codegen functions) ?????? */
#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2
#define T_PK 5   /* + */
#define T_MK 6   /* - */
#define T_DK 7   /* * */
#define T_QK 8   /* == */
#define T_LK 11  /* < */
#define T_GK 21  /* > */
#define T_XK 10  /* != */
#define T_HK 22  /* <= */
#define T_YK 23  /* >= */
#define T_DV 42  /* / */
#define T_MD 43  /* % */
#define T_SH 44  /* << */
#define T_SR 45  /* >> */
静 空 b(无 字 v) { 若 (cp >= CODE_BUF_CAP) { fprintf(stderr, "qcc_x86: code buffer overflow (fix 2026-08-09 审计)\n"); exit(1); } code[cp++] = v; }
静 空 b4(整 v) { b(v & 0xff); b((v >> 8) & 0xff); b((v >> 16) & 0xff); b((v >> 24) & 0xff); }

/* ModR/M: mod=0(reg,[reg+disp])/1(reg,[reg+disp8])/2(reg,[reg+disp32])/3(reg,reg) */
静 空 modrm(整 mod, 整 reg, 整 rm) { b((mod << 6) | ((reg & 7) << 3) | (rm & 7)); }
/* REX prefix: W=64bit, R=reg ext, X=index ext, B=rm ext */
静 空 rex(整 w, 整 r, 整 x, 整 bval) { b(0x40 | (w ? 8 : 0) | (r ? 4 : 0) | (x ? 2 : 0) | (bval ? 1 : 0)); }

/* MOV reg32, imm32 (zero-extends to 64-bit in x86-64) */
静 空 mov_r_imm(整 reg, 整 imm) { asm_emit("    移动 r%d, %d\n", (字*)(长 长)(reg), (字*)(长 长)(imm), (字*)(长 长)0); b(0xB8 | (reg & 7)); b4(imm); }
/* MOV rax, imm64 (48 B8 imm64) — long long literals (fix 2026-08-05) */
静 空 mov_rax_imm64(长 长 imm) {
    asm_emit("    移动64 r0, %d, %d\n", (字*)(长 长)((整)(imm & 0xFFFFFFFF)), (字*)(长 长)((整)(((无 长 长)imm) >> 32)), (字*)(长 长)0); /* text: lo, hi (asm_zh needs hi for H1==H2; fix 2026-08-05) */
    b(0x48); b(0xB8); b4((整)(imm & 0xFFFFFFFF)); b4((整)(((无 长 长)imm) >> 32));
}
/* push/pop r64 (sub rsp,8; mov [rsp],r64) — 64-bit temporaries, nesting-safe (fix 2026-08-05) */
/* NOTE: defined after sub_rsp_imm/add_rsp_imm (below 831) — sub_rsp_imm needs its forward decl first */
/* MOV [rsp+disp], reg32 */
__attribute__((unused))
静 空 mov_mrsp_reg(整 disp, 整 reg) {
    asm_emit("    存栈32 [rsp%+d], r%d\n", (字*)(长 长)(disp), (字*)(长 长)(reg), (字*)(长 长)0);
    rex(0, reg & 8, 0, 0); b(0x89);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
/* MOV reg32, [rsp+disp] */
__attribute__((unused))
静 空 mov_reg_mrsp(整 reg, 整 disp) {
    asm_emit("    取栈32 r%d, [rsp%+d]\n", (字*)(长 长)(reg), (字*)(长 长)(disp), (字*)(长 长)0);
    rex(0, reg & 8, 0, 0); b(0x8B);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
/* MOV reg64, reg64 */
静 空 mov_rr64(整 dst, 整 src) { asm_emit("    移64 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0); rex(1, src & 8, 0, dst & 8); b(0x89); modrm(3, src & 7, dst & 7); }
/* MOV reg32, reg32 */
静 空 mov_rr(整 dst, 整 src) { asm_emit("    移32 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0); rex(0, src & 8, 0, dst & 8); b(0x89); modrm(3, src & 7, dst & 7); }

/* ADD/SUB/IMUL/CMP reg32, reg32 ??op is token type (PK/MK/DK/QK) */
静 空 alu_rr(整 op, 整 dst, 整 src) {
    若 (op == T_PK) asm_emit("    加 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0);
    否 若 (op == T_MK) asm_emit("    减 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0);
    否 若 (op == T_DK) asm_emit("    乘 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0);
    否 若 (op == T_QK) asm_emit("    比较 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0);
    否 若 (op == 25 || op == 46) asm_emit("    与 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0); /* & : PT(25) from a&b, AN(46) from a&=b — fix 2026-08-05 */
    否 若 (op == 47) asm_emit("    或 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0);
    否 若 (op == 48) asm_emit("    异或 r%d, r%d\n", (字*)(长 长)(dst), (字*)(长 长)(src), (字*)(长 长)0);
    否 若 (op == T_DV || op == T_MD) { /* 除: expanded as 扩展符号 + 整除 r9 (explicit texts) */ }
    若 (op == T_SH || op == T_SR) {
        /* fix: ASM text order must match byte order (mov ecx,eax emitted first).
           T_SR: emit ONE text+byte pair below (逻辑右移/SHR or 算术右移/SAR) — the
           generic `右移` line here would DOUBLE the text (H2 emitted 2× SAR → H1≠H2,
           fix 2026-08-06, matches grok-build's single emission). */
        mov_rr(1, 0); /* ecx = shift count */
        若 (op == T_SH) asm_emit("    左移 r%d, cl\n", (字*)(长 长)(dst), (字*)(长 长)0, (字*)(长 长)0);
        否 若 (op == T_SR) { /* fallthrough to the SHR/SAR line below */ }
        否 asm_emit("    右移 r%d, cl\n", (字*)(长 长)(dst), (字*)(长 长)0, (字*)(长 长)0);
        /* unsigned operand >> → SHR (logical); signed → SAR (fix 2026-08-05: always SAR) */
        若 (op == T_SR) {
            整 use_shr = g_uns_shift;
            g_uns_shift = 0;
            若 (use_shr) { asm_emit("    逻辑右移 r%d, cl\n", (字*)(长 长)(dst), (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, dst & 8); b(0xD3); modrm(3, 5, dst & 7); }
            否 { asm_emit("    算术右移 r%d, cl\n", (字*)(长 长)(dst), (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, dst & 8); b(0xD3); modrm(3, 7, dst & 7); }
            返;
        }
        rex(0, 0, 0, dst & 8); b(0xD3); modrm(3, 4, dst & 7);
        返;
    }
    若 (op == 25 || op == 46) { rex(0, src & 8, 0, dst & 8); b(0x21); modrm(3, src & 7, dst & 7); 返; } /* & (fix 2026-08-05: AN=46 from &=) */
    若 (op == 47) { rex(0, src & 8, 0, dst & 8); b(0x09); modrm(3, src & 7, dst & 7); 返; } /* | */
    若 (op == 48) { rex(0, src & 8, 0, dst & 8); b(0x31); modrm(3, src & 7, dst & 7); 返; } /* ^ */
    若 (op == T_DK) {
        /* IMUL: reg=destination, rm=source */
        rex(0, dst & 8 ? 1 : 0, 0, src & 8 ? 1 : 0);
        b(0x0F); b(0xAF); modrm(3, dst & 7, src & 7);
        返;
    }
    若 (op == T_DV || op == T_MD) {
        整 use_udiv = g_uns_div; g_uns_div = 0; /* fix 2026-08-06 M1: unsigned 除法 */
        mov_rr(9, 0); /* r9d = divisor */
        mov_rr(0, dst); /* eax = dividend */
        若 (use_udiv) {
            asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
            asm_emit("    无符号除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xF7); modrm(3, 6, 1); /* DIV r9d */
        } 否 {
            asm_emit("    扩展符号\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x99); /* CDQ (fix 2026-08-06 M1: 原 48 99=CQO 检查 RAX 位63，32位负值高32位为0 → RDX=0 → 变无符号除法! -7/2 误算 2147483644) */
            asm_emit("    整除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0xF7); modrm(3, 7, 1); /* IDIV r9d (REX.B=1 for rm=r9) */
        }
        若 (op == T_MD) mov_rr(0, 2); /* remainder �?eax */
        mov_rr(dst, 0); /* result �?dst for mov_rr(0,dst) in caller */
        返;
    }
    rex(0, src & 8, 0, dst & 8);
    若 (op == T_PK) { b(0x01); modrm(3, src & 7, dst & 7); }
    否 若 (op == T_MK) { b(0x29); modrm(3, src & 7, dst & 7); }
    否 若 (op == T_QK) { b(0x39); modrm(3, src & 7, dst & 7); }
}
/* ADD/SUB reg32, imm8/imm32 (fix 2026-08-03: imm8-only sign-extended offsets
   >127 to NEGATIVE (128 → 0x80 → -128) → e->field stores at offset≥128 wrote
   BEHIND the struct. imm32 form (81 /0 id) when the value doesn't fit imm8.) */
静 空 alu_ri(整 op, 整 reg, 整 imm) {
    asm_emit("    运即 r%d, %d\n", (字*)(长 长)(reg), (字*)(长 长)(imm), (字*)(长 长)0);
    rex(0, 0, 0, reg & 8);
    若 (op == T_PK) {
        若 (imm >= -128 && imm <= 127) { b(0x83); modrm(3, 0, reg & 7); b(imm); }
        否 { b(0x81); modrm(3, 0, reg & 7); b4(imm); }
    }
    否 若 (op == T_MK) {
        若 (imm >= -128 && imm <= 127) { b(0x83); modrm(3, 5, reg & 7); b(imm); }
        否 { b(0x81); modrm(3, 5, reg & 7); b4(imm); }
    }
}
/* TEST reg32, reg32 ??set ZF */
静 空 test_rr(整 r1, 整 r2) { asm_emit("    测试 r%d, r%d\n", (字*)(长 长)(r1), (字*)(长 长)(r2), (字*)(长 长)0); rex(0, r2 & 8, 0, r1 & 8); b(0x85); modrm(3, r2 & 7, r1 & 7); }
/* PUSH/POP reg64 ??always 64-bit in long mode, REX only needed for R8-R15 */
静 空 push_r(整 r) { asm_emit("    压栈 r%d\n", (字*)(长 长)(r), (字*)(长 长)0, (字*)(长 长)0); 若 (r & 8) b(0x41); b(0x50 | (r & 7)); }
静 空 pop_r(整 r) { asm_emit("    弹栈 r%d\n", (字*)(长 长)(r), (字*)(长 长)0, (字*)(长 长)0); 若 (r & 8) b(0x41); b(0x58 | (r & 7)); }
/* CALL rel32 */
静 空 call_rel(整 rel) { b(0xE8); b4(rel); }
/* RET */
静 空 ret(空) { asm_emit("    返回\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xC3); }
/* LEA reg64, [rsp+disp] */
__attribute__((unused))
静 空 lea_r_mrsp(整 reg, 整 disp) {
    asm_emit("    取址 r%d, [rsp%+d]\n", (字*)(长 长)(reg), (字*)(长 长)(disp), (字*)(长 长)0);
    rex(1, reg & 8, 0, 0); b(0x8D);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
/* RBP-relative variants: [rbp+disp] �?stable during nested calls / temporary sub rsp.
   Frame slot at [rsp+off] == [rbp + off - cur_frame_sz] (rbp = rsp + frame at entry). */
静 空 mov_mbrp_reg(整 disp, 整 reg) {
    asm_emit("    存帧32 [rbp%+d], r%d\n", (字*)(长 长)(disp), (字*)(长 长)(reg), (字*)(长 长)0);
    rex(0, reg & 8, 0, 0); b(0x89);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
静 空 mov_reg_mbrp(整 reg, 整 disp) {
    asm_emit("    取帧32 r%d, [rbp%+d]\n", (字*)(长 长)(reg), (字*)(长 长)(disp), (字*)(长 长)0);
    rex(0, reg & 8, 0, 0); b(0x8B);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
静 空 lea_r_mbrp(整 reg, 整 disp) {
    asm_emit("    取帧址 r%d, [rbp%+d]\n", (字*)(长 长)(reg), (字*)(长 长)(disp), (字*)(长 长)0);
    rex(1, reg & 8, 0, 0); b(0x8D);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
/* char arr[N] = "lit": store one string byte into [rbp+disp] (C6 /0 = MOV r/m8, imm8) */
静 空 mov_byte_mbrp_imm(整 disp, 整 imm) {
    asm_emit("    存字节 [rbp%+d], %d\n", (字*)(长 长)(disp), (字*)(长 长)(imm), (字*)(长 长)0);
    b(0xC6);
    若 (disp < 128 && disp >= -128) { modrm(1, 0, 5); b(disp); }
    否 { modrm(2, 0, 5); b4(disp); }
    b(imm & 0xFF);
}
/* 64-bit variants: preserve full pointer values in registers/slots */
静 空 mov_mbrp_reg64(整 disp, 整 reg) {
    asm_emit("    存帧64 [rbp%+d], r%d\n", (字*)(长 长)(disp), (字*)(长 长)(reg), (字*)(长 长)0);
    rex(1, reg & 8, 0, 0); b(0x89);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
静 空 mov_reg_mbrp64(整 reg, 整 disp) {
    asm_emit("    取帧64 r%d, [rbp%+d]\n", (字*)(长 长)(reg), (字*)(长 长)(disp), (字*)(长 长)0);
    rex(1, reg & 8, 0, 0); b(0x8B);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
/* ---- SSE double (xmm0) helpers ---- */
静 空 sub_rsp_imm(整 v);
静 空 add_rsp_imm(整 v);
静 空 movsd_xmm0_mbrp(整 disp) { asm_emit("    浮取帧 xmm0, [rbp%+d]\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); 若 (disp < 128 && disp >= -128) { modrm(1, 0, 5); b(disp); } 否 { modrm(2, 0, 5); b4(disp); } }
静 空 movsd_mbrp_xmm0(整 disp) { asm_emit("    浮存帧 [rbp%+d], xmm0\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x11); 若 (disp < 128 && disp >= -128) { modrm(1, 0, 5); b(disp); } 否 { modrm(2, 0, 5); b4(disp); } }
静 空 movsd_xmm1_xmm0(空) { asm_emit("    浮移 xmm1, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); b(0xC8); }
静 空 movsd_xmm0_xmm1(空) { asm_emit("    浮移 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); b(0xC1); }
静 空 movsd_xmm0_mr13(空) { asm_emit("    浮取参 xmm0, [r13]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x41); b(0x0F); b(0x10); b(0x45); b(0x00); } /* movsd xmm0, [r13] — REX MUST follow the F2 mandatory prefix (F2 41 0F 10), else the CPU ignores it and reads [rbp+0]! */
静 空 movsd_xmm1_mbrp(整 disp) { asm_emit("    浮取帧 xmm1, [rbp%+d]\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); 若 (disp < 128 && disp >= -128) { modrm(1, 1, 5); b(disp); } 否 { modrm(2, 1, 5); b4(disp); } }
静 空 cvtsi2sd_xmm1_eax(空) { asm_emit("    整转浮 xmm1, eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x2A); b(0xC8); }
/* double function params (Win64): arg i goes in xmm[i] (i<4) / [rsp+32+8i] (i>=4) */
静 空 movsd_xmmreg_mrsp64(整 reg, 整 disp) { /* movsd xmmN, [rsp+disp] */
    asm_emit("    浮取栈 xmm%d, [rsp%+d]\n", (字*)(长 长)(reg), (字*)(长 长)(disp), (字*)(长 长)0);
    b(0xF2); b(0x0F); b(0x10);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
静 空 movsd_mrsp64_xmmreg(整 disp, 整 reg) { /* movsd [rsp+disp], xmmN */
    asm_emit("    浮存栈 [rsp%+d], xmm%d\n", (字*)(长 长)(disp), (字*)(长 长)(reg), (字*)(长 长)0);
    b(0xF2); b(0x0F); b(0x11);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
静 空 movsd_mbrp_xmmreg(整 disp, 整 reg) { /* movsd [rbp+disp], xmmN */
    asm_emit("    浮存帧 [rbp%+d], xmm%d\n", (字*)(长 长)(disp), (字*)(长 长)(reg), (字*)(长 长)0);
    b(0xF2); b(0x0F); b(0x11);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); }
    否 { modrm(2, reg & 7, 5); b4(disp); }
}
静 整 preg_to_xmm(整 preg) { 若 (preg == 1) 返 0; 若 (preg == 2) 返 1; 若 (preg == 8) 返 2; 返 3; }
静 空 addsd_xmm0_xmm1(空) { asm_emit("    浮加 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x58); b(0xC1); }
静 空 subsd_xmm0_xmm1(空) { asm_emit("    浮减 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x5C); b(0xC1); }
静 空 mulsd_xmm0_xmm1(空) { asm_emit("    浮乘 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x59); b(0xC1); }
静 空 divsd_xmm0_xmm1(空) { asm_emit("    浮除 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x5E); b(0xC1); }
静 空 cvtsi2sd_xmm0_eax(空) { asm_emit("    整转浮 xmm0, eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x2A); b(0xC0); }
静 空 cvttsd2si_eax_xmm0(空) { asm_emit("    浮转整 eax, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x2C); b(0xC0); }
静 空 push_xmm0(空) { asm_emit("    压浮 xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x81); b(0xEC); b4(8); b(0xF2); b(0x0F); b(0x11); modrm(0, 0, 4); b(0x24); } /* sub rsp,8; movsd [rsp], xmm0 (bare sub: avoid double ASM) */
静 空 pop_xmm0(空) { asm_emit("    弹浮 xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); modrm(0, 0, 4); b(0x24); b(0x48); b(0x81); b(0xC4); b4(8); } /* movsd xmm0, [rsp]; add rsp,8 (bare add) */
静 空 comisd_xmm0_xmm1(空) { asm_emit("    浮比较 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x66); b(0x0F); b(0x2F); b(0xC1); } /* set flags: xmm0 vs xmm1 */
静 空 movsd_xmm0_rip(整 disp) { asm_emit("    浮取静 xmm0, [rip%+d]\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); b(0x05); b4(disp); } /* movsd xmm0, [rip+disp] */
静 空 movsd_rip_xmm0(整 disp) { asm_emit("    浮存静 [rip%+d], xmm0\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x11); b(0x05); b4(disp); } /* movsd [rip+disp], xmm0 */
静 空 mov_mrsp_reg64(整 disp, 整 reg) {
    asm_emit("    存栈64 [rsp%+d], r%d\n", (字*)(长 长)(disp), (字*)(长 长)(reg), (字*)(长 长)0);
    rex(1, reg & 8, 0, 0); b(0x89);
    若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); }
    否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); }
}
静 空 mov_reg_mrsp64(整 reg, 整 disp) {
