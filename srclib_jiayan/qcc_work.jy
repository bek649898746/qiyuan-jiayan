    遍 (整 i = 0; i < macro_n; i++) 若 (!strcmp(macros[i].name, n)) 返 1;
    遍 (整 i = 0; i < str_macro_n; i++) 若 (!strcmp(str_macros[i].name, n)) 返 1;
    遍 (整 i = 0; i < fn_macro_n; i++) 若 (!strcmp(fn_macros[i].name, n)) 返 1;
    返 0;
}
/* #undef: remove NAME from numeric/string/function macro tables (fix 2026-08-05) */
静 空 macro_remove(常 字 *n) {
    遍 (整 i = 0; i < macro_n; i++) 若 (!strcmp(macros[i].name, n)) { 遍 (整 j = i; j < macro_n - 1; j++) macros[j] = macros[j + 1]; macro_n--; 返; }
    遍 (整 i = 0; i < str_macro_n; i++) 若 (!strcmp(str_macros[i].name, n)) { 遍 (整 j = i; j < str_macro_n - 1; j++) str_macros[j] = str_macros[j + 1]; str_macro_n--; 返; }
    遍 (整 i = 0; i < fn_macro_n; i++) 若 (!strcmp(fn_macros[i].name, n)) { 遍 (整 j = i; j < fn_macro_n - 1; j++) { fn_macros[j] = fn_macros[j + 1]; fn_macro_multiline[j] = fn_macro_multiline[j + 1]; } fn_macro_n--; 返; }
}

/* 对象宏收集 (lex 前): #define A <表达式/标识符> — 非函数宏非字符串宏非纯数字 (fix 2026-08-13) */
静 空 obj_macro_collect(常 字 *s) {
    obj_macro_n = 0;
    cl_if_n = 0; cl_if_skip = 0; /* fix 2026-08-13 Phase3: 条件编译感知 — 假分支里的 #define 不收 (否则 #else 里的 TAG "C" 覆盖 #if 里的 "A") */
    pp_guard_n = 0; /* fix 2026-08-13 Phase3: 自建顺序定义表 — 复用 fn_macro_collect 的全表会误判文件后部的 #define 已定义 (RE_TRANSLATE_TYPE 在 #ifndef 处被误判) */
    遍 (整 i = 0; s[i]; i++) {
        若 (s[i] == '/' && s[i + 1] == '*') { i += 2; 循环 (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++; i++; 续; }
        若 (s[i] == '/' && s[i + 1] == '/') { 循环 (s[i] && s[i] != '\n') i++; 续; }
        若 (s[i] == '"') { i++; 循环 (s[i] && s[i] != '"') { 若 (s[i] == '\\') i++; i++; } 续; }
        若 (s[i] == '\'') { i++; 循环 (s[i] && s[i] != '\'') { 若 (s[i] == '\\') i++; i++; } 续; }
        若 (s[i] == '#') {
            整 dj = i + 1; 循环 (s[dj] == ' ' || s[dj] == '\t') dj++; /* fix 2026-08-13 Phase3: 跳过 # 后空白 — glibc 缩进指令 #  define */
            整 is_ifdef = !strncmp(s + dj, "ifdef", 5) && (s[dj + 5] == 0 || s[dj + 5] == ' ' || s[dj + 5] == '\t' || s[dj + 5] == '\r' || s[dj + 5] == '\n');
            整 is_ifndef = !strncmp(s + dj, "ifndef", 6) && (s[dj + 6] == 0 || s[dj + 6] == ' ' || s[dj + 6] == '\t' || s[dj + 6] == '\r' || s[dj + 6] == '\n');
            整 is_if = !strncmp(s + dj, "if", 2) && !is_ifdef && !is_ifndef && (s[dj + 2] == 0 || s[dj + 2] == ' ' || s[dj + 2] == '\t' || s[dj + 2] == '\r' || s[dj + 2] == '\n');
            整 is_elif = !strncmp(s + dj, "elif", 4) && (s[dj + 4] == 0 || s[dj + 4] == ' ' || s[dj + 4] == '\t' || s[dj + 4] == '\r' || s[dj + 4] == '\n');
            整 is_else = !strncmp(s + dj, "else", 4) && (s[dj + 4] == 0 || s[dj + 4] == ' ' || s[dj + 4] == '\t' || s[dj + 4] == '\r' || s[dj + 4] == '\n');
            整 is_endif = !strncmp(s + dj, "endif", 5) && (s[dj + 5] == 0 || s[dj + 5] == ' ' || s[dj + 5] == '\t' || s[dj + 5] == '\r' || s[dj + 5] == '\n');
            整 is_def = !strncmp(s + dj, "define", 6) && (s[dj + 6] == 0 || s[dj + 6] == ' ' || s[dj + 6] == '\t' || s[dj + 6] == '\r' || s[dj + 6] == '\n');
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = cl_if_skip; 整 cond = 0;
                若 (is_ifdef || is_ifndef) {
                    字 nm[64]; 整 ni = 0; 整 q = dj + (is_ifdef ? 5 : 6);
                    循环 (s[q] == ' ' || s[q] == '\t') q++;
                    循环 (isalnum((无 字)s[q]) || s[q] == '_' || ((无 字)s[q] >= 0x80)) { 若 (ni < 63) nm[ni++] = s[q]; q++; }
                    nm[ni] = 0;
                    cond = is_ifdef ? pp_guard_exists(nm) : !pp_guard_exists(nm);
                } 否 若 (is_if || is_elif) {
                    字 expr[512]; 整 ei = 0; 整 q = dj + (is_if ? 2 : 4);
                    循环 (s[q] == ' ' || s[q] == '\t') q++;
                    循环 (s[q] && s[q] != '\n' && ei < 510) expr[ei++] = s[q++];
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--;
                    expr[ei] = 0;
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (cl_if_n < 1024) { cl_if_parent[cl_if_n] = parent; cl_if_taken[cl_if_n] = cond && !parent; cl_if_skip = parent || !cond; cl_if_n++; }
                } 否 若 (is_elif) {
                    若 (cl_if_n > 0) { 若 (!cl_if_taken[cl_if_n-1] && !cl_if_parent[cl_if_n-1]) { cl_if_taken[cl_if_n-1] = cond; cl_if_skip = cl_if_parent[cl_if_n-1] || !cond; } 否 cl_if_skip = 1; }
                } 否 若 (is_else) {
                    若 (cl_if_n > 0) { 若 (!cl_if_taken[cl_if_n-1] && !cl_if_parent[cl_if_n-1]) { cl_if_taken[cl_if_n-1] = 1; cl_if_skip = cl_if_parent[cl_if_n-1]; } 否 cl_if_skip = 1; }
                } 否 若 (is_endif) {
                    若 (cl_if_n > 0) { cl_if_n--; cl_if_skip = cl_if_n > 0 ? !cl_if_taken[cl_if_n-1] : 0; } /* fix 2026-08-13 Phase3: 同 lexer endif — 嵌套假分支恢复用 !taken */
                }
                循环 (s[i] && s[i] != '\n') i++;
                续;
            }
            若 (cl_if_skip) { /* 假分支: #define 不收 */
                循环 (s[i] && s[i] != '\n') i++;
                续;
            }
            若 (is_def) {
                { 字 gnm[64]; 整 gv = 0; pp_def_parse(s + i, gnm, &gv); 若 (gnm[0]) pp_guard_add(gnm, gv); } /* 顺序定义表: #ifdef 判断用 */
                整 p = dj + 6;
                循环 (s[p] == ' ' || s[p] == '\t') p++;
                字 nm[64]; 整 ni = 0;
                循环 (isalnum((无 字)s[p]) || s[p] == '_' || ((无 字)s[p] >= 0x80)) { 若 (ni < 63) nm[ni++] = s[p]; p++; }
                nm[ni] = 0;
                若 (nm[0] && s[p] != '(') { /* 非函数宏 → 对象宏候选; fix 2026-08-13 Phase3: ( 必须紧贴名字才算函数宏 */
                    循环 (s[p] == ' ' || s[p] == '\t') p++;
                    若 (s[p] != '"') { /* fix 2026-08-13 Phase3: 字符串宏不收 (值以 " 开头) — 否则 TAG "A"/"C" 被当对象宏展开覆盖 lexer 的字符串宏 */
                        字 av[4096]; 整 ai = 0;
                        循环 (s[p] && s[p] != '\n' && ai < 4090) { 若 (s[p] == '\\' && s[p + 1] == '\n') { p += 2; av[ai++] = ' '; 续; } av[ai++] = s[p]; p++; }
                        循环 (ai > 0 && (av[ai - 1] == ' ' || av[ai - 1] == '\t' || av[ai - 1] == '\r')) ai--;
                        av[ai] = 0;
                        若 (!(av[0] >= '0' && av[0] <= '9') && !(av[0] == '-' && av[1] >= '0' && av[1] <= '9') && !(av[0] == '0' && (av[1] == 'x' || av[1] == 'X'))) obj_add(nm, av); /* 允许空宏 #define X (ai==0) 展开为空 */
                    }
                }
                循环 (s[p] && s[p] != '\n') p++;
                i = p;
            }
        }
    }
}

静 空 fn_macro_collect(常 字 *s) {
    fn_macro_n = 0;
    cl_if_n = 0; cl_if_skip = 0; /* 条件编译栈重置 (fix 2026-08-07) */
    pp_guard_n = 0; /* fix 2026-08-07: 顺序定义表重置 — collect 自己按源码顺序重建 (头文件 #ifndef 守卫在首遇时视为未定义) */
    遍 (整 i = 0; s[i]; i++) {
        若 (s[i] == '/' && s[i + 1] == '*') { i += 2; 循环 (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++; i++; 续; }
        若 (s[i] == '/' && s[i + 1] == '/') { 循环 (s[i] && s[i] != '\n') i++; 续; }
        若 (s[i] == '"') { i++; 循环 (s[i] && s[i] != '"') { 若 (s[i] == '\\') i++; i++; } 续; }
        若 (s[i] == '\'') { i++; 循环 (s[i] && s[i] != '\'') { 若 (s[i] == '\\') i++; i++; } 续; }
        若 (s[i] == '#') { /* fix 2026-08-07: 条件编译感知 — 假分支里的 #define 不收 (否则 #if 0 里的宏被误收集展开) */
            整 d = i + 1; 循环 (s[d] == ' ' || s[d] == '\t') d++; /* fix 2026-08-13 Phase3: # 后空白 (glibc 缩进指令 #  define) */
            整 is_ifdef = !strncmp(s + d, "ifdef", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            整 is_ifndef = !strncmp(s + d, "ifndef", 6) && (s[d + 6] == 0 || s[d + 6] == ' ' || s[d + 6] == '\t' || s[d + 6] == '\r' || s[d + 6] == '\n');
            整 is_if = !strncmp(s + d, "if", 2) && !is_ifdef && !is_ifndef && (s[d + 2] == 0 || s[d + 2] == ' ' || s[d + 2] == '\t' || s[d + 2] == '\r' || s[d + 2] == '\n');
            整 is_elif = !strncmp(s + d, "elif", 4) && (s[d + 4] == 0 || s[d + 4] == ' ' || s[d + 4] == '\t' || s[d + 4] == '\r' || s[d + 4] == '\n');
            整 is_else = !strncmp(s + d, "else", 4) && (s[d + 4] == 0 || s[d + 4] == ' ' || s[d + 4] == '\t' || s[d + 4] == '\r' || s[d + 4] == '\n');
            整 is_endif = !strncmp(s + d, "endif", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            整 is_def = !strncmp(s + d, "define", 6) && (s[d + 6] == 0 || s[d + 6] == ' ' || s[d + 6] == '\t' || s[d + 6] == '\r' || s[d + 6] == '\n');
            整 is_undef = !strncmp(s + d, "undef", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = cl_if_skip; 整 cond = 0;
                若 (is_ifdef || is_ifndef) {
                    字 nm[64]; 整 ni = 0; 整 q = d + (is_ifdef ? 5 : 6);
                    循环 (s[q] == ' ' || s[q] == '\t') q++;
                    循环 (isalnum((无 字)s[q]) || s[q] == '_' || ((无 字)s[q] >= 0x80)) { 若 (ni < 63) nm[ni++] = s[q]; q++; }
                    nm[ni] = 0;
                    整 def = pp_guard_exists(nm);
                    cond = is_ifdef ? def : !def;
                } 否 若 (is_if || is_elif) {
                    字 expr[512]; 整 ei = 0; 整 q = d + (is_if ? 2 : 4);
                    循环 (s[q] == ' ' || s[q] == '\t') q++;
                    循环 (s[q] && s[q] != '\n' && ei < 510) expr[ei++] = s[q++];
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--;
                    expr[ei] = 0;
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (cl_if_n < 1024) { cl_if_parent[cl_if_n] = parent; cl_if_taken[cl_if_n] = cond && !parent; cl_if_skip = parent || !cond; cl_if_n++; }
                } 否 若 (is_elif) {
                    若 (cl_if_n > 0) { 若 (!cl_if_taken[cl_if_n-1] && !cl_if_parent[cl_if_n-1]) { cl_if_taken[cl_if_n-1] = cond; cl_if_skip = cl_if_parent[cl_if_n-1] || !cond; } 否 cl_if_skip = 1; }
                } 否 若 (is_else) {
                    若 (cl_if_n > 0) { 若 (!cl_if_taken[cl_if_n-1] && !cl_if_parent[cl_if_n-1]) { cl_if_taken[cl_if_n-1] = 1; cl_if_skip = cl_if_parent[cl_if_n-1]; } 否 cl_if_skip = 1; }
                } 否 若 (is_endif) {
                    若 (cl_if_n > 0) { cl_if_n--; cl_if_skip = cl_if_n > 0 ? !cl_if_taken[cl_if_n-1] : 0; } /* fix 2026-08-13 Phase3: 同 lexer endif — 嵌套假分支恢复用 !taken 而非 parent */
                }
                循环 (s[i] && s[i] != '\n') i++;
                续;
            }
            若 (cl_if_skip) { /* 假分支: #define/#undef 一律不收 */
                循环 (s[i] && s[i] != '\n') i++;
                续;
            }
            若 (is_undef) { /* fix 2026-08-07: 顺序定义表删除 (collect 阶段 #undef 生效) */
                整 q = d + 5;
                循环 (s[q] == ' ' || s[q] == '\t') q++;
                字 un[64]; 整 ui = 0;
                循环 (isalnum((无 字)s[q]) || s[q] == '_') { 若 (ui < 63) un[ui++] = s[q]; q++; }
                un[ui] = 0;
                若 (ui > 0) { pp_guard_del(un); 整 fmi2 = -1; 遍 (整 k = 0; k < fn_macro_n; k++) 若 (!strcmp(fn_macros[k].name, un)) { fmi2 = k; 断; } 若 (fmi2 >= 0 && fn_macro_multiline[fmi2] && fn_macros[fmi2].body[0] == '{') macro_remove(un); } /* fix 2026-08-15: 多行 do 语句宏保留 (color.c OUT 定义后使用再 #undef); 多行 { 初始化宏仍删 (userdiff.c PATTERNS/IPATTERN timeout) */
                循环 (s[i] && s[i] != '\n') i++;
                续;
            }
            若 (is_def) {
            { 字 dnm[64]; 整 dv = 0; pp_def_parse(s + i, dnm, &dv); 若 (dnm[0]) pp_guard_add(dnm, dv); } /* fix 2026-08-07: 任何 #define 都记入顺序表 (含数值, #if MODE==2 用真值) */
            整 p = d + 6;
            循环 (s[p] == ' ' || s[p] == '\t') p++;
            字 nm[64]; 整 ni = 0;
            循环 (isalnum((无 字)s[p]) || s[p] == '_') { 若 (ni < 63) nm[ni++] = s[p]; p++; }
            nm[ni] = 0;
            若 (s[p] == '(' && fn_macro_n < 2048 && strcmp(nm, "_va_alloc")) { /* fix 2026-08-13: 函数宏需 ( 紧贴名字无空格 — #define A (x) 是表达式宏 (Git hash-ll.h GIT_HASH_NALGOS/HEXSZ) */
                strcpy(fn_macros[fn_macro_n].name, nm);
                fn_macro_multiline[fn_macro_n] = 0;
                p++;
                整 pi = 0;
                循环 (s[p] && s[p] != ')' && pi < 16) { /* fix 2026-08-07: pi<16 防垃圾输入死循环 (原无界 → `...` 死转) */
                    循环 (s[p] == ' ' || s[p] == '\t' || s[p] == ',') p++;
                    循环 ((s[p] == '\\' && s[p + 1] == '\n') || (s[p] == '\\' && s[p + 1] == '\r' && s[p + 2] == '\n')) { /* fix 2026-08-15: 参数列表续行 \ (mergesort.h DEFINE_LIST_SORT_DEBUG 参数跨两行 — 原把 on_get_next,on_set_next 当 body 泄漏) */
                        p += (s[p + 1] == '\r' ? 3 : 2);
                        循环 (s[p] == ' ' || s[p] == '\t') p++;
                    }
                    若 (s[p] == ')') 断;
                    若 (s[p] == '.' && s[p + 1] == '.' && s[p + 2] == '.') { /* 变参 ... → __VA_ARGS__ 参数 (fix 2026-08-07: #define F(x, ...) 支持) */
                        strcpy(fn_macros[fn_macro_n].params[pi], "__VA_ARGS__");
                        pi++; p += 3;
                        循环 (s[p] == ' ' || s[p] == '\t') p++;
                        断;
                    }
                    整 qi = 0;
                    循环 (isalnum((无 字)s[p]) || s[p] == '_') { 若 (qi < 63) fn_macros[fn_macro_n].params[pi][qi++] = s[p]; p++; }
                    fn_macros[fn_macro_n].params[pi][qi] = 0;
                    pi++;
                }
                fn_macros[fn_macro_n].pn = pi;
                若 (s[p] == ')') p++;
                循环 (s[p] == ' ' || s[p] == '\t') p++;
                整 bi = 0;
                循环 (s[p] && s[p] != '\n' && bi < 16383) {
                    若 (s[p] == '\\' && (s[p + 1] == '\n' || (s[p + 1] == '\r' && s[p + 2] == '\n'))) { /* 多行 body: \ 续行 → 空格 (fix 2026-08-05) */
                        fn_macro_multiline[fn_macro_n] = 1;
                        若 (bi < 16383) fn_macros[fn_macro_n].body[bi++] = ' ';
                        p++;
                        若 (s[p] == '\r') p++;
                        若 (s[p] == '\n') p++;
                        续;
                    }
                    fn_macros[fn_macro_n].body[bi++] = s[p++];
                }
                fn_macros[fn_macro_n].body[bi] = 0;
                fn_macro_n++;
            }
        }
    }
    }
}

静 整 fn_exp_stack[64]; 静 整 fn_exp_n; /* fix 2026-08-13: 展开栈 — 防宏互递归 A→B→A (self_fmi 只防直接自递归: 展开 A 时 body 调 B → B 展开时 A 又可入 → 无限; Git hashmap_for_each_entry 嵌套链 + revision.c) */

/* expand fn-macro calls inside seg (recursive for nested macros) into *out at *o (grows).
   fix 2026-08-07: #x 字符串化 / ## 拼接 / __VA_ARGS__ 变参 / 自引用防递归 / 字符串字面量内不展开 / 参数扫描不拆串内逗号 */
静 空 fn_macro_expand_to(常 字 *seg, 字 **outp, 整 *o, 整 *cap, 整 self_fmi) {
    字 *out = *outp;
    整 in_str = 0; /* 顶层串内逐字复制 (fix 2026-08-07: 字符串字面量里的 NAME( 不展开) */
    遍 (整 i = 0; seg[i]; ) {
        若 (seg[i] == '#') { 整 q2 = i + 1; 循环 (seg[q2] == ' ' || seg[q2] == '\t') q2++; 若 (seg[q2] == 'd' || seg[q2] == 'u' || seg[q2] == 'i' || seg[q2] == 'e' || seg[q2] == 'l' || seg[q2] == 'p' || seg[q2] == 'n') { /* fix 2026-08-13: 预处理行不展开 (#define 行内宏名会被当调用展开); fix 2026-08-13 Phase3: # 后空白 (缩进 #  define __REPB_PREFIX(name) 原被展开成 #define name name) */
            循环 (seg[i] && seg[i] != '\n') { 若 (*o + 1 > *cap) { *cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; } out[(*o)++] = seg[i++]; }
            续;
        } }
        若 (seg[i] == '"' && !in_str) in_str = 1;
        否 若 (seg[i] == '"' && in_str && !quote_escaped(seg, i)) in_str = 0; /* fix 2026-08-14: \\" 两反斜杠后 " 应结束 */
        若 (seg[i] == '\'' && !in_str) { /* 字符字面量 'x'/'\n'/'"' — 跳过 (fix 2026-08-14: attr.c *cp == '"' 的字符字面量被当字符串开始 → in_str 奇偶翻转 → GIT_PATH_FUNC 不展开 → 参数 STR 卡死) */
            若 (*o + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
            out[(*o)++] = seg[i++]; /* opening ' */
            循环 (seg[i] && (seg[i] != '\'' || quote_escaped(seg, i))) {
                若 (*o + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
                out[(*o)++] = seg[i++];
            }
            若 (seg[i]) { 若 (*o + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; } out[(*o)++] = seg[i++]; }
            续;
        }
        若 (!in_str && seg[i] == '/' && seg[i + 1] == '*') { /* fix 2026-08-14: 缺块注释处理, 注释里的 " 触发字符串分支吞掉后续 → KHASH_INIT 未展开 */
            循环 (seg[i] && !(seg[i] == '*' && seg[i + 1] == '/')) { 若 (*o + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); out = *outp; } out[(*o)++] = seg[i++]; }
            若 (seg[i]) { 若 (*o + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); out = *outp; } out[(*o)++] = seg[i++]; 若 (seg[i]) { 若 (*o + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); out = *outp; } out[(*o)++] = seg[i++]; } }
            续;
        }
        若 (!in_str && seg[i] == '/' && seg[i + 1] == '/') { 循环 (seg[i] && seg[i] != '\n') { 若 (*o + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); out = *outp; } out[(*o)++] = seg[i++]; } 续; }
        若 (in_str) {
            若 (seg[i] == '\n' && !quote_escaped(seg, i)) in_str = 0; /* fix 2026-08-15: in_str 失步恢复 — 真实 C 字符串不能含裸换行, 裸换行处复位防 strbuf_reset 被误当串内不展开 */
            若 (*o + 1 > *cap) { *cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
            out[(*o)++] = seg[i++];
            续;
        }
        若 (isalnum((无 字)seg[i]) || seg[i] == '_') {
            字 nm[64]; 整 ni = 0;
            循环 (isalnum((无 字)seg[i]) || seg[i] == '_') { 若 (ni < 63) nm[ni++] = seg[i]; i++; }
            nm[ni] = 0;
            整 name_start = i - ni; /* 宏名起始下标 — 必须在此处保存, 后面跳过空白到 ( 后 i 已移动 (fix 2026-08-15: obstack_free 原型带空格被误展开) */
            整 fmi = -1;
            遍 (整 k = 0; k < fn_macro_n; k++) 若 (k != self_fmi && !strcmp(fn_macros[k].name, nm)) { fmi = k; 断; } /* 自引用宏不重入 (fix 2026-08-07: #define A(x) A(x) 防死递归) */
            若 (fmi >= 0) { 整 pw = i; 循环 (seg[pw] == ' ' || seg[pw] == '\t' || seg[pw] == '\r' || seg[pw] == '\n') pw++; 若 (seg[pw] == '(') i = pw; } /* fix 2026-08-13 Phase3: 函数宏调用允许名称与 ( 之间空白 — 仅真调用才跳过空白, 否则保留 (同名变量/函数指针不吞空白) */
