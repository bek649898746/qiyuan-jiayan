               实验: 跳过 final 产物能自举, 自举不动点收敛到同一值. */
        }
        asm_pass = 0;
    }

    /* ??PE / COFF 对象 */
    /* fix 2026-08-10 Gate 9: �������������ڴ� (���ļ�ϵͳ) */
    整 bin_out_len = 0;
    无 字 *ob = (无 字*)BIN_OUT_ADDR;
    整 oi = 0;
    若 (bare_metal) {
        若 (bin_hdr_n > 0) {
            memcpy(ob, bin_hdr, bin_hdr_n); oi = bin_hdr_n;
        } 否 {
            整 code_off = 0x1000;
