    若 (user_fn_active && n[0] != '_' && uninit_cnt < 256) { strcpy(uninit_names[uninit_cnt], n); uninit_scope[uninit_cnt] = uninit_depth; uninit_cnt++; } /* 接入 2026-08-28 机制层 #78 明确初始化: 用户代码(main 后)局部变量声明登记 (跳过 _ 前缀编译器内部变量/qcc_rt 运行时); 读取未初始化 → L5014 [ERR] */
