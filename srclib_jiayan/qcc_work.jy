/* 接入 2026-08-28 AI原生编译器 #6 可重入无状态核心 (大哥定 地基打桩第二桩): 编译核心函数化 — 每次调用独立分配 token/AST 数组 + 独立编译, 同进程可多次调用 (编译服务器/增量/并行前置) */
字 *qcc_prepend_rt(常 字 *src) { /* 可嵌入: rt 拼接封装 (fix 2026-08-28 大哥验收: reset 清宏 + 时序 → rt 守卫失效 → rt 实现剃光 → 嵌入产物缺代码段崩) — main 与 qcc_embed_driver 共用; 多路径搜索: 相对 cwd + 可执行文件目录 (Windows GetModuleFileName) */
    字 *rtb = read_file("srclib/qcc_rt.c");
    若 (!rtb) rtb = read_file("qcc_rt.c");
    若 (!rtb) { 字 mp[1024]; DWORD mn = GetModuleFileNameA(NULL, mp, 1023); 若 (mn > 0) { 字 *sl = strrchr(mp, '/'); 字 *bs = strrchr(mp, '\\'); 字 *last = sl && bs ? (sl > bs ? sl : bs) : (sl ? sl : bs); 若 (last) { *last = 0; 字 sp2[1024]; strcpy(sp2, mp); strcat(sp2, "/srclib/qcc_rt.c"); rtb = read_file(sp2); 若 (!rtb) { strcpy(sp2, mp); strcat(sp2, "/qcc_rt.c"); rtb = read_file(sp2); } } } }
    若 (!rtb) 返 NULL;
    整 rl = (整)strlen(rtb);
    g_rt_len = rl; /* 2026-08-28 loc.line: rt 长度 (parse 前算 rt_exp_lines) */
    整 al = (整)strlen(src);
    macro_add("QCC_RT_PREPENDED", 1); /* 标记 rt 已预置 — qcc_rt.c 守卫认此宏 */
    rt_line_skip = 1; 遍 (整 rk = 0; rk < rl; rk++) 若 (rtb[rk] == '\n') rt_line_skip++; /* 行号校正 */
    字 *combined2 = malloc((rl + al + 5 + 16) & ~3);
    memcpy(combined2, rtb, rl);
    combined2[rl] = '\n';
    memcpy(combined2 + rl + 1, src, al);
    combined2[rl + 1 + al] = 0;
    free(rtb);
