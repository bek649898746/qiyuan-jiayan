                循环 (isalnum(s[i]) || s[i] == '_' || ((无 字)s[i] >= 0x80)) { 若 (mi2 < 63) mname[mi2++] = s[i]; i++; }
                mname[mi2] = 0;
                循环 (s[i] == ' ' || s[i] == '\t') i++;
                若 (s[i] == '(') { /* function-like macro �?skip definition */
                    循环 (s[i] && s[i] != '\n') { 若 (s[i] == '\\' && s[i + 1] == '\n') i += 2; 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') i += 3; 否 i++; }
                    续;
                }
                长 长 mval = 0; /* fix 2026-08-09 审计 BUG-3: int 累加 3000000000 溢出 UB → long long */
