                                    tk++;
                                    整 idn2 = Nd(1); memcpy((字*)(nn + idn2), vn2, 32);
                                    整 bi2 = brace_fields(si, idn2);
                                    整 bt2 = Nd(5); Nc(bt2, bi2);
                                    Nc(b, bt2); b_cnt++;
