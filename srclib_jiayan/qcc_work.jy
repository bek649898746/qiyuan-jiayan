            { 整 v_c2 = Nd(1); memcpy((字*)(nn + v_c2), cname, 32);
              整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_c2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
              整 asg = Nd(10); Nc(asg, v_c2); Nc(asg, pl); Nc(wbd, asg); } /* __rc++; */
            { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(wbd, setl); nv[wh] = cl + 1; }
            Nc(wh, wbd);
            Nc(ibd, wh); }
          /* 反转3 [0, n) */
          { 整 d = Nd(7); memcpy((字*)(nn + d), dname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(ibd, d); }
          { 整 wh = Nd(9);
            { 整 v_d2 = Nd(1); memcpy((字*)(nn + v_d2), dname, 32);
              整 half = Nd(2); nv[half] = DV; { 整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32); Nc(half, v_n); } { 整 two = Nd(0); nv[two] = 2; Nc(half, two); } /* n/2 */
              整 cmp2 = Nd(2); nv[cmp2] = T_LK; Nc(cmp2, v_d2); Nc(cmp2, half);
              Nc(wh, cmp2); } /* while (__rd < n/2) */
            整 wbd = Nd(5);
