        { 整 d = Nd(7); memcpy((字*)(nn + d), rname, 32); 整 z = Nd(0); nv[z] = 0; Nc(d, z); Nc(blk, d); }
        返 blk;
    }
    若 (tt[tk] == VR && (!strcmp(tn[tk], "读锁") || !strcmp(tn[tk], "写锁") || !strcmp(tn[tk], "放锁"))) { /* 接入 2026-08-28 P1 #51: 读写锁操作 — 读锁 rw → __qcc_rwlock_rd; 写锁 rw → __qcc_rwlock_wr; 放锁 rw → __qcc_rwlock_un */
        整 is_wr = !strcmp(tn[tk], "写锁");
        整 is_un = !strcmp(tn[tk], "放锁");
        tk++;
        字 rn[64]; strcpy(rn, tn[tk]); tk++;
        若 (tt[tk] == SK) tk++;
        字 rname[80]; sprintf(rname, "__rwl_%s", rn);
        整 call = Nd(4);
        { 整 v2 = Nd(1); memcpy((字*)(nn + v2), rname, 32); 整 addr = Nd(11); Nc(addr, v2); Nc(call, addr); }
        若 (is_un) { 整 fn = Nd(1); memcpy((字*)(nn + fn), "__qcc_rwlock_un", 16); Nc(call, fn); }
        否 若 (is_wr) { 整 fn = Nd(1); memcpy((字*)(nn + fn), "__qcc_rwlock_wr", 16); Nc(call, fn); }
        否 { 整 fn = Nd(1); memcpy((字*)(nn + fn), "__qcc_rwlock_rd", 16); Nc(call, fn); }
