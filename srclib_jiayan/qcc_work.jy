    若 (bound_disp) { lea_r_mbrp(9, bound_disp); } /* lea r9, [rbp+bound_disp] — fix 2026-08-23 t35d: 移到 lcp 前, 显式精度路径(%.Ns)原跳过 lsnoprec → r9 残留垃圾 → cmp r12,r9 误跳 → 空输出 (attr.c %.*s name 缺失) */
