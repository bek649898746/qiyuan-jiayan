            整 is_if = !strncmp(s + q2, "if", 2) && !is_ifdef && !is_ifndef && (s[q2+2] == 0 || s[q2+2] == ' ' || s[q2+2] == '\t' || s[q2+2] == '\r' || s[q2+2] == '\n');
            整 is_elif = !strncmp(s + q2, "elif", 4) && (s[q2+4] == 0 || s[q2+4] == ' ' || s[q2+4] == '\t' || s[q2+4] == '\r' || s[q2+4] == '\n');
            整 is_else = !strncmp(s + q2, "else", 4) && (s[q2+4] == 0 || s[q2+4] == ' ' || s[q2+4] == '\t' || s[q2+4] == '\r' || s[q2+4] == '\n');
            整 is_endif = !strncmp(s + q2, "endif", 5) && (s[q2+5] == 0 || s[q2+5] == ' ' || s[q2+5] == '\t' || s[q2+5] == '\r' || s[q2+5] == '\n');
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = cx_skip; 整 cond = 0;
                若 (is_ifdef || is_ifndef) {
                    字 nm[64]; 整 ni = 0; 整 q3 = q2 + (is_ifdef ? 5 : 6);
                    循环 (s[q3] == ' ' || s[q3] == '\t') q3++;
                    循环 (isalnum((无 字)s[q3]) || s[q3] == '_' || ((无 字)s[q3] >= 0x80)) { 若 (ni < 63) nm[ni++] = s[q3]; q3++; }
                    nm[ni] = 0;
                    整 def = pp_guard_exists(nm) || macro_exists(nm) || obj_find(nm) != 0; /* 顺序表 + 数值/字符串/函数表 + 当前对象宏表 */
                    cond = is_ifdef ? def : !def;
                     
                } 否 若 (is_if || is_elif) {
                    字 expr[512]; 整 ei = 0; 整 q3 = q2 + (is_if ? 2 : 4);
                    循环 (s[q3] == ' ' || s[q3] == '\t') q3++;
                    循环 (s[q3] && ei < 510) { 若 (s[q3] == '\\' && s[q3+1] == '\n') { q3 += 2; expr[ei++] = ' '; 续; } 若 (s[q3] == '\n') 断; expr[ei++] = s[q3++]; } /* fix 2026-08-25 sqlite: #if 表达式反斜杠续行 (#if defined(A) \\\n + defined(B)>1) — 原只读到首个 \n → 尾反斜杠进 expr → pp_eval 误判 → 条件栈错 */
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--;
                    expr[ei] = 0;
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (cx_n < 64) { cx_parent[cx_n] = parent; cx_taken[cx_n] = cond && !parent; cx_skip = parent || !cond; cx_n++; }
                } 否 若 (is_elif) {
                    若 (cx_n > 0) { 若 (!cx_taken[cx_n-1] && !cx_parent[cx_n-1]) { cx_taken[cx_n-1] = cond; cx_skip = cx_parent[cx_n-1] || !cond; } 否 cx_skip = 1; }
                } 否 若 (is_else) {
                    若 (cx_n > 0) { 若 (!cx_taken[cx_n-1] && !cx_parent[cx_n-1]) { cx_taken[cx_n-1] = 1; cx_skip = cx_parent[cx_n-1]; } 否 cx_skip = 1; }
                } 否 若 (is_endif) {
                    若 (cx_n > 0) { cx_n--; cx_skip = cx_n > 0 ? !cx_taken[cx_n-1] : 0; }
                }
            }
            若 (!cx_skip) { /* 真分支才处理 #define/#undef */
                若 (s[q2] == 'u' && s[q2+1] == 'n' && s[q2+2] == 'd' && s[q2+3] == 'e' && s[q2+4] == 'f' && (s[q2+5] == 0 || s[q2+5] == ' ' || s[q2+5] == '\t')) { /* fix 2026-08-21: #undef 位置语义 — 展开到此处才删对象宏 (git-compat-util.h `#define rmdir lstat_cache_aware_rmdir` + symlinks.c `#undef rmdir` → 函数体 rmdir() 不再展开为自身 → commit 无限递归根治) */
                    整 q3 = q2 + 5;
                    循环 (s[q3] == ' ' || s[q3] == '\t') q3++;
                    字 un[64]; 整 ui = 0;
                    循环 (isalnum((无 字)s[q3]) || s[q3] == '_' || ((无 字)s[q3] >= 0x80)) { 若 (ui < 63) un[ui++] = s[q3]; q3++; }
                    un[ui] = 0;
                    若 (ui > 0) obj_del(un);
                } 否 若 (s[q2] == 'd' && s[q2+1] == 'e' && s[q2+2] == 'f' && s[q2+3] == 'i' && s[q2+4] == 'n' && s[q2+5] == 'e' && (s[q2+6] == 0 || s[q2+6] == ' ' || s[q2+6] == '\t')) { /* fix 2026-08-21: expand 阶段 #define 重新收集 — 配合 collect 阶段 #undef 删除, 完整位置语义 (git-compat-util.h `#undef time` + `#define time git_time` 模式, 否则 #undef 后宏永久丢失 → date.c 全文 time 未展开 → parse 爆炸) */
                    整 q3 = q2 + 6;
                    循环 (s[q3] == ' ' || s[q3] == '\t') q3++;
                    字 nm[64]; 整 ni = 0;
                    循环 (isalnum((无 字)s[q3]) || s[q3] == '_' || ((无 字)s[q3] >= 0x80)) { 若 (ni < 63) nm[ni++] = s[q3]; q3++; }
                    nm[ni] = 0;
                    若 (ni > 0 && s[q3] != '(') { /* 非函数宏 (与 collect 同过滤) */
                        循环 (s[q3] == ' ' || s[q3] == '\t') q3++;
                        若 (s[q3] != '"') { /* 非字符串宏 */
                            字 av[4096]; 整 ai = 0;
                            循环 (s[q3] && s[q3] != '\n' && ai < 4090) { 若 (s[q3] == '\\' && s[q3+1] == '\n') { q3 += 2; av[ai++] = ' '; 续; } av[ai++] = s[q3]; q3++; }
                            循环 (ai > 0 && (av[ai-1] == ' ' || av[ai-1] == '\t' || av[ai-1] == '\r')) ai--;
                            av[ai] = 0;
                            { 字 _av2[4096]; 整 _a2 = 0; 遍 (整 _c = 0; _c < ai; ) { 若 (av[_c] == '/' && av[_c + 1] == '*') { 循环 (_c + 1 < ai && !(av[_c] == '*' && av[_c + 1] == '/')) _c++; _c += 2; _av2[_a2++] = ' '; 续; } 若 (av[_c] == '/' && av[_c + 1] == '/') { 循环 (_c < ai && av[_c] != '\n') _c++; _av2[_a2++] = ' '; 续; } _av2[_a2++] = av[_c++]; } _av2[_a2] = 0; memcpy(av, _av2, _a2 + 1); ai = _a2; 循环 (ai > 0 && (av[ai-1] == ' ' || av[ai-1] == '\t')) ai--; av[ai] = 0; } /* fix 2026-08-26 pngtest: 同 collect — 注释替换为空白而非截断 */
                            obj_add(nm, av); /* fix 2026-08-27 ffmpeg pcmenc: 纯数字宏也收集 — 原跳过 (值走 lexer 数值表), 但 fn pass 在 lex 前需展开 CONFIG_PCM_U8_MUXER(0) 供 ## 拼接 → `PCMDEF_ ## config` 固化 PCMDEF_CONFIG_PCM_U8_MUXER 挂死; obj 展开 "0" 与 lexer 数值展开语义一致 */
                        }
                    }
                }
            }
            若 (s[q2] == 'd' || s[q2] == 'u' || s[q2] == 'i' || s[q2] == 'e' || s[q2] == 'l' || s[q2] == 'p' || s[q2] == 'n') { /* fix 2026-08-13: 预处理行不展开; fix 2026-08-13 Phase3: # 后空白 (缩进 #  define 原被展开) */
                循环 (1) {
                    循环 (s[i] && s[i] != '\n') out[o++] = s[i++];
                    整 cont = (i > 0 && s[i] == '\n' && s[i - 1] == '\\'); /* fix 2026-08-25 sqlite: 反斜杠续行 (# error "..." 多行字符串) — 原只拷首个物理行 → 续行内容的字符串引号漏到 code 态 → 幽灵字符串吞注释/宏 → SQLITE_PRIVATE 未展开 + 产物空 */
                    若 (s[i]) out[o++] = s[i++];
                    若 (!cont) 断;
                }
                续;
            } }
        若 (s[i] == '"') { out[o++] = s[i++]; 循环 (s[i] && (s[i] != '"' || quote_escaped(s, i))) out[o++] = s[i++]; 若 (s[i]) out[o++] = s[i++]; 续; } /* fix 2026-08-14: "\\" 两反斜杠后 " 应结束 — 原把 \\" 的 " 当转义吞后续 */
        若 (s[i] == '\'') { out[o++] = s[i++]; 循环 (s[i] && (s[i] != '\'' || quote_escaped(s, i))) out[o++] = s[i++]; 若 (s[i]) out[o++] = s[i++]; 续; } /* fix 2026-08-14: '\\' 字符字面量 — 原 ' 当转义吞 423 字符 (regex.c case '|' RE_LIMITED_OPS) */
        若 (s[i] == '/' && s[i + 1] == '*') { /* fix 2026-08-13: 块注释原样保留 (内部不展开; 否则注释里的 ' 撇号触发字符字面量分支吞掉后续 → hash-ll.h platform's 卡死) */
            循环 (s[i] && !(s[i] == '*' && s[i + 1] == '/')) { 若 (o >= cap - 4) { cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +32768 (bump realloc 泄漏) */; out = realloc(out, cap); } out[o++] = s[i++]; }
            若 (s[i]) { 若 (o >= cap - 4) { cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +32768 (bump realloc 泄漏) */; out = realloc(out, cap); } out[o++] = s[i++]; 若 (s[i]) { 若 (o >= cap - 4) { cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +32768 (bump realloc 泄漏) */; out = realloc(out, cap); } out[o++] = s[i++]; } }
            续;
        }
        若 (s[i] == '/' && s[i + 1] == '/') { 循环 (s[i] && s[i] != '\n') out[o++] = s[i++]; 续; }
        若 (isalnum((无 字)s[i]) || s[i] == '_' || ((无 字)s[i] >= 0x80)) {
            整 j = i;
            循环 (isalnum((无 字)s[j]) || s[j] == '_' || ((无 字)s[j] >= 0x80)) j++;
            整 prev_ok = (i > 0) && (isalnum((无 字)s[i - 1]) || s[i - 1] == '_' || ((无 字)s[i - 1] >= 0x80));
            整 next_ok = (isalnum((无 字)s[j]) || s[j] == '_' || ((无 字)s[j] >= 0x80));
            字 nm[64]; 整 nl = j - i;
            若 (nl < 63) { memcpy(nm, s + i, nl); nm[nl] = 0; } 否 nl = 0; /* fix 2026-08-15: 32→64, FIND_BISECTION_FIRST_PARENT_ONLY (32 字符) 原 nl>=31 被丢弃不展开 → undefined */
             
            若 (!prev_ok && !next_ok && nl > 0) {
                常 字 *val = obj_find(nm);
                 
                整 dep = 0;
                循环 (val && dep < 32 && (整)strlen(val) < 4000) {
                    常 字 *v2 = obj_find(val);
                    若 (!v2 || v2 == val) 断;
                    /* 链式: val 本身也是对象宏名 → 继续替换 */
                    整 vn = 0; 循环 (isalnum((无 字)val[vn]) || val[vn] == '_' || ((无 字)val[vn] >= 0x80)) vn++;
                    若 (val[vn] != 0) 断; /* 值含非标识符 → 不再链式 */
                    val = v2;
                    dep++;
                }
                若 (val) {
                    整 vl;
                    若 (obj_exp_depth < 32 && val[0]) { /* fix 2026-08-13 Phase3: 递归展开宏值 — BITSET_WORDS=(SBC_MAX/BITSET_WORD_BITS) 内层宏原不展开 */
                        obj_exp_depth++;
                        字 *vexp = obj_macro_expand(val);
                        obj_exp_depth--;
                        vl = (整)strlen(vexp);
                        若 (o + vl < cap - 4) { memcpy(out + o, vexp, vl); o += vl; }
                        free(vexp);
                    } 否 { vl = (整)strlen(val); 若 (o + vl < cap - 4) { memcpy(out + o, val, vl); o += vl; } }
                    i = j; 续;
                }
            }
            循环 (i < j) out[o++] = s[i++];
            续;
        }
        out[o++] = s[i++];
        若 (o >= cap - 4) { cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +32768 (bump realloc 泄漏) */; out = realloc(out, cap); }
    }
    out[o] = 0;
    返 out;
}/* string #define macros: #define NAME "value" — fix 2026-08-03: only NUMBER
   macros were supported, so route_learn's LOG_DIR/WEIGHTS_FILE compiled to
   NULL → scan_logs(NULL) crashed in the snprintf %s copy loop. The DECODED
   value is stored here and copied into str_tbl at the USE SITE (assigning the
   ID in source-reference order), so the .字串 ID order == sdat placement order
   and the 3-stage H1==H2 string layout stays identical. */
静 构 { 字 name[64]; 字 val[2048]; } str_macros[4096]; /* fix 2026-08-06; Phase1-L3: 64->1024 */ 静 整 str_macro_n;
静 字 *str_macro_find(常 字 *n) { 遍 (整 i = 0; i < str_macro_n; i++) 若 (!strcmp(str_macros[i].name, n)) 返 str_macros[i].val; 返 0; }
