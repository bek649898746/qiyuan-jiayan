        { 整 v2 = Nd(1); memcpy((字*)(nn + v2), sname, 32); 整 addr = Nd(11); Nc(addr, v2); Nc(call, addr); }
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "__qcc_sem_post", 15); Nc(call, fn); }
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "读写锁")) { /* 接入 2026-08-28 P1 #51: 读写锁声明 — 读写锁 rw; → { int __rwl_rw = 0; } state: >0 读者数 / 0 空闲 / -1 写者 */
        tk++; /* 读写锁 */
        字 rn[64]; strcpy(rn, tn[tk]); tk++;
        若 (tt[tk] == SK) tk++;
        字 rname[80]; sprintf(rname, "__rwl_%s", rn);
        var_offset(rname);
