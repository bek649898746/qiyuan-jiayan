                   slot_h[] is indexed by ARGUMENT position (the callee is skipped in both
                   the push loop and here), so walk kids skipping fn to find each arg node. */
                整 ak = 0;
                遍 (整 i = 0; i < 20 && ak < 4; i++) {
                    整 c = kids[i];
                    若 (c == fn || c < 0) 续;
                    整 gpr;
                    若 (ak == 0) gpr = 1; 否 若 (ak == 1) gpr = 2; 否 若 (ak == 2) gpr = 8; 否 gpr = 9;
                    若 (ndbl[c]) movsd_xmmreg_mrsp64(ak, argbase + total_h - slot_h[ak] - 8);
                    否 { mov_reg_mrsp64(0, argbase + total_h - slot_h[ak] - 8); mov_rr64(gpr, 0); }
                    ak++;
                }
            } 否 {
            /* builtin (printf/memcpy/...): fmt/int args load rcx/rdx/r8/r9; doubles read the pushed slots via r13 */
            若 (nargs >= 1) { mov_reg_mrsp64(0, argbase + total_h - slot_h[0] - 8); mov_rr64(1, 0); }
            若 (nargs >= 2) { mov_reg_mrsp64(0, argbase + total_h - slot_h[1] - 8); mov_rr64(2, 0); }
            若 (nargs >= 3) { mov_reg_mrsp64(0, argbase + total_h - slot_h[2] - 8); mov_rr64(8, 0); }
            若 (nargs >= 4) { mov_reg_mrsp64(0, argbase + total_h - slot_h[3] - 8); mov_rr64(9, 0); }
