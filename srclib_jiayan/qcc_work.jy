    若 (tt[tk] == VR && !strcmp(tn[tk], "方差")) { /* 接入 2026-08-28 方差 (variance): 方差 v, arr, n; → { __sn=n; __sm=0; __si=0; while(__si<__sn){ __sm+=arr[__si]; __si++; } __av=__sm/__sn; __sv=0; __si=0; while(__si<__sn){ __df=arr[__si]-__av; __sv+=__df*__df; __si++; } v=__sv/__sn; } — 两遍: 均值 + 平方差和 */
