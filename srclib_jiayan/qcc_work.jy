          Nc(d, mod); Nc(blk, d); }
        /* if (__rt < 0) { __rt += n; } */
        { 整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
          整 zero = Nd(0); nv[zero] = 0;
          整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_k); Nc(cmp, zero);
          整 ifn = Nd(8); Nc(ifn, cmp);
          { 整 v_k2 = Nd(1); memcpy((字*)(nn + v_k2), kname, 32);
            整 add = Nd(2); nv[add] = PK; Nc(add, v_k2); { 整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32); Nc(add, v_n); } /* __rt + n */
            整 asg = Nd(10); Nc(asg, v_k2); Nc(asg, add); Nc(ifn, asg); } /* __rt += n; */
          Nc(blk, ifn); }
        /* if (__rt != 0) { 反转[0,n-__rt) + 反转[n-__rt,n) + 反转[0,n) } */
        { 整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
          整 zero = Nd(0); nv[zero] = 0;
          整 cmp = Nd(2); nv[cmp] = T_XK; Nc(cmp, v_k); Nc(cmp, zero);
          整 ifn = Nd(8); Nc(ifn, cmp);
          整 ibd = Nd(5);
          /* 反转1 [0, n-__rt) */
          { 整 d = Nd(7); memcpy((字*)(nn + d), bname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(ibd, d); }
          { 整 wh = Nd(9);
            { 整 v_b = Nd(1); memcpy((字*)(nn + v_b), bname, 32);
              整 v_k2 = Nd(1); memcpy((字*)(nn + v_k2), kname, 32);
              整 sub = Nd(2); nv[sub] = MK; { 整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32); Nc(sub, v_n); } Nc(sub, v_k2); /* n-__rt */
              整 half = Nd(2); nv[half] = DV; Nc(half, sub); { 整 two = Nd(0); nv[two] = 2; Nc(half, two); } /* (n-__rt)/2 */
              整 cmp2 = Nd(2); nv[cmp2] = T_LK; Nc(cmp2, v_b); Nc(cmp2, half);
              Nc(wh, cmp2); } /* while (__rb < (n-__rt)/2) */
            整 wbd = Nd(5);
            整 v_t = Nd(1); memcpy((字*)(nn + v_t), wname, 32);
            整 v_b = Nd(1); memcpy((字*)(nn + v_b), bname, 32);
            整 idx1 = Nd(14); Nc(idx1, v_r); Nc(idx1, v_b); /* arr[__rb] */
            { 整 v_k3 = Nd(1); memcpy((字*)(nn + v_k3), kname, 32);
              整 sub1 = Nd(2); nv[sub1] = MK; { 整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32); Nc(sub1, v_n); } Nc(sub1, v_k3); /* n-__rt */
              { 整 one = Nd(0); nv[one] = 1; 整 sub2 = Nd(2); nv[sub2] = MK; Nc(sub2, sub1); Nc(sub2, one); /* n-__rt-1 */
                整 v_b2 = Nd(1); memcpy((字*)(nn + v_b2), bname, 32);
                整 sub3 = Nd(2); nv[sub3] = MK; Nc(sub3, sub2); Nc(sub3, v_b2); /* n-__rt-1-__rb */
                整 idx2 = Nd(14); Nc(idx2, v_r); Nc(idx2, sub3); /* arr[n-__rt-1-__rb] */
                { 整 asg = Nd(10); Nc(asg, v_t); Nc(asg, idx1); Nc(wbd, asg); } /* __rw = arr[__rb]; */
                { 整 asg = Nd(10); Nc(asg, idx1); Nc(asg, idx2); Nc(wbd, asg); } /* arr[__rb] = arr[..]; */
                { 整 asg = Nd(10); Nc(asg, idx2); Nc(asg, v_t); Nc(wbd, asg); } /* arr[..] = __rw; */
              } }
            { 整 v_b2 = Nd(1); memcpy((字*)(nn + v_b2), bname, 32);
