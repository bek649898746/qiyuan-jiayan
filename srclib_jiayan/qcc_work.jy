                    若 (asi >= 0 && stypes[asi].sz > 8) { bigsz = stypes[asi].sz; bigarr = 1; }
                }
                若 (bigsz > 0) {
                    整 aoff = var_lookup((字*)(nn + c));
                    整 nblk = (bigsz + 7) / 8;
                    若 (var_big_param((字*)(nn + c))) {
                        mov_reg_mbrp64(10, aoff - cur_frame_sz); /* r10 = copy ptr (param slot holds the address) */
                    } 否 若 (bigarr) {
