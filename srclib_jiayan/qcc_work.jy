        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "空合")) { /* 接入 2026-08-28 空合并 (null-coalescing): 空合 x, a, b; → { __mc=a; if(__mc!=0){ x=__mc; } if(__mc==0){ x=b; } } — a 非 0 用 a, 否则 b */
        tk++; /* 空合 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标变量 */
