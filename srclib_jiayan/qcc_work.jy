    若 (tt[tk] == VR && (!strcmp(tn[tk], "矩阵加") || !strcmp(tn[tk], "矩阵减"))) { /* 接入 2026-08-28 矩阵加/减 (蓝图 §一 矩阵族): 矩阵加 C, A, B, m, n; → { __mai=0; while(__mai<m){ __maj=0; while(__maj<n){ __maa=A[__mai][__maj]; __mab=B[__mai][__maj]; C[__mai][__maj]=__maa+__mab; __maj++; } __mai++; } } — 逐元素加/减 (双 2D 下标先存内部变量防寄存器冲突) */
