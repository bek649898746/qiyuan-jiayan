                遍 (整 ti2 = save_tk; ti2 < tk; ti2++) 若 (tt[ti2] == VK && (!strcmp(tn[ti2], "char") || !strcmp(tn[ti2], "_Bool"))) g_is_char = 1;
                若 (!g_is_char) { 整 tdi_gch = g_tdef >= 0 ? g_tdef : tdef_lookup(tn[save_tk]); 若 (tdi_gch >= 0 && !tdefs[tdi_gch].is_struct && !tdefs[tdi_gch].is_fnptr && !tdefs[tdi_gch].is_dbl && tdefs[tdi_gch].sz == 1) g_is_char = 1; } /* fix 2026-08-30 csmith t5: typedef char 全局数组 (int8_t g[5]) — 原 g_is_char=0 → g_esz=4 → brace_arr_init memset 清 5*4=20 字节越界覆盖 argv 数组区 → 有参 main strcmp(argv[1]) 崩 (103 崩溃家族) */
