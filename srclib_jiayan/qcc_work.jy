    若 (n242[p] < 0) { n242[p] = c; 返; }
    若 (n243[p] < 0) { n243[p] = c; 返; }
    若 (n244[p] < 0) { n244[p] = c; 返; }
    若 (n245[p] < 0) { n245[p] = c; 返; }
    若 (n246[p] < 0) { n246[p] = c; 返; }
    若 (n247[p] < 0) { n247[p] = c; 返; }
    若 (n248[p] < 0) { n248[p] = c; 返; }
    若 (n249[p] < 0) { n249[p] = c; 返; }
    若 (n250[p] < 0) { n250[p] = c; 返; }
    若 (n251[p] < 0) { n251[p] = c; 返; }
    若 (n252[p] < 0) { n252[p] = c; 返; }
    若 (n253[p] < 0) { n253[p] = c; 返; }
    若 (n254[p] < 0) { n254[p] = c; 返; }
    若 (n255[p] < 0) { n255[p] = c; 返; }
}

静 整 prim(空);
静 整 stmt(空);
静 整 expr(空);

静 整 prim(空) {
    若 (tt[tk] == PP || tt[tk] == MM) { /* 前缀 ++/--：先改值，返回新值（fix 2026-08-05） */
        整 is_dec = (tt[tk] == MM); tk++;
        整 v = prim();
        整 m = Nd(26); nv[m] = is_dec; Nc(m, v);
        返 m;
    }
    若 (tt[tk] == BK) { /* sizeof */
        tk++; /* skip sizeof */
        若 (tt[tk] == OK) tk++; /* skip ( */
        若 (tt[tk] == VK) { /* sizeof(int/char/double/...) + 指针 (fix 2026-08-05: was hardcoded 4 for every type) */
            整 tsz = 4;
            若 (!strcmp(tn[tk], "char")) tsz = 1;
            否 若 (!strcmp(tn[tk], "double")) tsz = 8;
            否 若 (!strcmp(tn[tk], "short")) tsz = 2;
            tk++;
            若 (tt[tk] == DK) { tsz = 8; tk++; } /* sizeof(int*) → 8 */
            若 (tt[tk] == KK) tk++;
            整 n = Nd(0); nv[n] = tsz; 返 n;
        }
        若 (tt[tk] == ST) { tk++; /* skip struct */
            若 (tt[tk] == VR) {
                整 sz = st_sz(tn[tk]); tk++; /* struct name */
                若 (tt[tk] == KK) tk++; /* ) */
                整 n = Nd(0); nv[n] = sz; 返 n;
            } 否 若 (tt[tk] == FK) { /* sizeof(struct {...}) — 匿名内联定义（fix 2026-08-05：原未处理 → parse 返 -1 吞掉 main 主体） */
                tk++; /* { */
                字 aname[32]; aname[0] = 0; 整 si = st_add(aname);
                整 funs = 0; /* unsigned 位域标记 */
                循环 (tk < TS && tt[tk] != UK) {
                    整 fsz = 4; 整 frow = 1; 整 dims = 0; 整 first = 1; 整 fdbl = 0;
                    若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char")) { fsz = 1; frow = 1; } 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; frow = 8; fdbl = 1; } tk++; }
                    否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == DK) tk++; 若 (tt[tk] == VR) { 字 fn[32]; strcpy(fn, tn[tk]); tk++; st_field_sz_r(si, fn, 4, 1); } }
                    否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; }
                    若 (tt[tk] == CL) { /* 无名位域 */
                        tk++; 整 ubw = 0;
                        若 (tt[tk] == NK) { ubw = tv[tk]; tk++; }
                        st_field_bit_anon(si, ubw);
                        funs = 0;
                    }
                    若 (tt[tk] == VR) {
                        字 fn[32]; strcpy(fn, tn[tk]); tk++;
                        整 bitw = 0;
                        若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) { bitw = tv[tk]; tk++; } }
                        若 (bitw > 0) { st_field_bit(si, fn, fsz, fsz, bitw, funs); 若 (fdbl) st_field_dbl(si, fn); funs = 0; }
                        否 {
                            循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { 若 (dims == 0) first = tv[tk]; dims++; fsz *= tv[tk]; tk++; } 若 (tt[tk] == RB) tk++; }
                            若 (dims >= 1) frow = fsz / first; 否 frow = fsz;
                            st_field_sz_r(si, fn, fsz, frow);
                            若 (fdbl) st_field_dbl(si, fn); 若 (fll) st_field_ty(si, fn, -3);
                        }
                    }
                    若 (tt[tk] == CK) tk++;
                    若 (tt[tk] == SK) tk++;
                }
                若 (tt[tk] == UK) tk++; /* } */
                若 (stypes[si].algn > 1) { 整 m = stypes[si].sz % stypes[si].algn; 若 (m) stypes[si].sz += stypes[si].algn - m; } /* fix 2026-08-06: struct 总大小 round up 到最大对齐 */
                整 sz = stypes[si].sz;
                若 (tt[tk] == KK) tk++; /* ) */
                整 n = Nd(0); nv[n] = sz; 返 n;
            }
        }
        若 (tt[tk] == VR && td_is(tn[tk])) { /* sizeof(TypedefName) — typedef'd struct/double */
            整 tdi = tdef_lookup(tn[tk]);
            若 (tdi >= 0 && tdefs[tdi].is_struct) {
                整 sz = st_sz(tdefs[tdi].st_name); tk++;
                若 (tt[tk] == KK) tk++;
                整 n = Nd(0); nv[n] = sz; 返 n;
            }
            若 (tdi >= 0 && tdefs[tdi].is_dbl && !tdefs[tdi].is_struct) { /* sizeof(typedef double) → 8 (fix 2026-08-05) */
                tk++;
                若 (tt[tk] == KK) tk++;
                整 n = Nd(0); nv[n] = 8; 返 n;
            }
        }
        若 (tt[tk] == VR) { /* sizeof(varname): array -> N*esz, double -> 8, char -> 1, ptr -> 8, else 4 */
            整 sz = 4;
            整 base_si = -1;
            遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                若 (!strcmp(vars[vi].name, tn[tk]) && var_codegen_visible(vi)) {
                    若 (vars[vi].arr_sz > 0) { 整 e = vars[vi].arr_esz ? vars[vi].arr_esz : 4; sz = vars[vi].arr_sz * e; }
                    否 若 (vars[vi].is_dbl) sz = 8;
                    否 若 (vars[vi].is_char) sz = 1;
                    否 若 (vars[vi].p_esz != 0) sz = 8; /* 指针: p_esz=元素大小, 槽 8 字节 */
                    否 sz = 4;
                    base_si = vars[vi].st_idx;
                    断;
                }
            tk++; /* skip varname */
            若 (tt[tk] == DT || tt[tk] == AR) { /* -> / . member: sizeof(e->name) */
                tk++;
                若 (tt[tk] == VR) {
                    若 (base_si >= 0) { 整 fs = st_field_size(stypes[base_si].name, tn[tk]); 若 (fs > 0) sz = fs; }
                    tk++;
                }
            }
            若 (tt[tk] == KK) tk++; /* ) */
            整 n = Nd(0); nv[n] = sz; 返 n;
        }
        返 -1;
    }
    若 (tt[tk] == NK) { 整 n = Nd(0); nv[n] = tv[tk]; 若 (tuns[tk]) nuns[n] = 1; 若 (tll[tk]) { nll[n] = 1; nll_hi[n] = tll_hi[tk]; } tk++; 返 n; } /* u-/LL-后缀字面量 → 标记（fix 2026-08-05） */
    若 (tt[tk] == FP) { 整 n = Nd(0); nv[n] = tv[tk]; nt[n] = FP; ndbl[n] = 1; tk++; 返 n; } /* double literal */
    若 (tt[tk] == VR) {
        /* enum constant? */
        整 ev = e_lookup(tn[tk]);
        若 (ev >= 0) { tk++; 整 n = Nd(0); nv[n] = ev; 返 n; }
        整 n = Nd(1); memcpy((字*)(nn + n), tn[tk], 32); tk++;
        若 (var_is_dbl(tn[tk - 1]) && var_arrsz(tn[tk - 1]) == 0) ndbl[n] = 1; /* double VARIABLE (数组名衰减为地址，不是 double — fix 2026-08-05: double 数组名被标 ndbl → 指针/double 比较走了浮点路径) */
        若 (var_is_ll(tn[tk - 1]) && var_arrsz(tn[tk - 1]) == 0) nll[n] = 1; /* long long 变量（fix 2026-08-05） */
        若 (var_is_uns(tn[tk - 1]) && var_arrsz(tn[tk - 1]) == 0) nuns[n] = 1; /* unsigned 变量（fix 2026-08-06: (long long)u 必须零扩展, movsxd 判断靠 nuns） */
        /* suffix chain: arr[expr] / .field / ->field (repeatable) */
        循环 (1) {
            若 (tt[tk] == LB) { /* array access */
                tk++; /* skip [ */
                整 m = Nd(14); /* array access node */
                Nc(m, n); /* n0 = variable */
                Nc(m, expr()); /* n1 = index */
                若 (tt[tk] == RB) tk++; /* skip ] */
                若 (nt[n] == 1 && (var_is_dbl((字*)(nn + n)) || var_pdbl((字*)(nn + n)))) ndbl[m] = 1; /* double array / double* elem */
                否 若 (ndbl[n]) ndbl[m] = 1; /* nested arr[i][j]: outer index node inherits double flag */
                n = m;
            } 否 若 (tt[tk] == DT || tt[tk] == AR) {
                整 ar = (tt[tk] == AR); tk++;
                若 (tt[tk] == VR) {
                    整 m = Nd(15); /* unified member access */
                    Nc(m, n); nv[m] = ar; /* nv=1 for arrow, 0 for dot */
                    memcpy((字*)(nn + m), tn[tk], 32); tk++;
                    若 (nt[n] == 1) { /* base is a struct var: flag double fields */
                        整 bsi = var_stidx((字*)(nn + n));
                        若 (bsi >= 0 && st_field_is_dbl(stypes[bsi].name, (字*)(nn + m))) ndbl[m] = 1;
                    }
                    n = m;
                } 否 断;
            } 否 若 (tt[tk] == PP || tt[tk] == MM) {
                /* postfix ++ / -- : return old value, then mutate (simple vars) */
                整 is_dec = (tt[tk] == MM); tk++;
                整 m = Nd(23); nv[m] = is_dec;
                Nc(m, n); n = m;
            } 否 若 (tt[tk] == OK) { /* 函数调用 f(...): 并入后缀链 (fix 2026-08-06: 镜像 qcc_x86.c — f()[0] 的 [0] 原悬空) */
                tk++; 整 c = Nd(4); 循环 (tt[tk] != KK) { 若 (tt[tk] == CK) tk++; Nc(c, expr()); } tk++; Nc(c, n); n = c;
            } 否 断;
        }
        返 n; }
    若 (tt[tk] == OK) {
        /* type cast: (type)expr �?type keywords/struct/typedef then ) */
        若 (tt[tk + 1] == VK || tt[tk + 1] == ST || (tt[tk + 1] == VR && td_is(tn[tk + 1]))) {
            字 *cast_ty = 0;
            tk++; /* ( */
            若 (tt[tk] == VK) { cast_ty = tn[tk]; 循环 (tt[tk] == VK) tk++; } /* first type kw: int/double */
            否 循环 (tt[tk] == VK) tk++;
            若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) tk++; }
            否 若 (tt[tk] == VR && td_is(tn[tk])) tk++;
            循环 (tt[tk] == DK) tk++; /* pointer * */
            若 (tt[tk] == KK) tk++; /* ) */
            整 ce = prim(); /* cast 操作数是 UNARY 表达式——用 prim() 而非 expr()：`(long long)1<<32` 必须先做 64 位 cast 再移位，不能解析成 `(long long)(1<<32)`（fix 2026-08-05） */
            /* (int) on a double expr: real truncation via node 19 (cg: cvttsd2si) */
            若 (cast_ty && !strcmp(cast_ty, "int") && ndbl[ce]) { 整 m = Nd(19); Nc(m, ce); ndbl[m] = 0; 返 m; }
            若 (cast_ty && !strcmp(cast_ty, "long") && ce >= 0) nll[ce] = 1; /* (long long)x -> 64 位操作数（fix 2026-08-05） */
            /* 后缀链: (cast)->field / (cast)[i] / (cast)(args) (fix 2026-08-06: 镜像 qcc_x86.c — ((T*)0)->i 的 ->i 原悬空) */
            循环 (1) {
                若 (tt[tk] == LB) { tk++; 整 m = Nd(14); Nc(m, ce); Nc(m, expr()); 若 (tt[tk] == RB) tk++; ce = m; }
                否 若 (tt[tk] == DT || tt[tk] == AR) {
                    整 ar = (tt[tk] == AR); tk++;
                    若 (tt[tk] == VR) { 整 m = Nd(15); Nc(m, ce); nv[m] = ar; memcpy((字*)(nn + m), tn[tk], 32); tk++; ce = m; } 否 断;
                } 否 若 (tt[tk] == OK) { tk++; 整 c = Nd(4); 循环 (tt[tk] != KK) { 若 (tt[tk] == CK) tk++; Nc(c, expr()); } tk++; Nc(c, ce); ce = c; }
                否 断;
            }
            返 ce; /* cast is no-op: value unchanged */
        }
        tk++; 整 n = expr();
        /* comma operator inside parens: (a, b, c) �?needed for (i++, PP) in the
           lexer's switch ternaries. NOT added to expr() itself: function args
           (f(a, b)) must stay separate (the call parser consumes the CK). */
        循环 (tt[tk] == CK) { tk++; 整 a = Nd(2); nv[a] = CK; Nc(a, n); Nc(a, expr()); n = a; }
        tk++;
        /* 后缀链: (expr)->field / (expr)[i] / (expr)(args) (fix 2026-08-06: 镜像 qcc_x86.c — 原只处理 (expr)(args), ((T*)0)->i 悬空) */
        循环 (1) {
            若 (tt[tk] == LB) { tk++; 整 m = Nd(14); Nc(m, n); Nc(m, expr()); 若 (tt[tk] == RB) tk++; n = m; }
            否 若 (tt[tk] == DT || tt[tk] == AR) {
                整 ar = (tt[tk] == AR); tk++;
                若 (tt[tk] == VR) { 整 m = Nd(15); Nc(m, n); nv[m] = ar; memcpy((字*)(nn + m), tn[tk], 32); tk++; n = m; } 否 断;
            } 否 若 (tt[tk] == OK) { tk++; 整 c = Nd(4); 循环 (tt[tk] != KK) { 若 (tt[tk] == CK) tk++; Nc(c, expr()); } tk++; Nc(c, n); n = c; }
            否 断;
        }
        返 n;
    }
    若 (tt[tk] == PT) { tk++; 整 n = Nd(11); Nc(n, prim()); 返 n; }
    若 (tt[tk] == DK) { tk++; 整 n = Nd(12); Nc(n, prim()); 返 n; }
    若 (tt[tk] == NT) { tk++; 整 n = Nd(17); Nc(n, prim()); 返 n; }
    若 (tt[tk] == BN) { tk++; 整 n = Nd(18); Nc(n, prim()); 返 n; } /* ~expr */
    若 (tt[tk] == MK) { /* unary minus: -expr */
        tk++;
        /* -double-literal: flip the IEEE sign bit at PARSE time (keeps -0.0 as a
           real negative zero; a runtime 0.0 - x would round -0.0 to +0.0) */
        若 (tt[tk] == FP) {
            整 idx = tv[tk];
            若 (dbl_n < 1024) { dbl_hi[dbl_n] = dbl_hi[idx]; dbl_lo[dbl_n] = dbl_lo[idx]; dbl_hi[dbl_n] ^= 0x80000000; } /* 不去重（C 原版 1922）：自举对齐 */
                    若 (dbl_n >= 1024) { fprintf(stderr, "[ERR] double 字面量表满 (fix 2026-08-06 M3)\n"); exit(1); }
            整 n = Nd(FP); nv[n] = dbl_n; ndbl[n] = 1; dbl_n++; tk++; /* -double 字面量必须标 ndbl（fix 2026-08-06） */
            返 n;
        }
        整 n = Nd(2); nv[n] = MK; Nc(n, Nd(0)); nv[n0[n]] = 0; Nc(n, prim()); 返 n;
    }
    若 (tt[tk] == STR) { 整 n = Nd(0); nv[n] = tv[tk]; /* str index → treated as immediate for codegen */ nt[n] = STR; tk++;
        while (tt[tk] == LB) { /* 字符串字面量下标 "abc"[i] (fix 2026-08-06: 原无 suffix chain → 实参解析卡死循环) */
            tk++; /* [ */
            整 m = Nd(14); Nc(m, n); Nc(m, expr()); 若 (tt[tk] == RB) tk++; /* ] */
            n = m;
        }
        返 n; }
    返 -1;
}

静 整 mul(空) { 整 n = prim(); 循环 (tt[tk] == DK || tt[tk] == DV || tt[tk] == MD || tt[tk] == SH || tt[tk] == SR) { 整 o = tt[tk++]; 整 a = Nd(2); nv[a] = o; 整 r = prim(); Nc(a, n); Nc(a, r); 若 ((o == DK || o == DV) && (ndbl[n] || ndbl[r])) ndbl[a] = 1; n = a; } 返 n; }
静 整 add(空) { 整 n = mul(); 循环 (tt[tk] == PK || tt[tk] == MK || tt[tk] == PT || tt[tk] == OR || tt[tk] == XR) { 整 o = tt[tk++]; 整 a = Nd(2); nv[a] = o; 整 r = mul(); Nc(a, n); Nc(a, r); 若 ((o == PK || o == MK) && (ndbl[n] || ndbl[r])) ndbl[a] = 1; n = a; } 返 n; }
静 整 cmp(空) { 整 n = add(); 循环 (tt[tk] == LK || tt[tk] == GK || tt[tk] == QK || tt[tk] == XK || tt[tk] == HK || tt[tk] == YK) { 整 o = tt[tk++]; 整 a = Nd(2); nv[a] = o; Nc(a, n); Nc(a, add()); n = a; } 返 n; }
静 整 land(空) { 整 n = cmp(); 循环 (tt[tk] == LA) { tk++; 整 a = Nd(2); nv[a] = LA; Nc(a, n); Nc(a, cmp()); n = a; } 返 n; }
静 整 lor(空) { 整 n = land(); 循环 (tt[tk] == LO) { tk++; 整 a = Nd(2); nv[a] = LO; Nc(a, n); Nc(a, land()); n = a; } 返 n; }
静 整 tern(空) { 整 n = lor(); 若 (tt[tk] == QU) { tk++; 整 t = lor(); 若 (tt[tk] == CL) tk++; 整 f = tern(); 整 a = Nd(22); Nc(a, n); Nc(a, t); Nc(a, f); 返 a; } 返 n; }
静 整 asgn(空) { 整 n = tern(); 若 (tt[tk] == AK) { tk++; 整 a = Nd(10); Nc(a, n); Nc(a, asgn()); 返 a; }
    若 (tt[tk] == PA || tt[tk] == MA || tt[tk] == DA || tt[tk] == SA || tt[tk] == OA || tt[tk] == AA || tt[tk] == XA || tt[tk] == SHR || tt[tk] == SHL || tt[tk] == MS) {
        整 o = tt[tk++];
        整 op = (o == PA) ? PK : (o == MA) ? MK : (o == DA) ? DK : (o == SA) ? DV : (o == OA) ? OR : (o == AA) ? AN : (o == XA) ? XR : (o == SHR) ? SR : (o == MS) ? MD : SH; /* fix 2026-08-05：MS=%= → MD */
        整 a = Nd(10); 整 bin = Nd(2); nv[bin] = op;
        Nc(a, n); Nc(bin, n); Nc(bin, asgn()); Nc(a, bin); /* a op= b �?a = a op b */
        返 a;
    } 返 n; }
静 整 expr(空) { 返 asgn(); }

/* local ARRAY brace init: int a[3]={1,2,3}; -> a[0]=1; a[1]=2; a[2]=3; */
静 整 gi_idx[8];  /* 全局多维初始化游标 (fix 2026-08-05) */
静 整 str_row = 0; /* 字符串初始化行计数器：char 行按顺序填充（fix 2026-08-05） */

静 整 arr_blk = -1; 静 整 arr_blk_root = -1; 静 整 arr_blk_cnt = 0; /* fix 2026-08-06: 块链, arr_blk_root=首块 */
静 空 arr_chain_add(整 asgn) {
    若 (arr_blk < 0) { arr_blk = Nd(5); arr_blk_root = arr_blk; arr_blk_cnt = 0; }
    若 (arr_blk_cnt >= 200) { 整 nb = Nd(5); Nc(arr_blk, nb); arr_blk = nb; arr_blk_cnt = 0; }
    Nc(arr_blk, asgn);
    arr_blk_cnt++;
}
静 空 brace_arr_init(整 b, 整 d, 整 *dims, 整 nd, 整 depth) {
    /* 递归初始化器: int a[2][3] = {1,2,3,4,5,6} 或 {{1,2,3},{4,5,6}}
       gi_idx[0..nd-1] = 完整多维游标。遇 { 下钻深度, 遇值生成 a[i][j]... = expr。
       顶层扁平(无内层 {)用低位进位; 嵌套行递归只推进本层列, 行由外层 FK 推进。
       本函数自管 { } 配平 (fix 2026-08-05) */
    若 (depth == 0) { arr_blk = -1; arr_blk_root = -1; arr_blk_cnt = 0; } /* fix 2026-08-06 */
    若 (tt[tk] == FK) tk++; /* 本层 '{' */
    整 has_nested = (tt[tk] == FK); /* 本层是否为嵌套行模式 */
    循环 (tt[tk] != UK) {
        若 (tt[tk] == CK || tt[tk] == SK) { tk++; 续; }
        若 (tt[tk] == UK) 断;
        若 (tt[tk] == FK && depth < nd - 1) { /* 嵌套行 { ... } */
            gi_idx[depth + 1] = 0; /* 重置子游标 (fix: next row continued from the previous row's column) */
            brace_arr_init(b, d, dims, nd, depth + 1); /* 递归开头统一吃 '{' (fix 2026-08-05: FK also tk++'d → double-ate on 3D) */
            gi_idx[depth]++; /* 行推进 */
            续;
        }
        若 (tt[tk] == STR) { /* char 行 = 字符串: char s[2][4] = {"ab","cd"} — 把字符串字节拷入行（fix 2026-08-05: 原存字符串地址 → 垃圾） */
            整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32);
            字 *sval = str_tbl[tv[tk]]; tk++;
            整 row_sz = dims[nd - 1] ? dims[nd - 1] : 1;
            /* 行号 → 前 nd-1 维索引（从次内层展开，独立于嵌套 depth） */
            整 rem = str_row;
            整 idxs[8];
            遍 (整 i = nd - 2; i >= 0; i--) { idxs[i] = rem % (dims[i] ? dims[i] : 1); rem /= (dims[i] ? dims[i] : 1); }
            整 node = idn;
            遍 (整 i = 0; i < nd - 1; i++) {
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = idxs[i];
                Nc(acc, idx);
                node = acc;
            }
            整 len = (整)strlen(sval);
            若 (len > row_sz) len = row_sz;
            遍 (整 k = 0; k < len; k++) {
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = k;
                Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc);
                整 cn = Nd(0); nv[cn] = (无 字)sval[k];
                Nc(asgn, cn);
                arr_chain_add(asgn);
            }
            若 (len < row_sz) { /* 补 NUL（C: char 行其余补 0） */
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = len;
                Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc);
                整 cn = Nd(0); nv[cn] = 0;
                Nc(asgn, cn);
                arr_chain_add(asgn);
            }
            str_row++;
            续;
        }
        /* 叶子: a[gi_idx[0]]...[gi_idx[nd-1]] = expr */
        /* 叶子 → 块链 (fix 2026-08-06) */
        整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32);
        整 node = idn;
        遍 (整 i = 0; i < nd; i++) {
            整 acc = Nd(14); Nc(acc, node);
            整 idx = Nd(0); nv[idx] = gi_idx[i];
            Nc(acc, idx);
            node = acc;
        }
        整 asgn = Nd(10); Nc(asgn, node); Nc(asgn, expr());
        arr_chain_add(asgn);
        /* 推进: 顶层扁平 → 低位进位; 嵌套行 → 只推进本层列 */
        若 (depth == 0 && !has_nested) {
            遍 (整 i = nd - 1; i >= 0; i--) {
                gi_idx[i]++;
                若 (gi_idx[i] < dims[i]) 断;
                gi_idx[i] = 0;
            }
        } 否 {
            gi_idx[depth]++;
        }
    }
    若 (tt[tk] == UK) tk++; /* 本层 '}' */
    若 (depth == 0 && arr_blk_root >= 0) Nc(b, arr_blk_root); /* fix 2026-08-06: 根块挂到顶层块 */
}

静 整 jy_min(空) { 返 0; }
/* x */
静 整 fx0(整 x) { 返 x + 0; }
静 整 fx1(整 x) { 返 x + 1; }
静 整 fx2(整 x) { 返 x + 2; }
静 整 fx3(整 x) { 返 x + 3; }
静 整 fx4(整 x) { 返 x + 4; }
静 整 fx5(整 x) { 返 x + 5; }
静 整 fx6(整 x) { 返 x + 6; }
静 整 fx7(整 x) { 返 x + 7; }
静 整 fx8(整 x) { 返 x + 8; }
静 整 fx9(整 x) { 返 x + 9; }

/* 甲言特性: 求绝对值 */
静 整 甲绝对值(整 x) { 若 (x < 0) 返 -x; 返 x; }
静 整 f(空) { 返 0; }
静 整 f(整 x) { 返 x; }
静 整 f(整 x) { 返 x + 1; }
静 整 f(整 x) { 整 y; y = x + 1; 返 y; }
静 整 f(整 x) { 若 (x > 0) 返 1; 返 0; }
静 整 f(整 x) { 循环 (x > 0) x = x - 1; 返 x; }
静 整 甲绝对值(整 x) { 若 (x < 0) 返 -x; 返 x; }
静 整 blk(空) {
    整 b = Nd(5); tk++;
    整 b_root = b;  /* first block = sequence root; extra blocks chain as children */
    整 b_cnt = 0;   /* children attached to current block (keep 256-slot headroom) */
    循环 (tt[tk] != UK) {
        若 (b_cnt >= 200) { /* block near its 256 child slots: chain a new sub-block
                               (cg case 5 recurses into nested blocks). main()'s body
                               has ~270 statements �?without this, Nc() silently drops
                               everything past the 256th. */
            整 nb = Nd(5);
            Nc(b, nb);
            b = nb;
            b_cnt = 0;
        }
        若 (tt[tk] == ST || (tt[tk] == VK && !strcmp(tn[tk], "static") && tt[tk + 1] == ST)) {
            /* function-local struct var: [static] struct C c; or struct C *p; */
            整 is_static = (tt[tk] == VK);
            若 (is_static) tk++; /* static */
            tk++; /* struct */
            整 si = -1;
            若 (tt[tk] == VR) { si = st_find(tn[tk]); tk++; } /* tag name C */
            若 (tt[tk] == FK) { /* struct Inner { fields }; — local TYPE definition */
                字 tname[32]; strcpy(tname, tn[tk - 1]);
                整 nsi = st_add(tname);
                tk++; /* { */
                整 funs = 0; /* unsigned 位域标记（跨 unsigned/int 迭代；fix 2026-08-05） */
                循环 (tk < TS && tt[tk] != UK) {
                    整 fsz = 4; 整 frow = 1; 整 dims = 0; 整 first = 1; 整 fdbl = 0;
                    若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char")) fsz = 1; 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; fdbl = 1; } tk++; }
                    否 若 (tt[tk] == ST) { /* nested struct field (maybe self-ref) */
                        tk++;
                        若 (tt[tk] == VR) {
                            整 inner_si = st_find(tn[tk]); tk++;
                            整 fptr = 0;
                            若 (tt[tk] == DK) { fptr = 1; tk++; }
                            若 (inner_si >= 0 && tt[tk] == VR) {
                                字 fn[32]; strcpy(fn, tn[tk]); tk++;
                                st_field_sz_r(nsi, fn, fptr ? 8 : stypes[inner_si].sz, 1);
                                st_field_ty(nsi, fn, inner_si);
                            }
                        }
                        若 (tt[tk] == SK) tk++;
                        续;
                    }
                    若 (tt[tk] == CL) { /* 无名位域 ": N" — 占位不注册（fix 2026-08-05） */
                        tk++; 整 ubw = 0;
                        若 (tt[tk] == NK) { ubw = tv[tk]; tk++; }
                        st_field_bit_anon(nsi, ubw);
                        funs = 0; /* unsigned 标记不得泄漏过无名位域 */
                    }
                    若 (tt[tk] == VR) {
                        字 fn[32]; strcpy(fn, tn[tk]); tk++;
                        整 bitw = 0;
                        若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) { bitw = tv[tk]; tk++; } } /* : N bit-field (fix 2026-08-05: was unhandled → parse loop stuck on ':' forever) */
                        若 (bitw > 0) {
                            st_field_bit(nsi, fn, fsz, fsz, bitw, funs); /* bit-field: packed into shared int slots */
                            若 (fdbl) st_field_dbl(nsi, fn);
                            funs = 0;
                        } 否 {
                        循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { 若 (dims == 0) first = tv[tk]; dims++; fsz *= tv[tk]; tk++; } 若 (tt[tk] == RB) tk++; }
                        若 (dims >= 1) frow = fsz / first;
                        否 frow = fsz;
                        st_field_sz_r(nsi, fn, fsz, frow);
                        若 (fdbl) st_field_dbl(nsi, fn);
                        }
                    }
                    若 (tt[tk] == CK) tk++;
                    若 (tt[tk] == SK) tk++;
                }
                若 (tt[tk] == UK) tk++;
                si = nsi; /* struct P {…} p; — the variable(s) after the } use the just-defined type */
                若 (tt[tk] == SK) { tk++; 续; } /* type-only declaration: struct P {...}; */
                /* variable declaration after the local type: struct P {…} p; / *p / p[3]; */
                { 整 is_ptr = 0;
                若 (tt[tk] == DK) { is_ptr = 1; tk++; } /* * */
                若 (tt[tk] == VR) {
                    字 vn[32]; strcpy(vn, tn[tk]); tk++;
                    整 d = Nd(7);
                    整 scnt = 1;
                    若 (tt[tk] == LB) { /* struct array: struct P arr[3]; */
                        scnt = 1;
                        循环 (tt[tk] == LB) {
                            tk++; 若 (tt[tk] == NK) { scnt *= tv[tk]; tk++; }
                            若 (tt[tk] == RB) tk++;
                        }
                    }
                    若 (is_static) {
                        若 (is_ptr) { var_static(vn, 4); vars[vcnt - 1].st_idx = si; }
                        否 var_static_struct(vn, si, scnt);
                    } 否 {
                        若 (is_ptr) { var_offset_ptr(vn, 4); vars[vcnt - 1].st_idx = si; }
                        否 若 (scnt > 1) { var_array(vn, scnt, stypes[si].sz); vars[vcnt - 1].st_idx = si; } /* struct array: 8B elements */
                        否 var_struct(vn, si);
                    }
                    memcpy((字*)(nn + d), vn, 32);
                    若 (tt[tk] == AK) {
                        tk++;
                        若 (tt[tk] == FK && si >= 0 && !is_ptr) { /* struct P p = { a, b, c }; — brace init */
                            tk++;
                            整 idn = Nd(1); memcpy((字*)(nn + idn), vn, 32);
                            整 bi = brace_fields(si, idn);
                            Nc(b, d); b_cnt++; /* declare first */
                            整 bt = Nd(5); Nc(bt, bi);
                            Nc(b, bt); b_cnt++;
                            若 (tt[tk] == UK) tk++;
                            循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                            若 (tt[tk] == SK) tk++;
                            续; /* handled; skip the normal decl attach + comma loop */
                        } 否 {
                            Nc(d, expr());
                        }
                    }
                    Nc(b, d); b_cnt++;
                    循环 (tt[tk] == CK) { /* struct P {…} a, c, d; — comma-separated */
                        tk++;
                        整 is_ptr2 = 0;
                        若 (tt[tk] == DK) { is_ptr2 = 1; tk++; }
                        若 (tt[tk] == VR) {
                            字 vn2[32]; strcpy(vn2, tn[tk]); tk++;
                            整 d2 = Nd(7);
                            若 (is_static) {
                                若 (is_ptr2) { var_static(vn2, 4); vars[vcnt - 1].st_idx = si; }
                                否 var_static_struct(vn2, si, 1);
                            } 否 {
                                若 (is_ptr2) { var_offset_ptr(vn2, 4); vars[vcnt - 1].st_idx = si; }
                                否 var_struct(vn2, si);
                            }
                            memcpy((字*)(nn + d2), vn2, 32);
                            若 (tt[tk] == AK) { tk++; Nc(d2, expr()); }
                            Nc(b, d2); b_cnt++;
                        }
                    }
                }
                循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                若 (tt[tk] == SK) tk++;
                续;
                }
            } 否 { 整 is_ptr = 0;
            若 (tt[tk] == DK) { is_ptr = 1; tk++; } /* * */
            若 (tt[tk] == VR) {
                字 vn[32]; strcpy(vn, tn[tk]); tk++;
                整 d = Nd(7);
                整 scnt = 1;
                若 (tt[tk] == LB) { /* struct array: struct P arr[3]; */
                    scnt = 1;
                    循环 (tt[tk] == LB) {
                        tk++; 若 (tt[tk] == NK) { scnt *= tv[tk]; tk++; }
                        若 (tt[tk] == RB) tk++;
                    }
                }
                若 (is_static) {
                    若 (is_ptr) { var_static(vn, 4); vars[vcnt - 1].st_idx = si; }
                    否 var_static_struct(vn, si, scnt);
                } 否 {
                    若 (is_ptr) { var_offset_ptr(vn, 4); vars[vcnt - 1].st_idx = si; }
                    否 若 (scnt > 1) { var_array(vn, scnt, stypes[si].sz); vars[vcnt - 1].st_idx = si; } /* struct array: 8B elements */
                    否 var_struct(vn, si);
                }
                memcpy((字*)(nn + d), vn, 32);
                若 (tt[tk] == AK) {
                    tk++;
                    若 (tt[tk] == FK && si >= 0 && !is_ptr) { /* struct P p = { a, b, c }; — brace init */
                        tk++;
                        整 idn = Nd(1); memcpy((字*)(nn + idn), vn, 32);
                        整 bi = brace_fields(si, idn);
                        Nc(b, d); b_cnt++; /* declare first */
                        整 bt = Nd(5); Nc(bt, bi);
                        Nc(b, bt); b_cnt++;
                        若 (tt[tk] == UK) tk++;
                        循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                        若 (tt[tk] == SK) tk++;
                        续; /* handled; skip the normal decl attach + comma loop */
                    } 否 {
                        Nc(d, expr());
                    }
                }
                Nc(b, d); b_cnt++;
                循环 (tt[tk] == CK) { /* struct A a, c, d; — comma-separated */
                    tk++;
                    整 is_ptr2 = 0;
                    若 (tt[tk] == DK) { is_ptr2 = 1; tk++; }
                    若 (tt[tk] == VR) {
                        字 vn2[32]; strcpy(vn2, tn[tk]); tk++;
                        整 d2 = Nd(7);
                        若 (is_static) {
                            若 (is_ptr2) { var_static(vn2, 4); vars[vcnt - 1].st_idx = si; }
                            否 var_static_struct(vn2, si, 1);
                        } 否 {
                            若 (is_ptr2) { var_offset_ptr(vn2, 4); vars[vcnt - 1].st_idx = si; }
                            否 var_struct(vn2, si);
                        }
                        memcpy((字*)(nn + d2), vn2, 32);
                        若 (tt[tk] == AK) { tk++; Nc(d2, expr()); }
                        Nc(b, d2); b_cnt++;
                    }
                }
            }
            } /* end else: normal struct var decl (or fall-through after local struct type def) */
            循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
            若 (tt[tk] == SK) tk++;
            续;
        }
        /* unknown typedef'd type from a skipped #include (size_t/time_t/...): treat as int (C 原版 2289) */
        整 unknown_ty_decl = 0;
        若 (tt[tk] == VR && !strcmp(tn[tk], "register")) tk++; /* 存储类 register: 忽略——局部变量本就放内存 (fix 2026-08-05: 曾是未定义标识符 → 变量没注册 → 读 0) */
        若 (tt[tk] == VR && !td_is(tn[tk]) && st_find(tn[tk]) < 0 && tt[tk + 1] == VR &&
            (tt[tk + 2] == AK || tt[tk + 2] == SK || tt[tk + 2] == LB || tt[tk + 2] == DK)) {
            unknown_ty_decl = 1;
        }
        若 (tt[tk] == VK || tt[tk] == EN || (tt[tk] == VR && td_is(tn[tk])) || unknown_ty_decl) { /* int/char/enum/typedef type (C 原版 2184) */
            整 was_enum = (tt[tk] == EN);
            整 ltd_si = -1; /* typedef'd struct 索引（C 原版 2187） */
            若 (tt[tk] == VR && td_is(tn[tk])) { ltd_si = td_st_index(tn[tk]); }
            整 tdi2v = tdef_lookup(tn[tk]); 整 tdi_fnptr_v = (tdi2v >= 0 && tdefs[tdi2v].is_fnptr); 整 tdi_fdbl_v = (tdi2v >= 0 && tdefs[tdi2v].fnptr_dbl); /* fnptr typedef 变量/数组: ops_t ops[2] / ops_t f（fix 2026-08-05: 原注册成 int → 4 字节元素，fnptr 调用取错地址；p_dbl=0 破坏 case-10 赋值的 double 返回调用） */
            整 is_char = (tt[tk] == VK && !strcmp(tn[tk], "char"));
            整 is_double = (tt[tk] == VK && !strcmp(tn[tk], "double"));
            整 is_uns = (tt[tk] == VK && !strcmp(tn[tk], "unsigned"));
            整 is_static = (tt[tk] == VK && !strcmp(tn[tk], "static"));
            整 is_ll = (tt[tk] == VK && !strcmp(tn[tk], "long") && tt[tk + 1] == VK && !strcmp(tn[tk + 1], "long"))
                     || (tt[tk] == VK && !strcmp(tn[tk], "unsigned") && tt[tk + 1] == VK && !strcmp(tn[tk + 1], "long") && tt[tk + 2] == VK && !strcmp(tn[tk + 2], "long")); /* long long / unsigned long long → 8 字节整（fix 2026-08-06: unsigned 前缀组合） */
            tk++; 若 (was_enum && tt[tk] == VR) tk++; /* skip enum type name */
            若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "char")) is_char = 1; 若 (!strcmp(tn[tk], "double")) is_double = 1; 若 (!strcmp(tn[tk], "unsigned")) is_uns = 1; tk++; } /* skip 2nd keyword */
            若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++; /* skip 3rd keyword of unsigned long long（fix 2026-08-06） */
            整 is_ptr = (tt[tk] == DK);
            若 (is_ptr) tk++; /* skip * for pointers */
            整 d = Nd(7);
            整 acnt = 0, adims = 0, adimv[8]; /* array elems/dims/sizes, seen by ={...} below (adimv fix 2026-08-05: multi-dim brace init) */
            遍 (整 i = 0; i < 8; i++) adimv[i] = 0;
            若 (tt[tk] == OK && tt[tk + 1] == DK) { /* function pointer: int (*fp)(args); */
                tk++; tk++; /* skip ( * */
                若 (tt[tk] == VR) {
                    字 vn[32]; strcpy(vn, tn[tk]); tk++;
                    若 (tt[tk] == LB) { /* fnptr ARRAY: int (*tbl[4])(int) — 8-byte elements */
                        整 cnt = 1;
                        循环 (tt[tk] == LB) {
                            tk++; 若 (tt[tk] == NK) { cnt *= tv[tk]; tk++; }
                            若 (tt[tk] == RB) tk++;
                        }
                        var_array(vn, cnt, 8);
                        若 (is_double) vars[vcnt - 1].p_dbl = 1; /* double-returning fnptr array: tbl[i](x) yields xmm0 */
                    } 否 {
                        var_offset_ptr(vn, is_char ? 1 : 4);
                        vars[vcnt - 1].arr_esz = 8; /* fnptr: deref *fp loads 8 bytes */
                        若 (is_double) vars[vcnt - 1].p_dbl = 1; /* double-returning fnptr: fp(x) yields xmm0 */
                    }
                    memcpy((字*)(nn + d), vn, 32);
                }
                若 (tt[tk] == KK) tk++; /* skip ) closing (*fp) */
                若 (tt[tk] == OK) { /* skip the arg-type list ( ... ) */
                    整 depth = 0;
                    循环 (tk < TS && tt[tk] != EK) {
                        若 (tt[tk] == OK) depth++;
                        否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                        tk++;
                    }
                }
                若 (tt[tk] == AK) { tk++; Nc(d, expr()); } /* init: int (*g)(int) = fp; */
                循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                若 (tt[tk] == SK) tk++;
                Nc(b, d); b_cnt++;
                续;
            }
            若 (tt[tk] == VR) { 字 vn[32]; strcpy(vn, tn[tk]); tk++;
            若 (tt[tk] == LB) { /* array (static char names[3][16] too) */
                整 esz = tdi_fnptr_v ? 8 : (is_ptr ? 8 : (is_char ? 1 : (is_double ? 8 : (is_ll ? 8 : 4)))); /* fnptr typedef 数组：8 字节指针元素；long long 数组：8 字节（fix 2026-08-06: 原 4 字节 → 元素重叠错位） */
                若 (ltd_si >= 0) { esz = stypes[ltd_si].sz; } /* typedef'd struct 数组元素大小（C 原版 2244） */
                整 cnt = 1; 整 first = 1; 整 dims = 0;
                循环 (tt[tk] == LB) {
                    tk++; 若 (tt[tk] == NK) { 若 (dims == 0) first = tv[tk]; 若 (dims < 8) adimv[dims] = tv[tk]; dims++; cnt *= tv[tk]; tk++; }
                    若 (tt[tk] == RB) tk++;
                }
                /* fix 2026-08-05: unsized array `整 a[] = {1,2,3}` / `字 *names[] = {...}`
                   → infer element count from the brace init list */
                若 (dims == 0 && tt[tk] == AK && tt[tk + 1] == FK) {
                    整 save = tk;
                    tk += 2; /* skip '=' '{' */
                    整 n = 1;
                    整 depth = 0;
                    循环 (tk < TS && !(tt[tk] == UK && depth == 0)) {
                        若 (tt[tk] == FK || tt[tk] == OK || tt[tk] == LB) depth++;
                        否 若 (tt[tk] == UK || tt[tk] == KK || tt[tk] == RB) depth--;
                        否 若 (tt[tk] == CK && depth == 0) n++;
                        tk++;
                    }
                    cnt = n;
                    tk = save; /* rewind to '=' — normal init path below */
                }
                acnt = cnt; adims = dims; /* expose to ={...} init */
                若 (is_static) {
                    var_static_arr(vn, 0, esz, cnt); /* esz = ELEMENT byte size (slots = cnt*esz/4) */
                    vars[vcnt - 1].p_esz = esz; /* element byte size for 2D outer scale (cg_mem_frow) */
                    若 (is_ll) vars[vcnt - 1].is_ll = 1; /* static long long 数组（fix 2026-08-06） */
                    若 (tdi_fdbl_v) vars[vcnt - 1].p_dbl = 1; /* double 返回 fnptr 数组（fix 2026-08-05） */
                    若 (dims > 1 && first > 0) vars[vcnt - 1].arr_esz = (cnt / first) * esz; /* row byte size for 2D+ */
                    若 (dims >= 1) { vars[vcnt - 1].frows[dims - 1] = esz; 遍 (整 fi = dims - 2; fi >= 0; fi--) vars[vcnt - 1].frows[fi] = vars[vcnt - 1].frows[fi + 1] * adimv[fi + 1]; } /* 3D per-dim rows (fix 2026-08-05) */
                    若 (is_double) vars[vcnt - 1].is_dbl = 1; /* static double array */
                    若 (is_uns) vars[vcnt - 1].is_uns = 1; /* unsigned 数组 (fix 2026-08-05) */
                    若 (ltd_si >= 0) vars[vcnt - 1].st_idx = ltd_si; /* typedef'd struct 数组（C 原版 2250） */
                } 否 {
                    var_array(vn, cnt, esz);
                    若 (is_ll) vars[vcnt - 1].is_ll = 1; /* long long 数组: 8 字节元素（fix 2026-08-06） */
                    若 (tdi_fdbl_v) vars[vcnt - 1].p_dbl = 1; /* double 返回 fnptr 数组（fix 2026-08-05） */
                    若 (ltd_si >= 0) vars[vcnt - 1].st_idx = ltd_si; /* typedef'd struct 数组（C 原版 2253） */
                    若 (dims > 1 && first > 0) {
                        /* local 2D+ array: arr_esz = ROW byte size (m[i] scales by it),
                           p_esz = scalar element size (m[i][j] outer scale). */
                        vars[vcnt - 1].arr_esz = (cnt / first) * esz;
                        vars[vcnt - 1].p_esz = esz;
                    }
                    若 (dims >= 1) { vars[vcnt - 1].frows[dims - 1] = esz; 遍 (整 fi = dims - 2; fi >= 0; fi--) vars[vcnt - 1].frows[fi] = vars[vcnt - 1].frows[fi + 1] * adimv[fi + 1]; } /* 3D per-dim rows (fix 2026-08-05) */
                    若 (is_double) vars[vcnt - 1].is_dbl = 1; /* local double array */
                    若 (is_uns) vars[vcnt - 1].is_uns = 1; /* unsigned 数组 (fix 2026-08-05) */
                }
            } 否 若 (is_static) {
                若 (is_double) { var_static(vn, 4); vars[vcnt - 1].is_dbl = 1; } /* static double: 8-byte .data slot */
                否 { var_static(vn, is_ptr ? (is_char ? 1 : 4) : 0); 若 (is_char) vars[vcnt - 1].is_char = 1; 若 (is_uns) vars[vcnt - 1].is_uns = 1; } }
            否 若 (is_ptr) {
                若 (is_double) { var_offset_ptr(vn, 8); vars[vcnt - 1].p_dbl = 1; } /* double*: 8-byte element + p_dbl */
                否 var_offset_ptr(vn, is_char ? 1 : 4);
                若 (ltd_si >= 0) vars[vcnt - 1].st_idx = ltd_si; } /* typedef'd struct 指针（C 原版 2268） */
            否 若 (ltd_si >= 0) { var_struct(vn, ltd_si); } /* typedef'd struct 变量（C 原版 2269） */
            否 若 (tdi_fnptr_v) { var_offset_ptr(vn, 4); vars[vcnt - 1].arr_esz = 8; 若 (tdi_fdbl_v) vars[vcnt - 1].p_dbl = 1; } /* typedef'd fnptr 变量：8 字节槽（fix 2026-08-05） */
            否 若 (is_ll) { var_ll(vn); 若 (is_uns) vars[vcnt - 1].is_uns = 1; } /* long long / unsigned long long: 8 字节整（fix 2026-08-06: ULL 同时标 is_uns） */
            否 若 (is_double) { var_double(vn); }
            否 { var_offset(vn); 若 (is_char) vars[vcnt - 1].is_char = 1; 若 (is_uns) vars[vcnt - 1].is_uns = 1; } /* sizeof(char 变量) 需要类型标记 (fix 2026-08-05) */
            memcpy((字*)(nn + d), vn, 32);
        } 若 (tt[tk] == AK) {
            tk++;
            若 (tt[tk] == FK && acnt > 0 && !is_static) {
                /* local ARRAY brace init: int data[5]={1,2,3,4,5}; / int m[2][3]={{...}}; (multi-dim fix 2026-08-05: was adims<=1 → 2D got no init) */
                Nc(b, d); b_cnt++; /* declare first */
                遍 (整 i = 0; i < 8; i++) gi_idx[i] = 0;
                str_row = 0; /* 字符串初始化行计数器（fix 2026-08-05） */
                brace_arr_init(b, d, adimv, adims > 0 ? adims : 1, 0); /* 自管 { } */
                循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                若 (tt[tk] == SK) tk++;
                续;
            } 否 若 (is_static && ginit_n < 4096) {
                /* function-local static with initializer: run ONCE at main entry
                   (C semantics), not on every call. Record in ginit; case-7 skips it. */
                整 decl = Nd(7); memcpy((字*)(nn + decl), (字*)(nn + d), 32);
                Nc(decl, expr());
                ginit[ginit_n++] = decl;
                vars[vcnt - 1].pdisp = ginit_n - 1; /* mark: handled by ginit */
            } 否 {
                Nc(d, expr());
            }
        } Nc(b, d); b_cnt++;
            循环 (tt[tk] == CK) { /* comma-separated: int a = 0, b = 0; */
                tk++;
                整 is_ptr2 = (tt[tk] == DK); 若 (is_ptr2) tk++;
                整 d2 = Nd(7);
                若 (tt[tk] == VR) {
                    字 vn2[32]; strcpy(vn2, tn[tk]); tk++;
                    若 (tt[tk] == LB) { /* 逗号列表里的数组：int a, b[3]; (fix 2026-08-05: 原 var_offset → adimv[8] 注册成 int, &adimv[0] NULL) */
                        整 cnt2 = 1;
                        循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { cnt2 *= tv[tk]; tk++; } 若 (tt[tk] == RB) tk++; }
                        整 esz2 = is_char ? 1 : (is_double ? 8 : (is_ptr ? 8 : 4));
                        若 (is_ptr2) var_offset_ptr(vn2, 4); 否 var_array(vn2, cnt2, esz2);
                        vars[vcnt - 1].p_esz = esz2;
                        若 (is_double) vars[vcnt - 1].is_dbl = 1;
                    } 否 {
                        若 (tt[tk] == AK) { tk++; Nc(d2, expr()); }
                        若 (is_ptr2) var_offset_ptr(vn2, is_char ? 1 : 4); 否 var_offset(vn2);
                    }
                    memcpy((字*)(nn + d2), vn2, 32);
                    Nc(b, d2); b_cnt++;
                }
            }
            tk++; }
        否 若 (tt[tk] == ST) { /* struct Name var; */
            tk++; /* skip struct */
            若 (tt[tk] == VR) {
                整 si = st_find(tn[tk]); tk++; /* struct type name */
                若 (si >= 0 && tt[tk] == VR) {
                    整 d = Nd(7); /* reuse decl node */
                    var_struct(tn[tk], si);
                    memcpy((字*)(nn + d), tn[tk], 32); tk++;
                    若 (tt[tk] == SK) tk++; /* skip ; */
                    Nc(b, d); b_cnt++;
                    续;
                }
            }
            /* skip to next ; if parse fails */
            循环 (tk < TS && tt[tk] != SK && tt[tk] != UK) tk++;
            若 (tt[tk] == SK) tk++;
        }
        否 若 (tt[tk] == VR && (td_is(tn[tk]) || st_find(tn[tk]) >= 0)) { /* typedef or struct type */
            整 tdi_dbl = 0; 整 tdi2 = tdef_lookup(tn[tk]); 若 (tdi2 >= 0 && tdefs[tdi2].is_dbl) tdi_dbl = 1;
            整 tdi_fnptr = (tdi2 >= 0 && tdefs[tdi2].is_fnptr); /* typedef'd fnptr：8 字节元素（C 原版 2327 移植） */
            tk++; /* skip type name */
            整 tsi = st_find(tn[tk-1]); 若 (tsi < 0) tsi = td_st_index(tn[tk-1]);
            整 is_struct = (tsi >= 0);
            整 is_ptr = 0;
            若 (tt[tk] == DK) { is_ptr = 1; tk++; } /* pointer */
            整 d = Nd(7);
            若 (tt[tk] == VR) {
                字 vn2[32]; strcpy(vn2, tn[tk]);
                若 (tt[tk+1] == LB) { /* typedef 数组：P arr[3]; */
                    整 scnt = 1; tk++; /* consume VR */
                    循环 (tt[tk] == LB) {
                        tk++; 若 (tt[tk] == NK) { scnt *= tv[tk]; tk++; }
                        若 (tt[tk] == RB) tk++;
                    }
                    若 (tdi_fnptr && !is_ptr) { var_array(vn2, scnt, 8); 若 (tdi2 >= 0 && tdefs[tdi2].fnptr_dbl) vars[vcnt - 1].p_dbl = 1; }
                    否 若 (is_struct && !is_ptr && scnt > 1) { var_array(vn2, scnt, stypes[tsi].sz); vars[vcnt - 1].st_idx = tsi; }
                    否 若 (is_struct && !is_ptr) { var_struct(vn2, tsi); }
                    否 若 (tdi_dbl && !is_ptr) { var_double(vn2); }
                    否 { var_offset(vn2); }
                } 否 {
                    若 (tdi_fnptr && !is_ptr) { var_offset_ptr(vn2, 4); vars[vcnt - 1].arr_esz = 8; 若 (tdi2 >= 0 && tdefs[tdi2].fnptr_dbl) vars[vcnt - 1].p_dbl = 1; }
                    否 若 (is_struct && !is_ptr) { var_struct(tn[tk], tsi); }
                    否 若 (tdi_dbl && !is_ptr) { var_double(tn[tk]); } /* typedef double alias: 8-byte slot */
                    否 { var_offset(tn[tk]); }
                }
                memcpy((字*)(nn + d), tn[tk], 32); tk++;
            }
            若 (tt[tk] == AK) {
                tk++;
                若 (tt[tk] == FK && is_struct && !is_ptr) { /* typedef struct P p = { a, b }; — brace init */
                    tk++;
                    整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32);
                    整 bi = brace_fields(tsi, idn);
                    Nc(b, d); b_cnt++;
                    整 bt = Nd(5); Nc(bt, bi);
                    Nc(b, bt); b_cnt++;
                    若 (tt[tk] == UK) tk++;
                    循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                    若 (tt[tk] == SK) tk++;
                    续;
                } 否 {
                    Nc(d, expr());
                }
            }
            若 (tt[tk] == SK) tk++;
            Nc(b, d);
        }
        否 { Nc(b, stmt()); b_cnt++; }
    }
    tk++; /* NOTE: vcnt NOT restored ??C has function scope, not block scope */
    返 b_root;
}

静 整 stmt(空) {
    若 (tt[tk] == GT) { /* goto label; */
        tk++;
        整 n = Nd(25);
        若 (tt[tk] == VR) { memcpy((字*)(nn + n), tn[tk], 32); tk++; }
        若 (tt[tk] == SK) tk++;
        返 n;
    }
    若 (tt[tk] == VR && tt[tk + 1] == CL) { /* label: */
        字 ln[32]; strcpy(ln, tn[tk]); tk += 2; /* name : */
        整 li = lbl_reg(ln);
        整 n = Nd(20); nv[n] = li + 1; /* SET_LABEL(li) */
        返 n;
    }
    若 (tt[tk] == RK) { tk++; 整 r = Nd(6); Nc(r, expr()); tk++; 返 r; }
    若 (tt[tk] == IK) { tk++; tk++; 整 n = Nd(8); Nc(n, expr()); tk++; Nc(n, stmt()); 若 (tt[tk] == ZK) { tk++; Nc(n, stmt()); } 返 n; }
    若 (tt[tk] == WK) { tk++; tk++; 整 n = Nd(9); Nc(n, expr()); tk++; Nc(n, stmt()); 返 n; }
    若 (tt[tk] == DW) { /* do stmt while (cond); */
        tk++; /* do */
        整 body = stmt();
        若 (tt[tk] == WK) { tk++; tk++; } /* while ( */
        整 cond = expr();
        若 (tt[tk] == KK) tk++; /* ) */
        若 (tt[tk] == SK) tk++; /* ; */
        整 n = Nd(24); Nc(n, body); Nc(n, cond);
        返 n;
    }
    若 (tt[tk] == JK) { /* for(init;cond;step)body �?{init; while(cond){body;step;}} */
        tk++; tk++; /* skip for and ( */
        整 blk_node = Nd(5);
        若 (tt[tk] != SK) {
            若 (tt[tk] == VK || tt[tk] == ST || (tt[tk] == VR && td_is(tn[tk]))) {
                /* for(int i = 0; ...) �?declaration as init */
                若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) tk++; }
                整 is_char = 0, is_ptr = 0;
                循环 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "char")) is_char = 1; tk++; }
                若 (tt[tk] == DK) { is_ptr = 1; tk++; }
                整 d = Nd(7);
                若 (tt[tk] == VR) {
                    字 vn[32]; strcpy(vn, tn[tk]); tk++;
                    若 (is_ptr) var_offset_ptr(vn, is_char ? 1 : 4); 否 var_offset(vn);
                    memcpy((字*)(nn + d), vn, 32);
                    若 (tt[tk] == AK) { tk++; Nc(d, expr()); }
                }
                Nc(blk_node, d);
            } 否 {
                Nc(blk_node, expr()); /* init */
            }
        } /* init */
        tk++; /* skip ; */
        整 wh = Nd(9); /* while node */
        若 (tt[tk] != SK) { Nc(wh, expr()); } 否 { 整 t = Nd(0); nv[t]=1; Nc(wh, t); } /* cond */
        tk++; /* skip ; */
        整 step = -1;
        若 (tt[tk] != KK) { step = expr(); } /* step */
        tk++; /* skip ) */
        整 body = stmt();
        若 (step >= 0) { /* append step: wrap body in block; set continue target = step start */
            整 cl = new_label();
            整 setl = Nd(20); nv[setl] = cl + 1; /* SET_LABEL(cl): label set at step start */
            整 wrap = Nd(5); Nc(wrap, body); Nc(wrap, setl); Nc(wrap, step); body = wrap;
            nv[wh] = cl + 1; /* while continue target override �?step */
        }
        Nc(wh, body); /* while(cond) {body;step;} */
        Nc(blk_node, wh); /* { init; while... } */
        返 blk_node;
    }
    若 (tt[tk] == SW) { /* switch(expr){case C:...default:...} �?if-else */
        tk++; tk++; /* skip switch ( */
        整 sw_expr = expr(); tk++; /* skip ) */
        若 (tt[tk] != FK) { 循环(tk<TS&&tt[tk]!=FK&&tt[tk]!=EK)tk++; } /* safety */
        tk++; /* skip { */
        var_offset("_sw");
        整 decl=Nd(7); memcpy((字*)(nn+decl),"_sw",4); Nc(decl,sw_expr);
        整 sw_var=Nd(1); memcpy((字*)(nn+sw_var),"_sw",4);
        整 chain=-1,prev=-1;
        循环(tt[tk]!=UK&&tt[tk]!=EK){
            若(tt[tk]==CA){ /* case CONST: */
                tk++; 整 cv=0;
                若(tt[tk]==NK){cv=tv[tk];tk++;}
                否 若(tt[tk]==VR){ 整 evc = e_lookup(tn[tk]); 若 (evc >= 0) { cv = evc; tk++; } } /* enum constant label: case STR: */
                若(tt[tk]==CL)tk++; /* : */
                整 body=Nd(5); /* case body */
                循环(tt[tk]!=BR&&tt[tk]!=CA&&tt[tk]!=DF&&tt[tk]!=UK&&tt[tk]!=EK){
                    若(tt[tk]==SK){tk++;续;}
                    若(tt[tk]==BR){tk++;若(tt[tk]==SK)tk++;断;} /* consume break before stmt() */
                    Nc(body,stmt());
                }
                若(tt[tk]==BR){tk++;若(tt[tk]==SK)tk++;} /* already consumed */
                整 cvn=Nd(0);nv[cvn]=cv;
                整 eq=Nd(2);nv[eq]=T_QK;Nc(eq,sw_var);Nc(eq,cvn);
                整 ifn=Nd(8);Nc(ifn,eq);Nc(ifn,body);
                若(prev>=0){n2[prev]=ifn;prev=ifn;}否{chain=ifn;prev=ifn;}
            }否 若(tt[tk]==DF){ /* default: */
                tk++;若(tt[tk]==CK)tk++;
                整 body=Nd(5);
                循环(tt[tk]!=BR&&tt[tk]!=UK&&tt[tk]!=EK){
                    若(tt[tk]==SK){tk++;续;}
                    Nc(body,stmt());
                }
                若(tt[tk]==BR){tk++;若(tt[tk]==SK)tk++;}
                整 t=Nd(0);nv[t]=1;
                整 ifn=Nd(8);Nc(ifn,t);Nc(ifn,body);
                若(prev>=0){
                    n2[prev] = ifn; /* else branch */
                    prev=ifn;
                }否{chain=ifn;prev=ifn;}
            }否{tk++;}
        }
        若(tt[tk]==UK)tk++;
        /* Wrap the whole switch in a synthetic while(1): a `break` nested in an
           if/loop inside a switch case compiles to case 16, which jumps to the
           GLOBAL brk_label -- but only loops (case 9/11) set brk_label, so a
           switch (lowered to if-else) leaves it STALE and the break resolves to
           a label from an unrelated function (e.g. macro_find's loop label ->
           jumps into its strcmp -> SIGSEGV). The wrapper makes brk_label point
           at the switch's end; the trailing break exits the wrapper. */
        整 sw_wh = Nd(9); { 整 t = Nd(0); nv[t] = 1; Nc(sw_wh, t); }
        整 sw_bd = Nd(5); Nc(sw_bd, decl); 若 (chain >= 0) Nc(sw_bd, chain);
        Nc(sw_bd, Nd(16)); /* break; -- leave the wrapper after the chain */
        Nc(sw_wh, sw_bd);
        返 sw_wh;
    }
    若 (tt[tk] == FK) 返 blk();
    若 (tt[tk] == BR) { tk++; 整 r = Nd(16); tk++; 返 r; } /* break; */
    若 (tt[tk] == CN) { tk++; 整 r = Nd(21); tk++; 返 r; } /* continue; */
    整 e = expr(); tk++; 返 e;
}

静 整 parse(常 字 *s) {
    tk = 0; nc = 1; vcnt = 0; rsp_used = 32; /* reserve shadow space */
    memset(ndbl, 0, ASZ * 4); /* per-node double flags must not leak across compiles */
    memset(nuns, 0, ASZ * 4); /* per-node unsigned flags (fix 2026-08-05) */
    fvn = 0; /* reset per-function var-range table */
    memset(tt, 0, TS * 4);
    字 *exp_src = pp_include_expand(s, 0); /* #include 预展开（fix 2026-08-06） */
    lex(exp_src);
    free(exp_src);
    若 (ti >= TS) { fprintf(stderr, "[ERR] token overflow\n"); 返 -1; }
    整 p = Nd(3); 若 (p < 0) 返 -1;
    
    循环 (tk < TS && tt[tk] != EK) {
        /* struct definition: struct Name { fields; }; or struct { fields; } var; */
        若 (tt[tk] == ST) {
            整 st_save = tk;
            整 is_union = !strcmp(tn[tk], "union");
            tk++; /* skip struct */
            若 (tt[tk] == VR) { /* tagged: keep the tag as the struct name */
                整 si = st_add(tn[tk]); tk++; /* struct name */
                若 (tt[tk] == FK) { /* { */
                    tk++;
                    整 funs = 0; /* unsigned 位域标记（fix 2026-08-05） */
                    循环 (tk < TS && tt[tk] != UK) {
                        整 fsz = 4; 整 frow = 1; 整 dims = 0; 整 first = 1; 整 fdbl = 0; 整 fll = 0; /* fll: long long 字段 (fix 2026-08-06) */
                        若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char")) { fsz = 1; } 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; fdbl = 1; } 否 若 (!strcmp(tn[tk], "long")) { 若 (tt[tk+1] == VK && !strcmp(tn[tk+1], "long")) { fsz = 8; frow = 8; fll = 1; } } 否 若 (!strcmp(tn[tk], "short")) { fsz = 2; frow = 2; } tk++; 若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++; /* 消费 long long 的第二个 long (fix 2026-08-06) */ }
                        否 若 (tt[tk] == ST) { /* nested struct field: struct Inner in; (or struct Node *next — self ref) */
                            tk++; /* struct */
                            若 (tt[tk] == VR) {
                                字 iname[32]; strcpy(iname, tn[tk]); tk++; /* Inner */
                                整 inner_si = st_find(iname);
                                若 (tt[tk] == FK) { /* 内联定义体: struct B { int y; } — 解析并注册 (fix 2026-08-05: was unhandled `{` → infinite loop) */
                                    整 ni = inner_si < 0 ? st_add(iname) : inner_si;
                                    tk++; /* { */
                                    整 ifuns = 0; /* unsigned 位域标记（fix 2026-08-05） */
                                    循环 (tk < TS && tt[tk] != UK) {
                                        整 ifsz = 4, ifrow = 1, ifdims = 0, ifirst = 1;
                                        若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) ifuns = 1; 若 (!strcmp(tn[tk], "char")) ifsz = 1; 否 若 (!strcmp(tn[tk], "double")) ifsz = 8; tk++; }
                                        否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == DK) tk++; }
                                        若 (tt[tk] == CL) { /* 无名位域（fix 2026-08-05） */
                                            tk++; 整 ubw = 0;
                                            若 (tt[tk] == NK) { ubw = tv[tk]; tk++; }
                                            st_field_bit_anon(ni, ubw);
                                            ifuns = 0;
                                        }
                                        若 (tt[tk] == VR) {
                                            字 fn[32]; strcpy(fn, tn[tk]); tk++;
                                            整 ibw = 0;
                                            若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) { ibw = tv[tk]; tk++; } } /* : N bit-field (fix 2026-08-05: inline nested struct loop) */
                                            若 (ibw > 0) { st_field_bit(ni, fn, ifsz, ifsz, ibw, ifuns); ifuns = 0; }
                                            否{
                                            循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { 若 (ifdims == 0) ifirst = tv[tk]; ifdims++; ifsz *= tv[tk]; tk++; } 若 (tt[tk] == RB) tk++; }
                                            若 (ifdims >= 1) ifrow = ifsz / ifirst; 否 ifrow = ifsz;
                                            st_field_sz_r(ni, fn, ifsz, ifrow);
                                            }
                                        }
                                        若 (tt[tk] == CK) tk++;
                                        若 (tt[tk] == SK) tk++;
                                    }
                                    若 (tt[tk] == UK) tk++; /* } */
                                    inner_si = ni;
                                }
                                整 fptr = 0;
                                若 (tt[tk] == DK) { fptr = 1; tk++; } /* struct Node *next: * sits BEFORE the name */
                                若 (inner_si >= 0 && tt[tk] == VR) {
                                    字 fn[32]; strcpy(fn, tn[tk]); tk++;
                                    若 (is_union) st_union_field(si, fn, fptr ? 8 : stypes[inner_si].sz);
                                    否 { st_field_sz_r(si, fn, fptr ? 8 : stypes[inner_si].sz, 1); st_field_ty(si, fn, inner_si); } /* ftype = pointed-to struct even for pointers (n1.next->val) */
                                }
                            }
                            若 (tt[tk] == SK) tk++;
                            续;
                        }
                        否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; } /* enum field: `枚 Color c;` → int (fix 2026-08-05) */
                        否 若 (tt[tk] == VR && (td_is(tn[tk]) || st_find(tn[tk]) >= 0)) tk++; /* typedef type */
                        若 (tt[tk] == CL) { /* 无名位域（fix 2026-08-05） */
                            tk++; 整 ubw = 0;
                            若 (tt[tk] == NK) { ubw = tv[tk]; tk++; }
                            st_field_bit_anon(si, ubw);
                            funs = 0; /* unsigned 标记不得泄漏过无名位域 */
                        }
                        若 (tt[tk] == VR) {
                            字 fn[32]; strcpy(fn, tn[tk]); tk++;
