                若 (!fn_first_param[0]) { fprintf(stderr, "[ERR] 多子句函数 '%s' 需要至少一个参数 (匹配对象为第一个参数, v3.0 #222)\n", (字*)(nn + fdef)); exit(1); }
                静 整 mcf_seq = 0; 字 srname[64]; sprintf(srname, "__mcf_%d_", mcf_seq++);
                静 整 mcf_seq2 = 0; 字 mmname[64]; sprintf(mmname, "__mmm_%d_", mcf_seq2++);
                var_offset(srname); uninit_remove(srname); var_offset(mmname); uninit_remove(mmname); /* 结果/匹配标志 (声明即赋值, 防 A4001) */
                bodyx = Nd(5);
                整 e_sel = Nd(1); memcpy((字*)(nn + e_sel), fn_first_param, 64); /* 匹配对象 = 第一个参数 */
                整 has_def = 0; 整 e_def = 0;
                整 vv[64]; 整 rr[64]; 整 has_guard[64]; 整 gv[64]; 整 ng = 0;
                循环 (1) {
                    若 (tt[tk] == VR && !strcmp(tn[tk], "其他")) { tk++; 若 (tt[tk] == CL) tk++; e_def = expr(); has_def = 1; 若 (tt[tk] == SK) tk++; 断; }
                    若 (ng < 64) {
                        整 v1 = band(); /* 模式值 (不含 | 位或, 等值分派) */
                        整 guard = -1;
                        若 (tt[tk] == IK && !strcmp(tn[tk], "if")) { tk++; guard = expr(); } /* 守卫: 值 若 cond */
                        若 (tt[tk] == CL) tk++; /* : */
                        整 res = expr();
                        若 (tt[tk] == SK) tk++; /* 尾分号 */
                        vv[ng] = v1; rr[ng] = res; has_guard[ng] = (guard >= 0); gv[ng] = guard;
                        ng++;
                    }
                    若 (tt[tk] == CK) { tk++; 续; }
                    断;
                }
                { 整 d = Nd(7); memcpy((字*)(nn + d), srname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(bodyx, d); } /* int __mcf = 0; (2026-08-29 fix: 其他不得作初始值 — 会无条件求值递归, 作未匹配兜底分支) */
                { 整 d = Nd(7); memcpy((字*)(nn + d), mmname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(bodyx, d); } /* int __mmm = 0; 已匹配标志 */
                遍 (整 i = 0; i < ng; i++) {
                    整 cmp = Nd(2); nv[cmp] = T_QK; Nc(cmp, e_sel); Nc(cmp, vv[i]); /* a == v1 */
                    若 (has_guard[i]) { 整 andn = Nd(2); nv[andn] = LA; Nc(andn, cmp); Nc(andn, gv[i]); cmp = andn; }
                    整 ifn = Nd(8); Nc(ifn, cmp);
                    整 ibd = Nd(5);
                    { 整 v_sr = Nd(1); memcpy((字*)(nn + v_sr), srname, 32);
                      整 asg = Nd(10); Nc(asg, v_sr); Nc(asg, rr[i]); Nc(ibd, asg); } /* __mcf = 结果; */
                    { 整 v_mm = Nd(1); memcpy((字*)(nn + v_mm), mmname, 32);
                      整 one = Nd(0); nv[one] = 1;
                      整 asg2 = Nd(10); Nc(asg2, v_mm); Nc(asg2, one); Nc(ibd, asg2); } /* __mmm = 1; */
                    Nc(ifn, ibd);
                    Nc(bodyx, ifn);
                }
                若 (has_def) { /* 其他: if (!__mmm) { __mcf = e_def; } — 未匹配兜底 (修复: 原作初始值无条件求值 → 递归崩溃) */
                    整 v_mm = Nd(1); memcpy((字*)(nn + v_mm), mmname, 32);
                    整 zero = Nd(0); nv[zero] = 0;
                    整 notm = Nd(2); nv[notm] = T_QK; Nc(notm, v_mm); Nc(notm, zero); /* __mmm == 0 */
                    整 ifn = Nd(8); Nc(ifn, notm);
                    整 ibd = Nd(5);
                    { 整 v_sr = Nd(1); memcpy((字*)(nn + v_sr), srname, 32);
                      整 asg = Nd(10); Nc(asg, v_sr); Nc(asg, e_def); Nc(ibd, asg); } /* __mcf = e_def; */
                    Nc(ifn, ibd);
                    Nc(bodyx, ifn);
                }
                { 整 v_sr = Nd(1); memcpy((字*)(nn + v_sr), srname, 32);
                  整 rn2 = Nd(6); Nc(rn2, v_sr); Nc(bodyx, rn2); } /* return __mcf; */
                ctfe_b0 = -1; /* 多子句函数无 { 体, CTFE 跳过 */
            } 否 {
                bodyx = blk();
            }
            若 (ctfe_fns_n < 2048 && ctfe_b0 >= 0) { strcpy(ctfe_fns[ctfe_fns_n].name, (字*)(nn + fdef)); ctfe_fns[ctfe_fns_n].body0 = ctfe_b0; ctfe_fns[ctfe_fns_n].body1 = tk; ctfe_fns_n++; } /* CTFE: 函数体 token 范围 (编译期 f() 求值用); 2026-08-29 P2 #222: 多子句函数 ctfe_b0=-1 不进表 (无 { 体, 防 body0=-1 越界) */
            若 (cur_contract >= 0 && contracts[cur_contract].pre_stmt >= 0) { 整 wrapx = Nd(5); Nc(wrapx, contracts[cur_contract].pre_stmt); Nc(wrapx, bodyx); bodyx = wrapx; } /* 契约前置 (2026-08-28 可吞清单 P0-7): 入口检查包函数体首 */
            Nc(fdef, bodyx); /* 函数体 (n0) */
            若 (defer_cnt[fvn] > 0) { /* 接入 2026-08-27 defer: LIFO 逆序打包 defer 语句 → n1[fdef] — return/函数尾跳 epi_label 处先执行 */
                整 cb = Nd(5);
                遍 (整 di = defer_cnt[fvn] - 1; di >= 0; di--) Nc(cb, defer_stmts[fvn][di]);
                Nc(fdef, cb); /* n1[fdef] = defer 清理块 (逆序) */
            }
            若 (fvn >= 65536) { fprintf(stderr, "[ERR] 函数体表超过 65536 上限 (fix 2026-08-26 sqlite: 512→8192)\n"); exit(1); }
            fve[fvn] = vcnt; fvn++; /* record var-range end; order == root attach order */
            fr_end[fvn - 1] = rsp_used; /* frame-bound end (vars only; statics inside the body don't touch rsp_used) */ qcc_cur_fn_err = 0; /* 2026-08-28 type-root-2 */
            parse_base = 0; /* back to file scope for the next top-level item */
            Nc(p, fdef);
            若 (fdef_n < 1024) { fn_lines[fdef_n] = cur_fdef_line; fdef_list[fdef_n++] = fdef; } 否 budget_fail("函数表 fdef_list", 1024); /* fix 2026-08-06: 根子槽只 256 个, 超出的函数用扁平列表保留 (否则 main 被丢); 2026-08-28 资源护栏: 满→确定性拒绝; 编译检查点: 每函数解析快照; 语义导航: 行号平行存储 */ { 字 _cl[96]; sprintf(_cl, "{\"cp\":\"parse\",\"func\":\"%s\",\"idx\":%d}", (字*)(nn + fdef), fdef_n - 1); cp_line(_cl); }
        } 否 {  断; } 
    }
    返 p;
}

