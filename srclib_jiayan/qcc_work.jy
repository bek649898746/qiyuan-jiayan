                        否 若 (_afsz9 == 2) { ir_emit(I_MOVZX_RAX_WORD, 0, 0, 0); ir_flush(); } /* Phase3-IR case15: ARROWFALL short */
                        否 { ir_emit(I_DEREF32, 0, 0, 0); ir_flush(); 若 (st_field_bitw(stypes[si].name, fn) > 0) bf_extract(stypes[si].name, fn); 若 (st_field_is_uns(stypes[si].name, fn)) nuns[n] = 1; } /* Phase3-IR case15: ARROWFALL dword + bit-field — fix 2026-08-30: unsigned 字段 nuns */
