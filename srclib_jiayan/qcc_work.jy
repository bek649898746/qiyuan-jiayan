            整 cmp = Nd(2); nv[cmp] = is_max ? T_GK : T_LK; Nc(cmp, idx1); Nc(cmp, idxk); /* arr[__pi] >/< arr[__pk] */
            整 ifn = Nd(8); Nc(ifn, cmp);
