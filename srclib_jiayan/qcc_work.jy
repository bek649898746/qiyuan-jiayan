                整 is_bind = 0; 字 bind_name[64]; bind_name[0] = 0; /* 2026-08-28 P2 #138 引用模式: 对照 引用 v: 结果 → 臂内绑定 v */
                若 (v1 >= 0 && nt[v1] == 1 && !strcmp((字*)(nn + v1), "引用")) {
                    is_bind = 1;
                    strcpy(bind_name, tn[tk]); tk++; /* 绑定变量名 */
                    若 (var_lookup(bind_name) < 0) var_offset(bind_name);
