/* extern 全局变量声明: 负槽标记 (rsp_off < 0), 无 .data 分配, is_static=1 走 RIP 相对
   codegen; coff_mode 下 coff_slot_sym 生成 sec=0 未定义符号 + REL32 重定位 (Task 5.1 多 .o) */
静 整 var_extern(常 字 *n, 整 is_char, 整 is_dbl, 整 pesz, 整 is_ll) {
    静 整 extern_n = 2;
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].rsp_off < 0 && var_codegen_visible(i)) 返 vars[i].rsp_off;
    若 (vcnt >= 65536) { fprintf(stderr, "[ERR] 变量表满 vcnt=%d\n", vcnt); exit(1); }
    strcpy(vars[vcnt].name, n);
    vars[vcnt].rsp_off = -extern_n; extern_n++;
    vars[vcnt].is_param = 0; vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0;
    vars[vcnt].p_esz = pesz; vars[vcnt].p_depth = 0; vars[vcnt].p_inner = 0; vars[vcnt].pstk = 0; vars[vcnt].pdisp = -1;
    vars[vcnt].is_dbl = is_dbl; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = is_char;
    vars[vcnt].is_uns = 0; vars[vcnt].is_ll = is_ll; vars[vcnt].is_static = 1;
    返 vars[vcnt++].rsp_off;
}
静 整 var_isstatic(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_static;
    返 0;
}
/* static array: N contiguous .data slots (4 bytes each), arr_sz records element count */
静 整 var_static_arr(常 字 *n, 整 pesz, 整 esz, 整 count) {
    var_align(); /* fix step25: _Alignas 变量级 */
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && var_codegen_visible(i)) { 若 (getenv("QCC_DBG_NS")) 若 (strstr(n, "ref_namespace")) fprintf(stderr, "[NS] vsa '%s' HIT i=%d rsp=%d pesz=%d esz=%d count=%d\n", n, i, vars[i].rsp_off, pesz, esz, count); 若 (vars[i].rsp_off < 0) { vars[i].rsp_off = stc_n; 整 sl2 = (count * esz + 3) / 4; stc_n += sl2; vars[i].arr_sz = count; vars[i].arr_esz = esz; } var_last_idx = i; 返 vars[i].rsp_off; }
