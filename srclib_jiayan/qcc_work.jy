            整 asg = Nd(10); Nc(asg, idx2); Nc(asg, e_new); Nc(ibd, asg); } /* arr[__rp] = new; */
          Nc(ifn, ibd);
          Nc(bd, ifn); }
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
