静 整 cl_blk = -1; /* 当前 blk() 块 (compound literal 初始化挂这里, fix 2026-08-11) */
静 整 compound_literal(整 is_struct, 整 si, 整 is_array, 整 arr_n, 整 arr_esz);
静 整 prim(空);
静 整 stmt(空);
静 整 expr(空);

静 整 prim(空) {
        若 (tt[tk] == PP || tt[tk] == MM) { /* prefix ++/-- : mutate, then return the NEW value (fix 2026-08-05: was unhandled → no-op) */
        整 is_dec = (tt[tk] == MM); tk++;
        整 v = prim();
        整 m = Nd(26); nv[m] = is_dec; Nc(m, v);
        返 m;
    }
    若 (tt[tk] == BK) { /* sizeof */
        tk++; /* skip sizeof */
        若 (tt[tk] == OK) tk++; /* skip ( */
        若 (tt[tk] == DK) { /* sizeof(*expr): deref → pointee size (struct T *p → sizeof(T); int *p → 4; char *p → 1) (fix 2026-08-15: strvec_init copied only 8 bytes, nr/alloc garbage) */
            tk++; /* * */
            整 sz = 8;
            若 (tt[tk] == VR) { 字 vn[64]; strcpy(vn, tn[tk]); 整 si = var_stidx(vn); 若 (si >= 0) sz = st_sz(stypes[si].name); 否 若 (var_pesz(vn) > 0) sz = var_pesz(vn); }
            整 v = prim(); (空)v; /* 消费 expr (mod.add) */
            若 (tt[tk] == KK) tk++; /* ) */
            整 n = Nd(0); nv[n] = sz; 返 n;
        }
        若 (tt[tk] == OK) { /* sizeof((expr)[0]): ARRAY_SIZE 宏 → 元素大小 (fix 2026-08-14: 原嵌套 ( 未消费 → ')[' 崩溃) */
            若 (tt[tk] == OK && tt[tk + 1] == DK && tt[tk + 2] == VR && tt[tk + 3] == KK && (tt[tk + 4] == AR || tt[tk + 4] == DT) && tt[tk + 5] == VR && tt[tk + 6] == KK) { /* sizeof((*ptr)->field) — commit-graph.c (*list)->date (fix 2026-08-15: 原 ARRAY_SIZE 分支盲吃 (* 漏 date → undefined) */
                整 si2 = var_stidx(tn[tk + 2]);
                整 fsz2 = 4;
                若 (si2 >= 0) { 整 fsv = st_field_size(stypes[si2].name, tn[tk + 5]); 若 (fsv > 0) fsz2 = fsv; }
                tk += 7; /* ( * base ) -> field ) */
                整 nsz = Nd(0); nv[nsz] = fsz2; 返 nsz;
            }
            若 (tt[tk] == OK && tt[tk + 1] == VR && (tt[tk + 2] == AR || tt[tk + 2] == DT) && tt[tk + 3] == VR && tt[tk + 4] == KK && tt[tk + 5] == LB) { /* sizeof((ptr->field)[0]) — ARRAY_SIZE(watch->dotgit_shortname) (fix 2026-08-15: dotgit_shortname 泄漏 undefined) */
                整 si3 = var_stidx(tn[tk + 1]);
                整 esz3 = 4;
                若 (si3 >= 0) { 整 el = st_field_el(si3, tn[tk + 3]); 若 (el > 0) esz3 = el; }
                tk += 5; /* ( base op field ) */
                若 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK || tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++; }
                若 (tt[tk] == KK) tk++; /* outer ) */
                整 nsz = Nd(0); nv[nsz] = esz3; 返 nsz;
            }
            tk++; /* ( */
            整 esz = 4;
            若 (tt[tk] == VR) {
                字 nm[64]; strcpy(nm, tn[tk]);
                整 base_si = -1;
                遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                    若 (!strcmp(vars[vi].name, nm) && var_codegen_visible(vi)) {
                        若 (vars[vi].arr_sz > 0) esz = vars[vi].arr_esz ? vars[vi].arr_esz : 4;
                        否 若 (vars[vi].p_esz != 0) esz = vars[vi].p_esz;
                        否 若 (vars[vi].is_char) esz = 1;
                        否 esz = 4;
                        base_si = vars[vi].st_idx;
                        断;
                    }
                tk++; /* varname */
                /* (expr)[0] 内的嵌套成员链也要完整消费: opts->internal.unpack_rejects
                   的 ARRAY_SIZE 会展开为 sizeof((opts->internal.unpack_rejects)[0]),
                   原只消费 opts → 后续 ->internal.unpack_rejects 泄漏为 undefined 符号 (fix 2026-08-15) */
                循环 (tt[tk] == DT || tt[tk] == AR) {
                    tk++; /* . 或 -> */
                    若 (tt[tk] == VR) {
                        若 (base_si >= 0) {
                            整 el = st_field_el(base_si, tn[tk]); 若 (el > 0) esz = el;
                            整 fty = st_field_ty_idx(stypes[base_si].name, tn[tk]); 若 (fty >= 0) base_si = fty; 否 base_si = -1;
                        }
                        tk++; /* 字段名 */
                    } 否 断;
                }
            }
            若 (tt[tk] == KK) tk++; /* ) */
            若 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK || tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++; } /* [0] */
            若 (tt[tk] == KK) tk++; /* sizeof 的 ) */
            整 n = Nd(0); nv[n] = esz; 返 n;
        }
        若 (tt[tk] == STR) { 整 n = Nd(0); nv[n] = (整)strlen(str_tbl[tv[tk]]) + 1; tk++; 返 n; } /* sizeof "string" (fix 2026-08-14: regcomp.c REG_NOMATCH_IDX = ... + sizeof "Success" — 原 STR 未消费泄漏 → 死循环) */
        若 (tt[tk] == VK) { /* sizeof(int/char/double/...) + pointers (fix 2026-08-05: was hardcoded 4 for every type) */
            整 tsz = 4;
            整 long_cnt = 0, is_dbl = 0, is_char = 0, is_short = 0;
            循环 (tt[tk] == VK) { /* unsigned long long / long long 是 8 字节; const/volatile 是限定符不影响大小 (fix 2026-08-15: sizeof(uintmax_t) 只吃 unsigned → 4 字节且 long long 泄漏, unsigned_add_overflows 的 bitsizeof(uintmax_t)-bitsizeof(a) 被吞) */
                若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) is_char = 1;
                否 若 (!strcmp(tn[tk], "double")) is_dbl = 1;
                否 若 (!strcmp(tn[tk], "short")) is_short = 1;
                否 若 (!strcmp(tn[tk], "long")) long_cnt++;
                tk++;
            }
            若 (is_char) tsz = 1;
            否 若 (is_short) tsz = 2;
            否 若 (is_dbl || long_cnt >= 2) tsz = 8;
            否 若 (long_cnt == 1) tsz = 4;
            若 (tt[tk] == DK) { tsz = 8; tk++; } /* sizeof(int*) → 8 */
            若 (tt[tk] == KK) tk++;
            整 n = Nd(0); nv[n] = tsz; 返 n;
        }
        若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == KK) tk++; 整 n = Nd(0); nv[n] = 4; 返 n; } /* sizeof(enum Tag) → int 4 字节 (fix 2026-08-15: commit-slab elem_size=sizeof(enum contains_result) → contains_result 泄漏 undefined) */
        若 (tt[tk] == ST) { tk++; /* skip struct */
            若 (tt[tk] == VR) {
                整 sz = st_sz(tn[tk]); tk++; /* struct name */
                若 (tt[tk] == KK) tk++; /* ) */
                整 n = Nd(0); nv[n] = sz; 返 n;
            } 否 若 (tt[tk] == FK) { /* sizeof(struct {...}) — anonymous inline definition (fix 2026-08-05: was unhandled → parse returned -1 and main() body was silently dropped) */
                tk++; /* { */
                字 aname[64]; aname[0] = 0; 整 si = st_add(aname);
                整 funs = 0; /* unsigned bit-field marker */
                循环 (tk < TS && tt[tk] != UK) {
                    整 fsz = 4; 整 frow = 1; 整 dims = 0; 整 first = 1; 整 fdbl = 0;
                    若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { fsz = 1; frow = 1; } 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; frow = 8; fdbl = 1; } tk++; }
                    循环 (tt[tk] == DK) { fsz = 8; tk++; } /* pointer field (fix: DK unhandled) */
                    若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == DK) tk++; 若 (tt[tk] == VR) { 字 fn[64]; strcpy(fn, tn[tk]); tk++; st_field_sz_r(si, fn, 4, 1); } }
                    若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; }
                    若 (tt[tk] == CL) { /* unnamed bit-field */
                        tk++; 整 ubw = 0;
                        若 (tt[tk] == NK) { ubw = tv[tk]; tk++; }
                        st_field_bit_anon(si, ubw);
                        funs = 0;
                    }
                    若 (tt[tk] == VR) {
                        字 fn[64]; strcpy(fn, tn[tk]); tk++;
                        整 bitw = 0;
                        若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) { bitw = tv[tk]; tk++; } }
                        若 (bitw > 0) { st_field_bit(si, fn, fsz, fsz, bitw, funs); 若 (fdbl) st_field_dbl(si, fn); funs = 0; }
                        否 {
                            整 fel = fsz; /* fix 2026-08-07: 数组字段元素大小 */
                            循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) { 若 (dims == 0) first = tv[tk]; dims++; fsz *= tv[tk]; tk++; } 否 若 (tt[tk] == VR) { 整 evc = e_lookup(tn[tk]); 若 (evc == 0x80000000) evc = macro_find(tn[tk]); 若 (evc != 0x80000000 && evc != -1) { 若 (dims == 0) first = evc; dims++; fsz *= evc; } tk++; } 否 { dims++; 整 bd = 1; 循环 (tk < TS && bd > 0) { 若 (tt[tk] == LB) bd++; 否 若 (tt[tk] == RB) { bd--; 若 (bd == 0) { tk++; 断; } } tk++; } } 若 (tt[tk] == PK || tt[tk] == MK) { 整 op = tt[tk]; tk++; 若 (tt[tk] == NK) { 若 (op == PK) fsz += tv[tk]; 否 fsz -= tv[tk]; tk++; } } 若 (tt[tk] == RB) tk++; /* fix 2026-08-13 Phase3: 复杂维度跳过 + NK/VR 后消费 ] */ }
                            若 (dims >= 1) frow = fsz / first; 否 frow = fsz;
                            st_field_sz_r(si, fn, fsz, frow);
                            stypes[si].fels[stypes[si].fn - 1] = fel; /* fix 2026-08-07 */
                            若 (fdbl) st_field_dbl(si, fn);
                        }
                    }
                    若 (tt[tk] == CK) tk++;
                    若 (tt[tk] == SK) tk++;
                }
                若 (tt[tk] == UK) tk++; /* } */
                若 (stypes[si].algn > 1) { 整 m = stypes[si].sz % stypes[si].algn; 若 (m) stypes[si].sz += stypes[si].algn - m; } /* fix 2026-08-06: struct 总大小 round up 到最大对齐 */
                整 sz = stypes[si].sz;
                若 (tt[tk] == KK) tk++; /* ) */
                整 n = Nd(0); nv[n] = sz; 返 n;
            }
        }
        若 (tt[tk] == VR && td_is(tn[tk])) { /* sizeof(TypedefName) — typedef'd struct/double (fix 2026-08-03: was 4) */
            整 tdi = tdef_lookup(tn[tk]);
            若 (tdi >= 0 && tdefs[tdi].is_struct) {
                整 sz = st_sz(tdefs[tdi].st_name); tk++;
                若 (tt[tk] == KK) tk++; /* ) */
                整 n = Nd(0); nv[n] = sz; 返 n;
            }
            若 (tdi >= 0 && tdefs[tdi].is_dbl && !tdefs[tdi].is_struct) { /* sizeof(typedef double) → 8 (fix 2026-08-05) */
                tk++;
                若 (tt[tk] == KK) tk++;
                整 n = Nd(0); nv[n] = 8; 返 n;
            }
        }
        若 (tt[tk] == VR) { /* sizeof(varname): array -> N*esz, double -> 8, char -> 1, ptr -> 8, else 4 */
            整 sz = 4;
            整 base_si = -1; /* struct type of the base var (for sizeof(e->field)) */
            遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                若 (!strcmp(vars[vi].name, tn[tk]) && var_codegen_visible(vi)) {
                    若 (vars[vi].arr_sz > 0) { 整 e = vars[vi].arr_esz ? vars[vi].arr_esz : 4; sz = vars[vi].arr_sz * e; }
                    否 若 (vars[vi].is_dbl) sz = 8;
                    否 若 (vars[vi].is_char) sz = 1;
                    否 若 (vars[vi].p_esz != 0) sz = 8; /* pointer: p_esz=element size, slot is 8 bytes */
                    否 sz = 4;
                    base_si = vars[vi].st_idx;
                    断;
                }
            tk++; /* skip varname */
            循环 (tt[tk] == DT || tt[tk] == AR) { /* -> / . member chain: sizeof(e->p->name) — 跟随后续成员直到最后字段 (fix 2026-08-15: precompose_utf8 sizeof(prec_dir->dirent_nfc->d_name) 原只跟一级 → d_name 泄漏 undefined) */
                tk++; /* skip ->/. */
                若 (tt[tk] == VR) {
                    若 (base_si >= 0) { 整 fs = st_field_size(stypes[base_si].name, tn[tk]); 若 (fs > 0) sz = fs; 整 fty = st_field_ty_idx(stypes[base_si].name, tn[tk]); 若 (fty >= 0) base_si = fty; 否 base_si = -1; }
                    tk++;
                }
            }
            若 (tt[tk] == KK) tk++; /* ) */
            整 n = Nd(0); nv[n] = sz; 返 n;
        }
        若 (tt[tk] == DK) { /* sizeof(*ptr) — 指针 deref: 指向类型大小 (fix 2026-08-13: 原 return -1 → token 错位, 镜像 v4 0xC0000005; hash-ll.h Clone memcpy(dst,src,sizeof(*dst))) */
            tk++; /* * */
            整 sz = 8;
            若 (tt[tk] == VR) {
                遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                    若 (!strcmp(vars[vi].name, tn[tk]) && var_codegen_visible(vi)) {
                        若 (vars[vi].p_esz > 0) sz = vars[vi].p_esz;
                        断;
                    }
                tk++; /* var name */
            }
            若 (tt[tk] == KK) tk++; /* ) */
            整 n = Nd(0); nv[n] = sz; 返 n;
        }
        返 -1;
    }
    若 (tt[tk] == NK) { 整 n = Nd(0); nv[n] = tv[tk]; 若 (tuns[tk]) nuns[n] = 1; 若 (tll[tk]) { nll[n] = 1; nll_hi[n] = tll_hi[tk]; } tk++; 返 n; } /* u-/LL-suffix literals → flags (fix 2026-08-05) */
    若 (tt[tk] == FP) { 整 n = Nd(0); nv[n] = tv[tk]; nt[n] = FP; ndbl[n] = 1; tk++; 返 n; } /* double literal */
    若 (tt[tk] == VR) {
        /* NULL = 0 (fix 2026-08-03: the self-host lexer has no preprocessor, so
           <stddef.h>'s #define NULL never reaches the parser — it fell through to
           an undefined identifier and compiled to a stale-register store) */
        若 (!strcmp(tn[tk], "NULL")) { tk++; 整 n = Nd(0); nv[n] = 0; 返 n; }
        若 (!strcmp(tn[tk], "__builtin_constant_p")) { /* GCC builtin: 编译期常量判断 → 返回 0 走运行时分支 (fix 2026-08-14: bswap.h 用, 原当函数调用 → undefined symbol) */
            tk++; /* 函数名 */
            若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } /* 跳过 (args) */
            整 n = Nd(0); nv[n] = 0; 返 n;
        }
        若 (!strcmp(tn[tk], "offsetof")) { /* offsetof(TYPE, MEMBER) = 成员字节偏移 (fix 2026-08-14: <stddef.h> 跳过 → offsetof 未展开当函数调用 → undefined symbol; fix 2026-08-15: __typeof__(*e) 嵌套括号 + const 前缀 → ent 泄漏 undefined) */
            tk++; /* offsetof */
            若 (tt[tk] == OK) {
                tk++; /* ( */
                整 osi = -1;
                循环 (tt[tk] == VK) tk++; /* const/volatile 前缀 */
                若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { osi = st_find(tn[tk]); tk++; } } /* struct Tag */
                否 若 (tt[tk] == VR) { osi = st_find(tn[tk]); tk++; } /* typedef 名 / __typeof__ 等 */
                { 整 d = 0; 循环 (tk < TS && tt[tk] != EK) { /* 跳过剩余类型 token 到顶层逗号 (__typeof__(*e) 嵌套括号) */
                    若 (tt[tk] == CK && d == 0) 断;
                    若 (tt[tk] == KK && d == 0) 断;
                    若 (tt[tk] == OK || tt[tk] == LB) d++;
                    否 若 (tt[tk] == KK || tt[tk] == RB) d--;
                    tk++;
                } }
                整 off = 0;
                若 (tt[tk] == CK) tk++; /* , */
                若 (osi >= 0 && tt[tk] == VR) { off = st_off(stypes[osi].name, tn[tk]); tk++; } /* 字段名 */
                { 整 d = 0; 循环 (tk < TS && tt[tk] != EK) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { 若 (d <= 0) { tk++; 断; } d--; } tk++; } } /* 跳到匹配 ) */
                整 n = Nd(0); nv[n] = off; 返 n;
            }
            tk++; 整 n2 = Nd(0); nv[n2] = 0; 返 n2;
        }
        /* enum constant? */
        整 ev = e_lookup(tn[tk]);
        若 (ev != 0x80000000) { tk++; 整 n = Nd(0); nv[n] = ev; 返 n; } /* fix 2026-08-09: != 哨兵而非 >= 0 (负值常量 RED=-2) */
        整 n = Nd(1); memcpy((字*)(nn + n), tn[tk], 64); tk++;
                若 (var_is_dbl(tn[tk - 1]) && var_arrsz(tn[tk - 1]) == 0) ndbl[n] = 1; /* double VARIABLE (array NAME decays to its address, not a double — fix 2026-08-05: double arr name was marked ndbl → p/d comparisons took the float path) */
        若 (var_is_ll(tn[tk - 1]) && var_arrsz(tn[tk - 1]) == 0) nll[n] = 1; /* long long VARIABLE (fix 2026-08-05) */
        若 (var_is_uns(tn[tk - 1]) && var_arrsz(tn[tk - 1]) == 0) nuns[n] = 1; /* unsigned VARIABLE (fix 2026-08-06: (long long)u 必须零扩展, movsxd 判断靠 nuns) */
        /* suffix chain: arr[expr] / .field / ->field (repeatable) */
        循环 (1) {
            若 (tt[tk] == LB) { /* array access */
                tk++; /* skip [ */
                整 m = Nd(14); /* array access node */
                Nc(m, n); /* n0 = variable */
                Nc(m, expr()); /* n1 = index */
                若 (tt[tk] == RB) tk++; /* skip ] */
                若 (nt[n] == 1 && (var_is_dbl((字*)(nn + n)) || var_pdbl((字*)(nn + n)))) ndbl[m] = 1; /* double array / double* elem */
                否 若 (ndbl[n]) ndbl[m] = 1; /* nested arr[i][j]: outer index node inherits double flag */
                n = m;
            } 否 若 (tt[tk] == DT || tt[tk] == AR) {
                整 ar = (tt[tk] == AR); tk++;
                若 (tt[tk] == VR) {
                    整 m = Nd(15); /* unified member access */
                    Nc(m, n); nv[m] = ar; /* nv=1 for arrow, 0 for dot */
                    memcpy((字*)(nn + m), tn[tk], 64); tk++;
                    若 (nt[n] == 1) { /* base is a struct var: flag double fields */
                        整 bsi = var_stidx((字*)(nn + n));
                        若 (bsi >= 0 && st_field_is_dbl(stypes[bsi].name, (字*)(nn + m))) ndbl[m] = 1;
                    }
                    n = m;
                } 否 断;
            } 否 若 (tt[tk] == PP || tt[tk] == MM) {
                /* postfix ++ / -- : return old value, then mutate (simple vars) */
                整 is_dec = (tt[tk] == MM); tk++;
                整 m = Nd(23); nv[m] = is_dec;
                Nc(m, n); n = m;
            } 否 若 (tt[tk] == OK) { /* 函数调用 f(...): 并入后缀链 (fix 2026-08-06: 原在 while 外直接 return, f()[0] 的 [0] 悬空 → 条件变指针比较) */
                整 callee = n; tk++; 整 c = Nd(4); 循环 (tt[tk] != KK && tt[tk] != EK) { 整 t0 = tk; 若 (tt[tk] == CK) tk++; Nc(c, expr()); 若 (tk == t0) 断; } 若 (tt[tk] == KK) tk++; Nc(c, n); n = c; /* fix 2026-08-07: EK 防 EOF 死循环 + 进度守卫防 expr() 不前进 (缺 ) 或非法参数) */
                若 (nt[callee] == 1 && fn_dbl_get_ret((字*)(nn + callee))) ndbl[c] = 1; /* fix 2026-08-06: parse 时标记 double 返回调用 (callee 节点, 非 n=c 后) — 参数 push 判断在 cg 前 → 跨 .o 声明时参数按 int 压栈 (avg 返回 0.0) */
            } 否 断;
        }
        返 n; }
    若 (tt[tk] == OK && tt[tk + 1] == VR && !strcmp(tn[tk + 1], "__typeof__")) { /* __typeof__(x)(y) GCC 类型转换 — 忽略类型, 返回 y (fix 2026-08-15: MSB 宏展开后 __typeof__ undefined) */
        tk++; /* ( */
        tk++; /* __typeof__ */
        若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } }
        若 (tt[tk] == KK) tk++; /* closing ) of (__typeof__(...)) */
        返 prim(); /* 解析被转换的表达式 */
    }
    若 (tt[tk] == OK) {
        /* type cast: (type)expr — type keywords/struct/typedef then ). fix 2026-08-13 Phase3: unknown typedef (uint32_t 来自跳过 <stdint.h>) 也当 cast 类型 — var_lookup==-1 排除变量 (a) */
            若 (tt[tk + 1] == VK || tt[tk + 1] == ST || (tt[tk + 1] == VR && td_is(tn[tk + 1]))) {
            字 *cast_ty = 0; 字 *cast_ty2 = 0;
            字 cast_sname[64] = ""; 整 cast_is_struct = 0;
            tk++; /* ( */
            若 (tt[tk] == VK) { cast_ty = tn[tk]; tk++; 若 (tt[tk] == VK) { cast_ty2 = tn[tk]; tk++; } 循环 (tt[tk] == VK) tk++; } /* first/second type kw: int/double */
            否 循环 (tt[tk] == VK) tk++;
            若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { strcpy(cast_sname, tn[tk]); cast_is_struct = 1; tk++; } } /* struct Tag — 保存 tag 名 (compound literal 用) */
            否 若 (tt[tk] == VR && td_is(tn[tk])) tk++;
            若 (tt[tk] == OK && tt[tk + 1] == DK) { /* fix 2026-08-10: 函数指针类型 cast (int (*)(int))expr — 跳过 (*) (args) 到类型结束 ) */
                整 fp_d = 1; tk++; /* (* 的 ( 已含在深度内 */
                循环 (tk < TS) {
                    若 (tt[tk] == OK) fp_d++;
                    否 若 (tt[tk] == KK) { 若 (fp_d == 0) { tk++; 断; } fp_d--; }
                    tk++;
                }
            }
            整 cast_nstar = 0; 循环 (tt[tk] == DK) { cast_nstar++; tk++; } /* pointer * */
            整 cast_arrn = 0; 整 cast_arresz = 0; /* compound literal 数组 dims: (int[N]){...} */
            若 (tt[tk] == LB) { /* (T[N]) 数组类型后缀 (compound literal 用, fix 2026-08-11) */
                tk++; 若 (tt[tk] == NK) { cast_arrn = tv[tk]; tk++; } 否 若 (tt[tk] == VR) { cast_arrn = 0; tk++; }
                若 (tt[tk] == RB) tk++;
                cast_arresz = cast_ty2 ? 8 : 4; /* double/long long → 8, else 4 */
            }
            若 (tt[tk] == KK) tk++; /* ) */
