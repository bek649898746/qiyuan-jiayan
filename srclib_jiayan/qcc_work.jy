        若 (tt[tk] == SK) tk++; /* ; */
        静 整 rp_seq = 0; 字 iname[64]; sprintf(iname, "__rp_%d_", rp_seq++);
        var_offset(iname);
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __rp = 0; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__rp < n) */
        整 bd = Nd(5);
        整 v_r = Nd(1); memcpy((字*)(nn + v_r), arrn, 32);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx = Nd(14); Nc(idx, v_r); Nc(idx, v_i); /* arr[__rp] */
          整 eq = Nd(2); nv[eq] = T_QK; Nc(eq, idx); Nc(eq, e_old); /* arr[__rp] == old */
          整 ifn = Nd(8); Nc(ifn, eq);
