            若 (ds2 >= 0 && ov_n > 0) { 字 *dty = stypes[ds2].name; 遍 (整 k = 0; k < ov_n; k++) 若 (ov_op[k] == DK && !strcmp(ov_ty[k], dty)) { 整 c = Nd(4); Nc(c, dop); { 整 fn = Nd(1); memcpy((字*)(nn + fn), ov_fn[k], 64); Nc(c, fn); } 返 c; } }
        }
        若 (dop >= 0 && nt[dop] == 1 && nullable_has((字*)(nn + dop))) { sprintf(g_errbuf, "可空类型: 变量 '%s' 未解包就解引用 (星号) — 先 解包 %s; (类型根治①, v3.0 #75)", (字*)(nn + dop), (字*)(nn + dop)); emit_error("A8001", g_errbuf); }
        Nc(n, dop);
        若 (dop >= 0 && nt[dop] == 1 && var_pdbl((字*)(nn + dop))) ndbl[n] = 1; /* *double-p → xmm0 */
        返 n; }
    若 (tt[tk] == NT) { tk++; 整 n = Nd(17); Nc(n, prim()); 返 n; }
    若 (tt[tk] == BN) { tk++; 整 n = Nd(18); Nc(n, prim()); 返 n; } /* ~expr */
    若 (tt[tk] == PK) { tk++; 返 prim(); } /* unary plus: +expr = expr — fix 2026-08-30 csmith s140/s153: 原无 PK 分支 → +x 落回 -1 → add() 当二元加 → 值翻倍 ((+0xFE3FL) → 2×0xFE3F, s140 g_373.f0) */
    若 (tt[tk] == MK) { /* unary minus: -expr */
        tk++;
        /* -double-literal: flip the IEEE sign bit at PARSE time (keeps -0.0 as a
           real negative zero; a runtime 0.0 - x would round -0.0 to +0.0) */
        若 (tt[tk] == FP) {
            整 idx = tv[tk];
            若 (dbl_n < 1024) { dbl_hi[dbl_n] = dbl_hi[idx]; dbl_lo[dbl_n] = dbl_lo[idx]; dbl_hi[dbl_n] ^= 0x80000000; } /* fix 2026-08-07: 512→1024 对齐镜像 (dbl_n∈[512,1024) 时原静默不写却 dbl_n++ → 垃圾 double) */
            若 (dbl_n >= 8192) { fprintf(stderr, "[ERR] double 字面量表满 (fix 2026-08-06 M3)\n"); exit(1); }
            整 n = Nd(FP); nv[n] = dbl_n; ndbl[n] = 1; dbl_n++; tk++; /* -double-literal: must be marked ndbl (fix 2026-08-06) */
            返 n;
        }
        整 n = Nd(2); nv[n] = MK; Nc(n, Nd(0)); nv[n0[n]] = 0; 整 um = prim(); Nc(n, um); 若 (um >= 0 && nll[um]) nll[n] = 1; 返 n; /* fix 2026-08-21 #28: 一元负传播 ll 标记 — 否则 -0x7fffffffffffffffLL - 1 的后续减按 32 位 (INT64_MIN 宏错) */
    }
    若 (tt[tk] == STR) { 整 n = Nd(0); nv[n] = tv[tk]; /* str index → treated as immediate for codegen */ nt[n] = STR; tk++;
        循环 (tt[tk] == LB) { /* 字符串字面量下标 "abc"[i] (fix 2026-08-06: 原 STR 分支无 suffix chain → 实参 `f("A"[0])` 解析卡在 `[` 死循环; 赋值场景留下未消费的 `[` 生成垃圾值) */
            tk++; /* [ */
            整 m = Nd(14); Nc(m, n); Nc(m, expr()); 若 (tt[tk] == RB) tk++; /* ] */
            n = m;
        }
        返 n; }
    返 -1;
}

静 整 mul(空) { 整 n = prim(); 循环 (tt[tk] == DK || tt[tk] == DV || tt[tk] == MD || tt[tk] == SH || tt[tk] == SR) { 整 o = tt[tk++]; 整 a = Nd(2); nv[a] = o; 整 r = prim(); Nc(a, n); Nc(a, r); 若 ((o == DK || o == DV) && n >= 0 && nt[n] == 0 && r >= 0 && nt[r] == 0 && nv[r] == 0) { sprintf(g_errbuf, "编译期除零: 常量除数为 0 (探雷雷5)"); emit_error("A2001", g_errbuf); } /* fix 2026-08-30 探雷雷5: 常量除零编译期拦截 — 仅分子分母都是字面量 (1/0, x 变量/表达式分母 0 放行: csmith 生成大量 /0 UB 在死代码/未执行路径, gcc 不拦, 拦截误伤 59 种子; 分子常量 = 必然执行, 拦) */ 若 ((o == DK || o == DV) && ((n >= 0 && ndbl[n]) || (r >= 0 && ndbl[r]))) ndbl[a] = 1; 若 (o == SH || o == SR) { 若 (expr_is_ll(n)) nll[a] = 1; } /* fix 2026-08-29 csmith: 移位结果宽度=左操作数 — 原 expr_is_ll(r) 也传播 → `x << (int8_t)uint64` 被标 LL → 64 位移位 mod64 错 (s137 静默) */ 否 若 (expr_is_ll(n) || (r >= 0 && expr_is_ll(r))) nll[a] = 1; /* fix 2026-08-22 #31: 64-bit result nll at parse time */ n = a; } 返 n; }
静 整 add(空) { 整 n = mul(); 循环 (tt[tk] == PK || tt[tk] == MK) { 整 o = tt[tk++]; 整 ovf = -1; 若 (ov_n > 0 && nt[n] == 1) { /* 接入 2026-08-27 运算符重载: 左操作数是 struct 变量且注册过该运算符+类型 → 生成函数调用 (重载表空则零影响原路径) */ 整 si = var_stidx((字*)(nn + n)); 若 (si >= 0) { 字 *tyn = stypes[si].name; 遍 (整 k = 0; k < ov_n; k++) 若 (ov_op[k] == (字)o && !strcmp(ov_ty[k], tyn)) { ovf = k; 断; } } } 若 (ovf >= 0) { 整 r = mul(); 整 c = Nd(4); Nc(c, n); Nc(c, r); { 整 fn = Nd(1); memcpy((字*)(nn + fn), ov_fn[ovf], 64); Nc(c, fn); } n = c; } 否 { 整 a = Nd(2); nv[a] = o; 整 r = mul(); Nc(a, n); Nc(a, r); 若 ((o == PK || o == MK) && ((n >= 0 && ndbl[n]) || (r >= 0 && ndbl[r]))) ndbl[a] = 1; n = a; } } 返 n; } /* t35m 2026-08-24: 按位 & ^ | 从加减层拆出 — C 优先级 (| 最低, ^ 中, & 最高; htonl(x) = (x&0xff)<<24 | (x>>24)&0xff 原 & 与 | 同级左结合 → 整体 &0xff → pack idx 魔数检查失败 → pack 对象读取失败) */
静 整 band(空) { 整 n = add(); 循环 (tt[tk] == PT) { tk++; 整 a = Nd(2); nv[a] = PT; 整 r = add(); Nc(a, n); Nc(a, r); n = a; } 返 n; }
静 整 bxor(空) { 整 n = band(); 循环 (tt[tk] == XR) { tk++; 整 a = Nd(2); nv[a] = XR; 整 r = band(); Nc(a, n); Nc(a, r); n = a; } 返 n; }
静 整 bor(空) { 整 n = bxor(); 循环 (tt[tk] == OR) { tk++; 整 a = Nd(2); nv[a] = OR; 整 r = bxor(); Nc(a, n); Nc(a, r); n = a; } 返 n; }
静 整 cmp(空) { 整 n = bor(); 循环 (tt[tk] == LK || tt[tk] == GK || tt[tk] == QK || tt[tk] == XK || tt[tk] == HK || tt[tk] == YK) { 整 o = tt[tk++]; 整 a = Nd(2); nv[a] = o; Nc(a, n); Nc(a, bor()); n = a; } 返 n; }
静 整 land(空) { 整 n = cmp(); 循环 (tt[tk] == LA) { tk++; 整 a = Nd(2); nv[a] = LA; Nc(a, n); Nc(a, cmp()); n = a; } 返 n; }
静 整 lor(空) { 整 n = land(); 循环 (tt[tk] == LO) { tk++; 整 a = Nd(2); nv[a] = LO; Nc(a, n); Nc(a, land()); n = a; } 返 n; }
静 整 tern(空) { 整 n = lor(); 若 (tt[tk] == QU) { tk++; 整 t = lor(); 若 (tt[tk] == CL) tk++; 整 f = tern(); 整 a = Nd(22); Nc(a, n); Nc(a, t); Nc(a, f); 返 a; } 返 n; }
静 整 asgn(空) { lv_moved_n = 0; lv_uninit_n = 0; lv_path_n = 0; asgn_lhs_parsing = 1; 整 n = tern(); 若 (!qcc_skip_err_check) err_union_check(n); /* 2026-08-28 type-root-2: try-branch exempt */ asgn_lhs_parsing = 0; 若 (tt[tk] == AK) { tk++; 若 (n >= 0 && cnst_node[n]) { sprintf(g_errbuf, "常量: 常量不可赋值 (常量 名 = 值 声明后只读, v3.0 #278)"); emit_error("A9006", g_errbuf); } 若 (n >= 0 && nt[n] == 1) { 字 *vname = (字*)(nn + n); 遍 (整 _im = 0; _im < immut_cnt; _im++) 若 (!strcmp(immut_names[_im], vname)) { sprintf(g_errbuf, "不可变: 变量 '%s' 是 不变 声明, 不能赋值 (v3.0 #209)", vname); emit_error("A9006", g_errbuf); } /* 2026-08-28 P1 #209: 不变变量只读 */ borrow_write_policy(n); /* 借用自动化 (2026-08-28 完善): 只读借用写=自动放还, 可变借用写=[ERR] — 原: bm>=0 一律 [ERR] 需手动 放还 */ 若 (is_moved(vname)) moved_release(vname); /* 接入 2026-08-28 机制层 #5: 写已移动变量 = 重新赋值/重新初始化 → 恢复可用 (Rust 式 move 后重绑定) */ uninit_remove(vname); guard_mark_ready(vname); nullable_remove(vname); /* 类型根治① (2026-08-28): 赋值 = 重新绑定 → 清除可空标记 */ /* 接入 2026-08-28 机制层 #78: 赋值 = 已初始化 */ } 否 { 整 rv = n; 循环 (rv >= 0 && (nt[rv] == 14 || nt[rv] == 15 || nt[rv] == 13 || nt[rv] == 12)) rv = n0[rv]; /* fix 2026-08-30 探雷雷4 大哥定位: 回溯补 nt==12 (解引用) — 原漏 *p=99 的 rv 停在解引用节点回溯不下去 → borrow_write_policy 不调用 → 借用追别名检查是死代码 (L4743 nt==12 逻辑永不触发); 补后 *p 回溯到指针名 p (nt==1) → 借用策略生效 */ 若 (rv >= 0 && nt[rv] == 1) { borrow_write_policy(n); /* 借用自动化 (2026-08-28 完善): 成员/数组写 → 基础变量借用策略 (s.v=5 触发 s 的只读借用自动放还; 箭头链写指向对象跳过) */ 若 (is_moved((字*)(nn + rv))) moved_release((字*)(nn + rv)); uninit_remove((字*)(nn + rv)); guard_mark_ready((字*)(nn + rv)); nullable_remove((字*)(nn + rv)); /* 类型根治①: 成员/数组写 = 重新绑定 → 清除可空标记 */ /* 接入 2026-08-28 机制层 #78: 成员/数组赋值 = 基础变量已初始化 */ } lv_path_n = 0; /* 2026-08-28 P1 #33/#34/#17: 成员/数组写目标 — 路径缓冲清除 (写策略已处理路径借用) */ { 整 _pw = n; 整 _pd = 0; 循环 (_pw >= 0 && _pd < 8 && (nt[_pw] == 14 || (nt[_pw] == 15 && nv[_pw] == 0))) _pw = n0[_pw]; 若 (n >= 0 && nt[n] == 15 && nv[n] == 0 && _pw >= 0 && nt[_pw] == 1) { 字 _pp[160]; sprintf(_pp, "%s.%s", (字*)(nn + _pw), (字*)(nn + n)); moved_release(_pp); } 否 若 (n >= 0 && nt[n] == 14 && n1[n] >= 0 && nt[n1[n]] == 0 && _pw >= 0 && nt[_pw] == 1) { 字 _pp[160]; sprintf(_pp, "%s[%d]", (字*)(nn + _pw), nv[n1[n]]); moved_release(_pp); } } /* #17: 字段/元素写 = 重新初始化 → 解除路径 moved (Rust 式 move 后重绑定) */ } 整 a = Nd(10); Nc(a, n); 整 _a_rhs = asgn(); 若 (n >= 0 && nt[n] == 1) { 若 (const_find((字*)(nn + n)) >= 0) { sprintf(g_errbuf, "%s", "常量: 变量 %s 是 常量 不可赋值 (常量 名 = 值 声明后不可变, v3.0 #278)"); emit_error("A9006", g_errbuf); } implicit_cast_check(_a_rhs, (字*)(nn + n)); 整 _ri = range_find((字*)(nn + n)); 若 (_ri >= 0) { 整 _rok = 0; 长 长 _rv = contract_const_eval(_a_rhs, NULL, NULL, 0, &_rok); 若 (_rok && (_rv < range_lo[_ri] || _rv > range_hi[_ri])) { sprintf(g_errbuf, "%s", "区间类型: 赋值 %lld 超出区间 [%d, %d] - 区间类型变量只能赋界内值 (v3.0 #101)"); emit_error("A9003", g_errbuf); } } } Nc(a, _a_rhs); 若 (n >= 0 && nt[n] == 1 && _a_rhs >= 0 && nt[_a_rhs] == 11 && n0[_a_rhs] >= 0 && nt[n0[_a_rhs]] == 1) { alias_reg((字*)(nn + n), (字*)(nn + n0[_a_rhs])); } /* fix 2026-08-30 探雷雷4: p = &x 登记别名 (借用追指针) */ 返 a; }
    若 (tt[tk] == PA || tt[tk] == MA || tt[tk] == DA || tt[tk] == SA || tt[tk] == OA || tt[tk] == AA || tt[tk] == XA || tt[tk] == SHR || tt[tk] == SHL || tt[tk] == MS) {
        若 (lv_uninit_n > 0) { sprintf(g_errbuf, "明确初始化: 变量 '%s' 未初始化就读取 (复合赋值隐含读, 声明须初始化或先赋值, v3.0 #78)", lv_uninit[0]); emit_error("A4001", g_errbuf); } /* 接入 2026-08-28 机制层 #78: x += 3 等价 x = x + 3 (读 x) — 未初始化复合赋值拦截 */
        若 (lv_path_n > 0) { 若 (lv_path_borrow[0]) { sprintf(g_errbuf, "借用检查: 字段/元素 '%s' 被可变借用 (独占), 不能读取 (v3.0 #33/#34)", lv_path[0]); emit_error("A3001", g_errbuf); } 否 { sprintf(g_errbuf, "所有权错误: 字段/元素 '%s' 已移动 (部分移动后源字段失效, v3.0 #17)", lv_path[0]); emit_error("A3101", g_errbuf); } } /* 2026-08-28 P1 #33/#34/#17: 复合赋值隐含读 — 路径缓冲拦截 */
        borrow_write_policy(n); /* 借用自动化 (2026-08-28 完善): 复合赋值=写 → 只读借用自动放还, 可变借用 [ERR] (原此路径无借用检查, 与 = 不一致) */
        整 o = tt[tk++];
        整 op = (o == PA) ? PK : (o == MA) ? MK : (o == DA) ? DK : (o == SA) ? DV : (o == OA) ? OR : (o == AA) ? AN : (o == XA) ? XR : (o == SHR) ? SR : (o == MS) ? MD : SH; /* fix 2026-08-05: MS=%= → MD (remainder); was SA→DV so %= divided */
        整 ovf2 = -1; /* 2026-08-28 P1 #260 复合赋值重载: a op= b → 重载函数(a, b) 若注册 */
        若 (ov_n > 0 && n >= 0 && nt[n] == 1) { 整 si2 = var_stidx((字*)(nn + n)); 若 (si2 >= 0) { 字 *tyn2 = stypes[si2].name; 遍 (整 k = 0; k < ov_n; k++) 若 (ov_op[k] == (字)op && !strcmp(ov_ty[k], tyn2)) { ovf2 = k; 断; } } }
        若 (ovf2 >= 0) { 整 rhs2 = asgn(); 整 call2 = Nd(4); Nc(call2, n); Nc(call2, rhs2); { 整 fn = Nd(1); memcpy((字*)(nn + fn), ov_fn[ovf2], 64); Nc(call2, fn); } 整 a2 = Nd(10); Nc(a2, n); Nc(a2, call2); 返 a2; } /* a = 重载函数(a, b) */
        整 a = Nd(10); 整 bin = Nd(2); nv[bin] = op;
        Nc(a, n); Nc(bin, n); Nc(bin, asgn()); Nc(a, bin); /* a op= b → a = a op b */
        返 a;
    } 若 (!move_dst_parsing && lv_moved_n > 0) { sprintf(g_errbuf, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能读取 (v3.0 #5)", lv_moved[0]); emit_error("A3101", g_errbuf); } /* 接入 2026-08-28 机制层 #5: 非赋值场景左值即右值读取 — 缓冲里的 moved 变量报错; 移入 dst 解析期跳过 (dst 是写目标, 可为已移动变量) */ 若 (!move_dst_parsing && lv_uninit_n > 0) { sprintf(g_errbuf, "明确初始化: 变量 '%s' 未初始化就读取 (声明须初始化或先赋值, v3.0 #78)", lv_uninit[0]); emit_error("A4001", g_errbuf); } /* 接入 2026-08-28 机制层 #78: 非赋值场景左值即右值读取 — 缓冲里的未初始化变量报错; 移入 dst 解析期跳过 (移入=初始化, fix 2026-08-28 #78回归: 移入 b,a 的 b 未初始化被误伤) */ 若 (!move_dst_parsing && lv_path_n > 0) { 若 (lv_path_borrow[0]) { sprintf(g_errbuf, "借用检查: 字段/元素 '%s' 被可变借用 (独占), 不能读取 (v3.0 #33/#34)", lv_path[0]); emit_error("A3001", g_errbuf); } 否 { sprintf(g_errbuf, "所有权错误: 字段/元素 '%s' 已移动 (部分移动后源字段失效, v3.0 #17)", lv_path[0]); emit_error("A3101", g_errbuf); } } /* 2026-08-28 P1 #33/#34/#17: 成员/元素路径读检查 — asgn 对所有表达式设 lhs=1, 路径读=非写目标时事后判定 (写目标已在 AK 分支清缓冲+写策略处理) */ 返 n; }
静 整 pipe_chain(空) { 整 n = asgn(); 循环 (tt[tk] == PIPE) { tk++; 整 f = asgn(); 整 call = Nd(4); Nc(call, n); Nc(call, f); n = call; } 返 n; } /* 接入 2026-08-27 管道操作符: a |> f = f(a) — call 节点 callee 是最后 Nc (case 4 L11080 反向找), 参数先挂 (fix 2026-08-27: 原 f 先挂 n0 → callee 变 a 字面量 → 垃圾函数名崩) */
静 整 expr(空) { parse_depth++; 若 (parse_depth > 350) budget_fail("表达式递归深度", 350); 整 _er = pipe_chain(); parse_depth--; 返 _er; } /* 资源护栏 9b (2026-08-28): 深括号/三元/嵌套调用递归护栏 — 实测每层 expr 链烧 10-20 栈帧, 崩溃点 ~500-800, 护栏 350 安全线下; 超限 A5001 确定性拒绝 (防栈溢出 0xC0000005) */

/* fix 2026-08-24 t35t: 循环条件顶层逗号表达式 — `} while (prev_ch = p_ch, (p_ch = *++p) != ']')`
   原 expr() 对顶层逗号 (非括号内) 只取第一部分 → 条件后半 (p_ch=*++p)!=']' 丢成循环后孤立表达式
   → do-while 循环体永不更新 p_ch → wildmatch dowild '[' 字符类死循环.
   逗号列表包成 block: 顺序执行各表达式, 最后表达式结果 = 条件值 (与 for-step 逗号列表同法). */
静 整 expr_comma(空) {
    整 n = expr();
    若 (tt[tk] == CK) {
        整 sb = Nd(5); Nc(sb, n);
        循环 (tt[tk] == CK) { tk++; Nc(sb, expr()); }
        n = sb;
    }
    返 n;
}

/* local ARRAY brace init: int a[3]={1,2,3}; -> a[0]=1; a[1]=2; a[2]=3; */
静 整 gi_idx[8];  /* 全局多维初始化游标 (fix 2026-08-05) */
静 整 str_row = 0; /* string-init row counter: char rows filled in order (fix 2026-08-05) */

静 整 arr_blk = -1; 静 整 arr_blk_root = -1; 静 整 arr_blk_cnt = 0; /* fix 2026-08-06: 数组初始化器块链（每块 ≤200 赋值, 链子块; arr_blk_root=首块） */
静 空 arr_chain_add(整 asgn) {
    若 (arr_blk < 0) { arr_blk = Nd(5); arr_blk_root = arr_blk; arr_blk_cnt = 0; }
    若 (arr_blk_cnt >= 200) { 整 nb = Nd(5); Nc(arr_blk, nb); arr_blk = nb; arr_blk_cnt = 0; }
    Nc(arr_blk, asgn);
    arr_blk_cnt++;
}
静 空 brace_arr_init(整 b, 整 d, 整 *dims, 整 nd, 整 depth, 整 esz) {
    /* 递归初始化器: int a[2][3] = {1,2,3,4,5,6} 或 {{1,2,3},{4,5,6}}
       gi_idx[0..nd-1] = 完整多维游标。遇 { 下钻深度, 遇值生成 a[i][j]... = expr。
       顶层扁平(无内层 {)用低位进位; 嵌套行递归只推进本层列, 行由外层 FK 推进。
       本函数自管 { } 配平 (fix 2026-08-05) */
    若 (depth == 0) {
        arr_blk = -1; arr_blk_root = -1; arr_blk_cnt = 0;
        /* fix 2026-08-23 t49f: C99 aggregate init zeroes unlisted elements -- brace_fields
           did this for structs but brace_arr_init did not; `struct ce *src[9] = { NULL, }`
           left src[1..8] as stack garbage -> git status crashed (oneway_diff tree=src[1]=garbage).
           memset whole array first; explicit initializers below override. */
        整 zaddr = Nd(11); Nc(zaddr, d);
        整 zcall = Nd(4);
        整 zcallee = Nd(1); memcpy((字*)(nn + zcallee), "memset", 7);
        Nc(zcall, zaddr);
        整 zz = Nd(0); nv[zz] = 0; Nc(zcall, zz);
        整 ztot = esz;
        遍 (整 zi = 0; zi < nd; zi++) ztot *= dims[zi];
        整 zsz = Nd(0); nv[zsz] = ztot; Nc(zcall, zsz);
        Nc(zcall, zcallee);
        arr_chain_add(zcall);
    }
    若 (tt[tk] == FK) tk++; /* 本层 '{' */
    整 has_nested = (tt[tk] == FK); /* 本层是否为嵌套行模式 */
    循环 (tt[tk] != UK) {
        若 (tt[tk] == CK || tt[tk] == SK) { tk++; 续; }
        若 (tt[tk] == UK) 断;
        若 (tt[tk] == LB) { /* Phase 2: designated initializer [idx] = expr (fix 2026-08-11) */
            整 dsubs[8]; 整 dn_cnt = 0;
            循环 (tt[tk] == LB) { /* 支持多维 [i][j] 设计器 */
                tk++; /* [ */
                整 dn = expr();
                整 didx = (dn > 0 && nt[dn] == 0) ? nv[dn] : -1; /* 常量下标: expr() 返回 Nd(0) 节点, nv 存值 */
                若 (didx < 0) { 循环 (tt[tk] != CK && tt[tk] != UK && tt[tk] != EK) tk++; 续; }
                若 (tt[tk] == RB) tk++; /* ] */
                若 (dn_cnt < 8) dsubs[dn_cnt++] = didx;
            }
            若 (tt[tk] == AK) tk++; /* = */
            /* 跳到指定下标: 顶层扁平 → gi_idx[0..dn_cnt-1]=dsubs (其余维清零); 嵌套行 → 本层 depth */
            若 (depth == 0) {
                遍 (整 i = 0; i < nd; i++) gi_idx[i] = 0;
                遍 (整 i = 0; i < dn_cnt; i++) gi_idx[i] = dsubs[i];
            } 否 {
                gi_idx[depth] = dsubs[0];
            }
            /* 落 leaf 消费值 (C99: [2]=9 后随值落 a[3] — leaf 的 ++ 推进保持语义) */
        }
        若 (tt[tk] == FK && depth < nd - 1) { /* nested row { ... } */
            gi_idx[depth + 1] = 0; /* reset the child cursor (fix: next row continued from the previous row's column) */
            brace_arr_init(b, d, dims, nd, depth + 1, esz); /* 递归开头统一吃 '{' (fix 2026-08-05: FK also tk++'d → double-ate on 3D) */
            gi_idx[depth]++; /* 行推进 */
            续;
        }
        若 (tt[tk] == STR && esz <= 1) { /* char 行 = 字符串: char s[2][4] = {"ab","cd"} — copy the string BYTES into the row (fix 2026-08-05: was stored as a string ADDRESS → garbage); fix 2026-08-13: 指针数组 char *arr[] = {"A"} esz=8 → 走 leaf 存地址 (原 copy bytes → 元素=字符 → 解引用崩溃) */
            整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32);
            字 *sval = str_tbl[tv[tk]]; tk++;
            整 row_sz = dims[nd - 1] ? dims[nd - 1] : 1;
            /* 行号 → 前 nd-1 维索引（从次内层展开，独立于嵌套 depth） */
            整 rem = str_row;
            整 idxs[8];
            遍 (整 i = nd - 2; i >= 0; i--) { idxs[i] = rem % (dims[i] ? dims[i] : 1); rem /= (dims[i] ? dims[i] : 1); }
            整 node = idn;
            遍 (整 i = 0; i < nd - 1; i++) {
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = idxs[i];
                Nc(acc, idx);
                node = acc;
            }
            整 len = (整)strlen(sval);
            若 (len > row_sz) len = row_sz;
            遍 (整 k = 0; k < len; k++) {
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = k;
                Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc);
                整 cn = Nd(0); nv[cn] = (无 字)sval[k];
                Nc(asgn, cn);
                arr_chain_add(asgn);
            }
            若 (len < row_sz) { /* NUL-terminate (C: the rest of the char row is zeroed) */
                整 acc = Nd(14); Nc(acc, node);
                整 idx = Nd(0); nv[idx] = len;
                Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc);
                整 cn = Nd(0); nv[cn] = 0;
                Nc(asgn, cn);
                arr_chain_add(asgn);
            }
            str_row++;
            续;
        }
        /* leaf: a[gi_idx[0]][gi_idx[1]]...[gi_idx[nd-1]] = expr */
        若 (tt[tk] == FK) { /* struct element initializer { ... }: parse into elem fields (fix 2026-08-15: commands[] global array of structs was skipped -> get_builtin found nothing) */
            整 si = var_stidx((字*)(nn + d)); /* local struct arrays now take this path too (fix 2026-08-16: help.c cmd_version local options[] was skipped -> opts->argh garbage -> strcspn(NULL-ish) crash) */
            若 (si >= 0) {
                整 idn2 = Nd(1); memcpy((字*)(nn + idn2), (字*)(nn + d), 32);
                整 node2 = idn2;
                遍 (整 i = 0; i < nd; i++) {
                    整 acc2 = Nd(14); Nc(acc2, node2);
                    整 idx2 = Nd(0); nv[idx2] = gi_idx[i];
                    Nc(acc2, idx2);
                    node2 = acc2;
                }
                tk++; /* skip { */
                整 sub = brace_fields(si, node2);
                若 (sub >= 0) { 遍 (整 k = 0; k < 256; k++) { 整 c = child_i(sub, k); 若 (c > 0) arr_chain_add(c); } }
                若 (tt[tk] == UK) tk++; /* closing } */
                若 (depth == 0 && !has_nested) { 遍 (整 i = nd - 1; i >= 0; i--) { gi_idx[i]++; 若 (gi_idx[i] < dims[i]) 断; gi_idx[i] = 0; } } 否 { gi_idx[depth]++; }
                续;
            }
            整 d2 = 1; tk++;
            循环 (tk < TS && d2 > 0) { 若 (tt[tk] == FK) d2++; 否 若 (tt[tk] == UK) { d2--; 若 (d2 <= 0) { tk++; 断; } } tk++; }
            若 (depth == 0 && !has_nested) { 遍 (整 i = nd - 1; i >= 0; i--) { gi_idx[i]++; 若 (gi_idx[i] < dims[i]) 断; gi_idx[i] = 0; } } 否 { gi_idx[depth]++; }
            续;
        }
        整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32);
        整 node = idn;
        遍 (整 i = 0; i < nd; i++) {
            整 acc = Nd(14); Nc(acc, node);
            整 idx = Nd(0); nv[idx] = gi_idx[i];
            Nc(acc, idx);
            node = acc;
        }
        整 asgn = Nd(10); Nc(asgn, node); Nc(asgn, expr());
        arr_chain_add(asgn);
        /* advance: top-level flat → little-endian carry; nested rows → this row's column */
        若 (depth == 0 && !has_nested) {
            遍 (整 i = nd - 1; i >= 0; i--) {
                gi_idx[i]++;
                若 (gi_idx[i] < dims[i]) 断;
                gi_idx[i] = 0;
            }
        } 否 {
            gi_idx[depth]++;
        }
    }
    若 (tt[tk] == UK) tk++; /* 本层 '}' */
    若 (depth == 0 && arr_blk_root >= 0) Nc(b, arr_blk_root); /* fix 2026-08-06: 根块挂到顶层块 */
}

/* C99 compound literal: (T){ init } — 匿名自动存储期临时对象 (fix 2026-08-11 Phase 2-3).
   cast 分支在 ')' 后见 FK 时调用。注册 _cl<N> 临时变量, 复用 brace_fields/brace_arr_init 填充,
   初始化块挂到 cl_blk (blk() 当前块), 返回临时对象的地址节点 (Nd(1)). */
静 整 cl_cnt = 0; /* 2026-08-28 可重入修复: 复合字面量临时名计数器 — reset_compile_state 每编译重置 */
静 整 rng_seq = 0; /* 2026-08-28 可重入修复: for-range 临时名计数器 — reset_compile_state 每编译重置 (原函数内静态跨编译累积 → 第 2 次编译临时名漂移) */
静 整 er_seq = 0; /* 2026-08-28 可重入修复: 错 union 临时名计数器 — reset_compile_state 每编译重置 */
静 整 compound_literal(整 is_struct, 整 si, 整 is_array, 整 arr_n, 整 arr_esz) {
    字 vn[64]; memset(vn, 0, 64); snprintf(vn, 32, "_cl%d", cl_cnt++); /* 2026-08-28 编译DAG: memset 清零 — snprintf 尾部不置零, memcpy(nn,vn,32) 拷栈垃圾 → nn 哈希非确定 (功能无害, 过程级哈希须确定性) */
    整 b = Nd(5); /* block: decl + init assigns */
    整 d = Nd(7); memcpy((字*)(nn + d), vn, 32); /* decl node */
    整 init_blk = Nd(5); /* init assignments (挂到 cl_blk) */
    若 (is_array) {
        若 (arr_n <= 0) { /* (T[]){} : 数 FK 内顶层元素数推断 dims */
            整 save_tk = tk; 整 cnt = 0; 整 depth0 = 1; tk++; /* skip { */
            循环 (tk < TS && depth0 > 0) {
                若 (tt[tk] == FK) depth0++;
                否 若 (tt[tk] == UK) { depth0--; 若 (depth0 == 0) 断; }
                否 若 (tt[tk] == CK && depth0 == 1) cnt++;
                tk++;
            }
            arr_n = cnt + 1;
            tk = save_tk;
        }
        var_array(vn, arr_n, arr_esz);
        Nc(b, d); /* declare */
        整 idn = Nd(1); memcpy((字*)(nn + idn), vn, 32);
        整 dims[1]; dims[0] = arr_n;
        tk++; /* skip { */
        brace_arr_init(init_blk, idn, dims, 1, 0, arr_esz);
    } 否 若 (is_struct) {
        var_struct(vn, si);
        Nc(b, d);
        整 idn = Nd(1); memcpy((字*)(nn + idn), vn, 32);
        tk++; /* skip { 先跳 FK (brace_fields 从 FK 后开始) */
        整 bi = brace_fields(si, idn);
        Nc(init_blk, bi);
        若 (tt[tk] == UK) tk++; /* } */
    } 否 { /* scalar: (T){5} → 临时 = 5 (C99: 标量 compound literal 是值, 非地址) */
        tk++; /* skip { */
        整 val = expr(); /* { 后的表达式值 */
        若 (tt[tk] == UK) tk++; /* } */
        /* 标量不需要临时变量 — 直接返回值 */
        返 val;
    }
    /* 声明挂当前块, 初始化挂 cl_blk (compound literal 语义: 初始化在包含语句前执行) */
    若 (cl_blk >= 0) Nc(cl_blk, b);
    若 (cl_blk >= 0) Nc(cl_blk, init_blk);
    整 n = Nd(1); memcpy((字*)(nn + n), vn, 32); /* 返回临时对象地址 */
    返 n;
}
静 整 const_expr_eval(整 *val); /* fwd (fix 2026-08-15: blk 内局部数组维度用常量表达式) */
静 整 blk(空) {
    整 b = Nd(5); tk++;
    parse_depth++; 若 (parse_depth > 350) budget_fail("块递归深度", 350); /* 资源护栏 9b (2026-08-28): 深块嵌套 {{{{...}}}} 递归护栏 (块每层 2-3 帧, 与表达式共用计数, 上限统一 350 安全线下) */
    borrow_depth++; /* 接入 2026-08-28 机制层 #4: 生命周期=词法块作用域 — 进入块深度+1, 块内借用记 scope, 块退出自动放还 */
    uninit_depth++; /* 接入 2026-08-28 机制层 #78: 未初始化变量表块深度 — 块退出清除本块声明 */
    整 b_root = b;  /* first block = sequence root; extra blocks chain as children */
    整 blk_vstart = vcnt; /* fix 2026-08-19: 本块直接声明的变量起点 — 结束时给未标记 blk_start/blk_end 的变量 (本块直接声明) 打上本块范围, 嵌套块的变量已由嵌套 blk() 标记, 不会被覆盖 */
    blk_vs[b_root] = blk_vstart; /* codegen 作用域判定: 本块 var 下界 */
    整 cl_prev = cl_blk; cl_blk = b; /* compound literal 初始化挂当前块 (fix 2026-08-11) */
    整 b_cnt = 0;   /* children attached to current block (keep 256-slot headroom) */
    
    循环 (tt[tk] != UK && tt[tk] != EK) { /* fix 2026-08-07: 缺 } 时 EK 防死循环 (原 while != UK 遇 EOF 转空 + tk 越界崩溃) */
        alignas_pending = 0; ag_struct = 0; /* fix 2026-08-25 step21: 每块语句清残留 — 变量前 _Alignas 不消费也不毒害后续声明; step25: ag_struct 同步清 */
        若 (tt[tk] == AG) { 整 agv = tv[tk]; tk++; 若 (tt[tk] == ST) { ag_struct = agv; alignas_pending = 0; } 否 alignas_pending = agv; } /* fix 2026-08-25 step21: 块级 _Alignas(N) — struct 前修饰 struct 变量 (step25), 否则给变量 (下一轮清理) */
        
        若 (b_cnt >= 200) { /* block near its 256 child slots: chain a new sub-block
                               (cg case 5 recurses into nested blocks). main()'s body
                               has ~270 statements �?without this, Nc() silently drops
                               everything past the 256th. */
            整 nb = Nd(5);
            Nc(b, nb);
            b = nb;
            b_cnt = 0;
        }
        若 (tt[tk] == VR && (!strcmp(tn[tk], "__asm__") || !strcmp(tn[tk], "__asm"))) { /* 内联汇编: 跳过 (fix 2026-08-14: malloc.c.h/sha1.c 的 __asm__ 内存屏障 → undefined symbol) */
            tk++; /* __asm__ */
            若 (tt[tk] == VR && (!strcmp(tn[tk], "__volatile__") || !strcmp(tn[tk], "volatile"))) tk++; /* __volatile__ */
            若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } /* 跳过 (asm body) */
            若 (tt[tk] == SK) tk++; /* ; */
            续;
        }
        若 (tt[tk] == ST || (tt[tk] == VK && (!strcmp(tn[tk], "static") || !strcmp(tn[tk], "const") || !strcmp(tn[tk], "volatile")) && tt[tk + 1] == ST) || (tt[tk] == VR && !strcmp(tn[tk], "register") && tt[tk + 1] == ST) || (tt[tk] == VK && !strcmp(tn[tk], "static") && tt[tk + 1] == VK && (!strcmp(tn[tk + 1], "const") || !strcmp(tn[tk + 1], "volatile")) && tt[tk + 2] == ST)) {
            /* function-local struct var: [static] [const] [volatile] [register] struct C c; (fix 2026-08-15: static const struct opentry; register struct _obstack_chunk *chunk; fix 2026-08-29 csmith: volatile struct S0 **l_299 原不认 volatile → 声明跳过 → 未定义函数) */
            
            整 is_static = (tt[tk] == VK && !strcmp(tn[tk], "static"));
            若 (is_static) tk++; /* static */
            若 (tt[tk] == VR && !strcmp(tn[tk], "register")) tk++; /* register 存储类忽略 (fix 2026-08-15: obstack.c _obstack_begin chunk undefined) */
            循环 (tt[tk] == VK && (!strcmp(tn[tk], "const") || !strcmp(tn[tk], "volatile"))) tk++; /* const/volatile */
            tk++; /* struct */
            整 si = -1;
            若 (tt[tk] == VR) { si = st_find(tn[tk]); tk++; } /* tag name C */
            /* fix 2026-08-17: 无 body 的局部 struct 变量声明 — 指针/指针数组/struct 数组/逗号.
               blk() 原仅「有 body」注册变量 (struct P {...} p), 无 body 漏 → 变量未注册 →
               外部符号 UND (cat-file.c cmd, add-patch.c colored, show-branch.c rev/commit,
               upload-pack.c pfd). */
            若 (tt[tk] != FK && (tt[tk] == DK || (tt[tk] == VR && (tt[tk + 1] == LB || tt[tk + 1] == CK || tt[tk + 1] == AK)))) {
                整 is_ptr = (tt[tk] == DK);
                整 ptr_depth = 0;
                循环 (tt[tk] == DK) { is_ptr = 1; ptr_depth++; tk++; 循环 (tt[tk] == VK && (!strcmp(tn[tk], "const") || !strcmp(tn[tk], "volatile"))) tk++; } /* fix 2026-08-20: 数指针层级 — struct X ** 原只消费一个 * → 第二个 * 残留 → VR 检查失败 → 声明被跳过 → 变量走隐式注册 p_esz=4 → prune_directory src/dst 步进/缩放全错 → add 丢文件; fix 2026-08-30 csmith t5: 指针链中间 const/volatile (struct S0 ** volatile * volatile *volatile *l — s116/s162 原残留 → 变量未注册 → 未定义函数) */
                若 (tt[tk] == OK && tt[tk + 1] == VR && (tt[tk + 2] == LB || tt[tk + 2] == KK)) {
                    /* struct X *(name[N]) paren-array (fix 2026-08-23: builtin_diff_tree oid[2] unregistered) */
                    tk++; /* ( */
                    字 vnp2[64]; strcpy(vnp2, tn[tk]); tk++; /* name */
                    整 cntp2 = 1;
                    循环 (tt[tk] == LB) {
                        tk++; 若 (tt[tk] == NK) { cntp2 = tv[tk]; tk++; }
                        否 若 (tt[tk] == VR) { 整 evc2 = e_lookup(tn[tk]); 若 (evc2 == 0x80000000) evc2 = macro_find(tn[tk]); 若 (evc2 != 0x80000000 && evc2 != -1) cntp2 = evc2; tk++; }
                        若 (tt[tk] == RB) tk++;
                    }
                    若 (tt[tk] == KK) tk++; /* ) */
                    整 esz_p = is_ptr ? 8 : (si >= 0 ? stypes[si].sz : 4);
                    若 (is_static) var_static_arr(vnp2, 0, esz_p, cntp2);
                    否 var_array(vnp2, cntp2, esz_p);
                    vars[vcnt - 1].st_idx = si;
                    若 (is_ptr) { vars[vcnt - 1].p_depth = ptr_depth; vars[vcnt - 1].p_inner = si >= 0 ? stypes[si].sz : 4; }
                    整 d3 = Nd(7); memcpy((字*)(nn + d3), vnp2, 32);
                    Nc(b, d3); b_cnt++;
                    循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                    若 (tt[tk] == SK) tk++;
                    续;
                }
                若 (tt[tk] == VR) {
                    字 vn[64]; strcpy(vn, tn[tk]); tk++;
                    整 d = Nd(7); memcpy((字*)(nn + d), vn, 32);
                    整 scnt = 1;
                    整 is_arr = 0; /* 数组声明标记 (fix 2026-08-18: static struct 数组误走栈帧 var_array → .data 槽全 0 → path.c pathname_array gitdir 乱码) */
                    整 sdims = 0; 整 sadim[8] = {0}; /* fix 2026-08-29 csmith: 每维大小 — 原只乘扁平 scnt, 局部 2D struct 数组 brace init {{..},{..}} 按扁平 nd=1 解析, 行闭合 } 提前断 → 只初始化第一行; 独立声明 (逗号声明+数组{init} qcc 自编译不消费 ={ 会错位) */
                    若 (tt[tk] == LB) { /* struct Tag *arr[N] / struct Tag arr[N] */
                        is_arr = 1;
                        scnt = 1;
                        整 unsized = 0;
                        循环 (tt[tk] == LB) {
                            tk++; 整 cdim = 0;
                            若 (const_expr_eval(&cdim)) { 若 (sdims < 8) sadim[sdims] = cdim; sdims++; scnt *= cdim > 0 ? cdim : 1; }
                            否 { 若 (tt[tk] == RB) unsized = 1; 否 { 循环 (tk < TS && tt[tk] != RB && tt[tk] != EK) tk++; } }
                            若 (tt[tk] == RB) tk++;
                        }
                        若 (unsized && tt[tk] == AK && tt[tk + 1] == FK) { /* struct Tag a[] = { {..}, .. } 未定长: 推断元素数 (fix 2026-08-18: fsck.c fsck_describe_object bufs[] — 原 scnt=1 → 只分配 1 元素槽 → bufs[1..3] 越界写坏邻 .data 槽) */
                            整 save_u = tk; 整 n = 1, d0 = 0; tk += 1; /* 落外层 { (镜像具名分支推断) */
                            循环 (tk < TS) {
                                若 (tt[tk] == FK) { /* 跳过内层初始化器 { ... } — struct 元素内部逗号不算分隔 (fix step25: 原把 {1,0} 内逗号数进 → SA[] 推断 2 而非 3 → 槽分配少 → 邻变量重叠) */
                                    整 sd = 1; tk++;
                                    循环 (tk < TS && sd > 0) { 若 (tt[tk] == FK) sd++; 否 若 (tt[tk] == UK) { sd--; 若 (sd <= 0) { tk++; 断; } } tk++; }
                                    续;
                                }
                                若 (tt[tk] == OK || tt[tk] == LB) d0++;
                                否 若 (tt[tk] == KK || tt[tk] == RB) { d0--; 若 (d0 == 0) { tk++; 断; } }
                                否 若 (tt[tk] == UK && d0 == 0) { tk++; 断; } /* 外层 } 结束 */
                                否 若 (tt[tk] == CK && d0 == 0 && tt[tk + 1] != UK) n++; /* 顶层元素逗号, 尾逗号不计 */
                                tk++;
                            }
                            tk = save_u;
                            scnt = n;
                            若 (sdims == 1 && sadim[0] == 0) { sadim[0] = n; } /* 未定长第一维推断 */
                        }
