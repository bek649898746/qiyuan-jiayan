                整 _b = name_start - 1; /* 宏名起始前一个字符 (与 ( 之间是否空白无关) */
                循环 (_b > 0 && (seg[_b] == ' ' || seg[_b] == '\t' || seg[_b] == '\r' || seg[_b] == '\n')) _b--;
                循环 (_b > 0 && seg[_b] == '*') { _b--; 循环 (_b > 0 && (seg[_b] == ' ' || seg[_b] == '\t' || seg[_b] == '\r' || seg[_b] == '\n')) _b--; } /* 跳过指针返回类型 char *_(...) — 否则 gettext.h 的 static inline _ 被当宏调用展开 (fix 2026-08-15: undefined symbol '_') */
                整 _is_decl = 0;
