}
/* 局部 signed char 变量读取: movsx eax, byte [rbp+disp] (符号扩展, fix 2026-08-29 csmith) */
静 空 movsx_eax_mbrp(整 disp) {
    asm_emit("    符号扩展字节 r0, [rbp%+d]\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0);
    b(0x0F); b(0xBE); b(0x85); b4(disp); /* movsx eax, byte [rbp+disp] */
}
/* 局部 short 变量读取: movzx eax, word [rbp+disp] (零扩展, uint16_t/unsigned short, fix 2026-08-25 bug#31b) */
静 空 movzx_eax_mbrp_w(整 disp) {
    asm_emit("    零扩展字 r0, [rbp%+d]\n", (字*)(长 长)(disp), (字*)(长 长)0, (字*)(长 长)0);
    b(0x0F); b(0xB7); b(0x85); b4(disp); /* movzx eax, word [rbp+disp] */
}
/* 局部 signed short 变量读取: movsx eax, word [rbp+disp] (符号扩展, fix 2026-08-25 bug#31b) */
静 空 movsx_eax_mbrp_w(整 disp) {
