                    }
                    否 若 (g_is_fnptr) { var_static(gname, 4); vars[var_last_idx].arr_esz = 8; 若 (g_fptr_dbl) vars[vcnt - 1].p_dbl = 1; } /* typedef'd fnptr var: 8-byte .data slot */
                    否 若 (g_stidx >= 0 && ptrd == 0) var_static_struct(gname, g_stidx, 1); /* struct var (fix 2026-08-17: ptrd>0 的 struct 指针必须走 var_static — 原 var_static_struct 注册成 struct 值 → gptr=&s 初始化写穿/读 NULL, git startup_info 崩) */
                    否 若 (g_stidx >= 0) { var_static(gname, 4); vars[var_last_idx].p_esz = (ptrd >= 2) ? 8 : stypes[g_stidx].sz; vars[vcnt - 1].st_idx = g_stidx; vars[vcnt - 1].p_depth = ptrd; 若 (ptrd >= 2) vars[vcnt - 1].p_inner = stypes[g_stidx].sz; } /* struct 指针: 8 字节 .data 槽 + p_esz=struct 大小 (p[i] 缩放, 仅单指针) + st_idx (fix 2026-08-17; fix 2026-08-21 #21: 双指针 struct T ** 元素是指针 → p_esz=8, p_depth/ptrd 记录) */
