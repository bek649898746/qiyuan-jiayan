          整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, e_val); Nc(bd, asg); } /* dst[__fl] = val; */
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
