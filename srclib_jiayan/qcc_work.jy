                        否 若 (afsz11 == 1) { 若 (st_field_csgn(stypes[si11].name, fn)) ir_emit(I_MOVSX_RAX_BYTE, 0, 0, 0); 否 ir_emit(I_MOVZX_RAX_BYTE, 0, 0, 0); } /* Phase3-IR case15: &e->f char (fix 2026-08-29 csmith: int8_t 字段 movsx) */
                        否 若 (afsz11 == 2) { 若 (st_field_is_uns(stypes[si11].name, fn)) ir_emit(I_MOVZX_RAX_WORD, 0, 0, 0); 否 ir_emit(I_MOVSX_RAX_WORD, 0, 0, 0); } /* Phase3-IR case15: &e->f short (fix 2026-08-30 csmith s172: int16_t 字段 movsx — 原恒 MOVZX) */
                        否 { ir_emit(I_DEREF32, 0, 0, 0); } /* Phase3-IR case15: &e->f dword */
