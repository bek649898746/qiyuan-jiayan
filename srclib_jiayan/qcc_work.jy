                            若 (g_is_uns) vars[vcnt - 1].is_uns = 1; /* fix 2026-08-29 csmith: 全局 uint 数组元素 is_uns → 传参零扩展 (s175 g_2[i][j]) */
                            若 (g_is_short) vars[vcnt - 1].is_short = 1;
                            若 (g_is_uns) vars[vcnt - 1].is_uns = 1;
