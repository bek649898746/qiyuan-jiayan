    否 { asm_emit("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */ }
    mov_rr64(3, 0); /* rbx = 64-bit value */
    emit_ll_digits(lfmt); /* %lld: print rbx 64 位, return to fmt loop */
    set_label(lld32);
    mov_eax_mr13(); /* eax = [r13] */
    若 (fmt_va_forward) { asm_emit("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3, 0, 5); b(8); /* add r13, 8 */ }
    否 { asm_emit("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3, 5, 5); b(8); /* sub r13, 8 */ }
    mov_rr(3, 0); /* ebx = value (saved) */
