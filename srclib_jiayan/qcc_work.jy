    若 (tt[tk] == VR && (!strcmp(tn[tk], "峰值") || !strcmp(tn[tk], "谷值"))) { /* 接入 2026-08-28 峰值/谷值 (argmax/argmin): 峰值 idx, arr, n; → { idx=0; __pk=0; __pi=1; while(__pi<n){ if(arr[__pi] > arr[__pk]){ __pk=__pi; } __pi++; } idx=__pk; } — 返回极值下标, 复用最大/最小比较模式 */
