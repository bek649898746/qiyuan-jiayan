                        若 (tsi < 0) { tsi = st_add(td_stname); }
                        strcpy(stypes[tsi].name, td_stname);
                        tk++; /* { */
                        整 tfuns = 0; /* unsigned bit-field marker (fix 2026-08-05) */
                        循环 (tk < TS && tt[tk] != UK) {
                            整 fsz = 4; 整 frow = 1; 整 dims = 0; 整 first = 1; 整 fdbl = 0;
                            若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) tfuns = 1; 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { fsz = 1; } 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; fdbl = 1; } tk++; }
                            循环 (tt[tk] == DK) { fsz = 8; tk++; } /* pointer field */
                            若 (tt[tk] == ST) { /* nested struct field */
                                tk++; /* struct */
