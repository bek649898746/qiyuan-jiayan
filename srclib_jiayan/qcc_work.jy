        }
    }
    }
}

静 整 fn_exp_stack[64]; 静 整 fn_exp_n; /* fix 2026-08-13: 展开栈 — 防宏互递归 A→B→A (self_fmi 只防直接自递归: 展开 A 时 body 调 B → B 展开时 A 又可入 → 无限; Git hashmap_for_each_entry 嵌套链 + revision.c) */
静 整 fn_active[2048]; 静 整 fn_scan_depth; /* fix 2026-08-26 sqlite: fn 宏位置语义 — 只有 #define 之后的调用才展开 (sqlite3Utf8Read 原型在 #define 之前被误展开成 (*((*A)++)) → 声明变表达式 → params 循环死锁) */

/* expand fn-macro calls inside seg (recursive for nested macros) into *out at *o (grows).
   fix 2026-08-07: #x 字符串化 / ## 拼接 / __VA_ARGS__ 变参 / 自引用防递归 / 字符串字面量内不展开 / 参数扫描不拆串内逗号 */
静 字 *fn_arena_blocks[64]; 静 整 fn_arena_block_n; 静 字 *fn_arena_pos; 静 字 *fn_arena_end; /* fix 2026-08-26 cpython/sqlite: fn_macro_expand_to 的 args/exp_args 大缓冲从栈移到堆竞技场 — 16×4096×2=128KB/层 × 递归嵌套 (sqlite3.c 深展开) 爆 1MB 栈 (0xC00000FD); args/exp_args 只在 tmp 构建前存活, 递归前可释放复用. 块链表: 块永不移动, 存活帧的 args/exp_args 裸指针不过期 (单块 realloc 移动基址 → 旧指针失效 → memcpy 写已释放块 → sqlite3.c 0xC0000005); 释放后区域复用, 峰值=最大并发嵌套 */
静 空 *fn_arena_alloc(整 n) {
    若 (!fn_arena_block_n) {
        fn_arena_blocks[0] = malloc(4 << 20);
        若 (!fn_arena_blocks[0]) { fprintf(stderr, "[ERR] OOM fn_arena\n"); exit(1); }
        fn_arena_pos = fn_arena_blocks[0];
        fn_arena_end = fn_arena_blocks[0] + (4 << 20);
        fn_arena_block_n = 1;
    }
    若 (fn_arena_pos + n > fn_arena_end) {
        若 (fn_arena_block_n >= 64) { fprintf(stderr, "[ERR] fn_arena blocks overflow\n"); exit(1); }
        整 nb = 8 << 20;
        fn_arena_blocks[fn_arena_block_n] = malloc(nb);
        若 (!fn_arena_blocks[fn_arena_block_n]) { fprintf(stderr, "[ERR] OOM fn_arena\n"); exit(1); }
        fn_arena_pos = fn_arena_blocks[fn_arena_block_n];
        fn_arena_end = fn_arena_pos + nb;
        fn_arena_block_n++;
    }
    空 *r = fn_arena_pos; fn_arena_pos += n;
    返 r;
}
静 空 fn_arena_release(字 *mark) { fn_arena_pos = mark; } /* LIFO: 释放到 mark (块链表块永不移动, 裸指针永有效); 首建场景 mark=NULL → 下轮 alloc 新建块 (一次性 4MB 浪费, 可接受) */

静 空 fn_macro_expand_to(常 字 *seg, 字 **outp, 整 *o, 整 *cap, 整 self_fmi) {
