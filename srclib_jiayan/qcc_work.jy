            { 整 one = Nd(0); nv[one] = 1; 整 sub2 = Nd(2); nv[sub2] = MK; { 整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32); Nc(sub2, v_n); } Nc(sub2, one); /* n-1 */
              整 v_d3 = Nd(1); memcpy((字*)(nn + v_d3), dname, 32);
