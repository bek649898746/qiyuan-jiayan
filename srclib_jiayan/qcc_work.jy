    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "填充")) { /* 接入 2026-08-27 数组段填充 (fill): 填充 dst, n, val; → { __fl=0; while(__fl<n){ dst[__fl]=val; __fl++; } } — 复用循环+下标赋值机制 */
        tk++; /* 填充 */
