/* PE 魔数（工程化：语义等价 #define，不动点 SHA 不变；fix 2026-08-05） */
#define FILE_ALIGNMENT 0x200
#define IMAGE_BASE 0x400000
#define DATA_RVA_OFF 0x300 /* statics 起点后移：给扩展导入区让位（fix 2026-08-06 BUG-1） */
#define STACK_PAD_SIZE 0x160000
