    mov_r12_al(); asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xFF); b(0xCA); /* dec edx */
    jmp_rel(-1); patch_label(cp-4, lpad, 2);
    set_label(lpdone); }
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
/* %x/%X: unsigned hex digits into [r12] (ebx = value, base 16; upper=1 → 'A'-'F').
   Fix 2026-08-05: %x was an unknown spec → swallowed (no output, no arg consume). */
静 空 emit_hex_digits(整 tail, 整 upper) {
    整 ldig = new_label(), lcpd = new_label(), l0a = new_label(), lchx = new_label();
    lea_r_mbrp(8, scratch_base + 248 + 12 - cur_frame_sz); /* r8 = temp end */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    set_label(ldig);
    asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 16); /* ecx = 16 */
    asm_emit("    无符号除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xF1); /* div ecx: eax=quot, edx=rem */
    asm_emit("    比较字节即 r2, 10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xFA); b(10); /* cmp dl, 10 (fix 2026-08-05: was 比较字节 = asm_zh emits 38 D0 → H2 off-by-one) */
    b(0x0F); b(0x82); b4(0); patch_label(cp-4, l0a, 8); /* jb l0a (dl is 0-15 unsigned: jb == jl here; is_jmp=8=低于跳 matches asm_zh's 0F 82 — fix 2026-08-05) */
    若 (upper) { asm_emit("    加字节 r2, 0x37\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x37); /* add dl, 0x37 = 'A'-10 (%X) */ }
    否 { asm_emit("    加字节 r2, 0x57\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x57); /* add dl, 0x57 = 'a'-10 */ }
    jmp_rel(-1); patch_label(cp-4, lchx, 2);
    set_label(l0a);
    asm_emit("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    set_label(lchx);
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
/* fix 2026-08-09 审计#7: %#x/%#X 前缀 + %0Nx 宽度填充（在 emit_hex_digits 前调用）。
   ebx = 值; sc+232=W; sc+260=#flag; sc+264=0flag; prefix='x'/'X'（调用点传字面量, host/mirror 字节一致）。
   输出顺序: 零填充: 前缀 → pad 个 '0' → digits; 空格/无宽: pad ' ' → 前缀 → digits.
   ⚠️ emit_hex_digits 从 EAX 取值 — 末尾必须恢复 eax = ebx */
静 空 emit_hex_prefix_pad(整 tail, 整 upper, 整 prefix) {
    整 lcount = new_label(), lpre = new_label(), lzp = new_label(), lsp = new_label(), lpref = new_label(), ldigits = new_label();
    /* 数 hex 位数 → r9d（do-while: 值 0 计 1 位; 值留在 ebx, 不碰 eax） */
    mov_rr(8, 3); mov_ri_ext(9, 0); /* r8d = ebx; r9d = 0 */
    set_label(lcount);
    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9d */
    rex(0,0,0,1); b(0xC1); modrm(3, 5, 0); b(4); /* shr r8d, 4 */
    asm_emit("    逻辑右移 r8, 4\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); /* fix 2026-08-12 H2 对等: 裸发射补 asm_emit 文本 (asm_zh 汇编需要) */
    test_rr(8, 8); jnz_rel(-1); patch_label(cp-4, lcount, 3);
    /* pad = W - len - (hash?2:0) */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 232); /* eax = W */
    mov_rr(2, 9); alu_rr(T_MK, 0, 2); /* edx = len; eax = W - len */
    mov_reg_mbrp(1, scratch_base - cur_frame_sz + 260); /* ecx = #flag */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lpre, 1); /* !#: 跳过 -2 */
    mov_r_imm(1, 2); alu_rr(T_MK, 0, 1); /* eax -= 2 */
    set_label(lpre);
    mov_rr(2, 0); /* edx = pad */
    mov_r_imm(1, 0); alu_rr(T_QK, 0, 1); b(0x0F); b(0x8E); b4(0); patch_label(cp-4, lpref, 6); /* cmp eax,0; jle lpref: 无填充直接前缀+digits */
    /* pad > 0: 检查 0 flag */
    mov_reg_mbrp(0, scratch_base - cur_frame_sz + 264); /* eax = 0flag */
    test_rr(0, 0); jz_rel(-1); patch_label(cp-4, lsp, 1); /* jz lsp: 空格填充 (fix 2026-08-12: is_jmp 3→1, 文本非零跳→为零跳, H2 对等) */
    /* 零填充: 先前缀, 再 pad 个 '0' */
    mov_reg_mbrp(1, scratch_base - cur_frame_sz + 260); /* ecx = #flag */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, lzp, 1);
    mov_r_imm(0, '0'); mov_r12_al(); asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4);
    mov_r_imm(0, prefix); mov_r12_al(); asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4);
    set_label(lzp);
    mov_r_imm(0, '0'); mov_r12_al(); asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* mov [r12],'0'; inc r12 */
    asm_emit("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xFF); b(0xCA); /* dec edx */
    jnz_rel(-1); patch_label(cp-4, lzp, 3);
    jmp_rel(-1); patch_label(cp-4, ldigits, 2);
    /* 空格填充: pad 个 ' ' 再前缀 */
    set_label(lsp);
    mov_r_imm(0, ' '); mov_r12_al(); asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4);
    asm_emit("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xFF); b(0xCA); /* dec edx */
    jnz_rel(-1); patch_label(cp-4, lsp, 3);
    /* 前缀(若有) — 空格路径与无填充路径共用 */
    set_label(lpref);
    mov_reg_mbrp(1, scratch_base - cur_frame_sz + 260); /* ecx = #flag */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ldigits, 1);
    mov_r_imm(0, '0'); mov_r12_al(); asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4);
    mov_r_imm(0, prefix); mov_r12_al(); asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4);
    set_label(ldigits);
    mov_rr(0, 3); /* ⚠️ eax = ebx = 值 (emit_hex_digits 从 eax 取值) */
    emit_hex_digits(tail, upper);
}
/* %llx/%llX: 64-bit unsigned hex digits into [r12] (rbx = value, base 16; upper=1 → 'A'-'F'),
   then jmp tail（fix 2026-08-06）。div rcx 无符号 64 位。 */
静 空 emit_ll_hex_digits(整 tail, 整 upper) {
    整 ldig = new_label(), lcpd = new_label(), l0a = new_label(), lchx = new_label();
    lea_r_mbrp(8, scratch_base + 192 + 24 - cur_frame_sz); /* r8 = temp end（复用 ll 临时区 [rbp-56]） */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    set_label(ldig);
    asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 16); /* ecx = 16 */
    asm_emit("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0xF7); modrm(3, 6, 1); /* div rcx */
    asm_emit("    比较字节即 r2, 10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xFA); b(10); /* cmp dl, 10 */
    b(0x0F); b(0x82); b4(0); patch_label(cp-4, l0a, 8); /* jb l0a (dl is 0-15 unsigned) */
    若 (upper) { asm_emit("    加字节 r2, 0x37\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x37); /* add dl, 0x37 = 'A'-10 (%llX) */ }
    否 { asm_emit("    加字节 r2, 0x57\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x57); /* add dl, 0x57 = 'a'-10 */ }
    jmp_rel(-1); patch_label(cp-4, lchx, 2);
    set_label(l0a);
    asm_emit("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    set_label(lchx);
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    asm_emit("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x85); modrm(3, 0, 0); /* test rax, rax */
    jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}

静 整 emit_fmt_loop(整 bound_disp) {
    整 ld = new_label(), ls = new_label(), lch = new_label(), lpct = new_label(), lcp = new_label(), lfmt = new_label(), ldone = new_label(), lf = new_label(), lx = new_label();
    整 lfnum = new_label(), lfrac = new_label(), lfrac2 = new_label(), lfsgn = new_label();
    整 lfsp = new_label(), lfnan = new_label(); /* fix 2026-08-26: %f 的 inf/NaN 特殊输出 (原 cvttsd2si 路径对 inf 输出垃圾) */
    整 le = new_label(), lE = new_label(), lg = new_label(), lG = new_label(); /* %e/%E/%g/%G (fix 2026-08-25 支持矩阵补全) */
    整 lfgt = new_label(); /* 共享浮点格式化核心入口 (fix 2026-08-25: 每个 printf 调用只发射一份, 4 分发存根跳入) */
    /* specifier-prefix parse + %f precision (root-cause 2026-08-03) */
    整 lflag = new_label(), lflags = new_label(), lwidth = new_label(), lprec = new_label();
    整 lplus = new_label(); /* fix 2026-08-23 t35g: %+d / %+05d 恒显正号 */
    整 lsign_pre = new_label(), lsign_done = new_label(); /* fix 2026-08-23 t35g: %d 符号提前输出 */
    整 lwd_nondigit = new_label(); /* fix 2026-08-23 t35g: 宽度后非数字 — 长度前缀回 lflag */
    整 lstrlen = new_label(), lstrlen_done = new_label(), lsnoprec2 = new_label(), lspad = new_label(), lscopy = new_label(); /* fix 2026-08-23 t35h: %s 宽度填充 */
    整 lcp_done = new_label(), lcp_pad = new_label(); /* fix 2026-08-23 t35h: 左对齐 %-s 尾部 pad */
    整 ldot = new_label(), ldig = new_label(), lspec = new_label(), lstar = new_label(); /* fix 2026-08-18: %.*s 星号精度 */
    整 ll_cnt = new_label(), lld32 = new_label(), lu32 = new_label(), lx32 = new_label(), lxU = new_label(), lxU32 = new_label(); /* fix 2026-08-06: %lld/%llu/%llx/%llX 64 位 (ll_cnt=计数, *32=32 位回退; lxU=%X 大写) */
    整 lz = new_label(); /* %z (size_t) → 64 位 (fix 2026-08-23 t35d) */
    整 lstarw = new_label(); /* %*s 宽度参数 (fix 2026-08-23 t35e) */
    整 lscale = new_label(), lscdone = new_label(), ldigl = new_label(), ldigd = new_label();
    整 lu = new_label(); /* %u unsigned decimal (fix 2026-08-05) */
    整 lo = new_label(); /* %o unsigned octal (fix 2026-08-22 t47) */
    整 lI = new_label(); /* Windows I64 modifier %I64u (fix 2026-08-22 t47) */
    整 lp = new_label(); /* %p pointer hex (fix 2026-08-19) */
    整 lfdot = new_label(); /* %.0f: no '.' when N==0 */
    整 lpfmt = new_label(); /* %% -> literal '%' (root-cause 2026-08-03: was swallowed) */
    整 lcnt = new_label(), lcnt2 = new_label(), lcntd = new_label(), lpad = new_label(), lwdone = new_label(); /* %d width padding */
    整 lminus = new_label(), ldleft = new_label(), lleft = new_label(), llpad = new_label(); /* '-' 左对齐 flag + 数字后 padding (fix 2026-08-06) */
    整 lsp = new_label(), lch0 = new_label(), lpade = new_label(); /* fix 2026-08-23 t35e: %0Nd zero-pad */
    整 lhash = new_label(), lzero = new_label(); /* fix 2026-08-09 审计#7: %#x 前缀 + %0Nx 零填充 */
    set_label(lfmt);
    asm_emit("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
    test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ldone, 1);
    mov_r_imm(0, '%'); alu_rr(T_QK, 1, 0); jz_rel(-1); patch_label(cp-4, lpct, 1);
    mov_r12_cl(); /* mov [r12], cl */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
    jmp_rel(-1); patch_label(cp-4, lfmt, 2);
    set_label(lpct);
    asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 (past '%') */
    /* specifier-prefix parse: flags/width/precision must NOT be emitted as literals
       (root-cause 2026-08-03: %.1f printed literal "1f"). Default precision = 6, width = 0. */
    mov_r_imm(0, 6); mov_mbrp_reg(scratch_base - cur_frame_sz + 224, 0);
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 232, 0); /* width W = 0 */
    mov_mbrp_reg(scratch_base - cur_frame_sz + 236, 0); /* explicit-precision flag = 0 (fix 2026-08-05) */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 244, 0); /* LL counter = 0 (fix 2026-08-06: %lld 64位取参; mov_mbrp_reg 第二参是寄存器号，必须先清零 eax) */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 252, 0); /* '-' 左对齐 flag = 0 (fix 2026-08-06) */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 260, 0); /* '#' 前缀 flag = 0 (fix 2026-08-09 审计#7) */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 264, 0); /* '0' 零填充 flag = 0 (fix 2026-08-09 审计#7) */
    mov_r_imm(0, 0); mov_mbrp_reg(scratch_base - cur_frame_sz + 0, 0); /* '+' 恒正 flag = 0 (fix 2026-08-23 t35g) */
