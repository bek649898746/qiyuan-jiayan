    asm_emit("    取反 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xD8); /* neg eax (fix 2026-08-23 t35g: len 不含符号, 符号提前输出) */
