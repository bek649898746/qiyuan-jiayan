            整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, add); /* src[__sl+__sl_lo] */
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(bd, asg); } }
