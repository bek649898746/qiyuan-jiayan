            kids[5] = n5[n]; kids[6] = n6[n]; kids[7] = n7[n]; kids[8] = n8[n]; kids[9] = n9[n];
            kids[10] = n10[n]; kids[11] = n11[n]; kids[12] = n12[n]; kids[13] = n13[n]; kids[14] = n14[n];
            kids[15] = n15[n]; kids[16] = n16[n]; kids[17] = n17[n]; kids[18] = n18[n]; kids[19] = n19[n];
