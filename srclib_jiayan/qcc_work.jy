                            } 否 若 (st_field_is_dbl(stypes[si].name, fname)) {
                                cg_f(n1[n]); push_xmm0(); /* save rhs (xmm0 slot) */
若(off>=0 || (coff_mode && var_isstatic(vname))){ 若 (var_isstatic(vname)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); } 否 { ir_emit(I_LOAD_RBP, 0, off - cur_frame_sz, 0); ir_flush(); } } /* Phase3-IR case10: rax = ptr */
                                否 {mov_r_imm(0,0);} /* ptr=0 if not found */
                                若(foff!=0){ ir_emit(I_ADD_EAX_IMM8, foff, 0, 0); ir_flush(); } /* Phase3-IR case10: 偏移 */
                                pop_xmm0(); /* xmm0 = rhs */
                                ir_emit(I_STORE_XMM0_RAX, 0, 0, 0); ir_flush(); /* Phase3-IR case10: ptr->field 存 double */
                        } 否 {

                                cg(n1[n]); 若 (fsz == 8) ll_ext32(n1[n]); push_r(0); /* save rhs on stack; ll 字段 int RHS 符号扩展 (fix 2026-08-07: 箭头字段 p->v = -100 存 64 位零扩展 → 4294967196; fix 2026-08-31 csmith s13: ==-3 sentinel 改 fsz==8) */
若(off>=0 || (coff_mode && var_isstatic(vname))){ 若 (var_isstatic(vname)) { ir_emit(I_LOAD_RIP64, off, 1, 0); ir_flush(); } 否 { ir_emit(I_LOAD_RBP, 0, off - cur_frame_sz, 0); ir_flush(); } } /* Phase3-IR case10: rax = ptr */
                                否 {mov_r_imm(0,0);} /* ptr=0 if not found */
                                若(foff!=0){ ir_emit(I_ADD_EAX_IMM8, foff, 0, 0); ir_flush(); } /* Phase3-IR case10: 偏移 */
                                pop_r(3); /* ebx = rhs */
