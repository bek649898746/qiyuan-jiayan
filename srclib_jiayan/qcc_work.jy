            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(bd, asg); } }
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i); Nc(asg, pl); Nc(bd, asg); } /* __tq++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "丢前")) { /* 接入 2026-08-27 丢前 k 个 (drop): 丢前 dst, src, n, k; → { __dk=k; __dq=0; while(__dq+__dk<n){ dst[__dq]=src[__dq+__dk]; __dq++; } } — 跳过前 k 个复制剩余, k>=n 复制 0 个 */
        tk++; /* 丢前 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_k = expr(); /* 丢前个数 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 dq_seq = 0; 字 iname[64]; sprintf(iname, "__dq_%d_", dq_seq++);
        静 整 dq_seq2 = 0; 字 kname[64]; sprintf(kname, "__dk_%d_", dq_seq2++);
        var_offset(iname); var_offset(kname);
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), kname, 32); Nc(d, e_k); Nc(blk, d); } /* int __dk = k; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __dq = 0; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          { 整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
            整 add = Nd(2); nv[add] = PK; Nc(add, v_i); Nc(add, v_k); /* __dq + __dk */
            整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, add); Nc(cmp, e_n); /* < n */
            Nc(wh, cmp); } }
        整 bd = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_i); /* dst[__dq] */
          { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 v_k2 = Nd(1); memcpy((字*)(nn + v_k2), kname, 32);
            整 add2 = Nd(2); nv[add2] = PK; Nc(add2, v_i2); Nc(add2, v_k2); /* __dq + __dk */
            整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, add2); /* src[__dq+__dk] */
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(bd, asg); } }
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i); Nc(asg, pl); Nc(bd, asg); } /* __dq++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "打乱")) { /* 接入 2026-08-27 Fisher-Yates 洗牌: 打乱 arr, n; → { __sh=n-1; while(__sh>0){ __sx=rand()%(__sh+1); 交换 arr[__sh],arr[__sx]; __sh--; } } — 就地 O(n) 均匀洗牌 (rand 取模, builtin) */
        tk++; /* 打乱 */
        字 arrn[64]; strcpy(arrn, tn[tk]); tk++; /* 数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 sh_seq = 0; 字 iname[64]; sprintf(iname, "__sh_%d_", sh_seq++);
        静 整 sh_seq2 = 0; 字 xname[64]; sprintf(xname, "__sx_%d_", sh_seq2++);
        静 整 sh_seq3 = 0; 字 tname[64]; sprintf(tname, "__st_%d_", sh_seq3++);
        var_offset(iname); var_offset(xname); var_offset(tname);
        整 blk = Nd(5);
        整 v_r = Nd(1); memcpy((字*)(nn + v_r), arrn, 32);
        /* int __sh = n-1; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32);
          { 整 one = Nd(0); nv[one] = 1; 整 sub = Nd(2); nv[sub] = MK; Nc(sub, e_n); Nc(sub, one); Nc(d, sub); }
          Nc(blk, d); }
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 zero = Nd(0); nv[zero] = 0;
          整 cmp = Nd(2); nv[cmp] = T_GK; Nc(cmp, v_i); Nc(cmp, zero); Nc(wh, cmp); } /* while (__sh > 0) */
        整 bd = Nd(5);
        /* int __sx = rand() % (__sh+1); */
        { 整 d = Nd(7); memcpy((字*)(nn + d), xname, 32);
          整 call = Nd(4); { 整 fn = Nd(1); memcpy((字*)(nn + fn), "rand", 5); Nc(call, fn); } /* rand() — 无参, callee 即唯一子 */
          { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
            整 plus1 = Nd(2); nv[plus1] = PK; Nc(plus1, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(plus1, one); } /* __sh+1 */
            整 mod = Nd(2); nv[mod] = T_MD; Nc(mod, call); Nc(mod, plus1); /* rand() % (__sh+1) */
            Nc(d, mod); }
          Nc(bd, d); }
        /* 三步交换 arr[__sh] <-> arr[__sx] */
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx1 = Nd(14); Nc(idx1, v_r); Nc(idx1, v_i); /* arr[__sh] */
          整 v_t = Nd(1); memcpy((字*)(nn + v_t), tname, 32);
          { 整 v_x = Nd(1); memcpy((字*)(nn + v_x), xname, 32);
            整 idx2 = Nd(14); Nc(idx2, v_r); Nc(idx2, v_x); /* arr[__sx] */
            { 整 asg = Nd(10); Nc(asg, v_t); Nc(asg, idx1); Nc(bd, asg); } /* __st = arr[__sh]; */
            { 整 asg = Nd(10); Nc(asg, idx1); Nc(asg, idx2); Nc(bd, asg); } /* arr[__sh] = arr[__sx]; */
            { 整 asg = Nd(10); Nc(asg, idx2); Nc(asg, v_t); Nc(bd, asg); } /* arr[__sx] = __st; */
          } }
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          { 整 one = Nd(0); nv[one] = 1; 整 sub = Nd(2); nv[sub] = MK; Nc(sub, v_i); Nc(sub, one);
            整 asg = Nd(10); Nc(asg, v_i); Nc(asg, sub); Nc(bd, asg); } } /* __sh--; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "相邻差")) { /* 接入 2026-08-27 相邻差 (adjacent difference): 相邻差 dst, src, n; → { dst[0]=src[0]; __ad=1; while(__ad<n){ dst[__ad]=src[__ad]-src[__ad-1]; __ad++; } } — n>=1 */
        tk++; /* 相邻差 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 ad_seq = 0; 字 iname[64]; sprintf(iname, "__ad_%d_", ad_seq++);
        var_offset(iname);
        整 blk = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        /* dst[0] = src[0]; */
        { 整 zero = Nd(0); nv[zero] = 0;
          整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, zero);
          { 整 zero2 = Nd(0); nv[zero2] = 0;
            整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, zero2);
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(blk, asg); } }
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 one = Nd(0); nv[one] = 1; Nc(d, one); } Nc(blk, d); } /* int __ad = 1; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__ad < n) */
        整 bd = Nd(5);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_i); /* dst[__ad] */
          { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 idx_s1 = Nd(14); Nc(idx_s1, v_s); Nc(idx_s1, v_i2); /* src[__ad] */
            { 整 v_i3 = Nd(1); memcpy((字*)(nn + v_i3), iname, 32);
              { 整 one = Nd(0); nv[one] = 1; 整 sub1 = Nd(2); nv[sub1] = MK; Nc(sub1, v_i3); Nc(sub1, one); /* __ad-1 */
                整 idx_s2 = Nd(14); Nc(idx_s2, v_s); Nc(idx_s2, sub1); /* src[__ad-1] */
                整 diff = Nd(2); nv[diff] = MK; Nc(diff, idx_s1); Nc(diff, idx_s2); /* src[__ad]-src[__ad-1] */
                整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, diff); Nc(bd, asg); } } } }
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i); Nc(asg, pl); Nc(bd, asg); } /* __ad++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "组排")) { /* 接入 2026-08-27 分区 (partition): 组排 dst, src, n, cond; → { __pp=0; __pj=n-1; __pi=0; while(__pi<n){ __cr=cond(src[__pi]); if(__cr!=0){ dst[__pp]=src[__pi]; __pp++; } if(__cr==0){ dst[__pj]=src[__pi]; __pj--; } __pi++; } } — cond 真前假后 (不稳定性); cond 结果存 __cr 避免 e_cond 多父 */
        tk++; /* 组排 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_cond = expr(); /* 条件函数 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 pp_seq = 0; 字 pname[64]; sprintf(pname, "__pp_%d_", pp_seq++);
        静 整 pp_seq2 = 0; 字 jname[64]; sprintf(jname, "__pj_%d_", pp_seq2++);
        静 整 pp_seq3 = 0; 字 iname[64]; sprintf(iname, "__pi_%d_", pp_seq3++);
        静 整 pp_seq4 = 0; 字 rname[64]; sprintf(rname, "__cr_%d_", pp_seq4++);
        var_offset(pname); var_offset(jname); var_offset(iname); var_offset(rname);
        整 blk = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        { 整 d = Nd(7); memcpy((字*)(nn + d), pname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __pp = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), jname, 32); { 整 one = Nd(0); nv[one] = 1; 整 sub = Nd(2); nv[sub] = MK; Nc(sub, e_n); Nc(sub, one); Nc(d, sub); } Nc(blk, d); } /* int __pj = n-1; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __pi = 0; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__pi < n) */
        整 bd = Nd(5);
        /* int __cr = cond(src[__pi]); */
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, v_i); /* src[__pi] */
          整 condc = Nd(4); Nc(condc, idx_s); Nc(condc, e_cond); /* cond(src[__pi]) */
          整 d = Nd(7); memcpy((字*)(nn + d), rname, 32); Nc(d, condc); Nc(bd, d); }
        /* if (__cr != 0) { 前填 } */
        { 整 v_r = Nd(1); memcpy((字*)(nn + v_r), rname, 32);
          整 zero = Nd(0); nv[zero] = 0;
          整 neq = Nd(2); nv[neq] = T_XK; Nc(neq, v_r); Nc(neq, zero);
          整 ifn = Nd(8); Nc(ifn, neq);
          整 ibd = Nd(5); /* 多语句体必须包块 (经验) */
          { 整 v_p = Nd(1); memcpy((字*)(nn + v_p), pname, 32);
            整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_p); /* dst[__pp] */
            整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, v_i2); /* src[__pi] */
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(ibd, asg); } /* dst[__pp]=src[__pi]; */
          { 整 v_p2 = Nd(1); memcpy((字*)(nn + v_p2), pname, 32);
            整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_p2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
            整 asg2 = Nd(10); Nc(asg2, v_p2); Nc(asg2, pl); Nc(ibd, asg2); } /* __pp++; */
          Nc(ifn, ibd);
          Nc(bd, ifn); }
        /* if (__cr == 0) { 后填 } */
        { 整 v_r = Nd(1); memcpy((字*)(nn + v_r), rname, 32);
          整 zero = Nd(0); nv[zero] = 0;
          整 eqz = Nd(2); nv[eqz] = T_QK; Nc(eqz, v_r); Nc(eqz, zero);
          整 ifn = Nd(8); Nc(ifn, eqz);
          整 ibd = Nd(5); /* 多语句体必须包块 (经验) */
          { 整 v_j = Nd(1); memcpy((字*)(nn + v_j), jname, 32);
            整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_j); /* dst[__pj] */
            整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, v_i2); /* src[__pi] */
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(ibd, asg); } /* dst[__pj]=src[__pi]; */
          { 整 v_j2 = Nd(1); memcpy((字*)(nn + v_j2), jname, 32);
            { 整 one = Nd(0); nv[one] = 1; 整 sub = Nd(2); nv[sub] = MK; Nc(sub, v_j2); Nc(sub, one);
              整 asg2 = Nd(10); Nc(asg2, v_j2); Nc(asg2, sub); Nc(ibd, asg2); } } /* __pj--; */
          Nc(ifn, ibd);
          Nc(bd, ifn); }
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i); Nc(asg, pl); Nc(bd, asg); } /* __pi++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "窗口")) { /* 接入 2026-08-27 滑动窗口和 (sliding window sum): 窗口 dst, src, n, w; → { __ww=w; __wd=0; while(__wd+__ww<=n){ __ws=0; __wt=0; while(__ws<__ww){ __wt+=src[__wd+__ws]; __ws++; } dst[__wd]=__wt; __wd++; } } — dst[i]=sum(src[i..i+w)) */
        tk++; /* 窗口 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_w = expr(); /* 窗口宽度 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 wd_seq = 0; 字 iname[64]; sprintf(iname, "__wd_%d_", wd_seq++);
        静 整 wd_seq2 = 0; 字 sname[64]; sprintf(sname, "__ws_%d_", wd_seq2++);
        静 整 wd_seq3 = 0; 字 tname[64]; sprintf(tname, "__wt_%d_", wd_seq3++);
        静 整 wd_seq4 = 0; 字 wname[64]; sprintf(wname, "__ww_%d_", wd_seq4++);
        var_offset(iname); var_offset(sname); var_offset(tname); var_offset(wname);
        整 blk = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        { 整 d = Nd(7); memcpy((字*)(nn + d), wname, 32); Nc(d, e_w); Nc(blk, d); } /* int __ww = w; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __wd = 0; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          { 整 v_w = Nd(1); memcpy((字*)(nn + v_w), wname, 32);
            整 add = Nd(2); nv[add] = PK; Nc(add, v_i); Nc(add, v_w); /* __wd+__ww */
            整 cmp = Nd(2); nv[cmp] = T_HK; Nc(cmp, add); Nc(cmp, e_n); /* <= n */
            Nc(wh, cmp); } } /* while (__wd+__ww <= n) */
        整 bd = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), sname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(bd, d); } /* int __ws = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), tname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(bd, d); } /* int __wt = 0; */
        整 wh2 = Nd(9);
        { 整 v_s2 = Nd(1); memcpy((字*)(nn + v_s2), sname, 32);
          { 整 v_w2 = Nd(1); memcpy((字*)(nn + v_w2), wname, 32);
            整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_s2); Nc(cmp, v_w2); Nc(wh2, cmp); } } /* while (__ws < __ww) */
        整 bd2 = Nd(5);
        { 整 v_t = Nd(1); memcpy((字*)(nn + v_t), tname, 32);
          { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
            整 v_s2 = Nd(1); memcpy((字*)(nn + v_s2), sname, 32);
            整 add = Nd(2); nv[add] = PK; Nc(add, v_i); Nc(add, v_s2); /* __wd+__ws */
            整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, add); /* src[__wd+__ws] */
            整 add2 = Nd(2); nv[add2] = PK; Nc(add2, v_t); Nc(add2, idx_s); /* __wt + src[..] */
