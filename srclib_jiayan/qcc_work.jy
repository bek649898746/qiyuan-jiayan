                    整 gdims[8]; 遍 (整 gdi = 0; gdi < 8; gdi++) gdims[gdi] = 0; 整 gdim_n = 0; /* per-dim sizes → frows (fix 2026-08-05: global 3D arrays had no frows → nested scale fell back to scalar) */
                    循环 (tt[tk] == LB) {
