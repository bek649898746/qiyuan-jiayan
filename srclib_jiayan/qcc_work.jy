                            整 _fcs = (!st_field_is_ptr(si, fname) && _fty >= 0 && stypes[_fty].sz > 8) ? stypes[_fty].sz : 0; /* fix 2026-08-22 t45: 排除指针字段 (r.rev = e — rev 是 entry*, ty_idx 解析成 entry 24B → 原 _fcs=24 → 数组名当 struct 值拷 24B → r.rev=0 崩) — 同步 t44 箭头分支修复 */
