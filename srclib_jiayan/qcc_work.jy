                若 (tt[tk] == FK && acnt > 0) { /* static ARRAY brace init: static int a[2]={1,2} / static char *s[]={"x"} — brace_arr_init, run once at main entry (fix 2026-08-13: 原走 expr() 无法解析 {…} → 运行 0xC0000005; revision.c lookup_other_head) */
                    整 blk = Nd(5);
                    Nc(blk, d); /* declare first */
                    遍 (整 i = 0; i < 8; i++) gi_idx[i] = 0;
                    str_row = 0;
                    brace_arr_init(blk, d, adimv, adims > 0 ? adims : 1, 0, tdi_fnptr_v ? 8 : (is_ptr ? 8 : (is_char ? 1 : (is_short ? 2 : (is_double ? 8 : (is_ll ? 8 : 4))))));
                    若 (ginit_n < 4096) ginit[ginit_n++] = blk;
                    vars[vcnt - 1].pdisp = ginit_n - 1; /* mark: handled by ginit */
                } 否 若 (ltd_si >= 0 && !is_ptr && tt[tk] == FK) { /* static typedef'd struct brace init (fix 2026-08-07: was Nc(decl,expr()) — expr() 不能解析 '{') */
                    tk++;
                    整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32); /* name in decl node d (vn out of scope) */
                    整 blkinit = brace_fields(ltd_si, idn);
                    若 (tt[tk] == UK) tk++;
                    若 (ginit_n < 4096) ginit[ginit_n++] = blkinit;
                    vars[vcnt - 1].pdisp = ginit_n - 1; /* mark: handled by ginit */
                } 否 {
                    整 decl = Nd(7); memcpy((字*)(nn + decl), (字*)(nn + d), 32);
                    Nc(decl, expr());
                    ginit[ginit_n++] = decl;
                    vars[vcnt - 1].pdisp = ginit_n - 1; /* mark: handled by ginit */
                }
            } 否 {
                { 整 _r3 = expr(); 若 (!is_double && _r3 >= 0 && expr_is_double(_r3)) { sprintf(g_errbuf, "无隐式转换: double 值赋给整型变量 (声明) — 用 转 int(...) 显式转换 (v3.0 #74)"); emit_error("A9002", g_errbuf); } 若 (user_fn_active && vcnt > 0) { type_mismatch_check(_r3, (字*)(nn + d), vcnt - 1); } /* fix 2026-08-30 探雷雷2: 标量/指针声明初始化类型错配检查 — 仅用户代码 (qcc_rt 豁免), vcnt-1 = 刚注册的当前变量 (var_lookup 可能命中 rt 残留) */ 若 (_r3 >= 0 && nt[_r3] == 11 && n0[_r3] >= 0 && nt[n0[_r3]] == 1) { alias_reg((字*)(nn + d), (字*)(nn + n0[_r3])); } /* fix 2026-08-30 探雷雷4: int *p = &x 声明初始化登记别名 (借用追指针) */ Nc(d, _r3); } /* #74 scalar */
            }
        } Nc(b, d); b_cnt++;
            若 (brace_init_blk >= 0) { Nc(b, brace_init_blk); b_cnt++; } /* 延迟挂 struct brace init 块 (fix 2026-08-15: merge.c autogen 逗号声明) */
            循环 (tt[tk] == CK) { /* comma-separated: int a = 0, b = 0; */
                tk++;
                整 is_ptr2 = 0, ptr2_depth = 0; 循环 (tt[tk] == DK) { is_ptr2 = 1; ptr2_depth++; tk++; 循环 (tt[tk] == VK && !strcmp(tn[tk], "const")) tk++; } /* fix 2026-08-14: 循环消费所有 *; 每个 * 后可选 const (fix 2026-08-15: show-branch * const*b); fix 2026-08-18: 数层级 → T** 逗号变量 8B 元素 */
                整 d2 = Nd(7);
                若 (tt[tk] == VR) {
                    字 vn2[64]; strcpy(vn2, tn[tk]); tk++;
                    若 (tt[tk] == LB) { /* array in comma list: int a, b[3]; (fix 2026-08-05: was var_offset → adimv[8] registered as int, &adimv[0] NULL) */
                        整 cnt2 = 1;
                        循环 (tt[tk] == LB) { tk++; 整 cdim2 = 0; 若 (const_expr_eval(&cdim2)) cnt2 *= cdim2; 否 若 (tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++; }
                        整 esz2 = tdi_fnptr_v ? 8 : ((is_ptr2 || is_ptr) ? 8 : (is_char ? 1 : (is_short ? 2 : (is_double ? 8 : (is_ll ? 8 : 4))))); /* fix 2026-08-16: 逗号声明 int *rsym[4] 是 8 字节指针数组 (原 is_ptr2 走 var_offset_ptr → arr_sz=0 → rsym[rsec][b2] 存到坏地址崩) */
                        var_array(vn2, cnt2, esz2);
                        vars[vcnt - 1].p_esz = 0; /* fix 2026-08-17: 1D ptr-array comma decl (int *rsym[4])
                           must keep p_esz=0 (2nd dim b2 is int, stride 4; old esz2=8 -> cg_mem_frow=8 ->
                           rsym[rsec][b2] store misaligned, corrupts neighbor ridx -> write_coff_obj reloc */
                        若 (is_double) vars[vcnt - 1].is_dbl = 1;
                        若 (is_ll) vars[vcnt - 1].is_ll = 1; /* fix 2026-08-06 */
                    } 否 {
                        整 comma_had_init = 0;
                        若 (tt[tk] == AK) { tk++; comma_had_init = 1; Nc(d2, expr()); } /* 逗号声明带初始化 (int a=0, b=1u) */
                        若 (is_ptr2) { var_offset_ptr(vn2, is_char ? 1 : 4); 若 (ptr2_depth >= 2) vars[vcnt - 1].arr_esz = 8; } /* fix 2026-08-18: T** 逗号变量 8B 元素 */
                        否 若 (is_ll) { var_ll(vn2); 若 (is_uns) vars[vcnt - 1].is_uns = 1; } /* fix 2026-08-06: 逗号声明 ll 变量 (原 var_offset → 存32) */
                        否 若 (is_double) { var_double(vn2); }
                        否 若 (ltd_si >= 0) { var_struct(vn2, ltd_si); } /* typedef struct comma var (fix: was missing → p2 as int) */
                        否 { var_offset(vn2); 若 (is_char) vars[vcnt - 1].is_char = 1; 若 (is_short) vars[vcnt - 1].is_short = 1; 若 (is_uns) vars[vcnt - 1].is_uns = 1; }
                        若 (comma_had_init) uninit_remove(vn2); /* 接入 2026-08-28 机制层 #78: 带初始化必须在 var_offset 登记后移除 (顺序! 先登记后移除) */
                    }
                    memcpy((字*)(nn + d2), vn2, 32);
                    Nc(b, d2); b_cnt++;
                }
            }
            tk++; }
        否 若 (tt[tk] == ST) { /* struct Name var; 或 struct Name *ptr; */
            
            tk++; /* skip struct */
            若 (tt[tk] == VR) {
                整 si = st_find(tn[tk]); tk++; /* struct type name */
                整 is_ptr = 0;
                循环 (tt[tk] == DK) { is_ptr = 1; tk++; } /* fix 2026-08-18: struct sl *values 指针 — 原 VR 检查失败 → *values 落表达式路径当隐式变量注册, 存值/取址槽位不一致 (var_sbase 按 struct 减大小, &取址不减) → &values 错位 → git_configset_get_value SEGV (git init) */
                若 (si >= 0 && tt[tk] == VR) {
                    整 d = Nd(7); /* reuse decl node */
                    字 vns[64]; strcpy(vns, tn[tk]);
                    若 (is_ptr) { var_offset_ptr(tn[tk], stypes[si].sz); vars[vcnt - 1].st_idx = si; vars[vcnt - 1].p_depth = 1; vars[vcnt - 1].p_inner = stypes[si].sz; } /* 指针变量: 8 字节槽 + struct 类型; fix 2026-08-20: p_esz=sizeof(struct) 原固定 4 → `struct option *newopt` 指针算术 i*4 → parse-options preprocess_options memcpy 参数错位 → git log 崩; p_depth/p_inner (fix 2026-08-18 对齐) */
                    否 var_struct(tn[tk], si);
                    memcpy((字*)(nn + d), tn[tk], 64); tk++;
                    整 struct_brace_blk = -1;
                    若 (tt[tk] == AK) { /* = init (fix 2026-08-15: struct strbuf merge_names = STRBUF_INIT, *autogen = NULL; 原只处理 ; → autogen 未注册) */
                        tk++;
                        uninit_remove(vns); /* #78: struct 变量声明带初始化 */
                        若 (tt[tk] == FK && !is_ptr) { /* brace init { .buf = ... } — 仅 struct 值变量 (fix 2026-08-18: 指针 = { 走 expr) */
                            tk++;
                            整 idn = Nd(1); memcpy((字*)(nn + idn), vns, 32);
                            整 bi = brace_fields(si, idn);
                            struct_brace_blk = Nd(5); Nc(struct_brace_blk, bi);
                            若 (tt[tk] == UK) tk++; /* } */
                        } 否 {
                            Nc(d, expr());
                        }
                    }
                    Nc(b, d); b_cnt++;
                    若 (struct_brace_blk >= 0) { Nc(b, struct_brace_blk); b_cnt++; }
                    循环 (tt[tk] == CK) { /* comma declarators: *autogen = NULL */
                        tk++;
                        整 is_ptr4 = 0; 循环 (tt[tk] == DK) { is_ptr4 = 1; tk++; }
                        若 (tt[tk] == VR) {
                            字 vn4[64]; strcpy(vn4, tn[tk]); tk++;
                            整 d4 = Nd(7);
                            若 (is_ptr4) { var_offset_ptr(vn4, stypes[si].sz); vars[vcnt - 1].st_idx = si; vars[vcnt - 1].p_depth = 1; vars[vcnt - 1].p_inner = stypes[si].sz; } /* fix 2026-08-20: p_esz=sizeof(struct) 同主声明 */
                            否 var_struct(vn4, si);
                            memcpy((字*)(nn + d4), vn4, 32);
                            若 (tt[tk] == AK) { /* = init */
                                tk++;
                                若 (tt[tk] == FK) { /* 花括号初始化器 { ... } — STRBUF_INIT 等 (fix 2026-08-18: 原 Nc(d4,expr()) 不能解析 { → 初始化器被吞 → 变量 buf=NULL → strbuf 操作 SEGV; setup.c `struct strbuf dir = STRBUF_INIT, gitdir = STRBUF_INIT, report = STRBUF_INIT;` git init/config 崩) */
                                    tk++;
                                    整 idn2 = Nd(1); memcpy((字*)(nn + idn2), vn4, 32);
                                    整 bi2 = brace_fields(si, idn2);
                                    整 blk2 = Nd(5); Nc(blk2, bi2);
                                    Nc(b, blk2); b_cnt++;
                                    若 (tt[tk] == UK) tk++; /* } */
                                } 否 {
                                    Nc(d4, expr());
                                }
                            }
                            Nc(b, d4); b_cnt++;
                        }
                    }
                    若 (tt[tk] == SK) tk++; /* skip ; */
                    续;
                }
            }
            /* skip to next ; if parse fails */
            循环 (tk < TS && tt[tk] != SK && tt[tk] != UK) tk++;
            若 (tt[tk] == SK) tk++;
        }
        否 若 (tt[tk] == VR && (td_is(tn[tk]) || st_find(tn[tk]) >= 0) && tt[tk + 1] != AR && tt[tk + 1] != DT && tt[tk + 1] != LB && tt[tk + 1] != AK) { /* typedef or struct type (guard: ->/./[ = 表达式; fix 2026-08-15: combine-diff sline[j].flag 被当 struct 声明 → flag 泄漏 undefined; fix 2026-08-18: `ref = xstrfmt(...)` — ref 恰是 git 的 struct tag (struct ref) → 被当类型名吞掉 → 赋值语句整个消失 → create_reference_database 的 ref 未初始化 → check_refname_format(垃圾) → git init 崩) */
            整 tdi_dbl = 0; 整 tdi2 = tdef_lookup(tn[tk]); 若 (tdi2 >= 0 && tdefs[tdi2].is_dbl) tdi_dbl = 1;
            整 tdi_fnptr = (tdi2 >= 0 && tdefs[tdi2].is_fnptr); /* typedef'd fnptr: 8-byte element (fix 2026-08-03) */
            tk++; /* skip type name */
            整 tsi = st_find(tn[tk-1]); 若 (tsi < 0) tsi = td_st_index(tn[tk-1]);
            整 is_struct = (tsi >= 0);
            整 is_ptr = 0;
            若 (tt[tk] == DK) { is_ptr = 1; tk++; } /* pointer */
            整 d = Nd(7);
            若 (tt[tk] == VR) {
                字 vn2[64]; strcpy(vn2, tn[tk]);
                若 (tt[tk+1] == LB) { /* typedef struct array: P arr[3]; — fix 2026-08-03: was single-element */
                    整 scnt = 1; tk++; /* consume VR */
                    循环 (tt[tk] == LB) {
                        tk++; 若 (tt[tk] == NK) { scnt *= tv[tk]; tk++; }
                        若 (tt[tk] == RB) tk++;
                    }
                    若 (tdi_fnptr && !is_ptr) { var_array(vn2, scnt, 8); 若 (tdi2 >= 0 && tdefs[tdi2].fnptr_dbl) vars[vcnt - 1].p_dbl = 1; }
                    否 若 (is_struct && !is_ptr && scnt > 1) { var_array(vn2, scnt, stypes[tsi].sz); vars[vcnt - 1].st_idx = tsi; }
                    否 若 (is_struct && !is_ptr) { var_struct(vn2, tsi); }
                    否 若 (tdi_dbl && !is_ptr) { var_double(vn2); }
                    否 { var_offset(vn2); }
                } 否 {
                若 (tdi_fnptr && !is_ptr) { var_offset_ptr(vn2, 4); vars[vcnt - 1].arr_esz = 8; 若 (tdi2 >= 0 && tdefs[tdi2].fnptr_dbl) vars[vcnt - 1].p_dbl = 1; }
                否 若 (is_struct && !is_ptr) { var_struct(tn[tk], tsi); }
                否 若 (tdi_dbl && !is_ptr) { var_double(tn[tk]); } /* typedef double alias: 8-byte slot */
                否 { var_offset(tn[tk]); }
                }
                memcpy((字*)(nn + d), vn2, 32); tk++;
            }
            若 (tt[tk] == AK) {
                tk++;
                若 (tt[tk] == FK && is_struct && !is_ptr && !(tk >= 1 && tt[tk-1] == RB)) { /* typedef struct P p = { a, b }; — brace init. Guard: array dims consumed (tt[tk-1]==RB) → skip brace_fields (array init unsupported) */
                    tk++;
                    整 idn = Nd(1); memcpy((字*)(nn + idn), (字*)(nn + d), 32);
                    整 bi = brace_fields(tsi, idn);
                    Nc(b, d); b_cnt++;
                    整 bt = Nd(5); Nc(bt, bi);
                    Nc(b, bt); b_cnt++;
                    若 (tt[tk] == UK) tk++;
                    循环 (tk < TS && tt[tk] != SK && tt[tk] != EK) tk++;
                    若 (tt[tk] == SK) tk++;
                    续;
                } 否 {
                    Nc(d, expr());
                }
            }
            若 (tt[tk] == SK) tk++;
            Nc(b, d);
            /* comma-separated: typedef P p1, p2, p3; (fix 2026-08-08: was missing → p2+ silently dropped) */
            循环 (tt[tk] == CK) {
                tk++;
                整 is_ptr3 = 0;
                若 (tt[tk] == DK) { is_ptr3 = 1; tk++; }
                若 (tt[tk] == VR) {
                    字 vn3[64]; strcpy(vn3, tn[tk]); tk++;
                    整 d3 = Nd(7);
                    若 (is_ptr3) { var_offset_ptr(vn3, 4); 若 (is_struct) vars[vcnt - 1].st_idx = tsi; }
                    否 若 (is_struct) var_struct(vn3, tsi);
                    否 若 (tdi_dbl) var_double(vn3);
                    否 var_offset(vn3);
                    memcpy((字*)(nn + d3), vn3, 32);
                    若 (tt[tk] == AK) { tk++; Nc(d3, expr()); }
                    Nc(b, d3); b_cnt++;
                }
                若 (tt[tk] == SK) tk++;
            }
        }
        否 { Nc(b, stmt()); b_cnt++; }
    }
    若 (tt[tk] == UK) tk++; /* fix 2026-08-07: EK 提前退出时不得越过 token 区 (原无条件 tk++ 遇 EOF 越界). NOTE: vcnt NOT restored — C has function scope, not block scope */
    遍 (整 gi = guard_cnt - 1; gi >= 0; gi--) { 若 (guard_vars[gi][0] != 0 && guard_scope[gi] == borrow_depth && guard_ready[gi]) { 整 call = Nd(4); { 整 arg = Nd(1); memcpy((字*)(nn + arg), guard_vars[gi], 64); Nc(call, arg); } { 整 fn = Nd(1); memcpy((字*)(nn + fn), guard_fns[gi], 64); Nc(call, fn); } Nc(b, call); b_cnt++; guard_vars[gi][0] = 0; } } { 整 w = 0; 遍 (整 r = 0; r < guard_cnt; r++) { 若 (guard_vars[r][0] != 0) { 若 (w != r) { strcpy(guard_vars[w], guard_vars[r]); strcpy(guard_fns[w], guard_fns[r]); guard_scope[w] = guard_scope[r]; guard_ready[w] = guard_ready[r]; } w++; } } guard_cnt = w; } /* 接入 2026-08-28 机制层 #8 RAII: 块退出 → 自动调用本块守卫析构 (LIFO 逆序, 复用 borrow_depth 判断作用域, 压缩移除) */ /* 2026-08-28 P1 #15 Drop 标记: guard_ready=0 (未初始化) 守卫跳过析构 */ /* 2026-08-28 P1 #25: 丢弃 已注销守卫 (guard_vars[gi][0]=0) 跳过析构 — 否则空名守卫发析构调用 → 未定义函数 '' (丢弃后块退不二次析构) */
    borrow_scope_exit(); /* 接入 2026-08-28 机制层 #4: 块退出 → 自动放还本块内借用 (生命周期=词法作用域, 嵌套正确) */
    uninit_scope_exit(); /* 接入 2026-08-28 机制层 #78: 块退出 → 清除本块声明的未初始化变量 (生命周期=词法块) */
    nullable_scope_exit(); /* 类型根治① (2026-08-28): 块退出 → 清除本块可空标记 (生命周期=词法块) */
    nv[b_root] = vcnt + 1; /* block end var bound for codegen scoping (fix 2026-08-16: sibling-block locals shadow earlier blocks) */
    遍 (整 bvi = blk_vstart; bvi < vcnt; bvi++) 若 (vars[bvi].blk_end == 0) { vars[bvi].blk_start = blk_vstart; vars[bvi].blk_end = vcnt; } /* fix 2026-08-19: 本块直接声明的变量 blk 范围 = 本块 [start,end) (嵌套块变量已标记, 保持其块内作用域) */
    cl_blk = cl_prev; /* 恢复外层块 (compound literal, fix 2026-08-11) */
    parse_depth--; /* 资源护栏 9b (2026-08-28): 块递归深度出栈 */
    返 b_root;
}

/* 接入 2026-08-28 可吞清单 P0-7: 契约审判 — 前置/后置 子句表 (fn 名键, 声明在顶部) + 检查语句构建器
   前置=入口检查 (解析期脱糖成 if(!pre){printf;exit;} 包函数体首), 后置=出口检查 (代码生成期 epilogue 注入, 返回 占位=返回值) */
静 整 contract_find(常 字 *fn) { 遍 (整 i = 0; i < contract_cnt; i++) 若 (!strcmp(contracts[i].fn, fn)) 返 i; 返 -1; }
/* 接入 2026-08-28 可吞清单 P0-8: 结构契约审判 — 接口级哈希 (Turn 接口级审判 qcc 版): 契约 struct 名 → 规范描述符 SHA256 (确定性接口指纹, 外部数据过 Schema 才能绑定) */
静 整 cstr_find(常 字 *n) { 遍 (整 i = 0; i < cstr_n; i++) 若 (!strcmp(cstr_names[i], n)) 返 i; 返 -1; }
静 整 cstr_register(常 字 *n) { /* 契约 P; — 登记 struct P 为契约类型 + 计算描述符哈希 (名:总大小:字段名:偏移:大小[:指针/数组], 声明序, 确定性) */
    若 (cstr_find(n) >= 0) 返 0;
    若 (cstr_n >= 64) budget_fail("契约结构表 cstr", 64);
    整 si = st_find(n);
    若 (si < 0) { fprintf(stderr, "[ERR] 契约: 未知结构体 '%s' (须先定义 struct %s)\n", n, n); 返 -1; }
    字 desc[4096]; 整 di = 0;
    di += sprintf(desc + di, "%s:%d:", n, stypes[si].sz);
    遍 (整 f = 0; f < stypes[si].fn && di < 3900; f++) {
        di += sprintf(desc + di, "%s:%d:%d%s,", stypes[si].fnames[f], stypes[si].foffs[f], stypes[si].fsizes[f], stypes[si].fptrs[f] ? ":p" : "");
    }
    字 h[65]; sha256_buf(desc, di, h);
    strcpy(cstr_names[cstr_n], n);
    strcpy(cstr_hashes[cstr_n], h);
    cstr_n++;
    返 0;
}
静 整 build_contract_check(整 cond_root, 整 msg_str) { /* if(!cond){ printf(msg); exit(1); } — 复用 保证/断言 eq0 模式 */
    整 eq0 = Nd(2); nv[eq0] = T_QK; Nc(eq0, cond_root); { 整 z = Nd(0); nv[z] = 0; Nc(eq0, z); }
    整 ifn = Nd(8); Nc(ifn, eq0);
    整 body = Nd(5);
    整 call_p = Nd(4); { 整 sn = Nd(0); nv[sn] = msg_str; nt[sn] = STR; Nc(call_p, sn); } { 整 en = Nd(1); memcpy((字*)(nn + en), "printf", 7); Nc(call_p, en); }
    Nc(body, call_p);
    整 call_x = Nd(4); { 整 one = Nd(0); nv[one] = 1; Nc(call_x, one); } { 整 en = Nd(1); memcpy((字*)(nn + en), "exit", 5); Nc(call_x, en); }
    Nc(body, call_x);
    Nc(ifn, body);
    返 ifn;
}
/* 接入 2026-08-28 可吞清单 P1 (兑现"证明器查"): 编译期常量前置审判 — 调用点参数全常量时折叠评估 前置, 违反 → 编译期报错 A6002 (不等运行时 abort) */
静 长 长 contract_const_eval(整 n, 常 字 **argnames, 常 长 长 *argvals, 整 argc, 整 *known) { /* 常量表达式折叠 (支持算术/比较/位/移位; 遇变量/调用/未知 → known=0 安全跳过) */
    *known = 1;
    若 (n < 0) 返 0;
    整 t = nt[n];
    若 (t == 0) 返 nv[n];
    若 (t == 1) { 常 字 *nm = (字*)(nn + n); 遍 (整 i = 0; i < argc; i++) 若 (!strcmp(nm, argnames[i])) 返 argvals[i]; *known = 0; 返 0; }
    若 (t == 2) { 整 k1, k2; 长 长 a = contract_const_eval(n0[n], argnames, argvals, argc, &k1); 长 长 b = contract_const_eval(n1[n], argnames, argvals, argc, &k2);
        若 (!k1 || !k2) { *known = 0; 返 0; }
        择 (nv[n]) {
            例 T_PK: 返 a + b; 例 T_MK: 返 a - b; 例 T_DK: 返 a * b;
            例 T_DV: 若 (b == 0) { *known = 0; 返 0; } 返 a / b;
            例 T_MD: 若 (b == 0) { *known = 0; 返 0; } 返 a % b;
            例 T_SH: 返 a << b; 例 T_SR: 返 a >> b;
            例 T_LK: 返 a < b; 例 T_GK: 返 a > b; 例 T_HK: 返 a <= b; 例 T_YK: 返 a >= b;
            例 T_QK: 返 a == b; 例 T_XK: 返 a != b;
            缺: *known = 0; 返 0;
        }
    }
    *known = 0; 返 0;
}

静 空 dangling_check(整 rv) { /* 2026-08-28 P1 #11 悬垂引用检测: return &局部 且函数返回指针 → [ERR] A3105 (指针指向已出作用域的局部) */
    若 (rv < 0 || cur_parse_fn[0] == 0) 返;
    若 (fn_ret_name_get_ptr(cur_parse_fn)) { /* 当前函数返回指针 */
        若 (nt[rv] == 11) { /* 取地址 &x — 沿基链下溯到根变量 (&a[0]/&s.field) */
            整 obj = n0[rv]; 整 dep = 0;
            循环 (obj >= 0 && dep < 8 && (nt[obj] == 14 || (nt[obj] == 15 && nv[obj] == 0))) { obj = n0[obj]; dep++; }
            若 (obj >= 0 && nt[obj] == 1) { /* 变量 */
                字 *nm = (字*)(nn + obj);
                整 vi = -1;
                遍 (整 k = vs_n() - 1; k >= 0; k--) 若 (!strcmp(vars[k].name, nm)) { vi = k; 断; }
                若 (vi >= parse_base && var_pesz(nm) == 0) { /* 值型局部 (非指针) 才悬垂 — 指针根 &ptr[k]/&ptr->f 指向 ptr 指向处, 安全 (rt strstr 等) */
                    sprintf(g_errbuf, "悬垂引用: 返回指向函数局部变量 '%s' 的指针 (局部变量随函数退出失效, v3.0 #11)", nm); emit_error("A3105", g_errbuf);
                }
            }
        }
    }
}
