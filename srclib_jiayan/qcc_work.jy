            若 (tt[tk] == FK) { /* { */
                tk++; 整 ev = 0;
                循环 (tk < TS && tt[tk] != UK) {
                    整 tk0 = tk;
                    若 (tt[tk] == VR) {
                        字 ename[64]; strcpy(ename, tn[tk]);
                        tk++; /* skip name */
