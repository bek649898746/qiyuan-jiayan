                整 g_is_ll = 0; /* global long long: 8-byte .data slot (fix 2026-08-05) */
                遍 (整 ti2 = save_tk; ti2 + 1 < tk; ti2++) 若 (tt[ti2] == VK && !strcmp(tn[ti2], "long") && tt[ti2 + 1] == VK && !strcmp(tn[ti2 + 1], "long")) g_is_ll = 1;
