/* byte size of a struct-typed var/param (0 = not a struct). st_sz is 0 for params
   (var_param zeroes it), so fall back to the struct type table. */
/* struct-typed var/param whose value fits in one 64-bit register (≤8 bytes):
   by-value return (rax), by-value arg (1 reg, full 64-bit), and plain
   assignment all move the whole struct as a single 8-byte value. Larger
   structs are not supported (no sret); leave them on the old path. */
静 整 var_small_struct(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) {
        若 (vars[i].arr_sz > 0) 返 0; /* struct array name is not a small value (fix 2026-08-03) */
        若 (vars[i].st_idx >= 0) { 整 sz = vars[i].st_sz > 0 ? vars[i].st_sz : stypes[vars[i].st_idx].sz; 返 (sz > 0 && sz <= 8) ? 1 : 0; }
        返 0;
    }
    返 0;
}
/* big-struct PARAM specifically: its slot holds a POINTER to the caller-side copy */
静 整 var_big_param(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) {
        /* fix 2026-08-22 #39: 指针参数被误判为大结构值参数 — `&struct_object_id *old_oid`
           生成了 mov(取值) 而非 lea(取址) → diff_tree_paths 的 parents_oid 收到 NULL → root
           commit 摘要打印 ll_diff_tree_paths 空指针崩. 大结构值参数必须 p_depth==0 (struct
           按值), 指针参数 (p_depth>=1, 含 T** 双指针) 槽位存指针值本身, 取地址用 lea. */
        若 (vars[i].is_param && vars[i].st_idx >= 0 && vars[i].p_depth == 0) { 整 sz = vars[i].st_sz > 0 ? vars[i].st_sz : stypes[vars[i].st_idx].sz; 返 (sz > 8) ? 1 : 0; }
