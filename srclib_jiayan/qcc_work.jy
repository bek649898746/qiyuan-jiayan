/* r12/r13 are high registers: [r13] needs mod=01+disp8, [r12] needs SIB 0x24 */
静 空 mov_eax_mr13(空) { asm_emit("    取参 eax, [r13]\n", 0, 0, 0); b(0x41); b(0x8B); b(0x45); b(0); }      /* mov eax, [r13] */
静 空 mov_rax_mr13(空) { asm_emit("    取64 rax, [r13]\n", 0, 0, 0); b(0x49); b(0x8B); b(0x45); b(0); }      /* mov rax, [r13] */
静 空 mov_r12_cl(空) { asm_emit("    写字节 [r12], cl\n", 0, 0, 0); rex(0,0,0,1); b(0x88); modrm(0,1,4); b(0x24); } /* mov [r12], cl */
静 空 mov_r12_al(空) { asm_emit("    写字符 [r12], al\n", 0, 0, 0); rex(0,0,0,1); b(0x88); modrm(0,0,4); b(0x24); } /* mov [r12], al */
