                整 nsz = Nd(0); nv[nsz] = fsz2; 返 nsz;
            }
            若 (tt[tk] == OK && tt[tk + 1] == VR && (tt[tk + 2] == AR || tt[tk + 2] == DT) && tt[tk + 3] == VR && tt[tk + 4] == KK && tt[tk + 5] == LB) { /* sizeof((ptr->field)[0]) — ARRAY_SIZE(watch->dotgit_shortname) (fix 2026-08-15: dotgit_shortname 泄漏 undefined) */
                整 si3 = var_stidx(tn[tk + 1]);
                整 esz3 = 4;
                若 (si3 >= 0) { 整 el = st_field_el(si3, tn[tk + 3]); 若 (el > 0) esz3 = el; }
                tk += 5; /* ( base op field ) */
                若 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK || tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++; }
                若 (tt[tk] == KK) tk++; /* outer ) */
                整 nsz = Nd(0); nv[nsz] = esz3; 返 nsz;
            }
            tk++; /* ( */
            整 esz = 4;
            若 (tt[tk] == VR) {
                字 nm[64]; strcpy(nm, tn[tk]);
                整 base_si = -1;
                遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                    若 (!strcmp(vars[vi].name, nm) && var_codegen_visible(vi)) {
                        若 (vars[vi].arr_sz > 0) esz = vars[vi].arr_esz ? vars[vi].arr_esz : 4;
                        否 若 (vars[vi].p_esz != 0) esz = vars[vi].p_esz;
                        否 若 (vars[vi].is_char) esz = 1;
                        否 若 (vars[vi].is_short) esz = 2; /* fix 2026-08-27 特性#1: sizeof(short 变量) 原 4 */
                        否 若 (vars[vi].is_ll) esz = 8; /* fix 2026-08-27 特性#1: sizeof(long long 变量) 原 4 */
                        否 若 (vars[vi].is_dbl) esz = 8;
                        否 esz = 4;
                        base_si = vars[vi].st_idx;
                        断;
                    }
                tk++; /* varname */
                /* (expr)[0] 内的嵌套成员链也要完整消费: opts->internal.unpack_rejects
                   的 ARRAY_SIZE 会展开为 sizeof((opts->internal.unpack_rejects)[0]),
                   原只消费 opts → 后续 ->internal.unpack_rejects 泄漏为 undefined 符号 (fix 2026-08-15) */
                循环 (tt[tk] == DT || tt[tk] == AR) {
                    tk++; /* . 或 -> */
                    若 (tt[tk] == VR) {
                        若 (base_si >= 0) {
                            整 el = st_field_el(base_si, tn[tk]); 若 (el > 0) esz = el;
                            整 fty = st_field_ty_idx(stypes[base_si].name, tn[tk]); 若 (fty >= 0) base_si = fty; 否 base_si = -1;
                        }
                        tk++; /* 字段名 */
                    } 否 断;
                }
            }
            若 (tt[tk] == KK) tk++; /* ) */
            若 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK || tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++; } /* [0] */
            若 (tt[tk] == KK) tk++; /* sizeof 的 ) */
            整 n = Nd(0); nv[n] = esz; 返 n;
        }
        若 (tt[tk] == STR) { 整 n = Nd(0); nv[n] = (整)strlen(str_tbl[tv[tk]]) + 1; tk++; 若 (sizeof_had_paren && tt[tk] == KK) tk++; /* fix 2026-08-16 根因F: sizeof("str") 漏消费 ')' → 后续 -1 残留 → 调用点 token 卡死 (color.c ATTR 宏 sizeof(x)-1) */ 返 n; } /* sizeof "string" (fix 2026-08-14: regcomp.c REG_NOMATCH_IDX = ... + sizeof "Success" — 原 STR 未消费泄漏 → 死循环) */
        若 (tt[tk] == VK) { /* sizeof(int/char/double/...) + pointers (fix 2026-08-05: was hardcoded 4 for every type) */
            整 tsz = 4;
            整 long_cnt = 0, is_dbl = 0, is_char = 0, is_short = 0;
            循环 (tt[tk] == VK) { /* unsigned long long / long long 是 8 字节; const/volatile 是限定符不影响大小 (fix 2026-08-15: sizeof(uintmax_t) 只吃 unsigned → 4 字节且 long long 泄漏, unsigned_add_overflows 的 bitsizeof(uintmax_t)-bitsizeof(a) 被吞) */
                若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) is_char = 1;
                否 若 (!strcmp(tn[tk], "double")) is_dbl = 1;
                否 若 (!strcmp(tn[tk], "short")) is_short = 1;
                否 若 (!strcmp(tn[tk], "long")) long_cnt++;
                tk++;
            }
            若 (is_char) tsz = 1;
            否 若 (is_short) tsz = 2;
            否 若 (is_dbl || long_cnt >= 2) tsz = 8;
            否 若 (long_cnt == 1) tsz = 4;
            若 (tt[tk] == DK) { tsz = 8; tk++; 循环 (tt[tk] == DK) tk++; } /* sizeof(int*) → 8; 多级指针 sizeof(void**)/int** 原只消费一个 * -> 残留影响后续解析 (fix 2026-08-23) */
            若 (tt[tk] == LB) { 整 dims = 0; 循环 (tt[tk] == LB) { tk++; 整 cdim = 0; 若 (const_expr_eval(&cdim)) { tsz *= cdim > 0 ? cdim : 1; dims++; } 若 (tt[tk] == RB) tk++; } 若 (dims == 0) tsz = 4; } /* fix 2026-08-25 bug#31: sizeof(int[5]) → 20 (原 [5] 残留 → 解析错乱崩 0xC0000005) */
            若 (tt[tk] == KK) tk++;
            整 n = Nd(0); nv[n] = tsz; 返 n;
        }
        若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == KK) tk++; 整 n = Nd(0); nv[n] = 4; 返 n; } /* sizeof(enum Tag) → int 4 字节 (fix 2026-08-15: commit-slab elem_size=sizeof(enum contains_result) → contains_result 泄漏 undefined) */
        若 (tt[tk] == ST) { tk++; /* skip struct */
            若 (tt[tk] == VR) {
                 
                整 sz = st_sz(tn[tk]); tk++; /* struct name */
                若 (tt[tk] == DK) { sz = 8; tk++; 循环 (tt[tk] == DK) tk++; } /* sizeof(struct X*) \xe2\x86\x92 8 - \xe5\x89\x8d\xe5\x90\x91\xe5\xa3\xb0\xe6\x98\x8e struct \xe6\x8c\x87\xe9\x92\x88 st_sz=0 (fix 2026-08-23) */
                若 (tt[tk] == KK) tk++; /* ) */
                整 n = Nd(0); nv[n] = sz; 返 n;
            } 否 若 (tt[tk] == FK) { /* sizeof(struct {...}) — anonymous inline definition (fix 2026-08-05: was unhandled → parse returned -1 and main() body was silently dropped) */
                tk++; /* { */
                字 aname[64]; aname[0] = 0; 整 si = st_add(aname);
                整 funs = 0; /* unsigned bit-field marker */
                循环 (tk < TS && tt[tk] != UK) {
                    整 fsz = 4; 整 frow = 1; 整 dims = 0; 整 first = 1; 整 fdbl = 0;
                    若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { fsz = 1; frow = 1; } 否 若 (!strcmp(tn[tk], "double")) { fsz = 8; frow = 8; fdbl = 1; } tk++; }
                    循环 (tt[tk] == DK) { fsz = 8; tk++; } /* pointer field (fix: DK unhandled) */
                    若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == DK) tk++; 若 (tt[tk] == VR) { 字 fn[64]; strcpy(fn, tn[tk]); tk++; st_field_sz_r(si, fn, 4, 1); } }
                    若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; }
                    若 (tt[tk] == CL) { /* unnamed bit-field */
                        tk++; 整 ubw = 0;
                        若 (tt[tk] == NK) { ubw = tv[tk]; tk++; }
                        st_field_bit_anon(si, ubw);
                        funs = 0;
                    }
                    若 (tt[tk] == VR) {
                        字 fn[64]; strcpy(fn, tn[tk]); tk++;
                        整 bitw = 0;
                        若 (tt[tk] == CL) { tk++; 若 (tt[tk] == NK) { bitw = tv[tk]; tk++; } }
                        若 (bitw > 0) { st_field_bit(si, fn, fsz, fsz, bitw, funs); 若 (fdbl) st_field_dbl(si, fn); funs = 0; }
                        否 {
                            整 fel = fsz; /* fix 2026-08-07: 数组字段元素大小 */
                            循环 (tt[tk] == LB) { tk++; 整 cdim = 0; 若 (const_expr_eval(&cdim)) { 若 (dims == 0) first = cdim; dims++; fsz *= cdim > 0 ? cdim : 1; } 否 { dims++; 循环 (tk < TS && tt[tk] != RB && tt[tk] != EK) tk++; } 若 (tt[tk] == RB) tk++; } /* t35k 2026-08-23: sizeof(匿名 struct) 数组维度整体表达式求值 (原 NK/VR/PK/MK 手写分支) */
                            若 (dims >= 1) frow = fsz / first; 否 frow = fsz;
                            st_field_sz_r(si, fn, fsz, frow);
                            若 (funs) stypes[si].fsgn[stypes[si].fn - 1] = 1; /* fix 2026-08-25 bug#33: 记录普通字段 unsigned (short 字段符号扩展判断, 原 fsgn 只给位域) */
                            stypes[si].fels[stypes[si].fn - 1] = fel; /* fix 2026-08-07 */
                            若 (fdbl) st_field_dbl(si, fn);
                        }
                    }
                    若 (tt[tk] == CK) tk++;
                    若 (tt[tk] == SK) tk++;
                }
                若 (tt[tk] == UK) tk++; /* } */
                若 (stypes[si].algn > 1) { 整 m = stypes[si].sz % stypes[si].algn; 若 (m) stypes[si].sz += stypes[si].algn - m; } /* fix 2026-08-06: struct 总大小 round up 到最大对齐 */
                整 sz = stypes[si].sz;
                若 (tt[tk] == KK) tk++; /* ) */
                整 n = Nd(0); nv[n] = sz; 返 n;
            }
        }
        若 (tt[tk] == VR && td_is(tn[tk])) { /* sizeof(TypedefName) — typedef'd struct/double (fix 2026-08-03: was 4) */
            整 tdi = tdef_lookup(tn[tk]);
            若 (tdi >= 0 && tdefs[tdi].is_struct) {
                整 sz = st_sz(tdefs[tdi].st_name); tk++;
                若 (tt[tk] == KK) tk++; /* ) */
                若 (tdefs[tdi].arr_n > 0) sz *= tdefs[tdi].arr_n; /* fix 2026-08-27 特性#2: struct typedef 数组 sizeof(PairArr)=16 */
                整 n = Nd(0); nv[n] = sz; 返 n;
            }
            若 (tdi >= 0 && tdefs[tdi].is_dbl && !tdefs[tdi].is_struct) { /* sizeof(typedef double) → 8 (fix 2026-08-05) */
                tk++;
                若 (tt[tk] == KK) tk++;
                整 n = Nd(0); nv[n] = 8; 返 n;
            }
            若 (tdi >= 0 && !tdefs[tdi].is_struct && !tdefs[tdi].is_dbl) { /* sizeof(标量 typedef) — size_t=8 (fix 2026-08-19: 原落 varname 路径 sz=4 → bitsizeof 错 → st_mult 溢出误报); typedef 数组 arr_n>0 → sz*arr_n (fix 2026-08-27 特性#2: sizeof(arr_t)=12) */
                tk++;
                若 (tt[tk] == KK) tk++;
                整 tszx = tdefs[tdi].sz;
                若 (tdefs[tdi].arr_n > 0) tszx = tdefs[tdi].sz * tdefs[tdi].arr_n;
                整 n = Nd(0); nv[n] = tszx; 返 n;
            }
            若 (tdi < 0) { /* fix 2026-08-27 特性#1: <stdint.h> 被跳过未注册的类型名兜底 — sizeof(int16_t)=4 根因 */
                整 tsz = 4;
                常 字 *tyn = tn[tk];
                若 (!strcmp(tyn, "int8_t") || !strcmp(tyn, "uint8_t")) tsz = 1;
                否 若 (!strcmp(tyn, "int16_t") || !strcmp(tyn, "uint16_t")) tsz = 2;
                否 若 (!strcmp(tyn, "int64_t") || !strcmp(tyn, "uint64_t") || !strcmp(tyn, "size_t") || !strcmp(tyn, "uintptr_t") || !strcmp(tyn, "intptr_t") || !strcmp(tyn, "ptrdiff_t") || !strcmp(tyn, "off_t") || !strcmp(tyn, "time_t")) tsz = 8;
                tk++;
                若 (tt[tk] == KK) tk++;
                整 n = Nd(0); nv[n] = tsz; 返 n;
            }
        }
        若 (tt[tk] == VR) { /* sizeof(varname): array -> N*esz, double -> 8, char -> 1, ptr -> 8, else 4 */
            整 sz = 4;
            整 esz = 4; /* element size, for sizeof(varname[0]) (fix 2026-08-17) */
            整 base_si = -1; /* struct type of the base var (for sizeof(e->field)) */
            遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                若 (!strcmp(vars[vi].name, tn[tk]) && var_codegen_visible(vi)) {
                    若 (vars[vi].arr_sz > 0) { 整 e = vars[vi].arr_esz ? vars[vi].arr_esz : 4; esz = e; sz = vars[vi].arr_sz * e; }
                    否 若 (vars[vi].is_dbl) { esz = 8; sz = 8; }
                    否 若 (vars[vi].is_char) { esz = 1; sz = 1; }
                    否 若 (vars[vi].is_short) { esz = 2; sz = 2; } /* fix 2026-08-27 特性#1: sizeof(short 变量/元素) 原 4 */
                    否 若 (vars[vi].is_ll) { esz = 8; sz = 8; } /* long long / size_t 变量 (fix 2026-08-19: 原落 else sz=4 → sizeof(size_t 参数)=4 → bitsizeof 错 → st_mult 溢出误报) */
                    否 若 (vars[vi].p_esz != 0) { esz = vars[vi].p_esz; sz = 8; } /* pointer: p_esz=element size, slot is 8 bytes */
                    否 若 (vars[vi].st_idx >= 0) { esz = st_sz(stypes[vars[vi].st_idx].name); sz = esz; } /* struct 变量: sizeof = struct 大小 (fix 2026-08-19: init_repository_format memcpy(dst,&fresh,sizeof(fresh)) 原 sz=4 只拷 version → v1_only_extensions.nr/items 栈垃圾 → verify_repository_format 误入 v1-only 错误路径 → git status 死循环/崩溃) */
                    否 { esz = 4; sz = 4; }
                    base_si = vars[vi].st_idx;
                    断;
                }
            tk++; /* skip varname */
            循环 (tt[tk] == DT || tt[tk] == AR) { /* -> / . member chain: sizeof(e->p->name) — 跟随后续成员直到最后字段 (fix 2026-08-15: precompose_utf8 sizeof(prec_dir->dirent_nfc->d_name) 原只跟一级 → d_name 泄漏 undefined) */
                tk++; /* skip ->/. */
                若 (tt[tk] == VR) {
                    若 (base_si >= 0) { 整 fs = st_field_size(stypes[base_si].name, tn[tk]); 若 (fs > 0) sz = fs; 整 el2 = st_field_el(base_si, tn[tk]); 若 (el2 > 0) esz = el2; 整 fty = st_field_ty_idx(stypes[base_si].name, tn[tk]); 若 (fty >= 0) base_si = fty; 否 base_si = -1; }
                    tk++;
                }
            }
            若 (tt[tk] == LB) { /* sizeof(varname[0]): element size (fix 2026-08-17: [0] was left dangling -> postfix index on the const-size node -> deref of const base, 0xC0000005 in regress_const_structarr) */
                tk++; 若 (tt[tk] == NK || tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++;
                sz = esz;
            }
            若 (tt[tk] == KK) tk++; /* ) */
            整 n = Nd(0); nv[n] = sz; 返 n;
        }
        若 (tt[tk] == DK) { /* sizeof(*ptr) — 指针 deref: 指向类型大小 (fix 2026-08-13: 原 return -1 → token 错位, 镜像 v4 0xC0000005; hash-ll.h Clone memcpy(dst,src,sizeof(*dst))) */
            tk++; /* * */
            整 sz = 8;
            整 si = -1;
            整 np2 = 0;
            循环 (tt[tk] == OK) { np2++; tk++; } /* fix 2026-08-19: 宏展开冗余括号 sizeof(*((src->items))) — COPY_ARRAY 的 sizeof(*(src)) 代入实参带括号 → 原见 ( 不解析直接返 8 → st_mult 收到 8 → status 崩 */
            若 (tt[tk] == VR) {
                遍 (整 vi = vs_n() - 1; vi >= 0; vi--)
                    若 (!strcmp(vars[vi].name, tn[tk]) && var_codegen_visible(vi)) {
                        若 (vars[vi].p_esz > 0) sz = vars[vi].p_esz;
                        si = vars[vi].st_idx;
                        断;
                    }
                tk++; /* var name */
                /* fix 2026-08-19: sizeof(*src->items) — 成员链解引用 (COPY_ARRAY(dst->items, src->items, dst->nr)
                   → memcpy(..., st_mult(sizeof(*src->items), n)))。原只处理 *varname, src->items 悬空 →
