                若 (tdi2v >= 0 && tdefs[tdi2v].is_dbl && !tdefs[tdi2v].is_struct && !tdefs[tdi2v].is_fnptr) { is_double = 1; } /* fix 2026-08-31: typedef double 2nd/3rd-token 路径 */ 否 若 (tdi2v >= 0 && !tdefs[tdi2v].is_fnptr && !tdefs[tdi2v].is_struct && !tdefs[tdi2v].is_dbl) { 若 (tdefs[tdi2v].sz == 1) { is_char = 1; 若 (!tdefs[tdi2v].is_uns) is_csgn = 1; } 否 若 (tdefs[tdi2v].sz == 2) { is_short = 1; } 否 若 (tdefs[tdi2v].sz == 8 && !is_double) is_ll = 1; } /* fix 2026-08-25 bug#28: typedef 宽度族 2nd/3rd-token 路径 (const uint8_t v 同修); is_uns 由 5081 统一处理; fix 2026-08-29 csmith: sz==1 补 is_csgn — int8_t(=signed char) 原 is_csgn=0 → 读取 movzx 零扩展 (0xBB→179) s94 家族 */
