                        整 tf_dbl = 0; /* fix 2026-08-27 特性#4: 匿名 typedef struct 普通字段 double 标记 (跨 VK 处理) */
                        整 npel = 0; 整 nbase = 4; /* fix 2026-08-27 第三批#2: 匿名 typedef struct 指针字段指针层级/指向元素大小 — 原只把 fdflt=8, 不设 fptrs 标记 → st_field_is_ptr=0 → var.ptrfield[i] 数组基不解引用取指针值 → 读结构体槽本身 (feat_sret11/15) */
                        若 (tt[tk] == VK) { 整 lc2 = 0; ftkw = 1; fdflt = 4; tf_dbl = 0; 循环 (tt[tk] == VK) { /* fix 2026-08-22 #36: typedef 匿名 struct 字段 unsigned long long 原只消费一个 VK → long long 漏掉 → 字段算 4 字节 (blk_SHA_CTX.size 4B → sha1 块偏移错 → 长对象哈希全错) */ 若 (!strcmp(tn[tk], "unsigned")) funs = 1; 否 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) fdflt = 1; 否 若 (!strcmp(tn[tk], "double")) { fdflt = 8; tf_dbl = 1; } 否 若 (!strcmp(tn[tk], "long")) lc2++; 否 若 (!strcmp(tn[tk], "short")) fdflt = 2; tk++; } 若 (lc2 >= 2) fdflt = 8; 否 若 (lc2 == 1) fdflt = 4; }
                        nbase = fdflt; /* 指针前的指向元素大小 (int*→4, char*→1, double*→8) */
                        循环 (tt[tk] == DK) { npel++; fdflt = 8; tk++; } /* pointer field — 计数指针层级 (fix 2026-08-27 第三批#2) */
                        若 (tt[tk] == EN) { ftkw = 1; tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == FK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == FK) d++; 否 若 (tt[tk] == UK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } 若 (tt[tk] == UK) tk++; } /* fix 2026-08-26 ffmpeg: typedef 匿名 struct 的 enum 字段 `enum {fir,iir} type;` — 原无 EN 分支 → token 不消费 → 死循环 (dither.c filter_t) */
                        若 (tt[tk] == ST) { /* nested struct field */
                            整 sub_is_union = !strcmp(tn[tk], "union"); /* fix 2026-08-27 特性#4: typedef 匿名 struct 内 union — 原按 struct 求和布局 → sizeof(含union struct)=32 (应16) */
                            tk++; /* struct */
                            若 (tt[tk] == FK) { /* 匿名 struct/union: union { ... } opr; — 解析 body 算大小 + 注册字段 + 消费数组维度 (fix 2026-08-26 lua: 同 MatchState capture[N] 缺口) */
                                整 anon_si = st_add(""); /* 匿名结构体类型 */
