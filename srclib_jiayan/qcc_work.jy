静 构 { 字 name[32]; 整 is_struct; 字 st_name[32]; 字 is_dbl; 字 is_fnptr; 字 fnptr_dbl; } tdefs[64]; 静 整 tdef_n;

__attribute__((unused))
静 整 tdef_lookup(常 字 *n) {
    遍 (整 i = 0; i < tdef_n; i++) 若 (!strcmp(tdefs[i].name, n)) 返 i;
    返 -1;
}
/* struct type index for a typedef name that aliases a struct (else -1) */
静 整 td_st_index(常 字 *n) {
    整 i = tdef_lookup(n);
    若 (i >= 0 && tdefs[i].is_struct) 返 st_find(tdefs[i].st_name);
    返 -1;
}
__attribute__((unused))
静 空 tdef_add(常 字 *n, 整 is_st, 常 字 *sn, 整 is_dbl) {
    若 (tdef_n >= 64) 返;
    /* check for duplicate */
    遍 (整 i = 0; i < tdef_n; i++) 若 (!strcmp(tdefs[i].name, n)) 返;
    strcpy(tdefs[tdef_n].name, n);
    tdefs[tdef_n].is_struct = is_st;
    tdefs[tdef_n].is_dbl = (字)is_dbl;
    tdefs[tdef_n].is_fnptr = 0;
    tdefs[tdef_n].fnptr_dbl = 0;
    若 (sn) strcpy(tdefs[tdef_n].st_name, sn);
    tdef_n++;
}
/* fnptr typedef: typedef int (*fp_t)(int,int); —— 8 字节元素，绝不是 double 槽（C 原版 221 移植） */
静 空 tdef_add_fnptr(常 字 *n, 整 ret_dbl) {
    若 (tdef_n >= 64) 返;
    遍 (整 i = 0; i < tdef_n; i++) 若 (!strcmp(tdefs[i].name, n)) 返;
    strcpy(tdefs[tdef_n].name, n);
    tdefs[tdef_n].is_struct = 0;
    tdefs[tdef_n].is_dbl = 0; /* fnptr 是指针，不是 double 值 */
    tdefs[tdef_n].is_fnptr = 1;
    tdefs[tdef_n].fnptr_dbl = (字)(ret_dbl ? 1 : 0); /* double 返回 fnptr: fp(x) 出 xmm0 */
    tdefs[tdef_n].st_name[0] = 0;
    tdef_n++;
}

