            整 stub_off = data_rva_base + 0x300 + 4 + 4 * stc_n;
            整 stub_va = 0x100000 + stub_off;
            遍 (整 i = 8; i < 0x300; i += 8) { *(整*)(ob+oi) = stub_va; *(整*)(ob+oi+4) = 0; oi += 8; }
            遍 (整 i = 0; i < stc_n; i++) { *(整*)(ob+oi) = 0; oi += 4; }
            ob[oi++] = 0xEB; ob[oi++] = 0xFE;
        }
        bin_out_len = oi;
        *(整*)BIN_OUT_LEN_ADDR = bin_out_len;
        printf("OK: bin -> mem (code=%d out=%d)\n", cp, bin_out_len);
    } 否 {
        FILE *f = fopen(outf, "wb");
        若 (!f) { fprintf(stderr, "qcc_x86: cannot write %s\n", outf); 返 1; }
        若 (bin_mode) {
            若 (bin_hdr_n > 0) {
                fwrite(bin_hdr, 1, bin_hdr_n, f);
            } 否 {
                整 code_off = 0x1000;
                整 cur = 0;
                若 (cur < code_off) { 遍 (整 i = cur; i < code_off; i++) fputc(0, f); cur = code_off; }
                fwrite(code, 1, cp, f);
                cur += cp;
                若 (cur < data_rva_base) { 遍 (整 i = cur; i < data_rva_base; i++) fputc(0, f); }
                /* .data: heap counter / IAT / ��̬�� */
                w4(f, 0); w4(f, 0);
                整 stub_off2 = data_rva_base + 0x300 + 4 + 4 * stc_n;
                整 stub_va2 = 0x100000 + stub_off2;
                遍 (整 i = 8; i < 0x300; i += 8) { w4(f, stub_va2); w4(f, 0); }
                遍 (整 i = 0; i < stc_n; i++) w4(f, 0);
                fputc(0xEB, f); fputc(0xFE, f);
            }
        } 否 若 (coff_mode) {
            write_coff_obj(f);
        } 否 {
            write_pe(f, entry_rva_global);
        }
        若 (fflush(f) != 0 || ferror(f)) { fprintf(stderr, "qcc_x86: I/O error writing %s (disk full? handle lost?)\n", outf); fclose(f); 返 1; } /* fix 2026-08-11 QA-1: fwrite 不检查返回值 → v2 截断静默成功 */
        fclose(f);
    }

    若 (asm_out) { fclose(asm_out); asm_out = NULL; }
    若 (graph_mode) graph_export(); /* -graph 旁路导出 (产物写完后, 2026-08-25) */

    若 (asm_mode) { 若 (!serve_mode) printf("OK: %s + %s.asm (%d bytes code)\n", outf, outf, cp); } 否 { 若 (!serve_mode) printf("OK: %s (%d bytes code)\n", outf, cp); } /* serve 模式抑制 OK 打印 (stdout 是响应通道, 诊断走 stderr) */
    若 (selfcheck_sha[0]) { /* Phase4 哈希审判: 编译产物 SHA256 对账不动点, fail-closed */
        字 sh[65]; sha256_file(outf, sh);
        若 (strcmp(sh, selfcheck_sha) != 0) {
            fprintf(stderr, "[SELFCHECK] FAIL: %s != %s (不动点对账失败, 哈希审判 fail-closed)\n", sh, selfcheck_sha);
            返 1;
        }
        若 (diagnostics_json) { fprintf(stderr, "{\"diagnostics\":[],\"selfcheck\":\"%s\"}\n", sh); } /* 接入 2026-08-28 AI原生 #1 v0.1: 哈希审判随 JSON 诊断同出 (甲言独有卖点) */
        否 fprintf(stderr, "[SELFCHECK] OK: %s\n", sh);
    }
    若 (expect_sha[0]) { /* #expect 源码内期望原语: 产物哈希对账 (Phase4), 与 --selfcheck 同级 */
        字 eh[65]; sha256_file(outf, eh);
        若 (strcmp(eh, expect_sha) != 0) {
            fprintf(stderr, "[EXPECT] FAIL: %s != %s (期望原语对账失败)\n", eh, expect_sha);
            返 1;
        }
        fprintf(stderr, "[EXPECT] OK: %s\n", eh);
    }
    若 (checkpoint_mode) { 字 hsh[65]; sha256_file(outf, hsh); 字 _cl[128]; sprintf(_cl, "{\"cp\":\"done\",\"artifact\":\"%.8s\"}", hsh); cp_line(_cl); } /* 编译检查点 (2026-08-28 AI原生 #6): 完成快照 (产物哈希前 8 位) */
    若 (dag_mode) { 字 dah[65]; sha256_file(outf, dah); printf("{\"dag\":{\"version\":\"%s\",\"stages\":{\"source\":\"%s\",\"tokens\":\"%s\",\"ast\":\"%s\",\"artifact\":\"%s\"}}}\n", QCC_CACHE_VER, dag_src, dag_tok, dag_ast, dah); } /* 编译 DAG 重放证明 (可吞清单 P0-9): 过程级哈希链 — 同输入+同编译器 → 同链; fix 2026-08-28: 挪进 qcc_compile_once (serve 模式 main 不执行 → dag 载荷丢失 → 客户端死等) */
    返 0;
}

/* 接入 2026-08-28 AI原生 #5: 文件级哈希增量编译 — sidecar 式缓存 (可吞清单 P0-5, MoonBit #3 + 生态 D5)
   键 = SHA256(版本 + 选项签名 + 宏表 + 源码); 命中=跳过编译 (输出文件即缓存); <outf>.qcckey 记录键
   --cache-verify: 命中时新鲜编译到 <outf>.qccfresh + 对账复验 (增量结果纳入不动点链); asm_mode/--repeat 不缓存
   fix 2026-08-28: 抽成函数 — serve/CLI 共用 (原缓存逻辑只在 main, serve 设置 cache_mode 但不走键/命中 → 缓存死代码) */
静 整 cache_try_hit(常 字 *src, 常 字 *outf, 整 asm_mode) { /* 命中→1 (跳过编译), miss→0, 失败→2/3 */
    字 pre[3600]; 整 pi = 0;
    字 ver_sel[65] = ""; 整 ver_len = 0;
    若 (selfcheck_sha[0]) { ver_len = (整)strlen(selfcheck_sha); memcpy(ver_sel, selfcheck_sha, ver_len); }
    否 { 字 mpx[1024]; DWORD mnx = GetModuleFileNameA(NULL, mpx, 1023); 若 (mnx > 0) { 字 vh[65]; sha256_file(mpx, vh); 若 (vh[0]) { memcpy(ver_sel, vh, 64); ver_len = 64; } } }
    若 (ver_len == 0) { ver_len = (整)strlen(QCC_CACHE_VER); memcpy(ver_sel, QCC_CACHE_VER, ver_len); }
    memcpy(pre + pi, ver_sel, ver_len); pi += ver_len;
    pre[pi++] = coff_mode ? 'c' : (bin_mode ? 'b' : 'x');
    若 (bare_metal) pre[pi++] = 'B';
    若 (is_compat_stat_c) pre[pi++] = 'C';
    遍 (整 mi = 0; mi < macro_n && pi < 3500; mi++) { 整 nl = (整)strlen(macros[mi].name); 若 (pi + nl + 12 < 3590) { memcpy(pre + pi, macros[mi].name, nl); pi += nl; pre[pi++] = '='; 整 vv = macros[mi].val; 字 vs[16]; 整 vi = 0; 若 (vv == 0) vs[vi++] = '0'; 循环 (vv > 0) { vs[vi++] = (字)('0' + vv % 10); vv /= 10; } 循环 (vi > 0) pre[pi++] = vs[--vi]; pre[pi++] = ';'; } }
    整 sl = (整)strlen(src);
    字 *kb = malloc(pi + sl + 1);
    memcpy(kb, pre, pi); memcpy(kb + pi, src, sl); kb[pi + sl] = 0;
    sha256_buf(kb, pi + sl, cache_key);
    free(kb);
    若 (!cache_sidecar_matches(outf)) 返 0;
    若 (selfcheck_sha[0]) { 字 sh2[65]; sha256_file(outf, sh2); 若 (strcmp(sh2, selfcheck_sha) != 0) { fprintf(stderr, "[CACHE] SELFCHECK-FAIL 缓存产物 %s != %s (不动点对账失败)\n", sh2, selfcheck_sha); 返 2; } fprintf(stderr, "[CACHE] selfcheck OK %s (缓存产物对账不动点)\n", sh2); }
    若 (cache_verify) { 字 tf[560]; strcpy(tf, outf); strcat(tf, ".qccfresh"); 若 (qcc_compile_once(src, tf, asm_mode)) { fprintf(stderr, "[CACHE] VERIFY 新鲜编译失败\n"); 返 3; } 字 hc[65], hf[65]; sha256_file(outf, hc); sha256_file(tf, hf); 若 (strcmp(hc, hf) == 0) { fprintf(stderr, "[CACHE] verify OK %s (增量产物==新鲜编译)\n", hc); } 否 { fprintf(stderr, "[CACHE] VERIFY-MISMATCH %s != %s (缓存失效, 已用新鲜产物刷新)\n", hc, hf); copy_file_bytes(tf, outf); cache_sidecar_write(outf); } }
    若 (!serve_mode) printf("OK: %s (cached)\n", outf);
    fprintf(stderr, "[CACHE] hit %.8s\n", cache_key);
    返 1;
}

/* 接入 2026-08-28 可吞清单 P1 (甲言化: 编译服务器 qccd — AI 专用中文编译器的长驻核心): --serve stdin/stdout JSON-lines 协议
   请求: {"cmd":"compile","src":"...","out":"a.exe","cache":true} / {"cmd":"compile","file":"foo.c"} / {"cmd":"ping"} / {"cmd":"quit"}
   响应(stdout): {"ok":true,"cmd":"compile","out":"a.exe","artifact":"<sha16>"} — 诊断走 stderr (与 CLI 一致), 客户端双流读取
   价值: 长驻进程免冷启动 (可重入核心重复调用) + 增量缓存命中免重编 — AI 迭代循环从秒级变毫秒级 (serve_mode 声明在顶部) */
静 整 serve_get_str(常 字 *line, 常 字 *key, 字 *out, 整 outn) { /* 最小 JSON: "key":"value" (值去转义) */
    字 pat[64]; sprintf(pat, "\"%s\":\"", key);
    常 字 *p = strstr(line, pat);
    若 (!p) 返 0;
    p += strlen(pat);
    整 oi = 0;
    循环 (*p && *p != '"' && oi < outn - 1) {
        若 (*p == '\\' && p[1]) { p++;
            若 (*p == 'n') out[oi++] = '\n';
            否 若 (*p == 'r') out[oi++] = '\r';
            否 若 (*p == 't') out[oi++] = '\t';
            否 若 (*p == '\\') out[oi++] = '\\';
            否 若 (*p == '"') out[oi++] = '"';
            否 out[oi++] = *p;
            p++;
        } 否 out[oi++] = *p++;
    }
    out[oi] = 0;
    返 1;
}
静 整 serve_get_flag(常 字 *line, 常 字 *key) { 字 pat[64]; sprintf(pat, "\"%s\":true", key); 返 strstr(line, pat) != NULL; }
静 空 serve_loop(空) {
    字 line[1048576]; /* 单请求一行; 内嵌 src 换行须 \n 转义 (大文件用 file 模式) */
    fprintf(stderr, "[SERVE] 甲言编译服务器就绪 (AI 专用中文编译器 qccd, 可重入核心 + 增量缓存)\n");
    循环 (fgets(line, 大小(line), stdin)) {
        字 cmd[32] = ""; serve_get_str(line, "cmd", cmd, 大小(cmd));
        若 (!strcmp(cmd, "quit") || serve_get_flag(line, "quit")) { fprintf(stderr, "[SERVE] 退出\n"); fflush(stdout); 返; } /* fix 2026-08-28: quit 协议 — 支持 {"cmd":"quit"} (原只查 "quit":true → 客户端永远退不出) */
        若 (!strcmp(cmd, "compile")) {
            字 src[786432]; 字 fn[512] = ""; 字 outf[512] = "a.exe";
            字 mode[32] = ""; /* 空=产码; interface/refs/dag=只解析导出 (stdout 即载荷) */
            整 use_file = serve_get_str(line, "file", fn, 大小(fn));
            serve_get_str(line, "out", outf, 大小(outf));
            serve_get_str(line, "mode", mode, 大小(mode));
            整 want_cache = serve_get_flag(line, "cache");
            字 *csrc = NULL;
            若 (use_file) { csrc = read_file(fn); 若 (!csrc) { printf("{\"ok\":false,\"cmd\":\"compile\",\"err\":\"cannot open %s\"}\n", fn); fflush(stdout); 续; } }
            否 { 若 (!serve_get_str(line, "src", src, 大小(src))) { printf("{\"ok\":false,\"cmd\":\"compile\",\"err\":\"no src/file\"}\n"); fflush(stdout); 续; } csrc = src; }
            整 saved_cache = cache_mode; cache_mode = want_cache ? 1 : 0;
            整 saved_iface = interface_mode, saved_refs = refs_mode, saved_dag = dag_mode, saved_verify = cache_verify;
            interface_mode = !strcmp(mode, "interface") ? 1 : 0;
            refs_mode = !strcmp(mode, "refs") ? 1 : 0;
            dag_mode = !strcmp(mode, "dag") ? 1 : 0;
            整 rc = 0;
            若 (cache_mode && !interface_mode && !refs_mode && !dag_mode) {
                macro_n = 0; /* fix 2026-08-28: serve 键计算前清宏表 — 缓存键含宏表, 而上次编译的 rt 宏 (QCC_RT_PREPENDED 等) 残留 → 同源两次键不同 → 缓存永不命中 (main 路径键在编译前算、宏表干净) */
                整 ch = cache_try_hit(csrc, outf, 0); /* 真缓存 (fix 2026-08-28: 原 serve 缓存死代码 — 键/命中逻辑只在 main) */
                若 (ch == 1) { printf("{\"ok\":true,\"cmd\":\"compile\",\"out\":\"%s\",\"cached\":true}\n", outf); fflush(stdout); 跳 serve_compile_done; }
                若 (ch == 2 || ch == 3) { printf("{\"ok\":false,\"cmd\":\"compile\",\"err\":\"cache-fail\"}\n"); fflush(stdout); 跳 serve_compile_done; }
            }
            rc = qcc_compile_once(csrc, outf, 0);
            若 (rc == 0 && cache_mode && !interface_mode && !refs_mode && !dag_mode) { cache_sidecar_write(outf); fprintf(stderr, "[CACHE] miss %.8s\n", cache_key); } /* 编译成功 → 落缓存键 (serve 同 main) */
            若 (interface_mode || refs_mode || dag_mode) {
                /* 载荷模式: qcc_compile_once 的 stdout 已输出接口/引用/DAG JSON (serve 抑制 OK 打印) — 它即响应 */
                若 (rc != 0) printf("{\"ok\":false,\"cmd\":\"compile\",\"mode\":\"%s\"}\n", mode);
            } 否 若 (rc == 0) { 字 ah[65]; sha256_file(outf, ah); printf("{\"ok\":true,\"cmd\":\"compile\",\"out\":\"%s\",\"artifact\":\"%.16s\"}\n", outf, ah); }
            否 printf("{\"ok\":false,\"cmd\":\"compile\",\"out\":\"%s\"}\n", outf);
            fflush(stdout);
serve_compile_done:
            cache_mode = saved_cache; interface_mode = saved_iface; refs_mode = saved_refs; dag_mode = saved_dag; cache_verify = saved_verify;
            若 (use_file) free(csrc);
        } 否 若 (!strcmp(cmd, "ping")) {
            printf("{\"ok\":true,\"cmd\":\"ping\",\"lang\":\"甲言 qcc\",\"serve\":true}\n"); fflush(stdout);
        } 否 {
            printf("{\"ok\":false,\"cmd\":\"%s\",\"err\":\"unknown command\"}\n", cmd); fflush(stdout);
        }
    }
}

/* 接入 2026-08-28 AI原生 #可嵌入: QCC_EMBEDDED 模式跳过 main — 编译器以库形式被调用 (qcc_compile_once 暴露为嵌入式 API) */
#ifndef QCC_EMBEDDED
整 main(整 argc, 字 **argv) {
    常 字 *src = "int main() { return 42; }";
    常 字 *outf = NULL;
    整 argi = 1;
    整 asm_mode = 0;
    字 *hdrs = NULL; 整 hdr_len = 0, hdr_cap = 0;
    字 *all_src = NULL; 整 all_len = 0;

    /* fix 2026-08-10 Gate 9: ������ "__bare__" ��Ǳ������������ */
    遍 (整 bi = 1; bi < argc; bi++) { 若 (argv[bi] && !strcmp(argv[bi], "__bare__")) { bare_metal = 1; 断; } }
    循环 (argc > argi) {
        若 (strcmp(argv[argi], "--help") == 0) {
            printf("甲言 qcc_x86 v5.0 · 铸基 郑宇和 · 自举 郑启元 · 审计 郑启灵 · 种子 828\nUsage: qcc_x86 [-S] [-I header.h] [-o out.exe] file.c [file2.c ...]\n  -S  output asm text\n  --cache / --cache-verify  文件级哈希增量编译 (AI原生 #5, 可吞清单 P0-5)\n  --budget  编译期资源水位报告 (AI原生 #9b, 可吞清单 P0-9b)\n  --diagnostics=json | --dj  JSON 诊断输出\n  --selfcheck <sha256>  产物哈希对账不动点\n  --repeat <N>  同进程连续编译验证可重入\n");
            返 0;
        }
        若 (strcmp(argv[argi], "--test") == 0) { printf("qcc_x86 selftest PASS · 铸基 郑宇和 · 自举 郑启元 · 审计 郑启灵 · 种子 828\n"); 返 0; }
        若 (strcmp(argv[argi], "-S") == 0) { asm_mode = 1; argi++; 续; }
        若 (strcmp(argv[argi], "-g") == 0) { dbg_on = 1; argi++; 续; } /* #289 DWARF (2026-09-01): 生成调试信息 */
        若 (strcmp(argv[argi], "-c") == 0) { coff_mode = 1; argi++; 续; }
        若 (strcmp(argv[argi], "-bin") == 0) { bin_mode = 1; argi++; 续; } /* fix 2026-08-08: 裸二进制 (内核) */
        若 (strcmp(argv[argi], "-o") == 0 && argc > argi + 1) { outf = argv[argi + 1]; argi += 2; 续; }
        若 (strcmp(argv[argi], "-D") == 0 && argc > argi + 1) { /* -D NAME=VALUE (fix 2026-08-13: Git 编译需要 C99 环境宏 __STDC_VERSION__ 等) */
            常 字 *dp = argv[argi + 1]; 常 字 *eq = dp;
            循环 (*eq && *eq != '=') eq++;
            若 (eq > dp && eq - dp < 32) {
                字 nm[64]; 整 dl = (整)(eq - dp);
                memcpy(nm, dp, dl); nm[dl] = 0;
                若 (*eq == '=') macro_add(nm, atoi(eq + 1)); 否 macro_add(nm, 1);
            }
            argi += 2; 续;
        }
        若 (strcmp(argv[argi], "--selfcheck") == 0 && argc > argi + 1) { strncpy(selfcheck_sha, argv[argi + 1], 64); selfcheck_sha[64] = 0; argi += 2; 续; }
        若 (strcmp(argv[argi], "--diagnostics=json") == 0 || strcmp(argv[argi], "--dj") == 0) { diagnostics_json = 1; argi++; 续; } /* 接入 2026-08-28 AI原生 #1: JSON 诊断模式 — 报错输出 {code,severity,message}, AI 程序化消费 */
        若 (strcmp(argv[argi], "--repeat") == 0 && argc > argi + 1) { repeat_n = atoi(argv[argi + 1]); 若 (repeat_n < 1) repeat_n = 1; argi += 2; 续; } /* 接入 2026-08-28 AI原生 #6: 同进程连续编译 N 次验证可重入 */
        若 (strcmp(argv[argi], "--cache") == 0) { cache_mode = 1; argi++; 续; } /* 接入 2026-08-28 AI原生 #5: 文件级哈希增量编译 (可吞清单 P0-5) — sidecar 式, 命中跳过编译 */
        若 (strcmp(argv[argi], "--cache-verify") == 0) { cache_verify = 1; cache_mode = 1; argi++; 续; } /* 命中时新鲜编译+对账复验 (增量结果纳入不动点链) */
        若 (strcmp(argv[argi], "--budget") == 0) { budget_flag = 1; argi++; 续; } /* 资源护栏 9b (可吞清单 P0-9b): 编译期水位报告 (AI 可读 JSON) */
        若 (strcmp(argv[argi], "--checkpoint") == 0 && argc > argi + 1) { checkpoint_mode = 1; strncpy(checkpoint_path, argv[argi + 1], 511); checkpoint_path[511] = 0; argi += 2; 续; } /* 编译检查点 (可吞清单 P0-6): 崩溃尸检 — 进度快照落盘 (lex/每函数parse/每函数codegen/done), 崩溃现场可查 */
        若 (strcmp(argv[argi], "--dag") == 0) { dag_mode = 1; argi++; 续; } /* 编译 DAG 重放证明 (可吞清单 P0-9): 过程级哈希链 (源码→token→AST→产物), 编译过程可重放可验证 */
        若 (strcmp(argv[argi], "--interface") == 0) { interface_mode = 1; argi++; 续; } /* 接口文件/语义导航 (可吞清单 P1, MoonBit #4 参考, 甲言化: 接口文件/导航 — 解析后导出 API 表面 JSON + 函数定义行号, AI 读接口不读实现) */
        若 (strcmp(argv[argi], "--recorder") == 0 && argc > argi + 1) { recorder_mode = 1; strncpy(recorder_path, argv[argi + 1], 511); recorder_path[511] = 0; argi += 2; 续; } /* 编译黑匣子 (可吞清单 P1, Agint flight-recorder 参考, 甲言化: 黑匣子) — 每函数代码增量哈希帧, 分歧逐帧定位 */
        若 (strcmp(argv[argi], "--serve") == 0) { serve_mode = 1; argi++; 续; } /* 编译服务器 qccd (甲言化, 可吞清单 P1): 长驻 stdin/stdout JSON-lines — AI 迭代循环毫秒级 */
         若 (strcmp(argv[argi], "--annotations") == 0) { annot_mode = 1; argi++; 续; } /* #173 注解导出 */
       若 (strcmp(argv[argi], "--refs") == 0) { refs_mode = 1; argi++; 续; } /* 引用收集 (可吞清单 P1): 谁引用了 X — 解析期记录 (名, 行) 表, JSON 导出 */
若 (strcmp(argv[argi], "-graph") == 0 && argc > argi + 1) { graph_mode = 1; strncpy(graph_out, argv[argi + 1], 511); graph_out[511] = 0; argi += 2; 续; } /* -graph 旁路导出 (P0 工具侧) */
        若 (strcmp(argv[argi], "-I") == 0 && argc > argi + 1) {
            字 *hb = read_file(argv[argi + 1]);
            若 (hb) {
                整 hl = (整)strlen(hb);
                若 (hdr_len + hl + 2 >= hdr_cap) { hdr_cap = hdr_len + hl + 4096; hdrs = realloc(hdrs, hdr_cap); }
                memcpy(hdrs + hdr_len, hb, hl); hdr_len += hl;
                hdrs[hdr_len++] = '\n'; hdrs[hdr_len] = 0;
                free(hb);
            }
            argi += 2; 续;
        }
        /* input file */
        strncpy(g_src_name, argv[argi], 511); g_src_name[511] = 0; /* JSON 诊断 loc.file */
        字 *fb = read_file(argv[argi]);
        若 (!fb) { fprintf(stderr, "qcc_x86: cannot open %s\n", argv[argi]); 返 1; }
        dir_of_path(argv[argi], g_src_dir, 大小(g_src_dir)); /* fix 2026-08-13 Phase3: 记录源文件目录, 供子目录 #include 相对搜索 */
        { 常 字 *pp2 = argv[argi];
          若 (strstr(pp2, "compat/stat.c") || strstr(pp2, "compat\\stat.c")) is_compat_stat_c = 1; }
        整 fl = (整)strlen(fb);
        all_src = realloc(all_src, (all_len + fl + 5) & ~3); /* fix 2026-08-12 UB-cleanup: realloc is a REAL bump alloc (not no-op)! all_len+fl+2 non-4-multiple -> tt..tll misaligned -> tll[tk] garbage -> spurious nll=1; +5=(needed+3)&~3: +4 under-allocates 1 byte when (all_len+fl)%4==3 -> all_src[all_len]=0 OOB */
        memcpy(all_src + all_len, fb, fl); all_len += fl;
        all_src[all_len++] = '\n'; all_src[all_len] = 0;
        free(fb);
        argi++;
    }
    若 (serve_mode) { serve_loop(); 返 0; } /* 编译服务器 qccd: 长驻循环 (stdin 请求 → stdout 响应, 诊断走 stderr) — 可重入核心 + 增量缓存, AI 迭代毫秒级 */
    若 (is_compat_stat_c) macro_add("QCC_COMPAT_STAT_C", 1); /* compat/stat.c 禁用 prelude 的 stat/lstat/fstat 自映射 */
    若 (all_len > 0) {
        整 total = hdr_len + all_len + 2;
        字 *combined = malloc((total + 3) & ~3); /* fix 2026-08-11 BLOCKER-3: round to 4 */
        整 pos = 0;
        若 (hdr_len > 0) { memcpy(combined, hdrs, hdr_len); pos = hdr_len; }
        memcpy(combined + pos, all_src, all_len); pos += all_len;
        combined[pos] = 0;
        src = combined;
        free(all_src);
    }
    free(hdrs);
    若 (!outf) {
        静 字 of[512]; strcpy(of, "a.exe"); outf = of;
    }

    若 (asm_mode) {
        字 af[512]; strcpy(af, outf);
        strcat(af, ".asm"); /* fix 2026-08-05: was stripping ".exe" then appending → `qcc -S f.c` wrote a.asm but printed a.exe.asm (misleading); now always outf+".asm" */
        strcpy(asm_name, af); /* fix 2026-08-06: 最终代越界重稳定时需截断重开 asm 文件 */
        asm_out = fopen(af, "wb");
    }

    /* prepend the self-host runtime (qcc_rt.c): heap realloc, fseek/ftell/rewind,
       exit/abort, strcpy/strncmp/isdigit/isalpha shadow the broken inline stubs.
       Every compiled program gets it, so stage2 is self-contained. */
    /* fix 2026-08-28: rt 拼接已移入 qcc_compile_once 内部 (reset 之后, 避免 macro_n=0 清 QCC_RT_PREPENDED → rt 剃光 → 嵌入产物崩); main 传纯用户源码 */

    /* 接入 2026-08-28 可吞清单 P0-9: 编译 DAG 重放证明 — 源码阶段哈希 (独立于缓存, 每次 --dag 都算) */
    若 (dag_mode) { 整 _dsl = (整)strlen(src); sha256_buf(src, _dsl, dag_src); }
    /* 接入 2026-08-28 AI原生 #5: 文件级哈希增量编译 — sidecar 式缓存 (可吞清单 P0-5, MoonBit #3 + 生态 D5)
       键 = SHA256(版本 + 选项签名 + 宏表 + 源码); 命中=跳过编译 (输出文件即缓存); <outf>.qcckey 记录键
       --cache-verify: 命中时新鲜编译到 <outf>.qccfresh + 对账复验 (增量结果纳入不动点链); asm_mode/--repeat 不缓存 */
    若 (cache_mode && !asm_mode && repeat_n <= 1 && all_len > 0) {
        整 _ch = cache_try_hit(src, outf, asm_mode); /* 抽成共享函数 (serve 复用, fix 2026-08-28) */
        若 (_ch == 1) 返 0;
        若 (_ch == 2 || _ch == 3) 返 1;
    }
    /* 接入 2026-08-28 AI原生 #6: 编译核心函数化 — 同进程可重复调用 (可重入无状态核心) */
    整 qc_rc = qcc_compile_once(src, outf, asm_mode);
    若 (qc_rc) 返 qc_rc;
    若 (cache_mode && !asm_mode && repeat_n <= 1 && outf && cache_key[0]) { cache_sidecar_write(outf); fprintf(stderr, "[CACHE] miss %.8s\n", cache_key); } /* 编译成功 → 落缓存键 (miss 记键, 下次命中) */
    字 rp0[65] = ""; 若 (repeat_n > 1) sha256_file(outf, rp0); /* fix 2026-08-28 可重入盲点: 记录第 1 次产物哈希 — 原只验 2..N 自洽, 漏"首 vs 次" (nll 残留 bug 因此存活) */
    遍 (整 qri = 1; qri < repeat_n; qri++) { /* --repeat: 同进程连续编译验证可重入 (每次独立分配数组, 产物应一致) */
        若 (qcc_compile_once(src, outf, asm_mode)) { fprintf(stderr, "[REPEAT] 第 %d 次编译失败 (可重入验证失败)\n", qri + 1); 返 1; }
        若 (rp0[0]) { 字 rp2[65]; sha256_file(outf, rp2); 若 (strcmp(rp0, rp2) != 0) { fprintf(stderr, "[REPEAT-FAIL] 第 %d 次编译产物 != 第 1 次 (可重入失败: %s != %s)\n", qri + 1, rp2, rp0); 返 1; } } /* 产物哈希对账: 首次 vs 每次 — 任何跨编译状态泄漏立即暴露 */
    }
    若 (repeat_n > 1) fprintf(stderr, "[REPEAT] 连续编译 %d 次一致 (含首次对账, 可重入无状态核心验证通过)\n", repeat_n);
    若 (budget_flag) budget_report(); /* 资源护栏 9b: 编译期水位报告 (AI 可读 JSON, 编译成功后) */
    返 0;

}
#endif /* QCC_EMBEDDED */