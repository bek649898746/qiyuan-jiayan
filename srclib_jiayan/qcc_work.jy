                遍 (整 ai = 0; ai < an && ai < 16; ai++) { /* fix 2026-08-13: ai<16 防 an 越界写栈 (v4 obj_macro_expand 崩溃根因候选) */
                    整 save_exp_n = fn_exp_n;
                    整 save_exp_stack[64]; 遍 (整 _s = 0; _s < 64; _s++) save_exp_stack[_s] = fn_exp_stack[_s]; /* fix 2026-08-14: 实参展开独立栈只重置 fn_exp_n, 展开实参时覆盖 fn_exp_stack[0..] → 恢复后外层栈被污染 → 非递归宏 (__ac_fsize) 被误判 in_stack → 泄漏成 undefined */
                    fn_exp_n = 0; /* 实参展开独立栈 */
                    字 eout[4096]; /* fix 2026-08-17: 实参展开用栈缓冲 — 原 malloc(64KB) 每实参
                        分配, bump allocator 下 eout 展开期间 expand_to 递归 realloc out 时
                        out 非堆顶 → fresh-copy 泄漏旧 out (sha1dc 18.5万次实参展开 × 每out 4MB
                        ≈ 数十GB → 堆越界). 实测实参展开 <100B, 栈缓冲 4KB 足够, 零堆分配零泄漏,
                        且不改任何堆分配模式 (不触发布局敏感). 超 4KB 时 fn_macro_expand_to realloc
                        到堆, eoutp 收口安全 (fix 2026-08-26 cpython). */
                    字 *eoutp = eout;
                    整 eo = 0, ecap = 大小(eout);
                    fn_macro_expand_to(args + ai * 4096, &eoutp, &eo, &ecap, -1);
                    eoutp[eo] = 0; /* fix 2026-08-26 cpython: 用 eoutp 而非 eout — 展开超栈缓冲时 fn_macro_expand_to realloc 到堆, 原 eout[eo]=0 写栈越界且 memcpy 源错 (latent bug, sys_doc ~4000 字符已近 4KB 阈值) */
                    { 整 cl = eo < 4095 ? eo : 4095; memcpy(exp_args + ai * 4096, eoutp, cl); exp_args[ai * 4096 + cl] = 0; } /* fix 2026-08-17: 显式长度复制 (栈缓冲 4096, 防 gcc -Werror 截断警告); fix 2026-08-26 cpython: 1023→4095 — sys_doc 实参 1354 字符不再截断 */
                    fn_exp_n = save_exp_n;
                    遍 (整 _s = 0; _s < 64; _s++) fn_exp_stack[_s] = save_exp_stack[_s];
                }
                /* expand body with params → args */
                字 tmp[16384]; 整 ti2 = 0;
                常 字 *body = fn_macros[fmi].body;
                遍 (整 b = 0; body[b] && ti2 < 16382; ) {
                    若 (body[b] == '#' && body[b + 1] == '#') { /* ## 拼接: 去尾空 + 跳过 ## 及后随空白 (fix 2026-08-07) */
                        循环 (ti2 > 0 && (tmp[ti2 - 1] == ' ' || tmp[ti2 - 1] == '\t')) ti2--;
                        b += 2;
                        循环 (body[b] == ' ' || body[b] == '\t') b++;
                        续;
                    }
                    若 (body[b] == '#') { /* #param 字符串化 → "转义后的参数" (fix 2026-08-07) */
                        b++;
                        循环 (body[b] == ' ' || body[b] == '\t') b++;
                        字 pn2[64]; 整 pi2 = 0;
                        循环 (isalnum((无 字)body[b]) || body[b] == '_') { 若 (pi2 < 63) pn2[pi2++] = body[b]; b++; }
                        pn2[pi2] = 0;
                        整 matched = -1;
                        遍 (整 p2 = 0; p2 < fn_macros[fmi].pn; p2++) 若 (!strcmp(fn_macros[fmi].params[p2], pn2)) { matched = p2; 断; }
                        若 (matched >= 0 && matched < an) {
                            若 (ti2 < 16382) tmp[ti2++] = '"';
                            整 va_end = !strcmp(pn2, "__VA_ARGS__") ? an : matched + 1; /* fix 2026-08-14: 只有 #__VA_ARGS__ 才逗号连接余参, 普通 #param 只字符串化一个参数 (原 #dll 把所有参数连接 → "secur32.dll, BOOL, ..." 错) */
                            遍 (整 ai = matched; ai < va_end && ti2 < 16380; ai++) {
                                若 (ai > matched) { tmp[ti2++] = ','; 若 (ti2 < 16381) tmp[ti2++] = ' '; }
                                常 字 *src = args + ai * 4096;
                                整 sk = 0, sp = 0;
                                循环 (src[sk] && (src[sk] == ' ' || src[sk] == '\t')) sk++; /* 去首空白 */
                                整 sl = 0; 循环 (src[sk + sl]) sl++; 循环 (sl > 0 && (src[sk + sl - 1] == ' ' || src[sk + sl - 1] == '\t')) sl--; /* 去尾空白 */
                                遍 (整 k = sk; k < sk + sl && ti2 < 16380; k++) {
                                    若 ((src[k] == ' ' || src[k] == '\t') && sp) 续; /* 内部连续空白 → 单空格 */
                                    sp = (src[k] == ' ' || src[k] == '\t');
                                    若 (src[k] == '\\' || src[k] == '"') { 若 (ti2 < 16380) tmp[ti2++] = '\\'; } /* 转义 \ 与 " */
                                    tmp[ti2++] = src[k];
                                }
                            }
                            若 (ti2 < 16382) tmp[ti2++] = '"';
                        } 否 { /* 非参数: 原样输出 # + 名字 (畸形宏, 不崩) */
                            若 (ti2 < 16382) tmp[ti2++] = '#';
                            遍 (整 k = 0; k < pi2 && ti2 < 16382; k++) tmp[ti2++] = pn2[k];
                        }
                        续;
                    }
                    若 (isalnum((无 字)body[b]) || body[b] == '_') {
                        字 pn2[64]; 整 pi2 = 0;
                        循环 (isalnum((无 字)body[b]) || body[b] == '_') { 若 (pi2 < 63) pn2[pi2++] = body[b]; b++; }
                        pn2[pi2] = 0;
                        整 matched = -1;
                        遍 (整 p2 = 0; p2 < fn_macros[fmi].pn; p2++) 若 (!strcmp(fn_macros[fmi].params[p2], pn2)) { matched = p2; 断; }
                        若 (matched >= 0 && !strcmp(pn2, "__VA_ARGS__")) { /* 变参: 余参逗号连接 (可空, fix 2026-08-07) */
                            遍 (整 ai = matched; ai < an && ti2 < 16380; ai++) {
                                若 (ai > matched) { tmp[ti2++] = ','; 若 (ti2 < 16381) tmp[ti2++] = ' '; }
                                遍 (整 k = 0; exp_args[ai * 4096 + k] && ti2 < 16380; k++) tmp[ti2++] = exp_args[ai * 4096 + k];
                            }
                        } 否 若 (matched >= 0 && matched < an) {
                            遍 (整 k = 0; exp_args[matched * 4096 + k] && ti2 < 16380; k++) tmp[ti2++] = exp_args[matched * 4096 + k];
                        } 否 {
                            遍 (整 k = 0; k < pi2 && ti2 < 16382; k++) tmp[ti2++] = pn2[k];
                        }
                    } 否 {
                        若 (ti2 < 16382) tmp[ti2++] = body[b++];
                    }
                }
                tmp[ti2] = 0;
                fn_arena_release(fn_arena_mark); /* fix 2026-08-26: args/exp_args 已用完 (tmp 已构建), 递归前释放 — 内层复用同一区域, 栈只留 tmp/eout */
                fn_macro_expand_to(tmp, outp, o, cap, fmi); /* recurse: body may contain nested macro calls */
                fn_exp_n--; /* 弹栈 (fix 2026-08-13) */
                out = *outp;
                续;
            }
            /* plain identifier */
            若 (*o + ni + 1 > *cap) { *cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
            遍 (整 k = 0; k < ni; k++) out[(*o)++] = nm[k];
        } 否 {
            若 (*o + 1 > *cap) { *cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
            out[(*o)++] = seg[i++];
        }
    }
    fn_scan_depth--; /* fix 2026-08-26 sqlite: 位置语义深度 */
    *outp = out;
}

/* 泛型定义预扫描 (接入 2026-08-28 机制层 #96): lex 前扫源码 "泛型 名字(params) = body;" → 注册 fn_macro
   (fn_macro_expand 在 lex 前文本展开调用, 中文 fn_macro 调用按实参类型天然多类型) */
静 空 generic_prepass(常 字 *s) {
    常 字 *p = s;
    循环 (*p) {
        若 (p[0] == '/' && p[1] == '/') { 循环 (*p && *p != '\n') p++; 续; }
        若 (p[0] == '/' && p[1] == '*') { p += 2; 循环 (*p && !(p[0] == '*' && p[1] == '/')) p++; 若 (*p) p += 2; 续; }
        若 (p[0] == '"') { p++; 循环 (*p && *p != '"') { 若 (*p == '\\') p++; p++; } 若 (*p) p++; 续; }
        若 (p[0] == '\'') { p++; 循环 (*p && *p != '\'') { 若 (*p == '\\') p++; p++; } 若 (*p) p++; 续; }
        若 (p[0] == '\xe6' && p[1] == '\xb3' && p[2] == '\x9b' && p[3] == '\xe5' && p[4] == '\x9e' && p[5] == '\x8b') { /* "泛型" */
            常 字 *q = p + 6;
            循环 (*q == ' ' || *q == '\t') q++;
            字 nm[64]; 整 qn = 0; 循环 ((isalnum((无 字)*q) || *q == '_' || (无 字)*q >= 0x80) && qn < 63) nm[qn++] = *q++;
            nm[qn] = 0;
            若 (nm[0]) {
                整 dup = 0; 遍 (整 i = 0; i < fn_macro_n; i++) 若 (!strcmp(fn_macros[i].name, nm)) { dup = 1; 断; }
                若 (!dup && fn_macro_n < 2048) {
                    strcpy(fn_macros[fn_macro_n].name, nm);
                    fn_macro_multiline[fn_macro_n] = 0;
                    循环 (*q == ' ' || *q == '\t') q++;
                    若 (*q == '(') { q++; 整 pi = 0; 循环 (*q && *q != ')' && pi < 16) { 循环 (*q==' '||*q=='\t'||*q==',') q++; 若 (*q==')') 断; 整 q2=0; 循环 ((isalnum((无 字)*q)||*q=='_') && q2<63) fn_macros[fn_macro_n].params[pi][q2++]=*q++; fn_macros[fn_macro_n].params[pi][q2]=0; pi++; /* fix 2026-08-28: 每次参数后 ++ (pn 少 1 → 只替换第一个参数) */ 若 (*q==')') 断; } 若 (*q==')') q++; fn_macros[fn_macro_n].pn=pi; }
                    否 fn_macros[fn_macro_n].pn = 0;
                    循环 (*q == ' ' || *q == '\t') q++;
                    若 (*q == '=') { q++; 循环 (*q==' '||*q=='\t') q++; }
                    整 b = 0; 循环 (*q && *q != '\n' && *q != ';' && b < 16383) fn_macros[fn_macro_n].body[b++] = *q++; /* body 到 ; 停 (fix 2026-08-28: 含 ; 展开后双分号 → 结果 0) */
                    fn_macros[fn_macro_n].body[b] = 0;
                    fn_macro_n++;
                }
            }
            p = q;
            续;
        }
        p++;
    }
}
静 字 *fn_macro_expand(常 字 *s) {
    generic_prepass(s); /* lex 前: 预扫描 泛型 定义注册 fn_macro (查重防重复) */
    整 cap = (整)strlen(s) * 2 + 1024;
    字 *out = malloc(cap);
    整 o = 0;
    fn_exp_n = 0; /* fix 2026-08-13: 重置展开栈 */
    fn_macro_expand_to(s, &out, &o, &cap, -1);
    若 (o + 1 > cap) { cap = o + 1; out = realloc(out, cap); }
    out[o] = 0;
    返 out;
}
/* conditional compilation stack (fix 2026-08-05) */
静 整 if_parent_skip[64]; 静 整 if_taken[64]; 静 整 if_n; 静 整 if_skip;
/* #if expression evaluator: defined(X), numbers, macro values, !, &&, ||, comparisons */
静 整 pp_eval(常 字 *e) {
    /* 剥离表达式内块注释/行注释 → 空白 (C 预处理语义: 注释在求值前已是空白; luaconf.h 浮点检查 #if 行尾块注释混入表达式 → 操作数解析失败, fix 2026-08-26) */
    字 ec[520]; 整 ecn = 0;
    遍 (整 i = 0; e[i] && ecn < 500; i++) {
        若 (e[i] == '/' && e[i + 1] == '*') { 循环 (e[i] && !(e[i] == '*' && e[i + 1] == '/')) i++; 若 (e[i]) i++; ec[ecn++] = ' '; 续; }
        若 (e[i] == '/' && e[i + 1] == '/') { 循环 (e[i] && e[i] != '\n') i++; ec[ecn++] = ' '; 续; }
        ec[ecn++] = e[i];
    }
    ec[ecn] = 0;
    e = ec;
    /* strip outer parens — only if the FIRST ( matches the LAST ) (fix 2026-08-06 M7:
       原只看首尾字符，(1<2)&&(2<3) 被误剥成 1<2)&&(2<3 → 括号失衡) */
    循环 (*e == ' ') e++;
    整 len = (整)strlen(e);
    循环 (len > 0 && e[len-1] == ' ') len--;
    若 (len >= 2 && e[0] == '(') {
        整 d = 0, m = -1;
        遍 (整 i = 0; i < len; i++) {
            若 (e[i] == '(') d++;
            否 若 (e[i] == ')') { d--; 若 (d == 0) { m = i; 断; } }
        }
        若 (m == len - 1) {
            字 inner[512]; memcpy(inner, e+1, len-2); inner[len-2] = 0;
            返 pp_eval(inner);
        }
    }
    /* ! 只作用于紧邻操作数 (fix step28: 原 `!A || B` 被算成 !(A||B) — `!` 吃了整个剩余表达式;
       现: 数前缀 ! 个数 → 解析紧邻操作数 (括号组/defined()/标识符) → 求值取反 → 剩余尾部拼回重求值;
       操作数无法解析 (如 `!-5`) 回退旧行为, 兼容病理输入) */
    {
        整 nneg = 0; 整 i = 0;
        循环 (e[i] == '!') { nneg++; i++; }
        若 (i > 0) {
            循环 (e[i] == ' ' || e[i] == '\t') i++;
            整 end = i;
            若 (e[i] == '(') {
                整 d = 1; end++;
                循环 (e[end] && d > 0) { 若 (e[end] == '(') d++; 否 若 (e[end] == ')') d--; end++; }
                若 (e[end] == ')') end++;
            } 否 若 (!strncmp(e + i, "defined", 7) && e[i + 7] == '(') {
                整 d = 1; end = i + 8;
                循环 (e[end] && d > 0) { 若 (e[end] == '(') d++; 否 若 (e[end] == ')') d--; end++; }
                若 (e[end] == ')') end++;
            } 否 {
                循环 (e[end] && (isalnum((无 字)e[end]) || e[end] == '_' || ((无 字)e[end] >= 0x80))) end++;
            }
            若 (end > i) {
                字 opd[512]; 整 ol = end - i; 若 (ol > 510) ol = 510; memcpy(opd, e + i, ol); opd[ol] = 0;
                整 ov = pp_eval(opd);
                整 v = (nneg & 1) ? (ov ? 0 : 1) : ov;
                若 (e[end] == 0) 返 v;
                字 full[512];
                sprintf(full, "%d %s", v, e + end);
                返 pp_eval(full);
            }
            返 pp_eval(e + 1) ? 0 : 1; /* 操作数无法解析: 回退旧行为 */
        }
    }
    /* split on || (lowest precedence), then &&, then ==/!=/< <= > >= — paren-aware (fix 2026-08-06 M7: 原在括号内错拆，(A||B)&&C 拆错) */
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '|' && e[i+1] == '|') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 2);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 (pp_eval(a) || pp_eval(b)) ? 1 : 0;
        }
    }
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '&' && e[i+1] == '&') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 2);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 (pp_eval(a) && pp_eval(b)) ? 1 : 0;
        }
    }
    /* 位或 | (fix 2026-08-26 cpython: _PyObject_VAR_SIZE #if ((SIZEOF_VOID_P-1) & SIZEOF_VOID_P) — 位运算缺位 → 条件求值错) */
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '|' && e[i+1] != '|') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 1);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 pp_eval(a) | pp_eval(b);
        }
    }
    /* 异或 ^ */
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '^') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 1);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 pp_eval(a) ^ pp_eval(b);
        }
    }
    /* 位与 & (单 &, 与 && 区分) */
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '&' && e[i+1] != '&') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 1);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            返 pp_eval(a) & pp_eval(b);
        }
    }
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        字 op = 0; 整 ol = 0;
        若 (dp == 0 && e[i] == '=' && e[i+1] == '=') { op = 1; ol = 2; }
        否 若 (dp == 0 && e[i] == '!' && e[i+1] == '=') { op = 2; ol = 2; }
        否 若 (dp == 0 && e[i] == '<' && e[i+1] == '=') { op = 3; ol = 2; }
        否 若 (dp == 0 && e[i] == '>' && e[i+1] == '=') { op = 4; ol = 2; }
        否 若 (dp == 0 && e[i] == '<' && e[i+1] != '<' && (i == 0 || e[i-1] != '<')) { op = 5; ol = 1; } /* fix 2026-08-26 cpython: 排除 << 移位 (前后都查 — `A >> B` 的第二个 > 原被当比较) */
        否 若 (dp == 0 && e[i] == '>' && e[i+1] != '>' && (i == 0 || e[i-1] != '>')) { op = 6; ol = 1; }
        若 (op) {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + ol);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            整 x = pp_eval(a), y = pp_eval(b);
            若 (op >= 3 && (pp_eval_operand_uns(a) || pp_eval_operand_uns(b))) { /* fix 2026-08-26 cpython: 无符号感知比较 — UINT32_MAX=4294967295 截断 int 为 -1, `OUTPUT_BUFFER_MAX_BLOCK_SIZE > UINT32_MAX` (268M > 4G 应假) 误判真 → zlibmodule.c #error; 操作数是无符号宏时按 32 位无符号比较 */
                无 ux = (无)x, uy = (无)y;
                若 (op == 3) 返 ux <= uy;
                若 (op == 4) 返 ux >= uy;
                若 (op == 5) 返 ux < uy;
                若 (op == 6) 返 ux > uy;
            }
            若 (op == 1) 返 x == y;
            若 (op == 2) 返 x != y;
            若 (op == 3) 返 x <= y;
            若 (op == 4) 返 x >= y;
            若 (op == 5) 返 x < y;
            若 (op == 6) 返 x > y;
        }
    }
    /* 移位 << >> (优先级高于关系比较, 低于加减) */
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (dp == 0 && e[i] == '<' && e[i+1] == '<') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 2);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            整 sh = pp_eval(b); 返 sh >= 0 && sh < 32 ? pp_eval(a) << sh : 0;
        } 否 若 (dp == 0 && e[i] == '>' && e[i+1] == '>') {
            字 a[512], b[512]; memcpy(a, e, i); a[i] = 0; strcpy(b, e + i + 2);
            整 la = (整)strlen(a); 循环 (la > 0 && (a[la-1] == ' ' || a[la-1] == '\t')) a[--la] = 0;
            整 lb = (整)strlen(b); 循环 (lb > 0 && (b[lb-1] == ' ' || b[lb-1] == '\t')) b[--lb] = 0;
            整 sh = pp_eval(b); 返 sh >= 0 && sh < 32 ? pp_eval(a) >> sh : 0;
        }
    }
    /* arithmetic +/- (fix 2026-08-13: git-compat-util.h 的 __STDC_VERSION__ - 0 < 199901L;
       原整串当宏名 → 0 → #error. 优先级低于比较: 比较先拆, 算术在更内层;
       fix 2026-08-26 cpython: 循环从 i=0 起数括号 — 原 i=1 漏数首 '(' → (A-1)&B 的 - 被当顶层拆分 → 求值错) */
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (i >= 1 && dp == 0 && (e[i] == '-' || e[i] == '+')) {
            字 a[512], b[512];
            整 la = i;
            循环 (la > 0 && (e[la-1] == ' ' || e[la-1] == '\t')) la--;
            memcpy(a, e, la); a[la] = 0;
            strcpy(b, e + i + 1);
            整 x = pp_eval(a), y = pp_eval(b);
            返 e[i] == '-' ? x - y : x + y;
        }
    }
    /* arithmetic * / % (fix 2026-08-26 pngtest: png.h 版本检查 #if PNG_LIBPNG_VER != PNG_LIBPNG_VER_MAJOR * 10000 + ... 
       — 原无乘除拆解 → `PNG_LIBPNG_VER_MAJOR * 10000` 整串当宏名 → 0 → 10643!=0 误报 #error "Inconsistent version numbers".
       在 +/- 之后拆分 (乘除优先级高于加减; 递归内层自然生效); 除零返回 0 防 UB; fix 2026-08-26 cpython: 同 +/- 括号计数) */
    遍 (整 i = 0, dp = 0; e[i]; i++) {
        若 (e[i] == '(') dp++;
        否 若 (e[i] == ')') dp--;
        若 (i >= 1 && dp == 0 && (e[i] == '*' || e[i] == '/' || e[i] == '%')) {
            字 a[512], b[512];
            整 la = i;
            循环 (la > 0 && (e[la-1] == ' ' || e[la-1] == '\t')) la--;
            memcpy(a, e, la); a[la] = 0;
            strcpy(b, e + i + 1);
            整 x = pp_eval(a), y = pp_eval(b);
            若 (e[i] == '*') 返 x * y;
            若 (e[i] == '/') 返 y ? x / y : 0;
            返 y ? x % y : 0;
        }
    }
    /* number or macro name (fix 2026-08-06: 支持负数字面量 #if -5 < 0; 原 -5 落到 macro_find 失败 → 0) */
    整 neg = 0;
    若 (e[0] == '-') { neg = 1; e++; }
    若 (e[0] == '0' && (e[1] == 'x' || e[1] == 'X')) {
        整 v = 0, p = 2; 循环 (isxdigit((无 字)e[p])) { 整 c = e[p]; v = v * 16 + (c >= '0' && c <= '9' ? c - '0' : (c >= 'a' && c <= 'f' ? c - 'a' + 10 : c - 'A' + 10)); p++; }
        返 neg ? -v : v;
    }
    若 (e[0] == '0' && e[1] >= '0' && e[1] <= '7') { 整 v = 0, p = 0; 循环 (e[p] >= '0' && e[p] <= '7') v = v * 8 + (e[p++] - '0'); 返 neg ? -v : v; } /* fix 2026-08-26 cpython: 八进制字面量 — fileutils.c `#if _S_IREAD != 0400` 原 0400 按十进制 400 求值 → 256!=400 真 → #error "Unsupported C library"; 必须在十进制之前 (0 开头优先) */
    若 (isdigit((无 字)e[0])) { 整 v = 0, p = 0; 循环 (isdigit((无 字)e[p])) v = v * 10 + (e[p++] - '0'); 返 neg ? -v : v; }
    若 (neg) 返 0; /* -名字: 不支持 */
    若 (!strncmp(e, "defined", 7) && e[7] == '(') { /* defined(X) 原子: 逻辑/比较拆分后到达 (fix 2026-08-15: defined(A)||defined(B) 原早退只算 A) */
        字 nm[64]; 整 ni = 0; 整 p = 8;
        循环 (isalnum((无 字)e[p]) || e[p] == '_' || ((无 字)e[p] >= 0x80)) { 若 (ni < 63) nm[ni++] = e[p]; p++; }
        nm[ni] = 0;
        返 (macro_exists(nm) || pp_guard_exists(nm)) ? 1 : 0; /* fix 2026-08-06: 原 macro_find>=0 对负值宏判假; 2026-08-07: 顺序定义表也算 */
    }
    { 常 字 *ob = obj_find(e); 若 (ob && ob[0] && pp_eval_depth < 24) { pp_eval_depth++; 整 _r = pp_eval(ob); pp_eval_depth--; 返 _r; } } /* fix 2026-08-26 pngtest: 对象宏别名在 #if 里递归求值 (#define PNG_LIBPNG_VER_SONUM PNG_LIBPNG_VER_SHAREDLIB — lexer 把非数值宏也注册成数值宏=0 → macro_exists 恒真 → 别名永不展开 → 16!=0 误报 #error); 必须在 macro_exists 之前查 obj_find — 别名宏在 macros[] 里的值是垃圾 0; 深度上限防 #define A A 自引用死循环 */
    若 (macro_exists(e)) 返 macro_find(e); /* fix 2026-08-06: 原 mv>=0 把负值宏当未找到 → 0 */
    返 pp_guard_val_of(e); /* fix 2026-08-07: 顺序定义表的值 (#define MODE 2 → #if MODE==1 用真值而非存在性) */
}

/* include 目录栈: #include "x.h" 先相对当前源文件所在目录搜索, 再相对 cwd (fix 2026-08-13 Phase3) */
静 字 inc_dir_stack[16][512]; 静 整 inc_dir_n;
静 字 g_inc_found_dir[512]; /* fix 2026-08-26 ffmpeg: pp_read_file_inc 实际找到文件的目录 (父链回溯命中时记录), pp_include_expand 用它建 inc_dir_stack — 原按 fname 子目录拼接导致头内相对 include 解析错 */
静 字 g_src_dir[512]; /* 顶层源文件目录 */
静 空 dir_of_path(常 字 *path, 字 *out, 整 cap) {
    整 i = 0, last = -1;
    循环 (path[i]) { 若 (path[i] == '/' || path[i] == '\\') last = i; i++; }
    若 (last > 0) { 整 n = last < cap - 1 ? last : cap - 1; memcpy(out, path, n); out[n] = 0; }
    否 out[0] = 0;
}
静 字 *pp_read_file_inc(常 字 *fname);

/* #include "file" — 预处理器包含展开（lex 前；条件编译感知；fix 2026-08-06） */
静 字 *pp_read_file(常 字 *path) {
    FILE *f = fopen(path, "rb");
    若 (!f) 返 0;
    fseek(f, 0, 2); 长 sz = ftell(f); fseek(f, 0, 0); /* SEEK 宏定义在本函数之后，自宿主不处理真实 <stdio.h>；用字面量 0/1/2 避开先使用后定义 (fix 2026-08-16 自举回归) */
    若 (sz < 0) { fclose(f); 返 0; }
    若 (sz > 16 * 1024 * 1024) { fclose(f); fprintf(stderr, "[ERR] #include 文件超过 16MB 上限 (fix 2026-08-06 M8: 原无大小上限，编译不可信源码=任意大文件读取面)\n"); exit(1); }
    字 *buf = malloc((size_t)sz + 1);
    若 (!buf) { fclose(f); 返 0; }
    size_t rd = fread(buf, 1, (size_t)sz, f);
    buf[rd] = 0; fclose(f);
    返 buf;
}
静 字 *pp_read_file_inc(常 字 *fname) {
    g_inc_found_dir[0] = 0; /* fix 2026-08-26 ffmpeg: 每次搜索前清空, 成功点记录实际目录 */
    若 (!strcmp(fname, "accctrl.h") || !strcmp(fname, "aclapi.h")) {
        /* Windows SDK 头文件不在源码树内; compat_prelude.h 已提供 ipc-win32.c 所需的类型/宏/API stub (fix 2026-08-15: ipc_get_active_state undefined) */
        字 *stub = malloc(2);
        若 (stub) stub[0] = 0;
        返 stub;
    }
    若 (!strcmp(fname, "limits.h")) {
        /* fix 2026-08-26 lua: <limits.h> 被跳过 → LLONG_MAX 等未定义 → luaconf.h `#if defined(LLONG_MAX)` 假
           → 整数类型链落到 #error "Compiler does not support 'long long'". 内建 limits.h: 标准整数极值
           (值同 png_compat.h, 已验证; 负值不括号 — pp_def_parse 只认 -N / (N)) */
        常 字 *st = "#define CHAR_BIT 8\n"
            "#define SCHAR_MIN -128\n#define SCHAR_MAX 127\n#define UCHAR_MAX 255\n"
            "#define CHAR_MIN 0\n#define CHAR_MAX 255\n"
            "#define SHRT_MIN -32768\n#define SHRT_MAX 32767\n#define USHRT_MAX 65535\n"
            "#define INT_MIN -2147483647\n#define INT_MAX 2147483647\n#define UINT_MAX 4294967295u\n"
            "#define LONG_MIN -9223372036854775808\n#define LONG_MAX 9223372036854775807\n#define ULONG_MAX 18446744073709551615UL\n"
            "#define LLONG_MIN -9223372036854775808\n#define LLONG_MAX 9223372036854775807\n#define ULLONG_MAX 18446744073709551615ULL\n";
        size_t sl = strlen(st);
        字 *stub2 = malloc(sl + 1);
        若 (stub2) { memcpy(stub2, st, sl); stub2[sl] = 0; }
        返 stub2;
    }
    若 (!strcmp(fname, "stdint.h")) {
        /* fix 2026-08-29 csmith 崩溃族根因: <stdint.h> 系统头被跳过 (角括号 include 找不到即弃)
           → uint64_t/int64_t/size_t/intptr_t 无 typedef 注册 → 类型尺寸落默认 4 (错)
           → crc32_8bytes(uint64_t val) 参数 32 位 → (val>>32) 在 x86 移位计数 mod32 环绕成 >>0
           → 字节重复 → 校验和错 + 多维指针/volatile 崩溃族 (csmith 20 种子 17 崩)。
           内置 stdint.h: 标准整数类型 (x86_64 Win64), 值同 mingw; 已有 limits.h/stdarg.h 同款先例。
           注意 custom_stdint_x86.h 的 #define uint64_t 多 token 值 qcc 宏系统不支持 → 死宏, 无冲突。 */
        常 字 *st =
            "typedef signed char int8_t;\n"
            "typedef unsigned char uint8_t;\n"
            "typedef short int16_t;\n"
            "typedef unsigned short uint16_t;\n"
            "typedef int int32_t;\n"
            "typedef unsigned int uint32_t;\n"
            "typedef long long int64_t;\n"
            "typedef unsigned long long uint64_t;\n"
            "typedef long long intptr_t;\n"
            "typedef unsigned long long uintptr_t;\n"
            "typedef unsigned long long size_t;\n"
            "typedef long long ssize_t;\n"
            "typedef long long ptrdiff_t;\n"
            "typedef long long intmax_t;\n"
            "typedef unsigned long long uintmax_t;\n"
            "typedef long long int_least64_t;\n"
            "typedef unsigned long long uint_least64_t;\n"
            "typedef int int_least32_t;\n"
            "typedef unsigned int uint_least32_t;\n"
            "typedef long long int_fast64_t;\n"
            "typedef unsigned long long uint_fast64_t;\n"
            "typedef int int_fast32_t;\n"
            "typedef unsigned int uint_fast32_t;\n";
        size_t sl = strlen(st);
        字 *stub2 = malloc(sl + 1);
        若 (stub2) { memcpy(stub2, st, sl); stub2[sl] = 0; }
        返 stub2;
    }
    若 (!strcmp(fname, "stdarg.h")) {
        /* fix 2026-08-23 t35e: <stdarg.h> is skipped by qcc (angle-bracket includes are
           dropped), so mingw's __builtin_va_start/__builtin_va_arg become undefined-function
           calls that silently return 0, and va_list decays to a 4-byte int (truncating the
           64-bit home-address) -> the whole va_list chain fails (git strbuf_addf/vsnprintf
           emit nothing). Builtin stdarg.h: va_list=char*, va_start->__qcc_va_start()
           (returns the Win64 home-area address), va_arg->pure C pointer arithmetic. */
        常 字 *st = "typedef char *va_list;\n"
            "#define _INTSIZEOF(n) ((sizeof(n) + 7) & ~7)\n"
            "#define va_start(ap, last) ((ap) = __qcc_va_start())\n"
            "#define va_arg(ap, type) (*(type *)(((ap) += _INTSIZEOF(type)) - _INTSIZEOF(type)))\n"
            "#define va_end(ap) ((ap) = 0)\n"
            "#define va_copy(d, s) ((d) = (s))\n";
        size_t sl = strlen(st);
        字 *stub2 = malloc(sl + 1);
        若 (stub2) { memcpy(stub2, st, sl); stub2[sl] = 0; }
        返 stub2;
    }
    若 (inc_dir_n > 0 && inc_dir_stack[inc_dir_n - 1][0]) {
        字 full[1024];
        strcpy(full, inc_dir_stack[inc_dir_n - 1]);
        strcat(full, "/");
        strcat(full, fname);
        字 *fc = pp_read_file(full);
        若 (fc) { strcpy(g_inc_found_dir, inc_dir_stack[inc_dir_n - 1]); 返 fc; }
        /* fix 2026-08-16 根治: #include 只搜当前源文件目录 — Git 头文件在根目录 (git-compat-util.h/builtin.h),
           子目录源文件 include 不到 → 224 文件全部 [ERR] 找不到。向上回溯父目录链。 */
        字 par[1024];
        strcpy(par, inc_dir_stack[inc_dir_n - 1]);
        遍 (;;) {
            字 *sl = strrchr(par, '/');
            字 *bs = strrchr(par, '\\');
            若 (bs > sl) sl = bs; /* Windows 路径反斜杠分隔 (fix 2026-08-16: 原只找 '/' 回溯永不触发) */
            若 (!sl) 断;
            *sl = 0;
            若 (!par[0]) 断;
            字 full2[1024];
            strcpy(full2, par);
            strcat(full2, "/");
            strcat(full2, fname);
            字 *fc2 = pp_read_file(full2);
            若 (fc2) { strcpy(g_inc_found_dir, par); 返 fc2; }
        }
    }
    返 pp_read_file(fname);
}
/* 第N行: 计算源码 pos 处的行号 (fix 2026-08-06 Task 5.3 中文诊断) */
静 整 rt_line_skip = 0; /* prepend 的 qcc_rt.c 行数 (用户源码行号校正) */
静 整 line_at(常 字 *s, 整 pos) {
    整 ln = 1;
    遍 (整 k = 0; k < pos && s[k]; k++) 若 (s[k] == '\n') ln++;
    返 ln - rt_line_skip;
}
静 字 expect_sha[65] = ""; /* #expect (Phase 4 哈希审判) */
静 字 selfcheck_sha[65] = ""; /* Phase4 --selfcheck */
静 空 sha256_buf(常 字 *data, 整 len, 字 out[65]); /* fwd: 定义在资源护栏区 (契约哈希/描述符需在 parse 期用) */
