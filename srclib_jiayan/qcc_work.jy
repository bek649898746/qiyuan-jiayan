静 整 node_psz(整 n); /* t49c4 fwd */
静 整 mem_addr(整 n, 整 *fsz_out, 整 *si_out);


静 整 var_arrsz(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].arr_sz;
    返 0;
}
/* element size for ptr[i] / arr[i]: arr_esz (arrays AND pointer params/locals now store
   it) else p_esz (legacy local char star / int star) else 4. char** yields 8 so argv[i]
   scales by 8. */
静 整 var_esz(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= 0; i--)
        若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) {
            
            若 (vars[i].arr_esz > 0) 返 vars[i].arr_esz;
            返 vars[i].p_esz > 0 ? vars[i].p_esz : 4;
        }
    返 4;
}
/* 变量类型大小 (fix 2026-08-20: sizeof(uint64_t v) 原返回 4 → csprng_bytes(&v, sizeof(v)) 只填低 4 字节
   → mkstemp 随机后缀高 4 字节是栈垃圾 → 第一次替换出乱码文件名 (git_mkstemps_mode tmp_obj_XXXXXX) */
静 整 var_sizeof(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= 0; i--)
        若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) {
            若 (vars[i].st_idx >= 0 && stypes[vars[i].st_idx].sz > 0) 返 stypes[vars[i].st_idx].sz; /* struct/typedef 变量 */
            若 (vars[i].arr_sz > 0) 返 vars[i].arr_sz * (vars[i].arr_esz > 0 ? vars[i].arr_esz : 4); /* 数组总字节 */
            若 (vars[i].p_depth > 0 || vars[i].p_esz > 0) 返 8; /* 指针 8 字节 */
            若 (vars[i].is_ll) 返 8; /* long long */
            若 (vars[i].is_dbl) 返 8; /* fix 2026-08-27 特性#1: double 变量 */
            若 (vars[i].is_char) 返 1; /* fix 2026-08-27 特性#1: char 变量 */
            若 (vars[i].is_short) 返 2; /* fix 2026-08-27 特性#1: short 变量 */
            返 4;
        }
    返 0;
}
静 整 cur_frame_sz = 96; /* set in main() before codegen: size of every function frame */

/* load a pointer-typed variable's VALUE into eax: static → .data slot (RIP-relative),
   local/param → frame slot. Centralized so the if/else emits in a small function
   (the inline single-statement if/else form was observed to drop both branches in
   the compiled compiler). */
静 空 load_ptr_slot(整 off, 常 字 *vn) {
    若 (var_isstatic(vn)) mov_rax_rip64(coff_static_disp(off, 1) - 1);
    否 mov_reg_mbrp64(0, off - cur_frame_sz);
}

/* eax = param value: register param (rcx/rdx/r8/r9) or stack param ([rbp+pdisp]) */
静 空 load_param_val(常 字 *name) {
    遍 (整 i = vs_n() - 1; i >= 0; i--) {
        若 (!strcmp(vars[i].name, name) && var_codegen_visible(i)) {
            整 _wide = vars[i].is_ll || vars[i].p_esz > 0 || vars[i].st_idx >= 0; /* fix 2026-08-22 #34b: 指针/struct 参数槽存 64 位地址 — 原只有 is_ll 才 64 位读, 指针参数 p->dm=t 高 32 位截断 */
            若 (vars[i].pstk) { 若 (_wide) mov_reg_mbrp64(0, vars[i].pdisp); 否 mov_reg_mbrp(0, vars[i].pdisp); } /* eax/rax = [rbp+pdisp] */
            否 若 (vars[i].is_param) { 整 r = -(vars[i].rsp_off + 1); 若 (r != 0) { 若 (_wide) mov_rr64(0, r); 否 mov_rr(0, r); } }
            返;
        }
    }
}

