                                否 { 整 fty = st_field_ty_idx(stypes[csi].name, tn[tk]); 若 (fty >= 0) { csi = fty; sz = st_sz(stypes[csi].name); } 否 { 整 pel = st_field_pel(csi, tn[tk]); 若 (pel > 0) sz = pel; csi = -1; } }
