/* 变量类型大小 (fix 2026-08-20: sizeof(uint64_t v) 原返回 4 → csprng_bytes(&v, sizeof(v)) 只填低 4 字节
   → mkstemp 随机后缀高 4 字节是栈垃圾 → 第一次替换出乱码文件名 (git_mkstemps_mode tmp_obj_XXXXXX) */
静 整 var_sizeof(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= 0; i--)
        若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) {
            若 (vars[i].st_idx >= 0 && stypes[vars[i].st_idx].sz > 0) 返 stypes[vars[i].st_idx].sz; /* struct/typedef 变量 */
            若 (vars[i].arr_sz > 0) { 整 e = vars[i].arr_esz > 0 ? vars[i].arr_esz : 4; 整 es = vars[i].p_esz > 0 ? vars[i].p_esz : e; 返 vars[i].arr_sz * es; } /* 数组总字节 (fix 2026-08-28: 2D 用标量元素大小, sizeof(int[2][2])=16 非 行大小8×总元素4=32) */
