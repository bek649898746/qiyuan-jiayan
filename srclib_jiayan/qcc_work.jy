    若 (tt[tk] == VR && !strcmp(tn[tk], "依据")) { /* 接入 2026-08-28 switch 表达式 (有值, 蓝图 §二): 依据 r, x 对照 1: a, 2: b, 其他: c; → { __sw=x; __sr=(其他或0); if(__sw==1){__sr=a;} if(__sw==2){__sr=b;} r=__sr; } — 多路等值分发 (select 指令试吞) */
        tk++; /* 依据 */
