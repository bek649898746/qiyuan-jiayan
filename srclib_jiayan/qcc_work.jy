              整 asg = Nd(10); Nc(asg, v_b2); Nc(asg, pl); Nc(wbd, asg); } /* __rb++; */
            { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(wbd, setl); nv[wh] = cl + 1; }
            Nc(wh, wbd);
            Nc(ibd, wh); }
          /* 反转2 [n-__rt, n) */
          { 整 d = Nd(7); memcpy((字*)(nn + d), cname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(ibd, d); }
          { 整 wh = Nd(9);
            { 整 v_c = Nd(1); memcpy((字*)(nn + v_c), cname, 32);
              整 v_k2 = Nd(1); memcpy((字*)(nn + v_k2), kname, 32);
              整 half = Nd(2); nv[half] = DV; Nc(half, v_k2); { 整 two = Nd(0); nv[two] = 2; Nc(half, two); } /* __rt/2 */
              整 cmp2 = Nd(2); nv[cmp2] = T_LK; Nc(cmp2, v_c); Nc(cmp2, half);
