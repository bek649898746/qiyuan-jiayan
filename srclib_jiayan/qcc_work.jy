    若 (tt[tk] == VR && !strcmp(tn[tk], "解构")) { /* 接入 2026-08-28 解构赋值 (同时赋值): 解构(a, b, c) = (e1, e2, e3); → { __dc_0=e1; __dc_1=e2; __dc_2=e3; a=__dc_0; b=__dc_1; c=__dc_2; } — RHS 先整体求值 (临时变量), 再逐个写 LHS; 变量数 2-N */
        tk++; /* 解构 */
        字 lnames[16][64]; 整 ln = 0;
        若 (tt[tk] == OK) tk++; /* ( */
        循环 (tt[tk] == VR && ln < 16) { strcpy(lnames[ln], tn[tk]); ln++; tk++; 若 (tt[tk] == CK) tk++; 否 断; }
        若 (tt[tk] == KK) tk++; /* ) */
        若 (tt[tk] == AK) tk++; /* = */
        整 rhsv[16]; 整 rn = 0;
        若 (tt[tk] == OK) tk++; /* ( */
        循环 (tt[tk] != KK && tt[tk] != SK && tt[tk] != EK && rn < 16) { rhsv[rn] = expr(); rn++; 若 (tt[tk] == CK) tk++; 否 断; }
        若 (tt[tk] == KK) tk++; /* ) */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 dc_seq = 0;
        整 blk = Nd(5);
        /* 接入 2026-08-28 多返回值拆包: 解构(a, b) = f(); → { long long __dp=f(); a=(int)__dp; b=(int)(__dp>>32); } — RHS 单调用 + LHS≥2 时拆 64 位打包 */
        若 (rn == 1 && rhsv[0] >= 0 && nt[rhsv[0]] == 4 && ln >= 2) {
            静 整 dp_seq = 0; 字 dpn[64]; sprintf(dpn, "__dp_%d_", dp_seq++);
            var_ll(dpn);
            { 整 d = Nd(7); memcpy((字*)(nn + d), dpn, 32); Nc(d, rhsv[0]); Nc(blk, d); } /* long long __dp = f(); */
            { 整 v_p = Nd(1); memcpy((字*)(nn + v_p), dpn, 32);
              整 v_l = Nd(1); memcpy((字*)(nn + v_l), lnames[0], 32);
              整 asg = Nd(10); Nc(asg, v_l); Nc(asg, v_p); Nc(blk, asg); } /* a = __dp (低 32 隐式截断); */
            { 整 v_p = Nd(1); memcpy((字*)(nn + v_p), dpn, 32);
              整 sh = Nd(2); nv[sh] = SR; nll[sh] = 1; Nc(sh, v_p); { 整 c32 = Nd(0); nv[c32] = 32; Nc(sh, c32); } /* __dp >> 32 */
              整 v_l = Nd(1); memcpy((字*)(nn + v_l), lnames[1], 32);
              整 asg = Nd(10); Nc(asg, v_l); Nc(asg, sh); Nc(blk, asg); } /* b = __dp >> 32; */
            返 blk;
        }
        遍 (整 i = 0; i < rn; i++) { /* RHS 存临时 */
            字 tmpn[64]; sprintf(tmpn, "__dc_%d_%d_", dc_seq, i);
            var_offset(tmpn);
            { 整 d = Nd(7); memcpy((字*)(nn + d), tmpn, 32); Nc(d, rhsv[i]); Nc(blk, d); }
        }
        dc_seq++;
        遍 (整 i = 0; i < ln && i < rn; i++) { /* LHS 逐个赋值 */
            字 tmpn[64]; sprintf(tmpn, "__dc_%d_%d_", dc_seq - 1, i);
            整 v_l = Nd(1); memcpy((字*)(nn + v_l), lnames[i], 32);
            整 v_t = Nd(1); memcpy((字*)(nn + v_t), tmpn, 32);
            整 asg = Nd(10); Nc(asg, v_l); Nc(asg, v_t); Nc(blk, asg);
