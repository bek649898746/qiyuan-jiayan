            } 否 若 (is_type && tt[tk] == OK && tt[tk + 1] == VR && (tt[tk + 2] == LB || tt[tk + 2] == KK)) {
                /* 括号数组声明: struct T *(name[N]); 全局指针数组 (fix 2026-08-15: pbase_tree_cache[256] undefined) */
