              { 整 asg = Nd(10); Nc(asg, v_t); Nc(asg, idx1); Nc(wbd, asg); } /* __rw = arr[__rd]; */
              { 整 asg = Nd(10); Nc(asg, idx1); Nc(asg, idx2); Nc(wbd, asg); } /* arr[__rd] = arr[n-1-__rd]; */
              { 整 asg = Nd(10); Nc(asg, idx2); Nc(asg, v_t); Nc(wbd, asg); } /* arr[n-1-__rd] = __rw; */
            }
            { 整 v_d3 = Nd(1); memcpy((字*)(nn + v_d3), dname, 32);
              整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_d3); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
              整 asg = Nd(10); Nc(asg, v_d3); Nc(asg, pl); Nc(wbd, asg); } /* __rd++; */
            { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(wbd, setl); nv[wh] = cl + 1; }
            Nc(wh, wbd);
            Nc(ibd, wh); }
          Nc(ifn, ibd);
          Nc(blk, ifn); }
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "取前")) { /* 接入 2026-08-27 取前 k 个 (take): 取前 dst, src, n, k; → { __tq=0; while(__tq<k && __tq<n){ dst[__tq]=src[__tq]; __tq++; } } — 复制前 k 个, k>n 复制全部 */
        tk++; /* 取前 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_k = expr(); /* 取前个数 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 tq_seq = 0; 字 iname[64]; sprintf(iname, "__tq_%d_", tq_seq++);
