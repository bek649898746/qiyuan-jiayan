                   #/## 参数不展开 (用原样 args)。参数展开用独立栈 (外层宏不入栈)。 */
                字 exp_args[16][1024];
                遍 (整 ai = 0; ai < an && ai < 16; ai++) { /* fix 2026-08-13: ai<16 防 an 越界写栈 (v4 obj_macro_expand 崩溃根因候选) */
                    整 save_exp_n = fn_exp_n;
                    整 save_exp_stack[64]; 遍 (整 _s = 0; _s < 64; _s++) save_exp_stack[_s] = fn_exp_stack[_s]; /* fix 2026-08-14: 实参展开独立栈只重置 fn_exp_n, 展开实参时覆盖 fn_exp_stack[0..] → 恢复后外层栈被污染 → 非递归宏 (__ac_fsize) 被误判 in_stack → 泄漏成 undefined */
                    fn_exp_n = 0; /* 实参展开独立栈 */
