    若 (tt[tk] == VR && !strcmp(tn[tk], "中位数")) { /* 接入 2026-08-28 中位数 (统计, 蓝图 §一 方向): 中位数 m, arr, n; → 双重循环选择法 (找第 n/2 小, 上中位数, 无需排序副本): { __md_n=n; __md_k=n/2; __md_i=0; while(__md_i<__md_n){ __md_l=0; __md_e=0; __md_j=0; while(__md_j<__md_n){ __md_l+=(arr[__md_j]<arr[__md_i]); __md_e+=(arr[__md_j]==arr[__md_i]); __md_j++; } if(__md_l<=__md_k && __md_l+__md_e>__md_k){ m=arr[__md_i]; } __md_i++; } } — 比较返回 0/1 直接累加 (无需 if) */
