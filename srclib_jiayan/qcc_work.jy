            整 depth = 0;
            循环 (tk < TS && tt[tk] != EK) {
                若 (tt[tk] == OK) depth++;
                否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                tk++;
            }
            续;
        }
        /* function definition */
        整 fn_ret_dbl = 0;
        整 fn_is_static = 0; /* fix 2026-08-06: static 函数 → 局部符号 (scl=3), 多 .o 头库不冲突 */
        若 (!strcmp(tn[tk], "__attribute__")) { tk++; 若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } } /* __attribute__((noreturn)) 前置 (fix 2026-08-14: NORETURN void die(...) — 空宏后 tt=SK 非 VR, 按 tn 匹配) */
        循环 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "static")) fn_is_static = 1; 若 (!strcmp(tn[tk], "double")) fn_ret_dbl = 1; tk++; } /* skip type keywords, catch double return */
        整 fn_ret_si = -1; /* struct return type index (sret candidates) */
        整 fn_ret_ptr = 0; /* struct return type is a POINTER (not sret) */
        若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { fn_ret_si = st_find(tn[tk]); tk++; } } /* struct return type: struct B *fn(...) */
        否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; 若 (tt[tk] == FK) { tk++; 整 ev = 0; 循环 (tk < TS && tt[tk] != UK && tt[tk] != EK) { 整 tk0 = tk; 若 (tt[tk] == VR) { 字 ename[64]; strcpy(ename, tn[tk]); tk++; 若 (tt[tk] == AK) { tk++; 整 neg = 0; 若 (tt[tk] == MK) { neg = 1; tk++; } 若 (tt[tk] == NK) { ev = neg ? -tv[tk] : tv[tk]; tk++; } } e_reg(ename, ev); ev++; } 若 (tt[tk] == CK) tk++; 若 (tt[tk] == SK) tk++; 若 (tk == tk0) tk++; } 若 (tt[tk] == UK) tk++; } } /* fix 2026-08-15: 匿名/带体 enum 返回类型 static enum { ... } fn(...) — 原只跳 enum 名, 见 { 落 fn 检测 break → ls_refs_advertise 被吞 */
        否 若 (tt[tk] == VR && td_is(tn[tk]) && tt[tk + 1] != OK) { 整 tdx = tdef_lookup(tn[tk]); 若 (tdx >= 0 && tdefs[tdx].is_dbl && !tdefs[tdx].is_struct) fn_ret_dbl = 1; tk++; } /* typedef return type — 但 VR 后跟 ( 时该 VR 是函数名 (typedef 被遮蔽), 不是返回类型 (fix 2026-08-14) */
        否 若 (tt[tk] == VR && tt[tk + 1] == VR && tt[tk + 2] == OK) { tk++; } /* unknown-type return (time_t etc) — treat as int (fix 2026-08-03: `static time_t parse_iso(...)` forward decl/definition swallowed main) */
        若 (tt[tk] == VK) tk++; /* skip 2nd keyword */
        循环 (tt[tk] == DK || (tt[tk] == VK && !strcmp(tn[tk], "const"))) { 若 (tt[tk] == DK) fn_ret_ptr = 1; tk++; } /* skip pointer(s) and interspersed const (fix 2026-08-15: `static const char * const *fn(...)` broke parse -> revert.c/cmd_cherry_pick missing) */
        若 (!strcmp(tn[tk], "__attribute__")) { tk++; 若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } } /* __attribute__((...)) 后置跳过 — 注意 #define __attribute__(x) 空宏后 tt=SK 非 VR, 只能按 tn 匹配 (fix 2026-08-14) */
        整 fdef = Nd(4);
        整 fn_ok = 0, fdef_is_fnptr_ret = 0;
        若 (tt[tk] == VR && tt[tk + 1] == OK) { /* fn name must be followed by ( */
            memcpy((字*)(nn + fdef), tn[tk], 64); tk++; tk++;
            fn_ok = 1;
        } 否 若 (tt[tk] == OK && tt[tk + 1] == DK) { /* fnptr: int (*pick(int v))(int) or int (*gfp)(int); */
            tk++; tk++; /* skip ( * */
            若 (tt[tk] == VR && tt[tk + 1] == OK) { /* name ( — fnptr-returning FUNCTION definition */
                memcpy((字*)(nn + fdef), tn[tk], 64); tk++; /* name */
                tk++; /* skip ( of the param list */
                fn_ok = 1; fdef_is_fnptr_ret = 1;
            } 否 若 (tt[tk] == VR && tt[tk + 1] == KK) { /* name ) — global fnptr VARIABLE: int (*gfp)(int); */
                字 vn[64]; strcpy(vn, tn[tk]); tk += 2; /* name ) */
                若 (tt[tk] == OK) { /* skip the arg-type list ( ... ) */
                    整 depth = 0;
                    循环 (tk < TS && tt[tk] != EK) {
                        若 (tt[tk] == OK) depth++;
                        否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                        tk++;
                    }
                }
                若 (tt[tk] == SK) tk++; /* ; */
                parse_base = 0; /* fix 2026-08-12: 文件级 fnptr 变量同样防原型 parse_base 泄漏 (var_static 按 parse_base 标 kw) */
                var_static(vn, 4); /* 8-byte .data slot (fnptr = pointer) */
                vars[vcnt - 1].arr_esz = 8; /* fnptr: *gfp loads 8 bytes */
                若 (fn_ret_dbl) vars[vcnt - 1].p_dbl = 1; /* double-returning fnptr: gfp(x) yields xmm0 */
                续;
            }
        }
        若 (fn_ok) {
            整 tfi = func_find((字*)(nn + fdef)); /* register return type BEFORE parsing params */
            若 (fn_is_static) fn_static_mark((字*)(nn + fdef)); 否 fn_static_unmark((字*)(nn + fdef)); /* fix 2026-08-15: 非 static 定义覆盖同名 static 标记 */
            func_tbl[tfi].ret_si = fn_ret_si;
            fn_ret_si_map[tfi] = fn_ret_si; /* survives gen_code's func_n=0 reset */
            fn_ret_ptr_map[tfi] = fn_ret_ptr;
            fn_ret_name_put((字*)(nn + fdef), fn_ret_si, fn_ret_ptr); /* name-keyed: survives func_tbl index renumbering */
            fn_dbl_set_ret((字*)(nn + fdef), fn_ret_dbl); /* double-return routing (xmm0) */
            cur_fn_sret = (fn_ret_si >= 0 && stypes[fn_ret_si].sz > 8 && !fn_ret_ptr); /* Win64: hidden sret ptr in rcx (struct by value only) */
            fvb[fvn] = vcnt; /* record var-range start (before params) */
            fr_start[fvn] = rsp_used; /* record frame-bound start: rsp_used is the pure frame footprint (globals/statics live in .data, never touch rsp_used) */
            parse_base = fvb[fvn]; /* scope body-local decl lookups to THIS function */
            整 pr = 0;
            整 fn_is_va = 0; /* variadic ... parsed (qcc lexes '...' as DT DT DT) */
            循环 (tt[tk] != KK && tt[tk] != SK && tt[tk] != UK && tt[tk] != EK && pr < 256) {
                整 pis_char = 0, pis_ptr = 0, ptr_depth = 0, p_stidx = -1, pis_dbl = 0;
                整 p_fptr = 0, p_fptr_dbl = 0; /* typedef'd fnptr param: 8-byte pointer slot (fix 2026-08-03) */
                整 pis_uns = 0; /* unsigned param: >> logical (fix 2026-08-05) */
                整 pis_ll = 0; /* long long param: 8-byte slot (fix 2026-08-05) */
                若 (tt[tk] == NK) { tk++; 续; } /* 空宏 #define UNUSED 展开成 0 (NK) 残留在参数名后 (const char *err UNUSED) → 跳过 (fix 2026-08-14: 原 NK 卡死参数循环) */
                若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) pis_char = 1; 否 若 (!strcmp(tn[tk], "double")) pis_dbl = 1; 否 若 (!strcmp(tn[tk], "unsigned")) pis_uns = 1; 否 若 (!strcmp(tn[tk], "long")) pis_ll = 1; tk++; }
                否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { p_stidx = st_find(tn[tk]); tk++; } } /* struct B *arr: remember struct type */
                否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; }
                否 若 (tt[tk] == VR && (td_is(tn[tk]) || st_find(tn[tk]) >= 0)) { 整 tdx = tdef_lookup(tn[tk]); 若 (tdx >= 0 && tdefs[tdx].is_dbl && !tdefs[tdx].is_struct) pis_dbl = 1; 若 (tdx >= 0 && tdefs[tdx].is_fnptr) { p_fptr = 1; p_fptr_dbl = tdefs[tdx].fnptr_dbl; } p_stidx = st_find(tn[tk]); tk++; } /* typedef'd struct / double alias / fnptr */
                若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) pis_char = 1; 否 若 (!strcmp(tn[tk], "double")) pis_dbl = 1; 否 若 (!strcmp(tn[tk], "unsigned")) pis_uns = 1; 否 若 (!strcmp(tn[tk], "long")) pis_ll = 1; tk++; } /* 2nd keyword */
                若 (tt[tk] == VR && (td_is(tn[tk]) || st_find(tn[tk]) >= 0) && tt[tk + 1] != CK && tt[tk + 1] != KK) { 整 tdx = tdef_lookup(tn[tk]); 若 (tdx >= 0 && tdefs[tdx].is_dbl && !tdefs[tdx].is_struct) pis_dbl = 1; 若 (tdx >= 0 && tdefs[tdx].is_fnptr) { p_fptr = 1; p_fptr_dbl = tdefs[tdx].fnptr_dbl; } p_stidx = st_find(tn[tk]); tk++; } /* fix 2026-08-13 Phase3; 2026-08-15: 参数名与 struct 标签同名 (int line) */
                若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++; /* 3rd keyword of unsigned long long (fix 2026-08-06) */
                循环 (tt[tk] == DK) { pis_ptr = 1; ptr_depth++; tk++; } /* pointer(s) * */
                若 (tt[tk] == OK && tt[tk + 1] == DK) { /* function pointer param: int (*fp)(int,int) */
                    tk++; tk++; /* skip ( * */
                    若 (tt[tk] == VR) {
                        var_param(tn[tk], pr, 4, 8, -1, 0, 0); /* fnptr: 8-byte pointer slot, 8-byte element (*fp loads 64-bit) */
                        若 (pis_dbl) vars[vcnt - 1].p_dbl = 1; /* double-returning fnptr param: fp(x) yields xmm0 */
                        tk++; pr++;
                    }
                    若 (tt[tk] == KK) tk++; /* skip ) closing (*fp) */
                    若 (tt[tk] == OK) { /* skip the arg-type list ( ... ) */
                        整 depth = 0;
                        循环 (tk < TS && tt[tk] != EK) {
                            若 (tt[tk] == OK) depth++;
                            否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                            tk++;
                        }
                    }
                    续;
                }
                若 (tt[tk] == OK && tt[tk + 1] == VR && tt[tk + 2] == OK) { /* 匿名函数指针参数: type (fn (args)) — 无 * (fix 2026-08-13 Phase3: regex preorder 参数 reg_errcode_t (fn (void*,...))) */
                    tk++; /* ( */
                    若 (tt[tk] == VR) { var_param(tn[tk], pr, 4, 8, -1, 0, 0); tk++; pr++; } /* fn */
                    若 (tt[tk] == OK) { 整 depth = 0; 循环 (tk < TS && tt[tk] != EK) { 若 (tt[tk] == OK) depth++; 否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } } tk++; } }
                    若 (tt[tk] == KK) tk++; /* 跳过 fnptr 参数结束的 ) — 否则后续参数错位 (fix 2026-08-13 Phase3) */
                    续;
                }
                若 (tt[tk] == LB) { /* 匿名数组参数: uint32_t[5] 无参数名 (fix 2026-08-13 Phase3: 原无此分支 → LB 卡住死循环, sha1.h sha1_compression_states) */
                    循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 否 若 (tt[tk] == VR) tk++; 若 (tt[tk] == RB) tk++; }
                    续;
                }
                若 (tt[tk] == VR) {
                    若 (p_fptr) { /* typedef'd fnptr param: fp_t cb — 8-byte pointer slot (fix 2026-08-03) */
                        var_param(tn[tk], pr, 4, 8, -1, 0, 0);
                        若 (p_fptr_dbl) vars[vcnt - 1].p_dbl = 1;
                        tk++; pr++;
                        循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 否 若 (tt[tk] == VR) tk++; /* fix 2026-08-13: 维度标识符跳过 */ 若 (tt[tk] == RB) tk++; } /* skip [N] */
                        若 (tt[tk] == CK) tk++;
                        若 (tt[tk] == DT) { 循环 (tt[tk] == DT) tk++; } /* variadic ellipsis */
                        续;
                    }
                    整 esz = 0;
                    若 (p_stidx >= 0) esz = stypes[p_stidx].sz;     /* struct / struct* param: element size = struct size */
                    否 若 (pis_dbl && ptr_depth > 0) esz = 8;       /* double* / double**: 8-byte elements */
                    否 若 (pis_char) esz = ptr_depth > 1 ? 8 : 1;   /* char* , char** */
                    否 若 (ptr_depth > 1) esz = 8;             /* int** */
                    否 若 (ptr_depth > 0) esz = 4;             /* int* */
                    若 (tt[tk + 1] == LB) { /* array param: int arr[4]; / char *argv[] — decays to a pointer */
                        pis_ptr = 1;
                        若 (ptr_depth > 0) esz = 8; /* pointer array: char *argv[] → 8-byte elements (fix 2026-08-03: was esz=1, argv[1] read a byte instead of a pointer) */
                        否 若 (esz == 0) esz = 4; /* element size for arr[i] scaling */
                    }
                    var_param(tn[tk], pr, pis_ptr ? (ptr_depth > 1 ? 8 : 4) : 0, esz, p_stidx, pis_dbl && !pis_ptr, pis_ll && !pis_ptr); /* fix 2026-08-11: 指针参数 p_esz 原硬编码 4 - 多级指针(char pp / int pp)应 8 */
                    若 (pis_char && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_char = 1; /* sizeof(char param) (fix 2026-08-05) */
                    若 (pis_uns && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_uns = 1; /* unsigned param: >> logical (fix 2026-08-05) */
                    若 (pis_ll && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_ll = 1; /* long long param: 8-byte slot (fix 2026-08-05) */
                    若 (pis_dbl && pis_ptr) vars[vcnt - 1].p_dbl = 1; /* double* param */
                    fn_dbl_put((字*)(nn + fdef), pr, pis_dbl && !pis_ptr); /* caller routes scalar doubles to xmm */
                    tk++; pr++;
                    循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 否 若 (tt[tk] == VR) tk++; /* fix 2026-08-13: 维度标识符跳过 */ 若 (tt[tk] == RB) tk++; } /* skip [N] */
                }
                若 (tt[tk] == CK) tk++;
                若 (tt[tk] == DT) { fn_is_va = 1; 循环 (tt[tk] == DT) tk++; } /* variadic ellipsis ... (dots lex as DT) */
            }
            若 (fn_is_va) {
                整 va_home;
                若 (cur_fn_sret) va_home = (pr < 3) ? 32 + 8 * pr : 56 + 8 * (pr - 3);
                否 va_home = (pr < 4) ? 24 + 8 * pr : 56 + 8 * (pr - 4);
                fn_va_put((字*)(nn + fdef), va_home);
            }
            若 (tt[tk] == SK) { parse_base = 0; tk++; 续; } /* fix 2026-08-12: 无括号声明误判为 fn 也重置 parse_base (同原型泄漏); no-paren decl misparsed as fn: static unsigned char *code; */
            tk++; /* skip ) */
            若 (tt[tk] == VR && !strcmp(tn[tk], "__attribute__")) { tk++; 若 (tt[tk] == OK) { 整 d = 1; tk++; 循环 (tk < TS && d > 0) { 若 (tt[tk] == OK) d++; 否 若 (tt[tk] == KK) { d--; 若 (d <= 0) { tk++; 断; } } tk++; } } } /* 声明尾真实 __attribute__((format(...))) 跳过 (空宏后 __attribute__ 是 tt=SK 的「分号」, 不能跳 — 否则原型判定丢失) */
            若 (fdef_is_fnptr_ret) { /* fnptr-return: skip ) closing (*pick) and the trailing (int) before the body */
                若 (tt[tk] == KK) tk++;
                若 (tt[tk] == OK) {
                    整 depth = 0;
                    循环 (tk < TS && tt[tk] != EK) {
                        若 (tt[tk] == OK) depth++;
                        否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                        tk++;
                    }
                }
            }
            若 (tt[tk] == SK) { fn_dbl_set_ret((字*)(nn + fdef), fn_ret_dbl); parse_base = 0; tk++; 续; } /* fix 2026-08-12: 函数原型后必须重置 parse_base — 否则下一个文件级声明在 parse_base>0 下 var_static 注册 → var_static_kw=1 (误标函数局部 static) → 全局变量从 main 不可见 → printf 参数加载缺失 (b_global) */
            Nc(fdef, blk());
            若 (fvn >= 512) { fprintf(stderr, "[ERR] 函数体表超过 512 上限 (fix 2026-08-06 M9)\n"); exit(1); }
            fve[fvn] = vcnt; fvn++; /* record var-range end; order == root attach order */
            fr_end[fvn - 1] = rsp_used; /* frame-bound end (vars only; statics inside the body don't touch rsp_used) */
            parse_base = 0; /* back to file scope for the next top-level item */
            Nc(p, fdef);
            若 (fdef_n < 1024) fdef_list[fdef_n++] = fdef; /* fix 2026-08-06: 根子槽只 256 个, 超出的函数用扁平列表保留 (否则 main 被丢) */
        } 否 { 断; }
    }
    返 p;
}

/* ?????? ??????: AST ??x86-64 machine code ?????? */
静 空 cg(整 n);
静 空 cgc(整 n);
静 空 cg_f(整 n); /* emit xmm0 = double value of expr n */

/* xmm0 = double value of an expression (float var/literal/arith, or int→cvtsi2sd) */
静 空 cg_f(整 n) {
    若 (n < 0) 返;
    整 t = nt[n];
    若 (t == 1) { /* identifier */
        字 *vn = (字*)(nn + n);
        整 off = var_lookup(vn);
        若 (var_is_dbl(vn)) {
            若 (var_isstatic(vn)) { movsd_xmm0_rip(coff_static_disp(off, 2) - 2); } /* static double via RIP (8-byte movsd: stc_disp is 6-byte-based) */
            否 movsd_xmm0_mbrp(off - cur_frame_sz);
        } 否 {
            若 (var_isstatic(vn)) mov_eax_rip(coff_static_disp(off, 0)); /* static int var via RIP (6-byte mov: stc_disp direct) */
            否 mov_reg_mbrp(0, off - cur_frame_sz); /* int var → eax */
            cvtsi2sd_xmm0_eax();
        }
        返;
    }
    若 (t == FP) { cg(n); 返; } /* FP literal → movsd xmm0 (cg case-FP) */
    若 (t == 0) { cg(n); cvtsi2sd_xmm0_eax(); 返; } /* int imm → convert */
    若 (t == 4) { /* function call: double-returning callee leaves xmm0; int callee → convert */
        字 *cfn = NULL;
        遍 (整 i = 19; i >= 0; i--) { 整 c = child_i(n, i); 若 (c >= 0 && nt[c] == 1) { cfn = (字*)(nn + c); 断; } }
        cg(n); /* emits the call */        若 (cfn && fn_dbl_get_ret(cfn)) { /* known double-returning callee: xmm0 already holds it */
        } 否 若 (ndbl[n]) { /* marked double call (incl. fnptr): leave xmm0 as-is */
        } 否 cvtsi2sd_xmm0_eax();
        返;
    }
    若 (t == 2) { /* binary */
        整 o = nv[n];
        若 (ndbl[n0[n]] || ndbl[n1[n]]) { /* floating sub-expr */
            cg_f(n0[n]); push_xmm0();
            cg_f(n1[n]); movsd_xmm1_xmm0(); pop_xmm0();
            若 (o == PK) addsd_xmm0_xmm1();
            否 若 (o == MK) subsd_xmm0_xmm1();
            否 若 (o == DK) mulsd_xmm0_xmm1();
            否 若 (o == DV) divsd_xmm0_xmm1();
            返;
        }
        cg(n); cvtsi2sd_xmm0_eax();
        返;
    }
    若 (t == 15) { /* member: double field x.d → movsd; int field → convert */
        字 *vn = (字*)(nn + n0[n]);
        整 off = var_lookup(vn);
        整 si = var_stidx(vn);
        整 fo = si >= 0 ? st_off(stypes[si].name, (字*)(nn + n)) : -1;
        若 (fo >= 0 && st_field_is_dbl(stypes[si].name, (字*)(nn + n))) {
            若 (nv[n] == 1) { /* ptr->field: load pointer, +fo, deref */
                若 (off >= 0) { 若 (var_isstatic(vn)) mov_rax_rip64(coff_static_disp(off, 1) - 1); /* static struct ptr: 8B .data slot via RIP */
                               否 若 (var_pesz(vn) > 0) mov_reg_mbrp64(0, off - cur_frame_sz); 否 mov_reg_mbrp(0, off - cur_frame_sz); }
                若 (fo != 0) add_rax_imm8(fo);
                asm_emit("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); modrm(0,0,0); /* movsd xmm0, [rax] */
            } 否 {
                若 (var_isstatic(vn)) movsd_xmm0_rip(coff_static_disp(off, 2) + fo - 2); /* static struct.d field via RIP (8-byte movsd) */
                否 若 (var_big_param(vn)) { mov_reg_mbrp64(0, off - cur_frame_sz); 若 (fo != 0) add_rax_imm8(fo); asm_emit("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF2); b(0x0F); b(0x10); modrm(0,0,0); } /* big struct param: slot holds ptr → ptr+fo, movsd [rax] (fix 2026-08-07) */
                否 movsd_xmm0_mbrp(off - stypes[si].sz + fo - cur_frame_sz);
            }
            返;
        }
    }
    若 (ndbl[n]) { cg(n); 返; } /* double node (array elem/var/field/call): cg leaves result in xmm0 */
    cg(n); cvtsi2sd_xmm0_eax(); /* fallback */
}

/* ?????? ?????? */
静 整 str_place(整 idx);
静 整 dbl_place(整 idx);

静 空 cgc(整 n) {
    cg(n0[n]); /* lhs ??eax */
    push_r(0); /* save lhs on stack (nesting- and call-safe) */
    cg(n1[n]); /* rhs ??eax */
    pop_r(3);  /* ebx = lhs */
    alu_rr(T_QK, 3, 0); /* cmp ebx(lhs), eax(rhs) ??flags = lhs - rhs */
    整 o = nv[n];
    若 (expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n])) setcc_u(o); /* fix 2026-08-06 M1: unsigned 比较 */
    否 setcc(o); /* setcc al */
    movzx_eax_al();
}

/* printf/fprintf/putstr: build output into a frame scratch buffer, then WriteFile.
   r10=handle r11=fmt r12=buf(advancing) r14=buf(start) r13=next-format-arg ptr.
   No calls until the final WriteFile, so volatile registers are safe throughout. */
静 整 emit_fmt_loop(整 bound_disp);
静 空 mov_ri_ext(整 reg, 整 imm); /* high-reg immediate mov (defined near CRT stub) */
/* bit-field codegen helpers (real bit semantics, fix 2026-08-05).
   A bit-field lives inside a shared 32-bit slot: foffs = slot byte offset,
   fbitof = bit offset in the slot, fbits = width. All slot traffic is 4-byte. */
静 空 bf_shl_imm(整 reg, 整 cnt) { /* shl r32, cl  (cnt compile-time 0..31) */
    若 (cnt <= 0) 返;
    mov_ri_ext(9, cnt);
    mov_rr(1, 9); /* ecx = cnt */
    asm_emit("    左移 r%d, cl\n", (字*)(长 长)(reg), (字*)(长 长)0, (字*)(长 长)0);
    rex(0, 0, 0, reg & 8); b(0xD3); modrm(3, 4, reg & 7);
}
静 空 bf_extract(常 字 *sn, 常 字 *fn) {
    /* eax = whole slot value → eax = field value (shr + and; signed fields sign-extend). */
    整 bw = st_field_bitw(sn, fn);
    若 (bw <= 0) 返;
    整 bitof = st_field_bitof(sn, fn);
    整 mask = bw >= 32 ? -1 : (1u << bw) - 1; /* fix 2026-08-09 审计: 1<<31 是有符号溢出 UB, 改 1u */
    若 (bitof == 0) { mov_ri_ext(9, mask); alu_rr(25, 0, 9); } /* eax &= mask */
    否 {
        mov_rr(10, 0); /* r10d = slot value */
        mov_ri_ext(9, bitof);
        mov_rr(0, 9); /* eax = bit offset (shift count) */
        g_uns_shift = 1;
        alu_rr(T_SR, 10, 0); /* r10d >>= cl (logical) */
        mov_rr(0, 10); /* eax = shifted field value */
        mov_ri_ext(9, mask);
        alu_rr(25, 0, 9); /* eax &= mask */
    }
    若 (bw < 32 && !st_field_is_uns(sn, fn)) { /* signed bit-field: sign-extend (fix 2026-08-05) */
        mov_rr(10, 0); /* r10d = masked field value */
        mov_ri_ext(9, 32 - bw);
        mov_rr(0, 9); /* eax = 32-bw (shift count) */
        alu_rr(T_SH, 10, 0); /* r10d <<= cl → sign bit lands in bit 31 */
        g_uns_shift = 0; /* arithmetic shift for signed fields */
        alu_rr(T_SR, 10, 0); /* r10d >>= cl (sar) → sign-extended */
        mov_rr(0, 10); /* eax = result */
    }
}
静 整 bf_store(常 字 *sn, 常 字 *fn) {
    /* rax = &slot, ebx = rhs value → read-modify-write the field bits.
       Returns 1 when handled (a bit-field), 0 for a plain field.
       NEVER write eax here: eax is the low 32 bits of rax, and rax holds the
       slot ADDRESS — writing eax zeroes the upper half and loses the address. */
    整 bw = st_field_bitw(sn, fn);
    若 (bw <= 0) 返 0;
    整 bitof = st_field_bitof(sn, fn);
    整 fm = bw >= 32 ? -1 : ((1u << bw) - 1) << bitof; /* fix 2026-08-09 审计: 1u 防有符号溢出 */
    mov_reg_mreg(10, 0); /* r10d = [rax] = old slot (rax keeps the address) */
    mov_rr(11, 3); /* r11d = rhs */
    bf_shl_imm(11, bitof); /* r11d <<= bitof */
    mov_ri_ext(9, fm);
    alu_rr(25, 11, 9); /* r11d &= field-bits mask */
    mov_ri_ext(9, ~fm);
    alu_rr(25, 10, 9); /* r10d &= ~field-bits mask (clear field bits) */
    alu_rr(47, 10, 11); /* r10d |= r11d */
    asm_emit("    存32rax r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 1, 0, 0); b(0x89); modrm(0, 2, 0); /* MOV [rax], r10d */
    返 1;
}
静 空 emit_print(常 字 *fname, 整 nargs) {
    整 is_fprintf = !strcmp(fname, "fprintf");
    整 is_putstr = !strcmp(fname, "putstr");
    整 fargoff = is_fprintf ? 2 : 1;
    /* kernel32 (WriteFile) requires rsp 16-byte aligned at the call (SSE).
       Compute the format-arg pointer from the PRE-alignment rsp (the pushed args sit
       at the pre-alignment position); r15 is callee-saved so kernel32 preserves it. */
    lea_r_mrsp(13, 8 * (nargs - 1 - fargoff)); /* r13 = &first format arg (pre-alignment rsp) */
    mov_rr64(15, 4); /* mov r15, rsp */
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp, -16 */
    /* save fmt BEFORE GetStdHandle clobbers rcx. The fmt slot is at the PRE-alignment
       position: for printf it's arg0 (still in rcx); for fprintf it's arg1 = [r13+8]
       (r13 is a pre-alignment address, immune to the `and rsp,-16` shift).
       IMPORTANT: the fmt must NOT be parked in the stack shadow space ([rsp+8..32]
       at the call) �?kernel32 owns that region and clobbers it. rbx is callee-saved,
       preserved by GetStdHandle, and restored by the epilogue, so it's a safe slot. */
    若 (is_fprintf) { asm_emit("    取64 r0, [r13+8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x45); b(8); } /* mov rax, [r13+8] = fmt */
    否 mov_rr64(0, 1); /* rax = rcx = fmt (arg0) */
    mov_rr64(3, 0);    /* rbx = fmt (callee-saved �?survives GetStdHandle) */
    mov_r_imm(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
    sub_rsp_imm(32);   /* shadow space for GetStdHandle — fix 2026-08-03: was missing (ABI requires 32B) */
    call_iat(0);       /* eax = handle */
    add_rsp_imm(32);
    mov_rr64(10, 0);   /* r10 = handle */
    mov_rr64(11, 3);   /* r11 = fmt */
    lea_r_mbrp(12, scratch_base - cur_frame_sz - 4096); /* r12 = buf — 缓冲下移到状态区之下 [rbp-4368] (fix 2026-08-06: 原与状态槽/&written 重叠) */
    mov_rr64(14, 12);  /* r14 = buf start */
    整 ldone;
    若 (is_putstr) {
        整 lcp = new_label();
        ldone = new_label();
        set_label(lcp);
        asm_emit("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x0F); b(0xB6); modrm(0, 1, 3); /* movzx ecx, byte[r11] */
        test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ldone, 1);
        mov_r12_cl(); /* mov [r12], cl */
        asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
        asm_emit("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 3); /* inc r11 */
        jmp_rel(-1); patch_label(cp-4, lcp, 2);
    } 否 {
        ldone = emit_fmt_loop(-272); /* printf/putstr 链：%s 拷贝以 rbp-272 为界（H2 fix 2026-08-06） */
    }
    set_label(ldone);
    /* len = r12 - r14 */
    mov_rr64(0, 12); asm_emit("    减64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,0); b(0x29); modrm(3, 6, 0); /* sub rax, r14 */
    mov_rr(8, 0); /* r8 = len */
    若 (bin_mode) { /* fix 2026-08-10 Gate 9: bin printf -> ���� COM1 0x3F8, �� kernel32 */
        整 lbin_loop = new_label(), lbin_wait = new_label(), lbin_done = new_label();
        set_label(lbin_loop);
        test_rr(8, 8); jz_rel(-1); patch_label(cp-4, lbin_done, 1);
        set_label(lbin_wait);
        mov_r_imm(2, 0x3FD); /* THR status reg */
        asm_emit("    ���˿� al, dx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xEC); /* in al, dx */
        b(0xA8); b(0x20); /* test al, 0x20 (THRE) */
        jz_rel(-1); patch_label(cp-4, lbin_wait, 1);
        rex(0,0,0,1); b(0x8A); modrm(0, 0, 6); /* mov al, [r14] */
        mov_r_imm(2, 0x3F8);
        asm_emit("    д�˿� dx, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xEE); /* out dx, al */
        asm_emit("    ���� r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 6); /* inc r14 */
        rex(0,0,0,1); b(0xFF); modrm(3, 1, 0); /* dec r8d */
        jmp_rel(-1); patch_label(cp-4, lbin_loop, 2);
        set_label(lbin_done);
    } 否 {
    sub_rsp_imm(32);
    mov_rr64(1, 10); /* rcx = handle */
    mov_rr64(2, 14); /* rdx = buf */
    lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz); /* r9 = &written */
    mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = 0 (8-byte NULL overlapped �?arg5 at [rsp+32] per real ABI) */
    call_iat(1);       /* WriteFile */
    add_rsp_imm(32);
    }
    mov_rr64(4, 15); /* mov rsp, r15 �?restore original stack position */
}

/* fix 2026-08-12 scanf: args already pushed (fmt first, then &a, &b...).
   Read stdin (GetStdHandle(-10) + ReadFile) into [rbp-4368] buf, then call
   _scanf_rt(fmt, args, buf, len) from qcc_rt.c to parse fmt and write back.
   Returns count of converted items in eax. */
静 空 emit_scanf(整 nargs) {
    整 ffi = func_find("_scanf_rt");
    lea_r_mrsp(13, 8 * (nargs - 1)); /* r13 = &fmt (arg0, pushed first = deepest; args at [r13+8..]) */
    mov_rr64(15, 4); /* r15 = pre-alignment rsp */
    asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp, -16 */
    mov_r_imm(1, -10); /* ecx = -10 = STD_INPUT_HANDLE */
    sub_rsp_imm(32);
    call_iat(0); /* eax = stdin handle */
    add_rsp_imm(32);
    mov_rr64(10, 0); /* r10 = handle */
    lea_r_mbrp(12, scratch_base - cur_frame_sz - 4096); /* r12 = buf (callee-saved — ReadFile clobbers r11, 同 printf) */
    lea_r_mbrp(9, scratch_base + 240 - cur_frame_sz);   /* r9 = &read */
    sub_rsp_imm(48);
    mov_rr64(1, 10); mov_rr64(2, 12);
    mov_ri_ext(8, 4096);
    mov_r_imm(0, 0); mov_mrsp_reg64(32, 0); /* [rsp+32] = 0 (overlapped) */
    call_iat(3); /* ReadFile */
    add_rsp_imm(48);
    mov_reg_mbrp(0, scratch_base + 240 - cur_frame_sz); /* eax = bytes read */
    mov_rr64(9, 0); /* r9 = len */
    asm_emit("    取64 r1, [r13]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x4D); b(0); /* rcx = fmt */
    /* 构造正序 args 数组到 [rbp+aoff]: args[k] = [r13-8-8k] 槽值 (参数按 fmt,&a,&b 压栈 → &a 在 [r13-8], &b 在 [r13-16]...).
       负索引 args[-argi] 在 qcc 编译会丢符号 (2026-08-12) → 显式正序拷贝. */
    { 整 aoff = -(272 + 8 * nargs);
      遍 (整 k = 0; k < nargs - 1; k++) {
          asm_emit("    取64 r0, [r13%+d]\n", (字*)(长 长)(-(8 + 8 * k)), (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x8B); b(0x45); b(-(8 + 8 * k)); /* mov rax, [r13-8-8k] */
          asm_emit("    存64 [rbp%+d], r0\n", (字*)(长 长)(aoff + 8 * k), (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x89); modrm(2, 0, 5); b4(aoff + 8 * k); /* mov [rbp+aoff+8k], rax */
      }
      lea_r_mbrp(2, aoff); /* rdx = args 数组 */
    }
    mov_rr64(8, 12); /* r8 = buf */
    若 (ffi >= 0) { /* _scanf_rt(fmt=rcx, args=rdx, buf=r8, len=r9) */
        sub_rsp_imm(32); /* shadow */
        call_rel(0);
        patch_label(cp - 4, func_tbl[ffi].label, 0);
        add_rsp_imm(32);
    }
    mov_rr64(4, 15); /* rsp = r15 (restore pre-alignment) */
}

/* shared %d/%s/%c/%% format loop: r11=fmt r12=out(advancing) r13=next-arg ptr.
   Returns the ldone label the caller must set_label() after the loop. */
/* shared decimal-digit emitter: prints |ebx| (with '-' sign) into the r12 buffer,
   then jumps to `tail`. Used by %d (tail=lfmt) and %f (tail=lfnum fractional path). */
静 空 emit_digits(整 tail) {
    整 lsign = new_label(), ldig = new_label(), lcpd = new_label();
    lea_r_mbrp(8, scratch_base + 248 + 12 - cur_frame_sz); /* r8 = digit temp end */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    test_rr(3, 3); b(0x0F); b(0x89); b4(0); patch_label(cp-4, lsign, 4); /* jns: skip sign */
    mov_r_imm(0, '-'); mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    mov_rr(0, 3); asm_emit("    取反 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xD8); mov_rr(3, 0); /* eax = -value; ebx = -value */
    set_label(lsign);
    mov_rr(0, 3); /* eax = value (positive) */
    set_label(ldig);
    asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 10); /* ecx = 10 */
    asm_emit("    整除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0xF7); b(0xF9); /* idiv ecx: eax=quot, edx=rem */
    asm_emit("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    test_rr(0, 0); jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
/* %lld: 64-bit signed decimal (fix 2026-08-06) — value in rbx, temp [rbp-56..] 24B, copy forward */
静 空 emit_ll_digits(整 tail) {
    整 lsign = new_label(), ldig = new_label(), lcpd = new_label();
    lea_r_mbrp(8, scratch_base + 192 + 24 - cur_frame_sz); /* r8 = ll temp end [rbp-56] */
    mov_rr64(9, 8); /* r9 = temp end (advancing) */
    asm_emit("    测试64 r3, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x85); modrm(3, 3, 3); /* test rbx, rbx (fix: B 位必须 0，否则 rm=3 变 r11) */
    b(0x0F); b(0x89); b4(0); patch_label(cp-4, lsign, 4); /* jns: skip sign */
    mov_r_imm(0, '-'); mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    取反64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0xF7); modrm(3, 3, 3); /* neg rbx (fix 2026-08-06: REX.B 必须 0，49 F7 DB 是 neg r11 → div 商溢出 #DE 崩溃) */
    set_label(lsign);
    mov_rr64(0, 3); /* rax = value (positive) */
    set_label(ldig);
    asm_emit("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x31); b(0xD2); /* xor edx, edx */
    mov_r_imm(1, 10); /* ecx = 10 */
    asm_emit("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0xF7); modrm(3, 6, 1); /* div rcx */
    asm_emit("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x80); b(0xC2); b(0x30); /* add dl, '0' */
    asm_emit("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 1, 1); /* dec r9 */
    asm_emit("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0, 2, 1); /* mov [r9], dl */
    asm_emit("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1, 0, 0, 0); b(0x85); modrm(3, 0, 0); /* test rax, rax */    jnz_rel(-1); patch_label(cp-4, ldig, 3);
    set_label(lcpd);
    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0, 0, 1); /* mov al, [r9] */
    mov_r12_al(); /* mov [r12], al */
    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 1); /* inc r9 */
    asm_emit("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3, 0, 4); /* inc r12 */
    asm_emit("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,1,0,1); b(0x39); modrm(3, 0, 1); /* cmp r9, r8 */
    jnz_rel(-1); patch_label(cp-4, lcpd, 3);
    jmp_rel(-1); patch_label(cp-4, tail, 2);
}
/* %llu: 64-bit unsigned decimal digits into [r12], then jmp tail (fix 2026-08-06).
   No sign handling (rbx is unsigned long long); div rcx unsigned 64-bit. */
静 空 emit_ll_unsigned_digits(整 tail) {
    整 ldig = new_label(), lcpd = new_label();
