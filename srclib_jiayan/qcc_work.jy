#define ASZ 1048576 /* 524288→1048576 (fix 2026-08-26 redis/lua: #if 反斜杠续行 + 表达式注释剥离后条件编译更正确 → sqlite3.c 多行 #if 含入更多代码 → AST 顶满 524288) */
静 整 blk_vs[ASZ]; /* fix 2026-08-19: 块节点 (nt==5) 的 var 起点 = blk() 入口 vcnt — codegen case-5 设置 cg_blk_start 用 (嵌套块作用域判定) */
#define MAX_LABELS 262144 /* 131072→262144 (fix 2026-08-31 中文链: layer_change 变量形式词名注入加了 cast 解析中文等价 — qcc_zh.jy 编译时短路 || 标签增多, 原上限恰好被顶满 LABEL-OVERFLOW; 扩容 2 倍给中英双链留余量) */
静 整 label_pos[MAX_LABELS];
静 整 label_set[MAX_LABELS];
静 整 defer_stmts[4096][64]; /* 接入 2026-08-27 defer: 每函数 defer 语句节点 (按函数序号 fvn, LIFO — epi_label 处逆序执行) */
静 整 defer_cnt[4096];
静 整 cur_fn_defer_idx = -1; /* parse 时当前函数序号 (defer 收集目标) */
/* 接入 2026-08-27 运算符重载: 重载 + 点 = 点_add; → ov 表注册, add() 分派 (左操作数是 struct 变量且类型匹配 → 函数调用) */
静 字 ov_op[32]; 静 字 ov_ty[32][64]; 静 字 ov_fn[32][64]; 静 整 ov_n;
静 构 { 整 patch_at; 整 target_label; 整 is_jmp; } patches[262144]; 整 patch_n; /* fix 2026-08-06: 16384→65536; 2026-08-16 自举回归: 65536→131072; 2026-08-28: 131072→262144 — 新特性批量接入 patch_n 贴上限 ([PATCH-OVERFLOW] 假绿) */
静 构 { 整 patch_at; 整 str_idx; } str_patches[32768]; 整 strpn; /* fix 2026-08-16 自举回归: 2048→8192 — 同步镜像后字符串引用超 2048; fix 2026-08-26 redis: 8192→32768 — redis-benchmark.c 1.6 万字符串字面量引用超 8192 */
静 构 { 整 patch_at; 整 dbl_idx; } dbl_patches[2048]; 整 dbl_patch_n; /* double-literal rip-relative disp32 patches */
静 构 { 整 patch_at; 整 label; } fn_patches[2048]; 整 fnpn; /* function-address imm32 patches */
静 整 ginit[16384]; 静 整 ginit_n; /* global variable initializer nodes (emitted at main entry); fix 2026-08-06: 128→4096 + 溢出报错（原 >128 静默丢初始值） */
静 整 ndbl[ASZ]; /* per-node flag: expression yields a double (floating) */
静 整 nerr[ASZ]; /* 2026-08-28 type-root-2: per-node error-union call result (must be checked) */
静 整 err_fn_cnt = 0; 静 字 err_fn_names[256][64]; 静 整 qcc_err_pending = 0; 静 整 qcc_err_pending_tok = -1; 静 整 qcc_cur_fn_err = 0; 静 整 qcc_skip_err_check = 0; /* 2026-08-28 type-root-2: try-branch expr() exempt from asgn A9001 */ /* 2026-08-28 type-root-2: error-union table + pending */
静 整 nll[ASZ]; /* per-node flag: expression is a 64-bit long long (fix 2026-08-05) */
静 整 nll_hi[ASZ]; /* per-node high 32 bits of a long-long literal (fix 2026-08-05) */
静 字 cast_sgn64[ASZ]; /* fix 2026-08-30 csmith s168: signed 64 cast ((int64_t)x / (long)x) 标记 — 值转换保留源 nuns (零扩展 b_cast), 类型 signed (除法/比较 signed); 不用 nll_hi (污染 LL 字面量语义 → 未初始化读取崩溃) */
静 字 cast_uns64[ASZ]; /* fix 2026-08-31 csmith s11: unsigned 64 cast ((uint64_t)x / (unsigned long long)x) 标记 - 目标 unsigned (比较/除法无符号) 但不设源 nuns */
静 字 cast32[ASZ]; /* fix 2026-08-31 csmith s61: 32 位类型 cast ((uint32_t)/(int32_t)/(uint8_t) 等) 标记 - 阻断 expr_is_ll 递归到子表达式 64 位字面量 (-6L) - & 传播 nll -> uint32<int64 比较误判无符号 */
静 字 cast_mark[ASZ]; /* fix 2026-08-30 探雷雷2: 显式 cast 标记 — (T*)x 是 no-op cast 直接返回操作数 (不建节点), 标记操作数节点供 type_mismatch_check 豁免 (int *p=(const char*)0xdeadbeef 合法, int *p=12345 非法) */
静 整 pesz[ASZ]; /* per-node flag: (T*) pointer-cast element byte size (1/2/4/8) - fix 2026-08-08 width bug: cast no-op drops type info, *((T*)x) width fell to 1 byte; keep target element size for case-12/10 */
静 整 nuns[ASZ]; /* per-node flag: expression is unsigned (u suffix literal / unsigned var) — >> must be logical SHR (fix 2026-08-05) */

/* ==================== COFF 对象输出（-c 模式） ==================== */
静 整 stc_disp(整 idx);
静 构 { 字 name[64]; 整 label; 整 defined; 整 ret_si; 整 declared; } func_tbl[65536]; /* fix 2026-08-06: 512 满 → main 等后注册函数被拒 (func_find 返 -1) → 编译产物无 main 崩; 2026-08-09 审计#2: 1024→2048; 2026-08-15 name 32→64 长函数名截断碰撞 (reftable min_update_index/_void); fix 2026-08-16 根因E3: 1024→2048 时 func_find 守卫漏改仍为 1024 → attr.c 等大文件超 1024 函数名 → func_find 返 -1 → func_tbl[-1].ret_si 越界写崩; 2048→8192 覆盖 Git 全量 + 守卫满则 [ERR] 硬退 (绝不返 -1); declared (接入 2026-08-28 declare 声明先行): 声明 名字(参数) 返回 类型; 注册签名, 未实现生成 stub (缺失=警告非错误, AI 渐进补全) */
/* static 函数名映射 (gen_code 重置 func_n, 用名字; fix 2026-08-06 Task 5.3: 多 .o 时 static 函数应 scl=3 局部符号, 否则 jystd 等头库每 .o 重复导出冲突) */
静 字 fn_static_names[512][64]; 静 整 fn_static_n;
静 空 fn_static_mark(常 字 *n) { 遍 (整 i = 0; i < fn_static_n; i++) 若 (!strcmp(fn_static_names[i], n)) 返; 若 (fn_static_n < 512) { strcpy(fn_static_names[fn_static_n++], n); } 否 budget_fail("static函数表 fn_static", 512); }
静 整 fn_static_is(常 字 *n) { 遍 (整 i = 0; i < fn_static_n; i++) 若 (!strcmp(fn_static_names[i], n)) 返 1; 返 0; }
静 空 fn_static_unmark(常 字 *n) { 遍 (整 i = 0; i < fn_static_n; i++) 若 (!strcmp(fn_static_names[i], n)) { 遍 (整 j = i; j < fn_static_n - 1; j++) strcpy(fn_static_names[j], fn_static_names[j + 1]); fn_static_n--; 返; } }
静 整 func_n = 0;
静 字 decl_names[256][64]; 静 整 decl_cnt; 静 字 decl_is_cproto[256]; /* fix 2026-08-30: C prototypes (int foo(void);) live in decl_names with flag=1: A1001 gate only, NO stub in -c mode (definition may be in another .o - jyld duplicate symbol) */ /* 接入 2026-08-28 declare 声明先行: 独立声明表 (func_n 在 gen_code 重置, 故不依赖 func_tbl.declared) — 声明 名字(参数); 注册, 未实现生成 stub */
静 整 coff_mode = 0;
静 /* fix 2026-08-10 Gate 9: ������� (bare_metal) + �ڴ�����/�����ַ */
整 bare_metal = 0; /* Gate 9: ��������������� (main ��� __bare__ ��������) */
#define BIN_SRC_ADDR 0x3800000
#define BIN_RT_ADDR 0x3900000
#define BIN_OUT_ADDR 0x3A00000
#define BIN_OUT_LEN_ADDR 0x3B00000
整 bin_mode = 0; /* -bin: 裸二进制输出 (内核: 无 PE 头/无 CRT/无 .data), fix 2026-08-08 */
静 整 coff_ginit_done = 0; /* -c: ginit emitted once per object */
静 整 ginit_flag_slot = -1; /* fix 2026-08-17: coff ginit 运行时守卫标志的 .data 槽 (首个被调函数触发一次) */
静 整 ginit_sub_label = -1; /* fix 2026-08-17: ginit 专用子程序标签 (正文只在 .text 末尾一次) */
#define MAX_CREL 131072
#define COFF_DATA_SITE_BASE 0x30000000 /* .data 重定位 site 哨兵：write_coff_obj 按 rsec=3 分组 */
静 构 { 整 site; 整 type; 整 sym; 整 addend; 整 is_label; 整 label; } crel[MAX_CREL];
静 整 crel_n;
#define MAX_CSYM 16384
静 构 { 字 name[64]; 整 value; 整 sec; 整 sc; 整 type; } csym[MAX_CSYM];
静 整 csym_n;
静 uint8_t *coff_str_data; 静 整 coff_str_len, coff_str_cap;
静 uint8_t *coff_dbl_data; 静 整 coff_dbl_len, coff_dbl_cap;
静 整 coff_text_sym, coff_str_sym, coff_dbl_sym, coff_bss_sym;

静 整 csym_find(常 字 *name) {
    遍 (整 i = 0; i < csym_n; i++) 若 (!strcmp(csym[i].name, name)) 返 i;
    返 -1;
}
静 整 csym_add(常 字 *name, 整 value, 整 sec, 整 sc, 整 type) {
    若 (csym_n >= MAX_CSYM) { fprintf(stderr, "qcc: csym overflow\n"); abort(); }
    整 i = csym_n++;
    strncpy(csym[i].name, name, 63); csym[i].name[63] = 0;
    csym[i].value = value; csym[i].sec = sec; csym[i].sc = sc; csym[i].type = type;
    返 i;
}
静 空 coff_crel(整 site, 整 type, 整 sym, 整 addend) {
    若 (crel_n >= MAX_CREL) { fprintf(stderr, "qcc: crel overflow\n"); abort(); }
    crel[crel_n].site = site; crel[crel_n].type = type;
    crel[crel_n].sym = sym; crel[crel_n].addend = addend;
    crel[crel_n].is_label = 0; crel[crel_n].label = -1;
    crel_n++;
}
/* .data 槽重定位：site 以 COFF_DATA_SITE_BASE 为基（write_coff_obj 识别为 secs[3]） */
静 空 coff_data_crel(整 data_off, 整 type, 整 sym, 整 addend) {
    coff_crel(COFF_DATA_SITE_BASE + data_off, type, sym, addend);
}
静 整 coff_counter_sym = -1;
静 整 coff_counter_sym_get(空) {
    若 (coff_counter_sym < 0) coff_counter_sym = csym_add("__qcc_heap_counter", 0, 0, 2, 0);
    返 coff_counter_sym;
}
静 空 coff_mov_eax_counter(空) {
    asm_emit("    读堆计数器 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    b(0x8B); b(0x05); b4(0); /* mov eax, [rip+0] */
    coff_crel(cp - 4, 0x0004, coff_counter_sym_get(), 0);
}
静 空 coff_mov_counter_eax(空) {
    asm_emit("    写堆计数器 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    b(0x89); b(0x05); b4(0); /* mov [rip+0], eax */
    coff_crel(cp - 4, 0x0004, coff_counter_sym_get(), 0);
}
静 空 coff_str_add(常 uint8_t *p, 整 n) {
    若 (coff_str_len + n > coff_str_cap) {
        整 nc = coff_str_cap ? coff_str_cap * 2 : 4096;
        循环 (nc < coff_str_len + n) nc *= 2;
        coff_str_data = realloc(coff_str_data, nc); coff_str_cap = nc;
    }
    memcpy(coff_str_data + coff_str_len, p, n); coff_str_len += n;
}
静 空 coff_dbl_add(常 uint8_t *p, 整 n) {
    若 (coff_dbl_len + n > coff_dbl_cap) {
        整 nc = coff_dbl_cap ? coff_dbl_cap * 2 : 4096;
        循环 (nc < coff_dbl_len + n) nc *= 2;
        coff_dbl_data = realloc(coff_dbl_data, nc); coff_dbl_cap = nc;
    }
    memcpy(coff_dbl_data + coff_dbl_len, p, n); coff_dbl_len += n;
}
静 整 coff_slot_sym(整 slot) {
    遍 (整 i = vcnt - 1; i >= 0; i--) { /* fix 2026-08-15: 原 vs_n()=vs_end 限制导致文件级 static slot 找不到 */
        若 (vars[i].rsp_off == slot) {
            整 s = csym_find(vars[i].name);
            若 (s < 0) {
                若 (slot < 0) s = csym_add(vars[i].name, 0, 0, 2, 0); /* extern: sec=0 未定义, scl=2 全局 (fix 2026-08-06 多 .o 链接) */
                否 s = csym_add(vars[i].name, 4 * slot, 4, (var_static_kw[i] || var_file_static[i]) ? 3 : 2, 0); /* fix 2026-08-06: 函数内 static → scl=3; fix 2026-08-14: 文件级 static 也 scl=3 */
            }
            返 s;
        }
    }
    返 -1;
}
静 整 coff_is_builtin(常 字 *n); /* 前向声明 (fix 2026-08-06) */
静 整 coff_func_label_sym(整 label) {
    遍 (整 i = 0; i < func_n; i++) {
        若 (func_tbl[i].label == label) {
            整 s = csym_find(func_tbl[i].name);
            若 (s < 0) {
                整 fsc = (fn_static_is(func_tbl[i].name) || coff_is_builtin(func_tbl[i].name)) ? 3 : 2; /* fix 2026-08-06: static/内建 → 局部符号 */
                s = csym_add(func_tbl[i].name, func_tbl[i].defined ? label_pos[label] : 0,
                             func_tbl[i].defined ? 1 : 0, fsc, 0x20);
            }
            返 s;
        }
    }
    返 -1;
}
静 整 coff_func_name_sym(常 字 *name) {
    整 s = csym_find(name);
    若 (s < 0) s = csym_add(name, 0, 0, 2, 0x20);
    返 s;
}
/* -c 模式：builtin 名（编译器内联发射，不是外部函数） */
静 整 coff_is_builtin(常 字 *n) {
    静 常 字 *bn[] = { "printf", "fprintf", "vfprintf", "sprintf", "snprintf", "vsnprintf", "_vsnprintf", "putstr", "scanf",
        "fopen", "fread", "fwrite", "fputc", "fputs", "fgetc", "fclose", "fseek", "ftell", "rewind", "feof", "fflush", "ferror", "fgets", /* fix 2026-08-18: fgetc 缺 → coff 模式当用户函数链到 msvcrt fgetc, 拿 HANDLE 当 FILE* 崩 (git config 读取); fix 2026-08-24 t35t: feof/fflush/ferror 补内置 — 否则当用户函数外部调用 msvcrt, 句柄当 FILE* 崩 (reflog/strbuf_getwholeline) */
        "_va_alloc", "host_va_alloc", "_setpos", "_getpos", "_exit_proc", "__qcc_va_start",
        "memset", "memcpy", "strlen", "strcmp", "strcpy", "strncpy",
        "malloc", "calloc", "free", "realloc", "isalnum", "isalpha", "exit", "abort", "inb", "outb", "inl", "outl", "__asm", "thread_create", "thread_join" }; /* 2026-08-28 type-root-14 #45: 线程内建 (CreateThread/WaitForSingleObject IAT 调用) */
    遍 (整 i = 0; i < (整)(大小(bn)/大小((bn)[0])); i++) 若 (!strcmp(bn[i], n)) 返 1;
    返 0;
}
静 整 coff_is_qcc_internal(常 字 *n) { /* qcc 专用 builtin: 无 CRT 对应, 取地址无法链接 (fix 2026-08-19: 其余 builtin (strcmp/memset...) 取地址 → coff 符号引用 → jyld 解析 msvcrt 导入 — git string_list `cmp = list->cmp ? list->cmp : strcmp` 原编成 NULL → call *0 → status SEGV) */
    静 常 字 *qi[] = { "putstr", "_va_alloc", "host_va_alloc", "_setpos", "_getpos", "_exit_proc", "__qcc_va_start", "inb", "outb", "inl", "outl", "__asm" };
    遍 (整 i = 0; i < (整)(大小(qi)/大小((qi)[0])); i++) 若 (!strcmp(qi[i], n)) 返 1;
    返 0;
}
静 整 coff_static_disp(整 idx, 整 k) {
    若 (coff_mode) {
        整 s = coff_slot_sym(idx);
        若 (s >= 0) coff_crel(cp + 2 + k, 0x0004, s, 0);
        返 k;
    }
    若 (idx < 0) { /* extern 无定义: 单文件编译无法解析 (fix 2026-08-06) */
        遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (vars[i].rsp_off == idx) { fprintf(stderr, "[ERR] extern 变量 '%s' 无定义 — 多文件请用 qcc -c + jyld 链接\n", vars[i].name); exit(1); }
        fprintf(stderr, "[ERR] extern 变量无定义\n"); exit(1);
    }
    返 stc_disp(idx);
}

静 整 new_label(空) { 若 (lc >= MAX_LABELS) { fprintf(stderr, "[LABEL-OVERFLOW] lc=%d\n", lc); abort(); } 整 l = lc++; label_set[l] = 0; 返 l; }
静 空 set_label(整 l) { label_pos[l] = cp; label_set[l] = 1; asm_emit(".L%d:\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0); }
静 空 patch_label(整 at, 整 l, 整 is_jmp) {
    若 (coff_mode) {
        整 fs = coff_func_label_sym(l);
        若 (fs >= 0) {
            coff_crel(at, 0x0004, fs, 0);
        } 否 {
            若 (!coff_text_sym) coff_text_sym = csym_add(".text", 0, 1, 3, 0);
            coff_crel(at, 0x0004, coff_text_sym, 0);
            crel[crel_n - 1].is_label = 1;
            crel[crel_n - 1].label = l;
        }
        返;
    }
    若 (patch_n >= 262144) { fprintf(stderr, "[PATCH-OVERFLOW] patch_n=%d (at label %d)\n", patch_n, l); abort(); }
    /* Emit the jump mnemonic into the asm text using the REAL label id (l),
       not the placeholder rel value. Fix 2026-08-03: -S output previously
       used jz_rel's rel (always 1 for forward refs), so asm_zh could never
       resolve jump targets -> H1!=H2. */
    若 (is_jmp == 0) asm_emit("    调用 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 1) asm_emit("    为零跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 2) asm_emit("    跳转 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 3) asm_emit("    非零跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 4) asm_emit("    非负跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 5) asm_emit("    大于等跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 6) asm_emit("    小于等跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 7) asm_emit("    高于等跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 8) asm_emit("    低于跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 9) asm_emit("    高于跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (is_jmp == 10) asm_emit("    小跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0); /* jl (fix 2026-08-06 %lld) */
    否 若 (is_jmp == 11) asm_emit("    大跳 .L%d\n", (字*)(长 长)(l), (字*)(长 长)0, (字*)(长 长)0); /* jg (fix 2026-08-06) */
    patches[patch_n].patch_at = at;
    patches[patch_n].target_label = l;
    patches[patch_n].is_jmp = is_jmp;
    patch_n++;
}
静 空 resolve_patches(空) {
    遍 (整 i = 0; i < patch_n; i++) {
        整 at = patches[i].patch_at;
        整 target = label_pos[patches[i].target_label];
        整 is_jmp = patches[i].is_jmp;

        若 (is_jmp == 0) {
            /* CALL rel32: E8 already emitted, at points to rel32 bytes */
            整 tgt = target - (at + 4);
            b4_at(at, tgt);
        } 否 若 (is_jmp == 2) {
            /* JMP rel32 */
            整 tgt = target - (at + 4);
            b4_at(at, tgt);
        } 否 若 (is_jmp == 1 || (is_jmp >= 3 && is_jmp <= 11)) {
            /* Jcc rel32 (jz/jnz/jns/jge/jle/jae/jb/ja/jl/jg) */
            整 tgt = target - (at + 4);
            code[at] = tgt & 0xff;
            code[at + 1] = (tgt >> 8) & 0xff;
            code[at + 2] = (tgt >> 16) & 0xff;
            code[at + 3] = (tgt >> 24) & 0xff;
        }
    }
}
/* codegen-time var visibility (root-cause 2026-08-03): during codegen, lookups run
   with parse_base=0 over [0, fve[gfn]), so a name that is BOTH a file-scope static
   AND an earlier function's local would resolve to the LOCAL (later index) — e.g.
   gen_code's `lc = g_lc_save` picked up cg()'s local `lc`, emitting a frame access
   whose rsp_off lay ~1KB below gen_code's frame. The global frame hid this (the
   write stayed in-frame); local frames expose it (stack corruption). The parse-time
   rule is: non-static vars are visible only within their own function
   [fvb[gfn], fve[gfn]); statics are visible everywhere. Enforce it during codegen. */
静 整 var_codegen_visible(整 i) {
    若 (vars[i].is_static) {
        若 (!vs_end) 返 1;            /* parse: statics visible (parse_base floor already blocks prior fns) */
        若 (cg_ginit_ctx) 返 1;       /* ginit: emitted at main entry, ALL statics visible (fix 2026-08-11 BLOCKER-3) */
        若 (var_static_kw[i]) 返 (i >= fvb[gfn]); /* fn-local static: ONLY its own function (fix 2026-08-11 BLOCKER-3) */
        返 1;                         /* global static: visible from any function */
    }
    若 (!vs_end) 返 (i >= parse_base && (vars[i].blk_end == 0 || vars[i].blk_end == -1)); /* parse phase: ONLY current function body (parse_base floor).
                                              fix 2026-08-11 BLOCKER-1: 原 return 1 导致跨函数同名变量泄漏 —
                                              var_is_dbl 等从其他函数找到同名变量 → ndbl[] 误标 → codegen 差异 (布局敏感根因)
                                              fix 2026-08-28 type-root-13 #277: 块已退出的变量 (blk_end>0) 不可见 — 块内同名遮蔽外层, 块外恢复外层 (原 parse 期无视块标记 → 块内变量泄漏出块遮蔽外层) */
    若 (cg_ginit_ctx) 返 0; /* fix 2026-08-17: ginit 只初始化静态; 跨函数非静态同名变量 (char *suffix 遮蔽 static char *suffix[]) 在 ginit 子程序发射点 fvb[gfn]/cg_blk_end 未正确设置时全可见 → 数组元素赋值错编成指针解引用+字节存储 → 崩 */
    /* fix 2026-08-19: 嵌套块同名变量只在块内可见 — 当前 codegen 块 [cg_blk_start, cg_blk_end)
       必须被该变量的声明块 [blk_start, blk_end) 包含. 否则 `struct strbuf gitdir` 之后嵌套块
       `const char *gitdir = ...` 的独立条目会让外层 &gitdir 解析到 char* 条目 (p_esz=1) →
       case 11 跳过 off-=sizeof(strbuf) → 地址错位 → strbuf 崩. 参数 (is_param) 全函数可见. */
    { 整 _r = (i >= fvb[gfn] && i < cg_blk_end && (vars[i].is_param || vars[i].blk_end == -1 || (vars[i].blk_start <= cg_blk_start && vars[i].blk_end >= cg_blk_end))); 返 _r; } /* codegen: this function's locals/params, and only up to the current block end — later sibling-block locals must not shadow earlier blocks (fix 2026-08-16). blk_end==-1: 复用条目标记函数级可见 (fix 2026-08-19) */
}
静 整 var_is_dbl(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_dbl;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_dbl; /* 全局 double (fix 2026-08-13: parse 期 parse_base 排除全局 → 全局 double 算术丢 64 位) */
    返 0;
}
/* long long var: 64-bit int loads/stores (fix 2026-08-05) */
静 整 var_is_ll(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_ll;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_ll; /* 全局 long long (fix 2026-08-13: 全局 LL 算术被当 32 位, b_global 6000000000→低32) */
    返 0;
}
/* char var: 1-byte loads/stores (fix 2026-08-25 bug#28b: 局部 char 变量 32 位读/写 → 负值/高位非零值错 —
   qcc char=unsigned 约定, 读用 movzx 零扩展, 存用 mov byte 截断) */
静 整 var_is_char(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_char;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_char; /* 全局 char */
    返 0;
}
/* signed char var: movsx 符号扩展读 (fix 2026-08-29 csmith: signed char x=0xB3 须返回 -77 非 179) */
静 整 var_is_csgn(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_csgn;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_csgn;
    返 0;
}
/* short var: 2-byte loads/stores (fix 2026-08-25 bug#31b: 局部 short/uint16_t 32 位读/写 → 16 位值高位污染) */
静 整 var_is_short(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_short;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_short; /* 全局 short */
    返 0;
}
/* unsigned variable: >> must use SHR (logical), not SAR (fix 2026-08-05) */
静 整 var_is_uns(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].is_uns;
    遍 (整 i = parse_base - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && vars[i].is_static && !var_static_kw[i]) 返 vars[i].is_uns; /* 全局 unsigned (fix 2026-08-13) */
    返 0;
}
/* pointer-to-double (double *p): p[i] reads/writes 8-byte doubles (movsd) */
静 整 var_pdbl(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].p_dbl;
    返 0;
}
/* 8-byte frame slot for a local double */
静 整 var_ll(常 字 *n) { /* long long: 8-byte int slot (fix 2026-08-05) */
    
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].arr_sz == 0 && var_codegen_visible(i)) {  vars[i].is_ll = 1; vars[i].blk_end = -1; 返 vars[i].rsp_off; } /* fix 2026-08-19: 复用条目标记函数级可见 */
    若 (vcnt >= 65536) { fprintf(stderr, "[ERR] 变量表满 vcnt=%d\n", vcnt); exit(1); }
    strcpy(vars[vcnt].name, n);
    rsp_used += 8; rsp_used = (rsp_used + 15) & ~15;
    vars[vcnt].rsp_off = rsp_used - 8;
    vars[vcnt].is_param = 0;
    vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0; vars[vcnt].p_esz = 0; vars[vcnt].p_depth = 0; vars[vcnt].p_inner = 0; vars[vcnt].pstk = 0; vars[vcnt].pdisp = 0; vars[vcnt].is_dbl = 0; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = 0; vars[vcnt].is_uns = 0; vars[vcnt].is_static = 0;
    vars[vcnt].is_ll = 1;
    
    返 vars[vcnt++].rsp_off;
}
静 整 var_double(常 字 *n) {
    遍 (整 i = vs_n() - 1; i >= parse_base; i--) 若 (!strcmp(vars[i].name, n) && vars[i].arr_sz == 0 && var_codegen_visible(i)) { vars[i].is_dbl = 1; vars[i].blk_end = -1; 返 vars[i].rsp_off; } /* fix 2026-08-19: 复用条目标记函数级可见 */
    若 (vcnt >= 65536) { fprintf(stderr, "[ERR] 变量表满 vcnt=%d\n", vcnt); exit(1); }
    strcpy(vars[vcnt].name, n);
    rsp_used += 8; rsp_used = (rsp_used + 15) & ~15;
    vars[vcnt].rsp_off = rsp_used - 8;
    vars[vcnt].is_param = 0;
    vars[vcnt].pslot = -1; vars[vcnt].preg = -1;
    vars[vcnt].st_idx = -1; vars[vcnt].st_sz = 0; vars[vcnt].arr_sz = 0; vars[vcnt].arr_esz = 0;
    vars[vcnt].frows[0] = 0; vars[vcnt].frows[1] = 0; vars[vcnt].frows[2] = 0; vars[vcnt].frows[3] = 0; vars[vcnt].p_esz = 0; vars[vcnt].p_depth = 0; vars[vcnt].p_inner = 0; vars[vcnt].pstk = 0; vars[vcnt].pdisp = 0; vars[vcnt].is_dbl = 0; vars[vcnt].p_dbl = 0; vars[vcnt].is_char = 0; vars[vcnt].is_uns = 0; vars[vcnt].is_static = 0;
    vars[vcnt].is_dbl = 1;
    返 vars[vcnt++].rsp_off;
}
/* _Alignas(N) 变量级存储对齐 (fix 2026-08-25 step25): 全局对齐 stc_n (.data 4 字节槽, N 任意 — 基址页对齐);
   返回 pending 值供调用方调整局部槽 (var_offset 标量 8 字节槽 → 地址自动 8/16 对齐). 
   无条件消费 alignas_pending 防污染后续变量. */
静 整 var_align(空) {
    整 pa = alignas_pending;
    alignas_pending = 0;
    若 (pa > 4) {
        stc_n = (stc_n + pa / 4 - 1) & ~(pa / 4 - 1);
    }
    返 pa;
}
静 字 uninit_names[256][64]; 静 整 uninit_scope[256]; 静 整 uninit_cnt = 0; 静 整 uninit_depth = 0; 静 字 lv_uninit[8][64]; 静 整 lv_uninit_n = 0; 静 整 user_fn_active = 0; /* 接入 2026-08-28 机制层 #78 明确初始化: 未初始化局部变量表 — var_offset 登记(仅用户 main 后 + 跳过 _ 前缀编译器内部变量), asgn 赋值移除, L5014 读取 [ERR], 块退出清除; user_fn_active=遇到用户 main 后置 1 (qcc_rt.c 运行时拼接在源码前, 无 main, 其变量不查避免误报) */
静 整 uninit_has(常 字 *v) { 遍 (整 i = 0; i < uninit_cnt; i++) 若 (!strcmp(uninit_names[i], v)) 返 1; 返 0; }
静 空 uninit_remove(常 字 *v) { 遍 (整 i = 0; i < uninit_cnt; i++) 若 (!strcmp(uninit_names[i], v)) { uninit_names[i][0] = 0; 返; } }
静 空 uninit_scope_exit(空) { uninit_depth--; 若 (uninit_depth < 0) uninit_depth = 0; 遍 (整 i = 0; i < uninit_cnt; ) { 若 (uninit_scope[i] > uninit_depth) { 遍 (整 j = i; j < uninit_cnt - 1; j++) { strcpy(uninit_names[j], uninit_names[j + 1]); uninit_scope[j] = uninit_scope[j + 1]; } uninit_cnt--; } 否 i++; } } /* 块退出: 清除本块声明的未初始化变量 (生命周期=词法块) */
整 tk; /* fwd: token 索引 (定义在 L3020 token 系统区 — 2026-08-28 emit_error 定位行号需提前声明; 2026-08-28 type-root-fix: 前移到 nullable_register 之前供其读 tk 做 pending 位置校验) */
静 字 nullable_names[256][64]; 静 整 nullable_scope[256]; 静 整 nullable_cnt = 0; 静 整 nullable_depth = 0; 静 整 qcc_nullable_pending = 0; 静 整 qcc_nullable_pending_tok = -1; /* 2026-08-28 type-root-fix: pending tok pos - lexer prescans, no pos check -> pending consumed by decl BEFORE 可空 */ /* 接入 2026-08-28 类型根治① (v3.0 #75): 可空类型真标记 — 可空 T x 声明登记(lexer 置 pending, 声明消费), 未解包解引用(星/箭头/下标) [ERR] A8001, 解包/赋值清除; 原词法层直接吞掉=等价普通声明, 无真类型 */
静 整 nullable_has(常 字 *v) { 遍 (整 i = 0; i < nullable_cnt; i++) 若 (!strcmp(nullable_names[i], v)) 返 1; 返 0; }
静 空 nullable_remove(常 字 *v) { 遍 (整 i = 0; i < nullable_cnt; i++) 若 (!strcmp(nullable_names[i], v)) { nullable_names[i][0] = 0; 返; } }
静 空 nullable_register(常 字 *n) { 若 (qcc_err_pending && tk >= qcc_err_pending_tok) qcc_err_pending = 0; /* 2026-08-28 type-root-2: var-decl clears err pending (pos-checked: qcc_rt prescan tk<pos must NOT clear) */ 若 (qcc_nullable_pending && user_fn_active && n[0] != '_' && tk >= qcc_nullable_pending_tok) { qcc_nullable_pending = 0; 若 (nullable_cnt < 256) { strcpy(nullable_names[nullable_cnt], n); nullable_scope[nullable_cnt] = nullable_depth; nullable_cnt++; } } } /* 2026-08-28 type-root-fix: tk>=pending_tok - decl must be AT/AFTER 可空 pos (lexer prescans) */ /* 可空声明: 消费 pending 标记, 登记 (仅用户代码 + 非 _ 内部变量) */
静 空 nullable_scope_exit(空) { nullable_depth--; 若 (nullable_depth < 0) nullable_depth = 0; 遍 (整 i = 0; i < nullable_cnt; ) { 若 (nullable_scope[i] > nullable_depth) { 遍 (整 j = i; j < nullable_cnt - 1; j++) { strcpy(nullable_names[j], nullable_names[j + 1]); nullable_scope[j] = nullable_scope[j + 1]; } nullable_cnt--; } 否 i++; } } /* 块退出: 清除本块的可空标记 */
静 空 emit_error(常 字 *code, 常 字 *msg) { /* 定义在 tk/tline 可见处 (var_offset 前) — 2026-08-28 大哥评估: loc.line 真值 = tline[tk]-rt_line_skip (用户源码行号) */
    若 (diagnostics_json) {
        /* fix 2026-08-28 真接入③: 修复建议按具体错误码精确给出 (原只按 A3/A4 族粗分, "查看错误码文档" 占位) */
        常 字 *fix = "查看错误码文档 (error_codes/README.md)";
        若 (!strcmp(code, "A3001")) fix = "解除借用后再写/读: 可变借用先 放还; 只读借用写=自动放还 (借用自动化)";
        否 若 (!strcmp(code, "A3002")) fix = "已有借用时不能再 可变借用: 先 放还 全部借用 (独占互斥)";
        否 若 (!strcmp(code, "A3003")) fix = "借用中不能再 可变借用: 先 放还 (只读借用挡独占)";
