                循环 (seg[i] && depth > 0) {
                    若 (seg[i] == '"' && !ain_str) ain_str = 1;
                    否 若 (seg[i] == '"' && ain_str && !quote_escaped(seg, i)) ain_str = 0; /* fix 2026-08-14: \\" 两反斜杠后 " 应结束 */
                    若 (seg[i] == '\'' && !ain_str) { /* 字符字面量 '"' 在宏实参内 — 跳过, 防 " 翻转 ain_str (fix 2026-08-14) */
                        若 (aj < 1023) args[an][aj++] = seg[i++]; /* opening ' */
                        循环 (seg[i] && (seg[i] != '\'' || quote_escaped(seg, i))) { 若 (aj < 1023) args[an][aj++] = seg[i]; i++; }
                        若 (seg[i]) { 若 (aj < 1023) args[an][aj++] = seg[i]; i++; }
                        续;
                    }
                    若 (!ain_str) {
                        若 (seg[i] == '(') depth++;
                        否 若 (seg[i] == ')') { depth--; 若 (depth == 0) 断; }
                        若 (seg[i] == ',' && depth == 1) { /* fix 2026-08-07: 串内逗号不拆参 */
                            args[an][aj] = 0;
                            若 (an < 15) { an++; aj = 0; }
                            否 { 若 (aj < 1023) args[an][aj++] = ','; 若 (aj < 1023) args[an][aj++] = ' '; } /* 超限: 并入末槽 (变参) */
                            i++; 循环 (seg[i] == ' ' || seg[i] == '\t') i++; 续; /* fix 2026-08-14: 跳逗号后前导空格 — DECLARE_PROC_ADDR(..., strftime) 的 strftime 前带空格 → ## 拼接 proc_addr_ strftime 有空隙 */
                        }
                    }
                    若 (aj < 1023) args[an][aj++] = seg[i];
                    i++;
                }
                args[an][aj] = 0; an++;
