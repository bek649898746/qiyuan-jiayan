静 整 emit_fmt_loop(整 bound_disp) {
    整 ld = new_label(), ls = new_label(), lch = new_label(), lpct = new_label(), lcp = new_label(), lfmt = new_label(), ldone = new_label(), lf = new_label(), lx = new_label(), lsnoprec = new_label();
    整 lfnum = new_label(), lfrac = new_label(), lfrac2 = new_label(), lfsgn = new_label();
    /* specifier-prefix parse + %f precision (root-cause 2026-08-03) */
    整 lflag = new_label(), lflags = new_label(), lwidth = new_label(), lprec = new_label();
    整 ldot = new_label(), ldig = new_label(), lspec = new_label();
    整 ll_cnt = new_label(), lld32 = new_label(), lu32 = new_label(), lx32 = new_label(), lxU = new_label(), lxU32 = new_label(); /* fix 2026-08-06: %lld/%llu/%llx/%llX 64 位 (ll_cnt=计数, *32=32 位回退; lxU=%X 大写) */
    整 lscale = new_label(), lscdone = new_label(), ldigl = new_label(), ldigd = new_label();
    整 lu = new_label(); /* %u unsigned decimal (fix 2026-08-05) */
    整 lfdot = new_label(); /* %.0f: no '.' when N==0 */
    整 lpfmt = new_label(); /* %% -> literal '%' (root-cause 2026-08-03: was swallowed) */
    整 lcnt = new_label(), lcnt2 = new_label(), lcntd = new_label(), lpad = new_label(), lwdone = new_label(); /* %d width padding */
    整 lminus = new_label(), ldleft = new_label(), lleft = new_label(), llpad = new_label(); /* '-' 左对齐 flag + 数字后 padding (fix 2026-08-06) */
    整 lhash = new_label(), lzero = new_label(); /* fix 2026-08-09 审计#7: %#x 前缀 + %0Nx 零填充 */
    set_label(lfmt);
