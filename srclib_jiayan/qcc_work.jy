    若 (tt[tk] == VR && !strcmp(tn[tk], "窗口平均")) { /* 接入 2026-08-28 滑动窗口平均 (sliding window mean): 窗口平均 dst, src, n, w; → 窗口和 / w (复用窗口求和 + 除法) */
