静 整 st_field_csgn(常 字 *sn, 常 字 *fn) { /* 1 = signed char 字段 (int8_t) — char 字段读 movsx (fix 2026-08-29 csmith: s3/s137 union/struct int8 字段零扩展静默) */
    整 si = st_find(sn); 若 (si < 0) 返 0;
    遍 (整 i = 0; i < stypes[si].fn; i++)
        若 (!strcmp(stypes[si].fnames[i], fn)) { 整 v = 0; memcpy(&v, &stypes[si].fcsgn[i], 1); 返 v != 0; }
    返 0;
