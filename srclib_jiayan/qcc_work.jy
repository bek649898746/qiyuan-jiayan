        }
    返 4;
}
静 整 cur_frame_sz = 96; /* set in main() before codegen: size of every function frame */

/* load a pointer-typed variable's VALUE into eax: static → .data slot (RIP-relative),
   local/param → frame slot. Centralized so the if/else emits in a small function
   (the inline single-statement if/else form was observed to drop both branches in
   the compiled compiler). */
静 空 load_ptr_slot(整 off, 常 字 *vn) {
    若 (var_isstatic(vn)) mov_rax_rip64(coff_static_disp(off, 1) - 1);
    否 mov_reg_mbrp64(0, off - cur_frame_sz);
}

/* eax = param value: register param (rcx/rdx/r8/r9) or stack param ([rbp+pdisp]) */
静 空 load_param_val(常 字 *name) {
    遍 (整 i = vs_n() - 1; i >= 0; i--) {
        若 (!strcmp(vars[i].name, name) && var_codegen_visible(i)) {
            若 (vars[i].pstk) { 若 (vars[i].is_ll) mov_reg_mbrp64(0, vars[i].pdisp); 否 mov_reg_mbrp(0, vars[i].pdisp); } /* eax/rax = [rbp+pdisp] (LL: 64-bit, fix 2026-08-05) */
            否 若 (vars[i].is_param) { 整 r = -(vars[i].rsp_off + 1); 若 (r != 0) { 若 (vars[i].is_ll) mov_rr64(0, r); 否 mov_rr(0, r); } }
            返;
        }
    }
}

