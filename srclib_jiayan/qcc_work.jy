/* parse-time double-expression predicate (root-cause 2026-08-03): `(int)expr` cast
   creation relied on ndbl[ce], which for a double-returning CALL is only set at
   CODEGEN (case-4) — so `(int)dadd(2.5,3.5)` was a NO-OP at parse, the call stayed
   double-typed, and printf %d read the raw xmm0 low bits (0). Detect double-ness
   here at parse: ndbl covers FP/double-var/double-member/double-binary; calls need
   the callee signature (mirror of case-4 ndbl logic). */
静 整 expr_is_double(整 n) {
    
    若 (n < 0) 返 0;
    若 (ndbl[n]) 返 1;
    若 (nt[n] == 4) { /* function call */
        整 fn = n0[n];
        若 (fn < 0) 返 0;
        若 (nt[fn] == 1) { /* named callee: function or fnptr var */
            字 *cfn = (字*)(nn + fn);
            若 (fn_dbl_get_ret(cfn)) 返 1; /* known double-returning function */
            若 (var_pdbl(cfn)) 返 1;       /* double-returning fnptr variable */
            返 0;
        }
        若 (nt[fn] == 12) fn = n0[fn]; /* (*fp): deref decays to the pointer var */
        若 (nt[fn] == 1) 返 var_pdbl((字*)(nn + fn)) ? 1 : 0;
        { 整 bn = arr_base_node(fn); /* expression callee (tbl[i], arr[i].f): base's p_dbl */
          若 (bn >= 0 && nt[bn] == 1 && var_pdbl((字*)(nn + bn))) 返 1; }
    }
    返 0;
}

静 整 Nd(整 t);
静 空 Nc(整 p, 整 c);
静 整 expr(空);
/* Brace initializer: walk struct si's fields, consuming values from the token
   stream ({ a, b, c }) and emitting assignments against the base expression
   (a Nd(1) var or a Nd(15) nested-member node). Nested struct fields recurse;
   array fields expand per element. Returns a block of assignment nodes. */
静 整 brace_fields(整 si, 整 base) {
    整 blk = Nd(5);
    整 fidx = 0;
    /* C99 aggregate init zeroes every member not explicitly initialized. qcc only
       emitted the listed fields, so `struct strvec blank = STRVEC_INIT` left nr/alloc
       as stack garbage and strvec_clear looped over a garbage count. Zero all scalar
       fields first; the explicit initializer below then overwrites the listed ones.
       (fix 2026-08-15 git_jiayan --version crash in strvec_clear) */
    遍 (整 z = 0; z < stypes[si].fn; z++) {
        整 fty = stypes[si].ftypes[z];
        整 fsz = stypes[si].fsizes[z];
        整 frow = stypes[si].frows[z];
        若 ((fty >= 0 && stypes[fty].sz == fsz) || (frow > 0 && fsz > frow)) 续; /* nested struct/array: not scalar */
        字 fname[64]; strcpy(fname, stypes[si].fnames[z]);
        整 mem = Nd(15); memcpy((字*)(nn + mem), fname, 32); nv[mem] = 0;
        Nc(mem, base);
        整 zero = Nd(0); nv[zero] = 0;
        整 asgn = Nd(10); Nc(asgn, mem); Nc(asgn, zero); Nc(blk, asgn);
    }
    循环 (tt[tk] != UK && tt[tk] != EK) { /* until } — fidx may exceed fn for out-of-order designators (fix 2026-08-05) */
        若 (tt[tk] == CK || tt[tk] == SK) { tk++; 续; } /* skip comma between values */
        若 (tt[tk] == UK) 断;
        若 (tt[tk] == DT && tt[tk + 1] == VR) { /* designated initializer: .field = expr */
            tk++; /* . */
            字 fld[64]; strcpy(fld, tn[tk]); tk++; /* field name */
            若 (tt[tk] == AK) tk++; /* = */
            整 tgt = -1;
            遍 (整 j = 0; j < stypes[si].fn; j++) 若 (!strcmp(stypes[si].fnames[j], fld)) { tgt = j; 断; }
            若 (tgt < 0) { 循环 (tt[tk] != CK && tt[tk] != UK && tt[tk] != EK) tk++; 续; }
            fidx = tgt; /* jump to the designated field (may go BACK) */
            续;
        }
        若 (fidx >= stypes[si].fn) { expr(); fidx++; 续; } /* all fields consumed: drop extra values */
        字 fname[64]; strcpy(fname, stypes[si].fnames[fidx]);
        整 fty = stypes[si].ftypes[fidx];
        整 fsz2 = stypes[si].fsizes[fidx];
        整 frow2 = stypes[si].frows[fidx];
        整 mem = Nd(15); memcpy((字*)(nn + mem), fname, 32); nv[mem] = 0;
        Nc(mem, base);
        /* fix 2026-08-07: 指针字段 (ftype=指向的 struct, 但 fsz=8 ≠ struct size) 不递归 —
           自引用结构体 struct LNode { int v; struct LNode *next; } 的 next 若递归 → 无限递归死循环 */
        整 fty_is_ptr = (fty >= 0 && stypes[fty].sz != fsz2);
        若 (fty >= 0 && !fty_is_ptr) { /* nested struct field */
            若 (tt[tk] == FK) { /* explicit nested braces { ... }: recurse into fields */
                tk++;
                整 sub = brace_fields(fty, mem);
                若 (tt[tk] == UK) tk++; /* skip closing } */
                遍 (整 k = 0; k < 256; k++) { 整 c = child_i(sub, k); 若 (c > 0) Nc(blk, c); }
            } 否 { /* struct VALUE expr (e.g. .needle = *want): copy whole struct (fix 2026-08-14: 原递归 brace_fields 误把 *want 当字段 → 死循环/崩溃) */
                整 asgn = Nd(10); Nc(asgn, mem); Nc(asgn, expr()); Nc(blk, asgn);
            }
        } 否 若 (frow2 > 0 && fsz2 > frow2) { /* array field: per element */
            整 nfield = fsz2 / frow2;
            整 open_brace = (tt[tk] == FK); /* explicit array braces { a, b } (fix 2026-08-14: 原不消费 { → expr() 卡 FK 死循环) */
            若 (open_brace) tk++;
            遍 (整 ei = 0; ei < nfield; ei++) {
                若 (tt[tk] == CK || tt[tk] == SK) tk++;
                若 (tt[tk] == UK || tt[tk] == EK) 断;
                整 eidx = ei;
                若 (tt[tk] == LB) { /* [idx] = value 指定下标 (fix 2026-08-14: .colors = { [GREP_COLOR_CONTEXT] = "..." } 原 [ 无分支 → expr() 返回 -1 死循环/崩溃) */
                    tk++;
                    若 (tt[tk] == NK) { eidx = tv[tk]; tk++; }
                    否 若 (tt[tk] == VR) { 整 evc = e_lookup(tn[tk]); 若 (evc == 0x80000000) evc = macro_find(tn[tk]); 若 (evc != 0x80000000 && evc != -1) eidx = evc; tk++; }
                    若 (tt[tk] == RB) tk++;
                    若 (tt[tk] == AK) tk++;
                }
                整 acc = Nd(14); Nc(acc, mem);
                整 idx = Nd(0); nv[idx] = eidx; Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc); Nc(asgn, expr()); Nc(blk, asgn);
            }
            若 (open_brace) { 循环 (tt[tk] == CK || tt[tk] == SK) tk++; 若 (tt[tk] == UK) tk++; } /* skip matching } (trailing comma inside array braces) */
        } 否 若 (tt[tk] == FK) { /* opaque nested brace (union field .u = { ... } 且 fty=-1): 跳过配平 (fix 2026-08-14: expr() 遇 { 崩溃) */
            整 d2 = 1; tk++;
            循环 (tk < TS && d2 > 0) { 若 (tt[tk] == FK) d2++; 否 若 (tt[tk] == UK) { d2--; 若 (d2 <= 0) { tk++; 断; } } tk++; }
        } 否 { /* scalar field */
            整 asgn = Nd(10); Nc(asgn, mem); Nc(asgn, expr()); Nc(blk, asgn);
        }
        fidx++;
    }
    返 blk;
}

静 整 kw(常 字 *s) {
    /* 甲言中文关键字已在 lexer 改写成英文 (tn), 此处只认英文 */
    若 (!strcmp(s, "struct") || !strcmp(s, "union")) 返 ST; /* union shares the struct machinery (offset-0 fields) */
    若 (!strcmp(s, "extern")) 返 VK;
    若 (!strcmp(s, "static")) 返 VK; /* treat as type modifier */
    若 (!strcmp(s, "const")) 返 VK;
    若 (!strcmp(s, "volatile")) 返 VK; /* 类型修饰符（fix 2026-08-06: 内核 MMIO 需要; 当普通 VK 跳过, 语义同 int） */
    若 (!strcmp(s, "void")) 返 VK;
    若 (!strcmp(s, "FILE") || !strcmp(s, "long")) 返 VK; /* builtin types used by self-host */
    若 (!strcmp(s, "enum")) 返 EN;
    若 (!strcmp(s, "return")) 返 RK;
    若 (!strcmp(s, "if")) 返 IK;
    若 (!strcmp(s, "else")) 返 ZK;
    若 (!strcmp(s, "while")) 返 WK;
    若 (!strcmp(s, "do")) 返 DW;
    若 (!strcmp(s, "goto")) 返 GT;
    若 (!strcmp(s, "for")) 返 JK;
    若 (!strcmp(s, "break")) 返 BR;
    若 (!strcmp(s, "continue")) 返 CN;
    若 (!strcmp(s, "switch")) 返 SW;
    若 (!strcmp(s, "case")) 返 CA;
    若 (!strcmp(s, "default")) 返 DF;
    若 (!strcmp(s, "signed")) 返 VK; /* fix 2026-08-15: signed char const cq_lookup[] — signed 未识别为关键字 */
    若 (!strcmp(s, "unsigned")) 返 VK;
    若 (!strcmp(s, "int") || !strcmp(s, "double")) 返 VK;
    若 (!strcmp(s, "char")) 返 VK;
    若 (!strcmp(s, "_Bool")) 返 VK;
    若 (!strcmp(s, "inline")) 返 VK;
    若 (!strcmp(s, "short")) 返 VK; /* fix 2026-08-06: short 缺词法分类 → struct 字段被当标识符注册成幻影字段, 布局错乱 (回归测试 regress_struct_align 暴露) */
    若 (!strcmp(s, "void")) 返 VK;
    若 (!strcmp(s, "sizeof")) 返 BK;
    返 NK;
}

静 空 lex(常 字 *s) {
    整 i = 0; ti = 0; tk = 0; 整 unknown_chars = 0; /* fix 2026-08-09 BUG-5: 未知字符计数, lex 结束汇报 */
    循环 (s[i] && ti < TS) {
        循环 (s[i] == ' ' || s[i] == '\n' || s[i] == '\t' || s[i] == '\r' || s[i] == '\f' || s[i] == '\v') i++; /* fix 2026-08-13 Phase3: \f/\v 是合法空白 — 漏掉会落入 switch default 发射 tt=0(EK) 幽灵 token, 中间截断 parse (regex_internal.c 第40行 \f) */
        若 (!s[i]) 断;
        若 (if_skip && s[i] != '#') { 循环 (s[i] && s[i] != '\n') i++; 续; } /* false branch: skip whole code lines (fix 2026-08-05) */
        若 (s[i] == '/' && s[i + 1] == '/') { 循环 (s[i] && s[i] != '\n') i++; 续; }
        若 (s[i] == '/' && s[i + 1] == '*') { i += 2; 循环 (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++; 若 (s[i]) i += 2; 续; }
        若 (s[i] == '#') { /* #define NAME VALUE / #include / conditional compilation (fix 2026-08-05: #ifdef/#ifndef/#if/#elif/#else/#endif) */
            整 d = i + 1; 循环 (s[d] == ' ' || s[d] == '\t') d++; /* fix 2026-08-13 Phase3: # 后空白 (glibc 缩进指令 #  define) */
            整 is_def = !strncmp(s + d, "define", 6) && (s[d + 6] == 0 || s[d + 6] == ' ' || s[d + 6] == '\t' || s[d + 6] == '\r' || s[d + 6] == '\n');
            整 is_ifdef = !strncmp(s + d, "ifdef", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            整 is_ifndef = !strncmp(s + d, "ifndef", 6) && (s[d + 6] == 0 || s[d + 6] == ' ' || s[d + 6] == '\t' || s[d + 6] == '\r' || s[d + 6] == '\n');
            整 is_if = !strncmp(s + d, "if", 2) && !is_ifdef && !is_ifndef && (s[d + 2] == 0 || s[d + 2] == ' ' || s[d + 2] == '\t' || s[d + 2] == '\r' || s[d + 2] == '\n');
            整 is_elif = !strncmp(s + d, "elif", 4) && (s[d + 4] == 0 || s[d + 4] == ' ' || s[d + 4] == '\t' || s[d + 4] == '\r' || s[d + 4] == '\n');
            整 is_else = !strncmp(s + d, "else", 4) && (s[d + 4] == 0 || s[d + 4] == ' ' || s[d + 4] == '\t' || s[d + 4] == '\r' || s[d + 4] == '\n');
            整 is_endif = !strncmp(s + d, "endif", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            整 is_undef = !strncmp(s + d, "undef", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            整 is_error = !strncmp(s + d, "error", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = if_skip;
                字 expr[512]; 整 ei = 0;
                若 (is_if || is_elif) {
                    整 p = d;
                    若 (is_if) p += 2; 否 p += 4;
                    循环 (s[p] == ' ' || s[p] == '\t') p++;
                    循环 (s[p] && s[p] != '\n' && ei < 510) expr[ei++] = s[p++];
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--; /* trim trailing (fix 2026-08-05: "#if VER > 1" left "VER " → macro lookup failed) */
                }
                expr[ei] = 0;
                整 cond = 0;
                若 (is_ifdef || is_ifndef) { /* #ifdef NAME / #ifndef NAME — read macro name straight from s[] */
                    字 nm[64]; 整 ni = 0;
                    整 p = d + (is_ifdef ? 5 : 6);
                    循环 (s[p] == ' ' || s[p] == '\t') p++;
                    循环 (isalnum(s[p]) || s[p] == '_' || ((无 字)s[p] >= 0x80)) { 若 (ni < 63) nm[ni++] = s[p]; p++; }
                    nm[ni] = 0;
                    整 def = macro_exists(nm); /* fix 2026-08-06: 原 macro_find>=0 对负值宏判假 */
                    cond = is_ifdef ? def : !def;
                } 否 若 (is_if || is_elif) {
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (if_n < 64) {
