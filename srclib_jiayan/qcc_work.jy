              整 v_i3 = Nd(1); memcpy((字*)(nn + v_i3), iname, 32);
              整 idx_a2 = Nd(14); Nc(idx_a2, v_a); Nc(idx_a2, v_i3);
              整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_a2); Nc(if_a_t, asg); /* dst[__mk]=a[__mi]; */
              整 v_i4 = Nd(1); memcpy((字*)(nn + v_i4), iname, 32);
              整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i4); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
              整 asg2 = Nd(10); Nc(asg2, v_i4); Nc(asg2, pl); Nc(if_a_t, asg2); /* __mi++; */
            }
            Nc(if_a, if_a_t);
            整 if_a_e = Nd(5);
            { 整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
              整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_k);
              整 v_j3 = Nd(1); memcpy((字*)(nn + v_j3), jname, 32);
              整 idx_b2 = Nd(14); Nc(idx_b2, v_b); Nc(idx_b2, v_j3);
              整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_b2); Nc(if_a_e, asg); /* dst[__mk]=b[__mj]; */
              整 v_j4 = Nd(1); memcpy((字*)(nn + v_j4), jname, 32);
              整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_j4); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
              整 asg2 = Nd(10); Nc(asg2, v_j4); Nc(asg2, pl); Nc(if_a_e, asg2); /* __mj++; */
            }
            n2[if_a] = if_a_e;
            Nc(if_j_t, if_a);
            整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
            整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_k); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
            整 asg3 = Nd(10); Nc(asg3, v_k); Nc(asg3, pl); Nc(if_j_t, asg3); /* __mk++; */
          }
          Nc(if_j, if_j_t);
          整 if_j_e = Nd(5);
          { 整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
            整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_k);
            整 v_i5 = Nd(1); memcpy((字*)(nn + v_i5), iname, 32);
            整 idx_a3 = Nd(14); Nc(idx_a3, v_a); Nc(idx_a3, v_i5);
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_a3); Nc(if_j_e, asg); /* dst[__mk]=a[__mi]; */
            整 v_i6 = Nd(1); memcpy((字*)(nn + v_i6), iname, 32);
            整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i6); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
            整 asg2 = Nd(10); Nc(asg2, v_i6); Nc(asg2, pl); Nc(if_j_e, asg2); /* __mi++; */
            整 v_k2 = Nd(1); memcpy((字*)(nn + v_k2), kname, 32);
            整 pl2 = Nd(2); nv[pl2] = PK; Nc(pl2, v_k2); { 整 one = Nd(0); nv[one] = 1; Nc(pl2, one); }
            整 asg3 = Nd(10); Nc(asg3, v_k2); Nc(asg3, pl2); Nc(if_j_e, asg3); /* __mk++; */
          }
          n2[if_j] = if_j_e;
          Nc(bd, if_j); }
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd, setl); nv[wh] = cl + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        /* 剩余 a */
        { 整 wh_a = Nd(9);
          { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_na); Nc(wh_a, cmp); }
          整 bd_a = Nd(5);
          { 整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
            整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_k);
            整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
            整 idx_a = Nd(14); Nc(idx_a, v_a); Nc(idx_a, v_i);
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_a); Nc(bd_a, asg);
            整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
            整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
            整 asg2 = Nd(10); Nc(asg2, v_i2); Nc(asg2, pl); Nc(bd_a, asg2);
            整 v_k2 = Nd(1); memcpy((字*)(nn + v_k2), kname, 32);
            整 pl2 = Nd(2); nv[pl2] = PK; Nc(pl2, v_k2); { 整 one = Nd(0); nv[one] = 1; Nc(pl2, one); }
            整 asg3 = Nd(10); Nc(asg3, v_k2); Nc(asg3, pl2); Nc(bd_a, asg3);
          }
          { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd_a, setl); nv[wh_a] = cl + 1; }
          Nc(wh_a, bd_a);
          Nc(blk, wh_a); }
        /* 剩余 b */
        { 整 wh_b = Nd(9);
          { 整 v_j = Nd(1); memcpy((字*)(nn + v_j), jname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_j); Nc(cmp, e_nb); Nc(wh_b, cmp); }
          整 bd_b = Nd(5);
          { 整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
            整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_k);
            整 v_j = Nd(1); memcpy((字*)(nn + v_j), jname, 32);
            整 idx_b = Nd(14); Nc(idx_b, v_b); Nc(idx_b, v_j);
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_b); Nc(bd_b, asg);
            整 v_j2 = Nd(1); memcpy((字*)(nn + v_j2), jname, 32);
            整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_j2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
            整 asg2 = Nd(10); Nc(asg2, v_j2); Nc(asg2, pl); Nc(bd_b, asg2);
            整 v_k2 = Nd(1); memcpy((字*)(nn + v_k2), kname, 32);
            整 pl2 = Nd(2); nv[pl2] = PK; Nc(pl2, v_k2); { 整 one = Nd(0); nv[one] = 1; Nc(pl2, one); }
            整 asg3 = Nd(10); Nc(asg3, v_k2); Nc(asg3, pl2); Nc(bd_b, asg3);
          }
          { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd_b, setl); nv[wh_b] = cl + 1; }
          Nc(wh_b, bd_b);
          Nc(blk, wh_b); }
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "去重")) { /* 接入 2026-08-27 去重 (unique 相邻去重): 去重 dst, src, n; → { __uq=0; __k=0; while(__uq<n){ if(__k==0 || dst[__k-1]!=src[__uq]){ dst[__k]=src[__uq]; __k++; } __uq++; } } — 去除相邻重复 (须排序后), 双指针 */
        tk++; /* 去重 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 uq_seq = 0; 字 iname[64]; sprintf(iname, "__uq_%d_", uq_seq++);
        静 整 uq_seq2 = 0; 字 kname[64]; sprintf(kname, "__uk_%d_", uq_seq2++);
        var_offset(iname); var_offset(kname); /* 遍历/输出 双指针 */
        整 blk = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __uq = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), kname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __uk = 0; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__uq < n) */
        整 bd = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 v_k = Nd(1); memcpy((字*)(nn + v_k), kname, 32);
          整 idx_s = Nd(14); Nc(idx_s, v_s); Nc(idx_s, v_i); /* src[__uq] */
          /* cond: __k==0 || dst[__k-1]!=src[__uq] — 简化为 dst[__k-1]==src[__uq] 且 __k>0 才跳过, 用嵌套 if: if(__k>0){ if(dst[__k-1]==src){ 跳过 } else { 保留 } } else { 保留 } — v1 用"非重复才保留"简化: if(!(__k>0 && dst[__k-1]==src)) */
          整 v_k2 = Nd(1); memcpy((字*)(nn + v_k2), kname, 32);
          整 zero = Nd(0); nv[zero] = 0;
          整 gt0 = Nd(2); nv[gt0] = T_GK; Nc(gt0, v_k2); Nc(gt0, zero); /* __k > 0 */
          整 v_k3 = Nd(1); memcpy((字*)(nn + v_k3), kname, 32);
          整 one1 = Nd(0); nv[one1] = 1;
          整 km1 = Nd(2); nv[km1] = MK; Nc(km1, v_k3); Nc(km1, one1); /* __k-1 */
          整 idx_p = Nd(14); Nc(idx_p, v_d); Nc(idx_p, km1); /* dst[__k-1] */
          整 eq = Nd(2); nv[eq] = T_QK; Nc(eq, idx_p); Nc(eq, idx_s); /* dst[__k-1] == src[__uq] */
          整 if_gt = Nd(8); Nc(if_gt, gt0); /* 用 if 嵌套: if(__k>0) { if(相等) 跳过 else 保留 } else 保留 */
          整 if_gt_b = Nd(5);
          整 if_eq = Nd(8); Nc(if_eq, eq);
          整 if_eq_t = Nd(5); /* 相等: 跳过 (空块) */
          Nc(if_eq, if_eq_t);
          整 if_eq_e = Nd(5);
          { 整 v_k4 = Nd(1); memcpy((字*)(nn + v_k4), kname, 32);
            整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_k4); /* dst[__uk] */
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(if_eq_e, asg); /* dst[__uk] = src[__uq]; */
            整 v_k5 = Nd(1); memcpy((字*)(nn + v_k5), kname, 32);
            整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_k5); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
            整 asg2 = Nd(10); Nc(asg2, v_k5); Nc(asg2, pl); Nc(if_eq_e, asg2); /* __uk++; */
          }
          n2[if_eq] = if_eq_e;
          Nc(if_gt_b, if_eq);
          Nc(if_gt, if_gt_b);
          整 if_gt_e = Nd(5);
          { 整 v_k4 = Nd(1); memcpy((字*)(nn + v_k4), kname, 32);
            整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_k4);
            整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(if_gt_e, asg); /* dst[__uk] = src[__uq]; */
            整 v_k5 = Nd(1); memcpy((字*)(nn + v_k5), kname, 32);
            整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_k5); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
            整 asg2 = Nd(10); Nc(asg2, v_k5); Nc(asg2, pl); Nc(if_gt_e, asg2); /* __uk++; */
          }
          n2[if_gt] = if_gt_e;
          Nc(bd, if_gt); }
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i2); Nc(asg, pl); Nc(bd, asg); } /* __uq++; */
        { 整 cl_u = new_label(); 整 setl_u = Nd(20); nv[setl_u] = cl_u + 1; Nc(bd, setl_u); nv[wh] = cl_u + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "计数")) { /* 接入 2026-08-27 计数 (匹配元素数): 计数 c, arr, n, cond; → { c=0; __ct=0; while(__ct<n){ if(cond(arr[__ct])){ c++; } __ct++; } } — 统计满足条件元素数, if 包块 */
        tk++; /* 计数 */
        字 cntn[64]; strcpy(cntn, tn[tk]); tk++; /* 计数变量 */
        若 (tt[tk] == CK) tk++; /* , */
        字 arrn[64]; strcpy(arrn, tn[tk]); tk++; /* 数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_cond = expr(); /* 条件函数 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 ct_seq = 0; 字 iname[64]; sprintf(iname, "__ct_%d_", ct_seq++);
        var_offset(iname);
        整 blk = Nd(5);
        整 v_c = Nd(1); memcpy((字*)(nn + v_c), cntn, 32);
        { 整 z = Nd(0); nv[z] = 0; 整 asg = Nd(10); Nc(asg, v_c); Nc(asg, z); Nc(blk, asg); } /* c = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __ct = 0; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__ct < n) */
        整 bd = Nd(5);
        整 v_r = Nd(1); memcpy((字*)(nn + v_r), arrn, 32);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx1 = Nd(14); Nc(idx1, v_r); Nc(idx1, v_i); /* arr[__ct] */
          整 condc = Nd(4); Nc(condc, idx1); Nc(condc, e_cond); /* cond(arr[__ct]) */
          整 ifn = Nd(8); Nc(ifn, condc);
          整 ibd = Nd(5);
          { 整 v_c2 = Nd(1); memcpy((字*)(nn + v_c2), cntn, 32);
            整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_c2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
            整 asg = Nd(10); Nc(asg, v_c2); Nc(asg, pl); Nc(ibd, asg); } /* c++; */
          Nc(ifn, ibd);
          Nc(bd, ifn); }
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i2); Nc(asg, pl); Nc(bd, asg); } /* __ct++; */
        { 整 cl_c = new_label(); 整 setl_c = Nd(20); nv[setl_c] = cl_c + 1; Nc(bd, setl_c); nv[wh] = cl_c + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "查找")) { /* 接入 2026-08-27 查找 (线性查找): 查找 idx, arr, n, val; → { idx=-1; __fh=0; while(__fh<n){ if(arr[__fh]==val){ idx=__fh; break; } __fh++; } } — 返回第一个匹配索引, 无则 -1 */
        tk++; /* 查找 */
        字 idxn[64]; strcpy(idxn, tn[tk]); tk++; /* 索引变量 */
        若 (tt[tk] == CK) tk++; /* , */
        字 arrn[64]; strcpy(arrn, tn[tk]); tk++; /* 数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_val = expr(); /* 查找值 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 fh_seq = 0; 字 iname[64]; sprintf(iname, "__fh_%d_", fh_seq++);
        var_offset(iname);
        整 blk = Nd(5);
        整 v_i = Nd(1); memcpy((字*)(nn + v_i), idxn, 32);
        { 整 neg = Nd(0); nv[neg] = -1; 整 asg = Nd(10); Nc(asg, v_i); Nc(asg, neg); Nc(blk, asg); } /* idx = -1; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __fh = 0; */
        整 wh = Nd(9);
        { 整 v_f = Nd(1); memcpy((字*)(nn + v_f), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_f); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__fh < n) */
        整 bd = Nd(5);
        整 v_r = Nd(1); memcpy((字*)(nn + v_r), arrn, 32);
        { 整 v_f = Nd(1); memcpy((字*)(nn + v_f), iname, 32);
          整 idx_a = Nd(14); Nc(idx_a, v_r); Nc(idx_a, v_f); /* arr[__fh] */
          整 cmp = Nd(2); nv[cmp] = T_QK; Nc(cmp, idx_a); Nc(cmp, e_val); /* arr[__fh] == val */
          整 ifn = Nd(8); Nc(ifn, cmp);
          整 ibd = Nd(5);
          { 整 v_f2 = Nd(1); memcpy((字*)(nn + v_f2), iname, 32); 整 asg = Nd(10); Nc(asg, v_i); Nc(asg, v_f2); Nc(ibd, asg); } /* idx = __fh; */
          整 brk = Nd(16); Nc(ibd, brk); /* break; */
          Nc(ifn, ibd);
          Nc(bd, ifn); }
        { 整 v_f = Nd(1); memcpy((字*)(nn + v_f), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_f); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_f); Nc(asg, pl); Nc(bd, asg); } /* __fh++; */
        { 整 cl_f = new_label(); 整 setl_f = Nd(20); nv[setl_f] = cl_f + 1; Nc(bd, setl_f); nv[wh] = cl_f + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && (!strcmp(tn[tk], "最大") || !strcmp(tn[tk], "最小"))) { /* 接入 2026-08-27 最大/最小 (数组极值): 最大 m, arr, n; → { m=arr[0]; __mi=1; while(__mi<n){ if(arr[__mi] > m){ m=arr[__mi]; } __mi++; } } — if 体包块 (深水区教训) */
        整 is_max = !strcmp(tn[tk], "最大");
        tk++; /* 最大/最小 */
        字 accn[64]; strcpy(accn, tn[tk]); tk++; /* 极值变量 */
        若 (tt[tk] == CK) tk++; /* , */
        字 arrn[64]; strcpy(arrn, tn[tk]); tk++; /* 数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 mn_seq = 0; 字 iname[64]; sprintf(iname, "__mn_%d_", mn_seq++);
        var_offset(iname);
        整 blk = Nd(5);
        整 v_a = Nd(1); memcpy((字*)(nn + v_a), accn, 32);
        整 v_r = Nd(1); memcpy((字*)(nn + v_r), arrn, 32);
        { 整 z = Nd(0); nv[z] = 0; 整 idx0 = Nd(14); Nc(idx0, v_r); Nc(idx0, z); 整 asg = Nd(10); Nc(asg, v_a); Nc(asg, idx0); Nc(blk, asg); } /* m = arr[0]; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 one = Nd(0); nv[one] = 1; Nc(d, one); } Nc(blk, d); } /* int __mn = 1; */
        整 wh = Nd(9);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32); 整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_i); Nc(cmp, e_n); Nc(wh, cmp); } /* while (__mn < n) */
        整 bd = Nd(5);
        { 整 v_i = Nd(1); memcpy((字*)(nn + v_i), iname, 32);
          整 idx1 = Nd(14); Nc(idx1, v_r); Nc(idx1, v_i); /* arr[__mn] */
          整 cmp = Nd(2); nv[cmp] = is_max ? T_GK : T_LK; Nc(cmp, idx1); Nc(cmp, v_a); /* arr[__mn] >/< m */
          整 ifn = Nd(8); Nc(ifn, cmp);
          整 ibd = Nd(5);
          { 整 asg = Nd(10); Nc(asg, v_a); Nc(asg, idx1); Nc(ibd, asg); } /* m = arr[__mn]; */
          Nc(ifn, ibd);
          Nc(bd, ifn); }
        { 整 v_i2 = Nd(1); memcpy((字*)(nn + v_i2), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_i2); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_i2); Nc(asg, pl); Nc(bd, asg); } /* __mn++; */
        { 整 cl_m = new_label(); 整 setl_m = Nd(20); nv[setl_m] = cl_m + 1; Nc(bd, setl_m); nv[wh] = cl_m + 1; }
        Nc(wh, bd);
        Nc(blk, wh);
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "排序")) { /* 接入 2026-08-27 排序 (冒泡): 排序 arr, n; → 双 while + if(arr[j]>arr[j+1]){三步交换} — 就地升序. fix 2026-08-27: ①n 存内部变量 __sn 防共享节点 ②交换包块 Nd(5) 挂 if then (直接挂 if 只处理 n1, n2 当 else) */
        tk++; /* 排序 */
        字 arrn[64]; strcpy(arrn, tn[tk]); tk++; /* 数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_n = expr(); /* 长度 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 st_seq = 0; 字 iname[64]; sprintf(iname, "__si_%d_", st_seq++);
        静 整 st_seq2 = 0; 字 jname[64]; sprintf(jname, "__sj_%d_", st_seq2++);
