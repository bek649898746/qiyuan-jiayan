    遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].st_idx;
    返 -1;
}
静 整 var_pesz(常 字 *n) {
