静 整 asm_mode = 0;          /* -S ?????? */
静 整 lc;                 /* ????????*/
静 整 epi_label;          /* function epilogue */
静 整 brk_label;          /* break jump target */
静 整 cont_label = -1;    /* continue jump target (innermost loop) */
/* The loader parks the main-thread stack right above the image's committed
   sections �?INSIDE the 80MB .data virtual range (stack ~VA 4.8-5.8MB, .data
   base 4.53MB). Static writes in that range would corrupt live stack frames
   (rbp high bits -> SIGSEGV). This pad shifts every written static/heap slot
   above ~5.9MB so nothing overlaps the stack. */
__attribute__((unused))
静 字 __pad0[STACK_PAD_SIZE];
静 字 str_tbl[1024][2048]; /* fix 2026-08-06: 512→2048 支持长字面量 */ 整 str_cnt;
静 构 { 字 name[32]; 整 rsp_off, is_param, pslot, preg, pstk, pdisp, st_idx, st_sz, arr_sz, arr_esz, p_esz, is_static, is_dbl; 字 p_dbl, is_char, is_uns, is_ll; 整 frows[4]; } vars[4096]; 整 vcnt; /* is_ll: long long（8 字节整）变量（fix 2026-08-05） */
静 整 stc_n = 0; /* static vars: slots in .data after the 8-byte heap counter */
/* two-pass generation state (file scope) */
静 整 root_global, g_lc_save, g_rsp_save, entry_rva_global;
静 整 crt_entry_off; /* .text offset of the mini-CRT entry stub (pass 2 value) */
静 整 fvb[512], fve[512], fvn; /* per-function var index ranges (parse order == gen order) */
静 整 fr_start[512], fr_end[512]; /* per-function rsp_used bounds at parse (exact frame footprint) */
静 整 gen_final = 0; /* 1 only on the LAST gen_code pass: gate -S asm text so the .asm file holds one copy (fix 2026-08-05: iteration re-runs gen_code → duplicate code + broken label resolution) */
静 整 gfn; /* current function index during gen_code */
静 整 vs_end = 0; /* var-search bound: vcnt during parse, fve[gfn] during codegen */
静 整 parse_base = 0; /* var-search floor during parse: fvb[fvn] inside a function body, else 0.
                              Prevents a body-local decl (e.g. cg's `int fn`) from reusing a same-named
                              var/param registered by an UNRELATED function (which would leave the
                              local unregistered here and let codegen fall back to a `char fn[32]`
                              array from another function -> LEA of its own address). */
静 整 cg_no_deref = 0; /* case 14: skip the final deref (nested-store base address) */
静 整 cg_mem_frow = 0; /* case 15: row size of the last static-struct array member read (2D field: fnames[idx]) */
静 整 cg_mem_dbl = 0;  /* case 14/15 nested: last array/member base is a double array → outer [i] load uses movsd */
静 整 cg_fdepth = 0;   /* multi-D nested-array chain depth (fix 2026-08-05) */
静 整 cg_fdepth_max = 0; /* innermost array's dimension count (deref only at outermost) */
静 整 cg_frows[4];     /* per-dim row sizes, set by the innermost array var */
静 整 cg_ginit_ctx = 0; /* 1 while emitting ginit initializers at main entry (case-7 must NOT skip them) */
静 整 cur_fn_sret = 0;  /* parse/codegen: current function returns a >8B struct by value (Win64 sret) */
静 整 cur_ret_si = -1;  /* codegen: current function's return struct type index (-1 = not struct) */
静 整 cg_sret_off = 0;  /* case-4: rbp-relative sret target (lea rcx) for a struct-returning call; 0 = none */
静 整 sret_ptr_off = 0; /* sret fn prologue: frame slot that saves the hidden return pointer (rcx) */
