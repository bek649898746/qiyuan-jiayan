        若 (!strcmp(fn_ret_sz_sig[i].name, name)) 返 fn_ret_sz_sig[i].ret_uns;
    返 0;
}
静 字 cur_fn_name[64]; /* function currently being codegen'd (case-6 double return) */
静 空 fn_dbl_put(常 字 *name, 整 pr, 整 dbl) {
    若 (pr < 0 || pr >= 8) 返;
    遍 (整 i = 0; i < fn_dbl_n; i++)
        若 (!strcmp(fn_dbl_sig[i].name, name)) { fn_dbl_sig[i].pdbl[pr] = (字)dbl; 返; }
    若 (fn_dbl_n >= 512) 返;
    strcpy(fn_dbl_sig[fn_dbl_n].name, name);
    memset(fn_dbl_sig[fn_dbl_n].pdbl, 0, 8);
    fn_dbl_sig[fn_dbl_n].pdbl[pr] = (字)dbl;
    fn_dbl_n++;
}
静 空 fn_dbl_set_ret(常 字 *name, 整 dbl) {
    遍 (整 i = 0; i < fn_dbl_n; i++)
        若 (!strcmp(fn_dbl_sig[i].name, name)) { fn_dbl_sig[i].ret_dbl = (字)dbl; 返; }
    若 (fn_dbl_n >= 512) 返;
    strcpy(fn_dbl_sig[fn_dbl_n].name, name);
    memset(fn_dbl_sig[fn_dbl_n].pdbl, 0, 8);
    fn_dbl_sig[fn_dbl_n].ret_dbl = (字)dbl;
    fn_dbl_n++;
}
静 整 fn_dbl_get(常 字 *name, 整 pr) {
    若 (pr < 0 || pr >= 8) 返 0;
    遍 (整 i = 0; i < fn_dbl_n; i++)
        若 (!strcmp(fn_dbl_sig[i].name, name)) 返 fn_dbl_sig[i].pdbl[pr];
    返 0;
}
静 整 fn_dbl_get_ret(常 字 *name) {
    遍 (整 i = 0; i < fn_dbl_n; i++)
        若 (!strcmp(fn_dbl_sig[i].name, name)) 返 fn_dbl_sig[i].ret_dbl;
    返 0;
}

/* fix 2026-08-30 探雷雷3: 内置/IAT 函数豁免表 — 未声明但 qcc 直接支持的内置调用
   (case-4 特殊处理 + IAT + msvcrt 标准库), C99 废除隐式声明后的白名单. 用户若
   定义同名函数 (defined=1) 优先用用户的, 此表仅在既无定义又无原型时兜底放行. */
静 常 字 *qcc_builtin_fns[] = {
    "printf","fprintf","sprintf","snprintf","vsnprintf","vfprintf","vprintf",
    "scanf","sscanf","fscanf","putstr","puts","putchar","getchar","gets",
    "memcpy","memset","memmove","memchr","memcmp",
    "strcpy","strncpy","strcmp","strncmp","strlen","strcat","strncat","strchr",
    "strrchr","strstr","strtok","strcspn","strspn","strdup","strndup","strerror",
    "strtol","strtoul","strtod","atoi","atol","atof","labs","llabs",
    "malloc","calloc","free","realloc","abort","qsort","bsearch","abs","rand","srand",
    "fopen","fclose","fread","fwrite","fseek","ftell","rewind","fgetc","fgets","fputc",
    "fputs","fflush","feof","ferror","fgetpos","fsetpos","remove","rename","tmpfile",
    "isdigit","isxdigit","isalnum","isalpha","isspace","islower","isupper","tolower","toupper",
    "clock","time","system","getenv",
    "fabs","floor","ceil","sqrt","pow","log","exp","sin","cos","tan","atan","atan2",
    "fmod","frexp","ldexp","modf","exit","_exit","getc","putc","ungetc",
    "GetStdHandle","GetCommandLineA","GetModuleFileNameA","GetProcAddress","LoadLibraryA",
    "VirtualAlloc","CreateThread","WaitForSingleObject","CloseHandle","ExitProcess",
    "SetFilePointer","ReadFile","WriteFile","CreateFiber","SwitchToFiber","ConvertThreadToFiber",
    "RtlEnterCriticalSection","RtlLeaveCriticalSection","get_proc_address","load_library",
    "thread_create","thread_join","atomic_fetch_add","atomic_exchange","atomic_compare_exchange",
    "atomic_load","atomic_store","atomic_load_acquire","atomic_load_release","atomic_load_relaxed",
    "atomic_store_release","atomic_store_relaxed","atomic_fetch_add_relaxed","atomic_exchange_relaxed",
    "atomic_fetch_add_acquire","atomic_fetch_add_release","atomic_exchange_acquire","atomic_exchange_release", /* fix 2026-08-30: 原子操作内存序变体 (原子 读/写/加/交换 + 松散/acquire/release, jyclib) */
    "mutex_lock","mutex_unlock", /* fix 2026-08-30: 锁住 m { } 脱糖的互斥锁运行时函数 (甲言内建自旋锁特性, batch6 #70) */"inb","inl","outb","outl","__asm","__asm_byte",
    "_write","_close","_unlink","_getpos","_setpos","_scanf_rt","_vsnprintf",
    "_bump_set","_bump_top","_va_alloc","_start","_exit_proc","__qcc_va_start",
    "isalpha_zh","strncmp_zh","strcmp_zh","strlen_zh","strcpy_zh","strchr_zh","strstr_zh",
};
静 整 is_qcc_builtin(常 字 *n) {
    遍 (整 i = 0; i < (整)(大小(qcc_builtin_fns) / 大小(qcc_builtin_fns[0])); i++)
        若 (!strcmp(qcc_builtin_fns[i], n)) 返 1;
    返 0;
}
静 整 func_find(常 字 *name) {
    遍 (整 i = 0; i < func_n; i++)
        若 (!strcmp(func_tbl[i].name, name)) 返 i;
    若 (func_n >= 65536) { fprintf(stderr, "[ERR] func_tbl 满 %d (%s)\n", func_n, name); exit(1); } /* fix 2026-08-16 根因E3: 原 1024 守卫与 2048 容量错配 → 返 -1 → 调用点 func_tbl[-1] 越界写崩 (attr.c); 改满则硬退, 绝不返 -1 */
    strcpy(func_tbl[func_n].name, name);
    func_tbl[func_n].label = new_label();
    func_tbl[func_n].defined = 0;
    func_tbl[func_n].declared = 0; /* fix 2026-08-30 探雷雷3: 新条目默认未声明 — 原型/declare 登记处置 1 (原 declared 残留跨编译污染) */
    func_tbl[func_n].ret_si = -1; /* non-struct return by default */
    返 func_n++;
}
/* user labels for goto: id allocated ONCE at parse (via new_label), so pass 1/2 agree */
静 构 { 字 name[64]; 整 id; } lbl_tbl[512]; 静 整 lbl_n;
静 整 lbl_find(常 字 *n) {
    遍 (整 i = 0; i < lbl_n; i++) 若 (!strcmp(lbl_tbl[i].name, n)) 返 lbl_tbl[i].id;
    返 -1;
}
静 整 lbl_reg(常 字 *n) {
    遍 (整 i = 0; i < lbl_n; i++) 若 (!strcmp(lbl_tbl[i].name, n)) 返 lbl_tbl[i].id;
    若 (lbl_n >= 512) 返 -1;
    strcpy(lbl_tbl[lbl_n].name, n);
    lbl_tbl[lbl_n].id = new_label();
    返 lbl_tbl[lbl_n++].id;
}
枚 { EK=0, IK, VK, NK, JK=4, PK=5, MK=6, DK=7, QK=8, WK=9, XK=10, LK=11, RK=12, BK=13, CK=14, SK=15, AK=16, OK=17, KK=18, FK=19, UK=20, GK=21, HK=22, YK=23, ZK=24, PT=25, VR=26, DT=27, AR=28, STR=29, ST=30, LB=31, RB=32, EN=33, BR=34, SW=35, CA=36, DF=37, CL=38, LA=39, LO=40, NT=41, DV=42, MD=43, SH=44, SR=45, AN=46, OR=47, XR=48, BN=49, CN=50, PA=51, MA=52, DA=53, SA=54, OA=55, AA=56, XA=57, SHR=58, SHL=59, QU=60, PP=61, MM=62, DW=63, GT=64, FP=65, MS=66, AL=67, GN=68, AG=69, PIPE=70, QA=71 }; /* AL=_Alignof (fix 2026-08-25 支持矩阵补全 step1); GN=_Generic (step6); AG=_Alignas (fix step21: 携带对齐值, parser 消费); MS=%= (fix 2026-08-05: %= previously lexed as MD+AK → compound-assign never matched); QA=?. 可选链 (接入 2026-08-28) */

