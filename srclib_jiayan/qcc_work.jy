        { 整 d = Nd(7); memcpy((字*)(nn + d), kname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __pk = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 one = Nd(0); nv[one] = 1; Nc(d, one); } Nc(blk, d); } /* int __pi = 1; */
