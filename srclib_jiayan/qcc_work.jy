    遍 (整 i = vs_n() - 1; i >= 0; i--) 若 (!strcmp(vars[i].name, n) && var_codegen_visible(i)) 返 vars[i].p_esz;
    返 0;
}
静 整 var_pdepth(常 字 *n) { /* 指针层级 (char **=2, char ***=3; 0=非指针) fix 2026-08-18 */
