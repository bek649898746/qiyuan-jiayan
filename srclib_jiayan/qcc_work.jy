        { 整 v2 = Nd(1); memcpy((字*)(nn + v2), sname, 32); 整 addr = Nd(11); Nc(addr, v2); Nc(call, addr); }
        { 整 fn = Nd(1); memcpy((字*)(nn + fn), "__qcc_sem_wait", 15); Nc(call, fn); }
        返 call;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "放行")) { /* 接入 2026-08-28 P1 #56: 信号量 V 操作 — 放行 sem; → __qcc_sem_post(&__sem_sem) 原子加许可 */
        tk++; /* 放行 */
        字 sn[64]; strcpy(sn, tn[tk]); tk++;
        若 (tt[tk] == SK) tk++;
        字 sname[80]; sprintf(sname, "__sem_%s", sn);
