                    asm_emit("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,1,0,1); b(0x01); modrm(3,2,3); /* ADD r11d, r10d */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(0, 11);                        /* eax = 新 counter */
                    coff_mov_counter_eax();               /* store back */
                    mov_rr(0, 8);                         /* return 对齐起始 */
                    set_label(lr_done);
                } 否 {
                    /* 单文件自举: 真 realloc (fix 2026-08-20 与 coff 同语义, RIP-relative counter) */
                    整 lr_nok = new_label(), lr_malloc = new_label(), lr_copy = new_label();
                    整 lr_cp = new_label(), lr_cpd = new_label(), lr_done = new_label();
                    test_rr(2, 2); jnz_rel(-1); patch_label(cp - 4, lr_nok, 1);
                    mov_r_imm(2, 1);
                    set_label(lr_nok);
                    test_rr(1, 1); jz_rel(-1); patch_label(cp - 4, lr_malloc, 1);
                    { /* top 检查 (fix 2026-08-22 t45): p + [p-8] == counter */
                    mov_rr(10, 1);                        /* r10d = p */
                    asm_emit("    取32 r10, [r10-8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8B); modrm(1,2,2); b(0xF8); /* r10d = [p-8] */
                    mov_rr(0, 1);                         /* eax = p */
                    asm_emit("    加 r0, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x01); modrm(3,2,0); /* add eax, r10d */
                    mov_rr(11, 0);                        /* r11d = p + old_size */
                    整 rel_t1b = data_rva_base - 0x1000 - cp - 6;
                    mov_eax_rip(rel_t1b);                 /* eax = counter */
                    asm_emit("    比较 r11, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x39); modrm(3,0,3); /* cmp r11d, eax */
                    jnz_rel(-1); patch_label(cp - 4, lr_copy, 1);
                    mov_rr(0, 1);                         /* eax = p */
                    asm_emit("    加 r0, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x01); modrm(3, 2, 0); /* add eax, edx */
                    asm_emit("    加 r0, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x83); modrm(3,0,0); b(7);
                    asm_emit("    与 r0, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x83); modrm(3,4,0); b(0xF8);
                    整 rel_t2 = data_rva_base - 0x1000 - cp - 6;
                    mov_rip_eax(rel_t2);                  /* counter = align(p + n) */
                    mov_rr(0, 1);                         /* eax = p */
                    asm_emit("    存32 [rax-8], edx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,0); b(0x89); modrm(1,2,0); b(0xF8); /* header = n */
                    mov_rr(0, 1);                         /* return p */
                    jmp_rel(-1); patch_label(cp - 4, lr_done, 2);
                    set_label(lr_copy);
                    整 rel_c1 = data_rva_base - 0x1000 - cp - 6;
                    mov_eax_rip(rel_c1);
                    mov_rr(11, 0);                        /* r11d = old counter (对齐) */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(8, 11);                        /* r8d = header */
                    asm_emit("    加 r11, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(8); /* 数据区 */
                    asm_emit("    加 r8, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,0); b(8); /* r8 = 数据区 (拷贝 dst, fix 2026-08-22 t45: 同 coff copy 修复) */
                    mov_rr(11, 8);                        /* r11 = q (保存返回) */
                    mov_rr(10, 2);                        /* r10d = n */
                    mov_rr(0, 11);                        /* eax = q (数据区) */
                    asm_emit("    加 r0, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,2,0,0); b(0x01); modrm(3,2,0); /* ADD eax, r10d */
                    asm_emit("    加 r0, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x83); modrm(3,0,0); b(7);
                    asm_emit("    与 r0, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x83); modrm(3,4,0); b(0xF8);
                    整 rel_c3 = data_rva_base - 0x1000 - cp - 6;
                    mov_rip_eax(rel_c3);                  /* counter = align(q + n) */
                    mov_rr(0, 11);                        /* eax = q */
                    asm_emit("    存32 [rax-8], edx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,0); b(0x89); modrm(1,2,0); b(0xF8); /* [q-8] = n (新 header) */
                    mov_rr(9, 1);                         /* r9 = p (src) */
                    mov_rr(10, 2);                        /* r10d = n (count 初值) */
                    mov_rr(0, 1);                         /* eax = p */
                    asm_emit("    取32 r0, [rax-8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,0); b(0x8B); modrm(1,0,0); b(0xF8); /* eax = 旧size */
                    asm_emit("    比较 r0, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x39); modrm(3,2,0); /* cmp eax, r10d */
                    jge_rel(-1); patch_label(cp - 4, lr_cp, 1); /* 旧>=新 → count=r10 */
                    mov_rr(10, 0);                        /* 旧<新 → count = 旧size */
                    set_label(lr_cp);
                    test_rr(10, 10); jz_rel(-1); patch_label(cp - 4, lr_cpd, 1);
                    asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x8A); modrm(0,0,1); /* mov al, [r9] */
                    asm_emit("    写字节 [r8], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x88); modrm(0,0,0); /* mov [r8], al */
                    asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,0,0,1); b(0xFF); modrm(3,0,0); /* inc r8 */
                    asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(1,0,0,1); b(0xFF); modrm(3,0,1); /* inc r9 */
                    asm_emit("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0xFF); modrm(3,1,2); /* dec r10 */
                    jmp_rel(-1); patch_label(cp - 4, lr_cp, 2);
                    set_label(lr_cpd);
                    mov_rr(0, 11);                        /* return q */
                    jmp_rel(-1); patch_label(cp - 4, lr_done, 2);
                    set_label(lr_malloc);
                    整 rel_m1 = data_rva_base - 0x1000 - cp - 6;
                    mov_eax_rip(rel_m1);                  /* mov eax, [rip+counter] */
                    mov_rr(11, 0);                        /* r11d = old counter (对齐) */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(8, 11);                        /* r8d = 对齐起始 (header) */
                    asm_emit("    加 r11, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(8); /* 数据区 */
                    mov_rr(10, 2);                        /* r10d = size (rdx) */
                    asm_emit("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,1,0,1); b(0x01); modrm(3,2,3); /* ADD r11d, r10d */
                    asm_emit("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,0,3); b(7);
                    asm_emit("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1); b(0x83); modrm(3,4,3); b(0xF8);
                    mov_rr(0, 11);                        /* eax = 新 counter */
                    整 rel_m3 = data_rva_base - 0x1000 - cp - 6;
                    mov_rip_eax(rel_m3);
                    asm_emit("    存32 [r8], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,0); b(0x89); modrm(0,2,0); /* mov [r8], edx — header = size */
                    mov_rr(0, 8);                         /* return header */
                    asm_emit("    加 r0, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x83); modrm(3,0,0); b(8); /* 数据区 */
                    set_label(lr_done);
                    }
                }
            } 否 若 (!strcmp(fname, "free")) {
                mov_r_imm(0, 0);
            } 否 若 (!strcmp(fname, "fclose")) {
                /* fix 2026-08-19: msvcrt fdopen 的 CRT FILE* → 提取 fd@+28 → msvcrt _close(fd)。
                   原 fclose 恒 no-op → close_tempfile_gently 不关锁文件 fd →
                   qcc_rename_impl 的 _unlink(HEAD.lock) 因文件占用失败 → HEAD.lock 残留。
                   coff 模式: fp≥0x10000 (CRT FILE*) 走 _close; fp<0x10000 (qcc fopen HANDLE)
                   或 fp==0 → no-op (无 CloseHandle 导入, 沿用旧行为; self-host 只走此路)。 */
                若 (coff_mode) {
                    整 lfz = new_label();
                    mov_rr64(10, 1); /* r10 = fp (arg0) */
                    test_rr(10, 10); jz_rel(-1); patch_label(cp - 4, lfz, 1);
                    asm_emit("    比较64 r10, 0x10000\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x49); b(0x81); b(0xFA); b4(0x10000); /* cmp r10, 0x10000 */
                    b(0x0F); b(0x82); b4(0); patch_label(cp - 4, lfz, 1); /* jb lfz (HANDLE no-op) */
                    b(0x41); b(0x8B); b(0x42); b(28); /* mov eax, [r10+28] = CRT _file (fd) */
                    mov_rr64(1, 0); /* rcx = fd */
                    sub_rsp_imm(32);
                    b(0xE8); b4(0); coff_crel(cp - 4, 0x0004, coff_func_name_sym("_close"), 0);
                    add_rsp_imm(32);
                    set_label(lfz);
                    mov_r_imm(0, 0); /* return 0 */
                } 否 {
                    mov_r_imm(0, 0); /* no-op (self-host fopen HANDLE 模型) */
                }
            } 否 若 (!strcmp(fname, "fseek")) {
                /* fseek(stream=rcx, offset=rdx, origin=r8): SetFilePointer(handle, offset, NULL, origin)
                   (fix 2026-08-24 t35v: 原 no-op → fseek 不生效 → files_for_each_reflog_ent_reverse 用
                   fseek/ftell 反向读 reflog 全空 → read_ref_at reccnt=0 → rev-parse HEAD@{1} "log is empty";
                   仿 ftell 实现) */
                mov_rr64(10, 1); /* r10 = handle */
                mov_rr64(11, 2); /* r11 = offset (rdx 参数) */
                mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
                sub_rsp_imm(0x30); /* shadow 32 + pad 16 */
                mov_rr64(1, 10); /* rcx = handle */
                mov_rr64(2, 11); /* rdx = offset */
                mov_rr64(9, 8);  /* r9 = origin (先保存, 因 r8 随后被 high 覆盖) */
                mov_ri_ext(8, 0); /* r8 = NULL (lpDistanceToMoveHigh) */
                call_iat(5); /* SetFilePointer */
                add_rsp_imm(0x30);
                mov_rr64(4, 15);
            } 否 若 (!strcmp(fname, "rewind")) {
                /* rewind(stream=rcx) = fseek(stream, 0, SEEK_SET) */
                mov_rr64(10, 1); /* r10 = handle */
                mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0);
                sub_rsp_imm(0x30);
                mov_rr64(1, 10);
                mov_r_imm(2, 0);  /* rdx = 0 */
                mov_ri_ext(8, 0); /* r8 = NULL (high) */
                mov_ri_ext(9, 0); /* r9 = FILE_BEGIN (0) */
                call_iat(5); /* SetFilePointer */
                add_rsp_imm(0x30);
                mov_rr64(4, 15);
            } 否 若 (!strcmp(fname, "ftell")) {
                /* ftell(stream=rcx): SetFilePointer((HANDLE)stream, 0, NULL, FILE_CURRENT) — 返回文件当前位置
                   (fix 2026-08-18: 原恒返回 0 → config do_event offset = 0-1 = -1 → store_aux_event
                   begin/end 全 -1 → store.parsed 垃圾 → git_config_set 写入循环 copy 错位 → .git/config 写坏
                   ("[\n" 开头) → "invalid section name ''" → git init 失败) */
                mov_rr64(10, 1); /* r10 = handle */
                mov_rr64(15, 4); asm_emit("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x48); b(0x83); b(0xE4); b(0xF0); /* and rsp,-16 */
                sub_rsp_imm(0x30); /* shadow 32 + pad 16 */
                mov_rr64(1, 10); /* rcx = handle */
                mov_r_imm(2, 0); /* rdx = 0 (distance to move) */
                mov_ri_ext(8, 0); /* r8 = NULL (no lpDistanceToMoveHigh) */
                mov_ri_ext(9, 1); /* r9 = FILE_CURRENT (1) */
                call_iat(5); /* SetFilePointer */
                add_rsp_imm(0x30);
                mov_rr64(4, 15);
            } 否 若 (!strcmp(fname, "exit")) {
                emit_exit_proc(); /* ExitProcess(rcx) — C exit() must not return */
            } 否 若 (!strcmp(fname, "strcpy") || !strcmp(fname, "strncpy")) {
                mov_rr(10, 8); mov_rr(9, 2); mov_rr(8, 1);
                整 lss3=new_label(), lds3=new_label();
                set_label(lss3);
                test_rr(10,10);jz_rel(-1);patch_label(cp-4,lds3,1);
                asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0x8A);modrm(0,0,1); /* mov al, [r9] */
                asm_emit("    写字节 [r8], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0x88);modrm(0,0,0); /* mov [r8], al */
                asm_emit("    测试al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); b(0x84);b(0xC0);jz_rel(-1);patch_label(cp-4,lds3,1);
                asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,0);
                asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,1);
                asm_emit("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,1,2);
                jmp_rel(-1);patch_label(cp-4,lss3,2);
                set_label(lds3);mov_rr(0,1);
            } 否 若 (!strcmp(fname, "isalpha") || !strcmp(fname, "isalnum")) {
                /* 正确实现: 字母 (isalpha) / 字母数字 (isalnum) 判断
                   (fix 2026-08-18: 原 mov_r_imm(0,1) 恒 true → git config 解析器
                   `if (!isalpha(c)) break` 对 EOF(-1) 不触发 → 空文件/读取失败报
                   "bad config line 1" — 本地 config 从未被正确读取) */
                mov_rr(1, 0); /* ecx = c (cmp 用) */
                /* 大写 A-Z */
                mov_r_imm(0, 'A'); alu_rr(T_QK, 1, 0); setcc_u(T_YK); movzx_eax_al(); mov_rr(10, 0);
                mov_r_imm(0, 'Z'); alu_rr(T_QK, 1, 0); setcc_u(T_HK); movzx_eax_al(); alu_rr(25, 10, 0);
                mov_rr(11, 10); /* r11d = 大写 */
                /* 小写 a-z */
                mov_r_imm(0, 'a'); alu_rr(T_QK, 1, 0); setcc_u(T_YK); movzx_eax_al(); mov_rr(10, 0);
                mov_r_imm(0, 'z'); alu_rr(T_QK, 1, 0); setcc_u(T_HK); movzx_eax_al(); alu_rr(25, 10, 0);
                alu_rr(47, 11, 10); /* r11d |= 小写 */
                若 (!strcmp(fname, "isalnum")) {
                    /* 数字 0-9 */
                    mov_r_imm(0, '0'); alu_rr(T_QK, 1, 0); setcc_u(T_YK); movzx_eax_al(); mov_rr(10, 0);
                    mov_r_imm(0, '9'); alu_rr(T_QK, 1, 0); setcc_u(T_HK); movzx_eax_al(); alu_rr(25, 10, 0);
                    alu_rr(47, 11, 10);
                }
                mov_rr(0, 11); /* eax = 结果 */
            } 否 若 (!strcmp(fname, "tolower")) {
                /* tolower(c): ASCII 大写转小写 (fix 2026-08-18: 原外部 msvcrt tolower 未链接 →
                   恒返 0 → git_config_parse_key 的 store_key 全 0 → is_keys_section 匹配失败
                   → store.seen 空 → git_config_set 写入循环 copy 错位 → .git/config 写坏) */
                mov_rr(1, 0); /* ecx = c (cmp 用) */
                /* 大写标志 r10 = (c>='A') && (c<='Z') */
                mov_r_imm(0, 'A'); alu_rr(T_QK, 1, 0); setcc_u(T_YK); movzx_eax_al(); mov_rr(10, 0);
                mov_r_imm(0, 'Z'); alu_rr(T_QK, 1, 0); setcc_u(T_HK); movzx_eax_al(); alu_rr(25, 10, 0);
                /* 结果 = c + 0x20 * 标志 */
                mov_rr(11, 1); /* r11d = c */
                mov_r_imm(0, 0x20); alu_rr(T_DK, 0, 10); /* eax = 0x20 * flag */
                alu_rr(T_PK, 11, 0); /* r11 += eax */
                mov_rr(0, 11); /* eax = 结果 */
            } 否 若 (!strcmp(fname, "strlen")) {
                mov_rr64(8, 1); /* r8 = ptr (rcx=arg0) — fix 2026-08-22 t45: 原 mov_rr(8,1) 32 位移动 → 高 32 位清零 → strlen(高地址指针) movzx 崩 (git branch used_atom[i].name.buf) */
                mov_r_imm(0, 0); /* eax = 0 (count) */
                整 ls = new_label(), ld = new_label();
                set_label(ls);
                asm_emit("    零扩展 ecx, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0, 0, 0, 1); b(0x0F); b(0xB6); modrm(0, 1, 0); /* movzx ecx,byte[r8] */
                test_rr(1, 1); jz_rel(-1); patch_label(cp-4, ld, 1);
