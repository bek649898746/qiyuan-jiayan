                若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) {
                    整 _c64u_pre = ((expr_is_ll(n0[n]) && expr_is_unsigned(n0[n])) || (expr_is_ll(n1[n]) && expr_is_unsigned(n1[n])) || (expr_is_ll(n0[n]) && expr_is_ll(n1[n]) && (expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n])))) ? 1 : 0; /* fix 2026-08-30 csmith s61: cg 前静态计算 — cg 后 nll/nuns 被传播污染 expr_is_ll 动态结果 → uint32<int64 误判无符号 */
                    cg(n0[n]); ll_ext32(n0[n]); ir_emit(I_PUSH_R64_RAX, 0, 0, 0); ir_flush();
                    cg(n1[n]); ll_ext32(n1[n]); ir_emit(I_MOV_RBX_RAX64, 0, 0, 0); ir_flush();
                    ir_emit(I_CMP64_SETCC, o, _c64u_pre, 0); ir_flush(); /* fix 2026-08-30 csmith s61: 64位比较按 C 整数转换 — int64 能表示 uint32 全值 → 有符号比较 (uint32<int64 原判无符号 → 分支翻转 s61 g_143); uint64 一方 → 无符号 */
                    断;
                }
            }
            若 (o == LA) { /* && short-circuit */
                整 lf = new_label(), le = new_label();
                cg(n0[n]); ir_emit(I_TEST_JZ, lf, 0, 0); ir_flush();
                cg(n1[n]); ir_emit(I_TEST_JZ, lf, 0, 0); ir_flush();
                ir_emit(I_MOV_IMM, 0, 1, 0); ir_emit(I_JMP_LBL, le, 0, 0); ir_flush();
                ir_emit(I_LABEL, lf, 0, 0); ir_emit(I_MOV_IMM, 0, 0, 0); ir_emit(I_LABEL, le, 0, 0); ir_flush();
                断;
            }
            若 (o == LO) { /* || short-circuit (fix 2026-08-15: 原 eager eval 两边, trace2 `!tgt_value || !strcmp(tgt_value,"")` 在 NULL 上 strcmp 崩) */
                整 lt = new_label(), le = new_label();
                cg(n0[n]); ir_emit(I_TEST_JNZ, lt, 0, 0); ir_flush();
                cg(n1[n]); ir_emit(I_TEST_JNZ, lt, 0, 0); ir_flush();
                ir_emit(I_MOV_IMM, 0, 0, 0); ir_emit(I_JMP_LBL, le, 0, 0); ir_flush();
                ir_emit(I_LABEL, lt, 0, 0); ir_emit(I_MOV_IMM, 0, 1, 0); ir_emit(I_LABEL, le, 0, 0); ir_flush();
                断;
            }
            若 (o == T_LK || o == T_GK || o == T_QK || o == T_XK || o == T_HK || o == T_YK) {
                cg(n0[n]); ir_emit(I_PUSH_RAX, 0, 0, 0); ir_flush();
                cg(n1[n]); ir_emit(I_CMP_SETCC32, o, (expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n])) ? 1 : 0, 0); ir_flush();
                断;
            }
            /* pointer arithmetic: `ptr + int` scales the int by the element size
               (int *p: p+1 → +4; char *s: s+1 → +1; char *names[]: +8).
               `ptr - ptr` divides the byte difference by the element size
               (fix 2026-08-05: was p - q*esz → garbage). */
            整 pscale = 0;
            整 psub_div = 0; /* 指针-指针: (p-q) 再除以元素大小 */
            若 (o == PK || o == T_MK) {

                /* (T*)ptr ± N: cast 元素大小优先 (fix 2026-08-19); 变量/数组名/成员
                   指针统一走 node_psz (fix 2026-08-20: 成员 p->field 原不识别 →
                   d.entries+1 步进 1 字节; prune_directory dir->nr=dst-dir->entries 算错) */
                整 lpsz = node_psz(n0[n]);
                若 (lpsz > 0) {
                    pscale = lpsz;
                    若 (o == T_MK) {
                        整 rpsz = node_psz(n1[n]);
                        若 (getenv("QCC_DBG_NS")) fprintf(stderr, "[PSUB] o=%d lpsz=%d rpsz=%d lnt=%d rnt=%d\n", o, lpsz, rpsz, nt[n0[n]], nt[n1[n]]); /* tmp diag */
                        若 (rpsz == pscale) { psub_div = pscale; pscale = 0; } /* p - q 同元素指针 → 除元素大小 */
                    }
                }
            }
            若 (pscale <= 1 && psub_div <= 1 && o != T_SR && o != T_DV && o != T_MD) { /* Phase3-IR: 32位无缩放/除路径 */
                cg(n0[n]); ir_emit(I_PUSH_RAX, 0, 0, 0); ir_flush();
                cg(n1[n]); ir_emit(I_ALU_RBX, o, 0, 0); ir_flush();
            } 否 {
            cg(n0[n]); ir_emit(I_PUSH_RAX, 0, 0, 0); ir_flush();
            cg(n1[n]); ir_emit(I_POP_RBX, 0, 0, 0); ir_flush();
            若 (pscale > 1) { ir_emit(I_IMUL32_SCALE, pscale, 0, 0); ir_flush(); }
            整 uns = 0;
            若 (o == T_SR) uns = expr_is_unsigned(n0[n]); /* unsigned >> → SHR (fix 2026-08-05) */
            否 若 (o == T_DV || o == T_MD) uns = expr_is_unsigned(n0[n]) || expr_is_unsigned(n1[n]); /* fix 2026-08-06 M1 */
            ir_emit(I_ALU_RBX_RES, o, uns, 0); ir_flush();
