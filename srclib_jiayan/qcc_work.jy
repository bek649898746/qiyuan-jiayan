                遍 (整 ti2 = save_tk; ti2 < tk; ti2++) 若 (tt[ti2] == VK && !strcmp(tn[ti2], "double")) g_is_double = 1;
                若 (!g_is_double) { 整 tdi = tdef_lookup(tn[save_tk]); 若 (tdi >= 0 && tdefs[tdi].is_dbl) g_is_double = 1; } /* typedef double alias */
                整 g_is_ll = 0; /* 全局 long long：8 字节 .data 槽（fix 2026-08-05） */
                遍 (整 ti2 = save_tk; ti2 + 1 < tk; ti2++) 若 (tt[ti2] == VK && !strcmp(tn[ti2], "long") && tt[ti2 + 1] == VK && !strcmp(tn[ti2 + 1], "long")) g_is_ll = 1;
                整 g_is_fnptr = 0, g_fptr_dbl = 0; /* typedef'd fnptr 全局：8 字节 .data 槽（C 原版 2895 移植） */
                { 整 tdi = tdef_lookup(tn[save_tk]); 若 (tdi >= 0 && tdefs[tdi].is_fnptr) { g_is_fnptr = 1; g_fptr_dbl = tdefs[tdi].fnptr_dbl; } }
                循环 (1) {
                    整 lead_ptr = 0;
                    循环 (tt[tk] == DK) { lead_ptr = 4; tk++; } /* leading * �?pointer */
                    若 (tt[tk] != VR || tt[tk + 1] == OK) { tk = save_tk; 断; }
                    字 gname[32]; strcpy(gname, tn[tk]); tk++;
                    /* char* -> esz 1 (byte indexing); int* -> 4; char** -> 8 via
                       the ptr-depth in the loop below (keep the LAST depth's char flag) */
                    整 pesz = lead_ptr ? (g_is_char ? 1 : 4) : 0;
                    整 ptrd = lead_ptr ? 1 : 0;
                    循环 (tt[tk] == DK) { 若 (g_is_char) pesz = 1; 否 pesz = 4; ptrd++; tk++; }
                    若 (ptrd > 1 && g_is_char) pesz = 8; /* char** -> 8-byte elements */
                    整 gcnt = 0; /* array element count (0 = not array) */
                    整 gfirst = 0; /* first dimension (row count) */
                    整 gdims[8]; 遍 (整 gdi = 0; gdi < 8; gdi++) gdims[gdi] = 0; 整 gdim_n = 0; /* 每维大小 → frows（fix 2026-08-05: 全局 3D 数组无 frows → 嵌套 scale 回退标量） */
                    循环 (tt[tk] == LB) {
                        tk++;
                        若 (tt[tk] == NK) {
                            若 (gcnt == 0) { gfirst = tv[tk]; gcnt = 1; }
                            gcnt *= tv[tk];
                            若 (gdim_n < 8) { gdims[gdim_n] = tv[tk]; gdim_n++; }
                            tk++;
                        }
                        若 (tt[tk] == RB) tk++;
                    }
                    /* fix 2026-08-05: unsized GLOBAL array `整 a[] = {1,2,3}` / `字 *names[] = {...}`
                       → infer count from the brace init list */
                    若 (gcnt == 0 && tt[tk] == AK && tt[tk + 1] == FK) {
                        整 save = tk;
                        tk += 2; /* skip '=' '{' */
                        整 n = 1;
                        整 depth = 0;
                        循环 (tk < TS && !(tt[tk] == UK && depth == 0)) {
                            若 (tt[tk] == FK || tt[tk] == OK || tt[tk] == LB) depth++;
                            否 若 (tt[tk] == UK || tt[tk] == KK || tt[tk] == RB) depth--;
                            否 若 (tt[tk] == CK && depth == 0) n++;
                            tk++;
                        }
                        gcnt = n; gfirst = n;
                        tk = save; /* rewind to '=' */
                    }
                    若 (gcnt > 0) {
                        若 (g_is_fnptr) {
                            /* typedef'd fnptr 数组：8 字节指针元素（C 原版 2919） */
                            var_static_arr(gname, 0, 8, gcnt);
                            vars[vcnt - 1].p_esz = 8;
                            若 (g_fptr_dbl) vars[vcnt - 1].p_dbl = 1;
                        } 否 若 (g_stidx >= 0) {
                            /* struct-typed array var: struct B globals[N]; */
                            var_static_struct(gname, g_stidx, gcnt);
                        } 否 {
                            /* multi-dim: the first index's element is the inner array (row). e.g.
                               char str_tbl[512][512] -> arr_esz=512 so str_tbl[i] yields a row
                               pointer (case-14 esz>4 path returns the ADDRESS, no deref). */
                            整 g_esz = g_is_char ? 1 : (g_is_double ? 8 : 4); /* ELEMENT byte size (slots) */
                            若 (ptrd > 0) g_esz = 8; /* pointer-typed array (char *names[3]): 8-byte elements */
                            var_static_arr(gname, pesz, g_esz, gcnt);
                            vars[vcnt - 1].p_esz = g_esz; /* element byte size for outer [j] scale / 64-bit load */
                            若 (gfirst > 0 && gcnt > gfirst && ptrd <= 0) vars[vcnt - 1].arr_esz = gcnt / gfirst * g_esz; /* 2D+: ROW byte size */
                            若 (gdim_n >= 1) { vars[vcnt - 1].frows[gdim_n - 1] = g_esz; 遍 (整 fi = gdim_n - 2; fi >= 0; fi--) vars[vcnt - 1].frows[fi] = vars[vcnt - 1].frows[fi + 1] * gdims[fi + 1]; } /* 3D per-dim rows（fix 2026-08-05） */
                            若 (g_is_double) vars[vcnt - 1].is_dbl = 1; /* global double array */
                        }
                    }
                    否 若 (g_is_fnptr) { var_static(gname, 4); vars[vcnt - 1].arr_esz = 8; 若 (g_fptr_dbl) vars[vcnt - 1].p_dbl = 1; } /* typedef'd fnptr var: 8-byte .data slot */
                    否 若 (g_stidx >= 0) var_static_struct(gname, g_stidx, 1); /* struct var */
                    否 若 (g_is_ll) { var_static(gname, 4); vars[vcnt - 1].is_ll = 1; } /* 全局 long long：8 字节 .data 槽（fix 2026-08-05） */
                    否 若 (g_is_double) { var_static(gname, 4); vars[vcnt - 1].is_dbl = 1; } /* global double: 8-byte .data slot */
                    否 var_static(gname, pesz);
                    若 (tt[tk] == AK) { /* = init */
                        若 (ginit_n >= 4096) { fprintf(stderr, "[ERR] 全局初始化器超过 4096 上限 (fix 2026-08-06)\n"); exit(1); }
                        tk++;
                        若 (tt[tk] == FK && g_stidx >= 0) { /* struct G g = { a, b, c }; — brace init */
                            tk++;
                            整 idn = Nd(1); memcpy((字*)(nn + idn), gname, 32);
                            整 blkinit = brace_fields(g_stidx, idn);
                            若 (tt[tk] == UK) tk++;
                            若 (ginit_n < 4096) ginit[ginit_n++] = blkinit; /* the block IS the initializer */
                        } 否 若 (tt[tk] == FK && gcnt > 0 && ginit_n < 4096) {
                            /* 全局数组初始化（含多维嵌套）：garr[N] = { a, b, c }; / 整 m[2][2][2] = {{{1,2},{3,4}},...}
                               → brace_arr_init 展开 garr[i][j][k]=...（fix 2026-08-05: 扁平循环遇嵌套 '{{' 崩 → main 未被解析） */
                            整 blk = Nd(5);
                            整 idn = Nd(1); memcpy((字*)(nn + idn), gname, 32);
                            遍 (整 i = 0; i < 8; i++) gi_idx[i] = 0;
                            str_row = 0; /* 字符串初始化行计数器（fix 2026-08-05） */
                            brace_arr_init(blk, idn, gdims, gdim_n > 0 ? gdim_n : 1, 0); /* 自管 { } 配平 */
                            若 (ginit_n < 4096) ginit[ginit_n++] = blk;
                        } 否 若 (ginit_n < 4096) {
                            整 decl = Nd(7); memcpy((字*)(nn + decl), gname, 32);
                            Nc(decl, expr());
                            ginit[ginit_n++] = decl;
                        } 否 {
                            循环 (tk < TS && tt[tk] != SK && tt[tk] != CK && tt[tk] != EK) tk++;
                        }
                    }
                    若 (tt[tk] == CK) { tk++; 续; } /* comma �?next var */
                    断;
                }
                若 (tk > save_tk) { 若 (tt[tk] == SK) tk++; 续; }
            } 否 {
                tk = save_tk;
            }
        }
        /* __attribute__((...)) �?skip balanced parens */
        若 (tt[tk] == VR && !strcmp(tn[tk], "__attribute__")) {
            tk++;
            整 depth = 0;
            循环 (tk < TS && tt[tk] != EK) {
                若 (tt[tk] == OK) depth++;
                否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                tk++;
            }
            续;
        }
        /* function definition */
        整 fn_ret_dbl = 0;
        循环 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "double")) fn_ret_dbl = 1; tk++; } /* skip type keywords, catch double return */
        整 fn_ret_si = -1; /* struct return type index (sret candidates) */
        若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { fn_ret_si = st_find(tn[tk]); tk++; } } /* struct return type: struct B *fn(...) */
        否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; }
        否 若 (tt[tk] == VR && td_is(tn[tk])) { 整 tdx = tdef_lookup(tn[tk]); 若 (tdx >= 0 && tdefs[tdx].is_dbl && !tdefs[tdx].is_struct) fn_ret_dbl = 1; tk++; } /* typedef double return */
        否 若 (tt[tk] == VR && tt[tk + 1] == VR && tt[tk + 2] == OK) { tk++; } /* 未知返回类型(time_t 等)——当 int 处理。C 原版 2026-08-03 修复：跳过未知类型名，下一个 VR+OK 才是函数名。BOM 文件首标识符(EF BB BF+int 连成一 token)也被此分支跳过 */
        若 (tt[tk] == VK) tk++; /* skip 2nd keyword */
        循环 (tt[tk] == DK) tk++; /* skip pointer(s) * */
        整 fdef = Nd(4);
        整 fn_ok = 0, fdef_is_fnptr_ret = 0;
        若 (tt[tk] == VR && tt[tk + 1] == OK) { /* fn name must be followed by ( */
            memcpy((字*)(nn + fdef), tn[tk], 32); tk++; tk++;
            fn_ok = 1;
        } 否 若 (tt[tk] == OK && tt[tk + 1] == DK) { /* fnptr: int (*pick(int v))(int) or int (*gfp)(int); */
            tk++; tk++; /* skip ( * */
            若 (tt[tk] == VR && tt[tk + 1] == OK) { /* name ( — fnptr-returning FUNCTION definition */
                memcpy((字*)(nn + fdef), tn[tk], 32); tk++; /* name */
                tk++; /* skip ( of the param list */
                fn_ok = 1; fdef_is_fnptr_ret = 1;
            } 否 若 (tt[tk] == VR && tt[tk + 1] == KK) { /* name ) — global fnptr VARIABLE: int (*gfp)(int); */
                字 vn[32]; strcpy(vn, tn[tk]); tk += 2; /* name ) */
                若 (tt[tk] == OK) { /* skip the arg-type list ( ... ) */
                    整 depth = 0;
                    循环 (tk < TS && tt[tk] != EK) {
                        若 (tt[tk] == OK) depth++;
                        否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                        tk++;
                    }
                }
                若 (tt[tk] == SK) tk++; /* ; */
                var_static(vn, 4); /* 8-byte .data slot (fnptr = pointer) */
                vars[vcnt - 1].arr_esz = 8; /* fnptr: *gfp loads 8 bytes */
                若 (fn_ret_dbl) vars[vcnt - 1].p_dbl = 1; /* double-returning fnptr: gfp(x) yields xmm0 */
                续;
            }
        }
        若 (fn_ok) {
            整 tfi = func_find((字*)(nn + fdef)); /* register return type BEFORE parsing params */
            func_tbl[tfi].ret_si = fn_ret_si;
            fn_ret_si_map[tfi] = fn_ret_si; /* survives gen_code's func_n=0 reset */
            fn_ret_name_put((字*)(nn + fdef), fn_ret_si); /* name-keyed: survives func_tbl index renumbering */
            fn_dbl_set_ret((字*)(nn + fdef), fn_ret_dbl); /* double-return routing (xmm0) */
            cur_fn_sret = (fn_ret_si >= 0 && stypes[fn_ret_si].sz > 8); /* Win64: hidden sret ptr in rcx */
            fvb[fvn] = vcnt; /* record var-range start (before params) */
fr_start[fvn] = rsp_used; /* record frame-bound start: pure frame footprint before params */
            parse_base = fvb[fvn]; /* scope body-local decl lookups to THIS function */
            整 pr = 0;
            循环 (tt[tk] != KK && tt[tk] != SK && tt[tk] != UK && tt[tk] != EK && pr < 256) {
                整 pis_char = 0, pis_ptr = 0, ptr_depth = 0, p_stidx = -1, pis_dbl = 0;
                整 p_fptr = 0, p_fptr_dbl = 0; /* typedef'd fnptr 参数：8 字节指针槽（C 原版 3045 移植） */
                整 pis_uns = 0; /* unsigned 参数: >> 逻辑 (fix 2026-08-05) */
                整 pis_ll = 0; /* long long 参数: 8 字节槽（fix 2026-08-05） */
                若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "char")) pis_char = 1; 否 若 (!strcmp(tn[tk], "double")) pis_dbl = 1; 否 若 (!strcmp(tn[tk], "unsigned")) pis_uns = 1; 否 若 (!strcmp(tn[tk], "long")) pis_ll = 1; tk++; }
                否 若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) { p_stidx = st_find(tn[tk]); tk++; } } /* struct B *arr: remember struct type */
                否 若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; }
                否 若 (tt[tk] == VR && (td_is(tn[tk]) || st_find(tn[tk]) >= 0)) { 整 tdx = tdef_lookup(tn[tk]); 若 (tdx >= 0 && tdefs[tdx].is_dbl && !tdefs[tdx].is_struct) pis_dbl = 1; 若 (tdx >= 0 && tdefs[tdx].is_fnptr) { p_fptr = 1; p_fptr_dbl = tdefs[tdx].fnptr_dbl; } p_stidx = st_find(tn[tk]); tk++; } /* typedef'd struct / double alias / fnptr */
                若 (tt[tk] == VK) { 若 (!strcmp(tn[tk], "char")) pis_char = 1; 否 若 (!strcmp(tn[tk], "double")) pis_dbl = 1; 否 若 (!strcmp(tn[tk], "unsigned")) pis_uns = 1; 否 若 (!strcmp(tn[tk], "long")) pis_ll = 1; tk++; } /* 2nd keyword */
                若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++; /* 3rd keyword of unsigned long long（fix 2026-08-06） */
                循环 (tt[tk] == DK) { pis_ptr = 1; ptr_depth++; tk++; } /* pointer(s) * */
                若 (tt[tk] == OK && tt[tk + 1] == DK) { /* function pointer param: int (*fp)(int,int) */
                    tk++; tk++; /* skip ( * */
                    若 (tt[tk] == VR) {
                        var_param(tn[tk], pr, 4, 8, -1, 0, 0); /* fnptr: 8-byte pointer slot, 8-byte element (*fp loads 64-bit) */
                        若 (pis_dbl) vars[vcnt - 1].p_dbl = 1; /* double-returning fnptr param: fp(x) yields xmm0 */
                        tk++; pr++;
                    }
                    若 (tt[tk] == KK) tk++; /* skip ) closing (*fp) */
                    若 (tt[tk] == OK) { /* skip the arg-type list ( ... ) */
                        整 depth = 0;
                        循环 (tk < TS && tt[tk] != EK) {
                            若 (tt[tk] == OK) depth++;
                            否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                            tk++;
                        }
                    }
                    续;
                }
                若 (tt[tk] == VR) {
                    若 (p_fptr) { /* typedef'd fnptr 参数：fp_t cb —— 8 字节指针槽（C 原版 3071 移植） */
                        var_param(tn[tk], pr, 4, 8, -1, 0, 0);
                        若 (p_fptr_dbl) vars[vcnt - 1].p_dbl = 1;
                        tk++; pr++;
                        循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 若 (tt[tk] == RB) tk++; } /* skip [N] */
                        若 (tt[tk] == CK) tk++;
                        若 (tt[tk] == DT) { 循环 (tt[tk] == DT) tk++; } /* variadic ellipsis */
                        续;
                    }
                    整 esz = 0;
                    若 (p_stidx >= 0) esz = stypes[p_stidx].sz;     /* struct / struct* param: element size = struct size */
                    否 若 (pis_dbl && ptr_depth > 0) esz = 8;       /* double* / double**: 8-byte elements */
                    否 若 (pis_char) esz = ptr_depth > 1 ? 8 : 1;   /* char* , char** */
                    否 若 (ptr_depth > 1) esz = 8;             /* int** */
                    否 若 (ptr_depth > 0) esz = 4;             /* int* */
                    若 (tt[tk + 1] == LB) { /* array param: int arr[4]; / char *argv[] — decays to a pointer */
                        pis_ptr = 1;
                        若 (esz == 0) esz = 4; /* element size for arr[i] scaling */
                    }
                    var_param(tn[tk], pr, pis_ptr ? 4 : 0, esz, p_stidx, pis_dbl && !pis_ptr, pis_ll && !pis_ptr); /* double* is a POINTER (rcx), not an xmm double */
                    若 (pis_char && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_char = 1; /* sizeof(char 参数) (fix 2026-08-05) */
                    若 (pis_uns && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_uns = 1; /* unsigned 参数: >> 逻辑 (fix 2026-08-05) */
                    若 (pis_ll && !pis_ptr && p_stidx < 0) vars[vcnt - 1].is_ll = 1; /* long long 参数: 8 字节槽（fix 2026-08-05） */
                    若 (pis_dbl && pis_ptr) vars[vcnt - 1].p_dbl = 1; /* double* param */
                    fn_dbl_put((字*)(nn + fdef), pr, pis_dbl && !pis_ptr); /* caller routes scalar doubles to xmm */
                    tk++; pr++;
                    循环 (tt[tk] == LB) { tk++; 若 (tt[tk] == NK) tk++; 若 (tt[tk] == RB) tk++; } /* skip [N] */
                }
                若 (tt[tk] == CK) tk++;
                若 (tt[tk] == DT) { 循环 (tt[tk] == DT) tk++; } /* variadic ellipsis ... (dots lex as DT) */
            }
            若 (tt[tk] == SK) { tk++; 续; } /* no-paren decl misparsed as fn: static unsigned char *code; */
            tk++; /* skip ) */
            若 (fdef_is_fnptr_ret) { /* fnptr-return: skip ) closing (*pick) and the trailing (int) before the body */
                若 (tt[tk] == KK) tk++;
                若 (tt[tk] == OK) {
                    整 depth = 0;
                    循环 (tk < TS && tt[tk] != EK) {
                        若 (tt[tk] == OK) depth++;
                        否 若 (tt[tk] == KK) { depth--; 若 (depth <= 0) { tk++; 断; } }
                        tk++;
                    }
                }
            }
            若 (tt[tk] == SK) { tk++; 续; } /* function prototype: register name, no body; call sites auto-register */
            Nc(fdef, blk());
            若 (fvn >= 512) { fprintf(stderr, "[ERR] 函数体表超过 512 上限 (fix 2026-08-06 M9)\n"); exit(1); }
            fve[fvn] = vcnt; fvn++; /* record var-range end; order == root attach order */
            fr_end[fvn - 1] = rsp_used; /* frame-bound end (vars only; statics inside the body don't touch rsp_used) */
            parse_base = 0; /* back to file scope for the next top-level item */
            Nc(p, fdef);
        } 否 { 断; }
    }
    返 p;
}

/* ?????? ??????: AST ??x86-64 machine code ?????? */
静 空 cg(整 n);
静 空 cgc(整 n);
静 空 cg_f(整 n); /* emit xmm0 = double value of expr n */

/* xmm0 = double value of an expression (float var/literal/arith, or int→cvtsi2sd) */
静 空 cg_f(整 n) {
    若 (n < 0) 返;
    整 t = nt[n];
    若 (t == 1) { /* identifier */
        字 *vn = (字*)(nn + n);
        整 off = var_lookup(vn);
        若 (var_is_dbl(vn)) {
            若 (var_isstatic(vn)) { asm_emit("    浮取静 xmm0, [rip+%d]\n", (字*)(长)(整)(stc_disp(off) - 2), 0, 0); movsd_xmm0_rip(stc_disp(off) - 2); } /* static double via RIP (8-byte movsd: stc_disp is 6-byte-based) */
            否 movsd_xmm0_mbrp(off - cur_frame_sz);
        } 否 {
            mov_reg_mbrp(0, off - cur_frame_sz); /* int var → eax */
            cvtsi2sd_xmm0_eax();
        }
        返;
    }
    若 (t == FP) { cg(n); 返; } /* FP literal → movsd xmm0 (cg case-FP) */
    若 (t == 0) { cg(n); cvtsi2sd_xmm0_eax(); 返; } /* int imm → convert */
    若 (t == 4) { /* function call: double-returning callee leaves xmm0; int callee → convert */
        字 *cfn = NULL;
        遍 (整 i = 19; i >= 0; i--) { 整 c = child_i(n, i); 若 (c >= 0 && nt[c] == 1) { cfn = (字*)(nn + c); 断; } }
        cg(n); /* emits the call */
        若 (cfn && fn_dbl_get_ret(cfn)) { /* known double-returning callee: xmm0 already holds it */
        } 否 若 (ndbl[n]) { /* marked double call (incl. fnptr): leave xmm0 as-is */
        } 否 cvtsi2sd_xmm0_eax();
        返;
    }
    若 (t == 2) { /* binary */
        整 o = nv[n];
        若 (ndbl[n0[n]] || ndbl[n1[n]]) { /* floating sub-expr */
            cg_f(n0[n]); push_xmm0();
            cg_f(n1[n]); movsd_xmm1_xmm0(); pop_xmm0();
            若 (o == PK) addsd_xmm0_xmm1();
            否 若 (o == MK) subsd_xmm0_xmm1();
            否 若 (o == DK) mulsd_xmm0_xmm1();
            否 若 (o == DV) divsd_xmm0_xmm1();
            返;
        }
        cg(n); cvtsi2sd_xmm0_eax();
        返;
    }
    若 (t == 15) { /* member: double field x.d → movsd; int field → convert */
        字 *vn = (字*)(nn + n0[n]);
        整 off = var_lookup(vn);
        整 si = var_stidx(vn);
        整 fo = si >= 0 ? st_off(stypes[si].name, (字*)(nn + n)) : -1;
        若 (fo >= 0 && st_field_is_dbl(stypes[si].name, (字*)(nn + n))) {
            若 (nv[n] == 1) { /* ptr->field: load pointer, +fo, deref */
                若 (off >= 0) { 若 (var_pesz(vn) > 0) mov_reg_mbrp64(0, off - cur_frame_sz); 否 mov_reg_mbrp(0, off - cur_frame_sz); }
                若 (fo != 0) add_rax_imm8(fo);
                b(0xF2); b(0x0F); b(0x10); modrm(0,0,0); /* movsd xmm0, [rax] */
            } 否 {
                movsd_xmm0_mbrp(off - stypes[si].sz + fo - cur_frame_sz);
            }
            返;
        }
    }
    若 (ndbl[n]) { cg(n); 返; } /* double node (array elem/var/field/call): cg leaves result in xmm0 */
    cg(n); cvtsi2sd_xmm0_eax(); /* fallback */
}

