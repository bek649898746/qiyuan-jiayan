/* parse-time double-expression predicate (root-cause 2026-08-03): `(int)expr` cast
   creation relied on ndbl[ce], which for a double-returning CALL is only set at
   CODEGEN (case-4) — so `(int)dadd(2.5,3.5)` was a NO-OP at parse, the call stayed
   double-typed, and printf %d read the raw xmm0 low bits (0). Detect double-ness
   here at parse: ndbl covers FP/double-var/double-member/double-binary; calls need
   the callee signature (mirror of case-4 ndbl logic). */
静 整 expr_is_double(整 n) {
    
    若 (n < 0) 返 0;
    若 (ndbl[n]) 返 1;
    若 (nt[n] == 1) {
        字 *vn2 = (字*)(nn + n);
        若 (var_arrsz(vn2) != 0) 返 0; /* 数组名衰减为地址, 不是 double 值 (fix 2026-08-25 step15: double 数组名 var_is_dbl=true → (char*)arr+n 走浮点加法 → 基址丢失; 同 L4319 ndbl 守卫) */
        返 var_is_dbl(vn2) ? 1 : 0;
    } /* fix 2026-08-25 bug#27: double 变量标识符 (原 ndbl 未设置 → 0-v1 走整数路径 → 负 double 全错) */
    若 (nt[n] == 4) { /* function call */
        整 fn = n0[n];
        若 (fn < 0) 返 0;
        若 (nt[fn] == 1) { /* named callee: function or fnptr var */
            字 *cfn = (字*)(nn + fn);
            若 (fn_dbl_get_ret(cfn)) 返 1; /* known double-returning function */
            若 (var_pdbl(cfn)) 返 1;       /* double-returning fnptr variable */
            返 0;
        }
        若 (nt[fn] == 12) fn = n0[fn]; /* (*fp): deref decays to the pointer var */
        若 (nt[fn] == 1) 返 var_pdbl((字*)(nn + fn)) ? 1 : 0;
        { 整 bn = arr_base_node(fn); /* expression callee (tbl[i], arr[i].f): base's p_dbl */
          若 (bn >= 0 && nt[bn] == 1 && var_pdbl((字*)(nn + bn))) 返 1; }
    }
    返 0;
}

静 整 Nd(整 t) { 若 (nc >= ASZ) { fprintf(stderr, "[ERR] AST overflow (%d) (fix 2026-08-17 审计: 满则硬退, 绝不返 -1 — 原返 -1 调用方 nv[-1] 越界写)\n", ASZ); exit(1); } 整 i = nc++; nt[i] = t; nv[i] = 0; n0[i] = n1[i] = n2[i] = n3[i] = n4[i] = n5[i] = n6[i] = n7[i] = n8[i] = n9[i] = n10[i] = n11[i] = n12[i] = n13[i] = n14[i] = n15[i] = n16[i] = n17[i] = n18[i] = n19[i] = n20[i] = n21[i] = n22[i] = n23[i] = n24[i] = n25[i] = n26[i] = n27[i] = n28[i] = n29[i] = n30[i] = n31[i] = n32[i] = n33[i] = n34[i] = n35[i] = n36[i] = n37[i] = n38[i] = n39[i] = n40[i] = n41[i] = n42[i] = n43[i] = n44[i] = n45[i] = n46[i] = n47[i] = n48[i] = n49[i] = n50[i] = n51[i] = n52[i] = n53[i] = n54[i] = n55[i] = n56[i] = n57[i] = n58[i] = n59[i] = n60[i] = n61[i] = n62[i] = n63[i] = n64[i] = n65[i] = n66[i] = n67[i] = n68[i] = n69[i] = n70[i] = n71[i] = n72[i] = n73[i] = n74[i] = n75[i] = n76[i] = n77[i] = n78[i] = n79[i] = n80[i] = n81[i] = n82[i] = n83[i] = n84[i] = n85[i] = n86[i] = n87[i] = n88[i] = n89[i] = n90[i] = n91[i] = n92[i] = n93[i] = n94[i] = n95[i] = n96[i] = n97[i] = n98[i] = n99[i] = n100[i] = n101[i] = n102[i] = n103[i] = n104[i] = n105[i] = n106[i] = n107[i] = n108[i] = n109[i] = n110[i] = n111[i] = n112[i] = n113[i] = n114[i] = n115[i] = n116[i] = n117[i] = n118[i] = n119[i] = n120[i] = n121[i] = n122[i] = n123[i] = n124[i] = n125[i] = n126[i] = n127[i] = n128[i] = n129[i] = n130[i] = n131[i] = n132[i] = n133[i] = n134[i] = n135[i] = n136[i] = n137[i] = n138[i] = n139[i] = n140[i] = n141[i] = n142[i] = n143[i] = n144[i] = n145[i] = n146[i] = n147[i] = n148[i] = n149[i] = n150[i] = n151[i] = n152[i] = n153[i] = n154[i] = n155[i] = n156[i] = n157[i] = n158[i] = n159[i] = n160[i] = n161[i] = n162[i] = n163[i] = n164[i] = n165[i] = n166[i] = n167[i] = n168[i] = n169[i] = n170[i] = n171[i] = n172[i] = n173[i] = n174[i] = n175[i] = n176[i] = n177[i] = n178[i] = n179[i] = n180[i] = n181[i] = n182[i] = n183[i] = n184[i] = n185[i] = n186[i] = n187[i] = n188[i] = n189[i] = n190[i] = n191[i] = n192[i] = n193[i] = n194[i] = n195[i] = n196[i] = n197[i] = n198[i] = n199[i] = n200[i] = n201[i] = n202[i] = n203[i] = n204[i] = n205[i] = n206[i] = n207[i] = n208[i] = n209[i] = n210[i] = n211[i] = n212[i] = n213[i] = n214[i] = n215[i] = n216[i] = n217[i] = n218[i] = n219[i] = n220[i] = n221[i] = n222[i] = n223[i] = n224[i] = n225[i] = n226[i] = n227[i] = n228[i] = n229[i] = n230[i] = n231[i] = n232[i] = n233[i] = n234[i] = n235[i] = n236[i] = n237[i] = n238[i] = n239[i] = n240[i] = n241[i] = n242[i] = n243[i] = n244[i] = n245[i] = n246[i] = n247[i] = n248[i] = n249[i] = n250[i] = n251[i] = n252[i] = n253[i] = n254[i] = n255[i] = -1; pesz[i] = 0; nchain[i] = -1; 返 i; } /* fix 2026-08-18: 新节点溢出链指针初始 -1 */
静 空 Nc(整 p, 整 c);
静 整 expr(空);
/* Brace initializer: walk struct si's fields, consuming values from the token
   stream ({ a, b, c }) and emitting assignments against the base expression
   (a Nd(1) var or a Nd(15) nested-member node). Nested struct fields recurse;
   array fields expand per element. Returns a block of assignment nodes. */
静 整 brace_fields(整 si, 整 base) {
    整 blk = Nd(5);
    整 fidx = 0;
    /* C99 aggregate init zeroes every member not explicitly initialized. qcc only
       emitted the listed fields, so `struct strvec blank = STRVEC_INIT` left nr/alloc
       as stack garbage and strvec_clear looped over a garbage count. Zero all scalar
       fields first; the explicit initializer below then overwrites the listed ones.
       (fix 2026-08-15 git_jiayan --version crash in strvec_clear) */
    遍 (整 z = 0; z < stypes[si].fn; z++) {
        整 fty = stypes[si].ftypes[z];
        整 fsz = stypes[si].fsizes[z];
        整 frow = stypes[si].frows[z];
        若 ((fty >= 0 && stypes[fty].sz == fsz) || (frow > 0 && fsz > frow)) {
            /* nested struct/array field: memset(&base.field, 0, fsz) — 设计化初始化器未覆盖的
               嵌套字段必须清零 (C 语义; fix 2026-08-19: REV_INFO_INIT 的 prune_data 等嵌套字段
               原跳过 → 垃圾 → setup_revisions 读垃圾 nr → status 崩) */
            字 zf[64]; memset(zf, 0, 64); strcpy(zf, stypes[si].fnames[z]); /* 2026-08-28 编译DAG: memset 清零 — strcpy 尾部栈垃圾 → memcpy(nn,zf,32) 使 nn 哈希非确定 */
            整 zmem = Nd(15); memcpy((字*)(nn + zmem), zf, 32); nv[zmem] = 0;
            Nc(zmem, base);
            整 zaddr = Nd(11); Nc(zaddr, zmem); /* &base.field */
            整 zcall = Nd(4);
            整 zcallee = Nd(1); memcpy((字*)(nn + zcallee), "memset", 7);
            Nc(zcall, zaddr);                       /* arg0 = &field */
            整 zz = Nd(0); nv[zz] = 0; Nc(zcall, zz); /* arg1 = 0 */
            整 zsz = Nd(0); nv[zsz] = fsz; Nc(zcall, zsz); /* arg2 = fsz */
            Nc(zcall, zcallee);                     /* callee LAST */
            Nc(blk, zcall);
            续; /* nested struct/array: not scalar */
        }
        字 fname[64]; strcpy(fname, stypes[si].fnames[z]);
        整 mem = Nd(15); memcpy((字*)(nn + mem), fname, 32); nv[mem] = 0;
        Nc(mem, base);
        整 zero = Nd(0); nv[zero] = 0;
        整 asgn = Nd(10); Nc(asgn, mem); Nc(asgn, zero); Nc(blk, asgn);
    }
    循环 (tt[tk] != UK && tt[tk] != EK) { /* until } — fidx may exceed fn for out-of-order designators (fix 2026-08-05) */
        若 (tt[tk] == CK || tt[tk] == SK) { tk++; 续; } /* skip comma between values */
        若 (tt[tk] == UK) 断;
        若 (tt[tk] == DT && tt[tk + 1] == VR) { /* designated initializer: .field = expr */
            tk++; /* . */
            字 fld[64]; strcpy(fld, tn[tk]); tk++; /* field name */
            若 (tt[tk] == AK) tk++; /* = */
            整 tgt = -1;
            遍 (整 j = 0; j < stypes[si].fn; j++) 若 (!strcmp(stypes[si].fnames[j], fld)) { tgt = j; 断; }
            若 (tgt < 0) { 整 _bd = 0; 循环 (tk < TS && tt[tk] != EK) { 若 (tt[tk] == FK) _bd++; 否 若 (tt[tk] == UK) { 若 (_bd == 0) 断; _bd--; 若 (_bd == 0) { tk++; 断; } } 否 若 (tt[tk] == CK && _bd == 0) 断; tk++; } 续; } /* fix 2026-08-16 根因G: 未知字段跳过需花括号配平且 _bd=0 的 } 是外层闭合(不消费) — 原遇任意 UK 就停(嵌套 {2} 截断) → 元素边界错乱 → 数组层 leaf 死循环 */
            fidx = tgt; /* jump to the designated field (may go BACK) */
            /* fix 2026-08-19: 嵌套设计器链 .field.member = val — 设计器分支只设 fidx 就 continue,
               loop-top 会把 .member 当外层字段查 → tgt<0 → 吞掉 (REV_INFO_INIT 的 .pruning.flags.recursive
               等嵌套设计器失效 → rev_info 未初始化 → status 崩)。沿链直走: .in.x → 下钻到最内层字段,
               expr() 取末值, 自然停在顶层逗号 (不能用 brace_fields 递归 — 会吞掉后续逗号字段)。 */
            若 (tt[tk] == DT && stypes[si].ftypes[tgt] >= 0 &&
                stypes[si].fsizes[tgt] == stypes[stypes[si].ftypes[tgt]].sz) {
                整 nf = stypes[si].ftypes[tgt];
                整 nmem = Nd(15); memcpy((字*)(nn + nmem), stypes[si].fnames[tgt], 32); nv[nmem] = 0;
                Nc(nmem, base);
                循环 (tt[tk] == DT && tt[tk + 1] == VR) {
                    tk++; /* . */
                    字 subf[64]; memset(subf, 0, 64); strcpy(subf, tn[tk]); tk++; /* member — 2026-08-28 编译DAG: memset 清零 (同 zf/vn, 栈缓冲尾部不置零 → memcpy(32) 拷垃圾 → nn 哈希非确定) */
                    若 (tt[tk] == AK) tk++; /* = */
                    整 subt = -1;
                    若 (nf >= 0) 遍 (整 j = 0; j < stypes[nf].fn; j++) 若 (!strcmp(stypes[nf].fnames[j], subf)) { subt = j; 断; }
                    若 (subt < 0) { 整 _bd = 0; 循环 (tk < TS && tt[tk] != EK) { 若 (tt[tk] == FK) _bd++; 否 若 (tt[tk] == UK) { 若 (_bd == 0) 断; _bd--; 若 (_bd == 0) { tk++; 断; } } 否 若 (tt[tk] == CK && _bd == 0) 断; tk++; } 断; }
                    整 nmem2 = Nd(15); memcpy((字*)(nn + nmem2), subf, 32); nv[nmem2] = 0;
                    Nc(nmem2, nmem);
                    nmem = nmem2;
                    nf = (subt >= 0) ? stypes[nf].ftypes[subt] : -1; /* 下钻: 若成员是标量 (fty=-1) 链到此为止 */
                    若 (tt[tk] == AK) tk++; /* = */
                }
                整 asgn = Nd(10); Nc(asgn, nmem); Nc(asgn, expr()); Nc(blk, asgn);
                续;
            }
            /* fix 2026-08-16 根因G: 成员设计器链 .value.update = {...} — 当前字段是匿名 union/struct 8字节近似 (无类型链接无法下钻), 后续 .member 段整体 opaque 消费 (原下一轮 loop-top 设计器分支把 .update 当本层字段查 → tgt<0 → 边界错乱 → 数组层 leaf 死循环 AST 溢出 merged_test.c) */
            若 (tt[tk] == DT && stypes[si].ftypes[fidx] < 0 && stypes[si].fsizes[fidx] == 8 && stypes[si].frows[fidx] == 8) {
                整 _bd = 0;
                循环 (tk < TS && tt[tk] != EK) {
                    若 (tt[tk] == FK) _bd++;
                    否 若 (tt[tk] == UK) { 若 (_bd == 0) 断; _bd--; 若 (_bd == 0) { tk++; 断; } } /* _bd=0 的 } 是外层闭合(元素结束, 不消费); 值自身的 } 使 _bd 1→0 消费后停 (fix 2026-08-16: 原把元素闭合也消费 → 边界错乱) */
                    否 若 (tt[tk] == CK && _bd == 0) 断;
                    tk++;
                }
            }
            续;
        }
        若 (fidx >= stypes[si].fn) { 整 _tk0 = tk; expr(); 若 (tk == _tk0) { 循环 (tk < TS && tt[tk] != CK && tt[tk] != SK && tt[tk] != UK && tt[tk] != EK) tk++; } /* expr 未推进 → 手动跳分隔符 (fix 2026-08-16: color.c attrs[] sizeof("..")-1 漏 ) 卡 KK → fidx 空转 2^31 溢出 INT_MIN 越界崩) */ fidx++; 续; } /* all fields consumed: drop extra values */
        字 fname[64]; strcpy(fname, stypes[si].fnames[fidx]);
        整 fty = stypes[si].ftypes[fidx];
        整 fsz2 = stypes[si].fsizes[fidx];
        整 frow2 = stypes[si].frows[fidx];
        整 mem = Nd(15); memcpy((字*)(nn + mem), fname, 32); nv[mem] = 0;
        Nc(mem, base);
        /* fix 2026-08-07: 指针字段 (ftype=指向的 struct, 但 fsz=8 ≠ struct size) 不递归 —
           自引用结构体 struct LNode { int v; struct LNode *next; } 的 next 若递归 → 无限递归死循环 */
        整 fty_is_ptr = (fty >= 0 && stypes[fty].sz != fsz2);
        若 (fty >= 0 && !fty_is_ptr) { /* nested struct field */
            若 (tt[tk] == FK) { /* explicit nested braces { ... }: recurse into fields */
                tk++;
                整 sub = brace_fields(fty, mem);
                若 (tt[tk] == UK) tk++; /* skip closing } */
                遍 (整 k = 0; k < 256; k++) { 整 c = child_i(sub, k); 若 (c > 0) Nc(blk, c); }
            } 否 若 (tt[tk] == DT) { /* 成员设计器链 .value.update = {...}: 递归进嵌套 struct 处理 (fix 2026-08-16 根因G: merged_test.c .value.update = { .old_hash = { 2 }, .name = "..." } — 原 expr() 卡 DT 不推进 → 元素边界错乱 → 数组层 leaf 死循环 AST 溢出) */
                整 sub = brace_fields(fty, mem);
                若 (tt[tk] == UK) tk++; /* skip closing } */
                遍 (整 k = 0; k < 256; k++) { 整 c = child_i(sub, k); 若 (c > 0) Nc(blk, c); }
            } 否 { /* struct VALUE expr (e.g. .needle = *want): copy whole struct (fix 2026-08-14: 原递归 brace_fields 误把 *want 当字段 → 死循环/崩溃) */
                整 ev = expr();
                整 asgn = Nd(10); Nc(asgn, mem); Nc(asgn, ev); Nc(blk, asgn);
            }
        } 否 若 (frow2 > 0 && fsz2 > frow2) { /* array field: per element */
            整 nfield = fsz2 / frow2;
            整 open_brace = (tt[tk] == FK); /* explicit array braces { a, b } (fix 2026-08-14: 原不消费 { → expr() 卡 FK 死循环) */
            若 (open_brace) tk++;
            遍 (整 ei = 0; ei < nfield; ei++) {
                若 (tt[tk] == CK || tt[tk] == SK) tk++;
                若 (tt[tk] == UK || tt[tk] == EK) 断;
                整 eidx = ei;
                若 (tt[tk] == LB) { /* [idx] = value 指定下标 (fix 2026-08-14: .colors = { [GREP_COLOR_CONTEXT] = "..." } 原 [ 无分支 → expr() 返回 -1 死循环/崩溃) */
                    tk++;
                    若 (tt[tk] == NK) { eidx = tv[tk]; tk++; }
                    否 若 (tt[tk] == VR) { 整 evc = e_lookup(tn[tk]); 若 (evc == 0x80000000) evc = macro_find(tn[tk]); 若 (evc != 0x80000000 && evc != -1) eidx = evc; tk++; }
                    若 (tt[tk] == RB) tk++;
                    若 (tt[tk] == AK) tk++;
                }
                整 acc = Nd(14); Nc(acc, mem);
                整 idx = Nd(0); nv[idx] = eidx; Nc(acc, idx);
                整 asgn = Nd(10); Nc(asgn, acc); Nc(asgn, expr()); Nc(blk, asgn);
            }
            若 (open_brace) { 循环 (tt[tk] == CK || tt[tk] == SK) tk++; 若 (tt[tk] == UK) tk++; } /* skip matching } (trailing comma inside array braces) */
        } 否 若 (tt[tk] == FK) { /* opaque nested brace (union field .u = { ... } 且 fty=-1): 跳过配平 (fix 2026-08-14: expr() 遇 { 崩溃) */
            整 d2 = 1; tk++;
            循环 (tk < TS && d2 > 0) { 若 (tt[tk] == FK) d2++; 否 若 (tt[tk] == UK) { d2--; 若 (d2 <= 0) { tk++; 断; } } tk++; }
        } 否 若 (fty < 0 && fsz2 == 8 && frow2 == 8 && tt[tk] == DT) { /* 匿名 union/struct 8字节近似的成员设计器链 (防御: 正常路径由设计器分支 blob-consumer 处理) */
            整 _bd = 0;
            循环 (tk < TS && tt[tk] != EK) {
                若 (tt[tk] == FK) _bd++;
                否 若 (tt[tk] == UK) { 若 (_bd == 0) 断; _bd--; 若 (_bd == 0) { tk++; 断; } }
                否 若 (tt[tk] == CK && _bd == 0) 断;
                tk++;
            }
        } 否 { /* scalar field */
            整 ev = expr();
            整 asgn = Nd(10); Nc(asgn, mem); Nc(asgn, ev); Nc(blk, asgn);
        }
        fidx++;
    }
    返 blk;
}

静 整 kw(常 字 *s) {
    /* 甲言中文关键字已在 lexer 改写成英文 (tn), 此处只认英文 */
    若 (!strcmp(s, "struct") || !strcmp(s, "union")) 返 ST; /* union shares the struct machinery (offset-0 fields) */
    若 (!strcmp(s, "extern")) 返 VK;
    若 (!strcmp(s, "static")) 返 VK; /* treat as type modifier */
    若 (!strcmp(s, "const")) 返 VK;
    若 (!strcmp(s, "volatile")) 返 VK; /* 类型修饰符（fix 2026-08-06: 内核 MMIO 需要; 当普通 VK 跳过, 语义同 int） */
    若 (!strcmp(s, "restrict")) 返 VK; /* C99 类型修饰符 (优化提示; qcc 无优化器, 忽略语义正确 — fix 2026-08-25 支持矩阵补全) */
    若 (!strcmp(s, "_Atomic")) 返 VK; /* C11 类型修饰符 (单线程下当普通类型, 无原子语义 — fix 2026-08-25 支持矩阵补全) */
    若 (!strcmp(s, "void")) 返 VK;
    若 (!strcmp(s, "FILE") || !strcmp(s, "long")) 返 VK; /* builtin types used by self-host */
    若 (!strcmp(s, "enum")) 返 EN;
    若 (!strcmp(s, "return")) 返 RK;
    若 (!strcmp(s, "if")) 返 IK;
    若 (!strcmp(s, "else")) 返 ZK;
    若 (!strcmp(s, "while")) 返 WK;
    若 (!strcmp(s, "do")) 返 DW;
    若 (!strcmp(s, "goto")) 返 GT;
    若 (!strcmp(s, "for")) 返 JK;
    若 (!strcmp(s, "break")) 返 BR;
    若 (!strcmp(s, "continue")) 返 CN;
    若 (!strcmp(s, "switch")) 返 SW;
    若 (!strcmp(s, "case")) 返 CA;
    若 (!strcmp(s, "default")) 返 DF;
    若 (!strcmp(s, "signed")) 返 VK; /* fix 2026-08-15: signed char const cq_lookup[] — signed 未识别为关键字 */
    若 (!strcmp(s, "unsigned")) 返 VK;
    若 (!strcmp(s, "int") || !strcmp(s, "double")) 返 VK;
    若 (!strcmp(s, "char")) 返 VK;
    若 (!strcmp(s, "_Bool")) 返 VK;
    若 (!strcmp(s, "inline")) 返 VK;
    若 (!strcmp(s, "short")) 返 VK; /* fix 2026-08-06: short 缺词法分类 → struct 字段被当标识符注册成幻影字段, 布局错乱 (回归测试 regress_struct_align 暴露) */
    若 (!strcmp(s, "void")) 返 VK;
    若 (!strcmp(s, "sizeof")) 返 BK;
    若 (!strcmp(s, "_Alignof")) 返 AL; /* C11 对齐查询 (fix 2026-08-25 支持矩阵补全 step1) */
    若 (!strcmp(s, "_Noreturn")) 返 VK; /* C11 函数修饰符 (fix 2026-08-25 支持矩阵补全 step2: 函数定义 VK 循环自然跳过) */
    若 (!strcmp(s, "_Generic")) 返 GN; /* C11 泛型选择 (fix 2026-08-25 支持矩阵补全 step6) */
    返 NK;
}

/* C11 _Alignof: 解析 (类型) 返回对齐值 — 与 sizeof 同族但语义不同 (fix 2026-08-25 支持矩阵补全 step1) */
静 整 alignof_type(空) {
    整 al = 4; /* default: int 对齐 */
    若 (tt[tk] == VK) { /* 基本类型 (含 unsigned/signed/long 修饰符链) */
        整 lc = 0;
        遍 (;;) {
            若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { al = 1; tk++; }
            否 若 (!strcmp(tn[tk], "short")) { al = 2; tk++; }
            否 若 (!strcmp(tn[tk], "long")) { lc++; al = (lc >= 2) ? 8 : 4; tk++; }
            否 若 (!strcmp(tn[tk], "double")) { al = 8; tk++; }
            否 若 (!strcmp(tn[tk], "unsigned") || !strcmp(tn[tk], "signed") || !strcmp(tn[tk], "int") || !strcmp(tn[tk], "void")) { tk++; }
            否 断;
        }
        循环 (tt[tk] == DK) { al = 8; tk++; } /* 指针 → 8 */
    } 否 若 (tt[tk] == ST) { /* struct/union: 用 st_field_sz_r 维护的最大对齐 algn */
        tk++;
        若 (tt[tk] == VR) {
            整 si = st_find(tn[tk]);
            若 (si >= 0 && (stypes[si].fn > 0 || stypes[si].sz > 0)) al = stypes[si].algn; /* 已定义结构体用最大对齐 (全 char 结构 algn=1 也是真值); 前向声明保持默认 */
            tk++;
        }
    } 否 若 (tt[tk] == EN) { /* enum → int 对齐 4 */
        tk++; 若 (tt[tk] == VR) tk++;
    } 否 若 (tt[tk] == VR) { /* typedef 名 */
        整 tdi = tdef_lookup(tn[tk]);
        若 (tdi >= 0) {
            若 (tdefs[tdi].is_struct) {
                整 si = st_find(tdefs[tdi].st_name);
                若 (si >= 0 && (stypes[si].fn > 0 || stypes[si].sz > 0)) al = stypes[si].algn;
            } 否 {
                整 tsz = tdefs[tdi].sz;
                若 (tsz >= 8) al = 8; 否 若 (tsz >= 4) al = 4; 否 若 (tsz >= 2) al = 2; 否 al = 1;
            }
        }
        tk++;
    }
    循环 (tt[tk] == LB) { /* 数组 T[N]: 对齐=元素对齐(已算), 消费 [N] */
        tk++;
        若 (tt[tk] == NK || tt[tk] == VR) tk++;
        若 (tt[tk] == RB) tk++;
    }
    返 al;
}

/* _Generic 控制表达式类型判定 (fix 2026-08-25 step6): 0=int 1=char 2=short 3=ll 4=double 5=uns 6=ptr 7=struct 8=other */
静 整 expr_type_of(整 n) {
    若 (n < 0) 返 8;
    整 t = nt[n];
    若 (t == FP) 返 4; /* double literal */
    若 (t == 0) { 若 (pesz[n] > 0) 返 6; 若 (ndbl[n]) 返 4; 若 (nll[n]) 返 3; 若 (nuns[n]) 返 5; 返 0; } /* int literal — fix 2026-08-27 特性#5: LL 字面量节点标记是 nll[n] (原 tll[n] 是 lexer token 数组, 恒 0 → 42LL 选成 int); fix 2026-08-27 特性#concepts: ndbl[n] → (double)0 cast 后字面量节点判 double; pesz[n]>0 → (T*)0 cast 后字面量判指针 */
    若 (t == 1) {
        字 *vn = (字*)(nn + n);
        若 (var_is_dbl(vn)) 返 4;
        若 (var_is_ll(vn)) 返 3;
        若 (var_is_uns(vn)) 返 5;
        若 (var_is_char(vn)) 返 1;
        若 (var_is_short(vn)) 返 2;
        若 (var_pesz(vn) > 0) 返 6;   /* pointer */
        若 (var_arrsz(vn) > 0) 返 6; /* fix 2026-08-27 特性#5: 数组名衰减为指针 (_Generic 匹配 char* 分支) */
        若 (var_stidx(vn) >= 0) 返 7; /* struct var */
        返 0;
    }
    若 (t == 4) { /* call: callee 节点 n0 是函数名 */
        整 cal = n0[n]; 若 (cal < 0) 返 8;
        字 *fn = (字*)(nn + cal);
        若 (fn_dbl_get_ret(fn) || fn_math_iat(fn) >= 0 || ext_fn_ret(fn) == 2) 返 4;
        若 (fn_ll_get_ret(fn) || ext_fn_ret(fn) == 1) 返 3;
        返 0;
    }
    若 (t == 19) { 若 (pesz[n] > 0) 返 6; 若 (ndbl[n]) 返 4; 若 (nll[n]) 返 3; 若 (nuns[n]) 返 5; 返 0; } /* cast — fix 2026-08-27 特性#concepts: ndbl[n] → (double) cast 判 double; pesz[n]>0 → (T*) cast 判指针 */
    若 (t == 10) 返 expr_type_of(n0[n]); /* assign: lhs 类型 */
    若 (t == 14) 返 expr_type_of(n0[n]); /* arr[i]: 元素类型 (近似) */
    若 (t == 2) { /* binop 结果类型 */
        整 op = nv[n];
        若 (op == LA || op == LO || op == T_QK || op == T_XK || op == T_LK || op == T_GK || op == T_HK || op == T_YK) 返 0; /* 比较/逻辑 → int */
        若 (op == T_SR || op == T_SH) 返 expr_type_of(n0[n]); /* 移位: 左操作数 */
        整 r1 = expr_type_of(n0[n]), r2 = expr_type_of(n1[n]);
        若 (r1 == 4 || r2 == 4) 返 4;
        若 (r1 == 3 || r2 == 3) 返 3;
        若 (r1 == 5 || r2 == 5) 返 5;
        若 (r1 == 6 || r2 == 6) 返 6;
        返 0;
    }
    返 8;
}
/* _Generic 关联类型解析 → 同上 id; -1 解析失败 */
静 整 gen_type_id(空) {
    若 (tt[tk] == DK) { 循环 (tt[tk] == DK) tk++; 返 6; } /* 指针 */
    若 (tt[tk] == VK) {
        若 (!strcmp(tn[tk], "int")) { tk++; 若 (tt[tk] == DK) { 循环 (tt[tk] == DK) tk++; 返 6; } 返 0; }
        若 (!strcmp(tn[tk], "char") || !strcmp(tn[tk], "_Bool")) { tk++; 若 (tt[tk] == DK) { 循环 (tt[tk] == DK) tk++; 返 6; } 返 1; }
        若 (!strcmp(tn[tk], "short")) { tk++; 若 (tt[tk] == DK) { 循环 (tt[tk] == DK) tk++; 返 6; } 返 2; }
        若 (!strcmp(tn[tk], "double")) { tk++; 若 (tt[tk] == DK) { 循环 (tt[tk] == DK) tk++; 返 6; } 返 4; }
        若 (!strcmp(tn[tk], "long")) { tk++; 若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++; 若 (tt[tk] == DK) { 循环 (tt[tk] == DK) tk++; 返 6; } 返 3; }
        若 (!strcmp(tn[tk], "unsigned")) { tk++; 若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++; 若 (tt[tk] == VK && !strcmp(tn[tk], "long")) tk++; 若 (tt[tk] == DK) { 循环 (tt[tk] == DK) tk++; 返 6; } 返 5; }
        若 (!strcmp(tn[tk], "void")) { tk++; 返 8; }
        若 (!strcmp(tn[tk], "const") || !strcmp(tn[tk], "volatile") || !strcmp(tn[tk], "restrict")) { tk++; 返 gen_type_id(); } /* 限定符跳过 */
        tk++; 返 8; /* 其他 VK */
    }
    若 (tt[tk] == ST) { tk++; 若 (tt[tk] == VR) tk++; 返 7; } /* struct */
    若 (tt[tk] == EN) { tk++; 若 (tt[tk] == VR) tk++; 返 0; } /* enum → int */
    若 (tt[tk] == VR) { /* typedef */
        整 tdi = tdef_lookup(tn[tk]);
        若 (tdi >= 0) {
            若 (tdefs[tdi].is_struct) { tk++; 返 7; }
            若 (tdefs[tdi].is_dbl) { tk++; 返 4; }
            若 (tdefs[tdi].sz == 8) { tk++; 返 3; }
            若 (tdefs[tdi].sz == 1) { tk++; 返 1; }
            若 (tdefs[tdi].sz == 2) { tk++; 返 2; }
        }
        tk++;
        返 8;
    }
    返 -1;
}

静 空 lex(常 字 *s) {
    整 i = 0; ti = 0; tk = 0; 整 unknown_chars = 0; 整 cur_line = 1; /* fix 2026-08-05: 未知字符计数, lex 结束汇报; 接入 2026-08-28: 行号追踪 (tline[ti]=cur_line) */
    循环 (s[i] && ti < TS) {
        循环 (s[i] == ' ' || s[i] == '\n' || s[i] == '\t' || s[i] == '\r' || s[i] == '\f' || s[i] == '\v') { 若 (s[i] == '\n') cur_line++; i++; } /* fix 2026-08-13 Phase3: \f/\v 是合法空白 — 漏掉会落入 switch default 发射 tt=0(EK) 幽灵 token, 中间截断 parse (regex_internal.c 第40行 \f); 接入 2026-08-28: 数换行更新 cur_line */
        若 (!s[i]) 断;
        若 (if_skip && s[i] != '#') { 若 (s[i] == '/' && s[i + 1] == '*') { i += 2; 循环 (s[i] && !(s[i] == '*' && s[i + 1] == '/')) { 若 (s[i] == '\n') cur_line++; i++; } 若 (s[i]) i += 2; 续; } /* fix 2026-08-26 cpython: 跳过区内块注释整体跳到闭合符 — pyconfig.h 注释里含条件指令示例文本, 逐行跳过会把注释内容当真指令 → 条件栈失衡 → 守卫 endif 关错层; 接入 2026-08-28: 块注释内换行数 cur_line (loc.line 精确) */ 循环 (s[i] && s[i] != '\n') i++; 续; } /* false branch: skip whole code lines (fix 2026-08-05) */
        若 (s[i] == '/' && s[i + 1] == '/') { 循环 (s[i] && s[i] != '\n') i++; 续; }
        若 (s[i] == '/' && s[i + 1] == '*') { i += 2; 循环 (s[i] && !(s[i] == '*' && s[i + 1] == '/')) { 若 (s[i] == '\n') cur_line++; i++; } 若 (s[i]) i += 2; 续; } /* 接入 2026-08-28: 块注释内换行数 cur_line (loc.line 精确) */
        若 (s[i] == '#') { /* #define NAME VALUE / #include / conditional compilation (fix 2026-08-05: #ifdef/#ifndef/#if/#elif/#else/#endif) */
            整 d = i + 1; 循环 (s[d] == ' ' || s[d] == '\t') d++; /* fix 2026-08-13 Phase3: # 后空白 (glibc 缩进指令 #  define) */
            整 is_def = !strncmp(s + d, "define", 6) && (s[d + 6] == 0 || s[d + 6] == ' ' || s[d + 6] == '\t' || s[d + 6] == '\r' || s[d + 6] == '\n');
            整 is_ifdef = !strncmp(s + d, "ifdef", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            整 is_ifndef = !strncmp(s + d, "ifndef", 6) && (s[d + 6] == 0 || s[d + 6] == ' ' || s[d + 6] == '\t' || s[d + 6] == '\r' || s[d + 6] == '\n');
            整 is_if = !strncmp(s + d, "if", 2) && !is_ifdef && !is_ifndef && (s[d + 2] == 0 || s[d + 2] == ' ' || s[d + 2] == '\t' || s[d + 2] == '\r' || s[d + 2] == '\n');
            整 is_elif = !strncmp(s + d, "elif", 4) && (s[d + 4] == 0 || s[d + 4] == ' ' || s[d + 4] == '\t' || s[d + 4] == '\r' || s[d + 4] == '\n');
            整 is_else = !strncmp(s + d, "else", 4) && (s[d + 4] == 0 || s[d + 4] == ' ' || s[d + 4] == '\t' || s[d + 4] == '\r' || s[d + 4] == '\n');
            整 is_endif = !strncmp(s + d, "endif", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            整 is_undef = !strncmp(s + d, "undef", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            整 is_error = !strncmp(s + d, "error", 5) && (s[d + 5] == 0 || s[d + 5] == ' ' || s[d + 5] == '\t' || s[d + 5] == '\r' || s[d + 5] == '\n');
            若 (is_if || is_ifdef || is_ifndef || is_elif || is_else || is_endif) {
                整 parent = if_skip;
                字 expr[512]; 整 ei = 0;
                若 (is_if || is_elif) {
                    整 p = d;
                    若 (is_if) p += 2; 否 p += 4;
                    循环 (s[p] == ' ' || s[p] == '\t') p++;
                    循环 (s[p] && ei < 510) { 若 (s[p] == '\\' && (s[p + 1] == '\n' || (s[p + 1] == '\r' && s[p + 2] == '\n'))) { p += (s[p + 1] == '\r' ? 3 : 2); expr[ei++] = ' '; 续; } 若 (s[p] == '\n') 断; expr[ei++] = s[p++]; } /* fix 2026-08-26 redis: #if/#elif 表达式反斜杠续行 (atomicvar.h `#elif ... && \` 跨 3 行 — 原只读首行 → 条件残缺 → #error) */
                    循环 (ei > 0 && (expr[ei-1] == ' ' || expr[ei-1] == '\t')) ei--; /* trim trailing (fix 2026-08-05: "#if VER > 1" left "VER " → macro lookup failed) */
                }
                expr[ei] = 0;
                整 cond = 0;
                若 (is_ifdef || is_ifndef) { /* #ifdef NAME / #ifndef NAME — read macro name straight from s[] */
                    字 nm[64]; 整 ni = 0;
                    整 p = d + (is_ifdef ? 5 : 6);
                    循环 (s[p] == ' ' || s[p] == '\t') p++;
                    循环 (isalnum(s[p]) || s[p] == '_' || ((无 字)s[p] >= 0x80)) { 若 (ni < 63) nm[ni++] = s[p]; p++; }
                    nm[ni] = 0;
                    整 def = macro_exists(nm); /* fix 2026-08-06: 原 macro_find>=0 对负值宏判假 */
                    cond = is_ifdef ? def : !def;
                } 否 若 (is_if || is_elif) {
                    cond = pp_eval(expr);
                }
                若 (is_if || is_ifdef || is_ifndef) {
                    若 (if_n < 64) {
                        if_parent_skip[if_n] = parent;
                        若 (is_if || is_ifdef || is_ifndef) { if_taken[if_n] = cond && !parent; if_skip = parent || !cond; }
                        if_n++;
                    }
                } 否 若 (is_elif) {
                    若 (if_n > 0) {
                        若 (!if_taken[if_n - 1] && !if_parent_skip[if_n - 1]) { if_taken[if_n - 1] = cond; if_skip = if_parent_skip[if_n - 1] || !cond; }
                        否 if_skip = 1;
                    }
                } 否 若 (is_else) {
                    若 (if_n > 0) {
                        若 (!if_taken[if_n - 1] && !if_parent_skip[if_n - 1]) { if_taken[if_n - 1] = 1; if_skip = if_parent_skip[if_n - 1]; }
                        否 if_skip = 1;
                    }
                } 否 若 (is_endif) {
                    若 (if_n > 0) { if_n--; if_skip = if_n > 0 ? !if_taken[if_n - 1] : 0; } /* fix 2026-08-13 Phase3: 原 if_parent_skip[if_n-1] 是父级 skip — 嵌套假分支弹出时误清 skip (regex_internal.h #ifdef RE_ENABLE_I18N 假分支内嵌 #ifdef _LIBC 弹出后 struct 体泄漏) */
                }
                循环 (s[i] && s[i] != '\n') { 若 (s[i] == '\\' && s[i + 1] == '\n') i += 2; 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') i += 3; 否 i++; } /* skip directive line */
                续;
            }
            若 (if_skip) { /* in a false branch: skip all lines (incl. #define/#include) until the matching #endif/#elif/#else */
                循环 (s[i] && s[i] != '\n') { 若 (s[i] == '\\' && s[i + 1] == '\n') i += 2; 否 若 (s[i] == '\\' && s[i + 1] == '\r' && s[i + 2] == '\n') i += 3; 否 i++; }
                续;
            }
            若 (is_undef) { /* #undef NAME — 从三个宏表删除（fix 2026-08-05） */
                整 p = d + 5;
                循环 (s[p] == ' ' || s[p] == '\t') p++;
                字 un[64]; 整 ui = 0;
                循环 (isalnum(s[p]) || s[p] == '_' || ((无 字)s[p] >= 0x80)) { 若 (ui < 63) un[ui++] = s[p]; p++; }
                un[ui] = 0;
                若 (ui > 0) macro_remove(un);
