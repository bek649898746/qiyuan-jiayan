                    整 _e = _b;
                    循环 (_e > 0 && (isalnum((无 字)seg[_e - 1]) || seg[_e - 1] == '_')) _e--;
                    字 _pw[64]; 整 _pl = _b - _e + 1; 若 (_pl < 63) { memcpy(_pw, seg + _e, _pl); _pw[_pl] = 0; } 否 _pw[0] = 0;
                    若 (!strcmp(_pw, "int") || !strcmp(_pw, "void") || !strcmp(_pw, "char") || !strcmp(_pw, "double") || !strcmp(_pw, "long") || !strcmp(_pw, "short") || !strcmp(_pw, "unsigned") || !strcmp(_pw, "const") || !strcmp(_pw, "FILE")) _is_decl = 1; /* fix 2026-08-14: 去掉 static/extern — 它们是存储类不是类型, static GIT_PATH_FUNC(...) 宏生成函数被误判声明不展开 → 参数 STR 卡死 */
                    若 (!_is_decl) { /* struct Tag *fn(...) / union U *fn(...) / enum E *fn(...) 返回类型 (fix 2026-08-15: mingw.c getpwuid 定义被 getpwuid stub 宏破坏) */
                        整 _s = _e; 循环 (_s > 0 && (seg[_s - 1] == ' ' || seg[_s - 1] == '\t' || seg[_s - 1] == '\r' || seg[_s - 1] == '\n')) _s--;
                        整 _u = _s; 循环 (_u > 0 && (isalnum((无 字)seg[_u - 1]) || seg[_u - 1] == '_')) _u--;
                        字 _pw2[16]; 整 _pl2 = _s - _u; 若 (_pl2 < 15) { memcpy(_pw2, seg + _u, _pl2); _pw2[_pl2] = 0; } 否 _pw2[0] = 0;
                        若 (!strcmp(_pw2, "struct") || !strcmp(_pw2, "union") || !strcmp(_pw2, "enum")) _is_decl = 1;
                    }
                }
                若 (_is_decl) { 若 (*o + ni + 1 > *cap) { *cap *= 2; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; } 遍 (整 k = 0; k < ni; k++) out[(*o)++] = nm[k]; 续; }
                整 in_stack = 0; 遍 (整 s = 0; s < fn_exp_n; s++) 若 (fn_exp_stack[s] == fmi) { in_stack = 1; 断; } /* fix 2026-08-13: 展开栈 — 互递归 A→B→A 防重入 (原 self_fmi 只防直接自递归) */
                若 (in_stack) { /* 已在展开栈: 保留函数调用 (C 蓝色油漆语义) */
                    若 (*o + ni + 1 > *cap) { *cap *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *outp = realloc(out, *cap); 若 (!*outp) { fprintf(stderr, "[ERR] OOM realloc\n"); exit(1); } out = *outp; }
