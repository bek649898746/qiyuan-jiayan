    n252 = _va_alloc(ASZ * 4); n253 = _va_alloc(ASZ * 4); n254 = _va_alloc(ASZ * 4); n255 = _va_alloc(ASZ * 4);

    code = malloc(CODE_BUF_CAP); cc = IMAGE_BASE; cp = 0; lc = 0; /* 4MB 预分配（C 原版 5469）：直接传常量给 malloc，cc 单独赋值——qcc 对 `cc=N;malloc(cc)` 会丢 cc 全局写 */
    sdc = 256; sdat = malloc(sdc); sdp = 0; strpn = 0;
    memset(str_offs, -1, 1024 * 4);;

    整 root = parse(src);
    若 (root < 0) { fprintf(stderr, "qcc_x86: parse failed\n"); 返 1; }
    root_global = root;
    parse_dbl_n = dbl_n; /* negate 会在 codegen 新增 double；两遍从 parse 后起点一致 */


    /* two-pass generation: pass 1 estimates text size �?.data base; pass 2 real */
    g_lc_save = lc; g_rsp_save = rsp_used;
    data_rva_base = 0x2000;
    asm_pass = 1;
    gen_code();
    data_rva_base = (0x1000 + cp + 4095) & ~4095;
    若 (data_rva_base < 0x2000) data_rva_base = 0x2000;
    asm_pass = 2;
    gen_final = 0;
    gen_code();
    /* fix 2026-08-05: pass-2 code can GROW past the pass-1 estimate (data-ref
       encodings shift with the .data base), rounding text past data_rva_base →
       .text/.data overlap → ERROR_BAD_EXE_FORMAT 193. Recompute the base from
       the pass-2 cp and re-generate until stable. Intermediate passes are
       silent (gen_final=0) so the -S asm file holds exactly one code copy. */
    遍 (整 it = 0; it < 8; it++) {
        整 nb = (0x1000 + cp + 4095) & ~4095;
        若 (nb < 0x2000) nb = 0x2000;
        若 (nb == data_rva_base) 断;
        data_rva_base = nb;
        gen_code();
    }
    gen_final = 1;
    gen_code();
    gen_final = 0;
    asm_pass = 0;

    /* ??PE */
    FILE *f = fopen(outf, "wb");
    若 (!f) { fprintf(stderr, "qcc_x86: cannot write %s\n", outf); 返 1; }
    write_pe(f, entry_rva_global);
    fclose(f);
    若 (asm_out) { fclose(asm_out); asm_out = 0; }

    若 (asm_mode) { printf("OK: %s + %s.asm (%d bytes code)\n", outf, outf, cp); } 否 { printf("OK: %s (%d bytes code)\n", outf, cp); }
    返 0;
}