                整 z2 = Nd(0); nv[z2] = 0;
                整 notm = Nd(2); nv[notm] = T_QK; Nc(notm, v_m); Nc(notm, z2); /* __sm == 0 */
                整 andn2 = Nd(2); nv[andn2] = LA; Nc(andn2, notm); Nc(andn2, cmp); /* !已匹配 && 条件 */
                cmp = andn2; }
              整 ifn = Nd(8); Nc(ifn, cmp);
              整 ibd = Nd(5);
              若 (bind_ref[i]) { /* #138 引用模式: int v = __sw; (臂内绑定) */
                  整 d = Nd(7); memcpy((字*)(nn + d), bind_names[i], 64);
                  整 v_sw = Nd(1); memcpy((字*)(nn + v_sw), iname, 32);
                  Nc(d, v_sw); Nc(ibd, d);
              }
              若 (bind_ref[i] && guard_vals[i] >= 0) { /* #138+守卫: 绑定后守卫 → 内层 if (v 已初始化) */
                  整 gifn = Nd(8); Nc(gifn, guard_vals[i]);
                  整 gbd = Nd(5);
                  { 整 v_r = Nd(1); memcpy((字*)(nn + v_r), rn2, 32);
                    整 asg = Nd(10); Nc(asg, v_r); Nc(asg, ress[i]); Nc(gbd, asg); }
                  Nc(gifn, gbd);
                  Nc(ibd, gifn);
              } 否 {
                  { 整 v_r = Nd(1); memcpy((字*)(nn + v_r), rn2, 32);
                    整 asg = Nd(10); Nc(asg, v_r); Nc(asg, ress[i]); Nc(ibd, asg); } /* __sr = 结果; */
              }
              { 整 v_m2 = Nd(1); memcpy((字*)(nn + v_m2), mname, 32);
                整 one = Nd(0); nv[one] = 1;
                整 asg2 = Nd(10); Nc(asg2, v_m2); Nc(asg2, one); Nc(ibd, asg2); } /* __sm = 1; 标记已匹配 */
              Nc(ifn, ibd);
              Nc(blk, ifn);
          } }
        { 整 v_r2 = Nd(1); memcpy((字*)(nn + v_r2), resn, 32);
          整 v_s = Nd(1); memcpy((字*)(nn + v_s), rn2, 32);
          整 asg = Nd(10); Nc(asg, v_r2); Nc(asg, v_s); Nc(blk, asg); uninit_remove(resn); } /* r = __sr; (2026-08-29 P2 批13: 结果变量手工赋值必须标记已初始化 — 否则 return r 误报 A4001) */
        返 blk;
    }
    若 (tt[tk] == VR && !strcmp(tn[tk], "展平")) { /* 接入 2026-08-28 二维展平一维 (flatten): 展平 dst, src, rows, cols; → { __cl=cols; __fl=0; __fr=0; while(__fr<rows){ __fc=0; while(__fc<__cl){ dst[__fl]=src[__fr][__fc]; __fl++; __fc++; } __fr++; } } — 行主序展平 (两级下标, 复用 qcc 原生多维数组机制) */
        tk++; /* 展平 */
        字 dstn[64]; strcpy(dstn, tn[tk]); tk++; /* 目标数组 */
        若 (tt[tk] == CK) tk++; /* , */
        字 srcn[64]; strcpy(srcn, tn[tk]); tk++; /* 源数组 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_r = expr(); /* 行数 */
        若 (tt[tk] == CK) tk++; /* , */
        整 e_c = expr(); /* 列数 */
        若 (tt[tk] == SK) tk++; /* ; */
        静 整 fl_seq = 0; 字 iname[64]; sprintf(iname, "__fl_%d_", fl_seq++);
        静 整 fl_seq2 = 0; 字 rname[64]; sprintf(rname, "__fr_%d_", fl_seq2++);
        静 整 fl_seq3 = 0; 字 cname[64]; sprintf(cname, "__fc_%d_", fl_seq3++);
        静 整 fl_seq4 = 0; 字 clname[64]; sprintf(clname, "__cl_%d_", fl_seq4++);
        var_offset(iname); var_offset(rname); var_offset(cname); var_offset(clname);
        整 blk = Nd(5);
        整 v_d = Nd(1); memcpy((字*)(nn + v_d), dstn, 32);
        整 v_s = Nd(1); memcpy((字*)(nn + v_s), srcn, 32);
        { 整 d = Nd(7); memcpy((字*)(nn + d), clname, 32); Nc(d, e_c); Nc(blk, d); } /* int __cl = cols; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), iname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __fl = 0; */
        { 整 d = Nd(7); memcpy((字*)(nn + d), rname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(blk, d); } /* int __fr = 0; */
        整 wh = Nd(9);
        { 整 v_r = Nd(1); memcpy((字*)(nn + v_r), rname, 32);
          整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_r); Nc(cmp, e_r); Nc(wh, cmp); } /* while (__fr < rows) */
        整 bd = Nd(5);
        { 整 d = Nd(7); memcpy((字*)(nn + d), cname, 32); { 整 z = Nd(0); nv[z] = 0; Nc(d, z); } Nc(bd, d); } /* int __fc = 0; */
        整 wh2 = Nd(9);
        { 整 v_c = Nd(1); memcpy((字*)(nn + v_c), cname, 32);
          { 整 v_cl = Nd(1); memcpy((字*)(nn + v_cl), clname, 32);
            整 cmp = Nd(2); nv[cmp] = T_LK; Nc(cmp, v_c); Nc(cmp, v_cl); Nc(wh2, cmp); } } /* while (__fc < __cl) */
        整 bd2 = Nd(5);
        { 整 v_f = Nd(1); memcpy((字*)(nn + v_f), iname, 32);
          整 idx_d = Nd(14); Nc(idx_d, v_d); Nc(idx_d, v_f); /* dst[__fl] */
          { 整 v_r2 = Nd(1); memcpy((字*)(nn + v_r2), rname, 32);
            整 idx_r = Nd(14); Nc(idx_r, v_s); Nc(idx_r, v_r2); /* src[__fr] — 行 */
            { 整 v_c2 = Nd(1); memcpy((字*)(nn + v_c2), cname, 32);
              整 idx_s = Nd(14); Nc(idx_s, idx_r); Nc(idx_s, v_c2); /* src[__fr][__fc] */
              整 asg = Nd(10); Nc(asg, idx_d); Nc(asg, idx_s); Nc(bd2, asg); } } }
        { 整 v_f = Nd(1); memcpy((字*)(nn + v_f), iname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_f); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_f); Nc(asg, pl); Nc(bd2, asg); } /* __fl++; */
        { 整 v_c = Nd(1); memcpy((字*)(nn + v_c), cname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_c); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_c); Nc(asg, pl); Nc(bd2, asg); } /* __fc++; */
        { 整 cl = new_label(); 整 setl = Nd(20); nv[setl] = cl + 1; Nc(bd2, setl); nv[wh2] = cl + 1; }
        Nc(wh2, bd2);
        Nc(bd, wh2);
        { 整 v_r = Nd(1); memcpy((字*)(nn + v_r), rname, 32);
          整 pl = Nd(2); nv[pl] = PK; Nc(pl, v_r); { 整 one = Nd(0); nv[one] = 1; Nc(pl, one); }
          整 asg = Nd(10); Nc(asg, v_r); Nc(asg, pl); Nc(bd, asg); } /* __fr++; */
