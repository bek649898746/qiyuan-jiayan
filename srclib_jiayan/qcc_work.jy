            整 v_c = Nd(1); memcpy((字*)(nn + v_c), cname, 32);
            整 v_k3 = Nd(1); memcpy((字*)(nn + v_k3), kname, 32);
            整 sub1 = Nd(2); nv[sub1] = MK; { 整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32); Nc(sub1, v_n); } Nc(sub1, v_k3); /* n-__rt */
            整 idx1 = Nd(14); Nc(idx1, v_r); Nc(idx1, sub1); /* arr[n-__rt] 起点 */
            { 整 one = Nd(0); nv[one] = 1; 整 sub2 = Nd(2); nv[sub2] = MK; { 整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32); Nc(sub2, v_n); } Nc(sub2, one); /* n-1 */
              整 idx2 = Nd(14); Nc(idx2, v_r); Nc(idx2, sub2); /* arr[n-1] */
              { 整 base = Nd(14); /* arr[n-__rt+__rc] 读 */
                Nc(base, v_r);
                { 整 v_k4 = Nd(1); memcpy((字*)(nn + v_k4), kname, 32);
                  整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32);
                  整 s1 = Nd(2); nv[s1] = MK; Nc(s1, v_n); Nc(s1, v_k4); /* n-__rt */
                  整 v_c2 = Nd(1); memcpy((字*)(nn + v_c2), cname, 32);
                  整 s2 = Nd(2); nv[s2] = PK; Nc(s2, s1); Nc(s2, v_c2); /* n-__rt+__rc */
                  Nc(base, s2); }
                { 整 v_c3 = Nd(1); memcpy((字*)(nn + v_c3), cname, 32);
                  整 sub3 = Nd(2); nv[sub3] = MK; Nc(sub3, sub2); Nc(sub3, v_c3); /* n-1-__rc */
                  整 idx2r = Nd(14); Nc(idx2r, v_r); Nc(idx2r, sub3); /* arr[n-1-__rc] */
                  整 asg = Nd(10); Nc(asg, v_t); Nc(asg, base); Nc(wbd, asg); } /* __rw = arr[n-__rt+__rc]; */
                { 整 base2 = Nd(14); /* arr[n-__rt+__rc] 写 */
                  Nc(base2, v_r);
                  { 整 v_k5 = Nd(1); memcpy((字*)(nn + v_k5), kname, 32);
                    整 v_n = Nd(1); memcpy((字*)(nn + v_n), nname, 32);
                    整 s1 = Nd(2); nv[s1] = MK; Nc(s1, v_n); Nc(s1, v_k5);
