静 整 recorder_mode = 0; 静 字 recorder_path[512]; 静 整 rec_prev_cp = 0; 静 整 rec_pass = 0; 静 空 rec_line(常 字 *line); 静 空 recorder_frame(常 字 *fn); /* 接入 2026-08-28 可吞清单 P1: 编译黑匣子 — 每函数代码增量哈希帧 (定义在资源护栏区) */
