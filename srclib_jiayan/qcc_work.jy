                整 g_is_uns = 0; /* global unsigned (fix 2026-08-18: size_t 全局 → is_uns → seta 无符号比较) */
                遍 (整 ti2 = save_tk; ti2 + 1 < tk; ti2++) { 若 (tt[ti2] == VK && !strcmp(tn[ti2], "long") && tt[ti2 + 1] == VK && !strcmp(tn[ti2 + 1], "long")) g_is_ll = 1; 若 (tt[ti2] == VK && !strcmp(tn[ti2], "unsigned")) g_is_uns = 1; }
                若 (!g_is_uns) { 整 tdi_gu = g_tdef >= 0 ? g_tdef : tdef_lookup(tn[save_tk]); 若 (tdi_gu >= 0 && !tdefs[tdi_gu].is_struct && !tdefs[tdi_gu].is_fnptr && !tdefs[tdi_gu].is_dbl && tdefs[tdi_gu].is_uns && tdefs[tdi_gu].sz <= 8) g_is_uns = 1; } /* fix 2026-08-29 csmith: typedef unsigned 全局 (uint32_t g=0xFFFFFFFF) — 原只认 unsigned 关键字 → is_uns=0 → 传参符号扩展 crc 错 (s175 g_2) */
                若 (!g_is_ll) { 整 tdi2 = g_tdef >= 0 ? g_tdef : tdef_lookup(tn[save_tk]); 若 (tdi2 >= 0 && !tdefs[tdi2].is_fnptr && !tdefs[tdi2].is_struct && !tdefs[tdi2].is_dbl && tdefs[tdi2].sz == 8 && !g_is_double) g_is_ll = 1; } /* fix 2026-08-18: typedef 8B 基类型 (size_t) 全局 → 8 字节 .data */
                { 整 tdi_gsh = g_tdef >= 0 ? g_tdef : tdef_lookup(tn[save_tk]); 若 (tdi_gsh >= 0 && !tdefs[tdi_gsh].is_struct && !tdefs[tdi_gsh].is_fnptr && !tdefs[tdi_gsh].is_dbl && tdefs[tdi_gsh].sz == 2) { g_is_short = 1; 若 (tdefs[tdi_gsh].is_uns) g_is_uns = 1; } } /* fix 2026-08-29 csmith: typedef short 全局 (int16_t/uint16_t) — 原只认 short 关键字 → int16_t g 标量 32 位零扩展 → 传参错 (seed102/18/64) */
                { 整 tdi_gu = g_tdef >= 0 ? g_tdef : tdef_lookup(tn[save_tk]); 若 (tdi_gu >= 0 && !tdefs[tdi_gu].is_struct && !tdefs[tdi_gu].is_fnptr && !tdefs[tdi_gu].is_dbl && tdefs[tdi_gu].is_uns && tdefs[tdi_gu].sz <= 8) g_is_uns = 1; } /* fix 2026-08-29 csmith: typedef unsigned 全局 (uint32_t g=0xFFFFFFFF) — 原只认 unsigned 关键字 → is_uns=0 → 传参按 signed 符号扩展 → crc 错 (s94 g_26) */
                整 g_is_fnptr = 0, g_fptr_dbl = 0; /* typedef'd fnptr global: 8-byte .data slot (fix 2026-08-03) */
                { 整 tdi = g_tdef >= 0 ? g_tdef : tdef_lookup(tn[save_tk]); 若 (tdi >= 0 && tdefs[tdi].is_fnptr) { g_is_fnptr = 1; g_fptr_dbl = tdefs[tdi].fnptr_dbl; } } /* fix 2026-08-07: g_tdef 覆盖 static 前缀 (static ops_t f 之前落 var_static(0)=4B) */
                整 first_var = 1;
