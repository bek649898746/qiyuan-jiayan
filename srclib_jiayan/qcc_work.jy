                    否 若 (g_stidx >= 0) var_static_struct(gname, g_stidx, 1); /* struct var */
                    否 若 (g_is_ll) { var_static(gname, 4); vars[vcnt - 1].is_ll = 1; } /* global long long: 8-byte .data slot (fix 2026-08-05) */
                    否 若 (g_is_double) { var_static(gname, 4); vars[vcnt - 1].is_dbl = 1; } /* global double: 8-byte .data slot */
