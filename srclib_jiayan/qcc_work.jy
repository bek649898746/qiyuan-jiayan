                ir_emit(I_CALL_FNPTR, 32 + 8 * fp_extra + shadow_pad + total_h, 0, 0); ir_flush(); /* Phase3-IR */
                /* Phase3-IR: mov r10,rax; call r10; add_rsp 由 I_CALL_FNPTR 落码 */
                /* (原三行删除) */
            } 否 若 (is_user && fi >= 0) {
                graph_record_call(func_tbl[fi].name); /* -graph 旁路: 调用关系记录 */
                    ir_emit(I_CALL_LBL, func_tbl[fi].label, argbase + total_h, 0); ir_flush(); /* Phase3-IR */
            } 否 若 (!strcmp(fname, "memset")) {
                /* dst=rcx, val=rdx, n=r8d */
                mov_rr(10, 8); /* r10d = n */
                mov_rr(9, 2); /* r9 = rdx = val */
                mov_rr(8, 1); /* r8 = rcx = dst */
                整 ls2 = new_label(), ld2 = new_label();
                set_label(ls2);
                test_rr(10, 10); jz_rel(-1); patch_label(cp-4, ld2, 1);
                asm_emit("    写字节 [r8], r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,1,0,1);b(0x88);modrm(0,1,0); /* MOV [r8], r9b */
                asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,0); /* inc r8 */
                asm_emit("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,1,2); /* dec r10 */
                jmp_rel(-1); patch_label(cp-4, ls2, 2);
                set_label(ld2);
                mov_rr(0, 1); /* eax = orig dst */
            } 否 若 (!strcmp(fname, "memcpy")) {
                /* dst=rcx(1), src=rdx(2), n=r8d(8) */
                mov_rr(10, 8); /* r10d = n */
                mov_rr(9, 2);  /* r9 = src */
                mov_rr(8, 1);  /* r8 = dst */
                /* copy 1 byte */
                整 ls = new_label(), ld = new_label();
                set_label(ls);
                test_rr(10, 10); jz_rel(-1); patch_label(cp-4, ld, 1);
                asm_emit("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0x8A);modrm(0,0,1); /* mov al, [r9] */
                asm_emit("    写字节 [r8], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0x88);modrm(0,0,0); /* mov [r8], al */
                asm_emit("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,0); /* inc r8 */
                asm_emit("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,0,1); /* inc r9 */
                asm_emit("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); rex(0,0,0,1);b(0xFF);modrm(3,1,2); /* dec r10 */
                jmp_rel(-1); patch_label(cp-4, ls, 2);
                set_label(ld);
                mov_rr(0, 1); /* eax = rcx = original dst */
            } 否 若 (!strcmp(fname, "strcmp")) {
                /* a=rcx, b=rdx */
                mov_rr(8, 1); /* r8 = a */
                mov_rr(9, 2); /* r9 = b */
                整 lss = new_label(), lds = new_label(), lzs = new_label(), leq = new_label();
