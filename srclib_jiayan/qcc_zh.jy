   gen_code's func_n=0 reset, so index-based fn_ret_si_map misaligns whenever a
   program adds/removes functions (e.g. printf) between parse and codegen. */
静 构 { 字 名[64]; 整 返构序; 整 返指; 整 返深; } 源己[2048]; 静 整 函返名数; /* fix 2026-08-16 根因E3: 512→2048 大文件顶层函数声明超 512 (原静默丢 → sret 误判); fix 2026-08-20: ret_depth 返回指针层数 (*=1 **=2) — case-12 *f() 解引用宽度 */
静 整 查返回名(常 字 *名) {
    遍 (整 计 = 0; 计 < 函返名数; 计++) 若 (!比较字符串(源己[计].名, 名)) 返 源己[计].返构序;
    返 -1;
}
静 整 返回名有(常 字 *名) { /* fix 2026-08-18: 区分「名表记录 ret_si=-1 (int 返回)」与「名表无此函数」— get 的 -1 哨兵二义 (int 返回被 fallback 到错位的 fn_ret_si_map[fi] → sret 误判) */
    遍 (整 计 = 0; 计 < 函返名数; 计++) 若 (!比较字符串(源己[计].名, 名)) 返 1;
    返 0;
}
静 整 查返回名指(常 字 *名) {
    遍 (整 计 = 0; 计 < 函返名数; 计++) 若 (!比较字符串(源己[计].名, 名)) 返 源己[计].返指;
    返 0;
}
静 整 副降二(常 字 *名) { /* fix 2026-08-20: 返回指针层数 (struct X* →1, struct X** →2) */
    遍 (整 计 = 0; 计 < 函返名数; 计++) 若 (!比较字符串(源己[计].名, 名)) 返 源己[计].返深;
    返 0;
}
静 空 当三(常 字 *名, 整 返构序, 整 返指, 整 返深) {
    遍 (整 计 = 0; 计 < 函返名数; 计++)
        若 (!比较字符串(源己[计].名, 名)) { 源己[计].返构序 = 返构序; 源己[计].返指 = 返指; 源己[计].返深 = 返深; 返; }
    若 (函返名数 >= 2048) 返;
    复制字符串(源己[函返名数].名, 名);
    源己[函返名数].返构序 = 返构序;
    源己[函返名数].返指 = 返指;
    源己[函返名数].返深 = 返深;
