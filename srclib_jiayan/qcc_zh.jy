            若 (词型表[词位] == 逗号) 词位++;
            字 实参名[64]; 复制字符串(实参名, 词名表[词位]); 整 实参节 = -1; 若 (词型表[词位] != 右括 && 词型表[词位] != 逗号) 实参节 = 原级(); /* R272 刀1 (2026-09-26 启元 · 第 364 站 round 11): **完整消费 实参表达式** — 原 `词位++` 只吃 一个 词 (`arr[0]` 只吃 `arr`), 残留 `[0])` 未消费 ⟹ 整个 「约束前缀 逗号表达式」 塌成 常量 0 (实测 r271e E3 `(__受约束(可加,arr[0]), 7)` = **0** 应 7; E4 `..., arr[0].v)` = 0 应 3; E1 应 6 得 0), 而 实参 是 单名 变量 (`元`) 时 恰好 干净 ⟹ imp_i 通过、imp_h 静默 0 0. 本处 与 `__特化` (同型副本) 一并 修 */
            若 (词型表[词位] == 右括) 词位++;
            整 接口序 = 满对(接口名);
            整 实参型序 = (实参节 >= 0) ? 序七(实参节) : 变量型序(实参名); /* R272 刀2 (2026-09-26 启元 · 第 364 站 round 11): 实参 类型 用 `序七` (下标/取址/成员/解引用/转型 通吃) 替 「只认 一个 词名」; 对 单名 变量 与 `变量型序` 逐字等价 (序七 L5119 即转调) ⟹ imp_i/imp_a..g 零影响. 与 刀1 必须 配套: 刀1 单独 ⟹ 值 恢复 但 类型名 仍取 「arr」(数组) ⟹ A9006 假拦 */
            字 实参类型[64] = "整";
            若 (实参型序 >= 0) 复制字符串(实参类型, 类型表[实参型序].名);
            否 {
                若 (变量是否浮(实参名)) 复制字符串(实参类型, "双");
                否 若 (变量是否字符(实参名)) 复制字符串(实参类型, "字");
                否 若 (变量是否短(实参名)) 复制字符串(实参类型, "短");
                否 若 (变量是否长(实参名)) 复制字符串(实参类型, "长");
            }
