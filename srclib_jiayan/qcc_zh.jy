        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "覆写")) { 词位++; 复制字符串(尾厚, 词名表[词位]); 词位++; 净丙一 = 1; } /* #13: 可覆写移动钩子 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        { 整 检游 = 池列; 整 检深 = 0; 整 检动 = 0; /* G1 (2026-09-09): 动态下标 (非-常数索引) 源 不可移出 — 运行期索引无法静态登记 → 移后读漏拦 (aud2c); Rust E0508 精神 */
    循环 (检游 >= 0 && 检深 < 8) { 整 检tt = 节型别[检游]; 若 (检tt == 节点_变量) 断; 若 (检tt == 节点_下标) { 若 (子1[检游] < 0 || 节型别[子1[检游]] != 节点_常数) { 检动 = 1; 断; } 检游 = 子0[检游]; 检深++; 续; } 若 (检tt == 节点_成员) { 检游 = 子0[检游]; 检深++; 续; } 断; }
    若 (检动) { 格式化到串(错缓冲, "所有权错误: 不能从动态下标移出 (运行期索引无法静态登记; 常数下标可移出 — Copy 值用 赋值, 或常数下标中转)"); 发错误("A3107", 错缓冲); 返 建节(5); } }
若 (池列 >= 0 && 节型别[池列] == 节点_变量) { /* 已移 登记: 源是简单变量时跟踪 (阶段C-1 #9: Copy 类型豁免源失效) */
            字 *源计数 = (字*)(节名表 + 池列);
            /* R454 (2026-10-01 · 第 439 站续五十 · R453 同族第二例): **外部符号作移动源 静默丢弃 根治** ——
               `extern 构 盒 外盒; 构 盒 b; 移入 b, 外盒;` 原 **编译成功** 且**移入整段被跳过**
               (自证式探针: 先把 b.x 填 7, 移入后打印仍为 **7** ⟹ 未被覆盖; 对照「有定义的全局」打印 3 ⟹ 移动正常).
               根因同 R453: 移动源的地址/值解析对 extern 变量 (栈偏移为**负**) 无校验, 且无诊断.
               修法: 在**移入源**解析点补同一收口 (非链接模式 + 负偏移 ⟹ 报 A1001, 与「读」对称). */
            若 (!链接模式) { 整 移偏R454 = 0; 整 移找R454 = 0;
                遍 (整 移计R454 = 变量总数() - 1; 移计R454 >= 0; 移计R454--) 若 (!比较字符串(变量表[移计R454].名, 源计数)) { 移偏R454 = 变量表[移计R454].栈偏移; 移找R454 = 1; 断; }
                若 (移找R454 && 移偏R454 < 0) { 格式化到串(错缓冲, "外部 变量 '%s' 无定义 — 单文件编译无法解析 (多文件请用 编译器 -c + 链接器 链接; 号合.0)", 源计数); 发错误("A1001", 错缓冲); } }
            字 源类型名[64]; 变量类型名(源计数, 源类型名);
            若 (当繁(源计数) >= 0) { 格式化到串(错缓冲, "借用检查: 变量 '%s' 被借用, 不能移动 (借用期所有权不可转移, 号合.0 #10)", 源计数); 发错误("A3004", 错缓冲); } /* 接入 2026-08-28 机制层 #10: 借用期间不能 移动 (只读借用在此拦, 可变借用 L5014 已拦) */
            若 (!类型可复制(源类型名)) {
                整 宏序; 遍 (宏序 = 0; 宏序 < 正次; 宏序++) 若 (!比较字符串(域六[宏序].路径, 源计数)) 断;
                若 (宏序 < 正次) { 格式化到串(错缓冲, "所有权错误: 变量 '%s' 已移动 (移动 后源失效), 不能再次移动", 源计数); 发错误("A3102", 错缓冲); }
                移源(源计数, 0);
            }
        } 否 若 (池列 >= 0 && 节型别[池列] == 节点_成员) { /* 2026-08-28 #17 部分移动 + 波1 (2026-09-09): 源是字段/元素字段 (s.x / 项[0].v) — 穿透链构造路径 登记已移, 其余字段仍可用 */
            字 *串升 = (字*)(节名表 + 池列);
            /* 穿透 成员/下标 链到根变量, 构造完整路径 (s.x / 项[0].v): 栈收集 后缀段 */
            整 链[8]; 整 链数 = 0; 整 游 = 子0[池列]; 整 根 = -1;
            循环 (游 >= 0 && 链数 < 8) {
                整 tt = 节型别[游];
                若 (tt == 节点_变量) { 根 = 游; 断; }
                若 (tt == 节点_下标) { 链[链数++] = 游; 游 = 子0[游]; 续; }
                若 (tt == 节点_成员) { 链[链数++] = 游; 游 = 子0[游]; 续; }
                断;
            }
            若 (根 >= 0 && !根节点可复制(根)) {
                { 整 根基 = 查活变量((字*)(节名表 + 根)); 整 庚查; 遍 (庚查 = 0; 庚查 < 逆汇; 庚查++) 若 (守卫表[庚查].槽名[0] != 0 && !比较字符串(守卫表[庚查].槽名, (字*)(节名表 + 根)) && (根基 < 0 || 守卫表[庚查].槽基 < 0 || 守卫表[庚查].槽基 == 根基)) { 格式化到串(错缓冲, "所有权错误: 守卫变量 '%s' 不可部分移动 (整对象析构会作用已移出字段; 先移出整个变量或 丢弃; Rust E0509)", (字*)(节名表 + 根)); 发错误("A3106", 错缓冲); } } /* 2026-09-09 守卫遮蔽: 根基 过滤 — 遮蔽块内层同名 无守卫 不误报 */ /* G5 (2026-09-06) */
                字 路径[96]; 路径[0] = 0; 拼接(路径, (字*)(节名表 + 根));
                /* 沿链正向追加: 链里存的是从内到外 (子0 向上), 需反向走 */
                遍 (整 丙 = 链数 - 1; 丙 >= 0; 丙--) { 整 段 = 链[丙]; 若 (节型别[段] == 节点_成员) { 拼接(路径, "."); 拼接(路径, (字*)(节名表 + 段)); } 否 若 (节型别[段] == 节点_下标 && 子1[段] >= 0 && 节型别[子1[段]] == 节点_常数) { 字 索[32]; 格式化到串(索, "[%d]", 节值表[子1[段]]); 拼接(路径, 索); } }
                拼接(路径, "."); 拼接(路径, 串升);
                若 (取环境("QCC_DBG_NS")) 输出到文件(错误流, "[W1] 登记路径=%s 根序=%d\n", 路径, 查活变量((字*)(节名表 + 根)));
                若 (正次 < 2048) { 复制字符串(域六[正次].路径, 路径); 域六[正次].别.tag = 域路型_域路成; 域六[正次].基 = 查活变量((字*)(节名表 + 根)); 复制字符串(域六[正次].字段, 串升); 正次++; }
                域标记(路径, 0);
            }
        } 否 若 (池列 >= 0 && 节型别[池列] == 节点_下标) { /* 波1c (2026-09-09): 源是数组元素 struct (移入 t, 项[0]) — 整元素移出, 登记 元素路径 (域路元), 后续 该元素 字段/整体 读拦; 原 elif 链无下标 → 静默漏拦 (位拷贝语义) */
            整 基序下 = 子0[池列];
            若 (基序下 >= 0 && 节型别[基序下] == 节点_变量 && !根节点可复制(基序下)) {
                字 元素路径[96]; 元素路径[0] = 0; 拼接(元素路径, (字*)(节名表 + 基序下));
                若 (子1[池列] >= 0 && 节型别[子1[池列]] == 节点_常数) { 字 索[32]; 格式化到串(索, "[%d]", 节值表[子1[池列]]); 拼接(元素路径, 索); }
                若 (正次 < 2048) { 复制字符串(域六[正次].路径, 元素路径); 域六[正次].别.tag = 域路型_域路元; 域六[正次].基 = 查活变量((字*)(节名表 + 基序下)); 正次++; }
                域标记(元素路径, 0);
