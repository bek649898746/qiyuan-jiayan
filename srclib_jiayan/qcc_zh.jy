                汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1);发字节(0xFF);模字节(3,0,1); /* ③ REX.W=1: 同上 */ /* 递增 r9 */
