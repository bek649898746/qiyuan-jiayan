    }
    若 (词型表[词位] == 词变量) { 整 评值 = 全回(词名表[词位]); 整 首简 = (评值 != 0x80000000 && 评值 != -1); 若 (!首简) { 评值 = 域零(词名表[词位]); 首简 = (评值 != 0x80000000 && 评值 != -1); } /* 全回 缺失=0x80000000, 域零 缺失=-1 — 两者都算未找到 */ 若 (!首简 && 宽劣 > 0) { 整 短次 = 中劣(词名表[词位]); 若 (短次 != 0x80000000) { 评值 = 短次; 首简 = 1; } } /* 2026-08-28 类型-根-16 #76: 编译期求值 帧内变量 (参数/局部); 修复 2026-08-29 #172: 帧内查到 -1 (负参数) 必须接受, 不能当"未找到"拒绝 */ 若 (!首简) { 整 常序 = 池繁(词名表[词位]); 若 (常序 >= 0) { 评值 = 外联[常序]; 首简 = 1; } } /* 第 157 站 根治 (#176 编译期断言 / #190 编译期断言族):
   常量求值器 原 只查 宏表 (全回/域零) 与 帧内变量 (中劣), **唯独不查 `常量 名 = 值;` 写入的 编译期常量表**;
   而 `常量` 声明 (L12328) 写的是 剩集/外联 两张表, 与 宏表 终复[] 不相通 ⟹
   `常量 整 甲 = 2; 编译期断言(甲 == 2);` 报「编译期断言: 表达式不是编译期常量 (号合.0 #176)」。
   对照实证: `编译期断言(2 == 2);` PASS / 具名常量 FAIL ⟹ 缺陷定位在「具名常量求值」而非 比较运算符。
