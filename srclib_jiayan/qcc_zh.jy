                        变量表[变量数 - 1].数组元素尺寸 = (计数二 / 首) * 元素尺寸;
                        变量表[变量数 - 1].指元素尺寸 = 元素尺寸;
                    }
                    若 (维数表 >= 1) { 变量表[变量数 - 1].域行数[维数表 - 1] = 元素尺寸; 遍 (整 己序 = 维数表 - 2; 己序 >= 0; 己序--) 变量表[变量数 - 1].域行数[己序] = 变量表[变量数 - 1].域行数[己序 + 1] * 余又[己序 + 1]; } /* 3D 每-维度 行 (修复 2026-08-05) */
                    若 (是否指标 && 元素尺寸 == 8 && 整得 < 0) 变量表[变量数 - 1].指内 = 是否字符标 ? 1 : (是否短标 ? 2 : ((当丙 || 是否长标) ? 8 : 4)); /* C4 普查刀1 (2026-09-24 启元 · 第 274 站): **与 C6 的 L10751 一致化** —— 原判据 含 `!当丙` (把 `双精度 *p[2]` 排除, 注释断言 "走浮点通道, 本来正确") 且 值式 缺 `当丙` 分支 (→ 4). 插桩铁证 (C7 深挖): `双精度 *dps[2]` 的 `指内 = 0` 而 全局版 `static 整数 *gp[2]` = 4 ⟹ 该断言 错误, C7 正是 反例. 本刀 去掉 `!当丙` 并按 被指类型 完整分派 (双精度 → 8). 对照 L10751 (static 分支, C6 刀 已同款). */ /* R255 刀5 (2026-09-23) 虾米: **「元素是指针」必须按 `是否指标` 判, 不能按声明里的类型词** —— 原 判据 `元素尺寸 == 8 && !是否长标 && !当丙 && 整得 < 0` 里 的 `是否长标` 是 按 **声明 中的 类型词** 置位的 (见 上方 `若 (是否长标) 变量表[变量数-1].是否长标 = 1;`), 不区分「词 修饰 元素」还是 「词 是 指针 的 基类型」⟹ `长整长整 *lparr[2]` 的 元素 是 **指针** 却 带 是否长标=1 ⟹ 整条 落空 ⟹ `指内` 保持 0 ⟹ `表达式内重(下标节点)` 递归 到 链根 得 0 ⟹ 外层 第二维 下标 步长 落空 (实测 r255al: 全局 `gparr[0][1]` = 22 ✓ 而 局部 `lparr[0][1]` = 0 ✗; 插桩 `[R255m] 名=lparr 指内=0`). 本刀 加 **`是否指标`** 守卫 (该变量 已 在 上文 用于 设 指元素尺寸, 正在 作用域) 并 把 指向元素 大小 按 被指 类型 **完整分派** (镜像 L10281 的 同款 写式): 字符 1 / 短整 2 / 长整整 8 / 其余 4. ⟹ `长整长整 *p[2]` 得 8 (修复), `短整 *p[2]` 由 错值 4 改 2 (顺带修好), 标量 数组 `是否指标 = 0` ⟹ 不 命中 (指内 保持 0, 不误伤), `双精度 *p[2]` 由 `当丙` 排除 (走 浮点通道, 本来正确). */ /* 修复 2026-08-23 t35j: 指针数组 (常量 字符 *数组[]) 指向元素大小 — 指内 语义=指向元素; 不动 是否字符标 (是否字符标 误标 常量 字符* 数组破坏 3797/3915 元素尺寸 → 自举崩 329B); 元素 8 字节非 邻辰/浮/结构体 → 指针数组 */
                    若 (当丙 || 单丙) { 变量表[变量数 - 1].是否浮标 = 1; 若 (单丙) 变量表[变量数 - 1].单标 = 1; } /* 局部 双精度/单精度 数组 (R4a-5: float 数组元素 4B 单标) */
                    若 (无符号标) 变量表[变量数 - 1].无符号标 = 1; /* 无符号 数组 (修复 2026-08-05) */
