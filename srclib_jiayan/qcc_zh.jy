        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 0); /* r9 method (mov_r_imm 不支持 r9) */ /* FILE_BEGIN */
        调导入(5);
        加栈即(48);
        移64(4, 15);
        移即(0, 0);
        相对跳转(-1); 补标号(码位 - 4, 首拾二, 2);
        设标号(左薄);
        移即(0, 0);
        设标号(首拾二);
    } 否 若 (!比较字符串(串升, "fclose")) {
