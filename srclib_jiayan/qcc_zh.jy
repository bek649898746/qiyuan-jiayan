                码生成免解引用 = 1; 初壹 = 解斥; 码生成(子0[数]); 码生成免解引用 = 0; 初壹 = 0; /* 堆九 = &目标 (修复 2026-08-18: ++/目标标记; 2026-09-04 虾米: 指针成员下标解引用) */
                整 符凶 = 4; 整 帧丁 = 1; /* 修复 2026-08-17: 同 例 23 — 字符/短整/长整 长整 元素 ++/-- 按目标宽度读写; 修复 2026-08-18: 指针字段成员 ++/-- 按指向元素缩放 */
                { 整 暂零 = 子0[数]; 若 (暂零 >= 0 && 节型别[暂零] == 节点_下标) { 整 域升 = 暂零; 循环 (域升 >= 0 && 节型别[域升] == 节点_下标) 域升 = 子0[域升]; 若 (域升 >= 0 && 节型别[域升] == 节点_变量) { 遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--) 若 (!比较字符串(变量表[变序].名, (字*)(节名表 + 域升)) && 变量码生成可见(变序)) { 若 (变量表[变序].指元素尺寸 > 0) 符凶 = 变量表[变序].指元素尺寸; 否 若 (变量表[变序].数组元素尺寸 > 0) 符凶 = 变量表[变序].数组元素尺寸; 断; } } 若 (域升 >= 0 && (节型别[域升] == 节点_成员 || 节型别[域升] == 节点_箭头)) { 整 构序二 = 变量型序((字*)(节名表 + 子0[域升])); 若 (构序二 >= 0) { 整 域序 = 字段序(构序二, (字*)(节名表 + 域升)); 若 (域序 >= 0) { 若 (类型表[构序二].字段[域序].原进) 符凶 = 字段指元素(构序二, (字*)(节名表 + 域升)); 否 若 (类型表[构序二].字段[域序].内联 > 0) 符凶 = 构域元素(构序二, (字*)(节名表 + 域升)); } } } /* 2026-09-04 虾米: 成员数组元素 ++/-- 前缀 (++b.y[0]) 14链底=成员15 原漏宽默认4 (P7/P12) */ } /* 修复 2026-09-03 p196: 2D 数组元素 ++/-- (g[4][4]) 原只跳一层子0(内层14节点) → 变量元素 返回 行宽48/默认4 → 64位 元素 32/8位 读改写 (volatile uint64 回绕 0xFFFFFFFFFFFFFFFF → 0xFFFFFFFF00000000/FFFFFF00); 沿嵌套14走到基 用 指元素尺寸(标量8) */
                  否 若 (暂零 >= 0 && 节型别[暂零] == 节点_成员) { 字 *变节二 = (字*)(节名表 + 子0[暂零]); 字 *正壹 = (字*)(节名表 + 暂零); 整 构序二 = 变量型序(变节二); 若 (构序二 >= 0) { 整 域尺寸 = 字段尺寸直(构序二, 正壹); 若 (域尺寸 > 0) 符凶 = 域尺寸; 整 域序 = 字段序(构序二, 正壹); 若 (域序 >= 0 && 类型表[构序二].字段[域序].原进) 帧丁 = 类型表[构序二].字段[域序].符肆; } }
                  否 若 (暂零 >= 0 && 节型别[暂零] == 节点_解引用) { 整 链寻 = 暂零, 链深 = 0; 循环 (链寻 >= 0 && 节型别[链寻] == 节点_解引用) { 链深++; 链寻 = 子0[链寻]; 若 (链寻 >= 0 && (节型别[链寻] == 节点_增减 || 节型别[链寻] == 节点_前置增减)) 链寻 = 子0[链寻]; } 若 (链寻 >= 0 && 节型别[链寻] == 节点_变量) { 整 链元 = 变量指深((字*)(节名表 + 链寻)); 整 内宽 = 正己((字*)(节名表 + 链寻)); 若 (内宽 <= 0) 内宽 = 变量元素((字*)(节名表 + 链寻)); 若 (链元 <= 0 && 链深 == 1) 链元 = 1; 若 (链元 > 链深) 符凶 = 8; 否 若 (链元 == 链深) 符凶 = 内宽 > 0 ? 内宽 : 1; 否 符凶 = 1; } /* 修复 2026-09-03 p318: (**g928)++ 链解引用宽度 沿 12 链到最内变量 按 剩余层 vs 指深 (镜像 ptr-store) */ 若 (子0[暂零] >= 0 && 指元素[子0[暂零]]) 符凶 = 指元素[子0[暂零]]; } }
                
                压栈寄存器(0);           /* [rsp] = &目标 (单 压栈: 读取 回 于 +0) */
                若 (符凶 == 8) { 移即(1, 帧丁); 发字节(0x48); 发字节(0x63); 模字节(3, 1, 1); } /* ecx = +步 movslq (修复 2026-09-03 p171/前缀: -帧丁 mov ecx 零扩展 → 64 位 add +4294967295 递增死循环; 镜像 例23 修复) */
                否 移即(1, 高拆 ? -帧丁 : 帧丁); /* ecx = ±步 (修复 2026-08-18: 指针字段按元素缩放) */
                移寄存器栈64(0, 0); /* 堆九 = [rsp] = &目标 */
                若 (符凶 == 8) 移寄存器内存64(0, 0);
                否 若 (符凶 == 4) 移寄存器内存(0, 0);
                否 若 (符凶 == 2) { 汇发("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB7); 模字节(0, 0, 0); }
                否 { 汇发("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 发字节(0x00); }
                若 (符凶 == 8) { 若 (高拆) { 前缀字节(1, 0, 0, 0); 发字节(0x29); 模字节(3, 1, 0); } 否 { 前缀字节(1, 0, 0, 0); 发字节(0x01); 模字节(3, 1, 0); } } 否 算寄存器(高拾, 0, 1);   /* 修复 2026-08-30 生成器 s134: 64 位元素 ++/-- 须 64 位自增 (加 堆九, rcx — 48 03 域转; 原 48 01 域转 是 加 rcx,堆九 方向反 → 值不变; 且 32 位 算寄存器 高 32 位清 0); 2026-09-03 p171 前缀: 高拆 用 减 (48 29) 非 加零扩展 */
                若 (符凶 == 8) 移64(3, 0); 否 移寄存器(3, 0);         /* rbx = 新 值 (64 位元素全 64) (保存; 堆九 重载 将 破坏 首子) */
                移寄存器栈64(0, 0); /* 堆九 = [rsp] = &目标 */
                若 (符凶 == 8) { 汇发("    存64 [r0], r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x89); 模字节(0, 3, 0); } /* 移动 [堆九], rbx */
                否 若 (符凶 == 4) { 汇发("    存零 [r0], r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x89); 模字节(0, 3, 0); } /* 移动 [堆九], ebx */
                否 若 (符凶 == 2) { 汇发("    存字 [r0], r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x89); 模字节(0, 3, 0); } /* 移动 [堆九], bx */
                否 { 汇发("    存字节 [r0], r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x88); 模字节(0, 3, 0); } /* 移动 [堆九], bl */
                若 (符凶 == 8) 移64(0, 3); 否 移寄存器(0, 3);         /* 首子 = 新 值 (64 位元素全 64) */
                加栈即(8);       /* 丢弃 &目标 */
            }
        } 断;
        例 节点_窄转型: { /* 窄类型截断 — (int16_t)/(uint8_t) 转型 值掩码+符号扩展 (修复 2026-08-30 生成器 B族: 原 转型 无-算子 保留 32 位垃圾, s62 全局变量 应 0x5568) */
            若 (子0[数] >= 0 && 表达式是否浮(子0[数])) { /* C128 (2026-09-19 第 123 站): **浮点源** 先 转 整数 —— 原 无条件 `码生成(子0[数])` (浮点 结果 在 xmm0) 却 直接 掩码 eax ⟹ eax 是 垃圾 ⟹ `(双精度)(字符)v` / `(双精度)(短整)v` 静默 得 0.00 (实测 v=300.7 → 0.00 应 44.00). 复用 例 节点_转型 (节点19) 的 写法. */
                码生成浮(子0[数]); 若 (节点长性(数, -1)) 长对(); 否 { 中发(宽二, 0, 0, 0); 中刷(); } /* 浮 → 整数 (cvttsd2si, 结果 在 eax) */
            } 否 码生成(子0[数]); /* 原值 → 首子 */
            若 (节值表[数] == 1) { 汇发("    掩码字节 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x25); 发四(0xFF); 若 (!窄无符号[数]) { 汇发("    符号扩展字节 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBE); 发字节(0xC0); } }
            否 { 汇发("    掩码字 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x25); 发四(0xFFFF); 若 (!窄无符号[数]) { 汇发("    符号扩展字 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBF); 发字节(0xC0); } } /* 修复 2026-08-30 生成器 s62: 窄 转型 符号扩展字 — 原 b(0x66);b(0x0F);b(0xBF);b(0xC0) 66 前缀使目标变 16 位 ax (movsww) → 首子 高 16 位不变 → (int16_t)0xABCD 得 0x0000ABCD 应 0xFFFFABCD (全局变量 被截断零扩展); 修复 2026-09-03 p218: 判定用 窄无符号 快照 (外层 (int) 转型清 节无符号 → (uint16_t)(int8 -3) 0xFFFD 被符号扩展 -3 错) */
            若 (节长标[数] && !窄无符号[数]) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } /* 修复 2026-09-02 p218: 窄 转型 后 直接 64 位上下文 ((long long)(int16_t)x) — 原只在 eax 符号扩展, 缺 movsxd → 零扩展 4294967295 应 -1 (与 变量读 L18497 movsxd 处理一致); 2026-09-03 判定用 窄无符号 快照 */
            断;
