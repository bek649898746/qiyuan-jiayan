        整 可空本 = (槽丙 < 可空槽数 && 可空槽表[槽丙] == 词位) ? 1 : 0;
        整 级丙 = 0; 整 探丙 = 词位 + 1; /* 第 210 站 R26-余 b (2026-09-21 真接入): 数 连续 `*` 的 个数 = 指针级数.
           原守卫 只认 **单级** (`词位+1 乘 && 词位+2 词变量`), 多级 `点 **p` 的 词位+2 是 `*` 而非 词变量
           ⟹ 不匹配 ⟹ 落原路径 ⟹ `可空 点 **p = 空;` 报 A8002 · `点 **p;` 报「未声明标识符 p」(连声明都没登记).
           实测 (老编译器 C63D55A7): ①`可空 点 **p = 空;` A8002 · ②`可空 点 ***p = 空;` A8002 · ③`点 **p;` 未声明标识符 · ④`点 **c[2];` 0xC0000005 崩. */
        若 (词型表[词位] == 词变量 && 查类型(词名表[词位]) >= 0 && !型定判断(词名表[词位]) && 词位 + 2 < 词容量
            && 词型表[词位 + 1] == 乘) {
