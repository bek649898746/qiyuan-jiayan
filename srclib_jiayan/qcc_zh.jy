                        循环 (甲序 > 0 && (参值[甲序 - 1] == ' ' || 参值[甲序 - 1] == '\t' || 参值[甲序 - 1] == '\r')) 甲序--;
                        参值[甲序] = 0;
                        { 字 计简[4096]; 整 栈吉 = 0; 遍 (整 隐字符 = 0; 隐字符 < 甲序; ) { 若 (参值[隐字符] == '/' && 参值[隐字符 + 1] == '*') { 循环 (隐字符 + 1 < 甲序 && !(参值[隐字符] == '*' && 参值[隐字符 + 1] == '/')) 隐字符++; 隐字符 += 2; 计简[栈吉++] = ' '; 续; } 若 (参值[隐字符] == '/' && 参值[隐字符 + 1] == '/') { 循环 (隐字符 < 甲序 && 参值[隐字符] != '\n') 隐字符++; 计简[栈吉++] = ' '; 续; } 计简[栈吉++] = 参值[隐字符++]; } 计简[栈吉] = 0; 复制内存(参值, 计简, 栈吉 + 1); 甲序 = 栈吉; 循环 (甲序 > 0 && (参值[甲序 - 1] == ' ' || 参值[甲序 - 1] == '\t')) 甲序--; 参值[甲序] = 0; } /* fix 2026-08-26 pngtest: 宏值内块注释替换为空白 (C 语义) — png.h 别名宏行尾 [Deprecated] 注释混进值 → pp_eval 失败; 注意只能替换不能截断 — sqlite3.c OPFLG_INITIALIZER 表体含行间注释, 原截断砍掉整个表 → 数组初始化残缺 → 解析死循环 AST 爆炸 */
