              若 (根九 >= 0 && 节型别[根九] == 节点_变量) { 字 *名九 = (字*)(节名表 + 根九);
                若 (变量指深查(名九) == 1 && 变量元素(名九) > 8 && 变量指内查(名九) > 0 && 变量元素(名九) > 变量指内查(名九)) {
                    遍 (整 变序九 = 变量总数() - 1; 变序九 >= 0; 变序九--) 若 (!比较字符串(变量表[变序九].名, 名九) && 变量码生成可见(变序九)) { 中系 = 1; 遍 (整 栈庚九 = 0; 栈庚九 < 4; 栈庚九++) 上薄[栈庚九] = 变量表[变序九].域行数[栈庚九]; 断; }
