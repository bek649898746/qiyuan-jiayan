            若 (词型表[词位] == 结构词 && (!比较字符串(词名表[词位], "struct") || !比较字符串(词名表[词位], "构") || 是联合词(词名表[词位])) && 词位 + 1 < 词容量 && 词型表[词位 + 1] == 左花) {
