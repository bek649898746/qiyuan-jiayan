                    若 (链接模式) {
                        发字节(0x48); 发字节(0x8D); 发字节(0x05); 发四(0); /* 启元修复② */
                        缺亥(码位 - 4, 0x0004, 新又((字*)(节名表 + 数)), 0);
                    } 否 若 (主薄((字*)(节名表 + 数))) {
                        移即(0, 0); /* 单文件 内置 (内联发射, 无真实函数体): 确定性 空 (修复 2026-08-19: 原 取参值 不发射 → 堆九 残留垃圾 → 测试靠运气) */
                    } 否 {
                        整 目丁; 遍 (目丁 = 0; 目丁 < 声明数; 目丁++) 若 (!比较字符串(串升一[目丁], (字*)(节名表 + 数))) 断;
                        若 (目丁 < 声明数) { /* 接入 2026-08-28 声明: 已声明未实现函数取地址 → 新五 烘焙 (同已定义函数, 指向 半未 绝对 VA) */
                            整 串寅一 = 查函数((字*)(节名表 + 数));
                            汇发("    移动 r0, FN:%s\n", (字*)(节名表 + 数), (字*)(长 长)0, (字*)(长 长)0);
                            发字节(0x48); 发字节(0x8D); 发字节(0x05); 发四(0); /* 启元修复②: 已声明未实现函数地址 lea */
                            若 (主又 >= 2048) { 输出到文件(错误流, "[FNPATCH-OVERFLOW] fnpn=%d\n", 主又); 终止程序(); }
                            新五[主又].旁退 = 码位 - 4;
                            新五[主又].标号一 = 函数表[串寅一].标号一;
