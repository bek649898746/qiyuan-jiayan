                    循环 (串值[计] && 串值[计] != '"' && 乙 < 2046) {
                        若 (串值[计] == '\\' && 串值[计 + 1]) { 计++; 若 (串值[计] == 'n') 净深[串宏数].数值[乙++] = '\n'; 否 若 (串值[计] == 't') 净深[串宏数].数值[乙++] = '\t'; 否 若 (串值[计] == '0') 净深[串宏数].数值[乙++] = 0; 否 净深[串宏数].数值[乙++] = 串值[计]; }
                        否 净深[串宏数].数值[乙++] = 串值[计];
                        计++;
