                移寄存器栈64(0, 参基 + 总计数 - 槽高[2] - 8); 移64(9, 0); /* r9 = lpParameter = 实参 */
                移寄存器栈64(14, 参基 + 总计数 - 槽高[0] - 8); /* r14 = &t (被调者-已存, 跨调用保留) */
                压栈寄存器(15); 移64(15, 4);
                汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                减栈即(48); /* 32 影子 + 2 栈参 (dwCreationFlags, lpThreadId) */
                移栈寄存器64(32, 1); /* [rsp+32] = dwCreationFlags = 0 (rcx=0) */
                移栈寄存器64(40, 1); /* [rsp+40] = lpThreadId = 空 */
                调导入(8); /* 创建线程 */
                加栈即(48);
                移64(4, 15); 弹栈寄存器(15);
                整联一(14, 0); /* *&t = 堆九 = 句柄 */
