                整 构呼 = 建节(4);
                { 整 构变 = 建节(1); 复制内存((字*)(节名表 + 构变), 结构化线程[构层][构计], 32);
                  整 构址 = 建节(11); 接子(构址, 构变); 接子(构呼, 构址); } /* &t */
                { 整 构函 = 建节(1); 复制内存((字*)(节名表 + 构函), "thread_join", 12); 接子(构呼, 构函); } /* thread_join(&t) */
                接子(构块, 构呼);
