        词位++;
        若 (词型表[词位] == 串词) { 拼前n(缓, 串表[词值表[词位]], 4095 - (整)取字长(缓)); 词位++; }
        否 若 (词型表[词位] == 词变量 && 首进(词名表[词位])) { 字 暂存[4096]; 初进(词名表[词位], 暂存, 大小(暂存)); 拼前n(缓, 暂存, 4095 - (整)取字长(缓)); 词位++; }
        否 若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "串")) { /* 串(n): 整数 → 十进制串 */
            词位++; 若 (词型表[词位] == 左括) 词位++;
            整 值 = 0; 若 (!常量表达式求值(&值)) { 词位 = 主戌; 返 0; }
