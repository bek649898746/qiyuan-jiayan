            整 元 = 计 + 1; 循环 (串值[元] == ' ' || 串值[元] == '\t') 元++; /* fix 2026-08-13 Phase3: # 后空白 (glibc 缩进指令 #  define) */
            整 内戊 = ((!比前n(串值 + 元, "define", 6) && (串值[元 + 6] == 0 || 串值[元 + 6] == ' ' || 串值[元 + 6] == '\t' || 串值[元 + 6] == '\r' || 串值[元 + 6] == '\n')) || (!比前n(串值 + 元, "定义词", 9) && (串值[元 + 9] == 0 || 串值[元 + 9] == ' ' || 串值[元 + 9] == '\t' || 串值[元 + 9] == '\r' || 串值[元 + 9] == '\n')));
            整 是否条件编译 = ((!比前n(串值 + 元, "ifdef", 5) && (串值[元 + 5] == 0 || 串值[元 + 5] == ' ' || 串值[元 + 5] == '\t' || 串值[元 + 5] == '\r' || 串值[元 + 5] == '\n')) || (!比前n(串值 + 元, "若有定义", 12) && (串值[元 + 12] == 0 || 串值[元 + 12] == ' ' || 串值[元 + 12] == '\t' || 串值[元 + 12] == '\r' || 串值[元 + 12] == '\n')));
            整 外二 = ((!比前n(串值 + 元, "ifndef", 6) && (串值[元 + 6] == 0 || 串值[元 + 6] == ' ' || 串值[元 + 6] == '\t' || 串值[元 + 6] == '\r' || 串值[元 + 6] == '\n')) || (!比前n(串值 + 元, "若无定义", 12) && (串值[元 + 12] == 0 || 串值[元 + 12] == ' ' || 串值[元 + 12] == '\t' || 串值[元 + 12] == '\r' || 串值[元 + 12] == '\n')));
            整 序粗 = !比前n(串值 + 元, "if", 2) && !是否条件编译 && !外二 && (串值[元 + 2] == 0 || 串值[元 + 2] == ' ' || 串值[元 + 2] == '\t' || 串值[元 + 2] == '\r' || 串值[元 + 2] == '\n');
            整 下环 = !比前n(串值 + 元, "elif", 4) && (串值[元 + 4] == 0 || 串值[元 + 4] == ' ' || 串值[元 + 4] == '\t' || 串值[元 + 4] == '\r' || 串值[元 + 4] == '\n');
            整 短再 = !比前n(串值 + 元, "else", 4) && (串值[元 + 4] == 0 || 串值[元 + 4] == ' ' || 串值[元 + 4] == '\t' || 串值[元 + 4] == '\r' || 串值[元 + 4] == '\n');
            整 短叁 = ((!比前n(串值 + 元, "endif", 5) && (串值[元 + 5] == 0 || 串值[元 + 5] == ' ' || 串值[元 + 5] == '\t' || 串值[元 + 5] == '\r' || 串值[元 + 5] == '\n')) || (!比前n(串值 + 元, "结束若", 9) && (串值[元 + 9] == 0 || 串值[元 + 9] == ' ' || 串值[元 + 9] == '\t' || 串值[元 + 9] == '\r' || 串值[元 + 9] == '\n')));
            整 高属 = !比前n(串值 + 元, "undef", 5) && (串值[元 + 5] == 0 || 串值[元 + 5] == ' ' || 串值[元 + 5] == '\t' || 串值[元 + 5] == '\r' || 串值[元 + 5] == '\n');
            整 终七 = !比前n(串值 + 元, "error", 5) && (串值[元 + 5] == 0 || 串值[元 + 5] == ' ' || 串值[元 + 5] == '\t' || 串值[元 + 5] == '\r' || 串值[元 + 5] == '\n');
            若 (序粗 || 是否条件编译 || 外二 || 下环 || 短再 || 短叁) {
                整 父节 = 顺一;
                字 表达式[512]; 整 戊序 = 0;
                若 (序粗 || 下环) {
                    整 指 = 元;
                    若 (序粗) 指 += 2; 否 指 += 4;
                    循环 (串值[指] == ' ' || 串值[指] == '\t') 指++;
                    循环 (串值[指] && 戊序 < 510) { 若 (串值[指] == '\\' && (串值[指 + 1] == '\n' || (串值[指 + 1] == '\r' && 串值[指 + 2] == '\n'))) { 指 += (串值[指 + 1] == '\r' ? 3 : 2); 表达式[戊序++] = ' '; 续; } 若 (串值[指] == '\n') 断; 表达式[戊序++] = 串值[指++]; } /* fix 2026-08-26 redis: #if/#elif 表达式反斜杠续行 (atomicvar.h `#elif ... && \` 跨 3 行 — 原只读首行 → 条件残缺 → #error) */
                    循环 (戊序 > 0 && (表达式[戊序-1] == ' ' || 表达式[戊序-1] == '\t')) 戊序--; /* trim trailing (fix 2026-08-05: "#if VER > 1" left "VER " → macro lookup failed) */
                }
