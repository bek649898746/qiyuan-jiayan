            遍 (整 计 = 0; 计 <= 末位; 计++) 计庚[计] = 取子(数, 计);
            整 参数个数 = 0;
            遍 (整 计 = 0; 计 <= 末位; 计++) { 整 字符 = 计庚[计]; 若 (字符 == 函 || 字符 < 0) 续; 参数个数++; }
