        } 否 {  断; } 
    }
    返 指;
}

/* ?????? ??????: AST ??x86-64 machine code ?????? */
静 空 码生成(整 数);
静 空 码生成浮(整 数); /* emit xmm0 = double value of expr n */

/* xmm0 = double value of an expression (float var/literal/arith, or int→cvtsi2sd) */
静 空 码生成浮(整 数) {
    若 (数 < 0) 返;
    整 暂 = 节型表[数];
    若 (暂 == 1) { /* identifier */
        字 *变节 = (字*)(节名表 + 数);
        整 偏移 = 查变量(变节);
        若 (变量是否浮(变节)) {
            若 (变量是否静态(变节)) { 右再(静态位移(偏移, 2) - 2); } /* static double via RIP (8-byte movsd: stc_disp is 6-byte-based) */
            否 逆厚(偏移 - 当前帧大小);
        } 否 {
            若 (变量是否静态(变节)) 移eax内存(静态位移(偏移, 0)); /* static int var via RIP (6-byte mov: stc_disp direct) */
            否 移寄存器帧(0, 偏移 - 当前帧大小); /* int var → eax */
            旧挂();
        }
        返;
    }
    若 (暂 == 终简) { 码生成(数); 返; } /* FP literal → movsd xmm0 (cg case-FP) */
    若 (暂 == 0) { 码生成(数); 旧挂(); 返; } /* int imm → convert */
    若 (暂 == 4) { /* function call: double-returning callee leaves xmm0; int callee → convert */
        字 *存分 = NULL;
        遍 (整 计 = 19; 计 >= 0; 计--) { 整 字符 = 取子(数, 计); 若 (字符 >= 0 && 节型表[字符] == 1) { 存分 = (字*)(节名表 + 字符); 断; } }
        码生成(数); /* emits the call */        若 (存分 && 查函数浮返(存分)) { /* known double-returning callee: xmm0 already holds it */
        } 否 若 (节浮标[数]) { /* marked double call (incl. fnptr): leave xmm0 as-is */
        } 否 旧挂();
        返;
    }
    若 (暂 == 2) { /* binary */
        整 丙 = 节值表[数];
        若 (节浮标[子0[数]] || 节浮标[子1[数]]) { /* floating sub-expr */
            码生成浮(子0[数]); 压浮0();
            码生成浮(子1[数]); 短弊(); 弹浮0();
            若 (丙 == 加) 总辛一();
            否 若 (丙 == 减) 整进();
            否 若 (丙 == 乘) 容甲();
            否 若 (丙 == 除) 末一一();
            返;
        }
        码生成(数); 旧挂();
        返;
    }
    若 (暂 == 15) { /* member: double field x.d → movsd; int field → convert */
        字 *变节 = (字*)(节名表 + 子0[数]);
        整 偏移 = 查变量(变节);
        整 构序 = 变量型序(变节);
        整 域偏移 = 构序 >= 0 ? 类型偏移(类型表[构序].名, (字*)(节名表 + 数)) : -1;
        若 (域偏移 >= 0 && 字段是否浮(类型表[构序].名, (字*)(节名表 + 数))) {
            若 (节值表[数] == 1) { /* ptr->field: load pointer, +fo, deref */
                若 (偏移 >= 0) { 若 (变量是否静态(变节)) 移rax内存64(静态位移(偏移, 1) - 1); /* static struct ptr: 8B .data slot via RIP */
                               否 若 (变量指元素(变节) > 0) 移寄存器帧64(0, 偏移 - 当前帧大小); 否 移寄存器帧(0, 偏移 - 当前帧大小); }
                若 (域偏移 != 0) 后弊一(域偏移);
                汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); /* movsd xmm0, [rax] */
            } 否 {
                若 (变量是否静态(变节)) 右再(静态位移(偏移, 2) + 域偏移 - 2); /* static struct.d field via RIP (8-byte movsd) */
                否 若 (素系(变节)) { 移寄存器帧64(0, 偏移 - 当前帧大小); 若 (域偏移 != 0) 后弊一(域偏移); 汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); } /* big struct param: slot holds ptr → ptr+fo, movsd [rax] (fix 2026-08-07) */
                否 逆厚(偏移 - 类型表[构序].尺寸 + 域偏移 - 当前帧大小);
            }
            返;
        }
    }
    若 (节浮标[数]) { 码生成(数); 返; } /* double node (array elem/var/field/call): cg leaves result in xmm0 */
    若 (暂 == 22) { /* double 三元 (fix 2026-08-25 step14): 分支求值到 xmm0 — 原 fallback cg(n)+cvtsi2sd 用 eax (比较标志) 覆盖 xmm0 */
        整 毛环 = 新标号(), 虚对 = 新标号();
        码生成(子0[数]); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 毛环, 1); /* 条件假 → lf2 */
        码生成浮(子1[数]); 相对跳转(-1); 补标号(码位 - 4, 虚对, 2);
        设标号(毛环);
        码生成浮(子2[数]);
        设标号(虚对);
        返;
    }
    码生成(数); 旧挂(); /* fallback */
}

/* ?????? ?????? */
静 整 外陆一(整 序标);
静 整 标劣(整 序标);


/* printf/fprintf/putstr: build output into a frame scratch buffer, then WriteFile.
   r10=handle r11=fmt r12=buf(advancing) r14=buf(start) r13=next-format-arg ptr.
   No calls until the final WriteFile, so volatile registers are safe throughout. */
静 整 度壬(整 总伍);
/* fix 2026-08-25 支持矩阵补全: %e/%E/%g/%G 科学/通用浮点格式化 (letter 在 sc+236, is_g 在 sc+24
   由 emit_fmt_loop 分发存根在运行时设置; 每 printf 调用只发射一份核心). 64-bit scale/fracN 支持 %.16g. */
静 空 正败(整 号分);
静 空 短组(整 暂终, 整 号分);
/* fix 2026-08-23 t35e: vsnprintf walks its va_list UP (ap, ap+8, ...); printf/sprintf walk
   the pushed arg table DOWN. emit_vsnprintf sets this so the fmt_loop advances r13 by +8. */
静 整 素组 = 0;
静 空 移即扩(整 寄存器, 整 立即数); /* high-reg immediate mov (defined near CRT stub) */
/* bit-field codegen helpers (real bit semantics, fix 2026-08-05).
   A bit-field lives inside a shared 32-bit slot: foffs = slot byte offset,
   fbitof = bit offset in the slot, fbits = width. All slot traffic is 4-byte. */
静 空 中升(整 寄存器, 整 计数二) { /* shl r32, cl  (cnt compile-time 0..31) */
    若 (计数二 <= 0) 返;
    移即扩(9, 计数二);
    移寄存器(1, 9); /* ecx = cnt */
    汇发("    左移 r%d, cl\n", (字*)(长 长)(寄存器), (字*)(长 长)0, (字*)(长 长)0);
    前缀字节(0, 0, 0, 寄存器 & 8); 发字节(0xD3); 模字节(3, 4, 寄存器 & 7);
}
静 空 副降(常 字 *符号数, 常 字 *函) {
    /* eax = whole slot value → eax = field value (shr + and; signed fields sign-extend). */
    整 缺繁 = 字段位宽(符号数, 函);
    若 (缺繁 <= 0) 返;
    整 正厚 = 暂进(符号数, 函);
    整 掩码 = 缺繁 >= 32 ? -1 : (1u << 缺繁) - 1; /* fix 2026-08-09 审计: 1<<31 是有符号溢出 UB, 改 1u */
    若 (正厚 == 0) { 移即扩(9, 掩码); 算寄存器(25, 0, 9); } /* eax &= mask */
    否 {
        移寄存器(10, 0); /* r10d = slot value */
        移即扩(9, 正厚);
        移寄存器(0, 9); /* eax = bit offset (shift count) */
        原七 = 1;
        算寄存器(帧寅, 10, 0); /* r10d >>= cl (logical) */
        移寄存器(0, 10); /* eax = shifted field value */
        移即扩(9, 掩码);
        算寄存器(25, 0, 9); /* eax &= mask */
    }
    若 (缺繁 < 32 && !字段是否无符号(符号数, 函)) { /* signed bit-field: sign-extend (fix 2026-08-05) */
        移寄存器(10, 0); /* r10d = masked field value */
        移即扩(9, 32 - 缺繁);
        移寄存器(0, 9); /* eax = 32-bw (shift count) */
        算寄存器(号庚, 10, 0); /* r10d <<= cl → sign bit lands in bit 31 */
        原七 = 0; /* arithmetic shift for signed fields */
        算寄存器(帧寅, 10, 0); /* r10d >>= cl (sar) → sign-extended */
        移寄存器(0, 10); /* eax = result */
    }
}
静 整 存壬(常 字 *符号数, 常 字 *函) {
    /* rax = &slot, ebx = rhs value → read-modify-write the field bits.
       Returns 1 when handled (a bit-field), 0 for a plain field.
       NEVER write eax here: eax is the low 32 bits of rax, and rax holds the
       slot ADDRESS — writing eax zeroes the upper half and loses the address. */
    整 缺繁 = 字段位宽(符号数, 函);
    若 (缺繁 <= 0) 返 0;
    整 正厚 = 暂进(符号数, 函);
    整 长汇 = 缺繁 >= 32 ? -1 : ((1u << 缺繁) - 1) << 正厚; /* fix 2026-08-09 审计: 1u 防有符号溢出 */
    移寄存器内存(10, 0); /* r10d = [rax] = old slot (rax keeps the address) */
    移寄存器(11, 3); /* r11d = rhs */
    中升(11, 正厚); /* r11d <<= bitof */
    移即扩(9, 长汇);
    算寄存器(25, 11, 9); /* r11d &= field-bits mask */
    移即扩(9, ~长汇);
    算寄存器(25, 10, 9); /* r10d &= ~field-bits mask (clear field bits) */
    算寄存器(47, 10, 11); /* r10d |= r11d */
    汇发("    存32rax r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 1, 0, 0); 发字节(0x89); 模字节(0, 2, 0); /* MOV [rax], r10d */
    返 1;
}
静 空 缺对(常 字 *串升, 整 参数个数) {
    整 逆成 = !比较字符串(串升, "fprintf");
    整 现伍二 = !比较字符串(串升, "putstr");
    整 短排 = 逆成 ? 2 : 1;
    /* kernel32 (WriteFile) requires rsp 16-byte aligned at the call (SSE).
       Compute the format-arg pointer from the PRE-alignment rsp (the pushed args sit
       at the pre-alignment position); r15 is callee-saved so kernel32 preserves it. */
    左壬一(13, 8 * (参数个数 - 1 - 短排)); /* r13 = &first format arg (pre-alignment rsp) */
    移64(15, 4); /* mov r15, rsp */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp, -16 */
    /* save fmt BEFORE GetStdHandle clobbers rcx. The fmt slot is at the PRE-alignment
       position: for printf it's arg0 (still in rcx); for fprintf it's arg1 = [r13+8]
       (r13 is a pre-alignment address, immune to the `and rsp,-16` shift).
       IMPORTANT: the fmt must NOT be parked in the stack shadow space ([rsp+8..32]
       at the call) �?kernel32 owns that region and clobbers it. rbx is callee-saved,
       preserved by GetStdHandle, and restored by the epilogue, so it's a safe slot. */
    若 (逆成) {
        汇发("    取64 r0, [r13+8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x45); 发字节(8); /* mov rax, [r13+8] = fmt (arg1) */
        移64(3, 0);    /* rbx = fmt (callee-saved, survives calls) */
        /* fix 2026-08-19: fprintf 必须写 FILE* 而非 stdout — git create_symref_locked
           fprintf(get_lock_file_fp(&lock->lk), "ref: %s\n", target) 曾全部打进 stdout
           → HEAD.lock 空/HEAD 空/残留 .lock。分派 (r10=目标, sc+248=is_fd 标志):
           fp==0 → stdout (self-host 的 stderr 值被置 0, 保持旧行为);
           fp<0x10000 → qcc fopen 的 HANDLE → WriteFile(fp,...);
           fp≥0x10000 → msvcrt fdopen 的 CRT FILE* → 取 _iobuf._file(fd)@+28 → _write(fd,...). */
        整 首细 = 新标号(), 总酉 = 新标号(), 计丙 = 新标号();
        移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 248, 0); /* is_fd = 0 — 必须先存 (mov_r_imm 会清 rax) */
        汇发("    取64 r0, [r13+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x45); 发字节(16); /* mov rax, [r13+16] = fp (arg0; [r13]=首变参, [r13+8]=fmt) */
        测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 首细, 3);
        /* fp == 0 → stdout */
        移即(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
        减栈即(32);
        调导入(0);       /* GetStdHandle */
        加栈即(32);
        移64(10, 0);   /* r10 = handle */
        相对跳转(-1); 补标号(码位 - 4, 计丙, 2);
        设标号(首细);
        汇发("    比较64 r0, 0x10000\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x3D); 发四(0x10000); /* cmp rax, 0x10000 */
        发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 总酉, 8); /* jb → HANDLE */
        /* CRT FILE* (msvcrt fdopen): _iobuf._file (fd) @ +28 (实测 msvcrt _iob: off=28 val=fd; UCRT 才是 24 — git 链 msvcrt; fix 2026-08-19) */
        发字节(0x8B); 发字节(0x40); 发字节(28); /* mov eax, [rax+28] */
        移64(10, 0);   /* r10 = fd */
        移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 248, 0); /* is_fd = 1 */
        相对跳转(-1); 补标号(码位 - 4, 计丙, 2);
        设标号(总酉);
        移64(10, 0);   /* r10 = fp (qcc fopen HANDLE) */
        设标号(计丙);
    } 否 {
        移64(0, 1); /* rax = rcx = fmt (arg0) */
        移64(3, 0);    /* rbx = fmt (callee-saved — survives GetStdHandle) */
        移即(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
        减栈即(32);   /* shadow space for GetStdHandle — fix 2026-08-03: was missing (ABI requires 32B) */
        调导入(0);       /* eax = handle */
        加栈即(32);
        移64(10, 0);   /* r10 = handle */
    }
    移64(11, 3);   /* r11 = fmt */
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = buf — 缓冲下移到状态区之下 [rbp-4368] (fix 2026-08-06: 原与状态槽/&written 重叠) */
    移64(14, 12);  /* r14 = buf start */
    整 段辰;
    若 (现伍二) {
        整 半拆 = 新标号();
        段辰 = 新标号();
        设标号(半拆);
        汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] */
        测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 段辰, 1);
        现午(); /* mov [r12], cl */
        汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
        汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
        相对跳转(-1); 补标号(码位-4, 半拆, 2);
    } 否 {
        段辰 = 度壬(-272); /* printf/putstr 链：%s 拷贝以 rbp-272 为界（H2 fix 2026-08-06） */
    }
    设标号(段辰);
    /* len = r12 - r14 */
    移64(0, 12); 汇发("    减64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3, 6, 0); /* sub rax, r14 */
    移寄存器(8, 0); /* r8 = len */
    若 (满双) { /* fix 2026-08-10 Gate 9: bin printf -> ���� COM1 0x3F8, �� kernel32 */
        整 单败一 = 新标号(), 长己 = 新标号(), 缓三 = 新标号();
        设标号(单败一);
        测寄存器(8, 8); 零跳(-1); 补标号(码位-4, 缓三, 1);
        设标号(长己);
        移即(2, 0x3FD); /* THR status reg */
        汇发("    ���˿� al, dx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xEC); /* in al, dx */
        发字节(0xA8); 发字节(0x20); /* test al, 0x20 (THRE) */
        零跳(-1); 补标号(码位-4, 长己, 1);
        前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 6); /* mov al, [r14] */
        移即(2, 0x3F8);
        汇发("    д�˿� dx, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xEE); /* out dx, al */
        汇发("    ���� r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 6); /* inc r14 */
        前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 0); /* dec r8d */
        相对跳转(-1); 补标号(码位-4, 单败一, 2);
        设标号(缓三);
    } 否 {
    减栈即(32);
    整 存次 = -1;
    若 (逆成) {
        /* is_fd(sc+248)==1 -> msvcrt _write(fd, buf, len); else WriteFile(handle, buf, len, &written, NULL) (fix 2026-08-19) */
        整 邻失 = 新标号();
        存次 = 新标号();
        移寄存器帧(0, 临时基 - 当前帧大小 + 248); /* eax = is_fd */
        测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 邻失, 1);
        减栈即(32); /* shadow space for _write */
        移64(1, 10); /* rcx = fd */
        移64(2, 14); /* rdx = buf */
        /* r8 = len already */
        若 (链接模式) {
            发字节(0xE8); 发四(0); /* call rel32 - jyld resolves _write -> msvcrt import */
            缺亥(码位 - 4, 0x0004, 新又("_write"), 0);
        } 否 {
            调导入(41); /* _write IAT slot (msvcrt, 2026-08-28 P1 #246: kernel32 15→17 → _write 39→41) */
        }
        加栈即(32);
        相对跳转(-1); 补标号(码位 - 4, 存次, 2);
        设标号(邻失);
    }
    移64(1, 10); /* rcx = handle */
    移64(2, 14); /* rdx = buf */
    取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &written */
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 0 (8-byte NULL overlapped - arg5 at [rsp+32] per real ABI) */
    调导入(1);       /* WriteFile */
    加栈即(32);
    若 (逆成) 设标号(存次);
    }
    移64(4, 15); /* mov rsp, r15 �?restore original stack position */
}
静 空 标得(整 参数个数) {
    
    /* fix 2026-08-23 t49e: vfprintf(fp, fmt, args) - fp is the qcc standard stream
       (0=stdout/stderr macro) -> route through WriteFile(GetStdHandle) exactly like the
       fprintf builtin. Direct msvcrt vfprintf(fp=0) crashes inside RtlEnterCriticalSection
       (color_vfprintf -> vfprintf(s->fp=stdout=0) -> status --short SEGV).
       Args already pushed (qcc right-to-left: args, fmt, fp) so the pre-aligned rsp holds
       [rsp]=fp, [rsp+8]=fmt, [rsp+16]=args. r15 is callee-saved (kernel32 preserves it). */
    整 首细 = 新标号(), 总酉 = 新标号(), 计丙 = 新标号();
    移64(15, 4); /* mov r15, rsp (pre-alignment) */
    若 (参数个数 == 3) {
        /* va_list case (color_vfprintf -> vfprintf(fp, fmt, args)): qcc pushes arg0 first (highest addr)
           -> [r15+16]=fp, [r15+8]=fmt, [r15]=args */
        汇发("    \xe5\x8f\x96 64 r0, [r15+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(16); /* mov rax, [r15+16] = fp */
        汇发("    \xe5\x8f\x96 64 r0, [r15]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(0); /* mov rax, [r15] = args */
        移64(13, 0); /* r13 = args (va_list) */
    } 否 {
        /* varargs call: [r15+8*(nargs-1)]=fp, [r15+8*(nargs-2)]=fmt, varargs start at [r15+8*(nargs-3)] */
        汇发("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (参数个数 - 1)), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(8 * (参数个数 - 1) & 0xff); /* mov rax, [r15+8*(nargs-1)] = fp */
        左壬一(13, 8 * (参数个数 - 3)); /* r13 = &first vararg */
    }
    汇发("    \xe5\xaf\xb9\xe9\xbd\x90\xe6\xa0\x88\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp, -16 */
    /* fmt -> rbx (callee-saved, survives GetStdHandle); fp stays in rax for dispatch */
    若 (参数个数 == 3) {
        汇发("    \xe5\x8f\x96 64 r0, [r15+8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(8); /* mov rax, [r15+8] = fmt */
        移64(3, 0); /* rbx = fmt */
        汇发("    \xe5\x8f\x96 64 r0, [r15+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(16); /* mov rax, [r15+16] = fp */
    } 否 {
        汇发("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (参数个数 - 2)), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(8 * (参数个数 - 2) & 0xff); /* mov rax, [r15+8*(nargs-2)] = fmt */
        移64(3, 0); /* rbx = fmt */
        汇发("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (参数个数 - 1)), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(8 * (参数个数 - 1) & 0xff); /* mov rax, [r15+8*(nargs-1)] = fp */
    }
    /* fp dispatch: fp==0 -> stdout (GetStdHandle); fp<0x10000 -> qcc fopen HANDLE; else CRT FILE* -> _file fd */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 248, 0); /* is_fd = 0 */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 首细, 3);
    移即(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
    减栈即(32); 调导入(0); 加栈即(32); /* GetStdHandle */
    移64(10, 0); /* r10 = handle */
    相对跳转(-1); 补标号(码位 - 4, 计丙, 2);
    设标号(首细);
    汇发("    \xe6\xaf\x94\xe8\xbe\x83 64 r0, 0x10000\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x3D); 发四(0x10000); /* cmp rax, 0x10000 */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 总酉, 8); /* jb -> HANDLE */
    发字节(0x8B); 发字节(0x40); 发字节(28); /* mov eax, [rax+28] = _file fd */
    移64(10, 0); /* r10 = fd */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 248, 0); /* is_fd = 1 */
    相对跳转(-1); 补标号(码位 - 4, 计丙, 2);
    设标号(总酉);
    移64(10, 0); /* r10 = fp (HANDLE) */
    设标号(计丙);
    移64(11, 3); /* r11 = fmt */
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = buf */
    移64(14, 12); /* r14 = buf start */
    整 段辰 = 度壬(-272);
    设标号(段辰);
    /* len = r12 - r14 */
    移64(0, 12); 汇发("    \xe5\x87\x8f 64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3, 6, 0); /* sub rax, r14 */
    移寄存器(8, 0); /* r8 = len */
    减栈即(32);
    整 邻失 = 新标号();
    整 存次 = 新标号();
    移寄存器帧(0, 临时基 - 当前帧大小 + 248); /* eax = is_fd */
    测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 邻失, 1);
    减栈即(32); /* shadow space for _write */
    移64(1, 10); /* rcx = fd */
    移64(2, 14); /* rdx = buf */
    若 (链接模式) { 发字节(0xE8); 发四(0); 缺亥(码位 - 4, 0x0004, 新又("_write"), 0); }
    否 调导入(41); /* _write (2026-08-28 P1 #246: 39→41) */
    加栈即(32);
    相对跳转(-1); 补标号(码位 - 4, 存次, 2);
    设标号(邻失);
    移64(1, 10); /* rcx = handle */
    移64(2, 14); /* rdx = buf */
    取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &written */
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 0 overlapped */
    调导入(1); /* WriteFile */
    加栈即(32);
    设标号(存次);
    移64(4, 15); /* mov rsp, r15 */
}


/* fix 2026-08-12 scanf: args already pushed (fmt first, then &a, &b...).
   Read stdin (GetStdHandle(-10) + ReadFile) into [rbp-4368] buf, then call
   _scanf_rt(fmt, args, buf, len) from qcc_rt.c to parse fmt and write back.
   Returns count of converted items in eax. */
静 空 前子(整 参数个数) {
    整 总辛 = 查函数("_scanf_rt");
    左壬一(13, 8 * (参数个数 - 1)); /* r13 = &fmt (arg0, pushed first = deepest; args at [r13+8..]) */
    移64(15, 4); /* r15 = pre-alignment rsp */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp, -16 */
    移即(1, -10); /* ecx = -10 = STD_INPUT_HANDLE */
    减栈即(32);
    调导入(0); /* eax = stdin handle */
    加栈即(32);
    移64(10, 0); /* r10 = handle */
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = buf (callee-saved — ReadFile clobbers r11, 同 printf) */
    取帧址(9, 临时基 + 240 - 当前帧大小);   /* r9 = &read */
    减栈即(48);
    移64(1, 10); 移64(2, 12);
    移即扩(8, 4096);
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 0 (overlapped) */
    调导入(3); /* ReadFile */
    加栈即(48);
    移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* eax = bytes read */
    移64(9, 0); /* r9 = len */
    汇发("    取64 r1, [r13]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x4D); 发字节(0); /* rcx = fmt */
    /* 构造正序 args 数组到 [rbp+aoff]: args[k] = [r13-8-8k] 槽值 (参数按 fmt,&a,&b 压栈 → &a 在 [r13-8], &b 在 [r13-16]...).
       负索引 args[-argi] 在 qcc 编译会丢符号 (2026-08-12) → 显式正序拷贝. */
    { 整 元平 = -(272 + 8 * 参数个数);
      遍 (整 键 = 0; 键 < 参数个数 - 1; 键++) {
          汇发("    取64 r0, [r13%+d]\n", (字*)(长 长)(-(8 + 8 * 键)), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x45); 发字节(-(8 + 8 * 键)); /* mov rax, [r13-8-8k] */
          汇发("    存64 [rbp%+d], r0\n", (字*)(长 长)(元平 + 8 * 键), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x89); 模字节(2, 0, 5); 发四(元平 + 8 * 键); /* mov [rbp+aoff+8k], rax */
      }
      取帧址(2, 元平); /* rdx = args 数组 */
    }
    移64(8, 12); /* r8 = buf */
    若 (总辛 >= 0) { /* _scanf_rt(fmt=rcx, args=rdx, buf=r8, len=r9, consumed=NULL) */
        减栈即(48); /* shadow 32 + 5th arg 8 + pad 8 */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = NULL (consumed 不需要 — scanf 无续读) */
        相对调用(0);
        补标号(码位 - 4, 函数表[总辛].标号一, 0);
        加栈即(48);
    }
    移64(4, 15); /* rsp = r15 (restore pre-alignment) */
}

/* sscanf(str, fmt, &a, ...): buf=arg0, fmt=arg1, args=arg2.. — 复用 _scanf_rt(fmt,args,buf,len) (fix 2026-08-25 step11) */
静 空 右轮(整 参数个数) {
    整 总辛 = 查函数("_scanf_rt");
    整 反丁 = 8 * (参数个数 - 1); /* arg0 槽偏移 (rsp 相对): 参数从栈深向浅 arg0=[rsp+abase], arg1=[rsp+abase-8], arg2+k=[rsp+abase-16-8k] */
    移64(15, 4); /* r15 = pre-alignment rsp */
    移寄存器栈64(8, 反丁);      /* r8 = arg0 (str/buf) */
    /* r9 = strlen(str): r8 扫描到 \0 */
    移64(11, 8); /* r11 = buf 保存 */
    移即(0, 0); /* eax = 0 (len) */
    整 净对 = 新标号(), 虚对 = 新标号();
    设标号(净对);
    汇发("    零扩展 ecx, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 0); /* movzx ecx, byte [r8] */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 虚对, 1);
    汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 1); 发字节(0xFF); 模字节(3, 0, 0); /* inc r8 */
    汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC0); /* inc eax */
    相对跳转(-1); 补标号(码位-4, 净对, 2);
    设标号(虚对);
    移64(9, 0);  /* r9 = len */
    移64(8, 11); /* r8 = buf (恢复) */
    移寄存器栈64(1, 反丁 - 8);  /* rcx = arg1 (fmt) */
    /* args 数组: arg2+k = [rsp+abase-16-8k] → [rbp+aoff+8k] */
    { 整 元平 = -(272 + 8 * (参数个数 - 2));
      遍 (整 键 = 0; 键 < 参数个数 - 2; 键++) {
          移寄存器栈64(0, 反丁 - 16 - 8 * 键); /* rax = arg2+k */
          汇发("    存64 [rbp%+d], r0\n", (字*)(长 长)(元平 + 8 * 键), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x89); 模字节(2, 0, 5); 发四(元平 + 8 * 键); /* mov [rbp+aoff+8k], rax */
      }
      取帧址(2, 元平); /* rdx = args */
    }
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp,-16 */
    减栈即(48);
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = NULL (consumed — sscanf 无续读) */
    若 (总辛 >= 0) { 相对调用(0); 补标号(码位 - 4, 函数表[总辛].标号一, 0); }
    加栈即(48);
    移64(4, 15); /* rsp = r15 */
}

/* fscanf(fp, fmt, &a, ...): 从 FILE*(HANDLE) 读 4096 字节到 buf, 复用 _scanf_rt (fix 2026-08-25 step12)
   续读 (fix step23): _scanf_rt 报告 consumed, 未消费部分 SetFilePointer 回退 — 多次 fscanf 同 FILE* 连续解析 */
静 空 域七(整 参数个数) {
    整 总辛 = 查函数("_scanf_rt");
    整 反丁 = 8 * (参数个数 - 1); /* arg0 = fp, arg1 = fmt, arg2+k = args (rsp 相对) */
    移寄存器栈64(0, 反丁); /* rax = arg0 (fp/handle) */
    移64(10, 0);          /* r10 = handle */
    反附(临时基 + 260 - 当前帧大小, 10); /* 保存 handle 到 scratch (8B, 独立槽 — 原 252 与 consumed@256 重叠高32位被污染) */
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = buf */
    取帧址(9, 临时基 + 240 - 当前帧大小);   /* r9 = &read */
    移64(15, 4);
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp,-16 */
    减栈即(48); /* shadow 32 + 1 stack arg 8 + pad 8 */
    移64(1, 10); 移64(2, 12);
    移即扩(8, 4096);
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = NULL (overlapped) */
    调导入(3); /* ReadFile */
    加栈即(48);
    移64(4, 15);
    移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* eax = bytes read */
    汇发("    存32 [rbp%+d], eax\n", (字*)(长 长)(临时基 + 248 - 当前帧大小), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x89); 模字节(2, 0, 5); 发四(临时基 + 248 - 当前帧大小); /* 存 bytes_read 供回退计算 (fix step23; modrm rm=5=rbp 非 rax) */
    移64(9, 0);  /* r9 = len */
    移64(8, 12); /* r8 = buf */
    移寄存器栈64(1, 反丁 - 8);  /* rcx = fmt (arg1) */
    { 整 元平 = -(272 + 8 * (参数个数 - 2));
      遍 (整 键 = 0; 键 < 参数个数 - 2; 键++) {
          移寄存器栈64(0, 反丁 - 16 - 8 * 键); /* rax = arg2+k */
          汇发("    存64 [rbp%+d], r0\n", (字*)(长 长)(元平 + 8 * 键), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x89); 模字节(2, 0, 5); 发四(元平 + 8 * 键); /* mov [rbp+aoff+8k], rax */
      }
      取帧址(2, 元平); /* rdx = args */
    }
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp,-16 */
    减栈即(48);
    取帧址(0, 临时基 + 256 - 当前帧大小); 移栈寄存器64(32, 0); /* [rsp+32] = &consumed (5th arg, fix step23) */
    若 (总辛 >= 0) { 相对调用(0); 补标号(码位 - 4, 函数表[总辛].标号一, 0); }
    加栈即(48);
    /* 保存 fscanf 返回值 (eax=argi) — 后续回退计算会破坏 eax (fix step23: 原 n=0 / SetFilePointer 返回值覆盖) */
    汇发("    存32 [rbp%+d], eax\n", (字*)(长 长)(临时基 + 244 - 当前帧大小), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x89); 模字节(2, 0, 5); 发四(临时基 + 244 - 当前帧大小);
    /* 续读回退: leftover = bytes_read - consumed; leftover>0 时 SetFilePointer(handle, -leftover, NULL, FILE_CURRENT=1) — 未消费字节下次 fscanf 重新读到 (fix step23) */
    移寄存器帧64(0, 临时基 + 260 - 当前帧大小); 移64(10, 0); /* r10 = handle (从独立槽重载 — r10 易失且对齐后栈槽偏移) */
    移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* eax = bytes_read */
    移寄存器帧(1, 临时基 + 256 - 当前帧大小); /* ecx = consumed */
    汇发("    减 r0, r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x29); 模字节(3, 1, 0); /* sub eax, ecx → leftover */
    { 整 外八 = 新标号();
      测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 外八, 1); /* leftover==0 → 跳过回退 */
      汇发("    取反 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xD8); /* neg eax → -leftover */
      移64(1, 10);  /* rcx = handle */
      移64(2, 0);   /* rdx = -leftover (回退距离) */
      移即扩(8, 0); /* r8 = NULL (lpDistanceToMoveHigh) */
      移即扩(9, 1); /* r9 = FILE_CURRENT */
      汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp,-16 */
      减栈即(32);
      调导入(5); /* SetFilePointer */
      加栈即(32);
      设标号(外八);
    }
    移寄存器帧(0, 临时基 + 244 - 当前帧大小); /* eax = 恢复 fscanf 返回值 (fix step23) */
    移64(4, 15); /* rsp = r15 */
}

/* shared %d/%s/%c/%% format loop: r11=fmt r12=out(advancing) r13=next-arg ptr.
   Returns the ldone label the caller must set_label() after the loop. */
/* shared decimal-digit emitter: prints |ebx| (with '-' sign) into the r12 buffer,
   then jumps to `tail`. Used by %d (tail=lfmt) and %f (tail=lfnum fractional path). */
静 空 域重一(整 号分) {
    整 空八一 = 新标号(), 净从 = 新标号(), 首甲 = 新标号(), 间寅 = 新标号(); /* fix 2026-08-23 t35g */
    取帧址(8, 临时基 + 248 + 12 - 当前帧大小); /* r8 = digit temp end */
    移64(9, 8); /* r9 = temp end (advancing) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 4); /* eax = sign_done (fix 2026-08-23 t35g: ld 已提前输出) */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 空八一, 1); /* sign 已输出 → 直接数字 */
    测寄存器(3, 3); 发字节(0x0F); 发字节(0x89); 发四(0); 补标号(码位-4, 净从, 4); /* jns: + 标志检查 (fix 2026-08-23 t35g) */
    移即(0, '-'); 存字节十二(); /* mov [r12], al */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移寄存器(0, 3); 汇发("    取反 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xD8); 移寄存器(3, 0); /* eax = -value; ebx = -value */
    相对跳转(-1); 补标号(码位-4, 空八一, 2);
    设标号(净从);
    移寄存器帧(0, 临时基 - 当前帧大小 + 0); /* eax = plus flag */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 空八一, 1);
    移即(0, '+'); 存字节十二(); /* mov [r12], al */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    设标号(空八一);
    移寄存器(0, 3); /* eax = value (positive) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    移即(1, 10); /* ecx = 10 */
    汇发("    整除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF9); /* idiv ecx: eax=quot, edx=rem */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* add dl, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* mov [r9], dl */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* mov al, [r9] */
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* cmp r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %lld: 64-bit signed decimal (fix 2026-08-06) — value in rbx, temp [rbp-56..] 24B, copy forward */
静 空 缓序(整 号分) {
    整 空八一 = 新标号(), 前亥 = 新标号(), 首甲 = 新标号(), 间寅 = 新标号(); /* fix 2026-08-23 t35g */
    取帧址(8, 临时基 + 192 + 24 - 当前帧大小); /* r8 = ll temp end [rbp-56] */
    移64(9, 8); /* r9 = temp end (advancing) */
    汇发("    测试64 r3, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 3, 3); /* test rbx, rbx (fix: B 位必须 0，否则 rm=3 变 r11) */
    发字节(0x0F); 发字节(0x89); 发四(0); 补标号(码位-4, 前亥, 4); /* jns: + 标志检查 (fix 2026-08-23 t35g) */
    移即(0, '-'); 存字节十二(); /* mov [r12], al */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    取反64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xF7); 模字节(3, 3, 3); /* neg rbx (fix 2026-08-06: REX.B 必须 0，49 F7 DB 是 neg r11 → div 商溢出 #DE 崩溃) */
    相对跳转(-1); 补标号(码位-4, 空八一, 2);
    设标号(前亥);
    移寄存器帧(0, 临时基 - 当前帧大小 + 0); /* eax = plus flag */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 空八一, 1);
    移即(0, '+'); 存字节十二(); /* mov [r12], al */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    设标号(空八一);
    移64(0, 3); /* rax = value (positive) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    移即(1, 10); /* ecx = 10 */
    汇发("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1); /* div rcx */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* add dl, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* mov [r9], dl */
    汇发("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 0, 0); /* test rax, rax */    非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* mov al, [r9] */
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* cmp r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %llu: 64-bit unsigned decimal digits into [r12], then jmp tail (fix 2026-08-06).
   No sign handling (rbx is unsigned long long); div rcx unsigned 64-bit. */
静 空 堆轮(整 号分) {
    整 首甲 = 新标号(), 间寅 = 新标号();
    取帧址(8, 临时基 + 192 + 24 - 当前帧大小); /* r8 = temp end (reuse ll temp area [rbp-56]) */
    移64(9, 8); /* r9 = temp end (advancing) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    移即(1, 10); /* ecx = 10 */
    汇发("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1); /* div rcx */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* add dl, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* mov [r9], dl */
    汇发("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 0, 0); /* test rax, rax */
    非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* mov al, [r9] */
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* cmp r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %u: unsigned decimal digits (no sign handling, div not idiv — fix 2026-08-05:
   %u was an unknown spec → swallowed). ebx = value, digits into [r12], jmp tail. */
静 空 宽七(整 号分) {
    整 首甲 = 新标号(), 间寅 = 新标号();
    取帧址(8, 临时基 + 248 + 12 - 当前帧大小); /* r8 = digit temp end */
    移64(9, 8); /* r9 = temp end (advancing) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    移即(1, 10); /* ecx = 10 */
    汇发("    无符号除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* div ecx: eax=quot, edx=rem */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* add dl, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* mov [r9], dl */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* mov al, [r9] */
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* cmp r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %o: unsigned octal digits into [r12] (ebx = value, base 8). fix 2026-08-22 t47:
   %o was an unknown spec → swallowed (no output, no arg consume) → 参数表错位 →
   git ls-files -s 的 "%s%06o %s %d" 后续 %s 读到 mode 当指针 strlen → SEGV. */
静 空 池组(整 号分) {
    整 首甲 = 新标号(), 间寅 = 新标号();
    取帧址(8, 临时基 + 248 + 12 - 当前帧大小); /* r8 = digit temp end */
    移64(9, 8); /* r9 = temp end (advancing) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    移即(1, 8); /* ecx = 8 */
    汇发("    无符号除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* div ecx: eax=quot, edx=rem */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* add dl, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* mov [r9], dl */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 首甲, 3);
    /* fix 2026-08-23 t35d: %06o 宽度/零填充 — W=sc+232, zero-flag=sc+264 (diff-tree/ls-files mode) */
    { 整 内列 = 新标号(), 暂双一 = 新标号(), 尾五 = 新标号(), 外繁 = 新标号();
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* eax = W */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 内列, 1); /* W==0 -> 无填充 */
    移64(0, 8); 汇发("    减64 r0, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3,1,0); /* rax = r8 - r9 = len (r8=temp end, r9=数字开头) */
    移帧寄存器(临时基 - 当前帧大小 + 240, 0); /* 存 len (sc+240 临时) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* eax = W */
    移寄存器帧(2, 临时基 - 当前帧大小 + 240); /* edx = len */
    汇发("    减32 r0, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x29); 模字节(3, 2, 0); /* eax = W - len = pad */
    移寄存器(2, 0); /* edx = pad count */
    移寄存器帧(1, 临时基 - 当前帧大小 + 264); /* ecx = zero-flag */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 尾五, 1);
    移即(0, '0'); 相对跳转(-1); 补标号(码位-4, 外繁, 2);
    设标号(尾五); 移即(0, ' ');
    设标号(外繁);
    设标号(暂双一);
    测寄存器(2, 2); 零跳(-1); 补标号(码位-4, 内列, 1);
    存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* dec edx */
    相对跳转(-1); 补标号(码位-4, 暂双一, 2);
    设标号(内列); }
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* mov al, [r9] */
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* cmp r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %x/%X: unsigned hex digits into [r12] (ebx = value, base 16; upper=1 → 'A'-'F').
   Fix 2026-08-05: %x was an unknown spec → swallowed (no output, no arg consume). */
静 空 容属(整 号分, 整 帧二) {
    整 首甲 = 新标号(), 间寅 = 新标号(), 终又 = 新标号(), 反伍 = 新标号();
    取帧址(8, 临时基 + 248 + 12 - 当前帧大小); /* r8 = temp end */
    移64(9, 8); /* r9 = temp end (advancing) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    移即(1, 16); /* ecx = 16 */
    汇发("    无符号除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* div ecx: eax=quot, edx=rem */
    汇发("    比较字节即 r2, 10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xFA); 发字节(10); /* cmp dl, 10 (fix 2026-08-05: was 比较字节 = asm_zh emits 38 D0 → H2 off-by-one) */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位-4, 终又, 8); /* jb l0a (dl is 0-15 unsigned: jb == jl here; is_jmp=8=低于跳 matches asm_zh's 0F 82 — fix 2026-08-05) */
    若 (帧二) { 汇发("    加字节 r2, 0x37\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x37); /* add dl, 0x37 = 'A'-10 (%X) */ }
    否 { 汇发("    加字节 r2, 0x57\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x57); /* add dl, 0x57 = 'a'-10 */ }
    相对跳转(-1); 补标号(码位-4, 反伍, 2);
    设标号(终又);
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* add dl, '0' */
    设标号(反伍);
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* mov [r9], dl */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* mov al, [r9] */
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* cmp r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* fix 2026-08-09 审计#7: %#x/%#X 前缀 + %0Nx 宽度填充（在 emit_hex_digits 前调用）。
   ebx = 值; sc+232=W; sc+260=#flag; sc+264=0flag; prefix='x'/'X'（调用点传字面量, host/mirror 字节一致）。
   输出顺序: 零填充: 前缀 → pad 个 '0' → digits; 空格/无宽: pad ' ' → 前缀 → digits.
   ⚠️ emit_hex_digits 从 EAX 取值 — 末尾必须恢复 eax = ebx */
静 空 首升(整 号分, 整 帧二, 整 余散一) {
    整 度壬一 = 新标号(), 上转 = 新标号(), 值拾 = 新标号(), 尾五 = 新标号(), 终低一 = 新标号(), 缓利 = 新标号();
    /* 数 hex 位数 → r9d（do-while: 值 0 计 1 位; 值留在 ebx, 不碰 eax） */
    移寄存器(8, 3); 移即扩(9, 0); /* r8d = ebx; r9d = 0 */
    设标号(度壬一);
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9d */
    前缀字节(0,0,0,1); 发字节(0xC1); 模字节(3, 5, 0); 发字节(4); /* shr r8d, 4 */
    汇发("    逻辑右移 r8, 4\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); /* fix 2026-08-12 H2 对等: 裸发射补 asm_emit 文本 (asm_zh 汇编需要) */
    测寄存器(8, 8); 非零跳(-1); 补标号(码位-4, 度壬一, 3);
    /* pad = W - len - (hash?2:0) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* eax = W */
    移寄存器(2, 9); 算寄存器(旧肆, 0, 2); /* edx = len; eax = W - len */
    移寄存器帧(1, 临时基 - 当前帧大小 + 260); /* ecx = #flag */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 上转, 1); /* !#: 跳过 -2 */
    移即(1, 2); 算寄存器(旧肆, 0, 1); /* eax -= 2 */
    设标号(上转);
    移寄存器(2, 0); /* edx = pad */
    移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 终低一, 6); /* cmp eax,0; jle lpref: 无填充直接前缀+digits */
    /* pad > 0: 检查 0 flag */
    移寄存器帧(0, 临时基 - 当前帧大小 + 264); /* eax = 0flag */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 尾五, 1); /* jz lsp: 空格填充 (fix 2026-08-12: is_jmp 3→1, 文本非零跳→为零跳, H2 对等) */
    /* 零填充: 先前缀, 再 pad 个 '0' */
    移寄存器帧(1, 临时基 - 当前帧大小 + 260); /* ecx = #flag */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 值拾, 1);
    移即(0, '0'); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    移即(0, 余散一); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    设标号(值拾);
    移即(0, '0'); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* mov [r12],'0'; inc r12 */
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* dec edx */
    非零跳(-1); 补标号(码位-4, 值拾, 3);
    相对跳转(-1); 补标号(码位-4, 缓利, 2);
    /* 空格填充: pad 个 ' ' 再前缀 */
    设标号(尾五);
    移即(0, ' '); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* dec edx */
    非零跳(-1); 补标号(码位-4, 尾五, 3);
    /* 前缀(若有) — 空格路径与无填充路径共用 */
    设标号(终低一);
    移寄存器帧(1, 临时基 - 当前帧大小 + 260); /* ecx = #flag */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 缓利, 1);
    移即(0, '0'); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    移即(0, 余散一); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    设标号(缓利);
    移寄存器(0, 3); /* ⚠️ eax = ebx = 值 (emit_hex_digits 从 eax 取值) */
    容属(号分, 帧二);
}
/* %llx/%llX: 64-bit unsigned hex digits into [r12] (rbx = value, base 16; upper=1 → 'A'-'F'),
   then jmp tail（fix 2026-08-06）。div rcx 无符号 64 位。 */
静 空 实厚(整 号分, 整 帧二) {
    整 首甲 = 新标号(), 间寅 = 新标号(), 终又 = 新标号(), 反伍 = 新标号();
    取帧址(8, 临时基 + 192 + 24 - 当前帧大小); /* r8 = temp end（复用 ll 临时区 [rbp-56]） */
    移64(9, 8); /* r9 = temp end (advancing) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    移即(1, 16); /* ecx = 16 */
    汇发("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1); /* div rcx */
    汇发("    比较字节即 r2, 10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xFA); 发字节(10); /* cmp dl, 10 */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位-4, 终又, 8); /* jb l0a (dl is 0-15 unsigned) */
    若 (帧二) { 汇发("    加字节 r2, 0x37\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x37); /* add dl, 0x37 = 'A'-10 (%llX) */ }
    否 { 汇发("    加字节 r2, 0x57\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x57); /* add dl, 0x57 = 'a'-10 */ }
    相对跳转(-1); 补标号(码位-4, 反伍, 2);
    设标号(终又);
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* add dl, '0' */
    设标号(反伍);
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* mov [r9], dl */
    汇发("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 0, 0); /* test rax, rax */
    非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* mov al, [r9] */
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* cmp r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}

静 整 度壬(整 总伍) {
    整 符组 = 新标号(), 暂双 = 新标号(), 首戊 = 新标号(), 素二 = 新标号(), 半拆 = 新标号(), 容低 = 新标号(), 段辰 = 新标号(), 高癸 = 新标号(), 首又一 = 新标号();
    整 帧序二 = 新标号(), 首分一 = 新标号(), 毛七 = 新标号(), 旧分 = 新标号();
    整 内寅 = 新标号(), 副合 = 新标号(); /* fix 2026-08-26: %f 的 inf/NaN 特殊输出 (原 cvttsd2si 路径对 inf 输出垃圾) */
    整 小于等 = 新标号(), 净二 = 新标号(), 初陆 = 新标号(), 局部全局 = 新标号(); /* %e/%E/%g/%G (fix 2026-08-25 支持矩阵补全) */
