                    }
                    槽高[槽数] = 总计数 + 新浅 * 8; /* the ADDRESS slot sits above the copy blocks */
                    若 (取环境("QCC_DBG_ARG")) 输出到文件(错误流, "[ARG] bigsz=%d slot_h[%d]=%d total_h=%d fname=%s\n", 链退, 槽数, 槽高[槽数], 总计数, 串升);
                    遍 (整 顺戊 = 新浅 - 1; 顺戊 >= 0; 顺戊--) {
