                压栈寄存器(15); 移64(15, 4);
                汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                减栈即(32);
                调导入(14); /* ConvertThreadToFiber */
                加栈即(32);
                移64(4, 15); 弹栈寄存器(15);
                加栈即(总计数);
                元子 = 1;
