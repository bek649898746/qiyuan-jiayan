                    否 若 (变量是否短(变节)) { 中发(标零, 偏移, 0, 0); 中刷(); 若 (!变量是否无符号(变节)) { 发字节(0x0F); 发字节(0xBF); 发字节(0xC0); } 若 (节点长性(数, -1)) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } } /* 修复 2026-08-29 生成器: 静态 短整 32 位加载 + 符号扩展 首子,ax 符号扩展 (有符号 短整 0xC789 → 0xFFFFC789; 无符号 高位 0 天然正确); 修复 2026-08-31 生成器 s65: 节长标 时 符号扩展64 64 位 (同局部 短整 t42) */
                    否 { 中发(标零, 偏移, 0, 是64位有(数) ? 1 : 0 /* 第 168 站: 收口 */); 中刷(); }
                } 否 {
                    /* 检查 若 数组 �?取址. 必须 解析 到 该 相同 变量 查变量 已找到:
