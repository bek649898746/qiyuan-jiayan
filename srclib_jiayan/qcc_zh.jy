                  若 (验构 >= 0 && 类型表[验构].函 > 0 && 字段序(验构, 词名表[词位]) < 0) { 格式化到串(错缓冲, "类型 '%s' 无字段 '%s' (成员访问 — 拼写错/字段不存在; 撞词家族收尾 2026-09-05)", 类型表[验构].名, 词名表[词位]); 发错误("A9001", 错缓冲); } }
