                汇发("    写字节 [r8], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0x88);模字节(0,0,0); /* 移动 [r8], 累加低 */
                汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1);发字节(0xFF);模字节(3,0,0); /* ③ REX.W=1: 原 0 ⟹ inc r8d ⟹ 指针 32 位回绕 */ /* 递增 r8 */
                汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1);发字节(0xFF);模字节(3,0,1); /* ③ REX.W=1: 同上 */ /* 递增 r9 */
                汇发("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0xFF);模字节(3,1,2); /* 递减 r10 */
