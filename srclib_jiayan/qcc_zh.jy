        若 (词型表[词位] == 逗号) { 词位++; 行值 = 赋值级(); 行有值 = 1; } /* #80: 抛出 码, 值 — 异常携带值 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        整 呼 = 建节(4);
        { 整 现高 = 建节(0); 节值表[现高] = 1; 接子(呼, 现高); } /* EX_GEN=1 */
        接子(呼, 行粗); /* 码 */
        若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
        若 (!串表[串数]) 串表[串数] = 短六();
