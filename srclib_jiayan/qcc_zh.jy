                    }
                    词位++;
                }
                若 (词型表[词位] == 逗号) 词位++;
            }
            若 (词型表[词位] == 右括) 词位++;
        }
        若 (词型表[词位] == 分号) 词位++;
        若 (整甲 >= 0) 正九++; /* A3: 64 上限 已 由 登记点 原得 接管 */
