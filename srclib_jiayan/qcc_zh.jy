                                若 (域型 >= 0) 当构序 = 域型; 否 当构序 = -1;
                            }
                            若 (当构序 >= 0) { 串值二 = 当构序; 域偏移一 = 类型偏移(类型表[串值二].名, 串升); }
                        }
                            若 (基构序 < 0) { 静默计(7, "数组[i].字段.写.主路径未解析-序七兜底"); 整 序九 = 序七(子0[微码]); 若 (序九 >= 0) { 串值二 = 序九; 域偏移一 = 类型偏移(类型表[序九].名, 串升); } 否 静默计(5, "数组[i].字段.写.域偏移<0-整段未发射"); } /* A2-prereq (2026-09-12): 结构体数组成员链 基 序 兜底 — 原 两阶段 只走 成员/箭头, 含 下标 基链 解析不到 → 域偏移=-1 静默/错址 */
                    }
                    若 (域偏移一 >= 0) {
