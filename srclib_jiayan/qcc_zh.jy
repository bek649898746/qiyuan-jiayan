                若 (字节一 > 0 && (段[字节一] == '.' || (段[字节一] == '>' && 段[字节一 - 1] == '-'))) 整伍 = 1; /* t35m 2026-08-24: 字段名与函数宏冲突 — iter->select(...) 的 select 是结构体字段, compat_prelude.h `#define select(n,r,w,e,t) 0` (Winsock stub) 文本展开破坏字段访问 → merge_ref_iterator_advance 缺 select 调用 → show-ref/branch/tag 死循环; 注意: 仅 `->`(前为 -) 或 `.` 才算字段访问, 裸 `>` 是比较运算符 (maximum_unsigned_value_of_type 前 (b) > 不能误伤) */
                若 (字节一 > 0 && (判字母数字((无 字)段[字节一]) || 段[字节一] == '_')) {
