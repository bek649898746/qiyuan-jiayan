/* 外部数学函数 → 导入表 槽位 8-31（非 目标文件 模式；修复 2026-08-06 缺陷-1; 2026-08-25 math24: 16→24, frexp/ldexp/modf 走混合 应用二进制接口 专用分支） */
静 整 终陆(常 字 *数) {
    静 常 字 *虚伍一[24] = { "pow","atan2","fmod","sqrt","cos","sin","tan","acos","asin","atan","log","log10","exp","floor","ceil","fabs","cosh","sinh","tanh","copysign","hypot","frexp","ldexp","modf" };
    遍 (整 计 = 0; 计 < 24; 计++) 若 (!比较字符串(虚伍一[计], 数)) 返 64 + 计; /* 2026-08-28 阶段一 #246: 内核库 15→17 槽 → msvcrt 槽 17 起 */
    返 -1;
}
/* 外部库函数注册表 (修复 2026-08-25 步五 时间 全系): 非 内置 非 math 的 msvcrt 导入表 函数,
   参数全 整数/指针 (六十四位窗口 标丁 传参), 返回类型各异。
   返回: 0=整数/指针(堆九 8B) 1=邻辰(堆九 64B) 2=双精度(xmm0)
   槽位 33-41 对应 栈降[25..33] (64 位变体映射标准名: 时间→_time64 等) */
静 常 字 *隔高[35] = { "time","difftime","localtime","gmtime","mktime","strftime","clock","asctime","ctime","strtok","strrchr","strnlen","strpbrk","memcmp","toupper","isalnum","isxdigit","isspace","rand","srand","abs","islower","isupper","iscntrl","isgraph","isprint","ispunct","labs","atof","strcoll","strxfrm","strncat","strncpy","strtod","getenv" }; /* isblank/strcasecmp/strtoll 等不在传统 msvcrt.dll 导出, 勿入表 */ /* A30 (2026-09-11): +getenv — 原 只 在 后聚[] 白名单 (隐式声明 放行) 却 无 导入 槽 → 静默 走 「未登记 回退 返 0」 桩 → 取环境/getenv 恒 空 (编译器 自身 所有 取环境 门控 是 死代码) */
静 常 字 *核名[64] = { 
"GetStdHandle", 
"WriteFile", 
"CreateFileA", 
"ReadFile", 
"VirtualAlloc", 
"SetFilePointer", 
"ExitProcess", 
"GetCommandLineA",

"CreateThread", 
"WaitForSingleObject", 
"CloseHandle", 
"CreateFiber", 
"SwitchToFiber", 
"DeleteFiber", 
"ConvertThreadToFiber", 
"LoadLibraryA",

"GetProcAddress", 
"GetLastError", 
"SetLastError", 
"GetModuleHandleA", 
"GetModuleFileNameA", 
"GetModuleFileNameW", 
"FreeLibrary", 
"LoadLibraryW",

"LoadLibraryExA", 
"FormatMessageA", 
"WideCharToMultiByte", 
"MultiByteToWideChar", 
"GetFileAttributesA", 
"GetFileAttributesW", 
"GetFileAttributesExA", 
"GetFileAttributesExW",

"SetFileAttributesW", 
"CreateFileW", 
"DeleteFileW", 
"FindFirstFileW", 
"FindNextFileW", 
"FindClose", 
"GetFileType", 
"GetFileInformationByHandle",

"SetFileTime", 
"GetLongPathNameW", 
"GetFullPathNameW", 
"GetFinalPathNameByHandleW", 
"GetEnvironmentStringsW", 
"FreeEnvironmentStringsW", 
"GetEnvironmentVariableW", 
"SetEnvironmentVariableW",

"Sleep", 
"GetSystemTimeAsFileTime", 
"GetProcessHeap", 
"HeapAlloc", 
"HeapFree", 
"CreateProcessW", 
"OpenProcess", 
"TerminateProcess",

"GetCurrentProcessId", 
"GetVersion", 
"SetConsoleCtrlHandler", 
"GetHandleInformation", 
"CreatePipe", 
"PeekNamedPipe", 
"GetNamedPipeInfo", 
"InitializeProcThreadAttributeList" }; /* C139 (2026-09-20 第 139 站): 内核库 17 个 API 的 「名 -> 导入槽」表 (槽号 = 索引, 与 左己[] 前 17 项 及 写导入表的 主亥[17] 同序). 原 只有 math (终陆) 与 msvcrt (帧退) 的 查询, **内核库 无查询** ⟹ 用户代码 调用 任何 Win32 API 都 落 「未登记回退」桩 ⟹ 恒 返 0 (实测 `GetStdHandle(-11)` 与 `GetCommandLineA()` 均 0; 编译器自身 用 直接槽号 调导入(0) 故 不受影响, 长期 未被发现). */
静 整 核退(常 字 *数) { 遍 (整 计 = 0; 计 < 64; 计++) 若 (!比较字符串(核名[计], 数)) 返 计; 返 -1; }
静 整 帧退(常 字 *数) {
    遍 (整 计 = 0; 计 < 35; 计++) 若 (!比较字符串(隔高[计], 数)) 返 89 + 计; /* 2026-08-28 阶段一 #246: msvcrt 槽 40→42 起 (内核库 +2); A30: getenv 槽 76 */
