                整 顺次 = 0, 首双 = 0; 循环 (词型表[词位] == 乘) { 顺次 = 1; 首双++; 词位++; 循环 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常"))) 词位++; } /* fix 2026-08-14: 循环消费所有 *; 每个 * 后可选 const (fix 2026-08-15: show-branch * const*b); fix 2026-08-18: 数层级 → T** 逗号变量 8B 元素 */
                整 元二 = 建节(7);
                若 (词型表[词位] == 词变量) {
                    字 变节二[64]; 复制字符串(变节二, 词名表[词位]); 词位++;
                    若 (词型表[词位] == 左方) { /* array in comma list: int a, b[3]; (fix 2026-08-05: was var_offset → adimv[8] registered as int, &adimv[0] NULL) */
                        整 短聚 = 1;
                        循环 (词型表[词位] == 左方) { 词位++; 整 隔九 = 0; 若 (常量表达式求值(&隔九)) 短聚 *= 隔九; 否 若 (词型表[词位] == 词变量) 词位++; 若 (词型表[词位] == 右方) 词位++; }
                        整 逆七 = 实甲 ? 8 : ((顺次 || 是否指标) ? 8 : (是否字符标 ? 1 : (是否短标 ? 2 : (当丙 ? 8 : (是否长标 ? 8 : 4))))); /* fix 2026-08-16: 逗号声明 int *rsym[4] 是 8 字节指针数组 (原 is_ptr2 走 var_offset_ptr → arr_sz=0 → rsym[rsec][b2] 存到坏地址崩) */
                        末午(变节二, 短聚, 逆七);
                        变量表[变量数 - 1].指元素尺寸 = 0; /* fix 2026-08-17: 1D ptr-array comma decl (int *rsym[4])
                           must keep p_esz=0 (2nd dim b2 is int, stride 4; old esz2=8 -> cg_mem_frow=8 ->
                           rsym[rsec][b2] store misaligned, corrupts neighbor ridx -> write_coff_obj reloc */
                        若 (当丙) 变量表[变量数 - 1].是否浮标 = 1;
                        若 (是否长标) 变量表[变量数 - 1].是否长标 = 1; /* fix 2026-08-06 */
                    } 否 {
                        整 现分 = 0;
                        若 (词型表[词位] == 赋号) { 词位++; 现分 = 1; 接子(元二, 表达式()); } /* 逗号声明带初始化 (int a=0, b=1u) */
                        若 (顺次) { 变偏指(变节二, 是否字符标 ? 1 : 4); 若 (首双 >= 2) 变量表[变量数 - 1].数组元素尺寸 = 8; } /* fix 2026-08-18: T** 逗号变量 8B 元素 */
                        否 若 (是否长标) { 余乙(变节二); 若 (无符号标) 变量表[变量数 - 1].无符号标 = 1; } /* fix 2026-08-06: 逗号声明 ll 变量 (原 var_offset → 存32) */
                        否 若 (当丙) { 变浮(变节二); }
                        否 若 (整得 >= 0) { 变构(变节二, 整得); } /* typedef struct comma var (fix: was missing → p2 as int) */
                        否 { 变量偏移(变节二); 若 (是否字符标) 变量表[变量数 - 1].是否字符标 = 1; 若 (是否短标) 变量表[变量数 - 1].是否短标 = 1; 若 (无符号标) 变量表[变量数 - 1].无符号标 = 1; }
                        若 (现分) 未初始化移除(变节二); /* 接入 2026-08-28 机制层 #78: 带初始化必须在 var_offset 登记后移除 (顺序! 先登记后移除) */
                    }
                    复制内存((字*)(节名表 + 元二), 变节二, 32);
                    接子(发字节, 元二); 字节计数++;
                }
            }
            词位++; }
        否 若 (词型表[词位] == 结构词) { /* struct Name var; 或 struct Name *ptr; */
            
            词位++; /* skip struct */
            若 (词型表[词位] == 词变量) {
                整 构序 = 查类型(词名表[词位]); 词位++; /* struct type name */
                整 是否指标 = 0;
                循环 (词型表[词位] == 乘) { 是否指标 = 1; 词位++; } /* fix 2026-08-18: struct sl *values 指针 — 原 VR 检查失败 → *values 落表达式路径当隐式变量注册, 存值/取址槽位不一致 (var_sbase 按 struct 减大小, &取址不减) → &values 错位 → git_configset_get_value SEGV (git init) */
                若 (构序 >= 0 && 词型表[词位] == 词变量) {
                    整 元 = 建节(7); /* reuse decl node */
                    字 素肆[64]; 复制字符串(素肆, 词名表[词位]);
                    若 (是否指标) { 变偏指(词名表[词位], 类型表[构序].尺寸); 变量表[变量数 - 1].型序标 = 构序; 变量表[变量数 - 1].指深 = 1; 变量表[变量数 - 1].指内 = 类型表[构序].尺寸; } /* 指针变量: 8 字节槽 + struct 类型; fix 2026-08-20: p_esz=sizeof(struct) 原固定 4 → `struct option *newopt` 指针算术 i*4 → parse-options preprocess_options memcpy 参数错位 → git log 崩; p_depth/p_inner (fix 2026-08-18 对齐) */
                    否 变构(词名表[词位], 构序);
                    复制内存((字*)(节名表 + 元), 词名表[词位], 64); 词位++;
                    整 总环 = -1;
                    若 (词型表[词位] == 赋号) { /* = init (fix 2026-08-15: struct strbuf merge_names = STRBUF_INIT, *autogen = NULL; 原只处理 ; → autogen 未注册) */
                        词位++;
                        未初始化移除(素肆); /* #78: struct 变量声明带初始化 */
                        若 (词型表[词位] == 左花 && !是否指标) { /* brace init { .buf = ... } — 仅 struct 值变量 (fix 2026-08-18: 指针 = { 走 expr) */
                            词位++;
                            整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), 素肆, 32);
                            整 乙序 = 值布(构序, 标识序);
                            总环 = 建节(5); 接子(总环, 乙序);
                            若 (词型表[词位] == 右花) 词位++; /* } */
                        } 否 {
                            接子(元, 表达式());
                        }
                    }
                    接子(发字节, 元); 字节计数++;
                    若 (总环 >= 0) { 接子(发字节, 总环); 字节计数++; }
                    循环 (词型表[词位] == 逗号) { /* comma declarators: *autogen = NULL */
                        词位++;
                        整 总合 = 0; 循环 (词型表[词位] == 乘) { 总合 = 1; 词位++; }
                        若 (词型表[词位] == 词变量) {
                            字 中成[64]; 复制字符串(中成, 词名表[词位]); 词位++;
                            整 半退二 = 建节(7);
                            若 (总合) { 变偏指(中成, 类型表[构序].尺寸); 变量表[变量数 - 1].型序标 = 构序; 变量表[变量数 - 1].指深 = 1; 变量表[变量数 - 1].指内 = 类型表[构序].尺寸; } /* fix 2026-08-20: p_esz=sizeof(struct) 同主声明 */
                            否 变构(中成, 构序);
                            复制内存((字*)(节名表 + 半退二), 中成, 32);
                            若 (词型表[词位] == 赋号) { /* = init */
                                词位++;
                                若 (词型表[词位] == 左花) { /* 花括号初始化器 { ... } — STRBUF_INIT 等 (fix 2026-08-18: 原 Nc(d4,expr()) 不能解析 { → 初始化器被吞 → 变量 buf=NULL → strbuf 操作 SEGV; setup.c `struct strbuf dir = STRBUF_INIT, gitdir = STRBUF_INIT, report = STRBUF_INIT;` git init/config 崩) */
                                    词位++;
                                    整 副系 = 建节(1); 复制内存((字*)(节名表 + 副系), 中成, 32);
                                    整 域进一 = 值布(构序, 副系);
                                    整 满七一 = 建节(5); 接子(满七一, 域进一);
                                    接子(发字节, 满七一); 字节计数++;
                                    若 (词型表[词位] == 右花) 词位++; /* } */
                                } 否 {
                                    接子(半退二, 表达式());
                                }
                            }
                            接子(发字节, 半退二); 字节计数++;
                        }
                    }
                    若 (词型表[词位] == 分号) 词位++; /* skip ; */
                    续;
                }
            }
            /* skip to next ; if parse fails */
            循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 右花) 词位++;
            若 (词型表[词位] == 分号) 词位++;
        }
        否 若 (词型表[词位] == 词变量 && (型定判断(词名表[词位]) || 查类型(词名表[词位]) >= 0) && 词型表[词位 + 1] != 箭头 && 词型表[词位 + 1] != 句点 && 词型表[词位 + 1] != 左方 && 词型表[词位 + 1] != 赋号) { /* typedef or struct type (guard: ->/./[ = 表达式; fix 2026-08-15: combine-diff sline[j].flag 被当 struct 声明 → flag 泄漏 undefined; fix 2026-08-18: `ref = xstrfmt(...)` — ref 恰是 git 的 struct tag (struct ref) → 被当类型名吞掉 → 赋值语句整个消失 → create_reference_database 的 ref 未初始化 → check_refname_format(垃圾) → git init 崩) */
            整 中己 = 0; 整 名分 = 型定查(词名表[词位]); 若 (名分 >= 0 && 型定表[名分].是否浮标) 中己 = 1;
            整 内双一 = (名分 >= 0 && 型定表[名分].是否函数指); /* typedef'd fnptr: 8-byte element (fix 2026-08-03) */
            词位++; /* skip type name */
            整 暂构序 = 查类型(词名表[词位-1]); 若 (暂构序 < 0) 暂构序 = 容成(词名表[词位-1]);
            整 是否构标 = (暂构序 >= 0);
            整 是否指标 = 0;
            若 (词型表[词位] == 乘) { 是否指标 = 1; 词位++; } /* pointer */
            整 元 = 建节(7);
            若 (词型表[词位] == 词变量) {
                字 变节二[64]; 复制字符串(变节二, 词名表[词位]);
                若 (词型表[词位+1] == 左方) { /* typedef struct array: P arr[3]; — fix 2026-08-03: was single-element */
                    整 扫描计数 = 1; 词位++; /* consume VR */
                    循环 (词型表[词位] == 左方) {
                        词位++; 若 (词型表[词位] == 常数) { 扫描计数 *= 词值表[词位]; 词位++; }
                        若 (词型表[词位] == 右方) 词位++;
                    }
                    若 (内双一 && !是否指标) { 末午(变节二, 扫描计数, 8); 若 (名分 >= 0 && 型定表[名分].函数指浮) 变量表[变量数 - 1].指浮 = 1; }
                    否 若 (是否构标 && !是否指标 && 扫描计数 > 1) { 末午(变节二, 扫描计数, 类型表[暂构序].尺寸); 变量表[变量数 - 1].型序标 = 暂构序; }
                    否 若 (是否构标 && !是否指标) { 变构(变节二, 暂构序); }
                    否 若 (中己 && !是否指标) { 变浮(变节二); }
                    否 { 变量偏移(变节二); }
                } 否 {
                若 (内双一 && !是否指标) { 变偏指(变节二, 4); 变量表[变量数 - 1].数组元素尺寸 = 8; 若 (名分 >= 0 && 型定表[名分].函数指浮) 变量表[变量数 - 1].指浮 = 1; }
                否 若 (是否构标 && !是否指标) { 变构(词名表[词位], 暂构序); }
                否 若 (中己 && !是否指标) { 变浮(词名表[词位]); } /* typedef double alias: 8-byte slot */
                否 { 变量偏移(词名表[词位]); }
                }
                复制内存((字*)(节名表 + 元), 变节二, 32); 词位++;
            }
            若 (词型表[词位] == 赋号) {
                词位++;
                若 (词型表[词位] == 左花 && 是否构标 && !是否指标 && !(词位 >= 1 && 词型表[词位-1] == 右方)) { /* typedef struct P p = { a, b }; — brace init. Guard: array dims consumed (tt[tk-1]==RB) → skip brace_fields (array init unsupported) */
                    词位++;
                    整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), (字*)(节名表 + 元), 32);
                    整 乙序 = 值布(暂构序, 标识序);
                    接子(发字节, 元); 字节计数++;
                    整 位型标 = 建节(5); 接子(位型标, 乙序);
                    接子(发字节, 位型标); 字节计数++;
                    若 (词型表[词位] == 右花) 词位++;
                    循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++;
                    若 (词型表[词位] == 分号) 词位++;
                    续;
                } 否 {
                    接子(元, 表达式());
                }
            }
            若 (词型表[词位] == 分号) 词位++;
            接子(发字节, 元);
            /* comma-separated: typedef P p1, p2, p3; (fix 2026-08-08: was missing → p2+ silently dropped) */
            循环 (词型表[词位] == 逗号) {
                词位++;
                整 当平 = 0;
                若 (词型表[词位] == 乘) { 当平 = 1; 词位++; }
                若 (词型表[词位] == 词变量) {
                    字 净申[64]; 复制字符串(净申, 词名表[词位]); 词位++;
                    整 反劣 = 建节(7);
                    若 (当平) { 变偏指(净申, 4); 若 (是否构标) 变量表[变量数 - 1].型序标 = 暂构序; }
                    否 若 (是否构标) 变构(净申, 暂构序);
                    否 若 (中己) 变浮(净申);
                    否 变量偏移(净申);
                    复制内存((字*)(节名表 + 反劣), 净申, 32);
                    若 (词型表[词位] == 赋号) { 词位++; 接子(反劣, 表达式()); }
                    接子(发字节, 反劣); 字节计数++;
                }
                若 (词型表[词位] == 分号) 词位++;
            }
        }
        否 { 接子(发字节, 语句()); 字节计数++; }
    }
    若 (词型表[词位] == 右花) 词位++; /* fix 2026-08-07: EK 提前退出时不得越过 token 区 (原无条件 tk++ 遇 EOF 越界). NOTE: vcnt NOT restored — C has function scope, not block scope */
    遍 (整 庚序 = 逆汇 - 1; 庚序 >= 0; 庚序--) { 若 (宽辰[庚序][0] != 0 && 帧附[庚序] == 计贰 && 串寅[庚序]) { 整 呼 = 建节(4); { 整 参 = 建节(1); 复制内存((字*)(节名表 + 参), 宽辰[庚序], 64); 接子(呼, 参); } { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 终双[庚序], 64); 接子(呼, 函); } 接子(发字节, 呼); 字节计数++; 宽辰[庚序][0] = 0; } } { 整 戌 = 0; 遍 (整 结 = 0; 结 < 逆汇; 结++) { 若 (宽辰[结][0] != 0) { 若 (戌 != 结) { 复制字符串(宽辰[戌], 宽辰[结]); 复制字符串(终双[戌], 终双[结]); 帧附[戌] = 帧附[结]; 串寅[戌] = 串寅[结]; } 戌++; } } 逆汇 = 戌; } /* 接入 2026-08-28 机制层 #8 RAII: 块退出 → 自动调用本块守卫析构 (LIFO 逆序, 复用 borrow_depth 判断作用域, 压缩移除) */ /* 2026-08-28 P1 #15 Drop 标记: guard_ready=0 (未初始化) 守卫跳过析构 */ /* 2026-08-28 P1 #25: 丢弃 已注销守卫 (guard_vars[gi][0]=0) 跳过析构 — 否则空名守卫发析构调用 → 未定义函数 '' (丢弃后块退不二次析构) */
    长申(); /* 接入 2026-08-28 机制层 #4: 块退出 → 自动放还本块内借用 (生命周期=词法作用域, 嵌套正确) */
    逆合一(); /* 接入 2026-08-28 机制层 #78: 块退出 → 清除本块声明的未初始化变量 (生命周期=词法块) */
    终排(); /* 类型根治① (2026-08-28): 块退出 → 清除本块可空标记 (生命周期=词法块) */
    节值表[末重] = 变量数 + 1; /* block end var bound for codegen scoping (fix 2026-08-16: sibling-block locals shadow earlier blocks) */
    遍 (整 邻挂 = 缓申; 邻挂 < 变量数; 邻挂++) 若 (变量表[邻挂].旧零 == 0) { 变量表[邻挂].内薄 = 缓申; 变量表[邻挂].旧零 = 变量数; } /* fix 2026-08-19: 本块直接声明的变量 blk 范围 = 本块 [start,end) (嵌套块变量已标记, 保持其块内作用域) */
    虚三 = 终降一; /* 恢复外层块 (compound literal, fix 2026-08-11) */
    解析深--; /* 资源护栏 9b (2026-08-28): 块递归深度出栈 */
    返 末重;
}

/* 接入 2026-08-28 可吞清单 P0-7: 契约审判 — 前置/后置 子句表 (fn 名键, 声明在顶部) + 检查语句构建器
   前置=入口检查 (解析期脱糖成 if(!pre){printf;exit;} 包函数体首), 后置=出口检查 (代码生成期 epilogue 注入, 返回 占位=返回值) */
静 整 中柒(常 字 *函) { 遍 (整 计 = 0; 计 < 左五; 计++) 若 (!比较字符串(段分[计].函, 函)) 返 计; 返 -1; }
/* 接入 2026-08-28 可吞清单 P0-8: 结构契约审判 — 接口级哈希 (Turn 接口级审判 qcc 版): 契约 struct 名 → 规范描述符 SHA256 (确定性接口指纹, 外部数据过 Schema 才能绑定) */
静 整 总六一(常 字 *数) { 遍 (整 计 = 0; 计 < 符转; 计++) 若 (!比较字符串(整伴[计], 数)) 返 计; 返 -1; }
静 整 深散(常 字 *数) { /* 契约 P; — 登记 struct P 为契约类型 + 计算描述符哈希 (名:总大小:字段名:偏移:大小[:指针/数组], 声明序, 确定性) */
    若 (总六一(数) >= 0) 返 0;
    若 (符转 >= 64) 原得("契约结构表 cstr", 64);
    整 构序 = 查类型(数);
    若 (构序 < 0) { 输出到文件(错误流, "[ERR] 契约: 未知结构体 '%s' (须先定义 struct %s)\n", 数, 数); 返 -1; }
    字 主回[4096]; 整 丁序 = 0;
    丁序 += 格式化到串(主回 + 丁序, "%s:%d:", 数, 类型表[构序].尺寸);
    遍 (整 文件 = 0; 文件 < 类型表[构序].函 && 丁序 < 3900; 文件++) {
        丁序 += 格式化到串(主回 + 丁序, "%s:%d:%d%s,", 类型表[构序].正辰[文件], 类型表[构序].正聚[文件], 类型表[构序].现捌[文件], 类型表[构序].原进[文件] ? ":p" : "");
    }
    字 首一[65]; 深伴(主回, 丁序, 首一);
    复制字符串(整伴[符转], 数);
    复制字符串(长退[符转], 首一);
    符转++;
    返 0;
}
静 整 现再(整 空高, 整 消息串) { /* if(!cond){ printf(msg); exit(1); } — 复用 保证/断言 eq0 模式 */
    整 右对 = 建节(2); 节值表[右对] = 比等; 接子(右对, 空高); { 整 零 = 建节(0); 节值表[零] = 0; 接子(右对, 零); }
    整 若序 = 建节(8); 接子(若序, 右对);
    整 体 = 建节(5);
    整 呼参 = 建节(4); { 整 符号数 = 建节(0); 节值表[符号数] = 消息串; 节型表[符号数] = 串词; 接子(呼参, 符号数); } { 整 缓进 = 建节(1); 复制内存((字*)(节名表 + 缓进), "printf", 7); 接子(呼参, 缓进); }
    接子(体, 呼参);
    整 呼隐 = 建节(4); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(呼隐, 壹节); } { 整 缓进 = 建节(1); 复制内存((字*)(节名表 + 缓进), "exit", 5); 接子(呼隐, 缓进); }
    接子(体, 呼隐);
    接子(若序, 体);
    返 若序;
}
/* 接入 2026-08-28 可吞清单 P1 (兑现"证明器查"): 编译期常量前置审判 — 调用点参数全常量时折叠评估 前置, 违反 → 编译期报错 A6002 (不等运行时 abort) */
静 长 长 目弊(整 数, 常 字 **副进, 常 长 长 *当壬, 整 首合, 整 *高癸一) { /* 常量表达式折叠 (支持算术/比较/位/移位; 遇变量/调用/未知 → known=0 安全跳过) */
    *高癸一 = 1;
    若 (数 < 0) 返 0;
    整 暂 = 节型表[数];
    若 (暂 == 0) 返 节值表[数];
    若 (暂 == 1) { 常 字 *名存 = (字*)(节名表 + 数); 遍 (整 计 = 0; 计 < 首合; 计++) 若 (!比较字符串(名存, 副进[计])) 返 当壬[计]; *高癸一 = 0; 返 0; }
    若 (暂 == 2) { 整 深子, 顺戊; 长 长 甲 = 目弊(子0[数], 副进, 当壬, 首合, &深子); 长 长 发字节 = 目弊(子1[数], 副进, 当壬, 首合, &顺戊);
        若 (!深子 || !顺戊) { *高癸一 = 0; 返 0; }
        择 (节值表[数]) {
            例 高拾: 返 甲 + 发字节; 例 旧肆: 返 甲 - 发字节; 例 下得: 返 甲 * 发字节;
            例 行降: 若 (发字节 == 0) { *高癸一 = 0; 返 0; } 返 甲 / 发字节;
            例 度未: 若 (发字节 == 0) { *高癸一 = 0; 返 0; } 返 甲 % 发字节;
            例 号庚: 返 甲 << 发字节; 例 帧寅: 返 甲 >> 发字节;
            例 比小: 返 甲 < 发字节; 例 外三: 返 甲 > 发字节; 例 隔系: 返 甲 <= 发字节; 例 宽排: 返 甲 >= 发字节;
            例 比等: 返 甲 == 发字节; 例 名庚: 返 甲 != 发字节;
            缺: *高癸一 = 0; 返 0;
        }
    }
    *高癸一 = 0; 返 0;
}

静 空 反双一(整 返回值) { /* 2026-08-28 P1 #11 悬垂引用检测: return &局部 且函数返回指针 → [ERR] A3105 (指针指向已出作用域的局部) */
    若 (返回值 < 0 || 当解析函[0] == 0) 返;
    若 (查返回名指(当解析函)) { /* 当前函数返回指针 */
        若 (节型表[返回值] == 11) { /* 取地址 &x — 沿基链下溯到根变量 (&a[0]/&s.field) */
            整 符挂 = 子0[返回值]; 整 号八 = 0;
            循环 (符挂 >= 0 && 号八 < 8 && (节型表[符挂] == 14 || (节型表[符挂] == 15 && 节值表[符挂] == 0))) { 符挂 = 子0[符挂]; 号八++; }
            若 (符挂 >= 0 && 节型表[符挂] == 1) { /* 变量 */
                字 *名存 = (字*)(节名表 + 符挂);
                整 变序 = -1;
                遍 (整 键 = 变量总数() - 1; 键 >= 0; 键--) 若 (!比较字符串(变量表[键].名, 名存)) { 变序 = 键; 断; }
                若 (变序 >= 解析基 && 变量指元素(名存) == 0) { /* 值型局部 (非指针) 才悬垂 — 指针根 &ptr[k]/&ptr->f 指向 ptr 指向处, 安全 (rt strstr 等) */
                    格式化到串(错缓冲, "悬垂引用: 返回指向函数局部变量 '%s' 的指针 (局部变量随函数退出失效, v3.0 #11)", 名存); 发错误("A3105", 错缓冲);
                }
            }
        }
    }
}
静 整 语句(空) {
