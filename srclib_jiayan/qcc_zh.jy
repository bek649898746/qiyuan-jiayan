                    汇发("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,1,0,1); 发字节(0x01); 模字节(3,2,3); /* ADD r11d, r10d (REX.R=1: reg=r10) */
