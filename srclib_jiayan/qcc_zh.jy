            若 (指[0] == '{' && 指[1] == '}') { /* 占位符 → 参数类型格式符 */
                常 字 *半十 = "%d";
                整 现高 = (甲序 < 匿数) ? 旁系(段吉[甲序]) : 0;
                若 (现高 >= 16) 半十 = "%s"; 否 若 (现高 == 5) 半十 = "%u"; 否 若 (现高 == 4) 半十 = "%f"; 否 若 (现高 == 3) 半十 = "%lld"; 否 若 (现高 == 1) 半十 = "%c"; /* A22 (2026-09-11): 指针 码 由 粗 6 改 「基类+16*深」 → >=16 判 字符串 (原 现高==6 失灵 → 指针 插值 落 %d) */
                甲序++;
