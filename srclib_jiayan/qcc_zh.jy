__attribute__((原粗))
静 空 整联一(整 号挂, 整 寄存器) {
    汇发("    存值 [r%d], r%d\n", (字*)(长 长)(号挂), (字*)(长 长)(寄存器), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 号挂 & 8); 发字节(0x89);
    若 (号挂 == 4 || 号挂 == 12) { 模字节(0, 寄存器 & 7, 号挂 & 7); 发字节(0x24); }
