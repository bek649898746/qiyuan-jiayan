        测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 串排, 1);
        汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0xFF);模字节(3,0,0); /* inc r8 */
        汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC0); /* inc eax */
        相对跳转(-1); 补标号(码位-4, 现陆, 2);
        设标号(串排);
        移64(8, 0); /* r8 = len */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* align */
        减栈即(48);
        移64(1, 10); /* rcx = handle */
        移64(2, 11); /* rdx = str */
