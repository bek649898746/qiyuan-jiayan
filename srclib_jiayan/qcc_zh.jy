静 构 { 字 名[64]; 整 是否构标; 字 构名一[64]; 字 是否浮标;
                 字 是否函数指; 字 函数指浮; 字 无符号标; 字 是否指针标; 整 尺寸; 整 数组数一; 整 指元素尺寸; 整 指构序; 整 别指针深; } 型定表[2048]; 静 整 型定数; /* C54 (2026-09-17): typedef 指针别名 登记「指针性质」— 原只记尺寸 ⟹ `typedef 结构体 S *TP;` 与 `typedef 结构体 S TP;` 记录相同 ⟹ `TP p;` 按尺寸==8 走 8字节整数入口 余乙 ⟹ 与形参同名时静默复用形参条目 ⟹ A9001 (nedmalloc threadcache_free) */ /* 尺寸: 基类型字节大小 (修复 2026-08-17: 类型定义 字段大小); 数组数一: 类型定义 数组元素数 (修复 2026-08-27 特性#2: 类型定义 整数 arr_t[3] — 尺寸(arr_t)=12, 变量声明按数组); P1 静默根治 (2026-09-15): 512→2048 — 满员 曾 静默 丢 类型定义 登记 (同一清扫族), 现 满则 原得 响亮拒绝 */

__attribute__((原粗))
静 整 型定查(常 字 *数) {
    遍 (整 计 = 型定数 - 1; 计 >= 0; 计--) 若 (!比较字符串(型定表[计].名, 数)) 返 计; /* P3-7b: 反向扫描 — 后注册 (内层块) 优先, 实现 遮蔽 */
    返 -1;
}
/* 结构体 类型 索引 遍 a 类型定义 名 那 aliases a 结构体 (否则 -1) */
静 整 容成(常 字 *数) {
    整 计 = 型定查(数);
    若 (计 >= 0 && 型定表[计].是否构标) 返 查类型(型定表[计].构名一);
    返 -1;
}
__attribute__((原粗))
静 空 型定加(常 字 *数, 整 全对, 常 字 *符号数, 整 是否浮标, 整 容薄, 整 无符号标, 整 指针元素, 整 指向构序) {
    若 (型定数 >= 2048) 原得("类型定义表 型定表", 2048);
    /* P3-7b (2026-09-11): 原 重复名 早返 (首次注册 生效) → 允许 追加 同名条目, 由 型定查 取 最后 一条 实现 遮蔽
       (配合 块() 出口 型定数 截断: 块内 同名别名 出块 自动 失效 ✓) */
    复制字符串(型定表[型定数].名, 数);
    型定表[型定数].是否构标 = 全对;
    型定表[型定数].是否浮标 = (字)是否浮标;
    型定表[型定数].无符号标 = (字)无符号标;
    型定表[型定数].是否函数指 = 0;
    型定表[型定数].函数指浮 = 0;
    型定表[型定数].尺寸 = 容薄; /* 修复 2026-08-17 */
    型定表[型定数].数组数一 = 0;
    型定表[型定数].是否指针标 = 指针元素 > 0 ? 1 : 0; 型定表[型定数].指元素尺寸 = 指针元素; 型定表[型定数].指构序 = 指向构序; /* C54 + 第82站: 指向构序 */
    若 (符号数) 复制字符串(型定表[型定数].构名一, 符号数);
    型定数++;
}
/* 函数指 类型定义: 类型定义 整数 (*fp_t)(整数,整数); — 8-字节 元素, 永不 a 双精度 槽位 */
静 空 型定加函数指(常 字 *数, 整 返浮) {
    若 (型定数 >= 2048) 原得("类型定义表 型定表", 2048);
    遍 (整 计 = 0; 计 < 型定数; 计++) 若 (!比较字符串(型定表[计].名, 数)) 返;
    复制字符串(型定表[型定数].名, 数);
    型定表[型定数].是否构标 = 0;
    型定表[型定数].是否浮标 = 0; /* 函数指 是 a 指针, 非 a 双精度 值 */
    型定表[型定数].无符号标 = 0;
    型定表[型定数].是否函数指 = 1;
    型定表[型定数].函数指浮 = (字)(返浮 ? 1 : 0); /* 双精度-返回 函数指: 函数指针(x) 产出 xmm0 */
    型定表[型定数].尺寸 = 8; /* 修复 2026-08-27 特性#2: 尺寸(函数指 类型定义) 原 0 */
    型定表[型定数].构名一[0] = 0;
    型定数++;
}

/* 闁冲厜鍋撻柍鍏夊亾闁冲厜�?类型定义 词法器�? 婵炲鍔岄崬浠嬪礆椤愩垺�?�?块/解析濞戞挾鎹奷_is闁告帇鍊栭弻?闁冲厜鍋撻柍鍏夊亾闁冲厜�?*/
静 字 标降一[512][64]; 静 整 深平;
静 空 左系(常 字 *数) {
    遍 (整 计 = 0; 计 < 深平; 计++) 若 (!比较字符串(标降一[计], 数)) 返;
    若 (深平 < 512) { 复制字符串(标降一[深平], 数); 深平++; } 否 原得("类型定义表 标降一", 512);
}
静 整 型定判断(常 字 *数) {
    遍 (整 计 = 0; 计 < 深平; 计++) 若 (!比较字符串(标降一[计], 数)) 返 1;
    返 0;
}

/* 闁冲厜鍋撻柍鍏夊亾闁冲厜�?枚举 閻㈩垱鎮傞崳铏规�?闁冲厜鍋撻柍鍏夊亾闁冲厜�?*/
静 构 { 字 名[64]; 整 数值; } 堆九一[8192]; 静 整 暂肆; /* 修复 2026-08-15: 256→8192 — 内置/加.c 等大文件 包含 链注册 枚举 常量超 256, CMIT_FMT_EMAIL 被静默丢弃 → 链接器 未定义 */
静 构 { 字 名[64]; 整 底一; 整 底二; 整 底八; 整 底无符; } 枚底表[64]; /* 字段名 避开 保留类型词: 底一/底二/底八 = 底层 1/2/8 字节, 底无符 = 无符号 (原 拟 用 字符/短/长/无符号 被 A9001 字段名撞词 拦下) */ 静 整 枚底数 = 0; /* C23 枚举底层类型 (2026-09-01): 枚 名 : 类型 { } — 枚举名→底层宽度标志 (枚 小 v; 按底层宽度注册). A3-枚举底层 (2026-09-12): 原 5 个 平行 一维 数组 (枚底名[32][64]/枚底字符[32]/枚底短[32]/枚底长[32]/枚底无符号[32]) 合成 一个 结构体 数组 (真结构: 同一 实体 的 属性 不再 分散 在 5 个 按 索引 对齐 的 数组 里); 容量 32 → 64 (原 32 满 即 静默丢弃) */
静 整 枚底查(常 字 *名) { 遍 (整 计 = 0; 计 < 枚底数; 计++) 若 (!比较字符串(枚底表[计].名, 名)) 返 计; 返 -1; } /* 枚底表查询: -1=未指定底层 (A3-枚举底层: 读 结构体 数组 的 名 字段) */
静 空 尾辰(常 字 *数, 整 值) {
    若 (暂肆 >= 8192) 原得("枚举常量表 堆九一", 8192);
    复制字符串(堆九一[暂肆].名, 数); 堆九一[暂肆].数值 = 值; 暂肆++;
}
静 整 全回(常 字 *数) {
    遍 (整 计 = 0; 计 < 暂肆; 计++) 若 (!比较字符串(堆九一[计].名, 数)) 返 堆九一[计].数值;
    返 0x80000000; /* ENUM_NOT_FOUND (修复 2026-08-09: 原 -1 与负值 枚举 常量冲突 → RED=-2 被当未找到 → 当变量用=0) */
}
静 构 { 字 名[64]; 整 变量数; } 直寅[256]; 静 整 链平; /* 判别表 (接入 2026-08-28 #97/#141): 判别类型名 → 变体数, 供依据 穷尽 检查 */
静 空 间繁(常 字 *数, 整 上高一) { 若 (链平 < 256) { 复制字符串(直寅[链平].名, 数); 直寅[链平].变量数 = 上高一; 链平++; } 否 原得("判别表 disc", 256); }
静 整 深薄(常 字 *数) { 遍 (整 计 = 0; 计 < 链平; 计++) 若 (!比较字符串(直寅[计].名, 数)) 返 直寅[计].变量数; 返 -1; }

/* ?????????? 双精度 ??????????? */
静 整 现退[8192]; 静 整 逆组[8192]; 静 整 浮数;
静 整 原七; /* 集 由 码生成() 之前 算寄存器: 帧寅 操作数 是 无符号 → 右移一 (修复 2026-08-05) */
静 整 现拾;   /* 集 由 码生成() 之前 算寄存器: 行降/度未 操作数(s) 无符号 → 除 (修复 2026-08-06 M1) */
/* 解析 a 浮点 字面量 于 s[*i] (数字 [ . 数字] [e[+-]数字]) 入 其
   IEEE-754 位 模式; advances *i 已过 该 字面量. 自身-宿主 已 无 真
   长整 长整 (它's a 32-位 整数), 故 该 8-字节 模式 是 已返回 作为 二
   ints (度附/链劣) 读取 出 的 该 双精度's 帧-槽位 字节 经 a 字符*. */
静 空 行丁(常 字 *串值, 整 *圆周率, 整 *首回, 整 *号九) {
    双 值 = 0; 整 计 = *圆周率;
    循环 (串值[计] >= '0' && 串值[计] <= '9') { 值 = 值 * 10 + (串值[计] - '0'); 计++; }
    若 (串值[计] == '.') { 计++; 双 顺转 = 0, 域 = 1; 循环 (串值[计] >= '0' && 串值[计] <= '9') { 顺转 = 顺转 * 10 + (串值[计] - '0'); 域 *= 10; 计++; } 值 += 顺转 / 域; } /* 修复 2026-08-06: 整数累加+单次除法，避免 顺转*=0.1 累加误差（0.015625 等精确） */
    若 (串值[计] == 'e' || 串值[计] == 'E') {
        计++; 整 值吉 = 1;
        若 (串值[计] == '+' || 串值[计] == '-') { 若 (串值[计] == '-') 值吉 = -1; 计++; }
        整 终 = 0; 循环 (串值[计] >= '0' && 串值[计] <= '9') { 终 = 终 * 10 + (串值[计] - '0'); 计++; }
        双 尾低 = 1; 遍 (整 键 = 0; 键 < 终; 键++) 尾低 *= 10;
        若 (值吉 > 0) 值 *= 尾低; 否 值 /= 尾低;
    }
    *圆周率 = 计;
    字 *值子 = (字 *)&值;
    整 链劣 = (值子[0] & 0xff) | ((值子[1] & 0xff) << 8) | ((值子[2] & 0xff) << 16) | ((值子[3] & 0xff) << 24);
    整 度附 = (值子[4] & 0xff) | ((值子[5] & 0xff) << 8) | ((值子[6] & 0xff) << 16) | ((值子[7] & 0xff) << 24);
    *号九 = 链劣; *首回 = 度附;
}

/* 十六进制 单精度 字面量: 0x1.8p3 = 1.5*2^3 = 12.0 (C99; 修复 2026-08-05: 曾 已解析 作为 十六进制 整数 则 垃圾) */
静 空 上复(常 字 *串值, 整 *圆周率, 整 *首回, 整 *号九) {
    双 值 = 0; 整 计 = *圆周率; /* s[i] = 首 十六进制 数字 (之后 0x) */
    循环 (判十六进制((无 字)串值[计])) { 整 字符 = 串值[计] | 0x20; 值 = 值 * 16 + (字符 <= '9' ? 字符 - '0' : 字符 - 'a' + 10); 计++; }
    若 (串值[计] == '.') {
        计++;
        双 顺转 = 1.0 / 16;
        循环 (判十六进制((无 字)串值[计])) { 整 字符 = 串值[计] | 0x20; 双 元 = 字符 <= '9' ? 字符 - '0' : 字符 - 'a' + 10; 值 += 元 * 顺转; 顺转 /= 16; 计++; }
    }
    若 (串值[计] == 'p' || 串值[计] == 'P') {
        计++; 整 值吉 = 1;
        若 (串值[计] == '+' || 串值[计] == '-') { 若 (串值[计] == '-') 值吉 = -1; 计++; }
        整 终 = 0; 循环 (串值[计] >= '0' && 串值[计] <= '9') { 终 = 终 * 10 + (串值[计] - '0'); 计++; }
        双 满列 = 1; 遍 (整 键 = 0; 键 < 终; 键++) 满列 *= 2;
        若 (值吉 > 0) 值 *= 满列; 否 值 /= 满列;
    }
    *圆周率 = 计;
    字 *值子 = (字 *)&值;
    整 链劣 = (值子[0] & 0xff) | ((值子[1] & 0xff) << 8) | ((值子[2] & 0xff) << 16) | ((值子[3] & 0xff) << 24);
    整 度附 = (值子[4] & 0xff) | ((值子[5] & 0xff) << 8) | ((值子[6] & 0xff) << 16) | ((值子[7] & 0xff) << 24);
    *号九 = 链劣; *首回 = 度附;
}

/* ?????? 词元 类型 常量 (必须 precede 码生成器 函数) ?????? */
#define 号汇 0
#define 邻一 1
#define 右得 2
#define 高拾 5   /* + */
#define 旧肆 6   /* - */
#define 下得 7   /* * */
#define 比等 8   /* == */
#define 比小 11  /* < */
#define 外三 21  /* > */
#define 名庚 10  /* != */
#define 隔系 22  /* <= */
#define 宽排 23  /* >= */
#define 行降 42  /* / */
#define 度未 43  /* % */
#define 号庚 44  /* << */
#define 帧寅 45  /* >> */
/* #289 调试信息 (2026-09-01): -g 时独立缓冲收集 行号表 (码位,行号) + 函数表 (名/起/止/行).
   隔离原则: 仅读 码位/词行表, 不写共享状态 → -g vs 无-g 产物 .text 逐字节一致 (验收门①) */
静 整 当前节行 = 0; /* #289 (第 453 站): 码生成 当前 节点 的 源行 —— 语句级 行表 的 唯一 行源
      (原 发字节 读 `词行表[词位]`, 而 码生成期 词位 不再 前进 ⟹ 行表 实际 只 记到 1 行) */
静 整 当前函文 = 0; /* #289 (第 453 站): 当前 正在 生成 的 函数 的 文件号 —— 行 归属 必须 与 本函数 同文件
      (实测 主 序言 处 出现 运行时行 ⟹ 该处 字节 属 尾段/共享 节点, 非 本函数 源) */
静 整 调试开关 = 0;
静 整 调试行数 = 0; 静 整 调试上次行 = 0;
静 整 调试行表[262144][3]; /* [码位, 行号, 文件号] */
静 构 { 字 名[128]; 整 起; 整 止; 整 行; 整 文件; } 调试函数表[8192];
静 字 调试预名[64] = "qcc_rt.c"; /* #289 (第 453 站): 前插运行时 源名 = .debug_line 的 第 2 个 文件条目 */
静 空 调试归属(整 原行, 整 *文件, 整 *行) { /* #289 (第 453 站): 行号 归属 校正 —— 复用 全项目 同一 公式
      用户行 = 原行 - (剩伴 ? 剩伴 : 反进)  (见 发错误 L3408 / __LINE__ L7045 / 源位置 L8474 / 语义导航 L20208)。
      原行 落 前插区 (<= 偏移) ⟹ 归 运行时 文件, 行 保 原值 (其 行号空间 就是 运行时源)。 */
    整 偏 = 剩伴 ? 剩伴 : 反进;
    若 (原行 <= 偏) { *文件 = 2; *行 = 原行; }
    否 { *文件 = 1; *行 = 原行 - 偏; 若 (*行 < 1) *行 = 1; }
}
静 整 调试函数数 = 0;
静 字 调试缓冲[1048576]; 静 易失 整 调试缓冲位 = 0; /* 易失: 强制内存读写。131072→1048576 (#289 第 453 站: 行表 真归并后 行数 由 ~50 升到 万级, 原 缓冲 会 静默 截断 行号程序) */
静 整 调试节abbrev起, 调试节abbrev尺寸; 静 整 调试节info起, 调试节info尺寸; 静 整 调试节line起, 调试节line尺寸;

静 空 发字节(无 字 值) {
    若 (调试开关 && 调试行数 < 262144 && 当前节行 > 0 && 当前节行 != 调试上次行) {
        整 调文 = 0; 整 调行 = 0; 调试归属(当前节行, &调文, &调行); /* #289: 归属 校正 (用户行 / 运行时行) */
        若 (调文 == 当前函文) { /* #289: 只 记 与 本函数 同文件 的行 (滤 尾段/共享节点 的 跨文件 串行) */
            调试行表[调试行数][0] = 码位; 调试行表[调试行数][1] = 调行; 调试行表[调试行数][2] = 调文; 调试行数++;
            调试上次行 = 当前节行;
        }
    }
    若 (码位 >= 码缓容量) { 输出到文件(错误流, "qcc_x86: 代码 缓冲 溢出 (修复 2026-08-09 审计)\n"); 退出(1); } 码[码位++] = 值;
}
静 空 发四(整 值) { 发字节(值 & 0xff); 发字节((值 >> 8) & 0xff); 发字节((值 >> 16) & 0xff); 发字节((值 >> 24) & 0xff); }

/* ModR/M: 模=0(寄存器,[寄存器+位移])/1(寄存器,[寄存器+disp8])/2(寄存器,[寄存器+三十二位位移])/3(寄存器,寄存器) */
静 空 模字节(整 余, 整 寄存器, 整 堆再) { 发字节((余 << 6) | ((寄存器 & 7) << 3) | (堆再 & 7)); }
/* 扩展前缀 余散一: W=64位, R=寄存器 ext, X=索引 ext, B=堆再 ext */
静 空 前缀字节(整 戌, 整 结, 整 亥, 整 旧合) { 发字节(0x40 | (戌 ? 8 : 0) | (结 ? 4 : 0) | (亥 ? 2 : 0) | (旧合 ? 1 : 0)); }

/* 移动 三十二位寄存器, 三十二位立即数 (零-扩展 到 64-位 在 x86-64) */
静 空 移即(整 寄存器, 整 立即数) { 汇发("    移动 r%d, %d\n", (字*)(长 长)(寄存器), (字*)(长 长)(立即数), (字*)(长 长)0); 发字节(0xB8 | (寄存器 & 7)); 发四(立即数); }
/* 移动 堆九, imm64 (48 反挂 imm64) — 长整 长整 字面量 (修复 2026-08-05) */
静 空 计升(长 长 立即数) {
    汇发("    移动64 r0, %d, %d\n", (字*)(长 长)((整)(立即数 & 0xFFFFFFFF)), (字*)(长 长)((整)(((无 长 长)立即数) >> 32)), (字*)(长 长)0); /* 文本: 链劣, 度附 (中文汇编 需 度附 遍 首利二==计简一; 修复 2026-08-05) */
    发字节(0x48); 发字节(0xB8); 发四((整)(立即数 & 0xFFFFFFFF)); 发四((整)(((无 长 长)立即数) >> 32));
}
/* 压栈/弹栈 r64 (减 rsp,8; 移动 [rsp],r64) — 64-位 temporaries, 嵌套-safe (修复 2026-08-05) */
/* 注意: 序布 之后 减栈即/加栈即 (以下 831) — 减栈即 需 其 向前 声明 首 */
/* 移动 [rsp+位移], 三十二位寄存器 */
__attribute__((原粗))
静 空 旁五(整 位移, 整 寄存器) {
    汇发("    存栈32 [rsp%+d], r%d\n", (字*)(长 长)(位移), (字*)(长 长)(寄存器), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 0); 发字节(0x89);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 4); 发字节(0x24); 发四(位移); }
}
/* 移动 三十二位寄存器, [rsp+位移] */
__attribute__((原粗))
静 空 双从一(整 寄存器, 整 位移) {
    汇发("    取栈32 r%d, [rsp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 0); 发字节(0x8B);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 4); 发字节(0x24); 发四(位移); }
}
/* 移动 reg64, reg64 */
静 空 移64(整 目标, 整 源) { 汇发("    移64 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0); 前缀字节(1, 源 & 8, 0, 目标 & 8); 发字节(0x89); 模字节(3, 源 & 7, 目标 & 7); }
/* 移动 三十二位寄存器, 三十二位寄存器 */
静 空 移寄存器(整 目标, 整 源) { 汇发("    移32 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0); 前缀字节(0, 源 & 8, 0, 目标 & 8); 发字节(0x89); 模字节(3, 源 & 7, 目标 & 7); }

/* 加/减/乘/比较 三十二位寄存器, 三十二位寄存器 ??算子 是 词元 类型 (加/减/乘/高平) */
静 空 算寄存器(整 算子, 整 目标, 整 源) {
    若 (算子 == 高拾) 汇发("    加 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 旧肆) 汇发("    减 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 下得) 汇发("    乘 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 比等) 汇发("    比较 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 25 || 算子 == 46) 汇发("    与 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0); /* & : 点(25) 自 a&b, 与(46) 自 a&=b — 修复 2026-08-05 */
    否 若 (算子 == 47) 汇发("    或 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 48) 汇发("    异或 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 行降 || 算子 == 度未) { /* 除: expanded 作为 扩展符号 + 整除 r9 (显式 texts) */ }
    若 (算子 == 号庚 || 算子 == 帧寅) {
        /* 修复: 汇编 文本 顺序 必须 匹配 字节 顺序 (移动 ecx,首子 已发射 首).
           帧寅: 发射 一 文本+字节 pair 以下 (逻辑右移/右移一 或 算术右移/算术右移) — 该
           泛型 `右移` 行 此处 将 双精度 该 文本 (计简一 已发射 2× 算术右移 → 首利二≠计简一,
           修复 2026-08-06, 匹配 grok-构建's 单 发射). */
        移寄存器(1, 0); /* ecx = 移位 计数 */
        若 (算子 == 号庚) 汇发("    左移 r%d, cl\n", (字*)(长 长)(目标), (字*)(长 长)0, (字*)(长 长)0);
        否 若 (算子 == 帧寅) { /* fallthrough 到 该 右移一/算术右移 行 以下 */ }
        否 汇发("    右移 r%d, cl\n", (字*)(长 长)(目标), (字*)(长 长)0, (字*)(长 长)0);
        /* 无符号 操作数 >> → 右移一 (逻辑); 有符号 → 算术右移 (修复 2026-08-05: 总是 算术右移) */
        若 (算子 == 帧寅) {
            整 栈集 = 原七;
            原七 = 0;
            若 (栈集) { 汇发("    逻辑右移 r%d, cl\n", (字*)(长 长)(目标), (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 目标 & 8); 发字节(0xD3); 模字节(3, 5, 目标 & 7); }
            否 { 汇发("    算术右移 r%d, cl\n", (字*)(长 长)(目标), (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 目标 & 8); 发字节(0xD3); 模字节(3, 7, 目标 & 7); }
            返;
        }
        前缀字节(0, 0, 0, 目标 & 8); 发字节(0xD3); 模字节(3, 4, 目标 & 7);
        返;
    }
    若 (算子 == 25 || 算子 == 46) { 前缀字节(0, 源 & 8, 0, 目标 & 8); 发字节(0x21); 模字节(3, 源 & 7, 目标 & 7); 返; } /* & (修复 2026-08-05: 与=46 自 &=) */
    若 (算子 == 47) { 前缀字节(0, 源 & 8, 0, 目标 & 8); 发字节(0x09); 模字节(3, 源 & 7, 目标 & 7); 返; } /* | */
    若 (算子 == 48) { 前缀字节(0, 源 & 8, 0, 目标 & 8); 发字节(0x31); 模字节(3, 源 & 7, 目标 & 7); 返; } /* ^ */
    若 (算子 == 下得) {
        /* 乘: 寄存器=目标, 堆再=源 */
        前缀字节(0, 目标 & 8 ? 1 : 0, 0, 源 & 8 ? 1 : 0);
        发字节(0x0F); 发字节(0xAF); 模字节(3, 目标 & 7, 源 & 7);
        返;
    }
    若 (算子 == 行降 || 算子 == 度未) {
        整 邻亥 = 现拾; 现拾 = 0; /* 修复 2026-08-06 M1: 无符号 除法 */
        移寄存器(9, 0); /* r9d = 除数 */
        移寄存器(0, 目标); /* 首子 = dividend */
        若 (邻亥) {
            汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
            汇发("    无符号除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xF7); 模字节(3, 6, 1); /* 除 r9d */
        } 否 {
            汇发("    扩展符号\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x99); /* 符号扩展 (修复 2026-08-06 M1: 原 48 99=CQO 检查 堆九 位63，32位负值高32位为0 → RDX=0 → 变无符号除法! -7/2 误算 2147483644) */
            汇发("    整除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xF7); 模字节(3, 7, 1); /* 除 r9d (扩展前缀.B=1 遍 堆再=r9) */
        }
        若 (算子 == 度未) 移寄存器(0, 2); /* 余 �?首子 */
        移寄存器(目标, 0); /* 结果 �?目标 遍 移寄存器(0,目标) 在 调用方 */
        返;
    }
    前缀字节(0, 源 & 8, 0, 目标 & 8);
    若 (算子 == 高拾) { 发字节(0x01); 模字节(3, 源 & 7, 目标 & 7); }
    否 若 (算子 == 旧肆) { 发字节(0x29); 模字节(3, 源 & 7, 目标 & 7); }
    否 若 (算子 == 比等) { 发字节(0x39); 模字节(3, 源 & 7, 目标 & 7); }
}
/* 加/减 三十二位寄存器, 八位立即数/三十二位立即数 (修复 2026-08-03: 八位立即数-仅 符号-已扩展 偏移
   >127 到 负 (128 → 0x80 → -128) → e->字段 存储 于 偏移≥128 wrote
   后 该 结构体. 三十二位立即数 form (81 /0 末丙) 当 该 值 doesn't fit 八位立即数.) */
静 空 __attribute__((原粗)) 隔利二(整 算子, 整 寄存器, 整 立即数) {
    汇发("    运即 r%d, %d\n", (字*)(长 长)(寄存器), (字*)(长 长)(立即数), (字*)(长 长)0);
    前缀字节(0, 0, 0, 寄存器 & 8);
    若 (算子 == 高拾) {
        若 (立即数 >= -128 && 立即数 <= 127) { 发字节(0x83); 模字节(3, 0, 寄存器 & 7); 发字节(立即数); }
        否 { 发字节(0x81); 模字节(3, 0, 寄存器 & 7); 发四(立即数); }
    }
    否 若 (算子 == 旧肆) {
        若 (立即数 >= -128 && 立即数 <= 127) { 发字节(0x83); 模字节(3, 5, 寄存器 & 7); 发字节(立即数); }
        否 { 发字节(0x81); 模字节(3, 5, 寄存器 & 7); 发四(立即数); }
    }
}
/* 测试 三十二位寄存器, 三十二位寄存器 ??集 满寅一 */
静 空 测寄存器(整 暂利, 整 符拾) { 汇发("    测试 r%d, r%d\n", (字*)(长 长)(暂利), (字*)(长 长)(符拾), (字*)(长 长)0); 前缀字节(0, 符拾 & 8, 0, 暂利 & 8); 发字节(0x85); 模字节(3, 符拾 & 7, 暂利 & 7); }
/* 压栈/弹栈 reg64 ??总是 64-位 在 长整 模式, 扩展前缀 仅 所需 遍 R8-R15 */
静 空 压栈寄存器(整 结) { 汇发("    压栈 r%d\n", (字*)(长 长)(结), (字*)(长 长)0, (字*)(长 长)0); 若 (结 & 8) 发字节(0x41); 发字节(0x50 | (结 & 7)); }
静 空 弹栈寄存器(整 结) { 汇发("    弹栈 r%d\n", (字*)(长 长)(结), (字*)(长 长)0, (字*)(长 长)0); 若 (结 & 8) 发字节(0x41); 发字节(0x58 | (结 & 7)); }
/* 调用 三十二位相对 */
静 空 相对调用(整 尾午) { 发字节(0xE8); 发四(尾午); }
/* 符号扩展64 后辰, r11d — 32 位索引符号扩展到 64 位再作指针偏移 (修复 2026-08-19:
   原 移寄存器(11,0) 零扩展 → 负索引 (-1) 变 0xFFFFFFFF → 指针 + 4旁败 → 段错误
   (packed-backend find_start/find_end_of_record 的 p[-1] 扫描崩) */
静 空 符号扩展r11(空) {
    汇发("    符号扩展 r11, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x4D); 发字节(0x63); 发字节(0xDB); /* 符号扩展64 后辰, r11d (扩展前缀.W+R+B, 63, 模字节 11 011 011) */
}
/* 返回 */
静 空 返一(空) { 汇发("    返回\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xC3); }
/* 取址 reg64, [rsp+位移] */
__attribute__((原粗))
静 空 左壬一(整 寄存器, 整 位移) {
    汇发("    取址 r%d, [rsp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x8D);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 4); 发字节(0x24); 发四(位移); }
}
/* RBP-相对 variants: [rbp+位移] �?稳定 期间 嵌套 调用 / 临时 减 rsp.
   帧 槽位 于 [rsp+偏移] == [rbp + 偏移 - 当前帧大小] (rbp = rsp + 帧 于 入口). */
静 空 移帧寄存器(整 位移, 整 寄存器) {
    汇发("    存帧32 [rbp%+d], r%d\n", (字*)(长 长)(位移), (字*)(长 长)(寄存器), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 0); 发字节(0x89);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
静 空 移寄存器帧(整 寄存器, 整 位移) {
    汇发("    取帧32 r%d, [rbp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 0); 发字节(0x8B);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
静 空 取帧址(整 寄存器, 整 位移) {
    汇发("    取帧址 r%d, [rbp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x8D);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
/* 字符 数组[N] = "lit": 存储 一 字符串 字节 入 [rbp+位移] (C6 /0 = 移动 r/m8, 八位立即数) */
静 空 终巳(整 位移, 整 立即数) {
    汇发("    存字节 [rbp%+d], %d\n", (字*)(长 长)(位移), (字*)(长 长)(立即数), (字*)(长 长)0);
    发字节(0xC6);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 5); 发字节(位移); }
    否 { 模字节(2, 0, 5); 发四(位移); }
    发字节(立即数 & 0xFF);
}
/* 局部 字符 变量存储: 移动 字节 [rbp+位移], 累加低 (1 字节截断, 修复 2026-08-25 缺陷#28b) */
静 空 容回(整 位移) {
    汇发("    存字节 [rbp%+d], al\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x88);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 5); 发字节(位移); }
    否 { 模字节(2, 0, 5); 发四(位移); }
}
/* 局部 字符 变量读取: 零扩展 首子, 字节 [rbp+位移] (零扩展, 编译器 字符=无符号 约定, 修复 2026-08-25 缺陷#28b) */
静 空 零扩展字节(整 位移) {
    汇发("    零扩展字节 r0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x0F); 发字节(0xB6); 发字节(0x85); 发四(位移); /* 零扩展 首子, 字节 [rbp+位移] */
}
/* 局部 有符号 字符 变量读取: 符号扩展 首子, 字节 [rbp+位移] (符号扩展, 修复 2026-08-29 生成器) */
静 空 符号扩展字节(整 位移) {
    汇发("    符号扩展字节 r0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x0F); 发字节(0xBE); 发字节(0x85); 发四(位移); /* 符号扩展 首子, 字节 [rbp+位移] */
}
/* 局部 短整 变量读取: 零扩展 首子, 字 [rbp+位移] (零扩展, uint16_t/无符号 短整, 修复 2026-08-25 缺陷#31b) */
静 空 零扩展字(整 位移) {
    汇发("    零扩展字 r0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x0F); 发字节(0xB7); 发字节(0x85); 发四(位移); /* 零扩展 首子, 字 [rbp+位移] */
}
/* 局部 有符号 短整 变量读取: 符号扩展 首子, 字 [rbp+位移] (符号扩展, 修复 2026-08-25 缺陷#31b) */
静 空 符号扩展字(整 位移) {
    汇发("    符号扩展字 r0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x0F); 发字节(0xBF); 发字节(0x85); 发四(位移); /* 符号扩展 首子, 字 [rbp+位移] */
}
/* 局部 短整 变量存储: 移动 字 [rbp+位移], ax (2 字节截断, 修复 2026-08-25 缺陷#31b) */
静 空 串戊(整 位移) {
    汇发("    存字 [rbp%+d], ax\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x66); 发字节(0x89);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 5); 发字节(位移); }
    否 { 模字节(2, 0, 5); 发四(位移); }
}
/* 字符 数组[N] = "lit" (静态, 目标文件): 存储 一 字符串 字节 入 [堆九+位移]
   (C6 /0 移动 r/m8, 八位立即数 — 无 重定位 所需; 堆九 已由 度一 指向 .数据 槽,
   修复 2026-08-20: 原弊一 的 C6 05 三十二位位移 八位立即数 在 目标文件 模式无法生成 三十二位相对
   修复 (八位立即数 在 三十二位位移 后, 链接器 按 P+4 修正会偏 1) → 静态 字符 x[]="lit" 在 版本库
   对象里存成字符串地址 → mkstemps 的 x_pattern 内容垃圾 → 版本库 初始化 EINVAL) */
静 空 缺从(整 位移, 整 立即数) {
    汇发("    存字节 [rax%+d], %d\n", (字*)(长 长)(位移), (字*)(长 长)(立即数), (字*)(长 长)0);
    发字节(0xC6);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 0); 发字节(位移); }
    否 { 模字节(2, 0, 0); 发四(位移); }
    发字节(立即数 & 0xFF);
}
/* 64-位 variants: preserve 满 指针 值 在 寄存器/槽位 */
静 空 反附(整 位移, 整 寄存器) {
    汇发("    存帧64 [rbp%+d], r%d\n", (字*)(长 长)(位移), (字*)(长 长)(寄存器), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x89);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
静 空 移寄存器帧64(整 寄存器, 整 位移) {
    汇发("    取帧64 r%d, [rbp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x8B);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
/* ---- SSE 双精度 (xmm0) helpers ---- */
静 空 减栈即(整 值);
静 空 加栈即(整 值);
静 空 逆厚(整 位移) { 汇发("    浮取帧 xmm0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 5); 发字节(位移); } 否 { 模字节(2, 0, 5); 发四(位移); } }
静 空 余申(整 位移) { 汇发("    浮存帧 [rbp%+d], xmm0\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x11); 若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 5); 发字节(位移); } 否 { 模字节(2, 0, 5); 发四(位移); } }
静 空 短弊(空) { 汇发("    浮移 xmm1, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 发字节(0xC8); }
静 空 新劣(空) { 汇发("    浮移 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 发字节(0xC1); }
静 空 逆排(空) { 汇发("    浮取参 xmm0, [r13]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x41); 发字节(0x0F); 发字节(0x10); 发字节(0x45); 发字节(0x00); } /* 双精度移动 xmm0, [r13] — 扩展前缀 必须 follow 该 F2 强制 余散一 (F2 41 0F 10), 否则 该 CPU 忽略 它 且 读取 [rbp+0]! */
静 空 堆双(整 位移) { 汇发("    浮取帧 xmm1, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 若 (位移 < 128 && 位移 >= -128) { 模字节(1, 1, 5); 发字节(位移); } 否 { 模字节(2, 1, 5); 发四(位移); } }
静 空 余十(空) { 汇发("    整转浮 xmm1, eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x2A); 发字节(0xC8); }
/* 双精度 函数 参数 (六十四位窗口): 实参 i goes 在 xmm[i] (i<4) / [rsp+32+8i] (i>=4) */
静 空 主二(整 寄存器, 整 位移) { /* 双精度移动 xmmN, [rsp+位移] */
    汇发("    浮取栈 xmm%d, [rsp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    发字节(0xF2); 发字节(0x0F); 发字节(0x10);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(位移); }
