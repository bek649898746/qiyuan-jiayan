                    汇发("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,0,3); 发字节(7); /* 加 r11d, 7 */
                    汇发("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,4,3); 发字节(0xF8); /* 且 r11d, 0xFFFFFFF8 — 8 字节对齐 (修复 2026-08-22 t44 同 清零分配) */
                    移寄存器(8, 11);                /* r8d = 对齐起始 (返回 值) */
                    移寄存器(10, 1);                /* r10d = n (rcx) */
                    汇发("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,1,0,1); 发字节(0x01); 模字节(3,2,3); /* 加 r11d, r10d (扩展前缀.R=1: 寄存器=r10) */
                    汇发("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,0,3); 发字节(7);
                    汇发("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,4,3); 发字节(0xF8);
