                整 虚细 = 0; /* global long long: 8-byte .data slot (fix 2026-08-05) */
                整 逆辰 = 0; /* global unsigned (fix 2026-08-18: size_t 全局 → is_uns → seta 无符号比较) */
                遍 (整 词序二 = 存词位; 词序二 + 1 < 词位; 词序二++) { 若 (词型表[词序二] == 型词 && (!比较字符串(词名表[词序二], "long") || !比较字符串(词名表[词序二], "长") || !比较字符串(词名表[词序二], "长整")) && 词型表[词序二 + 1] == 型词 && (!比较字符串(词名表[词序二 + 1], "long") || !比较字符串(词名表[词序二 + 1], "长") || !比较字符串(词名表[词序二 + 1], "长整"))) 虚细 = 1; 若 (词型表[词序二] == 型词 && (!比较字符串(词名表[词序二], "unsigned") || !比较字符串(词名表[词序二], "无"))) 逆辰 = 1; }
                若 (!逆辰) { 整 新薄 = 全局型定 >= 0 ? 全局型定 : 型定查(词名表[存词位]); 若 (新薄 >= 0 && !型定表[新薄].是否构标 && !型定表[新薄].是否函数指 && !型定表[新薄].是否浮标 && 型定表[新薄].无符号标 && 型定表[新薄].尺寸 <= 8) 逆辰 = 1; } /* fix 2026-08-29 csmith: typedef unsigned 全局 (uint32_t g=0xFFFFFFFF) — 原只认 unsigned 关键字 → is_uns=0 → 传参符号扩展 crc 错 (s175 g_2) */
                若 (!虚细) { 整 名分 = 全局型定 >= 0 ? 全局型定 : 型定查(词名表[存词位]); 若 (名分 >= 0 && !型定表[名分].是否函数指 && !型定表[名分].是否构标 && !型定表[名分].是否浮标 && 型定表[名分].尺寸 == 8 && !双回) 虚细 = 1; } /* fix 2026-08-18: typedef 8B 基类型 (size_t) 全局 → 8 字节 .data */
                { 整 堆成 = 全局型定 >= 0 ? 全局型定 : 型定查(词名表[存词位]); 若 (堆成 >= 0 && !型定表[堆成].是否构标 && !型定表[堆成].是否函数指 && !型定表[堆成].是否浮标 && 型定表[堆成].尺寸 == 2) { 副劣 = 1; 若 (型定表[堆成].无符号标) 逆辰 = 1; } } /* fix 2026-08-29 csmith: typedef short 全局 (int16_t/uint16_t) — 原只认 short 关键字 → int16_t g 标量 32 位零扩展 → 传参错 (seed102/18/64) */
                { 整 新薄 = 全局型定 >= 0 ? 全局型定 : 型定查(词名表[存词位]); 若 (新薄 >= 0 && !型定表[新薄].是否构标 && !型定表[新薄].是否函数指 && !型定表[新薄].是否浮标 && 型定表[新薄].无符号标 && 型定表[新薄].尺寸 <= 8) 逆辰 = 1; } /* fix 2026-08-29 csmith: typedef unsigned 全局 (uint32_t g=0xFFFFFFFF) — 原只认 unsigned 关键字 → is_uns=0 → 传参按 signed 符号扩展 → crc 错 (s94 g_26) */
                整 中附 = 0, 原分 = 0; /* typedef'd fnptr global: 8-byte .data slot (fix 2026-08-03) */
                { 整 型定序 = 全局型定 >= 0 ? 全局型定 : 型定查(词名表[存词位]); 若 (型定序 >= 0 && 型定表[型定序].是否函数指) { 中附 = 1; 原分 = 型定表[型定序].函数指浮; } } /* fix 2026-08-07: g_tdef 覆盖 static 前缀 (static ops_t f 之前落 var_static(0)=4B) */
                整 首变 = 1;
                循环 (1) {
                    整 新壹 = 0;
                    /* The type prefix parser above already consumes leading * for the FIRST
                       declarator (so function-def detection sees the name). Recover that
                       pointer depth here, otherwise `struct T *arr[]`/`char *names[]` are
                       registered as arrays-of-struct/chars instead of arrays-of-pointers.
                       (fix 2026-08-15: tr2_tgt_builtins[] for_each_builtin hang) */
                    若 (首变) 遍 (整 池进 = 存词位; 池进 < 词位; 池进++) 若 (词型表[池进] == 乘) 新壹++; /* fix 2026-08-16 根因D: 循环变量 p 遮蔽 parse 根节点 p (L4760 int p=Nd(3)), qcc 按名复用槽 → 循环写坏根 p → fdef 全挂错节点 → 解析树成环 → oidmap 无限递归。改名 pk 隔离作用域。 */
                    循环 (词型表[词位] == 乘) { 新壹++; 词位++; }
                    若 (词型表[词位] == 左括) { /* struct T * (name[N]); — 括号数组声明 (fix 2026-08-15: pack-objects.c pbase_tree_cache[256] 解析断 → oe_get_size_slow undefined) */
                        词位++; /* ( */
                        若 (词型表[词位] == 词变量) {
                            字 现退三[64]; 复制字符串(现退三, 词名表[词位]); 词位++;
                            整 单转 = 1;
                            循环 (词型表[词位] == 左方) { 词位++; 整 满寅二 = 0; 若 (常量表达式求值(&满寅二)) 单转 *= 满寅二; 否 若 (词型表[词位] == 词变量) 词位++; 若 (词型表[词位] == 右方) 词位++; }
                            若 (词型表[词位] == 右括) 词位++; /* ) */
                            隔排(现退三, 0, 8, 单转); /* 指针数组: 8 字节元素 */
                            变量表[变量数 - 1].指元素尺寸 = 8;
                            若 (旁申) 逆酉[变量数 - 1] = 1;
                            循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++;
                            若 (词型表[词位] == 分号) 词位++;
                        }
                        断;
                    }
                    若 (词型表[词位] != 词变量 || 词型表[词位 + 1] == 左括) { 词位 = 存词位; 断; }
                    字 毛寅[64]; 复制字符串(毛寅, 词名表[词位]); 词位++;
                    /* char* -> esz 1 (byte indexing); int* -> 4; char** -> 8 via
                       the ptr-depth in the loop below (keep the LAST depth's char flag) */
                    整 值午 = (全局型定 >= 0 && !型定表[全局型定].是否函数指 && !型定表[全局型定].是否构标 && 型定表[全局型定].尺寸 > 0) ? 型定表[全局型定].尺寸 : 0; /* fix 2026-08-19: typedef 标量全局数组元素大小 (wchar_t=unsigned short → 2) */
