    遍 (整 计 = 0; 串值[计]; 计++) {
        若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) 计++; 计++; 续; }
        若 (串值[计] == '/' && 串值[计 + 1] == '/') { 循环 (串值[计] && 串值[计] != '\n') 计++; 续; }
        若 (串值[计] == '"') { 计++; 循环 (串值[计] && 串值[计] != '"') { 若 (串值[计] == '\\') 计++; 计++; } 续; }
        若 (串值[计] == '\'') { 计++; 循环 (串值[计] && 串值[计] != '\'') { 若 (串值[计] == '\\') 计++; 计++; } 续; }
        若 (串值[计] == '#') { /* fix 2026-08-07: 条件编译感知 — 假分支里的 #define 不收 (否则 #if 0 里的宏被误收集展开) */
