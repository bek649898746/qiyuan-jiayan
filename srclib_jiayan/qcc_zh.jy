        遍 (整 计 = 0; 计 < 匿数; 计++) 接子(呼, 段吉[计]); /* 参数 */
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "printf", 7); 接子(呼, 函); } /* 被调者 最后 */
        返 呼;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "投递")) { /* 接入 2026-08-27 actor 消息投递; 2026-09-01 #19 语言级邮箱: 投递 名, v; → 内联入队 (若 __ac_名_buf 已声明), 否则回退 actor_send(&m, v) */
        糖目标放行(词位 + 1); /* D12R456 */
