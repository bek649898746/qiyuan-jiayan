                        整 全轮 = 4, 后厚 = -1;
                        内存地址(微码, &全轮, &后厚); /* 探测: 链末字段类型 (发射 一次, 后续 双精度 分支重取) */
                        若 ((后厚 >= 0 && 终捌(后厚, 串升)) || (整回 >= 0 && 终捌(整回, 串升))) { /* 修复 2026-08-27 特性#4: 嵌套链 双精度 字段写入 (b.数值.d = 3.14) — 原 码生成+压栈寄存器 存 堆九 (双精度 在 xmm0) → 0.0; 构序出 是字段指向 结构体 (d=-1), 用 整回 (字段所在结构体); 特性#5: 匿名 结构体 用索引查 (字段是否浮 按名 "" 失败) */
                            码生成浮(子1[数]); 压浮0();
                            若 (内存地址(微码, &域尺寸, &构序出) == 0) { 弹浮0(); 整 单浮序 = 整回 >= 0 ? 整回 : 后厚; 若 (单浮序 >= 0 && 终捌单(单浮序, 串升)) { 中发(栈丁单, 0, 0, 0); 中刷(); } 否 { 中发(栈丁, 0, 0, 0); 中刷(); } } /* R4a-0b: 嵌套链 4B float 字段单存 */
                        } 否 {
                        码生成(子1[数]); 若 (全轮 == 8 && !(子1[数] >= 0 && 节型表[子1[数]] == 4)) 扩32(子1[数]); 压栈寄存器(0); /* 保存 右侧 - 修复 2026-09-03 p103: 嵌套成员 64位字段 = 32位整常数 RHS 符号扩展; R449 (**主因**, 2026-09-20): 排除 调用 RHS — 调用 按 ABI 返回 8B 构值 时 值 已 完整 在 rax, 扩32 (符号扩展 32->64) 把 高 32 位 归零 ⟹ 存 8 字节 也 只 得 低半 (o.内.内 = 取构() 得 v=3 w=0). 插桩实录 全轮=8 ⟹ 本 行 对 调用 一直 在 扩32. 同族 第5例 (R435/R446/R447 都 补 同款 !(节型表==4) 守卫) */
                        若 (内存地址(微码, &域尺寸, &构序出) == 0) { /* 堆九 = &链 */
                            弹栈寄存器(3); /* ebx = 右侧 */
                            若 (构序出 >= 0 && 存壬(类型表[构序出].名, 串升)) { /* 位-字段 RMW 存储 (修复 2026-08-05) */ }
                            否 若 (域尺寸 == 1) { 中发(整集, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 嵌套链 存 字符 */
                否 若 (域尺寸 == 2) { 中发(旁辰, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 嵌套链 存 短整 */
                            否 若 (域尺寸 == 8 || 全轮 == 8) { 中发(堆柒, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 嵌套链 存 64; R449 (2026-09-20): 成员链 尾 字段 宽 8B + 调用 RHS (o.内.内 = 取构()) 原 只 存 4 字节 (得 v=3 w=0). 根因 (**插桩实录**): 本 分支 对 同一 链 节点 探测 两次 —— L24948 先 探测 得 全轮=8 (正确 宽度), 随后 L24953 码生成(调用) 覆盖 内存地址 依赖的 全局 状态 (长卯/中系/上薄[]) ⟹ L24954 再 探测 得 域尺寸=4 / 构序出=-1 (污染) ⟹ 域尺寸==8 永不 成立 ⟹ 落 前序 只 存 4 字节. 正解 = 用 **未被 污染 的 第一次 探测值 全轮** (在 码生成 之前 取得) 作 宽度 判据. 同族 第5例 (R435/R446/R447 之后); 后厚 不可用 (实测 后厚=2 非 构盒) */
                            否 { 中发(前序, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 嵌套链 存 32 */
                            移寄存器(0, 3); /* 首子 = 已存 值 (链式 赋值) */
                        }
                    }
                    }
                } 否 {
                字 *变名 = (字*)(节名表 + 子0[微码]); /* 结构体 变量 名 */
