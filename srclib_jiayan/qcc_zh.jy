                码生成(子0[数]); 断; }
            若 (码生成免解引用) { /* 修复 2026-08-08: 节点-23 后缀++/-- 需要 &目标 地址; 原 例-12 忽略 码生成免解引用 永远加载值 → (*p)++ 把值当地址. 修复 2026-08-27 第七批#5: 成员链操作数 (例 15) 在 码生成免解引用 下返回字段地址 → (*s.引用)-- 把 &s.引用 当 &目标 → 写错位 (计数器 变 256); 临时关 不引用 让操作数返回其值 (变量值/成员字段值 = 指针) */
                整 指外 = 子0[数];
                若 (指外 >= 0 && 节型别[指外] == 节点_变量 && 变量指深查((字*)(节名表 + 指外)) == 1 && 变量元素((字*)(节名表 + 指外)) > 8 && 变量指内查((字*)(节名表 + 指外)) > 0 && 变量元素((字*)(节名表 + 指外)) > 变量指内查((字*)(节名表 + 指外))) { /* A71 第2项: 指针-到-数组 `*pm` 在 免解引用 (取址) 模式 — pm 指向 数组 ⟹ 长卯 = 域行数[0] (第一维 行宽) 供 (*pm)[i] 步长 (pm 指向 int[2][3] ⟹ (*pm)[1] 步长 12) */
                    整 行宽 = 0; 遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--) 若 (!比较字符串(变量表[变序].名, (字*)(节名表 + 指外)) && 变量码生成可见(变序)) { 行宽 = 变量表[变序].域行数[0]; 断; }
                    长卯 = 行宽 > 0 ? 行宽 : 变量指内查((字*)(节名表 + 指外));
                }
                码生成免解引用 = 0; 码生成(子0[数]); 码生成免解引用 = 1;
                断;
            }
            码生成(子0[数]); /* 指针 → 首子 */
            整 指节 = 子0[数];
            若 (指节 >= 0 && (节型别[指节] == 节点_增减 || 节型别[指节] == 节点_前置增减)) 指节 = 子0[指节]; /* *p++ / *++p: 解析 经 递增/递减 到 该 指针 操作数 (修复 2026-08-16; 修复 2026-08-16 根因I: 指节>=0 守卫 — 解析 失败时 解引用 缺操作数 子0=-1, 原直接读 节型表[-1] 越界崩 shell.c) */
            整 元素 = 0; 字 *长十 = NULL; /* 修复 2026-08-30 生成器: 嵌套 解引用 符号 根 (***p 符号扩展/零扩展) */
            若 (指节 >= 0) {
            若 (节型别[指节] == 节点_变量) {
                元素 = 变量元素((字*)(节名表 + 指节)); 长卯 = 堆次((字*)(节名表 + 指节));
                若 (变量指深查((字*)(节名表 + 指节)) == 1 && 变量元素((字*)(节名表 + 指节)) > 8 && 变量指内查((字*)(节名表 + 指节)) > 0 && 变量元素((字*)(节名表 + 指节)) > 变量指内查((字*)(节名表 + 指节))) { /* A71 第2项 (2026-09-15): 指针-到-数组 `*pm` — pm 指向 数组 (数组元素尺寸>8 且 >指内) ⟹ *pm 是 数组, C 衰减 取址 不 加载; 长卯 = 域行数[0] (第一维 行宽) 供 (*pm)[i] 步长 (pm 指向 int[2][3] ⟹ (*pm)[1] 步长 12) */
                    整 行宽 = 0; 遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--) 若 (!比较字符串(变量表[变序].名, (字*)(节名表 + 指节)) && 变量码生成可见(变序)) { 行宽 = 变量表[变序].域行数[0]; 断; }
                    长卯 = 行宽 > 0 ? 行宽 : 变量指内查((字*)(节名表 + 指节));
