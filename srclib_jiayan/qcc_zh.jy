                循环 (判字母数字(串值[指]) || 串值[指] == '_' || ((无 字)串值[指] >= 0x80)) { 若 (逆肆 < 63) 存申[逆肆++] = 串值[指]; 指++; }
                存申[逆肆] = 0;
                若 (逆肆 > 0) 半从(存申);
