                    整 域偏移一 = 类型偏移(类型表[构序].名, 串升);
                    整 域尺寸 = 域偏移一 >= 0 ? 字段尺寸直(构序, 串升) : 0; /* 1/4/8 存储 宽度 (修复 2026-08-03: 函数指 字段 曾 4-字节 已截断) */
                    若 (域偏移一 >= 0) {
                        若 (计排) {
                            整 满二 = 字段类型序直(构序, 串升);
                            整 域四 = 成员写宽(构序, 串升, 满二); /* 修复 2026-08-22 t44: 排除指针字段 — rec->下一 是指针(xrecord_t*) 非结构体, 原 域四=24 → 深利(24) 把 rhash[度附] 当结构体复制 3×8B → 覆盖 rec->指针 (xdl_classify_record rec->下一=rhash[度附] 崩) */
                            整 当肆一 = 0; /* 修复 2026-08-22 #34b: arrow 成员结构赋值 p->dm = t (>8B 结构体 字段整块拷贝; 原标量路径 域尺寸=16 落 否则 只存首4字节) */
                            若 (域四 > 0 && 子1[数] >= 0) {
                                若 (节型表[子1[数]] == 节点_二元 && 节值表[子1[数]] == 逗号) { 整 逗序M = 表达式构序(子1[数]); 若 (逗序M >= 0 && 类型表[逗序M].尺寸 == 域四) 当肆一 = 1; } /* R535-e5: **逗号表达式 RHS（嵌套成员写入）** —— 同 N 段；原 落 `否 { 内存地址(逗号) }` ⟹ 返 -1 ⟹ 当肆一=0 ⟹ 两层链 (`o2.内.内 = (z=5, s)`) 12B 只存 4 字节 */
                                若 (节型表[子1[数]] == 1) {
                                    若 (变量型序((字*)(节名表 + 子1[数])) == 满二 && 变量指深((字*)(节名表 + 子1[数])) == 0) 当肆一 = 1; /* 修复 2026-08-22 #34b: 排除指针变量(指深>=1), 允许 结构体 值参数(槽 指元素尺寸=4 但非指针) */
                                } 否 {
                                    整 前从 = 0, 主得 = -1;
                                    若 (内存地址(子1[数], &前从, &主得) == 0 && 前从 == 域四) 当肆一 = 1;
                                }
                            }
                            若 (当肆一) {
                                若 (偏移 >= 0) { 若 (变量是否静态(变名)) { 中发(满丁, 偏移, 1, 0); 中刷(); } 否 若 (变量指元素(变名) > 0 || 变量指深(变名) > 0) { 中发(中取帧64, 0, 偏移 - 当前帧大小, 0); 中刷(); } 否 { 中发(中取帧, 0, 偏移 - 当前帧大小, 0); 中刷(); } } /* 第三阶段-中间表示 例十: 指针->字段 大结构 目标 */ /* 启元 Q8 (2026-09-23): 见 L25035 的长注释 —— 「是指针」判据 补 变量指深>0 */
                                否 若 (链接模式 && 变量是否静态(变名)) { 中发(满丁, 偏移, 1, 0); 中刷(); } /* 第三阶段-中间表示 例十 */
                                否 若 (偏移 < 0) { 取参值(变名); } /* 参数 指针 在 寄存器/栈 (修复 2026-08-22 #34b: 参数指针 arrow 赋值原 堆九=0 → 拷贝垃圾) */
                                否 { 移即(0, 0); }
                                若(域偏移一!=0){ 中发(尾浅, 域偏移一, 0, 0); 中刷(); } /* 启元 Q8 真修: 原 `元又`=32 位加 (前缀字节(0,...) 无 REX.W; x86-64 上 32 位 ALU 结果 零扩展 ⟹ 清高 32 位) ⟹ 改 `尾浅`(后弊一, 64 位加). 照抄 甲言自己 同族 正确写法 L25013 / L25038 */ /* 第三阶段-中间表示 例十: 大结构 目标 偏移 */
                                压栈寄存器(0); /* &目标 */
                                若 (节型表[子1[数]] == 1) {
                                    字 *副列 = (字*)(节名表 + 子1[数]);
                                    整 名十 = 查变量(副列);
                                    若 (名十 >= 0) { 若 (素系(副列)) { 中发(中取帧64, 0, 名十 - 当前帧大小, 0); 中刷(); } 否 若 (变量是否静态(副列)) { 中发(缺捌, 名十, 1, 0); 中刷(); } 否 { 中发(副失, 0, 变量基(副列, 名十) - 当前帧大小, 0); 中刷(); } } /* 第三阶段-中间表示 例十: 大结构 右操作数 取址 */
