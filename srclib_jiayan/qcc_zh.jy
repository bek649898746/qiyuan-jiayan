            若 (段[寻三] == '(') { 整 查参 = 寻三 + 1; 循环 (段[查参] == ' ' || 段[查参] == '\t') 查参++; 若 (段[查参] != '*') { /* 泛型 typedef: 激活 缺亥一 + 定义行删除不输出 (函数指 typedef 名(* 排除); #50 同名多版本全激活无 断) */
                遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (!比较字符串(函数宏表[键].名, 域一)) 缺亥一[键] = 1;
                循环 (段[计] && 段[计] != '\n') 计++;
                续;
            } }
