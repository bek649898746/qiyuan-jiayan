        }
        若 (!入串 && 段[计] == '\xe6' && 段[计+1] == '\xb3' && 段[计+2] == '\x9b' && 段[计+3] == '\xe5' && 段[计+4] == '\x9e' && 段[计+5] == '\x8b') { /* 泛型定义行 (接入 2026-08-28 #96): 激活 缺亥一 (同 #定义 位置语义, 之后的调用才展开), 定义行删除不输出 (词法器 无需跳过, 修复 2026-08-28: 复制残留导致 词法器 跳过交互 段错误) */
            整 寻三 = 计 + 6; 循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
            字 域一[64]; 整 主未 = 0;
            循环 (判字母数字((无 字)段[寻三]) || 段[寻三] == '_' || ((无 字)段[寻三] >= 0x80)) { 若 (主未 < 63) 域一[主未++] = 段[寻三]; 寻三++; }
            域一[主未] = 0;
            循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
            若 (段[寻三] == ':') { /* 阶段C-1 #45 泛型约束 (2026-09-01): 泛型 名: 接口(参数) — 激活时跳过约束名 */
                寻三++;
                循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
                循环 (判字母数字((无 字)段[寻三]) || 段[寻三] == '_' || (无 字)段[寻三] >= 0x80) 寻三++;
                循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
            }
            若 (段[寻三] == '(') 遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (!比较字符串(函数宏表[键].名, 域一)) 缺亥一[键] = 1; /* #50 同名多版本全激活 (2026-09-01) */
            循环 (段[计] && 段[计] != '\n') 计++;
            续;
        }
        若 (段[计] == '#') { 整 寻二 = 计 + 1; 循环 (段[寻二] == ' ' || 段[寻二] == '\t') 寻二++; 若 (段[寻二] == 'd' || 段[寻二] == 'u' || 段[寻二] == 'i' || 段[寻二] == 'e' || 段[寻二] == 'l' || 段[寻二] == 'p' || 段[寻二] == 'n' || ((无 字)段[寻二] >= 0x80)) { /* 修复 2026-08-13: 预处理行不展开 (#定义 行内宏名会被当调用展开); 修复 2026-08-13 第三阶段: # 后空白 (缩进 #  定义 __REPB_PREFIX(名) 原被展开成 #定义 名 名) */
            若 (((!比前n(段 + 寻二, "define", 6) && (段[寻二+6] == 0 || 段[寻二+6] == ' ' || 段[寻二+6] == '\t')) || (!比前n(段 + 寻二, "定义词", 9) && (段[寻二+9] == 0 || 段[寻二+9] == ' ' || 段[寻二+9] == '\t')))) { /* 修复 2026-08-26 数据库: 位置语义 — 记录函数宏定义点, 之后的调用才展开 */
                整 寻三 = 寻二 + (段[寻二] == 'd' ? 6 : 9); 循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
                字 域一[64]; 整 主未 = 0;
                循环 (判字母数字((无 字)段[寻三]) || 段[寻三] == '_' || ((无 字)段[寻三] >= 0x80)) { 若 (主未 < 63) 域一[主未++] = 段[寻三]; 寻三++; }
                域一[主未] = 0;
                若 (段[寻三] == '(') 遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (!比较字符串(函数宏表[键].名, 域一)) { 缺亥一[键] = 1; 断; }
            } 否 若 (!比前n(段 + 寻二, "undef", 5) && (段[寻二+5] == 0 || 段[寻二+5] == ' ' || 段[寻二+5] == '\t')) {
                整 寻三 = 寻二 + 5; 循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
                字 域一[64]; 整 主未 = 0;
                循环 (判字母数字((无 字)段[寻三]) || 段[寻三] == '_' || ((无 字)段[寻三] >= 0x80)) { 若 (主未 < 63) 域一[主未++] = 段[寻三]; 寻三++; }
                域一[主未] = 0;
                遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (!比较字符串(函数宏表[键].名, 域一)) { 缺亥一[键] = 0; 断; }
            }
            循环 (段[计] && 段[计] != '\n') { 若 (*丙 + 1 > *容量) { *容量 *= 2; /* 修复 2026-08-13 第三阶段: 倍增替代 +4096 — 提升 分配器 重分配 泄漏旧缓冲, 小步进在 序列器.c 大宏展开时平方级爆堆 */; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] 内存不足 重分配\n"); 退出(1); } 出 = *出指; } 出[(*丙)++] = 段[计++]; }
            续;
        } }
        若 (段[计] == '"' && !入串) 入串 = 1;
        否 若 (段[计] == '"' && 入串 && !帧再(段, 计)) 入串 = 0; /* 修复 2026-08-14: \\" 两反斜杠后 " 应结束 */
        若 (段[计] == '\'' && !入串) { /* 字符字面量 'x'/'\n'/'"' — 跳过 (修复 2026-08-14: 属性.c *码位 == '"' 的字符字面量被当字符串开始 → 入串 奇偶翻转 → GIT_PATH_FUNC 不展开 → 参数 串词 卡死) */
            若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] 内存不足 重分配\n"); 退出(1); } 出 = *出指; }
            出[(*丙)++] = 段[计++]; /* opening ' */
            循环 (段[计] && (段[计] != '\'' || 帧再(段, 计))) {
                若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] 内存不足 重分配\n"); 退出(1); } 出 = *出指; }
                出[(*丙)++] = 段[计++];
            }
            若 (段[计]) { 若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] 内存不足 重分配\n"); 退出(1); } 出 = *出指; } 出[(*丙)++] = 段[计++]; }
            续;
        }
