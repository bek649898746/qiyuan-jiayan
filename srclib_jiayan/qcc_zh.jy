静 字 域五[256][64]; 静 整 双繁[256]; 静 整 行次[256]; 静 整 素寅 = 0; 静 整 计贰 = 0; 静 整 度平[256]; /* 2026-08-28 type-root-3 NLL: last-read token pos of borrowed var (last-use auto-yields to mut borrow/write) */ /* 借用检查表 (接入 2026-08-28 机制层 #2/3/4/10): 借用 x; 标记只读(0), 可变借用 x; 独占(1); #4 生命周期=词法块作用域 — borrowed_scope 记录借用声明时块深度, 块退出自动放还 (借用不跨块) */
静 整 当繁(常 字 *值) { 遍 (整 计 = 0; 计 < 素寅; 计++) 若 (!比较字符串(域五[计], 值)) 返 双繁[计]; 返 -1; } /* 0=只读借用 1=可变借用(独占) -1=未借用 (vt_lifetime 状态机 2/3 对齐) */
静 空 下低(常 字 *值) { 若 (!值) 返; 遍 (整 计 = 0; 计 < 素寅; 计++) 若 (!比较字符串(域五[计], 值)) { 域五[计][0] = 0; 双繁[计] = 0; 返; } } /* 放还: 解除借用 (mode 一并清, 借用幂等注册 → 一次全清) — 放还语句/写自动放还共用 */
静 字 *源陆(整 数) { 整 返回值 = 数; 整 号八 = 0; 循环 (返回值 >= 0 && 号八 < 8 && (节型表[返回值] == 14 || (节型表[返回值] == 15 && 节值表[返回值] == 0))) { 返回值 = 子0[返回值]; 号八++; } 若 (返回值 >= 0 && 节型表[返回值] == 1) 返 (字*)(节名表 + 返回值); 返 NULL; } /* 借用自动化 (2026-08-28 完善): 写目标基础变量 — 下钻数组下标/点成员, 遇箭头/解引用停止 (写的是指向对象, 不是指针变量本身) */
静 字 初二[64][64]; 静 字 前十[64][64]; 静 整 剩子 = 0; /* fix 2026-08-30 探雷雷4: 借用追指针别名 — p=&x 登记别名 (指针→目标), *p 写时查目标借用状态 (借用 x; int *p=&x; *p=99 原绕过; 别名仅借用登记后生效, git 612 C 代码无 借用 不受影响); 函数级不清理 (残留无害, 检查依赖借用状态) */
静 空 总布(常 字 *指, 常 字 *暂) { /* fix 2026-08-30 探雷雷4: 登记/更新 指针→目标 别名 */
    若 (!指 || !暂 || !指[0] || !暂[0]) 返;
    遍 (整 计 = 0; 计 < 剩子; 计++) 若 (!比较字符串(初二[计], 指)) { 复制字符串(前十[计], 暂); 返; } /* 覆盖旧别名 */
    若 (剩子 < 64) { 复制字符串(初二[剩子], 指); 复制字符串(前十[剩子], 暂); 剩子++; }
}
静 空 串弊(整 数) { /* 2026-08-28 P1 #33/#34 借用分裂: 先查字段/元素路径借用 (s.x / a[i]) — 路径级独占拦截+只读自动放还, 其余字段/元素不受影响; 无路径借用才回落整变量检查 */
    若 (数 >= 0 && 节型表[数] == 12) { /* fix 2026-08-30 探雷雷4: *p = v 指针解引用写 — 借用追指针别名 (借用 x; int *p=&x; *p=99 原绕过; 只读借用→自动放还, 可变借用→拦截, 与直接写一致) */
        整 宽巳 = 子0[数];
        若 (宽巳 >= 0 && 节型表[宽巳] == 1) {
            字 *邻丙 = (字*)(节名表 + 宽巳);
            遍 (整 串申 = 0; 串申 < 剩子; 串申++) 若 (!比较字符串(初二[串申], 邻丙)) {
                整 值伴 = 当繁(前十[串申]);
                若 (值伴 == 1) { 格式化到串(错缓冲, "借用检查: 通过指针 '%s' 写被可变借用变量 '%s' (独占冻结, 借用追别名 v3.0 #3)", 邻丙, 前十[串申]); 发错误("A3001", 错缓冲); 返; }
                否 若 (值伴 == 0) { 下低(前十[串申]); 返; } /* 借用自动化: 指针写=解除目标只读借用 */
            }
        }
    }
    若 (数 >= 0 && 节型表[数] == 15 && 节值表[数] == 0) { /* 点成员写目标: 构造路径 "s.x" */
        字 *正壹 = (字*)(节名表 + 数); 整 行壬 = 子0[数]; 整 元组 = 0;
        循环 (行壬 >= 0 && 元组 < 8 && (节型表[行壬] == 14 || (节型表[行壬] == 15 && 节值表[行壬] == 0))) { 行壬 = 子0[行壬]; 元组++; }
        若 (行壬 >= 0 && 节型表[行壬] == 1) {
            字 元三[160]; 格式化到串(元三, "%s.%s", (字*)(节名表 + 行壬), 正壹);
            整 半陆一 = 当繁(元三);
            若 (半陆一 == 1) { 格式化到串(错缓冲, "借用检查: 字段 '%s' 被可变借用 (独占), 不能写 (v3.0 #33)", 元三); 发错误("A3001", 错缓冲); 返; }
            若 (半陆一 == 0) { 下低(元三); 返; } /* 借用自动化: 写字段 = 解除该字段只读借用 */
        }
    } 否 若 (数 >= 0 && 节型表[数] == 14 && 子1[数] >= 0 && 节型表[子1[数]] == 0) { /* 静态下标写目标: 路径 "a[i]" */
        整 素卯 = 子0[数]; 整 堆子 = 0;
        循环 (素卯 >= 0 && 堆子 < 8 && (节型表[素卯] == 14 || (节型表[素卯] == 15 && 节值表[素卯] == 0))) { 素卯 = 子0[素卯]; 堆子++; }
        若 (素卯 >= 0 && 节型表[素卯] == 1) {
            字 元三[160]; 格式化到串(元三, "%s[%d]", (字*)(节名表 + 素卯), 节值表[子1[数]]);
            整 半陆一 = 当繁(元三);
            若 (半陆一 == 1) { 格式化到串(错缓冲, "借用检查: 元素 '%s' 被可变借用 (独占), 不能写 (v3.0 #34)", 元三); 发错误("A3001", 错缓冲); 返; }
            若 (半陆一 == 0) { 下低(元三); 返; }
        }
    }
    字 *变节 = 源陆(数); 若 (!变节) 返; 整 素浅 = 当繁(变节); 若 (素浅 == 1) { 格式化到串(错缓冲, "借用检查: 变量 '%s' 被可变借用 (独占), 不能写 (可变借用后原变量冻结, v3.0 #3)", 变节); 发错误("A3001", 错缓冲); } 否 若 (素浅 == 0) 下低(变节); } /* 借用自动化 (2026-08-28 完善): 写目标 → 只读借用(0)自动放还 (显式写=解除只读借用的明确意图, 免手动 放还); 可变借用(1)硬错误 (独占冻结是本意, 读检查 L5014 已拦, 此处兜底) */
静 空 长申(空) { 计贰--; 若 (计贰 < 0) 计贰 = 0; 遍 (整 计 = 0; 计 < 素寅; ) { 若 (行次[计] > 计贰) { 遍 (整 乙 = 计; 乙 < 素寅 - 1; 乙++) { 复制字符串(域五[乙], 域五[乙 + 1]); 双繁[乙] = 双繁[乙 + 1]; 行次[乙] = 行次[乙 + 1]; } 素寅--; } 否 计++; } } /* 接入 2026-08-28 机制层 #4: 块退出 → 自动放还本块内新借用的变量 (生命周期=词法作用域, 数组压缩 O(n), 手动放还仍兼容) */
静 字 域六[256][64]; 静 整 正次 = 0; 静 整 首己 = 0; 静 整 目系 = 0; 静 整 宽低 = 0; 静 字 毛玖[8][64]; 静 整 目凶一 = 0; 静 字 值八[8][64]; 静 整 下列[8]; 静 整 顺深 = 0; /* 接入 2026-08-28 机制层 #5 移动语义完整: moved 表(全局, L5014 读检查/L5296 写恢复需要); move_dst_parsing=移入目标解析(dst是写); asgn_lhs_parsing=赋值左值解析中; addr_of_parsing=取地址操作数解析中(&x 不读值, 探雷雷6); lv_moved=左值解析期遇到的 moved 变量缓冲 (事后判定: 赋值→重新初始化放行, 非赋值→右值读取报错) */ /* 2026-08-28 P1 #33/#34/#17 修复: lv_path=成员/元素路径缓冲 (asgn 对所有表达式设 lhs=1, 原成员读检查 !asgn_lhs_parsing 永不触发 = 死钩子; 改为缓冲+asgn 事后判定: 写目标→写策略处理, 读→A3001/A3101) */
静 字 宽辰[64][64]; 静 字 终双[64][64]; 静 整 帧附[64]; 静 整 逆汇 = 0; 静 字 串寅[64]; /* 接入 2026-08-28 机制层 #8 RAII 完整(析构): 守卫 x, 析构名; → 记录(变量,析构函数,块深度), 块退出自动调用 析构名(x) (作用域退出自动释放, 复用 borrow_depth 做作用域标记) */ /* 2026-08-28 P1 #15 Drop 标记: guard_ready=1 已初始化(析构执行) 0 未初始化(跳过析构 — 部分初始化/未初始化不析构) */
静 整 号寅(整 结) { /* 接入 2026-08-28 机制层 #8 RAII 真修复: return 包块 { 活跃守卫析构(LIFO); 返回 } — 析构在 return 前可达 (原 blk() 块尾析构被 return 跳过 → 资源泄漏, feat_raii 只测落出路径没暴露); 每个 return 各有自己的析构副本, 运行时只走被选路径 → 无双发 */ /* 2026-08-28 P1 #24 所有权转移返回: return 局部 → 局部所有权转移给调用者, 返回变量的析构跳过 (返回路径不执行被返回变量的守卫 — 否则析构后调用者拿到的是已释放资源) */
    字 宽叁一[64] = ""; 字 前丙[64] = "";
    若 (结 >= 0 && 子0[结] >= 0 && 节型表[子0[结]] == 1) 复制字符串(宽叁一, (字*)(节名表 + 子0[结])); /* return x 单值: n0=返回表达式 (简单变量时记名) */
    若 (结 >= 0 && 节值表[结] == 9001 && 子1[结] >= 0 && 节型表[子1[结]] == 1) 复制字符串(前丙, (字*)(节名表 + 子1[结])); /* 返回(a,b) 多值: n1=第二值 */
    整 域序一 = 0;
    遍 (整 庚序 = 0; 庚序 < 逆汇; 庚序++) 若 (宽辰[庚序][0] != 0) { 域序一 = 1; 断; }
    若 (!域序一) 返 结;
    整 单回 = 建节(5);
    遍 (整 庚序 = 逆汇 - 1; 庚序 >= 0; 庚序--) { 若 (宽辰[庚序][0] != 0 && 串寅[庚序]) { /* 2026-08-28 P1 #15 Drop 标记: return 路径跳过未初始化守卫 */
        若 (宽叁一[0] && !比较字符串(宽辰[庚序], 宽叁一)) 续; /* #24: 所有权转移 — 被返回变量的守卫跳过 (资源归调用者) */
        若 (前丙[0] && !比较字符串(宽辰[庚序], 前丙)) 续; /* #24: 多值返回同样跳过 */
        整 呼 = 建节(4); { 整 参 = 建节(1); 复制内存((字*)(节名表 + 参), 宽辰[庚序], 64); 接子(呼, 参); } { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 终双[庚序], 64); 接子(呼, 函); }
        接子(单回, 呼);
    } }
    接子(单回, 结);
    返 单回;
}
静 空 副轮(常 字 *值) { /* 2026-08-28 P1 #15 Drop 标记: 赋值初始化 → 守卫 ready (块退出才析构) */
    遍 (整 计 = 0; 计 < 逆汇; 计++) 若 (!比较字符串(宽辰[计], 值)) 串寅[计] = 1;
}
静 整 后子(常 字 *值) { 遍 (整 计 = 0; 计 < 正次; 计++) 若 (!比较字符串(域六[计], 值)) 返 1; 返 0; } /* 2026-08-28 #5: 0/1 moved 状态 */
静 空 邻未(常 字 *值) { 遍 (整 计 = 0; 计 < 正次; 计++) 若 (!比较字符串(域六[计], 值)) { 域六[计][0] = 0; 返; } } /* 2026-08-28 #5: 重新赋值 = 重新初始化, 恢复可用 (Rust 式 move 后重绑定) */

静 整 副酉一(常 字 *串值, 整 尾柒) { /* 过程宏 #172: 生成代码文本 token 化 → 落位 [at, at+n); 返回生成 token 数 (失败 -1) */
    整 丙 = 尾柒; 常 字 *指 = 串值;
    循环 (*指) {
        循环 (*指 == ' ' || *指 == '\t' || *指 == '\n' || *指 == '\r') 指++;
        若 (!*指) 断;
        若 (丙 + 1 >= 词容量) 返 -1;
        内存设置(词名表[丙], 0, 64);
        词行表[丙] = 0; 词无符号表[丙] = 0; 词长表[丙] = 0; 段属[丙] = 0;
        若 ((*指 >= 'A' && *指 <= 'Z') || (*指 >= 'a' && *指 <= 'z') || *指 == '_') { /* 标识符 */
            整 乙 = 0;
            循环 (乙 < 63 && ((*指 >= 'A' && *指 <= 'Z') || (*指 >= 'a' && *指 <= 'z') || (*指 >= '0' && *指 <= '9') || *指 == '_')) 词名表[丙][乙++] = *指++;
            词型表[丙] = 词变量; 词值表[丙] = 0; 丙++;
        } 否 若 (*指 >= '0' && *指 <= '9') { /* 数字 */
            整 值 = 0; 整 域厚 = 0;
            若 (指[0] == '0' && (指[1] == 'x' || 指[1] == 'X')) { 域厚 = 1; 指 += 2; }
            循环 ((*指 >= '0' && *指 <= '9') || (域厚 && ((*指 >= 'a' && *指 <= 'f') || (*指 >= 'A' && *指 <= 'F')))) {
                整 元 = (*指 >= 'a') ? (*指 - 'a' + 10) : (*指 >= 'A') ? (*指 - 'A' + 10) : (*指 - '0');
                值 = 值 * (域厚 ? 16 : 10) + 元; 指++;
            }
            词型表[丙] = 常数; 词值表[丙] = 值; 丙++;
        } 否 若 (*指 == '"') { /* 字符串字面量 */
            指++; 字 间聚[4096]; 整 乙 = 0;
            循环 (*指 && *指 != '"' && 乙 < 4095) { 若 (*指 == '\\' && 指[1]) { 指++; 若 (*指 == 'n') 间聚[乙++] = '\n'; 否 若 (*指 == 't') 间聚[乙++] = '\t'; 否 若 (*指 == '0') 间聚[乙++] = 0; 否 间聚[乙++] = *指; } 否 间聚[乙++] = *指; 指++; }
            若 (*指 == '"') 指++;
            间聚[乙] = 0;
            若 (串数 >= 65536) 返 -1;
            若 (!串表[串数]) 串表[串数] = 短六();
            复制字符串(串表[串数], 间聚);
            词型表[丙] = 串词; 词值表[丙] = 串数; 串数++; 丙++;
        } 否 { /* 运算符 */
            字 字符 = *指;
            字 字符二 = 指[1];
            整 暂;
            若 (字符 == '+' ) { 若 (字符二 == '+') { 暂 = 增增; 指++; } 否 若 (字符二 == '=') { 暂 = 加等; 指++; } 否 暂 = 加; }
            否 若 (字符 == '-') { 若 (字符二 == '>') { 暂 = 箭头; 指++; } 否 若 (字符二 == '-') { 暂 = 减减; 指++; } 否 若 (字符二 == '=') { 暂 = 减等; 指++; } 否 暂 = 减; }
            否 若 (字符 == '*') { 若 (字符二 == '=') { 暂 = 乘等; 指++; } 否 暂 = 乘; }
            否 若 (字符 == '/') { 若 (字符二 == '=') { 暂 = 除等; 指++; } 否 暂 = 除; }
            否 若 (字符 == '%') { 若 (字符二 == '=') { 暂 = 隔伍; 指++; } 否 暂 = 取余; }
            否 若 (字符 == '&') { 若 (字符二 == '&') { 暂 = 逻辑与; 指++; } 否 暂 = 点; }
            否 若 (字符 == '|') { 若 (字符二 == '|') { 暂 = 逻辑或; 指++; } 否 暂 = 或; }
            否 若 (字符 == '^') { 若 (字符二 == '=') { 暂 = 异或等; 指++; } 否 暂 = 异或; }
            否 若 (字符 == '!') { 若 (字符二 == '=') { 暂 = 顺八; 指++; } 否 暂 = 总零; }
            否 若 (字符 == '=') { 若 (字符二 == '=') { 暂 = 高平; 指++; } 否 暂 = 赋号; }
            否 若 (字符 == '<') { 若 (字符二 == '<') { 暂 = 左移; 指++; } 否 若 (字符二 == '=') { 暂 = 元九; 指++; } 否 暂 = 下双; }
            否 若 (字符 == '>') { 若 (字符二 == '>') { 暂 = 右移; 指++; } 否 若 (字符二 == '=') { 暂 = 首降; 指++; } 否 暂 = 终附; }
            否 若 (字符 == '(') 暂 = 左括;
            否 若 (字符 == ')') 暂 = 右括;
            否 若 (字符 == '[') 暂 = 左方;
            否 若 (字符 == ']') 暂 = 右方;
            否 若 (字符 == '{') 暂 = 左花;
            否 若 (字符 == '}') 暂 = 右花;
            否 若 (字符 == ';') 暂 = 分号;
            否 若 (字符 == ',') 暂 = 逗号;
            否 若 (字符 == '.') 暂 = 句点;
            否 若 (字符 == ':') 暂 = 冒号;
            否 若 (字符 == '?') 暂 = 问号;
            否 若 (字符 == '~') 暂 = 按位非;
            否 返 -1;
            词型表[丙] = 暂; 词值表[丙] = 0; 词名表[丙][0] = 字符; 丙++; 指++;
        }
    }
    返 丙 - 尾柒;
}

静 整 原级(空) {
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "契约哈希")) { /* 接入 2026-08-28 可吞清单 P0-8: 契约哈希(P) → 结构契约描述符 SHA256 字符串常量 (接口指纹, strcmp 校验外部数据 Schema) */
            词位++; /* 契约哈希 */
            若 (词型表[词位] == 左括) 词位++; /* ( */
            字 实从[64]; 复制字符串(实从, 词名表[词位]); 词位++;
            若 (词型表[词位] == 右括) 词位++; /* ) */
            整 总六 = 总六一(实从);
            若 (总六 < 0 && 查类型(实从) >= 0) 深散(实从); /* 使用时自动登记 (顶层 契约 P; 若被全局变量路径拦截, 此处兜底) */
            总六 = 总六一(实从);
