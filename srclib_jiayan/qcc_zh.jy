#define 节容量 1048576 /* 524288→1048576 (修复 2026-08-26 数据库/脚本语言: #若 反斜杠续行 + 表达式注释剥离后条件编译更正确 → sqlite3.c 多行 #若 含入更多代码 → 抽象语法树 顶满 524288) */
静 整 副子[节容量]; /* 修复 2026-08-19: 块节点 (节型表==5) 的 变量 起点 = 块() 入口 变量数 — 码生成器 例-5 设置 值序 用 (嵌套块作用域判定) */
#define 短繁 1048576 /* 262144→1048576 (修复 2026-09-05 P0 攻坚: zh 源 2.5MB 自举 末=159836/计利一=262127 贴顶, 余量仅 17 → 任何新特性即 [补丁-溢出]; ×4 对齐编译器体积增长; 前序 131072→262144 (修复 2026-08-31 中文链)) */
静 整 标号位[短繁];
静 整 标号设[短繁];
静 整 末伴[4096][64]; /* 接入 2026-08-27 延迟: 每函数 延迟 语句节点 (按函数序号 单粗, LIFO — 长复 处逆序执行) */ 静 整 块延迟栈[256]; 静 整 块延迟深 = 0; /* 阶段C-1 #53 块级延迟 (2026-09-01): 每块 延迟 计数起点 — 嵌套块自然退出 LIFO 刷新, 返 由 号寅 刷新 */
静 整 名捌[4096];
静 整 标繁 = -1; /* 解析 时当前函数序号 (延迟 收集目标) */
/* 接入 2026-08-27 运算符重载: 重载 + 点 = 点_add; → 直戊一 表注册, 加() 分派 (左操作数是 结构体 变量且类型匹配 → 函数调用) */
静 构 { 字 符; 字 型名[64]; 字 函名[64]; } 重载表[32]; 静 整 初甲; /* A3-g (2026-09-12): 满属/总复/栈聚 3 平行数组 → 结构体数组 (运算符重载 登记) */
静 构 { 整 旁退; 整 单低; 整 全附; } 全败[1048576]; 整 计利一; /* 修复 2026-09-05 P0: 262144→1048576 — zh 源自举 计利一=262127 贴顶余 17 (见 短繁 注); 前序 16384→65536; 2026-08-16 自举回归: 65536→131072; 2026-08-28: 131072→262144 — 新特性批量接入 计利一 贴上限 ([补丁-溢出] 假绿) */
静 构 { 整 旁退; 整 串序标; } 宽伍[32768]; 整 段简; /* 修复 2026-08-16 自举回归: 2048→8192 — 同步镜像后字符串引用超 2048; 修复 2026-08-26 数据库: 8192→32768 — 数据库-基准.c 1.6 万字符串字面量引用超 8192 */
静 构 { 整 旁退; 整 浮序标; } 号集一[2048]; 整 暂拆; /* 双精度-字面量 指令指针-相对 三十二位位移 全败 */
静 构 { 整 旁退; 整 标号一; } 新五[2048]; 整 主又; /* 函数-地址 三十二位立即数 全败 */
静 整 后凶[16384]; 静 整 全局初始化数; /* 全局 变量 初始化 节点 (已发射 于 主 入口); 修复 2026-08-06: 128→4096 + 溢出报错（原 >128 静默丢初始值） */
静 整 节浮标[节容量]; /* 每-节点 标志: 表达式 产出 a 双精度 (浮点) */
判别 结果 于 { 值, 错(长 长 码) }; /* G2a (2026-09-06): 错误联合 判别化 (实重[] 节点标记 → 判别 结果) — 值=已检查/成功, 错(码)=未检查错误 携带常量错误码; 深挖载荷化 (2026-09-07) */
静 构 结果 实重[节容量]; /* 2026-08-28 类型-根-2: 每-节点 错误-联合 调用 结果 (必须 是 checked); G2a 判别化 */
静 长 长 错误码池[4096]; 静 整 错误码池长 = 0; /* 攻坚 2026-09-07: 错误函数 错 N 常量错误码 池 — 每函数 码集 (起点/数 记 函数表; 原 单 返错码 只记最后 错 → 首错误码 漏传播) */
静 整 错误函数 = 0; 静 整 外优 = 0; 静 整 满从 = -1;
静 整 错联待 = 0; 静 整 错联标[65536]; 静 整 联宽待R439 = 0; 静 字 联宽名R439[96]; 静 整 节联宽槽[节容量]; /* R443 (D-11b): 构值载荷 错误联合 声明节点 → tag 槽 栈偏移+1 (0=无); 解析期记, 码生成 按节点 取 (替代 码生成期 查名 —— 实测查名未命中 ⟹ store 静默丢失) */ 静 整 联宽源R440 = 0; /* R440 (D-11b): tag 通道 0 = rdx (8B 值类/双 载荷) · 1 = rax (构值 sret 载荷) */ /* R439 (D-11 首刀): 宽载荷 错误联合 声明初始化 的 tag 落位 暂存 —— 解析期 记, 待 **值声明节 挂入 块 之后** 再 挂 tag 声明节 (时序: tag 必须 在 调用 之后 捕获 rdx) */ /* A1 全 ABI (2026-09-11): 错误 T 变量 = 错误联合值 — 错联待=本声明待定 (外壹 置, 变量偏移 消费); 错联标[变量表条目]=1 → 8B 打包槽 {tag 高32|值 低32}, 写 8B / 默认 读 32 / 返回传播 长读. ⚠ 必须 声明 在 外壹/变量偏移 (L3xxx) 之前, 否则 隐式新变量 (全 0) */ 静 整 右陆 = 0; 静 整 当申 = 0; 静 整 语句表达式丢弃 = 0; /* F2 (2026-09-07): 语句表达式结果丢弃标志 — 除零检查 DCE 感知 (死除法不插检查) */
静 整 本声明错联(常 字 *名); /* R438 (2026-09-30 虾米 · 第 438 站 · D-10 根治): 前向 —— 定义 与 `预扫错误名` 同处 (L787x), 而 首个 建条目点 在 L3221 (`余乙`) ⟹ 无 前向 会被 当 隐式局部 (恒 0, 同 R391/R562/R433/R437 教训) */
静 空 新条目名(常 字 *数); /* R438: 前向 —— 变量表 新条目 收口 (名复制 + 错联标记 落位) */
静 整 错误位[256]; 静 整 错误位数 = 0; /* 错误 预扫描多函数位表 (2026-09-07 修: 外优/满从 只记最后一个 错误, 首函数 返错漏) */
静 字 窄化路径[16][64]; 静 整 窄化路数 = 0; /* H1d-③ (2026-09-11): 字段/路径级 窄化栈 — 若(!判空 n.左) 进块 压入 "n.左", 出块 弹出; 解引用 检查 查 此栈 */
静 字 成员路径尾[128]; 静 整 成员可空尾 = 0; /* H1d-③: 最近一次 成员访问 (一级: 基 是 变量) 的 路径 + 是否 可空指针字段 — 供 箭头/下标 解引用 检查 */
静 整 窄化栈[16]; 静 整 窄化数 = 0; /* R392 (C1-3 第二刀 · flow-sensitive 窄化栈): 原 `窄化表[16]{名[64],旧}` 结构体数组 (68B/槽) ⟹ 收编为 **只存变量序** (4B/槽); 旧可空态 移入 `变量表[].窄化旧` ⟹ 弹出时 **无需 再按名 查活变量** (省 O(变量数) 线性扫, 且 消除 同名遮蔽 致查错 的隐患) */ /* A3-d1 (2026-09-12): 窄化名/窄化旧 2 平行数组 → 窄化表{名/旧} 结构体数组 (flow-sensitive 窄化栈) */ /* 2026-08-28 类型-根-2: 尝试-分支 赋值级() exempt 自 赋值 A9001; G1b (2026-09-06): 旁午[]/函错误记 退役 (函数表.返错 权威) */
静 整 节长标[节容量]; /* 每-节点 标志: 表达式 是 a 64-位 长整 长整 (修复 2026-08-05) */
静 整 节长高[节容量]; /* 每-节点 高 32 符弊 的 a 长整-长整 字面量 (修复 2026-08-05) */
静 字 首甲二[节容量]; /* 修复 2026-08-30 生成器 s168: 有符号 64 转型 ((int64_t)x / (长整)x) 标记 — 值转换保留源 节无符号 (零扩展 b_cast), 类型 有符号 (除法/比较 有符号); 不用 节长高 (污染 邻辰 字面量语义 → 未初始化读取崩溃) */
静 字 号汇一[节容量]; /* 修复 2026-08-31 生成器 s11: 无符号 64 转型 ((uint64_t)x / (无符号 长整 长整)x) 标记 - 目标 无符号 (比较/除法无符号) 但不设源 节无符号 */
静 字 cast32[节容量]; /* 修复 2026-08-31 生成器 s61: 32 位类型 转型 ((uint32_t)/(int32_t)/(uint8_t) 等) 标记 - 阻断 表达式是否长 递归到子表达式 64 位字面量 (-6L) - & 传播 节长标 -> 三十二位无符号<六十四位整数 比较误判无符号 */
静 字 暂合[节容量]; /* 修复 2026-08-30 探雷雷2: 显式 转型 标记 — (T*)x 是 无-算子 转型 直接返回操作数 (不建节点), 标记操作数节点供 序平 豁免 (整数 *p=(常量 字符*)0xdeadbeef 合法, 整数 *p=12345 非法) */
静 整 指元素[节容量]; /* 每-节点 标志: (T*) 指针-转型 元素 字节 尺寸 (1/2/4/8) - 修复 2026-08-08 宽度 缺陷: 转型 无-算子 drops 类型 信息, *((T*)x) 宽度 fell 到 1 字节; 保持 目标 元素 尺寸 遍 例-12/10 */
静 整 节转序[节容量]; /* A71-续 (2026-09-15): (T*) 转型 的 目标 结构体序+1 (0=未记录/非结构体) — 节指元 只 存 类型码 (低位 7=构), 构序 丢失 ⟹ 转型 结果 的 成员访问 无法 静态 查字段 (A13 合一 时 被迫 保守 跳过 = 漏检 ((结构体 S*)&s)->typo / (&s)->typo / (*p).typo, 实测 6/8 静默). 与 节指元 同 生命周期: 建节 清零, 转型 解析期 打标 (后缀链() 之前, 见 原级() 转型 分支) */
静 整 节指元[节容量]; /* A22 (2026-09-11): (T*) 指针 转型 的 精确 类型码+1 (0=未记录) — 低 4 位 基类 (0整/1字/2短/3长/4双/5无符号/7构/8空其他/9函数指), 高 位 = 16*指针层级; 供 _Generic 控制表达式 精确 匹配 (原 只 有 元素 尺寸 → 任意 指针 互 匹配, 空 指针/结构体 指针/双精度 指针 全 判 不出) */
静 整 节无符号[节容量]; /* 每-节点 标志: 表达式 是 无符号 (u 后缀 字面量 / 无符号 变量) — >> 必须 是 逻辑 右移一 (修复 2026-08-05) */
静 整 节行表[节容量]; /* #289 (第 453 站): 每-节点 源行 (建节 时 取 词行表[词位], 仅 -g 档 记) — 语句级 行表 的 行源 */
静 整 调方返[节容量]; /* H1t (2026-09-11): 调用节点 的 「接口 方法 按值 返回 构体」 型序+1 (0=无标). 接口 分派 调用 的被调 是 隐藏 方法槽 (名 查不到) → 调用构返 原返 -1 → 成员访问 / 值实参 / 数组元素 赋值 静默 走 标量 通道 (读到 垃圾); 解析期 在 分派 建立 调用节点 时 打标 */
静 整 窄无符号[节容量]; /* 修复 2026-09-03 p218: 例27 窄转型 目标无符号性 快照 (创建时定, 外层 (int) 等转型清 节无符号 → 原例27 读可变 节无符号 被污染 → (uint16_t)(int8 -3) 0xFFFD 被符号扩展成 -3; 例27 必须按内层目标判定) */

/* ==================== 目标文件 对象输出（-c 模式） ==================== */
静 整 主升(整 序标);
静 构 { 字 名[64]; 整 标号一; 整 序布; 整 返构序; 整 间拆; 整 返接口; 整 返错; 长 长 返错码; 整 错误码起点; 整 错误码数; } 函数表[65536]; /* 修复 2026-08-06: 512 满 → 主 等后注册函数被拒 (查函数 返 -1) → 编译产物无 主 崩; 2026-08-09 审计#2: 1024→2048; 2026-08-15 名 32→64 长函数名截断碰撞 (reftable min_update_index/_void); 修复 2026-08-16 根因E3: 1024→2048 时 查函数 守卫漏改仍为 1024 → 属性.c 等大文件超 1024 函数名 → 查函数 返 -1 → 函数表[-1].返构序 越界写崩; 2048→8192 覆盖 版本库 全量 + 守卫满则 [错误] 硬退 (绝不返 -1); 已声明 (接入 2026-08-28 声明 声明先行): 声明 名字(参数) 返回 类型; 注册签名, 未实现生成 半未 (缺失=警告非错误, 甲序 渐进补全); 2026-09-01 #116: 返接口=返回实现接口索引 (-1=无, impl Trait); 2026-09-06 显式 G1: 返错=错误联合返回 (真接入: 旁午[] 字符串表 → 函数表属性); 攻坚 2026-09-07: 错误码起点/错误码数 = 错 N 常量码集 池区间 (数=-1 = 集未知/动态码或超8, 尝试 回落 若(__e)) */
/* 静态 函数名映射 (生成码 重置 函数数, 用名字; 修复 2026-08-06 任务 5.3: 多 .o 时 静态 函数应 scl=3 局部符号, 否则 jystd 等头库每 .o 重复导出冲突) */
静 字 净深一[1024][64]; 静 整 帧叁;
静 字 净私一[1024][64]; 静 整 帧肆;
静 空 函数私有标(常 字 *数) { 遍 (整 计 = 0; 计 < 帧肆; 计++) 若 (!比较字符串(净私一[计], 数)) 返; 若 (帧肆 < 1024) { 复制字符串(净私一[帧肆++], 数); } 否 原得("私有函数表 fn_private", 1024); }
静 整 函数是否私有(常 字 *数) { 遍 (整 计 = 0; 计 < 帧肆; 计++) 若 (!比较字符串(净私一[计], 数)) 返 1; 返 0; }
静 空 函数私有除(常 字 *数) { 遍 (整 计 = 0; 计 < 帧肆; 计++) 若 (!比较字符串(净私一[计], 数)) { 遍 (整 乙 = 计; 乙 < 帧肆 - 1; 乙++) 复制字符串(净私一[乙], 净私一[乙 + 1]); 帧肆--; 返; } }
静 空 函数静态标(常 字 *数) { 遍 (整 计 = 0; 计 < 帧叁; 计++) 若 (!比较字符串(净深一[计], 数)) 返; 若 (帧叁 < 1024) { 复制字符串(净深一[帧叁++], 数); } 否 原得("静态函数表 fn_static", 1024); }
静 整 函数是否静态(常 字 *数) { 遍 (整 计 = 0; 计 < 帧叁; 计++) 若 (!比较字符串(净深一[计], 数)) 返 1; 返 0; }
静 空 隔凶(常 字 *数) { 遍 (整 计 = 0; 计 < 帧叁; 计++) 若 (!比较字符串(净深一[计], 数)) { 遍 (整 乙 = 计; 乙 < 帧叁 - 1; 乙++) 复制字符串(净深一[乙], 净深一[乙 + 1]); 帧叁--; 返; } }
静 整 函数数 = 0;
静 字 串升一[8192][64]; 静 整 声明数; 静 字 邻捌[8192]; /* 修复 2026-08-30: C prototypes (整数 foo(空);) live 在 串升一 带 标志=1: A1001 门 仅, 无 半未 在 -c 模式 (定义 可能 是 在 另一 .o - 链接器 重复 符号) */ /* 接入 2026-08-28 声明 声明先行: 独立声明表 (函数数 在 生成码 重置, 故不依赖 函数表.已声明) — 声明 名字(参数); 注册, 未实现生成 半未 */
静 整 链接模式 = 0;
静 /* 修复 2026-08-10 门 9: ������� (计挂) + �ڴ�����/�����ַ */
整 计挂 = 0; /* 门 9: ��������������� (主 ��� __bare__ ��������) */
#define 剩薄 0x3800000
#define 宽贰 0x3900000
#define 现陆一 0x3A00000
#define 后拆一 0x3B00000
整 满双 = 0; /* -左退一: 裸二进制输出 (内核: 无 可执行格式 头/无 运行库/无 .数据), 修复 2026-08-08 */
静 整 满柒一 = 0; /* -c: 后凶 已发射 一旦 每 对象 */
静 整 链丑 = -1; /* 修复 2026-08-17: 目标文件 后凶 运行时守卫标志的 .数据 槽 (首个被调函数触发一次) */
静 整 单平 = -1; /* 修复 2026-08-17: 后凶 专用子程序标签 (正文只在 .文本 末尾一次) */
#define 首寅 131072
#define 正二 0x30000000 /* .数据 重定位 段次 哨兵：空伴 按 帧三=3 分组 */
静 构 { 整 段次; 整 型; 整 半退; 整 现重; 整 高亥; 整 标号一; } 实凶[首寅];
静 整 总得;
#define 空置 16384
静 构 { 字 名[64]; 整 值一; 整 缓癸; 整 域; 整 型; } 符退[空置];
静 整 满己;
静 uint8_t *列叁; 静 整 单利, 左进一;
静 uint8_t *列己; 静 整 副酉, 间退;
静 整 值升, 毛薄, 素戊, 外浅;

静 整 满合(常 字 *名) {
    遍 (整 计 = 0; 计 < 满己; 计++) 若 (!比较字符串(符退[计].名, 名)) 返 计;
    返 -1;
}
静 整 首利(常 字 *名, 整 值一, 整 缓癸, 整 域, 整 型) {
    若 (满己 >= 空置) { 输出到文件(错误流, "qcc: 符号表 溢出\n"); 终止程序(); }
    整 计 = 满己++;
    拷贝前n(符退[计].名, 名, 63); 符退[计].名[63] = 0;
    符退[计].值一 = 值一; 符退[计].缓癸 = 缓癸; 符退[计].域 = 域; 符退[计].型 = 型;
    返 计;
}
静 空 缺亥(整 段次, 整 型, 整 半退, 整 现重) {
    若 (总得 >= 首寅) { 输出到文件(错误流, "qcc: 重定位 溢出\n"); 终止程序(); }
    实凶[总得].段次 = 段次; 实凶[总得].型 = 型;
    实凶[总得].半退 = 半退; 实凶[总得].现重 = 现重;
    实凶[总得].高亥 = 0; 实凶[总得].标号一 = -1;
    总得++;
}
/* .数据 槽重定位：段次 以 正二 为基（空伴 识别为 标叁[3]） */
静 空 序深(整 数据偏, 整 型, 整 半退, 整 现重) {
    缺亥(正二 + 数据偏, 型, 半退, 现重);
}
静 整 列挂 = -1;
静 整 净拾(空) {
    若 (列挂 < 0) { /* 启元 Q2 修复 (2026-09-23): 堆计数器 必须【本模块定义 + 全局符号 scl=2】。
        原 首利(名,0,0,2,0) 的 缓癸=0 = 未定义 ⟹ .obj 留成外部引用 ⟹ 外部链接报 undefined reference。
        改为 先 变量静态 分配数据槽, 再 双成(槽) 查符号 (缓癸=4 本模块定义)。
        不设 逆酉 ⟹ 保持 scl=2 全局 —— 堆计数须 多 .o 共享, 与 __qcc_ginit_flag(scl=3 每 .o 独立) 语义不同。 */
        整 槽二 = 变量静态("__qcc_heap_counter", 0);
        列挂 = 双成(槽二);
    }
    返 列挂;
}
静 空 下平(空) {
    汇发("    读堆计数器 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x8B); 发字节(0x05); 发四(0); /* 移动 首子, [指令指针+0] */
    缺亥(码位 - 4, 0x0004, 净拾(), 0);
}
静 空 堆环(空) {
    汇发("    写堆计数器 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x89); 发字节(0x05); 发四(0); /* 移动 [指令指针+0], 首子 */
    缺亥(码位 - 4, 0x0004, 净拾(), 0);
}
静 空 正浅(常 uint8_t *指, 整 数) {
    若 (单利 + 数 > 左进一) {
        整 接子数 = 左进一 ? 左进一 * 2 : 4096;
        循环 (接子数 < 单利 + 数) 接子数 *= 2;
        列叁 = 重分配(列叁, 接子数); 左进一 = 接子数;
    }
    复制内存(列叁 + 单利, 指, 数); 单利 += 数;
}
静 空 短十(常 uint8_t *指, 整 数) {
    若 (副酉 + 数 > 间退) {
        整 接子数 = 间退 ? 间退 * 2 : 4096;
        循环 (接子数 < 副酉 + 数) 接子数 *= 2;
        列己 = 重分配(列己, 接子数); 间退 = 接子数;
    }
    复制内存(列己 + 副酉, 指, 数); 副酉 += 数;
}
静 整 双成(整 槽) {
    遍 (整 计 = 变量数 - 1; 计 >= 0; 计--) { /* 修复 2026-08-15: 原 变量总数()=净乙 限制导致文件级 静态 槽位 找不到 */
        若 (变量表[计].栈偏移 == 槽) {
            整 串值 = 满合(变量表[计].名);
            若 (串值 < 0) {
                若 (槽 < 0) 串值 = 首利(变量表[计].名, 0, 0, 2, 0); /* 外部: 缓癸=0 未定义, scl=2 全局 (修复 2026-08-06 多 .o 链接) */
                否 串值 = 首利(变量表[计].名, 4 * 槽, 4, (静态关键[计] || 逆酉[计]) ? 3 : 2, 0); /* 修复 2026-08-06: 函数内 静态 → scl=3; 修复 2026-08-14: 文件级 静态 也 scl=3 */
            }
            返 串值;
        }
    }
    返 -1;
}
静 整 主薄(常 字 *数); /* 前向声明 (修复 2026-08-06) */
静 整 段丑(整 标号一) {
    遍 (整 计 = 0; 计 < 函数数; 计++) {
        若 (函数表[计].标号一 == 标号一) {
            整 串值 = 满合(函数表[计].名);
            若 (串值 < 0) {
                整 净升 = (函数是否静态(函数表[计].名) || 函数是否私有(函数表[计].名) || 主薄(函数表[计].名)) ? 3 : 2; /* 修复 2026-08-06: 静态/内建 → 局部符号 */
                串值 = 首利(函数表[计].名, 函数表[计].序布 ? 标号位[标号一] : 0,
                             函数表[计].序布 ? 1 : 0, 净升, 0x20);
            }
            返 串值;
        }
    }
    返 -1;
}
静 整 新又(常 字 *名) {
    整 串值 = 满合(名);
    若 (串值 < 0) 串值 = 首利(名, 0, 0, 2, 0x20);
    返 串值;
}
/* -c 模式：内置 名（编译器内联发射，不是外部函数） */
静 整 主薄(常 字 *数) {
    静 常 字 *位非标[] = { "printf", "fprintf", "vfprintf", "sprintf", "snprintf", "vsnprintf", "_vsnprintf", "putstr", "scanf",
        "fopen", "fread", "fwrite", "fputc", "fputs", "fgetc", "fclose", "fseek", "ftell", "rewind", "feof", "fflush", "ferror", "fgets", /* 修复 2026-08-18: 读字符 缺 → 目标文件 模式当用户函数链到 msvcrt 读字符, 拿 句柄 当 文件* 崩 (版本库 配置 读取); 修复 2026-08-24 t35t: feof/刷新缓冲/判文件错误 补内置 — 否则当用户函数外部调用 msvcrt, 句柄当 文件* 崩 (reflog/strbuf_getwholeline) */
        "_va_alloc", "host_va_alloc", "_setpos", "_getpos", "_exit_proc", "__qcc_va_start",
        "memset", "memcpy", "strlen", "strcmp", "strcpy", "strncpy",
        "malloc", "calloc", "free", "realloc", "isalnum", "isalpha", "exit", "abort", "inb", "outb", "inl", "outl", "__asm", "thread_create", "thread_join",
        /* 启元 Q2 修复 (2026-09-23): 下面 6 个 甲言内建 都【已有内联分支】(码生成 里有 比较字符串(串升,X) 分支),
           却漏登记 位非标[] ⟹ 主薄() 返 0 ⟹ 双玖 为真 ⟹ 走"普通函数调用" ⟹ -c 模式 .obj 里留成外部引用 ⟹
           外部链接报 undefined reference. 与已登记的 _va_alloc / thread_create 同族 (同在 内置豁免表 L4472 行)。 */
        "_bump_set", "_bump_top", "atomic_fetch_add", "atomic_compare_exchange", "get_proc_address", "load_library",
        "timer_delay", "timer_deadline", "async_pump", "async_step", "async_register" }; /* 2026-08-28 #45 线程内建; 第 444 站 #66: `延时 N`→timer_delay(N) · `超时 N`→timer_deadline(N) 脱糖目标登记 (原未登记 ⟹ A1001 用户不可达; 运行时 qcc_rt.c 供真实现); 第 446 站 #65 事件循环: `异步 泵/步进/注册`→async_pump/async_step/async_register 同型登记 (原三个目标 运行时 与 内建表 双缺 ⟹ 实测 A1001 用户完全不可达) */
    遍 (整 计 = 0; 计 < (整)(大小(位非标)/大小((位非标)[0])); 计++) 若 (!比较字符串(位非标[计], 数)) 返 1;
    返 0;
}
静 整 满进(常 字 *数) { /* 编译器 专用 内置: 无 运行库 对应, 取地址无法链接 (修复 2026-08-19: 其余 内置 (比较字符串/内存设置...) 取地址 → 目标文件 符号引用 → 链接器 解析 msvcrt 导入 — 版本库 string_list `比较 = 列表->比较 ? 列表->比较 : 比较字符串` 原编成 空 → 调用 *0 → 状态 段错误) */
    静 常 字 *初细[] = { "putstr", "_va_alloc", "host_va_alloc", "_setpos", "_getpos", "_exit_proc", "__qcc_va_start", "inb", "outb", "inl", "outl", "__asm" };
    遍 (整 计 = 0; 计 < (整)(大小(初细)/大小((初细)[0])); 计++) 若 (!比较字符串(初细[计], 数)) 返 1;
    返 0;
}
静 整 静态位移(整 序标, 整 键) {
    若 (链接模式) {
        整 串值 = 双成(序标);
        若 (串值 >= 0) 缺亥(码位 + 2 + 键, 0x0004, 串值, 0);
        返 键;
    }
    若 (序标 < 0) { /* 外部 无定义: 单文件编译无法解析 (修复 2026-08-06); R450 (第 439 站续四十五): 统一走 发错误 —— 原 裸文本 + 退出(1) 无错误码/无建议/破坏 JSON 协议 (同 L23700 病) */
        遍 (整 计 = 变量总数() - 1; 计 >= 0; 计--) 若 (变量表[计].栈偏移 == 序标) { 格式化到串(错缓冲, "外部 变量 '%s' 无定义 (号合.0)", 变量表[计].名); 发错误("A1001", 错缓冲); }
        格式化到串(错缓冲, "外部 变量 无定义 (号合.0)"); 发错误("A1001", 错缓冲);
    }
    返 主升(序标);
}

静 整 新标号(空) { 若 (初成 >= 短繁) { 输出到文件(错误流, "[LABEL-OVERFLOW] lc=%d\n", 初成); 终止程序(); } 整 末 = 初成++; 标号设[末] = 0; 返 末; }
静 空 设标号(整 末) { 标号位[末] = 码位; 标号设[末] = 1; 汇发(".L%d:\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0); }
静 空 补标号(整 尾柒, 整 末, 整 全附) {
    若 (链接模式) {
        整 直弊 = 段丑(末);
        若 (直弊 >= 0) {
            缺亥(尾柒, 0x0004, 直弊, 0);
        } 否 {
            若 (!值升) 值升 = 首利(".text", 0, 1, 3, 0);
            缺亥(尾柒, 0x0004, 值升, 0);
            实凶[总得 - 1].高亥 = 1;
            实凶[总得 - 1].标号一 = 末;
        }
        返;
    }
    若 (计利一 >= 1048576) { 输出到文件(错误流, "[PATCH-OVERFLOW] patch_n=%d (于标签 %d)\n", 计利一, 末); 终止程序(); }
    /* 发射 该 jump mnemonic 入 该 汇编 文本 using 该 真 标号一 末丙 (l),
       非 该 placeholder 尾午 值. 修复 2026-08-03: -S 输出 先前
       已用 零跳's 尾午 (总是 1 遍 向前 引用), 故 中文汇编 可 永不
       解析 jump targets -> 首利二!=计简一. */
    若 (全附 == 0) 汇发("    调用 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 1) 汇发("    为零跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 2) 汇发("    跳转 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 3) 汇发("    非零跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 4) 汇发("    非负跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 5) 汇发("    大于等跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 6) 汇发("    小于等跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 7) 汇发("    高于等跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 8) 汇发("    低于跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 9) 汇发("    高于跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 10) 汇发("    小跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0); /* jl (修复 2026-08-06 %lld) */
    否 若 (全附 == 11) 汇发("    大跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0); /* jg (修复 2026-08-06) */
    全败[计利一].旁退 = 尾柒;
    全败[计利一].单低 = 末;
    全败[计利一].全附 = 全附;
    计利一++;
}
静 空 解析补丁(空) {
    遍 (整 计 = 0; 计 < 计利一; 计++) {
        整 尾柒 = 全败[计].旁退;
        整 空平 = 标号位[全败[计].单低];
        整 全附 = 全败[计].全附;

        若 (全附 == 0) {
            /* 调用 三十二位相对: E8 已 已发射, 于 点 到 三十二位相对 字节 */
            整 顺败 = 空平 - (尾柒 + 4);
            隔贰(尾柒, 顺败);
        } 否 若 (全附 == 2) {
            /* 跳转 三十二位相对 */
            整 顺败 = 空平 - (尾柒 + 4);
            隔贰(尾柒, 顺败);
        } 否 若 (全附 == 1 || (全附 >= 3 && 全附 <= 11)) {
            /* Jcc 三十二位相对 (零跳/非零跳/jns/jge/jle/jae/jb/ja/jl/jg) */
            整 顺败 = 空平 - (尾柒 + 4);
            码[尾柒] = 顺败 & 0xff;
            码[尾柒 + 1] = (顺败 >> 8) & 0xff;
            码[尾柒 + 2] = (顺败 >> 16) & 0xff;
            码[尾柒 + 3] = (顺败 >> 24) & 0xff;
        }
    }
}
/* 码生成器-时间 变量 可见性 (根-因 2026-08-03): 期间 码生成器, 查找 运行
   带 解析基=0 over [0, 总甲[剩回]), 故 a 名 那 是 双 a 文件-作用域 静态
   且 一 earlier 函数's 局部 将 解析 到 该 局部 (later 索引) — e.g.
   生成码's `初成 = 净成` picked up 码生成()'s 局部 `初成`, emitting a 帧 访问
   whose 栈偏移 lay ~1素繁 以下 生成码's 帧. 该 全局 帧 hid 此 (该
   写入 stayed 在-帧); 局部 frames expose 它 (栈 损坏). 该 解析-时间
   rule 是: 非-静态 变量 是 visible 仅 之内 它们的 own 函数
   [新寅[剩回], 总甲[剩回]); 静态 是 visible everywhere. Enforce 它 期间 码生成器. */
静 整 变量码生成可见(整 计) {
    若 (变量表[计].是否静态标) {
        若 (!净乙) 返 1;            /* 解析: 静态 visible (解析基 下限 已 块 prior fns) */
        若 (满伴) 返 1;       /* 后凶: 已发射 于 主 入口, 全 静态 visible (修复 2026-08-11 阻塞-3) */
        若 (静态关键[计]) 返 (计 >= 新寅[剩回]); /* 函-局部 静态: 仅 其 own 函数 (修复 2026-08-11 阻塞-3) */
        返 1;                         /* 全局 静态: visible 自 任意 函数 */
    }
    若 (!净乙) 返 (计 >= 解析基 && (变量表[计].旧零 == 0 || 变量表[计].旧零 == -1)); /* 解析 阶段: 仅 当前 函数 函数体 (解析基 下限).
                                              修复 2026-08-11 阻塞-1: 原 返回 1 导致跨函数同名变量泄漏 —
                                              变量是否浮 等从其他函数找到同名变量 → 节浮标[] 误标 → 码生成器 差异 (布局敏感根因)
                                              修复 2026-08-28 类型-根-13 #277: 块已退出的变量 (旧零>0) 不可见 — 块内同名遮蔽外层, 块外恢复外层 (原 解析 期无视块标记 → 块内变量泄漏出块遮蔽外层) */
    若 (满伴) 返 0; /* 修复 2026-08-17: 后凶 只初始化静态; 跨函数非静态同名变量 (字符 *后缀 遮蔽 静态 字符 *后缀[]) 在 后凶 子程序发射点 新寅[剩回]/旁得 未正确设置时全可见 → 数组元素赋值错编成指针解引用+字节存储 → 崩 */
    /* 修复 2026-08-19: 嵌套块同名变量只在块内可见 — 当前 码生成器 块 [值序, 旁得)
       必须被该变量的声明块 [内薄, 旧零) 包含. 否则 `结构体 strbuf gitdir` 之后嵌套块
       `常量 字符 *gitdir = ...` 的独立条目会让外层 &gitdir 解析到 字符* 条目 (指元素尺寸=1) →
       例 11 跳过 偏移-=尺寸(strbuf) → 地址错位 → strbuf 崩. 参数 (素三) 全函数可见. */
    { 整 返二 = (计 >= 新寅[剩回] && 计 < 旁得 && (变量表[计].素三 || 变量表[计].旧零 == -1 || (变量表[计].内薄 <= 值序 && 变量表[计].旧零 >= 旁得))); 返 返二; } /* 码生成器: 此 函数's 局部/参数, 且 仅 up 到 该 当前 块 结束 — later 兄弟-块 局部 必须 非 影子 earlier 块 (修复 2026-08-16). 旧零==-1: 复用条目标记函数级可见 (修复 2026-08-19) */
}
静 整 变量是否浮(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].是否浮标;
     遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否浮标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否浮标; /* 全局 双精度 (修复 2026-08-13: 解析 期 解析基 排除全局 → 全局 双精度 算术丢 64 位) */
    返 0;
}
静 整 变量单标(常 字 *数) { /* R4a-1: 单精度(4B float)变量 — 存储 movss 4B, 值语义 double (读提升) */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].单标;
     遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].单标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].单标;
    返 0;
}
静 整 变量指单(常 字 *数) { /* R4a-4: 指向 单精度 float 的指针 — 解引用 movss 4B (读提升/写降单) */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].指单;
     遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].指单;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].指单;
    返 0;
}
/* 长整 长整 变量: 64-位 整数 加载/存储 (修复 2026-08-05) */
静 整 变量是否长(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].是否长标;
     遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否长标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否长标; /* 全局 长整 长整 (修复 2026-08-13: 全局 邻辰 算术被当 32 位, b_global 6000000000→低32) */
    返 0;
}
/* 字符 变量: 1-字节 加载/存储 (修复 2026-08-25 缺陷#28b: 局部 字符 变量 32 位读/写 → 负值/高位非零值错 —
   编译器 字符=无符号 约定, 读用 零扩展 零扩展, 存用 移动 字节 截断) */
静 整 变量是否字符(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].是否字符标;
     遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否字符标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否字符标; /* 全局 字符 */
    返 0;
}
/* 有符号 字符 变量: 符号扩展 符号扩展读 (修复 2026-08-29 生成器: 有符号 字符 x=0xB3 须返回 -77 非 179) */
静 整 整丙(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].深成;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].深成;
    返 0;
}
/* 短整 变量: 2-字节 加载/存储 (修复 2026-08-25 缺陷#31b: 局部 短整/uint16_t 32 位读/写 → 16 位值高位污染) */
静 整 变量是否短(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].是否短标;
     遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否短标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否短标; /* 全局 短整 */
    返 0;
}
/* 无符号 变量: >> 必须 使用 右移一 (逻辑), 非 算术右移 (修复 2026-08-05) */
静 整 变量是否无符号(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].无符号标;
     遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].无符号标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].无符号标; /* 全局 无符号 (修复 2026-08-13) */
    返 0;
}

/* 小无符号 (uint8/uint16): C 整数提升为 有符号 int (int32 能表示全部值) — 比较/算术按有符号 (修复 2026-09-02: uint8 200 > (int8)-1 原按无符号 → 假) */
静 整 变量是否小无符号(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 (变量表[计].无符号标 && (变量表[计].是否字符标 || 变量表[计].是否短标));
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 (变量表[计].无符号标 && (变量表[计].是否字符标 || 变量表[计].是否短标));
    返 0;
}

/* 指针-到-双精度 (双精度 *p): p[i] 读取/写入 8-字节 双精度 (双精度移动) */
静 整 变量指浮(常 字 *数) { /* C131 (2026-09-19 第 125 站): **补 文件级 全局 回退** —— 原 只 扫 [解析基, 变量数) (当前 函数 局部), 全局/静态 浮点 指针 (索引 < 解析基) **永远查不到** ⟹ 恒 0 ⟹ ① `gp[i] = 双精度` 误报 A9002「双精度 值赋给整型数组元素」(L8731 判据 !变量指浮); ② 指针变量 读 分支 (L24867) 的 浮取 判据 失配 ⟹ 全局 double* 与 float* 下标 静默错值 (实测 4212992 = 地址 被当值). 同族 变量型序/变量指元素 已在 t46 (2026-08-22) 改 下界 0; 照 A22 既有 变量指浮查 (L5724) 的「查」模式 补回退, 不动 任何 调用点. 全局回退 仅 认 是否静态标 && !静态关键 的 文件级 条目. 注意: 本 注释 曾 因 写出 `*` 紧跟 `/` 的 序列 而 提前 闭合 ⟹ 变量表 报 '未声明标识符 地址'. */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].指浮;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].指浮;
    返 0;
}
/* 8-字节 帧 槽位 遍 a 局部 双精度 */
静 整 余乙(常 字 *数) { /* 长整 长整: 8-字节 整数 槽位 (修复 2026-08-05); H1a (2026-09-11): 可空 长整 支持 (值槽 + 分离 tag 槽 __nt_名) */
    整 此可空 = 取可空待(数); /* H1a (2026-09-11): 消费 本声明 的 可空槽 (helper 定义 在 可空槽表/词位 之后; 内联读 会 落到 隐式新变量) */
    外壹(数); /* R439 (2026-09-30 虾米 · 第 439 站 · D-11 首刀): 错误联合 判据 与 建条目 同源 —— 本声明错联 走 **本声明名词元** 回查 (R438 判据) */
    整 此错宽R439 = (错联待 && !此可空) ? 1 : 0; /* R439: `错误 T` 且 非可空 ⟹ 宽载荷 **8B 值类** 载体 (值槽 + 分离 tag 槽 __et_名); ≤4B 走 packed (marker 1) */
    
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].数组尺寸 == 0 && 变量码生成可见(计)) {  变量表[计].是否长标 = 1; 变量表[计].旧零 = -1; 若 (此错宽R439) { 错联标[计] = 2; 字 标名庚R439[96]; 格式化到串(标名庚R439, "__et_%s", 数); 若 (查变量(标名庚R439) < 0) 余乙(标名庚R439); } 返 变量表[计].栈偏移; } /* 修复 2026-08-19: 复用条目标记函数级可见 */ /* R439: 复用分支 也要 补 marker=2 + tag 槽 (否则 解构 查不到 __et_名 → DCL-MISS) */
    若 (变量数 >= 65536) { 输出到文件(错误流, "[ERR] 变量表满 变量数=%d\n", 变量数); 退出(1); }
    新条目名(数); /* R438: 建条目 单点收口 */
    栈用量 += 8; 栈用量 = (栈用量 + 15) & ~15;
    变量表[变量数].栈偏移 = 栈用量 - 8;
    变量表[变量数].素三 = 0;
    变量表[变量数].栈又 = -1; 变量表[变量数].值丙 = -1;
    变量表[变量数].型序标 = -1; 变量表[变量数].构尺寸 = 0; 变量表[变量数].数组尺寸 = 0; 变量表[变量数].数组元素尺寸 = 0;
    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0; 变量表[变量数].指元素尺寸 = 0; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = 0; 变量表[变量数].是否浮标 = 0; 变量表[变量数].指浮 = 0; 变量表[变量数].是否字符标 = 0; 变量表[变量数].无符号标 = 0; 变量表[变量数].是否静态标 = 0;
    变量表[变量数].是否长标 = 1;
    变量表[变量数].旧零 = (数[0] == '_') ? -1 : 0; /* G1-5 (2026-09-12): 旧零 是 块可见性 权威 (函数级 -1 / 块内 0) — 原 漏 初始化 → 残留 上一条 变量 的值 → 变量码生成可见 判错 → 该变量 在 码生成期 "不可见" (实测: 契约 __qcc_ret 走 本 通道 → [ERR] 未定义函数 '__qcc_ret' 不能取地址) */
    变量表[变量数].可空值标 = 0; 变量表[变量数].变可空.tag = 可空值_有值;
    若 (此可空) { 变量表[变量数].可空值标 = 2; 变量表[变量数].变可空.tag = 可空值_无值; } /* H1a: 可空值标 2 = 分离 tag 槽 类 (tag 槽 __nt_名 在 值 之后 分配 → 值槽 偏移 稳定) */
    就绪未标(数); /* D12R451 (D-12 根治): **余乙 原缺 本条**（变量偏移/变构 皆有）⟹ 8B 整数 从未进 守卫表 */
    若 (数[0] != '_') { 尾登记(数, 净丙, 变量数); } /* D12R451: 读侧 A4001 区 被 `尾系()` 整体门住 ⟹ 必须登记; ⚠️ **不加 序集 守卫** —— 九刀实证 序集 在此为假 ⟹ 带守卫 等于 不登记（第七刀 无效 的真因） */
    整 值偏一 = 变量表[变量数++].栈偏移;
    若 (此可空) { 字 标名庚[80]; 格式化到串(标名庚, "__nt_%s", 数); 余乙(标名庚); } /* H1a: tag 槽 (名 '_' 前缀 → 递归 内 外壹 不置 可空待) */
    若 (此错宽R439) { 错联标[变量数 - 1] = 2; 字 标名R439[96]; 格式化到串(标名R439, "__et_%s", 数); 余乙(标名R439); } /* R439: 宽载荷 错误联合 ⟹ marker 2 (分离 tag 槽类) + 分离 tag 槽 (值槽 之后 紧邻, 同 可空 H1a 模式; 名 下划线 前缀 ⟹ 递归 不复发) */
    返 值偏一;
}
静 整 变浮(常 字 *数) {
    整 此可空二 = 取可空待(数); /* H1b (2026-09-11): 消费 可空槽 (同 H1a, 经 helper) */
    外壹(数); /* R440 (D-11b): 同 变构 */
    整 此错宽R440b = (错联待 && !此可空二) ? 1 : 0; /* R440: `错误 双` 非可空 ⟹ 值槽 8B + 分离 tag 槽 (tag 走 rdx, 同 8B 值类) */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].数组尺寸 == 0 && 变量码生成可见(计)) { 变量表[计].是否浮标 = 1; 变量表[计].旧零 = -1; 返 变量表[计].栈偏移; } /* 修复 2026-08-19: 复用条目标记函数级可见 */
