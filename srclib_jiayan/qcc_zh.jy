                若 (词型表[词位] == 右方) 词位++; /* 跳过 ] */
                { /* 修复 2026-08-30 探雷雷5 + 阶段C-1 #52 (2026-09-02): 常量下标越界编译期拦截 — 目弊 折叠 (支持 -1/2+3 等常量表达式; 变量下标 高癸一=0 不查) */ 若 (节型别[底] == 节点_变量 && 串玖 >= 0) { 常 字 *池汇 = (字*)(节名表 + 底); 整 源得 = 变量数组(池汇); 若 (源得 > 0 && 变量指深(池汇) == 0) { 整 计未 = 0; 长 长 下标值 = 目弊(串玖, NULL, NULL, 0, &计未); 若 (计未 && (下标值 < 0 || 下标值 >= 源得)) { 格式化到串(错缓冲, "编译期越界: 数组 '%s'[%lld] 越界 (大小 %d) (探雷雷5, 号合.0 #52 依赖长度)", 池汇, 下标值, 源得); 发错误("A2001", 错缓冲); } } } } /* 阶段C-1 #52 (2026-09-02): 补下越界 节值表<0 — 依赖长度数组双向编译期拦截 */
                若 (!首己 && 节型别[底] == 节点_变量 && 串玖 >= 0 && 节型别[串玖] == 节点_常数) { /* 2026-08-28 阶段一 #34 切片分裂: 静态下标路径 a[i] — 元素级借用检查 (动态下标记录为边界) */
                    字 首又[160]; 格式化到串(首又, "%s[%d]", (字*)(节名表 + 底), 节值表[串玖]);
