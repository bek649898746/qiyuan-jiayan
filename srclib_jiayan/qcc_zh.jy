           子目录源文件 include 不到 → 224 文件全部 [ERR] 找不到。向上回溯父目录链。 */
        字 号得[1024];
        复制字符串(号得, 空七[净厚 - 1]);
        遍 (;;) {
            字 *槽长 = 反向查(号得, '/');
            字 *余庚 = 反向查(号得, '\\');
            若 (余庚 > 槽长) 槽长 = 余庚; /* Windows 路径反斜杠分隔 (fix 2026-08-16: 原只找 '/' 回溯永不触发) */
            若 (!槽长) 断;
            *槽长 = 0;
            若 (!号得[0]) 断;
            字 间八[1024];
            复制字符串(间八, 号得);
            拼接(间八, "/");
            拼接(间八, 串升);
            字 *反繁 = 源乙(间八);
            若 (反繁) { 复制字符串(序己, 号得); 返 反繁; }
        }
    }
    返 源乙(串升);
}
