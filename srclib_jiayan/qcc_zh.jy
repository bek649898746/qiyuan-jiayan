                字 *存轮 = (字 *)段吉; /* fix 2026-08-26: mark=args 起始 (块链表块永不移动, 裸指针有效) — 释放到 args 连 exp_args 一起回收 */
                计++;
                整 深度 = 1, 参序甲 = 0, 首劣 = 0;
                循环 (段[计] && 深度 > 0) {
                    若 (段[计] == '"' && !首劣) 首劣 = 1;
                    否 若 (段[计] == '"' && 首劣 && !帧再(段, 计)) 首劣 = 0; /* fix 2026-08-14: \\" 两反斜杠后 " 应结束 */
                    若 (段[计] == '\'' && !首劣) { /* 字符字面量 '"' 在宏实参内 — 跳过, 防 " 翻转 ain_str (fix 2026-08-14) */
                        若 (参序甲 < 4095) 段吉[匿数 * 4096 + 参序甲++] = 段[计++]; /* opening ' */
                        循环 (段[计] && (段[计] != '\'' || 帧再(段, 计))) { 若 (参序甲 < 4095) 段吉[匿数 * 4096 + 参序甲++] = 段[计]; 计++; }
                        若 (段[计]) { 若 (参序甲 < 4095) 段吉[匿数 * 4096 + 参序甲++] = 段[计]; 计++; }
                        续;
                    }
                    若 (!首劣) {
                        若 (段[计] == '(') 深度++;
                        否 若 (段[计] == ')') { 深度--; 若 (深度 == 0) 断; }
                        若 (段[计] == ',' && 深度 == 1) { /* fix 2026-08-07: 串内逗号不拆参 */
                            段吉[匿数 * 4096 + 参序甲] = 0;
                            若 (匿数 < 15) { 匿数++; 参序甲 = 0; }
                            否 { 若 (参序甲 < 4095) 段吉[匿数 * 4096 + 参序甲++] = ','; 若 (参序甲 < 4095) 段吉[匿数 * 4096 + 参序甲++] = ' '; } /* 超限: 并入末槽 (变参) */
                            计++; 循环 (段[计] == ' ' || 段[计] == '\t') 计++; 续; /* fix 2026-08-14: 跳逗号后前导空格 — DECLARE_PROC_ADDR(..., strftime) 的 strftime 前带空格 → ## 拼接 proc_addr_ strftime 有空隙 */
                        }
