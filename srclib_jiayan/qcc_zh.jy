                    若 (初得 >= 0 && (节型表[初得] == 23 || 节型表[初得] == 26)) 初得 = 子0[初得];
                    若 (初得 >= 0 && 节型表[初得] == 1 && 变量型序((字*)(节名表 + 初得)) == 主复一) 满丙 = 1;
                } 否 若 (子1[数] >= 0 && 节型表[子1[数]] == 1) {
                    若 (变量型序((字*)(节名表 + 子1[数])) == 主复一 && 变量指元素((字*)(节名表 + 子1[数])) == 0) 满丙 = 1;
