静 整 反进 = 0; /* prepend 的 qcc_rt.c 行数 (用户源码行号校正) */
静 整 旁亥(常 字 *串值, 整 位) {
    整 度转 = 1;
    遍 (整 键 = 0; 键 < 位 && 串值[键]; 键++) 若 (串值[键] == '\n') 度转++;
    返 度转 - 反进;
}
