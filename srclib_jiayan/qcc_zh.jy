                } 否 若 (下环) {
                    若 (条件计数 > 0) { 若 (!下劣[条件计数-1] && !后排[条件计数-1]) { 下劣[条件计数-1] = 条件; 顺一 = 后排[条件计数-1] || !条件; } 否 顺一 = 1; }
                } 否 若 (短再) {
                    若 (条件计数 > 0) { 若 (!下劣[条件计数-1] && !后排[条件计数-1]) { 下劣[条件计数-1] = 1; 顺一 = 后排[条件计数-1]; } 否 { 顺一 = 1; 下劣[条件计数-1] = 0; } } /* C69: 同上 (真分支已走 ⟹ #else 体跳过, 本层须标 0) */
                } 否 若 (短叁) {
                    若 (条件计数 > 0) { 条件计数--; 顺一 = 条件计数 > 0 ? !下劣[条件计数-1] : 0; } /* 修复 2026-08-13 第三阶段: 嵌套假分支恢复用 !taken 而非 父 */
                }
