        { 整 毛退 = 词位 + 1; 循环 (词型表[毛退] == 型词) 毛退++; 若 (词型表[毛退] == 结构词) { 毛退++; 若 (词型表[毛退] == 词变量) 毛退++; } 若 (词型表[毛退] == 枚词) { 毛退++; 若 (词型表[毛退] == 词变量) 毛退++; } 若 (词型表[毛退] == 词变量 && 型定判断(词名表[毛退])) 毛退++; 循环 (词型表[毛退] == 乘 || (词型表[毛退] == 型词 && (!比较字符串(词名表[毛退], "const") || !比较字符串(词名表[毛退], "常")))) 毛退++; 若 (词型表[毛退] == 词变量 && 词型表[毛退 + 1] == 左括) { 整 计五 = 毛退 + 2, 逆双 = 1; 循环 (计五 < 词容量 && 逆双 > 0) { 若 (词型表[计五] == 左括) 逆双++; 否 若 (词型表[计五] == 右括) 逆双--; 计五++; } 若 (计五 < 词容量 && 词型表[计五] == 左花) 深附 = 1; } }
