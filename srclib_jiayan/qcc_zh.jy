                体注册(新构丙, 联丙);
                类型定型(新构丙);
                字 暂存丙[64]; 格式化到串(暂存丙, "__anon_%d", 新构丙);
                复制字符串(类型表[新构丙].名, 暂存丙);
                若 (词型表[词位] == 词变量) {
                    字 别丙[64]; 复制字符串(别丙, 词名表[词位]); 词位++;
                    左系(别丙);
                    型定加(别丙, 1, 暂存丙, 0, 类型表[新构丙].尺寸, 0, 0, -1);
