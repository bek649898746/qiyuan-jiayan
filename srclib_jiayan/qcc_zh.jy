    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "类型") && (词型表[词位 + 1] == 结构词 || 词型表[词位 + 1] == 枚词) && (词型表[词位 + 2] == 左花 || (词型表[词位 + 2] == 词变量 && 词型表[词位 + 3] == 左花))) { 格式化到串(错缓冲, "类型 构/联合 [标签]? { ... } 别名; — 未支持 (别名 须 写在 = 左边); 请 写 类型 别名 = 构 { ... }; 或 先 定义 具名结构体 再 别名 (R540-B6)"); 发错误("A1001", 错缓冲); } /* 文件级 */
