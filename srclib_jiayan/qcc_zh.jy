        否 若 (!比较字符串(词名表[词位], "用户错误")) 复制字符串(缓属, "[用户错误]");
        否 若 (!比较字符串(词名表[词位], "系统错误")) 复制字符串(缓属, "[系统错误]");
        否 复制字符串(缓属, "[逻辑错误]");
        词位++;
        整 消息序标 = -1;
        若 (词型表[词位] == 串词) { 消息序标 = 词值表[词位]; 词位++; }
        若 (词型表[词位] == 分号) 词位++;
        字 堆平[160]; 格式化到串(堆平, "%s %%s\n", 缓属);
        若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
        若 (!串表[串数]) 串表[串数] = 短六();
