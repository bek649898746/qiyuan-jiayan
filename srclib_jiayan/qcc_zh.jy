#define 素九 66     /* 弹栈 r64; 比较 堆九,rbx; 条件置位/顺深一; 零扩展 首子,累加低 — 64位比较 */
#define 总优一 67   /* 双精度移动 xmm1,xmm0; 弹栈 xmm0; comisd; 条件置位(浮点条件码); 零扩展 — 双精度 比较 */
#define 容散 68     /* 移寄存器(1, 0): ecx = 首子 — 移位计数 */
