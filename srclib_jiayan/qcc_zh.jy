    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "挤压")) { /* 接入 2026-08-27 压缩删除匹配 (compact/remove): 挤压 dst, src, n, cond; → { __sq=0; __sj=0; while(__sj<n){ if(cond(src[__sj])!=0){ dst[__sq]=src[__sj]; __sq++; } __sj++; } } — 删除 cond 为真的元素, 剩余依次前移 (与过滤互补) */
