                整 深 = 1, 寻 = 指节;
                循环 (寻 >= 0 && 节型别[寻] == 节点_解引用) { 深++; 寻 = 子0[寻]; 若 (寻 >= 0 && (节型别[寻] == 节点_增减 || 节型别[寻] == 节点_前置增减)) 寻 = 子0[寻]; }
                若 (寻 >= 0 && 节型别[寻] == 节点_变量) {
                    若 (管道变量层级(寻) >= 1) { 元素 = 8; } /* L-15 (第二十四轮 · 真接入): **函数指针链** —— 解引用链的落点 必是 8 字节函数指针。
                        实测: `ppp`(`整 (***)(整)`) 的 变量指深=2 恰 等于 本处 深=2 ⟹ 原判据 落「元==深 → 正己」分支 得 元素=1
                        ⟹ 发 `零扩展 eax, [rax]` 只读 1 字节 → `call r10` 到半截地址 → 0xC0000005 (`(**ppp)(5)` 实测)。 */
                    否 { 整 元 = 变量指深((字*)(节名表 + 寻));
                        若 (元 > 深) 元素 = 8; 否 若 (元 == 深) 元素 = 正己((字*)(节名表 + 寻)); 否 元素 = 1; }
                }
                否 若 (寻 >= 0 && (节型别[寻] == 节点_成员 || 节型别[寻] == 节点_箭头)) { 整 内寻 = 表达式内重(寻); 元素 = (内寻 > 0) ? 内寻 : 8; } /* R253 (2026-09-22) 虾米: **成员/箭头 链根** —— 原 本 分支 只认 `节点_变量` 链根 ⟹ `**sBox.pp` 落 元素=0 ⟹ 8 字节读 (实测 8.000002 应 1.5); 变量基 `**fpp` 因 链根 是 变量 而 正确. 成员链 的 最内层 元素 尺寸 由 `表达式内重` 给出 (它 已 覆盖 成员/箭头, 与 下标路径 R248/R249 的改道 同源). */
            }
            否 若 (节型别[指节] == 节点_调用) { /* *f(...) — 解引用函数调用返回的指针: 宽度=返回指针层数 (修复 2026-08-20: 原 元素=0 → 零扩展字节 只取低字节 → hashmap_get 的 `*find_entry_ptr` 返回 0x50 → 状态 打印 它=80 崩) */
                字 *半对 = NULL;
                遍 (整 计 = 19; 计 >= 0; 计--) { 整 字符 = 取子(指节, 计); 若 (字符 >= 0 && 节型别[字符] == 节点_变量) { 半对 = (字*)(节名表 + 字符); 断; } }
                若 (半对) {
                    整 副组一 = 副降二(半对);
                    若 (查返回名指(半对) && 副组一 >= 2) 元素 = 8; /* 结构体 X** 及以上: 解引用得 X* (8B 指针) */
                    否 若 (查返回名指(半对) && 副组一 == 1) { 整 号利 = 查返回名(半对); 若 (号利 >= 0 && 类型表[号利].尺寸 <= 8) 元素 = 类型表[号利].尺寸; } /* 结构体 X* 小 结构体 (<=8B) 按值 */
                    /* 字符* / 整数* 等无类型记录: 保持默认 1 字节 */
