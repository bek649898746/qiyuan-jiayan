                压栈寄存器(15); 移64(15, 4);
                汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                减栈即(32);
                调导入(10); /* CloseHandle */
                加栈即(32);
                移64(4, 15); 弹栈寄存器(15);
                加栈即(总计数);
                元子 = 1;
            } 否 若 (!比较字符串(串升, "load_library")) { /* 2026-08-28 阶段一 #246: 动态库加载 — load_library("名") → LoadLibraryA(rcx=实参零) → 堆九=HMODULE (真运行时加载) */
                移寄存器栈64(1, 参基 + 总计数 - 槽高[0] - 8); /* rcx = 实参零 (DLL 名) */
