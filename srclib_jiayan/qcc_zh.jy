        反附(临时基 + 224 - 当前帧大小, 10); /* 当前 str */
        /* size-1 → scratch+236 */
        移64(0, 11);
        汇发("    减 r0, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x83); 模字节(3, 5, 0); 发字节(1); /* sub eax,1 */
