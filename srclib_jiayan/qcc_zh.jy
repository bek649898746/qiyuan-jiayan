        词位++; /* 越界检查 */
        整 上贰 = 表达式(); (空)上贰; /* 数组 (上下文) */
        若 (词型表[词位] == 逗号) 词位++;
        整 堆未 = 表达式(); /* 下标 */
        若 (词型表[词位] == 逗号) 词位++;
        整 终数 = 表达式(); /* 长度 */
        若 (词型表[词位] == 分号) 词位++;
        整 块 = 建节(5);
        遍 (整 容序 = 0; 容序 < 2; 容序++) { /* 两路: 0=idx<0, 1=idx>=n */
            整 比较;
            若 (容序 == 0) { 比较 = 建节(2); 节值表[比较] = 比小; 接子(比较, 堆未); { 整 零 = 建节(0); 节值表[零] = 0; 接子(比较, 零); } } /* idx < 0 */
            否 { 比较 = 建节(2); 节值表[比较] = 宽排; 接子(比较, 堆未); 接子(比较, 终数); } /* idx >= n */
            整 若序 = 建节(8); 接子(若序, 比较);
