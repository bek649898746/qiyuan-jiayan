                字 别名存[64]; 复制字符串(别名存, 词名表[词位 + 2]);
                整 标签尺寸 = 0; { 整 计玖 = 查类型(标签名); 若 (计玖 >= 0) 标签尺寸 = 类型表[计玖].尺寸; }
                左系(别名存);
