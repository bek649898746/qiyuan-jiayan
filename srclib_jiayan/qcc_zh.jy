静 整 后戊 = 0; /* 编译期求值 解释失败标志 (无法解释/副作用) — 区分 返回 发生 长简 无法解释 */
静 整 现利(空) { /* 词位 指向 {, 跳到匹配 } 之后; 返回 1 成功 */
    整 元 = 0;
    循环 (词位 < 词容量) { 若 (词型表[词位] == 左花) 元++; 否 若 (词型表[词位] == 右花) { 元--; 若 (元 == 0) { 词位++; 返 1; } } 词位++; }
    返 0;
}
静 整 当丙一(空) { /* 跳到顶层 ; (消费); 返回 1 成功 */
    整 元 = 0;
    循环 (词位 < 词容量) { 若 (词型表[词位] == 左括 || 词型表[词位] == 左花 || 词型表[词位] == 左方) 元++; 否 若 (词型表[词位] == 右括 || 词型表[词位] == 右花 || 词型表[词位] == 右方) { 若 (元 > 0) 元--; } 否 若 (词型表[词位] == 分号 && 元 == 0) { 词位++; 返 1; } 词位++; }
    返 0;
}
静 整 链聚(整 *值); /* 前向: 遍-步 解析 */
静 整 内申(空) { /* 定位 遍-步 结束位置 (不执行, 从 词位 扫到顶层 右括/分号) — 步 在循环尾才执行 */
    整 元 = 0; 整 乙 = 词位;
    循环 (乙 < 词容量) {
        若 (词型表[乙] == 左括) 元++;
        否 若 (词型表[乙] == 右括) { 若 (元 == 0) 返 乙; 元--; }
        否 若 (词型表[乙] == 分号 && 元 == 0) 返 乙;
        乙++;
    }
    返 乙;
}
静 整 池分(整 *返一) { /* 解释单条语句; 返回 1=继续 0=终止 (返回 或块尾或无法解释 — 无法解释时 后戊=1) */
    若 (词位 >= 词容量) { 后戊 = 1; 返 0; }
    若 (词型表[词位] == 分号) { 词位++; 返 1; } /* 空语句 */
    若 (词型表[词位] == 左花) { /* 块 */
        词位++;
