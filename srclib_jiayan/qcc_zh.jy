                    字 名存[64]; 整 名序 = 0;
                    整 指 = 元; 循环 (判字母数字((无 字)串值[指]) || 串值[指] == '_' || ((无 字)串值[指] >= 0x80)) 指++;
                    循环 (串值[指] == ' ' || 串值[指] == '\t') 指++;
                    循环 (判字母数字(串值[指]) || 串值[指] == '_' || ((无 字)串值[指] >= 0x80)) { 若 (名序 < 63) 名存[名序++] = 串值[指]; 指++; }
                    名存[名序] = 0;
                    整 定义 = 邻细(名存); /* fix 2026-08-06: 原 macro_find>=0 对负值宏判假 */
                    条件 = 是否条件编译 ? 定义 : !定义;
                } 否 若 (序粗 || 下环) {
                    条件 = 预处求值(表达式);
                }
                若 (序粗 || 是否条件编译 || 外二) {
                    若 (条件计数 < 64) {
                        后排[条件计数] = 父节;
                        若 (序粗 || 是否条件编译 || 外二) { 下劣[条件计数] = 条件 && !父节; 顺一 = 父节 || !条件; }
                        条件计数++;
                    }
                } 否 若 (下环) {
                    若 (条件计数 > 0) {
                        若 (!下劣[条件计数 - 1] && !后排[条件计数 - 1]) { 下劣[条件计数 - 1] = 条件; 顺一 = 后排[条件计数 - 1] || !条件; }
                        否 顺一 = 1;
                    }
                } 否 若 (短再) {
                    若 (条件计数 > 0) {
                        若 (!下劣[条件计数 - 1] && !后排[条件计数 - 1]) { 下劣[条件计数 - 1] = 1; 顺一 = 后排[条件计数 - 1]; }
                        否 顺一 = 1;
                    }
                } 否 若 (短叁) {
                    若 (条件计数 > 0) { 条件计数--; 顺一 = 条件计数 > 0 ? !下劣[条件计数 - 1] : 0; } /* fix 2026-08-13 Phase3: 原 if_parent_skip[if_n-1] 是父级 skip — 嵌套假分支弹出时误清 skip (regex_internal.h #ifdef RE_ENABLE_I18N 假分支内嵌 #ifdef _LIBC 弹出后 struct 体泄漏) */
                }
                循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') 计 += 2; 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') 计 += 3; 否 计++; } /* skip directive line */
                续;
            }
            若 (顺一) { /* in a false branch: skip all lines (incl. #define/#include) until the matching #endif/#elif/#else */
                循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') 计 += 2; 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') 计 += 3; 否 计++; }
