        例 节点_前置增减: { /* 余散一 ++/-- : mutate, 则 返回 该 新 值 (修复 2026-08-05) */
            码生成丢弃结果 = 0; /* 阶段D DCE (2026-09-05 虾米): ++/-- 有副作用, 阻断传递死 */
            整 高拆 = 节值表[数];
            整 容列 = 子0[数];
            若 (容列 < 0) 断; /* 修复 2026-08-16 根治: 操作数缺失的非法 ++/-- 节点 — 原 节型表[子0[n]] 读 节型表[-1] 越界崩 (加-补丁.c, 宿主 靠布局侥幸) */
