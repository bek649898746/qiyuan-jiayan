        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "编译期") && 词型表[词位 + 1] == 左括) { /* 阶段C-1 #52 (2026-09-02): 编译期(expr) 常量求值 — 跳过 编译期+左括, 内层表达式继续 (定长 长度 支持 编译期(2+3)) */
