静 整 *段属; /* per-token high 32 bits of a long-long literal (fix 2026-08-05) */

静 整 *节型表, *节值表, *子0, *子1, *子2, *子3, *子4, *子5, *子6, *子7, *子8, *子9, *子10, *子11, *子12, *子13, *子14, *子15, *子16, *子17, *子18, *子19, *目属, *后双, *号得一, *缓七, *域癸, *半丙, *首厚, *高拆一, *副败一, *前低一, *外八一, *虚吉, *栈七, *计午一, *外对, *度叁, *主申, *元六, *度丁, *长薄, *主退一, *主轮, *现降, *外辰, *内己, *副进一, *末拆, *缺利, *域进, *全戌, *右十, *存一, *首辛, *目壹, *栈退, *源己一, *副申, *旧回, *邻丑, *链凶, *直厚, *目丁一, *帧升, *末升, *度捌, *正六, *序对一, *元戌, *右组, *段庚, *列未, *栈又一, *单再, *末双, *末子一, *毛得, *中七, *值劣一, *全聚, *行午, *满联二, *整低, *隔卯, *目甲一, *缓退, *宽分, *全聚一, *满丑, *缺午, *帧凶, *尾置, *原八, *终降, *半厚, *主三, *行凶, *池肆, *暂辛, *号系, *余利, *间次, *新酉, *左壬, *符寅, *计子一, *计细, *暂叁, *虚肆, *名癸, *源重, *列六, *外丙, *帧卯, *下重, *长成, *源进, *半利, *符置, *目六, *前又, *上平, *尾五一, *深重, *全贰, *整退, *深叁, *素乙, *串败, *左降, *宽九, *池又, *逆合, *正癸, *高又, *初伍, *反双, *深丙, *末辰, *存陆一, *素降, *隔叁, *源转, *名次, *间双, *容未, *标复, *计粗, *栈巳, *目乙, *暂联, *双环, *旧降, *实弊, *尾辰一, *缺联, *号子, *缓平一, *满升, *缺双, *正回, *虚失, *符得, *号复, *尾对, *实集, *顺五一, *余戌, *逆八, *中凶, *元失, *尾次, *计庚一, *初七, *右弊, *深汇, *正伴, *半退一, *短深, *满午, *顺高, *原子一, *源退, *串二, *后吉, *逆系, *缺聚一, *逆陆, *缺丙一, *剩凶, *目酉, *存简, *终挂, *隔捌, *剩列, *堆双一, *值陆, *素再, *副伴, *虚四, *隔置, *名子, *旁低, *净戌, *副败, *新壹一, *总戌, *剩戊, *高卯, *空亥, *逆零, *间弊, *总丙一, *半平一, *初七一, *邻肆, *内深, *后联, *素七, *池贰, *中合, *串陆, *度浅, *初挂, *虚贰, *尾劣, *外简, *值从, *标巳, *度排, *现排, *空属, *高弊, *深零一, *标集, *整得一, *上组, *初成一, *缺贰, *余散, *整未, *原厚, *首亥, *现弊, *间得, *缺粗, *空凶, *整集一, *中聚, *短得, *实序, *主聚, *标寅, *栈凶二, *存丁, *净双, *后拾, 接子数;

/* fix 2026-08-30 探雷雷2: 明显类型错配检查 — 字符串/整数/指针/char 赋值 (声明初始化+赋值共用).
   只查字面量级错配 (报告三用例: 整 x="字符串" / int *p=12345 / 字 c="字符串"), 表达式/显式 cast
   天然豁免 (nt 非 STR/0/1), qcc_rt 豁免 (user_fn_active 在调用方). C 惯例: 0/NULL 赋指针合法,
   char[] 收字符串合法. */
静 空 序平(整 右侧, 常 字 *顺挂, 整 变序) {
    若 (右侧 < 0 || 变序 < 0 || 变序 >= 变量数 || 右侧 >= 接子数 || 右侧 >= 节容量 || !顺挂) 返;
    整 链附 = (变量表[变序].指深 > 0) || (变量表[变序].数组元素尺寸 == 8 && 变量表[变序].数组尺寸 == 0);
    若 (节型表[右侧] == 串词 && !链附 && 变量表[变序].数组尺寸 == 0) {
        格式化到串(错缓冲, "类型错配: 字符串字面量赋给 '%s' — 字符串只能赋给 char*/char[] (探雷雷2)", 顺挂);
        发错误("A2001", 错缓冲);
    }
    若 (节型表[右侧] == 0 && 链附 && 节值表[右侧] != 0 && !暂合[右侧]) {
        格式化到串(错缓冲, "类型错配: 整数 %d 赋给指针 '%s' — 指针只能用地址或 NULL(0) (探雷雷2)", 节值表[右侧], 顺挂);
        发错误("A2001", 错缓冲);
    }
    若 (节型表[右侧] == 1 && !链附 && !变量表[变序].是否浮标 && !变量表[变序].是否长标) {
        整 栈厚 = 查变量((字*)(节名表 + 右侧));
        若 (栈厚 >= 0 && (变量表[栈厚].指深 > 0 || (变量表[栈厚].数组元素尺寸 == 8 && 变量表[栈厚].数组尺寸 == 0))) {
            格式化到串(错缓冲, "类型错配: 指针赋给整数变量 '%s' — 指针不能隐式转整数 (探雷雷2)", 顺挂);
            发错误("A2001", 错缓冲);
        }
    }
}

/* walk an array-access/member chain (case-14/15 nodes) down to the base NAME node.
   For m[i][j] the outer node's n0 is an inner case-14 node, NOT a name node —
   (char*)(nn + n0[n]) would read garbage. Returns the base node index. */
静 整 原庚(整 数) {
    整 发字节 = 数;
    循环 (发字节 >= 0 && (节型表[发字节] == 14 || 节型表[发字节] == 15)) 发字节 = 子0[发字节];
    返 发字节;
}
/* does this expression subtree yield an unsigned value? (fix 2026-08-05) */
静 整 表达式是否无符号(整 数) {
    若 (数 < 0) 返 0;
    若 (首甲二[数]) 返 0; /* fix 2026-08-30 csmith s168: signed 64 cast ((int64_t)x) 类型 signed — 值转换保留源 nuns 但类型判定按 cast 后 (除法 120/-1 应 -120) */
    若 (号汇一[数]) 返 1; /* fix 2026-08-31 csmith s11: unsigned 64 cast ((uint64_t)x) 结果 unsigned (比较/除法无符号) */
    若 (节无符号[数]) 返 1; /* fix 2026-08-30 csmith s61: cast/typedef 设的 nuns 标记优先 (uint32_t)X 原只字面量 nt==0 看 nuns → 比较仍按有符号 setl 分支翻转) */
    若 (节型表[数] == 1) 返 变量是否无符号((字*)(节名表 + 数)); /* unsigned var */
    若 (节型表[数] == 0) 返 节无符号[数];                       /* 0xFFFFFFFFu literal */
    若 (节型表[数] == 2) { /* binary op: 结果类型按 C 通常算术转换 (fix 2026-08-06 M1 传播: (u-1)>0 判 unsigned) */
        整 丙 = 节值表[数];
        若 (丙 == 比小 || 丙 == 外三 || 丙 == 比等 || 丙 == 名庚 || 丙 == 隔系 || 丙 == 宽排) 返 0; /* 比较 -> int 0/1 */
        若 (丙 == 逻辑与 || 丙 == 逻辑或) 返 0; /* && || -> int */
        若 (丙 == 帧寅 || 丙 == 号庚) 返 表达式是否无符号(子0[数]); /* 移位: 结果类型=左操作数 */
        返 表达式是否无符号(子0[数]) || 表达式是否无符号(子1[数]); /* + - * / % & | ^: 任一 unsigned */
    }
    若 (节型表[数] == 23 || 节型表[数] == 26) 返 表达式是否无符号(子0[数]); /* ++/-- 前缀后缀: 结果类型=操作数类型 — fix 2026-08-31 csmith s11: (--(*l_20)) uint32 前自减被当 signed → int32<uint32 比较按有符号 setl → g_577|= 条件分支翻转 → 除零崩 */
    若 (节型表[数] == 14) 返 表达式是否无符号(子0[数]); /* arr[i]: 结果类型=数组元素类型 */
    若 (节型表[数] == 12) 返 表达式是否无符号(子0[数]); /* *p: 元素类型 — fix 2026-08-30 csmith s9/s52/s61: uint64 双解引用被当有符号 → setg 替 seta → 分支翻转 (**g_2263 > (...)^1 恒真路径未执行) */
    返 0;
}

/* does this expression subtree yield a 64-bit (long long) value?
   STATIC type check: does not rely on the codegen-time nll[] array, so a
   parent binary op can see a 64-bit child (e.g. (long long)x << 32) that
   hasn't been codegen'd yet (fix 2026-08-22 #31: ((long long)hi << 32) + lo
   compiled the outer + as 32-bit -> high 32 bits lost -> git --date=relative
   now=2009 "in the future"). */
静 整 表达式是否长(整 数) {
    若 (数 < 0) 返 0;
    若 (节长标[数]) 返 1; /* cast (long long)x / literal / pre-marked */
    若 (节型表[数] == 1) { 字 *副寅 = (字*)(节名表 + 数); 遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 副寅) && 变量表[计].数组尺寸 == 0 && 变量码生成可见(计)) 返 变量表[计].是否长标; 返 0; } /* long long var — fix 2026-08-30 csmith s61: var_is_ll 返回 rsp_off (局部负偏移) → expr_is_ll 返回负判假 → 局部 int64 比较误走 32 位路径 */
    若 (节型表[数] == 0) 返 词长表[数]; /* 1000000000LL literal */
    若 (节型表[数] == 4) { /* function call returning long long (fix #27) */
            遍 (整 外劣 = 0; 外劣 < 20; 外劣++) {
                整 堆散 = -1; 择 (外劣) { 例 0: 堆散 = 子0[数]; 断; 例 1: 堆散 = 子1[数]; 断; 例 2: 堆散 = 子2[数]; 断; 例 3: 堆散 = 子3[数]; 断; 例 4: 堆散 = 子4[数]; 断; 例 5: 堆散 = 子5[数]; 断; 例 6: 堆散 = 子6[数]; 断; 例 7: 堆散 = 子7[数]; 断; 例 8: 堆散 = 子8[数]; 断; 例 9: 堆散 = 子9[数]; 断; 例 10: 堆散 = 子10[数]; 断; 例 11: 堆散 = 子11[数]; 断; 例 12: 堆散 = 子12[数]; 断; 例 13: 堆散 = 子13[数]; 断; 例 14: 堆散 = 子14[数]; 断; 例 15: 堆散 = 子15[数]; 断; 例 16: 堆散 = 子16[数]; 断; 例 17: 堆散 = 子17[数]; 断; 例 18: 堆散 = 子18[数]; 断; 缺: 堆散 = 子19[数]; 断; }
            若 (堆散 >= 0 && 节型表[堆散] == 1) 返 查函数长返((字*)(节名表 + 堆散));
        }
        返 0;
    }
    若 (节型表[数] == 2) {
        整 丙 = 节值表[数];
        若 (丙 == 比小 || 丙 == 外三 || 丙 == 比等 || 丙 == 名庚 || 丙 == 隔系 || 丙 == 宽排 || 丙 == 逻辑与 || 丙 == 逻辑或) 返 0;
        若 (节无符号[数] && !节长标[数]) 返 0; /* fix 2026-08-30 csmith s61: (unsigned)cast 32 位值 (nuns=1, nll 清) — 原递归到 64 位字面量 (-6L) 判 ll → & 传播 nll → uint32<int64 比较误判无符号 */
        若 (丙 == 帧寅 || 丙 == 号庚) 返 表达式是否长(子0[数]); /* shift: result type = LHS */
        返 表达式是否长(子0[数]) || 表达式是否长(子1[数]); /* + - * / % & | ^ */
    }
    若 (节型表[数] == 14) 返 表达式是否长(子0[数]); /* arr[i]: result = element type */
    若 (节型表[数] == 12) { 整 邻丙 = 子0[数]; 若 (邻丙 >= 0 && 节点指元素(邻丙) == 8) 返 1; 返 表达式是否长(邻丙); } /* *p: element type — fix 2026-08-30 csmith s61: int64_t* 解引用原递归到指针 is_ll=0 → 64 位比较误走 32 位 (uint32<int64 g_143 分支翻转) */
    返 0;
}


/* helper: access AST node child i (replaces (int[]){...}[i] compound literals) */
/* Generate rax = ADDRESS of a member chain (o.a.b / p->x.y), handling `->` by
   dereferencing the pointer at that point (n1.next->val loads n1.next's pointer
   value, then offsets val). *fsz_out = final field byte size; *si_out = the
   chain's resulting struct type (for further field lookup). 0 on success. */
静 空 码生成(整 数); /* forward decl: mem_addr recurses through array-access codegen (case-14 base) */
/* type-only chain resolver: struct index of the VALUE at node n (no codegen).
   Mirrors mem_addr's struct resolution. -1 if not a struct value.
   fix 2026-08-22 #41: &p->parent[i].oid 的 mem_addr case-14 基是成员链
   (nt[n0[n]]==15), 原用 var_stidx(基名字) 把字段名 "parent" 当变量查 → -1 →
   地址表达式静默丢弃 → oidcpy 目标=残留寄存器 → root commit 摘要 emit_path 崩. */
静 整 序七(整 数) {
    若 (数 < 0) 返 -1;
    若 (节型表[数] == 1) 返 变量型序((字*)(节名表 + 数));
    若 (节型表[数] == 12) 返 序七(子0[数]);
    若 (节型表[数] == 13 || 节型表[数] == 15) {
        整 减法 = 序七(子0[数]);
        若 (减法 < 0) 返 -1;
        返 字段类型序(类型表[减法].名, (字*)(节名表 + 数));
    }
    若 (节型表[数] == 14) {
        整 发字节 = 子0[数];
        若 (发字节 >= 0 && (节型表[发字节] == 15 || 节型表[发字节] == 13 || 节型表[发字节] == 12 || 节型表[发字节] == 14))
            返 序七(发字节);      /* 成员链基 (p->parent[i]): 元素 struct = 基字段的 struct */
        若 (发字节 >= 0) 返 变量型序((字*)(节名表 + 发字节)); /* 普通数组/指针变量基 */
    }
    返 -1;
}
/* Phase3-IR case15: mem_addr 前置 IR 前向声明 (骨架区 9139 定义, 相同值重复定义安全) */
静 空 中发(整 算子, 整 甲, 整 发字节, 整 字符);
静 空 中刷(空);
#ifndef 缺捌
#define 缺捌 18
#define 副失 23
#define 缓劣 28
#define 尾浅 27
#endif
静 整 内存地址(整 数, 整 *中酉, 整 *构序出) {
    若 (节型表[数] == 5 || 节型表[数] == 6) { /* PK(+) / MK(-): 指针算术表达式回收操作数元素大小 (t49c4 fix: (recs+nrec)-1 外层 -1 应缩放) */
        整 末 = 节点指元素(子0[数]);
        若 (末 > 0) 返 末;
        返 节点指元素(子1[数]);
    }
    若 (节型表[数] == 1) { /* root identifier */
        字 *变节 = (字*)(节名表 + 数);
        整 偏移 = 查变量(变节);
        若 (偏移 < 0 && !(链接模式 && 变量是否静态(变节))) 返 -1; /* fix 2026-08-18: extern 全局 (off<0 负槽) 允许 — coff 符号重定位 (var_isstatic=1); 原拒绝对外引用 → 嵌套链 the_repository->hash_algo->null_oid 根节点失败 → return 表达式静默丢弃 → null_oid() 返垃圾 → git init create_symref 崩 (简单箭头 case-15 早已允许, mem_addr 缺) */
        *中酉 = 4;
        *构序出 = 变量型序(变节);
        若 (变量是否静态(变节)) { 中发(缺捌, 偏移, 1, 0); 中刷(); } /* Phase3-IR case15: mem_addr root 静态地址 */
        否 若 (变量指元素(变节) > 0) { 中发(副失, 0, 偏移 - 当前帧大小, 0); 中刷(); } /* Phase3-IR case15: mem_addr root 指针变量 */
        否 { 中发(副失, 0, 变量基(变节, 偏移) - 当前帧大小, 0); 中刷(); } /* Phase3-IR case15: mem_addr root 局部 */
        返 0;
    }
    若 (节型表[数] == 14) { /* arr[i]: rax = &arr[i]; element struct type from the array var (fix 2026-08-03: nested member chains with an array root, e.g. items[i].p.x, previously returned -1 → stores/loads silently dropped → stack corruption) */
        /* fix 2026-08-22 #41: 成员链基 (p->parent[i]) 的元素 struct 类型用 mem_ty 解析
           (原 var_stidx(基名字) 把字段名当变量 → -1 → 地址表达式静默丢弃) */
        整 构序 = 序七(数);
        若 (构序 < 0) 返 -1;
        码生成免解引用 = 1; 码生成(数); 码生成免解引用 = 0; /* rax = &arr[i] (struct array / struct ptr) */
        *中酉 = 类型表[构序].尺寸;
        *构序出 = 构序;
        返 0;
    }
    若 (节型表[数] == 12 || 节型表[数] == 13) { /* *ptr 作链基 (e.g. (*e)->next): 委托 + 一次解引用取操作数值 — 外层 is_arrow 再解引用得到 *e (fix 2026-08-18: 原只委托不解引用 → 少一层 → &(*e)->next 编成 &e 的值 → hashmap 链遍历死循环 → git init 读取 config 挂起) */
        若 (内存地址(子0[数], 中酉, 构序出) < 0) 返 -1;
        /* fix 2026-08-22 t46: *ptr 作 struct 值 (dst = *ptr / p->dm = *ptr) — deref 后 fsz 应为指向 struct 的大小
           (原保持基变量的默认 4 → 赋值 _fok2 检查 _rfsz==_fcs2 失败 → 落标量存储只存 4 字节 → ref->objectname=*oid 只存 hash 前 4 字节 → git branch "missing object") */
        若 (*构序出 >= 0 && 类型表[*构序出].尺寸 > 8 && *中酉 == 4) *中酉 = 类型表[*构序出].尺寸;
        中发(缓劣, 0, 0, 0); 中刷(); /* Phase3-IR case15: mem_addr *ptr 解引用 — rax = [rax] = 操作数值 */
        返 0;
    }
    若 (节型表[数] == 15) {
        字 *函 = (字*)(节名表 + 数);
        整 计排 = (节型表[数] == 15 && 节值表[数] == 1);
        整 减构序 = -1, 符四 = 4;
        若 (内存地址(子0[数], &符四, &减构序) < 0) 返 -1;
        若 (减构序 < 0) 返 -1;
        若 (计排) { 中发(缓劣, 0, 0, 0); 中刷(); } /* Phase3-IR case15: mem_addr 箭头解引用 — rax = [rax] (the struct pointer) */
        整 域偏移 = 类型偏移(类型表[减构序].名, 函);
        若 (域偏移 < 0) 返 -1;
        若 (域偏移 != 0) { 中发(尾浅, 域偏移, 0, 0); 中刷(); } /* Phase3-IR case15: mem_addr 字段偏移 */
        整回 = 减构序; /* 最终字段所在结构体 (fix 2026-08-18: 指针字段作数组基判定需要 containing struct) */
        *中酉 = 字段尺寸(类型表[减构序].名, 函);
        *构序出 = 字段类型序(类型表[减构序].名, 函);
        若 (*构序出 < 0 && 字段位宽(类型表[减构序].名, 函) > 0) *构序出 = 减构序; /* bit-field: report the CONTAINING struct so callers can extract/store (fix 2026-08-05) */
        剩未(减构序, 函); /* fix 2026-08-19: 原只设 cg_mem_frow 不重置 cg_fdepth/cg_frows[] — 陈旧全局污染数组缩放 (dir->internal.exclude_list_group[i] 的 16 被前置 codegen 的 1/4/8 覆盖 → group 垃圾指针 → git status match_pathname 崩); st_field_2d_setup 设新鲜 cg_fdepth=0/cg_frows[0]=row/cg_frows[1]=el/cg_mem_frow=el */
        返 0;
    }
    返 -1;
}

