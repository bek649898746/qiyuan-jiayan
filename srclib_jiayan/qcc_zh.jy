        若 (!比较字符串(满退[计].名, 名)) { 满退[计].净申一[打印] = (字)邻辰; 返; }
    若 (虚己 >= 1024) 返;
    复制字符串(满退[虚己].名, 名);
    内存设置(满退[虚己].净申一, 0, 8);
