    变量表[变量数].型序标 = -1; 变量表[变量数].构尺寸 = 0; 变量表[变量数].数组尺寸 = 0; 变量表[变量数].数组元素尺寸 = 0;
    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0; 变量表[变量数].指元素尺寸 = 指元素; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = 0; 变量表[变量数].是否浮标 = 0; 变量表[变量数].指浮 = 0; 变量表[变量数].是否字符标 = 0; 变量表[变量数].无符号标 = 0; 变量表[变量数].是否静态标 = 0;
    变量表[变量数].变可空.tag = (变可空待 ? 可空值_无值 : 可空值_有值); 变可空待 = 0; /* H1 (2026-09-06): 可空指针落位 */
    就绪未标(数); /* D12R452 (D-12b ①): 变偏指 原缺 本条（变量偏移/变构/余乙/变浮 皆有）⟹ 指针 从未进 守卫表 */
    若 (序集 && 数[0] != '_') { 尾登记(数, 净丙, 变量数); } /* D12R452 (D-12b ①): 读侧 A4001 区 被 `尾系()` 整体门住 ⟹ 必须登记; **带 `序集` 守卫** —— 与 `变量偏移`/`变构` 同纪律 (A4001 只查用户代码 `主` 之后); prelude 的 `qcc_snprintf` (`va_list ap; va_start(ap,fmt);` → `((ap) = …)`) 在 `主` 前 ⟹ 不登记 ⟹ 免 假阳 (闸 `feat_zh_prelude_regmatch_ok.c` 实证) */
