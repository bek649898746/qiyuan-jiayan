                码生成(子0[数]); 断; }
            整 素又一 = 节型表[子0[数]];
            若 (取环境("QCC_DBG_NS")) { 字 *副寅 = (字*)(节名表 + 子0[数]); 输出到文件(错误流, "[AMP2] nt0=%d base='%s' basent=%d nv=%d\n", 素又一, 副寅, (子0[数] >= 0 && 子0[子0[数]] >= 0) ? 节型表[子0[子0[数]]] : -1, 节值表[子0[数]]); } /* 暂存 diag */
            若 (素又一 == 13 || 素又一 == 15) { /* &b.计数 */
