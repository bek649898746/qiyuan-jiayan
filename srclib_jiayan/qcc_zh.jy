静 无 字 *码;    /* ????????? */
静 无 字 上子[256]; 静 整 容重一 = 0; /* -左退一: __asm_byte 前缀 (Multiboot2 头), 修复 2026-08-08 */
静 整 码位;             /* 码位=?????? */
静 整 初成;                 /* ????????*/
静 整 长复;          /* 函数 尾声 */
静 整 帧戊;          /* 中断 jump 目标 */
静 整 主重 = -1;    /* 继续 jump 目标 (最内 循环) */
/* 该 加载器 parks 该 主-线程 栈 右 以上 该 image's 已提交
   节 �?之内 该 80兆字节 .数据 虚拟 范围 (栈 ~VA 4.8-5.8兆字节, .数据
   基 4.53兆字节). 静态 写入 在 那 范围 将 损坏 live 栈 frames
   (rbp 高 符弊 -> 段错误). 此 填充 移位 每 已写 静态/堆 槽位
   以上 ~5.9兆字节 故 nothing overlaps 该 栈. */
__attribute__((原粗))
静 字 标重[半九];
静 字 *串表[65536]; /* 修复 2026-08-27 步七 (短进.2 §二B): 串表 分块动态化 — 原 [32768][12288] 静态二维 (384兆字节 BSS) 撞 可执行格式 映像 2旁败 段上限不可再扩; 改指针数组 + 字符串竞技场 堆块链 (每槽 12288, 块满开新块), BSS 384兆字节→512素繁, 2旁败 天花板彻底摘除. 每槽上限 12286 语义不变. 历史: 512→2048 槽 (2026-08-06); 每槽 2048→8192 (2026-08-13); 32768 槽 (2026-08-26 数据库); 每槽 8192→12288 (2026-08-26 解析器) */ 整 串数;
静 整 邻拾[65536]; /* 首重 偏移 遍 每 字符串 (已声明 早 遍 码生成 串词 例) (修复 2026-08-11: 串表 2048 时镜像 1090 字符串 > 1024 → 同步扩容; 2026-08-26 数据库: 2048→32768; 2026-08-27 步七: 32768→65536 配套指针数组) */
静 字 *中分[128]; 静 整 实劣; 静 字 *毛未, *净细; /* 串表 槽堆块链 (类 函数竞技场): 块 16兆字节 永不移动, 槽指针永有效 (修复 2026-08-27 步七) */
静 字 *短六(空) { /* 从块链切一个 12288 槽 (串表 分块分配, 步七) */
    若 (!实劣) {
        中分[0] = 内存分配(16 << 20);
        若 (!中分[0]) { 输出到文件(错误流, "[ERR] 内存不足 字符串竞技场\n"); 退出(1); }
        毛未 = 中分[0];
        净细 = 中分[0] + (16 << 20);
        实劣 = 1;
    }
    若 (毛未 + 12288 > 净细) {
        若 (实劣 >= 128) { 输出到文件(错误流, "[ERR] 字符串竞技场 块 溢出\n"); 退出(1); }
        中分[实劣] = 内存分配(16 << 20);
        若 (!中分[实劣]) { 输出到文件(错误流, "[ERR] 内存不足 字符串竞技场\n"); 退出(1); }
        毛未 = 中分[实劣];
        净细 = 毛未 + (16 << 20);
        实劣++;
    }
    字 *结 = 毛未; 毛未 += 12288;
    返 结;
}
判别 可空值 于 { 有值, 无值 }; /* H2a (2026-09-06): 可空 判别化 (变量表.变可空 int → 判别 可空值) — 有值=非可空/有值, 无值=可空/可能空 (变体名 加 值 后缀防关键字改写: 有/无 是关键字) */
判别 初始化态 于 { 未初始, 已初始 }; /* I1a (2026-09-06): 明确初始化 判别化 (就绪未表 → 判别 初始化态) — 未初始=声明未初始化(默认0), 已初始=已赋值/形参移入 */
静 构 { 字 名[64]; 整 栈偏移, 素三, 栈又, 值丙, 宽系, 长酉, 型序标, 构尺寸, 数组尺寸, 数组元素尺寸, 指元素尺寸, 指深, 指内, 是否静态标, 是否浮标; 字 指浮, 是否字符标, 是否短标, 无符号标, 是否长标, 深成, 单标, 指单; 整 域行数[4]; 整 内薄, 旧零; 整 元列, 首贰; 整 双伍; 构 可空值 变可空; 构 可空值 窄化旧; /* R392 (C1-3 第二刀): 窄化栈 的「旧可空态」归位到变量 (原 窄化表[16]{名,旧} 独立表 退役) */ 构 初始化态 就绪态; 整 可空值标; 整 就绪全, 就绪位, 就绪位二, 就绪数, 就绪路数, 就绪丙; /* 第0刀: 就绪位二 = 字段级 位图 高 32 位 (位序 31..61; 原 单字 只 31 字段 → 41 字段结构体 落 保守分支 假报 A4001) */ 整 就绪阵, 就绪阵丙; 字 就绪路[4][48]; } 变量表[65536]; /* A3-4b (2026-09-12): 就绪阵=结构体值数组 元素 touched 位图 (31位; -1=动态降不追踪) 就绪阵丙=0未登记/净丙+1已登记 (尾阵/尾阵元/尾阵基/尾阵深/尾阵数 5 平行数组 真结构化 并入 变量表) */ /* A3-4a (2026-09-12): 就绪全=可见字段数(0粗粒度/标量) 就绪位=31位字段位图 就绪数=已写字段计数 就绪路=嵌套已写路径 就绪路数=路径数 就绪丙=0未登记/净丙+1已登记 (尾进/尾基/整丙二/顺汇/尾全/尾数二/尾位/尾路/尾路数 9 平行数组 真结构化 并入 变量表) */ /* S2b-1 (2026-09-09): 可空值类型 8B 打包槽 持久标记 */ /* R4a-4: +指单 — 指向 单精度 float 的指针 (解引用 movss 4B) */ /* 修复 2026-08-29 生成器: +深成 — 有符号 字符 变量 (符号扩展 符号扩展读; 编译器 约定 字符=无符号 零扩展, 有符号 字符 须显式符号扩展) */ /* 修复 2026-08-26 步三十: +元列/首贰 — 局部 _Alignas(>16) 数组: 元列=对齐需求, 首贰=候选区基址 栈偏移 (地址槽存运行时对齐后的地址); 修复 2026-08-26 步三十一: +双伍 — 变长数组 变长数组: 维度表达式 抽象语法树 节点 (声明处 码生成 求值动态 减 rsp, 基址存地址槽, 元列=1 标记间接访问); 修复 2026-08-25 缺陷#31b: +是否短标 字段 (uint16_t/短整 变量 2 字节槽读写, t43); 修复 2026-08-14: 4096→16384 — 修订.c/序列器.c 大文件变量数超 4000 (头部静态 内联 函数累积); 指深/指内 (修复 2026-08-18): 指针层级 + 基类型元素大小 — (*X)[i] 外层缩放/解引用宽度 (字符** 参数 指元素尺寸=8 但元素 1, 原按 8 缩放 → 配置 写坏); 内薄/旧零 (修复 2026-08-19): 声明所在块的 变量 范围 — 码生成器 作用域判定: 嵌套块同名变量 (常量 字符 *gitdir 遮蔽 结构体 strbuf gitdir) 只在其块内可见, 防止遮蔽外层 结构体 变量 */
静 字 静态关键[65536]; /* 修复 2026-08-06: 函数内 静态 变量 (保存 等) → scl=3 局部符号, 多 .o 头库不冲突 */
静 字 逆酉[65536]; /* 文件级 静态 全局 → scl=3 (修复 2026-08-14: khash.h __ac_HASH_* 重复符号) */
静 整 变量指基[65536]; /* A22 (2026-09-11): 变量 所指 基类码+1 (0=未登记) — 声明期 精确 记录 指针 所指 基类 (空 指针/函数指/无符号 指针 等 元数据 派生 判 不 出 的 情形); 索引 = 变量表 条目; 码 = 基类 (0整/1字/2短/3长/4双/5无符号/7构/8空/9函数指) + 16*指针层级 */
整 变量数; /* 是否长标: 长整 长整 (8-字节 整数) 变量 (修复 2026-08-05) */
静 整 静态数 = 0; /* 静态 变量: 槽位 在 .数据 之后 该 8-字节 堆 计数器 */
/* 二-通过 代 状态 (文件 作用域) */
静 整 隔伍一, 净成, 现降一, 下集一;
静 整 副丑 = -1; /* 解析 根节点索引: 接子 子节点硬上限豁免 (修复 2026-08-18 — 根子槽 256, 函数>256 由 函数定义表 保留, 根子节点从未被读, 溢出无害) */
静 整 *顺分[256]; /* 扩展子槽 n256..n511 — 大型函数体 > 256 语句时原静默丢弃尾部语句 → 编译产物缺语义 (修复 2026-08-18: 乙层补丁硬上限暴露; 版本库 序列器.c 等大函数体被截断) */
静 整 *节链; /* 块节点溢出链: 512 子槽满 → 新块节点挂这里 (修复 2026-08-18: 版本库 大函数体 > 512 语句, 静态扩容不够 → 无界链式) */
静 整 函数定义表[1024]; 静 整 函数定义数; /* 顶层函数定义节点列表 (修复 2026-08-06: 根节点 子0..后拾 只容 256 个子 → 第 257 个函数 (主) 被 接子 静默丢弃 → 编译产物无 主 崩; 自举文件恰满 256) */
静 整 号平[1024]; 静 整 新散 = 0; /* 接入 2026-08-28 可吞清单 阶段一 (语义导航): 函数定义行号 (函数定义 名 词元 的 词行表, 与 函数定义表 平行) — 甲序 读代码定位用, 甲言化: --导航 */
静 整 最终生成 = 0; /* 1 仅 于 该 末 生成码 通过: 门 -S 汇编 文本 故 该 .汇编 文件 持有 一 拷贝 (修复 2026-08-05: 迭代 re-运行 生成码 → 重复 代码 + broken 标号一 resolution) */
静 整 顺高一; /* .文本 偏移 的 该 mini-运行库 入口 半未 (通过 2 值) */
静 整 新寅[65536], 总甲[65536], 单粗; /* 每-函数 变量 索引 ranges (解析 顺序 == gen 顺序) — 512→8192 (修复 2026-08-26 数据库: sqlite3.c 数千函数) */
静 整 段进[65536], 反细[65536]; /* 每-函数 栈用量 边界 于 解析 (精确 帧 footprint) */
静 整 剩回; /* 当前 函数 索引 期间 生成码 */
静 整 净乙 = 0; /* 变量-搜索 边界: 变量数 期间 解析, 总甲[剩回] 期间 码生成器 */
静 整 解析基 = 0; /* 变量-搜索 下限 期间 解析: 新寅[单粗] 之内 a 函数 函数体, 否则 0.
                              Prevents a 函数体-局部 声明 (e.g. 码生成's `整数 函`) 自 reusing a 相同-命名
                              变量/参数 已登记 由 一 UNRELATED 函数 (哪 将 leave 该
                              局部 未登记 此处 且 let 码生成器 回落 回 到 a `字符 函[64]`
                              数组 自 另一 函数 -> 取址 的 其 own 地址). */
静 整 码生成免解引用 = 0;
静 整 初壹 = 0;
静 整 正五 = 0; /* 例 11 &取地址时置位: 例 15 “指针字段作数组基”解引用应跳过 (否则 &p->缓 取地址多解引用, 修复 2026-08-18) */ /* 例 23/26 求 ++/-- 目标地址时置位: 例 15 “指针字段作数组基”解引用应跳过 (否则 size_t 字段 主酉->长度++ 被误解引用, 修复 2026-08-18) */ /* 例 14: 跳过 该 最终 解引用 (嵌套-存储 基 地址) */
静 整 长卯 = 0; /* 例 15: 行 尺寸 的 该 末 静态-结构体 数组 成员 读取 (2D 字段: 正辰[序标]) */
静 整 虚叁 = 0; /* 例 14: 数组元素 有符号 标记 — 1=有符号 字符, 2=有符号 短整; 嵌套 解引用 选 符号扩展 (修复 2026-08-29 生成器) */
静 整 右亥 = 0; /* 例 14: 数组元素 无符号 标记 — 嵌套 解引用 后 节无符号[n] (修复 2026-08-29 生成器: s175) */
静 整 码生成内存浮 = 0;  /* 例 14/15 嵌套: 末 数组/成员 基 是 a 双精度 数组 → 外层 [i] 加载 uses 双精度移动 */
静 整 码生成内存单 = 0;  /* R4a-6: 例 14 嵌套: 基 是 单精度(float 单标) 数组 → 外层 [i] 加载 uses movss+cvt */
静 整 码生成内存指 = 0;  /* 例 14 嵌套: 末属 [i] 已返回 该 地址 的 一 8-字节 指针 槽位 (整数 *首重[4]) — 外层 [j] 必须 加载 该 指针 首 (修复 2026-08-16: 空伴 首重[帧三][满分] 存储 wrote 到 该 帧 槽位 而 的 该 内重) */
静 整 整回 = -1; /* 内存地址: 嵌套链 (a->b->c) 最终字段所在结构体索引 — 例-15 指针字段作数组基判定用 (修复 2026-08-18: 迭代->映射->表[i] 嵌套链原只在简单箭头分支解引用, 嵌套链 不引用 返回字段地址 → 索引进结构体内部, hashmap_iter_next 崩) */
静 整 计双 = 0; /* 例 14: 嵌套 基 递归深度 — 内层下标被外层继续索引时 >0 (修复 2026-08-22 t41b: 指针字段双指针双层下标 板[i][j] — 内层 解引用 条件 & 外层 码生成内存指 判定) */
静 整 容戊 = 0; /* 例 15: 指针字段作数组基解引用后 — 内层 例 14 的索引结果 &板[i] 是槽地址, 有外层下标时需设 码生成内存指 供外层解引用 (修复 2026-08-22 t41b) */
静 整 旁得 = 0;  /* 码生成器: 上 变量-索引 边界 的 该 当前 块 (0 之前 首 函数). Later 兄弟-块 局部 是 excluded 故 `字符 名存[9]` 在 一 早 循环 函数体 isn't shadowed 由 a later `常量 字符 *名存` (修复 2026-08-16 空伴 内存设置 目标=8) */
静 整 值序 = 0; /* 码生成器: 下 变量-索引 边界 的 该 当前 块 (修复 2026-08-19: 嵌套块变量只在块内可见 — 见 变量码生成可见) */
静 整 中系 = 0;   /* multi-D 嵌套-数组 链 深度 (修复 2026-08-05) */
静 整 标拾 = 0; /* 最内 数组's 维度 计数 (解引用 仅 于 outermost) */
静 整 上薄[4];     /* 每-维度 行 尺寸, 集 由 该 最内 数组 变量 */
静 整 满伴 = 0; /* 1 循环 emitting 后凶 initializers 于 主 入口 (例-7 必须 非 跳过 它们) */
静 整 当前函数结构返 = 0;  /* 解析/码生成器: 当前 函数 返回 a >8B 结构体 由 值 (六十四位窗口 列败) */
静 整 列重 = -1; /* 变参 函: rbp-相对 地址 的 该 首 vararg 槽位; -1 = 非-变参 */
静 整 当前返回型序 = -1;  /* 码生成器: 当前 函数's 返回 结构体 类型 索引 (-1 = 非 结构体) */
静 整 码生成结构返偏移 = 0;  /* 例-4: rbp-相对 列败 目标 (取址 rcx) 遍 a 结构体-返回 调用; 0 = none */
静 整 码生成结构返静态 = 0; /* 修复 2026-08-30 生成器: 静态 结构体 列败 目标 — 例-4 rcx=&目标 用 指令指针 (静态 在 .数据, rbp 相对得垃圾 → s16 校验和 错) */
静 整 码生成结构返间接 = 0; /* G2b 补 (2026-09-11): 结构体-返回 调用 的 rcx 取 "本函数 已存 的 隐藏 返回指针" (sret 透传: 大结构体 错误载荷 直接转发 `返回 f()` 时 让 被调 直接 写 本函数 返回缓冲) */
静 整 结构返指偏移 = 0; /* 列败 函 前奏: 帧 槽位 那 保存 该 隐藏 返回 指针 (rcx) */
/* 汇编 文本 发射. 自身-宿主 修复 2026-08-03: 曾 varargs (va_list/vfprintf) 哪 该
   编译器 subset 不能 编译 → 自身-hosted -S 已发射 一 空 .汇编. 现在 已修 3-实参 带
   `字符 *` 参数 (8-字节 槽位) + 输出到文件: under 编译器 输出到文件 写入 该 汇编 文件; under
   编译器 该 内置 输出到文件 写入 输出流 (该 调用方 重定向). 该 `#定义 汇编 汇发`
   是 gone: 该 自身-宿主 词法器 寄存器 `#定义 名 数` 仅, 故 `#定义 汇编 汇发`
   静默 已登记 汇编=0 且 killed 每 调用 段次. 全 汇编( 调用 堆丑 是 现在
   汇发( directly; %d/%c 实参 arrive 作为 (字符*)(长整 长整)整数 (编译器- 且 编译器-legal,
   该 整数 值 幸存 在 该 低 符弊), %s 实参 通过 该 字符串 指针 直. */
静 FILE *汇编输出 = NULL;
静 整 汇编遍 = 0;
/* 汇编 文本 发射. 自身-宿主 完成 2026-08-03: 格式 入 a 栈 缓冲 带
   格式化到串 (编译器 内置) 则 写入 到 汇编输出 带 写入 (编译器 内置 uses 该 文件
   句柄) — 双 该 编译器 构建 且 该 自身-宿主 构建 写入 该 .汇编 文件 (无 输出流
   redirect 所需), 故 `编译器 -S 文件.c -o 文件.汇编` 工作 identically 在 双. %d 实参
   arrive 作为 (字符*)(长整 长整)整数 (该 整数 幸存 在 该 低 32 符弊), %s 实参 通过
   该 字符串 指针 直. */
静 空 汇发(常 字 *堆平, 字 *甲, 字 *发字节, 字 *字符) {
    若 (汇编输出 && 汇编遍 == 2 && 最终生成) {
        字 终亥[512];
        格式化到串(终亥, 堆平, 甲, 发字节, 字符);
        写入(终亥, 1, 取字长(终亥), 汇编输出);
    }
}
/* 单精度-实参 汇编 文本 (%.1f 的 a 双精度 字面量) — 相同 格式化到串+写入 路径. */
静 空 汇发浮(常 字 *堆平, 双 值) {
    若 (汇编输出 && 汇编遍 == 2 && 最终生成) {
        字 终亥[512];
        格式化到串(终亥, 堆平, 值);
        写入(终亥, 1, 取字长(终亥), 汇编输出);
    }
}
静 整 变量总数(空) { 返 净乙 ? 净乙 : 变量数; } /* 曾 #定义 变量总数() �?a #定义 将 寄存器 作为 a 词法器 宏 且 substitute 0! */
/* 简单 #定义 名 值 终复 (常量 numbers) */
静 构 { 字 名[64]; 整 数值; } 终复[4096]; 静 整 宏数; /* Phase1-L3: 64->1024 */
静 字 长十一[4096]; 静 字 内汇[4096]; 静 整 整酉[4096]; /* 数值宏 剩进一/U 后缀标志 — #定义 UINTMAX_MAX ...剩进一 展开必须保留 无符号 长整 长整 (修复 2026-08-15) */
静 空 原得(常 字 *栈散, 整 容量) { 输出到文件(错误流, "[ERR] A5001 资源护栏: 表 '%s' 满 (容量 %d), 编译确定性拒绝 — 请扩容对应容量宏 (可吞清单 阶段零-9b, 甲序原生 #9b)\n", 栈散, 容量); 退出(1); } /* 接入 2026-08-28 资源护栏: 超限走确定性降级 — 替代静默丢弃/满员返-1 (历史教训: 数据库 对象宏 2048 静默丢 → 解析 断链; 镜像 函数数 静默残留 → 外部 报错) */
静 整 解析深 = 0; /* 资源护栏 9b (2026-08-28): 表达式/块递归深度 — 防深嵌套栈溢出 0xC0000005, 超限 A5001 确定性拒绝 */
静 空 外零(常 字 *数, 整 值, 整 长属, 整 邻辰, 整 余贰) { 遍 (整 计 = 0; 计 < 宏数; 计++) 若 (!比较字符串(终复[计].名, 数)) { 终复[计].数值 = 值; 长十一[计] = (字)长属; 内汇[计] = (字)邻辰; 整酉[计] = 余贰; 返; } /* C72 (2026-09-17): 同名覆盖 (C 语义: 最后定义生效) — 原无查重 ⟹ 同名重复 #定义 产生两条 ⟹ #未定义 只删一条 ⟹ #若定义 仍判真 (d1/d2 最小复现); 与 符又一(对象宏表) 同款 */ 若 (宏数 < 4096) { 复制字符串(终复[宏数].名, 数); 终复[宏数].数值 = 值; 长十一[宏数] = (字)长属; 内汇[宏数] = (字)邻辰; 整酉[宏数] = 余贰; 宏数++; } 否 原得("宏表 终复", 4096); } /* 修复 2026-08-15: 上限 1024→4096 对齐数组容量 — fsmonitor--daemon.c 头链数值宏超 1024, SIMPLE_IPC_QUIT 被丢 → 未定义; 2026-08-28 资源护栏: 满→确定性拒绝 (原静默丢弃) */
静 空 宏加(常 字 *数, 整 值) { 外零(数, 值, 0, 0, 0); }
/* P0-3 命令行宏 通道 (2026-09-14 根治, 启元审计): -D 名=值 的语义 = 源码首行 #定义 名 值。
   原实现 是在 main 参数解析 处 直接 宏加() 写 数值宏表 —— 双重缺陷:
     ① 现退一() 首句 终子() 把 宏数 清零 (可重入复位) ⟹ 命令行 宏 原地蒸发 (08-28 修 QCC_RT_PREPENDED 时 只 挪了
        运行时拼接 的时序, 没看见 -D 走的是同一条 提前设 → 被复位清 的路);
     ② 数值宏表 只供 #if 预处求值 (域零), 不参与 源码文本替换 (满八) ⟹ 代码里的 FOO 不展开。
   实测 (seed 79E3AC71): -D FOO=42 下 #ifdef FOO 判假 / #if FOO==42 判假 / 代码内 FOO 报 A1001 未声明标识符;
   gcc 对照 三处 全真。又: 除 分离形 -D FOO=42 外, 紧凑形 -DFOO=42 (GCC 惯例) 原 被当 输入文件 → 无法打开 -DFOO=42。
   根治: 命令行 宏 只 暂存 名/值 文本 (不写 任何 宏表), 于 终子() 复位 之后 拼成 #define 行 前插 源 ——
   与 源码 #定义 共用 行申() 收集 + 净集() 展开 同一条 路径, 零 新增 语义 分支 (本项目 头号 缺陷模式 的反面)。
   ⚠️ 命宏数 不参与 终子() 复位 —— 它是 命令行输入, 跨 复位 持久 (同 argv); --重复 多次编译 每次 重新 前插。 */
静 字 命宏名[512][64]; 静 字 命宏值[512][4096]; 静 整 命宏数; /* 容量 512: 命令行 宏 数量级 远小于 源内 宏表 4096; 值 4096 对齐 对象宏 满八.数值 宽度 */
静 空 命宏加(常 字 *名, 常 字 *值) {
    若 (命宏数 >= 512) 原得("命令行宏表 命宏", 512);
    复制字符串(命宏名[命宏数], 名);
    拷贝前n(命宏值[命宏数], 值, 4095); 命宏值[命宏数][4095] = 0;
    命宏数++;
}
静 字 *命宏前插(常 字 *源) { /* 命令行宏 → #define 行块 前插 (返回 新 缓冲; 命宏数 为 0 时 原样 返 源) */
    若 (命宏数 <= 0) 返 源;
    整 总长 = 0;
    遍 (整 计 = 0; 计 < 命宏数; 计++) 总长 += (整)取字长(命宏名[计]) + (整)取字长(命宏值[计]) + 16;
    整 源长 = (整)取字长(源);
    字 *出 = 内存分配((总长 + 源长 + 8) & ~3);
    整 丙 = 0;
    遍 (整 计 = 0; 计 < 命宏数; 计++) {
        复制内存(出 + 丙, "#define ", 8); 丙 += 8; /* 用 ASCII 指令词 (#define) 而非 #定义: 字节数 7+1 确定, 免 中文 9 字节 计数 出错 */
        整 名长 = (整)取字长(命宏名[计]);
        复制内存(出 + 丙, 命宏名[计], 名长); 丙 += 名长;
        出[丙++] = ' ';
        整 值长 = (整)取字长(命宏值[计]);
        复制内存(出 + 丙, 命宏值[计], 值长); 丙 += 值长;
        出[丙++] = '\n';
    }
    复制内存(出 + 丙, 源, 源长); 丙 += 源长;
    出[丙] = 0;
    返 出;
}
静 整 域零(常 字 *数) { 遍 (整 计 = 0; 计 < 宏数; 计++) 若 (!比较字符串(终复[计].名, 数)) 返 终复[计].数值; 返 -1; }
/* 对象宏: #定义 A <表达式/标识符> → 文本层展开 (修复 2026-08-13: 版本库 哈希-邻辰.h 大量 TAB 别名/对象宏) */
静 构 { 字 名[64]; 字 数值[4096]; } 满八[8192]; 静 整 栈凶; /* 修复 2026-08-15: 名 32→64 + 数值 512→4096 — 长宏名/长宏体 (FIND_BISECTION_FIRST_PARENT_ONLY / REBASE_OPTIONS_INIT) */
