                    汇发("    加 r0, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x83); 模字节(3,0,0); 发字节(8); /* 数据区 */
                }
            } 否 若 (!比较字符串(串升, "malloc")) {
