    整 判载起 = 判载数; /* 本类型载荷项起点 (变载/判载名 全局序) */
    整 判载序 = -1; /* 荷布 判别序 (间繁 后 = 链平-1) */
    遍 (整 判载a = 0; 判载a < 变节; 判载a++) {
