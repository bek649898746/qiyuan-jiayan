        循环 (基 >= 0 && 节型别[基] == 节点_下标 && 钻深 < 8) { 基 = 子0[基]; 钻深++; }
        若 (基 >= 0 && 节型别[基] == 节点_变量) {
            字 *名 = (字*)(节名表 + 基);
            若 (浮名(名)) 节浮标[节] = 1; 否 若 (长名(名)) 节长标[节] = 1; /* 第 162 站: 接入 长整 原子判据 */ /* C144 (2026-09-19 第 134 站): 8 字节 整数 数组 元素 —— 糖 建 的 下标读 节点 原 只 被 补 浮标; 长整 数组 的 糖 (求和/均值/排序/反转) 元素 读 缺 节长标 ⟹ 32 位 截断 (实测 均值 2500000000000 -> 329033728). 镜像 浮 分支; 长整 数组名 的 是否长标 已 由 声明 登记 (L10023/L10034/L10178), 长整指针 由 A22 基类码 3 (变量基登 返 4). */
