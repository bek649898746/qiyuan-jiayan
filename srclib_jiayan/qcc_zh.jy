                        若 (体[发字节] == '#' && 体[发字节 + 1] == '#') { /* ## 拼接: 去尾空 + 跳过 ## 及后随空白 (修复 2026-08-07) */
                            循环 (词序二 > 0 && (暂存[词序二 - 1] == ' ' || 暂存[词序二 - 1] == '\t')) 词序二--;
                            发字节 += 2;
                            循环 (体[发字节] == ' ' || 体[发字节] == '\t') 发字节++;
