        { 整 变乙 = 建节(1); 复制内存((字*)(节名表 + 变乙), 跳名, 32);
          整 零 = 建节(0); 节值表[零] = 0; 整 赋节 = 建节(10); 接子(赋节, 变乙); 接子(赋节, 零); 接子(块节序, 赋节); } /* __md_j = 0; */
        整 计浅 = 建节(9);
