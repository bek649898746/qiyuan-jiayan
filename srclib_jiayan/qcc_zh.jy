          整 邻壬 = 建节(2); 节值表[邻壬] = 旧肆; 接子(邻壬, 变右); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(邻壬, 壹节); }
          整 赋节 = 建节(10); 接子(赋节, 变右); 接子(赋节, 邻壬);
