                    中发(主合, 0, 0, 0); 中刷(); /* Phase3-IR case10 */
                    中发(正散, 0, 0, 0); 中刷(); /* Phase3-IR case10 */
                    若 (变量指浮(变节)) { 弹浮0(); 中发(栈丁, 0, 0, 0); 中刷(); } /* Phase3-IR case10 */
                    否 若(满寅==1){ 中发(整集, 0, 0, 0); 中刷(); } /* Phase3-IR case10 */
                    否 若(满寅==2){ 中发(旁辰, 0, 0, 0); 中刷(); } /* Phase3-IR case10 */
                    否{ 中发(前序, 0, 0, 0); 中刷(); } /* Phase3-IR case10 */
                    移寄存器(0, 3); /* eax = stored value (chained assignments) */
                }
            } /* end struct-array-element else (fix 2026-08-06) */
            } 否 若 (节型表[子0[数]] == 12) { /* *ptr = expr — store by pointer element width (char*→1B, int*→4B, fnptr→8B, double*→movsd) */
                整 指节 = 子0[子0[数]];
                整 容分 = 指节;
                整 半再一 = 4;
                整 主复一 = -1;
                字 *总列 = NULL;
                若 (容分 >= 0) { /* fix 2026-08-16 根因I: pbase>=0 守卫 — parse 失败时 deref 缺操作数 n0=-1, 原直接读 nt[-1] 越界崩 shell.c */
                若 (节型表[容分] == 23 || 节型表[容分] == 26) 容分 = 子0[容分]; /* *p++ / *++p / *p--: resolve through inc/dec for the WIDTH only; cg(pnode) below must keep the inc/dec side effect (fix 2026-08-16: char* d++ store was 32-bit → in-place normalize truncates) */
                若 (节型表[容分] == 1) { 半再一 = 变量元素((字*)(节名表 + 容分)); 主复一 = 变量型序((字*)(节名表 + 容分)); 总列 = (字*)(节名表 + 容分); }
                否 若 (节型表[容分] == 12) { /* **X / ***X 链写: 解引用宽度按剩余层级 — fix 2026-08-30 csmith s9: (**g_462)=expr (**g_462 = *g_463 = g_464[2] uint8_t) 原 pe=4 默认 → dword store 覆盖 g_464[2][3][4][5] (镜像 case-12 读侧 L19090 层级算法) */
                    整 深 = 1, 寻 = 容分;
                    循环 (寻 >= 0 && 节型表[寻] == 12) { 深++; 寻 = 子0[寻]; 若 (寻 >= 0 && (节型表[寻] == 23 || 节型表[寻] == 26)) 寻 = 子0[寻]; }
                    若 (寻 >= 0 && 节型表[寻] == 1) {
                        整 元 = 变量指深((字*)(节名表 + 寻));
                        若 (元 > 深) 半再一 = 8; 否 若 (元 == 深) 半再一 = 正己((字*)(节名表 + 寻)); 否 半再一 = 1;
                    }
