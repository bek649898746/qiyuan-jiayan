                    汇发("    乘 r10, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,2,0,0); 发字节(0x0F); 发字节(0xAF); 模字节(3,2,2); /* 乘 r10d, edx */
                    汇发("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,1,0,1); 发字节(0x01); 模字节(3,2,3); /* 加 r11d, r10d (扩展前缀.R=1: 寄存器=r10) */
