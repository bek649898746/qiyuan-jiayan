                            循环 (判字母数字((无 字)体[发字节]) || 体[发字节] == '_' || (无 字)体[发字节] >= 0x80) { 若 (外伴 < 63) 直辛[外伴++] = 体[发字节]; 发字节++; } /* #72: 中文参数名体替换 */
                            直辛[外伴] = 0;
                            整 首组 = -1;
                            遍 (整 满列 = 0; 满列 < 函数宏表[素散].参数数; 满列++) 若 (!比较字符串(函数宏表[素散].容败[满列], 直辛)) { 首组 = 满列; 断; }
                            若 (首组 >= 0 && 首组 < 匿数) {
                                若 (词序二 < 16382) 暂存[词序二++] = '"';
                                整 va_end = !比较字符串(直辛, "__VA_ARGS__") ? 匿数 : 首组 + 1; /* 修复 2026-08-14: 只有 #__VA_ARGS__ 才逗号连接余参, 普通 #参数 只字符串化一个参数 (原 #dll 把所有参数连接 → "secur32.dll, 布尔, ..." 错) */
                                遍 (整 甲序 = 首组; 甲序 < va_end && 词序二 < 16380; 甲序++) {
                                    若 (甲序 > 首组) { 暂存[词序二++] = ','; 若 (词序二 < 16381) 暂存[词序二++] = ' '; }
                                    常 字 *源 = 段吉 + 甲序 * 4096;
                                    整 反五 = 0, 缓甲 = 0;
                                    循环 (源[反五] && (源[反五] == ' ' || 源[反五] == '\t')) 反五++; /* 去首空白 */
                                    整 槽长 = 0; 循环 (源[反五 + 槽长]) 槽长++; 循环 (槽长 > 0 && (源[反五 + 槽长 - 1] == ' ' || 源[反五 + 槽长 - 1] == '\t')) 槽长--; /* 去尾空白 */
                                    遍 (整 键 = 反五; 键 < 反五 + 槽长 && 词序二 < 16380; 键++) {
                                        若 ((源[键] == ' ' || 源[键] == '\t') && 缓甲) 续; /* 内部连续空白 → 单空格 */
                                        缓甲 = (源[键] == ' ' || 源[键] == '\t');
                                        若 (源[键] == '\\' || 源[键] == '"') { 若 (词序二 < 16380) 暂存[词序二++] = '\\'; } /* 转义 \ 与 " */
                                        暂存[词序二++] = 源[键];
                                    }
                                }
                                若 (词序二 < 16382) 暂存[词序二++] = '"';
                            } 否 { /* 非参数: 原样输出 # + 名字 (畸形宏, 不崩) */
                                若 (词序二 < 16382) 暂存[词序二++] = '#';
                                遍 (整 键 = 0; 键 < 外伴 && 词序二 < 16382; 键++) 暂存[词序二++] = 直辛[键];
                            }
                            续;
                        }
                        若 (判字母数字((无 字)体[发字节]) || 体[发字节] == '_' || (无 字)体[发字节] >= 0x80) { /* #72: 中文参数名 */
                            字 直辛[64]; 整 外伴 = 0;
                            循环 (判字母数字((无 字)体[发字节]) || 体[发字节] == '_' || (无 字)体[发字节] >= 0x80) { 若 (外伴 < 63) 直辛[外伴++] = 体[发字节]; 发字节++; } /* #72: 中文参数名体替换 */
                            直辛[外伴] = 0;
                            整 首组 = -1;
                            遍 (整 满列 = 0; 满列 < 函数宏表[素散].参数数; 满列++) 若 (!比较字符串(函数宏表[素散].容败[满列], 直辛)) { 首组 = 满列; 断; }
                            若 (首组 >= 0 && (!比较字符串(直辛, "__VA_ARGS__") || (变参名[素散][0] && !比较字符串(函数宏表[素散].容败[首组], 变参名[素散])))) { /* 变参: 余参逗号连接 (C宏 __VA_ARGS__ / 阶段C-1 #72 泛型变参, 2026-09-01) */
                                遍 (整 甲序 = 首组; 甲序 < 匿数 && 词序二 < 16380; 甲序++) {
                                    若 (甲序 > 首组) { 暂存[词序二++] = ','; 若 (词序二 < 16381) 暂存[词序二++] = ' '; }
                                    遍 (整 键 = 0; 新回[甲序 * 4096 + 键] && 词序二 < 16380; 键++) 暂存[词序二++] = 新回[甲序 * 4096 + 键];
                                }
                            } 否 若 (首组 >= 0 && 首组 < 匿数) {
                                遍 (整 键 = 0; 新回[首组 * 4096 + 键] && 词序二 < 16380; 键++) 暂存[词序二++] = 新回[首组 * 4096 + 键];
                            } 否 {
                                遍 (整 键 = 0; 键 < 外伴 && 词序二 < 16382; 键++) 暂存[词序二++] = 直辛[键];
                            }
                        } 否 {
                            若 (词序二 < 16382) 暂存[词序二++] = 体[发字节++];
                        }
                    }
                    若 (函数宏表[素散].约束[0] && 匿数 >= 1) { 若 (词序二 < 16382) 暂存[词序二++] = ')'; } /* 阶段C-1 #45: 逗号表达式前缀闭合 — (__受约束(接口, 实参), 体) */
                }
                暂存[词序二] = 0;
                
                直亥(存轮); /* 修复 2026-08-26: 实参/新回 已用完 (暂存 已构建), 递归前释放 — 内层复用同一区域, 栈只留 暂存/高分 */
                副组(暂存, 出指, 丙, 容量, 素散); /* recurse: 函数体 可能 contain 嵌套 宏 调用 */
