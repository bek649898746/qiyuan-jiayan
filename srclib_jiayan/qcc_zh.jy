                { 整 深进一 = 0; 遍 (整 计 = 0; 计 < 匿数; 计++) 若 (副双[计] >= 0) { 深进一 = 1; 断; }
                  若 (深进一 && 节型别[被调者] == 节点_变量) { 整 己序 = 存陆((字*)(节名表 + 被调者)); 整 参数数 = (己序 >= 0) ? 度伍[己序].参数数 : 0;
                    若 (参数数 > 0) { 整 列细[256]; 遍 (整 计 = 0; 计 < 256; 计++) 列细[计] = -1; 整 成功 = 1;
                        遍 (整 计 = 0; 计 < 匿数 && 成功; 计++) { 整 指 = 副双[计];
                            若 (指 >= 0) { 若 (指 >= 参数数 || 列细[指] >= 0) { 成功 = 0; 断; } 列细[指] = 参数个数[计]; }
                            否 { 整 寻 = 0; 循环 (寻 < 参数数 && 列细[寻] >= 0) 寻++; 若 (寻 >= 参数数) { 成功 = 0; 断; } 列细[寻] = 参数个数[计]; } }
                        若 (成功) { 遍 (整 乙 = 0; 乙 < 参数数; 乙++) { 整 短次; 若 (列细[乙] >= 0) 短次 = 列细[乙]; 否 { 短次 = 建节(0); 节值表[短次] = 0; } 接子(字符, 短次); } }
                        否 { 遍 (整 计 = 0; 计 < 匿数; 计++) 接子(字符, 参数个数[计]); } }
                    否 { 遍 (整 计 = 0; 计 < 匿数; 计++) 接子(字符, 参数个数[计]); } }
                  否 { 遍 (整 计 = 0; 计 < 匿数; 计++) 接子(字符, 参数个数[计]); } }
                接子(字符, 底); 底 = 字符; { 整 名降 = 查函数((字*)(节名表 + 被调者)); 若 (名降 >= 0) 实重[字符].码 = 函数表[名降].返错码; } 若 (节型别[被调者] == 节点_变量 && (下组((字*)(节名表 + 被调者)) || 预扫错误函((字*)(节名表 + 被调者)))) { 实重[字符].tag = 结果_错; } /* R305: 补 后置定义 错误函数 (预扫 名字回查; helper 见 错待消 旁) */ /* 载荷化 (2026-09-07): 返错码 无条件传 (返错码由 错 N 设, 不依赖 下组=返错 预扫描 多错误函数缺陷) */ /* 载荷化 (2026-09-07): 错误码 传到调用点 */ /* 类型-根-9 #211: 闭包 调用 - 若 被调者 是 闭包 名, 替换 带 函(封顶..., 实参) */ /* 2026-08-28 类型-根-2 */ /* 修复 2026-08-07: 词终 防 文件尾 死循环 + 进度守卫防 赋值级() 不前进 (缺 ) 或非法参数) */
                { /* 编译期常量前置审判 (2026-08-28 可吞清单 阶段一, 兑现"证明器查"): 调用点参数全常量 → 折叠评估 前置 → 违反编译期报错 A6002 (不等运行时 中止) */
                    若 (节型别[被调者] == 节点_变量 && 匿数 <= 32) {
                        整 净九 = 0; 遍 (整 串申 = 0; 串申 < 匿数; 串申++) 若 (副双[串申] >= 0) { 净九 = 1; 断; }
                        若 (!净九) {
                            整 上四 = 中柒((字*)(节名表 + 被调者));
                            若 (上四 >= 0 && 段分[上四].存集 >= 0) {
                                整 反凶 = 存陆((字*)(节名表 + 被调者)); 整 参数数 = (反凶 >= 0) ? 度伍[反凶].参数数 : 0;
                                若 (参数数 >= 0 && 参数数 <= 32) {
                                    常 字 *副进[32]; 长 长 当壬[32]; 整 全陆 = 1;
                                    遍 (整 键 = 0; 键 < 32; 键++) { 副进[键] = (反凶 >= 0 && 键 < 参数数) ? 度伍[反凶].左组[键] : ""; 当壬[键] = 0; }
                                    遍 (整 键 = 0; 键 < 匿数 && 键 < 32 && 全陆; 键++) { 整 右玖一; 长 长 参值 = 目弊(参数个数[键], NULL, NULL, 0, &右玖一); 若 (!右玖一) { 全陆 = 0; 断; } 若 (键 < 参数数) 当壬[键] = 参值; }
                                    若 (全陆) { 整 元浅; 长 长 副重 = 目弊(段分[上四].存集, 副进, 当壬, 参数数, &元浅);
                                        若 (元浅 && 副重 == 0) {
                                            字 初甲一[128]; 整 帧拆 = 0; 初甲一[0] = 0;
                                            遍 (整 键 = 0; 键 < 匿数 && 键 < 8; 键++) { 字 计八[40]; 格式化到串(计八, "%s%lld", 键 ? "," : "", 当壬[键]); 整 累加低 = (整)取字长(计八); 若 (帧拆 + 累加低 < 110) { 复制内存(初甲一 + 帧拆, 计八, 累加低); 帧拆 += 累加低; } }
                                            初甲一[帧拆] = 0;
