            } 否 若 (主布 && !顺一) { /* #expect <sha256>: 绝对断言, 编译完对账产物哈希 (Phase4) */
                常 字 *寻 = 指深度 + (*寻 == 'd' ? 6 : 9);
                循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                整 短丑 = 0;
                循环 ((*寻 >= '0' && *寻 <= '9') || (*寻 >= 'a' && *寻 <= 'f') || (*寻 >= 'A' && *寻 <= 'F')) { 若 (短丑 < 64) 宽布[短丑++] = *寻; 寻++; }
                宽布[短丑] = 0;
            } 否 若 (右附一 && !顺一) {
                常 字 *寻 = 指深度 + 7;
                循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                若 (*寻 != '"') {
                    /* <系统 头>: 尝试 半未/文件 首 (修复 2026-08-23 t35e:
                       <单八.h> 现在 解析 到 a 内置 custom 实现 经
                       元低; 非 已找到 -> 跳过, 自身-contained). */
                    字 串繁[512]; 整 实劣一 = 0;
                    常 字 *寻三 = 寻 + 1;
                    循环 (*寻三 && *寻三 != '>' && 实劣一 < 510) 串繁[实劣一++] = *寻三++;
                    串繁[实劣一] = 0;
                    字 *全戌一 = 实劣一 > 0 ? 元低(串繁) : 0;
                    若 (全戌一) {
                        字 行九[512]; 邻繁(串繁, 行九, 大小(行九));
                        字 标午[1024]; 标午[0] = 0;
                        若 (净厚 > 0 && 空七[净厚 - 1][0]) {
                            复制字符串(标午, 空七[净厚 - 1]);
                            若 (行九[0]) { 拼接(标午, "/"); 拼接(标午, 行九); }
                        } 否 { 复制字符串(标午, 行九); }
                        若 (净厚 < 16) { 复制字符串(空七[净厚], 标午); 净厚++; } 否 原得("包含目录栈 inc_dir", 16);
                        字 *容子一 = 缓卯(全戌一, 深度 + 1);
