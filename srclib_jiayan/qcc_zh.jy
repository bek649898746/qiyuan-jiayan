                        移寄存器帧64(10, 元平 - 当前帧大小); /* r10 = copy ptr (param slot holds the address) */
                    } 否 若 (短弊一) {
                        码生成免解引用 = 1; 码生成(字符); 码生成免解引用 = 0; /* rax = &h[i] (struct array element) */
                        移64(10, 0); /* r10 = &h[i] */
