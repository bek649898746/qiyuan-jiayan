    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "格式化")) { /* 接入 2026-08-27 字符串插值 (模板字符串): 格式化 "x={} y={}", x, y; → 格式化打印("x=%d y=%d", x, y); — {} 占位符按参数类型自动转格式符 (%d/%u/%f/%lld/%c/%s), 先解析参数收集类型再拼新格式串 */
        词位++; /* 格式化 */
        若 (词型表[词位] != 串词) { 整 终劣 = 建节(0); 节值表[终劣] = 0; 返 终劣; } /* 缺格式串: 空 */
        字 *堆二二 = 串表[词值表[词位]]; 词位++; /* 格式串字面量 */
        整 段吉[256]; 整 匿数 = 0; /* A45 (2026-09-12): 16 -> 256 — 原 匿数 < 16 静默 停止 收 实参, 而 格式串 仍 带 N 个 转换符 传 给 printf → 第 17 个 起 读 未传 槽 = 静默 错值 (实测 前 16 正确 / 后 全 0) */
        循环 (词型表[词位] == 逗号) { 词位++; 若 (匿数 >= 256) 原得("格式化 插值 实参", 256); 段吉[匿数++] = 赋值级(); } /* 逗号分隔参数 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        字 中列一[1024]; 整 名序 = 0; 整 甲序 = 0; /* 新格式串缓冲 (A45: 512/500 静默截断 -> 1024/1000 + 确定性拒绝) */
        遍 (字 *指 = 堆二二; *指; 指++) {
