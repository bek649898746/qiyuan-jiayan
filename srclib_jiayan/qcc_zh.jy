静 空 毛简(常 字 *指, 字 *名存, 整 *数值) {
    常 字 *寻 = 指 + 1; 循环 (*寻 == ' ' || *寻 == '\t') 寻++; 寻 += (寻[0] == 'd' ? 6 : 9); /* skip #  define (fix 2026-08-13 Phase3: # 后空白 — glibc 缩进指令) */
    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
