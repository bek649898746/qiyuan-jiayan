静 整 节末子(整 节) { /* A44 (2026-09-12): 真末子槽 索引 = 最后 一个 接子 挂上 的 子
   (接子 按序 填 子0..子255; 子19 空 => 未 溢出, 只需 扫 0..19; 顺分 256..511 未 在 建节 初始化, 不 扫)
   —— 原 各 处 硬编码 遍 (计 = 19; 计 >= 0) 只 覆盖 20 槽: 实参 >= 20 时 后挂 的 被调者 落 目属 溢出槽,
   倒扫 扫不到 -> 末实参 被当 被调者。 */
    若 (节 < 0) 返 -1;
    若 (子19[节] >= 0) { 遍 (整 计 = 255; 计 >= 19; 计--) 若 (取子(节, 计) >= 0) 返 计; }
    遍 (整 计 = 19; 计 >= 0; 计--) 若 (取子(节, 计) >= 0) 返 计;
    返 -1;
}
静 整 末变子(整 节) { /* A44: 自 真末子 倒扫 第一个 节点_变量 子 (被调 名 定位); 返回 节点序 非 槽索引 */
    遍 (整 计 = 节末子(节); 计 >= 0; 计--) { 整 堆散 = 取子(节, 计); 若 (堆散 >= 0 && 节型别[堆散] == 节点_变量) 返 堆散; }
    返 -1;
}
静 整 接口方法返型(常 字 *接口, 常 字 *方法) { /* H1t (2026-09-11): 接口 方法 的 按值 构体 返回 型序 — 取 任 一 「实现 接口 于 类型 { 方法 = 函数 }」 绑定 的 函数 签名 (-1 = 非/未知). 分派 调用 节点 无名, 返回型 只能 从 实现 绑定 反推 */
    若 (!接口 || !接口[0] || !方法 || !方法[0]) 返 -1;
    遍 (整 计 = 0; 计 < 实现数 && 计 < 64; 计++) {
        若 (比较字符串(实现表[计].接口名, 接口)) 续;
        遍 (整 键 = 0; 键 < 实现表[计].绑数 && 键 < 16; 键++) {
            若 (!比较字符串(实现表[计].绑名[键], 方法)) {
                若 (!实现表[计].绑函[键][0]) 返 -1;
                整 返序 = 查返回名(实现表[计].绑函[键]);
                若 (返序 >= 0 && !查返回名指(实现表[计].绑函[键])) 返 返序;
                返 -1;
            }
        }
    }
    返 -1;
}
静 空 标方返型(整 呼节, 常 字 *接口, 常 字 *方法) { /* H1t: 给 接口 分派 调用节点 打 返回型 标 (供 调用构返 读取) */
    若 (呼节 < 0 || 呼节 >= 节容量) 返;
    整 返序 = 接口方法返型(接口, 方法);
    若 (返序 >= 0) 调方返[呼节] = 返序 + 1;
}
静 整 调用构返(整 呼节) { /* H1i (2026-09-11): 调用节点 的 构值 返回 类型序 (结构体 按值 返回, 非 指针) — 调用-实参 sret 路径 (L20620 起) 的 判定 复用 */
    若 (呼节 < 0 || 节型别[呼节] != 节点_调用) 返 -1;
    若 (呼节 < 节容量 && 调方返[呼节] > 0) 返 调方返[呼节] - 1; /* H1t: 接口 分派 调用 — 被调 是 隐藏 方法槽 (查返回名 查不到), 用 解析期 打 的 返回型 标 */
    字 *内壹 = NULL;
    { 整 堆散 = 末变子(呼节); 若 (堆散 >= 0) 内壹 = (字*)(节名表 + 堆散); } /* A44: 被调 名 = 末 变量 子 (自 真末子 倒扫; 原 硬编码 19..0) */
    若 (!内壹 || !内壹[0]) 返 -1;
    整 双退 = 查返回名(内壹); 整 长三 = 查返回名指(内壹);
    返 (双退 >= 0 && !长三) ? 双退 : -1;
}

静 整 调用构指(整 呼节) { /* H1t (2026-09-11): 调用 返回 指针 的 所指 构体 型序 (供 `*f()` 解引用 分支 判定; 按值 返回 的 调用 返 -1) */
    若 (呼节 < 0 || 节型别[呼节] != 节点_调用) 返 -1;
    字 *内壹 = NULL;
    { 整 堆散 = 末变子(呼节); 若 (堆散 >= 0) 内壹 = (字*)(节名表 + 堆散); } /* A44 */
    若 (!内壹 || !内壹[0]) 返 -1;
    若 (!查返回名指(内壹)) 返 -1;
    返 查返回名(内壹);
}
静 整 变量指深查(常 字 *数); /* P0-20: 前向 (定义在 L5302 之后; 它含 **全局回退**, 而 变量指深 只看本函数 → 全局/静态 指针变量 会判成 0) */
静 整 表达式指深(整 数) { /* P0-20 (2026-09-14): 表达式 的 **指针层级** (0 = 非指针). 供 `表达式构序` 判「解引用 / 下标 的 结果 是否 **仍是 指针**」—— 因为 `变量型序(名)` 只给基类型序, **不含 指针层级**, 而 `序七` 对 解引用/下标 是「跳过」语义, 在单级指针下与结果类型重合、**多级下才暴露**. */
    若 (数 < 0) 返 0;
    整 型k = 节型别[数];
    若 (型k == 节点_变量) 返 变量指深查((字*)(节名表 + 数)); /* P0-20: 用 **全** 版 —— 全局/静态 指针变量 (git 里 常见 static struct X **g;) 在 变量指深 里 查不到 → 恒 0 → 判据 失效 */
    若 (型k == 节点_解引用) { 整 层k = 表达式指深(子0[数]); 返 层k > 0 ? 层k - 1 : 0; }
    若 (型k == 节点_下标) { 整 子k = 子0[数]; 若 (子k >= 0 && 节型别[子k] == 节点_变量) { 字 *名k = (字*)(节名表 + 子k); 若 (变量指深查(名k) == 0 && 变量指元素(名k) > 0) 返 1; 否 若 (变量数组(名k) > 0 && 变量指元素(名k) > 0) 返 变量指深查(名k); } 整 层k = 表达式指深(子k); /* C1 第二层 (2026-09-26 启元 · 第 363 站): **指针数组的下标结果仍是指针** —— 第 356 站给指针数组补 `指深=1` 后, 上面那条 `指深==0` 判据 不再命中 ⟹ 落到 层k-1 ⟹ 返回 0 (应 1) ⟹ 下游 码生成内存指(补加载) 落空 ⟹ `float *arr[2]` 的 `arr[0][1]` 读 ≈0. 新增一条 else-if (旧 ∨ 新 合并式): 真数组 && 元素是指针 ⟹ 层级 = 变量自身层级. 逐值: arr(数组2/指元8/指深1)=1 ✓ · slot(指深0)=走旧判据 ✓ · p(数组0)=走原路径 ✓ · int a[3](指元0)=走原路径 ✓ */ 返 层k > 0 ? 层k - 1 : 0; } /* P0-20 未修 (2026-09-14): 数组元素是指针 `struct inner *slot[N]; slot[i]` —— 原 下标/解引用 合并为「层级减一」, 而 数组 base 的 层级 是 0 ⇒ `表达式指深(slot[0])` = 0 ⇒ `表达式构序` 误判 构值 ⇒ 三目 A9001 假拦. 修: 数组 base 且 元素是指针 ⇒ 下标结果 = 指针 (层级 1). ⚠️ 判据 用 `变量指深查==0` (含 全局回退) + `变量指元素>0` (含 全局回退) —— 不能 用 `变量数组>0` (L3777 只查局部 ⇒ 静态 全局 指针数组 slot 查不到 ⇒ 判据恒假). */
    若 (型k == 节点_成员 || 型k == 节点_箭头) {
        整 基k = 序七(子0[数]); 若 (基k < 0) 返 0;
        整 标k = 字段序(基k, (字*)(节名表 + 数)); 若 (标k < 0) 返 0;
        若 (类型表[基k].字段[标k].高贰 > 0) 返 (整)类型表[基k].字段[标k].高贰;
        返 类型表[基k].字段[标k].原进 != 0 ? 1 : 0;
    }
    返 0;
}
静 整 表达式内重(整 数) { /* A71 三跳根治 (2026-09-15): 表达式 的 最深层基类型 元素大小 — 递归到 最内层 变量/指针字段 取 指内/主挂. 供 嵌套下标 的「第三跳」步长 (int* 的 元素 = int = 4, 而 最内层 int*** 的 堆次 = 8). 与 表达式指深 配成对: 指深 判「是否 指针/层级」, 内重 判「去掉 指针 后 的 标量 尺寸」. */
    若 (数 < 0) 返 0;
    整 型k = 节型别[数];
    若 (型k == 节点_变量) 返 变量指内查((字*)(节名表 + 数)); /* 含 全局 回退 (同 表达式指深 的 变量 分支) */
    若 (型k == 节点_下标 || 型k == 节点_解引用) 返 表达式内重(子0[数]); /* 下标/解引用 不 改变 基类型, 继续 递归 到 链根 */
     若 (型k == 节点_二元 && 子0[数] >= 0) 返 表达式内重(子0[数]); /* C9: 二元 穿透 左操作数 (指针算术 结果类型 = 左) */
     若 (型k == 节点_三元 && 子1[数] >= 0) 返 表达式内重(子1[数]); /* C9: 三元 穿透 真分支 */
    若 (型k == 节点_成员 || 型k == 节点_箭头) {
        整 基k = 序七(子0[数]); 若 (基k < 0) 返 表达式内重(子0[数]);
        整 标k = 字段序(基k, (字*)(节名表 + 数)); 若 (标k < 0) 返 表达式内重(子0[数]);
        若 (类型表[基k].字段[标k].高贰 > 0 || 类型表[基k].字段[标k].原进 != 0) 返 类型表[基k].字段[标k].主挂; /* 指针 字段: 最终 元素 大小 = 主挂 */
        返 表达式内重(子0[数]);
    }
    返 0;
}
静 整 表达式构序(整 数) { /* H1j (2026-09-11): 表达式 的 按值 结构体 类型序; -1 = 非 构值 (标量/指针/未知) — 用于 拦截 构值 三目 (三目 只 实现 标量/双精度 通道) */
    若 (数 < 0) 返 -1;
    整 型 = 节型别[数];
    若 (型 == 节点_变量) { 字 *名 = (字*)(节名表 + 数); 若 (变量指元素(名) > 0 || 变量数组(名) > 0) 返 -1; 返 变量型序(名); } /* 数组 名 退化 为 地址 ✓ 不 算 构值 */
    若 (型 == 节点_调用) 返 调用构返(数);
    若 (型 == 节点_成员 || 型 == 节点_箭头) {
        字 *函 = (字*)(节名表 + 数);
        整 基序 = 序七(子0[数]);
        若 (基序 < 0) 返 -1;
        若 (字段是否指(基序, 函)) 返 -1;
        返 字段类型序直(基序, 函);
    }
    若 (型 == 节点_解引用) { 若 (表达式指深(数) >= 1) 返 -1; /* P0-17/P0-20 (2026-09-14): **解引用 结果 仍是 指针 → 非构值**. `变量型序(名)` 只给基类型序、**不含指针层级**, 而 `序七` 对解引用是「跳过」语义, 在单级指针下与结果类型重合、**多级下才暴露**. 实测 git `blame.c` L33 `return result ? *result : NULL;` (result = `struct blame_origin **`) → 左误判构值 / 右 NULL 常数 → A9001 假拦. 判据统一为 `表达式指深(本节点) >= 1` (它 递归 求 层级), 覆盖 变量基 / 成员基 / 嵌套. */ 整 序指 = 序七(数); 若 (序指 >= 0) 返 序指; 返 调用构指(子0[数]); } /* H1q/H1t: *p 构值 分支 — 指针 变量 经 序七; `*指针返回调用()` 经 调用构指 (原 后者 落 -1 → A9001 假拦) */
    若 (型 == 节点_下标) { 若 (表达式指深(数) >= 1) 返 -1; 返 序七(数); } /* P0-20 (2026-09-14): **下标 结果 仍是 指针 → 非构值**. 与解引用分支同病 (P0-17): `序七(下标)` 对 变量/成员 基 是「跳过」语义 ⟹ `T **arr` 的 `arr[i]`、`s.arr[i]` (arr 是 `T**` 字段) 被 当 成 `T` 构值. 实测 git `revision.c` / `read-cache.c` 的 `cond ? <成员数组指针元素> : NULL` → 左误判构值 / 右 NULL 常数 → A9001 假拦. (H1t 2026-09-11 引入下标分支 —— 构体 数组 元素 arr[i] 作 构值 表达式.) */
    若 (型 == 节点_三元 && 节值表[数] > 0) 返 节值表[数] - 1; 若 (型 == 节点_二元 && 节值表[数] == 逗号 && 子1[数] >= 0) 返 表达式构序(子1[数]); /* R535-e5: 逗号 的 构值类型序 = 右操作数 */ /* H1q (2026-09-11): 构值 三目 自身 (嵌套 三目 分支 判定/成员 基 判定) */
    返 -1;
}
/* 解析-时间 双精度-表达式 predicate (根-因 2026-08-03): `(整数)表达式` 转型
   creation relied 于 节浮标[常式], 哪 遍 a 双精度-返回 调用 是 仅 集 于
   码生成器 (例-4) — 故 `(整数)dadd(2.5,3.5)` 曾 a 无-算子 于 解析, 该 调用 stayed
   双精度-typed, 且 格式化打印 %d 读取 该 度肆 xmm0 低 符弊 (0). Detect 双精度-ness
   此处 于 解析: 节浮标 covers 终简/双精度-变量/双精度-成员/双精度-二进制; 调用 需
   该 被调者 签名 (mirror 的 例-4 节浮标 逻辑). */
静 整 表达式是否浮(整 数) {
    
    若 (数 < 0) 返 0;
    若 (节型别[数] == 节点_二元 && 节值表[数] == 逗号 && 子1[数] >= 0) 返 表达式是否浮(子1[数]); /* C126b (2026-09-19 第 121 站): 逗号 表达式 的 值 = **右操作数** —— 原 无本分支 ⟹ 逗号节点 浮性 恒 0 ⟹ 实参判别 (`printf("%.2f", (x, 2.5))`) 走 整数压栈 ⟹ 0.00. 放在 节浮标 读取 **之前** 是 有意: 逗号节点 的 节浮标 由 码生成 期 才设, 而 实参判别 早于 它. */
    若 (节点浮性(数, -1)) 返 1;
    若 (节型别[数] == 节点_下标) { /* C131b (2026-09-19 第 125 站): **下标 结果的 浮性 = 基 直接 指向 的 浮性** —— 原 无本分支 ⟹ 恒 0 ⟹ 实参判别 / 返回转换 把 浮点 元素 当 整数 ⟹ 插入 整转浮 覆盖 已 读入 xmm0 的 浮点 值 (汇编实证: 浮取 xmm0,r0 紧跟 整转浮 xmm0,eax ⟹ 结果 = 地址 低 32 位). 必须 放在 节浮标 之后 (码生成期 设的 节浮标 优先); 且 本 函数 被 实参判别 调用, **早于** 码生成 (见 L5140 C126b 注释) ⟹ 只能 在此 解析期 判据 补. 多级指针 (指深>=2) 的 下标 结果 仍 是 指针 ⟹ 返 0. */
        整 基乙 = 子0[数];
        若 (基乙 < 0) 返 0;
        若 (节型别[基乙] == 节点_变量) {
            字 *名乙 = (字*)(节名表 + 基乙);
            若 (变量数组(名乙) != 0) 返 变量是否浮(名乙) ? 1 : 0; /* 数组名: 元素 自身 浮性 */
            若 (变量指深查(名乙) >= 2) 返 0; /* 多级: 下标 结果 是 指针, 非 浮点 值 */
            返 变量指浮(名乙) ? 1 : 0;
        }
        返 表达式是否浮(基乙); /* 嵌套 基 递归; 未覆盖 类型 仍 返 0 (行为 不变) */
    }
    若 (节型别[数] == 节点_变量) {
        字 *变节二 = (字*)(节名表 + 数);
        若 (变量数组(变节二) != 0) 返 0; /* 数组名衰减为地址, 不是 双精度 值 (修复 2026-08-25 步十五: 双精度 数组名 变量是否浮=真 → (字符*)数组+n 走浮点加法 → 基址丢失; 同 L4319 节浮标 守卫) */
        返 变量是否浮(变节二) ? 1 : 0;
    } /* 修复 2026-08-25 缺陷#27: 双精度 变量标识符 (原 节浮标 未设置 → 0-短进 走整数路径 → 负 双精度 全错) */
    若 (节型别[数] == 节点_调用) { /* 函数 调用 */
        /* A44b (2026-09-12): 被调者 = **真末子** — 原 取 子0[数] (首 子) 而 调用 节点 的 子 = [实参…, 被调者],
           ⇒ 有 实参 时 查 的 是 首 实参 的 名字 (与 A44 同 一 反模式; 子 0 只在 0 实参 时 恰好 是 被调者) */
        整 函 = -1;
        { 整 末位浮 = 节末子(数); 若 (末位浮 >= 0) 函 = 取子(数, 末位浮); }
        若 (函 < 0) 返 0;
        若 (节型别[函] == 节点_变量) { /* 命名 被调者: 函数 或 函数指 变量 */
            字 *存分 = (字*)(节名表 + 函);
            若 (查函数浮返(存分)) 返 1; /* 高癸一 双精度-返回 函数 */
            若 (变量指浮(存分)) 返 1;       /* 双精度-返回 函数指 变量 */
            返 0;
        }
        若 (节型别[函] == 节点_解引用) 函 = 子0[函]; /* (*函数指针): 解引用 退化 到 该 指针 变量 */
        若 (节型别[函] == 节点_变量) 返 变量指浮((字*)(节名表 + 函)) ? 1 : 0;
        { 整 位非标 = 原庚(函); /* 表达式 被调者 (栈散[i], 数组[i].f): 基's 指浮 */
          若 (位非标 >= 0 && 节型别[位非标] == 节点_变量 && 变量指浮((字*)(节名表 + 位非标))) 返 1; }
    }
    返 0;
}

静 整 错载宽(整 呼节) { /* R6b-2b (2026-09-09): 错误调用 载荷宽度 — 直接调用 8B-返回 错误函数 → 8 (双通道 {rax 8B 值 | rdx tag}); int/其它 → 0 (单 rax 打包 {低32 值 | 高32 tag}); 判定同 返回侧 R6b-1 (下组 + 半次一) */
    若 (呼节 < 0 || 节型别[呼节] != 节点_调用) 返 0;
    整 函 = -1;
    { 整 末九 = 节末子(呼节); 若 (末九 >= 0) 函 = 取子(呼节, 末九); } /* A44 */
    若 (函 < 0 || 节型别[函] != 节点_变量) 返 0;
    若 (!下组((字*)(节名表 + 函))) 返 0;
    若 (查函数浮返((字*)(节名表 + 函))) 返 16; /* G1 (2026-09-10): 双精度 载荷类 — 值 走 xmm0, tag 走 rdx (8B 类 值 占 rax, 浮点类 值 占 xmm0 → 消费侧 取值通道 不同); 中细 尺寸标记 复用 8, 靠 查函数浮返 区分 */
    返 半次一((字*)(节名表 + 函));
}
静 空 呼名一(整 呼节, 字 *出) { /* G1 (2026-09-10): 调用 节 → 被调 名 (非 调用节 / 非 标识符被调 → 空串) — 载荷类/透传 判定 共用 */
    出[0] = 0;
    若 (呼节 < 0 || 节型别[呼节] != 节点_调用) 返;
    整 函 = -1;
    { 整 末九 = 节末子(呼节); 若 (末九 >= 0) 函 = 取子(呼节, 末九); } /* A44 */
    若 (函 < 0 || 节型别[函] != 节点_变量) 返;
    复制字符串(出, (字*)(节名表 + 函));
}
静 整 错载荷类(常 字 *名) { /* G1 (2026-09-10): 错误函数 载荷 类别 — -1=非错误函数, 0=int 打包 (单 rax), 8=8B 值 载荷 (rax 值 + rdx tag), 16=双精度 载荷 (xmm0 值 + rdx tag); G2b: 32=大结构体 载荷 (sret 结构体 + rax tag + rdx 错码) */
    若 (!名 || !名[0] || !下组(名)) 返 -1;
    若 (半次一(名) == 32) 返 32;
    若 (查函数浮返(名)) 返 16;
    返 (半次一(名) == 8) ? 8 : 0;
}
静 整 错载构序(整 呼节) { /* G2b (2026-09-10): 调用 节 → 被调 返回 结构体 型序 (sret 大结构体 载荷 需要 构序 建 临时); -1 = 非 结构体返回 */
    字 名一[64]; 呼名一(呼节, 名一);
    若 (!名一[0]) 返 -1;
    整 序一 = 查函数纯(名一);
    返 (序一 >= 0) ? 函数表[序一].返构序 : -1;
}
静 整 同传呼(整 呼节) { /* G1 (2026-09-10): 节 是 调用 同类 错误函数? — 返回侧 透传 判定: 直接 返回 该 调用 时 不覆盖 tag 通道 (rdx 由 被调 透传, 同 int 类 '返回 __e 原样传播' 语义); 生成期 判据 用 中细 (半错一/查函数浮返) — 函数表 已复位 不可用 */
    字 名一[64]; 呼名一(呼节, 名一);
    若 (!名一[0] || !半错一(名一) || !半错一(当前函数名)) 返 0;
    返 (查函数浮返(名一) == 查函数浮返(当前函数名)) ? 1 : 0;
}
静 整 节点判(整 暂); /* E1b 前向: 建节 落位 判别 tag (定义在 判别 节点 声明后) */
静 整 建节(整 暂) { 若 (接子数 >= 节容量) { 输出到文件(错误流, "[ERR] 抽象语法树 溢出 (%d) (修复 2026-08-17 审计: 满则硬退, 绝不返 -1 — 原返 -1 调用方 节值表[-1] 越界写)\n", 节容量); 退出(1); } 整 计 = 接子数++; 节型表[计] = 暂; 节型别[计] = 节点判(暂); 节值表[计] = 0; 子0[计] = 子1[计] = 子2[计] = 子3[计] = 子4[计] = 子5[计] = 子6[计] = 子7[计] = 子8[计] = 子9[计] = 子10[计] = 子11[计] = 子12[计] = 子13[计] = 子14[计] = 子15[计] = 子16[计] = 子17[计] = 子18[计] = 子19[计] = 目属[计] = 后双[计] = 号得一[计] = 缓七[计] = 域癸[计] = 半丙[计] = 首厚[计] = 高拆一[计] = 副败一[计] = 前低一[计] = 外八一[计] = 虚吉[计] = 栈七[计] = 计午一[计] = 外对[计] = 度叁[计] = 主申[计] = 元六[计] = 度丁[计] = 长薄[计] = 主退一[计] = 主轮[计] = 现降[计] = 外辰[计] = 内己[计] = 副进一[计] = 末拆[计] = 缺利[计] = 域进[计] = 全戌[计] = 右十[计] = 存一[计] = 首辛[计] = 目壹[计] = 栈退[计] = 源己一[计] = 副申[计] = 旧回[计] = 邻丑[计] = 链凶[计] = 直厚[计] = 目丁一[计] = 帧升[计] = 末升[计] = 度捌[计] = 正六[计] = 序对一[计] = 元戌[计] = 右组[计] = 段庚[计] = 列未[计] = 栈又一[计] = 单再[计] = 末双[计] = 末子一[计] = 毛得[计] = 中七[计] = 值劣一[计] = 全聚[计] = 行午[计] = 满联二[计] = 整低[计] = 隔卯[计] = 目甲一[计] = 缓退[计] = 宽分[计] = 全聚一[计] = 满丑[计] = 缺午[计] = 帧凶[计] = 尾置[计] = 原八[计] = 终降[计] = 半厚[计] = 主三[计] = 行凶[计] = 池肆[计] = 暂辛[计] = 号系[计] = 余利[计] = 间次[计] = 新酉[计] = 左壬[计] = 符寅[计] = 计子一[计] = 计细[计] = 暂叁[计] = 虚肆[计] = 名癸[计] = 源重[计] = 列六[计] = 外丙[计] = 帧卯[计] = 下重[计] = 长成[计] = 源进[计] = 半利[计] = 符置[计] = 目六[计] = 前又[计] = 上平[计] = 尾五一[计] = 深重[计] = 全贰[计] = 整退[计] = 深叁[计] = 素乙[计] = 串败[计] = 左降[计] = 宽九[计] = 池又[计] = 逆合[计] = 正癸[计] = 高又[计] = 初伍[计] = 反双[计] = 深丙[计] = 末辰[计] = 存陆一[计] = 素降[计] = 隔叁[计] = 源转[计] = 名次[计] = 间双[计] = 容未[计] = 标复[计] = 计粗[计] = 栈巳[计] = 目乙[计] = 暂联[计] = 双环[计] = 旧降[计] = 实弊[计] = 尾辰一[计] = 缺联[计] = 号子[计] = 缓平一[计] = 满升[计] = 缺双[计] = 正回[计] = 虚失[计] = 符得[计] = 号复[计] = 尾对[计] = 实集[计] = 顺五一[计] = 余戌[计] = 逆八[计] = 中凶[计] = 元失[计] = 尾次[计] = 计庚一[计] = 初七[计] = 右弊[计] = 深汇[计] = 正伴[计] = 半退一[计] = 短深[计] = 满午[计] = 顺高[计] = 原子一[计] = 源退[计] = 串二[计] = 后吉[计] = 逆系[计] = 缺聚一[计] = 逆陆[计] = 缺丙一[计] = 剩凶[计] = 目酉[计] = 存简[计] = 终挂[计] = 隔捌[计] = 剩列[计] = 堆双一[计] = 值陆[计] = 素再[计] = 副伴[计] = 虚四[计] = 隔置[计] = 名子[计] = 旁低[计] = 净戌[计] = 副败[计] = 新壹一[计] = 总戌[计] = 剩戊[计] = 高卯[计] = 空亥[计] = 逆零[计] = 间弊[计] = 总丙一[计] = 半平一[计] = 初七一[计] = 邻肆[计] = 内深[计] = 后联[计] = 素七[计] = 池贰[计] = 中合[计] = 串陆[计] = 度浅[计] = 初挂[计] = 虚贰[计] = 尾劣[计] = 外简[计] = 值从[计] = 标巳[计] = 度排[计] = 现排[计] = 空属[计] = 高弊[计] = 深零一[计] = 标集[计] = 整得一[计] = 上组[计] = 初成一[计] = 缺贰[计] = 余散[计] = 整未[计] = 原厚[计] = 首亥[计] = 现弊[计] = 间得[计] = 缺粗[计] = 空凶[计] = 整集一[计] = 中聚[计] = 短得[计] = 实序[计] = 主聚[计] = 标寅[计] = 栈凶二[计] = 存丁[计] = 净双[计] = 后拾[计] = -1; 指元素[计] = 0; 节指元[计] = 0; 节转序[计] = 0; 节链[计] = -1; 节行表[计] = 调试开关 ? 词行表[词位] : 0; 返 计; } /* 修复 2026-08-18: 新节点溢出链指针初始 -1; A22 (2026-09-11): 节指元 清零; #289 (第 453 站): 节行表 = 源行 (仅 -g) */
静 空 接子(整 指, 整 字符);
静 整 赋值级(空);
静 空 成员路径串(整 数, 字 *出, 整 深) { /* H1e-② (2026-09-11): 成员/箭头/下标 链 → 路径串 (根 必须 是 变量; 深度 >8 放弃). 解引用检查 与 判空窄化 共用, 保证 两 端 路径 字符串 一致 */
    出[0] = 0;
    若 (数 < 0 || 深 > 8) 返;
    整 型九 = 节型别[数];
    若 (型九 == 节点_变量) { 复制字符串(出, (字*)(节名表 + 数)); 返; }
    若 (型九 == 节点_成员 || 型九 == 节点_箭头) {
        成员路径串(子0[数], 出, 深 + 1);
        若 (!出[0]) 返; /* 根 非 变量 (调用/解引用 等) → 无 可比较 路径 */
        若 (节值表[数] == 1) 拼接(出, "->"); 否 拼接(出, ".");
        拼接(出, (字*)(节名表 + 数));
        返;
    }
    若 (型九 == 节点_下标) {
        成员路径串(子0[数], 出, 深 + 1);
        若 (!出[0]) 返;
        若 (子1[数] >= 0 && 节型别[子1[数]] == 节点_常数) { 字 索九[24]; 格式化到串(索九, "[%d]", 节值表[子1[数]]); 拼接(出, 索九); }
        否 若 (子1[数] >= 0 && 节型别[子1[数]] == 节点_变量) { 拼接(出, "["); 拼接(出, (字*)(节名表 + 子1[数])); 拼接(出, "]"); } /* H1h (2026-09-11): 简单 下标变量 → 真名 (arr[i] vs arr[j] 可区分) */
        否 拼接(出, "[i]"); /* 复杂 下标表达式 → 占位符 (只 可能 少拦, 不会 误拦 常量/简单变量 元素) */
        返;
    }
}
静 整 解包tag生成(整 评值) { /* S2b-1 (2026-09-09): 可空值类型 解包 内联生成 — 空(tag!=0)→打印"解包空值"+出口(1); 值=低32 (替代 __qcc_unwrap 0哨兵; 有值0 合法) — 独立 helper: 巨型 赋值级() 内加 块 引 qcc_x86 死循环 */
    整 数长; 整 空判; 整 末值 = 评值; 整 浮载标 = 0; /* H1a: 末值 = 块末 值表达式 (分离类 用 64位 标记 副本 → 载荷 全宽, 不被 32 位 上下文 截断) */
    若 (评值 >= 0 && 节型别[评值] == 节点_变量 && 变量可空值((字*)(节名表 + 评值)) == 2) { /* H1a (2026-09-11): 分离 tag 槽 类 (可空 长整/双/结构体) — 判空 读 __nt_名; 块末值 = 变量 64位全读 */
        字 标名癸[80]; 可空标名((字*)(节名表 + 评值), 标名癸); /* H1g: 经 可空标名 (函数级静态 tag 带 函数序 前缀) */
        数长 = 建节(1); 复制内存((字*)(节名表 + 数长), 标名癸, 32);
        空判 = 建节(2); 节值表[空判] = 名庚; 接子(空判, 数长); { 整 零 = 建节(0); 节值表[零] = 0; 接子(空判, 零); }
        末值 = 建节(1); 复制内存((字*)(节名表 + 末值), (字*)(节名表 + 评值), 32); /* 值节点 副本 */
        若 (变量是否浮((字*)(节名表 + 评值))) { 节浮标[末值] = 1; 浮载标 = 1; } 否 节长标[末值] = 1; /* H1b: 双精度 载荷 → xmm0 通道 (节浮标); 整 类 载荷 → 64 位 标记 (否则 块末值 被 32 位 上下文 截断, 高 32 位 丢) */
    } 否 {
    数长 = 建节(1); 复制内存((字*)(节名表 + 数长), (字*)(节名表 + 评值), 32); 节长标[数长] = 1; /* 64位全读 (可空值标+节长标) */
    整 移位 = 建节(2); 节值表[移位] = 帧寅; 节长标[移位] = 1; 接子(移位, 数长); { 整 三二 = 建节(0); 节值表[三二] = 32; 接子(移位, 三二); } /* x >> 32 */
    空判 = 建节(2); 节值表[空判] = 名庚; 接子(空判, 移位); { 整 零 = 建节(0); 节值表[零] = 0; 接子(空判, 零); } /* (x>>32) != 0 → 空 */
    }
    整 主若 = 建节(8); 接子(主若, 空判);
    整 符附 = 建节(5);
    若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
    若 (!串表[串数]) 串表[串数] = 短六();
    复制字符串(串表[串数], "解包空值\n");
    整 呼参 = 建节(4); { 整 现转 = 建节(0); 节值表[现转] = 串数; 节型表[现转] = 串词; 节型别[现转] = 节点_串词; 接子(呼参, 现转); } { 整 顺庚 = 建节(1); 复制内存((字*)(节名表 + 顺庚), "printf", 7); 接子(呼参, 顺庚); }
    串数++;
    接子(符附, 呼参);
    整 呼隐 = 建节(4); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(呼隐, 壹节); } { 整 首壹 = 建节(1); 复制内存((字*)(节名表 + 首壹), "exit", 5); 接子(呼隐, 首壹); }
    接子(符附, 呼隐);
    接子(主若, 符附);
    整 块 = 建节(5); 接子(块, 主若); 接子(块, 末值); 若 (浮载标) 节浮标[块] = 1; /* 块末值 = x (packed: 低32; H1a 分离类: 载荷 全宽 64位; H1b 双: 浮标 传给 块) */
    返 块;
}
静 空 可空零值注入(整 声明节, 常 字 *名, 整 静标) { /* S2a (2026-09-09): 可空声明 无初始化器 → 注入 0 初值 (空=0 哨兵确定性) + 标记已初始 (可空空值合法, 免 A4001) — 声明解析各分支注册后、= 判别前调用; S2b-3 (2026-09-09): 静标=1 走 后凶 空注入 */
    若 (静标) { /* S2b-3 (2026-09-09): 静态/全局 可空值类型 无初始化器 → 后凶 记录 空注入 (程序入口置 高32 tag=1 空; BSS 0 = tag0 有值0 不符语义) */
        若 (词型表[词位] != 赋号 && 变量可空值(名)) {
            若 (变量可空值(名) == 2) { /* H1g (2026-09-11): 分离 tag 槽 类 (函数级 静态 长 长/双) → 后凶 赋值节点 `__nt_<值序>_名 = 1` (声明节 只 会 写 打包槽 高32; 名 带 值序 保证 后凶 发射期 查名 唯一) */
                字 标名亥[96]; 可空标名(名, 标名亥);
                整 赋值亥 = 建节(10);
                { 整 左亥 = 建节(1); 复制内存((字*)(节名表 + 左亥), 标名亥, 64); 接子(赋值亥, 左亥); }
                { 整 壹亥 = 建节(0); 节值表[壹亥] = 1; 接子(赋值亥, 壹亥); }
                若 (全局初始化数 >= 16384) { 输出到文件(错误流, "[ERR] 全局初始化器超过 16384 上限\n"); 退出(1); }
                后凶[全局初始化数++] = 赋值亥;
                返;
            }
            { 整 零 = 建节(0); 节值表[零] = 0; 接子(声明节, 零); } /* 子0 = 值 0 */
            { 整 壹 = 建节(0); 节值表[壹] = 1; 接子(声明节, 壹); } /* 子1 标记 → 打包段置 高32 tag=1 (空) */
            若 (全局初始化数 >= 16384) { 输出到文件(错误流, "[ERR] 全局初始化器超过 16384 上限\n"); 退出(1); }
            后凶[全局初始化数++] = 声明节;
        }
        返;
    }
    若 (词型表[词位] != 赋号 && 变量数 > 0 && 查活变量(名) >= 0 && 变量表[查活变量(名)].变可空.tag == 可空值_无值) { /* H1 (2026-09-11): 原 看 变量表[变量数-1] — 分离 tag 槽 类 (值槽 后 又 分配 tag 槽) 时 末条 = tag 槽 (有值态) → 注入 不触发; 改 按 名字 查 值槽 */
        未初始化移除(名);
        { 整 零 = 建节(0); 节值表[零] = 0; 接子(声明节, 零); } /* 声明节点 挂 0 子 = 注入 x = 0 */
        { 若 (变量可空值(名)) { 整 壹 = 建节(0); 节值表[壹] = 1; 接子(声明节, 壹); } } /* S2b-1 (2026-09-09): 可空值类型 无初始化器 → 注入无值 — 声明节 子1 标记, 打包段置 高32 tag=1 (空) */
    }
}
静 空 可空静零注入(常 字 *名) { /* S2b-3 (2026-09-09): 文件作用域 可空值类型 无初始化器 → 建 空注入 节点 入 后凶 (程序入口 置 tag=1 空); H1e (2026-09-11): 可空值标==2 (分离 tag 槽) → 后凶 赋值 `__nt_名 = 1` (原 声明节 只 会 写 高32 tag) */
    若 (词型表[词位] == 赋号 || !变量可空值(名)) 返;
    若 (变量可空值(名) == 2) {
        字 标名己[96]; 格式化到串(标名己, "__nt_%s", 名);
        整 赋值 = 建节(10);
        { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 标名己, 64); 接子(赋值, 左); }
        { 整 壹 = 建节(0); 节值表[壹] = 1; 接子(赋值, 壹); }
        若 (全局初始化数 >= 16384) { 输出到文件(错误流, "[ERR] 全局初始化器超过 16384 上限\n"); 退出(1); }
        后凶[全局初始化数++] = 赋值;
        返;
    }
    整 声明节 = 建节(7); 复制内存((字*)(节名表 + 声明节), 名, 32);
    { 整 零 = 建节(0); 节值表[零] = 0; 接子(声明节, 零); }
    { 整 壹 = 建节(0); 节值表[壹] = 1; 接子(声明节, 壹); }
    若 (全局初始化数 >= 16384) { 输出到文件(错误流, "[ERR] 全局初始化器超过 16384 上限\n"); 退出(1); }
    后凶[全局初始化数++] = 声明节;
}
/* 花括 初始化: walk 结构体 构序's 字段, consuming 值 自 该 词元
   流 ({ a, b, c }) 且 emitting 赋值 对比 该 基 表达式
   (a 建节(1) 变量 或 a 建节(15) 嵌套-成员 节点). 嵌套 结构体 字段 recurse;
   数组 字段 展开 每 元素. 返回 a 块 的 赋值 节点. */
静 整 值布(整 构序, 整 基) {
    整 块 = 建节(5);
    整 域序 = 0;
    /* C99 聚合 初始化 zeroes 每 成员 非 explicitly 已初始化. 编译器 仅
       已发射 该 listed 字段, 故 `结构体 strvec blank = STRVEC_INIT` 左 nr/分配
       作为 栈 垃圾 且 strvec_clear looped over a 垃圾 计数. 零 全 标量
       字段 首; 该 显式 初始化 以下 则 overwrites 该 listed ones.
       (修复 2026-08-15 git_jiayan --版本 崩溃 在 strvec_clear) */
    遍 (整 零 = 0; 零 < 类型表[构序].函; 零++) {
        整 域型 = 类型表[构序].字段[零].毛利;
        整 域尺寸 = 类型表[构序].字段[零].现捌;
        整 行 = 类型表[构序].字段[零].域行数[0];
        若 (类型表[构序].字段[零].数组标 || (域型 >= 0 && 类型表[域型].尺寸 == 域尺寸) || (行 > 0 && 域尺寸 > 行)) {
            /* 嵌套 结构体/数组 字段: 内存设置(&基.字段, 0, 域尺寸) — 设计化初始化器未覆盖的
               嵌套字段必须清零 (C 语义; 修复 2026-08-19: REV_INFO_INIT 的 prune_data 等嵌套字段
               原跳过 → 垃圾 → setup_revisions 读垃圾 nr → 状态 崩) */
            字 满寅一[64]; 内存设置(满寅一, 0, 64); 复制字符串(满寅一, 类型表[构序].字段[零].正辰); /* 2026-08-28 编译DAG: 内存设置 清零 — 复制字符串 尾部栈垃圾 → 复制内存(节名表,满寅一,32) 使 节名表 哈希非确定 */
            整 素巳 = 建节(15); 复制内存((字*)(节名表 + 素巳), 满寅一, 32); 节值表[素巳] = 0;
            接子(素巳, 基);
            整 宽甲 = 建节(11); 接子(宽甲, 素巳); /* &基.字段 */
            整 素又 = 建节(4);
            整 旁降 = 建节(1); 复制内存((字*)(节名表 + 旁降), "memset", 7);
            接子(素又, 宽甲);                       /* 实参零 = &字段 */
            整 长柒 = 建节(0); 节值表[长柒] = 0; 接子(素又, 长柒); /* 实参一 = 0 */
            整 旧附 = 建节(0); 节值表[旧附] = 域尺寸; 接子(素又, 旧附); /* 实参二 = 域尺寸 */
            接子(素又, 旁降);                     /* 被调者 末 */
            接子(块, 素又);
            续; /* 嵌套 结构体/数组: 非 标量 */
        }
        字 串升[64]; 复制字符串(串升, 类型表[构序].字段[零].正辰);
        整 内存 = 建节(15); 复制内存((字*)(节名表 + 内存), 串升, 32); 节值表[内存] = 0;
        接子(内存, 基);
        整 零值 = 建节(0); 节值表[零值] = 0;
        整 赋值 = 建节(10); 接子(赋值, 内存); 接子(赋值, 零值); 接子(块, 赋值);
    }
    循环 (词型表[词位] != 右花 && 词型表[词位] != 词终) { /* 至 } — 域序 可能 exceed 函 遍 出-的-顺序 designators (修复 2026-08-05) */
        若 (词型表[词位] == 逗号 || 词型表[词位] == 分号) { 词位++; 续; } /* 跳过 前厚 之间 值 */
        若 (词型表[词位] == 右花) 断;
        若 (词型表[词位] == 句点 && 词型表[词位 + 1] == 词变量) { /* 指定 初始化: .字段 = 表达式 */
            词位++; /* . */
            字 栈得[64]; 复制字符串(栈得, 词名表[词位]); 词位++; /* 字段 名 */
            若 (词型表[词位] == 赋号) 词位++; /* = */
            整 顺败 = -1;
            遍 (整 乙 = 0; 乙 < 类型表[构序].函; 乙++) 若 (!比较字符串(类型表[构序].字段[乙].正辰, 栈得)) { 顺败 = 乙; 断; }
            若 (顺败 < 0) { 整 剩申 = 0; 循环 (词位 < 词容量 && 词型表[词位] != 词终) { 若 (词型表[词位] == 左花) 剩申++; 否 若 (词型表[词位] == 右花) { 若 (剩申 == 0) 断; 剩申--; 若 (剩申 == 0) { 词位++; 断; } } 否 若 (词型表[词位] == 逗号 && 剩申 == 0) 断; 词位++; } 续; } /* 修复 2026-08-16 根因G: 未知字段跳过需花括号配平且 剩申=0 的 } 是外层闭合(不消费) — 原遇任意 右花 就停(嵌套 {2} 截断) → 元素边界错乱 → 数组层 叶 死循环 */
            域序 = 顺败; /* jump 到 该 指定 字段 (可能 go 回) */
            /* 修复 2026-08-19: 嵌套设计器链 .字段.成员 = 数值 — 设计器分支只设 域序 就 继续,
               循环-顶 会把 .成员 当外层字段查 → 顺败<0 → 吞掉 (REV_INFO_INIT 的 .pruning.标志.递归
               等嵌套设计器失效 → rev_info 未初始化 → 状态 崩)。沿链直走: .在.x → 下钻到最内层字段,
               赋值级() 取末值, 自然停在顶层逗号 (不能用 值布 递归 — 会吞掉后续逗号字段)。 */
            若 (词型表[词位] == 句点 && 类型表[构序].字段[顺败].毛利 >= 0 &&
                类型表[构序].字段[顺败].现捌 == 类型表[类型表[构序].字段[顺败].毛利].尺寸) {
                整 函数数一 = 类型表[构序].字段[顺败].毛利;
                整 暂细 = 建节(15); 复制内存((字*)(节名表 + 暂细), 类型表[构序].字段[顺败].正辰, 32); 节值表[暂细] = 0;
                接子(暂细, 基);
                循环 (词型表[词位] == 句点 && 词型表[词位 + 1] == 词变量) {
                    词位++; /* . */
                    字 主玖[64]; 内存设置(主玖, 0, 64); 复制字符串(主玖, 词名表[词位]); 词位++; /* 成员 — 2026-08-28 编译DAG: 内存设置 清零 (同 满寅一/变节, 栈缓冲尾部不置零 → 复制内存(32) 拷垃圾 → 节名表 哈希非确定) */
                    若 (词型表[词位] == 赋号) 词位++; /* = */
                    整 余繁 = -1;
                    若 (函数数一 >= 0) 遍 (整 乙 = 0; 乙 < 类型表[函数数一].函; 乙++) 若 (!比较字符串(类型表[函数数一].字段[乙].正辰, 主玖)) { 余繁 = 乙; 断; }
                    若 (余繁 < 0) { 整 剩申 = 0; 循环 (词位 < 词容量 && 词型表[词位] != 词终) { 若 (词型表[词位] == 左花) 剩申++; 否 若 (词型表[词位] == 右花) { 若 (剩申 == 0) 断; 剩申--; 若 (剩申 == 0) { 词位++; 断; } } 否 若 (词型表[词位] == 逗号 && 剩申 == 0) 断; 词位++; } 断; }
                    整 行对 = 建节(15); 复制内存((字*)(节名表 + 行对), 主玖, 32); 节值表[行对] = 0;
                    接子(行对, 暂细);
                    暂细 = 行对;
                    函数数一 = (余繁 >= 0) ? 类型表[函数数一].字段[余繁].毛利 : -1; /* 下钻: 若成员是标量 (域型=-1) 链到此为止 */
                    若 (词型表[词位] == 赋号) 词位++; /* = */
                }
                整 赋值 = 建节(10); 接子(赋值, 暂细); 接子(赋值, 赋值级()); 接子(块, 赋值);
                续;
            }
            /* 修复 2026-08-16 根因G: 成员设计器链 .值.更新 = {...} — 当前字段是匿名 联合/结构体 8字节近似 (无类型链接无法下钻), 后续 .成员 段整体 opaque 消费 (原下一轮 循环-顶 设计器分支把 .更新 当本层字段查 → 顺败<0 → 边界错乱 → 数组层 叶 死循环 抽象语法树 溢出 merged_test.c) */
            若 (词型表[词位] == 句点 && 类型表[构序].字段[域序].毛利 < 0 && 类型表[构序].字段[域序].现捌 == 8 && 类型表[构序].字段[域序].域行数[0] == 8) {
                整 剩申 = 0;
                循环 (词位 < 词容量 && 词型表[词位] != 词终) {
                    若 (词型表[词位] == 左花) 剩申++;
                    否 若 (词型表[词位] == 右花) { 若 (剩申 == 0) 断; 剩申--; 若 (剩申 == 0) { 词位++; 断; } } /* 剩申=0 的 } 是外层闭合(元素结束, 不消费); 值自身的 } 使 剩申 1→0 消费后停 (修复 2026-08-16: 原把元素闭合也消费 → 边界错乱) */
                    否 若 (词型表[词位] == 逗号 && 剩申 == 0) 断;
                    词位++;
                }
            }
            续;
        }
        若 (域序 >= 类型表[构序].函) { 整 源系 = 词位; 赋值级(); 若 (词位 == 源系) { 循环 (词位 < 词容量 && 词型表[词位] != 逗号 && 词型表[词位] != 分号 && 词型表[词位] != 右花 && 词型表[词位] != 词终) 词位++; } /* 表达式 未推进 → 手动跳分隔符 (修复 2026-08-16: color.c attrs[] 尺寸("..")-1 漏 ) 卡 右括 → 域序 空转 2^31 溢出 INT_MIN 越界崩) */ 域序++; 续; } /* 全 字段 已消费: 丢弃 额外 值 */
        字 串升[64]; 复制字符串(串升, 类型表[构序].字段[域序].正辰);
        整 域型 = 类型表[构序].字段[域序].毛利;
        整 主复 = 类型表[构序].字段[域序].现捌;
        整 新退 = 类型表[构序].字段[域序].域行数[0];
        整 内存 = 建节(15); 复制内存((字*)(节名表 + 内存), 串升, 32); 节值表[内存] = 0;
        接子(内存, 基);
        /* 修复 2026-08-07: 指针字段 (ftype=指向的 结构体, 但 域尺寸=8 ≠ 结构体 尺寸) 不递归 —
           自引用结构体 结构体 LNode { 整数 v; 结构体 LNode *下一; } 的 下一 若递归 → 无限递归死循环 */
        整 正零 = (域型 >= 0 && 类型表[域型].尺寸 != 主复);
        若 (域型 >= 0 && !正零) { /* 嵌套 结构体 字段 */
            若 (词型表[词位] == 左花) { /* 显式 嵌套 braces { ... }: recurse 入 字段 */
                词位++;
                整 减法 = 值布(域型, 内存);
                若 (词型表[词位] == 右花) 词位++; /* 跳过 关闭 } */
                遍 (整 键 = 0; 键 < 256; 键++) { 整 字符 = 取子(减法, 键); 若 (字符 > 0) 接子(块, 字符); }
            } 否 若 (词型表[词位] == 句点) { /* 成员设计器链 .值.更新 = {...}: 递归进嵌套 结构体 处理 (修复 2026-08-16 根因G: merged_test.c .值.更新 = { .old_hash = { 2 }, .名 = "..." } — 原 赋值级() 卡 句点 不推进 → 元素边界错乱 → 数组层 叶 死循环 抽象语法树 溢出) */
                整 减法 = 值布(域型, 内存);
                若 (词型表[词位] == 右花) 词位++; /* 跳过 关闭 } */
                遍 (整 键 = 0; 键 < 256; 键++) { 整 字符 = 取子(减法, 键); 若 (字符 > 0) 接子(块, 字符); }
            } 否 { /* 结构体 值 表达式 (e.g. .needle = *要): 拷贝 整体 结构体 (修复 2026-08-14: 原递归 值布 误把 *要 当字段 → 死循环/崩溃) */
                整 评值 = 赋值级();
                整 赋值 = 建节(10); 接子(赋值, 内存); 接子(赋值, 评值); 接子(块, 赋值);
            }
        } 否 若 (类型表[构序].字段[域序].数组标 || (新退 > 0 && 主复 > 新退)) { /* 数组 字段: 每 元素 (t12: 权威标记 ∨ 旧推断) */
            整 净浅一 = 主复 / 新退;
            整 末浅 = (词型表[词位] == 左花); /* 显式 数组 braces { a, b } (修复 2026-08-14: 原不消费 { → 赋值级() 卡 左花 死循环) */
            若 (末浅) 词位++;
            遍 (整 戊序 = 0; 戊序 < 净浅一; 戊序++) {
                若 (词型表[词位] == 逗号 || 词型表[词位] == 分号) 词位++;
                若 (词型表[词位] == 右花 || 词型表[词位] == 词终) 断;
                整 毛进二 = 戊序;
                若 (词型表[词位] == 左方) { /* [序标] = 值 指定下标 (修复 2026-08-14: .colors = { [GREP_COLOR_CONTEXT] = "..." } 原 [ 无分支 → 赋值级() 返回 -1 死循环/崩溃) */
                    词位++;
                    若 (词型表[词位] == 常数) { 毛进二 = 词值表[词位]; 词位++; }
                    否 若 (词型表[词位] == 词变量) { 整 评测数 = 全回(词名表[词位]); 若 (评测数 == 0x80000000) 评测数 = 域零(词名表[词位]); 若 (评测数 != 0x80000000 && 评测数 != -1) 毛进二 = 评测数; 词位++; }
                    若 (词型表[词位] == 右方) 词位++;
                    若 (词型表[词位] == 赋号) 词位++;
                }
                整 实伴 = 建节(14); 接子(实伴, 内存);
                整 序标 = 建节(0); 节值表[序标] = 毛进二; 接子(实伴, 序标);
                整 赋值 = 建节(10); 接子(赋值, 实伴); 接子(赋值, 赋值级()); 接子(块, 赋值);
            }
            若 (末浅) { 循环 (词型表[词位] == 逗号 || 词型表[词位] == 分号) 词位++; 若 (词型表[词位] == 右花) 词位++; } /* 跳过 matching } (尾随 前厚 之内 数组 braces) */
        } 否 若 (域型 < 0 && 主复 > 0 && 新退 == 主复 && 词型表[词位] == 左花) { /* t12 (2026-09-25 启元 · 第 363 站): **标量字段 初始化器 带花括号** (合法 C: `构 S { 双精度 a; } s = { { 4.5 } };`) —— 剥一层花括号 再 解析标量. 原 落 下方 opaque 跳配平 ⟹ 值整个丢弃 (实测 标量格 = 0.000, 应 4.500). 判据 限定 域型<0 && 主复==新退 ⟹ 只接 标量; 单元素数组 由 上方 数组标 分支 先接 (即使 数组标 未登, 取 a[0] 与 标量 同址, 行为等价) */
            词位++;
            整 补评值 = 赋值级();
            整 补赋值 = 建节(10); 接子(补赋值, 内存); 接子(补赋值, 补评值); 接子(块, 补赋值);
            若 (词型表[词位] == 右花) 词位++;
        } 否 若 (词型表[词位] == 左花) { /* opaque 嵌套 花括 (联合 字段 .u = { ... } 且 域型=-1): 跳过配平 (修复 2026-08-14: 赋值级() 遇 { 崩溃) */
            整 元二 = 1; 词位++;
            循环 (词位 < 词容量 && 元二 > 0) { 若 (词型表[词位] == 左花) 元二++; 否 若 (词型表[词位] == 右花) { 元二--; 若 (元二 <= 0) { 词位++; 断; } } 词位++; }
        } 否 若 (域型 < 0 && 主复 == 8 && 新退 == 8 && 词型表[词位] == 句点) { /* 匿名 联合/结构体 8字节近似的成员设计器链 (防御: 正常路径由设计器分支 blob-consumer 处理) */
            整 剩申 = 0;
            循环 (词位 < 词容量 && 词型表[词位] != 词终) {
                若 (词型表[词位] == 左花) 剩申++;
                否 若 (词型表[词位] == 右花) { 若 (剩申 == 0) 断; 剩申--; 若 (剩申 == 0) { 词位++; 断; } }
                否 若 (词型表[词位] == 逗号 && 剩申 == 0) 断;
                词位++;
            }
        } 否 { /* 标量 字段 */
            整 评值 = 赋值级();
            整 赋值 = 建节(10); 接子(赋值, 内存); 接子(赋值, 评值); 接子(块, 赋值);
        }
        域序++;
    }
    返 块;
}

/* (#195 存储面: 字段动态调用 逻辑内联于 调用分派处 — 独立 helper 函数体触发 生成器死循环, 弃用) */
/* #195 存储面 helper A: 接口字段 整组槽写; 判定须 原进==0 (T** 指针字段 高贰>0 误判防护) */
静 空 域接口赋值(整 块, 整 域构序, 整 域序, 常 字 *域基名, 常 字 *域名, 整 值, 整 箭标) {
    字 接口名[64]; 整 域接口序 = (整)类型表[域构序].字段[域序].高贰 - 1;
    若 (域接口序 < 0 || 域接口序 >= 列散) 返;
    复制字符串(接口名, 接口表[域接口序].名); 整 方法数 = 接口表[域接口序].槽数;
    整 源引序 = -1; 若 (值 >= 0 && 节型别[值] == 节点_变量) 源引序 = 接口引用序((字*)(节名表 + 值));
    字 类型名[64]; 类型名[0] = 0;
    { 整 对节 = -1; 若 (值 >= 0 && 节型别[值] == 节点_取址) 对节 = 子0[值]; 若 (对节 >= 0 && 节型别[对节] == 节点_变量) { 整 型序 = 变量型序((字*)(节名表 + 对节)); 若 (型序 >= 0) 复制字符串(类型名, 类型表[型序].名); } }
    { 整 左基 = 建节(1); 复制内存((字*)(节名表 + 左基), 域基名, 32);
      { 整 左 = 建节(15); 接子(左, 左基); 节值表[左] = (字)箭标; 复制内存((字*)(节名表 + 左), 域名, 64);
        { 整 赋 = 建节(10); 接子(赋, 左);
          若 (源引序 >= 0) { 字 源数[80]; 格式化到串(源数, "__ir_%s_数", (字*)(节名表 + 值)); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 源数, 64); 接子(赋, 右); }
          否 接子(赋, 值);
          接子(块, 赋); } } }
    若 (源引序 < 0 && 类型名[0] == 0) { 格式化到串(错缓冲, "接口: 类型 ? 未实现接口 %s (字段赋值需 &实现对象 或 引用; #195 存储面)", 接口名); 发错误("A9005", 错缓冲); }
    若 (源引序 < 0 && 类型名[0] != 0 && 找实序(接口名, 类型名) < 0) { 格式化到串(错缓冲, "接口: 类型 %s 未实现接口 %s (字段赋值; #195 存储面)", 类型名, 接口名); 发错误("A9005", 错缓冲); }
    遍 (整 槽 = 0; 槽 < 方法数; 槽++) {
        { 字 隐名[80]; 格式化到串(隐名, "__if_%s_m%d", 域名, 槽);
          整 左基 = 建节(1); 复制内存((字*)(节名表 + 左基), 域基名, 32);
          整 左 = 建节(15); 接子(左, 左基); 节值表[左] = (字)箭标; 复制内存((字*)(节名表 + 左), 隐名, 64);
          整 赋 = 建节(10); 接子(赋, 左);
          若 (源引序 >= 0) { 字 源槽[80]; 格式化到串(源槽, "__ir_%s_m%d", (字*)(节名表 + 值), 槽); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 源槽, 64); 接子(赋, 右); }
          否 { 字 函数名[64]; 找槽函数(域接口序, 类型名, 槽, 函数名); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 函数名, 64); 接子(赋, 右); }
          接子(块, 赋);
        }
    }
}
静 整 克隆链(整 原) { /* 纯可寻址链 深克隆 (节0/1/11/13/14/15) — 接口字段 隐藏槽 多读 需 N 份独立基 (防多父共享, 同可选链先例); 其它节点型 (下标索引 子表达式 纯读) 共享复用 */
    若 (原 < 0) 返 -1;
    整 型 = 节型表[原];
    若 (型 == 0) { 整 新 = 建节(0); 节值表[新] = 节值表[原]; 返 新; }
    若 (型 == 1) { 整 新 = 建节(1); 复制内存((字*)(节名表 + 新), (字*)(节名表 + 原), 64); 返 新; }
    若 (型 == 14) { 整 新 = 建节(14); 若 (子0[原] >= 0) 接子(新, 克隆链(子0[原])); 若 (子1[原] >= 0) 接子(新, 克隆链(子1[原])); 节值表[新] = 节值表[原]; 节长标[新] = 节长标[原]; 节无符号[新] = 节无符号[原]; 节浮标[新] = 节浮标[原]; 返 新; }
    若 (型 == 15 || 型 == 13) { 整 新 = 建节(15); 若 (子0[原] >= 0) 接子(新, 克隆链(子0[原])); 节值表[新] = 节值表[原]; 复制内存((字*)(节名表 + 新), (字*)(节名表 + 原), 64); 节长标[新] = 节长标[原]; 节无符号[新] = 节无符号[原]; 节浮标[新] = 节浮标[原]; 返 新; }
    若 (型 == 11) { 整 新 = 建节(11); 若 (子0[原] >= 0) 接子(新, 克隆链(子0[原])); 返 新; }
    返 原;
}
静 构 { 整 构序; 字 名[64]; 整 接口序; } 接口列表[64]; 静 整 接口列数 = 0; /* A3-f4 (2026-09-12): 接口列构/接口列名/接口列序 3 平行数组 → 接口列表{构序/名/接口序} 结构体数组 */
静 整 接口列查(整 构序, 常 字 *名) { 遍 (整 计 = 0; 计 < 接口列数; 计++) 若 (接口列表[计].构序 == 构序 && !比较字符串(接口列表[计].名, 名)) 返 接口列表[计].接口序; 返 -1; }
静 空 接口列登(整 构序, 常 字 *名, 整 接口序) { 若 (接口列查(构序, 名) < 0 && 接口列数 < 64) { 接口列表[接口列数].构序 = 构序; 复制字符串(接口列表[接口列数].名, 名); 接口列表[接口列数].接口序 = 接口序; 接口列数++; } }
静 整 域接口信息(整 成节, 字 *基名, 字 *域名, 整 *接序一, 整 *箭标一) { /* 接口引用字段 接收者 判定 (基链=变量+下标14+成员15/13 任意混合, 叶=成员 或 下标14覆盖成员[接口字段数组列]); 逐成员 字段类型序 步进解 承载型; 域名/箭标 取自 成员; 0 = 不支持 */
    基名[0] = 0; 域名[0] = 0; *接序一 = -1; *箭标一 = 0;
    整 叶组 = 0; 整 主 = 成节;
    若 (主 >= 0 && 节型别[主] == 节点_下标) { /* 接口字段数组列: 下标 盖 成员 → 分析成员 */
        若 (子0[主] >= 0 && (节型表[子0[主]] == 15 || 节型表[子0[主]] == 13)) { 主 = 子0[主]; 叶组 = 1; }
        否 返 0;
    }
    若 (主 < 0 || (节型别[主] != 节点_成员 && 节型别[主] != 节点_箭头)) 返 0;
    整 链[12]; 整 链数 = 0; 整 游 = 主;
    循环 (游 >= 0 && 链数 < 12) {
        整 型 = 节型表[游];
        若 (型 == 1) 断;
        若 (型 == 14 || 型 == 15 || 型 == 13) { 链[链数++] = 游; 游 = 子0[游]; 续; }
        返 0;
    }
    若 (游 < 0 || 节型别[游] != 节点_变量 || 查变量((字*)(节名表 + 游)) < 0) 返 0;
    复制字符串(基名, (字*)(节名表 + 游));
    整 型序 = 变量型序(基名); 若 (型序 < 0) 返 0;
    遍 (整 i2 = 链数 - 1; i2 >= 0; i2--) { /* 根→叶 逐成员 步进 (下标14 透明) */
        整 节 = 链[i2];
        若 (节 == 主) 续;
        若 (节型别[节] == 节点_下标) 续;
        整 名序 = 字段类型序直(型序, (字*)(节名表 + 节));
        若 (名序 < 0) { 若 (类型表[型序].名[0] && 字段序(型序, (字*)(节名表 + 节)) >= 0) 返 0; 返 0; }
        型序 = 名序;
    }
    复制字符串(域名, (字*)(节名表 + 主)); *箭标一 = (整)节值表[主];
    整 检序 = 字段序(型序, 域名); 若 (检序 < 0 || 类型表[型序].字段[检序].原进 != 0) 返 0;
    整 接序 = -1; 若 (类型表[型序].字段[检序].高贰 > 0) 接序 = (整)类型表[型序].字段[检序].高贰 - 1; 否 若 (叶组) 接序 = 接口列查(型序, 域名); /* 数组列: 高贰 不标 (撞指针深度), 查 侧表 */
    若 (接序 < 0 || 接序 >= 列散) 返 0;
    *接序一 = 接序; 返 1;
}
静 整 隐列(整 叶, 常 字 *隐名) { /* 隐藏方法槽 成员节点 (读/写 双用): 标量字段 → 15{克隆基, 隐名}; 数组列字段 (叶=14盖15) → 14{15{克隆基, 隐名}, 克隆下标} */
    若 (叶 >= 0 && 节型别[叶] == 节点_下标 && 子0[叶] >= 0 && (节型表[子0[叶]] == 15 || 节型表[子0[叶]] == 13)) {
        整 内 = 建节(15); 若 (子0[子0[叶]] >= 0) 接子(内, 克隆链(子0[子0[叶]])); 节值表[内] = 节值表[子0[叶]]; 复制内存((字*)(节名表 + 内), 隐名, 64);
        整 外 = 建节(14); 接子(外, 内); 若 (子1[叶] >= 0) 接子(外, 克隆链(子1[叶])); 返 外;
    }
    整 平 = 建节(15); 若 (叶 >= 0 && 子0[叶] >= 0) 接子(平, 克隆链(子0[叶])); 节值表[平] = 叶 >= 0 ? 节值表[叶] : 0; 复制内存((字*)(节名表 + 平), 隐名, 64); 返 平;
}
静 空 域接口赋值叶(整 块, 整 叶, 整 值, 整 域接口序) { /* 接口字段 整组槽写 (叶=成员或数组列 下标节点, 槽0 目标=叶本身; 隐藏列 经 隐列); RHS: 引用变量 → __ir 槽复制 / &对象 → 找槽函数 重填 */
    若 (域接口序 < 0 || 域接口序 >= 列散 || 叶 < 0) 返;
    字 接口名[64]; 复制字符串(接口名, 接口表[域接口序].名); 整 方法数 = 接口表[域接口序].槽数;
    字 场名[64]; 场名[0] = 0; 整 主 = 叶; 若 (主 >= 0 && 节型别[主] == 节点_下标 && 子0[主] >= 0 && (节型表[子0[主]] == 15 || 节型表[子0[主]] == 13)) 主 = 子0[主]; 若 (主 >= 0) 复制字符串(场名, (字*)(节名表 + 主));
    整 源引序 = -1; 若 (值 >= 0 && 节型别[值] == 节点_变量) 源引序 = 接口引用序((字*)(节名表 + 值));
    字 类型名[64]; 类型名[0] = 0;
    { 整 对节 = -1; 若 (值 >= 0 && 节型别[值] == 节点_取址) 对节 = 子0[值]; 若 (对节 >= 0 && 节型别[对节] == 节点_变量) { 整 型序 = 变量型序((字*)(节名表 + 对节)); 若 (型序 >= 0) 复制字符串(类型名, 类型表[型序].名); } }
    { 整 赋 = 建节(10); 接子(赋, 叶);
      若 (源引序 >= 0) { 字 源数[80]; 格式化到串(源数, "__ir_%s_数", (字*)(节名表 + 值)); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 源数, 64); 接子(赋, 右); }
      否 接子(赋, 值);
      接子(块, 赋); } /* 槽0 = 叶 (对象指针) */
    若 (源引序 < 0 && 类型名[0] == 0) { 格式化到串(错缓冲, "接口: 类型 ? 未实现接口 %s (字段赋值需 &实现对象 或 引用; #195 存储面)", 接口名); 发错误("A9005", 错缓冲); }
    若 (源引序 < 0 && 类型名[0] != 0 && 找实序(接口名, 类型名) < 0) { 格式化到串(错缓冲, "接口: 类型 %s 未实现接口 %s (字段赋值; #195 存储面)", 类型名, 接口名); 发错误("A9005", 错缓冲); }
    遍 (整 槽 = 0; 槽 < 方法数; 槽++) {
        { 字 隐名[80]; 格式化到串(隐名, "__if_%s_m%d", 场名, 槽);
          整 左 = 隐列(叶, 隐名);
          整 赋 = 建节(10); 接子(赋, 左);
          若 (源引序 >= 0) { 字 源槽[80]; 格式化到串(源槽, "__ir_%s_m%d", (字*)(节名表 + 值), 槽); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 源槽, 64); 接子(赋, 右); }
          否 { 字 函数名[64]; 找槽函数(域接口序, 类型名, 槽, 函数名); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 函数名, 64); 接子(赋, 右); }
          接子(块, 赋);
        }
    }
}
静 空 域接口赋值节点(整 块, 整 基节, 常 字 *域名, 整 值, 整 箭标, 整 域接口序) { /* 接口字段 整组槽写 (基=已解析表达式节点: 下标/成员链; 基节 克隆链 per 槽 — 防多父共享); RHS: 引用变量 → __ir 槽复制 / &对象 → 找槽函数 重填 */
    若 (域接口序 < 0 || 域接口序 >= 列散) 返;
    字 接口名[64]; 复制字符串(接口名, 接口表[域接口序].名); 整 方法数 = 接口表[域接口序].槽数;
    整 源引序 = -1; 若 (值 >= 0 && 节型别[值] == 节点_变量) 源引序 = 接口引用序((字*)(节名表 + 值));
    字 类型名[64]; 类型名[0] = 0;
    { 整 对节 = -1; 若 (值 >= 0 && 节型别[值] == 节点_取址) 对节 = 子0[值]; 若 (对节 >= 0 && 节型别[对节] == 节点_变量) { 整 型序 = 变量型序((字*)(节名表 + 对节)); 若 (型序 >= 0) 复制字符串(类型名, 类型表[型序].名); } }
    { 整 左 = 建节(15); 接子(左, 克隆链(基节)); 节值表[左] = (字)箭标; 复制内存((字*)(节名表 + 左), 域名, 64);
      { 整 赋 = 建节(10); 接子(赋, 左);
        若 (源引序 >= 0) { 字 源数[80]; 格式化到串(源数, "__ir_%s_数", (字*)(节名表 + 值)); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 源数, 64); 接子(赋, 右); }
        否 接子(赋, 值);
        接子(块, 赋); } }
    若 (源引序 < 0 && 类型名[0] == 0) { 格式化到串(错缓冲, "接口: 类型 ? 未实现接口 %s (字段赋值需 &实现对象 或 引用; #195 存储面)", 接口名); 发错误("A9005", 错缓冲); }
    若 (源引序 < 0 && 类型名[0] != 0 && 找实序(接口名, 类型名) < 0) { 格式化到串(错缓冲, "接口: 类型 %s 未实现接口 %s (字段赋值; #195 存储面)", 类型名, 接口名); 发错误("A9005", 错缓冲); }
    遍 (整 槽 = 0; 槽 < 方法数; 槽++) {
        { 字 隐名[80]; 格式化到串(隐名, "__if_%s_m%d", 域名, 槽);
          整 左 = 建节(15); 接子(左, 克隆链(基节)); 节值表[左] = (字)箭标; 复制内存((字*)(节名表 + 左), 隐名, 64);
          整 赋 = 建节(10); 接子(赋, 左);
          若 (源引序 >= 0) { 字 源槽[80]; 格式化到串(源槽, "__ir_%s_m%d", (字*)(节名表 + 值), 槽); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 源槽, 64); 接子(赋, 右); }
          否 { 字 函数名[64]; 找槽函数(域接口序, 类型名, 槽, 函数名); 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 函数名, 64); 接子(赋, 右); }
          接子(块, 赋);
        }
    }
}
静 整 逆低一(常 字 *串值) {
    /* 甲言中文关键字已在 词法器 改写成英文 (词名表), 此处只认英文 */
    /* 改层 (2026-08-31): 中文关键字第一等 — 直接认中文, 不经过英文改写 */
    若 (!比较字符串(串值, "断")) 返 标利; /* 中断 */
    若 (!比较字符串(串值, "例")) 返 案例; /* 例 */
    若 (!比较字符串(串值, "字") || !比较字符串(串值, "字节")) 返 型词; /* 字符 */
    若 (!比较字符串(串值, "常")) 返 型词; /* 常量 */
    若 (!比较字符串(串值, "续") || !比较字符串(串值, "继续")) 返 下退一; /* 继续 */
    若 (!比较字符串(串值, "缺")) 返 缺省; /* 缺省 */
    若 (!比较字符串(串值, "做")) 返 副丁; /* 做 */
    若 (!比较字符串(串值, "双")) 返 型词; /* 双精度 */
    若 (!比较字符串(串值, "否") || !比较字符串(串值, "否则")) 返 虚伍; /* 否则 */
    若 (!比较字符串(串值, "枚") || !比较字符串(串值, "枚举")) 返 枚词; /* 枚举 (`枚举` 别名 第1刀-第三段 2026-09-12: 原未注册 → 被当标识符) */
    若 (!比较字符串(串值, "单")) 返 型词; /* 单精度 */
    若 (!比较字符串(串值, "遍")) 返 净吉; /* 遍 */
    若 (!比较字符串(串值, "跳")) 返 大于; /* 跳转 */
    若 (!比较字符串(串值, "若")) 返 顺轮; /* 若 */
    若 (!比较字符串(串值, "整")) 返 型词; /* 整数 */
    若 (!比较字符串(串值, "长") || !比较字符串(串值, "长整")) 返 型词; /* 长整 */
    若 (!比较字符串(串值, "返") || !比较字符串(串值, "返回")) 返 后甲; /* 返回 */
    若 (!比较字符串(串值, "短")) 返 型词; /* 短整 */
    若 (!比较字符串(串值, "有符号") || !比较字符串(串值, "有符号")) 返 型词; /* 有符号 */
    若 (!比较字符串(串值, "大小")) 返 度序; /* 尺寸 */
    若 (!比较字符串(串值, "静")) 返 型词; /* 静态 */
    若 (!比较字符串(串值, "构") || !比较字符串(串值, "类") || !比较字符串(串值, "结构体")) 返 结构词; /* 结构体 (类 = C++ 互操作别名, 阶段C-1 #79 2026-09-02; `结构体` 别名 第1刀-第三段 2026-09-12: 原未注册 → 被当标识符 静默误编译) */
    若 (!比较字符串(串值, "择")) 返 开关; /* 开关 */
    若 (!比较字符串(串值, "联") || !比较字符串(串值, "联合")) 返 结构词; /* 联合 (第1刀-第二段 2026-09-12: 补 `联合` 别名 — 原 未注册 → 被当 标识符 → 静默 误编译) */
    若 (!比较字符串(串值, "无") || !比较字符串(串值, "无整")) 返 型词; /* 无符号 */
    若 (!比较字符串(串值, "空")) 返 型词; /* 空 */
    若 (!比较字符串(串值, "易失")) 返 型词; /* 易失 */
    若 (!比较字符串(串值, "循环")) 返 下得一; /* 循环 */

    若 (!比较字符串(串值, "struct") || !比较字符串(串值, "union")) 返 结构词; /* 联合 shares 该 结构体 machinery (偏移-0 字段) */
    若 (!比较字符串(串值, "extern")) 返 型词;
    若 (!比较字符串(串值, "static")) 返 型词; /* treat 作为 类型 modifier */
    若 (!比较字符串(串值, "const")) 返 型词;
    若 (!比较字符串(串值, "volatile")) 返 型词; /* 类型修饰符（修复 2026-08-06: 内核 MMIO 需要; 当普通 型词 跳过, 语义同 整数） */
    若 (!比较字符串(串值, "restrict")) 返 型词; /* C99 类型修饰符 (优化提示; 编译器 无优化器, 忽略语义正确 — 修复 2026-08-25 支持矩阵补全) */
    若 (!比较字符串(串值, "_Atomic")) 返 型词; /* C11 类型修饰符 (单线程下当普通类型, 无原子语义 — 修复 2026-08-25 支持矩阵补全) */
    若 (!比较字符串(串值, "void")) 返 型词;
    若 (!比较字符串(串值, "FILE") || !比较字符串(串值, "long")) 返 型词; /* 内置 类型 已用 由 自身-宿主 */
    若 (!比较字符串(串值, "enum")) 返 枚词;
    若 (!比较字符串(串值, "return")) 返 后甲;
    若 (!比较字符串(串值, "if")) 返 顺轮;
    若 (!比较字符串(串值, "else")) 返 虚伍;
    若 (!比较字符串(串值, "while")) 返 下得一;
    若 (!比较字符串(串值, "do")) 返 副丁;
    若 (!比较字符串(串值, "goto")) 返 大于;
    若 (!比较字符串(串值, "for")) 返 净吉;
    若 (!比较字符串(串值, "break")) 返 标利;
    若 (!比较字符串(串值, "continue")) 返 下退一;
    若 (!比较字符串(串值, "switch")) 返 开关;
    若 (!比较字符串(串值, "case")) 返 案例;
    若 (!比较字符串(串值, "default")) 返 缺省;
    若 (!比较字符串(串值, "signed")) 返 型词; /* 修复 2026-08-15: 有符号 字符 常量 cq_lookup[] — 有符号 未识别为关键字 */
    若 (!比较字符串(串值, "unsigned")) 返 型词;
    若 (!比较字符串(串值, "int") || !比较字符串(串值, "double") || !比较字符串(串值, "float")) 返 型词; /* R4a-1: float 第一类类型词 (与 单 同; 真 4B 单精度) */
    若 (!比较字符串(串值, "char")) 返 型词;
    若 (!比较字符串(串值, "_Bool")) 返 型词;
    若 (!比较字符串(串值, "inline")) 返 型词;
    若 (!比较字符串(串值, "__inline") || !比较字符串(串值, "__inline__") || !比较字符串(串值, "__forceinline")) 返 型词; /* C15 根治 (2026-09-17): GNU/MSVC 内联 拼写 __inline/__inline__/__forceinline 原未识别 ⟹ 落 词变量 ⟹ 函数定义头 错位 ⟹ 该函数被当「变量声明」⟹ 其 {} 被当「初始化列表」⟹ 一直扫到下一个 `;` ⟹ 吞掉其后 结构体定义 (实测 nedmalloc: `#define FORCEINLINE __inline` + `static FORCEINLINE int win32munmap(...)` ⟹ win32_mlock_t 定义残缺 ⟹ A1001 未定义或不完整) */
    若 (!比较字符串(串值, "short")) 返 型词; /* 修复 2026-08-06: 短整 缺词法分类 → 结构体 字段被当标识符注册成幻影字段, 布局错乱 (回归测试 结构对齐回归 暴露) */
    若 (!比较字符串(串值, "void")) 返 型词;
    若 (!比较字符串(串值, "sizeof")) 返 度序;
    若 (!比较字符串(串值, "_Alignof")) 返 容吉一; /* C11 对齐查询 (修复 2026-08-25 支持矩阵补全 步一) */
    若 (!比较字符串(串值, "_Noreturn")) 返 型词; /* C11 函数修饰符 (修复 2026-08-25 支持矩阵补全 步二: 函数定义 型词 循环自然跳过) */
    若 (!比较字符串(串值, "_Generic")) 返 满酉; /* C11 泛型选择 (修复 2026-08-25 支持矩阵补全 步六) */
    返 常数;
}
/* 第1刀-第二段 (2026-09-12): 联合 判定 单点收口 —— 原 全文件 7 处 内联 `(!比较字符串(x,"union") || !比较字符串(x,"联"))`, 加 一个 别名 要 改 7 处 (同一坑 的 又一 副本);
   现 收敛 到 一个 谓词: 加 别名 只 改 这里 (联合 别名 即 本次 补 的 第 三 个 拼写). */
静 整 是联合词(常 字 *词) { 返 (!比较字符串(词, "union") || !比较字符串(词, "联") || !比较字符串(词, "联合")) ? 1 : 0; }


/* C11 _Alignof: 解析 (类型) 返回对齐值 — 与 尺寸 同族但语义不同 (修复 2026-08-25 支持矩阵补全 步一) */
静 整 净乙一(空) {
    整 累加低 = 4; /* 缺省: 整数 对齐 */
    若 (词型表[词位] == 型词) { /* 基本类型 (含 无符号/有符号/长整 修饰符链) */
        整 初成 = 0;
        遍 (;;) {
            若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) { 累加低 = 1; 词位++; }
            否 若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) { 累加低 = 2; 词位++; }
            否 若 ((!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) { 初成++; 累加低 = (初成 >= 2) ? 8 : 4; 词位++; }
            否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) { 累加低 = 8; 词位++; }
            否 若 ((!比较字符串(词名表[词位], "unsigned") || !比较字符串(词名表[词位], "无") || !比较字符串(词名表[词位], "无整")) || (!比较字符串(词名表[词位], "signed") || !比较字符串(词名表[词位], "有符号") || !比较字符串(词名表[词位], "有符号")) || (!比较字符串(词名表[词位], "int") || !比较字符串(词名表[词位], "整")) || (!比较字符串(词名表[词位], "void") || !比较字符串(词名表[词位], "空"))) { 词位++; }
            否 断;
        }
        循环 (词型表[词位] == 乘) { 累加低 = 8; 词位++; } /* 指针 → 8 */
    } 否 若 (词型表[词位] == 结构词) { /* 结构体/联合: 用 字段尺寸递归 维护的最大对齐 满卯 */
        词位++;
        若 (词型表[词位] == 词变量) {
            整 构序 = 查类型(词名表[词位]);
            若 (构序 >= 0 && (类型表[构序].函 > 0 || 类型表[构序].尺寸 > 0)) 累加低 = 类型表[构序].满卯; /* 已定义结构体用最大对齐 (全 字符 结构 满卯=1 也是真值); 前向声明保持默认 */
            词位++;
        }
    } 否 若 (词型表[词位] == 枚词) { /* 枚举 → 整数 对齐 4 */
        词位++; 若 (词型表[词位] == 词变量) 词位++;
    } 否 若 (词型表[词位] == 词变量) { /* 类型定义 名 */
        整 型定序 = 型定查(词名表[词位]);
        若 (型定序 >= 0) {
            若 (型定表[型定序].是否构标) {
                整 构序 = 查类型(型定表[型定序].构名一);
                若 (构序 >= 0 && (类型表[构序].函 > 0 || 类型表[构序].尺寸 > 0)) 累加低 = 类型表[构序].满卯;
            } 否 {
                整 容薄 = 型定表[型定序].尺寸;
                若 (容薄 >= 8) 累加低 = 8; 否 若 (容薄 >= 4) 累加低 = 4; 否 若 (容薄 >= 2) 累加低 = 2; 否 累加低 = 1;
            }
        }
        词位++;
    }
    循环 (词型表[词位] == 左方) { /* 数组 T[N]: 对齐=元素对齐(已算), 消费 [N] */
        词位++;
        若 (词型表[词位] == 常数 || 词型表[词位] == 词变量) 词位++;
        若 (词型表[词位] == 右方) 词位++;
    }
    返 累加低;
}

/* A22 (2026-09-11) _Generic 类型码: 低 4 位 = 基类 (0整 1字 2短 3长 4双 5无符号 6保留 7构 8空/其他 9函数指), 高 位 = 16*指针层级.
   非指针 码 = 基类 (0..9, 与 旧 粗 kind 兼容); 指针 码 = 基类 + 16*深 (深>=1).
   旧 粗 kind 只 分 「指针/非指针」 → 任意 指针 互 匹配 (字符* 命中 整数* 分支), 数组 不 衰减, 层级 不 参与; 本 码 全部 精确. */
静 整 尺寸基码(整 元) { 若 (元 == 1) 返 1; 若 (元 == 2) 返 2; 若 (元 == 8) 返 3; 返 0; } /* 元素 字节 尺寸 → 基类 (4=整) */
静 整 名基码(常 字 *名) { /* 类型 词 名 → 基类 (-1=未知) */
    若 (!名 || !名[0]) 返 -1;
    若 (((!比较字符串(名, "char") || !比较字符串(名, "字")) || !比较字符串(名, "字节")) || !比较字符串(名, "_Bool")) 返 1;
    若 ((!比较字符串(名, "short") || !比较字符串(名, "短"))) 返 2;
    若 (((!比较字符串(名, "double") || !比较字符串(名, "双")) || (!比较字符串(名, "float") || !比较字符串(名, "单")))) 返 4;
    若 ((!比较字符串(名, "unsigned") || !比较字符串(名, "无")) || !比较字符串(名, "无整")) 返 5;
    若 ((!比较字符串(名, "long") || !比较字符串(名, "长")) || !比较字符串(名, "长整")) 返 3;
    若 ((!比较字符串(名, "void") || !比较字符串(名, "空"))) 返 8;
    若 ((!比较字符串(名, "int") || !比较字符串(名, "整"))) 返 0;
    返 -1;
}
静 整 变量基登(常 字 *数) { /* A22: 声明期 登记 的 类型码+1 (0 = 未登记) — 解 空 指针/无符号 指针/函数指 等 元数据 判 不 出 的 情形 */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量指基[计];
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量指基[计];
    返 0;
}
静 整 声明基码(整 构序, 整 空标, 整 浮标, 整 字符标, 整 短标, 整 无符号标, 整 长标) { /* A22: 声明期 类型 词 标 → 基类码 */
    若 (构序 >= 0) 返 7;
    若 (空标) 返 8;
    若 (浮标) 返 4;
    若 (无符号标) 返 5; /* 无符号 优先 (无符号 字符* = 5, 与 中十 的 无符号 优先 一致) */
    若 (字符标) 返 1;
    若 (短标) 返 2;
    若 (长标) 返 3;
    返 0;
}
静 空 变量基登写(常 字 *数, 整 码) { /* A22: 按 名 回写 最近 可见 条目 (变偏指 可能 复用 旧条目 → 直接 写 变量数-1 会 写错 变量) */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) { 变量指基[计] = 码 + 1; 返; }
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) { 变量指基[计] = 码 + 1; 返; }
}
/* R246-C2 (2026-09-22): **「名 涉浮」单一出口** —— 结构性收口第一刀。
   `变量是否浮(名) || 变量指浮(名)`（「名 与 浮点 相关」）在全源抄了 18 遍，
   是 R231~R245 十五站「同族漏 N-1 份」的最大一处重复源。
   收口后：**「名 与 浮点 相关」的定义只此一处** —— 新增维度（单精度/长整/短整）改这里即全源跟随。
   等价性：函数体 = `变量是否浮`（标量侧，含 数组名 守卫）+ `变量指浮`（指针侧，含 全局 回退）。 */
/* R246-C4a (2026-09-22): **指针声明 的 元数据 + 基类码 合成 单一登记出口**.
   由来: R233 收了「元数据」(指针元尺寸/指针元补), R244 又给漏掉的 1 条路径补了
   `变量基登写`(A22 基类码) —— 但 两者 仍是 **两次 独立 调用** ⟹ 调用点 **可以 只写一半**
   (R244 的 病人 正是: 写了 指针元补, 漏了 变量基登写).
   本函数 把 两者 合成 **一个** 调用 ⟹ **只写一半 在 结构上 不可能**.
   ⚠️ 定义 必须 在 `变量基登写` 之后 (单遍编译器 不能 前向 引用).
   等价性: 两被调 写 不同 字段 (变量表[序] 元数据 / 变量指基[计] 基类码), 顺序 无关. */
静 空 指针登记(整 序, 整 整得, 整 元尺寸, 整 型定指元素, 整 型定指构序, 整 指深一, 常 字 *名, 整 基类码) {
    指针元补(序, 整得, 元尺寸, 型定指元素, 型定指构序, 指深一);
    若 (基类码 >= 0) 变量基登写(名, 基类码);
}
静 整 浮名(常 字 *名) {
    返 (变量是否浮(名) || 变量指浮(名)) ? 1 : 0;
}
静 整 变量指浮查(常 字 *数) { /* A22: 同 变量指浮 但 含 文件级 全局 回退 (变量指浮 只 看 当前 函数 → 全局 双精度 指针 基类 判 成 整数) */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].指浮;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].指浮;
    返 0;
}
静 整 变量指深查(常 字 *数) { /* A22: 同 变量指深 但 含 全局 回退 */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].指深;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].指深;
    返 0;
}
静 整 变量指内查(常 字 *数) { /* A22: 同 正己(指内) 但 含 全局 回退 */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].指内;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].指内;
    返 0;
}
静 整 指元指针(整 节) { /* C1 第三层·判据收口 (2026-09-26 启元 · round 46): 该节点是否「指针数组元素」—— 用于在 比较/减法/转型 语境把这类节点从浮点通道排除 (它们的值在 rax 不在 xmm0; L7775 因元素指向浮点而误置 节浮标 导致走浮点). 判据 = 单层下标 & 基是变量 & 该变量「数组>0 && 指深>=1」(第 356 站载体). */
    若 (节 < 0 || 节型别[节] != 节点_下标) 返 0;
    整 基中 = 子0[节]; 若 (基中 < 0 || 节型别[基中] != 节点_变量) 返 0;
    字 *名中 = (字*)(节名表 + 基中);
    若 (变量数组(名中) > 0 && 变量指深查(名中) >= 1) 返 1;
    若 (变量指深查(名中) >= 2) 返 1; /* C1/C2 (2026-09-28 虾米 · 判据 A/批A): 补【裸多级指针变量】—— `单精度 **fk` 的 `fk[i]` 结果**仍是指针** (值在 rax, 不是浮点/标量), 但原判据要求「变量是数组」(`变量数组 > 0`) ⟹ 裸指针变量恒不认. 后果链 (插桩 [C12-A] 铁证, p2.c 全节点): `指元指针` 恒 0 → 且 `节点指元素(下标)=0` / `表达式指深(下标)=0` (两条对下标形态均无分支) ⟹ L23223 六项前提全假 ⟹ **根本不进 64 位路径** ⟹ 落 32 位无缩放 ⟹ 指针差返回**字节差** (实测 `fk[1]-fk[0]` 甲言 8 / gcc 2; `&farr[1][1]-&farr[0][1]` 甲言 8 / gcc 2). 对照 `静 单精度 *farr[2]` (数组名) ⟹ `变量数组=2>0` ⟹ 前提成立 ⟹ 归一正确 — 这就是「D1 对 / D2 错」的唯一差别. 判据取 `指深 >= 2` ⟹ 下标解一层后仍是指针; 单级指针 (`指深 1`) 不触发 (其下标结果是标量, 本不该缩放). */
    返 0;
}
静 整 变量基码(常 字 *数) { /* A22: 变量 所指 基类 (派生路径 — 未 登记 类型码 的 声明 形态) */
    若 (变量型序(数) >= 0) 返 7;
    若 (((变量是否浮(数) || 变量指浮查(数)) || 变量单标(数)) || 变量指单(数)) 返 4;
    若 (变量是否无符号(数)) 返 5;
    若 (变量是否字符(数)) 返 1;
    若 (变量是否短(数)) 返 2;
    若 (变量是否长(数)) 返 3;
    整 元 = 变量指内查(数); 若 (元 == 0) 元 = 变量指元素(数);
    若 (元 == 1) 返 1; 若 (元 == 2) 返 2; 若 (元 == 8) 返 3;
    返 0;
}
静 整 变量是函指(常 字 *数) { /* A22: 函数指 变量/参数 (无 指深/登记, 但 指元素=4 而 元素 宽=8) — 不 冒充 数据 指针 */
    若 ((变量指深查(数) > 0 || 变量数组(数) > 0) || 变量基登(数) > 0) 返 0;
    返 (变量指元素(数) == 4 && 变量元素(数) == 8);
}
/* _Generic 控制表达式 类型码 (A22 精确化) */
静 整 旁系(整 数) {
    若 (数 < 0) 返 8;
    若 (节指元[数] > 0) 返 节指元[数] - 1; /* A22: (T*) 转型 的 精确 码 优先 (控制表达式 可能 是 被 转型 的 变量) */
    整 暂 = 节型表[数];
    若 (暂 == 终简) 返 4; /* 双精度 字面量 */
    若 (暂 == 0) { 返 节点类型码(数); /* 第 167 站: 收口 为 读侧权威 */ } /* 整数 字面量 — 修复 2026-08-27 特性#5: 邻辰 字面量节点标记是 节长标[n] (原 词长表[n] 是 词法器 词元 数组, 恒 0 → 42邻辰 选成 整数); 修复 2026-08-27 特性#concepts: 节浮标[n] → (双精度)0 转型 后字面量节点判 双精度; A22: 指元素[n]>0 → (T*)0 转型 后 按 元素 尺寸 推 基类 + 16 (指针, 深 1) */
    若 (暂 == 1) {
        字 *变节 = (字*)(节名表 + 数);
        整 登 = 变量基登(变节);
        整 深 = 变量指深查(变节);
        若 (深 == 0 && (变量数组(变节) > 0 || 登 > 0)) 深 = 1; /* A22: 数组 名 衰减 为 指针 (字符 数组 原 先 命 中 是否字符 → 粗 1, 整数 数组 却 因 变量数组>0 → 粗 6, 两 者 不一致); 登>0 = 声明期 记 过 类型码 的 单指针 (全局/参数 路径 不 记 指深) */
        若 (深 == 0 && 变量指元素(变节) > 0 && 变量型序(变节) < 0 && !变量是函指(变节)) 深 = 1; /* A22 兜底: 有 元素 尺寸 且 非 结构体/函数指 的 路径 (遍-声明 指针 等 未 登记 路径); 结构体 值 参数 型序>=0 已 排除 */
        若 (深 > 0) 返 (登 > 0 ? 登 - 1 : 变量基码(变节)) + 16 * 深; /* A22: 指针 → 「基类 + 16*层级」 精确 码 */
        若 (变量是函指(变节)) 返 9; /* A22: 函数指 不 冒充 数据 指针 (旧 判 指针 会 命中 整数* 分支) */
        返 变量基码(变节); /* A22: 非 指针 — 同一 基类 派生 (结构体 7 / 双 4 / 无符号 5 / 字符 1 / 短 2 / 长 3 / 整数 0), 与 中十 优先序 一致 */
    }
    若 (暂 == 4) { /* 调用: 被调者 节点 子0 是函数名 */
        整 号对 = 子0[数]; 若 (号对 < 0) 返 8;
        字 *函 = (字*)(节名表 + 号对);
        若 (查函数浮返(函) || 终陆(函) >= 0 || 序贰(函) == 2) 返 4;
        若 (查函数长返(函) || 序贰(函) == 1) 返 3;
        返 0;
    }
    若 (暂 == 19) { 返 节点类型码(数); /* 第 167 站: 收口 为 读侧权威 */ } /* 转型 截断节点 — 修复 2026-08-27 特性#concepts: 节浮标[n] → (双精度) 转型 判 双精度; A22: 指元素[n]>0 → 指针 码 */
    若 (暂 == 10) 返 旁系(子0[数]); /* 赋值: lhs 类型 */
    若 (暂 == 14) { 整 元码 = 旁系(子0[数]); 若 (元码 >= 16) 返 元码 - 16; 返 元码; } /* 数组[i]/指针[i]: 元素类型 — A22: 指针 降 一 层 (原 直接 返 指针 粗 6, 元素 类型 丢) */
    若 (暂 == 2) { /* binop 结果类型 */
        整 算子 = 节值表[数];
        若 (算子 == 逻辑与 || 算子 == 逻辑或 || 算子 == 比等 || 算子 == 名庚 || 算子 == 比小 || 算子 == 外三 || 算子 == 隔系 || 算子 == 宽排) 返 0; /* 比较/逻辑 → 整数 */
        若 (算子 == 帧寅 || 算子 == 号庚) 返 旁系(子0[数]); /* 移位: 左操作数 */
        整 暂利 = 旁系(子0[数]), 符拾 = 旁系(子1[数]);
        若 (暂利 >= 16) 返 暂利; /* A22: 指针 算术 (p+n / p-n) 保持 指针 类型 */
        若 (符拾 >= 16) 返 符拾;
        若 (暂利 == 4 || 符拾 == 4) 返 4;
        若 (暂利 == 3 || 符拾 == 3) 返 3;
        若 (暂利 == 5 || 符拾 == 5) 返 5;
        返 0;
    }
    返 8;
}
/* _Generic 关联类型解析 → 类型码 (低 4 位 基类, 高 位 16*指针层级); -1 解析失败.
   A22 (2026-09-11): 原 只 返 粗 kind 且 空* 分支 消费 型词 后 直接 返 8 不 消费 `*` → 该 分支 的 关联表达式 被 解析成 `* 值` 解引用 → 取值 静默 垃圾; 现 统一 词序 循环 + 数 乘. */
静 整 中十(空) {
    若 (词型表[词位] == 乘) { 循环 (词型表[词位] == 乘) 词位++; 返 8 + 16; } /* 前导 * (非常规 写法): 指针, 基 未知 */
    若 (词型表[词位] == 型词) {
        整 基 = -1; 整 深 = 0;
        循环 (词型表[词位] == 型词) { /* 多 词 类型 (无符号 长整 长整 / 常量 字符 …) — 限定符 名基码 返 -1 自动 跳过 */
            整 当基 = 名基码(词名表[词位]);
            若 (当基 >= 0 && (基 < 0 || 当基 == 5)) 基 = 当基; /* 无符号 优先 覆盖 有符号 同宽 词 (无符号 长整 长整 → 5) */
            词位++;
        }
        若 (基 < 0) 基 = 8; /* 其他 型词 (非 基础 类型 名) */
        循环 (词型表[词位] == 乘) { 深++; 词位++; 循环 (词型表[词位] == 型词 && ((!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常")) || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")) || !比较字符串(词名表[词位], "restrict"))) 词位++; } /* 指针 层级 + * 间 限定符 */
        返 基 + 16 * 深;
    }
    若 (词型表[词位] == 结构词) { 词位++; 若 (词型表[词位] == 词变量) 词位++; 整 深 = 0; 循环 (词型表[词位] == 乘) { 深++; 词位++; } 返 7 + 16 * 深; } /* 结构体 */
    若 (词型表[词位] == 枚词) { 词位++; 若 (词型表[词位] == 词变量) 词位++; 整 深 = 0; 循环 (词型表[词位] == 乘) { 深++; 词位++; } 返 0 + 16 * 深; } /* 枚举 → 整数 */
    若 (词型表[词位] == 词变量) { /* 类型定义 */
        整 型定序 = 型定查(词名表[词位]);
        若 (型定序 >= 0) {
            整 基 = 0;
            若 (型定表[型定序].是否构标) 基 = 7;
            否 若 (型定表[型定序].是否函数指) 基 = 9;
            否 若 (型定表[型定序].是否浮标) 基 = 4;
            否 若 (型定表[型定序].尺寸 == 8) 基 = 型定表[型定序].无符号标 ? 5 : 3;
            否 若 (型定表[型定序].尺寸 == 1) 基 = 1;
            否 若 (型定表[型定序].尺寸 == 2) 基 = 2;
            否 若 (型定表[型定序].无符号标) 基 = 5;
            词位++; 整 深 = 0; 循环 (词型表[词位] == 乘) { 深++; 词位++; }
            返 基 + 16 * 深;
        }
        词位++;
        返 8;
    }
    返 -1;
}

/* A8刀2 (2026-09-24 第 264 站): **typedef 别名表（收窄版）** —— 零预扫, 边走边收.
   病灶: 括声一 只认 前词 == 型词 ⟹ `typedef 结构体 S T; T (t1);` 的 T 是 词变量 ⟹ 不归约.
   上一版(已回退) 用「词法器预扫全文本取最后标识符」⟹ 函数指针 typedef `typedef void *(*q1)(void *p);`
     的最后标识符 = 参数名 `p` ⟹ 参数名被当类型名 ⟹ `p (` 形态误归约 ⟹ 实测 30 锚回归.
   本刀 收窄三条: ① 边走边收 (注释/字符串 天然不入账, 零预扫 ⟹ 无性能代价)
     ② 语句内 遇 `(`/`[` 即 作废 (函数指针/数组 别名 一律不认)
     ③ 只在 花括号深度 0 的 `;` 登记 ⟹ `typedef 结构体 S { ... } T;` 正确取 T. */
字 别名名[128][64]; 整 别名数 = 0;
静 整 是型词名(常 字 *名) {
    若 (!比较字符串(名, "typedef") || !比较字符串(名, "struct") || !比较字符串(名, "union") || !比较字符串(名, "enum")) 返 1;
    若 (!比较字符串(名, "const") || !比较字符串(名, "volatile") || !比较字符串(名, "unsigned") || !比较字符串(名, "signed")) 返 1;
    若 (!比较字符串(名, "int") || !比较字符串(名, "char") || !比较字符串(名, "short") || !比较字符串(名, "long")) 返 1;
    若 (!比较字符串(名, "float") || !比较字符串(名, "double") || !比较字符串(名, "void") || !比较字符串(名, "_Bool")) 返 1;
    若 (!比较字符串(名, "bool") || !比较字符串(名, "restrict") || !比较字符串(名, "inline")) 返 1;
    若 (!比较字符串(名, "整") || !比较字符串(名, "字") || !比较字符串(名, "短") || !比较字符串(名, "长") || !比较字符串(名, "长整")) 返 1;
    若 (!比较字符串(名, "单") || !比较字符串(名, "双") || !比较字符串(名, "空") || !比较字符串(名, "构") || !比较字符串(名, "联")) 返 1;
    若 (!比较字符串(名, "枚") || !比较字符串(名, "常") || !比较字符串(名, "易失") || !比较字符串(名, "无") || !比较字符串(名, "有符号")) 返 1;
    若 (!比较字符串(名, "类型定义")) 返 1;
    返 0;
}
静 整 是别名(常 字 *名) {
    整 甲 = 0;
    循环 (甲 < 别名数) { 若 (!比较字符串(别名名[甲], 名)) 返 1; 甲++; }
    返 0;
}
静 空 加别名(常 字 *名) {
    若 (别名数 >= 128) 返;
    若 (名[0] == 0) 返;
    若 (是型词名(名)) 返;
    若 (是别名(名)) 返;
    复制字符串(别名名[别名数], 名);
    别名数++;
}
/* A8 (2026-09-23 第 260 站): **括号声明符 前瞻** —— `类型词 ( 标识符 )` 形态.
   返 1 = 应归约 (词法器 不发射 这对括号, 名字照常发射 ⟹ 词表里 `( 名 )` 天然成 `名`).
   ⚠️ 本判据 **不认 typedef 别名** (词法阶段 型定表 尚空) ⟹ `T (t1)` 那格 本刀 不修.
   起始字符只排除 `)`/`(`/`,`/`;` + 空白; 之后 遇 `(`/`,`/`;`/`*`/`[`/`=` 即 判非单标识符. */
静 整 括声一(常 字 *串值, 整 计) {
    整 乙 = 计 + 1;
    循环 (串值[乙] == ' ' || 串值[乙] == '\t' || 串值[乙] == '\r' || 串值[乙] == '\n') 乙++;
    若 (串值[乙] == 0 || 串值[乙] == ')' || 串值[乙] == '(' || 串值[乙] == ',' || 串值[乙] == ';') 返 0;
    循环 (串值[乙] && 串值[乙] != ' ' && 串值[乙] != '\t' && 串值[乙] != '\r' && 串值[乙] != '\n' && 串值[乙] != ')') {
        若 (串值[乙] == '(' || 串值[乙] == ',' || 串值[乙] == ';' || 串值[乙] == '*' || 串值[乙] == '[' || 串值[乙] == '=') 返 0;
        乙++;
    }
    循环 (串值[乙] == ' ' || 串值[乙] == '\t' || 串值[乙] == '\r' || 串值[乙] == '\n') 乙++;
    返 (串值[乙] == ')');
}
静 空 词法(常 字 *串值) {
    整 计 = 0; 词序 = 0; 词位 = 0; 整 半壬 = 0; 整 当前行 = 1; 整 跳发一 = 0, 吞右括 = 0; 整 收别名 = 0, 别名废 = 0, 别名深 = 0; 字 别名缓[64]; 别名缓[0] = 0; /* A8刀2: 收别名 = 正在 typedef 语句内; 别名废 = 本语句作废; 别名深 = 花括号深度 */ /* A8: 归约 用 —— 跳发一 = 本次 不 发射; 吞右括 = 待吞 配对 `)` */ /* 修复 2026-08-05: 未知字符计数, 词法 结束汇报; 接入 2026-08-28: 行号追踪 (词行表[词序]=当前行) */
    循环 (串值[计] && 词序 < 词容量) {
        循环 (串值[计] == ' ' || 串值[计] == '\n' || 串值[计] == '\t' || 串值[计] == '\r' || 串值[计] == '\f' || 串值[计] == '\v') { 若 (串值[计] == '\n') 当前行++; 计++; } /* 修复 2026-08-13 第三阶段: \f/\v 是合法空白 — 漏掉会落入 开关 缺省 发射 词型表=0(词终) 幽灵 词元, 中间截断 解析 (regex_internal.c 第40行 \f); 接入 2026-08-28: 数换行更新 当前行 */
        若 (!串值[计]) 断;
        若 (顺一 && 串值[计] != '#') { 若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) { 若 (串值[计] == '\n') 当前行++; 计++; } 若 (串值[计]) 计 += 2; 否 输出到文件(错误流, "[WARN] 词法: 注释未闭合 (文件结束时仍在块注释内) — 其后内容被当注释吞掉\n"); 续; } /* 修复 2026-08-26 解析器: 跳过区内块注释整体跳到闭合符 — pyconfig.h 注释里含条件指令示例文本, 逐行跳过会把注释内容当真指令 → 条件栈失衡 → 守卫 endif 关错层; 接入 2026-08-28: 块注释内换行数 当前行 (位置.行 精确) */ 循环 (串值[计] && 串值[计] != '\n') 计++; 续; } /* 假 分支: 跳过 整体 代码 行 (修复 2026-08-05) */
        若 (串值[计] == '/' && 串值[计 + 1] == '/') { 循环 (串值[计] && 串值[计] != '\n') 计++; 续; }
        若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) { 若 (串值[计] == '\n') 当前行++; 计++; } 若 (串值[计]) 计 += 2; 否 输出到文件(错误流, "[WARN] 词法: 注释未闭合 (文件结束时仍在块注释内) — 其后内容被当注释吞掉\n"); 续; } 若 (串值[计] == '*' && 串值[计 + 1] == '/') { 输出到文件(错误流, "[ERR] 词法: 游离的 注释结束符 (星号紧跟斜杠, 但不在块注释内) 行 %d — 已终止编译 (原: 静默 拆成 乘号 与 除号 两词元 继续, 后续 常以「未找到 主 入口」这类 不精确 诊断 收场), 请检查注释配对\n", 当前行); 退出(1); } /* F 闭环 (2026-09-28 虾米 · 批次 D): R355 当初只加 WARN (宽松词法, 零行为改变) 而 不终止 ⇒ 真正的错误 (注释配对错) 被 后续 语法错 掩盖, 诊断 不精确 (实测 F 探针: 注释里 出现 星号紧邻 斜杠 ⇒ 原报 2 条 WARN + 「未找到 主 入口」; 今报 本条 ERR 即止). 升级为 ERR + 立即终止 ⇒ 错误 早报、精确。文案 不含 注释 起止符 (沿用 R355 记录 的 工艺条: 甲言 词法 不区分 字符串 与 注释)。 */ /* R355 F 第二步 (宽松词法): 块注释外 出现 注释结束符 — 原 静默 拆成 乘号 与 除号 两词元 (常 导致 后续 语法错 而 无 线索). 本刀 只 追加 诊断, 不 改变 词法行为 零回归 (镜像 R332 的 未闭合 注释 告警). 注: 诊断文案 不可 含 注释起止符 字面量 —— 甲言 词法 不区分 字符串 与 注释, 文案里 写出 起止符 会 提前 终止 本注释 (本轮 首次 实现 即 因此 编译失败, 已 记为 工艺条). */ /* 接入 2026-08-28: 块注释内换行数 当前行 (位置.行 精确) */
        若 (串值[计] == '#') { /* #定义 名 值 / #包含 / conditional 编译 (修复 2026-08-05: #ifdef/#若无定义/#若/#elif/#否则/#endif) */
            整 元 = 计 + 1; 循环 (串值[元] == ' ' || 串值[元] == '\t') 元++; /* 修复 2026-08-13 第三阶段: # 后空白 (glibc 缩进指令 #  定义) */
            整 内戊 = ((!比前n(串值 + 元, "define", 6) && (串值[元 + 6] == 0 || 串值[元 + 6] == ' ' || 串值[元 + 6] == '\t' || 串值[元 + 6] == '\r' || 串值[元 + 6] == '\n')) || (!比前n(串值 + 元, "定义词", 9) && (串值[元 + 9] == 0 || 串值[元 + 9] == ' ' || 串值[元 + 9] == '\t' || 串值[元 + 9] == '\r' || 串值[元 + 9] == '\n')));
            整 是否条件编译 = ((!比前n(串值 + 元, "ifdef", 5) && (串值[元 + 5] == 0 || 串值[元 + 5] == ' ' || 串值[元 + 5] == '\t' || 串值[元 + 5] == '\r' || 串值[元 + 5] == '\n')) || (!比前n(串值 + 元, "若有定义", 12) && (串值[元 + 12] == 0 || 串值[元 + 12] == ' ' || 串值[元 + 12] == '\t' || 串值[元 + 12] == '\r' || 串值[元 + 12] == '\n')));
            整 外二 = ((!比前n(串值 + 元, "ifndef", 6) && (串值[元 + 6] == 0 || 串值[元 + 6] == ' ' || 串值[元 + 6] == '\t' || 串值[元 + 6] == '\r' || 串值[元 + 6] == '\n')) || (!比前n(串值 + 元, "若无定义", 12) && (串值[元 + 12] == 0 || 串值[元 + 12] == ' ' || 串值[元 + 12] == '\t' || 串值[元 + 12] == '\r' || 串值[元 + 12] == '\n')));
            整 序粗 = !比前n(串值 + 元, "if", 2) && !是否条件编译 && !外二 && (串值[元 + 2] == 0 || 串值[元 + 2] == ' ' || 串值[元 + 2] == '\t' || 串值[元 + 2] == '\r' || 串值[元 + 2] == '\n');
            整 下环 = !比前n(串值 + 元, "elif", 4) && (串值[元 + 4] == 0 || 串值[元 + 4] == ' ' || 串值[元 + 4] == '\t' || 串值[元 + 4] == '\r' || 串值[元 + 4] == '\n');
