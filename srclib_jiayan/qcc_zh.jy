        }
        若 (级丙 >= 1 && 探丙 < 词容量 && 词型表[探丙] == 词变量 && 探丙 + 1 < 词容量
            && (词型表[探丙 + 1] == 赋号 || 词型表[探丙 + 1] == 分号 || 词型表[探丙 + 1] == 左方)) {
            整 构丙 = 查类型(词名表[词位]);
            若 (可空本) 可空针 = 槽丙;
            词位 += 1 + 级丙; /* 标签名 + N 个 `*` ⇒ 变量名 */
            字 变丙[64]; 复制字符串(变丙, 词名表[词位]); 词位++; /* 变量名 ⇒ = / ; / [ */
            整 元丙 = 建节(7);
