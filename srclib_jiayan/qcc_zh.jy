            /* plain 标识符 */
            若 (*丙 + 名序 + 1 > *容量) { *容量 *= 2; /* 修复 2026-08-13 第三阶段: 倍增替代 +4096 — 提升 分配器 重分配 泄漏旧缓冲, 小步进在 序列器.c 大宏展开时平方级爆堆 */; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] 内存不足 重分配\n"); 退出(1); } 出 = *出指; }
            遍 (整 键 = 0; 键 < 名序; 键++) 出[(*丙)++] = 名存[键];
        } 否 {
            若 (*丙 + 1 > *容量) { *容量 *= 2; /* 修复 2026-08-13 第三阶段: 倍增替代 +4096 — 提升 分配器 重分配 泄漏旧缓冲, 小步进在 序列器.c 大宏展开时平方级爆堆 */; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] 内存不足 重分配\n"); 退出(1); } 出 = *出指; }
            出[(*丙)++] = 段[计++];
        }
    }
    余厚--; /* 修复 2026-08-26 数据库: 位置语义深度 */
    *出指 = 出;
}

/* 泛型定义预扫描 (接入 2026-08-28 机制层 #96): 词法 前扫源码 "泛型 名字(参数) = 函数体;" → 注册 函数宏
   (计进二 在 词法 前文本展开调用, 中文 函数宏 调用按实参类型天然多类型) */
静 空 净集(常 字 *串值) {
    常 字 *指 = 串值;
    循环 (*指) {
        若 (指[0] == '/' && 指[1] == '/') { 循环 (*指 && *指 != '\n') 指++; 续; }
        若 (指[0] == '/' && 指[1] == '*') { 指 += 2; 循环 (*指 && !(指[0] == '*' && 指[1] == '/')) 指++; 若 (*指) 指 += 2; 续; }
        若 (指[0] == '"') { 指++; 循环 (*指 && *指 != '"') { 若 (*指 == '\\') 指++; 指++; } 若 (*指) 指++; 续; }
        若 (指[0] == '\'') { 指++; 循环 (*指 && *指 != '\'') { 若 (*指 == '\\') 指++; 指++; } 若 (*指) 指++; 续; }
        /* 修复 2026-09-01 (泛型崩溃根因): 原 `寻 = 指 + (*寻 == 'd' ? 6 : 9)` 在 寻 定义前解引用 (未初始化 UB) — 泛型 2 汉字 6 字节, 直接 指 + 6 */
        若 (指[0] == '\xe6' && 指[1] == '\xb3' && 指[2] == '\x9b' && 指[3] == '\xe5' && 指[4] == '\x9e' && 指[5] == '\x8b') { /* "泛型" */
            常 字 *寻 = 指 + 6;
            循环 (*寻 == ' ' || *寻 == '\t') 寻++;
            字 名存[64]; 整 净优 = 0; 循环 ((判字母数字((无 字)*寻) || *寻 == '_' || (无 字)*寻 >= 0x80) && 净优 < 63) 名存[净优++] = *寻++;
            名存[净优] = 0;
            若 (名存[0]) {
                整 源癸 = 0, 源无约束 = 0; 遍 (整 计 = 0; 计 < 函数宏数; 计++) 若 (!比较字符串(函数宏表[计].名, 名存)) { 源癸 = 1; 若 (!函数宏表[计].约束[0]) 源无约束 = 1; }
                /* 阶段C-1 #50 泛型特化 (2026-09-01): 先读约束 — 同名多版本: 约束版可并存 + 首个无约束版为缺省 fallback */
                循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                字 约束暂[64]; 约束暂[0] = 0;
                若 (*寻 == ':') {
                    寻++;
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                    整 约束序 = 0; 循环 ((判字母数字((无 字)*寻) || *寻 == '_' || (无 字)*寻 >= 0x80) && 约束序 < 63) 约束暂[约束序++] = *寻++;
                    约束暂[约束序] = 0;
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                }
                整 重扫 = 0; 若 (源癸 && 约束暂[0]) 遍 (整 计 = 0; 计 < 函数宏数; 计++) 若 (!比较字符串(函数宏表[计].名, 名存) && !比较字符串(函数宏表[计].约束, 约束暂)) { 重扫 = 1; 断; } /* #50: 同 名+约束 = 重复定义 (净集 双调用 L1144+L13044), 跳过 */
                若 (!重扫 && (!源癸 || 约束暂[0] || !源无约束) && 函数宏数 < 2048) {
                    复制字符串(函数宏表[函数宏数].名, 名存);
                    余简[函数宏数] = 0;
                    若 (约束暂[0]) 复制字符串(函数宏表[函数宏数].约束, 约束暂);
                    若 (*寻 == '(') { 寻++; 整 圆周率 = 0; 循环 (*寻 && *寻 != ')' && 圆周率 < 16) { 循环 (*寻==' '||*寻=='\t'||*寻==',') 寻++; 若 (*寻==')') 断; 整 寻二=0; 循环 ((判字母数字((无 字)*寻)||*寻=='_'||(无 字)*寻>=0x80) && 寻二<63) 函数宏表[函数宏数].容败[圆周率][寻二++]=*寻++; /* #72: 中文参数名 */ 函数宏表[函数宏数].容败[圆周率][寻二]=0; 若 (*寻=='.' && 寻[1]=='.' && 寻[2]=='.') { 寻 += 3; 复制字符串(变参名[函数宏数], 函数宏表[函数宏数].容败[圆周率]); } /* 阶段C-1 #72 变参模板 (2026-09-01): 名... → 变参收集 (余参逗号连接) */ 圆周率++; /* 修复 2026-08-28: 每次参数后 ++ (参数数 少 1 → 只替换第一个参数) */ 若 (*寻==')') 断; } 若 (*寻==')') 寻++; 函数宏表[函数宏数].参数数=圆周率; }
                    否 函数宏表[函数宏数].参数数 = 0;
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                    若 (*寻 == '=') { 寻++; 循环 (*寻==' '||*寻=='\t') 寻++; }
                    整 发字节 = 0, 深花 = 0; 循环 (*寻 && *寻 != '\n' && 发字节 < 16383) { 若 (*寻 == '{') 深花++; 否 若 (*寻 == '}') { 若 (深花 > 0) 深花--; 否 断; } 否 若 (*寻 == ';' && 深花 == 0) 断; 函数宏表[函数宏数].体[发字节++] = *寻++; } /* #46: 花括号感知 — 结构体类型体 { T 一, 二; } 内 ; 不算终止 (2026-09-01) */
                    函数宏表[函数宏数].体[发字节] = 0;
                    函数宏数++;
                }
            }
            指 = 寻;
            续;
        }
        若 (指[0] == 'i' && 指[1] == 'n' && 指[2] == 'l' && 指[3] == 'i' && 指[4] == 'n' && 指[5] == 'e' && !(判字母数字((无 字)指[6]) || 指[6] == '_')) { /* 2026-09-01 #93 内联 (inline 英文): inline 类型 名(参数) { 返 expr; } → 注册函数宏 (体=expr), 调用点副组 展开; 中文 内联 不在此 (字段名 内联 冲突, L15142 主解析跳过, 普通函数调用不展开) */
            常 字 *寻 = 指 + 6;
            循环 (*寻 == ' ' || *寻 == '\t') 寻++;
            常 字 *名找 = 寻; 常 字 *名存指 = 0; 常 字 *名起 = 0;
            循环 (*名找 && *名找 != '\n' && *名找 != '{') {
                若 ((判字母数字((无 字)*名找) || *名找 == '_' || (无 字)*名找 >= 0x80)) { 若 (!名起) 名起 = 名找; 名存指 = 名找; }
                否 若 (*名找 == '(' && 名存指 && 名找[1] != '*') { 名起 = 0; 断; }
                否 若 (!(判字母数字((无 字)*名找) || *名找 == '_' || (无 字)*名找 >= 0x80)) 名起 = 0;
                名找++;
            }
            若 (*名找 == '(' && 名存指 && !名起) {
