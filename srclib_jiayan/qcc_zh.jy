                字 缺重[512]; 整 戊序 = 0;
                循环 (串值[指] && 串值[指] != '\n' && 戊序 < 510) 缺重[戊序++] = 串值[指++];
                缺重[戊序] = 0;
                输出到文件(错误流, "[ERR] 第%d行 #error: %s\n", 旁亥(串值, 计), 缺重); /* fix 2026-08-06 Task 5.3: 行号定位 */
                退出(1);
            }
            若 (内戊) {
                计 = 元 + (串值[元] == 'd' ? 6 : 9);
                循环 (串值[计] == ' ' || 串值[计] == '\t') 计++;
                字 宏名[64]; 整 旧丁 = 0;
                循环 (判字母数字(串值[计]) || 串值[计] == '_' || ((无 字)串值[计] >= 0x80)) { 若 (旧丁 < 63) 宏名[旧丁++] = 串值[计]; 计++; }
                宏名[旧丁] = 0;
