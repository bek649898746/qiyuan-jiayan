        若 (结构化深度 < 8) 结构化深度++;
        循环 (词型表[词位] != 右花 && 词型表[词位] != 词终) { 若 (词型表[词位] == 分号) { 词位++; 续; } 接子(构块, 语句()); } /* 体 (线程 登记到 构层) */
        若 (词型表[词位] == 右花) 词位++; /* } */
