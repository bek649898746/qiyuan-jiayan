            否 { 整 段未 = (词行表 && 词位 >= 1 && 词位 < 1000000) ? 词行表[词位 - 1] - (剩伴 ? 剩伴 : 反进) : 0; 若 (段未 < 1) 段未 = 1; 节值表[数] = 段未; } /* 源位置: 当前行号 (token 前的行) */
