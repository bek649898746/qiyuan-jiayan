            若 (词型表[词位] == 逗号) 词位++; /* , */
            整 邮箱值 = 赋值级(); /* 消息 */
            若 (词型表[词位] == 分号) 词位++; /* ; */
            字 邮箱H[80], 邮箱T[80], 邮箱C[80], 邮箱Cap[80];
            格式化到串(邮箱H, "__ac_%s_h", 邮箱名); 格式化到串(邮箱T, "__ac_%s_t", 邮箱名);
            格式化到串(邮箱C, "__ac_%s_c", 邮箱名); 格式化到串(邮箱Cap, "__ac_%s_cap", 邮箱名);
            整 邮箱块 = 建节(5);
            整 邮箱变 = 建节(1); 复制内存((字*)(节名表 + 邮箱变), 邮箱C, 32);
            整 邮箱指 = 建节(1); 复制内存((字*)(节名表 + 邮箱指), 邮箱Cap, 32);
            整 邮箱比 = 建节(2); 节值表[邮箱比] = 比小; 接子(邮箱比, 邮箱变); 接子(邮箱比, 邮箱指); /* c < cap */
            整 邮箱若 = 建节(8); 接子(邮箱若, 邮箱比);
            整 邮箱增 = 建节(5);
