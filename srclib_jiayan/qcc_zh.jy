            整 上亥 = 参数个数 > 4 ? 参数个数 - 4 : 0;
            整 双玖 = (己序 >= 0 && (函数表[己序].序布 || (链接模式 && !主薄(串升)))) || (己序 < 0 && 链接模式 && !主薄(串升)); /* extern call in -c mode also user call */
