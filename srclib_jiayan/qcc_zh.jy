                码生成免解引用 = 1;
                码生成(子0[数]);
                码生成免解引用 = 0;
            } 否 {
            字 *变名 = (字*)(节名表 + 子0[数]);
            整 偏移 = 查变量(变名);
             
            若 (偏移 >= 0) {
                若 (变量是否静态(变名)) { 度一(静态位移(偏移, 1) - 1); } /* 静态: &变量 = .数据 地址 (取址 7B) */
                否 {
                    整 全退 = 0;
                    遍(整 变序=0;变序<变量总数();变序++)若(!比较字符串(变量表[变序].名,变名)&&变量表[变序].数组尺寸>0&&变量码生成可见(变序))
                        { 整 元素尺寸=变量表[变序].数组元素尺寸?变量表[变序].数组元素尺寸:4; 整 缓辛=变量表[变序].指元素尺寸?变量表[变序].指元素尺寸:元素尺寸; 偏移 -= 变量表[变序].数组尺寸 * 缓辛; 全退=1; 断; } /* 修复 2026-08-28: &2D数组 用标量元素大小 (同 例 1/10/14) */
                    若 (!全退 && 变量指元素(变名) == 0) { 整 构序 = 变量型序(变名); 若 (构序 >= 0) 偏移 = 变量基(变名, 偏移); } /* 结构体: 偏移 是 结束; 指针变量 (结构体 T *p) 槽位即值存储 — 不减 结构体 大小 (修复 2026-08-18: &值 对 结构体 指针变量原减 尺寸(结构体) → 地址错位 24 → get_multi 写入错槽 → 值 仍 空 → git_configset_get_value 段错误); H1p (2026-09-11): 改 经 变量基 — ≤8B 构值 形参 (素三=1) 槽 起 即 对象 起, 原 无条件 减 尺寸 → &形参 差 一 槽 (实测 `双 *p = &v; 返 *p` = 0) */
