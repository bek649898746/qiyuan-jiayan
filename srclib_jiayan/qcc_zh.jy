                    若 (全退) { 若 (新属 >= 0 && (变量表[新属].元列 > 0 || 变量表[新属].双伍 > 0)) { 移寄存器帧64(0, 偏移 - 当前帧大小); } /* 修复 步三十/31: 对齐数组/变长数组 — 地址槽存运行时基址 */ 否 取帧址(0, 基 - 当前帧大小); }
