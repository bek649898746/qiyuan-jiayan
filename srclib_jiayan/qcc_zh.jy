    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
静 整 短六一(整 值丙) { 若 (值丙 == 1) 返 0; 若 (值丙 == 2) 返 1; 若 (值丙 == 8) 返 2; 返 3; }
静 空 总辛一(空) { 汇发("    浮加 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x58); 发字节(0xC1); }
静 空 整进(空) { 汇发("    浮减 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x5C); 发字节(0xC1); }
静 空 容甲(空) { 汇发("    浮乘 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x59); 发字节(0xC1); }
静 空 末一一(空) { 汇发("    浮除 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x5E); 发字节(0xC1); }
静 空 旧挂(空) { 汇发("    整转浮 xmm0, eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x2A); 发字节(0xC0); }
静 空 现简(空) { 汇发("    浮转整 eax, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x2C); 发字节(0xC0); }
静 空 长对(空) { 汇发("    浮转整64 rax, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2C); 发字节(0xC0); } /* cvttsd2si rax, xmm0 — (long long)double 64位截断 (fix 2026-08-25 bug#26: 原 32位 cvttsd2si eax → 零扩展到 LL → -5.0 得 4294967291) */
静 空 压浮0(空) { 汇发("    压浮 xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x81); 发字节(0xEC); 发四(8); 发字节(0xF2); 发字节(0x0F); 发字节(0x11); 模字节(0, 0, 4); 发字节(0x24); } /* sub rsp,8; movsd [rsp], xmm0 (bare sub: avoid double ASM) */
静 空 弹浮0(空) { 汇发("    弹浮 xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0, 0, 4); 发字节(0x24); 发字节(0x48); 发字节(0x81); 发字节(0xC4); 发四(8); } /* movsd xmm0, [rsp]; add rsp,8 (bare add) */
静 空 值凶(空) { 汇发("    浮比较 xmm0, xmm1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x0F); 发字节(0x2F); 发字节(0xC1); } /* set flags: xmm0 vs xmm1 */
静 空 右再(整 位移) { 汇发("    浮取静 xmm0, [rip%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 发字节(0x05); 发四(位移); } /* movsd xmm0, [rip+disp] */
静 空 新十一(整 位移) { 汇发("    浮存静 [rip%+d], xmm0\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x11); 发字节(0x05); 发四(位移); } /* movsd [rip+disp], xmm0 */
静 空 移栈寄存器64(整 位移, 整 寄存器) {
