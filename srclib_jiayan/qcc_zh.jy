                汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0x8A);模字节(0,0,1); /* mov al, [r9] */
                汇发("    写字节 [r8], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0x88);模字节(0,0,0); /* mov [r8], al */
                汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0xFF);模字节(3,0,0); /* inc r8 */
                汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0xFF);模字节(3,0,1); /* inc r9 */
                汇发("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0xFF);模字节(3,1,2); /* dec r10 */
