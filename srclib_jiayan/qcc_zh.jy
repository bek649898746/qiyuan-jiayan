静 构 { 字 名[64]; 整 是否构标; 字 构名一[64]; 字 是否浮标;
                 字 是否函数指; 字 函数指浮; 字 无符号标; 整 尺寸; 整 数组数一; } 型定表[512]; 静 整 型定数; /* sz: 基类型字节大小 (fix 2026-08-17: typedef 字段大小); arr_n: typedef 数组元素数 (fix 2026-08-27 特性#2: typedef int arr_t[3] — sizeof(arr_t)=12, 变量声明按数组) */

__attribute__((原粗))
静 整 型定查(常 字 *数) {
    遍 (整 计 = 0; 计 < 型定数; 计++) 若 (!比较字符串(型定表[计].名, 数)) 返 计;
    返 -1;
}
/* struct type index for a typedef name that aliases a struct (else -1) */
静 整 容成(常 字 *数) {
    整 计 = 型定查(数);
    若 (计 >= 0 && 型定表[计].是否构标) 返 查类型(型定表[计].构名一);
    返 -1;
}
__attribute__((原粗))
静 空 型定加(常 字 *数, 整 全对, 常 字 *符号数, 整 是否浮标, 整 容薄, 整 无符号标) {
    若 (型定数 >= 512) 返;
    /* check for duplicate */
    遍 (整 计 = 0; 计 < 型定数; 计++) 若 (!比较字符串(型定表[计].名, 数)) 返;
    复制字符串(型定表[型定数].名, 数);
    型定表[型定数].是否构标 = 全对;
    型定表[型定数].是否浮标 = (字)是否浮标;
    型定表[型定数].无符号标 = (字)无符号标;
    型定表[型定数].是否函数指 = 0;
    型定表[型定数].函数指浮 = 0;
    型定表[型定数].尺寸 = 容薄; /* fix 2026-08-17 */
    型定表[型定数].数组数一 = 0;
    若 (符号数) 复制字符串(型定表[型定数].构名一, 符号数);
    型定数++;
}
/* fnptr typedef: typedef int (*fp_t)(int,int); — 8-byte element, never a double slot */
静 空 型定加函数指(常 字 *数, 整 返浮) {
    若 (型定数 >= 512) 返;
    遍 (整 计 = 0; 计 < 型定数; 计++) 若 (!比较字符串(型定表[计].名, 数)) 返;
    复制字符串(型定表[型定数].名, 数);
    型定表[型定数].是否构标 = 0;
    型定表[型定数].是否浮标 = 0; /* fnptr is a POINTER, not a double value */
    型定表[型定数].无符号标 = 0;
    型定表[型定数].是否函数指 = 1;
    型定表[型定数].函数指浮 = (字)(返浮 ? 1 : 0); /* double-returning fnptr: fp(x) yields xmm0 */
    型定表[型定数].尺寸 = 8; /* fix 2026-08-27 特性#2: sizeof(fnptr typedef) 原 0 */
    型定表[型定数].构名一[0] = 0;
    型定数++;
}

