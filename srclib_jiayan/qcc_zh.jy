        若 (词型表[词位] == 串词) { 消息序标 = 词值表[词位]; 词位++; }
        若 (词型表[词位] == 分号) 词位++;
        字 堆平[160]; 若 (消息序标 >= 0) 格式化到串(堆平, "%s %%s\n", 缓属); 否 格式化到串(堆平, "%s\n", 缓属); /* 第 171 站 根治: 原 恒 带 `%%s` 而 无消息时 不 加 实参 ⟹ printf("[分类] %s\n") 无参 ⟹ `%s` 读 垃圾指针 ⟹ 崩 0xC0000005 (实测 `可恢复错误;` 崩) */
        若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
        若 (!串表[串数]) 串表[串数] = 短六();
        复制字符串(串表[串数], 堆平);
        整 空吉 = 串数; 串数++;
        整 块 = 建节(5);
        整 呼参 = 建节(4);
        { 整 符号数 = 建节(0); 节值表[符号数] = 空吉; 节型表[符号数] = 串词; 节型别[符号数] = 节点_串词; 接子(呼参, 符号数); }
        若 (消息序标 >= 0) { 整 计七 = 建节(0); 节值表[计七] = 消息序标; 节型表[计七] = 串词; 节型别[计七] = 节点_串词; 接子(呼参, 计七); }
        { 整 缓进 = 建节(1); 复制内存((字*)(节名表 + 缓进), "printf", 7); 接子(呼参, 缓进); }
        接子(块, 呼参);
        若 (净戌一) {
            整 呼隐 = 建节(4); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(呼隐, 壹节); } { 整 下集 = 建节(1); 复制内存((字*)(节名表 + 下集), "exit", 5); 接子(呼隐, 下集); }
            接子(块, 呼隐);
        }
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "传线程")) { /* 接入 2026-08-29 阶段二 #70 Send/同步: 传线程 T; — 编译期检查类型 T 跨线程传递安全 (线程不安全 T 标记 → 拦截) */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 传线程 */
        字 全置[64]; 复制字符串(全置, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        若 (串又(全置)) { /* 第 441 站 #70 (2026-10-02): 原为 输出到文件+退出(1) —— **无错误码** ⟹ 违反 R3。接入 发错误. */
            格式化到串(错缓冲, "线程安全(Send): 类型 '%s' 被标记 `线程不安全 %s;`, 不能跨线程传递 (号合.0 #70 Send/同步 — 先 `线程安全 %s;` 或避免跨线程)", 全置, 全置, 全置); 发错误("A6023", 错缓冲); }
        整 数 = 建节(0); 节值表[数] = 0; 返 数;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "尾调用优化")) { /* 接入 2026-08-29 阶段二 #152 TCO: 尾调用优化; (函数体首行) → 标记当前函数启用尾递归优化 (显式启用, 编译器 自身源码不用 → 自举稳定) */
        词位++; /* 尾调用优化 */
        若 (词型表[词位] == 分号) 词位++;
        若 (单粗 < 65536) 当前函数尾调[单粗] = 1;
        返 建节(5);
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "递归保护")) { /* 接入 2026-08-29 阶段二 #155 深度递归保护: 递归保护 深度; (函数体首行) → { __rec_<单粗>++; 若 (__rec_<单粗> > 深度) { 格式化打印("递归过深\n"); 出口(1); } } + 延迟 递减 (函数退出自动 --) */
        词位++; /* 递归保护 */
        整 当进 = 赋值级(); /* 深度上限 */
        若 (词型表[词位] == 分号) 词位++;
        字 直平[32]; 格式化到串(直平, "__rec_%d_", 单粗); /* 每函数唯一计数器 (静态 全局 整数, 跨调用保持) */
        变量静态(直平, 0); 未初始化移除(直平); /* 2026-08-29 阶段二 #155 修复: 指元素=0 普通 整数 (原 指元素=4 → 指针缩放 ++ 每层 +4 → 误触) */
        整 块 = 建节(5);
        { 整 变右 = 建节(1); 复制内存((字*)(节名表 + 变右), 直平, 32); /* __rec_<单粗>++ */
          整 加节 = 建节(2); 节值表[加节] = 加; 接子(加节, 变右); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(加节, 壹节); }
          整 赋节 = 建节(10); 接子(赋节, 变右); 接子(赋节, 加节); 接子(块, 赋节); }
        { 整 比较 = 建节(2); 节值表[比较] = 外三; { 整 变右 = 建节(1); 复制内存((字*)(节名表 + 变右), 直平, 32); 接子(比较, 变右); } 接子(比较, 当进); /* __rec_<单粗> > 深度 (修复: 计数=深度+1 含根调用, > 使深度N触发/深度N-1允许) */
          整 若序 = 建节(8); 接子(若序, 比较);
          整 块节 = 建节(5);
          若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
          若 (!串表[串数]) 串表[串数] = 短六();
          复制字符串(串表[串数], "\xe9\x80\x92\xe5\xbd\x92\xe8\xbf\x87\xe6\xb7\xb1\n"); /* "递归过深\n" */
          整 呼参 = 建节(4); { 整 符号数 = 建节(0); 节值表[符号数] = 串数; 节型表[符号数] = 串词; 节型别[符号数] = 节点_串词; 接子(呼参, 符号数); } { 整 缓进 = 建节(1); 复制内存((字*)(节名表 + 缓进), "printf", 7); 接子(呼参, 缓进); }
          串数++;
          接子(块节, 呼参);
          整 呼隐 = 建节(4); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(呼隐, 壹节); } { 整 下集 = 建节(1); 复制内存((字*)(节名表 + 下集), "exit", 5); 接子(呼隐, 下集); }
          接子(块节, 呼隐);
          接子(若序, 块节);
          接子(块, 若序); }
        { 整 变右 = 建节(1); 复制内存((字*)(节名表 + 变右), 直平, 32); /* 延迟: __rec_<单粗>-- (函数退出自动递减) */
          整 邻壬 = 建节(2); 节值表[邻壬] = 旧肆; 接子(邻壬, 变右); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(邻壬, 壹节); }
          整 赋节 = 建节(10); 接子(赋节, 变右); 接子(赋节, 邻壬);
          若 (标繁 >= 0 && 标繁 < 4096 && 名捌[标繁] < 64) 末伴[标繁][名捌[标繁]++] = 赋节; }
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "重试")) { /* 接入 2026-08-29 阶段二 #85 错误恢复/重试: 重试 f(), n; → { __rt_n=n; __rt_i=0; 循环(__rt_i<__rt_n){ __rt_r=f(); 若(__rt_r==0){__rt_i=__rt_n;} 否则 {__rt_i++;} } } — 调用返回 0=成功, 失败重试至多 n 次 */
        词位++; /* 重试 */
        整 间退一 = 赋值级(); /* 调用表达式 (返回错误码) */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 终数 = 赋值级(); /* 重试次数 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        静 整 名四 = 0; 字 首甲一[32]; 格式化到串(首甲一, "__rt_n_%d_", 名四++);
        静 整 半辛 = 0; 字 半戊[32]; 格式化到串(半戊, "__rt_i_%d_", 半辛++);
        静 整 左陆二 = 0; 字 单优[32]; 格式化到串(单优, "__rt_r_%d_", 左陆二++);
        变量偏移(首甲一); 变量偏移(半戊); 变量偏移(单优);
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 首甲一, 32); 接子(元, 终数); 接子(块, 元); } /* 整数 __rt_n = n; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 半戊, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(块, 元); } /* 整数 __rt_i = 0; */
        整 环节 = 建节(9);
        { 整 比较 = 建节(2); 节值表[比较] = 比小; { 整 变初 = 建节(1); 复制内存((字*)(节名表 + 变初), 半戊, 32); 接子(比较, 变初); } { 整 变名节 = 建节(1); 复制内存((字*)(节名表 + 变名节), 首甲一, 32); 接子(比较, 变名节); } 接子(环节, 比较); } /* __rt_i < __rt_n */
        整 块节 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 单优, 32); 接子(元, 间退一); 接子(块节, 元); } /* 整数 __rt_r = f(); */
        { 整 若序 = 建节(8); /* 若 (__rt_r == 0) */
          { 整 比较 = 建节(2); 节值表[比较] = 比等; { 整 变右 = 建节(1); 复制内存((字*)(节名表 + 变右), 单优, 32); 接子(比较, 变右); } { 整 零 = 建节(0); 节值表[零] = 0; 接子(比较, 零); } 接子(若序, 比较); }
          整 增节 = 建节(5);
          { 整 赋节 = 建节(10); { 整 变初 = 建节(1); 复制内存((字*)(节名表 + 变初), 半戊, 32); 接子(赋节, 变初); } { 整 变名节 = 建节(1); 复制内存((字*)(节名表 + 变名节), 首甲一, 32); 接子(赋节, 变名节); } 接子(增节, 赋节); } /* __rt_i = __rt_n; */
          接子(若序, 增节);
          整 行壬二 = 建节(5);
          { 整 赋节 = 建节(10); { 整 变初 = 建节(1); 复制内存((字*)(节名表 + 变初), 半戊, 32); 接子(赋节, 变初); } { 整 加节 = 建节(2); 节值表[加节] = 加; { 整 变初二 = 建节(1); 复制内存((字*)(节名表 + 变初二), 半戊, 32); 接子(加节, 变初二); } { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(加节, 壹节); } 接子(赋节, 加节); } 接子(行壬二, 赋节); } /* 否则 __rt_i++; */
          接子(若序, 行壬二);
          接子(块节, 若序); }
        { 整 拷长 = 新标号(); 整 置小 = 建节(20); 节值表[置小] = 拷长 + 1; 接子(块节, 置小); 节值表[环节] = 拷长 + 1; }
        接子(环节, 块节);
        接子(块, 环节);
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "检查取消")) { /* 接入 2026-08-29 阶段二 #67 检查点: 检查取消 t 返回 v; → 若 (t != 0) { 返回 v; } (默认返回 0) */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 检查取消 */
        字 呼名[64]; 复制字符串(呼名, 词名表[词位]); 词位++; /* 标志名 */
        整 旧细 = -1;
        若 (词型表[词位] == 后甲) { 词位++; 旧细 = 赋值级(); } /* 返回 → 后甲 词元 (词法映射) */
        若 (词型表[词位] == 分号) 词位++;
        整 若序 = 建节(8);
        { 整 变暂 = 建节(1); 复制内存((字*)(节名表 + 变暂), 呼名, 32);
          整 零 = 建节(0); 节值表[零] = 0;
          整 计利 = 建节(2); 节值表[计利] = 名庚; 接子(计利, 变暂); 接子(计利, 零); /* t != 0 */
          接子(若序, 计利); }
        整 块节 = 建节(5);
        { 整 邻轮 = 建节(6);
          若 (旧细 >= 0) 接子(邻轮, 旧细);
          否 { 整 零 = 建节(0); 节值表[零] = 0; 接子(邻轮, 零); }
          接子(块节, 邻轮); } /* 返回 v/0; */
        接子(若序, 块节);
        返 若序;
    }
    若 (词型表[词位] == 大于) { /* 跳转 标号一; */
        词位++;
        整 数 = 建节(25);
        若 (词型表[词位] == 词变量) { 复制内存((字*)(节名表 + 数), 词名表[词位], 64); 词位++; }
        若 (词型表[词位] == 分号) 词位++;
        { 整 段六 = 元败((字*)(节名表 + 数)); 若 (段六 < 0) 段六 = 暂回((字*)(节名表 + 数)); 节值表[数] = 段六 + 1; } /* 修复 2026-08-18: 跳转 在解析时固化 标号一 末丙 (计辛 按函数重置后 码生成器 的 元败 查不到前函数标签 — 设标号 已存 末丙, 跳转 必须同步) */
        返 数;
    }
    若 (词型表[词位] == 词变量 && 词型表[词位 + 1] == 冒号) { /* 标号一: — 2026-08-28 阶段一 #156 循环标签: 标签: 循环/遍/做 → 包装块 { 标签:; 循环; 标签_brk:; } (中断 标签→跳转 _brk, 继续 标签→跳转 标签循环头) */ /* 2026-08-28 阶段二 #164 带值 中断: 包装块声明 __brk_标签 退出变量, 中断 标签, 值; 写入 */
        字 度转[64]; 复制字符串(度转, 词名表[词位]); 词位 += 2; /* 名 : */
        整 段六 = 暂回(度转);
        若 (词型表[词位] == 下得一 || (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "for") || !比较字符串(词名表[词位], "遍"))) || 词型表[词位] == 副丁) { /* 标签后跟循环 */
            字 末排[80]; 格式化到串(末排, "%s_brk", 度转);
            整 乙序 = 暂回(末排); /* 注册 中断 目标标签 */
            整 数 = 建节(5);
            { 整 旧五 = 建节(20); 节值表[旧五] = 段六 + 1; 接子(数, 旧五); } /* 标签: (循环头 = 继续 目标) */
            字 整细[80]; 格式化到串(整细, "__brk_%s", 度转);
            若 (查变量(整细) < 0) 变量偏移(整细); /* #164: __brk_标签 退出变量 */
            { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 整细, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(数, 元); } /* 整数 __brk_标签 = 0; */
            若 (标签循环数 >= 64) 原得("标签循环名 (标签: 循环)", 64); /* A3-子表 清剿 (2026-09-12): 原 若 (标签循环数 < 64) 静默 丢弃 -> 第 65 个 标签循环 无声 失效 (带标签 断/续 清理 层 错) */ { 复制字符串(标签循环名[标签循环数], 度转); 标签循环深[标签循环数] = 计贰 + 1; 标签循环数++; } /* G14: 标签循环体深度 (带标签 断/续 跳外层 析构下界) */
            整 环 = 语句(); /* 循环语句 */
            接子(数, 环);
            { 整 标号 = 建节(20); 节值表[标号] = 乙序 + 1; 接子(数, 标号); } /* 标签_brk: (中断 目标 = 循环出口) */
            返 数;
        }
        整 数 = 建节(20); 节值表[数] = 段六 + 1; /* 设标号(段六) */
