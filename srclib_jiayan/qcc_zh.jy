/* The loader parks the main-thread stack right above the image's committed
   sections �?INSIDE the 80MB .data virtual range (stack ~VA 4.8-5.8MB, .data
   base 4.53MB). Static writes in that range would corrupt live stack frames
   (rbp high bits -> SIGSEGV). This pad shifts every written static/heap slot
   above ~5.9MB so nothing overlaps the stack. */
__attribute__((原粗))
静 字 标重[半九];
静 字 *串表[65536]; /* fix 2026-08-27 step7 (v1.2 §二B): str_tbl 分块动态化 — 原 [32768][12288] 静态二维 (384MB BSS) 撞 PE 映像 2GB 段上限不可再扩; 改指针数组 + str_arena 堆块链 (每槽 12288, 块满开新块), BSS 384MB→512KB, 2GB 天花板彻底摘除. 每槽上限 12286 语义不变. 历史: 512→2048 槽 (2026-08-06); 每槽 2048→8192 (2026-08-13); 32768 槽 (2026-08-26 redis); 每槽 8192→12288 (2026-08-26 cpython) */ 整 串数;
静 整 邻拾[65536]; /* RVA offset for each string (declared early for cg STR case) (fix 2026-08-11: str_tbl 2048 时镜像 1090 字符串 > 1024 → 同步扩容; 2026-08-26 redis: 2048→32768; 2026-08-27 step7: 32768→65536 配套指针数组) */
静 字 *中分[128]; 静 整 实劣; 静 字 *毛未, *净细; /* str_tbl 槽堆块链 (类 fn_arena): 块 16MB 永不移动, 槽指针永有效 (fix 2026-08-27 step7) */
静 字 *短六(空) { /* 从块链切一个 12288 槽 (str_tbl 分块分配, step7) */
    若 (!实劣) {
        中分[0] = 内存分配(16 << 20);
        若 (!中分[0]) { 输出到文件(错误流, "[ERR] OOM str_arena\n"); 退出(1); }
        毛未 = 中分[0];
        净细 = 中分[0] + (16 << 20);
        实劣 = 1;
    }
    若 (毛未 + 12288 > 净细) {
        若 (实劣 >= 128) { 输出到文件(错误流, "[ERR] str_arena blocks overflow\n"); 退出(1); }
        中分[实劣] = 内存分配(16 << 20);
        若 (!中分[实劣]) { 输出到文件(错误流, "[ERR] OOM str_arena\n"); 退出(1); }
        毛未 = 中分[实劣];
        净细 = 毛未 + (16 << 20);
        实劣++;
    }
    字 *结 = 毛未; 毛未 += 12288;
    返 结;
}
