            若 (接口序 < 0) { 格式化到串(错缓冲, "受约束: 接口 %s 未声明 (号合.0 #45)", 接口名); 发错误("A9004", 错缓冲); }
            字 实参类型[64] = "整";
            整 实参型序 = (实参节 >= 0) ? 序七(实参节) : 变量型序(实参名); /* R272 刀2 (2026-09-26 启元 · 第 364 站 round 11): 实参 类型 用 `序七` (下标/取址/成员/解引用/转型 通吃) 替 「只认 一个 词名」; 对 单名 变量 与 `变量型序` 逐字等价 (序七 L5119 即转调) ⟹ imp_i/imp_a..g 零影响. 与 刀1 必须 配套: 刀1 单独 ⟹ 值 恢复 但 类型名 仍取 「arr」(数组) ⟹ A9006 假拦 */
            若 (实参型序 >= 0) 复制字符串(实参类型, 类型表[实参型序].名);
            否 {
