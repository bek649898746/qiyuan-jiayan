          整 加节 = 建节(2); 节值表[加节] = 加; 接子(加节, 变右); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(加节, 壹节); }
          整 赋节 = 建节(10); 接子(赋节, 变右); 接子(赋节, 加节); 接子(块, 赋节); }
        { 整 比较 = 建节(2); 节值表[比较] = 外三; { 整 变右 = 建节(1); 复制内存((字*)(节名表 + 变右), 直平, 32); 接子(比较, 变右); } 接子(比较, 当进); /* __rec_<fvn> > 深度 (fix: 计数=深度+1 含根调用, > 使深度N触发/深度N-1允许) */
          整 若序 = 建节(8); 接子(若序, 比较);
