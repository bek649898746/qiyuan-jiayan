                若 (中参数a[计] == 帧寅) 原七 = 中参数b[计];
                否 若 (中参数a[计] == 行降 || 中参数a[计] == 度未) 现拾 = 中参数b[计];
                算寄存器(中参数a[计], 3, 0); 移寄存器(0, 3);
                断;
            例 隔得一: 移即(1, 中参数a[计]); 汇发("    除 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x99); 发字节(0xF7); 模字节(3, 7, 1); 断;
            例 旧玖: 移即(1, 中参数a[计]); 汇发("    除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x99); 前缀字节(1, 0, 0, 0); 发字节(0xF7); 模字节(3, 7, 1); 断;
            例 长转: 短弊(); 弹浮0();
                若 (中参数a[计] == 加) 总辛一();
                否 若 (中参数a[计] == 减) 整进();
                否 若 (中参数a[计] == 乘) 容甲();
                否 末一一();
                断;
            例 半属: 弹栈64(0);
                若 (中参数a[计] == 加) { 汇发("    加64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x01); 模字节(3, 3, 0); }
                否 若 (中参数a[计] == 减) { 汇发("    减64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x29); 模字节(3, 3, 0); }
                否 { 汇发("    乘64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x0F); 发字节(0xAF); 模字节(3, 0, 3); }
                断;
            例 值成: 弹栈寄存器(3); 原七 = 0; 现拾 = 0; 算寄存器(中参数a[计], 3, 0); 移寄存器(0, 3); 断;
            缺: 输出到文件(错误流, "[IR-UNKNOWN] op=%d\n", 短次一[计]); 退出(1);
        }
    }
    空失 = 0;
}

/* 阶段D DCE (2026-09-04 虾米): 当前表达式结果被丢弃 (逗号左/表达式语句), 纯运算可跳过发射 */
静 整 码生成丢弃结果 = 0;

/* 阶段D 折叠 (2026-09-05 虾米): 节点结果是否布尔 0/1 (比较/逻辑/! 经 转型 递归) */
静 整 节点是否布尔(整 数) {
    若 (数 < 0) 返 0;
    若 (节型别[数] == 节点_二元) {
        整 丙 = 节值表[数];
        若 (丙 == 下双 || 丙 == 终附 || 丙 == 高平 || 丙 == 顺八 || 丙 == 元九 || 丙 == 首降 || 丙 == 比小 || 丙 == 外三 || 丙 == 比等 || 丙 == 名庚 || 丙 == 隔系 || 丙 == 宽排 || 丙 == 逻辑与 || 丙 == 逻辑或) 返 1;
    }
    若 (节型别[数] == 节点_非节) 返 1; /* 逻辑非 ! */
    若 (节型别[数] == 节点_窄转型 || 节型别[数] == 节点_转型) 返 节点是否布尔(子0[数]); /* 窄转型/转型 */
    返 0;
}

/* 阶段D 折叠 (2026-09-05 虾米): 节点编译期常量值 (经 窄转型/转型 递归) */
静 整 节点常量值(整 数, 长 长 *值) {
    若 (数 < 0) 返 0;
    若 (节型别[数] == 节点_常数) { *值 = 节值表[数]; 返 1; }
    若 (节型别[数] == 节点_窄转型 || 节型别[数] == 节点_转型) 返 节点常量值(子0[数], 值); /* 窄转型/转型 */
    返 0;
}

/* 阶段D 折叠 (2026-09-04 虾米): 节点是否编译期常量 0 (经 窄转型/转型 递归; 长 0 也是 0) */
静 整 节点常量零(整 数) {
    若 (数 < 0) 返 0;
    若 (节型别[数] == 节点_常数) 返 (节值表[数] == 0 && !节浮标[数]);
    若 (节型别[数] == 节点_窄转型 || 节型别[数] == 节点_转型) 返 节点常量零(子0[数]); /* 窄转型/转型 */
    返 0;
}

/* 阶段D DCE (2026-09-04 虾米): 表达式是否纯 — 无副作用 (结果丢弃可安全跳过码生成) */
静 整 表达式是否纯(整 数) {
    若 (数 < 0) 返 1;
    择 (节型表[数]) {
        例 0: 返 1; /* 常量 */
        例 1: 返 1; /* 变量读 (volatile 读不追踪, 近似同 gcc -O0 死值丢弃) */
        例 2: 返 表达式是否纯(子0[数]) && 表达式是否纯(子1[数]); /* 二元 (算术/比较/逗号) */
        例 4: 返 0; /* 函数调用 (副作用) */
        例 5: { 遍 (整 计 = 0; 计 < 256; 计++) { 整 乙 = 取子(数, 计); 若 (乙 <= 0) 断; 若 (!表达式是否纯(乙)) 返 0; } 返 1; } /* 语句序列块: 全部子纯 (取子数组式遍历) */
        例 10: 返 0; /* 赋值 (副作用) */
        例 11: 返 1; /* 取址 &x (纯) */
        例 12: 返 表达式是否纯(子0[数]); /* 解引用 */
        例 13: 返 表达式是否纯(子0[数]); /* 链用 */
        例 14: 返 表达式是否纯(子0[数]) && 表达式是否纯(子1[数]); /* 下标 */
        例 15: 返 表达式是否纯(子0[数]); /* 成员访问 */
        例 17: 返 表达式是否纯(子0[数]); /* 逻辑非 ! */
        例 18: 返 表达式是否纯(子0[数]); /* 按位非 ~ */
        例 19: 返 表达式是否纯(子0[数]); /* 转型 */
        例 22: 返 表达式是否纯(子0[数]) && 表达式是否纯(子1[数]) && 表达式是否纯(子2[数]); /* 三目 ?: */
        例 23: 返 0; /* 后缀 ++ */
        例 26: 返 0; /* 前缀 ++ */
        例 27: 返 表达式是否纯(子0[数]); /* 窄转型 */
        例 28: 返 1; /* 语义节点 (借用/放还 注册语义, 码生成静默) */
        否: 返 0; /* 未知/控制流/声明: 保守不纯 */
    }
}

静 整 下标基元素宽(整 节) { /* R528 (2026-09-28 虾米 · 批次 B 续批 · S4+S5 收口): **「`*&X` 宽度推导」的 节点_下标 分支 手写 4 份** (L25185/25531/25890/26231, 逐字相同) ⟹ 改一处漏三处. 语义: 下标节点的 [基变量] 的元素宽 (取不到 返 0 = 调用方 保持原值). 纯重构. */ 若 (节 < 0 || 节型别[节] != 节点_下标) 返 0; 整 根伍八 = 子0[节]; 若 (根伍八 < 0 || 节型别[根伍八] != 节点_变量) 返 0; 返 变量元素((字*)(节名表 + 根伍八)); } 静 整 成员写宽(整 构序, 常 字 *字段名, 整 型序) { /* R526 (2026-09-28 虾米 · 批次 B 第二族 · S4+S5 收口): **成员写的「字段整块拷贝宽度」判据 手写 4 份** (L24883/L24982/L25034/L25088, 即 R317 当年只改口径没敢合并的那族) ⟹ 同一语义 4 份拷贝. 收口为单一权威: `!字段是否指 ⟹ 指针字段 按地址 非 值; 型序>=0 且 尺寸>=8 ⟹ 大构值 ⟹ 整块拷贝宽`. 纯重构. */ 返 (!字段是否指(构序, 字段名) && 型序 >= 0 && 类型表[型序].尺寸 >= 8) ? 类型表[型序].尺寸 : 0; } 静 整 是构值目标(整 型序, 常 字 *变名) { /* R525 (2026-09-28 虾米 · 批次 B 第一族 · S4+S5 收口): **同一个「赋值/初始化的构值目标」判据在赋值路径手写 8 份** —— 原形 逐字重复 8 次 (L24505/24551/25635/25646/25659/25677/25693/25705) ⟹ 改一处漏七处 (本会话 C2c 五刀够不着的同一种病). 收口为单一权威. 纯重构: 语义逐字等价 ⟹ **不动点必须不变**. */ 返 (型序 >= 0 && 类型表[型序].尺寸 > 8 && 变量指元素(变名) == 0) ? 1 : 0; } 静 整 构值三目(整 数) { /* H1q (2026-09-11): 大构值 (>8B) 三目 表达式 — 需要 sret 目标 通道 (声明初始化/赋值/返回/实参 四处 交 sret 目标) */
    若 (数 < 0 || 节型别[数] != 节点_三元 || 节值表[数] <= 0) 返 0;
    整 构序三 = 节值表[数] - 1;
    若 (构序三 < 0 || 构序三 >= 类型数) 返 0; /* 类型数 越界 守卫 (解析 半成品 节点) */
    返 (类型表[构序三].尺寸 > 8) ? 1 : 0;
}
静 空 构值源址(整 计) { /* H1q: 构值 表达式 的 源 地址 → 堆九 (静态 取静址 / 素系 槽内指针 / 局部 帧址 / 链式 免解引用) */
    若 (节型别[计] == 节点_变量) {
        字 *名 = (字*)(节名表 + 计);
        整 偏 = 查变量(名);
        若 (变量是否静态(名)) { 中发(缺捌, 偏, 1, 0); 中刷(); }
        否 若 (素系(名)) { 中发(中取帧64, 0, 偏 - 当前帧大小, 0); 中刷(); }
        否 { 中发(副失, 0, 变量基(名, 偏) - 当前帧大小, 0); 中刷(); }
    } 否 { 码生成免解引用 = 1; 码生成(计); 码生成免解引用 = 0; }
}
静 空 构值存目标(整 计, 整 构序) { /* H1q (2026-09-11): 把 构值 分支 写 入 当前 sret 目标 (码生成结构返偏移/静态/间接 三 态, 由 调用方 设置) */
    若 (计 < 0 || 构序 < 0) 返;
    整 尺寸 = 类型表[构序].尺寸; 若 (尺寸 <= 8) 尺寸 = 8;
    整 型 = 节型别[计];
    若 (型 == 节点_三元 && 节值表[计] > 0) { 码生成(计); 返; } /* 嵌套 三目: 目标 不变, 递归 */
    若 (型 == 节点_调用) { 码生成(计); 返; } /* 构值 返回 调用: 被调 直写 目标 (sret) */
    若 (!码生成结构返静态 && !码生成结构返间接 && 码生成结构返偏移 == 0) 返; /* H1q 安全网: 无 sret 目标 (如 构值 三目 被 用在 标量 语境 整 a = k?x:y;) → 不发射, 避免 写 [rbp+0] 毁帧 */
    构值源址(计);
    压栈寄存器(0);                                        /* 源 地址 */
    若 (码生成结构返间接) { 移寄存器帧64(0, 结构返指偏移 - 当前帧大小); } /* 目标 = *(本函数 返回指针 槽) */
    否 若 (码生成结构返静态) { 度一(静态位移(码生成结构返偏移, 1) - 1); }
    否 { 中发(副失, 0, 码生成结构返偏移, 0); }
    中刷();
    移64(3, 0);                                           /* rbx = 目标 */
    弹栈寄存器(0);                                        /* 堆九 = 源 */
    深利(尺寸);
}
静 空 构值取值(整 计, 整 构序) { /* H1q (2026-09-11): 小 构值 (<=8B) 三目 分支 — 值 放 堆九 (8B 槽 语义, 同 调用 返回) */
    若 (计 < 0) 返;
    整 型 = 节型别[计];
    若 (型 == 节点_三元 && 节值表[计] > 0) { 码生成(计); 返; } /* 嵌套 三目 */
    若 (型 == 节点_调用) { 码生成(计); 返; } /* 值 已 在 堆九 */
    构值源址(计);
    移寄存器内存64(0, 0); /* 堆九 = [堆九] */
    中刷();
}
静 空 发串词(整 构序) { /* C148 (2026-09-20 第 143 站): **字符串常量 发射 + 重定位 唯一 出口** —— 原 只 内联 在 例 节点_串词; __func__ (函数名 串) 需要 同 一路径 (懒放置 邻拾 / 段表 宽伍 / 汇编 STR%d 命名), 复制 一份 = 打补丁.
   ⚠️ 调用 前提: 该 串 已 登记 进 串表 且 邻拾[序标] = -1 (未放置) — 外陆一 内部 查 邻拾 懒分配。 */
    外陆一(构序); /* 确保 字符串 是 在 数据 缓冲 */
    若 (汇编输出 && 汇编遍 == 2 && 最终生成) {
        /* 串词 标记 uses 该 元失一 索引 (位置 之间 列细 字符串),
           matching 中文汇编's .字串 directive 顺序. 些 IDs 是 已解析 but
           永不 列细 (邻拾=-1), 故 该 度肆 末丙 misaligns str_offs2. */
        整 元失一 = 0;
        遍 (整 乙 = 0; 乙 < 构序; 乙++) 若 (邻拾[乙] >= 0) 元失一++;
        汇发("    移动 r0, STR%d\n", (字*)(长 长)(元失一), (字*)(长 长)0, (字*)(长 长)0);
        发字节(0x48); 发字节(0x8D); 发字节(0x05); 发四(0); /* 启元修复①: lea rax,[rip+disp32] — 原 B8=mov eax,imm32 强制 ADDR32 */
    } 否 {
        发字节(0x48); 发字节(0x8D); 发字节(0x05); 发四(0); /* 启元修复①: 与汇编分支一致 */
    }
    若 (段简 >= 32768) { 输出到文件(错误流, "[STRPATCH-OVERFLOW] strpn=%d\n", 段简); 终止程序(); }
    宽伍[段简].旁退 = 码位 - 4; /* 位置 的 三十二位立即数 */
    宽伍[段简].串序标 = 构序;
    段简++;
}
静 空 码生成(整 数) {
    若 (数 < 0) 返;
    若 (调试开关 && 数 < 节容量 && 节行表[数] > 0) 当前节行 = 节行表[数]; /* #289 (第 453 站): 语句级 行表 的 行源 */
    若 (数 >= 接子数) { 输出到文件(错误流, "[CG-BAD] n=%d nc=%d\n", 数, 接子数); 终止程序(); }
    整 暂 = 节型别[数];
    若 (暂 < 0 || 暂 > 31) { 输出到文件(错误流, "[CG-BADTYPE] n=%d nt=%d nc=%d\n", 数, 暂, 接子数); 终止程序(); }
    择 (节型别[数]) {
        例 节点_常数: 若 (节点长性(数, -1)) { 中发(当利一, 0, 节值表[数], 节长高[数]); 中刷(); } 否 { 中发(序移立即数, 0, 节值表[数], 0); 中刷(); } 断;
        例 节点_转型: 若 (子0[数] >= 0 && !((节型别[子0[数]] == 节点_下标 || 节型别[子0[数]] == 节点_解引用) && 链根变量(子0[数]) >= 0 && 变量数组((字*)(节名表 + 链根变量(子0[数]))) > 0 && 变量指深查((字*)(节名表 + 链根变量(子0[数]))) >= 1)) { 码生成浮(子0[数]); 若 (节点长性(数, -1)) 长对(); 否 { 中发(宽二, 0, 0, 0); 中刷(); } } 否 码生成(子0[数]); 断; /* C1 第三层·转型改道 (2026-09-26 启元 · round 45): **源是「指针数组元素」时不得走浮点通道** —— `(长 长)qa[0]` 原无条件 `码生成浮`+`长对`(cvttsd2si), 而 `qa[0]` 因 L7775 误置 `节浮标` ⟹ `码生成浮` 认为值已在 xmm0 ⟹ 不插整转浮 ⟹ 用 xmm0 残留浮点 (实测打印 4 应 = fbuf 地址). 本刀**不动 L7775**(那刀会断掉外层 `dp[1][0]` 依赖的内层浮标, 已实测净负), 只在**转型这一处**改道: 指针数组元素的值本来就在 rax ⟹ 直接 `码生成`. */ /* 修复 2026-08-25 缺陷#26: (长整 长整)双精度 64位 */
        例 节点_串词: 发串词(节值表[数]); 断; /* C148 (2026-09-20 第 143 站): 体 已 抽 为 发串词 (唯一 出口) — __func__ 复用 同一 发射/重定位 路径 */
        例 节点_双字面量: { /* 双精度 字面量: 双精度移动 xmm0, [指令指针 + dbl_const] (patched) */
            整 丁序 = 节值表[数];
            标劣(丁序);
            若 (汇编输出 && 汇编遍 == 2 && 最终生成) {
                汇发("    浮取静 xmm0, [rip+DBL%d]\n", (字*)(长 长)(丁序), (字*)(长 长)0, (字*)(长 长)0);
                发字节(0xF2); 发字节(0x0F); 发字节(0x10); 发字节(0x05); 发四(0); /* 双精度移动 xmm0,[指令指针+0] bare */
            } 否 {
                右再(0);
            }
            若 (暂拆 >= 2048) { 输出到文件(错误流, "[DBLPATCH-OVERFLOW] dbl_patch_n=%d\n", 暂拆); 终止程序(); }
            号集一[暂拆].旁退 = 码位 - 4;
            号集一[暂拆].浮序标 = 丁序;
            暂拆++;
        } 断;
        例 节点_变量: { /* 变量 ????????????? */
            若 (!比较字符串((字*)(节名表 + 数), "__func__") && 当前函数名[0]) { /* C148 (2026-09-20 第 143 站): 预定义 标识符 __func__ → **当前 函数名 串** (C99 语义). 原 落 查变量/查函数 皆 未命中 → A1001「未声明标识符」(实测 探针 r143b). 位置 取 码生成期 的 当前函数名 (L25745 函数 定义 入口 已 赋值) ⟹ 中文/C 风格 函数 定义 皆 覆盖. ⚠️ 已知 偏差: 本实现 给 **字符指针**, gcc 给 char[N+1] 数组 ⟹ sizeof(__func__) 我们 8 / gcc 4+; 尺寸(__func__) 场景 不 等价 (记 挂账). */
                整 函名列序 = -1;
                遍 (整 函名列计 = 0; 函名列计 < 串数; 函名列计++) 若 (串表[函名列计] && !比较字符串(串表[函名列计], 当前函数名)) { 函名列序 = 函名列计; 断; }
                若 (函名列序 < 0) { /* 未 登记: 现场 造 一 槽 (词法期 无 此 串 的 情形) */
                    若 (串数 >= 65536) 原得("字符串表 串表", 65536);
                    若 (!串表[串数]) 串表[串数] = 短六();
                    复制字符串(串表[串数], 当前函数名);
