            若 (词型表[词位] == 左花) { 字 *k2体名 = (字*)(节名表 + 函数定义); 若 (!比较字符串(k2体名, "main") || !比较字符串(k2体名, "主")) 序集 = 1; 若 (!值优 && !函数是否私有(k2体名)) 隔凶(k2体名); } /* C17b (2026-09-17): 确认 **函数定义** (有 { 体) 后 才 撤销 静态标记 — prelude 的 static 桩 (waitpid/gettimeofday/pipe...) 遇 到 后续 非 static **真定义** 时 让位 (符号 scl 由 L25810 统一判定 ==> 外部可见); 而 只有 **声明** (无体) 的 TU 保留 桩 的 static (各 .o 各持 局部副本, 不 duplicate)。同款教训: K2 方案A (2026-09-16) — main 的 **声明** 曾 误触发 未初始化检查开关 */ /* K2 方案A (2026-09-16): 只有 程序入口 的 **定义** (有函数体) 才 开启 未初始化检查 — 声明不开启 (compat/mingw.h 的 `int main(...)` 声明 曾 使 compat/*.c 全部被查) */
            整 主双 = 词位; /* 2026-08-28 类型-根-16 #76: 编译期求值 记录函数体 词元 起点 ({) */
            若 (首申((字*)(节名表 + 函数定义))) { /* 过程宏 #172: 函数体只进 编译期求值 表 (词元 区间), 不做代码生成 — 串(n)/字符串拼接是 编译期求值 专用语法, 正常 码生成器 无法编译
                ⚠️ 不 提升 单粗/函数定义表: 剩回(码生成器 按 函数定义表 顺序) 必须与 解析 单粗 同序; 跳过的宏函数不占索引 (参数 变量 成为孤儿, 被下一函数 新寅 覆盖, 永不引用) */
                若 (词型表[词位] != 左花) { 输出到文件(错误流, "[ERR] 过程宏函数 '%s' 须用 {} 函数体 (对照多子句语法不能做过程宏)\n", (字*)(节名表 + 函数定义)); 退出(1); }
                整 容布 = 0;
                循环 (词位 < 词容量) { 若 (词型表[词位] == 左花) 容布++; 否 若 (词型表[词位] == 右花) { 容布--; 若 (容布 == 0) { 词位++; 断; } } 词位++; }
                若 (计丁 < 2048) { 复制字符串(计序[计丁].名, (字*)(节名表 + 函数定义)); 计序[计丁].短亥 = 主双; 计序[计丁].隔子 = 词位; 计丁++; }
                右陆 = 0;
                解析基 = 0;
                续;
            }
            整 反对;
            若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "对照")) { /* 接入 2026-08-29 阶段二 #222 多子句函数定义: 函(a, ...) 对照 值: 结果, 值 若 守卫: 结果, ..., 其他: 默认; — 匹配第一个参数, 等值分派脱糖 → { 整数 __mcf=默认/0; 若(a==短进){__mcf=暂利;} ...; 返回 __mcf; } */
                词位++; /* 对照 */
                若 (!函首参[0]) { 格式化到串(错缓冲, "多子句函数 '%s' 需要至少一个参数 (匹配对象为第一个参数, 号合.0 #222)", (字*)(节名表 + 函数定义)); 发错误("A6026", 错缓冲); } /* 第 445 站 #222: 原 裸 `[ERR]` + 退出(1) 无码 ⟹ 改带码 A6026 (防无码拒绝) */
                静 整 号零 = 0; 字 上伴[64]; 格式化到串(上伴, "__mcf_%d_", 号零++);
                静 整 空成 = 0; 字 短合一[64]; 格式化到串(短合一, "__mmm_%d_", 空成++);
                变量偏移(上伴); 未初始化移除(上伴); 变量偏移(短合一); 未初始化移除(短合一); /* 结果/匹配标志 (声明即赋值, 防 A4001) */
                反对 = 建节(5);
                整 值巳 = 建节(1); 复制内存((字*)(节名表 + 值巳), 函首参, 64); /* 匹配对象 = 第一个参数 */
                整 末子 = 0; 整 原失 = 0; 整 原序 = -1; /* 第 450 站 #142: 原序 = `其他` 出现时的子句序号 (不可达检查用) */
                整 堆深[64]; 整 单优[64]; 整 虚进[64]; 整 段伴[64]; 整 池进一 = 0;
                循环 (1) {
                    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "其他")) { 词位++; 若 (词型表[词位] == 冒号) 词位++; 原失 = 赋值级(); 末子 = 1; 原序 = 池进一; 若 (词型表[词位] == 分号) 词位++; 否 { /* 第 450 站 #142: `其他` 之后仍有子句 ⟹ 不可达 (原: 直接 断, 静默丢弃后续子句) */
                        格式化到串(错缓冲, "多子句函数 '%s': `其他:` 之后 仍有 子句 —— 它们 不可达 (`其他` 必须 是 最后 一个 子句; #142)", (字*)(节名表 + 函数定义));
                        发错误("A6027", 错缓冲);
                        循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++; /* 排空 残留 子句, 防 连锁 误报 */
                        若 (词型表[词位] == 分号) 词位++;
                    } 断; }
                    若 (池进一 < 64) {
                        整 短进 = 宽捌(); /* 模式值 (不含 | 位或, 等值分派) */
                        整 直肆 = -1;
                        若 (词型表[词位] == 顺轮 && (!比较字符串(词名表[词位], "if") || !比较字符串(词名表[词位], "若"))) { 词位++; 直肆 = 赋值级(); } /* 守卫: 值 若 条件 */
                        若 (词型表[词位] == 冒号) 词位++; /* : */
                        整 结果 = 赋值级();
                        若 (词型表[词位] == 分号) 词位++; /* 尾分号 */
                        堆深[池进一] = 短进; 单优[池进一] = 结果; 虚进[池进一] = (直肆 >= 0); 段伴[池进一] = 直肆;
                        池进一++;
                    }
                    若 (词型表[词位] == 逗号) { 词位++; 续; }
                    断;
                }
                /* 第 450 站 #142 冗余/不可达模式检查 (原: 两者均 rc=0 静默) —— 单点, 复用唯一错误出口 */
                遍 (整 检甲 = 0; 检甲 < 池进一; 检甲++) 若 (堆深[检甲] >= 0 && 节型别[堆深[检甲]] == 节点_常数) 遍 (整 检乙 = 检甲 + 1; 检乙 < 池进一; 检乙++) 若 (堆深[检乙] >= 0 && 节型别[堆深[检乙]] == 节点_常数 && 节值表[堆深[检甲]] == 节值表[堆深[检乙]]) { 格式化到串(错缓冲, "多子句函数 '%s': 重复的 模式值 %d (第 %d 与 第 %d 个子句) —— 后者 不可达 (#142)", (字*)(节名表 + 函数定义), (整)节值表[堆深[检甲]], 检甲 + 1, 检乙 + 1); 发错误("A6027", 错缓冲); }
                若 (末子 && 原序 >= 0 && 原序 != 池进一) { 格式化到串(错缓冲, "多子句函数 '%s': `其他:` 之后 仍有 %d 个子句 —— 它们 不可达 (`其他` 必须 是 最后 一个 子句; #142)", (字*)(节名表 + 函数定义), 池进一 - 原序); 发错误("A6027", 错缓冲); }
                { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 上伴, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(反对, 元); } /* 整数 __mcf = 0; (2026-08-29 修复: 其他不得作初始值 — 会无条件求值递归, 作未匹配兜底分支) */
                { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 短合一, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(反对, 元); } /* 整数 __mmm = 0; 已匹配标志 */
                遍 (整 计 = 0; 计 < 池进一; 计++) {
                    整 比较 = 建节(2); 节值表[比较] = 比等; 接子(比较, 值巳); 接子(比较, 堆深[计]); /* a == 短进 */
                    若 (虚进[计]) { 整 直转 = 建节(2); 节值表[直转] = 逻辑与; 接子(直转, 比较); 接子(直转, 段伴[计]); 比较 = 直转; }
                    整 若序 = 建节(8); 接子(若序, 比较);
                    整 增节 = 建节(5);
                    { 整 右辛 = 建节(1); 复制内存((字*)(节名表 + 右辛), 上伴, 32);
                      整 赋节 = 建节(10); 接子(赋节, 右辛); 接子(赋节, 单优[计]); 接子(增节, 赋节); } /* __mcf = 结果; */
                    { 整 原丁 = 建节(1); 复制内存((字*)(节名表 + 原丁), 短合一, 32);
                      整 壹节 = 建节(0); 节值表[壹节] = 1;
                      整 赋节二 = 建节(10); 接子(赋节二, 原丁); 接子(赋节二, 壹节); 接子(增节, 赋节二); } /* __mmm = 1; */
                    接子(若序, 增节);
                    接子(反对, 若序);
                }
                若 (末子) { /* 其他: 若 (!__mmm) { __mcf = 原失; } — 未匹配兜底 (修复: 原作初始值无条件求值 → 递归崩溃) */
                    整 原丁 = 建节(1); 复制内存((字*)(节名表 + 原丁), 短合一, 32);
                    整 零值 = 建节(0); 节值表[零值] = 0;
                    整 素集一 = 建节(2); 节值表[素集一] = 比等; 接子(素集一, 原丁); 接子(素集一, 零值); /* __mmm == 0 */
                    整 若序 = 建节(8); 接子(若序, 素集一);
                    整 增节 = 建节(5);
                    { 整 右辛 = 建节(1); 复制内存((字*)(节名表 + 右辛), 上伴, 32);
                      整 赋节 = 建节(10); 接子(赋节, 右辛); 接子(赋节, 原失); 接子(增节, 赋节); } /* __mcf = 原失; */
                    接子(若序, 增节);
                    接子(反对, 若序);
                }
                { 整 右辛 = 建节(1); 复制内存((字*)(节名表 + 右辛), 上伴, 32);
                  整 外肆 = 建节(6); 接子(外肆, 右辛); 接子(反对, 外肆); } /* 返回 __mcf; */
                主双 = -1; /* 多子句函数无 { 体, 编译期求值 跳过 */
            } 否 {
                参析待 = 0; 参析数 = 0; /* TypeDrop v1 站2: 收集 本函数 析构形参 (窗口 [解析基, 变量数) = 本函数变量) */
                遍 (整 计 = 解析基; 计 < 变量数; 计++) { 若 (变量表[计].型序标 >= 0 && 变量表[计].名[0] != '_') { 字 *析构函数 = 型析查序(变量表[计].型序标); 若 (析构函数 || 类型含析构字段(变量表[计].型序标)) { 若 (参析数 >= 64) 原得("参析表 (析构形参)", 64); /* A3-参析 容量: 原 `参析数 < 16` 在 循环 条件 里 静默 截断 → 第 17 个起 析构 形参 永不 注册 */ 复制字符串(参析名[参析数], 变量表[计].名); 若 (析构函数) 复制字符串(参析函[参析数], 析构函数); 否 参析函[参析数][0] = 0; /* TypeDrop v2-2: 合成容器形参 */ 参析数++; } } }
                参析待 = (参析数 > 0) ? 1 : 0;
                反对 = 块();
            }
            若 (计丁 < 2048 && 主双 >= 0) { 复制字符串(计序[计丁].名, (字*)(节名表 + 函数定义)); 计序[计丁].短亥 = 主双; 计序[计丁].隔子 = 词位; 计丁++; } /* 编译期求值: 函数体 词元 范围 (编译期 f() 求值用); 2026-08-29 阶段二 #222: 多子句函数 主双=-1 不进表 (无 { 体, 防 短亥=-1 越界) */
            若 (末从 >= 0 && 段分[末从].空再 >= 0) { 整 首拆 = 建节(5); 接子(首拆, 段分[末从].空再); 接子(首拆, 反对); 反对 = 首拆; } /* 契约前置 (2026-08-28 可吞清单 阶段零-7): 入口检查包函数体首 */
            接子(函数定义, 反对); /* 函数体 (子0) */
            借检数据流(反对); /* #10 借检引擎: 函数体第二遍 引用流 NLL 数据流 (读端数据流分析代码) — 借绑/写/用 采集自本函数 AST, last-use 活性判定 */
            若 (名捌[单粗] > 0) { /* 接入 2026-08-27 延迟: LIFO 逆序打包 延迟 语句 → 子1[函数定义] — 返回/函数尾跳 长复 处先执行; #53 跳过块级已清除 (2026-09-01) */
                整 副甲 = 建节(5);
                遍 (整 丁序 = 名捌[单粗] - 1; 丁序 >= 0; 丁序--) 若 (末伴[单粗][丁序] > 0) 接子(副甲, 末伴[单粗][丁序]);
                接子(反对, 副甲); /* C7 (2026-09-11): 延迟 清理块 改挂 函数体块尾 — 原 挂 子1[函数定义] = 长复 (所有 返回 的 共享 跳转 目标) → 返回 与 落出 会 双发; 挂 体尾 后 只 在 落出 路径 执行, 各 返回 用 号寅 的 独立 副本 */
            }
            若 (单粗 >= 65536) { 输出到文件(错误流, "[ERR] 函数体表超过 65536 上限 (修复 2026-08-26 数据库: 512→8192)\n"); 退出(1); }
            总甲[单粗] = 变量数; 单粗++; /* 记录 变量-范围 结束; 顺序 == 根 attach 顺序 */
            反细[单粗 - 1] = 栈用量; /* 帧-边界 结束 (变量 仅; 静态 之内 该 函数体 don't touch 栈用量) */ 右陆 = 0; /* 2026-08-28 类型-根-2 */
            解析基 = 0; /* 回 到 文件 作用域 遍 该 下一 顶-级 item */
            接子(指, 函数定义);
            若 (函数定义数 < 1024) { 号平[函数定义数] = 新散; 函数定义表[函数定义数++] = 函数定义; } 否 原得("函数表 函数定义表", 1024); /* 修复 2026-08-06: 根子槽只 256 个, 超出的函数用扁平列表保留 (否则 主 被丢); 2026-08-28 资源护栏: 满→确定性拒绝; 编译检查点: 每函数解析快照; 语义导航: 行号平行存储 */ { 字 目次[96]; 格式化到串(目次, "{\"cp\":\"parse\",\"func\":\"%s\",\"idx\":%d}", (字*)(节名表 + 函数定义), 函数定义数 - 1); 长叁(目次); }
        } 否 { 循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++; 若 (词型表[词位] == 分号) 词位++; 续; } /* C13 根治 (2026-09-17): 原 兜底 `断` ==> 未识别顶层 token 直接终止整个 TU (如 未定义类型名开头 `AA void *f0(void);` 不匹配任何分支) ==> 后续函数静默丢弃 + rc=0 假成功 (实证 nedmalloc.c 13 函数 / tr2_dst.c 3 函数全丢)。改 跳到分号并续 — 词位必前进, 无死循环 */
    }
    返 指;
}

/* ?????? ??????: 抽象语法树 ??x86-64 机器 代码 ?????? */
静 空 码生成(整 数);
静 空 码生成浮(整 数); /* 发射 xmm0 = 双精度 值 的 表达式 n */
/* 第 166 站 (S8-② 第三张平表 `节无符号`): **写侧出口 双子**.
   普查: `节无符号` 29 赋值点 (置1 22 / 置0 4 / 克隆 2), 判据来源 两类 ——
     · `字段是否无符号(类型表[X].名, 函)`   (L25040/L25066/L25093/L25138 四处, 3 处逐字相同)
     · `变量是否无符号(名)`                (L8622 等)
   ⚠️ 两个函数 的 判据 **不同源** (类型表/字段 vs 变量表/名字) —— 不可混用 (第 164 站 教训).
   ⚠️ 均 **不含** 其他守卫; 调用点 若需 `变量数组(...) == 0` 等条件, 由调用点 自行 保留. */
静 空 标字段无符号(整 节, 常 字 *型名, 常 字 *函) {
    若 (节 >= 0 && 节 < 节容量 && 型名 && 函 && 字段是否无符号(型名, 函)) 节无符号[节] = 1;
}
静 空 标变量无符号(整 节, 常 字 *名) {
    若 (节 >= 0 && 节 < 节容量 && 名 && 变量是否无符号(名)) 节无符号[节] = 1;
}
/* 第 169 站 (S8-② 读侧权威 之二: **节点长性**): 建 `节点长性(整 节, 整 指节)` —— 镜像 `节点浮性`.
   由来: `节长标` 有 74 个读点, 其中 22 个 在 codegen 区 是 **纯判定** 形态
     (`若 (节点长性(数, -1)) { 发射 符号扩展/64 位 指令 }`) —— 语义 就是「该节点 是不是 64 位整」.
   本函数 与 `节点浮性` 同构: ① 平表 (缓存) ② 声明类型 (原子判据 `长指`).
   ⚠️ `节点长性(节, -1)` ≡ `(节 >= 0 && 节长标[节])` —— 唯一差异 是 补了 `节 >= 0` 守卫
     (原式 无守卫, 越界读); 实际路径 等价.
   价值: 把 codegen 区的读点 **收进函数背后** ⟹ S8-③ 平表退役 时 只需 改 本函数. */
静 整 节点长性(整 节, 整 指节) {
    若 (节 >= 0 && 节长标[节]) 返 1;              /* ① 平表 (缓存) */
    若 (指节 >= 0 && 长指(指节)) 返 1;            /* ② 声明类型 (原子判据 `长指`) */
    返 0;
}
/* 第 168 站 (S8-② 收尾批): **数值类型 判定 双子** —— 「单条判据 混用 多张平表」的收口.
   普查 (74 个 `节长标` 读点 + 29 个 `节无符号` 读点) 后, 真正「单条判据 混用 多表」的 只剩:
     · `节无符号[节] && !节长标[节]`  = **32 位无符号** (L4662)
     · `节长标[节] && !节无符号[节]`  = **64 位有符号/长整** (L22250)
   二者 是 **互补** 的两位编码 (无符号 ⟹ 32 位; 长 ⟹ 64 位有符号; 都置 ⟹ 64 位无符号).
   ⚠️ 本批 **不含** `64 位无符号` (节长标 && 节无符号) —— 若将来出现该形态, 应另加一个原子判据,
      不可 用 这两个 之一 代 真 (第 164 站 教训: 判据 不可 混). */
静 整 是32位无(整 节) { /* 32 位无符号 (无符号 且 非长) */
    返 (节 >= 0 && 节无符号[节] && !节长标[节]) ? 1 : 0;
}
静 整 是64位有(整 节) { /* 64 位有符号 (长 且 非无符号) */
    返 (节 >= 0 && 节长标[节] && !节无符号[节]) ? 1 : 0;
}
/* 第 167 站 (S8-② 读侧权威 之一: **节点类型码**): 建 `节点类型码(整 节)`.
   由来: L5864 (`暂 == 0` 整数字面量) 与 L5882 (`暂 == 19` 转型截断节点) **逐字相同 的 5 行** ——
     `指元素>0 ⟹ 尺寸基码+16 (指针) / 节浮标 ⟹ 4 / 节长标 ⟹ 3 / 节无符号 ⟹ 5 / 否则 0 (整数)`.
   这 5 行 = **节点 类型码 的读侧判定**, 却 两处 手写 ⟹ 收口 为 单一权威.
   ⚠️ 读侧权威 是 **S8-③ (平表退役)** 的 前置: 将来 类型码 若 改从 节点字段 推导,
      只需 改 本函数 **一处**, 而不是 追着 所有 手写 复制点 改.
   语义 = 原 5 行 **逐字等价** (参数 名 由 `数` 改 `节`; 调用点 传 `数`). */
静 整 节点类型码(整 节) {
    若 (指元素[节] > 0) 返 尺寸基码(指元素[节]) + 16;
    若 (节浮标[节]) 返 4;
    若 (节长标[节]) 返 3;
    若 (节无符号[节]) 返 5;
    返 0;
}
/* 第 165 站 (S8-② 发射族 补全): **发浮读字段(整 节, 整 单)** —— 字段读的「发射 + 打标」双子.
   第 158 站 的 `发浮取` 只覆盖**带 `汇发("浮取 xmm0, [r0]")` 文本**的站点 (5 处);
   而**直接用 `发字节` 发射**的字段读 (双精度 `movsd xmm0,[rax]` / 单精度 `movss+cvtss2sd`)
   是**同族**但未被覆盖 —— 本 helper 补全.
   ⚠️ **本函数不含 `汇发` 文本** (那是 `发浮取` 的职责; 二者勿混用 —— 第 164 站 教训:
      helper 注释必须写明 前提/边界). 参数 `单`: 0=双精度(movsd) / 1=单精度(movss+cvt).
   语义 = 原站点 的 **逐字等价**: 发射字节序列 + 打浮标 (打标 与 发射 不可分离). */
静 空 发浮读字段(整 节, 整 单标) {  /* 第 165 站 修复: 参数名 原为 \单\ —— **撞甲言类型词**(单精度), 与 第 144 站 教训同型 */
    若 (单标) { 发字节(0xF3); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0);
              发字节(0xF3); 发字节(0x0F); 发字节(0x5A); 发字节(0xC0); }
    否 { 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); }
    若 (节 >= 0 && 节 < 节容量) 节浮标[节] = 1;
}
/* 第 164 站 (S8-② 批次收口): **标清除(整 节)** —— 清除出口 (S8-① 规则 R7: 防错误继承).
   🔴 本站 回归记录 (两次 全量闸 红, 每次 5 个 宽字符糖锚 `feat_zh_sugar_wide{1..5}_ok.c`):
     首版 4 组 红 ⟹ 立项 怀疑 L8620/L8621 合并 (缩进 16 vs 8 = 不同控制流块, 已回滚);
     但 回滚后 重做 2 组 **仍 红** ⟹ 真根因 = **L10630 误用 原子判据 `浮或指浮`**:
       该判据 (第 161 站 从 L7294 提取) **内含 `节型别[指节] == 节点_变量` 守卫**,
       而 L10630 原判据 `变量是否浮(名) || 变量指浮(名)` **无 该 守卫** ⟹
       误用后 对「非 变量节点」不再打浮标 ⟹ 宽字符糖 代码生成 走偏 (exit=0 期望, 实得 1).
     ⟹ **教训: 原子判据的命名/注释必须反映完整语义 (含守卫条件)**;
        「看起来一样」的判据 在不同上下文 可能 少/多 一个守卫 —— 这是 第 161 站纪律的反例,
        而 **我自己** 犯了它 (提取时带上守卫, 命名时丢掉主语).
   ⚠️ 本节 (标清除) 与 控制流块 无关: 替换 分支内 单条语句, 块结构不变. */
静 空 标清除(整 节) {
    若 (节 >= 0 && 节 < 节容量) 节浮标[节] = 0;
}
/* 第 163 站 (S8-② 孪生传播 收口): **传浮长(父, 子)** —— 把「浮/长 成对传播」的**隐含约定**写进代码.
   `节浮标` 与 `节长标` 是 **孪生平表** (8 字节 浮 / 8 字节 整, 同一处 成对出现, 见 第 162 站 普查);
   原 各处 手写 `若 (节浮标[子]) 节浮标[父]=1; 否 若 (节长标[子]) 节长标[父]=1;` ——
   绑定 关系 只 存在于 作者 的 记忆里 (漏一处 即 浮/长 失配).
   本函数 让 孪生 关系 **显式**: 一个 调用 同时 处理 两表. */
静 空 传浮长(整 父, 整 子) {
    若 (父 < 0 || 父 >= 节容量) 返;
    若 (子 >= 0 && 节浮标[子]) 节浮标[父] = 1;
    否 若 (子 >= 0 && 节长标[子]) 节长标[父] = 1;
}
/* 第 162 站 (S8-② 框架 镜像 到 `节长标` —— 第二座山): **声明侧 长整 原子判据**.
   `节长标` 全文 221 处 / 赋值 72 处 (vs `节浮标` 127/40) ⟹ 更大的山; 且 与 浮标 **孪生**:
     L7294/7295 · L8651/8655 · L10630 都是 「浮分支 / 否 若 长分支」成对出现.
   本函数 = 那对 判据 里 长整 一侧 的 原子形式 (A22 基类码 3 = 长整; 见 L7295 注释 C144).
   层次 (镜像 `指浮双`/`浮或指浮`/`指浮单双`): 名字版 (长名) → 节点版 (长指) → 写侧出口. */
静 整 长名(常 字 *名) { /* 名字版: 变量 本身是 长整 或 其基类码 为 3 (长整) */
    若 (!名) 返 0;
    返 (变量是否长(名) || 变量基登(名) - 1 == 3) ? 1 : 0;
}
静 整 长指(整 指节) { /* 节点版: 该节点 是 变量 且 声明为 长整 (⚠️ 含 节型别==节点_变量 守卫; 名字版 用 `长名` —— 二者不可混 + 第 164 站 教训) */
    若 (指节 < 0 || 节型别[指节] != 节点_变量) 返 0;
    返 长名((字*)(节名表 + 指节));
}
/* 第 161 站 (S8-② 判据层次化): **三个原子判据** —— 「看起来一样的三套判据」各有名字.
   ⚠️ 三者 **语义不同**, 绝不可互相替代 (第 160 站 扫描 23 处混用点时 发现的最大陷阱):
     · `指浮双`    = 指向 **双精度**          (`变量指浮`)            —— 标指浮 / L8803 族 用
     · `浮或指浮`   = 本身浮 **或** 指向浮      (`变量是否浮||变量指浮`) —— L7294 等 B 模式 用
     · `指浮单双`   = 指向 **单或双** 精度       (`变量指浮||变量指单`)   —— 节点浮性② / 单精度通道 用
   散落手写这三套 判据 是 S8-① 说的「同规则两套判据」的直接来源 (A3 类缺陷).
   层次: 原子判据 (本三函数) → 组合出口 (`节点浮性` 读侧 / `标指浮` 写侧). */
静 整 指浮双(整 指节) { /* A: 指向 双精度 (⚠️ 含 节型别==节点_变量 守卫 + 指节>=0; 只认「指向」, 不含「本身是浮」) */
    返 (指节 >= 0 && 节型别[指节] == 节点_变量 && 变量指浮((字*)(节名表 + 指节))) ? 1 : 0;
}
静 整 浮或指浮(整 指节) { /* B: 本身浮 或 指向浮 (⚠️ **含 节型别==节点_变量 守卫** —— 第 164 站 曾因 把它 用到「只查变量名」的场景 而 引入回归; 名字版 场景 请另写) */
    返 (指节 >= 0 && 节型别[指节] == 节点_变量
        && (变量是否浮((字*)(节名表 + 指节)) || 变量指浮((字*)(节名表 + 指节)))) ? 1 : 0;
}
静 整 指浮单双(整 指节) { /* C: 指向 单或双 精度 (⚠️ 含 节型别==节点_变量 守卫; 与 B 的区别: B 含「本身浮」, C 含「指单」) */
    返 (指节 >= 0 && 节型别[指节] == 节点_变量
        && (变量指浮((字*)(节名表 + 指节)) || 变量指单((字*)(节名表 + 指节)))) ? 1 : 0;
}
静 整 成员字段函浮(整 成) { /* R469 (2026-10-01 · 续七十一): **函数指针 字段 的 「返回浮」 读侧查询** —— 直接读 **真结构** 位 `类型表[构序].字段[序].字段函浮` (A41 立的唯一权威), 不再依赖 解析期 节浮标/侧表. 判据 = 「被调者 是 成员/箭头 && 其字段 是 函数指针 && 返回 双精度」. 模式照抄 既有 L25938 的 字段元数据 遍历 写法. */
    若 (成 < 0 || (节型别[成] != 节点_成员 && 节型别[成] != 节点_箭头) || 子0[成] < 0) 返 0;
    整 序R469 = 序七(子0[成]);
    若 (序R469 < 0) 返 0;
    遍 (整 计R469 = 0; 计R469 < 类型表[序R469].函; 计R469++)
        若 (!比较字符串(类型表[序R469].字段[计R469].正辰, (字*)(节名表 + 成))) 返 (类型表[序R469].字段[计R469].字段函浮 != 0) ? 1 : 0;
    返 0;
}

/* 第 159 站 (S8-② 读侧收口): **节点浮性 —— 读侧 单一权威查询**.
   S8-① 指出「同一『是不是 double』有 **三套表示**」(变量表 / 类型表 / 平表 节浮标[]);
   读侧 因此 各自 手写 复合判据 —— 最长的一处 是 **4 个条件 || 链, 横跨 三套表示**,
   判据分散 ⟹ 「写侧漏一处、读侧就退化或判错」(S8-① 的 十轮 事故链).
   本函数 是 读侧 的 **单一出口**: 依次 查 ① 平表(缓存) ② 变量表(声明类型) ③ 平表(转型信息),
   语义 = 原 4 条件 的 **逐条等价改写** (零行为变更; 仅补 `指节 >= 0` 防御守卫, 实际路径 恒真).
   ⚠️ 本步只立「出口」并接 **首个** 消费点; 后续 逐步 让 它 成为 读侧 的 **唯一路径**
     (S8-② 路线图 ②-4), 再谈 平表 退役 (③). */
静 整 节点浮性(整 节, 整 指节); /* R461: 前向声明 —— 读侧需**递归调用自身**重算子节点浮性 */
静 整 节点浮性(整 节, 整 指节) {
    若 (节 >= 0 && 节浮标[节] && !((节型别[节] == 节点_解引用 || 节型别[节] == 节点_下标) && 表达式基浮(节) == 0)) 返 1; /* R255 刀2 (2026-09-23) 虾米: **① 缓存 也 必须 服从「加载方式 由 源类型 定」** —— `节浮标[节]` 同时 承载 两个 语义: (a) 「本节点 的 值 是 double」(实参/外层 消费) 与 (b) 「本节点 的 加载 方式 是 浮点」(本函数 ① 消费). 而 `(双精度)*plp` (plp→长整长整) 的 L9209 会 给 **操作数** (解引用节点) 打 `节浮标` ⟹ ① 缓存 命中 ⟹ `例 节点_解引用` 改发 `movsd xmm0,[r0]` (只写 xmm0, rax 不动) ⟹ 随后 R254 刀1 的 `cvtsi2sd xmm0, rax` 用 **指针值** 覆盖 xmm0 (实测 r255ae.c: 得 4386736 = (双精度)(指针值), 应 11). 守卫 只 排除「解引用 + 链根 指向非浮」—— 此时 (a) 成立 而 (b) 不成立, 故 ① 不得 返 1; `节浮标` 自身 不 清除 (实参 仍 按 xmm0 传). 指向浮点的解引用 / 变量 / 下标 / `标指浮`/`发浮取` 的 标 全部 逐字不变 (零回归). */ /* C8 根治 (2026-09-24 启元 · 第 276 站): **同族 漏网 —— ① 缓存 守卫 补 `节点_下标`**. 病灶(探针 c8_dblptr/m1_bad.c + objdump 铁证): `双精度 f(整数 *q){ 返 (双精度)q[0]; }` 生成 `mov $0,%eax; shl $2; add; mov (%rax),%eax; jmp; add rsp; ret` —— **取值 全对 (%eax=11) 却 无 `cvtsi2sd`** ⟹ `xmm0` 残留 0 (实测 返 0.000000, 应 11.000000); 而 `返 (双精度)*q` 正确 (有 `cvtsi2sd %eax,%xmm0`). 根因: 下标节点 被 打了 `节浮标` (语义 (a) 「值是 double」由 外层 消费 时 打) ⟹ `码生成浮` 里 `节点浮性(数,-1)` ① 缓存 命中 ⟹ `码生成(数); 返;` 走 **整型通道** 只写 `%eax`, **跳过 兜底 的 `旧挂()`**; 解引用 形态 恰因 R255 刀2 的 守卫 而 幸免 ⟹ 本刀 只是 把 同族 的 下标 一并 纳 入 守卫. `int t=q[0][0]` (整型上下文) / `double x=p[0]` (赋值 路径) / `(double)(q[0]+0)` (二元节点) 三者 原本 就 正确 ⟹ 与 本 病灶 正交. 判据: `表达式基浮(下标) == 0` 才 排除 ⟹ 真 浮点 数组 下标 (`双精度 d[3]; d[1]`, 经标Z=1 且 链根 基类码 4 ⟹ 表达式基浮 返 1) 逐字 不变 (零回归). */                                    /* ① 平表 已标 (缓存) */
    /* R457 (2026-10-01 · 第 439 站续五十二 · S8 塌缩: 第一族「变量声明类型」搬迁 · 第 3 次尝试):
       本分支的判据与**写点 @9500 逐字同构** ——
       写点: `若 (变量是否浮(词名表[词位-1]) && 变量数组(词名表[词位-1]) == 0) 节浮标[数] = 1;`
       读侧: 把「当前词」换成「该变量节点的名字」⟹ 同一判据、同一语义 (前两次失败: 第 1 次缺 `变量数组==0`;
       第 2 次缺 `变量数组==0` 且过度覆盖)。 */
    若 (节 >= 0 && 节型别[节] == 节点_变量 && 变量数组((字*)(节名表 + 节)) == 0 && 变量是否浮((字*)(节名表 + 节))) 返 1;
    /* R459 (2026-10-01 · 第 439 站续五十六 · S8 塌缩 第二族「双精度字面量」搬迁):
       与 写点@9702 **逐字同构** —— 写点: `整 数 = 建节(终简); 节值表[数] = 浮数; 节浮标[数] = 1;`
       ⟹ 双精度字面量的节点类型码 = `终简` ⟹ 读侧只查 `节型表[节] == 终简` 即可独立重算，
       纯**节点自身属性**（不依赖解析期上下文）⟹ 满足可搬性判据 (a)。 */
    若 (节 >= 0 && 节型表[节] == 终简) 返 1; /* S8 搬迁: 双精度字面量 (写点@9702) */
    /* R460 (2026-10-01 · 第 439 站续五十七 · S8 塌缩 第三族「经 typedef 的浮点变量」):
       背景: 变量表 `是否浮标` 的登记点**只覆盖关键字直接声明**(`双`/`单`) —— 实测:
       `类型 F = 双; F x = 7.5;` 时 `变量是否浮("x")` 返 0 ⟹ R457 的分支兜不住 typedef 场景
       (短路实验里 `feat_zh_typedef_float_ok` / `file_scope_typedef_float_ok` 仍在失败清单).
       判据: typedef 的浮点标记在**型定表**(v.是否浮标) ⟹ 读侧由「变量声明类型名 → 型定查 → 型定表」重算.
       ⚠️ 仍属「节点自身 + 类型表」稳定信息 ⟹ 满足可搬性判据 (a). */
    若 (节 >= 0 && 节型别[节] == 节点_变量 && 变量数组((字*)(节名表 + 节)) == 0) {
        字 型名R460[64]; 变量类型名((字*)(节名表 + 节), 型名R460); 整 型R460 = 型名R460[0] ? 型定查(型名R460) : -1;
        若 (型R460 >= 0 && 型定表[型R460].是否浮标) 返 1; }
    /* R461 (2026-10-01 · 第 439 站续五十八 · S8 塌缩 第四族「二元算术」):
       写点@9717(乘法内): `若 ((丙 == 乘 || 丙 == 除) && ((数 >= 0 && 节浮标[数]) || (结 >= 0 && 节浮标[结]))) 节浮标[甲] = 1;`
       —— 它读**子节点的平表值**；读侧等价重算 = **递归调用 `节点浮性` 于子节点**（§十三 规律：节点级）。
       ⚠️ 递归是安全的: 表达式是**树**(无环) ⟹ 深度受表达式嵌套限制。 */
    若 (节 >= 0 && 节型别[节] == 节点_二元 && (节值表[节] == 乘 || 节值表[节] == 除) && 子0[节] >= 0 && 子1[节] >= 0) {
        若 (节点浮性(子0[节], -1) || 节点浮性(子1[节], -1)) 返 1; }
    /* R462 (2026-10-01 · 第 439 站续五十九 · S8 塌缩 第五族「链式结构(下标/成员)」):
       写点@8131(后缀链): `若 (浮或指浮(底) && !(底是变量 && 变量指深查(底)>=2)) 节浮标[央] = 1;`
       与 @8133: `若 (节浮标[底] && !(...)) 节浮标[央] = 1;` —— 后者读**平表本身** ⟹ 短路后链断
       (实测症状: `member_chain_float_ok` 输出 `4386808.000000` = 指针值当浮点).
       读侧等价重算 = **递归** `节点浮性(子0[节], …)` —— 与 R461 同法, 覆盖「链式传播」这一族. */
    若 (节 >= 0 && 节型别[节] == 节点_下标 && 子0[节] >= 0 && 节点浮性(子0[节], 节) && !(节型别[子0[节]] == 节点_变量 && 变量指深查((字*)(节名表 + 子0[节])) >= 2)) 返 1; /* @8131 等价 */
    若 (节 >= 0 && 节型别[节] == 节点_下标 && 子0[节] >= 0 && 指浮单双(子0[节]) && 变量指深查((字*)(节名表 + 子0[节])) == 1) 返 1; /* R465 (2026-10-01): **下标基 = 一级浮点指针变量** ⟹ 结果必为浮点标量. 原 R462 分支靠 `节点浮性(子0, 节)` 走 ③④/R244 元数据路径, 但 ② (`指浮单双`) 因 `指节` 传的是下标节点而恒空 ⟹ `双精度 *lp; lp[i]` 短路后失判 (实测 feat_zh_float_ptr_meta_ok 回归). R464 曾试图改传参 (救1坏1, 已弃), 本刀改为**只追加**这一条窄判据. */
    若 (节 >= 0 && 节型别[节] == 节点_下标 && 子0[节] >= 0 && 表达式指深(节) == 0 && 表达式基浮(节)) 返 1; /* R466 (2026-10-01 · 续六十八): **下标族统一判据** —— 判据 = 「本节点解到标量 (表达式指深==0) && 链基指向浮点 (表达式基浮)」. 表达式基浮 是 C142 立的**读侧统一出口**（覆盖 变量链 + 调用链 + 成员链） ⟹ 可覆盖 R465 之外子形态（基 = 成员/箭头/转型/typedef/指针数组）. */
    若 (节 >= 0 && 节型别[节] == 节点_作用域块 && 节末子(节) >= 0 && 节点浮性(取子(节, 节末子(节)), -1)) 返 1; /* R468 (2026-10-01 · 续七十): **可空族「解包」读侧** —— `解包tag生成` 的产物是**作用域块**, 其浮性原靠解析期 `节浮标[块]` (L6052), 短路 ① 后失效 ⟹ 解包 得 0.0. 读侧等价 = **块的值 即 末子 的值** ⟹ 递归 节点浮性(末子). */
    若 (节 >= 0 && 节型别[节] == 节点_调用) { 整 被调R469 = (节末子(节) >= 0) ? 取子(节, 节末子(节)) : -1; 若 (成员字段函浮(被调R469)) 返 1; } /* R469 (2026-10-01 · 续七十一): **函数指针族** —— 调用节点的浮性 = 被调者(成员/箭头)字段的 「返回浮」真结构位. 原靠解析期 `节浮标[呼]`(L8214 族) ⟹ 短路 ① 后失效 ⟹ 返回值 走整数通道 (实测 `v=541272024.0000` = 指针值当浮点). */
    若 (节 >= 0 && 节型别[节] == 节点_解引用 && 子0[节] >= 0 && 节型别[子0[节]] == 节点_变量 && 指浮单双(子0[节]) && 变量指深查((字*)(节名表 + 子0[节])) == 1 && 表达式指深(节) == 0) 返 1; /* R470 (2026-10-01 · 续七十二): **解引用族（与 R465 完全对称）** —— R467 用「无守卫」版 (`表达式基浮`) 主干回归 994/998 已弃; 本刀把守卫加到与 R465 **同强度**: 基必须是 **一级浮点指针变量**(指浮单双 + 变量指深查==1), 且本节点**解到标量**(表达式指深==0). */
    若 (节 >= 0 && (节型别[节] == 节点_成员 || 节型别[节] == 节点_箭头) && 子0[节] >= 0 && 节点浮性(子0[节], 子0[节])) 返 1; /* @8181 族: 成员链 (嵌套双精度字段/指针字段) */
    若 (指浮单双(指节)) {
        /* R244 (2026-09-22) 刀2: **解到底 守卫** —— ② 原 无条件 返 1 (只 判「操作数 是 指向浮点的指针」),
           未 判「**本节点 解引用后 是否 到底**」。`*pp` (pp 指深 ≥ 2) 的结果 仍 是 `double*` (指针),
           却 被 判 浮点标量 ⟹ 发射 `浮取 xmm0,[r0]` (movsd) —— **只 写 xmm0, 不动 r0** ⟹
           需要「地址」的 外层 (`**pp` / `(*pp)[i]`) 拿到 陈旧/错值。
           实测 (scratch_gl/r9/r244b.c): 整数 二级 四种读法 全对 (宽度 无损), 浮点 二级 在
           函数内 static / 局部 全 0.000000, 文件级 恰好 因 `变量指浮 == 0` 而 幸免。 */
        若 (!(节 >= 0 && 节型别[节] == 节点_解引用 && 表达式指深(节) > 0)) 返 1;
    }                                          /* ② 变量表 声明类型 (原子判据 C) */
    若 (指节 >= 0 && 指元素[指节] == 8 && 节型别[指节] != 节点_变量) 返 1; /* ③ 转型 指元素 8 字节 */
    若 (指节 >= 0 && 节指元[指节] == 21 && 指元素[指节] == 4) 返 1;
    /* R244 (2026-09-22) 刀3: **链式 解引用 的 浮性** —— 操作数 是 解引用/下标/成员 节点 (非变量) 时,
       ② 因 `节型别==节点_变量` 守卫 落空、③④ 依赖 转型/链码 ⟹ `**pp` 四条全落空 ⟹ 判「非浮」
       ⟹ 走整数通道, 与 内层 遗留 的 xmm0 错配 (汇编实证 见 刀2 注释)。
       判据 = (i) 沿链 找 链根变量, 其 声明期 基类码 == 4 (双精度) —— `变量基登 - 1`;
              (ii) 本节点 **解到 标量** (表达式指深(节) == 0).
       ⚠️ 两 条件 缺一不可: 只 看 基类码 会 把 `pp[0]` (仍 是 double*) 误判 浮;
          只 看 指深 会 把 `长整长整 **lp` 误判 (同形位置 只有 基类码 能 分, 同 C135/C132 的 判据 构造)。 */
    若 (节 >= 0 && 指节 >= 0 && 节型别[指节] != 节点_变量 && 表达式指深(节) == 0) {
        整 根五 = 链根变量(指节);
        若 (根五 >= 0 && 变量基登((字*)(节名表 + 根五)) - 1 == 4) 返 1;
        若 (链含成员(指节) && 表达式基浮(指节)) 返 1; /* R253-续 (2026-09-23) 虾米: **成员链 的 浮性** —— 上行 判据 (`变量基登(链根) - 1 == 4`) 只认 **链根变量 的 双精度 基类码**; 成员链 的 链根 是 **结构体** (`**sBox.pp` 的 链根 `sBox`) ⟹ 恒假 ⟹ 判非浮 ⟹ 走 整数 通道 (实测 r253n N5: `float v = **sBox.pp` 得 1069547520 = 0x3FC00000 = 1.5f 位模式当整数; 同处 N4 变量基 `**fpp` 正确). 改用 R248 立的 **统一出口** `表达式基浮` (沿链 遇 成员/箭头 取 字段元数据 `终捌指`). `链含成员` 守卫 ⟹ 纯 变量链 逐字 不变 (零回归). 与 写侧 `指元浮` (L25138) 的 同类收口 呼应. */
    }       /* ③ 转型 单级双精度指针 (A22 码 21) */
    返 0;
}
/* 第 160 站 (S8-② 写侧出口 样板): **标指浮 —— 「指向浮点 ⟹ 打浮标」的 单一写侧出口**.
   与 第 158 站 `发浮取` (发射侧: 发射即打标)、第 159 站 `节点浮性` (读侧: 单一权威) 呼应.
   原 3 处 同形 打点 (L8803/L22386/L22389, 其中 2 处 逐字相同) 各自 手写
   「`节型别[X]==节点_变量 && 变量指浮(名)` ⟹ `节浮标[数]=1`」⟹ 本 helper 收口.
   语义 = 逐字等价 (仅把 `指节 >= 0` 守卫 移入 helper; L22386 的 `函数指` 守卫 保留在调用点).
   ⚠️ 判据 差异 提醒: 本函数 只认 `变量指浮` (指向双精度); 另有 若干点 认 `变量指浮 || 变量指单`
     (指向 单/双精度) —— 那 是 **不同语义**, 不可 混入本出口 (S8 收口 必须 逐条核对). */
静 空 标指浮(整 节, 整 指节, 常 字 *名) {
    /* R244 (2026-09-22) 刀4: **解到底 守卫 (解析期)** —— `标指浮` 在 **解析期** 就为 `*名` 打浮标,
       它与 `节点浮性` ② 同病: 只 判「名 是 浮点指针」, 未 判「**本节点 解到 标量**」。
       子 `*pp` (pp 指深 ≥ 2) 的结果 仍 是 指针, 却 被打上 浮标 ⟹ 码生成 时
       `节点浮性` ① 缓存命中 直接 返 1 ⟹ **刀2 的 守卫 根本 走不到** ⟹ 仍 发 `浮取 xmm0,[r0]`。
       实测: 只 加 刀2/刀3 时, `**dpp` 的 汇编 变成 **两次** `浮取 xmm0,[r0]`
       (内外层 各 一次, r0 无人 更新 ⟹ 两次 读 同一 地址) ⟹ 值 仍 错。本刀 堵住 这一路。 */
    若 (节 >= 0 && 节 < 节容量 && 指浮双(指节) && 变量指浮(名)
        && !(节型别[节] == 节点_解引用 && 表达式指深(节) > 0)) 节浮标[节] = 1;
}


/* xmm0 = 双精度 值 的 一 表达式 (单精度 变量/字面量/arith, 或 整数→cvtsi2sd) */
/* 第 158 站 (S8-② 第一块砖): 「发射 浮取 xmm0 指令 + 登记本节点浮性」收口为 **一个动作**.
   原状: 5 处 (L25073/25103/25134/25161/25241) 各自 手写 4 条 发字节 + 末尾 `节浮标[数] = 1`
     —— 判据相同、字节序列相同, 属 **纯重复劳动** (S8-① 清单「冗余度 9~15:1」的活样本).
   收口后: **发射 与 打标 不可分离** (结构保证) —— 新增 浮点读 时 不可能 只发指令 而 忘 打标;
     这正是 S8-① 指出的「写侧漏一处、读侧就退化或判错」的事故链的结构性封堵.
   ⚠️ 其余 14 处 `浮取 xmm0` 是 **参数/局部 装载** 或 **读路径 指令发射点** (无 AST 节点可标),
     不并入 —— 本 helper 只收口「有节点且需要打标」的那 5 处.
   判据: 不动点不变 (纯重构 / 零行为变更). */
静 空 发浮取(整 节) {
    汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0);
    若 (节 >= 0 && 节 < 节容量) 节浮标[节] = 1;
}

静 空 码生成浮(整 数) {
    若 (数 < 0) 返;
    整 暂 = 节型别[数];
    若 (暂 == 1) { /* 标识符 */
        字 *变节 = (字*)(节名表 + 数);
        整 偏移 = 查变量(变节);
        若 (变量是否浮(变节)) {
            若 (变量单标(变节)) { /* R4a-1: 单精度 float 变量读 → movss 4B + cvtss2sd 提升 */
                若 (变量是否静态(变节)) 载单静(静态位移(偏移, 2) - 2);
                否 载单帧(偏移 - 当前帧大小);
            } 否 若 (变量是否静态(变节)) { 右再(静态位移(偏移, 2) - 2); } /* 静态 双精度 经 指令指针 (8-字节 双精度移动: 主升 是 6-字节-based) */
            否 逆厚(偏移 - 当前帧大小);
        } 否 {
            若 (变量是否长(变节)) { /* A36 (2026-09-12): 64 位 整数 (长 长) → 双精度 必须 用 64 位 加载 + cvtsi2sd (REX.W); 原 一律 走 32 位 通道 → 高 32 位 静默 丢 (实测 长 长 5000000000LL 转 双 = 705032704; 除/赋值/实参 同 通道) */
                若 (变量是否静态(变节)) 移rax内存64(静态位移(偏移, 1) - 1); 否 移寄存器帧64(0, 偏移 - 当前帧大小);
                汇发("    整转浮64 xmm0, 堆九\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2A); 发字节(0xC0); /* cvtsi2sd xmm0, 堆九 */
            } 否 {
                若 (变量是否静态(变节)) 移eax内存(静态位移(偏移, 0)); /* 静态 整数 变量 经 指令指针 (6-字节 移动: 主升 direct) */
                否 移寄存器帧(0, 偏移 - 当前帧大小); /* 整数 变量 → 首子 */
                旧挂();
            }
        }
        返;
    }
    若 (暂 == 终简) { 码生成(数); 返; } /* 终简 字面量 → 双精度移动 xmm0 (码生成 例-终简) */
    若 (暂 == 0) { 码生成(数); 旧挂(); 返; } /* 整数 立即数 → 转换 */
    若 (暂 == 4) { /* 函数 调用: 双精度-返回 被调者 叶 xmm0; 整数 被调者 → 转换 */
        字 *存分 = NULL;
        遍 (整 计 = 19; 计 >= 0; 计--) { 整 字符 = 取子(数, 计); 若 (字符 >= 0 && 节型别[字符] == 节点_变量) { 存分 = (字*)(节名表 + 字符); 断; } }
        码生成(数); /* 发射 该 调用 */        若 (存分 && 查函数浮返(存分)) { /* 高癸一 双精度-返回 被调者: xmm0 已 持有 它 */
        } 否 若 (节点浮性(数, -1)) { /* marked 双精度 调用 (incl. 函数指): leave xmm0 作为-是 */
        } 否 旧挂();
        返;
    }
    若 (暂 == 2) { /* 二进制 */
        整 丙 = 节值表[数];
        若 (丙 == 逗号 && !(子0[数] >= 0 && 节型别[子0[数]] == 5)) { /* C126c (2026-09-19 第 121 站): + 守卫 `子0 不是块(5)` —— GNU 语句表达式 被 降级为 `逗号(块, 读临时)` (解析处 L8507~L8529, 块尾 含 `临时 = 末表达式`); 若 本分支 用「丢弃结果」模式 执行 那个块, 块尾 赋值 被 DCE ⟹ 临时 未写 ⟹ 读 得 0 (实测 feat_zh_stmtexpr_ok ⑤: 5.00 → 0.00). 子0 是块 ⟹ 让位 给 原路径. */ /* C126 (2026-09-19 第 121 站): 逗号 表达式 在 浮点求值 路径 上 的 结果 = **右操作数** —— 原 缺 本判据 ⟹ 落 下行 浮点分支, 发 压浮0/短弊/弹浮0 却 无 运算指令 (丙 是逗号, 四则 全不命中) ⟹ xmm0 = 弹回的 **左操作数** (静默错值: `double r = (7, 2.5)` → 7.00, `(y, 3.5)` → 2.50). 整数 形态 早已正确 (例 节点_二元 的 逗号分支) —— 本条 只是 补齐 浮点 求值 路径, 镜像 那段写法. */
            若 (表达式是否纯(子0[数])) { /* 纯左操作数 结果丢弃 → 完全跳过码生成 */ } 否 { 整 旧丢 = 码生成丢弃结果; 码生成丢弃结果 = 1; 码生成(子0[数]); 码生成丢弃结果 = 旧丢; }
            码生成浮(子1[数]); /* 右操作数 → xmm0 (本节点的值) */
            返;
        }
        若 ((节浮标[子0[数]] && !指元指针(子0[数])) || (节浮标[子1[数]] && !指元指针(子1[数]))) { /* 浮点 减-表达式 (round 46: 指针数组元素 不入浮点通道) */
            码生成浮(子0[数]); 压浮0();
            码生成浮(子1[数]); 短弊(); 弹浮0();
            若 (丙 == 加) 总辛一();
            否 若 (丙 == 减) 整进();
            否 若 (丙 == 乘) 容甲();
            否 若 (丙 == 除) 末一一();
            返;
        }
        码生成(数); 旧挂();
        返;
    }
    若 (暂 == 19 || 暂 == 27) { 码生成(数); 旧挂(); 返; } /* C127b (2026-09-19 第 122 站): **转型包装节点** (19 截断 / 27 窄截断) 的 浮点求值 —— 节点 19/27 的 `码生成` 产出 **整数** 在 eax (cvttsd2si), 故 必须 `旧挂()` 升成 xmm0. 原 无本分支 ⟹ 落到 末尾 兜底 之前 的 `若 (节点浮性(数, -1)) { 码生成(数); 返; }` ⟹ **只发截断 不升级** ⟹ 消费端 取 xmm0 (= 更早的 浮点残值) ⟹ `(双精度)(整数)v` 静默 得 原 v 值 (3.5 应 3.0). 与 上行 整数立即数 分支 同形. */
    若 (暂 == 15) { /* 成员: 双精度 字段 x.d → 双精度移动; 整数 字段 → 转换 */
        若 (子0[数] >= 0 && 节型别[子0[数]] != 1) {
            /* R256 刀5 (2026-09-23): **基 非 变量 的 浮点字段读** (嵌套成员链 lo.in.f / 下标基 / 解引用基 / 箭头基).
               原 本 分支 一律 把 `节名表 + 子0[数]` 当 **变量名** 查 (查变量/变量型序) ⟹ 基 是 成员节点 时 取到 的 是 **字段名**
               (实测 probe6: `lo.in.f` 的 B 站点 打出 基名=in 基型=15 —— 而 单级 `lo.f` 为 基名=lo 基型=1)
               ⟹ 浮点读 打到 无关地址 (实测 r256r `loc in.f` = 4.500001 应 3.500000; 同处 位模式 路径 正确 ⟹ 内存值 对, 只有 值读 错).
               修: 用 `内存地址()` 递归 求 链末字段 地址 (与 嵌套链地址 分支 L25798 同 机制; 地址 落在 r0),
               再 按 **字段元数据** (终捌/终捌单) 发射 movsd / movss+cvt. 无法解析 则 回退 通用路径. */
            整 域尺寸五 = 4, 构序五 = -1;
            若 (内存地址(数, &域尺寸五, &构序五) == 0) {
                整 序五 = (整回 >= 0) ? 整回 : 构序五;
                若 (序五 >= 0 && 终捌(序五, (字*)(节名表 + 数))) {
                    若 (终捌单(序五, (字*)(节名表 + 数))) { 发字节(0xF3); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); 发字节(0xF3); 发字节(0x0F); 发字节(0x5A); 发字节(0xC0); }
                    否 { 汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); }
                    返;
                }
            }
            码生成(数); 旧挂(); 返;
        }
        字 *变节 = (字*)(节名表 + 子0[数]);
        整 偏移 = 查变量(变节);
        整 构序 = 变量型序(变节);
        整 域偏移 = 构序 >= 0 ? 类型偏移(类型表[构序].名, (字*)(节名表 + 数)) : -1;
        若 (域偏移 >= 0 && 终捌(构序, (字*)(节名表 + 数))) {
            整 单浮 = 终捌单(构序, (字*)(节名表 + 数)); /* R4a-0b: 4B float 字段读 → movss+cvt 提升 */
            若 (节值表[数] == 1) { /* 指针->字段: 加载 指针, +域偏移, 解引用 */
                若 (偏移 >= 0) { 若 (变量是否静态(变节)) 移rax内存64(静态位移(偏移, 1) - 1); /* 静态 结构体 指针: 8B .数据 槽位 经 指令指针 */
                               否 若 (变量指元素(变节) > 0) 移寄存器帧64(0, 偏移 - 当前帧大小); 否 移寄存器帧(0, 偏移 - 当前帧大小); }
                若 (域偏移 != 0) 后弊一(域偏移);
                若 (单浮) { 发字节(0xF3); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); 发字节(0xF3); 发字节(0x0F); 发字节(0x5A); 发字节(0xC0); } /* movss xmm0,[堆九] + cvtss2sd */
                否 { 汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); } /* 双精度移动 xmm0, [堆九] */
            } 否 {
                若 (单浮) {
                    若 (变量是否静态(变节)) 载单静(静态位移(偏移, 2) + 域偏移 - 2);
                    否 若 (素系(变节)) { 移寄存器帧64(0, 偏移 - 当前帧大小); 若 (域偏移 != 0) 后弊一(域偏移); 发字节(0xF3); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); 发字节(0xF3); 发字节(0x0F); 发字节(0x5A); 发字节(0xC0); }
                    否 载单帧(变量基(变节, 偏移) + 域偏移 - 当前帧大小); /* H1p (2026-09-11): 原 用 局部 结构体 公式 (偏移 - 尺寸) — ≤8B 构值 形参 的 偏移 是 对象 起点 (素三=1) → 基 差 一 个 尺寸 → 双精度 字段 读 错 槽 (实测 8B 单双 构值 形参 `返 v.d` = 0); 改 经 变量基 (局部/形参 双 正确) */
                } 否 若 (变量是否静态(变节)) 右再(静态位移(偏移, 2) + 域偏移 - 2); /* 静态 结构体.d 字段 经 指令指针 (8-字节 双精度移动) */
                否 若 (素系(变节)) { 移寄存器帧64(0, 偏移 - 当前帧大小); 若 (域偏移 != 0) 后弊一(域偏移); 汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); } /* 大 结构体 参数: 槽位 持有 指针 → 指针+域偏移, 双精度移动 [堆九] (修复 2026-08-07) */
                否 逆厚(变量基(变节, 偏移) + 域偏移 - 当前帧大小); /* H1p (2026-09-11): 同 上 (双精度 分支) — 原 偏移 - 型尺寸 只 对 局部 结构体 成立 */
            }
            返;
        }
    }
    若 (表达式内重(数) == 8 && !表达式基浮(数)) { 码生成(数); 发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2A); 发字节(0xC0); 返; } /* R254 (2026-09-23) 虾米: **8 字节 整数 表达式 的 64 位 提升** —— 原 只 在 分支 1 (`暂 == 1` 变量) 里 按 `变量是否长(变节)` 走 64 位 `cvtsi2sd`; 而 `暂 == 14`(下标) / `暂 == 12`(解引用) **无 分支** ⟹ 落 末尾 兜底 `码生成(数); 旧挂();` (32 位 通道) ⟹ `(双精度)t1.lp[1]` / `(双精度)glp[1]` 静默 得 0.000000 (应 22), 而 「先落 长整 变量 再 转型」却 正确 (r254b H6/H7) ⟹ 判据 只认 **链根变量** (与 R253 六族 同根因). `表达式内重 == 8` 判「值是 8 字节 整数」(`long long*`→8, `double*`→8, `int*`→4), `!表达式基浮` 守卫 ⟹ 浮点 仍 走 浮点 通道 (H8 不受影响). 字节序列 取 自 L21611 (同款). */
    若 (节点浮性(数, -1)) { 码生成(数); 返; } /* 双精度 节点 (数组 元素/变量/字段/调用): 码生成 叶 结果 在 xmm0 */
    若 (暂 == 22) { /* 双精度 三元 (修复 2026-08-25 步十四): 分支求值到 xmm0 — 原 回退 码生成(n)+cvtsi2sd 用 首子 (比较标志) 覆盖 xmm0 */
        整 毛环 = 新标号(), 虚对 = 新标号();
        码生成(子0[数]); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 毛环, 1); /* 条件假 → 毛环 */
        码生成浮(子1[数]); 相对跳转(-1); 补标号(码位 - 4, 虚对, 2);
        设标号(毛环);
        码生成浮(子2[数]);
        设标号(虚对);
        返;
    }
    码生成(数); 旧挂(); /* 回退 */
}

/* ?????? ?????? */
静 整 外陆一(整 序标);
静 整 标劣(整 序标);


/* 格式化打印/输出到文件/putstr: 构建 输出 入 a 帧 暂存 缓冲, 则 WriteFile.
   r10=句柄 后辰=堆平 r12=缓(推进) r14=缓(开始) r13=下一-格式-实参 指针.
   无 调用 至 该 最终 WriteFile, 故 易失 寄存器 是 safe throughout. */
静 整 度壬(整 总伍);
/* 修复 2026-08-25 支持矩阵补全: %e/%E/%g/%G 科学/通用浮点格式化 (字母 在 域+236, is_g 在 域+24
   由 度壬 分发存根在运行时设置; 每 格式化打印 调用只发射一份核心). 64-位 毛简一/分数编号 支持 %.16g. */
静 空 正败(整 号分);
静 空 短组(整 暂终, 整 号分);
/* 修复 2026-08-23 t35e: vsnprintf walks 其 va_list UP (ap, ap+8, ...); 格式化打印/格式化到串 walk
   该 已压 实参 表 DOWN. 现七一 集 此 故 该 fmt_loop advances r13 由 +8. */
静 整 素组 = 0;
静 空 移即扩(整 寄存器, 整 立即数); /* 高-寄存器 立即数 移动 (序布 near 运行库 半未) */
/* 位-字段 码生成器 helpers (真 位 语义, 修复 2026-08-05).
   A 位-字段 lives 之内 a 共享 32-位 槽位: 正聚 = 槽位 字节 偏移,
   高玖 = 位 偏移 在 该 槽位, 间次一 = 宽度. 全 槽位 traffic 是 4-字节. */
静 空 中升(整 寄存器, 整 计数二) { /* 左移 r32, 拷长  (计数二 编译-时间 0..31) */
    若 (计数二 <= 0) 返;
    移即扩(9, 计数二);
    移寄存器(1, 9); /* ecx = 计数二 */
    汇发("    左移 r%d, cl\n", (字*)(长 长)(寄存器), (字*)(长 长)0, (字*)(长 长)0);
    前缀字节(0, 0, 0, 寄存器 & 8); 发字节(0xD3); 模字节(3, 4, 寄存器 & 7);
}
静 空 副降(常 字 *符号数, 常 字 *函) {
    /* 首子 = 整体 槽位 值 → 首子 = 字段 值 (右移 + 且; 有符号 字段 符号-扩展). */
    整 缺繁 = 字段位宽(符号数, 函);
    若 (缺繁 <= 0) 返;
    整 正厚 = 暂进(符号数, 函);
    整 掩码 = 缺繁 >= 32 ? -1 : (1u << 缺繁) - 1; /* 修复 2026-08-09 审计: 1<<31 是有符号溢出 UB, 改 1u */
    若 (正厚 == 0) { 移即扩(9, 掩码); 算寄存器(25, 0, 9); } /* 首子 &= 掩码 */
    否 {
        移寄存器(10, 0); /* r10d = 槽位 值 */
        移即扩(9, 正厚);
        移寄存器(0, 9); /* 首子 = 位 偏移 (移位 计数) */
        原七 = 1;
        算寄存器(帧寅, 10, 0); /* r10d >>= 拷长 (逻辑) */
        移寄存器(0, 10); /* 首子 = shifted 字段 值 */
        移即扩(9, 掩码);
        算寄存器(25, 0, 9); /* 首子 &= 掩码 */
    }
    若 (缺繁 < 32 && !字段是否无符号(符号数, 函)) { /* 有符号 位-字段: 符号-扩展 (修复 2026-08-05) */
        移寄存器(10, 0); /* r10d = 已掩码 字段 值 */
        移即扩(9, 32 - 缺繁);
        移寄存器(0, 9); /* 首子 = 32-缺繁 (移位 计数) */
        算寄存器(号庚, 10, 0); /* r10d <<= 拷长 → 符号 位 lands 在 位 31 */
        原七 = 0; /* 算术 移位 遍 有符号 字段 */
        算寄存器(帧寅, 10, 0); /* r10d >>= 拷长 (算术右移) → 符号-已扩展 */
        移寄存器(0, 10); /* 首子 = 结果 */
    }
}
静 整 存壬(常 字 *符号数, 常 字 *函) {
    /* 堆九 = &槽位, ebx = 右侧 值 → 读取-修改-写入 该 字段 符弊.
       返回 1 当 已处理 (a 位-字段), 0 遍 a plain 字段.
       永不 写入 首子 此处: 首子 是 该 低 32 符弊 的 堆九, 且 堆九 持有 该
       槽位 地址 — writing 首子 zeroes 该 上 源分 且 loses 该 地址. */
    整 缺繁 = 字段位宽(符号数, 函);
    若 (缺繁 <= 0) 返 0;
    整 正厚 = 暂进(符号数, 函);
    整 长汇 = 缺繁 >= 32 ? -1 : ((1u << 缺繁) - 1) << 正厚; /* 修复 2026-08-09 审计: 1u 防有符号溢出 */
    移寄存器内存(10, 0); /* r10d = [堆九] = 旧 槽位 (堆九 keeps 该 地址) */
    移寄存器(11, 3); /* r11d = 右侧 */
    中升(11, 正厚); /* r11d <<= 正厚 */
    移即扩(9, 长汇);
    算寄存器(25, 11, 9); /* r11d &= 字段-符弊 掩码 */
    移即扩(9, ~长汇);
    算寄存器(25, 10, 9); /* r10d &= ~字段-符弊 掩码 (明确 字段 符弊) */
    算寄存器(47, 10, 11); /* r10d |= r11d */
    汇发("    存32rax r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 1, 0, 0); 发字节(0x89); 模字节(0, 2, 0); /* 移动 [堆九], r10d */
    返 1;
}
静 空 缺对(常 字 *串升, 整 参数个数) {
    整 逆成 = !比较字符串(串升, "fprintf");
    整 现伍二 = !比较字符串(串升, "putstr");
    整 短排 = 逆成 ? 2 : 1;
    /* 内核库 (WriteFile) 需 rsp 16-字节 已对齐 于 该 调用 (SSE).
       计算 该 格式-实参 指针 自 该 目辰-对齐 rsp (该 已压 实参 sit
       于 该 目辰-对齐 位置); r15 是 被调者-已存 故 内核库 preserves 它. */
    左壬一(13, 8 * (参数个数 - 1 - 短排)); /* r13 = &首 格式 实参 (目辰-对齐 rsp) */
    移64(15, 4); /* 移动 r15, rsp */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp, -16 */
    /* 保存 堆平 之前 GetStdHandle 破坏 rcx. 该 堆平 槽位 是 于 该 目辰-对齐
       位置: 遍 格式化打印 它's 实参零 (仍 在 rcx); 遍 输出到文件 它's 实参一 = [r13+8]
       (r13 是 a 目辰-对齐 地址, immune 到 该 `且 rsp,-16` 移位).
       重要: 该 堆平 必须 非 是 parked 在 该 栈 影子 空间 ([rsp+8..32]
       于 该 调用) �?内核库 拥有 那 region 且 破坏 它. rbx 是 被调者-已存,
       preserved 由 GetStdHandle, 且 restored 由 该 尾声, 故 它's a safe 槽位. */
    若 (逆成) {
        汇发("    取64 r0, [r13+8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x45); 发字节(8); /* 移动 堆九, [r13+8] = 堆平 (实参一) */
        移64(3, 0);    /* rbx = 堆平 (被调者-已存, 幸存 调用) */
        /* 修复 2026-08-19: 输出到文件 必须写 文件* 而非 输出流 — 版本库 create_symref_locked
           输出到文件(get_lock_file_fp(&锁->lk), "见: %s\n", 目标) 曾全部打进 输出流
           → 头.锁 空/头 空/残留 .锁。分派 (r10=目标, 域+248=是否文件描述符 标志):
           函数指针==0 → 输出流 (自身-宿主 的 错误流 值被置 0, 保持旧行为);
           函数指针<0x10000 → 编译器 打开文件 的 句柄 → WriteFile(函数指针,...);
           函数指针≥0x10000 → msvcrt fdopen 的 运行库 文件* → 取 _iobuf._file(fd)@+28 → _write(fd,...). */
        整 首细 = 新标号(), 总酉 = 新标号(), 计丙 = 新标号();
        移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 248, 0); /* 是否文件描述符 = 0 — 必须先存 (移即 会清 堆九) */
        汇发("    取64 r0, [r13+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x45); 发字节(16); /* 移动 堆九, [r13+16] = 函数指针 (实参零; [r13]=首变参, [r13+8]=堆平) */
        测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 首细, 3);
        /* 函数指针 == 0 → 输出流 */
        移即(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
        减栈即(32);
        调导入(0);       /* GetStdHandle */
        加栈即(32);
        移64(10, 0);   /* r10 = 句柄 */
        相对跳转(-1); 补标号(码位 - 4, 计丙, 2);
        设标号(首细);
        汇发("    比较64 r0, 0x10000\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x3D); 发四(0x10000); /* 比较 堆九, 0x10000 */
        发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 总酉, 8); /* jb → 句柄 */
        /* 运行库 文件* (msvcrt fdopen): _iobuf._file (fd) @ +28 (实测 msvcrt _iob: 偏移=28 数值=fd; UCRT 才是 24 — 版本库 链 msvcrt; 修复 2026-08-19) */
        发字节(0x8B); 发字节(0x40); 发字节(28); /* 移动 首子, [堆九+28] */
        移64(10, 0);   /* r10 = fd */
        移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 248, 0); /* 是否文件描述符 = 1 */
        相对跳转(-1); 补标号(码位 - 4, 计丙, 2);
        设标号(总酉);
        移64(10, 0);   /* r10 = 函数指针 (编译器 打开文件 句柄) */
        设标号(计丙);
    } 否 {
        移64(0, 1); /* 堆九 = rcx = 堆平 (实参零) */
        移64(3, 0);    /* rbx = 堆平 (被调者-已存 — 幸存 GetStdHandle) */
        移即(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
        减栈即(32);   /* 影子 空间 遍 GetStdHandle — 修复 2026-08-03: 曾 缺失 (应用二进制接口 需 32B) */
        调导入(0);       /* 首子 = 句柄 */
        加栈即(32);
        移64(10, 0);   /* r10 = 句柄 */
    }
    移64(11, 3);   /* 后辰 = 堆平 */
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = 缓 — 缓冲下移到状态区之下 [rbp-4368] (修复 2026-08-06: 原与状态槽/&已写 重叠) */
    移64(14, 12);  /* r14 = 缓 开始 */
    整 段辰;
    若 (现伍二) {
        整 半拆 = 新标号();
        段辰 = 新标号();
        设标号(半拆);
        汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] */
        测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 段辰, 1);
        现午(); /* 移动 [r12], 拷长 */
        汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
        汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
        相对跳转(-1); 补标号(码位-4, 半拆, 2);
    } 否 {
        段辰 = 度壬(-272); /* 格式化打印/putstr 链：%s 拷贝以 rbp-272 为界（计简一 修复 2026-08-06） */
    }
    设标号(段辰);
    /* 长度 = r12 - r14 */
    移64(0, 12); 汇发("    减64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3, 6, 0); /* 减 堆九, r14 */
    移寄存器(8, 0); /* r8 = 长度 */
    若 (满双) { /* 修复 2026-08-10 门 9: 左退一 格式化打印 -> ���� COM1 0x3F8, �� 内核库 */
        整 单败一 = 新标号(), 长己 = 新标号(), 缓三 = 新标号();
        设标号(单败一);
        测寄存器(8, 8); 零跳(-1); 补标号(码位-4, 缓三, 1);
        设标号(长己);
        移即(2, 0x3FD); /* THR 状态 寄存器 */
        汇发("    ���˿� al, dx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xEC); /* 在 累加低, dx */
        发字节(0xA8); 发字节(0x20); /* 测试 累加低, 0x20 (THRE) */
        零跳(-1); 补标号(码位-4, 长己, 1);
        前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 6); /* 移动 累加低, [r14] */
        移即(2, 0x3F8);
        汇发("    д�˿� dx, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xEE); /* 出 dx, 累加低 */
        汇发("    ���� r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 6); /* 递增 r14 */
        前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 0); /* 递减 r8d */
        相对跳转(-1); 补标号(码位-4, 单败一, 2);
        设标号(缓三);
    } 否 {
    减栈即(32);
    整 存次 = -1;
    若 (逆成) {
        /* 是否文件描述符(域+248)==1 -> msvcrt _write(fd, 缓, 长度); 否则 WriteFile(句柄, 缓, 长度, &已写, 空) (修复 2026-08-19) */
        整 邻失 = 新标号();
        存次 = 新标号();
        移寄存器帧(0, 临时基 - 当前帧大小 + 248); /* 首子 = 是否文件描述符 */
        测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 邻失, 1);
        减栈即(32); /* 影子 空间 遍 _write */
        移64(1, 10); /* rcx = fd */
        移64(2, 14); /* rdx = 缓 */
        /* r8 = 长度 已 */
        若 (链接模式) {
            发字节(0xE8); 发四(0); /* 调用 三十二位相对 - 链接器 解析 _write -> msvcrt 导入 */
            缺亥(码位 - 4, 0x0004, 新又("_write"), 0);
        } 否 {
            调导入(88); /* _write 导入表 槽位 (msvcrt, 2026-08-28 阶段一 #246: 内核库 15→17 → _write 39→41) */
        }
        加栈即(32);
        相对跳转(-1); 补标号(码位 - 4, 存次, 2);
        设标号(邻失);
    }
    移64(1, 10); /* rcx = 句柄 */
    移64(2, 14); /* rdx = 缓 */
    取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &已写 */
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 0 (8-字节 空 重叠 - arg5 于 [rsp+32] 每 真 应用二进制接口) */
    调导入(1);       /* WriteFile */
    加栈即(32);
    若 (逆成) 设标号(存次);
    }
    移64(4, 15); /* 移动 rsp, r15 �?恢复 原 栈 位置 */
}
静 空 标得(整 参数个数) {
    
    /* 修复 2026-08-23 t49e: vfprintf(函数指针, 堆平, 实参) - 函数指针 是 该 编译器 standard 流
       (0=输出流/错误流 宏) -> 路由 经 WriteFile(GetStdHandle) exactly 像 该
       输出到文件 内置. Direct msvcrt vfprintf(函数指针=0) crashes 之内 RtlEnterCriticalSection
       (color_vfprintf -> vfprintf(s->函数指针=输出流=0) -> 状态 --短整 段错误).
       实参 已 已压 (编译器 右-到-左: 实参, 堆平, 函数指针) 故 该 目辰-已对齐 rsp 持有
       [rsp]=函数指针, [rsp+8]=堆平, [rsp+16]=实参. r15 是 被调者-已存 (内核库 preserves 它). */
    整 首细 = 新标号(), 总酉 = 新标号(), 计丙 = 新标号();
    移64(15, 4); /* 移动 r15, rsp (目辰-对齐) */
    若 (参数个数 == 3) {
        /* va_list 例 (color_vfprintf -> vfprintf(函数指针, 堆平, 实参)): 编译器 推送 实参零 首 (highest 地址)
           -> [r15+16]=函数指针, [r15+8]=堆平, [r15]=实参 */
        汇发("    \xe5\x8f\x96 64 r0, [r15+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(16); /* 移动 堆九, [r15+16] = 函数指针 */
        汇发("    \xe5\x8f\x96 64 r0, [r15]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(0); /* 移动 堆九, [r15] = 实参 */
        移64(13, 0); /* r13 = 实参 (va_list) */
    } 否 {
        /* varargs 调用: [r15+8*(实参数-1)]=函数指针, [r15+8*(实参数-2)]=堆平, varargs 开始 于 [r15+8*(实参数-3)] */
        汇发("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (参数个数 - 1)), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(8 * (参数个数 - 1) & 0xff); /* 移动 堆九, [r15+8*(实参数-1)] = 函数指针 */
        左壬一(13, 8 * (参数个数 - 3)); /* r13 = &首 vararg */
    }
    汇发("    \xe5\xaf\xb9\xe9\xbd\x90\xe6\xa0\x88\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp, -16 */
    /* 堆平 -> rbx (被调者-已存, 幸存 GetStdHandle); 函数指针 stays 在 堆九 遍 分派 */
    若 (参数个数 == 3) {
        汇发("    \xe5\x8f\x96 64 r0, [r15+8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(8); /* 移动 堆九, [r15+8] = 堆平 */
        移64(3, 0); /* rbx = 堆平 */
        汇发("    \xe5\x8f\x96 64 r0, [r15+16]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(16); /* 移动 堆九, [r15+16] = 函数指针 */
    } 否 {
        汇发("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (参数个数 - 2)), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(8 * (参数个数 - 2) & 0xff); /* 移动 堆九, [r15+8*(实参数-2)] = 堆平 */
        移64(3, 0); /* rbx = 堆平 */
        汇发("    \xe5\x8f\x96 64 r0, [r15+%d]\n", (字*)(长 长)(8 * (参数个数 - 1)), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x47); 发字节(8 * (参数个数 - 1) & 0xff); /* 移动 堆九, [r15+8*(实参数-1)] = 函数指针 */
    }
    /* 函数指针 分派: 函数指针==0 -> 输出流 (GetStdHandle); 函数指针<0x10000 -> 编译器 打开文件 句柄; 否则 运行库 文件* -> _file fd */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 248, 0); /* 是否文件描述符 = 0 */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 首细, 3);
    移即(1, -11); /* ecx = -11 = STD_OUTPUT_HANDLE */
    减栈即(32); 调导入(0); 加栈即(32); /* GetStdHandle */
    移64(10, 0); /* r10 = 句柄 */
    相对跳转(-1); 补标号(码位 - 4, 计丙, 2);
    设标号(首细);
    汇发("    \xe6\xaf\x94\xe8\xbe\x83 64 r0, 0x10000\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x3D); 发四(0x10000); /* 比较 堆九, 0x10000 */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 总酉, 8); /* jb -> 句柄 */
    发字节(0x8B); 发字节(0x40); 发字节(28); /* 移动 首子, [堆九+28] = _file fd */
    移64(10, 0); /* r10 = fd */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 248, 0); /* 是否文件描述符 = 1 */
    相对跳转(-1); 补标号(码位 - 4, 计丙, 2);
    设标号(总酉);
    移64(10, 0); /* r10 = 函数指针 (句柄) */
    设标号(计丙);
    移64(11, 3); /* 后辰 = 堆平 */
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = 缓 */
    移64(14, 12); /* r14 = 缓 开始 */
    整 段辰 = 度壬(-272);
    设标号(段辰);
    /* 长度 = r12 - r14 */
    移64(0, 12); 汇发("    \xe5\x87\x8f 64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3, 6, 0); /* 减 堆九, r14 */
    移寄存器(8, 0); /* r8 = 长度 */
    减栈即(32);
    整 邻失 = 新标号();
    整 存次 = 新标号();
    移寄存器帧(0, 临时基 - 当前帧大小 + 248); /* 首子 = 是否文件描述符 */
    测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 邻失, 1);
    减栈即(32); /* 影子 空间 遍 _write */
    移64(1, 10); /* rcx = fd */
    移64(2, 14); /* rdx = 缓 */
    若 (链接模式) { 发字节(0xE8); 发四(0); 缺亥(码位 - 4, 0x0004, 新又("_write"), 0); }
    否 调导入(88); /* _write (2026-08-28 阶段一 #246: 39→41) */
    加栈即(32);
    相对跳转(-1); 补标号(码位 - 4, 存次, 2);
    设标号(邻失);
    移64(1, 10); /* rcx = 句柄 */
    移64(2, 14); /* rdx = 缓 */
    取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &已写 */
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 0 重叠 */
    调导入(1); /* WriteFile */
    加栈即(32);
    设标号(存次);
    移64(4, 15); /* 移动 rsp, r15 */
}


/* 修复 2026-08-12 scanf: 实参 已 已压 (堆平 首, 则 &a, &b...).
   读取 输入流 (GetStdHandle(-10) + ReadFile) 入 [rbp-4368] 缓, 则 调用
   _scanf_rt(堆平, 实参, 缓, 长度) 自 运行时库.c 到 解析 堆平 且 写入 回.
   返回 计数 的 已转换 项 在 首子. */
静 空 前子(整 参数个数) {
    整 总辛 = 查函数("_scanf_rt");
    左壬一(13, 8 * (参数个数 - 1)); /* r13 = &堆平 (实参零, 已压 首 = deepest; 实参 于 [r13+8..]) */
    移64(15, 4); /* r15 = 目辰-对齐 rsp */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp, -16 */
    移即(1, -10); /* ecx = -10 = STD_INPUT_HANDLE */
    减栈即(32);
    调导入(0); /* 首子 = 输入流 句柄 */
    加栈即(32);
    移64(10, 0); /* r10 = 句柄 */
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = 缓 (被调者-已存 — ReadFile 破坏 后辰, 同 格式化打印) */
    取帧址(9, 临时基 + 240 - 当前帧大小);   /* r9 = &读取 */
    减栈即(48);
    移64(1, 10); 移64(2, 12);
    移即扩(8, 4096);
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 0 (重叠) */
    调导入(3); /* ReadFile */
    加栈即(48);
    移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* 首子 = 字节 读取 */
    移64(9, 0); /* r9 = 长度 */
    汇发("    取64 r1, [r13]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x4D); 发字节(0); /* rcx = 堆平 */
    /* 构造正序 实参 数组到 [rbp+元平]: 实参[k] = [r13-8-8k] 槽值 (参数按 堆平,&a,&b 压栈 → &a 在 [r13-8], &b 在 [r13-16]...).
       负索引 实参[-参序] 在 编译器 编译会丢符号 (2026-08-12) → 显式正序拷贝. */
    { 整 元平 = -(272 + 8 * 参数个数);
      遍 (整 键 = 0; 键 < 参数个数 - 1; 键++) {
          汇发("    取64 r0, [r13%+d]\n", (字*)(长 长)(-(8 + 8 * 键)), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x8B); 发字节(0x45); 发字节(-(8 + 8 * 键)); /* 移动 堆九, [r13-8-8k] */
          汇发("    存64 [rbp%+d], r0\n", (字*)(长 长)(元平 + 8 * 键), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x89); 模字节(2, 0, 5); 发四(元平 + 8 * 键); /* 移动 [rbp+元平+8k], 堆九 */
      }
      取帧址(2, 元平); /* rdx = 实参 数组 */
    }
    移64(8, 12); /* r8 = 缓 */
    若 (总辛 >= 0) { /* _scanf_rt(堆平=rcx, 实参=rdx, 缓=r8, 长度=r9, 已消费=空) */
        减栈即(48); /* 影子 32 + 5th 实参 8 + 填充 8 */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 空 (已消费 不需要 — scanf 无续读) */
        相对调用(0);
        补标号(码位 - 4, 函数表[总辛].标号一, 0);
        加栈即(48);
    }
    移64(4, 15); /* rsp = r15 (恢复 目辰-对齐) */
}

/* sscanf(字符串, 堆平, &a, ...): 缓=实参零, 堆平=实参一, 实参=实参二.. — 复用 _scanf_rt(堆平,实参,缓,长度) (修复 2026-08-25 步十一) */
静 空 右轮(整 参数个数) {
    整 总辛 = 查函数("_scanf_rt");
    整 反丁 = 8 * (参数个数 - 1); /* 实参零 槽偏移 (rsp 相对): 参数从栈深向浅 实参零=[rsp+反丁], 实参一=[rsp+反丁-8], 实参二+k=[rsp+反丁-16-8k] */
    移64(15, 4); /* r15 = 目辰-对齐 rsp */
    移寄存器栈64(8, 反丁);      /* r8 = 实参零 (字符串/缓) */
    /* r9 = 取字长(字符串): r8 扫描到 \0 */
    移64(11, 8); /* 后辰 = 缓 保存 */
    移即(0, 0); /* 首子 = 0 (长度) */
    整 净对 = 新标号(), 虚对 = 新标号();
    设标号(净对);
    汇发("    零扩展 ecx, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 0); /* 零扩展 ecx, 字节 [r8] */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 虚对, 1);
    汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 1); 发字节(0xFF); 模字节(3, 0, 0); /* 递增 r8 */
    汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC0); /* 递增 首子 */
    相对跳转(-1); 补标号(码位-4, 净对, 2);
    设标号(虚对);
    移64(9, 0);  /* r9 = 长度 */
    移64(8, 11); /* r8 = 缓 (恢复) */
    移寄存器栈64(1, 反丁 - 8);  /* rcx = 实参一 (堆平) */
    /* 实参 数组: 实参二+k = [rsp+反丁-16-8k] → [rbp+元平+8k] */
    { 整 元平 = -(272 + 8 * (参数个数 - 2));
      遍 (整 键 = 0; 键 < 参数个数 - 2; 键++) {
          移寄存器栈64(0, 反丁 - 16 - 8 * 键); /* 堆九 = 实参二+k */
          汇发("    存64 [rbp%+d], r0\n", (字*)(长 长)(元平 + 8 * 键), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x89); 模字节(2, 0, 5); 发四(元平 + 8 * 键); /* 移动 [rbp+元平+8k], 堆九 */
      }
      取帧址(2, 元平); /* rdx = 实参 */
    }
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
    减栈即(48);
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 空 (已消费 — sscanf 无续读) */
    若 (总辛 >= 0) { 相对调用(0); 补标号(码位 - 4, 函数表[总辛].标号一, 0); }
    加栈即(48);
    移64(4, 15); /* rsp = r15 */
}

/* fscanf(函数指针, 堆平, &a, ...): 从 文件*(句柄) 读 4096 字节到 缓, 复用 _scanf_rt (修复 2026-08-25 步十二)
   续读 (修复 步二十三): _scanf_rt 报告 已消费, 未消费部分 SetFilePointer 回退 — 多次 fscanf 同 文件* 连续解析 */
静 空 域七(整 参数个数) {
    整 总辛 = 查函数("_scanf_rt");
    整 反丁 = 8 * (参数个数 - 1); /* 实参零 = 函数指针, 实参一 = 堆平, 实参二+k = 实参 (rsp 相对) */
    移寄存器栈64(0, 反丁); /* 堆九 = 实参零 (函数指针/句柄) */
    移64(10, 0);          /* r10 = 句柄 */
    反附(临时基 + 260 - 当前帧大小, 10); /* 保存 句柄 到 暂存 (8B, 独立槽 — 原 252 与 已消费@256 重叠高32位被污染) */
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = 缓 */
    取帧址(9, 临时基 + 240 - 当前帧大小);   /* r9 = &读取 */
    移64(15, 4);
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
    减栈即(48); /* 影子 32 + 1 栈 实参 8 + 填充 8 */
    移64(1, 10); 移64(2, 12);
    移即扩(8, 4096);
    移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 空 (重叠) */
    调导入(3); /* ReadFile */
    加栈即(48);
    移64(4, 15);
    移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* 首子 = 字节 读取 */
    汇发("    存32 [rbp%+d], eax\n", (字*)(长 长)(临时基 + 248 - 当前帧大小), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x89); 模字节(2, 0, 5); 发四(临时基 + 248 - 当前帧大小); /* 存 bytes_read 供回退计算 (修复 步二十三; 模字节 堆再=5=rbp 非 堆九) */
    移64(9, 0);  /* r9 = 长度 */
    移64(8, 12); /* r8 = 缓 */
    移寄存器栈64(1, 反丁 - 8);  /* rcx = 堆平 (实参一) */
    { 整 元平 = -(272 + 8 * (参数个数 - 2));
      遍 (整 键 = 0; 键 < 参数个数 - 2; 键++) {
          移寄存器栈64(0, 反丁 - 16 - 8 * 键); /* 堆九 = 实参二+k */
          汇发("    存64 [rbp%+d], r0\n", (字*)(长 长)(元平 + 8 * 键), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x89); 模字节(2, 0, 5); 发四(元平 + 8 * 键); /* 移动 [rbp+元平+8k], 堆九 */
      }
      取帧址(2, 元平); /* rdx = 实参 */
    }
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
    减栈即(48);
    取帧址(0, 临时基 + 256 - 当前帧大小); 移栈寄存器64(32, 0); /* [rsp+32] = &已消费 (5th 实参, 修复 步二十三) */
    若 (总辛 >= 0) { 相对调用(0); 补标号(码位 - 4, 函数表[总辛].标号一, 0); }
    加栈即(48);
    /* 保存 fscanf 返回值 (首子=参序) — 后续回退计算会破坏 首子 (修复 步二十三: 原 n=0 / SetFilePointer 返回值覆盖) */
    汇发("    存32 [rbp%+d], eax\n", (字*)(长 长)(临时基 + 244 - 当前帧大小), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x89); 模字节(2, 0, 5); 发四(临时基 + 244 - 当前帧大小);
    /* 续读回退: 剩余 = bytes_read - 已消费; 剩余>0 时 SetFilePointer(句柄, -剩余, 空, FILE_CURRENT=1) — 未消费字节下次 fscanf 重新读到 (修复 步二十三) */
    移寄存器帧64(0, 临时基 + 260 - 当前帧大小); 移64(10, 0); /* r10 = 句柄 (从独立槽重载 — r10 易失且对齐后栈槽偏移) */
    移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* 首子 = bytes_read */
    移寄存器帧(1, 临时基 + 256 - 当前帧大小); /* ecx = 已消费 */
    汇发("    减 r0, r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x29); 模字节(3, 1, 0); /* 减 首子, ecx → 剩余 */
    { 整 外八 = 新标号();
      测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 外八, 1); /* 剩余==0 → 跳过回退 */
      汇发("    取反 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xD8); /* 取负 首子 → -剩余 */
      移64(1, 10);  /* rcx = 句柄 */
      移64(2, 0);   /* rdx = -剩余 (回退距离) */
      移即扩(8, 0); /* r8 = 空 (lpDistanceToMoveHigh) */
      移即扩(9, 1); /* r9 = FILE_CURRENT */
      汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
      减栈即(32);
      调导入(5); /* SetFilePointer */
      加栈即(32);
      设标号(外八);
    }
    移寄存器帧(0, 临时基 + 244 - 当前帧大小); /* 首子 = 恢复 fscanf 返回值 (修复 步二十三) */
    移64(4, 15); /* rsp = r15 */
}

/* 共享 %d/%s/%c/%% 格式 循环: 后辰=堆平 r12=出(推进) r13=下一-实参 指针.
   返回 该 段辰 标号一 该 调用方 必须 设标号() 之后 该 循环. */
/* 共享 十进制-数字 emitter: 打印 |ebx| (带 '-' 符号) 入 该 r12 缓冲,
   则 跳转 到 `尾`. 已用 由 %d (尾=容低) 且 %f (尾=帧序二 小数 路径). */
静 空 域重一(整 号分) {
    整 空八一 = 新标号(), 净从 = 新标号(), 首甲 = 新标号(), 间寅 = 新标号(); /* 修复 2026-08-23 t35g */
    取帧址(8, 临时基 + 248 + 12 - 当前帧大小); /* r8 = 数字 临时 结束 */
    移64(9, 8); /* r9 = 临时 结束 (推进) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 4); /* 首子 = 符号完成 (修复 2026-08-23 t35g: 符组 已提前输出) */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 空八一, 1); /* 符号 已输出 → 直接数字 */
    汇发("    测试64 r3, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 3, 3); 发字节(0x0F); 发字节(0x89); 发四(0); 补标号(码位-4, 净从, 4); /* A37: 测试 rbx 64 位 + jns (原 32 位 测试 → 高 32 位 非零 时 误判 负) */
    移即(0, '-'); 存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移64(0, 3); 汇发("    取反64 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 发字节(0xD8); 移64(3, 0); /* A37: 64 位 取反 (原 32 位 取反 → INT32_MIN 溢出 得 自身 → 逐位 垃圾) */
    相对跳转(-1); 补标号(码位-4, 空八一, 2);
    设标号(净从);
    移寄存器帧(0, 临时基 - 当前帧大小 + 0); /* 首子 = plus 标志 */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 空八一, 1);
    移即(0, '+'); 存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    设标号(空八一);
    移64(0, 3); /* A37: 首子 = 值 (64 位) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    移即(1, 10); /* ecx = 10 */
    汇发("    整除64 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 发字节(0xF9); /* A37: 64 位 除 rcx: 首子=quot, 段浅=rdx */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* 加 链弊, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* 移动 [r9], 链弊 */
    汇发("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 0, 0); 非零跳(-1); 补标号(码位-4, 首甲, 3); /* A37: 64 位 测试 r0 (原 32 位 测寄存器) */
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* 移动 累加低, [r9] */
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* 比较 r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %lld: 64-位 有符号 十进制 (修复 2026-08-06) — 值 在 rbx, 临时 [rbp-56..] 24B, 拷贝 向前 */
静 空 缓序(整 号分) {
    整 空八一 = 新标号(), 前亥 = 新标号(), 首甲 = 新标号(), 间寅 = 新标号(); /* 修复 2026-08-23 t35g */
    取帧址(8, 临时基 + 192 + 24 - 当前帧大小); /* r8 = 邻辰 临时 结束 [rbp-56] */
    移64(9, 8); /* r9 = 临时 结束 (推进) */
    汇发("    测试64 r3, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 3, 3); /* 测试 rbx, rbx (修复: B 位必须 0，否则 堆再=3 变 后辰) */
    发字节(0x0F); 发字节(0x89); 发四(0); 补标号(码位-4, 前亥, 4); /* jns: + 标志检查 (修复 2026-08-23 t35g) */
    移即(0, '-'); 存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    取反64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xF7); 模字节(3, 3, 3); /* 取负 rbx (修复 2026-08-06: 扩展前缀.B 必须 0，49 F7 栈甲 是 取负 后辰 → 除 商溢出 #DE 崩溃) */
    相对跳转(-1); 补标号(码位-4, 空八一, 2);
    设标号(前亥);
    移寄存器帧(0, 临时基 - 当前帧大小 + 0); /* 首子 = plus 标志 */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 空八一, 1);
    移即(0, '+'); 存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    设标号(空八一);
    移64(0, 3); /* 堆九 = 值 (正) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    移即(1, 10); /* ecx = 10 */
    汇发("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1); /* 除 rcx */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* 加 链弊, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* 移动 [r9], 链弊 */
    汇发("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 0, 0); /* 测试 堆九, 堆九 */    非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* 移动 累加低, [r9] */
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* 比较 r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %llu: 64-位 无符号 十进制 数字 入 [r12], 则 跳转 尾 (修复 2026-08-06).
   无 符号 处理 (rbx 是 无符号 长整 长整); 除 rcx 无符号 64-位. */
静 空 堆轮(整 号分) {
    整 首甲 = 新标号(), 间寅 = 新标号();
    取帧址(8, 临时基 + 192 + 24 - 当前帧大小); /* r8 = 临时 结束 (reuse 邻辰 临时 区域 [rbp-56]) */
    移64(9, 8); /* r9 = 临时 结束 (推进) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    移即(1, 10); /* ecx = 10 */
    汇发("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1); /* 除 rcx */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* 加 链弊, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* 移动 [r9], 链弊 */
    汇发("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 0, 0); /* 测试 堆九, 堆九 */
    非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* 移动 累加低, [r9] */
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* 比较 r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %u: 无符号 十进制 数字 (无 符号 处理, 除 非 除 — 修复 2026-08-05:
   %u 曾 一 未知 规格 → 吞掉). ebx = 值, 数字 入 [r12], 跳转 尾. */
静 空 宽七(整 号分) {
    整 首甲 = 新标号(), 间寅 = 新标号();
    取帧址(8, 临时基 + 248 + 12 - 当前帧大小); /* r8 = 数字 临时 结束 */
    移64(9, 8); /* r9 = 临时 结束 (推进) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    移即(1, 10); /* ecx = 10 */
    汇发("    无符号除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* 除 ecx: 首子=quot, edx=段浅 */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* 加 链弊, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* 移动 [r9], 链弊 */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* 移动 累加低, [r9] */
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* 比较 r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %o: 无符号 八进制 数字 入 [r12] (ebx = 值, 基 8). 修复 2026-08-22 t47:
   %o 曾 一 未知 规格 → 吞掉 (无 输出, 无 实参 消费) → 参数表错位 →
   版本库 暂双-文件 -s 的 "%s%06o %s %d" 后续 %s 读到 模式 当指针 取字长 → 段错误. */
静 空 池组(整 号分) {
    整 首甲 = 新标号(), 间寅 = 新标号();
    取帧址(8, 临时基 + 248 + 12 - 当前帧大小); /* r8 = 数字 临时 结束 */
    移64(9, 8); /* r9 = 临时 结束 (推进) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    移即(1, 8); /* ecx = 8 */
    汇发("    无符号除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* 除 ecx: 首子=quot, edx=段浅 */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* 加 链弊, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* 移动 [r9], 链弊 */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 首甲, 3);
    /* 修复 2026-08-23 t35d: %06o 宽度/零填充 — W=域+232, 零-标志=域+264 (差异-树/暂双-文件 模式) */
    { 整 内列 = 新标号(), 暂双一 = 新标号(), 尾五 = 新标号(), 外繁 = 新标号();
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* 首子 = W */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 内列, 1); /* W==0 -> 无填充 */
    移64(0, 8); 汇发("    减64 r0, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3,1,0); /* 堆九 = r8 - r9 = 长度 (r8=临时 结束, r9=数字开头) */
    移帧寄存器(临时基 - 当前帧大小 + 240, 0); /* 存 长度 (域+240 临时) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* 首子 = W */
    移寄存器帧(2, 临时基 - 当前帧大小 + 240); /* edx = 长度 */
    汇发("    减32 r0, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x29); 模字节(3, 2, 0); /* 首子 = W - 长度 = 填充 */
    移寄存器(2, 0); /* edx = 填充 计数 */
    移寄存器帧(1, 临时基 - 当前帧大小 + 264); /* ecx = 零-标志 */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 尾五, 1);
    移即(0, '0'); 相对跳转(-1); 补标号(码位-4, 外繁, 2);
    设标号(尾五); 移即(0, ' ');
    设标号(外繁);
    设标号(暂双一);
    测寄存器(2, 2); 零跳(-1); 补标号(码位-4, 内列, 1);
    存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* 递减 edx */
    相对跳转(-1); 补标号(码位-4, 暂双一, 2);
    设标号(内列); }
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* 移动 累加低, [r9] */
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* 比较 r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* %x/%X: 无符号 十六进制 数字 入 [r12] (ebx = 值, 基 16; 上=1 → 'A'-'F').
   修复 2026-08-05: %x 曾 一 未知 规格 → 吞掉 (无 输出, 无 实参 消费). */
静 空 容属(整 号分, 整 帧二) {
    整 首甲 = 新标号(), 间寅 = 新标号(), 终又 = 新标号(), 反伍 = 新标号();
    取帧址(8, 临时基 + 248 + 12 - 当前帧大小); /* r8 = 临时 结束 */
    移64(9, 8); /* r9 = 临时 结束 (推进) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    移即(1, 16); /* ecx = 16 */
    汇发("    无符号除 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* 除 ecx: 首子=quot, edx=段浅 */
    汇发("    比较字节即 r2, 10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xFA); 发字节(10); /* 比较 链弊, 10 (修复 2026-08-05: 曾 比较字节 = 中文汇编 发射 38 深零 → 计简一 偏移-由-一) */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位-4, 终又, 8); /* jb 终又 (链弊 是 0-15 无符号: jb == jl 此处; 全附=8=低于跳 匹配 中文汇编's 0F 82 — 修复 2026-08-05) */
    若 (帧二) { 汇发("    加字节 r2, 0x37\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x37); /* 加 链弊, 0x37 = 'A'-10 (%X) */ }
    否 { 汇发("    加字节 r2, 0x57\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x57); /* 加 链弊, 0x57 = 'a'-10 */ }
    相对跳转(-1); 补标号(码位-4, 反伍, 2);
    设标号(终又);
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* 加 链弊, '0' */
    设标号(反伍);
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* 移动 [r9], 链弊 */
    测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* 移动 累加低, [r9] */
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* 比较 r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}
/* 修复 2026-08-09 审计#7: %#x/%#X 前缀 + %0顺分 宽度填充（在 容属 前调用）。
   ebx = 值; 域+232=W; 域+260=#标志; 域+264=0标志; 余散一='x'/'X'（调用点传字面量, 宿主/mirror 字节一致）。
   输出顺序: 零填充: 前缀 → 填充 个 '0' → 数字; 空格/无宽: 填充 ' ' → 前缀 → 数字.
   ⚠️ 容属 从 首子 取值 — 末尾必须恢复 首子 = ebx */
静 空 首升(整 号分, 整 帧二, 整 余散一) {
    整 度壬一 = 新标号(), 上转 = 新标号(), 值拾 = 新标号(), 尾五 = 新标号(), 终低一 = 新标号(), 缓利 = 新标号();
    /* 数 十六进制 位数 → r9d（做-循环: 值 0 计 1 位; 值留在 ebx, 不碰 首子） */
    移寄存器(8, 3); 移即扩(9, 0); /* r8d = ebx; r9d = 0 */
    设标号(度壬一);
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9d */
    前缀字节(0,0,0,1); 发字节(0xC1); 模字节(3, 5, 0); 发字节(4); /* 右移 r8d, 4 */
    汇发("    逻辑右移 r8, 4\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); /* 修复 2026-08-12 计简一 对等: 裸发射补 汇发 文本 (中文汇编 汇编需要) */
    测寄存器(8, 8); 非零跳(-1); 补标号(码位-4, 度壬一, 3);
    /* 填充 = W - 长度 - (哈希?2:0) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* 首子 = W */
    移寄存器(2, 9); 算寄存器(旧肆, 0, 2); /* edx = 长度; 首子 = W - 长度 */
    移寄存器帧(1, 临时基 - 当前帧大小 + 260); /* ecx = #标志 */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 上转, 1); /* !#: 跳过 -2 */
    移即(1, 2); 算寄存器(旧肆, 0, 1); /* 首子 -= 2 */
    设标号(上转);
    移寄存器(2, 0); /* edx = 填充 */
    移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 终低一, 6); /* 比较 首子,0; jle 终低一: 无填充直接前缀+数字 */
    /* 填充 > 0: 检查 0 标志 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 264); /* 首子 = 0标志 */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 尾五, 1); /* 零跳 尾五: 空格填充 (修复 2026-08-12: 全附 3→1, 文本非零跳→为零跳, 计简一 对等) */
    /* 零填充: 先前缀, 再 填充 个 '0' */
    移寄存器帧(1, 临时基 - 当前帧大小 + 260); /* ecx = #标志 */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 值拾, 1);
    移即(0, '0'); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    移即(0, 余散一); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    设标号(值拾);
    移即(0, '0'); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 移动 [r12],'0'; 递增 r12 */
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* 递减 edx */
    非零跳(-1); 补标号(码位-4, 值拾, 3);
    相对跳转(-1); 补标号(码位-4, 缓利, 2);
    /* 空格填充: 填充 个 ' ' 再前缀 */
    设标号(尾五);
    移即(0, ' '); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* 递减 edx */
    非零跳(-1); 补标号(码位-4, 尾五, 3);
    /* 前缀(若有) — 空格路径与无填充路径共用 */
    设标号(终低一);
    移寄存器帧(1, 临时基 - 当前帧大小 + 260); /* ecx = #标志 */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 缓利, 1);
    移即(0, '0'); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    移即(0, 余散一); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    设标号(缓利);
    移寄存器(0, 3); /* ⚠️ 首子 = ebx = 值 (容属 从 首子 取值) */
    容属(号分, 帧二);
}
/* %llx/%llX: 64-位 无符号 十六进制 数字 入 [r12] (rbx = 值, 基 16; 上=1 → 'A'-'F'),
   则 跳转 尾（修复 2026-08-06）。除 rcx 无符号 64 位。 */
静 空 实厚(整 号分, 整 帧二) {
    整 首甲 = 新标号(), 间寅 = 新标号(), 终又 = 新标号(), 反伍 = 新标号();
    取帧址(8, 临时基 + 192 + 24 - 当前帧大小); /* r8 = 临时 结束（复用 邻辰 临时区 [rbp-56]） */
    移64(9, 8); /* r9 = 临时 结束 (推进) */
    设标号(首甲);
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    移即(1, 16); /* ecx = 16 */
    汇发("    无符号除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1); /* 除 rcx */
    汇发("    比较字节即 r2, 10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xFA); 发字节(10); /* 比较 链弊, 10 */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位-4, 终又, 8); /* jb 终又 (链弊 是 0-15 无符号) */
    若 (帧二) { 汇发("    加字节 r2, 0x37\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x37); /* 加 链弊, 0x37 = 'A'-10 (%llX) */ }
    否 { 汇发("    加字节 r2, 0x57\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x57); /* 加 链弊, 0x57 = 'a'-10 */ }
    相对跳转(-1); 补标号(码位-4, 反伍, 2);
    设标号(终又);
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* 加 链弊, '0' */
    设标号(反伍);
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* 移动 [r9], 链弊 */
    汇发("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 0, 0); /* 测试 堆九, 堆九 */
    非零跳(-1); 补标号(码位-4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* 移动 累加低, [r9] */
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* 比较 r9, r8 */
    非零跳(-1); 补标号(码位-4, 间寅, 3);
    相对跳转(-1); 补标号(码位-4, 号分, 2);
}

静 整 度壬(整 总伍) {
    整 符组 = 新标号(), 暂双 = 新标号(), 首戊 = 新标号(), 素二 = 新标号(), 半拆 = 新标号(), 容低 = 新标号(), 段辰 = 新标号(), 高癸 = 新标号(), 首又一 = 新标号();
    整 帧序二 = 新标号(), 首分一 = 新标号(), 毛七 = 新标号(), 旧分 = 新标号();
    整 内寅 = 新标号(), 副合 = 新标号(); /* 修复 2026-08-26: %f 的 无穷/非数 特殊输出 (原 cvttsd2si 路径对 无穷 输出垃圾) */
    整 壬符 = 新标号(), 壬位 = 新标号(), 壬毕 = 新标号(), 壬小 = 新标号(), 壬填 = 新标号(), 壬环 = 新标号(), 壬零 = 新标号(), 壬空 = 新标号(), 壬尾 = 新标号(), 壬尾环 = 新标号(), 壬符二 = 新标号(), 壬零二 = 新标号(); /* A38: %f 宽度/填充 */
    整 小于等 = 新标号(), 净二 = 新标号(), 初陆 = 新标号(), 局部全局 = 新标号(); /* %e/%E/%g/%G (修复 2026-08-25 支持矩阵补全) */
    整 当再 = 新标号(); /* 共享浮点格式化核心入口 (修复 2026-08-25: 每个 格式化打印 调用只发射一份, 4 分发存根跳入) */
    /* specifier-余散一 解析 + %f 精度 (根-因 2026-08-03) */
    整 终回 = 新标号(), 满劣 = 新标号(), 旁简 = 新标号(), 直子 = 新标号();
    整 宽附 = 新标号(); /* 修复 2026-08-23 t35g: %+d / %+05d 恒显正号 */
    整 空标 = 新标号(); /* A40b (2026-09-12): ' ' 空格 标志 → 域+268 (原 路由 到 满劣 被 静默 丢弃: % d 得 "42" 应 " 42") */
    整 正一 = 新标号(), 空一 = 新标号(), 符毕 = 新标号(), 长无符 = 新标号(), 空环 = 新标号(), 符二 = 新标号(), 符三 = 新标号(), 零环二 = 新标号(), 无符一 = 新标号(), 左无符 = 新标号(); /* A40a (2026-09-12): %d 三段式 填充 (空格在符号前 / 符号 / 零在符号后) + 符号 延后 打 */
    整 壬右 = 新标号(); /* A40e (2026-09-12): %f 非左对齐 分支 入口 (左对齐 需 先 打 符号) */
    整 精无 = 新标号(), 精零 = 新标号(), 精正 = 新标号(), 精环 = 新标号(), 精毕 = 新标号(), 精环二 = 新标号(), 精毕二 = 新标号(); /* A40c (2026-09-12): 整型 精度 (%.Nd) 补零 */
    整 短标 = 新标号(), 短二 = 新标号(), 短毕 = 新标号(); /* A40d (2026-09-12): 'h'/'hh' 长度 修饰 计数 + %hhd 窄化 */
    整 字左二 = 新标号(), 字空环 = 新标号(), 字印 = 新标号(), 字尾环 = 新标号(); /* A40f (2026-09-12): %c 宽度 */
    整 符伴 = 新标号(), 总细 = 新标号(); /* 修复 2026-08-23 t35g: %d 符号提前输出 */
    整 后九 = 新标号(); /* 修复 2026-08-23 t35g: 宽度后非数字 — 长度前缀回 终回 */
    整 副壹 = 新标号(), 实壬 = 新标号(), 空八二 = 新标号(), 域丑 = 新标号(), 单回一 = 新标号(); /* 修复 2026-08-23 t35h: %s 宽度填充 */
    整 当散 = 新标号(), 缺布 = 新标号(); /* 修复 2026-08-23 t35h: 左对齐 %-s 尾部 填充 */
    整 元粗 = 新标号(), 首甲 = 新标号(), 池伴 = 新标号(), 现卯 = 新标号(); /* 修复 2026-08-18: %.*s 星号精度 */
    整 高复 = 新标号(), 列组 = 新标号(), 满寅三 = 新标号(), 高聚 = 新标号(), 元甲 = 新标号(), 尾利 = 新标号(); /* 修复 2026-08-06: %lld/%llu/%llx/%llX 64 位 (高复=计数, *32=32 位回退; 元甲=%X 大写) */
    整 半得 = 新标号(); /* %z (size_t) → 64 位 (修复 2026-08-23 t35d) */
    整 目浅 = 新标号(); /* %*s 宽度参数 (修复 2026-08-23 t35e) */
    整 实己 = 新标号(), 列柒 = 新标号(), 下序 = 新标号(), 链叁 = 新标号();
    整 反挂一 = 新标号(); /* %u 无符号 十进制 (修复 2026-08-05) */
    整 链劣 = 新标号(); /* %o 无符号 八进制 (修复 2026-08-22 t47) */
    整 局部序 = 新标号(); /* 前巳一 I64 modifier %I64u (修复 2026-08-22 t47) */
    整 单薄 = 新标号(); /* %p 指针 十六进制 (修复 2026-08-19) */
    整 宽组 = 新标号(); /* %.0f: 无 '.' 当 N==0 */
    整 段卯 = 新标号(); /* %% -> 字面量 '%' (根-因 2026-08-03: 曾 吞掉) */
    整 主又一 = 新标号(), 全甲 = 新标号(), 初寅 = 新标号(), 暂双一 = 新标号(), 计低一 = 新标号(); /* %d 宽度 填充 */
    整 全劣 = 新标号(), 缺亥二 = 新标号(), 实又 = 新标号(), 号柒 = 新标号(); /* '-' 左对齐 标志 + 数字后 填充 (修复 2026-08-06) */
    整 尾五 = 新标号(), 外繁 = 新标号(), 外败 = 新标号(); /* 修复 2026-08-23 t35e: %0建节 零-填充 */
    整 标列 = 新标号(), 满粗 = 新标号(); /* 修复 2026-08-09 审计#7: %#x 前缀 + %0顺分 零填充 */
    设标号(容低);
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 段辰, 1);
    移即(0, '%'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 素二, 1);
    现午(); /* 移动 [r12], 拷长 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 容低, 2);
    设标号(素二);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 '%') */
    /* specifier-余散一 解析: 标志/宽度/精度 必须 非 是 已发射 作为 字面量
       (根-因 2026-08-03: %.1f printed 字面量 "1f"). 缺省 精度 = 6, 宽度 = 0. */
    移即(0, 6); 移帧寄存器(临时基 - 当前帧大小 + 224, 0);
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 232, 0); /* 宽度 W = 0 */
    移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* 显式-精度 标志 = 0 (修复 2026-08-05) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 244, 0); /* 邻辰 计数器 = 0 (修复 2026-08-06: %lld 64位取参; 移帧寄存器 第二参是寄存器号，必须先清零 首子) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 252, 0); /* '-' 左对齐 标志 = 0 (修复 2026-08-06) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 260, 0); /* '#' 前缀 标志 = 0 (修复 2026-08-09 审计#7) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 264, 0); /* '0' 零填充 标志 = 0 (修复 2026-08-09 审计#7) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 0, 0); /* '+' 恒正 标志 = 0 (修复 2026-08-23 t35g) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 268, 0); /* A40b (2026-09-12): ' ' 空格 标志 = 0 (原 无 此 槽, ' ' 被 静默 丢弃) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 204, 0); /* A40d (2026-09-12): 'h' 长度修饰 计数 = 0 (1=%hhd, 2=%hh) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 4, 0); /* 符号完成 = 0 (修复 2026-08-23 t35g) */
    设标号(终回);
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] */
    移即(0, '-'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 全劣, 1); /* '-' 标志: 左对齐 (修复 2026-08-06) */
    移即(0, '+'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 宽附, 1); /* 修复 2026-08-23 t35g: '+' 标志 → 域+268 */
    移即(0, ' '); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 空标, 1); /* A40b (2026-09-12): ' ' 空格 标志 → 空标 (原 跳 满劣 静默 丢弃) */
    移即(0, '0'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 满粗, 1); /* 修复 2026-08-09: '0' 标志 → 置位 域+264 */
    移即(0, '#'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 标列, 1); /* 修复 2026-08-09: '#' 标志 → 置位 域+260 */
    移即(0, 'l'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 高复, 1); /* 长度 余散一: 计数 'l' (修复 2026-08-06) */
    移即(0, 'I'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 局部序, 1); /* 前巳一 I64 modifier (修复 2026-08-22 t47: %I64u 当 未知 规格 跳过 → cat-文件 -s 输出 "64u" 不打印 尺寸; PRIuMAX="I64u") */
    移即(0, 'z'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 半得, 1); /* %z (size_t) → 64 位 (修复 2026-08-23 t35d: 原当未知格式跳过 'z' → 'u' 原样打印 → 版本库 "%zu" 输出 'u'; 属性.c report_invalid_attr 等 size_t 打印全乱) */
    移即(0, 'h'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 短标, 1); /* A40d (2026-09-12): 'h' 长度 修饰 → 短标 (原 跳 满劣 静默 丢弃 → %hhd 不 截断) */
    移即(0, 'L'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 满劣, 1);
    相对跳转(-1); 补标号(码位-4, 旁简, 2);
    设标号(局部序); /* 'I' → 64-位 (I64); 跳过 '6' '4' 修饰符避免当宽度 */
    移即(0, 2); 移帧寄存器(临时基 - 当前帧大小 + 244, 0); /* 高复 = 2 (64-位) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 'I') */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] */
    移即(0, '6'); 算寄存器(比等, 1, 0); 非零跳(-1); 补标号(码位-4, 满劣, 1); /* 非 '6' → 回 到 标志 循环 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 '6') */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] */
    移即(0, '4'); 算寄存器(比等, 1, 0); 非零跳(-1); 补标号(码位-4, 满劣, 1); /* 非 '4' → 回 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 '4') */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(半得); /* 'z' (size_t) → 64 位无符号; 后面直接是格式符 (u/d/x/o...) */
    移即(0, 2); 移帧寄存器(临时基 - 当前帧大小 + 244, 0); /* 高复 = 2 (64-位) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 'z') */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(标列); /* '#' 标志: 域+260 = 1 (修复 2026-08-09 审计#7: %#x → 0x 前缀) */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 260, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(宽附); /* '+' 标志: 域+268 = 1 (修复 2026-08-23 t35g) */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 0, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(空标); /* A40b (2026-09-12): ' ' 空格 标志: 域+268 = 1 (正数 打 一 个 ' ' 占位, 与 '+' 互斥 优先 '+') */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 268, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(短标); /* A40d (2026-09-12): 'h' 长度 修饰 计数 (1 → %hhd/%hd 窄化, 2 → %hh) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 204); 移即(1, 1); 算寄存器(高拾, 0, 1); 移帧寄存器(临时基 - 当前帧大小 + 204, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 'h') */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(满粗); /* '0' 标志: 域+264 = 1 (修复 2026-08-09 审计#7: %08x 零填充) */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 264, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(高复); /* 'l' 长度 余散一: 域+244++ (修复 2026-08-06) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 244); /* 首子 = 高复 */
    移即(1, 1); 算寄存器(高拾, 0, 1); /* 首子++ */
    移帧寄存器(临时基 - 当前帧大小 + 244, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(全劣); /* '-' 左对齐 标志: 域+252 = 1 (修复 2026-08-06) */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 252, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(满劣); /* 跳过 a 标志 字符 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(旁简); /* 宽度 数字: accumulate 入 域+232 (%5d -> 5) - 根-因 2026-08-03 */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] - RE-读取 (修复 2026-08-03: 曾 循环 于 该 stale 字符) */
    移即(0, '*'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 目浅, 1); /* %*s: 宽度参数 (修复 2026-08-23 t35e) */
    移即(0, '0'); 算寄存器(比等, 1, 0); 发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位-4, 后九, 8); /* 比较 拷长,'0'; jb 后九 (修复 2026-08-23 t35g: 非数字含 l/h/z/I 长度前缀) */
    移即(0, '9'); 算寄存器(比等, 1, 0); 发字节(0x0F); 发字节(0x87); 发四(0); 补标号(码位-4, 后九, 9); /* 比较 拷长,'9'; ja 后九 */
    汇发("    减字节 r1, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xE9); 发字节('0'); /* 减 拷长, '0' -> 数字 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* 首子 = W */
    移寄存器(2, 0);                                       /* edx = W */
    汇发("    左移 r0, 3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 0); 发字节(3);    /* 左移 首子, 3 -> W*8 */
    汇发("    左移 r2, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 2); 发字节(1);    /* 左移 edx, 1 -> W*2 */
    算寄存器(高拾, 0, 2);                                 /* 首子 = W*10 */
    算寄存器(高拾, 0, 1);                                 /* 首子 += 数字 */
    移帧寄存器(临时基 - 当前帧大小 + 232, 0); /* W = 首子 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 旁简, 2);
    设标号(后九); /* 修复 2026-08-23 t35g: 宽度后非数字 — 长度前缀(l/h/z/I)继续, '.' 精度, 其余转换符 */
    移即(0, 'l'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 高复, 1);
    移即(0, 'h'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 满劣, 1);
    移即(0, 'z'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 半得, 1);
    移即(0, 'I'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 局部序, 1);
    移即(0, '.'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 元粗, 1);
    相对跳转(-1); 补标号(码位-4, 池伴, 2);
    设标号(直子);
    移即(0, '.'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 元粗, 1);
    相对跳转(-1); 补标号(码位-4, 池伴, 2);
    设标号(元粗); /* .N / .* - 精度 (修复 2026-08-18: %.*s star — 原 `.` 后只认数字, `*` 当未知说明符跳过 → 后续参数错位 → 下一个 %s 把 整数 精度当指针 取字长 → 段错误; 版本库 vadvise "%shint:%s%.*s%s" 崩) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 '.') */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] */
    移即(0, '*'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 现卯, 1); /* 修复 2026-08-18: .* 星号精度 → 从参数表取 */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 224, 0);
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* 显式-精度 标志 遍 %s (修复 2026-08-05) */
    相对跳转(-1); 补标号(码位-4, 首甲, 2); /* 数字精度: 跳过 现卯 块 (修复 2026-08-18: 现卯 原放 首甲 后 → %.1f 数字路径落入 现卯 → 精度错 → 浮点除零 0xC0000094) */
    设标号(目浅); /* %*s 宽度参数 (修复 2026-08-23 t35e): 从参数表读 整数, 存 域+232 (W) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 '*') */
    行退(); /* 首子 = [r13] = 宽度 整数 */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移帧寄存器(临时基 - 当前帧大小 + 232, 0); /* W = 实参 */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] */
    相对跳转(-1); 补标号(码位-4, 终回, 2); /* 继续解析 (修复 2026-08-23: 返 终回 直接检查 - 满劣 会 递增 后辰 跳过 'I' 导致 %*I64u 的 '6''4' 被当宽度数字, 高复 为失) */
    设标号(现卯); /* .* 星号精度 (修复 2026-08-18): 从参数表取 整数, 参数表前移 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 '*') */
    行退(); /* 首子 = [r13] = 精度 整数 */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移帧寄存器(临时基 - 当前帧大小 + 224, 0); /* 精度 = 实参 */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* 显式-精度 */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] - 转换字符 */
    相对跳转(-1); 补标号(码位-4, 池伴, 2);
    设标号(首甲);
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* 零扩展 ecx, 字节[后辰] */
    移即(0, '0'); 算寄存器(比等, 1, 0); 发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位-4, 池伴, 8);
    移即(0, '9'); 算寄存器(比等, 1, 0); 发字节(0x0F); 发字节(0x87); 发四(0); 补标号(码位-4, 池伴, 9);
    /* ecx -= '0'; N = N*10 + 数字 */
    汇发("    减字节 r1, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xE9); 发字节('0'); /* 减 拷长, '0' */
    移寄存器帧(0, 临时基 - 当前帧大小 + 224); /* 首子 = N */
    移寄存器(2, 0);                                       /* edx = N */
    汇发("    左移 r0, 3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 0); 发字节(3);    /* 左移 首子, 3 -> N*8 */
    汇发("    左移 r2, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 2); 发字节(1);    /* 左移 edx, 1 -> N*2 */
    算寄存器(高拾, 0, 2);                                 /* 首子 = N*10 */
    算寄存器(高拾, 0, 1);                                 /* 首子 += 数字 */
    移帧寄存器(临时基 - 当前帧大小 + 224, 0); /* N = 首子 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 */
    相对跳转(-1); 补标号(码位-4, 首甲, 2);
    设标号(池伴); /* 分派 于 该 转换 字符 (ecx) */
    移即(0, 'd'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 符组, 1);
    移即(0, 'i'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 符组, 1); /* A39 (2026-09-12): %i = %d (原 未登记 → 落 未知说明符: 既 不 打印 又 不 消费 参数 → 后续 格式 参数 错位; 与 %o/%p 同类 历史 缺陷) */
    移即(0, 's'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 暂双, 1);
    移即(0, 'c'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 首戊, 1);
    移即(0, 'f'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 高癸, 1);
    移即(0, 'e'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 小于等, 1); /* %e 科学计数法 (修复 2026-08-25 支持矩阵补全) */
    移即(0, 'E'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 净二, 1); /* %E 大写科学计数法 */
    移即(0, 'g'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 初陆, 1); /* %g 通用浮点 (修复 2026-08-25 支持矩阵补全) */
    移即(0, 'G'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 局部全局, 1); /* %G 大写通用浮点 */
    移即(0, 'x'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 首又一, 1); /* %x 十六进制 (修复 2026-08-05) */
    移即(0, 'X'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 元甲, 1); /* %X 大写 十六进制 (修复 2026-08-06) */
    移即(0, 'u'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 反挂一, 1); /* %u 无符号 十进制 (修复 2026-08-05) */
    移即(0, 'o'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 链劣, 1); /* %o 无符号 八进制 (修复 2026-08-22 t47: 原当未知说明符跳过不消费参数 → 版本库 暂双-文件 -s "%s%06o %s %d" 后续 %s 读到 模式 当指针 取字长 段错误) */
    移即(0, 'p'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 单薄, 1); /* %p 指针 十六进制 (修复 2026-08-19: 原 %p 当未知说明符跳过不消费参数 → 后续 %d/%u/%s 参数错位一格 → t_zin gz.z.avail_in 读到指针值; 版本库 源码大量 %p) */
    移即(0, '%'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 段卯, 1); /* %% -> 字面量 % */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰: 未知 规格, 跳过 */
    相对跳转(-1); 补标号(码位-4, 容低, 2);
    设标号(段卯); /* %% : 发射 a 字面量 '%', 推进 已过 该 2主己 %, 回 到 该 堆平 循环 */
    现午(); /* 移动 [r12], 拷长 - 拷长 仍 持有 '%' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 该 2主己 %) */
    相对跳转(-1); 补标号(码位-4, 容低, 2);
    /* %p: 指针 作为 64-位 lowercase 十六进制 (修复 2026-08-19: 原 %p 当未知说明符跳过不消费参数 → 后续 %d/%u/%s 参数错位一格; 与 %llx 同路径强制 64 位) */
    设标号(单薄);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 规格 字符) */
    长劣(); /* 堆九 = [r13] (64-位 指针) */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移64(3, 0); /* rbx = 64-位 值 */
    实厚(容低, 0); /* %llx: 打印 rbx 64 位 无符号 十六进制 lowercase, 返回 到 堆平 循环 */
    /* %c: 发射 字符 实参 */
    设标号(首戊);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 规格 字符) */
    行退(); /* 首子 = [r13] */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移寄存器(3, 0); /* ebx = 字符 */
    /* A40f (2026-09-12): %c 宽度 支持 (原 宽度 被 静默 忽略: "%5c" 与 "%c" 同 输出; gcc "    A" / "A    ") */
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); 移即(1, 1); 算寄存器(旧肆, 0, 1); 移帧寄存器(临时基 - 当前帧大小 + 24, 0); /* pad = W - 1 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 252); 测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 字左二, 3); /* 左对齐 → 字符 先行 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 24); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 字印, 6); /* pad <= 0 → 无 填充 */
    设标号(字空环);
    移即(0, ' '); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    移寄存器帧(1, 临时基 - 当前帧大小 + 24); 移即(2, 1); 算寄存器(旧肆, 1, 2); 移帧寄存器(临时基 - 当前帧大小 + 24, 1);
    移寄存器帧(0, 临时基 - 当前帧大小 + 24); 测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 字空环, 3);
    设标号(字印);
    移寄存器(0, 3); 存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    相对跳转(-1); 补标号(码位-4, 容低, 2);
    设标号(字左二); /* 左对齐: 字符 先, 尾 补 pad 空格 */
    移寄存器(0, 3); 存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    移寄存器帧(0, 临时基 - 当前帧大小 + 24); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 容低, 6); /* pad <= 0 → 完 */
    设标号(字尾环);
    移即(0, ' '); 存字节十二(); 汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
    移寄存器帧(1, 临时基 - 当前帧大小 + 24); 移即(2, 1); 算寄存器(旧肆, 1, 2); 移帧寄存器(临时基 - 当前帧大小 + 24, 1);
    移寄存器帧(0, 临时基 - 当前帧大小 + 24); 测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 字尾环, 3);
    相对跳转(-1); 补标号(码位-4, 容低, 2);
    设标号(暂双);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 规格 字符) */
    长劣(); /* 堆九 = [r13] (64-位 指针) */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移64(8, 0); /* r8 = 字符串 */
    /* ---- 计算 长度 (r9d), 受 %.半捌 精度界 (t35h) ---- */
    移即扩(9, 0); /* r9d = 0 (长度) */
    移64(2, 8); /* rdx = 字符串 (64-位, 修复 2026-08-23 t35h: 移寄存器 32 位截断指针) */
    设标号(副壹);
    汇发("    零扩展 eax, [rdx]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 2); /* 零扩展 首子, 字节[rdx] \xe2\x80\x94 \xe6\x97\xa0 扩展前缀 (修复 2026-08-23 t35h: 前缀字节 B=1 \xe5\x8f\x98 r10) */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 实壬, 1);
    汇发("    自增 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,0); 发字节(0xFF); 模字节(3, 0, 2); /* 递增 rdx \xe2\x80\x94 扩展前缀.W=1 (修复 2026-08-23 t35h) */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9d */
    相对跳转(-1); 补标号(码位-4, 副壹, 2);
    设标号(实壬);
    /* 精度界: 长度 = 最小(长度, N) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 236); /* 首子 = has_explicit_prec */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 空八二, 1);
    移寄存器帧(0, 临时基 - 当前帧大小 + 224); /* 首子 = N */
    算寄存器(比等, 9, 0); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 空八二, 8); /* 比较 r9d, 首子; jle 空八二 */
    移寄存器(9, 0); /* 长度 = N */
    设标号(空八二);
    移帧寄存器(临时基 - 当前帧大小 + 228, 9); /* 保存 长度 -> 域+228 */
    /* 填充 = W - 长度; 域+236 存 填充 数 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* 首子 = W */
    移寄存器(2, 9); /* edx = 长度 */
    算寄存器(旧肆, 0, 2); /* 首子 = W - 长度 */
    移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 单回一, 8); /* 比较 首子,0; jle 单回一 */
    移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* 保存 填充 -> 域+236 */
    /* 左对齐 (域+252): 先拷贝后 填充 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 252); 测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 单回一, 1);
    /* 右对齐: 填充 空格先行 */
    移寄存器帧(2, 临时基 - 当前帧大小 + 236); /* edx = 填充 */
    移即(0, ' ');
    设标号(域丑);
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* 递减 edx */
    非零跳(-1); 补标号(码位-4, 域丑, 3);
    设标号(单回一);
    移寄存器帧(1, 临时基 - 当前帧大小 + 228); /* ecx = 长度 */
    相对跳转(-1); 补标号(码位-4, 半拆, 2);
    /* 计简一 修复 2026-08-06: %s 缓冲上限检查 — 仅 格式化打印/putstr 链（总伍 != 0，= rbp-272 状态区起点）：
       r9 预载 [rbp+总伍]，r12 达界即停（缓冲 4096B [rbp-4368..rbp-273]，不碰状态区/&已写）。
       格式化到串 链 总伍=0 → 不设界（用户缓冲，标准 C 语义）。 */
    设标号(半拆);
    若 (总伍) { 取帧址(9, 总伍); } /* 取址 r9, [rbp+总伍] — 修复 2026-08-23 t35d: 移到 半拆 前, 显式精度路径(%.半捌)原跳过 lsnoprec → r9 残留垃圾 → 比较 r12,r9 误跳 → 空输出 (属性.c %.*s 名 缺失) */
    若 (总伍) {
        汇发("    比较64 r12, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 1, 0, 1); 发字节(0x39); 模字节(3, 1, 4); /* 比较 r12, r9 */
        发字节(0x0F); 发字节(0x83); 发四(0); 补标号(码位-4, 容低, 7); /* jae 容低 (高于等跳): r12 >= 界 -> 停 */
    }
    汇发("    零扩展 eax, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 0); /* 零扩展 首子, 字节[r8] */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 当散, 1);
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 当散, 1); /* 计数 exhausted */
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 0); /* 递增 r8 */
    汇发("    自减 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC9); /* 递减 ecx */
    相对跳转(-1); 补标号(码位-4, 半拆, 2);
    设标号(当散); /* 修复 2026-08-23 t35h: 左对齐 %-s 尾部 填充 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 252); /* 首子 = 左 标志 */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 容低, 1);
    移寄存器帧(2, 临时基 - 当前帧大小 + 236); /* edx = 填充 */
    测寄存器(2, 2); 零跳(-1); 补标号(码位-4, 容低, 1);
    移即(0, ' ');
    设标号(缺布);
    存字节十二(); /* 移动 [r12], 累加低 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* 递减 edx */
    非零跳(-1); 补标号(码位-4, 缺布, 3);
    相对跳转(-1); 补标号(码位-4, 容低, 2);
    /* %d: 十进制 整数 实参 - 带 %建节 宽度 填充 (根-因 2026-08-03) */
    设标号(符组);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 规格 字符) */
    /* %lld: 64-位 十进制 (修复 2026-08-06) — 域+244 >= 2 → 64 位路径 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 244); /* 首子 = 高复 */
    移即(1, 2); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8C); 发四(0); 补标号(码位-4, 列组, 10); /* 比较 首子,2; jl 列组 (小跳) */
    长劣(); /* 堆九 = [r13] (64-位) */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移64(3, 0); /* rbx = 64-位 值 */
    缓序(容低); /* %lld: 打印 rbx 64 位, 返回 到 堆平 循环 */
    设标号(列组);
    行退(); /* 首子 = [r13] */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
