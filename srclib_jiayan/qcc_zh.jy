        整 变键 = 建节(1); 复制内存((字*)(节名表 + 变键), 键名, 32);
        整 序标深 = 建节(14); 接子(序标深, 变减); 接子(序标深, 变键); /* dst[__fk] */
        整 赋节 = 建节(10); 接子(赋节, 序标深); 接子(赋节, 序标始); 接子(增节, 赋节); /* dst[__fk] = src[__fi]; */
        { 整 加节 = 建节(2); 节值表[加节] = 加; 接子(加节, 变键); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(加节, 壹节); } 整 素吉 = 建节(10); 接子(素吉, 变键); 接子(素吉, 加节); 接子(增节, 素吉); } /* __fk++; */
        接子(若序, 增节);
        接子(块节, 若序);
        { 整 加节 = 建节(2); 节值表[加节] = 加; 接子(加节, 变初); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(加节, 壹节); } 整 半浅 = 建节(10); 接子(半浅, 变初); 接子(半浅, 加节); 接子(块节, 半浅); } /* __fi++; */
        接子(环节, 块节);
        接子(块, 环节);
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "映射")) { /* 接入 2026-08-27 高阶函数 映射 (编译成循环): 映射 dst, src, n, fn; → { __mi=0; while(__mi<n){ dst[__mi]=fn(src[__mi]); __mi++; } } — 数组映射 (Python map 风格) */
        词位++; /* 映射 */
        字 目标数[64]; 复制字符串(目标数, 词名表[词位]); 词位++; /* 目标数组 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        字 源计数[64]; 复制字符串(源计数, 词名表[词位]); 词位++; /* 源数组 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 终数 = 表达式(); /* 长度 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 链乙 = 表达式(); /* 映射函数 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        静 整 缓二 = 0; 字 内名[64]; 格式化到串(内名, "__mi_%d_", 缓二++);
        变量偏移(内名); /* 内部计数器 */
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 内名, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(块, 元); } /* int __mi = 0; */
        整 环节 = 建节(9);
        { 整 变初 = 建节(1); 复制内存((字*)(节名表 + 变初), 内名, 32); 整 比较 = 建节(2); 节值表[比较] = 比小; 接子(比较, 变初); 接子(比较, 终数); 接子(环节, 比较); } /* while (__mi < n) */
        整 块节 = 建节(5);
        整 变减 = 建节(1); 复制内存((字*)(节名表 + 变减), 目标数, 32);
        整 变串 = 建节(1); 复制内存((字*)(节名表 + 变串), 源计数, 32);
        整 变初 = 建节(1); 复制内存((字*)(节名表 + 变初), 内名, 32);
        整 序标始 = 建节(14); 接子(序标始, 变串); 接子(序标始, 变初); /* src[__mi] */
        整 呼 = 建节(4); 接子(呼, 序标始); 接子(呼, 链乙); /* fn(src[__mi]) — 参数先挂, callee 最后 */
        整 序标深 = 建节(14); 接子(序标深, 变减); { 整 变初二 = 建节(1); 复制内存((字*)(节名表 + 变初二), 内名, 32); 接子(序标深, 变初二); } /* dst[__mi] */
        整 赋节 = 建节(10); 接子(赋节, 序标深); 接子(赋节, 呼); 接子(块节, 赋节); /* dst[__mi] = fn(...); */
        { 整 加节 = 建节(2); 节值表[加节] = 加; 接子(加节, 变初); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(加节, 壹节); } 整 半浅 = 建节(10); 接子(半浅, 变初); 接子(半浅, 加节); 接子(块节, 半浅); } /* __mi = __mi + 1; */
        接子(环节, 块节);
        接子(块, 环节);
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "重载")) { /* 接入 2026-08-27 运算符重载注册: 重载 + 点 = 点_add; → ov 表注册 (运算符 + 类型名 → 函数名), add() 分派 — 用户先定义普通函数再注册 */ /* 2026-08-28 P2 #257/#258: 重载 * 智能 = fn (解引用), 重载 () 函子 = fn (调用) */
        词位++; /* 重载 */
        整 算子返 = 0;
        若 (词型表[词位] == 加) { 算子返 = 加; 词位++; } /* + */
        否 若 (词型表[词位] == 减) { 算子返 = 减; 词位++; } /* - */
        否 若 (词型表[词位] == 乘) { 算子返 = 乘; 词位++; } /* #257 * 解引用重载 */
        否 若 (词型表[词位] == 左括) { 算子返 = 左括; 词位++; 若 (词型表[词位] == 右括) 词位++; } /* #258 () 调用重载 */
        字 终薄[64] = ""; 若 (词型表[词位] == 词变量) { 复制字符串(终薄, 词名表[词位]); 词位++; } /* 类型名 */
        若 (词型表[词位] == 赋号) 词位++; /* = */
        字 函返[64] = ""; 若 (词型表[词位] == 词变量) { 复制字符串(函返, 词名表[词位]); 词位++; } /* 函数名 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        若 (初甲 < 32 && 算子返 && 终薄[0] && 函返[0]) { 满属[初甲] = (字)算子返; 复制字符串(总复[初甲], 终薄); 复制字符串(栈聚[初甲], 函返); 初甲++; }
        返 建节(5);
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "通道")) { /* 接入 2026-08-28 机制层: 有界通道声明 (Go channel, 环形缓冲): 通道 q, n; → { int __ch_q_buf[n]; int __ch_q_cap=n; int __ch_q_h=0; int __ch_q_t=0; int __ch_q_c=0; } — 送/收 内联环形队列 (非阻塞) */
        词位++; /* 通道 */
        字 净优[64]; 复制字符串(净优, 词名表[词位]); 词位++; /* 通道名 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 容量 = 4;
        常量表达式求值(&容量); /* 容量 (常量; 失败默认 4) */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        字 字节名[80], 外陆[80], 型名[80], 呼名[80], 总列[80];
        格式化到串(字节名, "__ch_%s_buf", 净优); 格式化到串(外陆, "__ch_%s_h", 净优);
        格式化到串(型名, "__ch_%s_t", 净优); 格式化到串(呼名, "__ch_%s_c", 净优); 格式化到串(总列, "__ch_%s_cap", 净优);
        末午(字节名, 容量, 4); /* int __ch_q_buf[cap]; (内部数组, 4 字节元素) */
        变量偏移(外陆); 变量偏移(型名); 变量偏移(呼名); 变量偏移(总列);
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 总列, 32); 整 字值 = 建节(0); 节值表[字值] = 容量; 接子(元, 字值); 接子(块, 元); } /* int __ch_q_cap = cap; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 外陆, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(块, 元); } /* int __ch_q_h = 0; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 型名, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(块, 元); } /* int __ch_q_t = 0; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 呼名, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(块, 元); } /* int __ch_q_c = 0; */
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "送")) { /* 接入 2026-08-28 机制层: 通道发送 (有界环形缓冲, 非阻塞) — 送 q, v; → { if (__ch_q_c < __ch_q_cap) { __ch_q_buf[__ch_q_t]=v; __ch_q_t=(__ch_q_t+1)%__ch_q_cap; __ch_q_c++; } }; 通道未声明时回退旧语法糖 chan_send(&ch, v) */
        词位++; /* 送 */
        字 净优[64]; 复制字符串(净优, 词名表[词位]);
        字 字节名[80]; 格式化到串(字节名, "__ch_%s_buf", 净优);
        若 (查变量(字节名) >= 0) { /* 通道已声明 (通道 q, n;) → 内联环形缓冲 */
            词位++; /* 通道名 */
            若 (词型表[词位] == 逗号) 词位++; /* , */
            整 间壹 = 表达式(); /* 值 */
            若 (词型表[词位] == 分号) 词位++; /* ; */
            字 外陆[80], 型名[80], 呼名[80], 总列[80];
            格式化到串(外陆, "__ch_%s_h", 净优); 格式化到串(型名, "__ch_%s_t", 净优);
            格式化到串(呼名, "__ch_%s_c", 净优); 格式化到串(总列, "__ch_%s_cap", 净优);
            整 块 = 建节(5);
            整 变字符 = 建节(1); 复制内存((字*)(节名表 + 变字符), 呼名, 32);
            整 值指 = 建节(1); 复制内存((字*)(节名表 + 值指), 总列, 32);
            整 比较 = 建节(2); 节值表[比较] = 比小; 接子(比较, 变字符); 接子(比较, 值指); /* __ch_q_c < __ch_q_cap */
            整 若序 = 建节(8); 接子(若序, 比较);
            整 增节 = 建节(5);
            { 整 值字节 = 建节(1); 复制内存((字*)(节名表 + 值字节), 字节名, 32);
              整 变暂 = 建节(1); 复制内存((字*)(节名表 + 变暂), 型名, 32);
              整 序标 = 建节(14); 接子(序标, 值字节); 接子(序标, 变暂);
              整 赋节 = 建节(10); 接子(赋节, 序标); 接子(赋节, 间壹); 接子(增节, 赋节); } /* __ch_q_buf[__ch_q_t] = v; */
            { 整 主壹 = 建节(1); 复制内存((字*)(节名表 + 主壹), 型名, 32);
              整 壹节 = 建节(0); 节值表[壹节] = 1;
              整 加法 = 建节(2); 节值表[加法] = 加; 接子(加法, 主壹); 接子(加法, 壹节);
              整 堆柒一 = 建节(1); 复制内存((字*)(节名表 + 堆柒一), 总列, 32);
              整 号集 = 建节(2); 节值表[号集] = 取余; 接子(号集, 加法); 接子(号集, 堆柒一);
              整 赋节 = 建节(10); 接子(赋节, 主壹); 接子(赋节, 号集); 接子(增节, 赋节); } /* __ch_q_t = (__ch_q_t+1) % __ch_q_cap; */
            { 整 单高 = 建节(1); 复制内存((字*)(节名表 + 单高), 呼名, 32);
              整 壹节 = 建节(0); 节值表[壹节] = 1;
              整 加节 = 建节(2); 节值表[加节] = 加; 接子(加节, 单高); 接子(加节, 壹节);
              整 赋节 = 建节(10); 接子(赋节, 单高); 接子(赋节, 加节); 接子(增节, 赋节); } /* __ch_q_c++; */
            接子(若序, 增节);
            接子(块, 若序);
            返 块;
        }
        /* 回退: 旧语法糖 chan_send(&ch, v) */
        整 计申 = 表达式(); /* 通道表达式 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 间壹 = 表达式(); /* 值表达式 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        整 呼 = 建节(4);
        { 整 地址 = 建节(11); 接子(地址, 计申); 接子(呼, 地址); } /* &ch */
        接子(呼, 间壹); /* v */
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "chan_send", 10); 接子(呼, 函); } /* callee 最后 */
        返 呼;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "收")) { /* 接入 2026-08-28 机制层: 通道接收 (有界环形缓冲, 非阻塞) — 收 q, v; → { if (__ch_q_c > 0) { v = __ch_q_buf[__ch_q_h]; __ch_q_h = (__ch_q_h+1)%__ch_q_cap; __ch_q_c--; } }; 通道未声明时回退旧语法糖 chan_recv(&ch, &v) */
        词位++; /* 收 */
        字 净优[64]; 复制字符串(净优, 词名表[词位]);
        字 字节名[80]; 格式化到串(字节名, "__ch_%s_buf", 净优);
        若 (查变量(字节名) >= 0) { /* 通道已声明 → 内联环形缓冲 */
            词位++; /* 通道名 */
            若 (词型表[词位] == 逗号) 词位++; /* , */
            字 变节[64]; 复制字符串(变节, 词名表[词位]); 词位++; /* 目标变量 */
            若 (词型表[词位] == 分号) 词位++; /* ; */
            字 外陆[80], 型名[80], 呼名[80], 总列[80];
            格式化到串(外陆, "__ch_%s_h", 净优); 格式化到串(型名, "__ch_%s_t", 净优);
            格式化到串(呼名, "__ch_%s_c", 净优); 格式化到串(总列, "__ch_%s_cap", 净优);
            整 块 = 建节(5);
            整 变字符 = 建节(1); 复制内存((字*)(节名表 + 变字符), 呼名, 32);
            整 零 = 建节(0); 节值表[零] = 0;
            整 比较 = 建节(2); 节值表[比较] = 外三; 接子(比较, 变字符); 接子(比较, 零); /* __ch_q_c > 0 */
            整 若序 = 建节(8); 接子(若序, 比较);
            整 增节 = 建节(5);
            { 整 值字节 = 建节(1); 复制内存((字*)(节名表 + 值字节), 字节名, 32);
              整 全升 = 建节(1); 复制内存((字*)(节名表 + 全升), 外陆, 32);
              整 序标 = 建节(14); 接子(序标, 值字节); 接子(序标, 全升);
              整 变右 = 建节(1); 复制内存((字*)(节名表 + 变右), 变节, 32);
              整 赋节 = 建节(10); 接子(赋节, 变右); 接子(赋节, 序标); 接子(增节, 赋节); } /* v = __ch_q_buf[__ch_q_h]; */
            { 整 深环 = 建节(1); 复制内存((字*)(节名表 + 深环), 外陆, 32);
              整 壹节 = 建节(0); 节值表[壹节] = 1;
              整 加法 = 建节(2); 节值表[加法] = 加; 接子(加法, 深环); 接子(加法, 壹节);
              整 值指 = 建节(1); 复制内存((字*)(节名表 + 值指), 总列, 32);
              整 号集 = 建节(2); 节值表[号集] = 取余; 接子(号集, 加法); 接子(号集, 值指);
              整 赋节 = 建节(10); 接子(赋节, 深环); 接子(赋节, 号集); 接子(增节, 赋节); } /* __ch_q_h = (__ch_q_h+1) % __ch_q_cap; */
            { 整 单高 = 建节(1); 复制内存((字*)(节名表 + 单高), 呼名, 32);
              整 壹节 = 建节(0); 节值表[壹节] = 1;
              整 减法 = 建节(2); 节值表[减法] = 减; 接子(减法, 单高); 接子(减法, 壹节);
              整 赋节 = 建节(10); 接子(赋节, 单高); 接子(赋节, 减法); 接子(增节, 赋节); } /* __ch_q_c--; */
            接子(若序, 增节);
            接子(块, 若序);
            返 块;
        }
        /* 回退: 旧语法糖 chan_recv(&ch, &v) */
        整 计申 = 表达式(); /* 通道表达式 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 间壹 = 表达式(); /* 目标表达式 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        整 呼 = 建节(4);
        { 整 列丑 = 建节(11); 接子(列丑, 计申); 接子(呼, 列丑); } /* &ch */
        { 整 主简 = 建节(11); 接子(主简, 间壹); 接子(呼, 主简); } /* &v */
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "chan_recv", 10); 接子(呼, 函); } /* callee 最后 */
        返 呼;
    }
    若 (词型表[词位] == 分号) { 词位++; 返 建节(5); } /* 空语句 ; — 返回空块节点 (codegen 无输出). fix 2026-08-19: 原落 expr() 兜底返回 -1 (不消费) → stmt() 挂 -1 给 if 空体 → case-8 codegen n1=-1 错乱 → `if (c) ; else ...` else 链无条件执行 (commit.c handle_ignored_arg strcmp(NULL) SEGV) */
    
    { 整 终 = 表达式(); 元得(终); 词位++; 返 终; }
}
/* 常量整数表达式求值 (数组维度用): 支持整数/枚举/宏常量、括号、+-*\/%<>^&| 与一元 +-~。
   左到右求值 (维度表达式几乎都是单运算符, 优先级差异可忽略)。成功置 *val 并推进 tk, 返回 1; 失败不推进, 返回 0。
   (fix 2026-08-14: hash_algos[GIT_HASH_NALGOS] 展开成 [(2 + 1)] — 原数组维度只认单 NK/VR token, `(` 卡住 → 维度=0 → 后续 null_oid 定义被吞 undefined) */
静 整 常量表达式求值(整 *数值); /* fwd */
静 整 末列(整 *数值) {
    若 (词型表[词位] == 常数) { *数值 = 词值表[词位]; 词位++; 返 1; }
    若 (词型表[词位] == 容吉一) { /* _Alignof 常量求值 (fix 2026-08-25 支持矩阵补全 step1) */
        词位++; 若 (词型表[词位] == 左括) 词位++;
        *数值 = 净乙一();
        若 (词型表[词位] == 右括) 词位++;
        返 1;
    }
    若 (词型表[词位] == 度序) { /* sizeof 常量维度: char tmp[sizeof "..."] (fix 2026-08-15: inet_ntop.c tp 未注册 undefined) */
        词位++; 若 (词型表[词位] == 左括) 词位++; /* sizeof( */
        整 尺寸 = 4;
        /* fix 2026-08-17: sizeof((arr)[idx]) — 括号数组元素 (ARRAY_SIZE(paths) 展开成
           sizeof(paths)/sizeof((paths)[0])): (paths) 括号后跟 [0] 下标, 原代码既不进
           VR 分支也不被 OK 分支消费 → sz 错 + token 残留 → 数组维度求值错 →
           brace_arr_init 越界崩 (diff-no-index.c to_free 0xC0000005). */
        若 (词型表[词位] == 左括 && 词型表[词位 + 1] == 词变量 && 词型表[词位 + 2] == 右括 && 词型表[词位 + 3] == 左方) {
            整 半再一 = 变量元素(词名表[词位 + 1]); 若 (半再一 > 0) 尺寸 = 半再一;
            词位 += 4; 循环 (词位 < 词容量 && 词型表[词位] != 右方 && 词型表[词位] != 词终) 词位++; 若 (词型表[词位] == 右方) 词位++;
            若 (词型表[词位] == 右括) 词位++; /* 末尾 ) */
            *数值 = 尺寸; 返 1;
        }
        若 (词型表[词位] == 串词) { 尺寸 = (整)取字长(串表[词值表[词位]]) + 1; 词位++; }
        否 若 (词型表[词位] == 型词) { 若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节"))||!比较字符串(词名表[词位],"_Bool")) 尺寸=1; 否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) 尺寸=8; 否 若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) 尺寸=2; 词位++; 循环 (词型表[词位] == 乘) { 尺寸 = 8; 词位++; } }
        否 若 (词型表[词位] == 结构词) { 词位++; 若 (词型表[词位] == 词变量) { 整 构序 = 查类型(词名表[词位]); 若 (构序 >= 0) 尺寸 = 类型表[构序].尺寸; 词位++; } }
        否 若 (词型表[词位] == 乘) { 尺寸 = 8; 词位++; 若 (词型表[词位] == 词变量) 词位++; }
        否 若 (词型表[词位] == 词变量) { 整 构序 = 变量型序(词名表[词位]);
            若 (构序 < 0 && 型定判断(词名表[词位])) { 整 型定序 = 型定查(词名表[词位]); 若 (型定序 >= 0 && 型定表[型定序].尺寸 > 0) { 尺寸 = 型定表[型定序].尺寸; 词位++; } } /* fix 2026-08-20: typedef 名 sizeof (sizeof(uint64_t) 原 4 → csprng_bytes(&v,sizeof(v)) 只填低 4 字节 → mkstemp 随机后缀高 4 字节垃圾 → 乱码文件名) */
            否 词位++;
            若 ((词型表[词位] == 箭头 || 词型表[词位] == 句点) && 词型表[词位 + 1] == 词变量) { 若 (构序 >= 0) { 整 直弊 = 字段尺寸(类型表[构序].名, 词名表[词位 + 1]); 若 (直弊 > 0) 尺寸 = 直弊; } 词位 += 2; }
            /* fix 2026-08-17: sizeof(裸数组名) 返回数组总字节数 (arr_sz * esz) — 原默认 4 →
               ARRAY_SIZE(arr) 展开 sizeof(arr) 除错 → 数组维度求值错 (diff-no-index.c to_free).
               仅当是数组变量 (arr_sz>0) 才覆盖, 普通变量保持默认 4. */
            否 { 整 深六 = 长壹(词名表[词位 - 1]); 若 (深六 > 0) 尺寸 = 深六; } } /* fix 2026-08-20: 普通变量 sizeof (long long v → 8; 原 4); fix 2026-08-28: 数组总字节统一走 var_sizeof (2D 用标量元素大小, sizeof(int[2][2])=16 非 32) */
        若 (词型表[词位] == 右括) 词位++;
        *数值 = 尺寸; 返 1;
    }
    若 (词型表[词位] == 词变量) { 整 评值 = 全回(词名表[词位]); 整 首简 = (评值 != 0x80000000 && 评值 != -1); 若 (!首简) { 评值 = 域零(词名表[词位]); 首简 = (评值 != 0x80000000 && 评值 != -1); } /* e_lookup 缺失=0x80000000, macro_find 缺失=-1 — 两者都算未找到 */ 若 (!首简 && 宽劣 > 0) { 整 短次 = 中劣(词名表[词位]); 若 (短次 != 0x80000000) { 评值 = 短次; 首简 = 1; } } /* 2026-08-28 type-root-16 #76: CTFE 帧内变量 (参数/局部); fix 2026-08-29 #172: 帧内查到 -1 (负参数) 必须接受, 不能当"未找到"拒绝 */ 若 (首简) { *数值 = 评值; 词位++; 返 1; } 返 0; }
    若 (词型表[词位] == 左括) { 词位++; 若 (!常量表达式求值(数值)) 返 0; 若 (词型表[词位] == 右括) 词位++; 返 1; }
    若 (词型表[词位] == 减) { 词位++; 若 (!末列(数值)) 返 0; *数值 = -*数值; 返 1; }
    若 (词型表[词位] == 加) { 词位++; 返 末列(数值); }
    若 (词型表[词位] == 按位非) { 词位++; 若 (!末列(数值)) 返 0; *数值 = ~*数值; 返 1; }
    返 0;
}
静 整 常量表达式求值(整 *数值) {
    若 (!末列(数值)) 返 0;
    遍 (;;) {
        整 算子 = 词型表[词位];
        若 (算子 == 加 || 算子 == 减 || 算子 == 乘 || 算子 == 除 || 算子 == 取余 || 算子 == 左移 || 算子 == 右移 || 算子 == 点 || 算子 == 或 || 算子 == 异或 || 算子 == 高平 || 算子 == 顺八 || 算子 == 下双 || 算子 == 终附 || 算子 == 元九 || 算子 == 首降) {
            词位++; 整 结; 若 (!末列(&结)) 返 0;
            择 (算子) { 例 加: *数值 += 结; 断; 例 减: *数值 -= 结; 断; 例 乘: *数值 *= 结; 断;
                例 除: 若 (结) *数值 /= 结; 断; 例 取余: 若 (结) *数值 %= 结; 断; 例 左移: *数值 <<= 结; 断;
                例 右移: *数值 >>= 结; 断; 例 点: *数值 &= 结; 断; 例 或: *数值 |= 结; 断; 例 异或: *数值 ^= 结; 断;
                例 高平: *数值 = (*数值 == 结); 断; 例 顺八: *数值 = (*数值 != 结); 断; 例 下双: *数值 = (*数值 < 结); 断;
                例 终附: *数值 = (*数值 > 结); 断; 例 元九: *数值 = (*数值 <= 结); 断; 例 首降: *数值 = (*数值 >= 结); 断; /* fix 2026-08-25: _Static_assert 比较运算符 */ }
        } 否 断;
    }
    返 1;
}

/* ========== 编译期执行完整 CTFE 解释器 (2026-08-28 type-root-16 #76) ==========
   在 [body0, body1) 解释纯函数体 (调用方把全局 tk 设为 body0, 用完恢复).
   支持: 声明/赋值/if/while/for/return/块; 纯算术表达式 (const_expr_eval + CTFE 帧).
   返回: 1=解释完成 0=无法解释 (known=0 安全跳过). */
静 空 外七(常 字 *数, 整 值) { /* 帧绑定: 同名更新, 新名压栈 */
    遍 (整 计 = 宽劣 - 1; 计 >= 0; 计--) 若 (!比较字符串(余布[计], 数)) { 双午[计] = 值; 源利[计] = 0; 返; }
    若 (宽劣 < 64) { 复制字符串(余布[宽劣], 数); 双午[宽劣] = 值; 源利[宽劣] = 0; 宽劣++; }
}
静 空 栈吉一(常 字 *数, 常 字 *值) { /* 字符串帧绑定: 同名覆盖类型, 新名压栈 */
    遍 (整 计 = 宽劣 - 1; 计 >= 0; 计--) 若 (!比较字符串(余布[计], 数)) { 源利[计] = 1; 拷贝前n(外薄[计], 值, 4095); 外薄[计][4095] = 0; 返; }
    若 (宽劣 < 64) { 复制字符串(余布[宽劣], 数); 源利[宽劣] = 1; 拷贝前n(外薄[宽劣], 值, 4095); 外薄[宽劣][4095] = 0; 宽劣++; }
}
静 整 初进(常 字 *数, 字 *出, 整 剩繁) { /* 读字符串帧值; 返回 1=是字符串 */
    遍 (整 计 = 宽劣 - 1; 计 >= 0; 计--) 若 (!比较字符串(余布[计], 数) && 源利[计]) { 拷贝前n(出, 外薄[计], 剩繁 - 1); 出[剩繁 - 1] = 0; 返 1; }
    返 0;
}
静 整 首进(常 字 *数) { /* 帧槽是否字符串 */
    遍 (整 计 = 宽劣 - 1; 计 >= 0; 计--) 若 (!比较字符串(余布[计], 数) && 源利[计]) 返 1;
    返 0;
}
静 整 序置(字 *出, 整 剩繁) { /* 求值字符串表达式: 字面量 / 串变量 / 串(n) 数字转串 / + 拼接; 消费成功返回 1 (失败恢复 tk) */
    整 主戌 = 词位;
    字 缓[4096]; 缓[0] = 0;
    若 (词型表[词位] == 串词) { 拷贝前n(缓, 串表[词值表[词位]], 4095); 缓[4095] = 0; 词位++; }
    否 若 (词型表[词位] == 词变量 && 首进(词名表[词位])) { 初进(词名表[词位], 缓, 大小(缓)); 词位++; }
    否 若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "串")) { /* 串(n): int → 十进制串 (作首操作数) */
        词位++; 若 (词型表[词位] == 左括) 词位++;
        整 值 = 0; 若 (!常量表达式求值(&值)) { 词位 = 主戌; 返 0; }
        字 暂存[32]; 格式化到串(暂存, "%d", 值);
        拷贝前n(缓, 暂存, 4095); 缓[4095] = 0;
        若 (词型表[词位] == 右括) 词位++;
    }
    否 返 0;
    循环 (词型表[词位] == 加) { /* + 拼接 (lexer: 二元加=PK, +=复合=PA) */
        词位++;
        若 (词型表[词位] == 串词) { 拼前n(缓, 串表[词值表[词位]], 4095 - (整)取字长(缓)); 词位++; }
        否 若 (词型表[词位] == 词变量 && 首进(词名表[词位])) { 字 暂存[4096]; 初进(词名表[词位], 暂存, 大小(暂存)); 拼前n(缓, 暂存, 4095 - (整)取字长(缓)); 词位++; }
        否 若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "串")) { /* 串(n): int → 十进制串 */
            词位++; 若 (词型表[词位] == 左括) 词位++;
            整 值 = 0; 若 (!常量表达式求值(&值)) { 词位 = 主戌; 返 0; }
            字 暂存[32]; 格式化到串(暂存, "%d", 值);
            拼前n(缓, 暂存, 4095 - (整)取字长(缓));
            若 (词型表[词位] == 右括) 词位++;
        }
        否 { 词位 = 主戌; 返 0; }
    }
    拷贝前n(出, 缓, 剩繁); 出[剩繁 - 1] = 0;
    返 1;
}
静 整 后戊 = 0; /* CTFE 解释失败标志 (无法解释/副作用) — 区分 return 发生 vs 无法解释 */
静 整 现利(空) { /* tk 指向 {, 跳到匹配 } 之后; 返回 1 成功 */
    整 元 = 0;
    循环 (词位 < 词容量) { 若 (词型表[词位] == 左花) 元++; 否 若 (词型表[词位] == 右花) { 元--; 若 (元 == 0) { 词位++; 返 1; } } 词位++; }
    返 0;
}
静 整 当丙一(空) { /* 跳到顶层 ; (消费); 返回 1 成功 */
    整 元 = 0;
    循环 (词位 < 词容量) { 若 (词型表[词位] == 左括 || 词型表[词位] == 左花 || 词型表[词位] == 左方) 元++; 否 若 (词型表[词位] == 右括 || 词型表[词位] == 右花 || 词型表[词位] == 右方) { 若 (元 > 0) 元--; } 否 若 (词型表[词位] == 分号 && 元 == 0) { 词位++; 返 1; } 词位++; }
    返 0;
}
静 整 链聚(整 *值); /* fwd: for-step 解析 */
静 整 内申(空) { /* 定位 for-step 结束位置 (不执行, 从 tk 扫到顶层 KK/SK) — step 在循环尾才执行 */
    整 元 = 0; 整 乙 = 词位;
    循环 (乙 < 词容量) {
        若 (词型表[乙] == 左括) 元++;
        否 若 (词型表[乙] == 右括) { 若 (元 == 0) 返 乙; 元--; }
        否 若 (词型表[乙] == 分号 && 元 == 0) 返 乙;
        乙++;
    }
    返 乙;
}
静 整 池分(整 *返一) { /* 解释单条语句; 返回 1=继续 0=终止 (return 或块尾或无法解释 — 无法解释时 ctfe_failed=1) */
    若 (词位 >= 词容量) { 后戊 = 1; 返 0; }
    若 (词型表[词位] == 分号) { 词位++; 返 1; } /* 空语句 */
    若 (词型表[词位] == 左花) { /* 块 */
        词位++;
        循环 (词位 < 词容量 && 词型表[词位] != 右花) { 若 (!池分(返一)) { 若 (词型表[词位] == 右花) 词位++; 返 0; } }
        若 (词型表[词位] == 右花) 词位++;
        返 1;
    }
    若 (词型表[词位] == 后甲) { /* return expr; — int 或 字符串 (过程宏代码生成 #172) */
        词位++;
        字 列败[8192];
        若 (序置(列败, 大小(列败))) { /* 字符串返回 */
            拷贝前n(外退, 列败, 8191); 外退[8191] = 0; 净十 = 1;
            若 (词型表[词位] == 分号) 词位++;
            返 0;
        }
        整 值 = 0;
        若 (!常量表达式求值(&值)) { 后戊 = 1; 返 0; }
        若 (词型表[词位] == 分号) 词位++;
        *返一 = 值;
        返 0;
    }
    若 (词型表[词位] == 型词) { /* 声明: int x = expr [, y = expr]; — CTFE 支持标量 int + 字符串 (过程宏 #172) */
        循环 (词型表[词位] == 型词 || (词型表[词位] == 词变量 && 型定判断(词名表[词位]))) 词位++; /* 类型 (int/char/.../typedef 名) */
        循环 (词型表[词位] == 乘) 词位++; /* 指针: 跳过 (字符串变量即 char* 声明) */
        遍 (;;) {
            若 (词型表[词位] != 词变量) { 后戊 = 1; 返 0; }
            字 变节[64]; 复制字符串(变节, 词名表[词位]); 词位++;
            若 (词型表[词位] == 赋号) { 词位++; 字 帧属[8192]; 若 (序置(帧属, 大小(帧属))) { 栈吉一(变节, 帧属); } 否 { 整 值 = 0; 若 (!常量表达式求值(&值)) { 后戊 = 1; 返 0; } 外七(变节, 值); } }
            否 { 后戊 = 1; 返 0; } /* 无初始化 → 未知 */
            若 (词型表[词位] == 逗号) { 词位++; 续; }
            断;
        }
        若 (词型表[词位] == 分号) 词位++;
        返 1;
    }
    若 (词型表[词位] == 顺轮) { /* if (cond) stmt [else stmt] */
        词位++; 若 (词型表[词位] == 左括) 词位++;
        整 字值 = 0; 若 (!常量表达式求值(&字值)) { 后戊 = 1; 返 0; }
        若 (词型表[词位] == 右括) 词位++;
        若 (字值) {
            若 (!池分(返一)) { /* then 执行, return 结束: 若 else 存在则跳过其体 */
                若 (词型表[词位] == 虚伍) { 词位++; 若 (词型表[词位] == 左花) 现利(); 否 当丙一(); }
                返 0;
            }
            若 (词型表[词位] == 虚伍) { 词位++; 若 (词型表[词位] == 左花) 现利(); 否 当丙一(); } /* then 未 return: 跳过 else 体 */
        } 否 {
            若 (词型表[词位] == 左花) 现利(); 否 当丙一(); /* cv=0: 跳过 then 体 */
            若 (词型表[词位] == 虚伍) { 词位++; 若 (!池分(返一)) 返 0; }
        }
        返 1;
    }
    若 (词型表[词位] == 下得一) { /* while (cond) stmt — 真循环 (上限防死循环) */
        词位++; 若 (词型表[词位] == 左括) 词位++;
        整 条件位 = 词位; 整 单厚 = 0; 整 全陆一 = 0;
        遍 (;;) {
            词位 = 条件位; 整 字值 = 0;
            若 (!常量表达式求值(&字值)) { 后戊 = 1; 返 0; }
            若 (词型表[词位] == 右括) 词位++;
            单厚 = 词位;
            若 (!字值) 断;
            若 (++全陆一 > 1000000) { 后戊 = 1; 返 0; } /* 防死循环 */
            词位 = 单厚;
            若 (词型表[词位] == 左花) { 词位++; 循环 (词位 < 词容量 && 词型表[词位] != 右花) { 若 (!池分(返一)) { 若 (词型表[词位] == 右花) 词位++; 返 0; } } 若 (词型表[词位] == 右花) 词位++; }
            否 { 若 (!池分(返一)) 返 0; }
        }
        词位 = 单厚;
        若 (词型表[词位] == 左花) 现利(); 否 当丙一();
        返 1;
    }
    若 (词型表[词位] == 净吉) { /* for (init; cond; step) stmt — CTFE: init 为 int 声明/赋值 (ctfe_stmt 消费 ;), cond/step 常量表达式 */
        词位++; 若 (词型表[词位] == 左括) 词位++;
        若 (!池分(NULL)) 返 0; /* init (声明/赋值, 消费 ;) — 失败已由 ctfe_failed 标记 */
        整 条件位 = 词位; 整 单厚 = 0; 整 后拆 = 0; 整 旁进 = 0; 整 全陆一 = 0;
        遍 (;;) {
            词位 = 条件位; 整 字值 = 0;
            若 (词型表[词位] == 分号) 字值 = 1; /* for(;;) 无条件 */
            否 若 (!常量表达式求值(&字值)) { 后戊 = 1; 返 0; }
            若 (词型表[词位] == 分号) 词位++;
            后拆 = 词位; 旁进 = 词位;
            若 (词型表[词位] == 右括) { 词位++; 单厚 = 词位; } /* 无 step: for(;;cond;) — 直接到 ) */
            否 { 旁进 = 内申(); 词位 = 旁进; 若 (词型表[词位] == 右括) 词位++; 单厚 = 词位; } /* 只定位 step 结束, 不执行 (循环尾才执行) */
            若 (!字值) { 若 (词型表[词位] == 左花) 现利(); 否 当丙一(); 断; } /* cond 假: 跳过 body 到 for 结束 (tk 停在 body 开始, 不跳则外层误解释 body) */
            若 (++全陆一 > 1000000) { 后戊 = 1; 返 0; } /* 防死循环 */
            词位 = 单厚;
            若 (词型表[词位] == 左花) { 词位++; 循环 (词位 < 词容量 && 词型表[词位] != 右花) { 若 (!池分(返一)) { 若 (词型表[词位] == 右花) 词位++; 返 0; } } 若 (词型表[词位] == 右花) 词位++; }
            否 { 若 (!池分(返一)) 返 0; }
            词位 = 后拆; /* 循环尾执行 step (重新解释到 step_end) */
            若 (词位 < 旁进) { 整 帧属 = 0; 若 (!链聚(&帧属)) { 后戊 = 1; 返 0; } }
        }
        返 1;
    }
    若 (词型表[词位] == 词变量) { /* x = expr; 或 x++; x--; x += n; — 赋值支持字符串 (过程宏 #172) */
        字 变节[64]; 复制字符串(变节, 词名表[词位]); 词位++;
        若 (词型表[词位] == 赋号) { 词位++; 字 帧属[8192]; 若 (序置(帧属, 大小(帧属))) { 栈吉一(变节, 帧属); 若 (词型表[词位] == 分号) 词位++; 返 1; } 整 值 = 0; 若 (!常量表达式求值(&值)) { 后戊 = 1; 返 0; } 若 (中劣(变节) == 0x80000000) { 后戊 = 1; 返 0; } 外七(变节, 值); 若 (词型表[词位] == 分号) 词位++; 返 1; }
        若 (词型表[词位] == 增增) { 词位++; 整 当 = 中劣(变节); 若 (当 == 0x80000000) { 后戊 = 1; 返 0; } 外七(变节, 当 + 1); 若 (词型表[词位] == 分号) 词位++; 返 1; }
        若 (词型表[词位] == 减减) { 词位++; 整 当 = 中劣(变节); 若 (当 == 0x80000000) { 后戊 = 1; 返 0; } 外七(变节, 当 - 1); 若 (词型表[词位] == 分号) 词位++; 返 1; }
        若 (词型表[词位] == 加等 || 词型表[词位] == 减等 || 词型表[词位] == 乘等 || 词型表[词位] == 除等 || 词型表[词位] == 或等) { 整 算子 = 词型表[词位]; 词位++; 整 结 = 0; 若 (!常量表达式求值(&结)) { 后戊 = 1; 返 0; } 整 当 = 中劣(变节); 若 (当 == 0x80000000) { 后戊 = 1; 返 0; } 若 (算子 == 加等) 当 += 结; 否 若 (算子 == 减等) 当 -= 结; 否 若 (算子 == 乘等) 当 *= 结; 否 若 (算子 == 除等) { 若 (!结) { 后戊 = 1; 返 0; } 当 /= 结; } 否 { 若 (!结) { 后戊 = 1; 返 0; } 当 %= 结; } 外七(变节, 当); 若 (词型表[词位] == 分号) 词位++; 返 1; }
        后戊 = 1; 返 0; /* 函数调用等其他语句 → 无法解释 */
    }
    后戊 = 1; 返 0;
}
静 整 链聚(整 *值) { /* for-step: i++ / i-- / i+=n / i-=n / i*=n / i=n (无分号) */
    若 (词型表[词位] == 词变量) {
        字 变节[64]; 复制字符串(变节, 词名表[词位]); 词位++;
        若 (词型表[词位] == 增增) { 词位++; 整 当 = 中劣(变节); 若 (当 == 0x80000000) 返 0; 外七(变节, 当 + 1); 返 1; }
        若 (词型表[词位] == 减减) { 词位++; 整 当 = 中劣(变节); 若 (当 == 0x80000000) 返 0; 外七(变节, 当 - 1); 返 1; }
        若 (词型表[词位] == 赋号) { 词位++; 整 结 = 0; 若 (!常量表达式求值(&结)) 返 0; 外七(变节, 结); 返 1; }
        若 (词型表[词位] == 加等 || 词型表[词位] == 减等 || 词型表[词位] == 乘等 || 词型表[词位] == 除等 || 词型表[词位] == 或等) { 整 算子 = 词型表[词位]; 词位++; 整 结 = 0; 若 (!常量表达式求值(&结)) 返 0; 整 当 = 中劣(变节); 若 (当 == 0x80000000) 返 0; 若 (算子 == 加等) 当 += 结; 否 若 (算子 == 减等) 当 -= 结; 否 若 (算子 == 乘等) 当 *= 结; 否 若 (算子 == 除等) { 若 (!结) 返 0; 当 /= 结; } 否 { 若 (!结) 返 0; 当 %= 结; } 外七(变节, 当); 返 1; }
    }
    返 0;
}
静 整 中属(常 字 *串升, 整 *出) { /* 编译期 f(常量...): 解析实参 (全常量) → 绑定参数帧 → 解释函数体 → *out=结果; 返回 1 成功 0 无法 */
    整 己序 = 宽庚(串升);
    若 (己序 < 0) 返 0;
    整 满癸 = 存陆(串升);
    若 (满癸 < 0) 返 0;
    整 基 = 宽劣;
    后戊 = 0;
    /* 解析实参 (tk 已在 '(' 后): 常量表达式, 逗号分隔, 到 ) */
    整 首合 = 0; 整 段吉[32];
    若 (词型表[词位] != 右括) {
        遍 (;;) {
            若 (首合 >= 32) { 宽劣 = 基; 返 0; }
            整 参值 = 0;
            若 (!常量表达式求值(&参值)) { 宽劣 = 基; 返 0; } /* 实参非常量 → 无法 */
            段吉[首合++] = 参值;
            若 (词型表[词位] == 逗号) { 词位++; 续; }
            断;
        }
    }
    若 (词型表[词位] != 右括) { 宽劣 = 基; 返 0; }
    词位++; /* ) */
    遍 (整 计 = 0; 计 < 首合; 计++) 外七(度伍[满癸].左组[计], 段吉[计]);
    /* 解释函数体 */
    整 存词位 = 词位;
    词位 = 计序[己序].短亥; /* 指向 { */
    整 返回值 = 0; 整 后置一 = 0;
    若 (词型表[词位] == 左花) 词位++; /* 跳过 { */
    循环 (词位 < 词容量 && 词型表[词位] != 右花 && 词位 < 计序[己序].隔子 && !后戊) {
        若 (!池分(&返回值)) { 后置一 = 1; 断; } /* return 或失败 */
    }
    整 成功 = !后戊;
    若 (成功 && !后置一) 返回值 = 0; /* 函数体自然结束 (无 return → 隐式 0) — return 后 rv 有效, 不覆盖 */
    宽劣 = 基;
    词位 = 存词位;
    若 (!成功) 返 0;
    *出 = 返回值;
    返 1;
}

静 整 毛重(常 字 *串升, 字 *出, 整 剩繁) { /* 过程宏 #172: 同 ctfe_call 但期望字符串返回 → out; 返回 1 成功 */
    整 己序 = 宽庚(串升);
    若 (己序 < 0) 返 0;
    整 满癸 = 存陆(串升);
    若 (满癸 < 0) 返 0;
    整 基 = 宽劣;
    后戊 = 0;
    净十 = 0; 外退[0] = 0;
    整 首合 = 0; 整 段吉[32];
    若 (词型表[词位] != 右括) {
        遍 (;;) {
            若 (首合 >= 32) { 宽劣 = 基; 返 0; }
            整 参值 = 0;
            若 (!常量表达式求值(&参值)) { 宽劣 = 基; 返 0; }
            段吉[首合++] = 参值;
            若 (词型表[词位] == 逗号) { 词位++; 续; }
            断;
        }
    }
    若 (词型表[词位] != 右括) { 宽劣 = 基; 返 0; }
    词位++; /* ) */
    遍 (整 计 = 0; 计 < 首合; 计++) 外七(度伍[满癸].左组[计], 段吉[计]);
    整 存词位 = 词位;
    词位 = 计序[己序].短亥; /* 指向 { */
    整 返回值 = 0;
    若 (词型表[词位] == 左花) 词位++;
    循环 (词位 < 词容量 && 词型表[词位] != 右花 && 词位 < 计序[己序].隔子 && !后戊) {
        若 (!池分(&返回值)) 断; /* return (int 或字符串) 或解释失败 */
    }
    整 成功 = !后戊;
    宽劣 = 基;
    词位 = 存词位;
    若 (!成功) 返 0;
    若 (!净十) 返 0; /* 未返回字符串 → 非代码生成宏 */
    拷贝前n(出, 外退, 剩繁 - 1); 出[剩繁 - 1] = 0;
    返 1;
}

静 整 标降(整 词位) {
    /* 跳过全局/文件级声明中的初始化器: = expr / = { ... } / = ( ... )
       到顶层逗号或分号停止 (不消费逗号/分号)。 (fix 2026-08-15: *local_packs = NULL, *altodb_packs = NULL) */
    若 (词型表[词位] != 赋号) 返 词位;
    词位++;
    整 元 = 0;
    循环 (词位 < 词容量 && 词型表[词位] != 词终) {
        若 (词型表[词位] == 左花 || 词型表[词位] == 左括 || 词型表[词位] == 左方) 元++;
        否 若 (词型表[词位] == 右花 || 词型表[词位] == 右括 || 词型表[词位] == 右方) { 元--; 若 (元 < 0) 元 = 0; }
        否 若 (元 == 0 && (词型表[词位] == 逗号 || 词型表[词位] == 分号)) 断;
        词位++;
    }
    返 词位;
}

/* ========== 宏系统 (2026-08-28 type-root-12 #167: AST 级安全宏 — lex 后 parse 前 token 级展开) ========== */
静 构 { 字 名[64]; 字 容败[16][64]; 整 参数数; 整 短亥; 整 隔子; } 隔升[512];
静 整 首布 = 0;
静 整 尾叁[512]; 静 整 首降一[512]; /* 宏声明 token 区间 (展开时跳过) */
静 整 短丁一(常 字 *数) { 遍 (整 计 = 0; 计 < 首布; 计++) 若 (!比较字符串(隔升[计].名, 数)) 返 计; 返 -1; }

静 整 *段粗; 静 整 *段汇; 静 整 *正低; 静 整 *源厚一; 静 整 *前乙; 静 整 *栈挂;
静 字 (*余集)[64];
静 整 空八; 静 整 半吉;
/* 嵌套宏展开帧栈: 每帧记录 宏索引 + 原始实参 token 切片 (调用者上下文惰性展开, 替换时括号包裹) */
静 整 净列[24]; 静 整 短捌[24]; 静 整 旁六[24][16][2];

静 空 计排二(空) { 输出到文件(错误流, "[ERR] A9008 宏展开超限: token 数超上限\n"); 退出(1); }

静 空 序申(整 计) {
    若 (空八 >= 词容量) 计排二();
    段粗[空八] = 词型表[计]; 段汇[空八] = 词值表[计]; 复制字符串(余集[空八], 词名表[计]);
    正低[空八] = 词行表[计]; 源厚一[空八] = 词无符号表[计]; 前乙[空八] = 词长表[计]; 栈挂[空八] = 段属[计];
    空八++;
}

静 空 源肆(整 型) { /* 合成 ( ) token 用于实参括号包裹 */
    若 (空八 >= 词容量) 计排二();
    段粗[空八] = 型; 段汇[空八] = 0; 复制字符串(余集[空八], 型 == 左括 ? "(" : ")");
    正低[空八] = 0; 源厚一[空八] = 0; 前乙[空八] = 0; 栈挂[空八] = 0;
    空八++;
}

静 整 直陆(整 计, 整 *高四, 整 *参出) { /* 最内层活动帧的参数匹配 (词法遮蔽) */
    遍 (整 文件 = 半吉 - 1; 文件 >= 0; 文件--) {
        整 宏序 = 净列[文件];
        遍 (整 寻 = 0; 寻 < 隔升[宏序].参数数; 寻++)
            若 (!比较字符串(隔升[宏序].容败[寻], 词名表[计])) { *高四 = 文件; *参出 = 寻; 返 1; }
    }
    返 0;
}

/* 展开原 token 区间 [a,b) 到输出: 嵌套宏调用展开 + 活动帧参数替换 (实参在调用者上下文惰性展开+括号包裹) */
静 空 首布一(整 甲, 整 发字节);

静 空 深薄一(整 顺转, 整 寻) { /* 帧 fr 的第 q 个实参, 在调用者上下文 (帧 0..fr-1) 展开 — 保存/恢复被隐藏帧槽位 (嵌套调用会复用槽位) */
    整 存 = 半吉;
    整 末分 = 净列[顺转]; 整 旁伴一 = 短捌[顺转]; 整 旧拾[16][2];
    遍 (整 键 = 0; 键 < 16; 键++) { 旧拾[键][0] = 旁六[顺转][键][0]; 旧拾[键][1] = 旁六[顺转][键][1]; }
    半吉 = 顺转;
    源肆(左括);
    首布一(旁六[顺转][寻][0], 旁六[顺转][寻][1]);
    源肆(右括);
    半吉 = 存;
    净列[顺转] = 末分; 短捌[顺转] = 旁伴一;
    遍 (整 键 = 0; 键 < 16; 键++) { 旁六[顺转][键][0] = 旧拾[键][0]; 旁六[顺转][键][1] = 旧拾[键][1]; }
}

静 空 首布一(整 甲, 整 发字节) {
    整 计 = 甲;
    循环 (计 < 发字节) {
        若 (词型表[计] == 词变量 && !比较字符串(词名表[计], "宏")) {
            整 段合 = -1; 遍 (整 键 = 0; 键 < 首布; 键++) 若 (尾叁[键] == 计) { 段合 = 键; 断; }
            若 (段合 >= 0) { 计 = 首降一[段合]; 续; }
        }
        若 (词型表[计] == 词变量) {
            整 末深, 右集;
            若 (直陆(计, &末深, &右集)) { 深薄一(末深, 右集); 计++; 续; }
        }
        整 宏序 = (词型表[计] == 词变量) ? 短丁一(词名表[计]) : -1;
        若 (词型表[计] == 词变量 && 计 + 1 < 词序 && 词型表[计 + 1] == 左括 && 宏序 >= 0 && 半吉 < 24) {
            整 常式 = 计 + 2; 整 元 = 1;
            循环 (常式 < 词序 && 元 > 0) { 若 (词型表[常式] == 左括) 元++; 否 若 (词型表[常式] == 右括) { 元--; 若 (元 == 0) 断; } 常式++; }
            整 度肆[16][2]; 整 匿数 = 0; 整 行己 = 计 + 2; 整 指深度 = 0;
            遍 (整 指 = 计 + 2; 指 < 常式; 指++) {
                若 (词型表[指] == 左括) 指深度++;
                否 若 (词型表[指] == 右括) { 若 (指深度 > 0) 指深度--; }
                否 若 (词型表[指] == 逗号 && 指深度 == 0) { 若 (匿数 < 16) { 度肆[匿数][0] = 行己; 度肆[匿数][1] = 指; } 匿数++; 行己 = 指 + 1; }
            }
            若 (行己 < 常式 && 匿数 < 16) { 度肆[匿数][0] = 行己; 度肆[匿数][1] = 常式; 匿数++; } /* 空括号 an=0 */
            若 (匿数 != 隔升[宏序].参数数) { 词位 = 计; 发错误("A9007", "宏参数个数不匹配: 调用与声明参数数不一致"); }
            整 顺转 = 半吉;
            净列[顺转] = 宏序; 短捌[顺转] = 匿数;
            遍 (整 键 = 0; 键 < 匿数; 键++) { 旁六[顺转][键][0] = 度肆[键][0]; 旁六[顺转][键][1] = 度肆[键][1]; }
            半吉++;
            首布一(隔升[宏序].短亥, 隔升[宏序].隔子); /* 整个体连续展开 — 内部游标自动越过嵌套调用 (逐 token 调用会把嵌套调用内部 token 重复处理) */
            半吉--;
            计 = 常式 + 1;
        } 否 {
            序申(计); 计++;
        }
    }
}

静 空 容癸一(空) {
    整 计 = 0;
    首布 = 0;
    循环 (计 < 词序) {
        若 (词型表[计] == 词变量 && !比较字符串(词名表[计], "宏") && 计 + 2 < 词序 && 词型表[计 + 1] == 词变量 && 词型表[计 + 2] == 左括) {
            整 池凶 = 计 + 2; 整 指深度 = 0; 整 全丁 = -1;
            循环 (池凶 < 词序) { 若 (词型表[池凶] == 左括) 指深度++; 否 若 (词型表[池凶] == 右括) { 指深度--; 若 (指深度 == 0) { 全丁 = 池凶; 断; } } 池凶++; }
            若 (全丁 > 0 && 首布 < 512) {
                整 邻壬 = 首布;
                复制字符串(隔升[邻壬].名, 词名表[计 + 1]);
                隔升[邻壬].参数数 = 0;
                { 整 栈劣 = 0; 遍 (整 寻 = 计 + 2; 寻 < 全丁; 寻++) { 若 (词型表[寻] == 左括) 栈劣++; 否 若 (词型表[寻] == 右括) 栈劣--; 否 若 (词型表[寻] == 词变量 && 栈劣 == 1 && 隔升[邻壬].参数数 < 16) 复制字符串(隔升[邻壬].容败[隔升[邻壬].参数数++], 词名表[寻]); } }
                整 域升 = -1; 整 计从 = -1; 整 声明终 = 全丁 + 1;
                若 (全丁 + 1 < 词序 && 词型表[全丁 + 1] == 赋号) { /* = expr ; */
                    域升 = 全丁 + 2; 整 元 = 0; 整 乙 = 全丁 + 2;
                    循环 (乙 < 词序) { 若 (词型表[乙] == 左括 || 词型表[乙] == 左花 || 词型表[乙] == 左方) 元++; 否 若 (词型表[乙] == 右括 || 词型表[乙] == 右花 || 词型表[乙] == 右方) { 若 (元 > 0) 元--; } 否 若 (词型表[乙] == 分号 && 元 == 0) { 计从 = 乙; 声明终 = 乙 + 1; 断; } 乙++; }
                } 否 若 (全丁 + 1 < 词序 && 词型表[全丁 + 1] == 左花) { /* { ... } */
                    域升 = 全丁 + 1; 整 元 = 0; 整 乙 = 全丁 + 1;
                    循环 (乙 < 词序) { 若 (词型表[乙] == 左花) 元++; 否 若 (词型表[乙] == 右花) { 元--; 若 (元 == 0) { 计从 = 乙 + 1; 声明终 = 乙 + 1; 断; } } 乙++; }
                }
                若 (域升 >= 0 && 计从 >= 域升) {
                    隔升[邻壬].短亥 = 域升; 隔升[邻壬].隔子 = 计从;
                    尾叁[邻壬] = 计; 首降一[邻壬] = 声明终;
                    首布++;
                    计 = 声明终; 续;
                }
            }
        }
        计++;
    }
    若 (首布 == 0) 返;
    段粗 = 清零分配(词容量, 4); 段汇 = 清零分配(词容量, 4); 正低 = 清零分配(词容量, 4);
    源厚一 = 清零分配(词容量, 4); 前乙 = 清零分配(词容量, 4); 栈挂 = 清零分配(词容量, 4);
    余集 = 清零分配(词容量, 64);
    若 (!段粗 || !段汇 || !正低 || !源厚一 || !前乙 || !栈挂 || !余集) { 输出到文件(错误流, "[ERR] 宏展开内存不足\n"); 退出(1); }
    空八 = 0; 半吉 = 0;
    首布一(0, 词序);
    释放内存(词型表); 释放内存(词值表); 释放内存(词名表); 释放内存(词行表); 释放内存(词无符号表); 释放内存(词长表); 释放内存(段属);
    词型表 = 段粗; 词值表 = 段汇; 词名表 = 余集; 词行表 = 正低; 词无符号表 = 源厚一; 词长表 = 前乙; 段属 = 栈挂;
    词序 = 空八;
}
/* fix 2026-08-30 探雷报告 雷1: 括号配对验证 — token 级统一扫 (lex+宏展开后, parser 前),
   任何不平衡立即报错 (带行号), 不再静默吞残缺语法 (原 blk() EK 静默退出 + 顶层孤立 } 忽略).
   C 括号严格嵌套, 纯栈式匹配即正确; 字符串/字符/注释已由 lex 处理为单 token, 不干扰. */
静 整 主置(空) {
    整 顺降[8192]; 整 名从[8192]; 整 缓甲 = 0;
    遍 (整 计 = 0; 计 < 词容量 && 词型表[计] != 词终; 计++) {
        整 暂 = 词型表[计];
        若 (暂 == 左括 || 暂 == 左方 || 暂 == 左花) {
            若 (缓甲 >= 8192) { 输出到文件(错误流, "[ERR] 括号嵌套过深 行 %d (paren_balance)\n", 词行表[计]); 返 -1; }
            顺降[缓甲] = 暂; 名从[缓甲] = 词行表[计]; 缓甲++;
        } 否 若 (暂 == 右括 || 暂 == 右方 || 暂 == 右花) {
            若 (缓甲 <= 0) { 输出到文件(错误流, "[ERR] 多余右括号 '%c' 行 %d (paren_balance)\n", 暂 == 右括 ? ')' : (暂 == 右方) ? ']' : '}', 词行表[计]); 返 -1; }
            整 暂柒 = (暂 == 右括) ? 左括 : (暂 == 右方) ? 左方 : 左花;
            若 (顺降[缓甲 - 1] != 暂柒) {
                字 丙 = (顺降[缓甲 - 1] == 左括) ? '(' : (顺降[缓甲 - 1] == 左方) ? '[' : '{';
                字 字符 = (暂 == 右括) ? ')' : (暂 == 右方) ? ']' : '}';
                输出到文件(错误流, "[ERR] 括号不匹配 '%c' vs '%c' (开 行 %d, 闭 行 %d) (paren_balance)\n", 丙, 字符, 名从[缓甲 - 1], 词行表[计]);
                返 -1;
            }
            缓甲--;
        }
    }
    若 (缓甲 > 0) {
        输出到文件(错误流, "[ERR] 缺右括号: %d 个未闭合 (首个开括号 '%c' 行 %d) (paren_balance)\n", 缓甲, (顺降[0] == 左括) ? '(' : (顺降[0] == 左方) ? '[' : '{', 名从[0]);
        返 -1;
    }
    返 0;
}

静 整 解析(常 字 *串值) {
    词位 = 0; 接子数 = 1; 变量数 = 0; 栈用量 = 32; /* reserve shadow space */
    遍 (整 单聚 = 0; 单聚 < 16384; 单聚++) { 变量表[单聚].元列 = 0; 变量表[单聚].首贰 = 0; 变量表[单聚].双伍 = 0; } /* fix step30/31: 静态 vars 数组跨编译残留清零 — 对齐间接/VLA 标记必须每编译重置 */
    函数定义数 = 0; /* fix 2026-08-06: 每次 parse 重置顶层函数列表 */
    内存设置(节浮标, 0, 大小(节浮标)); /* per-node double flags must not leak across compiles */
    内存设置(节无符号, 0, 大小(节无符号)); /* per-node unsigned flags (fix 2026-08-05) */
    单粗 = 0; /* reset per-function var-range table */
    计凶 = 0; /* 过程宏注册表每编译重置 (嵌入模式多文件编译防残留) */
    内存设置(词型表, 0, 词容量 * 4);
    字 *后弊 = 缓卯(串值, 0); /* #include 预展开（fix 2026-08-06） */
    
     
    行申(后弊); /* fix 2026-08-07: 移到 include 展开之后 — 头文件里的函数宏才能被收集展开 */
     
    原从(后弊); /* fix 2026-08-13: 对象宏收集 (lex 前, Git hash-ll.h) */
    净集(后弊); /* 泛型定义预扫描 (接入 2026-08-28 #96): 无条件执行, 注册 泛型 fn_macro (lex 前, 展开调用) */
     
    若 (函数宏数 > 0) {
        字 *元列一 = 计进二(后弊);
         
        若 (元列一 && 元列一[0]) { 释放内存(后弊); 后弊 = 元列一; }
    }
    若 (栈凶 > 0) { /* fix 2026-08-13: 对象宏文本层展开 (lex 前) */
         
        字 *中高一 = 实退一(后弊);
        若 (中高一 && 中高一[0]) { 释放内存(后弊); 后弊 = 中高一; }
    }
    若 (函数宏数 > 0) { /* fix 2026-08-15: 对象宏值里嵌套的函数宏需第二遍展开 (STRMAP_INIT → HASHMAP_INIT) — 否则 jyld undefined symbol */
        字 *堆失 = 计进二(后弊);
        若 (堆失 && 堆失[0]) { 释放内存(后弊); 后弊 = 堆失; }
    }
    虚五 = 0; /* fix 2026-08-13 Phase3: lex 阶段 #if defined(X) 走 macro 表(lex 自己的 #define); 清 pp_guard 防 fn_macro_collect 污染 → #if !defined(XTYPES_H) 被误判已定义跳过 xtypes.h typedef */
    
     
词法(后弊);
    若 (串双 > 0) { 剩伴 = 1; 遍 (整 外拾 = 0; 外拾 < 串双 && 外拾 < (整)取字长(后弊); 外拾++) 若 (后弊[外拾] == '\n') 剩伴++; } /* 2026-08-28 loc.line: exp_src 中 rt 部分实际行数 (展开后, 比 rt_line_skip 准) */
    容癸一(); /* 宏系统 (2026-08-28 type-root-12 #167): lex 后 parse 前 token 级展开 — 宏 名(参数) = expr; 或 宏 名(参数) { 语句 } */

    { 字 目次[96]; 格式化到串(目次, "{\"cp\":\"lex\",\"tokens\":%d}", 词序); 长叁(目次); } /* 编译检查点 (2026-08-28 AI原生 #6): lex 完成快照 */
    内巳(); /* 编译 DAG (可吞清单 P0-9): token 流阶段哈希 (tt/tv/tn/tline 入链) */

    
    释放内存(后弊);
    若 (词序 >= 词容量) { 输出到文件(错误流, "[ERR] token overflow\n"); 返 -1; }
    若 (主置() < 0) 返 -1; /* fix 2026-08-30 探雷雷1: 括号配对验证 (lex+宏展开后, parser 前) */
    整 指 = 建节(3); 若 (指 < 0) 返 -1;
    副丑 = 指; /* fix 2026-08-18: 记录根节点 → Nc 子节点硬上限豁免 (根子槽仅 256, 函数>256 由 fdef_list 保留) */
    
    循环 (词位 < 词容量 && 词型表[词位] != 词终) {
        { 整 列玖 = 词位; (空)列玖; }
        旁联 = 0; 名散 = 0; /* fix 2026-08-25 step21: 每顶层语句清残留 — 变量前 _Alignas 不消费也不毒害后续 struct; step25: ag_struct 同步清 */
        若 (词型表[词位] == 直联) { 整 首酉 = 词值表[词位]; 词位++; 若 (词型表[词位] == 结构词) { 名散 = 首酉; 旁联 = 0; } 否 旁联 = 首酉; } /* fix 2026-08-25 step21: 顶层 _Alignas(N) — struct 前修饰 struct 变量 (step25), 否则给变量 (下一轮清理) */
        
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "__asm__") || !比较字符串(词名表[词位], "__asm"))) { /* 顶层内联汇编 (__attribute__ 误解析致函数体落到顶层): 跳过 */
            词位++;
            若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "__volatile__") || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")))) 词位++;
            若 (词型表[词位] == 左括) { 整 元 = 1; 词位++; 循环 (词位 < 词容量 && 元 > 0) { 若 (词型表[词位] == 左括) 元++; 否 若 (词型表[词位] == 右括) { 元--; 若 (元 <= 0) { 词位++; 断; } } 词位++; } }
            若 (词型表[词位] == 分号) 词位++;
            续;
        }
        /* _Static_assert(expr, "msg"); — C11 编译期断言 (fix 2026-08-25 支持矩阵补全) */
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "_Static_assert") || !比较字符串(词名表[词位], "static_assert"))) {
            词位++; /* skip name */
            若 (词型表[词位] == 左括) 词位++; /* ( */
            整 单细一 = 0;
            常量表达式求值(&单细一);
            循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++; /* 跳到分号 (跳过 , "msg" ) ) */
            若 (词型表[词位] == 分号) 词位++;
            若 (!单细一) { 输出到文件(错误流, "[ERR] _Static_assert 失败\n"); 返 -1; }
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "测试")) { /* 接入 2026-08-29 P2 #192 编译期测试/文档: 测试 "名" 用 func; → ginit: __qcc_test_reg("名", func) — 测试函数用户定义 (返回 0=通过 非0=失败) */
            词位++; /* 测试 */
            字 型名[64]; 型名[0] = 0;
            若 (词型表[词位] == 串词) { 拷贝前n(型名, 串表[词值表[词位]], 63); 型名[63] = 0; 词位++; } /* "名" */
            若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "用")) 词位++; /* 用 */
            字 下二[64]; 复制字符串(下二, 词名表[词位]); 词位++; /* 测试函数名 */
            若 (词型表[词位] == 分号) 词位++; /* ; */
            若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
            若 (!串表[串数]) 串表[串数] = 短六();
            复制字符串(串表[串数], 型名);
            整 块 = 建节(5);
            整 呼 = 建节(4);
            { 整 符号数 = 建节(0); 节值表[符号数] = 串数; 节型表[符号数] = 串词; 接子(呼, 符号数); } /* 参数1: "名" */
            串数++;
            { 整 宽环 = 建节(1); 复制内存((字*)(节名表 + 宽环), 下二, 64); 接子(呼, 宽环); } /* 参数2: 函数地址 */
            { 整 存分 = 建节(1); 复制内存((字*)(节名表 + 存分), "__qcc_test_reg", 15); 接子(呼, 存分); } /* callee */
            接子(块, 呼);
            若 (全局初始化数 < 16384) 后凶[全局初始化数++] = 块; /* main 入口执行注册 */
            续;
        }
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "接口") || !比较字符串(词名表[词位], "实现") || !比较字符串(词名表[词位], "常量"))) { /* 接入 2026-08-29 P2 #207 修复: 接口/实现 顶层声明 — parse 顶层循环原无分支 → else break 吞后续 (main 丢失崩溃); stmt() 级已支持 (blk 内), 顶层显式转发 */
            整 串值 = 语句(); /* 接口 名 { 方法 }; / 实现 名 于 类型 { 方法 = fn }; (注册接口/impl 表) */
            若 (串值 >= 0) 接子(指, 串值);
            续;
        }
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "线程安全") || !比较字符串(词名表[词位], "线程不安全"))) { /* 接入 2026-08-29 P2 #70 Send/Sync: 线程安全 T; / 线程不安全 T; — 标记类型跨线程传递安全/不安全 (传线程 检查) */
            整 尾平一 = !比较字符串(词名表[词位], "线程安全");
            词位++;
            字 计七[64]; 复制字符串(计七, 词名表[词位]); 词位++;
            若 (词型表[词位] == 分号) 词位++;
            若 (尾平一) 新失(计七); /* 线程安全 → 从 unsafe 表移除 (覆盖) */
            否 若 (后劣 < 64 && !串又(计七)) 复制字符串(空乙[后劣++], 计七); /* 线程不安全 → 注册 */
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "密封")) { /* 接入 2026-08-29 P2 #207 密封/最终类: 密封 T; → 标记类型 T 不可被实现 (impl T { ... } 拦截) */
            词位++; /* 密封 */
            字 符号数[64]; 复制字符串(符号数, 词名表[词位]); 词位++;
            若 (词型表[词位] == 分号) 词位++;
            若 (行未 < 64 && !栈六(符号数)) 复制字符串(源九一[行未++], 符号数);
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "部分应用")) { /* 接入 2026-08-29 P2 #212 柯里化/部分应用: 部分应用 g, f, a; → 生成 int g(int __pa_x) { return f(a, __pa_x); } (绑定第一个参数, 顶层函数定义) */
            词位++; /* 部分应用 */
            字 毛寅[64]; 复制字符串(毛寅, 词名表[词位]); 词位++; /* g 包装函数名 */
            若 (词型表[词位] == 逗号) 词位++;
            字 串升[64]; 复制字符串(串升, 词名表[词位]); 词位++; /* f 原函数名 */
            若 (词型表[词位] == 逗号) 词位++;
            整 半寅 = 表达式(); /* 绑定参数 a */
            若 (词型表[词位] == 分号) 词位++;
            静 整 副进二 = 0; 字 序子[32]; 格式化到串(序子, "__pa_%d_", 副进二++);
            整 函数定义 = 建节(4); 复制内存((字*)(节名表 + 函数定义), 毛寅, 64);
            新寅[单粗] = 变量数; /* 2026-08-29 P2 #212: 函数变量起点 (缺则 g 变量范围含全部 → 序言 40+ 垃圾存帧) */
            变参(序子, 0, 0, 4, -1, 0, 0); /* int __pa_x (第 1 参数 slot=0→rcx, 原 slot=1→rdx 错位) */
            整 反对 = 建节(5);
            { 整 呼 = 建节(4);
              接子(呼, 半寅); /* 参数1: 绑定值 a */
              { 整 值指 = 建节(1); 复制内存((字*)(节名表 + 值指), 序子, 32); 接子(呼, 值指); } /* 参数2: x */
              { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 串升, 64); 接子(呼, 函); } /* callee: f */
              整 邻轮 = 建节(6); 接子(邻轮, 呼); 接子(反对, 邻轮); } /* return f(a, x); */
            接子(函数定义, 反对);
            若 (单粗 >= 65536) { 输出到文件(错误流, "[ERR] 函数体表超过 65536 上限\n"); 退出(1); }
            总甲[单粗] = 变量数; 单粗++; 反细[单粗 - 1] = 栈用量; 右陆 = 0;
            解析基 = 0;
            接子(指, 函数定义);
            若 (函数定义数 < 1024) { 号平[函数定义数] = 0; 函数定义表[函数定义数++] = 函数定义; }
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "嵌入")) { /* 接入 2026-08-29 P2 #189 编译期文件读取 (#embed 中文版): 嵌入 "file" 于 数据, 长度; — 编译期读文件 → 全局 char*数据 + int长度 (ginit 初始化) */
            词位++; /* 嵌入 */
            字 串升[256]; 串升[0] = 0;
            若 (词型表[词位] == 串词) { 拷贝前n(串升, 串表[词值表[词位]], 255); 串升[255] = 0; 词位++; } /* "file" */
            若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "于")) 词位++;
            字 初联[64]; 复制字符串(初联, 词名表[词位]); 词位++; /* 数据名 */
            若 (词型表[词位] == 逗号) 词位++;
            字 当降[64]; 复制字符串(当降, 词名表[词位]); 词位++; /* 长度名 */
            若 (词型表[词位] == 分号) 词位++;
