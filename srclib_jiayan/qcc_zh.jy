        }
        否 { 接子(发字节, 语句()); 字节计数++; }
    }
    若 (词型表[词位] == 右花) 词位++; /* 修复 2026-08-07: 词终 提前退出时不得越过 词元 区 (原无条件 词位++ 遇 文件尾 越界). 注意: 变量数 非 restored — C 已 函数 作用域, 非 块 作用域 */
    守卫冲刷(发字节); /* BatchB2: 块尾 残留 F 冲刷 (最后一条语句的移动/武装 在 发射条件析构 前落定) */
    遍 (整 庚序 = 逆汇 - 1; 庚序 >= 0; 庚序--) { 若 (守卫表[庚序].槽名[0] != 0 && 守卫表[庚序].槽帧 == 计贰) { 接子(发字节, 守卫条件析构(庚序)); 字节计数++; 守卫表[庚序].槽名[0] = 0; } } /* BatchB (2026-09-06): 块退出 同层守卫 条件析构 (运行时武装标志 F, 路径精确 — 分支内移出 F=0 则该路径不析构; 替代 原 串寅 静态门) */ { 整 戌 = 0; 遍 (整 结 = 0; 结 < 逆汇; 结++) { 若 (守卫表[结].槽名[0] != 0) { 复制内存(&守卫表[戌], &守卫表[结], sizeof(守卫表[戌])); /* C1: 整槽拷贝 (避开所有权) */  戌++; } } 逆汇 = 戌; } /* 接入 2026-08-28 机制层 #8 RAII: 块退出 → 自动调用本块守卫析构 (LIFO 逆序, 复用 计贰 判断作用域, 压缩移除) */ /* BatchB: 友格 同步压缩 */
