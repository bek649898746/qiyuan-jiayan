            若 (((!比前n(段 + 寻二, "define", 6) && (段[寻二+6] == 0 || 段[寻二+6] == ' ' || 段[寻二+6] == '\t')) || (!比前n(段 + 寻二, "定义词", 9) && (段[寻二+9] == 0 || 段[寻二+9] == ' ' || 段[寻二+9] == '\t')))) { /* fix 2026-08-26 sqlite: 位置语义 — 记录函数宏定义点, 之后的调用才展开 */
                整 寻三 = 寻二 + (段[寻二] == 'd' ? 6 : 9); 循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
                字 域一[64]; 整 主未 = 0;
                循环 (判字母数字((无 字)段[寻三]) || 段[寻三] == '_' || ((无 字)段[寻三] >= 0x80)) { 若 (主未 < 63) 域一[主未++] = 段[寻三]; 寻三++; }
                域一[主未] = 0;
                若 (段[寻三] == '(') 遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (!比较字符串(函数宏表[键].名, 域一)) { 缺亥一[键] = 1; 断; }
            } 否 若 (!比前n(段 + 寻二, "undef", 5) && (段[寻二+5] == 0 || 段[寻二+5] == ' ' || 段[寻二+5] == '\t')) {
                整 寻三 = 寻二 + 5; 循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
                字 域一[64]; 整 主未 = 0;
                循环 (判字母数字((无 字)段[寻三]) || 段[寻三] == '_' || ((无 字)段[寻三] >= 0x80)) { 若 (主未 < 63) 域一[主未++] = 段[寻三]; 寻三++; }
                域一[主未] = 0;
                遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (!比较字符串(函数宏表[键].名, 域一)) { 缺亥一[键] = 0; 断; }
            }
            循环 (段[计] && 段[计] != '\n') { 若 (*丙 + 1 > *容量) { *容量 *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] OOM realloc\n"); 退出(1); } 出 = *出指; } 出[(*丙)++] = 段[计++]; }
