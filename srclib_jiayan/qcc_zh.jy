        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* align */
        减栈即(48); /* shadow 32 + stack arg 8 + pad 8 */
        移64(1, 10); /* rcx = handle */
        移64(2, 11); /* rdx = &byte */
        移即扩(8, 1); /* r8 = 1 byte (mov_r_imm can't address high regs!) */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &written */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = NULL */
        调导入(1);     /* WriteFile */
        加栈即(48);
        移64(4, 15);
