        词位++; /* 编译期断言 */
        若 (词型表[词位] == 左括) 词位++; /* ( */
        整 字值 = 0;
        整 成功 = 常量表达式求值(&字值); /* 从当前 token 编译期常量求值 (消费表达式) */
        若 (词型表[词位] == 右括) 词位++; /* ) */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        若 (!成功) { 输出到文件(错误流, "[ERR] 编译期断言: 表达式不是编译期常量 (v3.0 #176)\n"); 退出(1); }
        若 (字值 == 0) { 输出到文件(错误流, "[ERR] 编译期断言失败: 表达式非真 (v3.0 #176)\n"); 退出(1); }
        返 建节(5); /* 断言通过: 无运行时代码 */
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "恐慌")) { /* 接入 2026-08-28 P1 #88: 恐慌机制 (panic) — 恐慌 "消息"; → { if (钩子) 钩子(); printf("消息\n"); exit(1); } 致命错误路径, 确定性终止 */ /* 2026-08-28 P2 #162: 恐慌钩子 (panic hook) — 恐慌钩子 fn; 注册, 恐慌时先调钩子再终止 */
        词位++; /* 恐慌 */
        字 消息[200]; 复制字符串(消息, "恐慌\n"); /* 默认消息 */
        若 (词型表[词位] == 串词) { 字 *前巳 = 串表[词值表[词位]]; 若 (前巳) 格式化限长(消息, 200, "%s\n", 前巳); 词位++; } /* 自定义消息 */
        若 (词型表[词位] == 分号) 词位++;
        整 块 = 建节(5);
        若 (旁丁[0]) { /* #162: 恐慌钩子 — 先调钩子 (确定性: 钩子=资源收尾) */
            整 尾庚 = 建节(4); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 旁丁, 64); 接子(尾庚, 函); }
            接子(块, 尾庚);
        }
        若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
        若 (!串表[串数]) 串表[串数] = 短六();
        复制字符串(串表[串数], 消息);
        整 呼参 = 建节(4); { 整 符号数 = 建节(0); 节值表[符号数] = 串数; 节型表[符号数] = 串词; 接子(呼参, 符号数); } { 整 缓进 = 建节(1); 复制内存((字*)(节名表 + 缓进), "printf", 7); 接子(呼参, 缓进); } /* printf("消息\n") — 参数先挂, callee 最后 */
        串数++;
        接子(块, 呼参);
        整 呼隐 = 建节(4); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(呼隐, 壹节); } { 整 下集 = 建节(1); 复制内存((字*)(节名表 + 下集), "exit", 5); 接子(呼隐, 下集); } /* exit(1) */
        接子(块, 呼隐);
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "恐慌钩子")) { /* 接入 2026-08-28 P2 #162 恐慌捕获/处理钩子: 恐慌钩子 fn; → 注册钩子, 恐慌时先调用 */
        词位++; /* 恐慌钩子 */
        字 左系一[64]; 复制字符串(左系一, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        复制字符串(旁丁, 左系一);
        返 建节(5);
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "声明")) { /* 接入 2026-08-28 declare 声明先行 (AI启动单/MoonBit#1): 声明 名字(参数) 返回 类型; → 注册签名, 实现后补(stub), 缺失=警告非错误 */
        词位++; /* 声明 */
        字 初联[64]; 复制字符串(初联, 词名表[词位]); 词位++; /* 函数名 */
        若 (声明数 < 256) 复制字符串(串升一[声明数++], 初联); /* 声明表注册 (独立于 func_tbl, gen_code 重置 func_n) */
        整 段组 = 0; /* 跳过 (参数) 返回 类型 到 ; */
        循环 (词位 < 词容量 && 词型表[词位] != 词终 && 词型表[词位] != 分号) {
            若 (词型表[词位] == 左括) 段组++;
            否 若 (词型表[词位] == 右括) { 段组--; 若 (段组 <= 0) { 词位++; 续; } }
            词位++;
        }
        若 (词型表[词位] == 分号) 词位++; /* ; */
        返 建节(5);
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "守卫")) { /* 接入 2026-08-28 机制层 #8 RAII 完整(析构): 守卫 x, 析构名; → 登记(变量,析构,块深度), 块退出自动调用 析构名(x) (作用域退出自动释放, Rust 式 drop) */
        词位++; /* 守卫 */
        字 段伴[64]; 复制字符串(段伴, 词名表[词位]); 词位++; /* 变量名 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        字 源四[64]; 复制字符串(源四, 词名表[词位]); 词位++; /* 析构函数名 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        若 (逆汇 < 64) { 复制字符串(宽辰[逆汇], 段伴); 复制字符串(终双[逆汇], 源四); 帧附[逆汇] = 计贰; 串寅[逆汇] = !尾系(段伴); 逆汇++; } /* 2026-08-28 P1 #15 Drop 标记: 守卫时变量未初始化 → 跳过析构 (块退出只析构已初始化守卫) */
        返 建节(5);
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "忘记")) { /* 接入 2026-08-28 P2 #20 泄漏逃生口 (mem::forget): 忘记 x; → 变量标记 moved 但守卫析构不执行 (有意泄漏, 所有权转交给运行时/调用者) */
        词位++; /* 忘记 */
        字 计十[64]; 复制字符串(计十, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        若 (后子(计十)) { 格式化到串(错缓冲, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能忘记 (v3.0 #20)", 计十); 发错误("A3102", 错缓冲); }
        若 (当繁(计十) >= 0) { 格式化到串(错缓冲, "借用检查: 变量 '%s' 被借用, 不能忘记 (借用期所有权不可转移, v3.0 #20)", 计十); 发错误("A3004", 错缓冲); }
        遍 (整 庚序 = 0; 庚序 < 逆汇; 庚序++) 若 (宽辰[庚序][0] != 0 && !比较字符串(宽辰[庚序], 计十)) { 宽辰[庚序][0] = 0; 串寅[庚序] = 0; } /* 注销守卫: 不析构 (泄漏) */
        若 (正次 < 256) 复制字符串(域六[正次++], 计十); /* 标记 moved: 生命周期移交, 后续读取 A3101 */
        返 建节(5);
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "丢弃")) { /* 接入 2026-08-28 P1 #25 显式丢弃: 丢弃 x; → 主动消费值结束生命周期 (Rust drop(x)) — 守卫析构立即执行+守卫注销 (块退出不二次析构), 变量标记 moved (后续读取 A3101); 借用中/已移动 = [ERR] (所有权不可在借用期转移) */
        词位++; /* 丢弃 */
        字 计十[64]; 复制字符串(计十, 词名表[词位]); 词位++; /* 变量名 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        若 (后子(计十)) { 格式化到串(错缓冲, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能丢弃 (v3.0 #25)", 计十); 发错误("A3102", 错缓冲); } /* 已移动不能再消费 (同移入 #10) */
        若 (当繁(计十) >= 0) { 格式化到串(错缓冲, "借用检查: 变量 '%s' 被借用, 不能丢弃 (借用期所有权不可转移, v3.0 #25)", 计十); 发错误("A3004", 错缓冲); } /* 借用期间不能消费 (同移入) */
        整 深乙一 = 建节(5);
        遍 (整 庚序 = 0; 庚序 < 逆汇; 庚序++) 若 (宽辰[庚序][0] != 0 && !比较字符串(宽辰[庚序], 计十) && 串寅[庚序]) { /* 守卫已登记且已初始化 → 立即析构 (主动消费=资源现在释放) */
            整 呼 = 建节(4); { 整 参 = 建节(1); 复制内存((字*)(节名表 + 参), 计十, 64); 接子(呼, 参); } { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 终双[庚序], 64); 接子(呼, 函); }
            接子(深乙一, 呼);
            宽辰[庚序][0] = 0; /* 注销守卫 → 块退出压缩时跳过, 不二次析构 */
        }
        若 (正次 < 256) 复制字符串(域六[正次++], 计十); /* 标记 moved: 生命周期结束, 后续读取 A3101 */
        返 深乙一;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "移入")) { /* 接入 2026-08-28 机制层 #1/#5/#13: 所有权 move — 移入 dst, src; → { dst = src; src 标记已移动 }; #13 覆写: 移入 dst, src 覆写 钩子名; → { 钩子名(&dst, &src); src 标记已移动 } (可覆写移动, 替代按位) */
        词位++; /* 移入 */
        首己 = 1; /* #5: dst 是写目标, 跳过 moved 读检查 (dst 可为已移动变量重新赋值) */
        整 反聚 = 表达式(); /* 目标 (左值: 变量/数组元素/成员) */
        首己 = 0;
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 池列 = 表达式(); /* 源 (变量/数组元素/成员) — 已 moved 时 L5014 读检查 [ERR] */
        整 净丙一 = 0; 字 尾厚[64] = "";
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "覆写")) { 词位++; 复制字符串(尾厚, 词名表[词位]); 词位++; 净丙一 = 1; } /* #13: 可覆写移动钩子 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        若 (池列 >= 0 && 节型表[池列] == 1) { /* moved 登记: 源是简单变量时跟踪 */
            字 *源计数 = (字*)(节名表 + 池列);
            若 (当繁(源计数) >= 0) { 格式化到串(错缓冲, "借用检查: 变量 '%s' 被借用, 不能移动 (借用期所有权不可转移, v3.0 #10)", 源计数); 发错误("A3004", 错缓冲); } /* 接入 2026-08-28 机制层 #10: 借用期间不能 move (只读借用在此拦, 可变借用 L5014 已拦) */
            整 宏序; 遍 (宏序 = 0; 宏序 < 正次; 宏序++) 若 (!比较字符串(域六[宏序], 源计数)) 断;
            若 (宏序 < 正次) { 格式化到串(错缓冲, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能再次移动", 源计数); 发错误("A3102", 错缓冲); }
            若 (正次 < 256) 复制字符串(域六[正次++], 源计数);
        } 否 若 (池列 >= 0 && 节型表[池列] == 15) { /* 2026-08-28 P1 #17 部分移动: 源是字段 (s.x) — 登记字段路径 moved, 其余字段仍可用 */
            字 *串升 = (字*)(节名表 + 池列);
            整 基 = 子0[池列];
            若 (基 >= 0 && 节型表[基] == 1) {
                字 路径[64]; 格式化到串(路径, "%s.%s", (字*)(节名表 + 基), 串升);
                若 (正次 < 256) 复制字符串(域六[正次++], 路径);
            }
        }
        串弊(反聚); /* 借用自动化 (2026-08-28 完善): 移入 dst = 写目标 → 只读借用自动放还, 可变借用 [ERR] (原此路径无 dst 借用检查) */
        { 整 当序 = 反聚; 整 度己 = 0; 循环 (当序 >= 0 && 度己 < 8 && (节型表[当序] == 14 || (节型表[当序] == 15 && 节值表[当序] == 0))) { 当序 = 子0[当序]; 度己++; } 若 (当序 >= 0 && 节型表[当序] == 1) { 未初始化移除((字*)(节名表 + 当序)); 邻未((字*)(节名表 + 当序)); } } /* #78 完善 (2026-08-28 fix #78回归): 移入 dst = 初始化/重新绑定 → 解除 dst 的未初始化/已移动状态 (与 asgn 赋值同记账) */
        整 块 = 建节(5);
        若 (净丙一) { /* #13: 覆写移动 → 调用钩子 钩子名(&dst, &src) (Nd(11)=取地址, callee 最后 Nc) */
            整 呼 = 建节(4);
            { 整 毛戊 = 建节(11); 接子(毛戊, 反聚); 接子(呼, 毛戊); }
            { 整 缺组 = 建节(11); 接子(缺组, 池列); 接子(呼, 缺组); }
            { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 尾厚, 64); 接子(呼, 函); }
            接子(块, 呼);
        } 否 {
            { 整 赋节 = 建节(10); 接子(赋节, 反聚); 接子(赋节, 池列); 接子(块, 赋节); } /* dst = src; */
        }
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "互斥锁")) { /* 接入 2026-08-28 机制层: 互斥锁声明 (内建自旋锁状态): 互斥锁 m; → { int __mtx_m = 0; } — 0=未锁, 1=锁定; 锁住 m {..} 用真原子 CAS 自旋 */
        词位++; /* 互斥锁 */
        字 邻壬[64]; 复制字符串(邻壬, 词名表[词位]); 词位++; /* 锁名 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        字 宏名[80]; 格式化到串(宏名, "__mtx_%s", 邻壬);
        变量偏移(宏名);
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 宏名, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(块, 元); } /* int __mtx_m = 0; */
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "信号量")) { /* 接入 2026-08-28 P1 #56: 信号量声明 — 信号量 sem, n; → { int __sem_sem = n; } 计数信号量 (n=初始许可数); 获取/放行 用真原子 CAS/xadd */
        词位++; /* 信号量 */
        字 符号数[64]; 复制字符串(符号数, 词名表[词位]); 词位++; /* 名 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 实散 = 0; 若 (词型表[词位] == 常数) { 实散 = 词值表[词位]; 词位++; }
        若 (词型表[词位] == 分号) 词位++; /* ; */
        字 构名[80]; 格式化到串(构名, "__sem_%s", 符号数);
        变量偏移(构名);
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 构名, 32); 整 零 = 建节(0); 节值表[零] = 实散; 接子(元, 零); 接子(块, 元); } /* int __sem_sem = n; */
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "获取")) { /* 接入 2026-08-28 P1 #56: 信号量 P 操作 — 获取 sem; → __qcc_sem_wait(&__sem_sem) 忙等到许可 */
        词位++; /* 获取 */
        字 符号数[64]; 复制字符串(符号数, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        字 构名[80]; 格式化到串(构名, "__sem_%s", 符号数);
        整 呼 = 建节(4);
        { 整 值二 = 建节(1); 复制内存((字*)(节名表 + 值二), 构名, 32); 整 地址 = 建节(11); 接子(地址, 值二); 接子(呼, 地址); }
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "__qcc_sem_wait", 15); 接子(呼, 函); }
        返 呼;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "放行")) { /* 接入 2026-08-28 P1 #56: 信号量 V 操作 — 放行 sem; → __qcc_sem_post(&__sem_sem) 原子加许可 */
        词位++; /* 放行 */
        字 符号数[64]; 复制字符串(符号数, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        字 构名[80]; 格式化到串(构名, "__sem_%s", 符号数);
        整 呼 = 建节(4);
        { 整 值二 = 建节(1); 复制内存((字*)(节名表 + 值二), 构名, 32); 整 地址 = 建节(11); 接子(地址, 值二); 接子(呼, 地址); }
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "__qcc_sem_post", 15); 接子(呼, 函); }
        返 呼;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "读写锁")) { /* 接入 2026-08-28 P1 #51: 读写锁声明 — 读写锁 rw; → { int __rwl_rw = 0; } state: >0 读者数 / 0 空闲 / -1 写者 */
        词位++; /* 读写锁 */
        字 邻轮[64]; 复制字符串(邻轮, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        字 链排[80]; 格式化到串(链排, "__rwl_%s", 邻轮);
        变量偏移(链排);
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 链排, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(块, 元); }
