    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "切片前缀")) { /* 接入 2026-08-29 P2 #143 切片模式-前缀: 切片前缀 dst, src, n, k; → { __sp=0; __sp_k=k; __sp_n=n; while(__sp<__sp_k && __sp<__sp_n){ dst[__sp]=src[__sp]; __sp++; } } — 取 src[0..k) 到 dst (k>n 自动截断) */
