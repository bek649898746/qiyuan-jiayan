                    }
                    函数宏表[函数宏数].体[乙序++] = 串值[指++];
                }
                函数宏表[函数宏数].体[乙序] = 0;
                函数宏数++;
            }
        }
    }
    }
}

静 整 反八[64]; 静 整 栈凶一; /* fix 2026-08-13: 展开栈 — 防宏互递归 A→B→A (self_fmi 只防直接自递归: 展开 A 时 body 调 B → B 展开时 A 又可入 → 无限; Git hashmap_for_each_entry 嵌套链 + revision.c) */
静 整 缺亥一[2048]; 静 整 余厚; /* fix 2026-08-26 sqlite: fn 宏位置语义 — 只有 #define 之后的调用才展开 (sqlite3Utf8Read 原型在 #define 之前被误展开成 (*((*A)++)) → 声明变表达式 → params 循环死锁) */

/* expand fn-macro calls inside seg (recursive for nested macros) into *out at *o (grows).
