    移寄存器(2, 9); /* edx = len */
    算寄存器(旧肆, 0, 2); /* eax = W - len */
    移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 单回一, 8); /* cmp eax,0; jle lscopy */
    移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* save pad -> sc+236 */
    /* 左对齐 (sc+252): 先拷贝后 pad */
    移寄存器帧(0, 临时基 - 当前帧大小 + 252); 测寄存器(0, 0); 非零跳(-1); 补标号(码位-4, 单回一, 1);
    /* 右对齐: pad 空格先行 */
    移寄存器帧(2, 临时基 - 当前帧大小 + 236); /* edx = pad */
    移即(0, ' ');
    设标号(域丑);
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    自减 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xCA); /* dec edx */
    非零跳(-1); 补标号(码位-4, 域丑, 3);
