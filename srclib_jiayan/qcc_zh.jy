                } 否 若 (序粗 || 下环) {
                    字 表达式[512]; 整 戊序 = 0; 整 寻 = 元 + (序粗 ? 2 : 4);
                    循环 (串值[寻] == ' ' || 串值[寻] == '\t') 寻++;
                    循环 (串值[寻] && 戊序 < 510) { 若 (串值[寻] == '\\' && (串值[寻 + 1] == '\n' || (串值[寻 + 1] == '\r' && 串值[寻 + 2] == '\n'))) { 寻 += (串值[寻 + 1] == '\r' ? 3 : 2); 表达式[戊序++] = ' '; 续; } 若 (串值[寻] == '\n') 断; 表达式[戊序++] = 串值[寻++]; } /* fix 2026-08-26 redis: #if 表达式反斜杠续行 (同 lexer/obj_expand) */
                    循环 (戊序 > 0 && (表达式[戊序-1] == ' ' || 表达式[戊序-1] == '\t')) 戊序--;
                    表达式[戊序] = 0;
                    条件 = 预处求值(表达式);
                }
                若 (序粗 || 是否条件编译 || 外二) {
                    若 (条件编译数 < 1024) { 缺三[条件编译数] = 父节; 序对[条件编译数] = 条件 && !父节; 外系 = 父节 || !条件; 条件编译数++; } 否 原得("行条件栈 cl_if", 1024);
                } 否 若 (下环) {
                    若 (条件编译数 > 0) { 若 (!序对[条件编译数-1] && !缺三[条件编译数-1]) { 序对[条件编译数-1] = 条件; 外系 = 缺三[条件编译数-1] || !条件; } 否 外系 = 1; }
                } 否 若 (短再) {
