静 整 实重[节容量]; /* 2026-08-28 type-root-2: per-node error-union call result (must be checked) */
静 整 错误函数 = 0; 静 字 旁午[256][64]; 静 整 外优 = 0; 静 整 满从 = -1; 静 整 右陆 = 0; 静 整 当申 = 0; /* 2026-08-28 type-root-2: try-branch expr() exempt from asgn A9001 */ /* 2026-08-28 type-root-2: error-union table + pending */
静 整 节长标[节容量]; /* per-node flag: expression is a 64-bit long long (fix 2026-08-05) */
静 整 节长高[节容量]; /* per-node high 32 bits of a long-long literal (fix 2026-08-05) */
静 字 首甲二[节容量]; /* fix 2026-08-30 csmith s168: signed 64 cast ((int64_t)x / (long)x) 标记 — 值转换保留源 nuns (零扩展 b_cast), 类型 signed (除法/比较 signed); 不用 nll_hi (污染 LL 字面量语义 → 未初始化读取崩溃) */
静 字 号汇一[节容量]; /* fix 2026-08-31 csmith s11: unsigned 64 cast ((uint64_t)x / (unsigned long long)x) 标记 — 目标 unsigned (比较/除法无符号) 但不设源 nuns (源有符号须符号扩展: (uint64_t)(int32)0x9D9DC934 → 0xFFFFFFFF9D9DC934) */
静 字 暂合[节容量]; /* fix 2026-08-30 探雷雷2: 显式 cast 标记 — (T*)x 是 no-op cast 直接返回操作数 (不建节点), 标记操作数节点供 type_mismatch_check 豁免 (int *p=(const char*)0xdeadbeef 合法, int *p=12345 非法) */
