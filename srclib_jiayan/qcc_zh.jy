            若 (词型表[词位] == 词变量) { /* 阶段C-1 #80 异常ABI (2026-09-02): 捕获 名 { 体 } — 捕获体前 名 = ex_val (异常携带值提取) */
                复制字符串(试捕名, 词名表[词位]); 词位++;
            }
            若 (词型表[词位] == 左花) 词位++; /* { */
            若 (试捕名[0]) { /* 名 = ex_val; */
                { 整 试值名 = 建节(1); 复制内存((字*)(节名表 + 试值名), 试捕名, 32);
                  整 试值取 = 建节(1); 复制内存((字*)(节名表 + 试值取), "ex_val", 7);
                  整 试值赋 = 建节(10); 接子(试值赋, 试值名); 接子(试值赋, 试值取); 接子(试块节, 试值赋); }
            }
            循环 (词型表[词位] != 右花 && 词型表[词位] != 词终) { 若 (词型表[词位] == 分号) { 词位++; 续; } 接子(试块节, 语句()); }
            若 (词型表[词位] == 右花) 词位++; /* } */
            { 整 试值子 = 建节(1); 复制内存((字*)(节名表 + 试值子), "ex_pending", 11);
              整 试零 = 建节(0); 节值表[试零] = 0;
              整 试赋节 = 建节(10); 接子(试赋节, 试值子); 接子(试赋节, 试零); 接子(试块节, 试赋节); }
        }
