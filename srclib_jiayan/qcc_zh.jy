    "mutex_lock","mutex_unlock", /* 修复 2026-08-30: 锁住 m { } 脱糖的互斥锁运行时函数 (甲言内建自旋锁特性, batch6 #70) */"inb","inl","outb","outl","__asm","__asm_byte",
