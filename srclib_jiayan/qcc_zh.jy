    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "重试")) { /* 接入 2026-08-29 P2 #85 错误恢复/重试: 重试 f(), n; → { __rt_n=n; __rt_i=0; while(__rt_i<__rt_n){ __rt_r=f(); if(__rt_r==0){__rt_i=__rt_n;} else {__rt_i++;} } } — 调用返回 0=成功, 失败重试至多 n 次 */
