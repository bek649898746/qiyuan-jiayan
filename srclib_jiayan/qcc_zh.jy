                            若 (满转 > 0) 原复 = 8; /* pointer-typed array (char *names[3]): 8-byte elements */
                            隔排(毛寅, 指元素, 原复, 全局数);
                            变量表[变量数 - 1].指元素尺寸 = 原复; /* element byte size for outer [j] scale / 64-bit load */
                            若 (满转 > 0) 变量表[变量数 - 1].指内 = 指元素; /* fix step26: 全局指针数组指向元素大小 (char *arr[] → 1, int * → 4, char** → 8) — t35j 只修了局部 var_array, 全局缺失 → GN[i][j] 嵌套外层按 fallback 4 缩放读错 (const char *GN[] = {"aa",..}; GN[0][0] 垃圾) */
                            若 (虚细) 变量表[变量数 - 1].是否长标 = 1; /* fix 2026-08-06: 全局 ll 数组标记 → 元素读写 64 位 + int RHS 符号扩展 */
                            若 (隔列 > 0 && 全局数 > 隔列) 变量表[变量数 - 1].数组元素尺寸 = 全局数 / 隔列 * 原复; /* 2D+: ROW byte size — fix 2026-08-30 csmith t5: 去掉 ptrd<=0 排除 (int32_t *g_84[2][8][10] 全局指针数组原无行宽 → g_84[i] 缩放 8 应 640 → 越界读垃圾指针 → s2 崩溃) */
                            若 (正双 >= 1) { 变量表[变量数 - 1].域行数[正双 - 1] = 原复; 遍 (整 己序 = 正双 - 2; 己序 >= 0; 己序--) 变量表[变量数 - 1].域行数[己序] = 变量表[变量数 - 1].域行数[己序 + 1] * 半降[己序 + 1]; } /* 3D per-dim rows (fix 2026-08-05) */
                            若 (双回) 变量表[变量数 - 1].是否浮标 = 1; /* global double array */
                            若 (列利) 变量表[变量数 - 1].深成 = 1; /* fix 2026-08-29 csmith: 全局 signed char 数组元素 is_csgn — 不设 is_char (普通 char 数组不被 var_is_char 误判) */
                            若 (逆辰) 变量表[变量数 - 1].无符号标 = 1; /* fix 2026-08-29 csmith: 全局 uint 数组元素 is_uns → 传参零扩展 (s175 g_2[i][j]) */
