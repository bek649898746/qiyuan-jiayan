                            前八 = (变量表[变序].指元素尺寸 > 0 && 变量表[变序].数组元素尺寸 > 变量表[变序].指元素尺寸); /* 2D+ array: a[i] is a ROW (array), decays to ADDRESS (fix 2026-08-16: secnames[i] 源被当 8 字节值 load → memcpy 源 0) */
                            { 整 内重 = 变量表[变序].指内 ? 变量表[变序].指内 : (变量表[变序].是否字符标 ? 1 : (变量表[变序].是否长标 ? 8 : (变量表[变序].是否浮标 ? 8 : 4))); 长卯 = (变量表[变序].数组元素尺寸 == 8 && !变量表[变序].是否长标 && !变量表[变序].是否浮标 && 变量表[变序].型序标 < 0) ? 内重 : (变量表[变序].指元素尺寸 ? 变量表[变序].指元素尺寸 : (变量表[变序].数组元素尺寸 <= 8 ? 变量表[变序].数组元素尺寸 : 8)); 虚叁 = 变量表[变序].深成 ? 1 : (变量表[变序].是否短标 && !变量表[变序].无符号标 ? 2 : 0); 右亥 = 变量表[变序].无符号标; } /* ELEMENT byte size for outer [j] scale; fix 2026-08-18: 静态指针数组 (int *nx[8]) 外维 [j] 按指向元素缩放; fix 2026-08-23 t35j: p_inner 优先; fix 2026-08-29: cg_mem_sgn/cg_mem_uns 元素 signed/unsigned 标记 */
                            /* ADDRESS for: struct arrays, 2D rows (esz>8), and 2D rows where
                               arr_esz > element size (char buf[4][8]: esz=8, elem=1).
                               8-byte POINTER arrays (char *names[3]: esz=8, elem=8) load 64-bit. */
                            若 (元素尺寸 > 4 && (变量表[变序].型序标 >= 0 || 元素尺寸 > 8 || 变量表[变序].数组元素尺寸 > 变量表[变序].指元素尺寸 || 变量表[变序].指元素尺寸 == 0)) 正玖 = 1;
                            若 (码生成免解引用 && 变量表[变序].数组元素尺寸 == 8 && !变量表[变序].是否长标 && !变量表[变序].是否浮标 && 变量表[变序].型序标 < 0 && !前八 && 变量表[变序].域行数[1] == 0) 码生成内存指 = 1; /* 静态指针数组元素 (int *nx[8]): 嵌套 base 返回槽地址, 外层 [j] 先加载指针 (fix 2026-08-18: 原缺 → 第二维索引进指针数组槽本身, 自举 CG-BAD; fix step26: !is_row — int M2D[2][2] 的 arr_esz=8 是行大小非指针数组, 原误判 → 外层 mov (%rax),%rax 读行内容当指针 → 2D 数组写地址=4 崩; fix 2026-08-30 csmith t5: +frows[1]==0 排除 2D 内维=1 指针数组 (g_135[2][1] arr_esz==p_esz==8 → is_row 失效 → 误解引用写穿 NULL, s2)) */
                            码生成内存浮 = (变量是否浮(变名) || 变量指浮(变名)) ? 1 : 0; /* static double array base → outer [i] movsd */
                            中系 = 1; 遍 (整 栈庚 = 0; 栈庚 < 4; 栈庚++) 上薄[栈庚] = 变量表[变序].域行数[栈庚]; /* per-dim rows: static arrays too (fix 2026-08-05: leftover fdepth/frows polluted nested field-array scale) */
                            标拾 = 1; 遍 (整 栈庚 = 0; 栈庚 < 4; 栈庚++) 若 (变量表[变序].域行数[栈庚] > 0) 标拾 = 栈庚 + 1; /* dim count */
                            断;
                        }
                    移寄存器(11, 0); /* r11d = index */
                    若 (元素尺寸 == 2) { 汇发("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(1); }
                    否 若 (元素尺寸 == 4) { 汇发("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(2); }
                    否 若 (元素尺寸 == 1) { } /* 1 字节行宽不缩放 */
                    否 { 移即(0, 元素尺寸); 移寄存器(9, 0); 汇发("    乘 r11, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 1, 0, 1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 3, 1); } /* IMUL r11d, r9d — fix 2026-08-29 csmith: esz=3 (int8 2D 行宽) 原不匹配 2/4/>4 不缩放 → g[1] 偏移 1 应 3 (2D int8 数组寻址错, s137/ginit2d) */
                    度一(静态位移(偏移, 1) - 1); /* rax = &static[0] (lea is 7 bytes: stc_disp assumes 6) */
                    符号扩展r11(); /* 32 位索引符号扩展 (fix 2026-08-19: 负索引零扩展 → ptr+4GB → SEGV) */
                汇发("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 1, 0, 0); 发字节(0x01); 模字节(3, 3, 0); /* ADD rax, r11 */
                    若 (!码生成免解引用) {
                        若 (变量是否浮(变名)) { 汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); } /* double array elem → xmm0 (NOT fnptr arrays) */
                        否 若 (前八) { /* 2D+ row: leave ADDRESS (C decay) — don't deref the row bytes (fix 2026-08-16) */ }
                        否 若 (正玖) { /* address mode for member access */
                            若 (元素尺寸 <= 8) { 若 (元素尺寸 == 8) { 移寄存器内存64(0, 0); } 否 { 移寄存器内存(0, 0); } } /* fix 2026-08-06: ≤8 字节 struct 元素作值 → 解引用 (原留地址 → x = arr[1] 存地址 4207368) */
                        } 否 若 (元素尺寸 == 1) { 若 (虚叁 == 1) { 汇发("    符号扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBE); 模字节(0, 0, 0); } 否 { 汇发("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 0); } 若 (右亥) 节无符号[数] = 1; } /* fix 2026-08-29 csmith: int8_t 静态数组元素符号扩展 (cg_mem_sgn); fix 2026-08-30 csmith t5: +nuns 传播 (uint8 数组元素传 uint64 参数零扩展) */
                        否 若 (元素尺寸 == 8) { 移寄存器内存64(0, 0); 节长标[数] = 1; 若 (右亥) 节无符号[数] = 1; } /* char* / pointer element: 64-bit — fix 2026-08-30 csmith t5: 补 nll (1D 静态数组 64 位元素原不设 → 传 uint64 参数被 ll_ext32 movsxd 截断, s25/s31/s32) */
                        否 若 (元素尺寸 == 2) { 若 (虚叁 == 2) { 汇发("    符号扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBF); 模字节(0, 0, 0); } 否 { 汇发("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB7); 模字节(0, 0, 0); } 若 (右亥) 节无符号[数] = 1; } /* fix 2026-08-29 csmith: int16_t 静态数组元素符号扩展; fix 2026-08-30: +nuns */
                        否 { 移寄存器内存(0, 0); 若 (右亥) 节无符号[数] = 1; } /* fix 2026-08-30 csmith t5: 1D 静态数组 uint 元素 nuns (s17/s22/s28/s35 传 uint64 参数被 movsxd 符号扩展) */
                    }
                    堆己 = 1;
                }
            } 否 {
                /* pointer param arr[i] OR generic base (address-of / cast expr):
                   index in r11 (r9 may be the param reg).
                   fix 2026-08-09: (&buf[0])[2] crashed — a node-11 base fell into
                   load_param_val("") → garbage ptr. Generic base: cg the base to get
                   its address, element size from pesz (cast) or cg_mem_frow (set by
                   the address-of child's case-14 cg). */
                整 存粗 = (节型表[子0[数]] == 11 || 变名[0] == 0);
                整 满寅 = 4;
                若 (存粗) {
                    /* element size from the address-of child (fix 2026-08-09:
                       cg_mem_frow is p_esz-based → 4 for char arrays; var_esz is right) */
                    若 (节型表[子0[数]] == 11) {
                        整 原回 = 子0[子0[数]];
                        若 (节型表[原回] == 14) 满寅 = 变量元素((字*)(节名表 + 子0[原回])); /* &arr[i]: element = array's arr_esz */
                        否 若 (节型表[原回] == 1) 满寅 = 变量元素((字*)(节名表 + 原回)); /* &var */
                        否 满寅 = 长卯 ? 长卯 : 4;
                        整 源九 = 码生成免解引用; 码生成(子0[数]); 码生成免解引用 = 源九; /* case 11 clobbers the flag; restore (fix 2026-08-09: store path wrote to the VALUE not the address) */
                        压栈寄存器(0);
                    } 否 {
                        /* 先 cg 基址 (case-12 解引用设 cg_mem_frow=元素宽度), 再取 peszp (fix 2026-08-20:
                           原先读陈旧 cg_mem_frow → (*argv)[1] 缩放 4 + 4字节加载 → 取到 0 → strchr(NULL) git -c 崩) */
                        整 源九 = 码生成免解引用; 码生成(子0[数]); 码生成免解引用 = 源九;
                        满寅 = 长卯 ? 长卯 : 4;
                        压栈寄存器(0);
                    }
                }
                否 满寅 = 变量元素(变名);
                { 整 值回 = 码生成免解引用; 码生成免解引用 = 0; 码生成(子1[数]); 码生成免解引用 = 值回; } /* index → eax */
                移寄存器(11, 0); /* r11d = index */
                若 (满寅 == 4) { 汇发("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(2); }
                否 若 (满寅 == 2) { 汇发("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(1); }
                否 若 (满寅 > 4) { 移即(0, 满寅); 移寄存器(9, 0); 汇发("    乘 r11, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 1, 0, 1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 3, 1); } /* IMUL r11d, r9d */
                若 (存粗) { 弹栈寄存器(0); } /* rax = base address (saved) */
                否 取参值(变名); /* eax = ptr (reg or [rbp+disp]) */
                符号扩展r11(); /* 32 位索引符号扩展 (fix 2026-08-19: 负索引零扩展 → ptr+4GB → SEGV) */
                汇发("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 1, 0, 0); 发字节(0x01); 模字节(3, 3, 0); /* ADD rax, r11 */
                若 (!码生成免解引用) {
                    若 (变量指浮(变名)) { 汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); } /* double* param elem → xmm0 */
                    否 若 (满寅 == 1) { 汇发("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 0); } /* movzx eax,byte[rax] */
                    否 若 (满寅 > 4) { 移寄存器内存64(0, 0); }         /* mov rax,[rax] (char** ?ptr / struct*) */
                    否 若 (满寅 == 2) { 汇发("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB7); 模字节(0, 0, 0); } /* movzx eax, word [rax] fix 2026-08-08 */
                    否 { 移寄存器内存(0, 0); } /* mov eax, [rax] */
                }
            }
        } 断;
    }
}
/* str */
/* string data */
静 无 字 *全伴; 静 整 反高, 下退;

静 整 目甲[1024]; /* byte offset of each double literal in sdat; -1 = not placed */
静 整 标劣(整 序标) {
    若 (目甲[序标] >= 0) 返 目甲[序标];
    循环 (反高 % 8 != 0) { 若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); } 全伴[反高++] = 0; }
    目甲[序标] = 反高;
    整 链劣 = 逆组[序标], 度附 = 现退[序标];
    遍 (整 键 = 0; 键 < 4; 键++) { 若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); } 全伴[反高++] = (无 字)((链劣 >> (8 * 键)) & 0xff); }
    遍 (整 键 = 0; 键 < 4; 键++) { 若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); } 全伴[反高++] = (无 字)((度附 >> (8 * 键)) & 0xff); }
    返 目甲[序标];
}

静 整 外陆一(整 序标) {
    若 (邻拾[序标] >= 0) 返 邻拾[序标];
    邻拾[序标] = 反高;
    常 字 *串值 = 串表[序标];
    循环 (*串值) { 若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); } 全伴[反高++] = (无 字)*串值++; }
    若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); }
    全伴[反高++] = 0; /* NUL terminator */
    返 邻拾[序标];
}
静 空 写四(FILE *文件, 整 值) { 写字符(值 & 0xff, 文件); 写字符((值 >> 8) & 0xff, 文件); 写字符((值 >> 16) & 0xff, 文件); 写字符((值 >> 24) & 0xff, 文件); }
静 空 串丙(FILE *文件, 整 值) { 写四(文件, 值); 写四(文件, 0); } /* 64-bit write: high word ALWAYS 0. The self-host has no real long long; `v >> 32` on a 32-bit value masks the shift count to 0 and re-writes v, so all w8 callers pass <4GB values. */
静 空 下布(FILE *文件, 整 值) { 写字符(值 & 0xff, 文件); 写字符((值 >> 8) & 0xff, 文件); }
静 空 容吉(FILE *文件, 整 数) { 循环 (数-- > 0) 写字符(0, 文件); }

/* fix 2026-08-12: 分块写零替代逐字节 fputc — 自宿主的 fputc builtin 每字节一次 WriteFile
   syscall, 52MB .data 填充 85s; fwrite 整块写 → 4KB 块 ≈ 20ms (快 ~4000 倍). */
静 空 净系(FILE *文件, 整 数) {
    字 旁布[4096]; 内存设置(旁布, 0, 大小(旁布));
    循环 (数 > 0) { 整 字符 = 数 > 4096 ? 4096 : 数; 写入(旁布, 1, 字符, 文件); 数 -= 字符; }
}

/* fix 2026-08-12 自举收敛 (根因): .data 覆盖范围必须 ≥ statics + bump 堆 + 自切栈.
   旧公式 max(cp*84, 0x800000) 只按输出代码量估算 — 自举时 cp*84≈83.7MB,
   但 statics ≈46MB + bump 堆 ≈42MB (tt/tv/tn/nn/tuns/tll/tll_hi 34MB + code 4MB + 源缓冲 ~1.5MB + sdat/misc ~3MB)
   ≈ 88MB > 83.7MB → stk_top 落进 tll_hi (v1: 0x52B15D8 = heap_start+33.6MB, tll_hi 在 +33.2..+35.2MB)
   → 栈帧向下写穿 token 数组 → 运行时 tll 垃圾 → 伪 nll=1 → 628 movabs → v1≠v2 2-cycle.
   新公式: statics 终点 (DATA_RVA_OFF + 4*stc_n + 2560) 之上加 0x4800000
   (堆上限 0x4000000=64MB + 栈余量 0x800000=8MB; 实测栈深 ≥2MB, 递归 parse/codegen 取 8MB),
   fix 2026-08-13: 44MB 不够 — 编译 revision.c (Git) 时 bump 堆实测 55.2MB (token 35MB
   + 源/宏展开缓冲 ~15MB + obj out 1.5MB), 越界 ~2MB 写穿栈帧 → obj_macro_expand 局部 s
   被覆盖 → 0xC0000005. 提到 64MB 留 ~9MB 余量,
   与 cp*84 取大者 — 小程序的 8MB 地板不变. */
静 整 上利(空) {
    整 终 = 码位 * 84 > 0x800000 ? 码位 * 84 : 0x800000;
    /* fix 2026-08-16 alias.c: bump heap needed 0x490626D (> 0x4800000) while
       expanding fn-macro args, so the counter walked past the image end and the
       very next byte store faulted (0xC0000005). Give the shared heap+stack
       region 128MiB instead of 72MiB. */
    /* fix 2026-08-16 根因E attr.c: fn-macro 展开实测把 bump 堆推到 165MiB+136MiB≈300MiB,
       超 128MiB 预算 → counter 越过 heap 终点+image 末尾 (0x11E98000) → malloc 指针越界写崩。
       预算 128→192MiB 留余量 (attr.c 需 ~136MiB)。image 相应增大 (v1 ~+64MB)。 */
    /* fix 2026-08-16 根因E attr.c: fn-macro 展开实测把 bump 堆推到 165MiB+136MiB≈300MiB,
       超 128MiB 预算 → counter 越过 heap 终点+image 末尾 (0x11E98000) → malloc 指针越界写崩。
       预算 128→192MiB 留余量 (attr.c 需 ~136MiB)。image 相应增大 (v1 ~+64MB)。 */
    /* fix 2026-08-17 block-sha1/sha1.c: 80 轮宏展开 (SHA_ROUND×80) 全量展开需 >192MiB
       (踩坑库: sha1.c 编译需 214MB 堆) → counter 走穿镜像尾 → out 指针越界写崩。
       预算 192→256MiB (0xC000000→0x10000000)。 */
    /* fix 2026-08-27 step7 (v1.2 §二B): str_tbl 分块动态化后 stc_n 不再含 384MB 静态
       str_tbl (4 亿槽), heap_top 从 ~658MB 跌到 ~257MB → 自举新编译器运行时 stk_top
       过低, 自切栈区与 bump 堆/code buffer 重叠 → 编 qcc 自身 SEGV (0x5f1937 跳栈区).
       预算 256→512MiB (0x10000000→0x20000000) 恢复 stk_top 高位, 与布局解耦. */
    整 总伴 = 名聚 + 4 * 静态数 + 2560 + 0x20000000;
    返 终 > 总伴 ? 终 : 总伴;
}

静 空 实三(FILE *文件, 整 内九) {
    整 隔简一 = 0x1000, 代码尺寸 = ((码位 + 4095) & ~4095);
    若 (代码尺寸 < 512) 代码尺寸 = 512;
    /* Fix 2026-08-03: the Windows loader rejects a PE whose .text end does not
       abut .data (ERROR_BAD_EXE_FORMAT 193). data_rva_base is sized from pass-1
       cp, which can round one page past the pass-2 final cp -> a 0x1000 hole.
       Make .text always end exactly where .data begins. */
    整 逆厚一 = 数据基址 - 隔简一;
    若 (代码尺寸 < 逆厚一) 代码尺寸 = 逆厚一;
    整 顺再 = 单亥;
    整 源组 = 数据基址; /* dynamic .data base (text may exceed 4KB) */
    整 缓粗 = (上利() + 0x100000 + 4095) & ~4095; /* fix 2026-08-12: 随 extent 动态 — 自举 stk_top≈97MB 超旧固定 96MB; +1MB 余量, 覆盖栈底之下 */
    若 (缓粗 < 0x6000000) 缓粗 = 0x6000000; /* 保持旧 96MB 地板 (fix 2026-08-11: str_tbl 2048 后 statics 46MB + bump 43MB ≈ 89MB > 80MB → 扩容到 96MB) */
    整 全癸 = 源组 + 缓粗 + 0x1000; /* SizeOfImage */

    /* DOS Header (64 bytes) */
    写字符('M', 文件); 写字符('Z', 文件); 容吉(文件, 58);
    写四(文件, 64); /* e_lfanew = 64 */

    /* PE Signature */
    写字符('P', 文件); 写字符('E', 文件); 写字符(0, 文件); 写字符(0, 文件);

    /* COFF Header (20 bytes) */
    下布(文件, 0x8664);  /* Machine: x86-64 */
    下布(文件, 2);       /* NumberOfSections �?.text + .data */
    写四(文件, 0);       /* TimeDateStamp */
    写四(文件, 0);       /* PointerToSymbolTable */
    写四(文件, 0);       /* NumberOfSymbols */
    下布(文件, 0xF0);    /* SizeOfOptionalHeader = 240 (PE32+ with 16 data dirs) */
    下布(文件, 0x22E);   /* Characteristics: EXE + large address aware */

    /* Optional Header PE32+ (112 bytes + 16*8 data dirs = 240) */
    下布(文件, 0x020B);  /* Magic: PE32+ */
    写字符(0, 文件); 写字符(0, 文件); /* LinkerVersion */
    写四(文件, 代码尺寸); /* SizeOfCode */
    写四(文件, 8);       /* SizeOfInitializedData �?heap counter */
    写四(文件, 0);       /* SizeOfUninitializedData */
    写四(文件, 内九); /* AddressOfEntryPoint */
    写四(文件, 隔简一);  /* BaseOfCode */
    串丙(文件, 号己); /* ImageBase �?low address for 32-bit pointers */
    写四(文件, 0x1000);  /* SectionAlignment */
    写四(文件, 单亥);   /* FileAlignment */
    下布(文件, 6); 下布(文件, 0); /* OSVersion */
    下布(文件, 0); 下布(文件, 0); /* ImageVersion */
    下布(文件, 6); 下布(文件, 0); /* SubsystemVersion */
    写四(文件, 0);       /* Win32VersionValue */
    写四(文件, 全癸); /* SizeOfImage */
    写四(文件, 单亥);   /* SizeOfHeaders */
    写四(文件, 0);       /* CheckSum */
    下布(文件, 3);       /* Subsystem: CONSOLE */
    下布(文件, 0x8100);  /* DllCharacteristics: NX + TERMINAL_SERVER_AWARE (no DYNAMIC_BASE) */
    串丙(文件, 0x400000); /* SizeOfStackReserve — 自举递归需>64KB; 必须>=StackCommit (CI windows-latest 严格校验) */
    串丙(文件, 0x400000); /* SizeOfStackCommit */
    串丙(文件, 0x100000); /* SizeOfHeapReserve */
    串丙(文件, 0x1000);   /* SizeOfHeapCommit */
    写四(文件, 0);       /* LoaderFlags */
    写四(文件, 16);      /* NumberOfRvaAndSizes */
    /* data directory 0: exports (none) */
    写四(文件, 0); 写四(文件, 0);
    /* data directory 1: import table (kernel32) */
    写四(文件, 数据基址 + 0x4E8); 写四(文件, 60); /* RVA of import descriptors + size (2026-08-28 P1 #246: desc@+0x4E8 kernel32 17 槽) */
    /* data directories 2-15: none */
    遍 (整 丁序 = 2; 丁序 < 16; 丁序++) { 写四(文件, 0); 写四(文件, 0); }

    /* Section Header (40 bytes) */
    写入(".text", 1, 5, 文件); 容吉(文件, 3); /* 8-byte section name ".text\0\0\0" — split write: the \0 escape is dropped by str_place (while(*s) stops at the embedded null), so a single 8-byte literal would be truncated (fix 2026-08-03) */
    写四(文件, 代码尺寸);  /* VirtualSize */
    写四(文件, 隔简一);   /* VirtualAddress */
    写四(文件, 代码尺寸);  /* SizeOfRawData */
    写四(文件, 顺再);  /* PointerToRawData */
    写四(文件, 0);          /* PointerToRelocations */
    写四(文件, 0);          /* PointerToLinenumbers */
    下布(文件, 0);          /* NumberOfRelocations */
    下布(文件, 0);          /* NumberOfLinenumbers */
    写四(文件, 0x60000020); /* .text: code + execute + read */

    /* .data section header */
    整 元丙 = 顺再 + 代码尺寸; /* MUST follow .text �?was 0x400, which overlapped code �?12B */
    写入(".data", 1, 5, 文件); 容吉(文件, 3); /* ".data\0\0\0" — split write (see .text note) */
    写四(文件, 缓粗);  /* VirtualSize �?80MB: statics + bump heap */
    写四(文件, 源组);    /* VirtualAddress */
    写四(文件, 首厚一);  /* SizeOfRawData — BSS分离: 只写导入表+heap counter, 堆/栈由 loader 清零 (fix 2026-08-25) */
    写四(文件, 元丙);   /* PointerToRawData */
    写四(文件, 0); 写四(文件, 0); 下布(文件, 0); 下布(文件, 0);
    写四(文件, 0xC0000040);  /* initialized data + read + write */

    /* Pad to text file offset */
    整 位 = (整)取文件位置(文件);
    循环 (位 < 顺再) { 写字符(0, 文件); 位++; }

    /* Write .text */
    写入(码, 1, 码位, 文件);

    /* Pad section to raw size */
    整 终一 = 顺再 + 代码尺寸;
    位 = (整)取文件位置(文件);
    循环 (位 < 终一) { 写字符(0, 文件); 位++; }

    /* .data section: write heap counter, then import table
       布局（fix 2026-08-06 BUG-1）：每个 DLL 的 IAT/ILT 独立且以 0 终止
       IAT1@+0x08 (8 kernel32 + term=72B) IAT2@+0x50 (59 msvcrt + term=480B)
       ILT1@+0x230 (9*8B=72B) ILT2@+0x278 (60*8B=480B) desc@+0x458 (3*20=60B) names@+0x4B0
       (fix 2026-08-19: IAT2 16→17; math21: 17→22; math24: 22→25; step5: 25→34; step8: 34→46; step9: 46→54; step10: 54→59 加 strcoll/strxfrm/strncat/strncpy/strtod; ILT thunk 8B 按 PE64 计) */
    定位文件(文件, 元丙, 号汇);
    整 实低 = 号己 + 源组 + 名聚 + 4 * 静态数 + 2560; /* argv[64]+tokens then heap */
    实低 = (实低 + 7) & ~7; /* fix 2026-08-12 BLOCKER-3: bump heap BASE 8-byte aligned — 布局变化 (data_rva_base/__pad0 尺寸) 不得影响堆对齐 (tll[tk] 错位读 → 伪 nll=1 → 2-cycle) */
    写四(文件, 实低); /* heap counter initialized */
    写四(文件, 0);          /* padding */
    静 常 字 *主亥[17] = { "GetStdHandle", "WriteFile", "CreateFileA", "ReadFile", "VirtualAlloc", "SetFilePointer", "ExitProcess", "GetCommandLineA", "CreateThread", "WaitForSingleObject", "CloseHandle", "CreateFiber", "SwitchToFiber", "DeleteFiber", "ConvertThreadToFiber", "LoadLibraryA", "GetProcAddress" }; /* 2026-08-28 type-root-15 #41: +CreateFiber/SwitchToFiber/DeleteFiber/ConvertThreadToFiber; 2026-08-28 P1 #246: +LoadLibraryA/GetProcAddress (动态库加载, 15→17 槽) */
    静 常 字 *栈降[59] = { "pow", "atan2", "fmod", "sqrt", "cos", "sin", "tan", "acos", "asin", "atan", "log", "log10", "exp", "floor", "ceil", "fabs", "cosh", "sinh", "tanh", "_copysign", "_hypot", "frexp", "ldexp", "modf", "_write", "_time64", "difftime", "_localtime64", "_gmtime64", "_mktime64", "strftime", "clock", "asctime", "ctime", "strtok", "strrchr", "strnlen", "strpbrk", "memcmp", "toupper", "isalnum", "isxdigit", "isspace", "rand", "srand", "abs", "islower", "isupper", "iscntrl", "isgraph", "isprint", "ispunct", "labs", "atof", "strcoll", "strxfrm", "strncat", "strncpy", "strtod" };
    整 双四 = 0x08, 总升 = 0x98, 长伍 = 0x278, 号吉 = 0x308, 源六 = 0x4E8, 名偏 = 0x524; /* 2026-08-28 P1 #246: kernel32 15→17 槽 (18*8=144=0x90); IAT1@0x08(144B→0x98), IAT2@0x98(480B→0x278), ILT1@0x278(144B→0x308), ILT2@0x308(480B→0x4E8), desc@0x4E8(60B→0x524), names@0x524 (至 ~0x8E0 < DATA_RVA_OFF 0x900) */
    整 数偏[76];
    /* IAT/ILT 占位 */
    定位文件(文件, 元丙 + 双四, 号汇); 遍 (整 计 = 0; 计 < 18; 计++) 串丙(文件, 0);
    定位文件(文件, 元丙 + 总升, 号汇); 遍 (整 计 = 0; 计 < 60; 计++) 串丙(文件, 0);
    定位文件(文件, 元丙 + 长伍, 号汇); 遍 (整 计 = 0; 计 < 18; 计++) 串丙(文件, 0);
    定位文件(文件, 元丙 + 号吉, 号汇); 遍 (整 计 = 0; 计 < 60; 计++) 串丙(文件, 0);
    /* names（hint 2B + name + \0） */
    定位文件(文件, 元丙 + 名偏, 号汇);
    遍 (整 计 = 0; 计 < 17; 计++) { 数偏[计] = (整)取文件位置(文件) - 元丙; 下布(文件, 0); 写行(主亥[计], 文件); 写字符(0, 文件); }
    遍 (整 计 = 0; 计 < 59; 计++) { 数偏[17 + 计] = (整)取文件位置(文件) - 元丙; 下布(文件, 0); 写行(栈降[计], 文件); 写字符(0, 文件); }
    整 短甲 = (整)取文件位置(文件) - 元丙; 写行("kernel32.dll", 文件); 写字符(0, 文件);
    整 深辛 = (整)取文件位置(文件) - 元丙; 写行("msvcrt.dll", 文件); 写字符(0, 文件);
    /* 回填 IAT1（17 + term） */
    定位文件(文件, 元丙 + 双四, 号汇);
    遍 (整 计 = 0; 计 < 17; 计++) 串丙(文件, 数据基址 + 数偏[计]);
    串丙(文件, 0);
    /* 回填 IAT2（59 + term） */
    定位文件(文件, 元丙 + 总升, 号汇);
    遍 (整 计 = 0; 计 < 59; 计++) 串丙(文件, 数据基址 + 数偏[17 + 计]);
    串丙(文件, 0);
    /* 回填 ILT1/ILT2 */
    定位文件(文件, 元丙 + 长伍, 号汇);
    遍 (整 计 = 0; 计 < 17; 计++) 串丙(文件, 数据基址 + 数偏[计]);
    串丙(文件, 0);
    定位文件(文件, 元丙 + 号吉, 号汇);
    遍 (整 计 = 0; 计 < 59; 计++) 串丙(文件, 数据基址 + 数偏[17 + 计]);
    串丙(文件, 0);
    /* import descriptors: kernel32 (IAT1/ILT1), msvcrt (IAT2/ILT2) */
    定位文件(文件, 元丙 + 源六, 号汇);
    写四(文件, 数据基址 + 长伍);  /* kernel32 OriginalFirstThunk */
    写四(文件, 0); 写四(文件, 0);
    写四(文件, 数据基址 + 短甲);  /* Name */
    写四(文件, 数据基址 + 双四);  /* FirstThunk */
    写四(文件, 数据基址 + 号吉);  /* msvcrt OriginalFirstThunk */
    写四(文件, 0); 写四(文件, 0);
    写四(文件, 数据基址 + 深辛);  /* Name */
    写四(文件, 数据基址 + 总升);  /* FirstThunk */
    遍 (整 丁序 = 0; 丁序 < 5; 丁序++) 写四(文件, 0); /* terminator descriptor */
    /* pad .data to raw size */
    定位文件(文件, 元丙 + 名聚, 号汇);
    位 = (整)取文件位置(文件);
    整 数据终 = 元丙 + 首厚一; /* BSS分离: 只写导入表+heap counter (fix 2026-08-25) */
    净系(文件, 数据终 - 位); /* fix 2026-08-12: 原逐字节 fputc, 自宿主 52MB 填充 85s → 分块 fwrite */
}

/* ?????? ??????????? */
/* MOV r32, imm32 for high registers (r8-r15): B8+reg only encodes 0-7, so prefix REX.B. */
静 空 移即扩(整 寄存器, 整 立即数) { 汇发("    移动 r%d, %d\n", (字*)(长 长)(寄存器), (字*)(长 长)(立即数), (字*)(长 长)0); 若 (寄存器 & 8) 发字节(0x41); 发字节(0xB8 | (寄存器 & 7)); 发四(立即数); }

/* Mini-CRT entry stub (hand-emitted): GetCommandLineA �?copy-tokenize argv into a
   static .data area (argv[64] at statics, token strings right after) �?call
   main(argc, argv) �?ExitProcess.
   Registers: r10=cmdline r11=scan idx r12=&argv[0] r13=&token_area(advancing)
   r14=argc r8=token_start r15=saved rsp. Each token is NUL-terminated in the copy. */
静 空 序置二(空) {
    整 顺辛 = 号己 + 数据基址 + 名聚 + 4 * 静态数; /* .data static area for argv[64] */
    顺高一 = 码位; /* entry point = start of this stub */
    /* 自切栈：立即�?rsp 切到 .data 内的高地址区（62MB 偏移处），完全脱�?loader �?
       （loader 把主线程栈放在镜�?SizeOfImage 内部 ~91.6-92.6MB，页面不可靠 �?
       deep parse 帧读 SIGSEGV）。固�?62MB 偏移：栈向下 1MB 仍在 .data 段内�?
       且高�?heap 终点（~48MB）；被编译程序没�?__stack 静态，不能用静态末尾�?*/
    整 存子一 = 号己 + 数据基址 + 上利(); /* fix 2026-08-12 自举收敛根因: 栈顶必须在 bump 堆终点之上 — 旧 max(cp*84,8MB) 自举时落进 tll_hi → 栈帧写穿 token 数组 → 2-cycle. 实测 v1g: stk_top=0x52B15D8=heap_start+33.6MB, tll_hi 在 +33.2..+35.2MB. data_extent = statics_end + 堆44MB + 栈8MB */
    移64(3, 4);         /* rbx = rsp (保存 loader 栈 — fix 2026-08-17 CI 根因: Server 2025 ntdll LdrShutdownProcess 清理路径 _chkstk 按 TEB 栈探测, 自切栈 rsp 脱离 TEB → SIGSEGV; 退出前切回 loader 栈) */
    移即扩(4, 存子一);     /* mov rsp, stk_top (32位 imm，零扩展) */
    /* fix 2026-08-25 step5: TEB 栈边界改为自切栈 — msvcrt _tzset/_setjmpex/_chkstk 按 TEB 栈探测,
       自切栈 rsp 脱离 loader 栈 → localtime/gmtime SEGV (_setjmpex: test %r11b,(%r11)).
       x64 TEB 基址=gs:0, StackBase=TEB+0x08 (高地址), StackLimit=TEB+0x10 (低地址) */
    移即扩(0, 存子一);     /* rax = stk_top */
    汇发("    改 TEB 栈基\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x65); 发字节(0x48); 发字节(0x89); 发字节(0x04); 发字节(0x25); 发四(0x08); /* mov gs:[0x08], rax */
    移即扩(0, 存子一 - 0x1000000); /* rax = stk_top - 16MB (栈向下预算) */
    汇发("    改 TEB 栈限\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x65); 发字节(0x48); 发字节(0x89); 发字节(0x04); 发字节(0x25); 发四(0x10); /* mov gs:[0x10], rax */
    移即扩(12, 顺辛);          /* r12 = &argv[0] */
    移即扩(13, 顺辛 + 512);    /* r13 = token area start */
    /* GetCommandLineA() */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp,-16 */
    减栈即(32);
    调导入(7);            /* GetCommandLineA �?rax */
    加栈即(32);
    移64(10, 0);        /* r10 = cmdline */
    移即扩(4, 存子一); /* rsp = stk_top (自切栈顶 — 不用 r15, r15 已让位) */
    移即扩(11, 0);      /* r11 = i (scan idx) */
    移即扩(14, 0);      /* r14 = argc */
    移即扩(15, 0);      /* r15 = in-quote flag (fix 2026-08-19: argv tokenizer 引号支持 — 原只按空格分割, git commit -m "first commit" 被拆成 "first + commit" → pathspec 'commit"' 错) */
    整 目再 = 新标号(), 缺置 = 新标号(), 缺挂 = 新标号(), 满升一 = 新标号(), 首拾一 = 新标号(), 外八 = 新标号(), 段辰 = 新标号(), 素贰 = 新标号(), 主进 = 新标号(), 深组 = 新标号();
    设标号(目再);
    汇发("    零扩展 SIB\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x43); 发字节(0x0F); 发字节(0xB6); 发字节(0x04); 发字节(0x1A);
    移寄存器(1, 0);           /* ecx = c */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 段辰, 1);
    移即(0, 0x20); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 外八, 1); /* cmp ecx,' ' */
    移即(0, 0x22); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 素贰, 1); /* cmp ecx,'"' → 引号 token 起点 */
    移64(8, 13);        /* r8 = token_start (r13) */
    设标号(缺置);
    汇发("    零扩展 SIB\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x43); 发字节(0x0F); 发字节(0xB6); 发字节(0x04); 发字节(0x1A); /* movzx eax, byte [r10+r11] */
    移寄存器(1, 0);           /* ecx = c */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 满升一, 1);
    移即(0, 0x22); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 主进, 1); /* cmp ecx,'"' → 翻转引号状态 */
    移即(0, 0x20); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 深组, 1); /* cmp ecx,' ' */
    汇发("    存字节帧 [r13+0], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0x88); 模字节(1, 1, 5); 发字节(0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3);
    汇发("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 5);
    相对跳转(-1); 补标号(码位-4, 缺置, 2);
    设标号(素贰); /* 引号 token 起点: 跳过 "，置 in-quote=1，token 从当前位置开始 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (skip ") */
    移即扩(15, 1); /* in-quote = 1 */
    移64(8, 13);    /* r8 = token_start */
    相对跳转(-1); 补标号(码位-4, 缺置, 2);
    设标号(深组); /* 空格: 引号内复制, 引号外结束 token */
    测寄存器(15, 15); 零跳(-1); 补标号(码位-4, 缺挂, 1); /* in-quote==0 → 结束 */
    汇发("    存字节帧 [r13+0], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0x88); 模字节(1, 1, 5); 发字节(0); /* 引号内空格: 复制 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3);
    汇发("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 5);
    相对跳转(-1); 补标号(码位-4, 缺置, 2);
    设标号(主进); /* 翻转引号状态: 跳过 "，不写入 token */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (skip ") */
    汇发("    异或 r15, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0x83); 发字节(0xF7); 发字节(0x01); /* xor r15d, 1 */
    相对跳转(-1); 补标号(码位-4, 缺置, 2);
    设标号(缺挂); /* token ended at a space: NUL-terminate, skip the space */
    汇发("    存字节0 [r13+0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xC6); 模字节(1, 0, 5); 发字节(0); 发字节(0);
    汇发("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 5);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3);
    相对跳转(-1); 补标号(码位-4, 首拾一, 2);
    设标号(满升一); /* token ended at NUL: terminate; outer loop will finish */
    汇发("    存字节0 [r13+0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xC6); 模字节(1, 0, 5); 发字节(0); 发字节(0);
    设标号(首拾一);
    汇发("    存栈索引 [r12+r14*8], r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x4F); 发字节(0x89); 发字节(0x04); 发字节(0xF4);
    汇发("    自增 r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 6);
    相对跳转(-1); 补标号(码位-4, 目再, 2);
    设标号(外八); /* space between tokens */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3);
    相对跳转(-1); 补标号(码位-4, 目再, 2);
    设标号(段辰);
    移64(1, 14);        /* rcx = argc */
    移64(2, 12);        /* rdx = &argv[0] */
    移即扩(4, 存子一); /* rsp = stk_top (自切栈顶; argv lives in .data; frame may grow over old stack) */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp,-16 */
    减栈即(32);        /* shadow space */
    {
        整 宏序 = 查函数("main");
        若 (宏序 < 0 || !函数表[宏序].序布) 宏序 = 查函数("主"); /* 甲言: 主() = main() */
        若 (宏序 < 0 || !函数表[宏序].序布) { 输出到文件(错误流, "[ERR] 未找到 main 入口 — parse 可能中断 (func_tbl[-1] 越界原跳 label 0 → call realloc 崩, p21/p23/p25)\n"); 退出(1); }
        相对调用(0);
        补标号(码位 - 4, 函数表[宏序].标号一, 0); /* call main */
    }
    加栈即(32);
    移寄存器(1, 0);           /* ecx = main's return code */
    移64(4, 3);         /* rsp = rbx (loader 栈 — Server 2025 ntdll LdrShutdownProcess _chkstk 需 TEB 栈区) */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
    减栈即(32);
    调导入(6);            /* ExitProcess �?never returns */
}

/* two-pass generation support: root_global/g_lc_save/g_rsp_save/entry_rva_global at file scope */
空 生成码(空) {
    /* reset codegen state for two-pass (pass 1 estimates .data base, pass 2 real) */
    码位 = 0; 计利一 = 0; 段简 = 0; 主又 = 0; 暂拆 = 0; 反高 = 0; 剩回 = 0;
    满柒一 = 0;
    正五 = 0; 码生成内存浮 = 0; 码生成内存指 = 0; 整回 = -1; 计双 = 0; 中系 = 0; 标拾 = 0; 初壹 = 0; 码生成免解引用 = 0; 值序 = 0; 满伴 = 0; /* fix 2026-08-28 可重入: cg_* codegen 状态标志跨编译残留 → 进程内第 2 次编译首个函数代码不同 (--repeat 只验 2..N 自洽, 漏首 vs 次) */
    若 (整再) { 帧又 = 0; 素凶++; 字 列再[80]; 格式化到串(列再, "{\"pass\":%d,\"start\":true}", 素凶); 段弊(列再); } /* 编译黑匣子: 每 pass 起始帧 (gen_code 多遍, 每遍独立帧序) */
    函数数 = 0; /* MUST re-register all functions in pass 2 with FRESH labels �?
                   otherwise pass-2 new_label() numbers overlap the pass-1 function
                   labels and epilogue/return jumps resolve to the wrong functions. */
    初成 = 净成; 栈用量 = 现降一;
    遍 (整 计 = 0; 计 < 串数; 计++) { 邻拾[计] = -1; } /* fix 2026-08-11: 镜像 1090 字符串 > 1024, str_offs 扩容 2048; fix 2026-08-27 step7: 清 str_cnt 全量 (原 2048 残留 — str_offs 扩 65536 后 str_cnt>2048 时旧值残留 → 字符串地址错) */
    遍 (整 计 = 0; 计 < 1024; 计++) { 目甲[计] = -1; } /* fix 2026-08-03: was 512 — strings with ID>=512 kept pass-1 offsets, so pass-2 pool missed them and string refs pointed past the pool */
    遍 (整 计 = 0; 计 < 短繁; 计++) { 标号位[计] = 0; 标号设[计] = 0; }
    /* Pre-place ALL strings and doubles in ID order (fix 2026-08-03): str_place/
       dbl_place are normally lazy (first-reference order), which can deviate from
       lex order (a "" literal lexed early but referenced late, static-init
       strings, etc.) → H1's sdat layout ≠ the .字串/.浮点 ID-order emission →
       route_learn's string/double pool drifted and H1≠H2. Pre-placing in ID order
       makes the sdat layout deterministic and ID-ordered, matching asm_zh. */
    遍 (整 计 = 0; 计 < 串数; 计++) 外陆一(计);
    遍 (整 计 = 0; 计 < 浮数; 计++) 标劣(计);

    /* generate code */
    /* pre-mark all function labels as defined so calls before the definition
       (forward declaration) resolve as user calls, not builtins */
    遍 (整 计 = 0; 计 < 函数定义数; 计++) {
        整 字符 = 函数定义表[计];
        若 (字符 <= 0) 续;
        { 静 整 单简 = 0; 单简++; (空)单简; }
        整 己序 = 查函数((字*)(节名表 + 字符));
        函数表[己序].序布 = 1;
    }
    主又 = 0;
    解析基 = 0; /* codegen lookups use vs_end (=fve[gfn]), not the parse-time floor */
    /* per-function LOCAL frames (root-cause 2026-08-03): recomputed in the loop below */

    遍 (整 计 = 0; 计 < 函数定义数; 计++) {
        整 字符 = 函数定义表[计];
        若 (字符 <= 0) 续;

        /* function definition */
        字 *串升 = (字*)(节名表 + 字符);
        整 己序 = 查函数(串升);
        复制字符串(当前函数名, 串升); /* for case-6 double-return routing */
        { 字 目次[96]; 格式化到串(目次, "{\"cp\":\"codegen\",\"func\":\"%s\",\"idx\":%d}", 串升, 计); 长叁(目次); } /* 编译检查点 (2026-08-28 AI原生 #6): 每函数代码生成快照 */
        设标号(函数表[己序].标号一);
        汇发("\n; === %s ===\n%s:\n", 串升, 串升, (字*)(长 长)0);
        函数表[己序].序布 = 1;
        当前返回型序 = 查返回名(串升);
        若 (当前返回型序 < 0 && !返回名有(串升) && 己序 >= 0 && 己序 < 8192) 当前返回型序 = 返回型序表[己序]; /* fix 2026-08-18: 名表优先 (同上 — int 返回函数名表有记录, 不得回退错位索引表) */
        { 整 当返指 = 查返回名指(串升);
          当前函数结构返 = (当前返回型序 >= 0 && 类型表[当前返回型序].尺寸 > 8 && !当返指); } /* sret fn: params shift (rcx = hidden ptr); struct pointer return is NOT sret */
        列重 = 变参取(串升);

        /* local frame — single source of truth: `off` is the GLOBAL parse-time rsp_off,
           fr_start[gfn] this function's baseline. disp = off - cur_frame_sz
           = (off - fr_start) - fn_frame, so each var lands at [rsp + (off - fr_start)]
           right after `sub rsp, fn_frame`. fr_end-fr_start is always 16-aligned and
           272 = 17*16, so fn_frame keeps ABI alignment at OS-call sites. */
        整 段三 = (反细[剩回] - 段进[剩回]) + 4368 + 8; /* fix 2026-08-07 Gate-1: +8 → fn_frame≡8(mod16)。入口 rsp≡8(标准) → 2 push(rbp,rbx) 仍 ≡8 → 帧后 rsp≡0 → 调用点 Win64 ABI 16 对齐（gcc sqlite3 混链 movaps 崩溃根因）。fr_end-fr_start 恒 16 对齐 */
        当前帧大小 = 段进[剩回] + 段三; /* 51 sites `off - cur_frame_sz` untouched */
        临时基 = 当前帧大小 - 272; /* 状态区 [rbp-272..]，printf 缓冲在其下 [rbp-4368..rbp-273]（emit_print 里 lea -4096） */
        结构返指偏移 = 当前帧大小 - 4376; /* sret slot at [rbp-4376] — 内联 printf 格式解释器把 [rbp-8] 当 '#' 标志/清零 scratch (emit_print 状态位), 与 sret 槽冲突 → sret 函数内调 printf 后返回指针被毁 → rcx 垃圾写崩 (fix 2026-08-27 第三批#2: feat_sret10 makeA 崩 0xC0000005). 移入局部区与 printf 缓冲间的恒空闲 +8 填充 (fn_frame 必含 +8), 局部区顶 [rbp-4376) 永不被占用 */

        /* fix 2026-08-08 -bin: _start 设裸机栈 + 正常序言 (完整帧, 函数体帧访问有效) */
        整 深劣 = (满双 && 计 == 0 && !比较字符串(串升, "_start"));
        整 邻拾一 = (满双 && !比前n(串升, "__isr_", 6)); /* __isr_xxx: 裸中断函数 — 无帧、iretq */
        若 (深劣) {
            移即扩(4, 0x200000); /* mov rsp, 0x200000 — 内核栈 (裸机无栈) */
            移64(15, 4);         /* r15 = rsp */
            压栈寄存器(5);  /* push rbp */
            压栈寄存器(3);  /* push rbx */
            移64(5, 4); /* mov rbp, rsp */
            减栈即(段三); /* 完整帧 */
        } 否 若 (邻拾一) {
            /* 裸中断函数: 无栈帧, iretq 退出 (CPU 已压入 SS:RSP:RFLAGS:CS:RIP) */
            (空)0; /* no prologue */
        } 否 {
            压栈寄存器(5);  /* push rbp */
            压栈寄存器(3);  /* push rbx */
            移64(5, 4); /* mov rbp, rsp */
            减栈即(段三); /* shadow space + locals */
        }
        若 (当前函数结构返) 反附(结构返指偏移 - 当前帧大小, 1); /* save the hidden sret pointer (rcx) — inner calls clobber it */

        /* copy incoming params into frame slots (reg params from rcx/rdx/r8/r9,
           stack params from [rbp+pdisp]) �?params live in slots, so recursive /
           nested calls can't clobber the parameter registers.
           Pointer params (p_esz>0) are copied 64-bit to keep full addresses.
           Only THIS function's vars [fvb[gfn], fve[gfn]) �?all 109 functions share
           vars[], copying every param into every prologue would clobber live slots. */
        整 当重 = 新寅[剩回], 宽乙 = 总甲[剩回];
        净乙 = 宽乙; /* scope var lookups to this function during codegen */
        旁得 = 宽乙; /* default block bound = whole function; nested case-5 blocks tighten it (fix 2026-08-16) */
        值序 = 宽乙; /* fix 2026-08-19: 默认块下界 = 函数末尾 (宽松, 顶层块变量可见; case-5 进入块时收紧) */
        整 上己一 = (满双 && 计 == 0) || 邻拾一; /* -bin 入口函数或 ISR: 跳过参数复制 */
        旧序[己序] = 新标号(); 设标号(旧序[己序]); /* #152 TCO: 参数复制点 (尾递归 jmp 目标) */
        遍 (整 变序 = 当重; 变序 < 宽乙; 变序++) {
            若 (变量表[变序].素三 && !上己一) {
                若 (变量表[变序].是否浮标) {
                    /* double param: xmm[preg→xmm] (reg) or [rbp+pdisp] (stack). 8 bytes. */
                    若 (变量表[变序].宽系) { 逆厚(变量表[变序].长酉); 余申(变量表[变序].栈偏移 - 当前帧大小); }
                    否 若 (当前函数结构返) 内丙(变量表[变序].栈偏移 - 当前帧大小, 变量表[变序].栈又); /* sret fn: double param k lives in xmm[k] */
                    否 内丙(变量表[变序].栈偏移 - 当前帧大小, 短六一(变量表[变序].值丙));
                } 否 若 (变量表[变序].宽系) {
                    若 (变量表[变序].指元素尺寸 > 0 || (变量表[变序].型序标 >= 0 && 变量表[变序].构尺寸 > 0 && 变量表[变序].构尺寸 <= 8) || 变量表[变序].是否长标) { 移寄存器帧64(0, 变量表[变序].长酉); 反附(变量表[变序].栈偏移 - 当前帧大小, 0); }
                    否 { 移寄存器帧(0, 变量表[变序].长酉); 移帧寄存器(变量表[变序].栈偏移 - 当前帧大小, 0); }
                } 否 若 (变量表[变序].指元素尺寸 > 0 || (变量表[变序].型序标 >= 0 && 变量表[变序].构尺寸 > 0 && 变量表[变序].构尺寸 <= 8) || 变量表[变序].是否长标) 反附(变量表[变序].栈偏移 - 当前帧大小, 变量表[变序].值丙);
                否 移帧寄存器(变量表[变序].栈偏移 - 当前帧大小, 变量表[变序].值丙);
            }
        }

        /* fix step30: 局部 _Alignas(>16) 数组 — 固定 rbp 帧 rbp%N ∈ {8,24} 编译期未知, 静态 [rbp+disp]
           无法保证 >16 对齐; 候选区运行时对齐, 对齐地址存地址槽 (cg case1 数组 decay 读槽). */
        遍 (整 变序 = 当重; 变序 < 宽乙 && !上己一; 变序++) {
            若 (变量表[变序].元列 > 0 && 变量表[变序].双伍 <= 0) { /* fix step31: VLA 的 alignN=1 只是地址槽标记, 不是 _Alignas 对齐数组 — 跳过, 动态分配在声明处 */
                整 池汇 = 变量表[变序].元列;
                
                取帧址(0, 变量表[变序].首贰 - 当前帧大小);  /* rax = 候选区基址 */
                发字节(0x48); 发字节(0x81); 发字节(0xC0); 发四(池汇 - 1);             /* add rax, N-1 */
                发字节(0x48); 发字节(0x25); 发四(-池汇);                         /* and rax, -N */
                反附(变量表[变序].栈偏移 - 当前帧大小, 0); /* 地址槽 = 对齐地址 */
            }
        }

        /* variadic functions: spill the four integer-argument registers into the
           Win64 home area so va_start/va_arg (and msvcrt _vsnprintf) can walk a
           contiguous vararg list. Home base = rbp+24 (see var_param pdisp math).
           Fixed named params are still copied above; the spill only adds the
           home-area view needed by va_list. */
        若 (列重 >= 0 && !上己一) {
            反附(24, 1); /* rcx -> home[0] */
            反附(32, 2); /* rdx -> home[1] */
            反附(40, 8); /* r8  -> home[2] */
            反附(48, 9); /* r9  -> home[3] */
        }

        /* epilogue label: return jumps here */
        长复 = 新标号();

        若 (链接模式 && 全局初始化数 > 0) { /* fix 2026-08-17: coff 模式 ginit 用专用子程序 + 每函数守卫调用 —
                                            原只在最后一个函数内联发射, 若该函数不被调用 (git setup.o
                                            validate_ref_storage_format --help 路径不调) 则初始化永不执行;
                                            初版每函数内联 ginit body → 大 .o 代码缓冲溢出 (sequencer.o) */
            若 (链丑 < 0) { 链丑 = 变量静态("__qcc_ginit_flag", 0); 逆酉[变量数 - 1] = 1; } /* 每 .o 独立局部符号 (scl=3), 防链接重复 */
            若 (单平 < 0) 单平 = 新标号();
            整 初陆 = 新标号();
            移eax内存(静态位移(链丑, 0)); /* flag 已置位? */
            测寄存器(0, 0);
            非零跳(-1); 补标号(码位 - 4, 初陆, 3);            /* 已初始化 → skip */
            相对调用(0); 补标号(码位 - 4, 单平, 0); /* call ginit 子程序 (coff 前向重定位) */
            设标号(初陆);
            满柒一 = 1;
        } 否 若 ((!链接模式 && (!比较字符串(串升, "main") || !比较字符串(串升, "主"))) || (满双 && !比较字符串(串升, "_start"))) { /* bin 模式: ginit 在 _start 发射 (裸机无 CRT) */
            满伴 = 1; /* ginit decls must NOT be skipped by case-7's local-static check */
            遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) 码生成(后凶[庚序]);
            满伴 = 0;
            满柒一 = 1;
        }

        码生成(子0[字符]); /* function body */

        /* epilogue label: return jumps here — 提前到 gfn++ 前 (defer cg 需当前函数 vs_end, 原 gfn++ 后 vs_end 指向下一函数 → defer 变量"不能取地址" fix 2026-08-27 defer 接入) */
        设标号(长复);
        若 (子1[字符] >= 0) { /* defer: 延迟语句 LIFO 逆序执行 — return 跳这里先清理再 epilogue; rax 保存/恢复 — defer 内调用会 clobber return 值 (fix 2026-08-27 defer 接入) */
            减栈即(16); /* 对齐 + 临时槽 */
            汇发("    存指64 [rsp], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x89); 模字节(0, 0, 4); 发字节(0x24); /* mov [rsp], rax */
            码生成(子1[字符]);
            汇发("    取指64 r0, [rsp]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x8B); 模字节(0, 0, 4); 发字节(0x24); /* mov rax, [rsp] */
            加栈即(16);
        }
        { 整 上四 = 中柒(串升); 若 (上四 >= 0 && 段分[上四].源甲) { 整 上系 = 查变量("__qcc_ret"); 若 (上系 >= 0) 移帧寄存器(上系 - 当前帧大小, 0); 码生成(现再(段分[上四].左陆一, 段分[上四].源庚)); 若 (上系 >= 0) 移寄存器帧(0, 上系 - 当前帧大小); } } /* 契约后置 (2026-08-28 可吞清单 P0-7): epilogue 处 __qcc_ret=返回值; if(!后置){printf;exit;} — 每个 return 都跳 epi_label, 在此统一检查; 检查后恢复 rax=返回值 (cg 求值会踩 rax); fix 2026-08-28: RAII 回滚误删此检查 (回归, _verify_contract ⑤ 后置违反不拦) */
        剩回++; /* next function's var range */

        若 (邻拾一) {
            /* iretq: 从中断返回 (CPU 自动弹出 RIP:CS:RFLAGS:RSP:SS) */
            汇发("    中断返回\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
            发字节(0x48); 发字节(0xCF);
        } 否 {
            整 后伍 = 0; /* fix step31: VLA 动态 sub rsp 后 rsp 不在 rbp-fn_frame — 用 mov rsp,rbp 直接丢弃 VLA 栈区 */
            遍 (整 素壬 = 当重; 素壬 < 宽乙; 素壬++) 若 (变量表[素壬].双伍 > 0) { 后伍 = 1; 断; }
            若 (后伍) 移64(4, 5); /* mov rsp, rbp */
            否 加栈即(段三);
            弹栈寄存器(3); /* pop rbx */
            弹栈寄存器(5); /* pop rbp */
            返一();
        }
        存重(串升); /* 编译黑匣子: 每函数代码增量哈希帧 (定位分歧: diff 两黑匣子, 首个不同 delta 即首个分歧函数) */
    }
    /* 接入 2026-08-28 declare 声明先行: 已声明的未实现函数 → stub (mov eax,0; ret), 缺失=警告非错误 (AI 渐进补全) */
    遍 (整 丁序 = 0; 丁序 < 声明数; 丁序++) {
        若 (链接模式 && 邻捌[丁序]) 续; /* fix 2026-08-30: C proto no stub in -c (definition may be in another .o - jyld duplicate symbol) */
        整 当退 = 查函数(串升一[丁序]);
        若 (!函数表[当退].序布) {
            设标号(函数表[当退].标号一);
            发字节(0xB8); 发字节(0x00); 发字节(0x00); 发字节(0x00); 发字节(0x00); /* mov eax, 0 (返回 0 的骨架) */
            发字节(0xC3); /* ret */
            函数表[当退].序布 = 1;
        }
    }
    若 (链接模式 && 单平 >= 0) { /* fix 2026-08-17: ginit 专用子程序 (每函数守卫调用, 正文只在末尾一次) */
        设标号(单平);
        /* fix 2026-08-19: set flag=1 BEFORE running the initializer body so the
           ginit body can safely call guarded functions in the SAME .o (userdiff.c
           builtin_drivers init calls the IPATTERN/PATTERNS stubs). With the flag
           set only at the end, the callee's guard sees flag==0 and calls the
           ginit sub again -> A<->B mutual recursion -> stack overflow 0xC00000FD. */
        移即(0, 1); 终拆(静态位移(链丑, 0)); /* flag = 1 FIRST: ginit re-entrant */
        满伴 = 1;

        遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) 码生成(后凶[庚序]);
        满伴 = 0;
        发字节(0xC3); /* ret */
    }
    若 (链接模式) {
        /* -c 模式：跳过 CRT 与补丁烘焙；str/fn/dbl 补丁改为 COFF 重定位 */
        遍 (整 计 = 0; 计 < 段简; 计++) {
            整 构序 = 宽伍[计].串序标;
            若 (!毛薄) 毛薄 = 首利(".rdata$str", 0, 2, 3, 0);
            整 偏移 = 邻拾[构序];
            隔贰(宽伍[计].旁退, 偏移);
            缺亥(宽伍[计].旁退, 0x0002, 毛薄, 偏移);
        }
        遍 (整 计 = 0; 计 < 主又; 计++) {
            整 直弊 = 段丑(新五[计].标号一);
            若 (直弊 >= 0) {
                隔贰(新五[计].旁退, 0);
                缺亥(新五[计].旁退, 0x0002, 直弊, 0);
            }
        }
        /* 计算字符串数据总大小 — dbl_offs 值包含 sdat 前缀（字符串）偏移，
           但 COFF .rdbl 节只有 double 数据（从 0 开始），reloc addend 必须减去前缀。 */
        整 元再 = 0;
        遍 (整 计 = 0; 计 < 串数; 计++) 若 (邻拾[计] >= 0) {
            整 尺寸 = (整)取字长(串表[计]) + 1;
            若 (邻拾[计] + 尺寸 > 元再) 元再 = 邻拾[计] + 尺寸;
        }
        若 (元再 > 反高) 元再 = 反高;
        遍 (整 计 = 0; 计 < 暂拆; 计++) {
            整 丁序 = 号集一[计].浮序标;
            若 (!素戊) 素戊 = 首利(".rdata$dbl", 0, 3, 3, 0);
            整 偏移 = 目甲[丁序] - 元再; /* .rdbl 节内偏移（去掉字符串前缀） */
            隔贰(号集一[计].旁退, 偏移);
            缺亥(号集一[计].旁退, 0x0004, 素戊, 偏移);
        }
        若 (反高 > 0) {
            正浅(全伴, 元再);
            若 (反高 > 元再) 短十(全伴 + 元再, 反高 - 元再);
        }
        /* 内部跳转重定位的 addend = 最终 label_pos（前向跳转在 patch 时未知）。
           COFF addend 在指令字节中（jyld 从指令读），必须写回最终值。 */
        遍 (整 计 = 0; 计 < 总得; 计++) 若 (实凶[计].高亥) {
            实凶[计].现重 = 标号位[实凶[计].标号一];
            隔贰(实凶[计].段次, 标号位[实凶[计].标号一]);
        }
        返;
    }

    /* mini-CRT entry stub: provides argc/argv, calls main, exits with its code.
       Emitted in BOTH passes (pass 2 overwrites pass 1 identically).
       -bin 模式: 无 CRT (内核自备 Multiboot2 header + 入口, fix 2026-08-08) */
    若 (!满双) {
        汇发("\n; === CRT ===\n_入口:\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        序置二();
    }

    /* ????????? */
    解析补丁();

    /* ??????????? patch imm32 in mov_r_imm ??actual VA (ImageBase + RVA) */
    整 码终 = 码位;
    遍 (整 计 = 0; 计 < 段简; 计++) {
        整 构序 = 宽伍[计].串序标;
        整 偏移 = 邻拾[构序]; /* byte offset within string data */
        整 首重 = (满双 ? 0x104000 : 号己) + 0x1000 + 码终 + 偏移; /* bin: 内核加载基址 0x104000 (拼接引导后) + code区 + off */
        隔贰(宽伍[计].旁退, 首重);
    }
    /* patch function-address imm32s (fn ptr assignment) to actual VA */
    遍 (整 计 = 0; 计 < 主又; 计++) {
        整 首重 = (满双 ? 0x104000 : 号己) + 0x1000 + 标号位[新五[计].标号一];
        隔贰(新五[计].旁退, 首重);
    }
    /* patch double-literal rip-relative disp32s: target VA = text_rva + code_end + dbl_off.
       movsd xmm0,[rip+disp32] is 8 bytes (F2 0F 10 05 + disp4); disp sits at patch_at
       (4 bytes into the instruction), so the RIP base is patch_at+4 (end of instruction). */
    遍 (整 计 = 0; 计 < 暂拆; 计++) {
        整 丁序 = 号集一[计].浮序标;
        整 偏移 = 目甲[丁序];
        整 基 = (满双 ? 0x104000 : 号己);
        整 首重 = 基 + 0x1000 + 码终 + 偏移;
        隔贰(号集一[计].旁退, 首重 - (基 + 0x1000 + 号集一[计].旁退 + 4));
    }
    /* ????????????????????*/
    若 (反高 > 0) {
        循环 (码位 + 反高 >= 码缓容量) { 无 字 *接子数 = 重分配(码, 码缓容量+4096); /* code 缓冲上限（fix 2026-08-06: 误用 IMAGE_BASE 语义，H1） */ 若 (!接子数) { 输出到文件(错误流, "qcc_x86: OOM at code buffer %d bytes\n", 号己+4096); 退出(1); } 码 = 接子数; }
        复制内存(码 + 码位, 全伴, 反高);
        码位 += 反高;
    }

    /* data section ASM directives for round-trip */
    汇发("\n; === .data ===\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    整 虚捌 = 0;
    /* .字串 in ID order (= sdat placement order), .浮点 INTERLEAVED at its sdat
       position - qcc places doubles mid-sdat during codegen, so dumping all
       .浮点 at the end made asm_zh's string-pool layout differ. */
    遍 (整 计 = 0; 计 < 串数; 计++) {
        整 偏移 = 邻拾[计];
        循环 (虚捌 < 浮数) {
            整 满散 = 目甲[虚捌];
            若 (满散 < 0) { 虚捌++; 续; }
            若 (偏移 >= 0 && 满散 < 偏移) {
                整 链劣 = 逆组[虚捌], 度附 = 现退[虚捌];
                无 字 栈甲[8];
                栈甲[0]=链劣&0xff;栈甲[1]=(链劣>>8)&0xff;栈甲[2]=(链劣>>16)&0xff;栈甲[3]=(链劣>>24)&0xff;
                栈甲[4]=度附&0xff;栈甲[5]=(度附>>8)&0xff;栈甲[6]=(度附>>16)&0xff;栈甲[7]=(度附>>24)&0xff;
                双 值; 复制内存(&值, 栈甲, 8);
                汇发浮(".浮点 %f\n", 值);
                虚捌++;
            } 否 断;
        }
        若 (偏移 >= 0) {
            /* escape quotes/backslashes/newlines: strings like "%s":" start with a
               quote, which asm_zh's .字串 parser took as the closing quote */
            汇发(".字串 \"", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
            遍 (常 字 *条件码 = 串表[计]; *条件码; 条件码++) {
                若 (*条件码 == '"') 汇发("\\\"", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*条件码 == '\\') 汇发("\\\\", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*条件码 == '\n') 汇发("\\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*条件码 == '\t') 汇发("\\t", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 汇发("%c", (字*)(长 长)(*条件码), (字*)(长 长)0, (字*)(长 长)0);
            }
            汇发("\"\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        }
    }
    循环 (虚捌 < 浮数) {
        若 (目甲[虚捌] >= 0) {
            整 链劣 = 逆组[虚捌], 度附 = 现退[虚捌];
            无 字 栈甲[8];
            栈甲[0]=链劣&0xff;栈甲[1]=(链劣>>8)&0xff;栈甲[2]=(链劣>>16)&0xff;栈甲[3]=(链劣>>24)&0xff;
            栈甲[4]=度附&0xff;栈甲[5]=(度附>>8)&0xff;栈甲[6]=(度附>>16)&0xff;栈甲[7]=(度附>>24)&0xff;
            双 值; 复制内存(&值, 栈甲, 8);
            汇发浮(".浮点 %f\n", 值);
        }
        虚捌++;
    }
    /* static-slot count for the heap counter (asm_zh cannot know stc_n) */
    汇发("\n.堆计 %d\n", (字*)(长 长)(静态数), (字*)(长 长)0, (字*)(长 长)0);
    /* tell asm_zh the exact code_end (before sdat) so it can align its layout */
    汇发(".布局 code_end=%d data_base=0x%X\n", (字*)(长 长)(码位 - 反高), (字*)(长 长)(数据基址), (字*)(长 长)0);
    /* fix 2026-08-12 H2 对等: 告诉 asm_zh 直发的 .data 段尺寸 (data_extent 修复后 vsize/raw 是动态的,
       asm_zh 旧写死 0x5000000/0x4000 → H2 产物 .data 段 ≠ 直发 → H2 对等失败) */
    { 整 串得 = (上利() + 0x100000 + 4095) & ~4095; 若 (串得 < 0x6000000) 串得 = 0x6000000; /* 96MB 地板 (write_pe 同) */
      汇发(".段 data_vsize=0x%X data_raw=0x%X\n", (字*)(长 长)串得, (字*)(长 长)(首厚一), (字*)(长 长)0); }

    /* ??main ???????? �?mini-CRT stub is the real entry (it calls main) */
    整 内九 = 0x1000 + 顺高一;
    若 (满双) {
        /* -bin 入口 = _start (用户主函数) 的 label 偏移, 非 CRT stub (bin 跳过 CRT) — fix 2026-08-08 */
        整 构序 = 查函数("_start");
        若 (构序 < 0 || !函数表[构序].序布) 构序 = 查函数("主");
        若 (构序 >= 0 && 函数表[构序].序布) 内九 = 0x1000 + 标号位[函数表[构序].标号一]; /* bin 偏移 = code区(0x1000) + 函数偏移 */
        输出到文件(错误流, "[BIN] _start entry offset: 0x%X (code=%d)\n", 内九, 码位);
    }
    下集一 = 内九;
}

/* Read a file into a malloc'd NUL-terminated string (NULL on failure).
   REAL function, NOT a macro: the lexer skips function-like macro definitions
   (#define F(x) ...), so a macro call would compile as an undefined function
   and the self-hosted compiler could never read its input. */
静 字 *逆平一(常 字 *路径) {
    若 (计挂) { /* fix 2026-08-10 Gate 9: ������ļ�ϵͳ -> �ڴ�� */
        若 (!比较字符串(路径, "srclib/qcc_rt.c") || !比较字符串(路径, "qcc_rt.c")) {
            返 (字 *)宽贰; /* ����ʱ */
        }
        返 (字 *)剩薄;  /* ��Դ�� */
    }

    字 *发字节 = NULL;
    FILE *文件;
    整 尺寸;
    文件 = 打开文件(路径, "rb");
    若 (文件) {
        定位文件(文件, 0, 2); /* SEEK_END */
        尺寸 = 取文件位置(文件);
        倒带(文件);
        若 (尺寸 < 0) { 关文件(文件); 返 NULL; } /* fix 2026-08-09 BUG-12: ftell 失败(-1L 非 seekable)显式检查 */
        若 (尺寸 > 0 && 尺寸 <= 16777216) { /* fix 2026-08-24 t35u: 1048576→2097152 — qcc_x86.c 自身 t35u 后 1.05MB 超 1MB 上限 → H1 链自举编译自身 "cannot open" */
            发字节 = 内存分配((尺寸 + 4) & ~3); /* fix 2026-08-11 BLOCKER-3: round to 4 — unaligned bump sizes misalign tt..tll -> tll[tk] garbage -> spurious nll=1 -> 2-cycle */
            读取(发字节, 1, 尺寸, 文件);
            发字节[尺寸] = 0;
            /* skip UTF-8 BOM (EF BB BF): qcc lexed it as a CJK identifier
               (e.g. "主"), corrupting the first token and swallowing main
               (fix 2026-08-06: `unsigned a>=b; if(...){printf;return;}` crashed) */
            若 (尺寸 >= 3 && (无 字)发字节[0] == 0xEF && (无 字)发字节[1] == 0xBB && (无 字)发字节[2] == 0xBF) {
                移动内存(发字节, 发字节 + 3, 尺寸 - 3);
                发字节[尺寸 - 3] = 0;
            }
        }
        关文件(文件);
    }
    返 发字节;
}

/* 自切栈：loader 把主线程栈放在镜�?SizeOfImage 内部（~91.6-92.6MB），页面不可�?
   （deep parse 帧读 SIGSEGV）。本数组必须是【最后一个文件级静态】：CRT stub 入口
   �?rsp 切到这里，栈�?= heap 起点，栈向下增长、heap 向上增长，背靠背互不侵犯�?*/
__attribute__((原粗))
静 字 主二一[0x100000];

/* ---------- COFF 对象写入（-c 模式） ---------- */
静 空 逆辰一(FILE *文件, 整 值) { 写字符(值 & 0xFF, 文件); 写字符((值 >> 8) & 0xFF, 文件); }
静 空 值庚(FILE *文件, 整 值) { 写字符(值 & 0xFF, 文件); 写字符((值 >> 8) & 0xFF, 文件); 写字符((值 >> 16) & 0xFF, 文件); 写字符((值 >> 24) & 0xFF, 文件); }

/* 全局 brace 初始化器静态落盘：把 brace_arr_init/brace_fields 生成的
   常量赋值（sane_ctype[256]、commands[] 等）直接写进 .data，多文件链接时
   ginit 不会执行，不能依赖运行时代码。左值必须是文件级/函数级 static。 */
静 字 *旧劣(整 数) {
    循环 (数 >= 0 && (节型表[数] == 14 || 节型表[数] == 15 || 节型表[数] == 13)) 数 = 子0[数];
    若 (数 >= 0 && 节型表[数] == 1) 返 (字*)(节名表 + 数);
    返 NULL;
}
静 整 段陆(常 字 *数) {
    遍 (整 计 = 变量数 - 1; 计 >= 0; 计--)
        若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && 变量表[计].栈偏移 >= 0)
            返 计;
    返 -1;
}
/* 计算 static 左值表达式在 .data 内的字节偏移（相对其基变量槽）。
   *esz_out = 该位置要写入的字节数；*si_out = 结构体类型（成员链续接用，-1 表示非结构体）。 */
静 整 隔拆(整 数, 整 *基槽出, 整 *帧布, 整 *构序出) {
    若 (数 < 0) 返 -1;
    若 (节型表[数] == 1) {
        整 序标 = 段陆((字*)(节名表 + 数));
        若 (序标 < 0) 返 -1;
        *基槽出 = 变量表[序标].栈偏移;
        整 构序 = 变量表[序标].型序标;
        整 元素尺寸 = 4;
        若 (变量表[序标].数组元素尺寸 > 0) 元素尺寸 = 变量表[序标].数组元素尺寸;
        否 若 (变量表[序标].指元素尺寸 > 0) 元素尺寸 = 8;
        否 若 (变量表[序标].是否长标 || 变量表[序标].是否浮标) 元素尺寸 = 8;
        否 若 (构序 >= 0) 元素尺寸 = 类型表[构序].尺寸;
        *帧布 = 元素尺寸;
        *构序出 = 构序;
        返 0;
    }
    若 (节型表[数] == 14) {
        整 字符 = 子1[数]; /* fix 2026-08-16 根治: 数组访问节点索引子节点可能为 -1 (非法/解析产物), nt[-1]/nv[-1] 越界读 — qcc 三元急切求值两分支都算, host(gcc 分支式) 靠布局侥幸不崩, v1 必崩 (add-patch.c 0xC0000005) */
        整 序标 = (字符 >= 0 && 节型表[字符] == 0) ? 节值表[字符] : -1;
        若 (序标 < 0) 返 -1;
        整 余庚 = 0, 元素尺寸 = 0, 构序 = -1;
        整 宽戌 = 隔拆(子0[数], &余庚, &元素尺寸, &构序);
        若 (宽戌 < 0 || 元素尺寸 <= 0) 返 -1;
        整 内双 = 元素尺寸;
        整 出构序 = 构序;
        若 (构序 < 0) { /* 数组元素：下一层的字节大小取数组基变量的标量元素大小 */
            字 *外癸 = 旧劣(数);
            整 容排 = 外癸 ? 段陆(外癸) : -1;
            若 (容排 >= 0) {
                内双 = 变量表[容排].指元素尺寸 > 0 ? 变量表[容排].指元素尺寸 :
                          (变量表[容排].数组元素尺寸 > 0 ? 变量表[容排].数组元素尺寸 : 4);
            }
        }
        *基槽出 = 余庚;
        *帧布 = 内双;
        *构序出 = 出构序;
        返 宽戌 + 序标 * 元素尺寸;
    }
    若 (节型表[数] == 15 || 节型表[数] == 13) {
        若 (节值表[数] != 0) 返 -1; /* 指针箭头成员（->）不在全局静态初始化器中出现 */
        字 *函 = (字*)(节名表 + 数);
        整 余庚 = 0, 元素尺寸 = 0, 构序 = -1;
        整 宽戌 = 隔拆(子0[数], &余庚, &元素尺寸, &构序);
        若 (宽戌 < 0 || 构序 < 0) 返 -1;
        整 域偏移 = 类型偏移(类型表[构序].名, 函);
        若 (域偏移 < 0) 返 -1;
        整 域尺寸 = 字段尺寸(类型表[构序].名, 函);
        整 域型 = 字段类型序(类型表[构序].名, 函);
        若 (域型 >= 0 && 类型表[域型].尺寸 != 域尺寸) 域型 = -1; /* struct 指针字段：不是值嵌入 */
        *基槽出 = 余庚;
        *帧布 = 域尺寸;
        *构序出 = 域型;
        返 宽戌 + 域偏移;
    }
    返 -1;
}
/* fix 2026-08-21: 全局 const 初始化器的常量表达式 (GIT_SHA1_HEXSZ=(2*RAW) 等) 编译期折叠 —
   原 coff_write_lval_value 只认 NK 字面量, 表达式节点走 ginit 运行时赋值 → 跨 .o 时 ginit 触发晚
   (object-name.o 读 hash_algos 时 object-file.o 的 ginit 未跑) → cat-file/commit oid 解析失败 (Not a valid object name) */
静 整 帧汇(整 数, 整 *成功) {
    若 (数 < 0) { *成功 = 0; 返 0; }
    若 (节型表[数] == 0) { *成功 = 1; 返 节值表[数]; }
    若 (节型表[数] == 2) {
        整 丙 = 节值表[数];
        整 缓六 = 0, 中寅 = 0;
        整 甲 = 帧汇(子0[数], &缓六);
        整 发字节 = 帧汇(子1[数], &中寅);
        若 (!缓六 || !中寅) { *成功 = 0; 返 0; }
        若 (丙 == 下得) { *成功 = 1; 返 甲 * 发字节; }
        若 (丙 == 高拾) { *成功 = 1; 返 甲 + 发字节; }
        若 (丙 == 旧肆) { *成功 = 1; 返 甲 - 发字节; }
        若 (丙 == 行降) { 若 (发字节 == 0) { *成功 = 0; 返 0; } *成功 = 1; 返 甲 / 发字节; }
        若 (丙 == 度未) { 若 (发字节 == 0) { *成功 = 0; 返 0; } *成功 = 1; 返 甲 % 发字节; }
        *成功 = 0; 返 0;
    }
    *成功 = 0; 返 0;
}
静 空 缺组一(uint8_t *反汇, 整 数据偏, 整 元素尺寸, 整 右侧) {
    若 (右侧 < 0) 返;
    若 (节型表[右侧] == 0) {
        整 值 = 节值表[右侧];
        若 (元素尺寸 == 1) { 反汇[数据偏] = (无 字)值; }
        否 若 (元素尺寸 == 2) { 反汇[数据偏] = (无 字)(值 & 0xff); 反汇[数据偏 + 1] = (无 字)((值 >> 8) & 0xff); }
        否 若 (元素尺寸 == 4) { 复制内存(反汇 + 数据偏, &值, 4); }
        否 若 (元素尺寸 == 8) {
            长 长 直繁 = (长 长)(无 整)值;
            若 (节长标[右侧]) 直繁 |= ((长 长)(无 整)节长高[右侧]) << 32;
            复制内存(反汇 + 数据偏, &直繁, 8);
        }
        返;
    }
    若 (节型表[右侧] == 2) { /* 常量表达式编译期折叠: (2 * GIT_SHA1_RAWSZ) → 40 (fix 2026-08-21: 原跳过 → .data 槽 0 → 跨 .o ginit 未跑时读 0) */
        整 成功 = 0;
        整 值 = 帧汇(右侧, &成功);
        若 (!成功) 返;
        若 (元素尺寸 == 1) { 反汇[数据偏] = (无 字)值; }
        否 若 (元素尺寸 == 2) { 反汇[数据偏] = (无 字)(值 & 0xff); 反汇[数据偏 + 1] = (无 字)((值 >> 8) & 0xff); }
        否 若 (元素尺寸 == 4) { 复制内存(反汇 + 数据偏, &值, 4); }
        否 若 (元素尺寸 == 8) { 长 长 直繁 = (长 长)值; 复制内存(反汇 + 数据偏, &直繁, 8); }
        返;
    }
    若 (节型表[右侧] == 11 && 子0[右侧] >= 0 && 节型表[子0[右侧]] == 1) { /* &target: 8 字节指针槽 ADDR64 重定位 (fix 2026-08-21: brace init 的 & 自引用 (tempfile_list = {&list,&list}) 原跳过 → .data 槽 0 → volatile_list_del head=垃圾 → commit 崩) */
        字 *顺败 = (字*)(节名表 + 子0[右侧]);
        整 邻戌 = 查变量(顺败);
        整 顺合 = 邻戌 >= 0 ? 双成(邻戌) : -1;
        若 (顺合 >= 0) { 内存设置(反汇 + 数据偏, 0, 8); 序深(数据偏, 0x0001, 顺合, 0); }
        返;
    }
    若 (节型表[右侧] == 串词) {
        整 构序 = 节值表[右侧];
        若 (!毛薄) 毛薄 = 首利(".rstr", 0, 2, 3, 0);
        整 现重 = (构序 >= 0 && 构序 < 串数 && 邻拾[构序] >= 0) /* fix 2026-08-27 step7: si<str_cnt (原 2048 残留 — str_offs 扩 65536 配套) */ ? 邻拾[构序] : 0;
        
        序深(数据偏, 0x0002, 毛薄, 现重);
        返;
    }
    若 (节型表[右侧] == 1) {
        字 *词名表 = (字*)(节名表 + 右侧);
        整 串值 = 满合(词名表);
        若 (串值 < 0) 串值 = 首利(词名表, 0, 0, 2, 0x20);
        序深(数据偏, 0x0002, 串值, 0);
        返;
    }
}
静 空 名十一(整 泛数, uint8_t *反汇) {
    若 (泛数 < 0) 返;
    若 (节型表[泛数] == 5) {
        遍 (整 键 = 0; 键 < 256; 键++) {
            整 字符 = 取子(泛数, 键);
            若 (字符 > 0) 名十一(字符, 反汇);
        }
        返;
    }
    若 (节型表[泛数] == 10) {
        整 直繁 = 子0[泛数], 右侧 = 子1[泛数];
        
        若 (直繁 < 0 || 右侧 < 0) 返;
        整 余庚 = 0, 元素尺寸 = 0, 构序 = -1;
        整 首转 = 隔拆(直繁, &余庚, &元素尺寸, &构序);
        
        若 (首转 < 0 || 余庚 < 0) 返;
        整 数据偏 = 4 * 余庚 + 首转;
        若 (数据偏 < 0 || 元素尺寸 <= 0 || 数据偏 + (元素尺寸 > 4 ? 8 : 元素尺寸) > 静态数 * 4) 返;
        缺组一(反汇, 数据偏, 元素尺寸, 右侧);
    }
}

静 空 空伴(FILE *文件) {
    /* 节内容 */
    构 { 字 名[16]; 整 尺寸一; uint8_t *数据; 整 旧粗; } 标叁[4];
    内存设置(标叁, 0, 大小(标叁));
    复制字符串(标叁[0].名, ".text"); 标叁[0].尺寸一 = 码位; 标叁[0].数据 = 码; 标叁[0].旧粗 = 0x60000020;
    复制字符串(标叁[1].名, ".rstr"); 标叁[1].尺寸一 = 单利; 标叁[1].数据 = 列叁; 标叁[1].旧粗 = 0x40300040;
    复制字符串(标叁[2].名, ".rdbl"); 标叁[2].尺寸一 = 副酉; 标叁[2].数据 = 列己; 标叁[2].旧粗 = 0x40300040;
    /* Task 5.1 (fix 2026-08-06): 全局初始值入 .data — 原 .bss 无内容, 常量初始值 (ginit) 在 -c 多 .o 链接时
       挂在第一个函数入口不执行 → counter=100 丢成 0。改 .data 段含初始值; 未初始化全局写 0 (语义等价 .bss 清零) */
    复制字符串(标叁[3].名, ".data"); 标叁[3].尺寸一 = 静态数 * 4; 标叁[3].旧粗 = 0xC0300080;
    uint8_t *反汇 = (uint8_t*)内存分配((静态数 ? 静态数 : 1) * 4);
    内存设置(反汇, 0, (静态数 ? 静态数 : 1) * 4); /* fix 2026-08-17: bump calloc does NOT zero; write_coff_obj .data needs clean buffer */

    标叁[3].数据 = 反汇;
    遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) { /* 常量全局初始值 (g = 立即数) 直接写 .data — case 7 decl+init (值在 n0), case 10 assign (值在 n1) */
        整 泛数 = 后凶[庚序];
        整 虚败 = -1;
        若 (泛数 >= 0 && 节型表[泛数] == 7 && 子0[泛数] >= 0 && 节型表[子0[泛数]] == 0) 虚败 = 子0[泛数];
        否 若 (泛数 >= 0 && 节型表[泛数] == 10 && 子1[泛数] >= 0 && 节型表[子1[泛数]] == 0) 虚败 = 子1[泛数];
        /* fix 2026-08-17: &var 地址常量 → .data ADDR32 重定位 (coff 多 .o 时 ginit 子程序不被 main 所在 .o 调用 → 全局指针 = &x 保持 0 崩; 单文件非 coff 走 ginit 正常) */
        否 若 (链接模式 && 泛数 >= 0 && 节型表[泛数] == 7 && 子0[泛数] >= 0 && 节型表[子0[泛数]] == 11 && 子0[子0[泛数]] >= 0 && 节型表[子0[子0[泛数]]] == 1) 虚败 = 子0[泛数];
        否 若 (链接模式 && 泛数 >= 0 && 节型表[泛数] == 10 && 子1[泛数] >= 0 && 节型表[子1[泛数]] == 11 && 子0[子1[泛数]] >= 0 && 节型表[子0[子1[泛数]]] == 1) 虚败 = 子1[泛数];
        /* fix 2026-08-21: 字符串字面量初始化器 (const char *g = "str") → .data 槽写字符串地址 reloc。
           原只匹配数值/&var 节点, STR 节点 (nt=STR) 跳过 → 槽 0 → blob_type/commit_type 等 NULL → hash-object/commit 崩 */
        否 若 (链接模式 && 泛数 >= 0 && 节型表[泛数] == 7 && 子0[泛数] >= 0 && 节型表[子0[泛数]] == 串词) 虚败 = 子0[泛数];
        否 若 (链接模式 && 泛数 >= 0 && 节型表[泛数] == 10 && 子1[泛数] >= 0 && 节型表[子1[泛数]] == 串词) 虚败 = 子1[泛数];
        若 (虚败 >= 0) {
            字 *变节 = (字*)(节名表 + 泛数);
            整 偏移 = 查变量(变节);
            若 (偏移 >= 0 && 偏移 < 静态数) {
                若 (节型表[虚败] == 11) { /* &target: 8 字节指针槽 0 占位 + ADDR64 重定位 (fix 2026-08-17: 原 4 字节 + REL32_3(0x0006) 错类型 → 链接后垃圾地址) */
                    字 *顺败 = (字*)(节名表 + 子0[虚败]);
                    整 邻戌 = 查变量(顺败);
                    整 顺合 = 邻戌 >= 0 ? 双成(邻戌) : -1;
                    若 (顺合 >= 0) { 内存设置(反汇 + 4 * 偏移, 0, 8); 序深(4 * 偏移, 0x0001, 顺合, 0); }
                } 否 若 (节型表[虚败] == 串词) { /* 字符串字面量: 8 字节指针槽 → .rstr 段 ADDR32 重定位 */
                    内存设置(反汇 + 4 * 偏移, 0, 8);
                    缺组一(反汇, 4 * 偏移, 8, 虚败);
                } 否 {
                    整 值 = 节值表[虚败];
                    若 (变量是否长(变节)) { 长 长 直繁 = (长 长)值; 复制内存(反汇 + 4 * 偏移, &直繁, 8); } /* ll 全局常量: 符号扩展 8 字节 (fix 2026-08-06: 原 4 字节 → 高 4 字节 0, -5 变 4294967291) */
                    否 若 (计得(变节) == 1) { 无 字 逆未 = (无 字)值; 复制内存(反汇 + 4 * 偏移, &逆未, 1); } /* fix 2026-08-30 csmith t6: 8 位标量 .data 初始化窄化 — static uint8_t g=-17 原写 0xFFFFFFEF → 32 位读 4294967279 (s88 族根治) */
                    否 若 (计得(变节) == 2) { 无 短 帧属 = (无 短)值; 复制内存(反汇 + 4 * 偏移, &帧属, 2); } /* fix 2026-08-30 csmith t6: 16 位标量 .data 初始化窄化 — static uint16_t g=-1 原写 0xFFFFFFFF → 读 4294967295 */
                    否 复制内存(反汇 + 4 * 偏移, &值, 4);
                }
            }
        }
    }
    若 (!值升) 值升 = 首利(".text", 0, 1, 3, 0);
    若 (!毛薄) 毛薄 = 首利(".rstr", 0, 2, 3, 0);
    若 (!素戊) 素戊 = 首利(".rdbl", 0, 3, 3, 0);
    若 (!外浅) 外浅 = 首利(".data", 0, 4, 3, 0); /* fix 2026-08-06: .bss→.data (全局初始值入 .data) */
    遍 (整 计 = 0; 计 < 函数数; 计++) {
        若 (函数表[计].序布) {
            整 净升 = (函数是否静态(函数表[计].名) || 主薄(函数表[计].名)) ? 3 : 2; /* static/内建 → 局部符号 scl=3 (fix 2026-08-06: 多 .o 头库不冲突) */
            整 串值 = 满合(函数表[计].名);
            若 (串值 < 0) {
                串值 = 首利(函数表[计].名, 标号位[函数表[计].标号一], 1, 净升, 0x20);
            } 否 {
                /* fix 2026-08-15: 同名未定义符号先入表（函数体之前被引用）→ 定义被跳过，符号值停在 0 → strbuf_add 跳到对象首函数 */
                符退[串值].值一 = 标号位[函数表[计].标号一];
                符退[串值].缓癸 = 1;
                符退[串值].域 = 净升;
                符退[串值].型 = 0x20;
            }
        }
    }
    遍 (整 计 = 0; 计 < 变量数; 计++) {
        若 (变量表[计].是否静态标 && 变量表[计].栈偏移 >= 0) { /* extern (rsp_off<0) 不生成 .bss 定义符号 — 由 coff_slot_sym 生成 sec=0 未定义 (fix 2026-08-06) */
            整 上丙 = (静态关键[计] || 逆酉[计]) ? 3 : 2;
            整 串值 = 满合(变量表[计].名);
            若 (串值 < 0) 串值 = 首利(变量表[计].名, 4 * 变量表[计].栈偏移, 4, 上丙, 0); /* fix 2026-08-06: 函数内 static → scl=3 局部; fix 2026-08-14: 文件级 static 也 scl=3 */
            否 {
                /* fix 2026-08-15: 同名符号先以未定义/错误值入表 → 更新为真实 .data 槽 */
                符退[串值].值一 = 4 * 变量表[计].栈偏移;
                符退[串值].缓癸 = 4;
                符退[串值].域 = 上丙;
                符退[串值].型 = 0;
            }
        }
    }

    /* -c 多 .o 链接: 把「函数/全局变量地址」类静态初始化器直接落成 .data ADDR32 重定位。
       否则它们只存在于 ginit 运行时代码，而 ginit 只挂在对象最后一个函数入口，
       多文件链接后不会执行 → 静态函数指针槽保持 0（usage_routine/die_routine 崩）。 */
    遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) {
        整 泛数 = 后凶[庚序];
        若 (泛数 < 0 || 节型表[泛数] != 7 || 子0[泛数] < 0) 续;
        若 (节型表[子0[泛数]] != 1) 续; /* 仅处理函数/全局变量地址初始化 */
        字 *变节 = (字*)(节名表 + 泛数);
        整 偏移 = -1;
        遍 (整 变序 = 变量数 - 1; 变序 >= 0; 变序--)
            若 (!比较字符串(变量表[变序].名, 变节) && 变量表[变序].是否静态标 && 变量表[变序].栈偏移 >= 0) { 偏移 = 变量表[变序].栈偏移; 断; }
        若 (偏移 < 0) 续;
        字 *词名表 = (字*)(节名表 + 子0[泛数]);
        整 串值 = 满合(词名表);
        若 (串值 < 0) 续;
        序深(4 * 偏移, 0x0002, 串值, 0);
    }

    /* 全局 brace 数组/结构体初始化：把静态可确定的元素/字段值写入 .data。
       覆盖 sane_ctype[256]、commands[] 等（fix 2026-08-16: 多文件链接 ginit 不执行，
       原 .data 全零 → isspace/isalnum 宏全假、命令分发表空）。 */
    遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) {
        整 泛数 = 后凶[庚序];
        若 (泛数 >= 0 && 节型表[泛数] == 5) 名十一(泛数, 反汇);
    }

    /* 每节重定位 */
    整 下布一[4] = {0,0,0,0};
    遍 (整 计 = 0; 计 < 总得; 计++) {
        /* 重定位按 site 所在节分组（不是目标符号的节） */
        整 段次 = 实凶[计].段次;
        整 帧三 = 0;
        若 (段次 >= 正二) 帧三 = 3;
        否 若 (段次 >= 码位) {
            若 (段次 < 码位 + 单利) 帧三 = 1;
            否 帧三 = 2;
        }
        下布一[帧三]++;
    }
    整 *首重[4], *初巳[4], *上柒一[4];
    整 容排[4] = {0,0,0,0};
    遍 (整 计 = 0; 计 < 4; 计++) {
        首重[计] = 清零分配(下布一[计] ? 下布一[计] : 1, 4);
        初巳[计] = 清零分配(下布一[计] ? 下布一[计] : 1, 4);
        上柒一[计] = 清零分配(下布一[计] ? 下布一[计] : 1, 4);
    }
    遍 (整 计 = 0; 计 < 总得; 计++) {
        整 段次 = 实凶[计].段次;
        整 帧三 = 0;
        若 (段次 >= 正二) 帧三 = 3;
        否 若 (段次 >= 码位) {
            若 (段次 < 码位 + 单利) 帧三 = 1;
            否 帧三 = 2;
        }
        整 满分 = 容排[帧三]++;
        首重[帧三][满分] = (帧三 == 3) ? (实凶[计].段次 - 正二) : 实凶[计].段次;
        初巳[帧三][满分] = 实凶[计].半退;
        上柒一[帧三][满分] = 实凶[计].型;
    }

    /* fix 2026-08-18: ADDR32/ADDR64 .data 重定位的 addend 必须写进 .data 站点 —
       COFF 的 addend 存在节数据里 (链接器读站点字节加符号地址); 原只记 reloc 表不写 addend
       → 全局指针 = 字符串 (special_refs[]={"FETCH_HEAD",...}) 的 addend 全 0 →
       指针指向 .rstr 偏移 0 ("SUDO_UID") → is_special_ref strcmp 垃圾 → git init SEGV */
    遍 (整 计 = 0; 计 < 总得; 计++) {
        若 (实凶[计].段次 >= 正二 && (实凶[计].型 == 0x0002 || 实凶[计].型 == 0x0001)) {
            整 偏移 = 实凶[计].段次 - 正二;
            
            若 (偏移 >= 0 && 偏移 + 8 <= 静态数 * 4) {
                整 甲 = 实凶[计].现重;
                若 (实凶[计].型 == 0x0001) { 长 长 标址 = (长 长)(无 整)甲; 复制内存(反汇 + 偏移, &标址, 8); }
                否 复制内存(反汇 + 偏移, &甲, 4);
            }
        }
    }

    /* COFF header */
    逆辰一(文件, 0x8664); 逆辰一(文件, 4); 值庚(文件, 0);
    整 余九 = (整)取文件位置(文件);
    值庚(文件, 0); 值庚(文件, 0);
    逆辰一(文件, 0); 逆辰一(文件, 0);

    /* 节表 + 计算 raw offsets */
    整 逆玖 = 20 + 40 * 4;
    整 度序一[4];
    遍 (整 计 = 0; 计 < 4; 计++) {
        字 名存[9]; 内存设置(名存, 0, 9); 复制内存(名存, 标叁[计].名, 8);
        写入(名存, 1, 8, 文件);
        值庚(文件, 0); 值庚(文件, 0);
        值庚(文件, 标叁[计].尺寸一);
        值庚(文件, 逆玖); 逆玖 += 标叁[计].尺寸一;
        /* reloc offset 先占位，写完数据后回填 */
        度序一[计] = -1;
        值庚(文件, 0); 值庚(文件, 0);
        逆辰一(文件, 下布一[计]); 逆辰一(文件, 0);
        值庚(文件, 标叁[计].旧粗);
    }

    /* 节数据 */
    遍 (整 计 = 0; 计 < 4; 计++) {
        若 (标叁[计].数据 && 标叁[计].尺寸一 > 0) 写入(标叁[计].数据, 1, 标叁[计].尺寸一, 文件);
    }
    /* 重定位表（对象重定位偏移 = 文件绝对偏移） */
    整 堆凶 = (整)取文件位置(文件);
    遍 (整 计 = 0; 计 < 4; 计++) {
        度序一[计] = 下布一[计] ? 堆凶 : 0;
        遍 (整 乙 = 0; 乙 < 下布一[计]; 乙++) {
            值庚(文件, 首重[计][乙]);
            值庚(文件, 初巳[计][乙]);
            逆辰一(文件, 上柒一[计][乙]);
        }
        堆凶 += 下布一[计] * 10;
    }
    /* 回填节表 PointerToRelocations（第 i 项 +24） */
    遍 (整 计 = 0; 计 < 4; 计++) {
        定位文件(文件, 20 + 40 * 计 + 24, 号汇);
        值庚(文件, 度序一[计]);
    }

    /* 符号表 */
    整 虚酉 = 堆凶 + (下布一[0] + 下布一[1] + 下布一[2] + 下布一[3]) * 10;
    定位文件(文件, 虚酉, 号汇);
    整 元丁 = 4;
    遍 (整 计 = 0; 计 < 满己; 计++) 若 ((整)取字长(符退[计].名) > 8) 元丁 += (整)取字长(符退[计].名) + 1;
    遍 (整 计 = 0; 计 < 满己; 计++) {
        常 字 *名存 = 符退[计].名;
        整 长度一 = (整)取字长(名存);
        若 (长度一 <= 8) {
            字 容拾[8]; 内存设置(容拾, 0, 8); 复制内存(容拾, 名存, 长度一);
            写入(容拾, 1, 8, 文件);
        } 否 {
            整 丙 = 4;
            遍 (整 键 = 0; 键 < 计; 键++) 若 ((整)取字长(符退[键].名) > 8) 丙 += (整)取字长(符退[键].名) + 1;
            写字符(0,文件); 写字符(0,文件); 写字符(0,文件); 写字符(0,文件); /* 4 zero + 4 offset = 8 字节名字段 */
            值庚(文件, 丙);
        }
        值庚(文件, 符退[计].值一);
        逆辰一(文件, 符退[计].缓癸);
        逆辰一(文件, 符退[计].型);
        写字符(符退[计].域, 文件);
        写字符(0, 文件);
    }
    /* 字符串表 */
    值庚(文件, 元丁);
    遍 (整 计 = 0; 计 < 满己; 计++) {
        若 ((整)取字长(符退[计].名) > 8) { 写行(符退[计].名, 文件); 写字符(0, 文件); }
    }
    /* 回填符号表指针 */
    定位文件(文件, 余九, 号汇);
    值庚(文件, 虚酉);
    值庚(文件, 满己);
}

/* ==== Phase 3 阶段 C: IR 工程预埋区 (v1.4 §11.2 定义态 · 宏门内零占用) ====
   语义依据: 《甲言_逆向定律库_IR工程预埋全景.md》§12 优先级 (类型宽度第一)
   纪律: IR_PREBED_ACTIVE 未定义 → 结构定义不参与编译 → 产物零影响 → 自举不变 (85af2ba4)
   激活: Phase 7 打开宏 + 引用 → 必须过预埋尺 (v1.4 §7.2) + 差异测试双闸 */
#ifdef 前亥一
/* 1. IR3 三地址码 (v1.4 §2.1, LLVM 值模型定律 §6) — 类型宽度第一优先 */
typedef 构 { 整 算子; 整 现高; 整 元; 整 首利一; 整 串值二; 整 剩十; } 实薄;
/* ty 编码: 低 8 位类型 (i8=1 i16=2 i32=3 i64=4 u8=5 u16=6 u32=7 u64=8 f32=9 f64=10 ptr=11),
   高 8 位值级属性位 (LAW_LINEAR/SUM/LATTICE) */
#define 缓集 1000000  /* 预埋初始值: 激活前按编译 Git 全量最坏规模实测校准 (2026-08-25 启元审计) */
静 实薄 暂弊[缓集]; 静 整 现序一;

/* 2. 块表/CFG (v1.4 §3, LLVM CFG 定律 §7) — 只存 succ 反向算 pred (LLVM 定律 2) */
typedef 构 { 整 始; 整 终一; 整 列丁; 整 副肆; 整 尾序一[8]; 整 末辛[8]; } 剩系;
#define 剩伴一 100000  /* 预埋初始值: 激活前按 Git 全量函数数 × 最坏基本块数实测校准 (2026-08-25 启元审计) */
静 剩系 末一二[剩伴一]; 静 整 上退;

/* 3. 值级 side-tables (v1.4 §10.1, 逆向定律库 §1-3/§5) */
#define 首吉 1000000  /* 预埋初始值: 激活前按编译 Git 全量最坏规模实测校准 (2026-08-25 启元审计) */
静 整 总子[首吉];      /* 所有权状态机: 0=普通 1=move后 2=不可变借用 3=可变借用 (int 一次给够, 对齐逆向定律库 §1) */
静 整 源粗[首吉];   /* lifetime 域编号: 0=函数级 1..N=显式 'a 域 */
静 整 计肆一[首吉];           /* 和类型判别式: 0..N-1 */
静 整 空对[首吉];         /* 类型变量编号: 0=非泛型 >0=第 N 个 */
静 整 段双[首吉];         /* 截断标记: 0=无 1=赋值截断 2=cast 截断 3=扩展 */

/* 4. 类型级 side-tables (逆向定律库 §4, 不内联 stypes — §11.1 冻结) */
#define 目低 4096  /* 与 stypes[4096] 对齐; stypes 扩容时同步 (2026-08-25 启元审计) */
静 整 左戊一[目低];    /* 范围下界 (-1=无界) */
静 整 半退三[目低];    /* 范围上界 (-1=无界) */
静 整 度散[目低]; /* 父类型 id (-1=无) */

/* 5. 分析结果缓存 (逆向定律库 §8, LLVM NewPM 定律 2) — 任意变换后全失效 (实战定) */
typedef 构 { 整 末丙; 整 *结果一; 整 结果数; 整 净合; } 间再;
#define 尾午一 64 /* 预埋初始值: 激活前按 Git 全量 pass/分析类型数实测校准 (2026-08-25 启元审计) */
静 间再 隔系一[尾午一]; 静 整 暂组;
静 整 左癸[尾午一][64]; /* result 指向 store 行 (固定容量, 无 malloc) */

/* 6. loopback 回边标记 (逆向定律库 §11) — 待大哥拍板, 拍板后加进 BLK: int loopback; */
#endif /* IR_PREBED_ACTIVE */

/* ==== -graph 旁路导出 (P0 工具侧闭环: graph_query.py 查询, 2026-08-25) ====
   旁路: 不插桩不影响编译行为, 仅编译完成后遍历 func_tbl/stypes + 调用记录导出 JSON */
静 整 旧又二 = 0; 静 字 末高[512] = "";
#define 空丙 20000
静 字 副薄[空丙][64]; 静 字 中二[空丙][64]; 静 整 外平;
静 空 原肆(常 字 *尾捌) {
    若 (!旧又二 || !当前函数名[0] || 外平 >= 空丙) 返;
    遍 (整 计 = 0; 计 < 外平; 计++) /* 去重: 同一 from→to 只记一次 (防 4000 上限被重复调用占满截断, 2026-08-25) */
        若 (!比较字符串(副薄[计], 当前函数名) && !比较字符串(中二[计], 尾捌)) 返;
    复制字符串(副薄[外平], 当前函数名);
    复制字符串(中二[外平], 尾捌);
    外平++;
}
静 空 副寅一(空) {
    若 (!旧又二 || !末高[0]) 返;
    FILE *文件 = 打开文件(末高, "wb");
    若 (!文件) { 输出到文件(错误流, "qcc_x86: cannot write graph %s\n", 末高); 返; }
    整 首 = 1;
    输出到文件(文件, "{\n\"entities\": [\n");
    遍 (整 计 = 0; 计 < 函数数; 计++) { 若 (!首) { 输出到文件(文件, ",\n"); } 首 = 0; 输出到文件(文件, "{\"id\":\"fn:%s\",\"name\":\"%s\",\"kind\":\"function\",\"line\":0}", 函数表[计].名, 函数表[计].名); }
    遍 (整 计 = 0; 计 < 类型数; 计++) {
        若 (!首) { 输出到文件(文件, ",\n"); } 首 = 0;
        输出到文件(文件, "{\"id\":\"st:%s\",\"name\":\"%s\",\"kind\":\"struct\",\"line\":0,\"fields\":[", 类型表[计].名, 类型表[计].名);
        遍 (整 乙 = 0; 乙 < 类型表[计].函; 乙++)
            输出到文件(文件, "\"%s\"%s", 类型表[计].正辰[乙], 乙 + 1 < 类型表[计].函 ? "," : "");
        输出到文件(文件, "]}");
    }
    输出到文件(文件, "\n],\n\"relations\": [\n");
    首 = 1;
    遍 (整 计 = 0; 计 < 外平; 计++) { 若 (!首) { 输出到文件(文件, ",\n"); } 首 = 0; 输出到文件(文件, "{\"from\":\"fn:%s\",\"to\":\"fn:%s\",\"kind\":\"calls\"}", 副薄[计], 中二[计]); }
    输出到文件(文件, "\n],\n\"layout_sensitive\": [\n");
    首 = 1;
    遍 (整 计 = 0; 计 < 类型数; 计++) {
        若 (!首) { 输出到文件(文件, ",\n"); } 首 = 0;
        常 字 *缺分; /* risk 阈值 (2026-08-25 审计定): 字段≥8 或 大小≥64 = high; 字段≥4 或 大小≥32 = medium; 否则 low */
        若 (类型表[计].函 >= 8 || 类型表[计].尺寸 >= 64) 缺分 = "high";
        否 若 (类型表[计].函 >= 4 || 类型表[计].尺寸 >= 32) 缺分 = "medium";
        否 缺分 = "low";
        输出到文件(文件, "{\"type\":\"st:%s\",\"name\":\"%s\",\"fields\":%d,\"risk\":\"%s\"}", 类型表[计].名, 类型表[计].名, 类型表[计].函, 缺分);
    }
    输出到文件(文件, "\n]\n}\n");
    关文件(文件);
    输出到文件(错误流, "[graph] %s 导出完成 (fn:%d st:%d calls:%d)\n", 末高, 函数数, 类型数, 外平);
}

/* ==== Phase 4 哈希审判: SHA-256 自举自证 (编译器编译完自动算产物哈希对账不动点, fail-closed; 补记13 法官上岗) ==== */
静 无 整 计零[64] = {0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
静 无 整 顺又(无 整 亥, 整 数) { 返 (亥 >> 数) | (亥 << (32 - 数)); }
静 空 右序(无 整 首一[8], 常 无 字 *指) {
    无 整 戌[64], 甲, 发字节, 字符, 元, 终, 文件, 庚, 初肆, 计, 虚利, 串七;
    遍 (计 = 0; 计 < 16; 计++) 戌[计] = ((无 整)指[计*4] << 24) | ((无 整)指[计*4+1] << 16) | ((无 整)指[计*4+2] << 8) | 指[计*4+3];
    遍 (计 = 16; 计 < 64; 计++) 戌[计] = 戌[计-16] + (顺又(戌[计-15], 7) ^ 顺又(戌[计-15], 18) ^ (戌[计-15] >> 3)) + 戌[计-7] + (顺又(戌[计-2], 17) ^ 顺又(戌[计-2], 19) ^ (戌[计-2] >> 10));
    甲 = 首一[0]; 发字节 = 首一[1]; 字符 = 首一[2]; 元 = 首一[3]; 终 = 首一[4]; 文件 = 首一[5]; 庚 = 首一[6]; 初肆 = 首一[7];
    遍 (计 = 0; 计 < 64; 计++) {
        虚利 = 初肆 + (顺又(终, 6) ^ 顺又(终, 11) ^ 顺又(终, 25)) + ((终 & 文件) ^ (~终 & 庚)) + 计零[计] + 戌[计];
        串七 = (顺又(甲, 2) ^ 顺又(甲, 13) ^ 顺又(甲, 22)) + ((甲 & 发字节) ^ (甲 & 字符) ^ (发字节 & 字符));
        初肆 = 庚; 庚 = 文件; 文件 = 终; 终 = 元 + 虚利; 元 = 字符; 字符 = 发字节; 发字节 = 甲; 甲 = 虚利 + 串七;
    }
    首一[0] += 甲; 首一[1] += 发字节; 首一[2] += 字符; 首一[3] += 元; 首一[4] += 终; 首一[5] += 文件; 首一[6] += 庚; 首一[7] += 初肆;
}
静 空 链伍(常 字 *路径, 字 出[65]) {
    无 整 首一[8]; 无 字 缓[64], 容吉[128]; 整 计, 乙, 数, 参数数;
    无 长 长 链玖 = 0, 符弊; FILE *文件 = 打开文件(路径, "rb");
    首一[0]=0x6a09e667; 首一[1]=0xbb67ae85; 首一[2]=0x3c6ef372; 首一[3]=0xa54ff53a; 首一[4]=0x510e527f; 首一[5]=0x9b05688c; 首一[6]=0x1f83d9ab; 首一[7]=0x5be0cd19;
    若 (!文件) { 出[0] = 0; 返; }
    循环 ((数 = (整)读取(缓, 1, 64, 文件)) == 64) { 右序(首一, 缓); 链玖 += 64; }
    复制内存(容吉, 缓, 数); 参数数 = 数; 容吉[参数数++] = 0x80;
    循环 ((参数数 & 63) != 56) 容吉[参数数++] = 0;
    符弊 = (链玖 + (无 长 长)数) * 8;
    遍 (计 = 0; 计 < 8; 计++) 容吉[参数数++] = (无 字)(符弊 >> (56 - 8 * 计));
    遍 (计 = 0; 计 < 参数数; 计 += 64) 右序(首一, 容吉 + 计);
    关文件(文件);
    遍 (计 = 0; 计 < 8; 计++) 遍 (乙 = 0; 乙 < 4; 乙++) {
        无 整 反挂 = (首一[计] >> (24 - 8 * 乙)) & 0xFF;
        出[计 * 8 + 乙 * 2] = "0123456789abcdef"[反挂 >> 4];
        出[计 * 8 + 乙 * 2 + 1] = "0123456789abcdef"[反挂 & 15];
    }
    出[64] = 0;
}

/* 接入 2026-08-28 AI原生 #5: 文件级哈希增量编译 — 内存 SHA256 (缓存键) + 文件拷贝 + sidecar 缓存读写 */
静 空 深伴(常 字 *数据, 整 长度一, 字 出[65]) {
    无 整 首一[8]; 无 字 容吉[128]; 整 计, 乙, 数, 参数数; 无 长 长 链玖 = 0, 符弊;
    首一[0]=0x6a09e667; 首一[1]=0xbb67ae85; 首一[2]=0x3c6ef372; 首一[3]=0xa54ff53a; 首一[4]=0x510e527f; 首一[5]=0x9b05688c; 首一[6]=0x1f83d9ab; 首一[7]=0x5be0cd19;
    循环 (长度一 >= 64) { 右序(首一, (常 无 字 *)数据); 数据 += 64; 长度一 -= 64; 链玖 += 64; }
    数 = 长度一; 复制内存(容吉, 数据, 数); 参数数 = 数; 容吉[参数数++] = 0x80;
    循环 ((参数数 & 63) != 56) 容吉[参数数++] = 0;
    符弊 = (链玖 + (无 长 长)数) * 8;
    遍 (计 = 0; 计 < 8; 计++) 容吉[参数数++] = (无 字)(符弊 >> (56 - 8 * 计));
    遍 (计 = 0; 计 < 参数数; 计 += 64) 右序(首一, 容吉 + 计);
    遍 (计 = 0; 计 < 8; 计++) 遍 (乙 = 0; 乙 < 4; 乙++) {
        无 整 反挂 = (首一[计] >> (24 - 8 * 乙)) & 0xFF;
        出[计 * 8 + 乙 * 2] = "0123456789abcdef"[反挂 >> 4];
        出[计 * 8 + 乙 * 2 + 1] = "0123456789abcdef"[反挂 & 15];
    }
    出[64] = 0;
}
静 整 池薄一(常 字 *堆乙, 常 字 *整汇) { 字 *元 = 逆平一(堆乙); 若 (!元) 返 0; 整 数 = (整)取字长(元); FILE *文件 = 打开文件(整汇, "wb"); 若 (!文件) { 释放内存(元); 返 0; } 整 戌 = (整)写入(元, 1, 数, 文件); 关文件(文件); 释放内存(元); 返 戌 == 数; }
静 空 短浅(常 字 *输出文件, 字 *缓, 整 终凶) { 拷贝前n(缓, 输出文件, 终凶 - 8); 缓[终凶 - 8] = 0; 拼接(缓, ".qcckey"); }
静 整 旧三(常 字 *输出文件) { 字 缓甲[540]; 短浅(输出文件, 缓甲, 大小(缓甲)); 字 *键 = 逆平一(缓甲); 若 (!键) 返 0; 整 央 = !比较字符串(键, 双降); 释放内存(键); 返 央; }
静 空 满贰一(常 字 *输出文件) { 字 缓甲[540]; 短浅(输出文件, 缓甲, 大小(缓甲)); FILE *文件 = 打开文件(缓甲, "wb"); 若 (文件) { 写入(双降, 1, 64, 文件); 关文件(文件); } }

/* 接入 2026-08-28 AI原生 #6 (可吞清单 P0-6): 编译检查点 — 崩溃尸检 post-mortem (进度快照落盘, 数据留底不死不灭; Turn P0-4 快照的 qcc 版) */
静 空 长叁(常 字 *行一) { 若 (!堆低一 || !暂寅[0]) 返; FILE *文件 = 打开文件(暂寅, "ab"); 若 (!文件) 返; 写入(行一, 1, 取字长(行一), 文件); 写字符('\n', 文件); 刷新缓冲(文件); 关文件(文件); } /* 每条快照独立开/写/刷/关 — 崩溃时已刷盘的行即现场 (缓冲丢失=尸检失效) */

/* 接入 2026-08-28 AI原生 9b: 编译器资源护栏 — 编译期水位报告 (AI 可读 JSON, 可吞清单 P0-9b) */
静 整 初汇 = 0; /* --budget */
/* 接入 2026-08-28 可吞清单 P0-9: 编译 DAG 重放证明 — 过程级哈希 (源码→token→AST→产物 每阶段哈希入链, 编译过程可重放可验证; 自举证明从产物级升级为过程级) */
静 空 内巳(空) { 若 (!总置) 返; 字 首利二[65], 计简一[65], 反对一[65], 计低[65], 终再[300]; 若 (词序 > 0) 深伴((常 字*)词型表, 词序 * 4, 首利二); 否 复制字符串(首利二, "0"); 若 (词序 > 0) 深伴((常 字*)词值表, 词序 * 4, 计简一); 否 复制字符串(计简一, "0"); 若 (词序 > 0) 深伴((常 字*)词名表, 词序 * 64, 反对一); 否 复制字符串(反对一, "0"); 若 (词序 > 0) 深伴((常 字*)词行表, 词序 * 4, 计低); 否 复制字符串(计低, "0"); 格式化到串(终再, "%s%s%s%s", 首利二, 计简一, 反对一, 计低); 深伴(终再, 256, 素细); }
静 空 暂卯(空) { 若 (!总置) 返; 字 首利二[65], 计简一[65], 反对一[65], 计低[65], 满肆[65], 终再[340];
    若 (接子数 > 0) 深伴((常 字*)节型表, 接子数 * 4, 首利二); 否 复制字符串(首利二, "0");
    若 (接子数 > 0) 深伴((常 字*)节值表, 接子数 * 4, 计简一); 否 复制字符串(计简一, "0");
    若 (接子数 > 0) { 字 *新三 = 内存分配((长 长)接子数 * 64 + 16); 整 直失 = 0; 遍 (整 计 = 0; 计 < 接子数 && 直失 < (整)((长 长)接子数 * 64 - 16); 计++) { 整 段玖 = (整)取字长((字*)(节名表 + 计)); 复制内存(新三 + 直失, (字*)(节名表 + 计), 段玖); 直失 += 段玖; 新三[直失++] = 0x1F; } 深伴(新三, 直失, 反对一); 释放内存(新三); } 否 复制字符串(反对一, "0"); /* nn 按名哈希 (截 NUL): 节点名槽内部有 ASLR 相关历史尾字节 (功能无害, codegen 按 NUL 读) — 语义内容才入链, 保证确定性 */
    若 (接子数 > 0) 深伴((常 字*)子0, 接子数 * 4, 计低); 否 复制字符串(计低, "0");
    若 (接子数 > 0) 深伴((常 字*)子1, 接子数 * 4, 满肆); 否 复制字符串(满肆, "0");
    格式化到串(终再, "%s%s%s%s%s", 首利二, 计简一, 反对一, 计低, 满肆); 深伴(终再, 320, 直八);
}
/* 接入 2026-08-28 可吞清单 P1 (MoonBit #4 接口文件 + Agint #14 结构化工件): 接口文件导出 — --interface 解析后导出 API 表面 JSON (AI 读接口不读实现, 直击 SWE-AGI '读代码瓶颈') */
静 整 暂厚 = 0; /* --interface */
静 常 字 *帧得(整 变序) { 若 (变量表[变序].是否浮标) 返 "double"; 若 (变量表[变序].是否长标) 返 "longlong"; 若 (变量表[变序].是否字符标) 返 "char"; 若 (变量表[变序].无符号标) 返 "unsigned"; 若 (变量表[变序].指元素尺寸 > 0) 返 "ptr"; 若 (变量表[变序].型序标 >= 0) 返 "struct"; 若 (变量表[变序].数组尺寸 > 0) 返 "array"; 返 "int"; }
静 常 字 *现序(常 字 *函) { 整 实卯 = 查返回名(函); 若 (实卯 >= 0) { 静 字 总五[96]; 格式化到串(总五, "struct %s", 类型表[实卯].名); 返 总五; } 若 (查返回名指(函)) 返 "ptr"; 若 (查函数长返(函)) 返 "longlong"; 若 (查函数浮返(函)) 返 "double"; 返 "int"; }
静 空 容一(空) { /* 接口文件 (AI 可消费 JSON): 函数签名/参数/返回 + 结构体/typedef/全局/枚举 — 解析期表导出, 不产码 */
    格式化打印("{\"interface\":{");
    格式化打印("\"functions\":[");
    整 总柒 = 1;
    遍 (整 计 = 0; 计 < 函数定义数; 计++) {
        整 字符 = 函数定义表[计];
        若 (字符 <= 0) 续;
        字 *函 = (字*)(节名表 + 字符);
        整 净乙三 = (计 < 65536) ? 新寅[计] : 0, 短进 = (计 < 65536) ? 总甲[计] : 0;
        格式化打印("%s{\"name\":\"%s\",\"defined\":true,\"line\":%d,\"params\":[", 总柒 ? "" : ",", 函, (计 < 1024) ? 号平[计] : 0);
        整 余系 = 0;
        遍 (整 变序 = 净乙三; 变序 < 短进 && 变序 >= 0; 变序++) 若 (变量表[变序].素三) { 格式化打印("%s{\"name\":\"%s\",\"type\":\"%s\"}", 余系 ? "," : "", 变量表[变序].名, 帧得(变序)); 余系++; }
        格式化打印("],\"ret\":\"%s\"}", 现序(函));
        总柒 = 0;
    }
    遍 (整 丁序 = 0; 丁序 < 声明数; 丁序++) { 整 余细 = 0; 遍 (整 计 = 0; 计 < 函数定义数; 计++) 若 (函数定义表[计] > 0 && !比较字符串((字*)(节名表 + 函数定义表[计]), 串升一[丁序])) { 余细 = 1; 断; } 若 (!余细) { 格式化打印("%s{\"name\":\"%s\",\"defined\":false}", 总柒 ? "" : ",", 串升一[丁序]); 总柒 = 0; } } /* declare 声明未实现的骨架 */
    格式化打印("]");
    格式化打印(",\"structs\":[");
    整 反伴 = 1;
    遍 (整 构序 = 0; 构序 < 类型数; 构序++) {
        若 (类型表[构序].名[0] == 0 || 类型表[构序].尺寸 <= 0) 续;
        格式化打印("%s{\"name\":\"%s\",\"size\":%d,\"fields\":[", 反伴 ? "" : ",", 类型表[构序].名, 类型表[构序].尺寸);
        遍 (整 文件 = 0; 文件 < 类型表[构序].函; 文件++) 格式化打印("%s{\"name\":\"%s\",\"off\":%d,\"size\":%d%s}", 文件 ? "," : "", 类型表[构序].正辰[文件], 类型表[构序].正聚[文件], 类型表[构序].现捌[文件], 类型表[构序].原进[文件] ? ",\"ptr\":true" : "");
        格式化打印("]}");
        反伴 = 0;
    }
    格式化打印("]");
    格式化打印(",\"typedefs\":[");
    整 满庚 = 1;
    遍 (整 词序 = 0; 词序 < 型定数; 词序++) { 格式化打印("%s{\"name\":\"%s\",\"sz\":%d%s}", 满庚 ? "" : ",", 型定表[词序].名, 型定表[词序].尺寸, 型定表[词序].是否构标 ? ",\"struct\":true" : ""); 满庚 = 0; }
    格式化打印("]");
    格式化打印(",\"globals\":[");
    整 隔列 = 1;
    遍 (整 变序 = 0; 变序 < 变量数; 变序++) 若 (变量表[变序].是否静态标 && !静态关键[变序]) { 格式化打印("%s{\"name\":\"%s\",\"type\":\"%s\",\"size\":%d}", 隔列 ? "" : ",", 变量表[变序].名, 帧得(变序), 变量表[变序].指元素尺寸 > 0 ? 8 : (变量表[变序].数组尺寸 > 0 ? 变量表[变序].数组尺寸 : (变量表[变序].是否长标 || 变量表[变序].是否浮标) ? 8 : 变量表[变序].是否字符标 ? 1 : 4)); 隔列 = 0; }
    格式化打印("]");
    格式化打印(",\"enums\":[");
    整 主联 = 1;
    遍 (整 戊序 = 0; 戊序 < 暂肆; 戊序++) { 格式化打印("%s{\"name\":\"%s\",\"val\":%d}", 主联 ? "" : ",", 堆九一[戊序].名, 堆九一[戊序].数值); 主联 = 0; }
    格式化打印("]");
    格式化打印("}}\n");
}
/* 接入 2026-08-28 可吞清单 P1 (参考 MoonBit 语义导航, 甲言化: 引用收集): --refs 谁引用了 X — prim VR 名 token 处记录 (名, 用户行), 读/写/调用全覆盖; AI 查调用点/使用点不翻全文件 */
静 整 双贰 = 0; 静 构 { 字 名[64]; 整 堆丑[64]; 整 数; } refs[4096];
静 空 标进(常 字 *数, 整 行一) { /* 引用登记 (按名去重, 行去重) */
    若 (!新六 || !数 || !数[0]) 返;
    整 度转 = 行一 - (剩伴 ? 剩伴 : 反进); 若 (度转 < 1) 度转 = 1;
    遍 (整 计 = 0; 计 < 双贰; 计++) 若 (!比较字符串(refs[计].名, 数)) {
        遍 (整 键 = 0; 键 < refs[计].数; 键++) 若 (refs[计].堆丑[键] == 度转) 返;
        若 (refs[计].数 < 64) refs[计].堆丑[refs[计].数++] = 度转;
        返;
    }
    若 (双贰 < 4096) { 复制字符串(refs[双贰].名, 数); refs[双贰].堆丑[0] = 度转; refs[双贰].数 = 1; 双贰++; }
}
静 空 总升一(空) { /* 引用表导出 (AI 可消费 JSON): {"refs":[{"name":"X","sites":[行,...]},...]} */
    格式化打印("{\"refs\":[");
    遍 (整 计 = 0; 计 < 双贰; 计++) {
        格式化打印("%s{\"name\":\"%s\",\"sites\":[", 计 ? "," : "", refs[计].名);
        遍 (整 键 = 0; 键 < refs[计].数; 键++) 格式化打印("%s%d", 键 ? "," : "", refs[计].堆丑[键]);
        格式化打印("]}");
    }
    格式化打印("]}\n");
}
/* 接入 2026-08-28 可吞清单 P1 (Agint flight-recorder 参考, 甲言化: 编译黑匣子): 每函数代码增量哈希帧 — 自举分歧时逐帧 diff 定位首个分歧函数 (黑匣子只读记录, 数据留底不死不灭); 全局声明在顶部 (gen_code 用) */
静 空 段弊(常 字 *行一) { 若 (!整再 || !元零[0]) 返; FILE *文件 = 打开文件(元零, "ab"); 若 (!文件) 返; 写入(行一, 1, 取字长(行一), 文件); 写字符('\n', 文件); 刷新缓冲(文件); 关文件(文件); } /* 独立开/写/刷/关 — 崩溃时已刷盘行即现场 */
静 空 存重(常 字 *函) { /* 每函数代码增量哈希帧: sha256(code[rec_prev_cp..cp)) — 增量 O(n) 总量, 分歧定位到函数级 */
    若 (!整再) 返;
    整 目壹一 = 码位;
    若 (目壹一 > 帧又) {
        字 首一[65]; 深伴((常 字*)码 + 帧又, 目壹一 - 帧又, 首一);
        字 原降[160]; 格式化到串(原降, "{\"pass\":%d,\"fn\":\"%s\",\"delta\":\"%.16s\",\"cp\":%d}", 素凶, 函, 首一, 目壹一);
        段弊(原降);
    }
    帧又 = 目壹一;
}

/* 接入 2026-08-28 AI原生 9b: 编译器资源护栏 — 编译期水位报告 (AI 可读 JSON, 可吞清单 P0-9b) */
静 空 存八(空) {
    格式化打印("{\"budget\":["
      "{\"name\":\"macros\",\"used\":%d,\"cap\":4096},"
      "{\"name\":\"fn_macros\",\"used\":%d,\"cap\":2048},"
      "{\"name\":\"obj_macros\",\"used\":%d,\"cap\":8192},"
      "{\"name\":\"funcs\",\"used\":%d,\"cap\":65536},"
      "{\"name\":\"vars\",\"used\":%d,\"cap\":65536},"
      "{\"name\":\"tokens\",\"used\":%d,\"cap\":%d},"
      "{\"name\":\"ast_nodes\",\"used\":%d,\"cap\":%d},"
      "{\"name\":\"labels\",\"used\":%d,\"cap\":131072},"
      "{\"name\":\"strings\",\"used\":%d,\"cap\":65536},"
      "{\"name\":\"typedefs\",\"used\":%d,\"cap\":512},"
      "{\"name\":\"discriminants\",\"used\":%d,\"cap\":256},"
      "{\"name\":\"borrowed\",\"used\":%d,\"cap\":256},"
      "{\"name\":\"moved\",\"used\":%d,\"cap\":256},"
      "{\"name\":\"declares\",\"used\":%d,\"cap\":256}"
      "]}\n",
      宏数, 函数宏数, 栈凶, 函数数, 变量数, 词序, 词容量, 接子数, 节容量, 初成, 串数, 深平, 链平, 素寅, 正次, 声明数);
}

/* 接入 2026-08-28 AI原生编译器 #6 可重入无状态核心 (大哥定 地基打桩第二桩): 编译核心函数化 — 每次调用独立分配 token/AST 数组 + 独立编译, 同进程可多次调用 (编译服务器/增量/并行前置) */
字 *堆辛(常 字 *源) { /* 可嵌入: rt 拼接封装 (fix 2026-08-28 大哥验收: reset 清宏 + 时序 → rt 守卫失效 → rt 实现剃光 → 嵌入产物缺代码段崩) — main 与 qcc_embed_driver 共用; 多路径搜索: 相对 cwd + 可执行文件目录 (Windows GetModuleFileName) */
    字 *度退 = 逆平一("srclib/qcc_rt.c");
    若 (!度退) 度退 = 逆平一("qcc_rt.c");
    若 (!度退) { 字 标未[1024]; 双字 邻壬 = GetModuleFileNameA(NULL, 标未, 1023); 若 (邻壬 > 0) { 字 *槽长 = 反向查(标未, '/'); 字 *余庚 = 反向查(标未, '\\'); 字 *末一 = 槽长 && 余庚 ? (槽长 > 余庚 ? 槽长 : 余庚) : (槽长 ? 槽长 : 余庚); 若 (末一) { *末一 = 0; 字 外庚[1024]; 复制字符串(外庚, 标未); 拼接(外庚, "/srclib/qcc_rt.c"); 度退 = 逆平一(外庚); 若 (!度退) { 复制字符串(外庚, 标未); 拼接(外庚, "/qcc_rt.c"); 度退 = 逆平一(外庚); } } } }
    若 (!度退) 返 NULL;
    整 旁戊 = (整)取字长(度退);
    串双 = 旁戊; /* 2026-08-28 loc.line: rt 长度 (parse 前算 rt_exp_lines) */
    整 累加低 = (整)取字长(源);
    宏加("QCC_RT_PREPENDED", 1); /* 标记 rt 已预置 — qcc_rt.c 守卫认此宏 */
    反进 = 1; 遍 (整 原排 = 0; 原排 < 旁戊; 原排++) 若 (度退[原排] == '\n') 反进++; /* 行号校正 */
    字 *元二一 = 内存分配((旁戊 + 累加低 + 5 + 16) & ~3);
    复制内存(元二一, 度退, 旁戊);
    元二一[旁戊] = '\n';
    复制内存(元二一 + 旁戊 + 1, 源, 累加低);
    元二一[旁戊 + 1 + 累加低] = 0;
    释放内存(度退);
    返 元二一;
}
静 空 终子(空) { /* 接入 2026-08-28 AI原生 #6: 重置跨编译累积的静态全局表 (parse 已重置 tk/vcnt/fdef_n/tt 等; 这里补宏/类型/字符串/函数/机制层/static槽/位域/声明/枚举/typedef/判别/double表) */
    宏数 = 0; 函数宏数 = 0; 栈凶 = 0; 全局初始化数 = 0; 函数数 = 0; 串数 = 0; 虚五 = 0; 类型数 = 0;
    静态数 = 0; 位槽 = -1; 位位 = 0; /* static 槽计数 + 位域打包状态 — 跨编译累积必须重置 */
    声明数 = 0; 深平 = 0; 暂肆 = 0; 链平 = 0; 型定数 = 0; 浮数 = 0; /* declare声明表 + typedef名 + 枚举常量 + 判别表 + typedef定义 + double常量表 */
    顺一 = 0; 条件计数 = 0; 外系 = 0; 条件编译数 = 0; /* lex 预处理条件编译栈 */
    净乙 = 0; /* fix 2026-08-28 可重入根因: vs_n() = vs_end?vs_end:vcnt — vs_end 残留(上次 codegen 的 fve[gfn]) → 第二次 parse 期 var_offset REUSE 搜索越界 → 复用 vars[169] 超出 vcnt → codegen DCL-MISS。parse 期必须 vs_end=0 (vs_n()=vcnt) */
    素寅 = 0; 计贰 = 0; 正次 = 0; 首己 = 0; 目系 = 0; 目凶一 = 0; 遍 (整 首戌 = 0; 首戌 < 256; 首戌++) 度平[首戌] = -1; /* 2026-08-28 type-root-3 NLL: reset */
    顺汇 = 0; 净丙 = 0; 旧辛 = 0; 序集 = 0; 逆汇 = 0;
    虚陆 = 0; 缺五 = 0; 直十 = 0; 实二 = -1;
    错误函数 = 0; 外优 = 0; 满从 = -1; 右陆 = 0; 当申 = 0; 内存设置(实重, 0, 大小(实重)); 长八 = 0; /* type-root-7 #101 */ 列散 = 0; 实现数 = 0; /* type-root-8 #114 */ 计退 = 0; 内存设置(目肆, 0, 大小(目肆)); /* type-root-10 #278 */ 列散 = 0; 实现数 = 0; /* type-root-8 #114 */ /* 2026-08-28 type-root-2 */ /* 2026-08-28 type-root-fix: reset pending tok too */ /* 类型根治① (2026-08-28): 可空表每编译重置 */
    内乙 = 2; 新集一 = 0; 余陆 = 0; 行巳 = 0; /* fix 2026-08-28 可重入漏洞: 临时名/extern 槽计数器跨编译累积 — extern 负偏移地址泄漏 + 临时名后缀漂移 → 进程内第 2 次编译产物 ≠ 第 1 次 (--repeat 只验 2..N 自洽, 漏首 vs 次) */
    素凶 = 0; 帧又 = 0; /* 黑匣子: pass 帧序每编译重置 (跨编译累积 → 分歧定位错帧) */
    虚己 = 0; 函浮数 = 0; 函返名数 = 0; 内丑一 = 0; 帧叁 = 0; /* fix 2026-08-28 可重入: 函数签名名表跨编译累积 → fn_ll_get 命中旧条目 → 参数压栈选错 (I_PUSH_RAX vs I_PUSH_R64_RAX) → 进程内第 2 次编译产物 ≠ 第 1 次 */
    空失 = 0; 总得 = 0; 满己 = 0; /* fix 2026-08-28 可重入: IR 指令缓冲/coff 重定位残留 — ir_flush 只在表达式末尾清, 若上次编译末尾有未 flush IR → 下次首个 flush 发射残留指令 (首个函数代码多指令) */
    双贰 = 0; /* 引用表每编译重置 */
