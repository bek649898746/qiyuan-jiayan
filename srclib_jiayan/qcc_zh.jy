静 整 是保留函名(常 字 *名) {
    遍 (整 计 = 0; 计 < (整)(大小(保留函名表) / 大小(保留函名表[0])); 计++)
        若 (!比较字符串(保留函名表[计], 名)) 返 1;
    返 0;
}
静 整 度卯(常 字 *数) {
    遍 (整 计 = 0; 计 < (整)(大小(后聚) / 大小(后聚[0])); 计++)
        若 (!比较字符串(后聚[计], 数)) 返 1;
    返 0;
}
静 整 查函数(常 字 *名) {
    遍 (整 计 = 0; 计 < 函数数; 计++)
        若 (!比较字符串(函数表[计].名, 名)) 返 计;
    若 (函数数 >= 65536) { 输出到文件(错误流, "[ERR] 函数表 满 %d (%s)\n", 函数数, 名); 退出(1); } /* 修复 2026-08-16 根因E3: 原 1024 守卫与 2048 容量错配 → 返 -1 → 调用点 函数表[-1] 越界写崩 (属性.c); 改满则硬退, 绝不返 -1 */
    复制字符串(函数表[函数数].名, 名);
    函数表[函数数].标号一 = 新标号();
    函数表[函数数].序布 = 0;
    函数表[函数数].间拆 = 0; /* 修复 2026-08-30 探雷雷3: 新条目默认未声明 — 原型/声明 登记处置 1 (原 已声明 残留跨编译污染) */
    函数表[函数数].返构序 = -1; /* 非-结构体 返回 由 缺省 */
    返回型序表[函数数] = -1; 素二一[函数数] = 0; /* 修复 2026-09-17 free_fn 族根治: get-or-create 新条目 必须清 索引-based 返回类型表 — 生成码 的函数数=0 复位 使 函数表索引 被复用, 前一轮 残留 脏值 (如 0 → 类型表[0]=88B 结构体) 会让 「名表无记录 的未知名」 经 返回型序表[己序] 回退 取得 别的函数的 返回结构体 → 源子(sret) 误判 → 函数指针调用 被发成 直接调用 (中调用标号 函数表[己序].标号一) → 段丑 → 首利 写 未定义外部符号 (free_fn/strbuf_add/hash_algos 等 35 个多余外部引用) */
    函数表[函数数].返接口 = -1; /* 阶段C-1 #116 impl Trait: 返回实现接口索引 (-1=无) */
    函数表[函数数].返错 = 0; /* 显式 G1 (2026-09-06): 错误联合返回 属性 (-1/0=普通, 1=错误返回) */
    函数表[函数数].错误码起点 = 0; 函数表[函数数].错误码数 = 0; /* 攻坚 2026-09-07: 错 N 码集 池区间 (默认空) */
    返 函数数++;
}
/* user labels 遍 跳转: 末丙 已分配 一旦 于 解析 (经 新标号), 故 通过 1/2 agree */
静 构 { 字 名[64]; 整 末丙; } 行得[512]; 静 整 计辛;
静 整 元败(常 字 *数) {
    遍 (整 计 = 0; 计 < 计辛; 计++) 若 (!比较字符串(行得[计].名, 数)) 返 行得[计].末丙;
    返 -1;
}
静 整 暂回(常 字 *数) {
    遍 (整 计 = 0; 计 < 计辛; 计++) 若 (!比较字符串(行得[计].名, 数)) 返 行得[计].末丙;
    若 (计辛 >= 512) 返 -1;
    复制字符串(行得[计辛].名, 数);
    行得[计辛].末丙 = 新标号();
    返 行得[计辛++].末丙;
}
枚 { 词终=0, 顺轮, 型词, 常数, 净吉=4, 加=5, 减=6, 乘=7, 高平=8, 下得一=9, 顺八=10, 下双=11, 后甲=12, 度序=13, 逗号=14, 分号=15, 赋号=16, 左括=17, 右括=18, 左花=19, 右花=20, 终附=21, 元九=22, 首降=23, 虚伍=24, 点=25, 词变量=26, 句点=27, 箭头=28, 串词=29, 结构词=30, 左方=31, 右方=32, 枚词=33, 标利=34, 开关=35, 案例=36, 缺省=37, 冒号=38, 逻辑与=39, 逻辑或=40, 总零=41, 除=42, 取余=43, 左移=44, 右移=45, 与=46, 或=47, 异或=48, 按位非=49, 下退一=50, 加等=51, 减等=52, 乘等=53, 除等=54, 或等=55, 与等=56, 异或等=57, 右移一=58, 左移一=59, 问号=60, 增增=61, 减减=62, 副丁=63, 大于=64, 终简=65, 隔伍=66, 容吉一=67, 满酉=68, 直联=69, 满再一=70, 长粗=71 }; /* 容吉一=_Alignof (修复 2026-08-25 支持矩阵补全 步一); 满酉=_Generic (步六); 直联=_Alignas (修复 步二十一: 携带对齐值, 解析器 消费); 隔伍=%= (修复 2026-08-05: %= 先前 lexed 作为 取余+赋号 → 复合-赋值 永不 首组); 长粗=?. 可选链 (接入 2026-08-28) */

#define 词容量 2097152 /* 修复 2026-08-09 审计#13: 262144→524288 镜像自举容量 */
静 整 *词型表, *词值表; 字 (*词名表)[64]; 字 (*节名表)[64]; 整 词序, 词位; /* 词名表=词元 名, 节名表=节点 名 (必须 是 separate �?它们 collide! 节点 索引 == 词元 索引 破坏) */
/* ═══ 第 230 站 (2026-09-21 · R230)：**内联匿名体收尾** 单点收口 ═══
   病根：同一段「内联体闭合 → 指针层 → 字段名 → 数组维度 → 字段登记」在三份解析块各写一遍，
    ② 具名有指针分支（2026-08-22 t41b），③ typedef / ④ 文件级匿名**都没有** ⟹
    `struct { … } *entry;` 的内联体后 `*` 无人消费 ⟹ 词位停在 `*` ⟹ 字段整条未登记。
   本刀收成一份；下次改「内联体字段收尾」语义只改这里。
   返 1 = 已消费；返 0 = 未处理（无变量名/其他形态），交调用方后续分支。
   注：② 具名块（L17609）**未并入** —— 它的同段末尾挂着 `否 { C11 无名匿名成员 }` 分支，
     整段替换会改动控制流；它是已正确的实现，留待将来与 `否` 分支一起拆解时合并。
   参数 联合标：置 1 时走 `联合字段`（偏移强制 0），供将来并入 ② 用。 */
静 整 匿体收尾(整 构序, 整 匿构序, 整 联合标) {
    若 (词型表[词位] == 右花) 词位++; /* } */
    类型定型(匿构序);
    整 基尺 = 类型表[匿构序].尺寸;
    若 (词型表[词位] == 乘) { /* 指针字段 —— 原 ③④ 缺此分支 */
        整 指层 = 0;
        循环 (词型表[词位] == 乘) { 指层++; 词位++; }
        若 (词型表[词位] == 词变量) {
            字 源酉[64]; 复制字符串(源酉, 词名表[词位]); 词位++;
            整 序败 = 1; /* 指针数组 `构 { … } *arr[4];` —— 原只当单指针 (漏维度) ⟹ 布局少 24 字节 */
            循环 (词型表[词位] == 左方) { 词位++; 若 (词型表[词位] == 常数) { 若 (维长数 < 4) 维长表[维长数++] = 词值表[词位]; 序败 *= 词值表[词位]; 词位++; }
                否 若 (词型表[词位] == 词变量) { 整 评测数 = 全回(词名表[词位]); 若 (评测数 == 0x80000000) 评测数 = 域零(词名表[词位]);
                    若 (评测数 != 0x80000000 && 评测数 != -1) 序败 *= 评测数; 词位++; }
                若 (词型表[词位] == 右方) 词位++; }
            标合 = 8; /* 指针恒 8 字节对齐（覆盖内层结构体的自然对齐，内层不含指针时为 4） */
            若 (联合标) { 联合字段(构序, 源酉, 8 * 序败, 基尺); 字段类型(构序, 源酉, 匿构序); }
            否 字段登记(构序, 源酉, 8 * 序败, 8, 匿构序, 8);
            整 序尾 = 类型表[构序].函 - 1;
            类型表[构序].字段[序尾].原进 = 1;
            类型表[构序].字段[序尾].符肆 = 指层 > 1 ? 8 : 基尺;
            类型表[构序].字段[序尾].主挂 = 基尺;
            类型表[构序].字段[序尾].高贰 = (字)指层;
            若 (词型表[词位] == 分号) 词位++;
            返 1;
        }
        返 0;
    }
    若 (词型表[词位] == 词变量) {
        字 源酉[64]; 复制字符串(源酉, 词名表[词位]); 词位++;
        整 序败 = 1;
        循环 (词型表[词位] == 左方) { 词位++; 若 (词型表[词位] == 常数) { 若 (维长数 < 4) 维长表[维长数++] = 词值表[词位]; 序败 *= 词值表[词位]; 词位++; }
            否 若 (词型表[词位] == 词变量) { 整 评测数 = 全回(词名表[词位]); 若 (评测数 == 0x80000000) 评测数 = 域零(词名表[词位]);
                若 (评测数 != 0x80000000 && 评测数 != -1) 序败 *= 评测数; 词位++; }
            若 (词型表[词位] == 右方) 词位++; }
        若 (匿构序 >= 0) 标合 = 类型表[匿构序].满卯; /* 嵌套对齐 (2026-09-13) */
        若 (联合标) { 联合字段(构序, 源酉, 基尺 * 序败, 基尺); 字段类型(构序, 源酉, 匿构序); }
        否 字段登记(构序, 源酉, 基尺 * 序败, 基尺, 匿构序, 匿构序);
        若 (词型表[词位] == 分号) 词位++;
        返 1;
    }
    若 (词型表[词位] == 分号) 词位++;
    返 0;
}

静 空 数组维度累(整 *维数, 整 *副次, 整 *新尺寸) { /* S4+S5 批次 B 收口 (2026-09-29 · 第 377 站):
    字段解析族「数组维度累加」—— 原 7 处逐字同文 (L4765/4801/18542/18571/18698/18735/19072;
    宿主 = 体注册() 与 解析() 的各字段解析路径).
    语义: 消费 `[维]` `[维]` … 序列 —— 常数维 取 词值表, 词变量维 取 全回()/域零() 求值 (0x80000000/-1 视为未知)
    ⟹ 累乘入 新尺寸, 首维 记入 副次 (供调用方算 行宽).
    三个状态量用**指针**传入 (调用点局部变量: 维数一/副次/新尺寸) —— 前置已实测 甲言 指针参数 + `(*a)++` + `*c *= v` 均正确.
    ⚠️ 同族**未并**的变体 (见 scratch_c1b2/b7_scan.txt): 「域维数/隔午」版 3 处 (L18613/18793/19133) ·
       「仅跳过不累加」版 3 处 (L18161/19203/19777) —— 语义不同, 勿混并. */
    循环 (词型表[词位] == 左方) {
        词位++;
        若 (词型表[词位] == 常数) {
            若 (*维数 == 0) *副次 = 词值表[词位];
            若 (维长数 < 4) 维长表[维长数++] = 词值表[词位];
            (*维数)++; *新尺寸 *= 词值表[词位]; 词位++;
        } 否 若 (词型表[词位] == 词变量) {
            整 评测数二 = 全回(词名表[词位]);
            若 (评测数二 == 0x80000000) 评测数二 = 域零(词名表[词位]);
            若 (评测数二 != 0x80000000 && 评测数二 != -1) { 若 (*维数 == 0) *副次 = 评测数二; 若 (维长数 < 4) 维长表[维长数++] = 评测数二; (*维数)++; *新尺寸 *= 评测数二; }
            词位++;
        }
        若 (词型表[词位] == 右方) 词位++;
    }
}

静 空 枚词体跳过(空) { /* S4+S5 批次 B 收口 (2026-09-29 · 第 376 站): 字段解析族「枚举(枚词) 成员体跳过」——
