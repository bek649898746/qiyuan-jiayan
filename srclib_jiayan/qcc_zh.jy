/* RIP-relative .data access for static vars: [rip+disp] */
静 空 移eax内存(整 位移) { 汇发("    取静32 eax, [rip%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x8B); 发字节(0x05); 发四(位移); }            /* mov eax, [rip+disp] */
静 空 终拆(整 位移) { 汇发("    存静32 [rip%+d], eax\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x89); 发字节(0x05); 发四(位移); }            /* mov [rip+disp], eax */
静 空 移rax内存64(整 位移) { 汇发("    取静64 rax, [rip%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x8B); 发字节(0x05); 发四(位移); } /* mov rax, [rip+disp] */
静 空 行六(整 位移) { 汇发("    存静64 [rip%+d], rax\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x89); 发字节(0x05); 发四(位移); } /* mov [rip+disp], rax */
静 空 度一(整 位移) { 汇发("    取静址 rax, [rip%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x8D); 发字节(0x05); 发四(位移); }   /* lea rax, [rip+disp] */
/* static 8/16 位标量 RMW 辅助 (fix 2026-08-30 csmith t6: static uint8_t/int16_t ++/--/store 须按元素宽读写掩码, s75/s88) */
静 空 副双二(整 位移) { 汇发("    取静字节零扩 eax, [rip%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 发字节(0x05); 发四(位移); } /* movzx eax, byte [rip+disp] (7B: disp-1) */
静 空 初复(整 位移) { 汇发("    取静字节符扩 eax, [rip%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBE); 发字节(0x05); 发四(位移); } /* movsx eax, byte [rip+disp] (7B) */
静 空 隔置一(整 位移) { 汇发("    取静字零扩 eax, [rip%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x0F); 发字节(0xB7); 发字节(0x05); 发四(位移); } /* movzx eax, word [rip+disp] (8B: disp-2) */
静 空 左平(整 位移) { 汇发("    取静字符扩 eax, [rip%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x0F); 发字节(0xBF); 发字节(0x05); 发四(位移); } /* movsx eax, word [rip+disp] (8B) */
静 空 终辛(整 位移) { 汇发("    存静字节 [rip%+d], al\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x88); 发字节(0x05); 发四(位移); } /* mov byte [rip+disp], al (6B) */
静 空 全汇(整 位移) { 汇发("    存静字 [rip%+d], ax\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x89); 发字节(0x05); 发四(位移); } /* mov word [rip+disp], ax (7B: disp-1) */
/* MOV byte [rip+disp], imm8 — 7 bytes (C6 05 disp32 imm8). stc_disp() assumes a
   6-byte instruction, so callers must pass stc_disp()-1 (the 7-byte RIP base is
   one byte further). Non-coff only (fix 2026-08-05: global char arr = "lit"). */
静 空 原弊一(整 位移, 整 立即数) {
    汇发("    存静字节 [rip%+d], %d\n", (字*)(长 长)(位移), (字*)(长 长)(立即数), (字*)(长 长)0);
    发字节(0xC6); 发字节(0x05); 发四(位移); 发字节(立即数 & 0xFF);
}
/* ADD rax, imm8 (64-bit �?for pointer+offset) */
静 空 后弊一(整 值) {
    汇发("    加指针 rax, %d\n", (字*)(长 长)(值), (字*)(长 长)0, (字*)(长 长)0);
    若 (值 >= -128 && 值 <= 127) { 前缀字节(1, 0, 0, 0); 发字节(0x83); 模字节(3, 0, 0); 发字节(值 & 0xff); }
    否 { 前缀字节(1, 0, 0, 0); 发字节(0x05); 发四(值); } /* add rax, imm32 (offsets > 127, e.g. stypes[si].fn at 736) */
}
/* MOV reg32, [reg64] ??dereference */
静 空 移寄存器内存(整 寄存器, 整 号挂) {
    汇发("    取值 r%d, [r%d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(号挂), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 号挂 & 8); 发字节(0x8B);
    若 (号挂 == 4 || 号挂 == 12) { 模字节(0, 寄存器 & 7, 号挂 & 7); 发字节(0x24); }
    否 模字节(0, 寄存器 & 7, 号挂 & 7);
}
/* MOV reg64, [reg64] �?full-width deref (char** argv[i] �?8-byte pointer) */
静 空 移寄存器内存64(整 寄存器, 整 号挂) {
    汇发("    取64 r%d, [r%d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(号挂), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 号挂 & 8); 发字节(0x8B);
    若 (号挂 == 4 || 号挂 == 12) { 模字节(0, 寄存器 & 7, 号挂 & 7); 发字节(0x24); }
    否 模字节(0, 寄存器 & 7, 号挂 & 7);
}
/* MOV [reg64], reg32 ??used by struct member store (cg case 13) */
__attribute__((原粗))
静 空 整联一(整 号挂, 整 寄存器) {
    汇发("    存值 [r%d], r%d\n", (字*)(长 长)(号挂), (字*)(长 长)(寄存器), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 号挂 & 8); 发字节(0x89);
    若 (号挂 == 4 || 号挂 == 12) { 模字节(0, 寄存器 & 7, 号挂 & 7); 发字节(0x24); }
    否 模字节(0, 寄存器 & 7, 号挂 & 7);
}
/* JMP rel32 / conditional jumps */
静 空 相对跳转(整 尾午) { 发字节(0xE9); 发四(尾午); }
静 空 零跳(整 尾午) { 发字节(0x0F); 发字节(0x84); 发四(尾午); }
__attribute__((原粗))
静 空 非零跳(整 尾午) { 发字节(0x0F); 发字节(0x85); 发四(尾午); }
静 空 总优二(整 尾午) { 发字节(0x0F); 发字节(0x8D); 发四(尾午); } /* JGE rel32 — fix 2026-08-22 t45: realloc copy min(旧,新) 计数 */
/* SETcc ??op is token type (T_LK/T_GK/T_QK/T_XK/T_HK/T_YK) */
静 空 高进(整 算子) {
    无 字 条件码;
    若 (算子 == 比等) { 条件码 = 0x94; 汇发("    置等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 名庚) { 条件码 = 0x95; 汇发("    置不等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 比小) { 条件码 = 0x9C; 汇发("    置小 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 外三) { 条件码 = 0x9F; 汇发("    置大 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 隔系) { 条件码 = 0x9E; 汇发("    置小等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 宽排) { 条件码 = 0x9D; 汇发("    置大等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 { 条件码 = 0x94; 汇发("    置条件 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    发字节(0x0F); 发字节(条件码); 模字节(3, 0, 0);
}
/* unsigned setcc (fix 2026-08-06 M1): < → setb(0x92), > → seta(0x97), <= → setbe(0x96), >= → setae(0x93) */
静 空 顺深一(整 算子) {
    无 字 条件码;
    若 (算子 == 比等) { 条件码 = 0x94; 汇发("    置等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 名庚) { 条件码 = 0x95; 汇发("    置不等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 比小) { 条件码 = 0x92; 汇发("    置低 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 外三) { 条件码 = 0x97; 汇发("    置高 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 隔系) { 条件码 = 0x96; 汇发("    置低等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 若 (算子 == 宽排) { 条件码 = 0x93; 汇发("    置高等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    否 { 条件码 = 0x94; 汇发("    置条件 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); }
    发字节(0x0F); 发字节(条件码); 模字节(3, 0, 0);
}
/* MOVZX eax, al */
静 空 中失(空) { 汇发("    零扩展 eax, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 模字节(3, 0, 0); }
/* ADD rsp, imm32 �?imm8 (0x83) sign-extends and breaks for frame sizes �?0x80 */
静 空 加栈即(整 值) { 汇发("    加栈 %d\n", (字*)(长 长)(值), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x81); 发字节(0xC4); 发四(值); }
/* SUB rsp, imm32 �?imm8 (0x83) sign-extends and breaks for frame sizes �?0x80 */
静 空 减栈即(整 值) { 汇发("    减栈 %d\n", (字*)(长 长)(值), (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x81); 发字节(0xEC); 发四(值); }

/* push/pop r64 (sub rsp,8; mov [rsp],r64) — 64-bit temporaries, nesting-safe (fix 2026-08-05: mov [rsp+0] clobbered across nested LL ops) */
静 空 压栈64(整 寄存器) {
    减栈即(8);
    汇发("    存栈64 [rsp+0], r%d\n", (字*)(长 长)(寄存器), (字*)(长 长)0, (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x89); 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(0);
}
静 空 弹栈64(整 寄存器) {
    汇发("    取栈64 r%d, [rsp+0]\n", (字*)(长 长)(寄存器), (字*)(长 长)0, (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x8B); 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(0);
    加栈即(8);
}

/* b4_at: write 4 bytes at absolute position */
静 空 隔贰(整 位, 整 值) { 码[位] = 值 & 0xff; 码[位+1] = (值>>8)&0xff; 码[位+2] = (值>>16)&0xff; 码[位+3] = (值>>24)&0xff; }

