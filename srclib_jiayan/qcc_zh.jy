        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "解包")) { /* 接入 2026-08-28 机制层 #75 可空类型完整: 解包 x → __qcc_unwrap(x) — 空值运行时检查 (x==0 → [ERR] 空值解包 + exit, 强制处理空值); 类型根治① (2026-08-28): 解包同时清除可空标记 (解包后变量视为非空, 后续解引用放行) */
            词位++; /* 解包 */
            { 字 串进[64]; 复制字符串(串进, 词名表[词位]); 副降一(串进); } /* 类型根治①: 解包 x → x 不再可空 (若 x 是简单变量) */
            整 评值 = 表达式(); /* 被解包表达式 */
            整 呼 = 建节(4);
            接子(呼, 评值); /* 参数: 值 */
            { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "__qcc_unwrap", 13); 接子(呼, 函); } /* callee 最后 (rt 提供实现) */
            返 呼;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "原子")) { /* 接入 2026-08-27 原子操作 (表达式层, 同异步模式): 原子 加(&x, 1) → atomic_fetch_add(&x, 1); 原子 读(&x) → atomic_load(&x); 原子 写(&x, v) → atomic_store(&x, v) — 操作名映射, 用户定义 atomic_* (读改写原子性, C 模拟已验语义) */
        词位++; /* 原子 */
        字 缓得[64]; 复制字符串(缓得, 词名表[词位]); 词位++; /* 操作名: 加/读/写/比较交换 */
        字 串升[80];
        若 (!比较字符串(缓得, "加")) 格式化到串(串升, "atomic_fetch_add");
        否 若 (!比较字符串(缓得, "读")) 格式化到串(串升, "atomic_load");
        否 若 (!比较字符串(缓得, "写")) 格式化到串(串升, "atomic_store");
        否 若 (!比较字符串(缓得, "比较交换")) 格式化到串(串升, "atomic_compare_exchange"); /* 接入 2026-08-28 机制层: 真 cmpxchg 原子 CAS (内建, 非用户函数) */
        否 若 (!比较字符串(缓得, "交换")) 格式化到串(串升, "atomic_exchange"); /* 接入 2026-08-28 机制层: 真 xchg 原子交换 (内建) */
        否 格式化到串(串升, "atomic_%s", 缓得);
        若 (词型表[词位] == 左括) 词位++; /* ( */
        整 呼 = 建节(4);
        循环 (词型表[词位] != 右括 && 词型表[词位] != 词终 && 词型表[词位] != 分号) { 接子(呼, 表达式()); 若 (词型表[词位] == 逗号) 词位++; } /* 参数 */
        若 (词型表[词位] == 右括) 词位++; /* ) */
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "松散")) { 拼接(串升, "_relaxed"); 词位++; } /* 接入 2026-08-28 机制层 #44 内存序: 松散 (relaxed, 无屏障) */
        否 若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "获取")) { 拼接(串升, "_acquire"); 词位++; } /* 获取 (acquire, load 后屏障) */
        否 若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "释放")) { 拼接(串升, "_release"); 词位++; } /* 释放 (release, store 前屏障) */
        否 若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "顺序")) { 词位++; } /* 顺序 (seq_cst, 默认, 双屏障) */
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 串升, 64); 接子(呼, 函); } /* callee 最后 */
        返 呼;
    }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "异步")) { /* 接入 2026-08-27 异步操作 (事件循环, 同区域模式): 异步 泵(ts, 3, 1, 10) → async_pump(ts, 3, 1, 10); 异步 步进(t, 1, 10) → async_step(t, 1, 10) — 用户定义 async_* (事件循环+协程式 await+定时器 tick, C 模拟已验语义) */
        词位++; /* 异步 */
        字 缓得[64]; 复制字符串(缓得, 词名表[词位]); 词位++; /* 操作名: 泵/步进/注册 — 映射到英文 (fix 2026-08-27: 中文名不能直接拼 async_ 前缀) */
        字 串升[80];
        若 (!比较字符串(缓得, "泵")) 格式化到串(串升, "async_pump");
        否 若 (!比较字符串(缓得, "步进")) 格式化到串(串升, "async_step");
        否 若 (!比较字符串(缓得, "注册")) 格式化到串(串升, "async_register");
        否 格式化到串(串升, "async_%s", 缓得); /* 通用 async_<op> 映射 */
        若 (词型表[词位] == 左括) 词位++; /* ( */
        整 呼 = 建节(4);
        循环 (词型表[词位] != 右括 && 词型表[词位] != 词终 && 词型表[词位] != 分号) { 接子(呼, 表达式()); 若 (词型表[词位] == 逗号) 词位++; } /* 参数 */
        若 (词型表[词位] == 右括) 词位++; /* ) */
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 串升, 64); 接子(呼, 函); } /* callee 最后 */
        返 呼;
    }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "取块")) { /* 接入 2026-08-28 P1 #225 内存池取块 (表达式层): 取块 池 → __qcc_pool_alloc(__pool_x_id) — 空闲栈弹出 void* */
            词位++; /* 取块 */
            字 参数数[64]; 复制字符串(参数数, 词名表[词位]); 词位++;
            字 标识符数[80]; 格式化到串(标识符数, "__pool_%s_id", 参数数);
            整 呼 = 建节(4);
            { 整 值 = 建节(1); 复制内存((字*)(节名表 + 值), 标识符数, 32); 接子(呼, 值); }
            { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "__qcc_pool_alloc", 17); 接子(呼, 函); }
            返 呼;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "文档数")) { /* #288: 文档条数编译期常量 (表达式层) */
            词位++;
            若 (词型表[词位] == 分号) 词位++;
            整 数 = 建节(0); 节值表[数] = 元辛;
            返 数;
        }
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "目标架构") || !比较字符串(词名表[词位], "目标字长") || !比较字符串(词名表[词位], "源位置"))) { /* 接入 2026-08-28 P2 #253 目标架构检测 + #191 源码位置: 目标架构 → 1 (x86_64); 目标字长 → 64; 源位置 → 当前用户行号编译期常量 */
            整 缓三一 = !比较字符串(词名表[词位], "目标架构");
