            整 符癸 = (型定序转值 >= 0 && !型定表[型定序转值].是否函数指 && 型定表[型定序转值].数组数一 > 0) ? 型定表[型定序转值].数组数一 : 0; /* 修复 2026-08-27 特性#2: 类型定义 数组元素数 (arr_t 数组 无 [N] 也按数组) */
            若 (词型表[词位] == 左方 || 符癸 > 0) { /* 数组 (静态 字符 名[3][16] 亦); 类型定义 数组 arr_t 数组 无 [N] 也进 */
                /* 类型定义'd 结构体 数组: P 数组[3] — 元素 尺寸 = 结构体 尺寸,
