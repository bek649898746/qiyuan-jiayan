          整 呼参 = 建节(4); { 整 符号数 = 建节(0); 节值表[符号数] = 串数; 节型表[符号数] = 串词; 接子(呼参, 符号数); } { 整 缓进 = 建节(1); 复制内存((字*)(节名表 + 缓进), "printf", 7); 接子(呼参, 缓进); }
