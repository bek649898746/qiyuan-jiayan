                { 整 暂零 = 子0[数]; 若 (暂零 >= 0 && 节型别[暂零] == 节点_下标) { 整 域升 = 暂零; 循环 (域升 >= 0 && 节型别[域升] == 节点_下标) 域升 = 子0[域升]; 若 (域升 >= 0 && 节型别[域升] == 节点_变量) { 遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--) 若 (!比较字符串(变量表[变序].名, (字*)(节名表 + 域升)) && 变量码生成可见(变序)) { 若 (变量表[变序].指元素尺寸 > 0) 元素 = 变量表[变序].指元素尺寸; 否 若 (变量表[变序].数组元素尺寸 > 0) 元素 = 变量表[变序].数组元素尺寸; 断; } } 若 (域升 >= 0 && (节型别[域升] == 节点_成员 || 节型别[域升] == 节点_箭头)) { 整 构序二 = 变量型序((字*)(节名表 + 子0[域升])); 若 (构序二 >= 0) { 整 域序 = 字段序(构序二, (字*)(节名表 + 域升)); 若 (域序 >= 0) { 若 (类型表[构序二].字段[域序].原进) 元素 = 字段指元素(构序二, (字*)(节名表 + 域升)); 否 若 (类型表[构序二].字段[域序].内联 > 0) 元素 = 构域元素(构序二, (字*)(节名表 + 域升)); } } } /* 2026-09-04 虾米: 成员数组元素 ++/-- (b.y[0]++) 14链底=成员15 原漏宽默认4 → 32位自增高半不进位 (P4/P5/P6) */ } /* 修复 2026-09-03 p196: 2D 数组元素 ++/-- (g[4][4]) 原只跳一层 → 行宽/默认宽; 沿嵌套 14 到基 用 指元素尺寸 (标量) */
