    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past the 2nd %) */
