            若 (缺卯) { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "__qcc_cell_set", 15); 接子(呼, 函); }
            否 { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "__qcc_cell_get", 15); 接子(呼, 函); }
