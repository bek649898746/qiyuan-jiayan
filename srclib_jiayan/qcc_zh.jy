    整 判载宽b = (判载码p[判载a][判载b] == 9) ? 8 : ((判载码p[判载a][判载b] == 10) ? 4 : ((判载码p[判载a][判载b] == 3 || 判载码p[判载a][判载b] == 7) ? 1 : ((判载码p[判载a][判载b] == 1 || 判载码p[判载a][判载b] == 4 || 判载码p[判载a][判载b] == 8) ? 8 : ((判载码p[判载a][判载b] == 2 || 判载码p[判载a][判载b] == 6) ? 2 : 4)))); /* 第 185 站: 码 10 → 4 */ /* 第 178 站: 码 9 → 8 */
    整 判载对b = 判载宽b >= 8 ? 8 : (判载宽b >= 4 ? 4 : (判载宽b >= 2 ? 2 : 1));
    若 (判载对b > 判载对) 判载对 = 判载对b;
    } }
