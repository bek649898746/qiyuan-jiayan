                    汇发("    存32 [r8], r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1); 发字节(0x89); 模字节(0,2,0); /* 移动 [r8], r10d — 头 = n*尺寸 */
                    /* 清零数据区 (修复 2026-08-22 t45: 单-文件 清零分配 也清零+头) */
                    移即(0, 0); /* 首子 = 0 */
                    移寄存器(11, 8);   /* 后辰 = 头 */
                    汇发("    加 r11, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,0,3); 发字节(8);
                    { 整 标属 = 新标号(), 深高 = 新标号();
