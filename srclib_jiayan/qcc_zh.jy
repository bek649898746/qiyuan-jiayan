    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 空八二, 1);
    移寄存器帧(0, 临时基 - 当前帧大小 + 224); /* eax = N */
    算寄存器(比等, 9, 0); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 空八二, 8); /* cmp r9d, eax; jle lsnoprec2 */
    移寄存器(9, 0); /* len = N */
    设标号(空八二);
