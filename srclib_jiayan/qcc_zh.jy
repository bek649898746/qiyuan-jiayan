        汇发("    浮转整\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x2C); 发字节(0xC0); /* eax = fracN (may be scale) */
        移寄存器帧(1, 域 + 228);       /* ecx = scale */
        汇发("    比较无 r0, r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x39); 模字节(3, 1, 0);         /* cmp eax, ecx (CF = eax < ecx -> jb = no carry) */
        发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 毛七, 8); /* jb lfrac2: no carry */
        移即(0, 0);                 /* frac6 = 0 */
        汇发("    自增 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC3);                /* inc ebx (int part + 1) */
        设标号(毛七);
        移帧寄存器(域 + 208, 0);       /* save frac6 as int */
        域重一(帧序二);              /* print int part -> fractional path */
        /* fractional path: '.' then N digits of fracN (leading zeros) - root-cause
           2026-08-03: was 6 unrolled divs; now loops N times with divisor = scale/10. */
        设标号(帧序二);
        移寄存器帧(0, 域 + 224); /* eax = N */
        测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 宽组, 1); /* N==0: no fractional digits, skip '.' */
        移即(0, '.'); 存字节十二();
        汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
        设标号(宽组);
        移寄存器帧(0, 域 + 228); 移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); 汇发("    除32 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* div ecx: eax = scale/10 */
        移寄存器(8, 0);                    /* r8d = divisor */
        移寄存器帧(9, 域 + 224);       /* r9d = N (digit count) */
        设标号(下序);
        测寄存器(9, 9); 零跳(-1); 补标号(码位-4, 链叁, 1);
        移寄存器帧(0, 域 + 208);       /* eax = fracN */
        汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2);                /* xor edx, edx */
        汇发("    除32 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xF7); 模字节(3, 6, 0); /* div r8d: eax=digit, edx=rem */
        汇发("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC0); 发字节(0x30); 存字节十二(); /* add al,'0'; mov [r12], al - digit is in EAX (fix 2026-08-03) */
        汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
        移帧寄存器(域 + 208, 2);       /* fracN = edx (rem) */
        移寄存器(0, 8); 移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); 汇发("    除32 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* div ecx: eax = divisor/10 */
        移寄存器(8, 0);                    /* r8d = divisor/10 */
        汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9d */
        相对跳转(-1); 补标号(码位-4, 下序, 2);
        设标号(链叁);
        相对跳转(-1); 补标号(码位 - 4, 容低, 2);
    }
    /* %e/%E/%g/%G: 科学/通用浮点 — 分发存根设 letter(sc+236)+is_g(sc+24)+跳共享核心 (fix 2026-08-25
       支持矩阵补全; 必须每 printf 只发射一份核心, 4 个 call site 各自发射会标签爆炸 LABEL-OVERFLOW) */
    设标号(小于等);
    移即(0, 'e'); 移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* letter */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 24, 0);    /* is_g = 0 */
    相对跳转(-1); 补标号(码位 - 4, 当再, 2);
    设标号(净二);
    移即(0, 'E'); 移帧寄存器(临时基 - 当前帧大小 + 236, 0);
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 24, 0);
    相对跳转(-1); 补标号(码位 - 4, 当再, 2);
    设标号(初陆);
    移即(0, 'e'); 移帧寄存器(临时基 - 当前帧大小 + 236, 0);
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 24, 0);    /* is_g = 1 */
    相对跳转(-1); 补标号(码位 - 4, 当再, 2);
    设标号(局部全局);
    移即(0, 'E'); 移帧寄存器(临时基 - 当前帧大小 + 236, 0);
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 24, 0);
    相对跳转(-1); 补标号(码位 - 4, 当再, 2);
    设标号(当再);
    正败(容低);
/* ---- %f 的 inf/NaN 输出 (fix 2026-08-26): 符号已输出, 只输出 "inf"/"nan" ---- */
    设标号(内寅);
    { 整 目进 = 临时基 - 当前帧大小; /* 重新加载 |v| (%f 路径已改 xmm0) */
      逆厚(目进 + 192);
      汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq rax, xmm0 */
      发字节(0x48); 发字节(0xC1); 发字节(0xE0); 发字节(12);                   /* shl rax, 12: 尾数移高, 符号+指数移出 */
      发字节(0x48); 发字节(0x85); 发字节(0xC0);                          /* test rax, rax: 尾数非 0 → NaN */
      发字节(0x0F); 发字节(0x85); 发四(0); 补标号(码位 - 4, 副合, 9); /* jnz lfnan */
      移即(0, 'i'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, 'n'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, 'f'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      相对跳转(-1); 补标号(码位 - 4, 容低, 2);
      设标号(副合);
      移即(0, 'n'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, 'a'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, 'n'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, '('); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, 'i'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, 'n'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, 'd'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      移即(0, ')'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
      相对跳转(-1); 补标号(码位 - 4, 容低, 2);
    }
/* %d->lfmt, %f->fractional path */
    返 段辰;
}

/* %e/%E/%g/%G: scientific / general float formatting (fix 2026-08-25 支持矩阵补全).
   is_g(sc+24) 与 letter(sc+236) 由 emit_fmt_loop 分发存根在运行时设置.
   Emitted machine code shares the %f sign/rounding patterns but adds decimal-exponent
   normalization. scale/fracN use 64-bit arithmetic so %.16g/%.17g (SQLite) work.
   Precision N from sc+224 (default 6). Width/zero-pad ignored for float formats.
   Slot map (all inside the printf scratch area, sc = scratch_base - cur_frame_sz):
     sc+8:   scale (int64)          sc+192: |v| (double)
     sc+16:  strip counter (int32)  sc+200: mantissa/frac (double)
     sc+20:  style flag (0=f-style 1=e-style)   sc+208: fracN (int64)
     sc+24:  is_g (0=%e/%E 1=%g/%G)  sc+216: 0.5 (double)
     sc+224: N_frac (int32)         sc+228: exp (int32)
     sc+236: exponent letter        sc+240: 10.0 (double, 8字节 sc+240..247 — 勿与其他槽重叠)
   Register discipline: r11=fmt r12=dest r13=args; r8/r9 scratch; emit_u64_digits
   digit temp spans ~sc+242..259 (downward from [rbp+sc+260]), so nothing below
   sc+240 may be live across a call to it (style flag at sc+20 / is_g at sc+24 因此安全). */
静 空 正败(整 号分) {
    整 容伴 = 新标号(), 链伍一 = 新标号(), 值轮 = 新标号();
    整 邻陆 = 新标号(), 左属一 = 新标号(); /* fix 2026-08-26: inf/NaN 特殊输出 (原归一化循环死循环) */
    整 容叁 = 新标号(), 栈附 = 新标号(), 素附 = 新标号();
    整 正聚一 = 新标号(), 副子一 = 新标号();
    整 双挂 = 新标号(), 存寅 = 新标号(), 满申 = 新标号();
    整 旁散 = 新标号(), 双六 = 新标号(), 短劣 = 新标号();
    整 局部数 = 新标号(), 段拾 = 新标号(), 存系一 = 新标号(), 尾序 = 新标号();
    整 计退二 = 新标号();
    整 前轮 = 新标号(), 左深 = 新标号(), 段属一 = 新标号(), 外汇 = 新标号();
    整 局部全局成功 = 新标号(), 容成一 = 新标号(), 直属 = 新标号();
    整 目从 = 新标号(), 新十 = 新标号(), 域寅 = 新标号(), 下一 = 新标号();
    整 下挂 = 新标号();
    整 域 = 临时基 - 当前帧大小;

    /* consume the double arg */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past spec char) */
    逆排();
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); }

    /* ---- sign (same pattern as %f: IEEE sign bit) ---- */
    余申(域 + 192);       /* save v */
    逆厚(域 + 192);
    汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq rax, xmm0 */
    汇发("    测试位 r0, 63\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,0); 发字节(0x0F); 发字节(0xBA); 发字节(0xE0); 发字节(0x3F); /* bt rax, 63 */
    发字节(0x0F); 发字节(0x83); 发四(0); 补标号(码位 - 4, 容伴, 7); /* jae l_sgn: sign clear, keep */
    移即(0, '-'); 存字节十二(); /* mov [r12], '-' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    堆双(域 + 192);       /* xmm1 = v */
    移即(0, 0); 旧挂(); /* xmm0 = 0.0 */
    整进();               /* xmm0 = 0.0 - v = -v */
    余申(域 + 192);       /* save |v| */
    设标号(容伴);

    /* fix 2026-08-26: inf/NaN 检测 — 原归一化循环对 inf (v/10 恒 inf) 与 NaN (comisd 无序 CF=1, NaN<1 恒真) 死循环。
       指数位全 1 (0x7FF) → 跳 l_sp 输出 "inf"/"nan"; 正常值 fall-through (xmm0 未被 clobber). */
    汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq rax, xmm0 */
    发字节(0x48); 发字节(0xC1); 发字节(0xE8); 发字节(52);                /* shr rax, 52 */
    发字节(0x25); 发四(0x7FF);                              /* and eax, 0x7FF */
    发字节(0x3D); 发四(0x7FF);                              /* cmp eax, 0x7FF */
    发字节(0x0F); 发字节(0x84); 发四(0); 补标号(码位 - 4, 邻陆, 8); /* je l_sp (inf/NaN) */

    /* exp = 0 */
    移即(0, 0); 移帧寄存器(域 + 228, 0);

    /* zero check (normalization would loop forever on 0) */
    移即(0, 0); 余十(); /* xmm1 = 0.0 */
    值凶();
    发字节(0x0F); 发字节(0x84); 发四(0); 补标号(码位 - 4, 链伍一, 1); /* je l_zero: v == 0 */

    /* ---- normalize |v| to [1,10): exp counts powers of 10 ---- */
    移即(0, 10); 余十();  /* xmm1 = 10.0 */
    新劣(); 余申(域 + 240); /* [sc+240] = 10.0 (8字节 sc+240..247 — is_g 在 sc+24 不重叠) */
    逆厚(域 + 192);          /* restore xmm0 = v (movsd_xmm0_xmm1 clobbered it) */
    设标号(值轮);
    值凶();                 /* CF = (v < 10) */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 容叁, 8); /* jb l_sml: v < 10 */
    末一一();                  /* v /= 10 */
    移寄存器帧(0, 域 + 228); 移即(1, 1); 算寄存器(高拾, 0, 1); 移帧寄存器(域 + 228, 0); /* exp++ */
    相对跳转(-1); 补标号(码位 - 4, 值轮, 2);
    设标号(容叁);
    设标号(栈附);
    移即(0, 1); 余十();  /* xmm1 = 1.0 (reload each iteration — mulsd clobbers it with 10.0) */
    值凶();                 /* CF = (v < 1) */
    发字节(0x0F); 发字节(0x83); 发四(0); 补标号(码位 - 4, 素附, 7); /* jae l_norm: v >= 1 */
    堆双(域 + 240);          /* xmm1 = 10.0 */
    容甲();                  /* v *= 10 */
    移寄存器帧(0, 域 + 228); 移即(1, 1); 算寄存器(旧肆, 0, 1); 移帧寄存器(域 + 228, 0); /* exp-- */
    相对跳转(-1); 补标号(码位 - 4, 栈附, 2);
    设标号(素附);
    /* xmm0 = mantissa in [1,10), exp at sc+228, |v| at sc+192 — 运行时 is_g(sc+24) 分支 */
    移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 正聚一, 3); /* is_g==0 → 直接 e-style */
    /* %g: precision 0 -> 1 (C standard: zero precision treated as one) */
    移寄存器帧(0, 域 + 224); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 局部全局成功, 3);
    移即(0, 1); 移帧寄存器(域 + 224, 0);
    设标号(局部全局成功);
    /* %g style decision: e-style iff exp < -4 or exp >= N (default N=6) */
    移寄存器帧(0, 域 + 228); 移即(1, -4); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8C); 发四(0); 补标号(码位 - 4, 正聚一, 10); /* cmp eax,-4; jl l_efmt */
    移寄存器帧(1, 域 + 224); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位 - 4, 正聚一, 5); /* cmp eax,ecx; jge l_efmt */
    /* ---- f-style ---- */
    移寄存器帧(0, 域 + 224);
    移即(1, 1); 算寄存器(旧肆, 0, 1);           /* eax = N-1 */
    移寄存器帧(1, 域 + 228); 算寄存器(旧肆, 0, 1); /* eax = N-1-exp */
    移帧寄存器(域 + 224, 0);                     /* N_frac */
    移即(0, 0); 移帧寄存器(域 + 20, 0);     /* style = 0 (f-style) */
    逆厚(域 + 192);                     /* xmm0 = v */
    长对();                          /* rax = (int64)v */
    移64(3, 0);                                /* rbx = int part */
    移64(0, 3); 发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2A); 发字节(0xC0); /* cvtsi2sd xmm0, rax */
    短弊();                             /* xmm1 = (double)int */
    逆厚(域 + 192);
    整进();                             /* xmm0 = v - int */
    余申(域 + 200);                     /* frac */
    相对跳转(-1); 补标号(码位 - 4, 双挂, 2);
    设标号(链伍一);
    /* v == 0: exp stays 0, mantissa = 0 — jump back through the %g style decision
       (exp=0 -> f-style -> "0"/"-0"; %e/%E is_g==0 jumps straight to l_efmt anyway) */
    相对跳转(-1); 补标号(码位 - 4, 素附, 2);
    设标号(正聚一);
    /* ---- e-style ---- */
    余申(域 + 200);                         /* save mantissa (0 or [1,10)) */
    /* 运行时 is_g: %g e-style 用 N-1 位小数 (%e 保持 N) */
    移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 容成一, 3);
    移寄存器帧(0, 域 + 224); 移即(1, 1); 算寄存器(旧肆, 0, 1); 移帧寄存器(域 + 224, 0); /* N_frac = N-1 */
    设标号(容成一);
    /* guard N_frac >= 0 */
    移寄存器帧(0, 域 + 224); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位 - 4, 副子一, 5); /* cmp eax,0; jge l_nfok */
    移即(0, 0); 移帧寄存器(域 + 224, 0);
    设标号(副子一);
    /* mantissa int digit (0-9) */
    逆厚(域 + 200);
    现简();
    移寄存器(3, 0);                                      /* ebx = digit */
    移寄存器(0, 3); 旧挂();                 /* xmm0 = (double)digit */
    短弊();
    逆厚(域 + 200);
    整进();                                 /* xmm0 = mantissa - digit */
    余申(域 + 200);                         /* frac */
    移即(0, 1); 移帧寄存器(域 + 20, 0);         /* style = 1 (e-style) */
    设标号(双挂);
    /* ---- shared: scale = 10^N_frac (64-bit) ---- */
    移即(0, 1); 反附(域 + 8, 0);        /* scale = 1 */
    移寄存器帧(9, 域 + 224);                         /* r9d = N_frac */
    设标号(存寅);
    测寄存器(9, 9); 零跳(-1); 补标号(码位 - 4, 满申, 1);
    移寄存器帧64(0, 域 + 8);                         /* rax = scale */
    移即(1, 10);                                  /* ecx = 10 */
    发字节(0x48); 发字节(0xF7); 发字节(0xE1);                         /* mul rcx: rdx:rax = scale*10 */
    反附(域 + 8, 0);                         /* scale = rax */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9d */
    相对跳转(-1); 补标号(码位 - 4, 存寅, 2);
    设标号(满申);
    /* ---- shared: fracN = trunc(frac * scale + 0.5) ---- */
    移即(0, 1); 旧挂();              /* xmm0 = 1.0 */
    移即(0, 2); 余十();              /* xmm1 = 2.0 */
    末一一();                                 /* xmm0 = 0.5 (1.0/2.0) */
    余申(域 + 216);                         /* save 0.5 */
    移寄存器帧64(0, 域 + 8);                         /* rax = scale */
    发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2A); 发字节(0xC8);       /* cvtsi2sd xmm1, rax (scale) */
    逆厚(域 + 200);                         /* xmm0 = frac */
    容甲();                                 /* xmm0 = frac*scale */
    堆双(域 + 216);                         /* xmm1 = 0.5 */
    总辛一();                                 /* xmm0 = frac*scale + 0.5 */
    长对();                              /* rax = fracN */
    /* carry: fracN >= scale -> fracN = 0, adjust mantissa/int */
    移寄存器帧64(1, 域 + 8);                         /* rcx = scale */
    发字节(0x48); 发字节(0x39); 模字节(3, 1, 0);                  /* cmp rax, rcx */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 短劣, 8); /* jb l_nocarry: fracN < scale */
    移寄存器帧(0, 域 + 20); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 旁散, 3); /* style 0? */
    发字节(0xFF); 发字节(0xC3);                                  /* inc ebx (f-style int part) */
    相对跳转(-1); 补标号(码位 - 4, 双六, 2);
    设标号(旁散);
    发字节(0xFF); 发字节(0xC3);                                  /* inc ebx (mantissa digit) */
    移即(1, 10); 算寄存器(比等, 3, 1);              /* cmp ebx, 10 */
    发字节(0x0F); 发字节(0x8C); 发四(0); 补标号(码位 - 4, 双六, 10); /* jl l_carry_done: digit < 10 */
    移即(3, 1);                                   /* ebx = 1 */
    移寄存器帧(0, 域 + 228); 移即(1, 1); 算寄存器(高拾, 0, 1); 移帧寄存器(域 + 228, 0); /* exp++ */
    设标号(双六);
    移即(0, 0);                                   /* fracN = 0 */
    设标号(短劣);
    反附(域 + 208, 0);                       /* save fracN */
    /* ---- strip trailing zeros (only %g; 运行时 is_g 判断) ---- */
    移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 直属, 3);
    {
        移即(0, 0); 移帧寄存器(域 + 16, 0);     /* strip = 0 */
        设标号(目从);
        移寄存器帧64(0, 域 + 208);                   /* rax = fracN */
        发字节(0x48); 发字节(0x85); 发字节(0xC0);                     /* test rax, rax */
        非零跳(-1); 补标号(码位 - 4, 新十, 3);
        移即(0, 0); 移帧寄存器(域 + 224, 0);    /* N_eff = 0 */
        相对跳转(-1); 补标号(码位 - 4, 下一, 2);
        设标号(新十);
        移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
        发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1);              /* div rcx: rax=fracN/10, rdx=rem */
        测寄存器(2, 2); 非零跳(-1); 补标号(码位 - 4, 域寅, 3); /* rem != 0 -> done */
        反附(域 + 208, 0);                   /* fracN /= 10 */
        移寄存器帧(0, 域 + 16); 移即(1, 1); 算寄存器(高拾, 0, 1); 移帧寄存器(域 + 16, 0); /* strip++ */
        相对跳转(-1); 补标号(码位 - 4, 目从, 2);
        设标号(域寅);
        /* N_eff = N - strip */
        移寄存器帧(0, 域 + 16); 移寄存器帧(1, 域 + 224); 算寄存器(旧肆, 1, 0); 移帧寄存器(域 + 224, 1);
        /* scale_eff = scale / 10^strip (64-bit) */
        移寄存器帧64(0, 域 + 8); 移寄存器帧(1, 域 + 16); /* rax=scale, ecx=strip */
        设标号(下挂);
        测寄存器(1, 1); 零跳(-1); 补标号(码位 - 4, 下一, 1);
        移即(2, 10); 移寄存器(8, 2);                /* r8 = 10 (divisor — 不能放 scale 自身, 会 scale/scale=1) */
        汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
        发字节(0x49); 发字节(0xF7); 发字节(0xF0);                     /* div r8: rax = scale/10 */
        反附(域 + 8, 0);                     /* scale /= 10 */
        移寄存器帧(1, 域 + 16); 发字节(0xFF); 发字节(0xC9); 移帧寄存器(域 + 16, 1); /* strip-- */
        相对跳转(-1); 补标号(码位 - 4, 下挂, 2);
        设标号(下一);
    }
    设标号(直属);  /* is_g==0: 跳过 strip, fracN/N/scale 原样 */
    /* ---- print mantissa/int part (style flag sc+20 运行时分支) ---- */
    移寄存器帧(0, 域 + 20); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 计退二, 3);
    短组(域 + 260, 局部数);              /* f-style: print rbx (int), jmp l_num */
    设标号(计退二);
    /* e-style: single mantissa digit (0-9) */
    移寄存器(0, 3);
    汇发("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC0); 发字节(0x30); /* add al, '0' */
    存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    相对跳转(-1); 补标号(码位 - 4, 局部数, 2);
    /* ---- fraction digits: '.' + N_eff digits of fracN, divisor = scale/10 ---- */
    设标号(局部数);
    移寄存器帧(0, 域 + 224); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 段拾, 1); /* N==0: skip '.' */
    移即(0, '.'); 存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    设标号(段拾);
    移寄存器帧64(0, 域 + 8);                         /* rax = scale */
    移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1);                  /* div rcx: rax = scale/10 */
    移64(8, 0);                                    /* r8 = divisor */
    移寄存器帧(9, 域 + 224);                         /* r9d = N (digit count) */
    设标号(存系一);
    测寄存器(9, 9); 零跳(-1); 补标号(码位 - 4, 尾序, 1);
    移寄存器帧64(0, 域 + 208);                       /* rax = fracN */
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    发字节(0x49); 发字节(0xF7); 发字节(0xF0);                         /* div r8: rax=digit, rdx=rem */
    汇发("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC0); 发字节(0x30); /* add al, '0' */
    存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    反附(域 + 208, 2);                       /* fracN = rdx */
    移64(0, 8);                                    /* rax = divisor */
    移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1);                  /* div rcx: rax = divisor/10 */
    移64(8, 0);                                    /* r8 = divisor/10 */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9d */
    相对跳转(-1); 补标号(码位 - 4, 存系一, 2);
    设标号(尾序);
    /* exit: style 0 -> tail, style 1 -> l_exp (exponent print) */
    移寄存器帧(0, 域 + 20); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 前轮, 3);
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
    /* ---- exponent: letter(sc+236) + sign + at least 2 digits ---- */
    设标号(前轮);
    移寄存器帧(0, 域 + 236); 存字节十二();           /* letter */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移寄存器帧(0, 域 + 228); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位 - 4, 左深, 5); /* cmp eax,0; jge l_pl */
    移即(0, '-'); 存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移寄存器帧(0, 域 + 228); 移即(1, 0); 算寄存器(旧肆, 1, 0); 移帧寄存器(域 + 228, 1); /* exp = 0 - exp */
    相对跳转(-1); 补标号(码位 - 4, 段属一, 2);
    设标号(左深);
    移即(0, '+'); 存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    设标号(段属一);
    移寄存器帧(0, 域 + 228); 移即(1, 10); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位 - 4, 外汇, 5); /* cmp eax,10; jge l_expcopy */
    移即(0, '0'); 存字节十二();                   /* pad '0' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移寄存器帧(0, 域 + 228);
    汇发("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC0); 发字节(0x30); /* add al, '0' */
    存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
    设标号(外汇);
    /* multi-digit exponent (>= 2 digits): rbx = |exp| */
    移寄存器帧(0, 域 + 228); 移64(3, 0);
    短组(域 + 260, 号分);

    /* ---- inf/NaN 输出 (fix 2026-08-26): 符号已由符号处理输出 '-' — 只输出 "inf"/"nan" ---- */
    设标号(邻陆);
    逆厚(域 + 192);                          /* 重新加载 |v| (归一化循环已改 xmm0) */
    汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq rax, xmm0 */
    发字节(0x48); 发字节(0xC1); 发字节(0xE0); 发字节(12);                   /* shl rax, 12: 尾数移到高 52 位 (符号+指数移出) */
    发字节(0x48); 发字节(0x85); 发字节(0xC0);                          /* test rax, rax: 尾数非 0 → NaN */
    发字节(0x0F); 发字节(0x85); 发四(0); 补标号(码位 - 4, 左属一, 9); /* jnz l_nanx */
    移即(0, 'i'); 存字节十二();                    /* 'i' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, 'n'); 存字节十二();                    /* 'n' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, 'f'); 存字节十二();                    /* 'f' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
    设标号(左属一);
    移即(0, 'n'); 存字节十二();                    /* 'n' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, 'a'); 存字节十二();                    /* 'a' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, 'n'); 存字节十二();                    /* 'n' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, '('); 存字节十二();                    /* '(' (fix step29: 对齐 msvcrt/gcc "nan(ind)") */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, 'i'); 存字节十二();                    /* 'i' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, 'n'); 存字节十二();                    /* 'n' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, 'd'); 存字节十二();                    /* 'd' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    移即(0, ')'); 存字节十二();                    /* ')' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
}

/* print rbx (unsigned 64-bit) as decimal to [r12], then jmp tail.
   digit temp buffer at [rbp+temp_end-12 .. temp_end] (12 bytes, plenty for 64-bit).
   fix 2026-08-25 支持矩阵补全: shared by emit_fmt_float (int part + exponent). */
静 空 短组(整 暂终, 整 号分) {
    整 首甲 = 新标号(), 间寅 = 新标号();
    取帧址(8, 暂终);               /* r8 = temp end */
    移64(9, 8);                        /* r9 = temp end (advancing) */
    设标号(首甲);
    移64(0, 3);                        /* rax = value */
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
    移即(1, 10);
    发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1);      /* div rcx: rax=quot, rdx=rem */
    移64(3, 0);                        /* rbx = quot */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* add dl, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* dec r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* mov [r9], dl */
    发字节(0x48); 发字节(0x85); 模字节(3, 3, 3);      /* test rbx, rbx */
    非零跳(-1); 补标号(码位 - 4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* mov al, [r9] */
    存字节十二();
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* cmp r9, r8 */
    非零跳(-1); 补标号(码位 - 4, 间寅, 3);
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
}

/* sprintf(dest=rcx, fmt=rdx, args...): format into dest buffer, return chars written.
   No kernel32 calls, so no stack alignment juggling. r14=dest r11=fmt r12=adv r13=args.
   argstart = index of the first VALUE arg in the pushed stack (2 for sprintf,
   3 for snprintf which carries a size arg). */
静 空 源回(整 参数个数, 整 邻回一) {
    左壬一(13, 8 * (参数个数 - 1 - 邻回一)); /* r13 = &first value arg */
    移64(14, 1);  /* r14 = dest (rcx = arg0) */
    移64(11, 2);  /* r11 = fmt (rdx = arg1) */
    移64(12, 14); /* r12 = dest advancing */
    整 段辰 = 度壬(0); /* sprintf/snprintf：用户缓冲，不设界（标准语义） */
    设标号(段辰);
    /* NUL-terminate the dest buffer — sprintf MUST write the terminator (fix 2026-08-03: emit_fmt_loop
       leaves it off because printf/fprintf write a known-length blob; self-host -S text was corrupted
       with stale-buffer residue after the first asm_emit call). */
    汇发("    存字节0r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xC6); 发字节(0x04); 发字节(0x24); 发字节(0); /* mov byte [r12], 0 */
    移64(0, 12); 汇发("    减64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3, 6, 0); /* rax = r12 - r14 = count */
}

/* vsnprintf(buf=rcx, size=rdx, fmt=r8, ap=r9): builtin - format the varargs pointed to by
   va_list ap into an internal buffer, copy at most size-1 bytes into buf (NUL-terminated),
   and return the length that would have been written. fix 2026-08-23 t35e: vsnprintf was
   unregistered (no msvcrt IAT import) -> undefined-function fallback returned 0 -> git's
   strbuf_addf/vsnprintf chain silently emitted nothing (diff header lost its prefix etc.).
   va_list is char* (custom stdarg.h stub), r13=ap matches emit_fmt_loop's 8-byte arg table. */
静 空 现七一(空) {
    整 满败一 = 新标号();
    移64(3, 1);  /* rbx = buf (rcx) */
    移64(15, 2); /* r15 = size (rdx) */
    压栈寄存器(3);        /* save buf */
    压栈寄存器(15);       /* save size */
    移64(11, 8);  /* r11 = fmt (r8) */
    移64(13, 9);  /* r13 = ap (r9) = va_list; fmt_va_forward makes fmt_loop walk UP */
    素组 = 1;
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = internal buffer */
    移64(14, 12); /* r14 = buffer start */
    整 段辰 = 度壬(-272);
    素组 = 0;
    设标号(段辰);
    /* len = r12 - r14 */
    移64(0, 12); 汇发("    减64 rax, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3, 6, 0);
    移帧寄存器(临时基 - 当前帧大小 + 224, 0); /* save len (sc+224 free after fmt_loop) */
    弹栈寄存器(15); /* size */
    弹栈寄存器(3);  /* buf */
    /* r9 = min(len, size-1) */
    移64(9, 15); 移即(1, 1); 算寄存器(旧肆, 9, 1); /* r9d = size - 1 */
    移寄存器帧(1, 临时基 - 当前帧大小 + 224); /* ecx = len */
    算寄存器(比等, 9, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 满败一, 6); /* cmp r9d,ecx; jle lcap */
    移64(9, 1); /* r9 = len */
    设标号(满败一);
    /* rep movsb: rcx=count, rsi=src, rdi=buf */
    移64(1, 9);  /* rcx = count */
    移64(6, 14); /* rsi = r14 (internal buffer start; r8 clobbered by fmt_loop) */
    移64(7, 3);  /* rdi = buf */
    汇发("    块复制 (rep movsb)\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF3); 发字节(0xA4);
    汇发("    写字节 [rdi], 0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xC6); 发字节(0x07); 发字节(0); /* mov byte [rdi], 0 (rdi=7, no REX needed) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 224); /* eax = len (needed length) */
}

/* _va_alloc(size=rcx) �?VirtualAlloc(NULL, size, MEM_RESERVE|MEM_COMMIT, PAGE_READWRITE) */
静 空 满六(空) {
    移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* align */
    减栈即(32); /* shadow space only (4 args, rsp%16==0 at call) — fix 2026-08-03: was 40 (rsp%16==8) */
    移64(2, 1);       /* rdx = size */
    移即扩(1, 0);     /* rcx = lpAddress NULL */
    移即扩(8, 0x3000); /* r8 = MEM_RESERVE|MEM_COMMIT */
    移即扩(9, 0x4);   /* r9 = PAGE_READWRITE */
    调导入(4);          /* VirtualAlloc */
    加栈即(32);
    移64(4, 15);
}

/* _setpos(handle=rcx, pos=rdx, method=r8) �?SetFilePointer(handle, pos, NULL, method) */
静 空 直丁一(空) {
    移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
    减栈即(32);
    移64(9, 8);  /* r9 = method */
    移即扩(8, 0); /* r8 = NULL (lpDistanceToMoveHigh) */
    调导入(5);     /* SetFilePointer */
    加栈即(32);
    移64(4, 15);
}

/* _getpos(handle=rcx) �?SetFilePointer(handle, 0, NULL, FILE_CURRENT=1) */
静 空 缺排(空) {
    移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
    减栈即(32);
    移即扩(2, 0); /* rdx = 0 */
    移即扩(8, 0); /* r8 = NULL */
    移即扩(9, 1); /* r9 = FILE_CURRENT */
    调导入(5);
    加栈即(32);
    移64(4, 15);
}

/* _exit_proc(code=rcx) �?ExitProcess(code) �?never returns */
静 空 现戊(空) {
    移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
    减栈即(32);
    调导入(6); /* ExitProcess */
}

/* fopen/fread/fwrite: real file I/O via kernel32 (CreateFileA/ReadFile/WriteFile).
   Args arrive in rcx/rdx/r8/r9 (call machinery). All kernel32 calls need rsp 16-aligned
   and the 5th+ args at [rsp+32+8k] �?align with r15 and restore. */
静 空 堆吉(常 字 *串升) {
    若 (!比较字符串(串升, "fopen")) {
        /* fopen(path=rcx, mode=rdx): parse mode[0], call CreateFileA */
        移64(10, 1); /* r10 = path */
        移64(11, 2); /* r11 = mode */
        移64(15, 4); /* mov r15, rsp */
        汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp, -16 */
        减栈即(64); /* shadow 32 + 3 stack args 24 + pad 8  �? rsp%16==0 at call */
        /* defaults for 'w': GENERIC_WRITE (rdx = arg2!) + CREATE_ALWAYS */
        移即(0, 3); 移寄存器(8, 0);   /* r8 = share 3 (READ|WRITE) */
        移即(0, 0); 移寄存器(9, 0);   /* r9 = security NULL */
        移即(0, 2); 移栈寄存器64(32, 0);  /* [rsp+32] = CREATE_ALWAYS */
        移即(0, 0x80); 移栈寄存器64(40, 0); /* [rsp+40] = FILE_ATTRIBUTE_NORMAL */
        移即(0, 0); 移栈寄存器64(48, 0);  /* [rsp+48] = template NULL */
        移即(2, 0x40000000);              /* rdx = GENERIC_WRITE (default) */
        /* mode[0] */
        汇发("    零扩展 eax, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 3); /* movzx eax, byte[r11] */
        整 短高 = 新标号(), 标址 = 新标号(), 段辰 = 新标号();
        汇发("    比较字节即 r0, 0x72\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x3C); 发字节('r'); 零跳(-1); 补标号(码位-4, 短高, 1); /* 'r' �?read */
        汇发("    比较字节即 r0, 0x61\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x3C); 发字节('a'); 零跳(-1); 补标号(码位-4, 标址, 1); /* 'a' �?append */
        相对跳转(-1); 补标号(码位-4, 段辰, 2); /* 'w' defaults already set */
        设标号(短高);
        移即(2, 0x80000000);              /* rdx = GENERIC_READ */
        移即(0, 3); 移栈寄存器64(32, 0);  /* [rsp+32] = OPEN_EXISTING */
        相对跳转(-1); 补标号(码位-4, 段辰, 2);
        设标号(标址);
        移即(2, 0x4);                 /* rdx = FILE_APPEND_DATA �?闁告劖鐟﹀鍫熸交濠婂棙鍎?EOF */
        移即(0, 4); 移栈寄存器64(32, 0);  /* [rsp+32] = OPEN_ALWAYS */
        设标号(段辰);
        移64(1, 10); /* rcx = path */
        调导入(2);     /* CreateFileA */
        加栈即(64);
        移64(4, 15); /* mov rsp, r15 */
        /* fix 2026-08-18: CreateFileA 失败返回 INVALID_HANDLE_VALUE(-1) 而非 0!
           caller 的 if(fp) 只判 0 → 打开失败被当成功 → 对不存在的 .git/config 启动
           解析 → git init "bad config line 1"。将 -1 归一为 NULL(0)。 */
        { 整 反丑 = 新标号();
          汇发("    比较 rax, -1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xF8); 发字节(0xFF);
          非零跳(-1); 补标号(码位 - 4, 反丑, 1);
          移即(0, 0); /* rax = NULL */
          设标号(反丑); }
    } 否 若 (!比较字符串(串升, "fread")) {
        /* fread(ptr=rcx, size=rdx, nmemb=r8, stream=r9): ReadFile */
        移64(10, 9); /* r10 = handle */
        移64(11, 1); /* r11 = ptr */
        移64(14, 2); /* r14 = size (rdx) — 保存用于返回值 bytes/size (fix 2026-08-24 t35v) */
        移64(0, 2);  /* rax = size */
        汇发("    乘64 r0, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 0, 0); /* imul rax, r8 */
        移64(8, 0);  /* r8 = count */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &read */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* align */
        减栈即(48); /* shadow 32 + 1 stack arg 8 + pad 8  �? rsp%16==0 at call */
        移64(1, 10); /* rcx = handle */
        移64(2, 11); /* rdx = ptr */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = NULL */
        调导入(3);     /* ReadFile */
        加栈即(48);
        移64(4, 15);
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* eax = bytes read */
        /* fix 2026-08-24 t35v: C fread 返回元素数 = bytes/size (原返回字节数 → files-backend.c nread=fread(buf,cnt,1,f) 得 403≠1 → "cannot read 403 bytes" → rev-parse HEAD@{1} 失败) */
        移寄存器(9, 14); /* r9d = size */
        汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
        汇发("    无符号除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xF7); 模字节(3, 6, 1); /* DIV r9d */
    } 否 若 (!比较字符串(串升, "fwrite")) {
        /* fwrite(ptr=rcx, size=rdx, nmemb=r8, stream=r9): WriteFile
           stream==0 → stdout (git 的 FILE* stdout/stderr 值为 0; fix 2026-08-20:
           git ls-files write_name fputs/stdout 全打进无效句柄 0 → 无输出) */
        整 整零 = 新标号(), 终捌一 = 新标号();
        移帧寄存器(临时基 + 224 - 当前帧大小, 1); /* 保存 ptr(rcx) — GetStdHandle 破坏 rcx (fix 2026-08-20: 原 GetStdHandle 后 mov rcx→r11 读到垃圾 → strlen/WriteFile 错) */
        移64(11, 9); 测寄存器(11, 11); 零跳(-1); 补标号(码位 - 4, 整零, 1);
        移64(10, 11); /* r10 = stream (HANDLE) */
        相对跳转(-1); 补标号(码位 - 4, 终捌一, 2);
        设标号(整零);
        移即(1, -11); 减栈即(32); 调导入(0); 加栈即(32); /* GetStdHandle(STD_OUTPUT) */
        移64(10, 0); /* r10 = handle */
        设标号(终捌一);
        移寄存器帧(11, 临时基 + 224 - 当前帧大小); /* 恢复 ptr */
        移64(0, 2);  /* rax = size */
        汇发("    乘64 r0, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 0, 0); /* imul rax, r8 */
        移64(8, 0);  /* r8 = count */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &written */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48); /* shadow 32 + stack arg 8 + pad 8 (rsp%16==0 at call) — fix 2026-08-03: was 40, ABI misaligned */
        移64(1, 10); 移64(2, 11);
        移即(0, 0); 移栈寄存器64(32, 0);
        调导入(1);     /* WriteFile */
        加栈即(48);
        移64(4, 15);
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* eax = bytes written */
    } 否 若 (!比前n(串升, "atomic_load", 11)) {
        /* 接入 2026-08-28 机制层 #44 内存序: 真原子读 — atomic_load(ptr=rcx) → mov rax, [rcx]; acquire/seq_cst 加 mfence */
        发字节(0x48); 发字节(0x8B); 发字节(0x01); /* mov rax, [rcx] (REX.W=48 + 8B + modrm 01=[rcx]/rax) */
        若 (!比较字符串(串升, "atomic_load") || 查找子串(串升, "_acquire")) { 发字节(0x0F); 发字节(0xAE); 发字节(0xF0); } /* mfence (0F AE F0): 默认 seq_cst / acquire */
    } 否 若 (!比前n(串升, "atomic_store", 12)) {
        /* 接入 2026-08-28 机制层 #44 内存序: 真原子写 — atomic_store(ptr=rcx, v=rdx) → [release/seq_cst 前 mfence]; mov [rcx], rdx */
        若 (!比较字符串(串升, "atomic_store") || 查找子串(串升, "_release")) { 发字节(0x0F); 发字节(0xAE); 发字节(0xF0); } /* mfence: 默认 seq_cst / release */
        发字节(0x48); 发字节(0x89); 发字节(0x11); /* mov [rcx], rdx (REX.W=48 + 89 + modrm 11=[rcx]/rdx) */
    } 否 若 (!比较字符串(串升, "atomic_compare_exchange")) {
        /* 接入 2026-08-28 机制层: 真原子 CAS — atomic_compare_exchange(ptr=rcx, expected=rdx, new=r8)
           → mov rax, rdx (expected); lock cmpxchg [rcx], r8; rax = 旧值 (cmpxchg 语义: [rcx]==rax 则 [rcx]=r8, 否则 rax=[rcx]) */
        移64(0, 2); /* rax = rdx (expected) */
        汇发("    比较交换 [rcx], r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0xF0); 发字节(0x4C); 发字节(0x0F); 发字节(0xB1); 发字节(0x01); /* lock cmpxchg [rcx], r8 (REX.W+R=4C + 0F B1 + modrm 01=[rcx]/r8) */
    } 否 若 (!比较字符串(串升, "atomic_fetch_add")) {
        /* 接入 2026-08-28 机制层: 真原子 fetch-add — atomic_fetch_add(ptr=rcx, delta=rdx)
           → movsxd rax, edx (delta 32 位符号扩展 — fix 2026-08-28 P1 #7: 原 mov_rr64 高 32 位垃圾,
           64 位 lock xadd 写 8 字节污染相邻 data (Arc count+data 布局 → data+1 污染));
           lock xadd [rcx], rax; rax = 旧值, [rcx] += delta */
        发字节(0x48); 发字节(0x63); 发字节(0xC2); /* movsxd rax, edx (符号扩展 32→64) */
        汇发("    原子交换加 [rcx], rax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0xF0); 发字节(0x48); 发字节(0x0F); 发字节(0xC1); 发字节(0x01); /* lock xadd [rcx], rax (REX.W=48 + 0F C1 + modrm 01) */
    } 否 若 (!比较字符串(串升, "atomic_exchange")) {
        /* 接入 2026-08-28 机制层: 真原子交换 — atomic_exchange(ptr=rcx, v=rdx)
           → mov rax, rdx; xchg [rcx], rax; rax = 旧值, [rcx] = v (xchg 天然原子, 无需 lock) */
        移64(0, 2); /* rax = rdx (v) */
        汇发("    交换 [rcx], rax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0x48); 发字节(0x87); 发字节(0x01); /* xchg [rcx], rax (REX.W=48 + 87 + modrm 01) */
    } 否 若 (!比较字符串(串升, "fgetc")) {
        /* fgetc(stream=rcx): ReadFile(handle, &byte, 1, &read, NULL) → eax = byte; EOF → -1
           (fix 2026-08-18: 原非数学 builtin 落 else → mov_r_imm(0,0) 恒返 0 → git config 读取全 0
           → "bad config line 1"; 编译器 fopen 返回 CreateFileA HANDLE, 必须用 ReadFile 而非 msvcrt fgetc) */
        移64(10, 1); /* r10 = handle */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* and rsp,-16 */
        减栈即(48); /* shadow 32 + 1 stack arg 8 + pad 8 */
        移64(1, 10); /* rcx = handle */
        取帧址(2, 临时基 + 232 - 当前帧大小); /* rdx = &byte */
        移即扩(8, 1); /* r8 = 1 byte */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &read */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = NULL */
        调导入(3);     /* ReadFile */
        加栈即(48);
        移64(4, 15);
        { 整 余五 = 新标号(), 帧序一 = 新标号();
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* eax = bytes read */
        测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 余五, 1); /* read==0 → EOF */
        /* fix 2026-08-18: 读到的字节须 8 位零扩展 (movzbl eax, byte [scratch+232]) — 原 32 位 mov_reg_mbrp
           把 byte 缓冲的高 24 位栈残留一并返回 (ReadFile 只写 1 字节) → 高字节垃圾 (如 0x0b30d10a) →
           get_next_char 返回垃圾字符 → config 解析 isspace 查表越界 SEGV (git init 0xC0000005) */
        { 整 元 = 临时基 + 232 - 当前帧大小;
          若 (元 >= -128 && 元 <= 127) { 发字节(0x0F); 发字节(0xB6); 发字节(0x45); 发字节((无 字)元); }
          否 { 发字节(0x0F); 发字节(0xB6); 发字节(0x85); 发四(元); } }
        相对跳转(-1); 补标号(码位 - 4, 帧序一, 2);
        设标号(余五);
        移即(0, -1); /* EOF */
        设标号(帧序一); }
    } 否 若 (!比较字符串(串升, "fseek")) {
        /* fseek(stream=rcx, offset=rdx, origin=r8) → SetFilePointer(handle, offset, NULL, origin)
           stream==0 (stdin/stdout) → return 0 (fix 2026-08-24 t35t: reflog 反向读取 fseek(句柄)
           原走 msvcrt 需 FILE* 而 emit_fileio fopen 返回 HANDLE → reflog 崩) */
        整 外繁一 = 新标号(), 满辛 = 新标号();
        移64(10, 1); 测寄存器(10, 10); 零跳(-1); 补标号(码位 - 4, 外繁一, 1);
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移64(1, 10); /* rcx = handle */
        /* rdx = offset (参数原样) */
        移64(9, 8); /* r9 = origin — 必须在 r8 覆盖前保存 (fix 2026-08-24 t35v: 原 r8 先被 high=NULL 覆盖 → r9=0 (FILE_BEGIN) → fseek(SEEK_END) 移到文件头 → ftell=0 → reflog 反向读取空 → rev-parse HEAD@{1} "log is empty") */
        移即扩(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = NULL (high) */
        调导入(5); /* SetFilePointer */
        加栈即(48);
        移64(4, 15);
        移即(0, 0); /* return 0 */
        相对跳转(-1); 补标号(码位 - 4, 满辛, 2);
        设标号(外繁一);
        移即(0, 0); /* stream==0 → 0 */
        设标号(满辛);
    } 否 若 (!比较字符串(串升, "ftell")) {
        /* ftell(stream=rcx) → SetFilePointer(handle, 0, NULL, FILE_CURRENT=1)
           (fix 2026-08-24 t35t: 原走 msvcrt 拿句柄当 FILE* 崩) */
        整 半丑 = 新标号(), 原辛 = 新标号();
        移64(10, 1); 测寄存器(10, 10); 零跳(-1); 补标号(码位 - 4, 半丑, 1);
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移64(1, 10);
        移即(2, 0);
        移即扩(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 1); /* r9 method (mov_r_imm 不支持 r9, fix 2026-08-24 t35t) */ /* FILE_CURRENT */
        调导入(5);
        加栈即(48);
        移64(4, 15);
        相对跳转(-1); 补标号(码位 - 4, 原辛, 2);
        设标号(半丑);
        移即(0, 0);
        设标号(原辛);
    } 否 若 (!比较字符串(串升, "feof")) {
        /* feof(stream=rcx): cur=SetFilePointer(h,0,NULL,CUR); size=SetFilePointer(h,0,NULL,END);
           恢复 cur; return (cur >= size) — 句柄语义下无缓冲 EOF 标志, 用位置比较
           (fix 2026-08-24 t35t: strbuf_getwholeline 的 feof(句柄) 原走 msvcrt 崩) */
        整 名薄 = 新标号(), 上劣 = 新标号();
        移64(10, 1); 测寄存器(10, 10); 零跳(-1); 补标号(码位 - 4, 名薄, 1);
        移帧寄存器(临时基 + 256 - 当前帧大小, 10); /* 存 handle 到栈 (fix 2026-08-28: r10 是 volatile, SetFilePointer 调用后破坏 → size 查询用垃圾 handle 返 0xFFFFFFFF → feof 恒 0) */
        /* cur */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移寄存器帧(1, 临时基 + 256 - 当前帧大小); 移即(2, 0);
        移即扩(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 1); /* r9 method (mov_r_imm 不支持 r9, fix 2026-08-24 t35t) */ 调导入(5);
        加栈即(48); 移64(4, 15);
        移帧寄存器(临时基 + 240 - 当前帧大小, 0); /* 存 cur */
        /* size */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移寄存器帧(1, 临时基 + 256 - 当前帧大小); 移即(2, 0);
        移即扩(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 2); /* r9 method (mov_r_imm 不支持 r9) */ 调导入(5); /* FILE_END */
        加栈即(48); 移64(4, 15);
        移帧寄存器(临时基 + 248 - 当前帧大小, 0); /* 存 size */
        /* 恢复 cur */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移寄存器帧(1, 临时基 + 256 - 当前帧大小);
        移寄存器帧(2, 临时基 + 240 - 当前帧大小);
        移即扩(8, 0); /* r8 = high = NULL (fix 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; mov_r_imm 不支持 r8-r15, 用 mov_ri_ext) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 0); /* r9 method (mov_r_imm 不支持 r9) */ 调导入(5); /* FILE_BEGIN */
        加栈即(48); 移64(4, 15);
        /* return (cur >= size) */
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* eax = cur */
        压栈寄存器(0);
        移寄存器帧(0, 临时基 + 248 - 当前帧大小); /* eax = size */
        弹栈寄存器(3); /* ebx = cur */
        汇发("    比较 r3, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x39); 模字节(3, 0, 3); /* cmp rbx, rax → rbx-rax = cur-size */
        发字节(0x0F); 发字节(0x93); 模字节(3, 0, 0); /* setae al (cur >= size → EOF) */
        中失();
        相对跳转(-1); 补标号(码位 - 4, 上劣, 2);
        设标号(名薄);
        移即(0, 0); /* stream==0 → 0 (非 EOF) */
        设标号(上劣);
    } 否 若 (!比较字符串(串升, "fputc")) {
        /* fputc(c=rcx, stream=rdx): WriteFile(handle, &byte, 1, &written, NULL)
           stream==0 → stdout (fix 2026-08-20) */
        整 缓合 = 新标号(), 右置 = 新标号();
