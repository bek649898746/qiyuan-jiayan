            整 外二 = ((!比前n(串值 + 深乙, "ifndef", 6) && (串值[深乙 + 6] == 0 || 串值[深乙 + 6] == ' ' || 串值[深乙 + 6] == '\t' || 串值[深乙 + 6] == '\r' || 串值[深乙 + 6] == '\n')) || (!比前n(串值 + 深乙, "若无定义", 12) && (串值[深乙 + 12] == 0 || 串值[深乙 + 12] == ' ' || 串值[深乙 + 12] == '\t' || 串值[深乙 + 12] == '\r' || 串值[深乙 + 12] == '\n')));
            整 序粗 = !比前n(串值 + 深乙, "if", 2) && !是否条件编译 && !外二 && (串值[深乙 + 2] == 0 || 串值[深乙 + 2] == ' ' || 串值[深乙 + 2] == '\t' || 串值[深乙 + 2] == '\r' || 串值[深乙 + 2] == '\n');
            整 下环 = !比前n(串值 + 深乙, "elif", 4) && (串值[深乙 + 4] == 0 || 串值[深乙 + 4] == ' ' || 串值[深乙 + 4] == '\t' || 串值[深乙 + 4] == '\r' || 串值[深乙 + 4] == '\n');
            整 短再 = !比前n(串值 + 深乙, "else", 4) && (串值[深乙 + 4] == 0 || 串值[深乙 + 4] == ' ' || 串值[深乙 + 4] == '\t' || 串值[深乙 + 4] == '\r' || 串值[深乙 + 4] == '\n');
            整 短叁 = ((!比前n(串值 + 深乙, "endif", 5) && (串值[深乙 + 5] == 0 || 串值[深乙 + 5] == ' ' || 串值[深乙 + 5] == '\t' || 串值[深乙 + 5] == '\r' || 串值[深乙 + 5] == '\n')) || (!比前n(串值 + 深乙, "结束若", 9) && (串值[深乙 + 9] == 0 || 串值[深乙 + 9] == ' ' || 串值[深乙 + 9] == '\t' || 串值[深乙 + 9] == '\r' || 串值[深乙 + 9] == '\n')));
            整 内戊 = ((!比前n(串值 + 深乙, "define", 6) && (串值[深乙 + 6] == 0 || 串值[深乙 + 6] == ' ' || 串值[深乙 + 6] == '\t' || 串值[深乙 + 6] == '\r' || 串值[深乙 + 6] == '\n')) || (!比前n(串值 + 深乙, "定义词", 9) && (串值[深乙 + 9] == 0 || 串值[深乙 + 9] == ' ' || 串值[深乙 + 9] == '\t' || 串值[深乙 + 9] == '\r' || 串值[深乙 + 9] == '\n')));
