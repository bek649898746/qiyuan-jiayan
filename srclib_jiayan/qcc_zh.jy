        }
        串弊(反聚); /* 借用自动化 (2026-08-28 完善): 移入 目标 = 写目标 → 只读借用自动放还, 可变借用 [错误] (原此路径无 目标 借用检查) */
        { 整 当序 = 反聚; 整 度己 = 0; 循环 (当序 >= 0 && 度己 < 8 && (节型别[当序] == 节点_下标 || (节型别[当序] == 节点_成员 && 节值表[当序] == 0))) { 当序 = 子0[当序]; 度己++; } 若 (当序 >= 0 && 节型别[当序] == 节点_变量) { { 整 直父2 = -1; 整 尾扫2 = 反聚; 整 尾跳2 = 0; 整 尾深2 = 0; 循环 (尾扫2 >= 0 && 尾跳2 < 8 && (节型别[尾扫2] == 节点_下标 || 节型别[尾扫2] == 节点_成员 || 节型别[尾扫2] == 节点_箭头 || 节型别[尾扫2] == 节点_解引用)) { 若 (节型别[尾扫2] == 节点_成员) { 直父2 = 尾扫2; 尾深2++; } 尾扫2 = 子0[尾扫2]; 尾跳2++; } 若 (尾深2 <= 1) { 若 (直父2 >= 0 && 尾索((字*)(节名表 + 当序)) >= 0) 尾写字段((字*)(节名表 + 当序), (字*)(节名表 + 直父2)); 否 未初始化移除((字*)(节名表 + 当序)); } 否 { 字 尾径2[48]; 尾径2[0] = 0; 整 尾游2 = 反聚; 整 尾游跳2 = 0; 循环 (尾游2 >= 0 && 尾游跳2 < 8 && (节型别[尾游2] == 节点_下标 || 节型别[尾游2] == 节点_成员 || 节型别[尾游2] == 节点_箭头 || 节型别[尾游2] == 节点_解引用)) { 若 (节型别[尾游2] == 节点_成员) { 若 (尾径2[0]) { 字 尾新2[48]; 格式化到串(尾新2, "%s.%s", (字*)(节名表 + 尾游2), 尾径2); 复制字符串(尾径2, 尾新2); } 否 { 复制字符串(尾径2, (字*)(节名表 + 尾游2)); } } 尾游2 = 子0[尾游2]; 尾游跳2++; } 尾写路径((字*)(节名表 + 当序), 尾径2); } } 若 (尾阵索((字*)(节名表 + 当序)) >= 0) { 整 阵游2 = 反聚; 整 阵跳2 = 0; 循环 (阵游2 >= 0 && 阵跳2 < 8 && 子0[阵游2] != 当序) { 阵游2 = 子0[阵游2]; 阵跳2++; } 若 (阵游2 >= 0 && 节型别[阵游2] == 节点_下标) { 整 阵索节2 = 子1[阵游2]; 若 (阵索节2 >= 0 && 节型别[阵索节2] == 节点_常数) 尾阵触((字*)(节名表 + 当序), 节值表[阵索节2]); 否 尾阵触((字*)(节名表 + 当序), -1); } } 邻未((字*)(节名表 + 当序)); } } /* #78 完善: 移入 目标 = 初始化/重新绑定; I2-③: 字段路径登记; 元素级: 数组元素目标 → touched 置位 */
        { 整 槽目 = -1; 字 覆目标[64]; 覆目标[0] = 0;
          若 (反聚 >= 0 && 节型别[反聚] == 节点_变量) { 复制字符串(覆目标, (字*)(节名表 + 反聚)); 槽目 = 守卫槽找(覆目标); }
          整 块 = 建节(5);
          若 (槽目 >= 0 && 覆目标[0] && !节点含变(池列, 覆目标)) 接子(块, 守卫条件析构(槽目)); /* BatchB (2026-09-06): 移入覆写 守卫目标 旧值 条件析构 (Rust drop-on-overwrite; F 路径精确, 替代 ring3b 静态 析构序) */
          若 (净丙一) { /* #13: 覆写移动 → 调用钩子 钩子名(&目标, &源) (建节(11)=取地址, 被调者 最后 接子) */
              整 呼 = 建节(4);
              { 整 毛戊 = 建节(11); 接子(毛戊, 反聚); 接子(呼, 毛戊); }
              { 整 缺组 = 建节(11); 接子(缺组, 池列); 接子(呼, 缺组); }
              { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 尾厚, 64); 接子(呼, 函); }
              接子(块, 呼);
          } 否 {
              { 整 赋节 = 建节(10); 接子(赋节, 反聚); 接子(赋节, 池列); 接子(块, 赋节); } /* 目标 = 源; */
          }
          若 (槽目 >= 0) 接子(块, 守卫置F(槽目, 1)); /* 移入 = 初始化: 目标守卫 武装 (BatchB; 未守卫 空转) */
          若 (池列 >= 0 && 节型别[池列] == 节点_变量) { 整 槽源 = 守卫槽找((字*)(节名表 + 池列)); 若 (槽源 >= 0 && !守卫表[槽源].槽串) 接子(块, 守卫置F(槽源, 0)); } /* 源 非Copy 移出 → F=0 (BatchB: 仅本次 移源 撤就绪的源) */
          返 块;
        }
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "互斥锁")) { /* 接入 2026-08-28 机制层: 互斥锁声明 (内建自旋锁状态): 互斥锁 m; → { 整数 __mtx_m = 0; } — 0=未锁, 1=锁定; 锁住 m {..} 用真原子 CAS 自旋 */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 互斥锁 */
        字 邻壬[64]; 复制字符串(邻壬, 词名表[词位]); 词位++; /* 锁名 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        字 宏名[80]; 格式化到串(宏名, "__mtx_%s", 邻壬);
        变量偏移(宏名);
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 宏名, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(块, 元); } /* 整数 __mtx_m = 0; */
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "信号量")) { /* 接入 2026-08-28 阶段一 #56: 信号量声明 — 信号量 sem, n; → { 整数 __sem_sem = n; } 计数信号量 (n=初始许可数); 获取/放行 用真原子 CAS/xadd */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 信号量 */
        字 符号数[64]; 复制字符串(符号数, 词名表[词位]); 词位++; /* 名 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 实散 = 0; 若 (词型表[词位] == 常数) { 实散 = 词值表[词位]; 词位++; }
        若 (词型表[词位] == 分号) 词位++; /* ; */
        字 构名[80]; 格式化到串(构名, "__sem_%s", 符号数);
        变量偏移(构名);
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 构名, 32); 整 零 = 建节(0); 节值表[零] = 实散; 接子(元, 零); 接子(块, 元); } /* 整数 __sem_sem = n; */
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "获取")) { /* 接入 2026-08-28 阶段一 #56: 信号量 P 操作 — 获取 sem; → __qcc_sem_wait(&__sem_sem) 忙等到许可 */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 获取 */
        字 符号数[64]; 复制字符串(符号数, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        字 构名[80]; 格式化到串(构名, "__sem_%s", 符号数);
        整 呼 = 建节(4);
        { 整 值二 = 建节(1); 复制内存((字*)(节名表 + 值二), 构名, 32); 整 地址 = 建节(11); 接子(地址, 值二); 接子(呼, 地址); }
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "__qcc_sem_wait", 15); 接子(呼, 函); }
        返 呼;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "放行")) { /* 接入 2026-08-28 阶段一 #56: 信号量 V 操作 — 放行 sem; → __qcc_sem_post(&__sem_sem) 原子加许可 */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 放行 */
        字 符号数[64]; 复制字符串(符号数, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        字 构名[80]; 格式化到串(构名, "__sem_%s", 符号数);
        整 呼 = 建节(4);
        { 整 值二 = 建节(1); 复制内存((字*)(节名表 + 值二), 构名, 32); 整 地址 = 建节(11); 接子(地址, 值二); 接子(呼, 地址); }
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "__qcc_sem_post", 15); 接子(呼, 函); }
        返 呼;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "读写锁")) { /* 接入 2026-08-28 阶段一 #51: 读写锁声明 — 读写锁 rw; → { 整数 __rwl_rw = 0; } 状态: >0 读者数 / 0 空闲 / -1 写者 */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 读写锁 */
        字 邻轮[64]; 复制字符串(邻轮, 词名表[词位]); 词位++;
        若 (词型表[词位] == 分号) 词位++;
        字 链排[80]; 格式化到串(链排, "__rwl_%s", 邻轮);
        变量偏移(链排);
        整 块 = 建节(5);
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 链排, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(块, 元); }
