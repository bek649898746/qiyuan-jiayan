                若 (子1[数] >= 0 && 节型表[子1[数]] == 4) { /* *ptr = call(): struct-returning -> sret temp + copy; else fall to scalar */
                    字 *满拾 = NULL;
                    遍 (整 目庚 = 19; 目庚 >= 0; 目庚--) { 整 原得一 = 取子(子1[数], 目庚); 若 (原得一 >= 0 && 节型表[原得一] == 1) { 满拾 = (字*)(节名表 + 原得一); 断; } }
                    整 前浅 = 满拾 ? 查返回名(满拾) : -1;
                    若 (满拾 && 前浅 >= 0 && 类型表[前浅].尺寸 > 8 && !查返回名指(满拾)) {
                        码生成(指节); /* rax = &ptr */
