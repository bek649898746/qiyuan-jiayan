        若 (段[计] == '\'' && !入串) { /* 字符字面量 'x'/'\n'/'"' — 跳过 (fix 2026-08-14: attr.c *cp == '"' 的字符字面量被当字符串开始 → in_str 奇偶翻转 → GIT_PATH_FUNC 不展开 → 参数 STR 卡死) */
