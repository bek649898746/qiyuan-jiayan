   func_tbl indexes are re-assigned by gen_code's func_n=0 reset, so the same
   name-keyed pattern as fn_ret_name_map is required here. */
静 构 { 字 名[64]; 整 名庚一; } 当利[512]; 静 整 源午;
静 整 变参取(常 字 *名) {
    遍 (整 计 = 0; 计 < 源午; 计++) 若 (!比较字符串(当利[计].名, 名)) 返 当利[计].名庚一;
    返 -1;
}
静 空 变参放(常 字 *名, 整 名庚一) {
    遍 (整 计 = 0; 计 < 源午; 计++)
