                    前缀字节(0, 0, 0, 1); 发字节(0x88); 模字节(0, 0, 3); /* 移动 [后辰], 累加低 */
                    前缀字节(0, 0, 0, 1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 r11d */
                    前缀字节(0, 0, 0, 1); 发字节(0xFF); 模字节(3, 1, 2); /* 递减 r10d */
