                若 (!比较字符串(行排, "int8_t") || !比较字符串(行排, "uint8_t")) 容薄 = 1;
                否 若 (!比较字符串(行排, "int16_t") || !比较字符串(行排, "uint16_t")) 容薄 = 2;
                否 若 (!比较字符串(行排, "int64_t") || !比较字符串(行排, "uint64_t") || !比较字符串(行排, "size_t") || !比较字符串(行排, "uintptr_t") || !比较字符串(行排, "intptr_t") || !比较字符串(行排, "ptrdiff_t") || !比较字符串(行排, "off_t") || !比较字符串(行排, "time_t")) 容薄 = 8;
                词位++;
                若 (词型表[词位] == 右括) 词位++;
                整 数 = 建节(0); 节值表[数] = 容薄; 返 数;
            }
        }
        若 (词型表[词位] == 词变量) { /* sizeof(varname): array -> N*esz, double -> 8, char -> 1, ptr -> 8, else 4 */
            整 尺寸 = 4;
            整 元素尺寸 = 4; /* element size, for sizeof(varname[0]) (fix 2026-08-17) */
            整 基构序 = -1; /* struct type of the base var (for sizeof(e->field)) */
            遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--)
                若 (!比较字符串(变量表[变序].名, 词名表[词位]) && 变量码生成可见(变序)) {
                    若 (变量表[变序].数组尺寸 > 0) { 整 终 = 变量表[变序].数组元素尺寸 ? 变量表[变序].数组元素尺寸 : 4; 元素尺寸 = 终; 整 值吉 = 变量表[变序].指元素尺寸 > 0 ? 变量表[变序].指元素尺寸 : 终; 尺寸 = 变量表[变序].数组尺寸 * 值吉; } /* fix 2026-08-28: esz=行大小 (sizeof(A[0])), sz=总字节用标量元素 (sizeof(A)) */
                    否 若 (变量表[变序].是否浮标) { 元素尺寸 = 8; 尺寸 = 8; }
                    否 若 (变量表[变序].是否字符标) { 元素尺寸 = 1; 尺寸 = 1; }
                    否 若 (变量表[变序].是否短标) { 元素尺寸 = 2; 尺寸 = 2; } /* fix 2026-08-27 特性#1: sizeof(short 变量/元素) 原 4 */
                    否 若 (变量表[变序].是否长标) { 元素尺寸 = 8; 尺寸 = 8; } /* long long / size_t 变量 (fix 2026-08-19: 原落 else sz=4 → sizeof(size_t 参数)=4 → bitsizeof 错 → st_mult 溢出误报) */
                    否 若 (变量表[变序].指元素尺寸 != 0) { 元素尺寸 = 变量表[变序].指元素尺寸; 尺寸 = 8; } /* pointer: p_esz=element size, slot is 8 bytes */
                    否 若 (变量表[变序].型序标 >= 0) { 元素尺寸 = 构尺寸(类型表[变量表[变序].型序标].名); 尺寸 = 元素尺寸; } /* struct 变量: sizeof = struct 大小 (fix 2026-08-19: init_repository_format memcpy(dst,&fresh,sizeof(fresh)) 原 sz=4 只拷 version → v1_only_extensions.nr/items 栈垃圾 → verify_repository_format 误入 v1-only 错误路径 → git status 死循环/崩溃) */
                    否 { 元素尺寸 = 4; 尺寸 = 4; }
                    基构序 = 变量表[变序].型序标;
                    断;
                }
            词位++; /* skip varname */
            循环 (词型表[词位] == 句点 || 词型表[词位] == 箭头) { /* -> / . member chain: sizeof(e->p->name) — 跟随后续成员直到最后字段 (fix 2026-08-15: precompose_utf8 sizeof(prec_dir->dirent_nfc->d_name) 原只跟一级 → d_name 泄漏 undefined) */
                词位++; /* skip ->/. */
                若 (词型表[词位] == 词变量) {
                    若 (基构序 >= 0) { 整 直弊 = 字段尺寸(类型表[基构序].名, 词名表[词位]); 若 (直弊 > 0) 尺寸 = 直弊; 整 符凶 = 构域元素(基构序, 词名表[词位]); 若 (符凶 > 0) 元素尺寸 = 符凶; 整 域型 = 字段类型序(类型表[基构序].名, 词名表[词位]); 若 (域型 >= 0) 基构序 = 域型; 否 基构序 = -1; }
                    词位++;
                }
            }
            若 (词型表[词位] == 左方) { /* sizeof(varname[0]): element size (fix 2026-08-17: [0] was left dangling -> postfix index on the const-size node -> deref of const base, 0xC0000005 in regress_const_structarr) */
                词位++; 若 (词型表[词位] == 常数 || 词型表[词位] == 词变量) 词位++; 若 (词型表[词位] == 右方) 词位++;
                尺寸 = 元素尺寸;
            }
            若 (词型表[词位] == 右括) 词位++; /* ) */
            整 数 = 建节(0); 节值表[数] = 尺寸; 返 数;
        }
        若 (词型表[词位] == 乘) { /* sizeof(*ptr) — 指针 deref: 指向类型大小 (fix 2026-08-13: 原 return -1 → token 错位, 镜像 v4 0xC0000005; hash-ll.h Clone memcpy(dst,src,sizeof(*dst))) */
            词位++; /* * */
            整 尺寸 = 8;
            整 构序 = -1;
            整 逆集 = 0;
            循环 (词型表[词位] == 左括) { 逆集++; 词位++; } /* fix 2026-08-19: 宏展开冗余括号 sizeof(*((src->items))) — COPY_ARRAY 的 sizeof(*(src)) 代入实参带括号 → 原见 ( 不解析直接返 8 → st_mult 收到 8 → status 崩 */
            若 (词型表[词位] == 词变量) {
                遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--)
                    若 (!比较字符串(变量表[变序].名, 词名表[词位]) && 变量码生成可见(变序)) {
                        若 (变量表[变序].指元素尺寸 > 0) 尺寸 = 变量表[变序].指元素尺寸;
                        构序 = 变量表[变序].型序标;
                        断;
                    }
                词位++; /* var name */
                /* fix 2026-08-19: sizeof(*src->items) — 成员链解引用 (COPY_ARRAY(dst->items, src->items, dst->nr)
                   → memcpy(..., st_mult(sizeof(*src->items), n)))。原只处理 *varname, src->items 悬空 →
                   parse 错位 → st_mult 收到垃圾 → status 崩。沿链解析: 指针字段 → 指向大小; struct 字段 → 下钻 */
                循环 (词型表[词位] == 句点 || 词型表[词位] == 箭头) {
                    词位++; /* -> / . */
                    若 (词型表[词位] == 词变量) {
                        若 (构序 >= 0) {
                            整 域型 = 字段类型序(类型表[构序].名, 词名表[词位]);
                            若 (字段是否指(构序, 词名表[词位])) {
                                整 高二 = 字段指元素(构序, 词名表[词位]);
                                若 (高二 > 0) 尺寸 = 高二; /* 指针字段: sizeof(*p->field) = 指向元素/结构大小 */
                                构序 = 域型 >= 0 ? 域型 : -1;
                            } 否 若 (域型 >= 0) {
                                构序 = 域型; 尺寸 = 类型表[构序].尺寸; /* struct 字段: 下钻, 中间值=结构大小 */
                            } 否 {
                                整 虚八 = 字段尺寸(类型表[构序].名, 词名表[词位]);
                                若 (虚八 > 0) 尺寸 = 虚八; /* 标量字段: sizeof(*p->ch) = 1 */
                                构序 = -1;
                            }
                        }
                        词位++;
                    } 否 断;
                }
            }
            循环 (词型表[词位] == 右括 && 逆集 > 0) { 逆集--; 词位++; } /* 内层闭合括号 (计数配对 — fix 2026-08-19) */
            若 (词型表[词位] == 右括) 词位++; /* sizeof 自身的外层 ) */
            整 数 = 建节(0); 节值表[数] = 尺寸; 返 数;
        }
        返 -1;
    }
    若 (词型表[词位] == 常数) { 整 数 = 建节(0); 节值表[数] = 词值表[词位]; 若 (词无符号表[词位]) 节无符号[数] = 1; 若 (词长表[词位]) { 节长标[数] = 1; 节长高[数] = 段属[词位]; } 词位++; 返 数; } /* u-/LL-suffix literals → flags (fix 2026-08-05) */
    若 (词型表[词位] == 终简) { 整 数 = 建节(0); 节值表[数] = 词值表[词位]; 节型表[数] = 终简; 节浮标[数] = 1; 词位++; 返 数; } /* double literal */
    若 (词型表[词位] == 词变量) {
        /* 过程宏调用 (2026-08-29 P2 #172): 注册名 + ( → 编译期执行函数 → 生成代码文本 → token 化就地拼接 → 续解析表达式 */
        若 (首申(词名表[词位]) && 词型表[词位 + 1] == 左括) {
            整 缓子 = 词位;
            字 净组[64]; 复制字符串(净组, 词名表[词位]);
            词位 += 2; /* 跳过 宏名 ( — ctfe_call_str 期望 tk 在实参开始 */
            静 字 全列[65536]; /* ⚠️ 静态缓冲 (fix 2026-08-29 #172): 64KB 栈局部会让 prim 帧 +64KB — parse 深递归叠加 serve_loop 1.75MB 栈帧 → 栈溢出 0xC00000FD (serve 崩基线不崩) */
            全列[0] = 0;
            若 (!毛重(净组, 全列, 大小(全列))) {
                循环 (词位 < 词容量 && 词型表[词位] != 右括 && 词型表[词位] != 词终) { 词位++; } 若 (词型表[词位] == 右括) 词位++;
                格式化到串(错缓冲, "过程宏: %s 展开失败 (函数须已定义且返回字符串, 参数须编译期常量, 函数体须 CTFE 可解释纯函数)", 净组);
                发错误("A9101", 错缓冲);
                整 旁退一 = 建节(0); 节值表[旁退一] = 0; 返 旁退一;
            }
            整 指终 = 词位; /* ) 之后 */
            整 号分 = 词序 - 指终;
            /* ⚠️ 拼接顺序 (fix 2026-08-29 #172): 尾部 [p_end, p_end+tail) 必须先备份 —
               pm_tokenize 落位 [mstart, mstart+gn) 在 gn 大于消费区时会覆盖尾部源,
               (平方和(3,4)→'(3*3)+(4*4)' 11>6 token → 尾部读成 '(' '4' → 表达式错乱成 call) */
            静 整 前重[4096]; 静 整 上五[4096]; 静 整 缺深[4096];
            静 整 前转[4096]; 静 整 池巳[4096]; 静 整 虚申[4096];
            静 字 首高一[4096][64];
            整 全成 = 号分; 若 (全成 > 4096) 全成 = 4096;
            遍 (整 暂隐 = 0; 暂隐 < 全成; 暂隐++) { 前重[暂隐] = 词型表[指终 + 暂隐]; 上五[暂隐] = 词值表[指终 + 暂隐]; 缺深[暂隐] = 词行表[指终 + 暂隐]; 前转[暂隐] = 词无符号表[指终 + 暂隐]; 池巳[暂隐] = 词长表[指终 + 暂隐]; 虚申[暂隐] = 段属[指终 + 暂隐]; 复制内存(首高一[暂隐], 词名表[指终 + 暂隐], 64); }
            整 泛数 = 副酉一(全列, 缓子); /* 生成代码落位 [mstart, mstart+gn) */
            若 (泛数 <= 0) {
                格式化到串(错缓冲, "过程宏: %s 生成代码含非法字符 (token 化失败)", 净组);
                发错误("A9102", 错缓冲);
                整 后子一 = 建节(0); 节值表[后子一] = 0; 返 后子一;
            }
            整 目标 = 缓子 + 泛数;
            若 (目标 + 号分 >= 词容量) { 输出到文件(错误流, "[ERR] 过程宏展开后 token 溢出\n"); 退出(1); }
            遍 (整 暂隐 = 0; 暂隐 < 全成; 暂隐++) { 词型表[目标 + 暂隐] = 前重[暂隐]; 词值表[目标 + 暂隐] = 上五[暂隐]; 词行表[目标 + 暂隐] = 缺深[暂隐]; 词无符号表[目标 + 暂隐] = 前转[暂隐]; 词长表[目标 + 暂隐] = 池巳[暂隐]; 段属[目标 + 暂隐] = 虚申[暂隐]; 复制内存(词名表[目标 + 暂隐], 首高一[暂隐], 64); }
            词序 = 目标 + 号分;
            词位 = 缓子;
            返 原级(); /* 递归解析生成代码 (作表达式) */
        }
        /* NULL = 0 (fix 2026-08-03: the self-host lexer has no preprocessor, so
           <stddef.h>'s #define NULL never reaches the parser — it fell through to
           an undefined identifier and compiled to a stale-register store) */
        若 (!比较字符串(词名表[词位], "NULL")) { 词位++; 整 数 = 建节(0); 节值表[数] = 0; 返 数; }
        若 (!比较字符串(词名表[词位], "__builtin_constant_p")) { /* GCC builtin: 编译期常量判断 → 返回 0 走运行时分支 (fix 2026-08-14: bswap.h 用, 原当函数调用 → undefined symbol) */
            词位++; /* 函数名 */
            若 (词型表[词位] == 左括) { 整 元 = 1; 词位++; 循环 (词位 < 词容量 && 元 > 0) { 若 (词型表[词位] == 左括) 元++; 否 若 (词型表[词位] == 右括) { 元--; 若 (元 <= 0) { 词位++; 断; } } 词位++; } } /* 跳过 (args) */
            整 数 = 建节(0); 节值表[数] = 0; 返 数;
        }
        若 (!比较字符串(词名表[词位], "__builtin_types_compatible_p")) { /* GCC builtin: 类型兼容判断 → 返回 0 (保守: 不兼容 → copyable=1 → BARF_UNLESS_COPYABLE 通过) (fix 2026-08-20: COPY_ARRAY 宏的 copyable 用 — 原当函数调用 → 括号/参数解析错乱 → copy_array 调用只压 1 参 → preprocess_options memcpy 参数错位 → git log 崩) */
            词位++; /* 函数名 */
            若 (词型表[词位] == 左括) { 整 元 = 1; 词位++; 循环 (词位 < 词容量 && 元 > 0) { 若 (词型表[词位] == 左括) 元++; 否 若 (词型表[词位] == 右括) { 元--; 若 (元 <= 0) { 词位++; 断; } } 词位++; } } /* 跳过 (typeof(...), char) — 不解析 typeof, 防括号配对破坏 */
            整 数 = 建节(0); 节值表[数] = 0; 返 数;
        }
        若 (!比较字符串(词名表[词位], "offsetof")) { /* offsetof(TYPE, MEMBER) = 成员字节偏移 (fix 2026-08-14: <stddef.h> 跳过 → offsetof 未展开当函数调用 → undefined symbol; fix 2026-08-15: __typeof__(*e) 嵌套括号 + const 前缀 → ent 泄漏 undefined) */
            词位++; /* offsetof */
            若 (词型表[词位] == 左括) {
                词位++; /* ( */
                整 长陆 = -1;
                循环 (词型表[词位] == 型词) 词位++; /* const/volatile 前缀 */
                若 (词型表[词位] == 结构词) { 词位++; 若 (词型表[词位] == 词变量) { 长陆 = 查类型(词名表[词位]); 词位++; } } /* struct Tag */
                否 若 (词型表[词位] == 词变量) { 长陆 = 查类型(词名表[词位]); 若 (长陆 < 0) 长陆 = 容成(词名表[词位]); 词位++; } /* typedef 名 — fix 2026-08-20: offsetof(z_stream, m) typedef 名≠struct名(z_stream vs z_stream_s) → st_find 失败 → off=0 → git-zlib z_stream 字段全 0 → deflate Z_MEM_ERROR */
                { 整 元 = 0; 循环 (词位 < 词容量 && 词型表[词位] != 词终) { /* 跳过剩余类型 token 到顶层逗号 (__typeof__(*e) 嵌套括号) */
                    若 (词型表[词位] == 逗号 && 元 == 0) 断;
                    若 (词型表[词位] == 右括 && 元 == 0) 断;
                    若 (词型表[词位] == 左括 || 词型表[词位] == 左方) 元++;
                    否 若 (词型表[词位] == 右括 || 词型表[词位] == 右方) 元--;
                    词位++;
                } }
                整 偏移 = 0;
                若 (词型表[词位] == 逗号) 词位++; /* , */
                若 (长陆 >= 0 && 词型表[词位] == 词变量) { 偏移 = 类型偏移(类型表[长陆].名, 词名表[词位]); 词位++; } /* 字段名 */
                { 整 元 = 0; 循环 (词位 < 词容量 && 词型表[词位] != 词终) { 若 (词型表[词位] == 左括) 元++; 否 若 (词型表[词位] == 右括) { 若 (元 <= 0) { 词位++; 断; } 元--; } 词位++; } } /* 跳到匹配 ) */
                整 数 = 建节(0); 节值表[数] = 偏移; 返 数;
            }
            词位++; 整 子2 = 建节(0); 节值表[子2] = 0; 返 子2;
        }
        /* enum constant? */
        整 评值 = 全回(词名表[词位]);
        若 (评值 != 0x80000000) { 词位++; 整 数 = 建节(0); 节值表[数] = 评值; 返 数; } /* fix 2026-08-09: != 哨兵而非 >= 0 (负值常量 RED=-2) */
        若 (后子(词名表[词位])) { 若 (目系) { 若 (目凶一 < 8) { 复制字符串(毛玖[目凶一++], 词名表[词位]); } } 否 若 (!首己) { 格式化到串(错缓冲, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能读取 (v3.0 #5)", 词名表[词位]); 发错误("A3101", 错缓冲); } } /* 接入 2026-08-28 机制层 #5: 移动后源彻底失效 — 右值读即 [ERR]; 左值解析期(asgn_lhs_parsing)记入缓冲由 asgn 事后判定 (赋值=重新初始化放行/非赋值=右值读报错); 移入目标(dst)是写跳过 */
        若 (尾系(词名表[词位])) { 若 (目系 && !宽低) { 若 (旧辛 < 8) { 复制字符串(容进[旧辛++], 词名表[词位]); } } 否 若 (!首己 && !宽低) { 格式化到串(错缓冲, "明确初始化: 变量 '%s' 未初始化就读取 (声明须初始化或先赋值, v3.0 #78)", 词名表[词位]); 发错误("A4001", 错缓冲); } } /* 接入 2026-08-28 机制层 #78: 读取未初始化变量 = C 头号隐蔽 bug → 编译期拦截 (赋值左值记缓冲由 asgn 事后判定/移入目标跳过); fix 2026-08-30 探雷雷6: &x 取地址不读值, addr_of_parsing 时豁免 (直接报错 + lv_uninit 缓冲登记都不做) */
