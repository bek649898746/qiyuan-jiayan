                循环 (串值[指] && 串值[指] != ')' && 圆周率 < 16) { /* fix 2026-08-07: pi<16 防垃圾输入死循环 (原无界 → `...` 死转) */
                    循环 (串值[指] == ' ' || 串值[指] == '\t' || 串值[指] == ',') 指++;
                    循环 ((串值[指] == '\\' && 串值[指 + 1] == '\n') || (串值[指] == '\\' && 串值[指 + 1] == '\r' && 串值[指 + 2] == '\n')) { /* fix 2026-08-15: 参数列表续行 \ (mergesort.h DEFINE_LIST_SORT_DEBUG 参数跨两行 — 原把 on_get_next,on_set_next 当 body 泄漏) */
