        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 内名, 32); 接子(元, 值巳); 接子(块, 元); } /* int __sw = x; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 外肆, 32);
