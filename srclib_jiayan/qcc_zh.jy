                    若 (域偏移一 < 0) { /* 修复 2026-08-18: 数组[i].字段=表达式 的基是字段链 (存储->已解析[nr].开始=开始) — 参值 是字段名 (已解析) 非变量 → 沿基链解析元素 结构体 (原 域偏移一=-1 整段跳过 → 事件数组从未写入 → 配置 写循环读全 0)
                                       修复 2026-08-19: 二级字段链 (d->在.g[i].分配) 原单遍上溯只解析 .在 → 末属 (恰好有 分配@0) → 误写 g[i]+0; 镜像 例-15 读路径两阶段: 上溯找链根变量 + 下钻全链字段类型 → 元素 */
                        整 列得 = 子0[子0[微码]];
                        整 基构序 = -1;
                        整 深度 = 0;
                        循环 (列得 >= 0 && 深度 < 8 && (节型别[列得] == 节点_成员 || 节型别[列得] == 节点_箭头)) {
                            字 *逆未 = (字*)(节名表 + 子0[列得]);
                            整 间四 = 变量型序(逆未);
                            若 (间四 >= 0) { 基构序 = 间四; 断; }
                            列得 = 子0[列得]; 深度++;
                        }
                        若 (基构序 >= 0) {
                            整 堆低[8]; 整 计数一 = 0;
                            整 寻 = 子0[子0[微码]];
                            循环 (寻 >= 0 && 计数一 < 8 && (节型别[寻] == 节点_成员 || 节型别[寻] == 节点_箭头)) { 堆低[计数一++] = 寻; 寻 = 子0[寻]; }
                            整 当构序 = 基构序;
                            遍 (整 丙序 = 计数一 - 1; 丙序 >= 0 && 当构序 >= 0; 丙序--) {
                                字 *源捌 = (字*)(节名表 + 堆低[丙序]);
