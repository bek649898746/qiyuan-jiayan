                若 (串值[计] >= '0' && 串值[计] <= '7') { /* 八进制转义 '\033' — 原只吃 1 位, 剩余 33' 重新 lex → token 错位, non_ascii 函数体吞掉后续顶层函数 (fix 2026-08-15: pretty.c len undefined) */
                    整 直戊一 = 0, 主己 = 0;
                    循环 (主己 < 3 && 串值[计] >= '0' && 串值[计] <= '7') { 直戊一 = 直戊一 * 8 + (串值[计] - '0'); 计++; 主己++; }
                    字值 = 直戊一;
                } 否 {
                    字值 = (串值[计] == 'n') ? '\n' : (串值[计] == 't') ? '\t' : (串值[计] == '0') ? 0 : (串值[计] == 'r') ? '\r' : (串值[计] == 'f') ? '\f' : (串值[计] == 'v') ? '\v' : 串值[计]; 计++; /* fix 2026-08-23 t35d: \r \f \v 转义未处理 → blank=" \t\n\r\f\v" 编译成 'r''f''v' → strcspn 找不到空白 → attr.c parse_attr_line namelen 错 → "]bina" 警告 */
                }
            }
            否 计++;
            若 (串值[计] == '\'') 计++;
            词型表[词序] = 常数; 词值表[词序] = 字值; { 词行表[词序] = 当前行; 素集 = 当前行; 词序++; } 续;
        }
        择 (串值[计]) { 例 '+': 词型表[词序] = 串值[计 + 1] == '+' ? (计++, 增增) : 串值[计 + 1] == '=' ? (计++, 加等) : 加; 断; 例 '-': 词型表[词序] = 串值[计 + 1] == '>' ? (计++, 箭头) : 串值[计 + 1] == '-' ? (计++, 减减) : 串值[计 + 1] == '=' ? (计++, 减等) : 减; 断; 例 '*': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 乘等) : 乘; 断; 例 '/': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 除等) : 除; 断; 例 '%': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 隔伍) : 取余; 断; 例 '&': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 与等) : 串值[计 + 1] == '&' ? (计++, 逻辑与) : 点; 断; 例 '|': 词型表[词序] = 串值[计 + 1] == '>' ? (计++, 满再一) : 串值[计 + 1] == '=' ? (计++, 或等) : 串值[计 + 1] == '|' ? (计++, 逻辑或) : 或; 断; /* 接入 2026-08-27 管道操作符: | > → PIPE (a |> f = f(a)) */ 例 '^': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 异或等) : 异或; 断; 例 '~': 词型表[词序] = 按位非; 断; 例 '?': 词型表[词序] = (串值[计 + 1] == '.') ? (计++, 长粗) : 问号; 断; /* ?. 可选链 → QA (接入 2026-08-28); 普通 ? → QU 三目 */ 例 '.': 若 (串值[计 + 1] == '?') { 计++; 词型表[词序] = 长粗; } /* 可选链 ?. → QA (接入 2026-08-28: a?.b = a 非空 ? a->b : 0) */ 否 若 (串值[计 + 1] >= '0' && 串值[计 + 1] <= '9') { 整 副吉, 深庚一; 行丁(串值, &计, &副吉, &深庚一); 若 (串值[计] == 'f' || 串值[计] == 'F') 计++; 若 (浮数 >= 8192) { 输出到文件(错误流, "[ERR] double tbl full\n"); 退出(1); } 现退[浮数] = 副吉; 逆组[浮数] = 深庚一; 词型表[词序] = 终简; 词值表[词序] = 浮数; 浮数++; { 词行表[词序] = 当前行; 素集 = 当前行; 词序++; } 续; } 词型表[词序] = 句点; 断; 例 '=': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 高平) : 赋号; 断; 例 '<': 词型表[词序] = 串值[计 + 1] == '<' ? (串值[计 + 2] == '=' ? (计 += 2, 左移一) : (计++, 左移)) : 串值[计 + 1] == '=' ? (计++, 元九) : 下双; 断; 例 '>': 词型表[词序] = 串值[计 + 1] == '>' ? (串值[计 + 2] == '=' ? (计 += 2, 右移一) : (计++, 右移)) : 串值[计 + 1] == '=' ? (计++, 首降) : 终附; 断; 例 '!': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 顺八) : 总零; 断; 例 ';': 词型表[词序] = 分号; 断; 例 ',': 词型表[词序] = 逗号; 断; 例 '(': 词型表[词序] = 左括; 断; 例 ')': 词型表[词序] = 右括; 断; 例 '{': 词型表[词序] = 左花; 断; 例 '}': 词型表[词序] = 右花; 断; 例 '[': 词型表[词序] = 左方; 断; 例 ']': 词型表[词序] = 右方; 断; 例 ':': 词型表[词序] = 冒号; 断; 缺: 半壬++; 计++; 续; } { 词行表[词序] = 当前行; 素集 = 当前行; 词序++; } 计++; /* fix 2026-08-13 Phase3: default 不发射 token (原 ti++ 留下 tt=0=EK 幽灵 token 截断 parse) */
    }
    若 (半壬) 输出到文件(错误流, "[WARN] lex: %d 未知字符被忽略为空白 (fix 2026-08-09 BUG-5)\n", 半壬);
}

