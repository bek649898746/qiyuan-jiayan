    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0;
    变量表[变量数].指元素尺寸 = 指元素; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = -1;
