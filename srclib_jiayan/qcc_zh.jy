静 字 字段可空待名[64]; 静 整 字段可空待序 = -1; /* R391 ⚠️ 必须定义在 `字段尺寸递归` **之前** (390 版 放在 L3340 旧表位置 ⟹ 该函数内 被当 隐式局部 恒 0 ⟹ 落位永不生效; 最小插桩 实测 `登 构序=3` 与 `到点 待序=0` 并存) */
静 空 字段尺寸递归(整 构序, 常 字 *函, 整 域尺寸, 整 行, 整 对齐依) { /* 对齐依 (D5/D9 2026-09-13): 数组字段 的 **对齐依据** = 元素类型 尺寸. 与 `行` 拆开 是因为 `行` 还 要 存进 字段.域行数 (多维 索引 第一维 缩放) —— 两者 在多维 数组 上 不 同 (行=行宽, 对齐依=元素尺寸); 旧法 用 行 兼 两职 → 多维 字段 被 判 8 对齐 (结构体 总尺寸 +4). */
    若 (函[0] != '_' && 是保留函名(函)) { 格式化到串(错缓冲, "字段名 '%s' 是 保留词/内建名, 不能作 字段名 (声明会被静默吞掉 ⟹ 静默错值 或 死循环; 请改名) (号合.0, 撞词家族 R434 2026-09-30)", 函); 发错误("A9001", 错缓冲); }
    若 (类型表[构序].函 >= 1024) { 输出到文件(错误流, "[ERR] 结构体 '%s' 字段超过 1024 上限\n", 类型表[构序].名); 退出(1); }
     
    若 (取环境("QCC_DBG_NS")) 若 (!比较字符串(类型表[构序].名, "gz3") || !比较字符串(类型表[构序].名, "z_stream_s") || !比较字符串(类型表[构序].名, "git_zstream") || 查找子串(类型表[构序].名, "z_stream") || !比较字符串(类型表[构序].名, "config_set") || !比较字符串(类型表[构序].名, "hashmap") || !比较字符串(类型表[构序].名, "configset_list") || !比较字符串(类型表[构序].名, "string_list")) 输出到文件(错误流, "[FLD] struct '%s' fld='%s' fsz=%d frow=%d idx=%d\n", 类型表[构序].名, 函, 域尺寸, 行, 类型表[构序].函); /* 暂存 diag */
    整 序标 = 类型表[构序].函;
    若 (字段可空待名[0] && 字段可空待序 == 构序 && !比较字符串(字段可空待名, 函)) { 类型表[构序].字段[序标].可空标 = 1; 字段可空待名[0] = 0; 字段可空待序 = -1; } /* R391: 待定 可空字段 就地 落位 (名+构序 双匹配, 落位即清) */
    /* 修复 2026-08-06: 结构体 字段对齐填充（字符+整数 应 8 非 5）。对齐单位由 行（元素/行大小）推导:
       行>=8 → 8 (双精度/邻辰/指针); 行>=4 → 4 (整数/单精度); 行>=2 → 2 (短整)。数组字段 行=元素大小。
       修复 2026-08-07: 域尺寸>=8 也 8 对齐 — 指针字段 (结构体 LNode* 下一) 调用传 行=1 → 原 对齐=1 → 偏移错位 (读 [&b+4] 而非 +8) */
    整 深庚 = 1;
    若 (标合 > 1) { 深庚 = 标合; 标合 = 1; } /* 修复 2026-08-19: 结构体 类型成员按结构体自身对齐 (FILETIME=4 非按大小 8 → WIN32_FIND_DATAW cFileName@44 非 48 — 前巳一 SDK 布局) */
    否 若 (行 != 域尺寸) { /* 数组字段: 对齐按元素大小, 非总大小 — 修复 2026-08-19: wchar_t cFileName[260] 域尺寸=520 → 原 对齐=8 → 偏移 48 错 (应 44, wchar_t 对齐 2)
        D5/D9 (2026-09-13): 依据 由 `行` 改 `对齐依` —— 多维 数组 的 行 是 行宽 (12/192...), 元素 尺寸 才 是 对齐 依据 (原 12>=8 → 判 8 对齐 → 结构体 总尺寸 +4; 见 c_array_field_oracle 32 vs gcc 28). 调用点 传 对齐依 = 元素尺寸; 未传 (=行) 时 行为 与 旧 完全一致. */
        整 依联 = 对齐依 > 0 ? 对齐依 : 行;
        若 (依联 >= 8) 深庚 = 8;
        否 若 (依联 >= 4) 深庚 = 4;
        否 若 (依联 >= 2) 深庚 = 2;
    }
    否 若 (行 >= 8 || 域尺寸 >= 8) 深庚 = 8;
    否 若 (行 >= 4 || 域尺寸 >= 4) 深庚 = 4;
    否 若 (行 >= 2 || 域尺寸 >= 2) 深庚 = 2;
    若 (旁联 > 0) { /* 修复 2026-08-25 步二十一: _Alignas(N) 显式对齐覆盖自然对齐 (只增不减); 消费后清零 — 结构体 前简 {_Alignas(8) 字符} → 尺寸 8, A4 {字符,_Alignas(8) 整数} → i@8 尺寸 16 */
        若 (旁联 > 深庚) 深庚 = 旁联;
        旁联 = 0;
    }
    若 (类型表[构序].是否打包) 深庚 = 1; /* #231: 打包结构体字段紧凑 (无对齐填充); 满卯保持 1 → 结构体尺寸不轮 up */
    整 账二填 = (深庚 - (类型表[构序].尺寸 % 深庚)) % 深庚;
    类型表[构序].尺寸 += 账二填; /* 填充 字段偏移到对齐 (2026-09-03 账② 修复: 原 if 条件写自引用复杂表达式丢失, 拆临时变量) */
    复制字符串(类型表[构序].字段[序标].正辰, 函);
    类型表[构序].字段[序标].正聚 = 类型表[构序].尺寸;
    类型表[构序].字段[序标].现捌 = 域尺寸;
    复制内存(&类型表[构序].字段[序标].域行数, &行, 4); /* 修复 2026-08-05: direct 域行数[序标]=行 made 嵌套-存储 毛简一 读取 该 旧 构域行 -> 自身-referential 垃圾 于 自身-宿主; &数组[i] 缩放 由 该 已修 元素 尺寸 */
    类型表[构序].字段[序标].毛利 = -1; /* 非 a 结构体 字段 由 缺省 */
    类型表[构序].字段[序标].间次一 = 0; 类型表[构序].字段[序标].高玖 = 0; /* 非 位-字段 */
    类型表[构序].字段[序标].值劣 = 0; /* 非 位-字段: signedness irrelevant (修复 2026-08-05) */
    若 (字段浮待) { 类型表[构序].字段[序标].副优 = 1; 字段浮待 = 0; } /* A62: 各 内联解析路径 设 标记, 此处 统一 消费 (单点收口) */
    类型表[构序].字段[序标].错联标 = 0; 类型表[构序].字段[序标].内联 = 0; 类型表[构序].字段[序标].符肆 = 0; 类型表[构序].字段[序标].主挂 = 0; 类型表[构序].字段[序标].高贰 = 0; 类型表[构序].字段[序标].副戌 = 0; 类型表[构序].字段[序标].数组标 = 字段数组待; 字段数组待 = 0; /* 2026-09-04 虾米: 逐字段数组清零 — 标量字段曾残留上一结构体同槽垃圾 (构域元素/末凶一 误判 → 局部帧 8B 整成员读落 32 位); t12: 清零与消费合体 —— 无条件写入 字段数组待(1/0) 并清零, 顺序天然正确 */
    类型表[构序].字段[序标].原进 = 0; /* 指针字段标记: 字段解析处按 实丁 设置 (修复 2026-08-18) */ 若 (字段错联待) { 类型表[构序].字段[序标].错联标 = 1; 字段错联待 = 0; } /* R411: 同款单点收口 —— 字段解析处 置位, 此处 统一落位; ⚠️ 位置必须在「字段属性清零批（内联/原进 …）」**之后**，否则刚落位即被清零 */
    位槽 = -1; 位位 = 0; /* a 非-位-字段 结束 任意 待定 位 运行 */
    类型表[构序].尺寸 += 域尺寸;
    /* B7 (2026-09-29): 多维 数组字段 → **逐维行宽表** 写 域行数[0..n-1] (由内向外累乘).
       元素尺寸 **反推** = 域尺寸 / ∏维长表 (不依赖 对齐依 — 实测有调用点把 行宽 当 对齐依 传).
       非数组 (维长数 < 2) 不写 ⟹ 行为不变. */
    若 (维长数 >= 2) {
        整 总元B7 = 1;
        遍 (整 维jB7 = 0; 维jB7 < 维长数; 维jB7++) 总元B7 *= 维长表[维jB7];
        整 累宽B7 = (总元B7 > 0 && 域尺寸 >= 总元B7) ? (域尺寸 / 总元B7) : ((对齐依 > 0) ? 对齐依 : 行);
        若 (累宽B7 <= 0) 累宽B7 = (对齐依 > 0) ? 对齐依 : 行;
        遍 (整 维kB7 = 维长数 - 1; 维kB7 >= 0; 维kB7--) {
            类型表[构序].字段[序标].域行数[维kB7] = 累宽B7;
            若 (维kB7 > 0) 累宽B7 *= 维长表[维kB7];
        }
    }
    维长数 = 0;
    若 (深庚 > 类型表[构序].满卯) 类型表[构序].满卯 = 深庚; /* 记录 结构体 最大对齐（总大小 轮 up） */
    若 (取环境("QCC_DBG_NS")) 若 (类型表[构序].名[0] == 0 || 查找子串(类型表[构序].名, "ref_namespace") || 查找子串(类型表[构序].名, "pathspec")) 输出到文件(错误流, "[NS] fld '%s' field='%s' si=%d idx=%d foffs=%d fsz=%d frow=%d\n", 类型表[构序].名, 函, 构序, 序标, 类型表[构序].字段[序标].正聚, 域尺寸, 行);
    若 (取环境("QCC_DBG_NS")) 若 (查找子串(类型表[构序].名, "pathspec")) 输出到文件(错误流, "[NS!] fld '%s' field='%s' si=%d idx=%d foffs=%d fsz=%d frow=%d\n", 类型表[构序].名, 函, 构序, 序标, 类型表[构序].字段[序标].正聚, 域尺寸, 行); /* P0-10: 同上 */
    类型表[构序].函 = 类型表[构序].函 + 1;
    /* C1 (2026-09-29 第 385 站): 值类型 可空字段 → 追加 具名 tag 字段 `__nt_<名>` (B2 tag 区).
       ⚠️ 必须在 `函+1` **之后** —— 否则 tag 递归读未递增的 函 ⟹ 同索引 **覆盖本字段** (第 384 站病灶). */
    若 (可空值待) {
        可空值待 = 0; /* 先清 防递归 */
        字 标名C1[96];
        格式化到串(标名C1, "__nt_%s", 函);
        字段尺寸递归(构序, 标名C1, 4, 1, 1); /* R389: 域尺寸 1→4 — 1 落「域尺寸==1」残缺分支 (8 位存不发射); 4 走默认分支真写, 且布局不变 (tag 仍在 q+4 = 打包槽高 32) */
    }
}
静 整 字段序(整 构序, 常 字 *函) { 遍 (整 计 = 0; 计 < 类型表[构序].函; 计++) 若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) 返 计; 返 -1; }
静 整 构域元素(整 构序, 常 字 *函) { 整 序标 = 字段序(构序, 函); 返 (序标 >= 0 && 类型表[构序].字段[序标].内联 > 0) ? 类型表[构序].字段[序标].内联 : (序标 >= 0 ? 类型表[构序].字段[序标].域行数[0] : 1); } /* 数组字段元素大小; 未设置→行 (标量) */
静 整 字段指元素(整 构序, 常 字 *函) { 整 序标 = 字段序(构序, 函);  若 (序标 >= 0 && 类型表[构序].字段[序标].符肆 > 0) 返 类型表[构序].字段[序标].符肆; /* 修复 2026-08-21: 符肆 未设置/为 0 — 前向声明 结构体 T *字段 的指向元素大小未回填 (L5634 内构序>=0 分支用未完成 结构体 的 尺寸=0, 且不注册 池凶) → 回退 到字段类型的 构尺寸 (config_set* → 72) */ 若 (序标 >= 0) { 整 暂构序 = -1; 复制内存(&暂构序, &类型表[构序].字段[序标].毛利, 4); 若 (暂构序 >= 0 && 暂构序 < 4096) { 整 容薄 = 类型表[暂构序].尺寸; 若 (容薄 > 0) 返 容薄; } } 返 4; } /* 指针字段的指向元素大小 (修复 2026-08-17: 字符 *缓 → 1, 整数 * → 4; 未设置→4) */
静 整 上己(整 构序, 常 字 *函) { /* 修复 2026-08-22 t41b: 指针字段最终元素大小 — T** 双层下标第二维 (板[i][j] 元素 尺寸(T)); 单指针 T* 返回 尺寸(T) 等同 符肆 */ 整 序标 = 字段序(构序, 函); 若 (序标 >= 0 && 类型表[构序].字段[序标].主挂 > 0) 返 类型表[构序].字段[序标].主挂; 若 (序标 >= 0) { 整 暂构序 = -1; 复制内存(&暂构序, &类型表[构序].字段[序标].毛利, 4); 若 (暂构序 >= 0 && 暂构序 < 4096) { 整 容薄 = 类型表[暂构序].尺寸; 若 (容薄 > 0) 返 容薄; } } 返 字段指元素(构序, 函); }
静 整 反二(整 构序, 常 字 *函) { /* 修复 2026-08-22 t41b: 指针字段层级 (T*=1, T**=2) — 决定数组基的最大下标层数 */ 整 序标 = 字段序(构序, 函); 若 (序标 >= 0 && 类型表[构序].字段[序标].高贰 > 0) 返 类型表[构序].字段[序标].高贰; 若 (序标 >= 0 && 类型表[构序].字段[序标].原进 != 0) 返 1; 返 0; }
静 整 字段是否指(整 构序, 常 字 *函) { 整 序标 = 字段序(构序, 函); 返 序标 >= 0 && 类型表[构序].字段[序标].原进 != 0; } /* 指针字段标记 (结构体 X 星号 等; 修复 2026-08-18: 指针字段作数组基判定 — 原 域型==-1 漏判 结构体 指针字段) */
静 整 末凶一(整 构序, 常 字 *函) { 整 序标 = 字段序(构序, 函); 若 (序标 >= 0 && 类型表[构序].字段[序标].原进) 返 0; 若 (序标 < 0) 返 0; 若 (类型表[构序].字段[序标].数组标) 返 1; 若 (类型表[构序].字段[序标].内联 > 0) 返 类型表[构序].字段[序标].内联 != 类型表[构序].字段[序标].现捌; 返 类型表[构序].字段[序标].现捌 == 0; } /* 数组字段: 内联>0 且 内联(元素大小) != 现捌(总大小); 内联==0 时 现捌==0 → flex/空数组 字符 名[0] 也是数组 → 成员访问取地址 (修复 2026-08-20: dir_entry.名[FLEX_ARRAY=0] 域尺寸=0 原落 4 字节标量加载 → "hell" 当地址 → add_files %s 崩); 函数指 字段 内联==0, 标量 内联==fsize (修复 2026-08-16); 修复 2026-08-19: 指针字段 (原进=1) 的 内联=指向元素大小≠现捌=指针大小 → 被误判为内联数组 → s->下一输出[i] 保留字段地址+按 行(8) 缩放 → qcc_deflate_emit 拷贝写坏 z_stream (下一输出=7a/avail_out=-1) */
静 整 构域行(常 字 *符号数, 常 字 *函); /* 前向 */
静 整 字段是否浮(常 字 *符号数, 常 字 *函); /* 前向 */
静 空 剩未(整 构序, 常 字 *函) { /* 修复 2026-08-07: 结构体 数组字段 → 布好 2D 深度状态 (第一维行大小, 第二维元素大小) */
    整 行二 = 构域行(类型表[构序].名, 函);
    整 元素 = 构域元素(构序, 函);
    长卯 = 元素;                /* 解引用 用元素大小 */
    中系 = 0;
    上薄[0] = 行二;               /* 第一维 (行) 缩放 */
    上薄[1] = 元素;                /* 第二维 (列) 缩放 */
    上薄[2] = 0; 上薄[3] = 0;
    标拾 = (行二 > 元素) ? 2 : 1; /* 2D 字段: 第二维后才 解引用; 1D: 第一维后 */
    /* B7 (2026-09-29): 多维 数组 字段 → 逐维行宽表 (字段尺寸递归/联合字段 已填 域行数[0..n-1]).
       原 只给 上薄[0]/上薄[1] 两维 ⟹ 三维+ 的 **中间维** 步长 落 元素尺寸 (错);
       变量数组路径 早已 整表复制 ⟹ 本处 补 字段侧 同构. */
    { 整 序B7 = 字段序(构序, 函);
      若 (序B7 >= 0) {
          整 维B7 = 0;
          遍 (整 维kB7 = 0; 维kB7 < 4; 维kB7++)
              若 (类型表[构序].字段[序B7].域行数[维kB7] > 0) { 上薄[维kB7] = 类型表[构序].字段[序B7].域行数[维kB7]; 维B7 = 维kB7 + 1; }
          若 (维B7 >= 1) 标拾 = 维B7;
      }
    }
    码生成内存浮 = 终捌(构序, 函) ? 1 : 0;
    码生成内存单 = (码生成内存浮 && 构域元素(构序, 函) == 4) ? 1 : 0; /* R5 dao3 (2026-09-25 Qiyuan, station 363): 4-byte single-precision member ARRAY field must load with movss+cvtss2sd, not movsd. This unified member-field entry only ever set 码生成内存浮, while the array-variable paths set BOTH (L26357/L26421) ==> consumer L26336 fell into the else branch ==> 8-byte movsd ==> gfm.a[0] read 8.00 (= 1.5f spliced with 2.5f) and gf.a[0] read 0.00 (= 1.5f spliced with zero padding); all double member arrays were correct because movsd is right for them. Element width via 构域元素 (L2011), so float[1] and float[N] are both covered. NOTE: 终捌单 would NOT work here -- it tests 现捌 == 4, i.e. TOTAL array bytes, so float[N>1] always fails (separate defect D2, reported not fixed). Guarded by 码生成内存浮 and only turning 1 when element width == 4 ==> double and non-float member arrays keep the previous value 0 byte-for-byte, zero regression. */
    /* 2026-09-04 虾米 (挂账1 修复): 成员数组元素符号 — 例14 嵌套基 deref (21593/21595) 用 虚叁/右亥
       决定 i8/i16 符号扩展; 变量数组 由 例14 分支设 (L21607/21659), 成员数组基 全经 剩未 统一设:
       i8 元素 → 虚叁=1 (movsx), i16 有符号 → 虚叁=2 (movsxw), u8/u16/u32/u64 → 右亥=无符号 (节无符号)
       原漏设 → 恒零扩展 (t.c[0]=-1 读成 255) / u32/u64 无符号元素 64 位上下文符号扩展错 */
    若 (!字段是否指(构序, 函)) {
        整 元宽 = 构域元素(构序, 函);
        若 (元宽 == 1) 虚叁 = 原细(类型表[构序].名, 函) ? 1 : 0;
        否 若 (元宽 == 2) 虚叁 = 字段是否无符号(类型表[构序].名, 函) ? 0 : 2;
        否 虚叁 = 0;
        右亥 = 字段是否无符号(类型表[构序].名, 函);
    }
}
静 空 构域位(整 构序, 常 字 *函, 整 域尺寸, 整 行, 整 位宽, 整 长属) {
    /* 真 位-字段 语义: pack consecutive 位-字段 入 共享 整数 槽位.
       正聚 = 槽位 字节 偏移; 高玖 = 位 偏移 之内 该 槽位; 间次一 = 宽度.
       长属 = 1 遍 `无符号` 位-字段 (无 符号 extension 于 读取); 整数 → 有符号. */
    若 (类型表[构序].函 >= 1024) { 输出到文件(错误流, "[ERR] 结构体 字段超过 1024 上限\n"); 退出(1); }
    整 序标 = 类型表[构序].函;
    复制字符串(类型表[构序].字段[序标].正辰, 函);
    { /* D4 (2026-09-13): 位域 容器 宽度 按 基类型 — 原 硬编 32 位 槽 + 4 字节 (unsigned char a:1 占 4 字节; gcc = 1).
         域尺寸 即 基类型 宽度 (字符 1 / 短 2 / 整数 4 / 邻辰 8) → 槽宽 = 域尺寸 * 8. */
        整 槽宽D4 = 域尺寸 >= 8 ? 64 : (域尺寸 >= 4 ? 32 : (域尺寸 >= 2 ? 16 : 8));
        若 (位槽 < 0 || 位位 + 位宽 > 槽宽D4) { 位槽 = 类型表[构序].尺寸; 类型表[构序].尺寸 += 域尺寸 > 0 ? 域尺寸 : 4; 位位 = 0; }
    }
    类型表[构序].字段[序标].正聚 = 位槽;
    类型表[构序].字段[序标].现捌 = 域尺寸;
    复制内存(&类型表[构序].字段[序标].域行数, &行, 4);
    类型表[构序].字段[序标].毛利 = -1;
    类型表[构序].字段[序标].间次一 = 位宽;
    类型表[构序].字段[序标].高玖 = 位位;
    类型表[构序].字段[序标].值劣 = 长属;
    位位 += 位宽;
    若 (取环境("QCC_DBG_NS")) 若 (类型表[构序].名[0] == 0 || 查找子串(类型表[构序].名, "ref_namespace")) 输出到文件(错误流, "[NS] bit '%s' field='%s' si=%d idx=%d foffs=%d bitof=%d bw=%d uns=%d\n", 类型表[构序].名, 函, 构序, 序标, 类型表[构序].字段[序标].正聚, 类型表[构序].字段[序标].高玖, 位宽, 长属);
    类型表[构序].函 = 类型表[构序].函 + 1;
}
静 空 半四(整 构序, 整 位宽) {
    /* 匿名 位-字段 ": N" — occupies 符弊 but 寄存器 无 字段 (修复 2026-08-05).
       : 0 forces 该 下一 命名 位-字段 入 a fresh 整数 槽位 (C rule). */
    若 (位宽 > 0) {
        若 (位槽 < 0 || 位位 + 位宽 > 32) { 位槽 = 类型表[构序].尺寸; 类型表[构序].尺寸 += 4; 位位 = 0; }
        位位 += 位宽;
    } 否 {
        位槽 = -1; 位位 = 0; /* 零-宽度: 下一 字段 开始 a 新 槽位 */
    }
}
静 整 字段返浮待; /* A18 (2026-09-11): 结构体 字段 函数指针 「返回 浮」标记 — 字段态 型 只 记 指针性, 不 记 所指 函数 返回型 → 调用点 缺 节浮标 → 消费端 走 整数通道 (静默 错值 o.区(&r)+1.0 = 541229081.0) */
静 空 字段类型(整 构序, 常 字 *函, 整 现高) {
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 类型表[构序].字段[计].毛利 = 现高; 若 (现高 == -2 && 字段返浮待) 类型表[构序].字段[计].字段函浮 = 1; 返; } /* A41: 真结构 位 一处 收口 写; A3-7 (2026-09-12): 名键 侧表 字段函浮名/构 已 退役 (真结构 = 唯一 权威) */
}
静 空 字段登记(整 构序, 常 字 *函, 整 域尺寸, 整 行, 整 构型序, 整 对齐依) { /* 第1刀 (2026-09-12): 结构体字段 登记 **单点收口** —— 4 份 解析块 (① 尺寸() 内联匿名 ② 具名带父序 ③ 类型定义匿名 ④ 文件级匿名) 里 「字段尺寸递归 + 字段类型」 这对 永远同时出现 的 调用, 收进 一处: 漏登记 结构体类型序 (毛利) 在 结构上 不可能 (A2-prereq 病灶① = ③④ 各漏一次; 同 形态 已 复发 7 次) */
    若 (函[0] != '_' && 是保留函名(函)) { 格式化到串(错缓冲, "字段名 '%s' 是 保留词/内建名, 不能作 字段名 (声明会被静默吞掉 ⟹ 静默错值 或 死循环; 请改名) (号合.0, 撞词家族 R434 2026-09-30)", 函); 发错误("A9001", 错缓冲); }
    字段尺寸递归(构序, 函, 域尺寸, 行, 对齐依);
    若 (构型序 != -1) 字段类型(构序, 函, 构型序); /* T5 (2026-09-13): 原 条件 `>= 0` 只 透传 真 类型序, -2 (函数指针 标记) / -3 (接口 隐式槽) 被 静默 跳过 → 这两 类 调用点 无法 并入. -1 是 唯一 合法 「无类型」 值 → 条件 放宽 到 `!= -1`; 现有 调用点 只 传 -1 或 >= 0, 行为 逐字节 不变 */
}
/* 前向声明 结构体 标签 *字段 的标签回填 (修复 2026-08-18):
   ref_iterator 的 vtable 字段 — 结构体 ref_iterator_vtable 定义在后 (版本库 引用-内部.h 320 长简 478) →
   字段解析时 内构序=-1 走"未知标签指针字段"分支 (无 字段类型) → 字段类型序=-1 →
   内存地址 链 迭代->vtable->推进 断 → 函数指针调用目标塌缩成 迭代 → 调用 *迭代 → 版本库 初始化 段错误.
   标签 结构体定义时 (构加 / 定义体完成) 回填 毛利 索引 (字段大小/偏移早已按 8 字节指针就位). */
typedef 构 { 字 标名[64]; 整 借序; 字 段名[64]; } 待标录; /* A3 (2026-09-12): 前向声明 待回填 结构体标签 字段 真结构 — 原 3 个 按同下标对齐 的 平行数组 (余对/目凶/段对) 合成 一行记录; 判据 ③: 前置声明 注册表 是 pending 缓冲 而 非 语义旁路 → 收尾 = 索引化 */
静 空 指针字段标(整 构序, 整 域序, 整 层级, 整 基元) { /* R248 (2026-09-22) 虾米: **指针字段 元数据 写侧出口** ——
   原状: 「是 指针(原进) / 指针层级(高贰) / 最内层 元素 尺寸(主挂)」三位 在 各 字段 解析路径 里 各自 手写,
   其中 **型词 路径 (L17965)** 只 写 原进 + 符肆 ⟹ 高贰/主挂 恒 0 ⟹ `表达式指深`/`表达式内重` 对 成员基 恒 0
   ⟹ `struct box { float **pp; }` 的 `(*bx.pp)[i]` / `bx.pp[0][j]` 步长与浮性 全失 (R248 实测).
   镜像路径 (`暂构序`, t41b 2026-08-22) 已是 全套 —— 本出口 收口 这一 语义, 后续 各路径 逐步 并入. */
    类型表[构序].字段[域序].原进 = 1;
    类型表[构序].字段[域序].高贰 = (字)层级;
    类型表[构序].字段[域序].主挂 = 基元;
}

静 待标录 待标表[4096]; 静 整 满失;
静 空 堆丁(常 字 *标, 整 构序, 常 字 *函) {
    若 (满失 >= 4096) { 输出到文件(错误流, "[ERR] 待定 结构体标签表满 4096\n"); 退出(1); }
    复制字符串(待标表[满失].标名, 标); 待标表[满失].借序 = 构序; 复制字符串(待标表[满失].段名, 函); 满失++;
}
静 空 实重一(整 新构序) {
    整 逆复 = 类型表[新构序].尺寸;
    遍 (整 计 = 0; 计 < 满失; 计++)
        若 (!比较字符串(待标表[计].标名, 类型表[新构序].名)) {
            字段类型(待标表[计].借序, 待标表[计].段名, 新构序);
            /* 修复 2026-08-21: 前向声明 结构体 T *字段 的 符肆 也要回填 — 原只回填类型索引, 符肆=0 → 字段指元素 默认 4 → 分配数组(repo->配置,1) 的 尺寸(*(repo->配置))=4 → config_set 只分 4 字节 → git_configset_init 越界写 → hashmap 崩 */
            若 (逆复 > 0) { 整 标薄 = 字段序(待标表[计].借序, 待标表[计].段名); 若 (标薄 >= 0 && 类型表[待标表[计].借序].字段[标薄].符肆 <= 0) 类型表[待标表[计].借序].字段[标薄].符肆 = 逆复; 若 (标薄 >= 0 && 类型表[待标表[计].借序].字段[标薄].主挂 <= 0) 类型表[待标表[计].借序].字段[标薄].主挂 = 逆复; } /* 修复 2026-08-22 t41b: 主挂 同步回填 */
        }
}
静 整 字段类型序直(整 构序, 常 字 *函) { /* G1-1a (2026-09-12): 构序 直查 — 原名键版 走 「构序→名→查类型→构序」 全局 名 往返, 匿名 类型 (名="") 全部 撞 第一个 匿名 条目 → 嵌套 成员链 (hb.inner.f) 里层 类型序 断 (A42); 匿名 类型 的字段属性 查询 必须 构序 直查 */
    若 (构序 < 0 || 构序 >= 4096) 返 -1;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 整 值; 复制内存(&值, &类型表[构序].字段[计].毛利, 4); 返 值; }
    返 -1;
}
静 整 字段类型序(常 字 *符号数, 常 字 *函) {
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 -1;
    返 字段类型序直(构序, 函);
}
静 空 构域浮(整 构序, 常 字 *函) { /* 记 a 结构体 字段 作为 双精度 (8-字节 双精度移动 访问) */
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 类型表[构序].字段[计].副优 = 1; 返; }
}
静 整 字段是否浮(常 字 *符号数, 常 字 *函) {
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 若 (类型表[构序].字段[计].原进 != 0 && 类型表[构序].字段[计].字段函浮 == 0) 返 0; /* C133 (2026-09-19 第 127 站) */ 整 值 = 0; 复制内存(&值, &类型表[构序].字段[计].副优, 1); 返 值 != 0; } /* 修复 2026-08-05: `整数 v; 复制内存(&v,...,1)` 左 3 垃圾 字节 → 自身-宿主 flagged plain 字段 作为 双精度 → comparisons went 函数指针; v=0 zeroes 该 槽位 首 */
    返 0;
}
静 整 终捌(整 构序, 常 字 *函) { /* 修复 2026-08-27 特性#5: 按索引查 浮 — 匿名 结构体/联合 名="" 时 查类型 失败/错配 (u.c.r 链) */
    若 (构序 < 0) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 若 (类型表[构序].字段[计].原进 != 0 && 类型表[构序].字段[计].字段函浮 == 0) 返 0; /* C133 (2026-09-19 第 127 站): **数据指针字段 不是 双精度 值** —— 指针 声明路径 在 识别 double/float 时 已置 浮标记 (值肆/目薄一/末进一/标轮), 而 其后的 指针循环 只覆盖 域尺寸, 未清 浮标记 ⟹ `double *p` 字段的 副优 被误置 ⟹ 赋值 走 浮点存法 (cvtsi2sd + movsd) ⟹ 字段 存的 不是 指针 ⟹ 后续 下标/解引用 用 垃圾地址 → 段错误; 读 得 0.00.
    判据 排除 函数指针 字段 (原进 && 字段函浮) —— 那类 副优 确有 语义 (函数 返回 双精度), 见 L7236 既有 同款 排除. */
    整 值 = 0; 复制内存(&值, &类型表[构序].字段[计].副优, 1); 返 值 != 0; }
    返 0;
}
静 整 字段尺寸(常 字 *符号数, 常 字 *函); /* 前向 (定义 L1974) */
静 整 字段单浮(常 字 *符号数, 常 字 *函) { 返 (字段是否浮(符号数, 函) && 字段尺寸(符号数, 函) == 4) ? 1 : 0; } /* R4a-0b: 4B 单精度 float 字段 (存储 movss, 读提升) */
静 整 终捌单(整 构序, 常 字 *函) { 若 (构序 < 0) 返 0; 遍 (整 计 = 0; 计 < 类型表[构序].函; 计++) 若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) 返 (类型表[构序].字段[计].副优 && 类型表[构序].字段[计].现捌 == 4) ? 1 : 0; 返 0; } /* R4a-0b: 按构序查 4B 单浮字段 (匿名结构体用) */
静 整 终捌指(整 构序, 常 字 *函) { /* C133c (2026-09-19 第 127 站): **数据 指针 字段 的 指向元素 是否 双精度** (元素 语义).
    与 `终捌` 的分工: 终捌 = 字段 **值** 是 双精度 (已 排除 数据指针); 终捌指 = 字段 **指向的** 元素 是 双精度.
    载体 复用 `副优`: 指针 声明路径 识别 双精度/单精度 时 置 1 (值肆/目薄一/末进一), 其后 的 指针循环 只 覆盖 域尺寸, 未 清 该标记
    ⟹ 对 `双精度 *p` 字段, 副优 = 1 恰好 携带「指向 双精度」的 信息 (对 `长整 长整 *p` 字段 副优 = 0, 二者 在 域尺寸/符肆 上 同形, 只 此处 可 区分).
    消费点: 嵌套 基 下标 的 **写路径** (`s.p[i] = 值`) —— 存法 与 值准备 必须 按 元素 浮性 走 浮点 (原 `变量是否浮(基变量)` 对 结构体 恒 0 ⟹ 走 整数存 ⟹ 值 留在 xmm0 未落地 ⟹ 分型 M4 得 0.00). */
    若 (构序 < 0) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 若 (类型表[构序].字段[计].原进 == 0 || 类型表[构序].字段[计].字段函浮 != 0) 返 0; 整 值 = 0; 复制内存(&值, &类型表[构序].字段[计].副优, 1); 返 值 != 0; }
    返 0;
}
静 整 副优查(整 构序, 常 字 *函) { /* R5 刀1 (2026-09-24 启元 · 第 296 站): 字段自身 浮标 (不限指针). 与 终捌指 同构, 但 不设 `原进 == 0` 守卫 —— 数组/标量 字段 同样 有 浮标. */ 若 (构序 < 0) 返 0; 遍 (整 计 = 0; 计 < 类型表[构序].函; 计++) 若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 整 值 = 0; 复制内存(&值, &类型表[构序].字段[计].副优, 1); 返 值 != 0; } 返 0; }
静 空 字段大小(整 构序, 常 字 *函, 整 域尺寸) { 字段尺寸递归(构序, 函, 域尺寸, 1, 1); }
/* 联合 字段: 偏移 0, 尺寸 = 最大 的 全 字段 */
静 空 联合字段(整 构序, 常 字 *函, 整 域尺寸, 整 行) {
    若 (函[0] != '_' && 是保留函名(函)) { 格式化到串(错缓冲, "联合字段名 '%s' 是 保留词/内建名, 不能作 联合字段名 (声明会被静默吞掉 ⟹ 静默错值 或 死循环; 请改名) (号合.0, 撞词家族 R434 2026-09-30)", 函); 发错误("A9001", 错缓冲); }
    若 (类型表[构序].函 >= 1024) { 输出到文件(错误流, "[ERR] 结构体 字段超过 1024 上限\n"); 退出(1); }
    整 序标 = 类型表[构序].函;
    复制字符串(类型表[构序].字段[序标].正辰, 函);
    类型表[构序].字段[序标].正聚 = 0;
    类型表[构序].字段[序标].现捌 = 域尺寸;
    类型表[构序].字段[序标].域行数[0] = 行; /* 修复 2026-08-29 生成器: 标量 行=域尺寸 (原恒 1 → 值布 `域尺寸>行` 误判 嵌套(内存设置) → 初始化值丢, seed64/18); 数组字段 行=元素大小 (原 域尺寸 → c[4] 按 4 缩放 → regress_union 回归) */
    类型表[构序].字段[序标].毛利 = -1;
    类型表[构序].字段[序标].间次一 = 0; 类型表[构序].字段[序标].高玖 = 0; 类型表[构序].字段[序标].值劣 = 0; /* 联合 字段: 永不 位-字段 (修复 2026-08-05) */
    类型表[构序].字段[序标].错联标 = 0; 类型表[构序].字段[序标].内联 = 0; 类型表[构序].字段[序标].符肆 = 0; 类型表[构序].字段[序标].主挂 = 0; 类型表[构序].字段[序标].高贰 = 0; 类型表[构序].字段[序标].副戌 = 0; 类型表[构序].字段[序标].数组标 = 字段数组待; 字段数组待 = 0; /* 2026-09-04 虾米: 逐字段数组清零 (同 字段尺寸递归); t12: 联合成员 同样 清零与消费合体 (A63 同款 —— 防「只消费一处」) */
    若 (字段浮待) { 类型表[构序].字段[序标].副优 = 1; 字段浮待 = 0; } /* A63 (2026-09-14): **联合成员** 同样 消费 双精度标记 —— 原 只 有 字段尺寸递归 消费, 而 union 成员 走 本函数 ⟹ `union FU5 { int a; double b; } fu;` 的 fu.b 读 0.0 (gcc 5.5) */
    若 (域尺寸 > 类型表[构序].尺寸) 类型表[构序].尺寸 = 域尺寸;
    { /* D14 (2026-09-13): 联合 成员 对齐 汇总 — 原 本 处 不 更新 满卯 (字段尺寸递归 会 更新), 
         → union 作 结构体 字段 时 调用侧 标合 = 类型表[union].满卯 = 0 → 对齐 判定 落 「按 大小 猜」 分支
         → 16 字节 union (成员 含 数组) 被 判 8 对齐 → 外层 结构体 uoff 8 (应 4) / osz 24 (应 20).
         对齐 依据 与 字段尺寸递归 同 构: 数组 成员 按 元素尺寸 行, 标量 按 自身 大小. */
        整 深联 = 1;
        若 (行 != 域尺寸) { 若 (行 >= 8) 深联 = 8; 否 若 (行 >= 4) 深联 = 4; 否 若 (行 >= 2) 深联 = 2; }
        否 若 (行 >= 8 || 域尺寸 >= 8) 深联 = 8;
        否 若 (行 >= 4 || 域尺寸 >= 4) 深联 = 4;
        否 若 (行 >= 2 || 域尺寸 >= 2) 深联 = 2;
        若 (深联 > 类型表[构序].满卯) 类型表[构序].满卯 = 深联;
    }
    /* B7 (2026-09-29): 多维 数组 联合成员 → 逐维行宽表 (同 字段尺寸递归);
       元素尺寸 反推 = 域尺寸 / ∏维长表. */
    若 (维长数 >= 2) {
        整 总元J7 = 1;
        遍 (整 维jB7 = 0; 维jB7 < 维长数; 维jB7++) 总元J7 *= 维长表[维jB7];
        整 累宽J7 = (总元J7 > 0 && 域尺寸 >= 总元J7) ? (域尺寸 / 总元J7) : 行;
        若 (累宽J7 <= 0) 累宽J7 = 行;
        遍 (整 维kB7 = 维长数 - 1; 维kB7 >= 0; 维kB7--) {
            类型表[构序].字段[序标].域行数[维kB7] = 累宽J7;
            若 (维kB7 > 0) 累宽J7 *= 维长表[维kB7];
        }
    }
    维长数 = 0;
    类型表[构序].函 = 类型表[构序].函 + 1;
}
/* R1-B 锤A (2026-09-04): 判别 类型化载荷字段直接登记 — 指定绝对偏移 (联合式重叠), 真类型标记
   码: 0=整4B 1=双8B(浮) 2=短2B 4=长8B 5=无整4B 6=无短2B 8=无长8B (字符/指针/结构体 载荷 v2) */
静 空 判载字段(整 构序, 常 字 *函, 整 判偏, 整 判码, 整 判元, 整 判层, 整 判构序) { /* 第 179 站: +判构序 (指向 结构体 的 指针) */ /* 第 178 站 (#97 v2): +判元(指向元素尺寸)/判层(指针层级) —— 供 指针载荷 (码 9) */
    若 (类型表[构序].函 >= 1024) { 输出到文件(错误流, "[ERR] 结构体 字段超过 1024 上限\n"); 退出(1); }
    整 序标 = 类型表[构序].函;
    复制字符串(类型表[构序].字段[序标].正辰, 函);
    类型表[构序].字段[序标].正聚 = 判偏;
    整 判宽 = (判码 == 9) ? 8 : ((判码 == 10) ? 4 : ((判码 == 3 || 判码 == 7) ? 1 : ((判码 == 1 || 判码 == 4 || 判码 == 8) ? 8 : ((判码 == 2 || 判码 == 6) ? 2 : 4)))); /* 第 185 站: 码 10 (单精度) → 4 */ /* 第 178 站: 码 9 (指针) → 8 字节 */ /* 第 175 站 (#97): 补 1 字节 分支 (码 3/7) */
    类型表[构序].字段[序标].现捌 = 判宽;
    类型表[构序].字段[序标].域行数[0] = 判宽;
    类型表[构序].字段[序标].毛利 = (判码 == 9 && 判构序 >= 0) ? 判构序 : -1; /* 第 179 站 (#97 v2): 指向 **结构体** 的 指针载荷 → 记 构序 (实测必需: `a.p->x` 箭头访问 的类型推导 依赖它; 标量指针 载荷 判构序 = -1 ⟹ 仍 为 -1, 与 第 178 站 行为 一致) */
    类型表[构序].字段[序标].间次一 = 0; 类型表[构序].字段[序标].高玖 = 0;
    类型表[构序].字段[序标].值劣 = (判码 == 5 || 判码 == 6 || 判码 == 8 || 判码 == 7) ? 1 : 0; /* 无符号标记 (第 175 站: 含 码 7 无符号 字) */
    类型表[构序].字段[序标].副优 = (判码 == 1 || 判码 == 10) ? 1 : 0; /* 第 185 站: 浮点 标记 (码 1 双精度 / 码 10 单精度 4B —— 读写路径 用 `副优 && 现捌==4` 区分 单精度) */
    类型表[构序].字段[序标].副戌 = 0; 类型表[构序].字段[序标].原进 = (判码 == 9) ? 1 : 0; /* 第 178 站 (#97 v2): 指针载荷 → 指针字段标记 (读路径 据此 解引用/缩放, 与 普通指针字段 同构) */
    类型表[构序].字段[序标].内联 = (判码 == 9) ? 8 : 0; 类型表[构序].字段[序标].符肆 = (判码 == 9) ? 判元 : 0; 类型表[构序].字段[序标].主挂 = (判码 == 9) ? 判元 : 0; 类型表[构序].字段[序标].高贰 = (判码 == 9) ? (字)判层 : 0;
    若 (判偏 + 判宽 > 类型表[构序].尺寸) 类型表[构序].尺寸 = 判偏 + 判宽;
    整 判对齐 = 判宽 >= 8 ? 8 : (判宽 >= 4 ? 4 : (判宽 >= 2 ? 2 : 1));
    若 (判对齐 > 类型表[构序].满卯) 类型表[构序].满卯 = 判对齐;
    类型表[构序].函 = 类型表[构序].函 + 1;
}
__attribute__((原粗))
静 空 类型字段(整 构序, 常 字 *函) { 字段大小(构序, 函, 4); }
静 整 构域行(常 字 *符号数, 常 字 *函) {
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 整 值; 复制内存(&值, &类型表[构序].字段[计].域行数, 4); 返 值; }
    返 0;
}
静 整 类型偏移(常 字 *符号数, 常 字 *函) {
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 -1;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 整 值; 复制内存(&值, &类型表[构序].字段[计].正聚, 4);  返 值; }
    返 -1;
}
静 整 字段位宽(常 字 *符号数, 常 字 *函) { /* 位-字段 宽度, 0 = 非 a 位-字段 (修复 2026-08-05) */
