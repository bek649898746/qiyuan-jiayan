    }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "判类型") && 词型表[词位 + 1] == 左括) { /* 阶段C-1 #74 (2026-09-02): 判类型(x, T) 常量上下文求值 — 变量类型名 == T 词元名 (配合 编译期断言/编译期) */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 判类型 */
            词位++; /* ( */
            字 判名[64]; 复制字符串(判名, 词名表[词位]); 词位++; /* 变量 */
            若 (词型表[词位] == 逗号) 词位++; /* , */
            字 判型[64]; 复制字符串(判型, 词名表[词位]); 词位++; /* 类型名 */
            若 (词型表[词位] == 右括) 词位++;
