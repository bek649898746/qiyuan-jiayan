        移64(13, 8); 测寄存器(13, 13); 零跳(-1); 补标号(码位 - 4, 元列二, 1);
        相对跳转(-1); 补标号(码位 - 4, 余繁一, 2);
        设标号(元列二);
        移即(1, -10); 减栈即(32); 调导入(0); 加栈即(32); /* GetStdHandle(STD_INPUT) */
        移64(13, 0);
        设标号(余繁一);
        反附(临时基 + 244 - 当前帧大小, 13); /* handle */
        移即(0, 0); 移帧寄存器(临时基 + 252 - 当前帧大小, 0); /* count = 0 */
        设标号(列午);
        /* count >= size-1 → done */
        移寄存器帧(0, 临时基 + 252 - 当前帧大小); 压栈寄存器(0);
        移寄存器帧(0, 临时基 + 236 - 当前帧大小); 弹栈寄存器(3);
        汇发("    比较 r3, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x39); 模字节(3, 0, 3);
        发字节(0x0F); 发字节(0x93); 模字节(3, 0, 0); 中失(); /* count >= size-1 */
        测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 段辰, 1);
        /* ReadFile(handle, &byte, 1, &read, NULL) */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移寄存器帧64(1, 临时基 + 244 - 当前帧大小); /* rcx = handle */
        取帧址(2, 临时基 + 232 - 当前帧大小); /* &byte */
        移即扩(8, 1); /* r8 = 1 */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* &read */
        移即(0, 0); 移栈寄存器64(32, 0);
        调导入(3); /* ReadFile */
        加栈即(48); 移64(4, 15);
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* read */
        测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 剩进, 1); /* read==0 → EOF */
        /* str[count] = byte; eax 符号扩展 byte (movzx) */
        移寄存器帧64(3, 临时基 + 224 - 当前帧大小); /* rbx = 当前 str */
        { 整 元 = 临时基 + 232 - 当前帧大小;
          若 (元 >= -128 && 元 <= 127) { 发字节(0x0F); 发字节(0xB6); 发字节(0x45); 发字节((无 字)元); }
          否 { 发字节(0x0F); 发字节(0xB6); 发字节(0x85); 发四(元); } } /* movzx eax, byte[scratch+232] */
        移帧寄存器(临时基 + 232 - 当前帧大小, 0); /* 保存 byte 值 (供 '\n' 检查) */
        汇发("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0x88); 模字节(0, 0, 3); /* mov [rbx], al */
        /* str++ */
        移寄存器帧64(0, 临时基 + 224 - 当前帧大小);
        汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xFF); 模字节(3, 0, 0);
        反附(临时基 + 224 - 当前帧大小, 0);
        /* count++ */
        移寄存器帧(0, 临时基 + 252 - 当前帧大小);
        汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC0);
        移帧寄存器(临时基 + 252 - 当前帧大小, 0);
        /* byte == '\n' → done */
        移寄存器帧(0, 临时基 + 232 - 当前帧大小);
        汇发("    比较字节即 r0, 0x0a\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x3C); 发字节(0x0A);
        零跳(-1); 补标号(码位 - 4, 段辰, 1);
        相对跳转(-1); 补标号(码位 - 4, 列午, 2);
        设标号(段辰);
        /* *str = 0 */
        移寄存器帧64(3, 临时基 + 224 - 当前帧大小);
        移即(0, 0);
        汇发("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0x88); 模字节(0, 0, 3);
        移寄存器帧64(0, 临时基 + 220 - 当前帧大小); /* return 原始 str */
        相对跳转(-1); 补标号(码位 - 4, 目二, 2);
        设标号(剩进);
        /* EOF: 有字符 → 返回 str (需先 *str=0), 无字符 → NULL */
        移寄存器帧(0, 临时基 + 252 - 当前帧大小);
        测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 目二, 1); /* count==0 → 0 */
        移寄存器帧64(3, 临时基 + 224 - 当前帧大小);
        移即(0, 0);
        汇发("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0x88); 模字节(0, 0, 3);
        移寄存器帧64(0, 临时基 + 220 - 当前帧大小);
        相对跳转(-1); 补标号(码位 - 4, 目二, 2);
        设标号(目二);
    }
}

/* struct 逐块拷贝: rax=源地址, rbx=目标地址, csz 字节 (8/4 块; fix 2026-08-06 struct 值赋值)
   每步带 asm_emit 文本 —— 否则 -S 缺指令, H1==H2 崩 (fix 2026-08-06 route_learn 四核验证抓到) */
静 空 深利(整 逆平) {
    整 键 = 0;
    循环 (逆平 - 键 >= 8) {
        移寄存器内存64(1, 0); /* rcx = [rax] */
        汇发("    存64 [r3], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        前缀字节(1, 0, 0, 0); 发字节(0x89); 模字节(0, 1, 3); /* mov [rbx], rcx */
        后弊一(8);
        汇发("    加即64 r3, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        前缀字节(1, 0, 0, 0); 发字节(0x83); 模字节(3, 0, 3); 发字节(8); /* add rbx, 8 (64 位) */
        键 += 8;
    }
    若 (逆平 - 键 >= 4) {
        移寄存器内存(1, 0); /* ecx = [rax] */
        汇发("    存零 [r3], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0x89); 模字节(0, 1, 3); /* mov [rbx], ecx (去冗余 REX 0x40, 与存零文本一致) */
        后弊一(4);
        汇发("    加即64 r3, 4\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        前缀字节(1, 0, 0, 0); 发字节(0x83); 模字节(3, 0, 3); 发字节(4);
        键 += 4;
    }
}

/* int RHS → 64 位目标: 有符号 32 位值符号扩展 movsxd rax,eax
   (fix 2026-08-06: long long v=-7 存 64 位槽时零扩展 → 4294967289; 正数/unsigned/已 LL 不动) */
静 空 扩32(整 右侧) {
    若 (右侧 >= 0 && !节长标[右侧] && !节无符号[右侧]) {
        若 (节型表[右侧] == 1 && (变量指元素((字*)(节名表+右侧)) > 0 || 变量数组((字*)(节名表+右侧)) > 0)) 返; /* 指针/数组值不扩展 */
        汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0x48); 发字节(0x63); 模字节(3, 0, 0);
    }
}

/* fix 2026-08-11 汇编本身: __asm("指令") 字符串汇编编码器 (bin_mode).
   支持内核常用指令: hlt/nop/ret/sti/cli/int3/iretq + push/pop + mov/add/sub/cmp 寄存器/立即数.
   Intel 语法 "mov rax, 0x10" / "mov rax, rbx". */
静 整 栈八(常 字 *串值) {
    构 { 常 字 *数; 整 末丙; } 计浅一[] = {
        {"rax",0},{"rcx",1},{"rdx",2},{"rbx",3},{"rsp",4},{"rbp",5},{"rsi",6},{"rdi",7},
        {"eax",0},{"ecx",1},{"edx",2},{"ebx",3},{"esp",4},{"ebp",5},{"esi",6},{"edi",7},
        {"al",0},{"cl",1},{"dl",2},{"bl",3},{"spl",4},{"bpl",5},{"sil",6},{"dil",7},
        {"r8",8},{"r9",9},{"r10",10},{"r11",11},{"r12",12},{"r13",13},{"r14",14},{"r15",15},
        {"r8d",8},{"r9d",9},{"r10d",10},{"r11d",11},{"r12d",12},{"r13d",13},{"r14d",14},{"r15d",15},
    };
    遍 (整 计 = 0; 计 < (整)(大小(计浅一)/大小((计浅一)[0])); 计++) 若 (!比较字符串(串值, 计浅一[计].数)) 返 计浅一[计].末丙;
    返 -1;
}
静 空 值壹(常 字 *计肆) {
    字 缓[256]; 拷贝前n(缓, 计肆, 255); 缓[255] = 0;
    字 *算子 = 缓; 循环 (*算子 == ' ' || *算子 == '\t') 算子++;
    字 *缺聚 = 算子; 循环 (*缺聚 && *缺聚 != ' ' && *缺聚 != '\t' && *缺聚 != ',') 缺聚++;
    字 算子码[64]; 整 右利 = 缺聚 - 算子; 若 (右利 > 31) 右利 = 31; 复制内存(算子码, 算子, 右利); 算子码[右利] = 0;
    /* 接入 2026-08-29 P2 指令词表 v1.1: 中文指令等价 — __asm("移动 rax, 0x10") == __asm("mov rax, 0x10") (用户可写中文汇编) */
    若 (!比较字符串(算子码, "停机")) 复制字符串(算子码, "hlt");
    否 若 (!比较字符串(算子码, "空操作")) 复制字符串(算子码, "nop");
    否 若 (!比较字符串(算子码, "返回")) 复制字符串(算子码, "ret");
    否 若 (!比较字符串(算子码, "开中断")) 复制字符串(算子码, "sti");
    否 若 (!比较字符串(算子码, "关中断")) 复制字符串(算子码, "cli");
    否 若 (!比较字符串(算子码, "断点")) 复制字符串(算子码, "int3");
    否 若 (!比较字符串(算子码, "中断返回")) 复制字符串(算子码, "iretq");
    否 若 (!比较字符串(算子码, "压栈")) 复制字符串(算子码, "push");
    否 若 (!比较字符串(算子码, "弹栈")) 复制字符串(算子码, "pop");
    否 若 (!比较字符串(算子码, "移动")) 复制字符串(算子码, "mov");
    否 若 (!比较字符串(算子码, "加法")) 复制字符串(算子码, "add");
    否 若 (!比较字符串(算子码, "减法")) 复制字符串(算子码, "sub");
    否 若 (!比较字符串(算子码, "比较")) 复制字符串(算子码, "cmp");
    循环 (*缺聚 == ' ' || *缺聚 == '\t' || *缺聚 == ',') 缺聚++;
    字 *整凶 = 缺聚; 循环 (*整凶 == ' ' || *整凶 == '\t') 整凶++;
    /* 单操作数或无操作数指令 */
    若 (!比较字符串(算子码, "hlt")) { 发字节(0xF4); 返; }
    若 (!比较字符串(算子码, "nop")) { 发字节(0x90); 返; }
    若 (!比较字符串(算子码, "ret") || !比较字符串(算子码, "retq")) { 发字节(0xC3); 返; }
    若 (!比较字符串(算子码, "sti")) { 发字节(0xFB); 返; }
    若 (!比较字符串(算子码, "cli")) { 发字节(0xFA); 返; }
    若 (!比较字符串(算子码, "int3")) { 发字节(0xCC); 返; }
    若 (!比较字符串(算子码, "iretq")) { 发字节(0x48); 发字节(0xCF); 返; }
    /* push/pop reg */
    若 (!比较字符串(算子码, "push") || !比较字符串(算子码, "pop")) {
        字 *前简 = 整凶; 循环 (*前简 == '%') 前简++;
        整 结 = 栈八(前简);
        若 (结 >= 0) {
            若 (结 < 8) {
                若 (!比较字符串(算子码, "push")) 发字节(0x50 + 结); 否 发字节(0x58 + 结);
            } 否 {
                整 链劣 = 结 - 8;
                若 (!比较字符串(算子码, "push")) { 发字节(0x41); 发字节(0x50 + 链劣); }
                否 { 发字节(0x41); 发字节(0x58 + 链劣); }
            }
            返;
        }
    }
    /* 双操作数: mov/add/sub/cmp dst, src */
    字 *前厚 = 整凶; 循环 (*前厚 && *前厚 != ',') 前厚++;
    若 (*前厚 == ',') {
        *前厚 = 0; 前厚++;
        循环 (*前厚 == ' ' || *前厚 == '\t') 前厚++;
        字 *目标 = 整凶; 循环 (*目标 == '%') 目标++;
        字 *源 = 前厚; 循环 (*源 == '%') 源++;
        整 左集 = 栈八(目标), 计一 = 栈八(源);
        /* 立即数: 0xNN 或 数字 */
        整 立即数 = 0; 整 域伴 = (源[0] == '$') || (源[0] >= '0' && 源[0] <= '9');
        若 (域伴) {
            若 (源[0] == '$') 源++;
            若 (源[0] == '0' && (源[1] == 'x' || 源[1] == 'X')) 立即数 = (整)字符串转长整(源, 0, 16);
            否 立即数 = 转整数(源);
            若 (左集 >= 0) {
                整 下利 = 目标[0] == 'r';
                若 (!比较字符串(算子码, "mov")) {
                    若 (左集 < 8) { 若 (下利) 发字节(0x48); 发字节(0xC7); 发字节(0xC0 + 左集); 发四(立即数); }
                    否 { 发字节(0x49); 发字节(0xC7); 发字节(0xC0 + 左集 - 8); 发四(立即数); }
                    返;
                }
                若 (!比较字符串(算子码, "add")) {
                    若 (左集 < 8) { 若 (下利) 发字节(0x48); 发字节(0x81); 发字节(0xC0 + 左集); 发四(立即数); }
                    否 { 发字节(0x49); 发字节(0x81); 发字节(0xC0 + 左集 - 8); 发四(立即数); }
                    返;
                }
                若 (!比较字符串(算子码, "sub")) {
                    若 (左集 < 8) { 若 (下利) 发字节(0x48); 发字节(0x81); 发字节(0xE8 + 左集); 发四(立即数); }
                    否 { 发字节(0x49); 发字节(0x81); 发字节(0xE8 + 左集 - 8); 发四(立即数); }
                    返;
                }
                若 (!比较字符串(算子码, "cmp")) {
                    若 (左集 < 8) { 若 (下利) 发字节(0x48); 发字节(0x81); 发字节(0xF8 + 左集); 发四(立即数); }
                    否 { 发字节(0x49); 发字节(0x81); 发字节(0xF8 + 左集 - 8); 发四(立即数); }
                    返;
                }
            }
        }
        /* reg, reg */
        若 (左集 >= 0 && 计一 >= 0) {
            整 隔庚 = 目标[0] == 'r';
            若 (!比较字符串(算子码, "mov")) {
                若 (左集 < 8 && 计一 < 8) {
                    若 (隔庚) 发字节(0x48);
                    发字节(0x89); 发字节(0xC0 + 计一 * 8 + 左集);
                } 否 若 (左集 >= 8 && 计一 < 8) { 发字节(0x4D); 发字节(0x89); 发字节(0xC0 + 计一 * 8 + (左集 - 8)); }
                否 若 (左集 < 8 && 计一 >= 8) { 发字节(0x4C); 发字节(0x89); 发字节(0xC0 + (计一 - 8) * 8 + 左集); }
                否 { 发字节(0x4D); 发字节(0x89); 发字节(0xC0 + (计一 - 8) * 8 + (左集 - 8)); }
                返;
            }
            若 (!比较字符串(算子码, "add") || !比较字符串(算子码, "sub") || !比较字符串(算子码, "cmp")) {
                整 基 = !比较字符串(算子码, "add") ? 0x01 : (!比较字符串(算子码, "sub") ? 0x29 : 0x39);
                若 (左集 < 8 && 计一 < 8) { 若 (隔庚) 发字节(0x48); 发字节(基); 发字节(0xC0 + 计一 * 8 + 左集); }
                否 若 (左集 >= 8 && 计一 < 8) { 发字节(0x4D); 发字节(基); 发字节(0xC0 + 计一 * 8 + (左集 - 8)); }
                否 若 (左集 < 8 && 计一 >= 8) { 发字节(0x4C); 发字节(基); 发字节(0xC0 + (计一 - 8) * 8 + 左集); }
                否 { 发字节(0x4D); 发字节(基); 发字节(0xC0 + (计一 - 8) * 8 + (左集 - 8)); }
                返;
            }
        }
    }
    输出到文件(错误流, "[ERR] __asm 未编码: %s\n", 计肆);
}

/* 指针表达式节点的元素大小 (T* → sizeof(T); 数组名 → 元素宽; 非指针 → 0)
   fix 2026-08-20: 成员访问 p->field 也是指针 — 原指针运算只识别 cast/纯变量名,
   `d.entries + 1` 不缩放 (步进 1 字节 → 全错位), `dst - d.entries` 不识别 →
   prune_directory `dir->nr = dst - dir->entries` 算错 → git add 丢全部文件. */
静 整 源辰一(整 数) { /* query member-chain field struct si (pure query, no codegen) - t49e fix */
    若 (数 < 0) 返 -1;
    整 暂 = 节型表[数];
    若 (暂 == 1) { 字 *变节 = (字*)(节名表 + 数); 返 变量型序(变节); }
    若 (暂 == 13 || 暂 == 15) {
        整 基 = 源辰一(子0[数]);
        若 (基 < 0) 返 -1;
        字 *函 = (字*)(节名表 + 数);
        返 字段类型序(类型表[基].名, 函);
    }
    若 (暂 == 11) 返 源辰一(子0[数]); /* &expr */
    若 (暂 == 12) 返 源辰一(子0[数]); /* *ptr */
    返 -1;
}
静 整 节点指元素(整 数) {
    若 (数 < 0) 返 0;
    若 (节型表[数] == 2) { /* binary op node: ptr +/- expr (t49c4 fix) */
        若 (节值表[数] == 5 || 节值表[数] == 6) {
            整 末 = 节点指元素(子0[数]);
            若 (末 > 0) 返 末;
            返 节点指元素(子1[数]);
        }
    }
    若 (指元素[数] < 0) 返 0; /* t35k 2026-08-23: 非指针整数 cast (uintptr_t/size_t) 哨兵 → 指针算术不缩放 (原 (uintptr_t)p-1 按 node_psz=4 缩放 → cb_node_of p-4 → cbtree 崩) */
    若 (指元素[数] > 0) 返 指元素[数]; /* (T*) cast 元素大小 (fix 2026-08-19) — 必须先于 nt==11 结构推断: (char*)&arr[i] 的 cast 在操作数上写 pesz=1, 取址推断不得覆盖 (fix 2026-08-25 step20 回归: regress_cmdlist/regress_struct_align) */
    若 (节型表[数] == 11) { /* &expr: 取址数组元素 → 指针元素大小 = 基数组元素大小 (fix 2026-08-25 step20: &arr[i]-&arr[j] 缩放; 变量指针差 p-q 已修, 取址下标差值是最后缺口; 只有下标操作数才缩放, 其他取址返回 0 保持原行为) */
        整 算子 = 子0[数];
        若 (算子 >= 0 && 节型表[算子] == 14) 返 节点指元素(子0[算子]); /* &arr[i] → 数组/指针基元素大小 (int arr→4, double da→8, struct pa→sizeof, char→1 无缩放) */
        返 0;
    }
    若 (节型表[数] == 10) 返 节点指元素(子0[数]); /* 复合赋值 (p += N): 返回左操作数元素大小 (fix 2026-08-25 step17: ((p+=8)-8) 减法 lpsz 原=0 无缩放 → int 指针/double 指针差错位; char 指针碰巧对) */
    若 (节型表[数] == 1) { /* 变量名: 数组名→元素宽, T** 指针→arr_esz(8), T*→p_esz */
        字 *变节 = (字*)(节名表 + 数);
        遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--)
            若 (!比较字符串(变量表[变序].名, 变节) && 变量码生成可见(变序)) {
                若 (取环境("QCC_DBG_NS")) 输出到文件(错误流, "[NPSZ] var '%s' arr_sz=%d arr_esz=%d p_esz=%d\n", 变节, 变量表[变序].数组尺寸, 变量表[变序].数组元素尺寸, 变量表[变序].指元素尺寸); /* tmp diag */
                若 (变量表[变序].数组元素尺寸 > 0) 返 变量表[变序].数组元素尺寸; /* 数组行/T** 元素 (T** 的 arr_esz=8, p_esz=4 — fix 2026-08-20: 原优先 p_esz → dst-entries 按 4 缩放错) */
                返 变量表[变序].指元素尺寸;
            }
        返 0;
    }
    若 (节型表[数] == 13 || 节型表[数] == 15) { /* s.field / p->field: 指针字段的元素大小 */
        整 微码 = 数;
        字 *函 = (字*)(节名表 + 微码);
        整 构序二 = 源辰一(子0[微码]); /* fix 2026-08-23 t49e: (&expr)->field base */
        若 (构序二 >= 0) {
            整 域序 = 字段序(构序二, 函);
            若 (域序 >= 0 && 类型表[构序二].原进[域序])
                返 类型表[构序二].符肆[域序] ? 类型表[构序二].符肆[域序] : 8;
            /* fix 2026-08-22 #42d: 数组字段的指针算术缩放 — int lens[320] + n 原返回 0
               → 不缩放 → st->lens+hlit 步进 1 字节 → inflate 动态表 dist 表指针错位
               → 垃圾 maxbits 崩. 数组字段 (fels!=fsizes 或 flex) 返回元素大小. */
            若 (域序 >= 0 && 末凶一(构序二, 函))
                返 构域元素(构序二, 函);
        }
        返 0;
    }
    返 0;
}

/* ==== Phase 3 IR 骨架 v3 (阶段B) ==== */
#define 高散 2000000
静 整 短次一[高散], 中参数a[高散], 中参数b[高散], 中参数c[高散];
静 整 空失;
静 空 原肆(常 字 *尾捌); /* -graph 旁路: 调用关系记录 (定义在 main 前, 前向声明供 case4 使用) */
静 空 中发(整 算子, 整 甲, 整 发字节, 整 字符) {
    若 (空失 >= 高散) { 输出到文件(错误流, "[IR-OVERFLOW] ir_n=%d\n", 空失); 退出(1); }
    短次一[空失] = 算子; 中参数a[空失] = 甲; 中参数b[空失] = 发字节; 中参数c[空失] = 字符; 空失++;
}
#define 序移立即数 1    /* a=reg, b=imm32 */
#define 当利一 2 /* a=reg, b=lo, c=hi */
#define 中跳标号 3    /* a=label */
#define 中标号 4      /* a=label */
#define 中测零跳 5    /* a=label: test eax,eax; jz label */
#define 虚丙 6   /* a=label: test eax,eax; jnz label */
#define 中压栈rax 7   /* push rax */
#define 值成 8    /* a=op: pop rbx; alu_rr(op, 3, 0); mov rax, rbx (32位) */
#define 中取帧 9   /* a=reg, b=disp, c=signext: mov reg, [rbp+disp] (32位) (+符号扩展) */
#define 中压栈64rax 10 /* push_r64(0): sub rsp,8; mov [rsp],rax */
#define 首分 11 /* mov rbx, rax */
#define 半属 12    /* a=op: pop_r64(0); add/sub/imul64 rax,rbx */
#define 堆庚 13  /* a=disp: mov [rbp+disp], eax (32位存储) */
#define 栈置 14 /* push_xmm0() */
#define 长转 15   /* a=op: movsd xmm1,xmm0; pop_xmm0; addsd/subsd/mulsd/divsd */
#define 标零 16 /* a=off, b=k, c=signext: mov eax,[rip+coff_static_disp(off,k)] */
#define 满丁 17 /* a=off, b=k: mov rax,[rip+coff_static_disp(off,k)-1] */
#define 缺捌 18    /* a=off, b=k: lea rax,[rip+coff_static_disp(off,k)-1] */
#define 中调用标号 19   /* a=label, b=add_rsp_imm: call_rel(0); patch_label; add_rsp_imm(b) */
#define 顺七 20 /* a=imm: sub_rsp_imm(imm) */
#define 中取栈寄存器 21 /* a=gpr, b=disp: mov_reg_mrsp64(0,disp); mov_rr64(gpr,0) */
#define 中巳 22 /* a=idx, b=disp: movsd_xmmreg_mrsp64(idx,disp) */
#define 副失 23 /* a=gpr, b=disp: lea_r_mbrp(gpr,disp) */
#define 序调用函数指 24 /* a=add_rsp_imm: mov r10,rax; call r10; add_rsp_imm(a) */
#define 段未二 25    /* a=op: alu_rr(op, 0, 1) — eax op ebx */
#define 宽二 26    /* cvttsd2si eax, xmm0: (int)double 截断 */
/* ==== Phase 3 case15 成员访问 IR 指令 (2026-08-25, 直译全等字节级一致) ==== */
#define 尾浅 27 /* a=v: add_rax_imm8(v) — 字段偏移 (imm8/imm32 自动) */
#define 缓劣 28      /* mov_reg_mreg64(0,0): mov rax, [rax] — 64 位指针/ll 字段解引用 */
#define 旧又 29      /* mov_reg_mreg(0,0): mov eax, [rax] — 32 位 int 字段解引用 */
#define 当排 30 /* movzx eax, byte [rax] — char 字段解引用 (零扩展) */
#define 原升一 31 /* movzx eax, word [rax] — short 字段解引用 (零扩展) */
#define 前降 34 /* movsx eax, word [rax] — signed short 字段解引用 (符号扩展, fix 2026-08-25 bug#33) */
#define 中取帧64 32    /* a=reg, b=disp: mov_reg_mbrp64(reg, disp) — 64 位局部读 (指针/ll 字段) */
#define 名进 33 /* a=disp: movsd_xmm0_mbrp(disp) — double 字段读 (movsd xmm0, [rbp+disp]) */
/* ==== Phase 3 case10 赋值存储 IR 指令 (2026-08-25, 直译全等字节级一致) ==== */
#define 整集 35 /* MOV [rax], bl — char 字段存储 (rex; b(0x88); modrm(0,3,0)) */
#define 旁辰 36 /* MOV [rax], bx — short 字段存储 (rex; b(0x66); b(0x89); modrm(0,3,0)) */
#define 前序 37    /* MOV [rax], ebx — int 字段存储 (rex; b(0x89); modrm(0,3,0)) */
#define 堆柒 38    /* MOV [rax], rbx — LL/指针字段存储 (rex(1); b(0x89); modrm(0,3,0)) */
#define 栈丁 39 /* movsd [rax], xmm0 — double 字段存储 (b(0xF2); b(0x0F); b(0x11); modrm(0,0,0)) */
#define 元又 40  /* alu_ri(T_PK,0,v): add eax, imm (32位, 无 REX.W) — 嵌套链赋值偏移 */
#define 容重 41   /* mov_mbrp_reg64(disp,0): mov [rbp+disp], rax (rex1; b(0x89); modrm(1/2,0,5)) */
#define 内酉 42 /* movsd_mbrp_xmm0(disp): movsd [rbp+disp], xmm0 (b(0xF2);b(0x0F);b(0x11); modrm(1/2,0,5)) */
#define 实七 43   /* lea_rax_rip(coff_static_disp(a,b)+c-1) — static 字段写地址含 foff */
#define 上柒 44  /* IMUL r11d, r9d (rex(0,1,0,1); 0F AF; modrm(3,3,1)) — arr[i]=expr 索引缩放 */
#define 正散 45  /* ADD rax, r11 (rex(1,1,0,0); 01; modrm(3,3,0)) — 地址+=索引 */
#define 串辛 46  /* SHL r11d, imm (rex(0,0,0,1); C1; modrm(3,4,3); imm) — 索引缩放 */
#define 主合 47   /* MOVSXD r11, r11d (4D 63 DB) — 32位索引符号扩展 */
#define 内壹一 48   /* MOV r9d, imm (41 B9 imm32) — 缩放因子加载 */
#define 素癸 49  /* MOV [rbx], al (rex; b(0x88); modrm(0,0,3)) — *ptr=expr char */
#define 计贰一 50  /* MOV word [rbx], ax (b(0x66); b(0x89); modrm(0,0,3)) */
#define 中存栈32 51     /* MOV [rbx], eax (rex; b(0x89); modrm(0,0,3)) */
#define 中存栈64 52     /* MOV [rbx], rax (rex1; b(0x89); modrm(0,0,3)) */
#define 前八一 53  /* MOVSD [rbx], xmm0 (b(0xF2);b(0x0F);b(0x11); modrm(0,0,3)) */
#define 终九 54  /* MOV byte [rbp+disp], al (b(0x88); modrm(1/2,0,5)) */
#define 外玖 55  /* MOV word [rbp+disp], ax (b(0x66);b(0x89); modrm(1/2,0,5)) */
#define 源伍 56  /* MOVSD [rip+disp], xmm0 (b(0xF2);b(0x0F);b(0x11);b(0x05);b4) — static double 写 */
#define 内丑 57 /* MOV [rip+disp], rax (rex1;b(0x89);b(0x05);b4) — static 64写 */
#define 列失 58 /* MOV [rip+disp], eax (b(0x89);b(0x05);b4) — static 32写 */
#define 深未 90  /* MOV byte [rip+disp], al (b(0x88);b(0x05);b4) — static 8写 (fix 2026-08-30 csmith t6) */
#define 终六 91  /* MOV word [rip+disp], ax (b(0x66);b(0x89);b(0x05);b4) — static 16写 (fix 2026-08-30 csmith t6) */
#define 栈复 92 /* movzx eax, byte [rip+disp] (0F B6 05 disp32, 7B) — static 8位零扩展读 (fix 2026-08-30 csmith t6) */
#define 间三 93 /* movsx eax, byte [rip+disp] (0F BE 05 disp32, 7B) — static 8位符号扩展读 */
#define 原双 94 /* movzx eax, word [rip+disp] (66 0F B7 05 disp32, 8B) — static 16位零扩展读 */
#define 当肆 95 /* movsx eax, word [rip+disp] (66 0F BF 05 disp32, 8B) — static 16位符号扩展读 */
#define 标繁一 59   /* movzx eax, byte [rbp+disp] (0F B6 85 disp32) — char 局部读 */
#define 宽布一 60 /* movzx eax, word [rbp+disp] (0F B7 85 disp32) — short 零扩展读 */
#define 值回一 61 /* movsx eax, word [rbp+disp] (0F BF 85 disp32) — short 符号扩展读 */
#define 深丁 78   /* movsx eax, byte [rbp+disp] (0F BE 85 disp32) — signed char 符号扩展读 (fix 2026-08-29 csmith) */
#define 首十 79  /* movsx eax, byte [rax] (0F BE 00) — signed char 字段符号扩展读 (fix 2026-08-29 csmith) */
#define 中戊 62       /* test eax,eax; sete al; movzx eax,al — !expr */
#define 元置 63         /* NOT eax (F7 D0) — ~expr */
#define 旁卯 64     /* alu_rr(op, 0, 1): eax op ebx (无 pop!) — ++/-- 用 */
#define 度细 65     /* pop rbx; cmp ebx,eax; setcc/setcc_u; movzx eax,al — 32位比较 */
#define 素九 66     /* pop r64; cmp rax,rbx; setcc/setcc_u; movzx eax,al — 64位比较 */
#define 总优一 67   /* movsd xmm1,xmm0; pop xmm0; comisd; setcc(浮点cc); movzx — double 比较 */
#define 容散 68     /* mov_rr(1, 0): ecx = eax — 移位计数 */
#define 中移64 69         /* a=kind(0=shl,1=sar,2=shr): pop r64; shl/sar/shr rax, cl */
#define 直布 70       /* a=op(25/46=and,47=or,48=xor): pop r64; and/or/xor rax, rbx */
#define 目拾 71  /* imul rbx, rcx (rex1;0F AF;modrm(3,3,1)) — LL 指针缩放 */
#define 剩分 72      /* a=op, b=uns: pop r64; add/sub/imul/div/mod rax, rbx (含除/取模) */
#define 标粗 73         /* pop_r(3): rbx = [rsp] — 32位指针缩放路径 */
#define 中卯 74    /* a=pscale: mov r10d,eax; mov eax,imm; imul eax,r10 — 32位指针缩放 */
#define 暂重 75     /* a=op, b=uns: g_uns设置; alu_rr(op,3,0); mov_rr(0,3) — 缩放/除/移位后 */
#define 隔得一 76        /* a=psub_div: mov ecx,imm; cdq; idiv ecx — 指针差除元素大小 */
#define 旧玖 77      /* a=psub64: mov rcx,imm; cqo; idiv rcx — 64位指针差除元素大小 */
/* ==== Phase 3 阶段C: pass 框架 + 定律接口位 ==== */
静 空 (*深双)(整 *算子, 整 *甲, 整 *发字节, 整 *字符) __attribute__((原粗)) = 0; /* pass 回调, 默认不激活 (0=直译全等) */
#define 单次 1  /* 定律接口位: 线性资源 (move/borrow/lifetime) — 不激活 */
#define 末伴一 2     /* 定律接口位: 和类型 (tagged union) — 不激活 */
#define 实序一 4 /* 定律接口位: 类型格 (上下界/约束) — 不激活 */
静 整 正己一[256] __attribute__((原粗)); /* 定律接口位 per-struct (bitmask, 全 0=不激活 → 编译产物不变) */
静 空 中刷(空) {
    若 (深双) { 遍 (整 计 = 0; 计 < 空失; 计++) 深双(&短次一[计], &中参数a[计], &中参数b[计], &中参数c[计]); } /* Phase3-C: pass 遍历 (默认空) */
    遍 (整 计 = 0; 计 < 空失; 计++) {
        择 (短次一[计]) {
            例 序移立即数: 移即(中参数a[计], 中参数b[计]); 断;
            例 当利一: 计升(((长 长)(无 整)中参数b[计]) | (((长 长)(无 整)中参数c[计]) << 32)); 断;
            例 中跳标号: 相对跳转(-1); 补标号(码位 - 4, 中参数a[计], 2); 断;
            例 中标号: 设标号(中参数a[计]); 断;
            例 中测零跳: 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 中参数a[计], 1); 断;
            例 虚丙: 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 中参数a[计], 3); 断;
            例 中压栈rax: 压栈寄存器(0); 断;
            例 中取帧: 移寄存器帧(中参数a[计], 中参数b[计]); 若 (中参数c[计]) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } 断;
            例 中压栈64rax: 压栈64(0); 断;
            例 首分: 移64(3, 0); 断;
            例 堆庚: 移帧寄存器(中参数a[计], 0); 断;
            例 栈置: 压浮0(); 断;
            例 标零: 移eax内存(静态位移(中参数a[计], 中参数b[计])); 若 (中参数c[计]) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } 断;
            例 满丁: 移rax内存64(静态位移(中参数a[计], 中参数b[计]) - 1); 断;
            例 缺捌: 度一(静态位移(中参数a[计], 中参数b[计]) - 1); 断;
            例 中调用标号: 相对调用(0); 补标号(码位 - 4, 中参数a[计], 0); 加栈即(中参数b[计]); 断;
            例 顺七: 减栈即(中参数a[计]); 断;
            例 中取栈寄存器: 移寄存器栈64(0, 中参数b[计]); 移64(中参数a[计], 0); 断;
            例 中巳: 主二(中参数a[计], 中参数b[计]); 断;
            例 副失: 取帧址(中参数a[计], 中参数b[计]); 断;
            例 序调用函数指: 移64(10, 0); 汇发("    调 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 1); 发字节(0xFF); 模字节(3, 2, 2); 加栈即(中参数a[计]); 断;
            例 段未二: 算寄存器(中参数a[计], 0, 1); 断;
            例 宽二: 现简(); 断;
            例 尾浅: 后弊一(中参数a[计]); 断;
            例 缓劣: 移寄存器内存64(0, 0); 断;
            例 旧又: 移寄存器内存(0, 0); 断;
            例 当排: 汇发("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 0); 断;
            例 首十: 汇发("    符号扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBE); 模字节(0, 0, 0); 断; /* signed char 字段符号扩展 (fix 2026-08-29 csmith) */
            例 原升一: 汇发("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB7); 模字节(0, 0, 0); 断;
            例 前降: 汇发("    符号扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBF); 模字节(0, 0, 0); 断;
            例 中取帧64: 移寄存器帧64(中参数a[计], 中参数b[计]); 断;
            例 名进: 逆厚(中参数a[计]); 断;
            例 整集: 前缀字节(0, 0, 0, 0); 发字节(0x88); 模字节(0, 3, 0); 断;
            例 旁辰: 前缀字节(0, 0, 0, 0); 发字节(0x66); 发字节(0x89); 模字节(0, 3, 0); 断;
            例 前序: 前缀字节(0, 0, 0, 0); 发字节(0x89); 模字节(0, 3, 0); 断;
            例 堆柒: 前缀字节(1, 0, 0, 0); 发字节(0x89); 模字节(0, 3, 0); 断;
            例 栈丁: 发字节(0xF2); 发字节(0x0F); 发字节(0x11); 模字节(0, 0, 0); 断;
            例 元又: 前缀字节(0, 0, 0, 0); 若 (中参数a[计] >= -128 && 中参数a[计] <= 127) { 发字节(0x83); 模字节(3, 0, 0); 发字节(中参数a[计]); } 否 { 发字节(0x81); 模字节(3, 0, 0); 发四(中参数a[计]); } 断;
            例 容重: 前缀字节(1, 0, 0, 0); 发字节(0x89); 若 (中参数a[计] < 128 && 中参数a[计] >= -128) { 模字节(1, 0, 5); 发字节(中参数a[计]); } 否 { 模字节(2, 0, 5); 发四(中参数a[计]); } 断;
            例 内酉: 发字节(0xF2); 发字节(0x0F); 发字节(0x11); 若 (中参数a[计] < 128 && 中参数a[计] >= -128) { 模字节(1, 0, 5); 发字节(中参数a[计]); } 否 { 模字节(2, 0, 5); 发四(中参数a[计]); } 断;
            例 实七: 度一(静态位移(中参数a[计], 中参数b[计]) + 中参数c[计] - 1); 断;
            例 上柒: 前缀字节(0, 1, 0, 1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 3, 1); 断;
            例 正散: 前缀字节(1, 1, 0, 0); 发字节(0x01); 模字节(3, 3, 0); 断;
            例 串辛: 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(中参数a[计]); 断;
            例 主合: 发字节(0x4D); 发字节(0x63); 发字节(0xDB); 断;
            例 内壹一: 发字节(0x41); 发字节(0xB9); 发四(中参数a[计]); 断;
            例 素癸: 前缀字节(0, 0, 0, 0); 发字节(0x88); 模字节(0, 0, 3); 断;
            例 计贰一: 发字节(0x66); 发字节(0x89); 模字节(0, 0, 3); 断;
            例 中存栈32: 前缀字节(0, 0, 0, 0); 发字节(0x89); 模字节(0, 0, 3); 断;
            例 中存栈64: 前缀字节(1, 0, 0, 0); 发字节(0x89); 模字节(0, 0, 3); 断;
            例 前八一: 发字节(0xF2); 发字节(0x0F); 发字节(0x11); 模字节(0, 0, 3); 断;
            例 终九: 发字节(0x88); 若 (中参数a[计] < 128 && 中参数a[计] >= -128) { 模字节(1, 0, 5); 发字节(中参数a[计]); } 否 { 模字节(2, 0, 5); 发四(中参数a[计]); } 断;
            例 外玖: 发字节(0x66); 发字节(0x89); 若 (中参数a[计] < 128 && 中参数a[计] >= -128) { 模字节(1, 0, 5); 发字节(中参数a[计]); } 否 { 模字节(2, 0, 5); 发四(中参数a[计]); } 断;
            例 源伍: 新十一(静态位移(中参数a[计], 中参数b[计]) - 2); 断;
            例 内丑: 行六(静态位移(中参数a[计], 中参数b[计]) - 1); 断;
            例 列失: 终拆(静态位移(中参数a[计], 中参数b[计])); 断;
            例 深未: { 整 容布 = 静态位移(中参数a[计], 中参数b[计]); 发字节(0x88); 发字节(0x05); 发四(容布); } 断; /* MOV byte [rip+disp], al — disp 须在发射前求值 (stc_disp 假设指令 6B, 求值时机错位会 -2, fix 2026-08-30 csmith t6) */
            例 终六: { 整 容布 = 静态位移(中参数a[计], 中参数b[计]) - 1; 发字节(0x66); 发字节(0x89); 发字节(0x05); 发四(容布); } 断; /* MOV word [rip+disp], ax — 7B 指令需 -1 (同 RAX64, fix 2026-08-30 csmith t6) */
            例 栈复: { 整 容布 = 静态位移(中参数a[计], 中参数b[计]) - 1; 发字节(0x0F); 发字节(0xB6); 发字节(0x05); 发四(容布); } 断; /* movzx eax, byte [rip+disp] (7B: disp-1, fix 2026-08-30 csmith t6) */
            例 间三: { 整 容布 = 静态位移(中参数a[计], 中参数b[计]) - 1; 发字节(0x0F); 发字节(0xBE); 发字节(0x05); 发四(容布); } 断; /* movsx eax, byte [rip+disp] (7B) */
            例 原双: { 整 容布 = 静态位移(中参数a[计], 中参数b[计]) - 2; 发字节(0x66); 发字节(0x0F); 发字节(0xB7); 发字节(0x05); 发四(容布); } 断; /* movzx eax, word [rip+disp] (8B: disp-2) */
            例 当肆: { 整 容布 = 静态位移(中参数a[计], 中参数b[计]) - 2; 发字节(0x66); 发字节(0x0F); 发字节(0xBF); 发字节(0x05); 发四(容布); } 断; /* movsx eax, word [rip+disp] (8B) */
            例 标繁一: 发字节(0x0F); 发字节(0xB6); 发字节(0x85); 发四(中参数a[计]); 断;
            例 宽布一: 发字节(0x0F); 发字节(0xB7); 发字节(0x85); 发四(中参数a[计]); 断;
            例 值回一: 发字节(0x0F); 发字节(0xBF); 发字节(0x85); 发四(中参数a[计]); 断;
            例 深丁: 发字节(0x0F); 发字节(0xBE); 发字节(0x85); 发四(中参数a[计]); 断; /* signed char 符号扩展读 (fix 2026-08-29 csmith) */
            例 中戊: 测寄存器(0, 0); 发字节(0x0F); 发字节(0x94); 模字节(3, 0, 0); 中失(); 断;
            例 元置: 发字节(0xF7); 发字节(0xD0); 断;
            例 旁卯: 算寄存器(中参数a[计], 0, 1); 断;
            例 度细: 弹栈寄存器(3); 算寄存器(比等, 3, 0); 若 (中参数b[计]) 顺深一(中参数a[计]); 否 高进(中参数a[计]); 中失(); 断;
            例 素九: 弹栈64(0); 汇发("    比较64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x39); 模字节(3, 3, 0); 若 (中参数b[计]) 顺深一(中参数a[计]); 否 高进(中参数a[计]); 中失(); 断;
            例 总优一: 短弊(); 弹浮0(); 值凶();
                若 (中参数a[计] == 比小) { 汇发("    置低 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0x92); 模字节(3, 0, 0); 中失(); }      /* setb: xmm0 < xmm1 */
                否 若 (中参数a[计] == 外三) { 汇发("    置高 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0x97); 模字节(3, 0, 0); 中失(); } /* seta */
                否 若 (中参数a[计] == 比等) { 汇发("    置等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0x94); 模字节(3, 0, 0); 中失(); } /* sete */
                否 若 (中参数a[计] == 名庚) { 汇发("    置不等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0x95); 模字节(3, 0, 0); 中失(); } /* setne */
                否 若 (中参数a[计] == 隔系) { 汇发("    置低等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0x96); 模字节(3, 0, 0); 中失(); } /* setbe */
                否 { 汇发("    置高等 al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0x93); 模字节(3, 0, 0); 中失(); }                /* setae: >= */
                断;
            例 容散: 移寄存器(1, 0); 断;
            例 中移64: 弹栈64(0);
                若 (中参数a[计] == 2) { 汇发("    逻辑右移64 r0, cl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xD3); 模字节(3, 5, 0); }
                否 若 (中参数a[计] == 1) { 汇发("    算术右移64 r0, cl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xD3); 模字节(3, 7, 0); }
                否 { 汇发("    左移64 r0, cl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xD3); 模字节(3, 4, 0); }
                断;
            例 直布: 弹栈64(0);
                若 (中参数a[计] == 25 || 中参数a[计] == 46) { 汇发("    与64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x21); 模字节(3, 3, 0); }
                否 若 (中参数a[计] == 47) { 汇发("    或64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x09); 模字节(3, 3, 0); }
                否 { 汇发("    异或64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x31); 模字节(3, 3, 0); }
                断;
            例 目拾: 前缀字节(1, 0, 0, 0); 发字节(0x0F); 发字节(0xAF); 模字节(3, 3, 1); 断;
            例 剩分: 弹栈64(0);
                若 (中参数a[计] == 加) { 汇发("    加64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x01); 模字节(3, 3, 0); }
                否 若 (中参数a[计] == 减) { 汇发("    减64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x29); 模字节(3, 3, 0); }
                否 若 (中参数a[计] == 乘) { 汇发("    乘64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x0F); 发字节(0xAF); 模字节(3, 0, 3); }
                否 若 (中参数a[计] == 除) {
                    若 (中参数b[计]) { 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); 汇发("    无符号除64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xF7); 模字节(3, 6, 3); }
                    否 { 汇发("    除64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x99); 发字节(0x48); 发字节(0xF7); 模字节(3, 7, 3); }
                }
                否 { /* MD */
                    若 (中参数b[计]) { 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); 汇发("    无符号除余64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xF7); 模字节(3, 6, 3); 移64(0, 2); }
                    否 { 汇发("    除余64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x99); 发字节(0x48); 发字节(0xF7); 模字节(3, 7, 3); 移64(0, 2); }
                }
                断;
            例 标粗: 弹栈寄存器(3); 断;
            例 中卯: 移寄存器(10, 0); 移即(0, 中参数a[计]); 汇发("    乘 r0, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 0, 2); 断;
            例 暂重:
                若 (中参数a[计] == 帧寅) 原七 = 中参数b[计];
                否 若 (中参数a[计] == 行降 || 中参数a[计] == 度未) 现拾 = 中参数b[计];
                算寄存器(中参数a[计], 3, 0); 移寄存器(0, 3);
                断;
            例 隔得一: 移即(1, 中参数a[计]); 汇发("    除 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x99); 发字节(0xF7); 模字节(3, 7, 1); 断;
            例 旧玖: 移即(1, 中参数a[计]); 汇发("    除64 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x99); 前缀字节(1, 0, 0, 0); 发字节(0xF7); 模字节(3, 7, 1); 断;
            例 长转: 短弊(); 弹浮0();
                若 (中参数a[计] == 加) 总辛一();
                否 若 (中参数a[计] == 减) 整进();
                否 若 (中参数a[计] == 乘) 容甲();
                否 末一一();
                断;
            例 半属: 弹栈64(0);
                若 (中参数a[计] == 加) { 汇发("    加64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x01); 模字节(3, 3, 0); }
                否 若 (中参数a[计] == 减) { 汇发("    减64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x29); 模字节(3, 3, 0); }
                否 { 汇发("    乘64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x0F); 发字节(0xAF); 模字节(3, 0, 3); }
                断;
            例 值成: 弹栈寄存器(3); 原七 = 0; 现拾 = 0; 算寄存器(中参数a[计], 3, 0); 移寄存器(0, 3); 断;
            缺: 输出到文件(错误流, "[IR-UNKNOWN] op=%d\n", 短次一[计]); 退出(1);
        }
    }
    空失 = 0;
}

静 空 码生成(整 数) {
    若 (数 < 0) 返;
    若 (数 >= 接子数) { 输出到文件(错误流, "[CG-BAD] n=%d nc=%d\n", 数, 接子数); 终止程序(); }
    整 暂 = 节型表[数];
    若 (暂 < 0 || 暂 > 65) { 输出到文件(错误流, "[CG-BADTYPE] n=%d nt=%d nc=%d\n", 数, 暂, 接子数); 终止程序(); }
    择 (节型表[数]) {
        例 0: 若 (节长标[数]) { 中发(当利一, 0, 节值表[数], 节长高[数]); 中刷(); } 否 { 中发(序移立即数, 0, 节值表[数], 0); 中刷(); } 断;
        例 19: 码生成浮(子0[数]); 若 (节长标[数]) 长对(); 否 { 中发(宽二, 0, 0, 0); 中刷(); } 断; /* fix 2026-08-25 bug#26: (long long)double 64位 */
        例 串词: { /* string literal ??placeholder, patched after codegen */
            整 构序 = 节值表[数];
            外陆一(构序); /* ensure string is in data buffer */
            若 (汇编输出 && 汇编遍 == 2 && 最终生成) {
                /* STR marker uses the COMPACT index (position among PLACED strings),
                   matching asm_zh's .字串 directive order. Some IDs are parsed but
                   never placed (str_offs=-1), so the raw ID misaligns str_offs2. */
                整 元失一 = 0;
                遍 (整 乙 = 0; 乙 < 构序; 乙++) 若 (邻拾[乙] >= 0) 元失一++;
                汇发("    移动 r0, STR%d\n", (字*)(长 长)(元失一), (字*)(长 长)0, (字*)(长 长)0);
                发字节(0xB8); 发四(0); /* mov eax, 0 (bare; mov_r_imm would double-emit ASM) */
            } 否 {
                移即(0, 0);
            }
            若 (段简 >= 32768) { 输出到文件(错误流, "[STRPATCH-OVERFLOW] strpn=%d\n", 段简); 终止程序(); }
            宽伍[段简].旁退 = 码位 - 4; /* position of imm32 */
            宽伍[段简].串序标 = 构序;
            段简++;
        } 断;
        例 终简: { /* double literal: movsd xmm0, [rip + dbl_const] (patched) */
            整 丁序 = 节值表[数];
            标劣(丁序);
            若 (汇编输出 && 汇编遍 == 2 && 最终生成) {
                汇发("    浮取静 xmm0, [rip+DBL%d]\n", (字*)(长 长)(丁序), (字*)(长 长)0, (字*)(长 长)0);
                发字节(0xF2); 发字节(0x0F); 发字节(0x10); 发字节(0x05); 发四(0); /* movsd xmm0,[rip+0] bare */
            } 否 {
                右再(0);
            }
            若 (暂拆 >= 2048) { 输出到文件(错误流, "[DBLPATCH-OVERFLOW] dbl_patch_n=%d\n", 暂拆); 终止程序(); }
            号集一[暂拆].旁退 = 码位 - 4;
            号集一[暂拆].浮序标 = 丁序;
            暂拆++;
        } 断;
        例 1: { /* variable ????????????? */
            整 偏移 = 查变量((字*)(节名表 + 数));
            若 (偏移 == -1) { /* fix 2026-08-06: off<-1 是 extern 负槽, 走 static 读生成外部符号; 只有 -1 (未定义) 才走函数/参数 */
                若 (!比较字符串((字*)(节名表 + 数), "stderr") || !比较字符串((字*)(节名表 + 数), "stdout") || !比较字符串((字*)(节名表 + 数), "stdin")) { 移即(0, 0); 断; } /* msvcrt FILE* globals are unavailable as imports; NULL lets fflush(NULL) flush all streams (fix 2026-08-15 vreportf fflush(stderr) garbage arg) */
                整 总辛 = 查函数((字*)(节名表 + 数));
                若 (总辛 >= 0 && 函数表[总辛].序布) {
                    /* function name as value �?absolute VA (patched in PE output) */
                    汇发("    移动 r0, FN:%s\n", (字*)(节名表 + 数), (字*)(长 长)0, (字*)(长 长)0); /* fn-address marker for the -S/asm_zh path (fix 2026-08-03: emit ONE text+bytes pair — mov_r_imm would add a second "移动 r0, 0" text) */
                    发字节(0xB8); 发四(0); /* mov eax, 0 (manual bytes, NOT mov_r_imm: it prints its own text) */
