        } 断;
        例 节点_二元: { /* 二进制 算子 */
            整 丙 = 节值表[数];
            整 本弃 = 码生成丢弃结果; 码生成丢弃结果 = 0; /* 阶段D DCE (2026-09-05 虾米): 默认子节点不丢弃; 比较/移位分支自行继承本弃 (纯比较/移位结果丢弃时子节点间接死) */
            若 (丙 == 逗号) { 若 (表达式是否纯(子0[数])) { /* 阶段D DCE (2026-09-04 虾米): 纯左操作数结果丢弃 → 完全跳过码生成 */ } 否 { 码生成丢弃结果 = 1; 码生成(子0[数]); 码生成丢弃结果 = 0; } 码生成丢弃结果 = 本弃; 码生成(子1[数]); 码生成丢弃结果 = 0; 若 (子1[数] >= 0 && 表达式是否浮(子1[数])) 节浮标[数] = 1; /* C126b: 逗号 的 浮性 传自 右操作数 (原 只传 节长标) */ 若 (子1[数] >= 0 && 节长标[子1[数]]) 节长标[数] = 1; 若 (节点长性(数, -1)) { 中刷(); 扩32(子1[数]); } 断; } /* 前厚: evaluate 左 (侧 effects), 结果 = 右; 节长标 时 32 位值 符号扩展64 (修复 2026-08-31 生成器 s62: (uint64_t)(a,b) 零扩展 → 全局变量 0x5569 应 0x5568) */
            若 (((子0[数] >= 0 && 表达式是否浮(子0[数])) && !指元指针(子0[数])) || ((子1[数] >= 0 && 表达式是否浮(子1[数])) && !指元指针(子1[数]))) { /* round 46: 指针数组元素 不入浮点通道 */ /* 修复 2026-08-25 缺陷#27: 用 表达式是否浮 (覆盖 双精度 变量) 替代裸 节浮标 */
                /* 浮点-点 算术 / comparison (结果 在 xmm0) */
                若 (丙 == 加 || 丙 == 减 || 丙 == 乘 || 丙 == 除) {
                    码生成浮(子0[数]); 中发(栈置, 0, 0, 0); 中刷();
                    码生成浮(子1[数]); 中发(长转, 丙, 0, 0); 中刷();
                    节浮标[数] = 1;
                    断;
                }
                若 (丙 == 比小 || 丙 == 外三 || 丙 == 比等 || 丙 == 名庚 || 丙 == 隔系 || 丙 == 宽排) {
                    码生成浮(子0[数]); 中发(栈置, 0, 0, 0); 中刷();
                    码生成浮(子1[数]); 中发(总优一, 丙, 0, 0); 中刷();
                    断;
                }
                /* 其他 ops 于 双精度: 回落 经 到 整数 (最佳-effort) */
            }
            若 (节长标[数] || (子0[数] >= 0 && 表达式是否长(子0[数])) || (子0[数] >= 0 && 节点指元素(子0[数]) > 0) || ((丙 != 号庚 && 丙 != 帧寅) && 子1[数] >= 0 && 表达式是否长(子1[数])) || (子0[数] >= 0 && 指元指针(子0[数])) || (子1[数] >= 0 && 指元指针(子1[数]))) { /* R290 (2026-09-26 启元 · 第 364 站 round 24): **补 64 位路径前提** —— R286 铁证: 下标形态 `节长标=0` 且 `节点指元素(子0)=0` ⟹ 原四前提全假 ⟹ **根本不进 64 位路径**. 本刀补 `指元指针` (L6278); 配套: L18179 给**全局**结构体指针数组补 `指深=1` (R289 确证 `点=18179 名=gsp`; [R290] 指深查=1 验证), L9867 给**局部**补 (R281 已提交). 两半齐备后 指元指针 返 1 ⟹ 本判据成立 ⟹ 走 64 位路径 ⟹ 其内已有归一逻辑 (`右卯`). */ /* 启元 Q7 修复 (2026-09-23): 补【左操作数 是 数组/指针】判据 —— 原三条件里 `表达式是否长(数组名)` 返 0 (L5042 变量分支要求 `数组尺寸 == 0`, 只认标量) ⟹ `static 字符 缓冲区[64] + 64` 落 32 位加法 (实测 add %eax,%ebx / mov %ebx,%eax) ⟹ 高 32 位清零 ⟹ 地址失真崩 0xC0000409. 指针参与加减 结果必为指针 (语义安全); 缩放 由 下方 旧乙 逻辑 在 64 位路径内部 处理. */
                /* 64-位 长整 长整 算术 / comparison (修复 2026-08-05); 修复 2026-08-25 缺陷#32: +节长标[n] — (长整 长整)转型 标记的节点本身也走 64 位 ((长整 长整)(-5) 一元负); 修复 2026-08-29 生成器: 移位 (号庚/帧寅) 排除右操作数 节长标 — 结果宽度=左操作数, `x << (int8_t)六十四位无符号` 原走 64 位 (mod64) → 0x381E<<102→<<38 而非 32 位 (mod32)→<<6 (s137 静默) */
