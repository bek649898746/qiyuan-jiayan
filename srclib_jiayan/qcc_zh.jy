静 整 现退[8192]; 静 整 逆组[8192]; 静 整 浮数;
静 整 原七; /* set by cg() before alu_rr: T_SR operand is unsigned → SHR (fix 2026-08-05) */
静 整 现拾;   /* set by cg() before alu_rr: T_DV/T_MD operand(s) unsigned → DIV (fix 2026-08-06 M1) */
/* parse a floating literal at s[*i] (digits [ . digits] [e[+-]digits]) into its
   IEEE-754 bit pattern; advances *i past the literal. Self-host has NO real
   long long (it's a 32-bit int), so the 8-byte pattern is returned as two
   ints (hi/lo) read out of the double's frame-slot bytes via a char*. */
静 空 行丁(常 字 *串值, 整 *圆周率, 整 *首回, 整 *号九) {
    双 值 = 0; 整 计 = *圆周率;
    循环 (串值[计] >= '0' && 串值[计] <= '9') { 值 = 值 * 10 + (串值[计] - '0'); 计++; }
    若 (串值[计] == '.') { 计++; 双 顺转 = 0, 域 = 1; 循环 (串值[计] >= '0' && 串值[计] <= '9') { 顺转 = 顺转 * 10 + (串值[计] - '0'); 域 *= 10; 计++; } 值 += 顺转 / 域; } /* fix 2026-08-06: 整数累加+单次除法，避免 fr*=0.1 累加误差（0.015625 等精确） */
    若 (串值[计] == 'e' || 串值[计] == 'E') {
        计++; 整 值吉 = 1;
        若 (串值[计] == '+' || 串值[计] == '-') { 若 (串值[计] == '-') 值吉 = -1; 计++; }
        整 终 = 0; 循环 (串值[计] >= '0' && 串值[计] <= '9') { 终 = 终 * 10 + (串值[计] - '0'); 计++; }
        双 尾低 = 1; 遍 (整 键 = 0; 键 < 终; 键++) 尾低 *= 10;
        若 (值吉 > 0) 值 *= 尾低; 否 值 /= 尾低;
    }
    *圆周率 = 计;
    字 *值子 = (字 *)&值;
    整 链劣 = (值子[0] & 0xff) | ((值子[1] & 0xff) << 8) | ((值子[2] & 0xff) << 16) | ((值子[3] & 0xff) << 24);
    整 度附 = (值子[4] & 0xff) | ((值子[5] & 0xff) << 8) | ((值子[6] & 0xff) << 16) | ((值子[7] & 0xff) << 24);
    *号九 = 链劣; *首回 = 度附;
}

/* hex float literal: 0x1.8p3 = 1.5*2^3 = 12.0 (C99; fix 2026-08-05: was parsed as hex int then junk) */
静 空 上复(常 字 *串值, 整 *圆周率, 整 *首回, 整 *号九) {
    双 值 = 0; 整 计 = *圆周率; /* s[i] = first hex digit (after 0x) */
    循环 (判十六进制((无 字)串值[计])) { 整 字符 = 串值[计] | 0x20; 值 = 值 * 16 + (字符 <= '9' ? 字符 - '0' : 字符 - 'a' + 10); 计++; }
    若 (串值[计] == '.') {
        计++;
        双 顺转 = 1.0 / 16;
        循环 (判十六进制((无 字)串值[计])) { 整 字符 = 串值[计] | 0x20; 双 元 = 字符 <= '9' ? 字符 - '0' : 字符 - 'a' + 10; 值 += 元 * 顺转; 顺转 /= 16; 计++; }
    }
    若 (串值[计] == 'p' || 串值[计] == 'P') {
        计++; 整 值吉 = 1;
        若 (串值[计] == '+' || 串值[计] == '-') { 若 (串值[计] == '-') 值吉 = -1; 计++; }
        整 终 = 0; 循环 (串值[计] >= '0' && 串值[计] <= '9') { 终 = 终 * 10 + (串值[计] - '0'); 计++; }
        双 满列 = 1; 遍 (整 键 = 0; 键 < 终; 键++) 满列 *= 2;
        若 (值吉 > 0) 值 *= 满列; 否 值 /= 满列;
    }
    *圆周率 = 计;
    字 *值子 = (字 *)&值;
    整 链劣 = (值子[0] & 0xff) | ((值子[1] & 0xff) << 8) | ((值子[2] & 0xff) << 16) | ((值子[3] & 0xff) << 24);
    整 度附 = (值子[4] & 0xff) | ((值子[5] & 0xff) << 8) | ((值子[6] & 0xff) << 16) | ((值子[7] & 0xff) << 24);
    *号九 = 链劣; *首回 = 度附;
}

/* ?????? token type constants (must precede codegen functions) ?????? */
#define 号汇 0
#define 邻一 1
#define 右得 2
#define 高拾 5   /* + */
#define 旧肆 6   /* - */
#define 下得 7   /* * */
#define 比等 8   /* == */
#define 比小 11  /* < */
#define 外三 21  /* > */
#define 名庚 10  /* != */
#define 隔系 22  /* <= */
#define 宽排 23  /* >= */
#define 行降 42  /* / */
#define 度未 43  /* % */
#define 号庚 44  /* << */
#define 帧寅 45  /* >> */
静 空 发字节(无 字 值) { 若 (码位 >= 码缓容量) { 输出到文件(错误流, "qcc_x86: code buffer overflow (fix 2026-08-09 审计)\n"); 退出(1); } 码[码位++] = 值; }
静 空 发四(整 值) { 发字节(值 & 0xff); 发字节((值 >> 8) & 0xff); 发字节((值 >> 16) & 0xff); 发字节((值 >> 24) & 0xff); }

/* ModR/M: mod=0(reg,[reg+disp])/1(reg,[reg+disp8])/2(reg,[reg+disp32])/3(reg,reg) */
静 空 模字节(整 余, 整 寄存器, 整 堆再) { 发字节((余 << 6) | ((寄存器 & 7) << 3) | (堆再 & 7)); }
/* REX prefix: W=64bit, R=reg ext, X=index ext, B=rm ext */
静 空 前缀字节(整 戌, 整 结, 整 亥, 整 旧合) { 发字节(0x40 | (戌 ? 8 : 0) | (结 ? 4 : 0) | (亥 ? 2 : 0) | (旧合 ? 1 : 0)); }

/* MOV reg32, imm32 (zero-extends to 64-bit in x86-64) */
静 空 移即(整 寄存器, 整 立即数) { 汇发("    移动 r%d, %d\n", (字*)(长 长)(寄存器), (字*)(长 长)(立即数), (字*)(长 长)0); 发字节(0xB8 | (寄存器 & 7)); 发四(立即数); }
/* MOV rax, imm64 (48 B8 imm64) — long long literals (fix 2026-08-05) */
静 空 计升(长 长 立即数) {
    汇发("    移动64 r0, %d, %d\n", (字*)(长 长)((整)(立即数 & 0xFFFFFFFF)), (字*)(长 长)((整)(((无 长 长)立即数) >> 32)), (字*)(长 长)0); /* text: lo, hi (asm_zh needs hi for H1==H2; fix 2026-08-05) */
    发字节(0x48); 发字节(0xB8); 发四((整)(立即数 & 0xFFFFFFFF)); 发四((整)(((无 长 长)立即数) >> 32));
}
/* push/pop r64 (sub rsp,8; mov [rsp],r64) — 64-bit temporaries, nesting-safe (fix 2026-08-05) */
/* NOTE: defined after sub_rsp_imm/add_rsp_imm (below 831) — sub_rsp_imm needs its forward decl first */
/* MOV [rsp+disp], reg32 */
__attribute__((原粗))
静 空 旁五(整 位移, 整 寄存器) {
    汇发("    存栈32 [rsp%+d], r%d\n", (字*)(长 长)(位移), (字*)(长 长)(寄存器), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 0); 发字节(0x89);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 4); 发字节(0x24); 发四(位移); }
}
/* MOV reg32, [rsp+disp] */
__attribute__((原粗))
静 空 双从一(整 寄存器, 整 位移) {
    汇发("    取栈32 r%d, [rsp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 0); 发字节(0x8B);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 4); 发字节(0x24); 发四(位移); }
}
/* MOV reg64, reg64 */
静 空 移64(整 目标, 整 源) { 汇发("    移64 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0); 前缀字节(1, 源 & 8, 0, 目标 & 8); 发字节(0x89); 模字节(3, 源 & 7, 目标 & 7); }
/* MOV reg32, reg32 */
静 空 移寄存器(整 目标, 整 源) { 汇发("    移32 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0); 前缀字节(0, 源 & 8, 0, 目标 & 8); 发字节(0x89); 模字节(3, 源 & 7, 目标 & 7); }

/* ADD/SUB/IMUL/CMP reg32, reg32 ??op is token type (PK/MK/DK/QK) */
静 空 算寄存器(整 算子, 整 目标, 整 源) {
    若 (算子 == 高拾) 汇发("    加 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 旧肆) 汇发("    减 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 下得) 汇发("    乘 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 比等) 汇发("    比较 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 25 || 算子 == 46) 汇发("    与 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0); /* & : PT(25) from a&b, AN(46) from a&=b — fix 2026-08-05 */
    否 若 (算子 == 47) 汇发("    或 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 48) 汇发("    异或 r%d, r%d\n", (字*)(长 长)(目标), (字*)(长 长)(源), (字*)(长 长)0);
    否 若 (算子 == 行降 || 算子 == 度未) { /* 除: expanded as 扩展符号 + 整除 r9 (explicit texts) */ }
    若 (算子 == 号庚 || 算子 == 帧寅) {
        /* fix: ASM text order must match byte order (mov ecx,eax emitted first).
           T_SR: emit ONE text+byte pair below (逻辑右移/SHR or 算术右移/SAR) — the
           generic `右移` line here would DOUBLE the text (H2 emitted 2× SAR → H1≠H2,
           fix 2026-08-06, matches grok-build's single emission). */
        移寄存器(1, 0); /* ecx = shift count */
        若 (算子 == 号庚) 汇发("    左移 r%d, cl\n", (字*)(长 长)(目标), (字*)(长 长)0, (字*)(长 长)0);
        否 若 (算子 == 帧寅) { /* fallthrough to the SHR/SAR line below */ }
        否 汇发("    右移 r%d, cl\n", (字*)(长 长)(目标), (字*)(长 长)0, (字*)(长 长)0);
        /* unsigned operand >> → SHR (logical); signed → SAR (fix 2026-08-05: always SAR) */
        若 (算子 == 帧寅) {
            整 栈集 = 原七;
            原七 = 0;
            若 (栈集) { 汇发("    逻辑右移 r%d, cl\n", (字*)(长 长)(目标), (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 目标 & 8); 发字节(0xD3); 模字节(3, 5, 目标 & 7); }
            否 { 汇发("    算术右移 r%d, cl\n", (字*)(长 长)(目标), (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 目标 & 8); 发字节(0xD3); 模字节(3, 7, 目标 & 7); }
            返;
        }
        前缀字节(0, 0, 0, 目标 & 8); 发字节(0xD3); 模字节(3, 4, 目标 & 7);
        返;
    }
    若 (算子 == 25 || 算子 == 46) { 前缀字节(0, 源 & 8, 0, 目标 & 8); 发字节(0x21); 模字节(3, 源 & 7, 目标 & 7); 返; } /* & (fix 2026-08-05: AN=46 from &=) */
    若 (算子 == 47) { 前缀字节(0, 源 & 8, 0, 目标 & 8); 发字节(0x09); 模字节(3, 源 & 7, 目标 & 7); 返; } /* | */
    若 (算子 == 48) { 前缀字节(0, 源 & 8, 0, 目标 & 8); 发字节(0x31); 模字节(3, 源 & 7, 目标 & 7); 返; } /* ^ */
    若 (算子 == 下得) {
        /* IMUL: reg=destination, rm=source */
        前缀字节(0, 目标 & 8 ? 1 : 0, 0, 源 & 8 ? 1 : 0);
        发字节(0x0F); 发字节(0xAF); 模字节(3, 目标 & 7, 源 & 7);
        返;
    }
    若 (算子 == 行降 || 算子 == 度未) {
        整 邻亥 = 现拾; 现拾 = 0; /* fix 2026-08-06 M1: unsigned 除法 */
        移寄存器(9, 0); /* r9d = divisor */
        移寄存器(0, 目标); /* eax = dividend */
        若 (邻亥) {
            汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* xor edx, edx */
            汇发("    无符号除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xF7); 模字节(3, 6, 1); /* DIV r9d */
        } 否 {
            汇发("    扩展符号\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x99); /* CDQ (fix 2026-08-06 M1: 原 48 99=CQO 检查 RAX 位63，32位负值高32位为0 → RDX=0 → 变无符号除法! -7/2 误算 2147483644) */
            汇发("    整除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xF7); 模字节(3, 7, 1); /* IDIV r9d (REX.B=1 for rm=r9) */
        }
        若 (算子 == 度未) 移寄存器(0, 2); /* remainder �?eax */
        移寄存器(目标, 0); /* result �?dst for mov_rr(0,dst) in caller */
        返;
    }
    前缀字节(0, 源 & 8, 0, 目标 & 8);
    若 (算子 == 高拾) { 发字节(0x01); 模字节(3, 源 & 7, 目标 & 7); }
    否 若 (算子 == 旧肆) { 发字节(0x29); 模字节(3, 源 & 7, 目标 & 7); }
    否 若 (算子 == 比等) { 发字节(0x39); 模字节(3, 源 & 7, 目标 & 7); }
}
/* ADD/SUB reg32, imm8/imm32 (fix 2026-08-03: imm8-only sign-extended offsets
   >127 to NEGATIVE (128 → 0x80 → -128) → e->field stores at offset≥128 wrote
   BEHIND the struct. imm32 form (81 /0 id) when the value doesn't fit imm8.) */
静 空 __attribute__((原粗)) 隔利二(整 算子, 整 寄存器, 整 立即数) {
    汇发("    运即 r%d, %d\n", (字*)(长 长)(寄存器), (字*)(长 长)(立即数), (字*)(长 长)0);
    前缀字节(0, 0, 0, 寄存器 & 8);
    若 (算子 == 高拾) {
        若 (立即数 >= -128 && 立即数 <= 127) { 发字节(0x83); 模字节(3, 0, 寄存器 & 7); 发字节(立即数); }
        否 { 发字节(0x81); 模字节(3, 0, 寄存器 & 7); 发四(立即数); }
    }
    否 若 (算子 == 旧肆) {
        若 (立即数 >= -128 && 立即数 <= 127) { 发字节(0x83); 模字节(3, 5, 寄存器 & 7); 发字节(立即数); }
        否 { 发字节(0x81); 模字节(3, 5, 寄存器 & 7); 发四(立即数); }
    }
}
/* TEST reg32, reg32 ??set ZF */
静 空 测寄存器(整 暂利, 整 符拾) { 汇发("    测试 r%d, r%d\n", (字*)(长 长)(暂利), (字*)(长 长)(符拾), (字*)(长 长)0); 前缀字节(0, 符拾 & 8, 0, 暂利 & 8); 发字节(0x85); 模字节(3, 符拾 & 7, 暂利 & 7); }
/* PUSH/POP reg64 ??always 64-bit in long mode, REX only needed for R8-R15 */
静 空 压栈寄存器(整 结) { 汇发("    压栈 r%d\n", (字*)(长 长)(结), (字*)(长 长)0, (字*)(长 长)0); 若 (结 & 8) 发字节(0x41); 发字节(0x50 | (结 & 7)); }
静 空 弹栈寄存器(整 结) { 汇发("    弹栈 r%d\n", (字*)(长 长)(结), (字*)(长 长)0, (字*)(长 长)0); 若 (结 & 8) 发字节(0x41); 发字节(0x58 | (结 & 7)); }
/* CALL rel32 */
静 空 相对调用(整 尾午) { 发字节(0xE8); 发四(尾午); }
/* movsxd r11, r11d — 32 位索引符号扩展到 64 位再作指针偏移 (fix 2026-08-19:
   原 mov_rr(11,0) 零扩展 → 负索引 (-1) 变 0xFFFFFFFF → ptr + 4GB → SEGV
   (packed-backend find_start/find_end_of_record 的 p[-1] 扫描崩) */
静 空 符号扩展r11(空) {
    汇发("    符号扩展 r11, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x4D); 发字节(0x63); 发字节(0xDB); /* movsxd r11, r11d (REX.W+R+B, 63, modrm 11 011 011) */
}
/* RET */
静 空 返一(空) { 汇发("    返回\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xC3); }
/* LEA reg64, [rsp+disp] */
__attribute__((原粗))
静 空 左壬一(整 寄存器, 整 位移) {
    汇发("    取址 r%d, [rsp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x8D);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 4); 发字节(0x24); 发四(位移); }
}
/* RBP-relative variants: [rbp+disp] �?stable during nested calls / temporary sub rsp.
   Frame slot at [rsp+off] == [rbp + off - cur_frame_sz] (rbp = rsp + frame at entry). */
静 空 移帧寄存器(整 位移, 整 寄存器) {
    汇发("    存帧32 [rbp%+d], r%d\n", (字*)(长 长)(位移), (字*)(长 长)(寄存器), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 0); 发字节(0x89);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
静 空 移寄存器帧(整 寄存器, 整 位移) {
    汇发("    取帧32 r%d, [rbp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 0); 发字节(0x8B);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
静 空 取帧址(整 寄存器, 整 位移) {
    汇发("    取帧址 r%d, [rbp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x8D);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
/* char arr[N] = "lit": store one string byte into [rbp+disp] (C6 /0 = MOV r/m8, imm8) */
静 空 终巳(整 位移, 整 立即数) {
    汇发("    存字节 [rbp%+d], %d\n", (字*)(长 长)(位移), (字*)(长 长)(立即数), (字*)(长 长)0);
    发字节(0xC6);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 5); 发字节(位移); }
    否 { 模字节(2, 0, 5); 发四(位移); }
    发字节(立即数 & 0xFF);
}
/* 局部 char 变量存储: mov byte [rbp+disp], al (1 字节截断, fix 2026-08-25 bug#28b) */
静 空 容回(整 位移) {
    汇发("    存字节 [rbp%+d], al\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x88);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 5); 发字节(位移); }
    否 { 模字节(2, 0, 5); 发四(位移); }
}
/* 局部 char 变量读取: movzx eax, byte [rbp+disp] (零扩展, qcc char=unsigned 约定, fix 2026-08-25 bug#28b) */
静 空 零扩展字节(整 位移) {
    汇发("    零扩展字节 r0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x0F); 发字节(0xB6); 发字节(0x85); 发四(位移); /* movzx eax, byte [rbp+disp] */
}
/* 局部 signed char 变量读取: movsx eax, byte [rbp+disp] (符号扩展, fix 2026-08-29 csmith) */
静 空 符号扩展字节(整 位移) {
    汇发("    符号扩展字节 r0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x0F); 发字节(0xBE); 发字节(0x85); 发四(位移); /* movsx eax, byte [rbp+disp] */
}
/* 局部 short 变量读取: movzx eax, word [rbp+disp] (零扩展, uint16_t/unsigned short, fix 2026-08-25 bug#31b) */
静 空 零扩展字(整 位移) {
    汇发("    零扩展字 r0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x0F); 发字节(0xB7); 发字节(0x85); 发四(位移); /* movzx eax, word [rbp+disp] */
}
/* 局部 signed short 变量读取: movsx eax, word [rbp+disp] (符号扩展, fix 2026-08-25 bug#31b) */
静 空 符号扩展字(整 位移) {
    汇发("    符号扩展字 r0, [rbp%+d]\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x0F); 发字节(0xBF); 发字节(0x85); 发四(位移); /* movsx eax, word [rbp+disp] */
}
/* 局部 short 变量存储: mov word [rbp+disp], ax (2 字节截断, fix 2026-08-25 bug#31b) */
静 空 串戊(整 位移) {
    汇发("    存字 [rbp%+d], ax\n", (字*)(长 长)(位移), (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x66); 发字节(0x89);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 5); 发字节(位移); }
    否 { 模字节(2, 0, 5); 发四(位移); }
}
/* char arr[N] = "lit" (static, coff): store one string byte into [rax+disp]
   (C6 /0 MOV r/m8, imm8 — no relocation needed; rax 已由 lea_rax_rip 指向 .data 槽,
   fix 2026-08-20: mov_byte_rip_imm 的 C6 05 disp32 imm8 在 coff 模式无法生成 REL32
   修复 (imm8 在 disp32 后, jyld 按 P+4 修正会偏 1) → static char x[]="lit" 在 git
   对象里存成字符串地址 → mkstemps 的 x_pattern 内容垃圾 → git init EINVAL) */
静 空 缺从(整 位移, 整 立即数) {
    汇发("    存字节 [rax%+d], %d\n", (字*)(长 长)(位移), (字*)(长 长)(立即数), (字*)(长 长)0);
    发字节(0xC6);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 0, 0); 发字节(位移); }
    否 { 模字节(2, 0, 0); 发四(位移); }
    发字节(立即数 & 0xFF);
}
/* 64-bit variants: preserve full pointer values in registers/slots */
静 空 反附(整 位移, 整 寄存器) {
    汇发("    存帧64 [rbp%+d], r%d\n", (字*)(长 长)(位移), (字*)(长 长)(寄存器), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x89);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
静 空 移寄存器帧64(整 寄存器, 整 位移) {
    汇发("    取帧64 r%d, [rbp%+d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(位移), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 0); 发字节(0x8B);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 5); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 5); 发四(位移); }
}
