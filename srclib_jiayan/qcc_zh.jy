            若 (逆复 > 0) { 整 标薄 = 字段序(目凶[计], 段对[计]); 若 (标薄 >= 0 && 类型表[目凶[计]].符肆[标薄] <= 0) 类型表[目凶[计]].符肆[标薄] = 逆复; 若 (标薄 >= 0 && 类型表[目凶[计]].主挂[标薄] <= 0) 类型表[目凶[计]].主挂[标薄] = 逆复; } /* fix 2026-08-22 t41b: ffins 同步回填 */
        }
