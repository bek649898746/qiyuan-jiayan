            若 (!字值) 断;
            若 (++全陆一 > 1000000) { 后戊 = 1; 返 0; } /* 防死循环 */
            词位 = 单厚;
            若 (词型表[词位] == 左花) { 词位++; 循环 (词位 < 词容量 && 词型表[词位] != 右花) { 若 (!池分(返一)) { 若 (词型表[词位] == 右花) 词位++; 返 0; } } 若 (词型表[词位] == 右花) 词位++; }
            否 { 若 (!池分(返一)) 返 0; }
        }
        词位 = 单厚;
        若 (词型表[词位] == 左花) 现利(); 否 当丙一();
        返 1;
    }
    若 (词型表[词位] == 净吉) { /* 遍 (初始化; 条件; 步) 语句 — 编译期求值: 初始化 为 整数 声明/赋值 (池分 消费 ;), 条件/步 常量表达式 */
        词位++; 若 (词型表[词位] == 左括) 词位++;
        若 (!池分(NULL)) 返 0; /* 初始化 (声明/赋值, 消费 ;) — 失败已由 后戊 标记 */
        整 条件位 = 词位; 整 单厚 = 0; 整 后拆 = 0; 整 旁进 = 0; 整 全陆一 = 0;
        遍 (;;) {
            词位 = 条件位; 整 字值 = 0;
            若 (词型表[词位] == 分号) 字值 = 1; /* 遍(;;) 无条件 */
            否 若 (!常量表达式求值(&字值)) { 后戊 = 1; 返 0; }
            若 (词型表[词位] == 分号) 词位++;
            后拆 = 词位; 旁进 = 词位;
            若 (词型表[词位] == 右括) { 词位++; 单厚 = 词位; } /* 无 步: 遍(;;条件;) — 直接到 ) */
            否 { 旁进 = 内申(); 词位 = 旁进; 若 (词型表[词位] == 右括) 词位++; 单厚 = 词位; } /* 只定位 步 结束, 不执行 (循环尾才执行) */
            若 (!字值) { 若 (词型表[词位] == 左花) 现利(); 否 当丙一(); 断; } /* 条件 假: 跳过 函数体 到 遍 结束 (词位 停在 函数体 开始, 不跳则外层误解释 函数体) */
            若 (++全陆一 > 1000000) { 后戊 = 1; 返 0; } /* 防死循环 */
            词位 = 单厚;
            若 (词型表[词位] == 左花) { 词位++; 循环 (词位 < 词容量 && 词型表[词位] != 右花) { 若 (!池分(返一)) { 若 (词型表[词位] == 右花) 词位++; 返 0; } } 若 (词型表[词位] == 右花) 词位++; }
            否 { 若 (!池分(返一)) 返 0; }
            词位 = 后拆; /* 循环尾执行 步 (重新解释到 旁进) */
            若 (词位 < 旁进) { 整 帧属 = 0; 若 (!链聚(&帧属)) { 后戊 = 1; 返 0; } }
        }
        返 1;
    }
    若 (词型表[词位] == 词变量) { /* x = 表达式; 或 x++; x--; x += n; — 赋值支持字符串 (过程宏 #172) */
        字 变节[64]; 复制字符串(变节, 词名表[词位]); 词位++;
        若 (词型表[词位] == 赋号) { 词位++; 字 帧属[8192]; 若 (序置(帧属, 大小(帧属))) { 栈吉一(变节, 帧属); 若 (词型表[词位] == 分号) 词位++; 返 1; } 整 值 = 0; 若 (!常量表达式求值(&值)) { 后戊 = 1; 返 0; } 若 (中劣(变节) == 0x80000000) { 后戊 = 1; 返 0; } 外七(变节, 值); 若 (词型表[词位] == 分号) 词位++; 返 1; }
        若 (词型表[词位] == 增增) { 词位++; 整 当 = 中劣(变节); 若 (当 == 0x80000000) { 后戊 = 1; 返 0; } 外七(变节, 当 + 1); 若 (词型表[词位] == 分号) 词位++; 返 1; }
        若 (词型表[词位] == 减减) { 词位++; 整 当 = 中劣(变节); 若 (当 == 0x80000000) { 后戊 = 1; 返 0; } 外七(变节, 当 - 1); 若 (词型表[词位] == 分号) 词位++; 返 1; }
        若 (词型表[词位] == 加等 || 词型表[词位] == 减等 || 词型表[词位] == 乘等 || 词型表[词位] == 除等 || 词型表[词位] == 或等) { 整 算子 = 词型表[词位]; 词位++; 整 结 = 0; 若 (!常量表达式求值(&结)) { 后戊 = 1; 返 0; } 整 当 = 中劣(变节); 若 (当 == 0x80000000) { 后戊 = 1; 返 0; } 若 (算子 == 加等) 当 += 结; 否 若 (算子 == 减等) 当 -= 结; 否 若 (算子 == 乘等) 当 *= 结; 否 若 (算子 == 除等) { 若 (!结) { 后戊 = 1; 返 0; } 当 /= 结; } 否 { 若 (!结) { 后戊 = 1; 返 0; } 当 %= 结; } 外七(变节, 当); 若 (词型表[词位] == 分号) 词位++; 返 1; }
        后戊 = 1; 返 0; /* 函数调用等其他语句 → 无法解释 */
    }
    后戊 = 1; 返 0;
}
静 整 链聚(整 *值) { /* 遍-步: i++ / i-- / i+=n / i-=n / i*=n / i=n (无分号) */
    若 (词型表[词位] == 词变量) {
        字 变节[64]; 复制字符串(变节, 词名表[词位]); 词位++;
        若 (词型表[词位] == 增增) { 词位++; 整 当 = 中劣(变节); 若 (当 == 0x80000000) 返 0; 外七(变节, 当 + 1); 返 1; }
        若 (词型表[词位] == 减减) { 词位++; 整 当 = 中劣(变节); 若 (当 == 0x80000000) 返 0; 外七(变节, 当 - 1); 返 1; }
        若 (词型表[词位] == 赋号) { 词位++; 整 结 = 0; 若 (!常量表达式求值(&结)) 返 0; 外七(变节, 结); 返 1; }
        若 (词型表[词位] == 加等 || 词型表[词位] == 减等 || 词型表[词位] == 乘等 || 词型表[词位] == 除等 || 词型表[词位] == 或等) { 整 算子 = 词型表[词位]; 词位++; 整 结 = 0; 若 (!常量表达式求值(&结)) 返 0; 整 当 = 中劣(变节); 若 (当 == 0x80000000) 返 0; 若 (算子 == 加等) 当 += 结; 否 若 (算子 == 减等) 当 -= 结; 否 若 (算子 == 乘等) 当 *= 结; 否 若 (算子 == 除等) { 若 (!结) 返 0; 当 /= 结; } 否 { 若 (!结) 返 0; 当 %= 结; } 外七(变节, 当); 返 1; }
    }
    返 0;
}
静 整 中属(常 字 *串升, 整 *出) { /* 编译期 f(常量...): 解析实参 (全常量) → 绑定参数帧 → 解释函数体 → *出=结果; 返回 1 成功 0 无法 */
    整 己序 = 宽庚(串升);
    若 (己序 < 0) 返 0;
    整 满癸 = 存陆(串升);
    若 (满癸 < 0) 返 0;
    整 基 = 宽劣;
    后戊 = 0;
    /* 解析实参 (词位 已在 '(' 后): 常量表达式, 逗号分隔, 到 ) */
    整 首合 = 0; 整 段吉[32];
    若 (词型表[词位] != 右括) {
        遍 (;;) {
            若 (首合 >= 32) { 宽劣 = 基; 返 0; }
            整 参值 = 0;
            若 (!常量表达式求值(&参值)) { 宽劣 = 基; 返 0; } /* 实参非常量 → 无法 */
            段吉[首合++] = 参值;
            若 (词型表[词位] == 逗号) { 词位++; 续; }
            断;
        }
    }
    若 (词型表[词位] != 右括) { 宽劣 = 基; 返 0; }
    词位++; /* ) */
    宽劣 = 基; /* #68: 推新帧 — 隐藏外层同名, 递归/嵌套调用 帧隔离 */
    遍 (整 计 = 0; 计 < 首合; 计++) 压帧(度伍[满癸].左组[计], 段吉[计]);
    /* 解释函数体 */
    整 存词位 = 词位;
    词位 = 计序[己序].短亥; /* 指向 { */
    整 返回值 = 0; 整 后置一 = 0;
    若 (词型表[词位] == 左花) 词位++; /* 跳过 { */
    循环 (词位 < 词容量 && 词型表[词位] != 右花 && 词位 < 计序[己序].隔子 && !后戊) {
        若 (!池分(&返回值)) { 后置一 = 1; 断; } /* 返回 或失败 */
    }
    整 成功 = !后戊;
    若 (成功 && !后置一) 返回值 = 0; /* 函数体自然结束 (无 返回 → 隐式 0) — 返回 后 返回值 有效, 不覆盖 */
    宽劣 = 基;
    词位 = 存词位;
    若 (!成功) 返 0;
    *出 = 返回值;
    返 1;
}

静 整 毛重(常 字 *串升, 字 *出, 整 剩繁) { /* 过程宏 #172: 同 中属 但期望字符串返回 → 出; 返回 1 成功 */
    整 己序 = 宽庚(串升);
    若 (己序 < 0) 返 0;
    整 满癸 = 存陆(串升);
    若 (满癸 < 0) 返 0;
    整 基 = 宽劣;
    后戊 = 0;
    净十 = 0; 外退[0] = 0;
    整 首合 = 0; 整 段吉[32];
    若 (词型表[词位] != 右括) {
        遍 (;;) {
            若 (首合 >= 32) { 宽劣 = 基; 返 0; }
            整 参值 = 0;
            若 (!常量表达式求值(&参值)) { 宽劣 = 基; 返 0; }
            段吉[首合++] = 参值;
            若 (词型表[词位] == 逗号) { 词位++; 续; }
            断;
        }
    }
    若 (词型表[词位] != 右括) { 宽劣 = 基; 返 0; }
    词位++; /* ) */
    /* 第 440 站 F8#172 (2026-10-02): **过程宏 实参个数 校验** —— 原实现 只解析实参、**从不比对函数形参表**
       ⟹ 实测 `甲宏()` / `甲宏(3)` / `甲宏(3,4,5)` 对 2 参宏函数 **全部编译成功**（多给 静默忽略，
       少给且 宏体未引用该参 时 也 静默通过）⟹ R1 结果不确定 / R2 诊断缺失。
       注: 少给且宏体引用 → 原本也走调用方 A9101（响亮）；多给 → 原本**全静默**。
       本判据 走 发错误（而非 返 0），因为「实参个数 ≠ 形参个数」是**确定性用户错误**，
       不该落回 毛重 的「无法求值」兜底（那会把错调用 静默降级为 A9101 之外的 常量 0）。 */
    若 (首合 != 度伍[满癸].参数数) { 宽劣 = 基; 格式化到串(错缓冲, "过程宏: %s 实参个数 %d ≠ 形参个数 %d (号合.0 #172)", 串升, 首合, 度伍[满癸].参数数); 发错误("A9103", 错缓冲); }
    宽劣 = 基; /* #68: 推新帧 — 隐藏外层同名, 递归/嵌套调用 帧隔离 */
    遍 (整 计 = 0; 计 < 首合; 计++) 压帧(度伍[满癸].左组[计], 段吉[计]);
    整 存词位 = 词位;
    词位 = 计序[己序].短亥; /* 指向 { */
    整 返回值 = 0;
    若 (词型表[词位] == 左花) 词位++;
    循环 (词位 < 词容量 && 词型表[词位] != 右花 && 词位 < 计序[己序].隔子 && !后戊) {
        若 (!池分(&返回值)) 断; /* 返回 (整数 或字符串) 或解释失败 */
    }
    整 成功 = !后戊;
    宽劣 = 基;
    词位 = 存词位;
    若 (!成功) 返 0;
    若 (!净十) 返 0; /* 未返回字符串 → 非代码生成宏 */
    拷贝前n(出, 外退, 剩繁 - 1); 出[剩繁 - 1] = 0;
    返 1;
}

静 整 标降(整 词位) {
    /* 跳过全局/文件级声明中的初始化器: = 表达式 / = { ... } / = ( ... )
       到顶层逗号或分号停止 (不消费逗号/分号)。 (修复 2026-08-15: *local_packs = 空, *altodb_packs = 空) */
    若 (词型表[词位] != 赋号) 返 词位;
    词位++;
    整 元 = 0;
    循环 (词位 < 词容量 && 词型表[词位] != 词终) {
        若 (词型表[词位] == 左花 || 词型表[词位] == 左括 || 词型表[词位] == 左方) 元++;
        否 若 (词型表[词位] == 右花 || 词型表[词位] == 右括 || 词型表[词位] == 右方) { 元--; 若 (元 < 0) 元 = 0; }
        否 若 (元 == 0 && (词型表[词位] == 逗号 || 词型表[词位] == 分号)) 断;
        词位++;
    }
    返 词位;
}

/* ========== 宏系统 (2026-08-28 类型-根-12 #167: 抽象语法树 级安全宏 — 词法 后 解析 前 词元 级展开) ========== */
静 构 { 字 名[64]; 整 参位[16]; 整 参数数; 整 短亥; 整 隔子; 整 变参位; } 隔升[512]; /* #168 2026-09-01: 参数存词元流坐标 (qcc char 数组乘式索引缺陷: 容败[16][64] 拷贝读空) */ /* 第 451 站 #282: 变参位 = `...` 在形参表中的槽 (>=0 即变参宏, -1 = 非变参) */
静 整 首布 = 0;
静 整 尾叁[512]; 静 整 首降一[512]; /* 宏声明 词元 区间 (展开时跳过) */
静 整 短丁一(常 字 *数) { 遍 (整 计 = 0; 计 < 首布; 计++) 若 (!比较字符串(隔升[计].名, 数)) 返 计; 返 -1; }

静 整 *段粗; 静 整 *段汇; 静 整 *正低; 静 整 *源厚一; 静 整 *前乙; 静 整 *栈挂;
静 字 (*余集)[64];
静 整 空八; 静 整 半吉;
/* 嵌套宏展开帧栈: 每帧记录 宏索引 + 原始实参 词元 切片 (调用者上下文惰性展开, 替换时括号包裹) */
静 整 净列[24]; 静 整 短捌[24]; 静 整 旁六[24][16][2];

/* 接入 2026-09-01 #168 卫生宏: 函数宏体内局部变量声明在每次展开时 gensym 改名 (_hyg<序>_<原名>),
   与调用点同名变量隔离 (无变量捕获). 卫栈按展开深度嵌套; 实参展开在调用者上下文, 屏蔽卫栈. */
静 字 卫栈原[32][32][64]; 静 字 卫栈新[32][32][80]; 静 整 卫栈数[32]; 静 整 卫深 = 0; 静 整 卫序 = 0;
静 字 卫原暂存[32][64];
/* #173 注解/属性 (2026-09-01): 注解 名 = 值; 顶层元数据标注 — 注解表 (名→值), 编译期可查 */
静 构 { 字 名[64]; 字 值[256]; } 注解表[256];
静 整 注解数 = 0;
/* #231 repr 控制 (2026-09-01): 打包 构 名 { } — 结构体紧凑布局 (字段无对齐填充, 尺寸不轮 up) */
静 整 打包标[4096]; /* 结构体打包标志 (0/1) */
静 整 查注解(常 字 *名, 字 *值) { 遍 (整 计 = 0; 计 < 注解数; 计++) 若 (!比较字符串(注解表[计].名, 名)) { 复制字符串(值, 注解表[计].值); 返 1; } 返 0; } /* 编译期注解查询 */

静 整 查卫生(常 字 *名, 字 *新名) {
    遍 (整 层 = 卫深 - 1; 层 >= 0; 层--) {
        遍 (整 键 = 0; 键 < 卫栈数[层]; 键++)
            若 (!比较字符串(卫栈原[层][键], 名)) { 复制字符串(新名, 卫栈新[层][键]); 返 1; }
    }
    返 0;
}

静 整 卫生识别(整 甲, 整 乙, 整 宏序) {
    /* 扫描宏体词元 [甲,乙) 识别局部变量声明: <类型词|typedef名> <变量名> 且 后跟 =/;/,[ 且 非宏参数 */
    整 数 = 0; 整 计 = 甲;
    循环 (计 < 乙) {
        整 是类型 = (词型表[计] == 型词) || (词型表[计] == 词变量 && (查类型(词名表[计]) >= 0 || !比较字符串(词名表[计], "typedef")));
        若 (是类型) {
            整 扫 = 计 + 1;
            循环 (扫 < 乙 && (词型表[扫] == 型词 || (词型表[扫] == 词变量 && 查类型(词名表[扫]) >= 0))) 扫++;
            整 名位 = -1;
            若 (扫 < 乙 && 词型表[扫] == 词变量) {
                名位 = 扫;
                若 (查类型(词名表[扫]) >= 0 && 扫 + 1 < 乙 && 词型表[扫 + 1] == 词变量) 名位 = 扫 + 1; /* typedef 类型名后才是变量 */
            }
            若 (名位 >= 0) {
                整 后 = 名位 + 1;
                若 (后 < 乙 && (词型表[后] == 赋号 || 词型表[后] == 分号 || 词型表[后] == 逗号 || 词型表[后] == 左方)) {
                    整 是参 = 0;
                    遍 (整 键 = 0; 键 < 隔升[宏序].参数数 && 键 < 16; 键++) 若 (!比较字符串(词名表[隔升[宏序].参位[键]], 词名表[名位])) { 是参 = 1; 断; }
                    若 (!是参 && 数 >= 32) { /* 第 440 站 F8#168 (2026-10-02): 原为 `数 < 32` 的静默丢弃 —— 宏体局部标识符 >32 时 **卫生隔离静默失效** (gensym 不再施加 ⟹ 撞名), 属 R1 结果不确定。改响亮拒绝。 */
                        格式化到串(错缓冲, "卫生宏: 宏体内的局部标识符 超过 卫生 处理上限 32 个 (原实现 静默截断 ⟹ 隔离 静默失效); 请拆分宏体, 或改用 函数 (号合.0 #168)"); 发错误("A9009", 错缓冲); }
                    若 (!是参 && 数 < 32) { 复制字符串(卫原暂存[数], 词名表[名位]); 数++; }
                }
            }
            计 = (名位 >= 0) ? (名位 + 1) : (扫 > 计 ? 扫 : 计 + 1);
            续;
        }
        计++;
    }
    返 数;
}

静 空 序申卫生(整 计) { /* #168: 输出词元, 命中卫栈则输出 gensym 新名 */
    字 替名[80]; 字 *写名 = 词名表[计];
    若 (词型表[计] == 词变量 && 卫深 > 0 && 查卫生(词名表[计], 替名)) 写名 = 替名;
    若 (空八 >= 词容量) 计排二();
    段粗[空八] = 词型表[计]; 段汇[空八] = 词值表[计]; 复制字符串(余集[空八], 写名);
    正低[空八] = 词行表[计]; 源厚一[空八] = 词无符号表[计]; 前乙[空八] = 词长表[计]; 栈挂[空八] = 段属[计];
    空八++;
}

静 空 计排二(空) { 输出到文件(错误流, "[ERR] A9008 宏展开超限: 词元 数超上限\n"); 退出(1); }

静 空 序申(整 计) {
    若 (空八 >= 词容量) 计排二();
    段粗[空八] = 词型表[计]; 段汇[空八] = 词值表[计]; 复制字符串(余集[空八], 词名表[计]);
    正低[空八] = 词行表[计]; 源厚一[空八] = 词无符号表[计]; 前乙[空八] = 词长表[计]; 栈挂[空八] = 段属[计];
    空八++;
}

静 空 源肆(整 型) { /* 合成 ( ) 词元 用于实参括号包裹 */
    若 (空八 >= 词容量) 计排二();
    段粗[空八] = 型; 段汇[空八] = 0; 复制字符串(余集[空八], 型 == 左括 ? "(" : ")");
    正低[空八] = 0; 源厚一[空八] = 0; 前乙[空八] = 0; 栈挂[空八] = 0;
    空八++;
}

静 整 直陆(整 计, 整 *高四, 整 *参出) { /* 最内层活动帧的参数匹配 (词法遮蔽): 参位 = 词元流坐标, 词名表[坐标] 直接比较 */
    遍 (整 文件 = 半吉 - 1; 文件 >= 0; 文件--) {
        整 宏序 = 净列[文件];
        遍 (整 寻 = 0; 寻 < 隔升[宏序].参数数; 寻++)
            若 (!比较字符串(词名表[隔升[宏序].参位[寻]], 词名表[计])) { *高四 = 文件; *参出 = 寻; 返 1; }
    }
    返 0;
}

/* 展开原 词元 区间 [a,b) 到输出: 嵌套宏调用展开 + 活动帧参数替换 (实参在调用者上下文惰性展开+括号包裹) */
静 空 首布一(整 甲, 整 发字节);

静 空 深薄一(整 顺转, 整 寻) { /* 帧 顺转 的第 q 个实参, 在调用者上下文 (帧 0..顺转-1) 展开 — 保存/恢复被隐藏帧槽位 (嵌套调用会复用槽位) */
    整 存 = 半吉;
    整 存卫深 = 卫深; 卫深 = 顺转; /* #168 卫生宏: 实参在调用者上下文展开, 用调用者帧 (0..顺转-1) 的卫栈, 屏蔽本宏帧 */
    整 末分 = 净列[顺转]; 整 旁伴一 = 短捌[顺转]; 整 旧拾[16][2];
    遍 (整 键 = 0; 键 < 16; 键++) { 旧拾[键][0] = 旁六[顺转][键][0]; 旧拾[键][1] = 旁六[顺转][键][1]; }
    半吉 = 顺转;
    源肆(左括);
    若 (隔升[末分].变参位 == 寻 && 旁伴一 > 寻) 首布一(旁六[顺转][寻][0], 旁六[顺转][旁伴一 - 1][1]); /* 第 451 站 #282: 变参槽 ⟹ 展开 **余参合并切片** (第 寻 个 起点 → 最后一个 终点, 实参切片连续) */
    否 首布一(旁六[顺转][寻][0], 旁六[顺转][寻][1]);
    源肆(右括);
    卫深 = 存卫深;
    半吉 = 存;
    净列[顺转] = 末分; 短捌[顺转] = 旁伴一;
    遍 (整 键 = 0; 键 < 16; 键++) { 旁六[顺转][键][0] = 旧拾[键][0]; 旁六[顺转][键][1] = 旧拾[键][1]; }
}

静 空 首布一(整 甲, 整 发字节) {
    整 计 = 甲;
    循环 (计 < 发字节) {
        若 (词型表[计] == 词变量 && !比较字符串(词名表[计], "宏")) {
            整 段合 = -1; 遍 (整 键 = 0; 键 < 首布; 键++) 若 (尾叁[键] == 计) { 段合 = 键; 断; }
            若 (段合 >= 0) { 计 = 首降一[段合]; 续; }
        }
        若 (词型表[计] == 词变量) {
            整 末深, 右集;
            若 (直陆(计, &末深, &右集)) { 深薄一(末深, 右集); 计++; 续; }
        }
        整 宏序 = (词型表[计] == 词变量) ? 短丁一(词名表[计]) : -1;
        若 (词型表[计] == 词变量 && 计 + 1 < 词序 && 词型表[计 + 1] == 左括 && 宏序 >= 0 && 半吉 >= 24) { /* 第 440 站 F8#167 (2026-10-02): 原 `半吉 < 24` 门槛 之外 **静默不展开** ⟹ 宏名 被当 函数名/标识符 继续解析 (同名函数存在时 **静默改调函数**, 语义无声改变) —— 属 R1 结果不确定。改响亮拒绝。 */
            格式化到串(错缓冲, "宏展开: 嵌套层数 超过上限 24 (原实现 静默停止展开 ⟹ 宏名 被当 函数名/标识符 继续解析, 静默改变语义); 请减少宏嵌套 (号合.0 #167)"); 发错误("A9010", 错缓冲); }
        若 (词型表[计] == 词变量 && 计 + 1 < 词序 && 词型表[计 + 1] == 左括 && 宏序 >= 0 && 半吉 < 24) {
            整 常式 = 计 + 2; 整 元 = 1;
            循环 (常式 < 词序 && 元 > 0) { 若 (词型表[常式] == 左括) 元++; 否 若 (词型表[常式] == 右括) { 元--; 若 (元 == 0) 断; } 常式++; }
            整 度肆[16][2]; 整 匿数 = 0; 整 行己 = 计 + 2; 整 指深度 = 0;
            遍 (整 指 = 计 + 2; 指 < 常式; 指++) {
                若 (词型表[指] == 左括) 指深度++;
                否 若 (词型表[指] == 右括) { 若 (指深度 > 0) 指深度--; }
                否 若 (词型表[指] == 逗号 && 指深度 == 0) { 若 (匿数 < 16) { 度肆[匿数][0] = 行己; 度肆[匿数][1] = 指; } 匿数++; 行己 = 指 + 1; }
            }
            若 (行己 < 常式 && 匿数 < 16) { 度肆[匿数][0] = 行己; 度肆[匿数][1] = 常式; 匿数++; } /* 空括号 一=0 */
            若 ((隔升[宏序].变参位 < 0 && 匿数 != 隔升[宏序].参数数) || (隔升[宏序].变参位 >= 0 && 匿数 < 隔升[宏序].参数数 - 1)) { 词位 = 计; 发错误("A9007", "宏参数个数不匹配: 调用与声明参数数不一致"); } /* 第 451 站 #282: 变参宏 (_) 只要求 固定参数个数 齐全, 余参 归 __VA_ARGS__ */
            整 顺转 = 半吉;
            净列[顺转] = 宏序; 短捌[顺转] = 匿数;
            遍 (整 键 = 0; 键 < 匿数; 键++) { 旁六[顺转][键][0] = 度肆[键][0]; 旁六[顺转][键][1] = 度肆[键][1]; }
            半吉++;
            { 整 卫基 = 卫深;
              若 (卫深 < 32) {
                  整 卫数 = 卫生识别(隔升[宏序].短亥, 隔升[宏序].隔子, 宏序);
                  若 (卫数 > 0) {
                      遍 (整 键 = 0; 键 < 卫数; 键++) {
                          复制字符串(卫栈原[卫深][键], 卫原暂存[键]);
                          格式化到串(卫栈新[卫深][键], "_hyg%d_%s", 卫序++, 卫原暂存[键]);
                      }
                  }
                  卫栈数[卫深] = 卫数; 卫深++; /* 每帧压一层 (无局部变量也压空层), 保证 卫深==帧号 对应 */
              }
              首布一(隔升[宏序].短亥, 隔升[宏序].隔子); /* 整个体连续展开 — 内部游标自动越过嵌套调用 (逐 词元 调用会把嵌套调用内部 词元 重复处理) */
              卫深 = 卫基;
            }
            半吉--;
            计 = 常式 + 1;
        } 否 {
            序申卫生(计); 计++;
        }
    }
}

静 空 删词元区(整 位置) { /* #279: 删除一个词元, 后续前移; 末尾清 EK 防残留 */
    整 计 = 位置;
    循环 (计 < 词序 - 1) {
        词型表[计] = 词型表[计 + 1]; 词值表[计] = 词值表[计 + 1];
        移动内存(词名表[计], 词名表[计 + 1], 64);
        词行表[计] = 词行表[计 + 1]; 词无符号表[计] = 词无符号表[计 + 1]; 词长表[计] = 词长表[计 + 1]; 段属[计] = 段属[计 + 1];
        计++;
    }
    若 (词序 - 1 >= 0) { 词型表[词序 - 1] = 词终; 词名表[词序 - 1][0] = 0; }
    词序--;
}

静 空 名称空间展开(空) { /* #279 名称空间/模块完整 (2026-09-01): 名称空间 名 { ... } 词元级展开
    — 块内顶层符号加前缀 名_, 名::符号 合并为 名_符号, 名称空间 名 { 和 } 删除 */
    整 计 = 0;
    循环 (计 < 词序) {
        若 (词型表[计] == 词变量 && !比较字符串(词名表[计], "名称空间")) {
            若 (计 + 2 < 词序 && 词型表[计 + 1] == 词变量 && 词型表[计 + 2] == 左花) {
                字 前缀[80]; 格式化到串(前缀, "%s_", 词名表[计 + 1]);
                整 起 = 计 + 2; 整 终 = 起; 整 深 = 0;
                循环 (终 < 词序) { 若 (词型表[终] == 左花) 深++; 否 若 (词型表[终] == 右花) { 深--; 若 (深 == 0) { 终++; 断; } } 终++; }
                若 (终 > 起 + 1 && 终 <= 词序) {
                    整 扫 = 起 + 1;
                    循环 (扫 < 终 - 1) {
                        /* 名::符号 合并 */
                        若 (词型表[扫] == 词变量 && 扫 + 3 < 终 - 1 && 词型表[扫 + 1] == 冒号 && 词型表[扫 + 2] == 冒号 && 词型表[扫 + 3] == 词变量) {
                            字 名一[64], 名二[64]; 复制字符串(名一, 词名表[扫]); 复制字符串(名二, 词名表[扫 + 3]);
                            格式化到串(词名表[扫], "%s_%s", 名一, 名二);
                            删词元区(扫 + 1); 删词元区(扫 + 1); 删词元区(扫 + 1); /* 删 : : 符号 */
                            终 -= 3;
                            扫 += 1; 续;
                        }
                        /* 声明: 型词 [型词]* 名字 */
                        若 (词型表[扫] == 型词) {
                            整 名扫 = 扫 + 1;
                            循环 (名扫 < 终 - 1 && 词型表[名扫] == 型词) 名扫++;
                            若 (名扫 < 终 - 1 && 词型表[名扫] == 词变量) {
                                整 后 = 名扫 + 1;
                                若 (后 < 终 - 1 && (词型表[后] == 左括 || 词型表[后] == 赋号 || 词型表[后] == 分号 || 词型表[后] == 逗号 || 词型表[后] == 左方 || 词型表[后] == 左花)) {
                                    { 字 旧名[64]; 复制字符串(旧名, 词名表[名扫]); 若 (比前n(旧名, 前缀, 取字长(前缀)) != 0) 格式化到串(词名表[名扫], "%s%s", 前缀, 旧名); }
                                    若 (词型表[后] == 左括) { /* 函数定义: 参数内结构体/枚举标签加前缀, 跳参数列表+函数体 (局部变量不改名) */
                                        整 参扫 = 后; 整 参深 = 0;
                                        循环 (参扫 < 终 - 1) {
                                            若 (词型表[参扫] == 左括) 参深++;
                                            否 若 (词型表[参扫] == 右括) { 参深--; 若 (参深 == 0) { 参扫++; 断; } }
                                            否 若 (参深 == 1 && (词型表[参扫] == 结构词 || 词型表[参扫] == 枚词) && 参扫 + 1 < 终 - 1 && 词型表[参扫 + 1] == 词变量) {
                                                { 字 旧名[64]; 复制字符串(旧名, 词名表[参扫 + 1]); 若 (比前n(旧名, 前缀, 取字长(前缀)) != 0) 格式化到串(词名表[参扫 + 1], "%s%s", 前缀, 旧名); }
                                                参扫++; /* 跳过标签 */
                                            }
                                            参扫++;
                                        }
                                        若 (参扫 < 终 - 1 && 词型表[参扫] == 左花) {
                                            整 体深 = 0; 整 体扫 = 参扫;
                                            循环 (体扫 < 终 - 1) { 若 (词型表[体扫] == 左花) 体深++; 否 若 (词型表[体扫] == 右花) { 体深--; 若 (体深 == 0) { 体扫++; 断; } } 体扫++; }
                                            扫 = 体扫; 续;
                                        }
                                    }
                                }
                            }
                            扫 = 名扫; 续;
                        }
                        /* 结构/联合/枚举 标签 */
                        若 (词型表[扫] == 结构词 || 词型表[扫] == 枚词) {
                            整 名扫 = 扫 + 1;
                            若 (名扫 < 终 - 1 && 词型表[名扫] == 词变量) {
                                整 后 = 名扫 + 1;
                                若 (后 < 终 - 1 && (词型表[后] == 左花 || 词型表[后] == 分号 || 词型表[后] == 逗号 || 词型表[后] == 词变量)) {
                                    { 字 旧名[64]; 复制字符串(旧名, 词名表[名扫]); 若 (比前n(旧名, 前缀, 取字长(前缀)) != 0) 格式化到串(词名表[名扫], "%s%s", 前缀, 旧名); }
                                    若 (词型表[后] == 左花 && 词型表[扫] == 结构词) { /* 结构体定义体: 字段不改, 跳过 */
                                        整 体深 = 0; 整 体扫 = 后;
                                        循环 (体扫 < 终 - 1) { 若 (词型表[体扫] == 左花) 体深++; 否 若 (词型表[体扫] == 右花) { 体深--; 若 (体深 == 0) { 体扫++; 断; } } 体扫++; }
                                        扫 = 体扫; 续;
                                    }
                                }
                            }
                            扫 = 名扫 + 1; 续;
                        }
                        /* typedef 类型名 */
                        若 (词型表[扫] == 词变量 && !比较字符串(词名表[扫], "typedef")) {
                            整 扫2 = 扫 + 1;
                            循环 (扫2 < 终 - 1 && (词型表[扫2] == 型词 || (词型表[扫2] == 词变量 && 查类型(词名表[扫2]) >= 0))) 扫2++;
                            若 (扫2 < 终 - 1 && 词型表[扫2] == 词变量) {
                                { 字 旧名[64]; 复制字符串(旧名, 词名表[扫2]); 若 (比前n(旧名, 前缀, 取字长(前缀)) != 0) 格式化到串(词名表[扫2], "%s%s", 前缀, 旧名); }
                            }
                            扫 = 扫2; 续;
                        }
                        扫++;
                    }
                }
                /* 删除 名称空间 名 { 三个词元 */
                删词元区(计); 删词元区(计); 删词元区(计);
                /* 删除 } (原 终-1, 删 3 后 = 终-4) */
                若 (终 - 4 >= 0 && 终 - 4 < 词序 && 词型表[终 - 4] == 右花) 删词元区(终 - 4);
                计 = 终 - 4; /* 块后位置 (删 4 词元后前移) */
                续;
            }
        }
        /* 全局 名::符号 合并 (块外引用) */
        若 (词型表[计] == 词变量 && 计 + 3 < 词序 && 词型表[计 + 1] == 冒号 && 词型表[计 + 2] == 冒号 && 词型表[计 + 3] == 词变量) {
            字 名一[64], 名二[64]; 复制字符串(名一, 词名表[计]); 复制字符串(名二, 词名表[计 + 3]);
            格式化到串(词名表[计], "%s_%s", 名一, 名二);
            删词元区(计 + 1); 删词元区(计 + 1); 删词元区(计 + 1);
            续;
        }
        计++;
    }
}

静 空 容癸一(空) {
    整 计 = 0;
    首布 = 0;
    循环 (计 < 词序) {
        若 (词型表[计] == 词变量 && !比较字符串(词名表[计], "宏") && 计 + 2 < 词序 && 词型表[计 + 1] == 词变量 && 词型表[计 + 2] == 左括) {
            整 池凶 = 计 + 2; 整 指深度 = 0; 整 全丁 = -1;
            循环 (池凶 < 词序) { 若 (词型表[池凶] == 左括) 指深度++; 否 若 (词型表[池凶] == 右括) { 指深度--; 若 (指深度 == 0) { 全丁 = 池凶; 断; } } 池凶++; }
            若 (全丁 > 0 && 首布 < 512) {
                整 邻壬 = 首布;
                复制字符串(隔升[邻壬].名, 词名表[计 + 1]);
                隔升[邻壬].参数数 = 0;
                隔升[邻壬].变参位 = -1; /* 第 451 站 #282: 默认非变参 (静数组初值 0, 必须显式置 -1) */
                { 整 栈劣 = 0; 遍 (整 寻 = 计 + 2; 寻 < 全丁; 寻++) { 若 (词型表[寻] == 左括) 栈劣++; 否 若 (词型表[寻] == 右括) 栈劣--; 否 若 (词型表[寻] == 句点 && 栈劣 == 1 && 寻 + 2 < 全丁 && 词型表[寻 + 1] == 句点 && 词型表[寻 + 2] == 句点) { /* 第 451 站 #282: 变参 `...` ⟹ 占一个形参槽 (参位 暂 -1, 待 体范围 确定后 扫 __VA_ARGS__ 回填) */ 若 (隔升[邻壬].参数数 < 16) { 隔升[邻壬].变参位 = 隔升[邻壬].参数数; 隔升[邻壬].参位[隔升[邻壬].参数数] = -1; 隔升[邻壬].参数数 = 隔升[邻壬].参数数 + 1; } 寻 += 2; } 否 若 (词型表[寻] == 词变量 && 栈劣 == 1 && 隔升[邻壬].参数数 < 16) { 隔升[邻壬].参位[隔升[邻壬].参数数] = 寻; 隔升[邻壬].参数数 = 隔升[邻壬].参数数 + 1; } } }
                整 域升 = -1; 整 计从 = -1; 整 声明终 = 全丁 + 1;
                若 (全丁 + 1 < 词序 && 词型表[全丁 + 1] == 赋号) { /* = 表达式 ; */
                    域升 = 全丁 + 2; 整 元 = 0; 整 乙 = 全丁 + 2;
                    循环 (乙 < 词序) { 若 (词型表[乙] == 左括 || 词型表[乙] == 左花 || 词型表[乙] == 左方) 元++; 否 若 (词型表[乙] == 右括 || 词型表[乙] == 右花 || 词型表[乙] == 右方) { 若 (元 > 0) 元--; } 否 若 (词型表[乙] == 分号 && 元 == 0) { 计从 = 乙; 声明终 = 乙 + 1; 断; } 乙++; }
                } 否 若 (全丁 + 1 < 词序 && 词型表[全丁 + 1] == 左花) { /* { ... } */
                    域升 = 全丁 + 1; 整 元 = 0; 整 乙 = 全丁 + 1;
                    循环 (乙 < 词序) { 若 (词型表[乙] == 左花) 元++; 否 若 (词型表[乙] == 右花) { 元--; 若 (元 == 0) { 计从 = 乙 + 1; 声明终 = 乙 + 1; 断; } } 乙++; }
                }
                若 (域升 >= 0 && 计从 >= 域升) {
                    隔升[邻壬].短亥 = 域升; 隔升[邻壬].隔子 = 计从;
                    若 (隔升[邻壬].变参位 >= 0) { 遍 (整 觅 = 域升; 觅 < 计从; 觅++) 若 (隔升[邻壬].参位[隔升[邻壬].变参位] < 0 && 词型表[觅] == 词变量 && !比较字符串(词名表[觅], "__VA_ARGS__")) { 隔升[邻壬].参位[隔升[邻壬].变参位] = 觅; } } /* 第 451 站 #282: 体范围已知 ⟹ 扫宏体 回填 __VA_ARGS__ 的词元坐标 (形参匹配靠 参位 坐标直接比较) */
                    尾叁[邻壬] = 计; 首降一[邻壬] = 声明终;
                    首布++;
                    计 = 声明终; 续;
                }
            }
        }
        计++;
    }
    若 (首布 == 0) 返;
    段粗 = 清零分配(词容量, 4); 段汇 = 清零分配(词容量, 4); 正低 = 清零分配(词容量, 4);
    源厚一 = 清零分配(词容量, 4); 前乙 = 清零分配(词容量, 4); 栈挂 = 清零分配(词容量, 4);
    余集 = 清零分配(词容量, 64);
    若 (!段粗 || !段汇 || !正低 || !源厚一 || !前乙 || !栈挂 || !余集) { 输出到文件(错误流, "[ERR] 宏展开内存不足\n"); 退出(1); }
    空八 = 0; 半吉 = 0;
    首布一(0, 词序);
    释放内存(词型表); 释放内存(词值表); 释放内存(词名表); 释放内存(词行表); 释放内存(词无符号表); 释放内存(词长表); 释放内存(段属);
    词型表 = 段粗; 词值表 = 段汇; 词名表 = 余集; 词行表 = 正低; 词无符号表 = 源厚一; 词长表 = 前乙; 段属 = 栈挂;
    词序 = 空八;
}
/* 修复 2026-08-30 探雷报告 雷1: 括号配对验证 — 词元 级统一扫 (词法+宏展开后, 解析器 前),
   任何不平衡立即报错 (带行号), 不再静默吞残缺语法 (原 块() 词终 静默退出 + 顶层孤立 } 忽略).
   C 括号严格嵌套, 纯栈式匹配即正确; 字符串/字符/注释已由 词法 处理为单 词元, 不干扰. */
静 整 主置(空) {
    整 顺降[8192]; 整 名从[8192]; 整 缓甲 = 0;
    遍 (整 计 = 0; 计 < 词容量 && 词型表[计] != 词终; 计++) {
        整 暂 = 词型表[计];
        若 (暂 == 左括 || 暂 == 左方 || 暂 == 左花) {
            若 (缓甲 >= 8192) { 输出到文件(错误流, "[ERR] 括号嵌套过深 行 %d (括号配对)\n", 词行表[计]); 返 -1; }
            顺降[缓甲] = 暂; 名从[缓甲] = 词行表[计]; 缓甲++;
        } 否 若 (暂 == 右括 || 暂 == 右方 || 暂 == 右花) {
            若 (缓甲 <= 0) { 输出到文件(错误流, "[ERR] 多余右括号 '%c' 行 %d (括号配对)\n", 暂 == 右括 ? ')' : (暂 == 右方) ? ']' : '}', 词行表[计]); 返 -1; }
            整 暂柒 = (暂 == 右括) ? 左括 : (暂 == 右方) ? 左方 : 左花;
            若 (顺降[缓甲 - 1] != 暂柒) {
                字 丙 = (顺降[缓甲 - 1] == 左括) ? '(' : (顺降[缓甲 - 1] == 左方) ? '[' : '{';
                字 字符 = (暂 == 右括) ? ')' : (暂 == 右方) ? ']' : '}';
                输出到文件(错误流, "[ERR] 括号不匹配 '%c' 长简 '%c' (开 行 %d, 闭 行 %d) (括号配对)\n", 丙, 字符, 名从[缓甲 - 1], 词行表[计]);
                返 -1;
            }
            缓甲--;
        }
    }
    若 (缓甲 > 0) {
        输出到文件(错误流, "[ERR] 缺右括号: %d 个未闭合 (首个开括号 '%c' 行 %d) (括号配对)\n", 缓甲, (顺降[0] == 左括) ? '(' : (顺降[0] == 左方) ? '[' : '{', 名从[0]);
        返 -1;
    }
    返 0;
}

静 空 字段名撞型词查(空) { /* S4+S5 批次 B 收口 (2026-09-29 虾米): 「字段名 撞 保留型词」错误检查 ——
    原 8 份 逐字同文 且 文案 已 分叉 (7 份 = "声明侧吞字段, 嵌套/匿名 结构体"; L18107 = "声明侧吞字段 —
    无名类型声明后须跟 字段名/或该型词是非法续类型") ⟹ 收口 单点权威 + 统一文案, 使 同类 修复 不可能 再 漏改第 8 处.
    语义 (P0.5 2026-09-05 首次落地): 构 X { 整 长; } —— 声明侧 型词 被吞 (整 之后 又 是 型词 长, 无字段名)
    静默 少字段; 合法字段 分号前 = 名字/右方/常数, 型词 在前 = 裸类型无名. 原 调用点: 独立结构体 路径 L18107 +
    嵌套/匿名 结构体 等 7 处 (L17807/17838/17881/17923/17957/18059/18219). */
    若 (词型表[词位] == 分号 && 词型表[词位 - 1] == 型词) {
        格式化到串(错缓冲, "字段名 缺失: 保留型词 '%s' 不能作字段名 (声明侧吞字段 — 匿名/嵌套/具名 结构体 声明后 须跟 字段名, 或该 型词 为 非法续类型; P0.5 2026-09-05)", 词名表[词位 - 1]);
        发错误("A9001", 错缓冲);
    }
}

静 整 解析(常 字 *串值) {
    打包待 = 0; /* 2026-09-03 账② 修复: 跨编译残留 → 新结构体被误标打包 → 字段对齐全 1 (struct_align 族) */
    词位 = 0; 接子数 = 1; 变量数 = 0; 栈用量 = 32; /* reserve 影子 空间 */
    遍 (整 单聚 = 0; 单聚 < 16384; 单聚++) { 变量表[单聚].元列 = 0; 变量表[单聚].首贰 = 0; 变量表[单聚].双伍 = 0; } /* 修复 步三十/31: 静态 变量 数组跨编译残留清零 — 对齐间接/变长数组 标记必须每编译重置 */
    函数定义数 = 0; /* 修复 2026-08-06: 每次 解析 重置顶层函数列表 */
    内存设置(节浮标, 0, 大小(节浮标)); /* 每-节点 双精度 标志 必须 非 leak 跨 编译 */
    内存设置(节无符号, 0, 大小(节无符号)); /* 每-节点 无符号 标志 (修复 2026-08-05) */
    内存设置(节长标, 0, 大小(节长标)); /* 修复 2026-08-31 生成器 s61: 节长标 数组从未清零 - 跨编译残留 */
    内存设置(cast32, 0, 大小(cast32)); /* 修复 2026-08-31 生成器 s61: cast32 表清零 */
    内存设置(错联标, 0, 大小(错联标)); 内存设置(节联宽槽, 0, 大小(节联宽槽)); /* R443: 同批 清零 (跨编译残留 同 节长标 教训) */ /* R437 (2026-09-30 虾米 · 第 437 站 · D-10): **错误联合标记表 跨编译残留清零** —— 原清零点只有定义处一处; 与 `节长标`/`cast32` 同款教训(脚本源码已因「跨编译残留」补过这两张表)。若不清理, 上一编译的 `错联标[序]=1` 会残留到本次, 或被本次新标记覆盖后又被**旧序**误读 ⟹ 与 `错联查名` 的序口径不一致。 */
    单粗 = 0; /* 复位 每-函数 变量-范围 表 */
    计凶 = 0; /* 过程宏注册表每编译重置 (嵌入模式多文件编译防残留) */
    内存设置(词型表, 0, 词容量 * 4);
    字 *后弊 = 缓卯(串值, 0); /* #包含 预展开（修复 2026-08-06） */
    
     
     
    原从(后弊); /* 修复 2026-08-13: 对象宏收集 (词法 前, 版本库 哈希-邻辰.h) */
    行申(后弊); /* 修复 2026-08-07: 移到 包含 展开之后 — 头文件里的函数宏才能被收集展开 */
/* C96 (2026-09-18 第 96 站): **先建对象宏表 (原从) 再收集函数宏 (行申)** —— 原顺序 (行申 先) 使 行申 内的 #if <表达式> 条件判定 (L600 外合 / L608 预处求值) 在 满八 为空时求值 ⟹ **别名宏条件恒假** (#define A B + #if A > 0 判假; 探针 [DBG-A] 实证: 行申阶段 满八=(空) 返 0, 词法阶段 满八=B 返 1) ⟹ 假分支里的 #define M(x) 类 **函数宏永不被收集** (Lua luaconf.h 三个浮点分支的 l_floatatt 全丢 ⟹ lcode.c/lmathlib.c/lstrlib.c 报 A1001 未声明函数 l_floatatt)。 */
    净集(串值); /* 泛型定义预扫描 (2026-09-01 修复: 改扫用户源码 串值 — 原 后弊 经 行申/原从 处理后泛型行丢失 → 展开失效; 头文件泛型罕见后续补) */
     
    若 (函数宏数 > 0) {
        字 *元列一 = 计进二(后弊);
         
        若 (元列一 && 元列一[0]) { 释放内存(后弊); 后弊 = 元列一; }
    }
    若 (栈凶 > 0) { /* 修复 2026-08-13: 对象宏文本层展开 (词法 前) */
         
        字 *中高一 = 实退一(后弊);
        若 (中高一 && 中高一[0]) { 释放内存(后弊); 后弊 = 中高一; }
    }
    若 (函数宏数 > 0) { /* 修复 2026-08-15: 对象宏值里嵌套的函数宏需第二遍展开 (STRMAP_INIT → HASHMAP_INIT) — 否则 链接器 未定义 符号 */
        字 *堆失 = 计进二(后弊);
        若 (堆失 && 堆失[0]) { 释放内存(后弊); 后弊 = 堆失; }
    }
    虚五 = 0; /* 修复 2026-08-13 第三阶段: 词法 阶段 #若 序布(X) 走 宏 表(词法 自己的 #定义); 清 单肆 防 行申 污染 → #若 !序布(XTYPES_H) 被误判已定义跳过 xtypes.h 类型定义 */
    
     
    词法(后弊);
    若 (串双 > 0) { 剩伴 = 1; 遍 (整 外拾 = 0; 外拾 < 串双 && 外拾 < (整)取字长(后弊); 外拾++) 若 (后弊[外拾] == '\n') 剩伴++; } /* 2026-08-28 位置.行: 后弊 中 运行时 部分实际行数 (展开后, 比 反进 准) */
    名称空间展开(); /* #279 名称空间/模块完整 (2026-09-01): 名称空间 名 { ... } 块内符号加前缀 名_, 名::符号 合并 */
    容癸一(); /* 宏系统 (2026-08-28 类型-根-12 #167): 词法 后 解析 前 词元 级展开 — 宏 名(参数) = 表达式; 或 宏 名(参数) { 语句 } */

    { 字 目次[96]; 格式化到串(目次, "{\"cp\":\"lex\",\"tokens\":%d}", 词序); 长叁(目次); } /* 编译检查点 (2026-08-28 甲序原生 #6): 词法 完成快照 */
    内巳(); /* 编译 DAG (可吞清单 阶段零-9): 词元 流阶段哈希 (词型表/词值表/词名表/词行表 入链) */

    
    释放内存(后弊);
    若 (词序 >= 词容量) { 输出到文件(错误流, "[ERR] 词元 溢出\n"); 返 -1; }
    若 (主置() < 0) 返 -1; /* 修复 2026-08-30 探雷雷1: 括号配对验证 (词法+宏展开后, 解析器 前) */
    整 指 = 建节(3); 若 (指 < 0) 返 -1;
    副丑 = 指; /* 修复 2026-08-18: 记录根节点 → 接子 子节点硬上限豁免 (根子槽仅 256, 函数>256 由 函数定义表 保留) */
    
    循环 (词位 < 词容量 && 词型表[词位] != 词终) {
        { 整 列玖 = 词位; (空)列玖; }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "重载")) { /* fix 2026-08-31 #255 顶层重载: 重载 + 点 = 点加; — 顶层主循环原无分支, 重载被变量声明/结构体分支吞 → main 丢失 */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 重载 */
            整 算子返三 = 0;
            若 (词型表[词位] == 加) { 算子返三 = 加; 词位++; }
            否 若 (词型表[词位] == 减) { 算子返三 = 减; 词位++; }
            否 若 (词型表[词位] == 乘) { 算子返三 = 乘; 词位++; }
            否 若 (词型表[词位] == 左括) { 算子返三 = 左括; 词位++; 若 (词型表[词位] == 右括) 词位++; }
            字 终薄三[64] = ""; 若 (词型表[词位] == 词变量) { 复制字符串(终薄三, 词名表[词位]); 词位++; }
            若 (词型表[词位] == 赋号) 词位++;
            字 函返三[64] = ""; 若 (词型表[词位] == 词变量) { 复制字符串(函返三, 词名表[词位]); 词位++; }
            若 (词型表[词位] == 分号) 词位++;
            若 (初甲 < 32 && 算子返三 && 终薄三[0] && 函返三[0]) { 重载表[初甲].符 = (字)算子返三; 复制字符串(重载表[初甲].型名, 终薄三); 复制字符串(重载表[初甲].函名, 函返三); 初甲++; }
            续;
        }
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "私有") || !比较字符串(词名表[词位], "公开"))) { /* 阶段C-1 #197 封装/访问控制: 私有 名; / 公开 名; — 符号可见性标记 (私有→scl=3 文件级局部符号, 跨 .o 不可见; 公开→scl=2 默认全局) */
            糖目标放行(词位 + 1); /* D12R456 */
            整 是私有 = !比较字符串(词名表[词位], "私有");
            词位++;
            字 符号名[64]; 复制字符串(符号名, 词名表[词位]); 词位++;
            若 (词型表[词位] == 分号) 词位++;
            若 (是私有) {
                函数私有标(符号名); /* C17 (2026-09-17) 根治: 私有 → **独立集合** 净私一 (原 入 静态集合 净深一 ⟹ 与 static 语义 混淆: prelude 的 static 桩定义 (waitpid/pipe/gettimeofday/git_SHA1_Update_Chunked/openlog/syslog) 让 后续 非 static 真定义 在 L18330 被 永久 标 static ⟹ .o 出 scl=3 ⟹ 链接期 缺 外部符号; 符号 scl 判定 两处 (段丑 L2907 + L25810) 均 查 函数是否静态 || 函数是否私有) */
                遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 符号名)) { 逆酉[计] = 1; 断; } /* 私有变量(后置标记): 逆酉 → COFF scl=3 (修复 2026-09-01: 原设 是否静态标 不参与符号 scl 判定 L21477; 前置标记由全局声明处查集合保证) */
            } 否 {
                隔凶(符号名); 函数私有除(符号名); /* 公开: 撤销私有函数标记 (出 静态 + 私有 两 集合) */
                遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 符号名)) { 逆酉[计] = 0; 断; } /* 公开变量: 逆酉清零 (若该变量同时 C 静态 声明则冲突, 以公开为准) */
            }
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "注解")) { /* #173 注解/属性 (2026-09-01): 注解 名 = 值; — 元数据标注, 注册注解表 (编译期可查) */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 注解 */
            字 注名[64] = "";
            若 (词型表[词位] == 词变量) { 复制字符串(注名, 词名表[词位]); 词位++; }
            若 (词型表[词位] == 赋号) 词位++;
            字 注值[256] = "";
            若 (词型表[词位] == 串词) { 若 (词值表[词位] >= 0 && 串表[词值表[词位]]) 复制字符串(注值, 串表[词值表[词位]]); 词位++; }
            否 { 整 注数 = 0; 若 (常量表达式求值(&注数)) 格式化到串(注值, "%d", 注数); }
            若 (词型表[词位] == 分号) 词位++;
            若 (注名[0] && 注解数 < 256) { 复制字符串(注解表[注解数].名, 注名); 复制字符串(注解表[注解数].值, 注值); 注解数++; }
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "打包")) { 打包待 = 1; 词位++; } /* #231 repr 打包: 打包 构 名 { } — 紧凑布局 */
        旁联 = 0; 名散 = 0; /* 修复 2026-08-25 步二十一: 每顶层语句清残留 — 变量前 _Alignas 不消费也不毒害后续 结构体; 步二十五: 名散 同步清 */
        若 (词型表[词位] == 直联) { 整 首酉 = 词值表[词位]; 词位++; 若 (词型表[词位] == 结构词) { 名散 = 首酉; 旁联 = 0; } 否 旁联 = 首酉; } /* 修复 2026-08-25 步二十一: 顶层 _Alignas(N) — 结构体 前修饰 结构体 变量 (步二十五), 否则给变量 (下一轮清理) */
        
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "__asm__") || !比较字符串(词名表[词位], "__asm"))) { /* 顶层内联汇编 (__attribute__ 误解析致函数体落到顶层): 跳过 */
            词位++;
            若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "__volatile__") || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")))) 词位++;
            若 (词型表[词位] == 左括) { 整 元 = 1; 词位++; 循环 (词位 < 词容量 && 元 > 0) { 若 (词型表[词位] == 左括) 元++; 否 若 (词型表[词位] == 右括) { 元--; 若 (元 <= 0) { 词位++; 断; } } 词位++; } }
            若 (词型表[词位] == 分号) 词位++;
            续;
        }
        /* _Static_assert(表达式, "消息"); — C11 编译期断言 (修复 2026-08-25 支持矩阵补全) */
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "_Static_assert") || !比较字符串(词名表[词位], "static_assert"))) {
            词位++; /* 跳过 名 */
            若 (词型表[词位] == 左括) 词位++; /* ( */
            整 单细一 = 0;
            常量表达式求值(&单细一);
            循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++; /* 跳到分号 (跳过 , "消息" ) ) */
            若 (词型表[词位] == 分号) 词位++;
            若 (!单细一) { 输出到文件(错误流, "[ERR] _Static_assert 失败\n"); 返 -1; }
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "测试")) { /* 接入 2026-08-29 阶段二 #192 编译期测试/文档: 测试 "名" 用 func; → 后凶: __qcc_test_reg("名", func) — 测试函数用户定义 (返回 0=通过 非0=失败) */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 测试 */
            字 型名[64]; 型名[0] = 0;
            若 (词型表[词位] == 串词) { 拷贝前n(型名, 串表[词值表[词位]], 63); 型名[63] = 0; 词位++; } /* "名" */
            若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "用")) 词位++; /* 用 */
            字 下二[64]; 复制字符串(下二, 词名表[词位]); 词位++; /* 测试函数名 */
            若 (词型表[词位] == 分号) 词位++; /* ; */
            若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
            若 (!串表[串数]) 串表[串数] = 短六();
            复制字符串(串表[串数], 型名);
            整 块 = 建节(5);
            整 呼 = 建节(4);
            { 整 符号数 = 建节(0); 节值表[符号数] = 串数; 节型表[符号数] = 串词; 节型别[符号数] = 节点_串词; 接子(呼, 符号数); } /* 参数1: "名" */
            串数++;
            { 整 宽环 = 建节(1); 复制内存((字*)(节名表 + 宽环), 下二, 64); 接子(呼, 宽环); } /* 参数2: 函数地址 */
            { 整 存分 = 建节(1); 复制内存((字*)(节名表 + 存分), "__qcc_test_reg", 15); 接子(呼, 存分); } /* 被调者 */
            接子(块, 呼);
            若 (全局初始化数 < 16384) 后凶[全局初始化数++] = 块; /* 主 入口执行注册 */
            续;
        }
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "接口") || !比较字符串(词名表[词位], "实现") || !比较字符串(词名表[词位], "常量") || !比较字符串(词名表[词位], "文档"))) { /* 第 455 站 #288: 顶层 `文档 "文本";` 也 转发 语句() — 原 顶层 无 分支 ⟹ 文档 静默 丢失 (文档数 = 0) */ /* 接入 2026-08-29 阶段二 #207 修复: 接口/实现 顶层声明 — 解析 顶层循环原无分支 → 否则 中断 吞后续 (主 丢失崩溃); 语句() 级已支持 (块 内), 顶层显式转发 */
            糖目标放行(词位 + 1); /* D12R456 */
            整 串值 = 语句(); /* 接口 名 { 方法 }; / 实现 名 于 类型 { 方法 = 函 }; (注册接口/实现 表) */
            若 (串值 >= 0) 接子(指, 串值);
            续;
        }
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "线程安全") || !比较字符串(词名表[词位], "线程不安全"))) { /* 接入 2026-08-29 阶段二 #70 Send/同步: 线程安全 T; / 线程不安全 T; — 标记类型跨线程传递安全/不安全 (传线程 检查) */
            糖目标放行(词位 + 1); /* D12R456 */
            整 尾平一 = !比较字符串(词名表[词位], "线程安全");
            词位++;
            字 计七[64]; 复制字符串(计七, 词名表[词位]); 词位++;
            若 (词型表[词位] == 分号) 词位++;
            若 (尾平一) 新失(计七); /* 线程安全 → 从 unsafe 表移除 (覆盖) */
            若 (后劣 >= 64) 原得("空乙 表 (Send/线程不安全 标注)", 64); /* A3-类型属性 容量守卫 (2026-09-12): 原 满 64 条 静默丢弃 → `线程不安全 T;` 标注 无效 而 不 报 */
             若 (!尾平一 && !串又(计七)) 复制字符串(空乙[后劣++], 计七); /* 第 441 站 #70 根治 (2026-10-02): 原缺 `!尾平一` 守卫 —— `新失(计七)` 只把条目**置空**(后劣 不减), 紧接着 `!串又(计七)` 因空串不等而返真 ⟹ 刚被移除的名字**又被加回**不安全表 ⟹ **`线程安全 T;` 反向 把 T 标成 线程不安全** (实测: `线程安全 盒;` + 函数内 `传线程 盒;` 报 A6023)。判据: 仅 `线程不安全 T;` 才注册。 */
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "密封")) { /* 接入 2026-08-29 阶段二 #207 密封/最终类: 密封 T; → 标记类型 T 不可被实现 (实现 T { ... } 拦截) */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 密封 */
            字 符号数[64]; 复制字符串(符号数, 词名表[词位]); 词位++;
            若 (词型表[词位] == 分号) 词位++;
            若 (行未 >= 64) 原得("源九一 表 (密封 标注)", 64); /* A3-类型属性 容量守卫 (2026-09-12): 原 满 64 静默丢弃 → `密封 T;` 实现 拦截 静默 失效 */
             若 (!栈六(符号数)) 复制字符串(源九一[行未++], 符号数);
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "复制")) { /* 阶段C-1 #9 Copy 语义 (2026-09-01): 复制 T; → 标记类型 T 可拷贝 — 移入 目标, 源 对 Copy 类型不失效源 (Rust Copy trait, C 按位复制默认) */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 复制 */
            字 复制名[64]; 复制字符串(复制名, 词名表[词位]); 词位++;
            若 (词型表[词位] == 分号) 词位++;
            若 (复制数 >= 64) 原得("复制表 (复制 标注)", 64); /* A3-类型属性 容量守卫 (2026-09-12): 原 满 64 静默丢弃 → `复制 T;` 无声 失效 (类型 被 当 非 Copy → 赋值/传参 走 移动) */
            若 (!复制查(复制名)) 复制字符串(复制表[复制数++], 复制名);
            { 整 型序 = 查类型(复制名); 若 (型序 >= 0) { 若 (型析查名(复制名) || 类型含析构字段(型序)) { 格式化到串(错缓冲, "析构类型 (TypeDrop A5): 类型 '%s' 已标 析构 或 含析构字段 — 不可再标 复制 (Copy+Drop 冲突, Rust 语义)", 复制名); 发错误("A3110", 错缓冲); } 类型表[型序].可复制 = 1; } } /* 2026-09-05 虾米 S3: Copy 位双写类型表 (类型属性权威; 复制表 保留兼容旧代码) — 标量 (整/字/双 无类型表条目) 由 类型可复制 默认 Copy */ /* A5 (2026-09-06): 含析构字段结构 标复制 → 拒 */
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "判别")) { 判别解析(); 续; } /* D-1: 判别 顶层定义 (全局类型/常量, 跨函数可用) */
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "析构")) { /* TypeDrop v1 (2026-09-06 虾米): 析构 T, fn; — 类型级析构登记 (Rust Drop): T 局部值变量 自动析构; 与 复制 T 冲突/未定义类型 → A3110 */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 析构 */
            字 析构类型名[64]; 复制字符串(析构类型名, 词名表[词位]); 词位++; /* 类型名 */
            若 (词型表[词位] == 逗号) 词位++; /* , */
            字 析构函数名[64]; 复制字符串(析构函数名, 词名表[词位]); 词位++; /* 析构函数名 */
            若 (词型表[词位] == 分号) 词位++; /* ; */
            若 (!析构函数名[0]) { 格式化到串(错缓冲, "析构类型: 缺析构函数名 (析构 %s, 函数名; — TypeDrop v1)", 析构类型名); 发错误("A3110", 错缓冲); }
            整 构序 = 查类型(析构类型名);
            若 (构序 < 0) { 格式化到串(错缓冲, "析构类型: 未定义类型 '%s' (先定义 构 %s {…} 再 析构; TypeDrop v1)", 析构类型名, 析构类型名); 发错误("A3110", 错缓冲); }
            若 (复制查(析构类型名) || (构序 >= 0 && 类型表[构序].可复制)) { 格式化到串(错缓冲, "析构类型: '%s' 已标 复制, 不可再 析构 (Copy+Drop 冲突, Rust 语义; TypeDrop v1)", 析构类型名); 发错误("A3110", 错缓冲); }
            若 (构序 >= 0 && 类型表[构序].析构函[0]) { 格式化到串(错缓冲, "析构类型: '%s' 重复登记 析构 (TypeDrop v1)", 析构类型名); 发错误("A3110", 错缓冲); } /* A3-析构位: 判据 = 真结构 字段 非空 (原 型析查名 线性扫) */
            若 (构序 >= 0) 复制字符串(类型表[构序].析构函, 析构函数名); /* A3-析构位: 写 真结构 (容量 随 类型表 4096; 原 `若 (型析数 < 64)` 满 即 静默丢弃) */
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "线性")) { /* 阶段C-1 #51 线性类型 (2026-09-02): 线性 T; → 标记类型 T 值只能消费一次 — T 类型变量读取即消耗 (加入已移表), 二次读取 A3101 (仿 移入 #5; 与 复制 相反: 复制=可无限拷贝, 线性=只许一次) */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 线性 */
            字 线性名[64]; 复制字符串(线性名, 词名表[词位]); 词位++;
            若 (词型表[词位] == 分号) 词位++;
            若 (线性数 >= 64) 原得("线性表 (线性 标注)", 64); /* A3-类型属性 容量守卫 (2026-09-12): 同 上 (线性 标注 静默 失效 → 值 可 被 复制, 语义 反了) */
            若 (!线性查(线性名)) 复制字符串(线性表[线性数++], 线性名);
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "部分应用")) { /* 接入 2026-08-29 阶段二 #212 柯里化/部分应用: 部分应用 g, f, a; → 生成 整数 g(整数 __pa_x) { 返回 f(a, __pa_x); } (绑定第一个参数, 顶层函数定义) */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 部分应用 */
            字 毛寅[64]; 复制字符串(毛寅, 词名表[词位]); 词位++; /* g 包装函数名 */
            若 (词型表[词位] == 逗号) 词位++;
            字 串升[64]; 复制字符串(串升, 词名表[词位]); 词位++; /* f 原函数名 */
            若 (词型表[词位] == 逗号) 词位++;
            整 半寅 = 赋值级(); /* 绑定参数 a */
            若 (词型表[词位] == 分号) 词位++;
            静 整 副进二 = 0; 字 序子[32]; 格式化到串(序子, "__pa_%d_", 副进二++);
            整 函数定义 = 建节(4); 复制内存((字*)(节名表 + 函数定义), 毛寅, 64);
            新寅[单粗] = 变量数; /* 2026-08-29 阶段二 #212: 函数变量起点 (缺则 g 变量范围含全部 → 序言 40+ 垃圾存帧) */
            变参(序子, 0, 0, 4, -1, 0, 0); /* 整数 __pa_x (第 1 参数 槽位=0→rcx, 原 槽位=1→rdx 错位) */
            整 反对 = 建节(5);
            { 整 呼 = 建节(4);
              接子(呼, 半寅); /* 参数1: 绑定值 a */
              { 整 值指 = 建节(1); 复制内存((字*)(节名表 + 值指), 序子, 32); 接子(呼, 值指); } /* 参数2: x */
              { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 串升, 64); 接子(呼, 函); } /* 被调者: f */
              整 邻轮 = 建节(6); 接子(邻轮, 呼); 接子(反对, 邻轮); } /* 返回 f(a, x); */
            接子(函数定义, 反对);
            若 (单粗 >= 65536) { 输出到文件(错误流, "[ERR] 函数体表超过 65536 上限\n"); 退出(1); }
            总甲[单粗] = 变量数; 单粗++; 反细[单粗 - 1] = 栈用量; 右陆 = 0;
            解析基 = 0;
            接子(指, 函数定义);
            若 (函数定义数 < 1024) { 号平[函数定义数] = 0; 函数定义表[函数定义数++] = 函数定义; }
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "嵌入")) { /* 接入 2026-08-29 阶段二 #189 编译期文件读取 (#embed 中文版): 嵌入 "文件" 于 数据, 长度; — 编译期读文件 → 全局 字符*数据 + 整数长度 (后凶 初始化) */
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; /* 嵌入 */
            字 串升[256]; 串升[0] = 0;
            若 (词型表[词位] == 串词) { 拷贝前n(串升, 串表[词值表[词位]], 255); 串升[255] = 0; 词位++; } /* "文件" */
            跳过于
            字 初联[64]; 复制字符串(初联, 词名表[词位]); 词位++; /* 数据名 */
            若 (词型表[词位] == 逗号) 词位++;
            字 当降[64]; 复制字符串(当降, 词名表[词位]); 词位++; /* 长度名 */
            若 (词型表[词位] == 分号) 词位++;
            FILE *名厚 = 打开文件(串升, "rb");
            若 (!名厚) { /* 第 440 站 F8#189 (2026-10-02): 原为 `输出到文件(错误流,"[ERR] …") + 退出(1)` —— **无错误码** ⟹ 违反 R3 可机器读 (拒绝须带码)。接入唯一错误出口 `发错误`. */
                格式化到串(错缓冲, "嵌入: 文件不存在或不可读 '%s' (编译期文件读取 #189, 路径按 当前工作目录 解析)", 串升); 发错误("A6019", 错缓冲); }
            若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
            若 (!串表[串数]) 串表[串数] = 短六();
            整 计卯 = (整)读取(串表[串数], 1, 12287, 名厚); /* 槽上限 12素繁 (大文件后续 字符[] 初始化补) */
            关文件(名厚);
            串表[串数][计卯] = 0;
            整 原属 = 串数; 串数++;
            变量静态(初联, 1); 未初始化移除(初联); /* 字符 *数据 */
            变量静态(当降, 4); 未初始化移除(当降); /* 整数 长度 */
            整 整系 = 建节(5);
            { 整 值 = 建节(1); 复制内存((字*)(节名表 + 值), 初联, 32);
              整 符号数 = 建节(0); 节值表[符号数] = 原属; 节型表[符号数] = 串词; 节型别[符号数] = 节点_串词;
              整 赋节 = 建节(10); 接子(赋节, 值); 接子(赋节, 符号数); 接子(整系, 赋节); } /* 数据 = 字符串槽; */
            { 整 值 = 建节(1); 复制内存((字*)(节名表 + 值), 当降, 32);
              整 计数一 = 建节(0); 节值表[计数一] = 计卯;
              整 赋节 = 建节(10); 接子(赋节, 值); 接子(赋节, 计数一); 接子(整系, 赋节); } /* 长度 = 计卯; */
            若 (全局初始化数 < 16384) 后凶[全局初始化数++] = 整系; /* 主 入口执行 */
