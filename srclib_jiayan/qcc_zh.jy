                    否 若 (变量是否长(变节)) { 移寄存器帧64(0, 偏移 - 当前帧大小); 节长标[数] = 1; } /* 长整 长整: 满 64-位 (修复 2026-08-05) */
                    否 若 (变量可空值(变节) && 节长标[数]) { 移寄存器帧64(0, 偏移 - 当前帧大小); 节长标[数] = 1; } /* S2b-1 (2026-09-09): 可空值 打包槽 全 64 位读 (判空/解包 提取高32 tag — 节长标 请求) */
                    否 若 (变量是否浮(变节)) { 若 (变量单标(变节)) 载单帧(偏移 - 当前帧大小); 否 逆厚(偏移 - 当前帧大小); } /* R4a-1: 单精度 float → movss 4B + 提升; 双精度 → movsd */
                    否 若 (宽复(变节)) { 移寄存器帧64(0, 变量基(变节, 偏移) - 当前帧大小); } /* 结构体 值: 满 8 字节 (≤8B 结构体) */
                    否 若 (变量是否字符(变节)) { 若 (整丙(变节)) 符号扩展字节(偏移 - 当前帧大小); 否 零扩展字节(偏移 - 当前帧大小); 若 (节点长性(数, -1)) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } } /* 修复 2026-08-25 缺陷#28b: 局部 字符 1 字节零扩展读 (原 32 位 → 负值/高位非零错); 修复 2026-08-29 生成器: 有符号 字符 符号扩展 符号扩展; 修复 2026-08-31 生成器 s65: 节长标 时 符号扩展64 64 位 — (uint64_t)八位整数 原只扩到 32 位 0xFFFFFFB9 应 0xFFFFFFFFFFFFFFB9 (同 短整 t42) */
                    否 若 (变量是否短(变节)) { 若 (变量是否无符号(变节)) 零扩展字(偏移 - 当前帧大小); 否 符号扩展字(偏移 - 当前帧大小); 若 (节点长性(数, -1)) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } } /* 修复 2026-08-25 缺陷#31b: 局部 短整 16 位读; 节长标 时 符号扩展64 64 位扩展 (t42 (无符号 长整 长整)短整) */
                    否 { 中发(中取帧, 0, 偏移 - 当前帧大小, 是64位有(数) ? 1 : 0 /* 第 168 站: 收口 */); 中刷(); } /* 第三阶段-中间表示: 局部 整数 读 */
                }
