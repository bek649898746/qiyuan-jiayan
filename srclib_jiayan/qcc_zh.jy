                    压栈寄存器(15); 移64(15, 4);
                    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                    减栈即(32);
                    调导入(隔利);
                    加栈即(32);
                    移64(4, 15); 弹栈寄存器(15);
                    加栈即(总计数);
                    元子 = 1;
                }
            } 否 若 (帧退(串升) >= 0 || 核退(串升) >= 0) {
                /* 外部库函数 (修复 2026-08-25 步五 时间 全系): 参数全 整数/指针 → 六十四位窗口 标丁 (rcx/rdx/r8/r9) 传参,
                   导入表 调用; 返回 整数/指针=堆九, 邻辰=堆九 64 (节长标 标记), 双精度=xmm0 (节浮标 标记)
                   C139 (2026-09-20 第 139 站): **内核库** (GetStdHandle/WriteFile/... 17 个) 也 走 本 分支 —— 其 参数/返回
                   与 msvcrt 同款 (全 整数/指针 + 8 字节 返回), 故 复用 同一 传参序列, 只 槽号 来源 不同 (核退). */
                整 新二一 = (帧退(串升) >= 0) ? 帧退(串升) : 核退(串升);
                若 (参数个数 >= 1) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[0] - 8); 移64(1, 0); }
                若 (参数个数 >= 2) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[1] - 8); 移64(2, 0); }
                若 (参数个数 >= 3) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[2] - 8); 移64(8, 0); }
                若 (参数个数 >= 4) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[3] - 8); 移64(9, 0); }
                遍 (整 键 = 4; 键 < 参数个数; 键++) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[键] - 8); 移栈寄存器64(32 + 8 * (键 - 4), 0); }
                压栈寄存器(15); 移64(15, 4);
                汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                减栈即(32);
                调导入(新二一);
                加栈即(32);
                移64(4, 15); 弹栈寄存器(15);
                加栈即(总计数);
                元子 = 1;
            } 否 {
                整 隔利 = 终陆(串升);
                若 (隔利 >= 0) { /* 外部数学函数：六十四位窗口 应用二进制接口 传参（双精度→xmm，签名固定全 双精度）+ 导入表 调用（修复 2026-08-06 缺陷-1） */
                    遍 (整 键 = 0; 键 < 参数个数 && 键 < 4; 键++)
                        主二(键, 参基 + 总计数 - 槽高[键] - 8);
                    遍 (整 键 = 4; 键 < 参数个数; 键++) {
                        主二(0, 参基 + 总计数 - 槽高[键] - 8);
                        末未(32 + 8 * (键 - 4), 0);
                    }
                    { /* 修复 2026-08-06: 显式对齐替代启发式 pad8 — pad8=((实参数+额外+5)&1) 在表达式嵌套时错（格式化打印 参数里的 pow 调用，堆平 已压栈偏移 8 → rsp 未对齐 → msvcrt movdqa 段错误）。
                          r15 保存 rsp → 且 rsp,-16 → 减 32 影子 → 调用 → 恢复。数学函数全为 1-2 双精度 参数（额外=0）。 */
                    压栈寄存器(15); /* 保存 r15 */
                    移64(15, 4); /* 移动 r15, rsp */
                    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp, -16 */
                    减栈即(32); /* 影子 空间 */
                    调导入(隔利);
                    加栈即(32);
                    移64(4, 15); /* 移动 rsp, r15 */
                    弹栈寄存器(15); /* 恢复 r15 */
                    加栈即(总计数); /* 弹栈 dead 实参 槽位 */ }
                    元子 = 1;
                } 否 {
                    /* 第 225 站 (2026-09-21 · R9 真身): 「未登记外部函数」报警。
                       病灶: 不在 三张 IAT 表 (msvcrt 35 / 内核库 17 / math 24) 里的 外部函数 调用,
                         编译期 静默 生成「返 0」⟹ 编译通过 但 运行期 恒 0, 无任何诊断
                         (与 C8「静默跳过」/ C18a「假成功」/ C7「实参掩盖」同族)。
                       本刀 只 装 报警器 (复用 空槽 0, 数组 不扩 ⟹ 零布局变化, 不改判据 ⟹ 零回归):
                         默认 零输出; QCC_DBG_SILENT=1 时 逐次 打印 函数名, 编译尾 静默报告() 汇总。 */
                    静默计(0, "外部函数未登记(代码生成为恒返0)");
                    若 (取环境("QCC_DBG_SILENT")) 输出到文件(错误流, "[未登记外部函数] %s\n", 串升);
                    移即(0, 0); /* 未定义 → 返回 0 */
                }
            }
            若 (!双玖 && !函数指 && !元子) 加栈即(8 * 参数个数); /* 清 up 已压 实参 (builtins: 无 影子 减) */
        } 断;
        例 节点_作用域块: {
            整 串五 = 旁得;
            整 满三 = 值序;
            若 (节值表[数] > 0) { 旁得 = 节值表[数] - 1; 值序 = 副子[数]; } /* 复合-语句 块: 节值表[] = 块 结束 变量 边界 集 由 块() (修复 2026-08-16); 副子[] = 块 开始 边界 (修复 2026-08-19: 嵌套块变量只在其块内可见) */
            整 计子 = -1; /* 修复 2026-08-31 生成器 s62: 逗号列表 (块) 末表达式 = 块 值 */
            遍 (整 计 = 0; 计 < 512; 计++) { 整 字符 = 取子(数, 计); 若 (字符 > 0) { 码生成(字符); 计子 = 字符; } } /* 修复 2026-08-18: 256→512 扩展子槽 — 大型函数体 > 256 语句不再截断 */
            遍 (整 行弊 = 节链[数]; 行弊 > 0; 行弊 = 节链[行弊]) /* 修复 2026-08-18: 溢出链块 (512+ 语句, 版本库 大函数体) */
