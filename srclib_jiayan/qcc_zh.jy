                若 (短进 >= 0 && 节型别[短进] == 节点_常数) { 整 字值 = 节值表[短进]; 遍 (整 乙 = 0; 乙 < 左陆; 乙++) { 若 (域退[乙] < 0 && ((池对[乙] >= 0 && 节型表[池对[乙]] == 0 && 节值表[池对[乙]] == 字值) || (链高[乙] >= 0 && 节型表[链高[乙]] == 0 && 节值表[链高[乙]] == 字值))) { 输出到文件(错误流, "[ERR] 冗余模式: 值 #%d 已被前臂匹配 (不可达分支, 号合.0 #142)\n", 字值); 退出(1); } } }
                若 (值二 >= 0 && 节型别[值二] == 节点_常数) { 整 素陆 = 节值表[值二]; 遍 (整 乙 = 0; 乙 < 左陆; 乙++) { 若 (域退[乙] < 0 && ((池对[乙] >= 0 && 节型表[池对[乙]] == 0 && 节值表[池对[乙]] == 素陆) || (链高[乙] >= 0 && 节型表[链高[乙]] == 0 && 节值表[链高[乙]] == 素陆))) { 输出到文件(错误流, "[ERR] 冗余模式: 值 #%d 已被前臂匹配 (不可达分支, 号合.0 #142)\n", 素陆); 退出(1); } } }
