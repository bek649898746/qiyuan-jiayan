        循环 (终[计] == '!') { 副高一++; 计++; }
        若 (计 > 0) {
            循环 (终[计] == ' ' || 终[计] == '\t') 计++;
            整 终一 = 计;
            若 (终[计] == '(') {
                整 元 = 1; 终一++;
                循环 (终[终一] && 元 > 0) { 若 (终[终一] == '(') 元++; 否 若 (终[终一] == ')') 元--; 终一++; }
                若 (终[终一] == ')') 终一++;
            } 否 若 (!比前n(终 + 计, "defined", 7) && 终[计 + 7] == '(') {
                整 元 = 1; 终一 = 计 + 8;
                循环 (终[终一] && 元 > 0) { 若 (终[终一] == '(') 元++; 否 若 (终[终一] == ')') 元--; 终一++; }
                若 (终[终一] == ')') 终一++;
            } 否 {
                循环 (终[终一] && (判字母数字((无 字)终[终一]) || 终[终一] == '_' || ((无 字)终[终一] >= 0x80))) 终一++;
            }
            若 (终一 > 计) {
                字 新厚[512]; 整 现伍一 = 终一 - 计; 若 (现伍一 > 510) 现伍一 = 510; 复制内存(新厚, 终 + 计, 现伍一); 新厚[现伍一] = 0;
                整 直戊一 = 预处求值(新厚);
                整 值 = (副高一 & 1) ? (直戊一 ? 0 : 1) : 直戊一;
                若 (终[终一] == 0) 返 值;
                字 整布[512];
                格式化到串(整布, "%d %s", 值, 终 + 终一);
                返 预处求值(整布);
            }
            返 预处求值(终 + 1) ? 0 : 1; /* 操作数无法解析: 回退旧行为 */
        }
    }
    /* split on || (lowest precedence), then &&, then ==/!=/< <= > >= — paren-aware (fix 2026-08-06 M7: 原在括号内错拆，(A||B)&&C 拆错) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (深 == 0 && 终[计] == '|' && 终[计+1] == '|') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 2);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            返 (预处求值(甲) || 预处求值(发字节)) ? 1 : 0;
        }
    }
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (深 == 0 && 终[计] == '&' && 终[计+1] == '&') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 2);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            返 (预处求值(甲) && 预处求值(发字节)) ? 1 : 0;
        }
    }
    /* 位或 | (fix 2026-08-26 cpython: _PyObject_VAR_SIZE #if ((SIZEOF_VOID_P-1) & SIZEOF_VOID_P) — 位运算缺位 → 条件求值错) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (深 == 0 && 终[计] == '|' && 终[计+1] != '|') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 1);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            返 预处求值(甲) | 预处求值(发字节);
        }
    }
    /* 异或 ^ */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (深 == 0 && 终[计] == '^') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 1);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            返 预处求值(甲) ^ 预处求值(发字节);
        }
    }
    /* 位与 & (单 &, 与 && 区分) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (深 == 0 && 终[计] == '&' && 终[计+1] != '&') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 1);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            返 预处求值(甲) & 预处求值(发字节);
        }
    }
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        字 算子 = 0; 整 现伍一 = 0;
        若 (深 == 0 && 终[计] == '=' && 终[计+1] == '=') { 算子 = 1; 现伍一 = 2; }
        否 若 (深 == 0 && 终[计] == '!' && 终[计+1] == '=') { 算子 = 2; 现伍一 = 2; }
        否 若 (深 == 0 && 终[计] == '<' && 终[计+1] == '=') { 算子 = 3; 现伍一 = 2; }
        否 若 (深 == 0 && 终[计] == '>' && 终[计+1] == '=') { 算子 = 4; 现伍一 = 2; }
        否 若 (深 == 0 && 终[计] == '<' && 终[计+1] != '<' && (计 == 0 || 终[计-1] != '<')) { 算子 = 5; 现伍一 = 1; } /* fix 2026-08-26 cpython: 排除 << 移位 (前后都查 — `A >> B` 的第二个 > 原被当比较) */
        否 若 (深 == 0 && 终[计] == '>' && 终[计+1] != '>' && (计 == 0 || 终[计-1] != '>')) { 算子 = 6; 现伍一 = 1; }
        若 (算子) {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 现伍一);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            整 亥 = 预处求值(甲), 寅 = 预处求值(发字节);
            若 (算子 >= 3 && (剩辰(甲) || 剩辰(发字节))) { /* fix 2026-08-26 cpython: 无符号感知比较 — UINT32_MAX=4294967295 截断 int 为 -1, `OUTPUT_BUFFER_MAX_BLOCK_SIZE > UINT32_MAX` (268M > 4G 应假) 误判真 → zlibmodule.c #error; 操作数是无符号宏时按 32 位无符号比较 */
                无 内得 = (无)亥, 隔布 = (无)寅;
                若 (算子 == 3) 返 内得 <= 隔布;
                若 (算子 == 4) 返 内得 >= 隔布;
                若 (算子 == 5) 返 内得 < 隔布;
                若 (算子 == 6) 返 内得 > 隔布;
            }
            若 (算子 == 1) 返 亥 == 寅;
            若 (算子 == 2) 返 亥 != 寅;
            若 (算子 == 3) 返 亥 <= 寅;
            若 (算子 == 4) 返 亥 >= 寅;
            若 (算子 == 5) 返 亥 < 寅;
            若 (算子 == 6) 返 亥 > 寅;
        }
    }
    /* 移位 << >> (优先级高于关系比较, 低于加减) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (深 == 0 && 终[计] == '<' && 终[计+1] == '<') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 2);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            整 移位 = 预处求值(发字节); 返 移位 >= 0 && 移位 < 32 ? 预处求值(甲) << 移位 : 0;
        } 否 若 (深 == 0 && 终[计] == '>' && 终[计+1] == '>') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 2);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            整 移位 = 预处求值(发字节); 返 移位 >= 0 && 移位 < 32 ? 预处求值(甲) >> 移位 : 0;
        }
    }
    /* arithmetic +/- (fix 2026-08-13: git-compat-util.h 的 __STDC_VERSION__ - 0 < 199901L;
       原整串当宏名 → 0 → #error. 优先级低于比较: 比较先拆, 算术在更内层;
       fix 2026-08-26 cpython: 循环从 i=0 起数括号 — 原 i=1 漏数首 '(' → (A-1)&B 的 - 被当顶层拆分 → 求值错) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (计 >= 1 && 深 == 0 && (终[计] == '-' || 终[计] == '+')) {
            字 甲[512], 发字节[512];
            整 标址 = 计;
            循环 (标址 > 0 && (终[标址-1] == ' ' || 终[标址-1] == '\t')) 标址--;
            复制内存(甲, 终, 标址); 甲[标址] = 0;
            复制字符串(发字节, 终 + 计 + 1);
            整 亥 = 预处求值(甲), 寅 = 预处求值(发字节);
            返 终[计] == '-' ? 亥 - 寅 : 亥 + 寅;
        }
    }
    /* arithmetic * / % (fix 2026-08-26 pngtest: png.h 版本检查 #if PNG_LIBPNG_VER != PNG_LIBPNG_VER_MAJOR * 10000 + ... 
       — 原无乘除拆解 → `PNG_LIBPNG_VER_MAJOR * 10000` 整串当宏名 → 0 → 10643!=0 误报 #error "Inconsistent version numbers".
       在 +/- 之后拆分 (乘除优先级高于加减; 递归内层自然生效); 除零返回 0 防 UB; fix 2026-08-26 cpython: 同 +/- 括号计数) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (计 >= 1 && 深 == 0 && (终[计] == '*' || 终[计] == '/' || 终[计] == '%')) {
            字 甲[512], 发字节[512];
            整 标址 = 计;
            循环 (标址 > 0 && (终[标址-1] == ' ' || 终[标址-1] == '\t')) 标址--;
            复制内存(甲, 终, 标址); 甲[标址] = 0;
            复制字符串(发字节, 终 + 计 + 1);
            整 亥 = 预处求值(甲), 寅 = 预处求值(发字节);
            若 (终[计] == '*') 返 亥 * 寅;
            若 (终[计] == '/') 返 寅 ? 亥 / 寅 : 0;
            返 寅 ? 亥 % 寅 : 0;
        }
    }
    /* number or macro name (fix 2026-08-06: 支持负数字面量 #if -5 < 0; 原 -5 落到 macro_find 失败 → 0) */
    整 负 = 0;
    若 (终[0] == '-') { 负 = 1; 终++; }
    若 (终[0] == '0' && (终[1] == 'x' || 终[1] == 'X')) {
        整 值 = 0, 指 = 2; 循环 (判十六进制((无 字)终[指])) { 整 字符 = 终[指]; 值 = 值 * 16 + (字符 >= '0' && 字符 <= '9' ? 字符 - '0' : (字符 >= 'a' && 字符 <= 'f' ? 字符 - 'a' + 10 : 字符 - 'A' + 10)); 指++; }
        返 负 ? -值 : 值;
    }
    若 (终[0] == '0' && 终[1] >= '0' && 终[1] <= '7') { 整 值 = 0, 指 = 0; 循环 (终[指] >= '0' && 终[指] <= '7') 值 = 值 * 8 + (终[指++] - '0'); 返 负 ? -值 : 值; } /* fix 2026-08-26 cpython: 八进制字面量 — fileutils.c `#if _S_IREAD != 0400` 原 0400 按十进制 400 求值 → 256!=400 真 → #error "Unsupported C library"; 必须在十进制之前 (0 开头优先) */
    若 (判数字((无 字)终[0])) { 整 值 = 0, 指 = 0; 循环 (判数字((无 字)终[指])) 值 = 值 * 10 + (终[指++] - '0'); 返 负 ? -值 : 值; }
    若 (负) 返 0; /* -名字: 不支持 */
    若 (!比前n(终, "defined", 7) && 终[7] == '(') { /* defined(X) 原子: 逻辑/比较拆分后到达 (fix 2026-08-15: defined(A)||defined(B) 原早退只算 A) */
        字 名存[64]; 整 名序 = 0; 整 指 = 8;
        循环 (判字母数字((无 字)终[指]) || 终[指] == '_' || ((无 字)终[指] >= 0x80)) { 若 (名序 < 63) 名存[名序++] = 终[指]; 指++; }
        名存[名序] = 0;
        返 (邻细(名存) || 外合(名存)) ? 1 : 0; /* fix 2026-08-06: 原 macro_find>=0 对负值宏判假; 2026-08-07: 顺序定义表也算 */
    }
    { 常 字 *素挂 = 双繁一(终); 若 (素挂 && 素挂[0] && 行分 < 24) { 行分++; 整 返二 = 预处求值(素挂); 行分--; 返 返二; } } /* fix 2026-08-26 pngtest: 对象宏别名在 #if 里递归求值 (#define PNG_LIBPNG_VER_SONUM PNG_LIBPNG_VER_SHAREDLIB — lexer 把非数值宏也注册成数值宏=0 → macro_exists 恒真 → 别名永不展开 → 16!=0 误报 #error); 必须在 macro_exists 之前查 obj_find — 别名宏在 macros[] 里的值是垃圾 0; 深度上限防 #define A A 自引用死循环 */
    若 (邻细(终)) 返 域零(终); /* fix 2026-08-06: 原 mv>=0 把负值宏当未找到 → 0 */
    返 前利(终); /* fix 2026-08-07: 顺序定义表的值 (#define MODE 2 → #if MODE==1 用真值而非存在性) */
}

/* include 目录栈: #include "x.h" 先相对当前源文件所在目录搜索, 再相对 cwd (fix 2026-08-13 Phase3) */
静 字 空七[16][512]; 静 整 净厚;
静 字 序己[512]; /* fix 2026-08-26 ffmpeg: pp_read_file_inc 实际找到文件的目录 (父链回溯命中时记录), pp_include_expand 用它建 inc_dir_stack — 原按 fname 子目录拼接导致头内相对 include 解析错 */
静 字 标寅一[512]; /* 顶层源文件目录 */
静 空 邻繁(常 字 *路径, 字 *出, 整 容量) {
    整 计 = 0, 末一 = -1;
    循环 (路径[计]) { 若 (路径[计] == '/' || 路径[计] == '\\') 末一 = 计; 计++; }
    若 (末一 > 0) { 整 数 = 末一 < 容量 - 1 ? 末一 : 容量 - 1; 复制内存(出, 路径, 数); 出[数] = 0; }
    否 出[0] = 0;
}
静 字 *元低(常 字 *串升);

/* #include "file" — 预处理器包含展开（lex 前；条件编译感知；fix 2026-08-06） */
静 字 *源乙(常 字 *路径) {
    FILE *文件 = 打开文件(路径, "rb");
    若 (!文件) 返 0;
    定位文件(文件, 0, 2); 长 尺寸 = 取文件位置(文件); 定位文件(文件, 0, 0); /* SEEK 宏定义在本函数之后，自宿主不处理真实 <stdio.h>；用字面量 0/1/2 避开先使用后定义 (fix 2026-08-16 自举回归) */
    若 (尺寸 < 0) { 关文件(文件); 返 0; }
    若 (尺寸 > 16 * 1024 * 1024) { 关文件(文件); 输出到文件(错误流, "[ERR] #include 文件超过 16MB 上限 (fix 2026-08-06 M8: 原无大小上限，编译不可信源码=任意大文件读取面)\n"); 退出(1); }
    字 *缓 = 内存分配((size_t)尺寸 + 1);
    若 (!缓) { 关文件(文件); 返 0; }
    size_t 半列 = 读取(缓, 1, (size_t)尺寸, 文件);
    缓[半列] = 0; 关文件(文件);
    返 缓;
}
静 字 *元低(常 字 *串升) {
    序己[0] = 0; /* fix 2026-08-26 ffmpeg: 每次搜索前清空, 成功点记录实际目录 */
    若 (!比较字符串(串升, "accctrl.h") || !比较字符串(串升, "aclapi.h")) {
        /* Windows SDK 头文件不在源码树内; compat_prelude.h 已提供 ipc-win32.c 所需的类型/宏/API stub (fix 2026-08-15: ipc_get_active_state undefined) */
        字 *半未 = 内存分配(2);
        若 (半未) 半未[0] = 0;
        返 半未;
    }
    若 (!比较字符串(串升, "limits.h")) {
        /* fix 2026-08-26 lua: <limits.h> 被跳过 → LLONG_MAX 等未定义 → luaconf.h `#if defined(LLONG_MAX)` 假
           → 整数类型链落到 #error "Compiler does not support 'long long'". 内建 limits.h: 标准整数极值
           (值同 png_compat.h, 已验证; 负值不括号 — pp_def_parse 只认 -N / (N)) */
        常 字 *构一 = "#define CHAR_BIT 8\n"
            "#define SCHAR_MIN -128\n#define SCHAR_MAX 127\n#define UCHAR_MAX 255\n"
            "#define CHAR_MIN 0\n#define CHAR_MAX 255\n"
            "#define SHRT_MIN -32768\n#define SHRT_MAX 32767\n#define USHRT_MAX 65535\n"
            "#define INT_MIN -2147483647\n#define INT_MAX 2147483647\n#define UINT_MAX 4294967295u\n"
            "#define LONG_MIN -9223372036854775808\n#define LONG_MAX 9223372036854775807\n#define ULONG_MAX 18446744073709551615UL\n"
            "#define LLONG_MIN -9223372036854775808\n#define LLONG_MAX 9223372036854775807\n#define ULLONG_MAX 18446744073709551615ULL\n";
        size_t 槽长 = 取字长(构一);
        字 *尾联 = 内存分配(槽长 + 1);
        若 (尾联) { 复制内存(尾联, 构一, 槽长); 尾联[槽长] = 0; }
        返 尾联;
    }
    若 (!比较字符串(串升, "stdint.h")) {
        /* fix 2026-08-29 csmith 崩溃族根因: <stdint.h> 系统头被跳过 (角括号 include 找不到即弃)
           → uint64_t/int64_t/size_t/intptr_t 无 typedef 注册 → 类型尺寸落默认 4 (错)
           → crc32_8bytes(uint64_t val) 参数 32 位 → (val>>32) 在 x86 移位计数 mod32 环绕成 >>0
           → 字节重复 → 校验和错 + 多维指针/volatile 崩溃族 (csmith 20 种子 17 崩)。
           内置 stdint.h: 标准整数类型 (x86_64 Win64), 值同 mingw; 已有 limits.h/stdarg.h 同款先例。
           注意 custom_stdint_x86.h 的 #define uint64_t 多 token 值 qcc 宏系统不支持 → 死宏, 无冲突。 */
        常 字 *构一 =
            "typedef signed char int8_t;\n"
            "typedef unsigned char uint8_t;\n"
            "typedef short int16_t;\n"
            "typedef unsigned short uint16_t;\n"
            "typedef int int32_t;\n"
            "typedef unsigned int uint32_t;\n"
            "typedef long long int64_t;\n"
            "typedef unsigned long long uint64_t;\n"
            "typedef long long intptr_t;\n"
            "typedef unsigned long long uintptr_t;\n"
            "typedef unsigned long long size_t;\n"
            "typedef long long ssize_t;\n"
            "typedef long long ptrdiff_t;\n"
            "typedef long long intmax_t;\n"
            "typedef unsigned long long uintmax_t;\n"
            "typedef long long int_least64_t;\n"
            "typedef unsigned long long uint_least64_t;\n"
            "typedef int int_least32_t;\n"
            "typedef unsigned int uint_least32_t;\n"
            "typedef long long int_fast64_t;\n"
            "typedef unsigned long long uint_fast64_t;\n"
            "typedef int int_fast32_t;\n"
            "typedef unsigned int uint_fast32_t;\n";
        size_t 槽长 = 取字长(构一);
        字 *尾联 = 内存分配(槽长 + 1);
        若 (尾联) { 复制内存(尾联, 构一, 槽长); 尾联[槽长] = 0; }
        返 尾联;
    }
    若 (!比较字符串(串升, "stdarg.h")) {
        /* fix 2026-08-23 t35e: <stdarg.h> is skipped by qcc (angle-bracket includes are
           dropped), so mingw's __builtin_va_start/__builtin_va_arg become undefined-function
           calls that silently return 0, and va_list decays to a 4-byte int (truncating the
           64-bit home-address) -> the whole va_list chain fails (git strbuf_addf/vsnprintf
           emit nothing). Builtin stdarg.h: va_list=char*, va_start->__qcc_va_start()
           (returns the Win64 home-area address), va_arg->pure C pointer arithmetic. */
        常 字 *构一 = "typedef char *va_list;\n"
            "#define _INTSIZEOF(n) ((sizeof(n) + 7) & ~7)\n"
            "#define va_start(ap, last) ((ap) = __qcc_va_start())\n"
            "#define va_arg(ap, type) (*(type *)(((ap) += _INTSIZEOF(type)) - _INTSIZEOF(type)))\n"
            "#define va_end(ap) ((ap) = 0)\n"
            "#define va_copy(d, s) ((d) = (s))\n";
        size_t 槽长 = 取字长(构一);
        字 *尾联 = 内存分配(槽长 + 1);
        若 (尾联) { 复制内存(尾联, 构一, 槽长); 尾联[槽长] = 0; }
        返 尾联;
    }
    若 (净厚 > 0 && 空七[净厚 - 1][0]) {
        字 整布[1024];
        复制字符串(整布, 空七[净厚 - 1]);
        拼接(整布, "/");
        拼接(整布, 串升);
        字 *容复 = 源乙(整布);
        若 (容复) { 复制字符串(序己, 空七[净厚 - 1]); 返 容复; }
