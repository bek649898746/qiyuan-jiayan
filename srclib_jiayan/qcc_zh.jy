静 空 末未(整 位移, 整 寄存器) { /* movsd [rsp+disp], xmmN */
    汇发("    浮存栈 [rsp%+d], xmm%d\n", (字*)(长 长)(位移), (字*)(长 长)(寄存器), (字*)(长 长)0);
    发字节(0xF2); 发字节(0x0F); 发字节(0x11);
    若 (位移 < 128 && 位移 >= -128) { 模字节(1, 寄存器 & 7, 4); 发字节(0x24); 发字节(位移); }
    否 { 模字节(2, 寄存器 & 7, 4); 发字节(0x24); 发四(位移); }
