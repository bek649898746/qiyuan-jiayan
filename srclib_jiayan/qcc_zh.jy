    设标号(副壹);
    汇发("    零扩展 eax, [rdx]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 2); /* movzx eax, byte[rdx] \xe2\x80\x94 \xe6\x97\xa0 REX (fix 2026-08-23 t35h: rex B=1 \xe5\x8f\x98 r10) */
