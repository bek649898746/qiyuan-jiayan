静 整 字段类型序(常 字 *符号数, 常 字 *函) {
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 -1;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].正辰[计], 函)) { 整 值; 复制内存(&值, &类型表[构序].毛利[计], 4); 返 值; }
    返 -1;
}
静 空 构域浮(整 构序, 常 字 *函) { /* mark a struct field as double (8-byte movsd access) */
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
