    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "结构化并发")) { /* 2026-09-01 #25 结构化并发: 结构化并发 { 体 } — 块内 线程 自动登记, 块退出自动 join 全部子线程 (父作用域等待子任务) */
        词位++; /* 结构化并发 */
        若 (词型表[词位] == 左花) 词位++; /* { */
        整 构块 = 建节(5);
