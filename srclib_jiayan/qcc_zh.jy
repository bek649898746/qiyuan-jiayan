/* A2 本体 (2026-09-12): 每字段 元数据 **真结构化** —— 原 16 个 按 同 下标 [1024] 对齐 的 平行数组
   (正辰/正聚/现捌/域行数/毛利/间次一/高玖/副优/值劣/内联/符肆/原进/主挂/高贰/副戌/字段函浮),
   合成 一行记录 —— 加一个 字段属性 只 改 这里; 继承 拷贝 由 15 处 手工 平行 拷贝 塌缩 为 1 处 整记录 拷贝.
注: 类型表 内 写 `字段录 字段[1024]` (不带 `构` 词) —— `构 <结构体类型名> <字段>[N];` 在 文件级匿名块 会 死循环 (另案挂账). */
typedef 构 { 字 正辰[64]; 整 正聚; 整 现捌; 整 域行数[4]; 整 毛利; 整 间次一; 整 高玖; 字 副优; 字 值劣;
        整 内联; 整 符肆; 字 原进; 整 主挂; 字 高贰; 字 副戌; 字 字段函浮; 字 数组标; 字 可空标; 字 错联标; } 字段录; /* R411 (2026-09-30): **字段级 错误联合 标记** —— 「`错误 T` 作字段」的**类型级载体**（`错联标[]` 原来只有变量级）；供 `解构(v,t) = s.值` 的字段源拆包判据（411）*/ /* R391 (2026-09-29 · C1-3 第一刀): 字段级 **可空标记** —— 原 `可空字段表[256]{构序,名}` 独立表 收进此处 (与 `原进` 指针标记 同点; `字段可空查` 由 线性扫 变 字段序查) */
静 构 { 字 名[64]; 字段录 字段[1024]; 整 函; 整 尺寸; 整 满卯; /* A41 (2026-09-12): 每字段 「函数指针 返回浮」 位 (真结构) — 写入 收口 在 字段类型() 一处; A3-7 (2026-09-12): 名键 侧表 字段函浮名/构/字段函浮数 已 **退役删除** (真结构 = 唯一 权威, 旁路表 82 → 81) */ 整 父构序; 字 是否联; 字 是否打包; 字 可复制; 字 契约印[65]; 字 析构函[64]; /* A3-析构位 (2026-09-12): `析构 T, fn;` 的 析构函数名 (真结构: 键 = 构序) — 原 名键 平行侧表 型析名[64][64]/型析函[64][64] (线性 反向 扫 + 64 条 静默 上限) 退役 */ /* A3-契约指纹 (2026-09-12): 契约 P; 的 SHA256 接口指纹 (真结构: 键 = 构序, 空 = 未登记) — 原 名键侧表 整伴[64][64]/长退[64][65] (旁路) 退役 */ } 类型表[4096]; /* 可复制: 所有权 copyable 位 (2026-09-05 虾米) — 0=非 Copy (默认, 赋值/传参走移动) 1=可 Copy (复制 T 标注或自动派生标量); BSS 零初值=非 Copy; 仅甲言模式生效 (C 兼容 struct 不受影响) */ /* 内联: 数组字段元素大小 (修复 2026-08-07) */ 静 整 类型数; /* 满卯: 结构体 最大对齐（修复 2026-08-06）; 修复 2026-08-13 字段表 64→128 (diff_options 71 字段); 修复 2026-08-14 128→256 (rev_info 130+ 字段); 主挂/高贰 (修复 2026-08-22 t41b): 指针字段最终元素大小 + 指针层级 — T** 双指针字段双层下标 (板[i][j]) 第二维缩放; 副戌 (修复 2026-08-29 生成器): 有符号 字符 字段标记 (int8_t 字段读 符号扩展, 剩十/s137 静默); 父构序 (阶段C-1 #193 2026-09-01): 单继承父类型索引 (-1=无) — 构 子 : 父 { } 基类字段置首; 是否联 (阶段C-1 #193): 本类型是 联合 (联/union) — 联合不可被继承 */

静 整 查类型(常 字 *数) {
    遍 (整 计 = 0; 计 < 类型数; 计++) 若 (!比较字符串(类型表[计].名, 数)) { 若 (取环境("QCC_DBG_NS")) 若 (查找子串(数, "ref_namespace")) 输出到文件(错误流, "[NS] st_find '%s' -> %d sz=%d algn=%d fn=%d\n", 数, 计, 类型表[计].尺寸, 类型表[计].满卯, 类型表[计].函); 返 计; }
    若 (取环境("QCC_DBG_NS")) 若 (查找子串(数, "ref_namespace")) 输出到文件(错误流, "[NS] st_find '%s' -> -1\n", 数);
    返 -1;
}
静 整 位槽 = -1, 位位 = 0;  /* 位-字段 packing 状态: 当前 整数-槽位 正聚 + 位 偏移 之内 它 */
静 空 类型定型(整 构序) { /* 修复 2026-08-06: 结构体 总大小按最大对齐 轮 up — 原只记 满卯 未应用, 域{整数,字符}=5 应为 8 (数组 步长/列败 一致性) */
    若 (构序 >= 0 && 类型表[构序].满卯 > 1) {
        整 账二填 = (类型表[构序].满卯 - (类型表[构序].尺寸 % 类型表[构序].满卯)) % 类型表[构序].满卯;
        类型表[构序].尺寸 += 账二填; /* 2026-09-03 账② 修复: 原 if 条件写自引用复杂表达式丢失, 拆临时变量 */
    }
}
静 空 实重一(整 新构序); /* 前向: 前向声明 结构体 标签 *字段 的类型回填 (修复 2026-08-18) */
静 整 标合 = 1; /* 修复 2026-08-19: 结构体 类型成员的对齐暂存 — 注册处设, 字段尺寸递归 消费 (FILETIME=4 → WIN32_FIND_DATAW 布局对齐 前巳一 SDK) */
静 字 字段数组待 = 0;
/* 第 455 站第二十一轮: **函数指针字段 的 数组元素数** 独立侧表 —— 键 (构序, 字段序), 值 = 元素数 (0 = 标量)。
   为什么不用 `字段录` 里的位: 实测 `域行数[3]` 被别处使用（写它 ⟹ 运行期 0xC0000005）、
   `高贰` 亦改变 direct 调用的码生成（写它 ⟹ `s.t[0](5)` 崩）⟹ 两处都**不能**承载新语义。
   成因: 类型表里 标量 `整 (*f)(整)` 与 size-1 数组 `整 (*t[1])(整)` **逐字段同形** ⟹ 声明期事实只能另存。 */
静 整 字段素构[1024]; 静 整 字段素序[1024]; 静 整 字段素值[1024]; 静 整 字段素数 = 0;
静 空 字段素登(整 构序, 整 序, 整 素) { 若 (字段素数 < 1024) { 字段素构[字段素数] = 构序; 字段素序[字段素数] = 序; 字段素值[字段素数] = 素; 字段素数++; } }
静 整 字段素查(整 构序, 整 序) { 遍 (整 计素 = 字段素数 - 1; 计素 >= 0; 计素--) 若 (字段素构[计素] == 构序 && 字段素序[计素] == 序) 返 字段素值[计素]; 返 0; }
静 整 字段函层构[1024]; 静 整 字段函层序[1024]; 静 整 字段函层值[1024]; 静 整 字段函层数 = 0;
静 空 字段函层登(整 构序, 整 序, 整 星) { 若 (字段函层数 < 1024) { 字段函层构[字段函层数] = 构序; 字段函层序[字段函层数] = 序; 字段函层值[字段函层数] = 星; 字段函层数++; } } /* L-15 (第二十四轮): 声明期 登记 函数指针字段的 **星数** (1 = `整 (*f)(整)`, 2 = `整 (**pp)(整)`) —— 类型表 里 二级 退化为 普通指针 (毛利=-1) 与 `整 *p` 逐字段同形 ⟹ 侧表 是 唯一可区分载体 (同 第二十一轮 `字段素登` 模式) */
静 整 字段函层查(整 构序, 整 序) { 遍 (整 计函 = 字段函层数 - 1; 计函 >= 0; 计函--) 若 (字段函层构[计函] == 构序 && 字段函层序[计函] == 序) 返 字段函层值[计函]; 返 0; }
静 整 可空值待 = 0; /* C1 第385站: 下一字段 是「值类型 可空」(B2 tag 区) */
静 整 维长表[4]; /* B7 (2026-09-29): 最近一次 字段数组维度解析 的 **逐维长度** */
静 整 维长数 = 0;  /* B7: 维长表 有效长度 */ /* t12 (2026-09-25 启元 · 第 363 站): 下一字段 是否 数组 —— 解析路径置 1, 字段尺寸递归/联合字段 统一消费 并 标 数组标. 设立缘由: 单元素数组 T a[1] 与标量 T a 在类型表里 现捌==域行数 完全同形, 值布/末凶一 只能靠 `总字节>元素尺寸` 推断 ⟹ 单元素数组全盲 (静态 { {v} } 初始化值丢弃); 同一语义 单一权威载体. */
静 整 字段错联待 = 0; /* R411: 下一字段 是否 `错误 T`（同 A62 字段浮待 的单点收口模式）*/
静 整 字段浮待 = 0; /* A62 (2026-09-14): 下一字段 是否 双精度 — 各 内联定义 解析路径 识别 double 时 置 1, 字段尺寸递归 统一 消费 并 标 副优 (根治「同一语义 多条路径改一漏五」) */
静 整 打包待 = 0;   /* 顶层 打包 前缀暂存 (构加 消费) — 2026-09-08 前移: 原声明 L14455 在 构加 L1746 之后 → 构加内前向引用 隐式声明 双同名条目 → 写(L14868)/读(L1746) 地址分裂 (0x2801af28 vs 0x5686287a), 自举静态丢值根因 */
静 整 旁联 = 0; /* 修复 2026-08-25 步二十一: _Alignas(N) 显式对齐暂存 — 解析器 在 直联 词元 处设, 字段尺寸递归 消费 (字段级对齐, 并抬升 结构体 最大对齐) */
静 整 名散 = 0; /* 修复 2026-08-25 步二十五: _Alignas(N) 结构体 前 — 修饰 结构体 变量 (编译器: `_Alignas(16) 结构体 S v;` 对齐 v, 不修饰类型/字段); 变构 消费 */
静 整 复制查(常 字 *数); /* 前向声明 (所有权 S4b, 2026-09-05): 构加 回查 复制表 用 — 复制 T 顺序无关 */
静 整 构加(常 字 *数) {
    若 (类型数 >= 4096) { 输出到文件(错误流, "[ERR] 结构体 表满 4096 (修复 2026-08-17 审计: 满则硬退, 绝不返 -1 — 原返 -1 调用方未检查 → 类型表[-1] 越界写)\n"); 退出(1); }
    复制字符串(类型表[类型数].名, 数); 类型表[类型数].函 = 0; 类型表[类型数].尺寸 = 0; 类型表[类型数].满卯 = 1; 类型表[类型数].父构序 = -1; 类型表[类型数].是否联 = 0; 类型表[类型数].契约印[0] = 0; 类型表[类型数].析构函[0] = 0; /* A3-析构位: 同 契约印 — 非空即「已登记」的 真结构位, 建条目 必须 显式 清空 (可重入: 同 索引 跨编译 复用) */ /* #193: 默认无父, 非联合; A3-契约指纹 (2026-09-12): 新条目 契约指纹 置空 (可重入: 同 索引 跨编译 复用 时 不 残留 上次 的 指纹 → 否则 无 `契约 P;` 的 第二次 编译 会 误 认 已 登记) */
    位槽 = -1; 位位 = 0; /* 复位 位-字段 packing 遍 该 新 结构体 */
    标合 = 1; /* 修复 2026-08-20: 新 结构体 开始时重置 结构体 对齐暂存 — 原跨 结构体 泄漏 (eg_a 满卯=8 残留 → eg_b 字段被 8 对齐 → di_b 数组字段偏移 8 错 (应 4)) */
    整 半捌 = 类型数++;
    若 (复制查(数)) 类型表[半捌].可复制 = 1; /* 所有权 S4b (2026-09-05 虾米): 复制 T 顺序无关 — 构 声明时回查复制表 (复制 T 声明于构 前也生效; 规避 遗留 bug: 构定义后紧跟 复制T 顶层解析断链 — 构分支把 复制 当构类型变量名吞, 后续函数丢失) */
    若 (打包待) 类型表[半捌].是否打包 = 1; 否 类型表[半捌].是否打包 = 0; 打包待 = 0; /* #231: 消费顶层打包前缀 (2026-09-03 账② 修复: 打包标 数组自举读写丢值, 并入类型表) */
    若 (取环境("QCC_DBG_NS")) 若 (1) 输出到文件(错误流, "[NS] st_add name='%s' ns=%d\n", 数, 半捌); /* 暂存 diag 全 */
    若 (取环境("QCC_DBG_NS")) 若 (查找子串(数, "pathspec")) 输出到文件(错误流, "[NSA!] st_add name='%s' ns=%d\n", 数, 半捌); /* P0-10: 原 **无条件**, 污染 stderr → 改 受 QCC_DBG_NS 控制 */
    实重一(半捌); /* 新结构体定义 (或首次引用即创建) → 回填引用它的 待定 指针字段 (修复 2026-08-18) */
