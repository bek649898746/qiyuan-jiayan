                            否 若 (变量是否长(变名)) { 中发(容重, 偏移 - 当前帧大小, 0, 0); 中刷(); 若 (变量可空值(变名) == 2) { 整 标偏二 = 可空标槽(变名); 若 (标偏二 >= 0) { 移即(0, 0); 中发(容重, 标偏二 - 当前帧大小, 0, 0); 中刷(); } } } /* 第三阶段-中间表示 例十; H1a (2026-09-11): 分离 tag 槽 类 赋值 补 tag=0 (有值) — 与 packed 类 赋值 语义 对齐 */
                            否 若 (宽复(变名)) { 中发(容重, 变量基(变名, 偏移) - 当前帧大小, 0, 0); 中刷(); 若 (变量可空值(变名) == 2) { 整 标偏八 = 可空标槽(变名); 若 (标偏八 >= 0) { 移即(0, 0); 中发(容重, 标偏八 - 当前帧大小, 0, 0); 中刷(); } } } /* 第三阶段-中间表示 例十; H1c (2026-09-11): 结构体 可空 值 赋值 → 补 tag=0 (有值) */
                            否 若 (变量是否字符(变名)) { 中发(终九, 偏移 - 当前帧大小, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十 */
否 若 (变量是否短(变名)) { 中发(外玖, 偏移 - 当前帧大小, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 短整 2 字节截断存 */
                    否 { 若 (空源) { 中发(容重, 偏移 - 当前帧大小, 0, 0); 中刷(); } 否 { 中发(堆庚, 偏移 - 当前帧大小, 0, 0); 中刷(); 若 (变量可空值(变名)) { 移即(0, 0); 中发(堆庚, 偏移 - 当前帧大小 + 4, 0, 0); 中刷(); } /* S2b-1: 可空值 有值写 → 打包 {高32 tag=0 | 低32 值} */ } }
                }
                }
            }
        } 断;
        例 节点_取址: { /* &变量 亦 &结构体.字段, &数组[i] */
            若 (子0[数] >= 0 && 节型别[子0[数]] == 节点_变量 && 查变量((字*)(节名表 + 子0[数])) < 0 && 查函数纯((字*)(节名表 + 子0[数])) >= 0) { /* L-15 根因 (C 6.5.3.2): `&函数名` 的值 = **函数地址** = 函数名本身的值。
