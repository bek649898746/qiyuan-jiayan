            词型表[词序] = 常数; 词值表[词序] = 字值; { 词行表[词序] = 当前行; 素集 = 当前行; 词序++; } 续;
        }
        择 (串值[计]) { 例 '+': 词型表[词序] = 串值[计 + 1] == '+' ? (计++, 增增) : 串值[计 + 1] == '=' ? (计++, 加等) : 加; 断; 例 '-': 词型表[词序] = 串值[计 + 1] == '>' ? (计++, 箭头) : 串值[计 + 1] == '-' ? (计++, 减减) : 串值[计 + 1] == '=' ? (计++, 减等) : 减; 断; 例 '*': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 乘等) : 乘; 断; 例 '/': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 除等) : 除; 断; 例 '%': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 隔伍) : 取余; 断; 例 '&': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 与等) : 串值[计 + 1] == '&' ? (计++, 逻辑与) : 点; 断; 例 '|': 词型表[词序] = 串值[计 + 1] == '>' ? (计++, 满再一) : 串值[计 + 1] == '=' ? (计++, 或等) : 串值[计 + 1] == '|' ? (计++, 逻辑或) : 或; 断; /* 接入 2026-08-27 管道操作符: | > → 满再一 (a |> f = f(a)) */ 例 '^': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 异或等) : 异或; 断; 例 '~': 词型表[词序] = 按位非; 断; 例 '?': 词型表[词序] = (串值[计 + 1] == '.') ? (计++, 长粗) : 问号; 断; /* ?. 可选链 → 长粗 (接入 2026-08-28); 普通 ? → 问号 三目 */ 例 '.': 若 (串值[计 + 1] == '?') { 计++; 词型表[词序] = 长粗; } /* 可选链 ?. → 长粗 (接入 2026-08-28: a?.b = a 非空 ? a->b : 0) */ 否 若 (串值[计 + 1] >= '0' && 串值[计 + 1] <= '9') { 整 副吉, 深庚一; 行丁(串值, &计, &副吉, &深庚一); 整 单A50 = 0; 若 (串值[计] == 'f' || 串值[计] == 'F') { 单A50 = 1; 计++; } /* A50: 记录 `.5f` 单精度 后缀 (原 丢弃) */ 若 (浮数 >= 8192) { 输出到文件(错误流, "[ERR] 双精度 栈散 满\n"); 退出(1); } 现退[浮数] = 副吉; 逆组[浮数] = 深庚一; 词型表[词序] = 终简; 词值表[词序] = 浮数; 词长表[词序] = 单A50 ? 3 : 0; 浮数++; /* A50: 词长表 3 = 单精度 */ { 词行表[词序] = 当前行; 素集 = 当前行; 词序++; } 续; } 词型表[词序] = 句点; 断; 例 '=': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 高平) : 赋号; 断; 例 '<': 词型表[词序] = 串值[计 + 1] == '<' ? (串值[计 + 2] == '=' ? (计 += 2, 左移一) : (计++, 左移)) : 串值[计 + 1] == '=' ? (计++, 元九) : 下双; 断; 例 '>': 词型表[词序] = 串值[计 + 1] == '>' ? (串值[计 + 2] == '=' ? (计 += 2, 右移一) : (计++, 右移)) : 串值[计 + 1] == '=' ? (计++, 首降) : 终附; 断; 例 '!': 词型表[词序] = 串值[计 + 1] == '=' ? (计++, 顺八) : 总零; 断; 例 ';': 若 (收别名) { 若 (!别名废 && 别名深 == 0 && 别名缓[0]) { 加别名(别名缓);} 收别名 = 0; } 词型表[词序] = 分号; 断; 例 ',': 词型表[词序] = 逗号; 断; 例 '(': 别名废 = 1; 若 ((词序 > 0 && (词型表[词序 - 1] == 型词 || 是别名(词名表[词序 - 1]))) && 括声一(串值, 计)) { 吞右括 = 1; 跳发一 = 1; } 否 词型表[词序] = 左括; 断; 例 ')': 若 (吞右括) { 吞右括 = 0; 跳发一 = 1; } 否 词型表[词序] = 右括; 断; 例 '{': 别名深++; 词型表[词序] = 左花; 断; 例 '}': 若 (别名深 > 0) 别名深--; 词型表[词序] = 右花; 断; 例 '[': 别名废 = 1; 词型表[词序] = 左方; 断; 例 ']': 词型表[词序] = 右方; 断; 例 ':': 词型表[词序] = 冒号; 断; 缺: 半壬++; 计++; 续; } 若 (!跳发一) { 词行表[词序] = 当前行; 素集 = 当前行; 词序++; } 跳发一 = 0; 计++; /* A8: 归约时 不发射 (跳发一) */ /* 修复 2026-08-13 第三阶段: 缺省 不发射 词元 (原 词序++ 留下 词型表=0=词终 幽灵 词元 截断 解析) */
    }
    若 (半壬) 输出到文件(错误流, "[WARN] 词法: %d 未知字符被忽略为空白 (修复 2026-08-09 缺陷-5)\n", 半壬);
}

