        接子(甲, 左退一); /* a 算子= b → a = a 算子 b */
        返 甲;
    } 若 (!首己 && !括内层 && 目凶一 > 0) { 格式化到串(错缓冲, "所有权错误: 变量 '%s' 已移动 (移动 后源失效), 不能读取 (号合.0 #5)", 毛玖[0]); 发错误("A3101", 错缓冲); } /* 接入 2026-08-28 机制层 #5: 非赋值场景左值即右值读取 — 缓冲里的 已移 变量报错; 移入 目标 解析期跳过 (目标 是写目标, 可为已移动变量) */ 若 (!首己 && !括内层 && 旧辛 > 0) { 遍 (整 检辛 = 0; 检辛 < 旧辛; 检辛++) 若 (尾系(容进[检辛])) { 格式化到串(错缓冲, "明确初始化: 变量 '%s' 未初始化就读取 (声明须初始化或先赋值, 号合.0 #78)", 容进[检辛]); 发错误("A4001", 错缓冲); 断; } } /* D12R454b: **逐名 复查 `尾系()`** —— 缓冲 里 的 变量 可能 **已 被 内层 赋值 路径 初始化** (`未初始化移除` 清 就绪丙, 但 不清 容进 缓冲): 实测 `((ap) = 0);` (prelude `va_start` 宏 展开) 其中 内层 `赋值()` 已 写 `ap`, 外层 末尾 仍 见 缓冲 有 `ap` ⟹ 假阳. 改 为 报错前 复核 每个 名字 当前 **是否仍** 未初始化 ⟹ 写后 读 不再 冤. */ /* 接入 2026-08-28 机制层 #78: 非赋值场景左值即右值读取 — 缓冲里的未初始化变量报错; 移入 目标 解析期跳过 (移入=初始化, 修复 2026-08-28 #78回归: 移入 b,a 的 b 未初始化被误伤) */ 若 (!首己 && !括内层 && 顺深 > 0) { 若 (下列[0]) { 格式化到串(错缓冲, "借用检查: 字段/元素 '%s' 被可变借用 (独占), 不能读取 (号合.0 #33/#34)", 值八[0]); 发错误("A3001", 错缓冲); } 否 { 格式化到串(错缓冲, "所有权错误: 字段/元素 '%s' 已移动 (部分移动后源字段失效, 号合.0 #17)", 值八[0]); 发错误("A3101", 错缓冲); } } /* 2026-08-28 阶段一 #33/#34/#17: 成员/元素路径读检查 — 赋值 对所有表达式设 lhs=1, 路径读=非写目标时事后判定 (写目标已在 赋号 分支清缓冲+写策略处理) */ 若 (!首己 && !括内层 && !移入源中 && 可空读数 > 0) { 格式化到串(错缓冲, "可空类型: 变量 '%s' 未解包就取值 (值类型运算/传参/比较) — 先 解包 %s; 或 若(!判空 %s) { ... } 分支窄化 (类型根治①, 号合.0 #75)", 可空读[0], 可空读[0], 可空读[0]); 发错误("A8001", 错缓冲); } /* 2026-09-10 N1: 可空值类型 读值 事后判定 (目系缓冲; 写目标赋号分支 副降一 清可空 不报) */ 若 (!首己 && !括内层 && 尾阵读数 > 0) { 若 (支层 > 0 && 支层 <= 128) { 整 层读 = 支层 - 1; 遍 (整 乙转 = 0; 乙转 < 尾阵读数 && 支阵读量[层读] < 8; 乙转++) { 复制字符串(支阵读名[层读][支阵读量[层读]], 尾阵读[乙转]); 支阵读位[层读][支阵读量[层读]] = 尾阵读位[乙转]; 支阵读量[层读]++; } } 否 { 格式化到串(错缓冲, "明确初始化: 数组元素 '%s[%d]' 未初始化就读取 (元素级 #78: 该元素从未被写入)", 尾阵读[0], 尾阵读位[0]); 发错误("A4001", 错缓冲); } } /* I2-③ 元素级: 读缓冲 事后判定 (写目标 由 RHS 递归清缓冲, 不报); A103: **分支内 推迟** —— 记入 本层 缓冲, 由 `支阵合()` 在 汇合点 判定 (否则 then 判定时 else 未解析 ⇒ 假阳) */ 返 数; }
静 整 管道字段维数(整 构序, 整 序FI) { /* 第 455 站 第十四轮: 函数指针字段 的 数组维数 (0=标量 / 1 / 2)
    实测 (FDBG 插桩): `整 (*t[2])(整)` 域行数[0]=8 现捌=16; `整 (*t2[2][3])(整)` 域行数[0]=24 域行数[1]=8 现捌=48。
    ⚠️ 关键: `字段录.数组标` 对**函数指针数组字段不置位**(实测 =0) ⟹ 不能用它判「是否数组」;
    可用的是 `现捌`(总字节) 与 `域行数[0]`(**行宽**): 总元素数 = 现捌/8, 首维 = 现捌/域行数[0],
    二者相等 ⟹ 1 维, 否则 2 维。 */
    若 (序FI < 0) 返 0;
    /* 第十九轮 (skeptic 第八轮): 权威来源 = **声明期登记的元素数** (`域行数[3]`, 见两条函数指针字段路径)。
       类型表里 标量 `整 (*f)(整)` 与 size-1 数组 `整 (*t[1])(整)` **逐字段同形** (现捌=8 域行0=8 数组标=0 原进=0)
       ⟹ 只能靠声明期事实区分; 上一轮用「用户写了 `[i]`」猜 ⟹ 误放行标量越界下标 (`s.f[1]` 崩)。 */
    整 素F = 字段素查(构序, 序FI); /* 第二十一轮: 侧表查询 (类型表里的位都不能承载 —— 见侧表注释) */
    若 (素F <= 0) 返 0; /* 标量 ⟹ 维数 0 (下标分支据此 **拒**) */
    若 (素F == 1) 返 1; /* size-1 数组 */
    整 总字F = 类型表[构序].字段[序FI].现捌;
    整 域行F = 类型表[构序].字段[序FI].域行数[0];
    整 总素F = 总字F / 8;
    整 首维F = (域行F > 0) ? 总字F / 域行F : 0;
    若 (首维F > 0 && 总素F == 首维F) 返 1;
    返 2;
}
静 整 管道变量层级(整 节) { /* 第 455 站 第七轮 (skeptic 第三轮驳回 修复): 返回 变量的 **函数指 层级**。
    血泪: 上一轮判据 `(登-1) % 16 == 9` **丢掉了层级** ⟹ 把 函数指针**数组** `整 (*t[2])(整)`
    (A22 码 = 9 + 16*1, 层级 1) 当成 **标量** 函数指针放行 ⟹ `5 |> t`(裸数组名) 编译 rc=0 + 运行期 0xC0000005
    (实测; 同输入 `t(5)` **直接调用** 也崩 —— 基准线法)。
    返回: -1 = 非变量 / 非函数指族; 0 = 标量 函数指针 (`整 (*g)(整)`); 1 = 函数指针 数组; 2+ = 更高层。 */
    若 (节 < 0 || 节型别[节] != 节点_变量) 返 -1;
    整 槽Q = 查变量((字*)(节名表 + 节));
    若 (槽Q >= 0 && 槽Q < 65536) { 整 登L = 变量指基[槽Q] - 1; 若 (登L > 0 && 登L % 16 == 9) 返 登L / 16; }
    /* 第九轮: **文件级(全局)变量** `查变量` 查不到 (实测 全局函数指针被误拒) ⟹ 回退 既有 `变量基登()` (含全局回退) */
    整 登G = 变量基登((字*)(节名表 + 节));
    若 (登G <= 0) 返 -1;
    登G = 登G - 1;
    若 (登G % 16 != 9) 返 -1; /* 基类 9 = 函数指 (A22 码表) */
    返 登G / 16;
}
静 整 管道变量可调(整 节) { /* **标量** 函数指针 (层级 0) 或 真 函数名 */
    字 *名 = (字*)(节名表 + 节);
    若 (查函数纯(名) >= 0) 返 1;
    返 (管道变量层级(节) == 0);
}
静 整 管道层级0(整 节) { /* 第 455 站 第十七轮: 表达式 是否 是 **层级 0 的 标量函数指针** ——
    「解引用 一代」得 可调用值 ⟺ 子 是 标量函数指针。
    基准: `(*fp)(5)`=6 ✓(fp 层级 0) · `(*pp)(5)`=6 ✓(pp 层级 1 — L-15 第二十三轮 真接入: 解引用 一代 得 一级函数指针)
          · `(**pp)(5)`=6 ✓(内层 `*pp` 是层级 0) · `(*(t[0]))(5)`=6 ✓(下标元素 是层级 0) · `(*p)(5)` ⟹ 拒(p 非函数指族)。 */
    若 (节 < 0) 返 0;
    整 型 = 节型别[节];
    若 (型 == 节点_变量) 返 (管道变量层级(节) == 0);
    若 (型 == 节点_解引用) { 整 子D2 = 子0[节]; 返 (子D2 >= 0 && 节型别[子D2] == 节点_变量 && 管道变量层级(子D2) == 1); } /* `**pp`: 内层 `*pp` 是层级 0 ⟺ pp 层级 1 */
    若 (型 == 节点_下标) 返 管道可调用(节);      /* 下标元素 本身 是 层级 0 函数指针 */
    若 (型 == 节点_成员 || 型 == 节点_箭头) 返 管道可调用(节);
    返 0;
}
静 整 强制解引宽8 = 0; /* L-15 (第二十四轮): 被调者 保留解引用 时 置 1 —— 解引用宽度 恒为 8 (函数指针), 绕过 `节点_解引用` 各基形状 的宽度推断 (三元 / 2D 下标链 等 不在已知分支 ⟹ 元素 落 1 ⟹ 零扩展字节 → call 半截地址) */
静 整 表达式层级(整 节) { /* L-15 (第 455 站第二十四轮 · skeptic 第十轮 驳回修复): 「节」求值后 的 **函数指针层级** ——
    0 = 层级 0 标量函数指针值 (`整 (*g)(整)`); 1 = 指向函数指针的指针 (`整 (**g)(整)`); 2+ = 更深;
    -1 = 明确 非函数指族 (数据指针/标量); -2 = 判不出 (未知, 调用点 保守 走 真解引用)。
    C 语义 (6.5.3.2): `*X` 作用于 函数指针**值** ⟹ 结果 是 **函数指示符** (不读内存), 值即 X 的值;
    作用于 指向函数指针的 指针 ⟹ 读一次。故 `*X` 的结果层级 = max(0, 层级(X) - 1)。
    ⚠️ 第十二—二十三轮 的 判据 只认 **变量** 子 ⟹ 解引用链 / 成员字段 / 下标元素 落到旧「无条件丢层」
    ⟹ `(**ppp)(5)` / `(*s.pp)(5)` / `(*t[0])(5)` 少一次解引用 → call 到指针自身的地址 → 0xC0000005。 */
    若 (节 < 0) 返 -2;
    整 型 = 节型别[节];
    若 (型 == 节点_变量) { 字 *名录E = (字*)(节名表 + 节);
        若 (变量指深查(名录E) == 1 && 变量元素(名录E) > 8 && 变量指内查(名录E) > 0 && 变量元素(名录E) > 变量指内查(名录E)) 返 -1; /* L-15 根因稿: **指针-到-数组** (数据, 如 `整 (*pm)[2][3]`) —— 其 A22 码 与 标量函数指针 同 (10/层级 0) ⟹ 必须 显式 排除, 否则 `*pm` 被误当 函数指示符 而 不加载 (实测 回归 `feat_zh_param_ptrtoarray_ok.c` A=4 应 12)。判据 与 L26722 的 A71 指针-到-数组 判别 同源。 */
        返 管道变量层级(节); }
    若 (型 == 节点_解引用) { 整 子层一 = 表达式层级(子0[节]); 若 (子层一 == -2) 返 -2; 若 (子层一 == -1) 返 -1; 返 (子层一 >= 1) ? 子层一 - 1 : 0; }
    若 (型 == 节点_取址) { 整 取子二 = 子0[节];
        若 (取子二 >= 0 && 节型别[取子二] == 节点_变量 && 查变量((字*)(节名表 + 取子二)) < 0 && 查函数纯((字*)(节名表 + 取子二)) >= 0) 返 0; /* L-15 (第二十四轮): `&函数名` = **一级函数指针** (与 `节点_调用` 取址分支 同判据)。否则 `(*(&f))(5)` 里 `&f` 被当「未知」→ `*` 走真加载 → 读函数首字节 → 0xC0000005 (P12 实测) */
        整 子层二 = 表达式层级(取子二); 若 (子层二 < 0) 返 -2; 返 子层二 + 1; }
    若 (型 == 节点_下标) { 整 基层一 = 表达式层级(子0[节]); 若 (基层一 == -2) 返 -2; 若 (基层一 == -1) 返 -1; 若 (基层一 <= 0) 返 -1; 返 基层一 - 1; }
    若 (型 == 节点_成员 || 型 == 节点_箭头) { /* 字段: `字段类型序直 == -2` = 函数指族; `反二` = 指针字段星数 (T*=1, T**=2) ⟹ 层级 = 星数 - 1 */
        整 构基一 = 子0[节]; 若 (构基一 < 0) 返 -2;
        整 构序一 = -1;
        若 (节型别[构基一] == 节点_变量) 构序一 = 变量型序((字*)(节名表 + 构基一));
        否 若 (节型别[构基一] == 节点_解引用) { 整 内基一 = 子0[构基一]; 若 (内基一 >= 0 && 节型别[内基一] == 节点_变量) 构序一 = 变量型序((字*)(节名表 + 内基一)); }
        若 (构序一 < 0) 返 -2;
        整 序标一 = 字段序(构序一, (字*)(节名表 + 节));
        若 (序标一 < 0) 返 -2;
        整 星侧一 = 字段函层查(构序一, 序标一); /* L-15 (第二十四轮): 声明期侧表 —— 星数 (0 = 非函数指族) */
        若 (星侧一 > 0) 返 星侧一 - 1; /* 星数 1 → 层级 0 (`整 (*f)(整)`); 星数 2 → 层级 1 (`整 (**pp)(整)`) */
        若 (字段类型序直(构序一, (字*)(节名表 + 节)) != -2) 返 -1;
        返 0; /* 一级 函数指 字段 (走 既有登记路径, 未入侧表 时 的回退) */
    }
    返 -2;
}
静 整 管道可调用(整 节) {
    若 (节 < 0) 返 0;
    整 型 = 节型别[节];
    若 (型 == 节点_变量) 返 管道变量可调(节);
    若 (型 == 节点_取址) { /* L-15 (第 455 站第二十三轮): 码生成点 已 真接入 —— `&函数名` = 函数指针 ⟹ 可调用
        (基准线 `(&f)(5)` 现 = f(5)); `&变量` = 二级指针 ⟹ 拒。判据 与 码生成点 **同源** (防 文案 先于 实现 腐烂)。 */
        整 取验一 = 子0[节];
        返 (取验一 >= 0 && 节型别[取验一] == 节点_变量 && 查变量((字*)(节名表 + 取验一)) < 0 && 查函数纯((字*)(节名表 + 取验一)) >= 0);
    }
    若 (型 == 节点_解引用) { /* L-15 (第二十四轮): `*X` 可调用 ⟺ 层级(X) ∈ {0,1,-2} ——
        层级 0: X 的值 即 函数指针 (`*X` 是函数指示符, 不加载); 层级 1: 真加载 一代;
        -2 (判不出): 与 码生成点 **同源** 保守放行。判据统一走 `表达式层级` (覆盖 解引用链/成员字段/下标元素)。 */
        整 层验二 = 表达式层级(子0[节]);
        返 (层验二 == 0 || 层验二 == 1 || 层验二 == -2);
    }
    若 (型 == 节点_下标) { /* 函数指针 **数组** 的元素 */
        整 基I = 子0[节]; 若 (基I < 0) 返 0;
        整 层数L = 0; 整 游L = 节;
        循环 (游L >= 0 && 节型别[游L] == 节点_下标 && 层数L < 8) { 层数L++; 游L = 子0[游L]; }
        若 (游L >= 0) 基I = 游L; /* 第十五轮: 用 **最内层基** 做字段判断 (原只看 子0 ⟹ L>=2 时基是另一个下标 ⟹ 全拒) */
        /* 第十一轮 (skeptic 第五轮): 基 也 可以 是 **成员/箭头** —— `s.t[0]` / `p->t[0]`
           (结构体里的 函数指针数组 字段)。基准线: `s.t[0](5)` = 6, `p->t[0](5)` = 6 均正常。
           原 判据 只接 `节点_变量` 基 ⟹ 成员基 得 层级 -1 ⟹ 误拒。 */
        若 (节型别[基I] == 节点_成员 || 节型别[基I] == 节点_箭头) {
            整 构基I = 子0[基I]; 若 (构基I < 0) 返 0;
            整 构序I = 变量型序((字*)(节名表 + 构基I)); 若 (构序I < 0) 返 0;
            整 序FI = 字段序(构序I, (字*)(节名表 + 基I)); 若 (序FI < 0) 返 0;
            若 (字段类型序直(构序I, (字*)(节名表 + 基I)) != -2) 返 0; /* 非 函数指针族 */
            /* 第十二轮: **下标层数 == 字段维数** ⟹ 放行。`s.t[0]`(L1/D1) ✓ · `s.t2[0]`(L1/D2) 拒 · `s.t2[0][0]`(L2/D2) ✓ */
            /* 第十五轮 (skeptic L-16b): 维数 D 用 **行宽 < 总尺寸** 推 (不依赖 B7 逐维表 —— 函数指针数组字段不走那条路径):
               `域行数[0]` = 行宽 (L1976 注释「多维索引第一维缩放」), `现捌` = 字段总字节。
               `行宽 < 总字节` ⟹ 至少 2 维。基准: `s.t[0]`(L1,D1)=6 ✓ · `s.t2[0]`(L1,D2) 崩 ⟹ 拒 · `s.t2[0][0]`(L2,D2)=6 ⟹ 放行。 */
            整 维数F = 管道字段维数(构序I, 序FI);
            /* 第二十二轮 (skeptic 第九轮): 标量字段 (维数 0) —— `f[0]` **语义上 == `f`** ⟹
               基准 `s.f[0](5)` = 6 (同一编译器), 且 `5 |> s.f` = 6 亦放行 ⟹ 这里必须**放行常量 0 下标**;
               越界/非常量下标仍 **拒** (基准 `s.f[9](5)` 崩)。 */
            若 (维数F <= 0) {
                若 (层数L == 1) { 整 索N = 子1[节]; 若 (索N >= 0 && 节型别[索N] == 节点_常数 && 节值表[索N] == 0) 返 1; }
                返 0;
            }
            返 (层数L == 维数F); /* size-1(1)/1D(1)/2D(2) ⟹ L == D */
        }
        返 (管道变量层级(基I) == 1); /* 变量基: 层级 1 退化 一层 ⟹ 标量函数指针 */
    }
    若 (型 == 节点_成员 || 型 == 节点_箭头) { /* 成员 函数指针 字段: 既有 `字段类型序直` 的 -2 标记 (A41/T5 权威) */
        整 构基 = 子0[节]; 若 (构基 < 0 || 节型别[构基] != 节点_变量) 返 0;
        整 构序D = 变量型序((字*)(节名表 + 构基)); 若 (构序D < 0) 返 0;
        整 序FD = 字段序(构序D, (字*)(节名表 + 节));
        若 (序FD < 0) 返 0;
        若 (字段类型序直(构序D, (字*)(节名表 + 节)) != -2) 返 0; /* 非 函数指针族 */
        /* 第十三轮 (skeptic L-16a): **裸** 成员/箭头 —— 标量函数指针字段 一律放行;
           数组字段 则按**基准线**区分: 点形式 `s.t` 求值出数组首地址(== 函数地址) ⟹ `s.t(5)`=6 可用 ⟹ 放行;
           箭头形式 `p->t` 求值出成员偏移 ⟹ `p->t(5)` 实测 0xC0000005 ⟹ **拒**。 */
        整 维裸F = 管道字段维数(构序D, 序FD);
        若 (维裸F <= 0) 返 1; /* 标量函数指针字段 ⟹ 放行 */
        /* 第十六轮 (实测): `节值表[成员节点]` = 0 表 `.`, = 1 表 `->`。
           基准线: `s.t(5)` = 6 (点形式求值出数组首地址) ⟹ 放行; `p->t(5)` 崩 ⟹ 拒。 */
        返 (节值表[节] == 0);
    }
    返 0; /* 常数 / 串词 / 二元 / 三元 / 转型 / 增减 … 一律 不可调用 */
}

静 整 管道链(空) { 整 数 = 赋值(); 循环 (词型表[词位] == 满再一) { 词位++; 整 文件 = 赋值(); 若 (!管道可调用(文件)) { 复制字符串(错缓冲, "管道: `|>` 右操作数 必须 可调用 —— 函数名 / 函数指针变量 / 函数指针字段 / 函数指针数组元素 / `(*函数指针)` / `(&函数名)` (a |> f 等价 f(a); ⚠️ `&函数指针变量` 是二级指针, 不可调用; 号合.0 #213/L-15)"); 发错误("A6028", 错缓冲); } 整 呼 = 建节(4); 接子(呼, 数); 接子(呼, 文件); 数 = 呼; } 返 数; } /* 接入 2026-08-27 管道操作符: a |> f = f(a) — 调用 节点 被调者 是最后 接子 (例 4 L11080 反向找), 参数先挂 (修复 2026-08-27: 原 f 先挂 子0 → 被调者 变 a 字面量 → 垃圾函数名崩) */
静 整 赋值级(空) { 解析深++; 若 (解析深 > 350) 原得("表达式递归深度", 350); 整 全又 = 管道链(); 解析深--; 返 全又; } /* 资源护栏 9b (2026-08-28): 深括号/三元/嵌套调用递归护栏 — 实测每层 表达式 链烧 10-20 栈帧, 崩溃点 ~500-800, 护栏 350 安全线下; 超限 A5001 确定性拒绝 (防栈溢出 0xC0000005) */

/* 修复 2026-08-24 t35t: 循环条件顶层逗号表达式 — `} 循环 (prev_ch = p_ch, (p_ch = *++p) != ']')`
   原 赋值级() 对顶层逗号 (非括号内) 只取第一部分 → 条件后半 (p_ch=*++p)!=']' 丢成循环后孤立表达式
   → 做-循环 循环体永不更新 p_ch → wildmatch dowild '[' 字符类死循环.
   逗号列表包成 块: 顺序执行各表达式, 最后表达式结果 = 条件值 (与 遍-步 逗号列表同法). */
静 整 表达式(空) {
    整 数 = 赋值级();
    若 (词型表[词位] == 逗号) {
        整 主酉 = 建节(5); 接子(主酉, 数);
        循环 (词型表[词位] == 逗号) { 词位++; 接子(主酉, 赋值级()); }
        数 = 主酉;
    }
    返 数;
}

/* 局部 数组 花括 初始化: 整数 a[3]={1,2,3}; -> a[0]=1; a[1]=2; a[2]=3; */
静 整 现双[8];  /* 全局多维初始化游标 (修复 2026-08-05) */
静 整 串行 = 0; /* 字符串-初始化 行 计数器: 字符 行 已填 在 顺序 (修复 2026-08-05) */

静 整 满联 = -1; 静 整 栈肆 = -1; 静 整 缺丙 = 0; /* 修复 2026-08-06: 数组初始化器块链（每块 ≤200 赋值, 链子块; 栈肆=首块） */
静 空 序寅(整 赋值) {
    若 (满联 < 0) { 满联 = 建节(5); 栈肆 = 满联; 缺丙 = 0; }
    若 (缺丙 >= 200) { 整 新三 = 建节(5); 接子(满联, 新三); 满联 = 新三; 缺丙 = 0; }
    接子(满联, 赋值);
    缺丙++;
}
静 空 左升(整 发字节, 整 元, 整 *维数表, 整 主己, 整 深度, 整 元素尺寸) {
    /* 递归初始化器: 整数 a[2][3] = {1,2,3,4,5,6} 或 {{1,2,3},{4,5,6}}
       现双[0..主己-1] = 完整多维游标。遇 { 下钻深度, 遇值生成 a[i][j]... = 表达式。
       顶层扁平(无内层 {)用低位进位; 嵌套行递归只推进本层列, 行由外层 左花 推进。
       本函数自管 { } 配平 (修复 2026-08-05) */
    若 (深度 == 0) {
        尾阵触((字*)(节名表 + 元), -1); /* A78 (2026-09-14): 左升 = 整数组 完整 初始化器 (含 memset 零填) ⇒ 元素级 追踪 整体 放行. 收口 于 此: 原 只在 L8665 路径 两处 (L8777/L8801) 显式 尾阵触, 而 内联定义 (L8887) / 已注册标签 (L9151) 两条 平行 路径 漏 ⇒ 函数内 内联定义 结构体数组 花括初始化 后 常数下标 读 误 A4001 (git commit.c bufs; 最小复现 b3/e2) */
        满联 = -1; 栈肆 = -1; 缺丙 = 0;
        遍 (整 计 = 0; 计 < 主己; 计++) 现双[计] = 0; /* A75g (2026-09-14): 顶层 入口 重置 游标 —— 原 只在 「设计器 [序标]」分支 重置 现双;
           而 「嵌套 行 模式」(新复=1, 即 初始化器 是 {{...},{...}}) 的 进位 走 `否 { 现双[深度]++ }` —— **不 回绕** ⇒ 该 数组 用完 后 现双 残留 (例 2 个 元素 后 = 2)
           ⇒ 污染 **下一个** 数组: 从 现双[0]=1 开始 ⇒ 生成 arr[1] / arr[2] ⇒ **A2001 假 越界**.
           实测 (x1): `struct {int a,b;} aa[] = { {1,2} };` + `struct q {int a,b;} af[2] = { {1,2},{3,4} };`
             探针: af 推断 正确 (数=2) 但 叶 探针 现双0 = **1** / **2** ⇒ af[2] 越界. 旧编译器 同样 失败 (既存). */
        /* 修复 2026-08-23 t49f: C99 聚合 初始化 zeroes unlisted 元素 -- 值布
           做过 此 遍 结构体 but 左升 做过 非; `结构体 常式 *源[9] = { 空, }`
           左 源[1..8] 作为 栈 垃圾 -> 版本库 状态 已崩 (oneway_diff 树=源[1]=垃圾).
           内存设置 整体 数组 首; 显式 initializers 以下 覆盖. */
        整 宽甲 = 建节(11); 接子(宽甲, 元);
        整 素又 = 建节(4);
        整 旁降 = 建节(1); 复制内存((字*)(节名表 + 旁降), "memset", 7);
        接子(素又, 宽甲);
        整 长柒 = 建节(0); 节值表[长柒] = 0; 接子(素又, 长柒);
        整 半三 = 元素尺寸;
        遍 (整 旧辛一 = 0; 旧辛一 < 主己; 旧辛一++) 半三 *= 维数表[旧辛一];
        整 旧附 = 建节(0); 节值表[旧附] = 半三; 接子(素又, 旧附);
        接子(素又, 旁降);
        序寅(素又);
    }
    若 (词型表[词位] == 左花) 词位++; /* 本层 '{' */
    整 新复 = (词型表[词位] == 左花); /* 本层是否为嵌套行模式 */
    循环 (词型表[词位] != 右花) {
        若 (词型表[词位] == 逗号 || 词型表[词位] == 分号) { 词位++; 续; }
        若 (词型表[词位] == 右花) 断;
        若 (词型表[词位] == 左方) { /* 阶段 2: 指定 初始化 [序标] = 表达式 (修复 2026-08-11) */
            整 首进一[8]; 整 链从 = 0;
            循环 (词型表[词位] == 左方) { /* 支持多维 [i][j] 设计器 */
                词位++; /* [ */
                整 计十 = 赋值级();
                整 尾属 = (计十 > 0 && 节型别[计十] == 节点_常数) ? 节值表[计十] : -1; /* 常量下标: 赋值级() 返回 建节(0) 节点, 节值表 存值 */
                若 (尾属 < 0) { 循环 (词型表[词位] != 逗号 && 词型表[词位] != 右花 && 词型表[词位] != 词终) 词位++; 续; }
                若 (词型表[词位] == 右方) 词位++; /* ] */
                若 (链从 < 8) 首进一[链从++] = 尾属;
            }
            若 (词型表[词位] == 赋号) 词位++; /* = */
            /* 跳到指定下标: 顶层扁平 → 现双[0..链从-1]=首进一 (其余维清零); 嵌套行 → 本层 深度 */
            若 (深度 == 0) {
                遍 (整 计 = 0; 计 < 主己; 计++) 现双[计] = 0;
                遍 (整 计 = 0; 计 < 链从; 计++) 现双[计] = 首进一[计];
            } 否 {
                现双[深度] = 首进一[0];
            }
            若 (词型表[词位] == 句点 && 词型表[词位 + 1] == 词变量) { /* A75c (2026-09-14): [序标].字段 = 值 — C99 6.7.9 设计器 成员链
                原 无 分支 → 词位 停 在 `.` → 落 叶 赋值级() 不推进 → 死循环 (AST 溢出 1048576);
                修: 沿 已算好的 现双 下标链 再 接 一 层 成员 节点 (15), 然后 按 叶 同样 推进 现双 */
                词位++; /* . */
                字 左名[64]; 复制字符串(左名, 词名表[词位]); 词位++;
                若 (词型表[词位] == 赋号) 词位++; /* = */
                整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), (字*)(节名表 + 元), 32);
                整 堆零 = 标识序;
                遍 (整 计 = 0; 计 < 主己; 计++) {
                    整 实伴 = 建节(14); 接子(实伴, 堆零);
                    整 序标 = 建节(0); 节值表[序标] = 现双[计];
                    接子(实伴, 序标);
                    堆零 = 实伴;
                }
                整 左叶 = 建节(15); 接子(左叶, 堆零); 复制内存((字*)(节名表 + 左叶), 左名, 64);
                整 赋值 = 建节(10); 接子(赋值, 左叶); 接子(赋值, 赋值级());
                序寅(赋值);
                若 (深度 == 0 && !新复) { 遍 (整 计 = 主己 - 1; 计 >= 0; 计--) { 现双[计]++; 若 (现双[计] < 维数表[计]) 断; 现双[计] = 0; } } 否 { 现双[深度]++; } /* 与 叶 同样 推进 */
                续;
            }
        }
        若 (词型表[词位] == 左花 && 深度 < 主己 - 1) { /* 嵌套 行 { ... } */
            现双[深度 + 1] = 0; /* 复位 该 子 cursor (修复: 下一 行 continued 自 该 前 行's 列) */
            左升(发字节, 元, 维数表, 主己, 深度 + 1, 元素尺寸); /* 递归开头统一吃 '{' (修复 2026-08-05: 左花 亦 词位++'d → 双精度-ate 于 3D) */
            现双[深度]++; /* 行推进 */
            续;
        }
        若 (词型表[词位] == 串词 && 元素尺寸 <= 1) { /* 字符 行 = 字符串: 字符 s[2][4] = {"计八","cd"} — 拷贝 该 字符串 字节 入 该 行 (修复 2026-08-05: 曾 已存 作为 a 字符串 地址 → 垃圾); 修复 2026-08-13: 指针数组 字符 *数组[] = {"A"} 元素尺寸=8 → 走 叶 存地址 (原 拷贝 字节 → 元素=字符 → 解引用崩溃) */
            整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), (字*)(节名表 + 元), 32);
            字 *单细一 = 串表[词值表[词位]]; 词位++;
            整 行尺寸 = 维数表[主己 - 1] ? 维数表[主己 - 1] : 1;
            /* 行号 → 前 主己-1 维索引（从次内层展开，独立于嵌套 深度） */
            整 段浅 = 串行;
            整 池薄[8];
            遍 (整 计 = 主己 - 2; 计 >= 0; 计--) { 池薄[计] = 段浅 % (维数表[计] ? 维数表[计] : 1); 段浅 /= (维数表[计] ? 维数表[计] : 1); }
            整 堆零 = 标识序;
            遍 (整 计 = 0; 计 < 主己 - 1; 计++) {
                整 实伴 = 建节(14); 接子(实伴, 堆零);
                整 序标 = 建节(0); 节值表[序标] = 池薄[计];
                接子(实伴, 序标);
                堆零 = 实伴;
            }
            整 长度一 = (整)取字长(单细一);
            若 (长度一 > 行尺寸) 长度一 = 行尺寸;
            遍 (整 键 = 0; 键 < 长度一; 键++) {
                整 实伴 = 建节(14); 接子(实伴, 堆零);
                整 序标 = 建节(0); 节值表[序标] = 键;
                接子(实伴, 序标);
                整 赋值 = 建节(10); 接子(赋值, 实伴);
                整 计数一 = 建节(0); 节值表[计数一] = (无 字)单细一[键];
                接子(赋值, 计数一);
                序寅(赋值);
            }
            若 (长度一 < 行尺寸) { /* 空字符-终止 (C: 该 其余 的 该 字符 行 是 已清零) */
                整 实伴 = 建节(14); 接子(实伴, 堆零);
                整 序标 = 建节(0); 节值表[序标] = 长度一;
                接子(实伴, 序标);
                整 赋值 = 建节(10); 接子(赋值, 实伴);
                整 计数一 = 建节(0); 节值表[计数一] = 0;
                接子(赋值, 计数一);
                序寅(赋值);
            }
            串行++;
            续;
        }
        /* 叶: a[现双[0]][现双[1]]...[现双[主己-1]] = 表达式 */
        若 (词型表[词位] == 左花) { /* 结构体 元素 初始化 { ... }: 解析 入 元素 字段 (修复 2026-08-15: commands[] 全局 数组 的 结构体 曾 已跳 -> get_builtin 已找到 nothing) */
            整 构序 = 变量型序((字*)(节名表 + 元)); /* 局部 结构体 数组 现在 take 此 路径 亦 (修复 2026-08-16: help.c cmd_version 局部 options[] 曾 已跳 -> opts->argh 垃圾 -> strcspn(空-ish) 崩溃) */
            若 (构序 >= 0) {
                整 副系 = 建节(1); 复制内存((字*)(节名表 + 副系), (字*)(节名表 + 元), 32);
                整 末戌 = 副系;
                遍 (整 计 = 0; 计 < 主己; 计++) {
                    整 下重一 = 建节(14); 接子(下重一, 末戌);
                    整 序标二 = 建节(0); 节值表[序标二] = 现双[计];
                    接子(下重一, 序标二);
                    末戌 = 下重一;
                }
                词位++; /* 跳过 { */
                整 减法 = 值布(构序, 末戌);
                若 (减法 >= 0) { 遍 (整 键 = 0; 键 < 256; 键++) { 整 字符 = 取子(减法, 键); 若 (字符 > 0) 序寅(字符); } }
                若 (词型表[词位] == 右花) 词位++; /* 关闭 } */
                若 (深度 == 0 && !新复) { 遍 (整 计 = 主己 - 1; 计 >= 0; 计--) { 现双[计]++; 若 (现双[计] < 维数表[计]) 断; 现双[计] = 0; } } 否 { 现双[深度]++; }
                续;
            }
            整 元二 = 1; 词位++;
            循环 (词位 < 词容量 && 元二 > 0) { 若 (词型表[词位] == 左花) 元二++; 否 若 (词型表[词位] == 右花) { 元二--; 若 (元二 <= 0) { 词位++; 断; } } 词位++; }
            若 (深度 == 0 && !新复) { 遍 (整 计 = 主己 - 1; 计 >= 0; 计--) { 现双[计]++; 若 (现双[计] < 维数表[计]) 断; 现双[计] = 0; } } 否 { 现双[深度]++; }
            续;
        }
        整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), (字*)(节名表 + 元), 32);
        整 堆零 = 标识序;
        遍 (整 计 = 0; 计 < 主己; 计++) {
            整 实伴 = 建节(14); 接子(实伴, 堆零);
            整 序标 = 建节(0); 节值表[序标] = 现双[计];
            接子(实伴, 序标);
            堆零 = 实伴;
        }
        整 末凶三 = 赋值级(); 直丁(末凶三, (字*)(节名表 + 元)); 整 赋值 = 建节(10); 接子(赋值, 堆零); 接子(赋值, 末凶三);
        序寅(赋值);
        /* 推进: 顶-级 flat → little-端序 进位; 嵌套 行 → 此 行's 列 */
        若 (深度 == 0 && !新复) {
            遍 (整 计 = 主己 - 1; 计 >= 0; 计--) {
                现双[计]++;
                若 (现双[计] < 维数表[计]) 断;
                现双[计] = 0;
            }
        } 否 {
            现双[深度]++;
        }
    }
    若 (词型表[词位] == 右花) 词位++; /* 本层 '}' */
    若 (深度 == 0 && 栈肆 >= 0) 接子(发字节, 栈肆); /* 修复 2026-08-06: 根块挂到顶层块 */
}

/* C99 复合 字面量: (T){ 初始化 } — 匿名自动存储期临时对象 (修复 2026-08-11 阶段 2-3).
   转型 分支在 ')' 后见 左花 时调用。注册 目次<N> 临时变量, 复用 值布/左升 填充,
   初始化块挂到 虚三 (块() 当前块), 返回临时对象的地址节点 (建节(1)). */
静 整 新集一 = 0; /* 2026-08-28 可重入修复: 复合字面量临时名计数器 — 终子 每编译重置 */
静 整 余陆 = 0; /* 2026-08-28 可重入修复: 遍-范围 临时名计数器 — 终子 每编译重置 (原函数内静态跨编译累积 → 第 2 次编译临时名漂移) */
静 整 行巳 = 0; /* 2026-08-28 可重入修复: 错 联合 临时名计数器 — 终子 每编译重置 */
静 整 存伍(整 是否构标, 整 构序, 整 初柒, 整 数组数一, 整 数组元素尺寸) {
    字 变节[64]; 内存设置(变节, 0, 64); 格式化限长(变节, 32, "_cl%d", 新集一++); /* 2026-08-28 编译DAG: 内存设置 清零 — 格式化限长 尾部不置零, 复制内存(节名表,变节,32) 拷栈垃圾 → 节名表 哈希非确定 (功能无害, 过程级哈希须确定性) */
    整 发字节 = 建节(5); /* 块: 声明 + 初始化 assigns */
    整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 变节, 32); /* 声明 节点 */
    整 右丙 = 建节(5); /* 初始化 赋值 (挂到 虚三) */
    若 (初柒) {
