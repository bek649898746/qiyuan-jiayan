                若 (词型表[词位] == 或) { 词位++; 值二 = 宽捌(); } /* #132 or 模式: v1 | v2 (| = OR token 47) */
                若 (词型表[词位] == 顺轮 && (!比较字符串(词名表[词位], "if") || !比较字符串(词名表[词位], "若"))) { 词位++; 直肆 = 表达式(); } /* #133 守卫模式: v 若 cond (若 词法映射为 if/IK) */
                /* 2026-08-28 P2 #144 区间模式: 对照 范围 lo 到 hi: 结果 — 值域匹配 (sw >= lo && sw <= hi), 须在 : 前解析边界 */
                整 暂散 = -1, 行劣 = -1;
                若 (短进 >= 0 && 节型表[短进] == 1 && !比较字符串((字*)(节名表 + 短进), "范围")) {
                    暂散 = 表达式(); 若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "到")) 词位++; 行劣 = 表达式();
                }
                若 (词型表[词位] == 冒号) 词位++; /* : */
                整 结果 = 表达式();
                正戌[左陆] = 暂散; 值深[左陆] = 行劣;
                /* 2026-08-28 P1 #142 冗余/不可达模式检查: 常量模式与前面**无守卫**臂重复 → 后臂不可达 [ERR] (有守卫前臂可能失败, 不构成冗余) */
                若 (短进 >= 0 && 节型表[短进] == 0) { 整 字值 = 节值表[短进]; 遍 (整 乙 = 0; 乙 < 左陆; 乙++) { 若 (域退[乙] < 0 && ((池对[乙] >= 0 && 节型表[池对[乙]] == 0 && 节值表[池对[乙]] == 字值) || (链高[乙] >= 0 && 节型表[链高[乙]] == 0 && 节值表[链高[乙]] == 字值))) { 输出到文件(错误流, "[ERR] 冗余模式: 值 #%d 已被前臂匹配 (不可达分支, v3.0 #142)\n", 字值); 退出(1); } } }
                若 (值二 >= 0 && 节型表[值二] == 0) { 整 素陆 = 节值表[值二]; 遍 (整 乙 = 0; 乙 < 左陆; 乙++) { 若 (域退[乙] < 0 && ((池对[乙] >= 0 && 节型表[池对[乙]] == 0 && 节值表[池对[乙]] == 素陆) || (链高[乙] >= 0 && 节型表[链高[乙]] == 0 && 节值表[链高[乙]] == 素陆))) { 输出到文件(错误流, "[ERR] 冗余模式: 值 #%d 已被前臂匹配 (不可达分支, v3.0 #142)\n", 素陆); 退出(1); } } }
