                若 (维数表 == 0 && 符癸 == 0 && 词型表[词位] == 赋号 && 词型表[词位 + 1] == 左花) {
                    整 主戌 = 词位;
                    词位 += 2; /* 跳过 '=' '{' */
                    整 数 = 1, 深度 = 0, 前辰 = 0;
                    
                    循环 (词位 < 词容量 && !(词型表[词位] == 右花 && 深度 == 0)) {
                        若 (词型表[词位] == 左花 || 词型表[词位] == 左括 || 词型表[词位] == 左方) 深度++;
                        否 若 (词型表[词位] == 右花 || 词型表[词位] == 右括 || 词型表[词位] == 右方) { 深度--; 若 (深度 == 0) 前辰 = 0; } /* P0-11-B (2026-09-14) */
                        否 若 (词型表[词位] == 逗号 && 深度 == 0) { 数++; 前辰 = 1; }
                        否 若 (深度 == 0) 前辰 = 0; /* 修复 2026-08-19: C99 尾逗号 — 局部 静态 `字符 *数组[] = {"A","B",}` 原算成 3 元素 → 尺寸=24 → ARRAY_SIZE=3 → is_special_ref special_refs[2] 越界 (版本库 初始化 比较字符串 崩); 与全局路径 前辰 对齐 */
                        
                        词位++;
                    }
