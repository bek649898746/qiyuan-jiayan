    变量表[变量数].可空值标 = 0; 变量表[变量数].变可空.tag = 可空值_有值;
    若 (此可空二) { 变量表[变量数].可空值标 = 2; 变量表[变量数].变可空.tag = 可空值_无值; } /* H1b: 分离 tag 槽 类 (同 H1a 长整) */
    若 (数[0] != '_') { 尾登记(数, 净丙, 变量数); } /* D12R451: 变浮 有 就绪未标 缺 尾登记 ⟹ 双 未初始化读 漏; 同 余乙 不加 序集 守卫 */
