            循环 (段[计] && !(段[计] == '*' && 段[计 + 1] == '/')) { 若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 出 = *出指; } 出[(*丙)++] = 段[计++]; }
            若 (段[计]) { 若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 出 = *出指; } 出[(*丙)++] = 段[计++]; 若 (段[计]) { 若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 出 = *出指; } 出[(*丙)++] = 段[计++]; } }
            续;
        }
        若 (!入串 && 段[计] == '/' && 段[计 + 1] == '/') { 循环 (段[计] && 段[计] != '\n') { 若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 出 = *出指; } 出[(*丙)++] = 段[计++]; } 续; }
        若 (入串) {
            若 (段[计] == '\n' && !帧再(段, 计)) 入串 = 0; /* fix 2026-08-15: in_str 失步恢复 — 真实 C 字符串不能含裸换行, 裸换行处复位防 strbuf_reset 被误当串内不展开 */
            若 (*丙 + 1 > *容量) { *容量 *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +4096 — bump allocator realloc 泄漏旧缓冲, 小步进在 sequencer.c 大宏展开时平方级爆堆 */; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] OOM realloc\n"); 退出(1); } 出 = *出指; }
            出[(*丙)++] = 段[计++];
            续;
        }
        若 (判字母数字((无 字)段[计]) || 段[计] == '_' || (无 字)段[计] >= 0x80) { /* fix 2026-08-28 #96: 中文宏名 (泛型 最大值) 也扫描 */
            字 名存[64]; 整 名序 = 0;
