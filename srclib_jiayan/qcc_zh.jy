                } 否 若 (短叁) {
                    若 (条件编译数 > 0) { 条件编译数--; 外系 = 条件编译数 > 0 ? !序对[条件编译数-1] : 0; } /* fix 2026-08-13 Phase3: 同 lexer endif — 嵌套假分支恢复用 !taken 而非 parent */
                }
                循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') 计 += 2; 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') 计 += 3; 否 计++; } /* fix 2026-08-26 lua: 续行感知 — 假分支 #error 反斜杠续行引号平衡 (luaconf.h) */
                续;
            }
            若 (外系) { /* 假分支: #define/#undef 一律不收 */
                循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') 计 += 2; 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') 计 += 3; 否 计++; } /* fix 2026-08-26 lua: 续行感知 (同上) */
                续;
            }
            若 (高属) { /* fix 2026-08-07: 顺序定义表删除 (collect 阶段 #undef 生效) */
                整 寻 = 元 + 5;
                循环 (串值[寻] == ' ' || 串值[寻] == '\t') 寻++;
                字 存申[64]; 整 逆肆 = 0;
                循环 (判字母数字((无 字)串值[寻]) || 串值[寻] == '_') { 若 (逆肆 < 63) 存申[逆肆++] = 串值[寻]; 寻++; }
                存申[逆肆] = 0;
                若 (逆肆 > 0) { 缺得(存申); 整 终低 = -1; 遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (!比较字符串(函数宏表[键].名, 存申)) { 终低 = 键; 断; } 若 (终低 >= 0 && 余简[终低] && 函数宏表[终低].体[0] == '{') 半从(存申); } /* fix 2026-08-15: 多行 do 语句宏保留 (color.c OUT 定义后使用再 #undef); 多行 { 初始化宏仍删 (userdiff.c PATTERNS/IPATTERN timeout) */
                循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') 计 += 2; 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') 计 += 3; 否 计++; } /* fix 2026-08-26 lua: 续行感知 (同上) */
                续;
            }
            若 (内戊) {
            { 字 旁又[64]; 整 度戌 = 0; 毛简(串值 + 计, 旁又, &度戌); 若 (旁又[0]) 首丙一(旁又, 度戌); } /* fix 2026-08-07: 任何 #define 都记入顺序表 (含数值, #if MODE==2 用真值) */
            整 指 = 元 + (串值[元] == 'd' ? 6 : 9);
