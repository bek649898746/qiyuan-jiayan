    若 (首亥[指] < 0) { 首亥[指] = 字符; 返; }
    若 (现弊[指] < 0) { 现弊[指] = 字符; 返; }
    若 (间得[指] < 0) { 间得[指] = 字符; 返; }
    若 (缺粗[指] < 0) { 缺粗[指] = 字符; 返; }
    若 (空凶[指] < 0) { 空凶[指] = 字符; 返; }
    若 (整集一[指] < 0) { 整集一[指] = 字符; 返; }
    若 (中聚[指] < 0) { 中聚[指] = 字符; 返; }
    若 (短得[指] < 0) { 短得[指] = 字符; 返; }
    若 (实序[指] < 0) { 实序[指] = 字符; 返; }
    若 (主聚[指] < 0) { 主聚[指] = 字符; 返; }
    若 (标寅[指] < 0) { 标寅[指] = 字符; 返; }
    若 (栈凶二[指] < 0) { 栈凶二[指] = 字符; 返; }
    若 (存丁[指] < 0) { 存丁[指] = 字符; 返; }
    若 (净双[指] < 0) { 净双[指] = 字符; 返; }
    若 (后拾[指] < 0) { 后拾[指] = 字符; 返; }
    若 (指 == 副丑) 返; /* 根节点: 子节点冗余 — 函数全在 函数定义表 扁平列表, 超 256 静默丢弃无害 (修复 2026-08-18: 乙层补丁 接子 硬上限误伤自举 — 编译器 自身 283 函数 > 256 子槽; 隔伍一 从未被读) */
    遍 (整 短丑 = 0; 短丑 < 256; 短丑++) 若 (顺分[短丑][指] < 0) { 顺分[短丑][指] = 字符; 返; } /* 修复 2026-08-18: 扩展子槽 n256..n511 — 大型函数体 > 256 语句不再截断 (原静默丢弃 → 编译产物缺语句, 版本库 大函数错乱) */
    若 (节链[指] < 0) 节链[指] = 建节(5); /* 512 子槽满 → 溢出链块 (修复 2026-08-18: 版本库 大函数体 > 512 语句, 无界链式扩展 — 序列器.c do_pick_commit 级函数) */
    接子(节链[指], 字符); /* 递归挂到链块 (链块满再链) */
}

静 整 虚三 = -1; /* 当前 块() 块 (复合 字面量 初始化挂这里, 修复 2026-08-11) */
静 整 存伍(整 是否构标, 整 构序, 整 初柒, 整 数组数一, 整 数组元素尺寸);
静 整 原级(空);
静 整 三元(空); /* A69 (2026-09-14): 前置声明 —— `大小(<表达式>)` 前瞻 需要 **完整** 表达式 解析; `原级` 只 管 高位 (不 处理 二元 `+` `*` 等) ⟹ 原 用 它 时 `大小(x+1)` 只 消费 `x`, `+1` 残留 到 外层 → 整个 被 拼成 `4+1` = 5 */
静 整 块(空); /* 语句表达式 ({ ... }) 复用块解析 (修复 2026-08-25 步十九) */
静 整 语句(空);
静 整 赋值级(空);
静 整 常量表达式求值(整 *数值); /* 前向: 接入 2026-08-27 编译期(表达式) 需在 原级() 前声明 (原 前向 在 L6589 晚于 原级) */

/* R1 值级侧表定义 (2026-09-03 虾米): 借用检查/impl Trait "落IR"写入 (L5145 总子/L8882 源粗/L15632 空对)
   引用本定义 — 原预埋区尾部定义 (L22798+) 使写入悬空 (qcc 隐式注册独立符号, 探针实证);
   移前为正式定义, 预埋区同名行删除 (qcc 同名静态数组保留首定义容量, 实验实证) */
#define 首吉 1000000  /* 预埋初始值: 激活前按编译 版本库 全量最坏规模实测校准 (2026-08-25 启元审计) */
静 整 总子[首吉];      /* 所有权状态机: 0=普通 1=移动后 2=不可变借用 3=可变借用 (整数 一次给够, 对齐逆向定律库 §1) */
静 整 源粗[首吉];   /* 生命周期 域编号: 0=函数级 1..N=显式 'a 域 */
静 整 空对[首吉];         /* 类型变量编号: 0=非泛型 >0=第 N 个 */
静 整 计肆一[首吉];  /* R1-3: 和类型判别值侧表 (按 直寅 判别登记 全局序 记变体判别值; 链平 全编译累计 无每类型清零; 写点 L11442) */

/* R1-B 锤A (2026-09-04): 判别 类型化载荷 布局侧表 — 荷布/变载 自预埋区移前正式定义 (仿 R1-1 教训:
   原预埋区尾部定义 (L23xxx) 使写入悬空隐式符号; 判载名 并行存 载荷字段名 (依据 载荷绑定 读端用) */
#define 荷布容 4096
typedef 构 { 整 变体数; 整 判别偏; 整 载荷序; 整 总尺寸; } 荷布录;
typedef 构 { 整 变体; 整 类型序; 整 域偏; 整 载荷尺寸; 整 载荷元素; 整 指层; 整 载荷构序; } 荷栽目; /* 第 179 站 (#97 v2): +载荷构序 (指向 结构体 的 指针载荷 用) */ /* 第 178 站 (#97 v2 指针载荷): +载荷元素(指向元素尺寸) / +指层(指针层级) */
静 荷布录 荷布[荷布容]; 静 荷栽目 变载[荷布容 * 8]; 静 整 荷布数;
#define 判载名容 8192
静 字 判载名[判载名容][64];
静 整 判载数;

/* #10 借用检查器本体 读端 NLL 引擎 (2026-09-04): 引用流借用检查 — 真 last-use 数据流
   设计: 变量态机语义 = 总子 预埋 (0普通/1移动/2不可变借用/3可变借用), 每变量索引.
   引用绑定 r=&x (type10 lhs=名 rhs=&名) → x 进入借用区, 区活到 r 对该绑定的末次使用;
   借用区内写 x → A3001 (与解析期 双繁 直接借用检查互补, 管引用外流场景). */
静 整 借绑r[4096]; 静 整 借绑x[4096]; 静 整 借绑起[4096]; 静 整 借绑止[4096]; 静 整 借绑深[4096]; 静 整 借绑数 = 0;   /* 引用绑定表: r变序, x变序, 起止位置, 绑定块深 (CFG 保守 2026-09-05: 分支内重绑/放还 不结算 顺序外层绑定) */
静 整 借深 = 0; /* 借检采 当前块深 (型8若/9循环/22三元/24做 子节点 +1; CFG 保守合并) */
静 整 借界B起[256]; 静 整 借界B终[256]; 静 整 借界C起[256]; 静 整 借界C终[256]; 静 整 借界深[256]; 静 整 借界数 = 0; /* if 双路事件区间 (CFG 2026-09-05): then 区间 [B起,B终) else [C起,C终), 借界深=if 自身块深 — 双路覆盖结算 (配对要求 乙直接于臂 深==借界深+1); C起=-1 无 else */
静 整 借位含(整 起, 整 终, 整 位) { 返 (起 >= 0 && 位 >= 起 && 位 < 终); } /* 事件位在区间内 */
静 整 借用r[8192]; 静 整 借用位[8192]; 静 整 借用数 = 0;                                       /* r 的每次使用位置 */
静 整 借写变[4096]; 静 整 借写位[4096]; 静 整 借写数 = 0;                                        /* 写事件 */
静 整 借位 = 0;
静 整 借模式[65536]; /* #10 NLL 引擎激活标记: 本函数出现 借用/可变借用/放还 语句 = 借用语义函数 (纯 C 别名不激活, csmith 兼容) */
静 空 借绑加(整 r, 整 x, 整 起, 整 深) { 若 (借绑数 < 4080) { 借绑r[借绑数] = r; 借绑x[借绑数] = x; 借绑起[借绑数] = 起; 借绑止[借绑数] = -1; 借绑深[借绑数] = 深; 借绑数++; } }
静 空 借用加(整 r, 整 位) { 若 (借用数 < 8180) { 借用r[借用数] = r; 借用位[借用数] = 位; 借用数++; } }
静 空 借写加(整 v, 整 位) { 若 (借写数 < 4080) { 借写变[借写数] = v; 借写位[借写数] = 位; 借写数++; } }
静 整 借传dst[4096]; 静 整 借传src[4096]; 静 整 借传位[4096]; 静 整 借传数 = 0;
静 空 借传加(整 d, 整 s, 整 位) { 若 (借传数 < 4080) { 借传dst[借传数] = d; 借传src[借传数] = s; 借传位[借传数] = 位; 借传数++; } } /* v3 引用别名链: r2=r1 传播事件 */
静 整 借返r[4096]; 静 整 借返位[4096]; 静 整 借返数 = 0;
静 空 借返加(整 r, 整 位) { 若 (借返数 < 4080) { 借返r[借返数] = r; 借返位[借返数] = 位; 借返数++; } } /* v4 返回引用事件 */
静 整 借点x[4096]; 静 整 借点位[4096]; 静 整 借点数 = 0; /* v5 借用点名 (型28 借用/可变借用): 绑定过滤 */
静 空 借点加(整 x, 整 位) { 若 (借点数 < 4080) { 借点x[借点数] = x; 借点位[借点数] = 位; 借点数++; } }
静 整 借还x[4096]; 静 整 借还位[4096]; 静 整 借还数 = 0; /* v5 放还 (型28 放还): 解绑 */
静 空 借还加(整 x, 整 位) { 若 (借还数 < 4080) { 借还x[借还数] = x; 借还位[借还数] = 位; 借还数++; } }
/* 预扫描: 引用绑定与写/用事件由 借检采(整 数, 整 语境) DFS 采集; 语境 1=赋值左值子树 2=取址操作数 0=值读 */
静 整 借查名(常 字 *名) { 遍 (整 计 = 变量总数() - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 名)) 返 计; 返 -1; } /* 全表反向查名: 最近声明优先 (局部遮蔽全局); 解析期 查变量 只搜当前函数区间 → 全局不可达 */
静 空 借检采(整 数, 整 语境);
静 空 借检扫绑定(整 数) {
    整 r = -1, x = -1;
    整 左 = 子0[数];
    若 (左 >= 0 && 节型别[左] == 节点_变量) { r = 借查名((字*)(节名表 + 左)); } /* lhs 直接名 */
    若 (r >= 0) { 借写加(r, 借位++); /* 写/重绑 r: 旧绑定在分析期按止点结算 */ }
    /* rhs: &x 直接 (type11 over name) — 引用绑定; rhs 引用变量拷贝 r2=r1 — 别名链传播 (v3); 否则 普通值读 */
    整 乙 = 子1[数];
    若 (乙 >= 0 && 节型别[乙] == 节点_取址 && 子0[乙] >= 0 && 节型表[子0[乙]] == 1) {
        整 内 = 借查名((字*)(节名表 + 子0[乙]));
        若 (内 >= 0) { 若 (r >= 0) 借绑加(r, 内, 借位, 借深); 借位++; }
    } 否 若 (乙 >= 0 && 节型别[乙] == 节点_变量 && r >= 0) { /* r2 = r1: 传播 r1 活跃绑定 */
        整 源变 = 借查名((字*)(节名表 + 乙));
        若 (源变 >= 0) { 借传加(r, 源变, 借位); 借位++; }
        借检采(乙, 0); /* r1 值读 = r1 的一次使用 */
    } 否 若 (乙 >= 0) { 借检采(乙, 0); }
}
静 空 借检采(整 数, 整 语境) {
    若 (数 < 0) 返;
    整 型 = 节型表[数];
    若 (型 == 1) { /* 名 */
        若 (语境 == 0) { 整 v = 借查名((字*)(节名表 + 数)); 若 (v >= 0) 借用加(v, 借位++); }
        返;
    }
    若 (型 == 28) { /* 借语义语句节点 v5: 节值表 1=放还 2=借用 3=可变借用; 子0=type1 目标名 — 本体直读 */
        整 名 = 子0[数];
        若 (名 >= 0 && 节型别[名] == 节点_变量) {
            整 v = 借查名((字*)(节名表 + 名));
            若 (v >= 0) {
                整 码 = 节值表[数];
                若 (码 == 1) 借还加(v, 借位);
                若 (码 == 2 || 码 == 3) 借点加(v, 借位);
                借位++;
            }
        }
        返;
    }
    若 (型 == 6) { /* 返回: 简单引用变量返回 → 借返事件 (悬垂检查); 值也记一次使用; 非 name 走通用遍历 */
        整 值 = 子0[数];
        若 (值 >= 0 && 节型别[值] == 节点_变量) { 整 v = 借查名((字*)(节名表 + 值)); 若 (v >= 0) { 借用加(v, 借位); 借返加(v, 借位); 借位++; } 返; }
    }
    若 (型 == 11) { 借检采(子0[数], 2); 返; } /* &x — x 非读 */
    若 (型 == 10) { 借检扫绑定(数); 返; }      /* 赋值: 绑定/写 + rhs */
    若 (型 == 12) { 借检采(子0[数], 0); 返; }  /* *p 解引用 = 读 p (v1 写穿*p 不追踪) */
    若 (型 == 14 || 型 == 15) { /* a[i] / s.f 链: 基读写, 其余子 值读 */
        借检采(子0[数], 语境);
        若 (语境 == 0 && 型 == 14 && 子1[数] >= 0) 借检采(子1[数], 0);
        返;
    }
    /* 其余: 全部子节点 (取子 512 槽 + 节链 溢出链) 按 值读 采集 (覆盖 语句序列/调用实参/若/循环 等) — 分支/循环节点 子节点在 更深块 采集 (CFG 保守 2026-09-05) */
    若 (型 == 8) { /* if: 子0=条件(顺序必经) 子1=then 子2=else(可选) — 双路事件区间登记 (CFG 双路覆盖结算 2026-09-05) */
        借检采(子0[数], 0); /* 条件必经 (顺序深度) */
        { 整 界甲 = 借位; 借深++; 若 (取子(数, 1) > 0) 借检采(取子(数, 1), 0); 借深--;
          整 界乙 = 借位; 借深++; 整 界丙 = -1; 整 界丁 = -1; 若 (取子(数, 2) > 0) { 界丙 = 借位; 借检采(取子(数, 2), 0); 界丁 = 借位; } 借深--;
          若 (借界数 < 250) { 借界B起[借界数] = 界甲; 借界B终[借界数] = 界乙; 借界C起[借界数] = 界丙; 借界C终[借界数] = 界丁; 借界深[借界数] = 借深; 借界数++; } }
        返;
    }
    { 整 深进 = (型 == 9 || 型 == 22 || 型 == 24) ? 1 : 0; 若 (深进) 借深++;
      遍 (整 计 = 0; 计 < 512; 计++) { 整 字符 = 取子(数, 计); 若 (字符 > 0) 借检采(字符, 0); }
      遍 (整 行弊 = 节链[数]; 行弊 > 0; 行弊 = 节链[行弊]) 遍 (整 计 = 0; 计 < 512; 计++) { 整 字符 = 取子(行弊, 计); 若 (字符 > 0) 借检采(字符, 0); }
      若 (深进) 借深--; }
}
静 空 借检数据流(整 体根) {
    借位 = 0; 借深 = 0; 借界数 = 0; 借绑数 = 0; 借用数 = 0; 借写数 = 0; 借传数 = 0; 借返数 = 0; 借点数 = 0; 借还数 = 0;
    若 (体根 < 0) 返;
    若 (单粗 < 0 || 单粗 >= 65536 || !借模式[单粗]) 返; /* #10 NLL: 仅借用语义函数 (含 借用/可变借用/放还 语句) 激活 — 纯 C 别名 p=&x 合法 (csmith 兼容) */
    借检采(体根, 0); /* 整函数体 DFS, 顺序=源码序近似 */
    若 (借绑数 == 0) { 借模式[单粗] = 0; 返; }
    /* 0) v5 语义对齐: 放还 x 位 q → 指向 x 的绑定止 = min(止, q) (有 放还 语句可见后, 放还后写 x 合法) */
    遍 (整 戊 = 0; 戊 < 借还数; 戊++) {
        整 x = 借还x[戊], q = 借还位[戊];
        遍 (整 甲 = 0; 甲 < 借绑数; 甲++) 若 (借绑x[甲] == x && 借绑起[甲] < q && (借绑止[甲] < 0 || 借绑止[甲] > q)) 借绑止[甲] = q;
    }
    /* 1) 每绑定止点 = 该 r 下次重绑位置 或 -1 (函数末); CFG 2026-09-05: 顺序重绑 (深<=甲深) 必结算; 分支内重绑 (深>甲深) 仅当 if 双路覆盖 (then/else 同 r 各一重绑) 才结算 — 单路 if(c){r=&y} 后写 x 拦 (另一路径 x 仍借); 双路 if(c){r=&y}否{r=&z} → x 借用解除 */
    遍 (整 甲 = 0; 甲 < 借绑数; 甲++) {
        整 甲止 = -1;
        遍 (整 乙 = 0; 乙 < 借绑数; 乙++) {
            若 (甲 == 乙 || 借绑r[乙] != 借绑r[甲] || 借绑起[乙] <= 借绑起[甲]) 续;
            整 结算 = (借绑深[乙] <= 借绑深[甲]);
            若 (!结算) { /* 乙 在更深块: 双路覆盖结算 (2026-09-05 t9 嵌套精度) — 乙 直接于 最内层 if 臂 (借绑深[乙]==借界深[戊]+1) 且 对侧臂 有直接 r 顺序赋值 (同深) → 汇合后 r 确定重绑; 嵌套 if (乙 深>外层if深+1) 或 对侧无直接赋值 → 不结算保守拦 (t9: 内层 if 无 else 路径未重绑) */
                遍 (整 戊 = 0; 戊 < 借界数 && !结算; 戊++) {
                    整 乙臂 = -1;
                    若 (借界B起[戊] >= 0 && 借位含(借界B起[戊], 借界B终[戊], 借绑起[乙]) && 借绑深[乙] == 借界深[戊] + 1) 乙臂 = 0;
                    否 若 (借界C起[戊] >= 0 && 借位含(借界C起[戊], 借界C终[戊], 借绑起[乙]) && 借绑深[乙] == 借界深[戊] + 1) 乙臂 = 1;
                    若 (乙臂 >= 0) { 整 对侧起 = 乙臂 ? 借界B起[戊] : 借界C起[戊]; 整 对侧终 = 乙臂 ? 借界B终[戊] : 借界C终[戊]; 整 直深 = 借界深[戊] + 1;
                        若 (对侧起 >= 0) { 遍 (整 丙 = 0; 丙 < 借绑数 && !结算; 丙++) {
                            若 (丙 == 甲 || 借绑r[丙] != 借绑r[甲] || 借绑起[丙] <= 借绑起[甲] || 借绑深[丙] != 直深) 续;
                            若 (借位含(对侧起, 对侧终, 借绑起[丙])) 结算 = 1;
                        } }
                    }
                }
            }
            若 (结算 && (甲止 < 0 || 借绑起[乙] < 甲止)) 甲止 = 借绑起[乙];
        }
        若 (甲止 >= 0 && (借绑止[甲] < 0 || 甲止 < 借绑止[甲])) 借绑止[甲] = 甲止;
    }
    /* 1.5) 引用别名链传播 (v3): r2=r1 把 r1 活跃绑定 (起<传播位<止) 拷贝给 r2 (同源止) */
    遍 (整 戊 = 0; 戊 < 借传数; 戊++) {
        整 源 = 借传src[戊], 位 = 借传位[戊], 增 = 0;
        遍 (整 甲 = 0; 甲 < 借绑数; 甲++) 若 (!增 && 借绑r[甲] == 源 && 借绑起[甲] < 位 && (借绑止[甲] < 0 || 借绑止[甲] > 位)) {
            借绑加(借传dst[戊], 借绑x[甲], 位, 借绑深[甲]); 借绑止[借绑数 - 1] = 借绑止[甲]; 借绑深[借绑数 - 1] = 借绑深[甲]; 增 = 1; 断;
        }
    }
    /* 2) 每写 x: 活跃绑定 (起<写位<止) 指向 x 且 r 在 (写位, 止) 内有用 → A3001; 先点名门 (v6): x 在写位前有有效点名 (借用/可变借用 且未被 放还) 才追踪 */
    遍 (整 丙 = 0; 丙 < 借写数; 丙++) {
        整 位 = 借写位[丙], v = 借写变[丙];
        { 整 点活 = 0;
          遍 (整 丁2 = 0; 丁2 < 借点数; 丁2++) 若 (借点x[丁2] == v && 借点位[丁2] < 位) {
              整 活 = 1;
              遍 (整 丁3 = 0; 丁3 < 借还数; 丁3++) 若 (借还x[丁3] == v && 借还位[丁3] > 借点位[丁2] && 借还位[丁3] < 位) 活 = 0;
              若 (活) 点活 = 1;
          }
          若 (!点活) 续; /* 未点名/已放还: 普通别名写, 不追踪 */
        }
        遍 (整 甲 = 0; 甲 < 借绑数; 甲++) {
            若 (借绑x[甲] != v || 借绑起[甲] >= 位) 续;
            若 (借绑止[甲] >= 0 && 借绑止[甲] <= 位) 续;
            整 r = 借绑r[甲], 止 = 借绑止[甲];
            遍 (整 丁 = 0; 丁 < 借用数; 丁++) 若 (借用r[丁] == r && 借用位[丁] > 位 && (止 < 0 || 借用位[丁] < 止)) {
                格式化到串(错缓冲, "借用检查 (NLL): 变量 '%s' 被引用 '%s' 借用中 (写后仍使用, last-use 数据流 — 借用检查器本体 #10); 先 放还 或 重绑 引用再写", (字*)(变量表[v].名), (字*)(变量表[r].名)); 发错误("A3001", 错缓冲); 甲 = 借绑数; 断;
            }
        }
    }
    /* 3) 间接悬垂返回 (v4): 返回引用变量 r 且其活跃绑定 (止<0=未被重绑) 指向 非静态 变量 x → A3105 (反双一 只查 return &x 直形, 引用间接漏网); v5 点名门: x 须被 借用 点名过 (未点名局部返回 = C 遗产别名) */
    遍 (整 戊 = 0; 戊 < 借返数; 戊++) {
        整 r = 借返r[戊];
        遍 (整 甲 = 0; 甲 < 借绑数; 甲++) 若 (借绑r[甲] == r && 借绑止[甲] < 0) {
            整 x = 借绑x[甲];
            { 整 有点 = 0; 遍 (整 丁4 = 0; 丁4 < 借点数; 丁4++) 若 (借点x[丁4] == x) 有点 = 1; 若 (!有点) 续; }
            若 (x >= 0 && x < 变量总数() && !变量表[x].是否静态标) {
                格式化到串(错缓冲, "借用检查 (NLL): 返回引用 '%s' 指向局部变量 '%s' (悬垂 — 间接返回, 借用检查器本体 #10); 局部借用不可逃逸函数", (字*)(变量表[r].名), (字*)(变量表[x].名)); 发错误("A3105", 错缓冲); 甲 = 借绑数; 断;
            }
        }
    }
    借模式[单粗] = 0; /* 引擎用后清除激活标记 (下一函数从零开始) */
}
判别 借态 于 { 无借, 共享借, 独占借 }; /* E3b (2026-09-06): 借用状态 判别化 — 无借=0 共享借=1(原只读0) 独占借=2(原可变1) */
静 构 { 字 名[64]; 构 借态 别; 整 深; 整 基; 整 末用; } 借用表[2048]; 静 整 素寅 = 0; /* 2026-09-09 借用遮蔽: 基 = 登记变量 条目序 (遮蔽同名隔离; -1=路径/不可见) */ 静 整 计贰 = 0; /* A3-c1 (2026-09-12): 域五/双繁/行次/借基/度平 5 平行数组 → 借用表{名/别/深/基/末用} 结构体数组 */ /* 2026-08-28 类型-根-3 节长标: 末-读取 词元 位 的 已借用 变量 (末-使用 auto-产出 到 mut 借用/写入) */ /* 借用检查表 (接入 2026-08-28 机制层 #2/3/4/10): 借用 x; 标记只读(共享借), 可变借用 x; 独占(独占借); #4 生命周期=词法块作用域 — 行次 记录借用声明时块深度, 块退出自动放还 (借用不跨块) */
静 构 { 字 名[64]; 整 父; } 存期表[16].名; 静 整 存期数 = 0; /* A3-h (2026-09-12): 存期表/域约束 2 平行数组 → 存期表{名/父} 结构体数组 (生命周期域表 真结构化) */
静 整 当繁(常 字 *值) { 整 当基 = 查活变量(值); 遍 (整 计 = 0; 计 < 素寅; 计++) 若 (!比较字符串(借用表[计].名, 值) && (当基 < 0 || 借用表[计].基 < 0 || 借用表[计].基 == 当基)) 返 借用表[计].别.tag; 返 -1; } /* 2026-09-09 借用遮蔽: 优先 当前可见基 (遮蔽同名外层借用 不误配; 路径/不可见 退全名) */
静 空 下低(常 字 *值) { 借用 值; 若 (!值) { 放还 值; 返; } 整 低基 = 查活变量(值); 遍 (整 计 = 0; 计 < 素寅; 计++) 若 (!比较字符串(借用表[计].名, 值) && (低基 < 0 || 借用表[计].基 < 0 || 借用表[计].基 == 低基)) { 借用表[计].名[0] = 0; 借用表[计].别.tag = 借态_无借; 总子[计] = 0; /* 阶段C-1 #4 落IR: 放还 → vt_lifetime 状态恢复普通 (0) */ 放还 值; 返; } 放还 值; } /* 放还: 解除借用 (模式 一并清, 借用幂等注册 → 一次全清) — 放还语句/写自动放还共用 */
静 整 查域(常 字 *名) { 遍 (整 计 = 0; 计 < 存期数; 计++) 若 (!比较字符串(存期表[计].名, 名)) 返 计; 返 -1; } /* 阶段C-1 #4 二步: 生命周期域查询 (0-based 索引, -1=未声明) */
静 整 活过(整 甲域, 整 乙域) { /* 生命周期攻坚 t3 (2026-09-07): 存活约束传递判定 — 甲域 是否 活过 乙域 (沿 域约束 链走; 甲域==乙域 或 约束链 达 乙域 = 活过; 步数<16 防环) */
    遍 (整 步数 = 0; 步数 < 16 && 甲域 >= 0; 步数++) {
        若 (甲域 == 乙域) 返 1;
        甲域 = 存期表[甲域].父;
    }
    返 0;
}
静 字 借用单元表[256][64]; 静 整 借用单元数 = 0; /* t6 (2026-09-07): RefCell 运行时借用计数 — 借用单元 x, 初值; 借用/可变借用/放还 x 走运行时计数 (绕开编译期借用检查, 共享可变逃逸口) */
静 整 借用单元查(常 字 *名) { 遍 (整 计 = 0; 计 < 借用单元数; 计++) 若 (!比较字符串(借用单元表[计], 名)) 返 计; 返 -1; }
静 字 *源陆(整 数) { 整 返回值 = 数; 整 号八 = 0; 循环 (返回值 >= 0 && 号八 < 8 && (节型别[返回值] == 节点_下标 || (节型别[返回值] == 节点_成员 && 节值表[返回值] == 0))) { 返回值 = 子0[返回值]; 号八++; } 若 (返回值 >= 0 && 节型别[返回值] == 节点_变量) 返 (字*)(节名表 + 返回值); 返 NULL; } /* 借用自动化 (2026-08-28 完善): 写目标基础变量 — 下钻数组下标/点成员, 遇箭头/解引用停止 (写的是指向对象, 不是指针变量本身) */
静 构 { 字 指[64]; 字 目标[64]; 整 基; } 别名表[64]; 静 整 剩子 = 0; /* A3-c2 (2026-09-12): 初二/前十/前十基 3 平行数组 → 别名表{指/目标/基} 结构体数组 (借用追指针别名) */
静 空 总布(常 字 *指, 常 字 *暂) { /* 修复 2026-08-30 探雷雷4: 登记/更新 指针→目标 别名; 2026-09-10: 同记 目标基序 (路径取根名) */
    若 (!指 || !暂 || !指[0] || !暂[0]) 返;
    字 根名[64]; 整 根丙 = 0; 遍 (整 乙 = 0; 暂[乙] && 根丙 < 63 && 暂[乙] != '.' && 暂[乙] != '['; 乙++) { 根名[根丙++] = 暂[乙]; } 根名[根丙] = 0;
    整 暂基 = 根名[0] ? 查活变量(根名) : -1;
    遍 (整 计 = 0; 计 < 剩子; 计++) 若 (!比较字符串(别名表[计].指, 指)) { 复制字符串(别名表[计].目标, 暂); 别名表[计].基 = 暂基; 返; } /* 覆盖旧别名 */
    若 (剩子 < 64) { 复制字符串(别名表[剩子].指, 指); 复制字符串(别名表[剩子].目标, 暂); 别名表[剩子].基 = 暂基; 剩子++; }
}
静 字 *别名终(常 字 *名, 整 深) { /* P3-16 (2026-09-10): 别名声 → 链终目标 (p→q→x 多级指针别名): 逐层跟随 指针别名表 (初二→前十); 深度限 4 + 自环保护; 无别名 → 原名 */
    若 (!名 || !名[0] || 深 > 4) 返 (字*)名;
    遍 (整 计 = 0; 计 < 剩子; 计++) 若 (!比较字符串(别名表[计].指, 名)) { 若 (比较字符串(别名表[计].目标, 名)) 返 别名终(别名表[计].目标, 深 + 1); 返 别名表[计].目标; }
    返 (字*)名;
}
静 空 别名目标名(整 数, 字 *输出) { /* 2026-09-10 4d: &目标 的目标名 — 变量→变量名; 成员/下标链→完整路径 (s.内.v / a[0]) 供 总布 登记 成员别名 */    输出[0] = 0;
    若 (数 < 0) 返;
    若 (节型别[数] == 节点_变量) { 复制字符串(输出, (字*)(节名表 + 数)); 返; }
    整 链栈[8]; 整 链栈数 = 0; 整 游 = 数; 整 根 = -1;
    循环 (游 >= 0 && 链栈数 < 8) { 整 另型 = 节型别[游]; 若 (另型 == 节点_变量) { 根 = 游; 断; } 若 (另型 == 节点_下标 || 另型 == 节点_成员) { 链栈[链栈数++] = 游; 游 = 子0[游]; 续; } 断; }
    若 (根 < 0) 返;
    拼接(输出, (字*)(节名表 + 根));
    整 止 = (链栈数 > 0 && 节型别[链栈[0]] == 节点_成员) ? 1 : 0; /* 取址成员字段 → 父对象 (s.内.v → s.内, 移动/借用的是父对象, 跳过最内层字段); 下标元素 → 元素本身 (a[0] 保留) */
    遍 (整 丙 = 链栈数 - 1; 丙 >= 止; 丙--) { 整 段 = 链栈[丙]; 若 (节型别[段] == 节点_成员) { 拼接(输出, "."); 拼接(输出, (字*)(节名表 + 段)); } 否 若 (节型别[段] == 节点_下标 && 子1[段] >= 0 && 节型别[子1[段]] == 节点_常数) { 字 索[32]; 格式化到串(索, "[%d]", 节值表[子1[段]]); 拼接(输出, 索); } }
}
静 空 串弊(整 数) { /* 2026-08-28 阶段一 #33/#34 借用分裂: 先查字段/元素路径借用 (s.x / a[i]) — 路径级独占拦截+只读自动放还, 其余字段/元素不受影响; 无路径借用才回落整变量检查 */
    若 (数 >= 0 && 节型别[数] == 节点_解引用) { /* 修复 2026-08-30 探雷雷4: *p = v 指针解引用写 — 借用追指针别名 (借用 x; 整数 *p=&x; *p=99 原绕过; 只读借用→自动放还, 可变借用→拦截, 与直接写一致) */
        整 宽巳 = 子0[数];
        若 (宽巳 >= 0 && 节型别[宽巳] == 节点_变量) {
            字 *邻丙 = (字*)(节名表 + 宽巳);
            遍 (整 串申 = 0; 串申 < 剩子; 串申++) 若 (!比较字符串(别名表[串申].指, 邻丙)) {
                整 值伴 = 当繁(别名表[串申].目标); 若 (后子(别名表[串申].目标)) { 格式化到串(错缓冲, "所有权错误: 通过指针 '%s' 写已移动变量 '%s' (别名悬垂, 移动后源失效 号合.0 #5)", 邻丙, 别名表[串申].目标); 发错误("A3101", 错缓冲); 返; } /* 2026-09-09 别名悬垂写: 与读方向对称 */
                若 (值伴 == 借态_独占借) { 格式化到串(错缓冲, "借用检查: 通过指针 '%s' 写被可变借用变量 '%s' (独占冻结, 借用追别名 号合.0 #3)", 邻丙, 别名表[串申].目标); 发错误("A3001", 错缓冲); 返; }
                否 若 (值伴 == 借态_共享借) { 下低(别名表[串申].目标); 返; } /* 借用自动化: 指针写=解除目标只读借用 */
            }
        }
    }
    若 (数 >= 0 && 节型别[数] == 节点_成员 && 节值表[数] == 0) { /* 点成员写目标: 构造路径 "s.x" */
        字 *正壹 = (字*)(节名表 + 数); 整 行壬 = 子0[数]; 整 元组 = 0;
        循环 (行壬 >= 0 && 元组 < 8 && (节型别[行壬] == 节点_下标 || (节型别[行壬] == 节点_成员 && 节值表[行壬] == 0))) { 行壬 = 子0[行壬]; 元组++; }
        若 (行壬 >= 0 && 节型别[行壬] == 节点_变量) {
            字 元三[160]; 格式化到串(元三, "%s.%s", (字*)(节名表 + 行壬), 正壹);
            整 半陆一 = 当繁(元三);
            若 (半陆一 == 借态_独占借) { 格式化到串(错缓冲, "借用检查: 字段 '%s' 被可变借用 (独占), 不能写 (号合.0 #33)", 元三); 发错误("A3001", 错缓冲); 返; }
            若 (半陆一 == 借态_共享借) { 下低(元三); 返; } /* 借用自动化: 写字段 = 解除该字段只读借用 */
        }
    } 否 若 (数 >= 0 && 节型别[数] == 节点_下标 && 子1[数] >= 0 && 节型别[子1[数]] == 节点_常数) { /* 静态下标写目标: 路径 "a[i]" */
        整 素卯 = 子0[数]; 整 堆子 = 0;
        循环 (素卯 >= 0 && 堆子 < 8 && (节型别[素卯] == 节点_下标 || (节型别[素卯] == 节点_成员 && 节值表[素卯] == 0))) { 素卯 = 子0[素卯]; 堆子++; }
        若 (素卯 >= 0 && 节型别[素卯] == 节点_变量) {
            字 元三[160]; 格式化到串(元三, "%s[%d]", (字*)(节名表 + 素卯), 节值表[子1[数]]);
            整 半陆一 = 当繁(元三);
            若 (半陆一 == 借态_独占借) { 格式化到串(错缓冲, "借用检查: 元素 '%s' 被可变借用 (独占), 不能写 (号合.0 #34)", 元三); 发错误("A3001", 错缓冲); 返; }
            若 (半陆一 == 借态_共享借) { 下低(元三); 返; }
        }
    }
    字 *变节 = 源陆(数); 若 (!变节) 返; 若 (接口引用冻结(变节)) { 格式化到串(错缓冲, "接口: 目标对象 '%s' 被接口引用冻结, 不能写 (接口引用持有目标; #195 动态多态)", 变节); 发错误("A3001", 错缓冲); } 整 素浅 = 当繁(变节); 若 (素浅 == 借态_独占借) { 格式化到串(错缓冲, "借用检查: 变量 '%s' 被可变借用 (独占), 不能写 (可变借用后原变量冻结, 号合.0 #3)", 变节); 发错误("A3001", 错缓冲); } 否 若 (素浅 == 借态_共享借) { 整 有别名 = 0; 整 变基 = 查活变量(变节); 遍 (整 串申 = 0; 串申 < 剩子; 串申++) 若 (!比较字符串(别名表[串申].目标, 变节) && (变基 < 0 || 别名表[串申].基 < 0 || 别名表[串申].基 == 变基)) { 有别名 = 1; 断; } 若 (有别名 && 变量型序(变节) >= 0 && 变量指深(变节) == 0) { 格式化到串(错缓冲, "借用检查: 变量 '%s' 被借用且存在别名指针, 赋值覆盖会使别名悬垂 — 先 放还 %s 再写 (号合.0 #3)", 变节, 变节); 发错误("A3004", 错缓冲); } 否 下低(变节); } } /* P0-2 收窄 (2026-09-10 修 en 链 3 回归): 别名悬垂 只对 **构值目标** 成立 (覆盖 = 旧对象销毁 → 别名真悬垂, P0-2 本意); 标量/指针目标 覆盖只改值 (别名仍指向同槽, 无内存悬垂) → 与 NLL 一致 (末次用后重赋值合法) → 走 只读借用自动放还 (原 一律 A3004 → 误伤 英文语法 NLL 正例 regress_nll_{branch,loop,ref_chain}_ok) */ /* 借用自动化 (2026-08-28 完善): 写目标 → 只读借用(0)自动放还 (显式写=解除只读借用的明确意图, 免手动 放还); 可变借用(1)硬错误 (独占冻结是本意, 读检查 L5014 已拦, 此处兜底) */
静 空 长申(空) { 计贰--; 若 (计贰 < 0) 计贰 = 0; 遍 (整 计 = 0; 计 < 素寅; ) { 若 (借用表[计].深 > 计贰) { 总子[计] = 0; 源粗[计] = 0; /* 阶段C-1 #4 落IR: 块退出自动放还 → vt_lifetime 恢复普通 */ 遍 (整 乙 = 计; 乙 < 素寅 - 1; 乙++) { 复制字符串(借用表[乙].名, 借用表[乙 + 1].名); 借用表[乙].别.tag = 借用表[乙 + 1].别.tag; 借用表[乙].深 = 借用表[乙 + 1].深; 借用表[乙].基 = 借用表[乙 + 1].基; 借用表[乙].末用 = 借用表[乙 + 1].末用; 总子[乙] = 总子[乙 + 1]; 源粗[乙] = 源粗[乙 + 1]; /* 阶段C-1 #4 落IR: 借用表压缩同步 vt_lifetime 槽 */ } 素寅--; } 否 计++; } } /* 接入 2026-08-28 机制层 #4: 块退出 → 自动放还本块内新借用的变量 (生命周期=词法作用域, 数组压缩 O(n), 手动放还仍兼容) */
静 整 正次 = 0; 静 整 首己 = 0; 静 整 目系 = 0; 静 整 宽低 = 0; 静 整 实参中 = 0; 静 整 括内层 = 0; /* D12R454 (D-12c 根治): 括号 表达式 **内部** —— 由 `原级()` 括号分支 置位. 括号 = 子表达式 分组, 不改变 语义 ⟹ 其 **读判定** (未初始化 A4001/移动 A3101/借用 A3001/可空 A8001/元素级 A4001) 必须 上交 **最外层** `赋值()` (那时 旧辛 等 缓冲 已 汇集), 否则 内层 递归 `赋值()` 会把 `(a)` 的 `a` 误当「值读」 ⟹ A4001 假阳 (`整 a; (a) = 7;` 实测; prelude `va_start(ap,fmt)` 展开 `((ap) = …)` 同型). ⚠️ **必须 声明 在此 (先于 `原级()` L8888)** —— 甲言 单遍: 声明 晚于 使用者 ⟹ 被当 隐式符号 恒 0, 旗标 失效 (插桩铁证) */ /* 雷6 (2026-09-13): 实参 解析中 — 成员/下标 链 实参 = 潜在 出参 (字拷/内存拷 目标参数) → 字段级 逃逸, 免 A4001 假阳 */ 静 字 毛玖[8][64]; 静 整 目凶一 = 0; 静 字 值八[8][64]; 静 整 下列[8]; 静 整 顺深 = 0; 静 字 可空读[8][64]; 静 整 可空读数 = 0; 静 整 移入源中 = 0; 静 整 可空复制中 = 0; 静 字 错待名[512][64]; 静 整 错待深[512]; 静 整 错待数 = 0; 静 整 转存中 = 0; 静 整 返传中 = 0; /* G1 (2026-09-10): 返传中 = 返回语句 操作数 解析中 — 错误函数 内 `返回 f();` (f 错误函数) 是 透传语义 (rax/rdx 原样传播, 同 尝试 生成形态) → 元得 豁免 (非错误函数 仍 由 返回侧 !右陆 判定 拦 A9001) */ /* P3-14 (2026-09-10): 错误结果 转存变量 → 待检查态 (延迟: 转存不报; 比较处 消解; 作用域尾 仍待检查 → A9001) */ /* 2026-09-10 N1 修复: 可空复制上下文 (可空→可空 直接复制 = S2b-4 整槽复制, 探针放行) */ 静 字 尾阵读[8][64]; 静 整 尾阵读位[8]; 静 整 尾阵读数 = 0; /* I2-③ 元素级 读缓冲 (postfix a[i] 记, 赋值尾 事后判定 — 同 容进/旧辛 机制) */ /* 2026-09-10 N1: 可空读=可空值类型 未解包 取值 缓冲 (目系 记, 赋值 事后判定 读值 A8001 / 写目标 副降一 放行); 移入源中=移入源解析豁免 (消费 Copy 复制不需解包) */ /* 接入 2026-08-28 机制层 #5 移动语义完整: 已移 表(全局, L5014 读检查/L5296 写恢复需要); 首己=移入目标解析(目标是写); 目系=赋值左值解析中; 宽低=取地址操作数解析中(&x 不读值, 探雷雷6); 毛玖=左值解析期遇到的 已移 变量缓冲 (事后判定: 赋值→重新初始化放行, 非赋值→右值读取报错) */ /* 2026-08-28 阶段一 #33/#34/#17 修复: 值八=成员/元素路径缓冲 (赋值 对所有表达式设 lhs=1, 原成员读检查 !目系 永不触发 = 死钩子; 改为缓冲+赋值 事后判定: 写目标→写策略处理, 读→A3001/A3101) */
判别 域路型 于 { 域路简, 域路成, 域路元 }; /* t8 (2026-09-07): 域六 路径判别化 (去字符串化第一步) — 简单=整变量兜底, 成员=s.x, 元素=a[0] (预留) */
静 构 { 字 路径[64]; 构 域路型 别; 整 基; 字 字段[64]; } 域六[2048]; /* A3-e1 (2026-09-12): 域六/域六别/域六基/域六字段 4 平行数组 → 结构体数组 (路径/别/基/字段); 正次 不变 */


判别 移态 于 { 可用, 已移 }; /* E3a (2026-09-06): 所有权移动状态 判别化 (语义状态机吃狗粮) — 可用=0 已移=1 */
静 构 移态 移标[65536]; /* 所有权 移动状态 (2026-09-05 虾米 S2): 按 变量表 条目序 (0..变量总数-1) — 可用/已移 (判别); BSS 零初值 (tag=0=可用); 块退条目 (旧零>0) 由 查活变量 过滤不可见 → 遮蔽天然隔离, 移标残留无害; 路径部分移动 (s.x/a[0]) 仍存 域六 */
判别 槽型 于 { 值槽, 数组槽(元素数) }; /* C2 (2026-09-06): 守卫槽 槽型 判别 (吃狗粮第一块真肉) — 值槽=标量析构, 数组槽=逐元素 (载荷=元素数 N) */
静 构 { 字 槽名[64]; 字 槽析[64]; 整 槽帧; 整 槽基; 整 槽串; 字 槽F[80]; 构 槽型 型; 整 槽合析; 整 槽合析序; } 守卫表[256]; /* 2026-09-09 守卫遮蔽: 槽基 = 登记变量 条目序 (遮蔽同名隔离; -1=不可见/全局) */ 静 整 逆汇 = 0; /* C1 (2026-09-06): 守卫槽 平行表 → 对象数组 struct (DOG-0 吃狗粮第一步); C2 (2026-09-06): 槽戌 → 槽型 型 (判别 tag+载荷 元素数) */ /* 接入 2026-08-28 机制层 #8 RAII 完整(析构): 守卫 x, 析构名; → 记录(变量,析构函数,块深度), 块退出自动调用 析构名(x) (作用域退出自动释放, 复用 计贰 做作用域标记) */ /* 2026-08-28 阶段一 #15 丢弃 标记: 串寅=1 已初始化(析构执行) 0 未初始化(跳过析构 — 部分初始化/未初始化不析构) */
 /* BatchB (2026-09-06 虾米): 守卫运行时武装标志名 (_dp_<槽>_<槽>, 帧内 整 槽) — 1=槽当前持有需析构资源 0=空/已移出/未初始化; 块退出/返回/覆写析构 改 若(友格) 条件发射 → 分支路径精确 (移出/丢弃/忘记 在各自路径 F=0, 重赋值 F=1) */

 /* TypeDrop v2-1 (2026-09-06): 合成 drop glue — 槽为"含析构字段容器"时 合析=1, 合析序=容器构序 */
静 整 类型含析构字段深(整 构序, 整 深) { /* v2-2 递归扫描 (防自指/防环/union 排除 — 修复 en 语料误伤: 自递归 struct/typedef 指针/union) */
    若 (构序 < 0 || 深 > 32) 返 0; /* 波3c (2026-09-09): 防环深度护栏 6 → 32 — 原 深>6 误伤 合法深层嵌套容器 (L8 9层容器 判非析构 → 字段 X 漏析构 计数0 实测); 防环仍靠 毛型!=构序 (直接自指) + 深限 (间接环 32 层内必撞); 合成发射 递归无独立限, 32 层 AST 安全 */
    若 (类型表[构序].是否联) 返 0; /* union 不合成 (Rust union 不自动 drop) */
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++) {
        整 毛型 = 类型表[构序].字段[计].毛利;
        若 (毛型 >= 0 && 毛型 != 构序) {
            若 (型析查序(毛型)) 返 1;
            若 (类型含析构字段深(毛型, 深 + 1)) 返 1;
        }
    }
    返 0;
}
静 整 类型含析构字段(整 构序) { 返 类型含析构字段深(构序, 0); } /* 字段 含 析构类型 (直接或递归合成, 防环) */ /* TypeDrop 站4 (2026-09-06): 槽为数组析构时 = 元素数 N (0=值槽); 压缩/登记 同步 */
静 整 守卫槽找(常 字 *名) { 若 (!名 || !名[0]) 返 -1; 整 槽基限 = 查活变量(名); 遍 (整 庚序 = 0; 庚序 < 逆汇; 庚序++) 若 (守卫表[庚序].槽名[0] != 0 && !比较字符串(守卫表[庚序].槽名, 名) && (槽基限 < 0 || 守卫表[庚序].槽基 < 0 || 守卫表[庚序].槽基 == 槽基限)) 返 庚序; 返 -1; } /* 2026-09-09 守卫遮蔽: 优先 当前可见基 槽 (遮蔽同名外层守卫 不误配; 基不可见/全局 退 全名) */ /* 守卫槽 名字反查 (最近注册; 同名局限同 宽辰 全表) */
静 整 守卫析构呼(整 庚序) { 整 呼 = 建节(4); { 整 参 = 建节(1); 复制内存((字*)(节名表 + 参), 守卫表[庚序].槽名, 64); 接子(呼, 参); } { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 守卫表[庚序].槽析, 64); 接子(呼, 函); } 返 呼; } /* 析构名(x); */
静 整 守卫置F(整 庚序, 整 值) { 若 (庚序 < 0 || 庚序 >= 256 || !守卫表[庚序].槽F[0]) 返 建节(5); 若 (守卫表[庚序].型.tag == 槽型_数组槽) { /* B1 (2026-09-06): 数组槽 — 逐元素 F[宽k]=值 (整组武装/撤防) */ 整 块 = 建节(5); 遍 (整 宽k = 0; 宽k < 守卫表[庚序].型.p0 && 宽k < 256; 宽k++) { 整 赋 = 建节(10); { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 守卫表[庚序].槽F, 64); 整 下标 = 建节(14); 接子(下标, 左); { 整 c = 建节(0); 节值表[c] = 宽k; 接子(下标, c); } 接子(赋, 下标); } { 整 右 = 建节(0); 节值表[右] = 值; 接子(赋, 右); } 接子(块, 赋); } 返 块; } 整 赋 = 建节(10); { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 守卫表[庚序].槽F, 64); 接子(赋, 左); } { 整 右 = 建节(0); 节值表[右] = 值; 接子(赋, 右); } 返 赋; } /* F = 值; (标量) / 逐元素 (数组) */
静 整 守卫置F元素(整 庚序, 整 宽k, 整 值) { /* B1 (2026-09-06): 数组槽 单元素 F[宽k]=值 */
    若 (庚序 < 0 || 庚序 >= 256 || !守卫表[庚序].槽F[0] || 宽k < 0 || 宽k >= 守卫表[庚序].型.p0) 返 建节(5);
    整 赋 = 建节(10); { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 守卫表[庚序].槽F, 64); 整 下标 = 建节(14); 接子(下标, 左); { 整 c = 建节(0); 节值表[c] = 宽k; 接子(下标, c); } 接子(赋, 下标); } { 整 右 = 建节(0); 节值表[右] = 值; 接子(赋, 右); } 返 赋; }
静 整 守卫元素析构(整 庚序, 整 宽k) { /* B1 (2026-09-06): 若(F[宽k]!=0) { 析构(a[宽k]); F[宽k]=0; } — 单元素覆写析构 */
    若 (庚序 < 0 || 庚序 >= 256 || !守卫表[庚序].槽F[0] || 宽k < 0 || 宽k >= 守卫表[庚序].型.p0) 返 建节(5);
    整 若节 = 建节(8);
    { 整 条 = 建节(2); 节值表[条] = 顺八; { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 守卫表[庚序].槽F, 64); 整 下标F = 建节(14); 接子(下标F, 左); { 整 c = 建节(0); 节值表[c] = 宽k; 接子(下标F, c); } 接子(条, 下标F); } { 整 右 = 建节(0); 节值表[右] = 0; 接子(条, 右); } 接子(若节, 条); }
    { 整 体 = 建节(5); 整 名节 = 建节(1); 复制内存((字*)(节名表 + 名节), 守卫表[庚序].槽名, 64); 整 下标 = 建节(14); 接子(下标, 名节); { 整 c = 建节(0); 节值表[c] = 宽k; 接子(下标, c); } 若 (守卫表[庚序].槽合析) 合成发射(体, -1, 下标, 守卫表[庚序].槽合析序); 否 { 整 址 = 建节(11); 接子(址, 下标); 整 呼 = 建节(4); 接子(呼, 址); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 守卫表[庚序].槽析, 64); 接子(呼, 函); } 接子(体, 呼); } 接子(体, 守卫置F元素(庚序, 宽k, 0)); 接子(若节, 体); }
    返 若节;
}
静 整 守卫置F元素动(整 庚序, 整 索节, 整 值) { /* B1b (2026-09-06): 数组槽 F[动态索引]=值 (索节=变量节点) */
    若 (庚序 < 0 || 庚序 >= 256 || !守卫表[庚序].槽F[0] || 索节 < 0) 返 建节(5);
    整 赋 = 建节(10); { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 守卫表[庚序].槽F, 64); 整 下标 = 建节(14); 接子(下标, 左); { 整 克 = 建节(1); 复制内存((字*)(节名表 + 克), (字*)(节名表 + 索节), 64); 接子(下标, 克); } 接子(赋, 下标); } { 整 右 = 建节(0); 节值表[右] = 值; 接子(赋, 右); } 返 赋; }
静 整 守卫元素析构动(整 庚序, 整 索节) { /* B1b (2026-09-06): 若(F[动态索引]!=0) { 析构(a[索引]); F[索引]=0; } — 动态下标单元素覆写析构 */
    若 (庚序 < 0 || 庚序 >= 256 || !守卫表[庚序].槽F[0] || 索节 < 0) 返 建节(5);
    整 若节 = 建节(8);
    { 整 条 = 建节(2); 节值表[条] = 顺八; { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 守卫表[庚序].槽F, 64); 整 下标F = 建节(14); 接子(下标F, 左); { 整 克 = 建节(1); 复制内存((字*)(节名表 + 克), (字*)(节名表 + 索节), 64); 接子(下标F, 克); } 接子(条, 下标F); } { 整 右 = 建节(0); 节值表[右] = 0; 接子(条, 右); } 接子(若节, 条); }
    { 整 体 = 建节(5); 整 名节 = 建节(1); 复制内存((字*)(节名表 + 名节), 守卫表[庚序].槽名, 64); 整 下标 = 建节(14); 接子(下标, 名节); { 整 克 = 建节(1); 复制内存((字*)(节名表 + 克), (字*)(节名表 + 索节), 64); 接子(下标, 克); } 若 (守卫表[庚序].槽合析) 合成发射(体, -1, 下标, 守卫表[庚序].槽合析序); 否 { 整 址 = 建节(11); 接子(址, 下标); 整 呼 = 建节(4); 接子(呼, 址); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 守卫表[庚序].槽析, 64); 接子(呼, 函); } 接子(体, 呼); } 接子(体, 守卫置F元素动(庚序, 索节, 0)); 接子(若节, 体); }
    返 若节;
}
静 空 合成发射(整 体块, 整 变量节, 整 链节, 整 构序) { /* TypeDrop v2-2 (2026-09-06): 递归 drop glue — 直接析构字段 (型析查序) + 合成字段递归 (含析构字段容器) */
    遍 (整 计 = 类型表[构序].函 - 1; 计 >= 0; 计--) { /* 波3a (2026-09-09): 字段析构 逆序 (Rust: 后声明先析构, 防字段依赖) — 原 0..函 正序 (a,b,c) 实测非逆序 */
        整 毛型 = 类型表[构序].字段[计].毛利;
        字 *析构函数 = (毛型 >= 0) ? 型析查序(毛型) : 0;
        整 基节 = 链节 >= 0 ? 链节 : 变量节;
        整 成员 = 建节(15); 复制内存((字*)(节名表 + 成员), 类型表[构序].字段[计].正辰, 64); 接子(成员, 基节);
        整 内联 = 类型表[构序].字段[计].内联; 整 现捌 = 类型表[构序].字段[计].现捌; 整 N = (内联 > 0 && 现捌 > 内联) ? (现捌 / 内联) : 1; /* B2 (2026-09-06): 数组字段 (静态维度) → 逐元素; 标量 → 单值 */
        遍 (整 宽k = 0; 宽k < N && 宽k < 256; 宽k++) {
            整 元基 = 成员; 若 (N > 1) { 元基 = 建节(14); 接子(元基, 成员); { 整 c = 建节(0); 节值表[c] = 宽k; 接子(元基, c); } }
            若 (析构函数) { 整 址 = 建节(11); 接子(址, 元基); 整 呼 = 建节(4); 接子(呼, 址); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 析构函数, 64); 接子(呼, 函); } 接子(体块, 呼); }
            否 若 (毛型 >= 0 && 类型含析构字段(毛型)) 合成发射(体块, 变量节, 元基, 毛型); /* 合成容器字段 (含数组字段逐元素) → 递归其字段 */
        }
    }
}
静 整 守卫条件析构(整 庚序) { 若 (庚序 < 0 || 庚序 >= 256 || !守卫表[庚序].槽F[0]) 返 建节(5); 若 (守卫表[庚序].型.tag == 槽型_数组槽) { /* B1 (2026-09-06): 数组槽 — 逐元素 若(F[宽k]!=0) 析构 (只析构已赋值元素) */ 整 块 = 建节(5); 遍 (整 宽k = 0; 宽k < 守卫表[庚序].型.p0 && 宽k < 256; 宽k++) { 整 若节 = 建节(8); { 整 条 = 建节(2); 节值表[条] = 顺八; { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 守卫表[庚序].槽F, 64); 整 下标F = 建节(14); 接子(下标F, 左); { 整 c = 建节(0); 节值表[c] = 宽k; 接子(下标F, c); } 接子(条, 下标F); } { 整 右 = 建节(0); 节值表[右] = 0; 接子(条, 右); } 接子(若节, 条); } { 整 体 = 建节(5); 整 名节 = 建节(1); 复制内存((字*)(节名表 + 名节), 守卫表[庚序].槽名, 64); 整 下标 = 建节(14); 接子(下标, 名节); { 整 c = 建节(0); 节值表[c] = 宽k; 接子(下标, c); } 若 (守卫表[庚序].槽合析) 合成发射(体, -1, 下标, 守卫表[庚序].槽合析序); 否 { 整 址 = 建节(11); 接子(址, 下标); 整 呼 = 建节(4); 接子(呼, 址); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 守卫表[庚序].槽析, 64); 接子(呼, 函); } 接子(体, 呼); } 接子(体, 守卫置F元素(庚序, 宽k, 0)); 接子(若节, 体); } 接子(块, 若节); } 返 块; } 整 若节 = 建节(8); { 整 条 = 建节(2); 节值表[条] = 顺八; { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 守卫表[庚序].槽F, 64); 接子(条, 左); } { 整 右 = 建节(0); 节值表[右] = 0; 接子(条, 右); } 接子(若节, 条); } { 整 体 = 建节(5); 若 (守卫表[庚序].槽合析) { 整 名节 = 建节(1); 复制内存((字*)(节名表 + 名节), 守卫表[庚序].槽名, 64); 合成发射(体, 名节, -1, 守卫表[庚序].槽合析序); } /* TypeDrop v2-2: 递归 drop glue */ 否 { 接子(体, 守卫析构呼(庚序)); } 接子(体, 守卫置F(庚序, 0)); 接子(若节, 体); } 返 若节; } /* 若 (F != 0) { 析构; F = 0; } — 标量 / 数组逐元素 (B1) */静 整 触槽[32]; 静 整 触数 = 0; /* BatchB2 (2026-09-06): 语句级 F 冲刷 事件记录 — 移源 撤就绪/副轮 武装 记槽, 块() 语句边界 统一写 F=串寅 (覆盖 调用传参/表达式内移动 等非语句尾路径) */
静 空 触记(整 槽) { 借用 槽; 若 (槽 < 0) { 放还 槽; 返; } 遍 (整 计 = 0; 计 < 触数; 计++) 若 (触槽[计] == 槽) { 放还 槽; 返; } 若 (触数 < 32) 触槽[触数++] = 槽; 放还 槽; } /* D1 (2026-09-06): 借用/放还 语义重写 — 引擎源码首个 借检 激活函数 (借模式), 自举时自检跑在自身源码上 (DOG 自举化第一块) */
静 空 守卫冲刷(整 块) { 遍 (整 计 = 0; 计 < 触数; 计++) { 整 槽 = 触槽[计]; 若 (槽 >= 0 && 槽 < 逆汇 && 守卫表[槽].槽名[0] != 0) 接子(块, 守卫置F(槽, 守卫表[槽].槽串 ? 1 : 0)); } 触数 = 0; } /* F = 当前静态串寅 (语句边界后 覆盖本语句内 多次翻转 终态) */
静 整 守卫外流拒(整 节, 字 *基名) { /* G9/G12 (2026-09-06): RHS 是 守卫基 纯成员链拷贝外流 (t = a.子 / t = a.内.子; 非 移入) — 叶字段 非Copy 结构 → 双所有权 (基 作用域整析构 与 t 双释放) → A3106 (Rust E0509: Drop 型不可读非Copy字段); 标量/Copy/指针字段 放行; 链含 下标14/解引用12/取址11 或 基非变量 → 保守放行 (挂账) */
    整 链[8]; 整 链数 = 0; 整 游 = 节; 整 基 = -1;
    循环 (游 >= 0 && 链数 < 8) {
        整 t = 节型别[游];
        若 (t == 节点_变量) { 基 = 游; 断; }
        若 (t != 节点_成员 && t != 节点_箭头) 返 0; /* 下标/解引用/其它 → 保守放行 */
        链[链数++] = 游;
        游 = 子0[游];
    }
    若 (基 < 0 || 链数 == 0) 返 0;
    复制字符串(基名, (字*)(节名表 + 基));
    整 槽 = 守卫槽找(基名);
    若 (槽 < 0) 返 0; /* 非守卫基: C 拷贝语义保留 */
    整 构序 = 变量型序(基名);
    若 (构序 < 0) 返 0;
    遍 (整 计 = 链数 - 1; 计 >= 0; 计--) { /* 自 base 正向逐层走 */
        字 *字段名 = (字*)(节名表 + 链[计]);
        整 字段序 = 字段序(构序, 字段名);
        若 (字段序 < 0 || 字段序 >= 类型表[构序].函) 返 0;
        整 叶型 = -1; 复制内存(&叶型, &类型表[构序].字段[字段序].毛利, 4);
        若 (计 == 0) { /* 顶层叶字段: 判定 */
            若 (叶型 < 0) 返 0; /* 标量/指针: Copy 放行 */
            若 (类型表Copy(叶型)) 返 0;
            返 1;
        }
        若 (叶型 < 0) 返 0; /* 中间层非结构: parser 已拦, 保守放行 */
        构序 = 叶型;
    }
    返 0;
}
静 整 跳层[128]; 静 整 跳层数 = 0; /* G10/G13 (2026-09-06 虾米): break/continue 作用域深度栈 — 循环体解析压 +体块深度(计贰+1); switch 压 -体深度 (负=switch-break 语义: case 内 块 守卫 帧附>=|v| 析构, case 顶层/switch 外 帧附<|v| 保留; continue 穿透 switch) */
静 空 跳入(整 下界) { 若 (跳层数 < 128) 跳层[跳层数++] = 下界; }
静 空 跳出(空) { 若 (跳层数 > 0) 跳层数--; }
静 整 断析构层() { 若 (跳层数 > 0) { 整 v = 跳层[跳层数 - 1]; 若 (v > 0) 返 v; 若 (v < 0) 返 -v; } 返 -1; } /* break: 栈顶 循环(+)/switch(-) 体深度; 0/空 → 不析构 */
静 整 续析构层() { 遍 (整 计 = 跳层数 - 1; 计 >= 0; 计--) 若 (跳层[计] > 0) 返 跳层[计]; 返 -1; } /* continue: 最近循环 (穿透 switch 负层) */
静 字 标签循环名[64][64]; 静 整 标签循环深[64]; 静 整 标签循环数 = 0; /* G14 (2026-09-06): 标签循环体深度表 (标签: 循环/遍/做 登记) — 带标签 断/续 跳外层循环 析构下界 */
静 整 标签析构层(常 字 *标签) { 若 (!标签 || !标签[0]) 返 -1; 遍 (整 计 = 标签循环数 - 1; 计 >= 0; 计--) 若 (!比较字符串(标签循环名[计], 标签)) 返 标签循环深[计]; 返 -1; }
/* TypeDrop v1 (2026-09-06 虾米): 析构 T, fn; 类型级析构登记 — T 值变量 自动析构 (Rust Drop 对齐). A3-析构位 (2026-09-12): 原 2 个 名键 平行数组 型析名[64][64]/型析函[64][64] + 型析数 已 退役 → 迁入 真结构 类型表[构序].析构函[64] (容量 64 → 4096, 且 查 构序 不再 走 名 往返) */
静 字 参析名[64][64]; 静 字 参析函[64][64]; 静 整 参析数 = 0; 静 整 参析待 = 0; /* A3-参析 容量 (2026-09-12): 原 [16] —— 形参 收集 循环 是 `&& 参析数 < 16`, 超过 16 个 **静默 截断**, 被 截 掉 的 析构形参 **从不 注册 守卫 → 其 析构 永不执行 (静默 资源泄漏)**; 现 64 + 满 即 原得 确定性拒绝 (与 守卫表 256 同 手法) */ /* TypeDrop v1 站2 (2026-09-06): 析构形参待办 — 函数体块() 前收集, 入口登记+F=1 (形参=调用者移入, 函数出口自动析构) */
静 整 临析数 = 0; /* TypeDrop A2 (2026-09-06): drop 顺序追平 临时槽 唯一名计数器 (RHS 先求值入 临时, 再析构旧值, 再搬入) */
静 字 *型析查名(常 字 *类型名) { 若 (!类型名 || !类型名[0]) 返 0; 整 序八 = 查类型(类型名); 若 (序八 < 0 || 序八 >= 4096) 返 0; 返 (类型表[序八].析构函[0]) ? 类型表[序八].析构函 : 0; } /* TypeDrop v1: 类型名→析构函数; A3-析构位: 原 线性 反向 扫 名键侧表 → 查类型 + 真结构 字段 (空 = 未登记) */
静 字 *型析查序(整 构序) { 若 (构序 < 0 || 构序 >= 4096) 返 0; 返 (类型表[构序].析构函[0]) ? 类型表[构序].析构函 : 0; } /* 变量声明处按 构序 查; A3-析构位 (2026-09-12): 原 走 「构序→名→查名」 往返 (匿名 类型 名="" 时 会 撞 第一 匿名条目), 现 直接 读 真结构 字段 */
静 整 类型析构自动(字 *名, 整 构序, 整 F初值) { /* TypeDrop v1/v2-1 (2026-09-06): 析构类型 或 含析构字段容器 局部值变量 自动登记守卫槽 + 返 F=F初值 节点 */
    若 (!名 || !名[0] || 名[0] == '_') 返 建节(5);
    字 *析构函数 = 型析查序(构序);
    整 合成 = 0;
    若 (!析构函数) { 若 (类型含析构字段(构序)) 合成 = 1; 否 返 建节(5); }
    整 槽 = 守卫槽找(名);
    若 (槽 < 0) {
        若 (逆汇 >= 256) 原得("守卫槽 溢出 (TypeDrop 类型析构)", 256);
        复制字符串(守卫表[逆汇].槽名, 名);
        若 (合成) { 守卫表[逆汇].槽析[0] = 0; 守卫表[逆汇].槽合析 = 1; 守卫表[逆汇].槽合析序 = 构序; } 否 { 复制字符串(守卫表[逆汇].槽析, 析构函数); 守卫表[逆汇].槽合析 = 0; 守卫表[逆汇].槽合析序 = 0; }
        守卫表[逆汇].槽帧 = 计贰; 守卫表[逆汇].槽基 = 查活变量(名); 守卫表[逆汇].槽串 = F初值 ? 1 : 0;
        格式化到串(守卫表[逆汇].槽F, "_dp_%d", 逆汇); 变量偏移(守卫表[逆汇].槽F);
        守卫表[逆汇].型.tag = 槽型_值槽; 守卫表[逆汇].型.p0 = 0; 槽 = 逆汇; 逆汇++;
    }
    返 守卫置F(槽, F初值);
}
静 整 跳转析构包(整 下界, 整 跳节) { /* G10: { 冲刷; 若(F){析构} 帧附>=下界 的活守卫 (LIFO); 跳节 } — break/continue 不绕过守卫析构 (泄漏修复 probe_23/24) */
    若 (下界 < 0 || 跳节 < 0) 返 跳节;
    整 包 = 建节(5);
    守卫冲刷(包);
    遍 (整 庚序 = 逆汇 - 1; 庚序 >= 0; 庚序--) 若 (守卫表[庚序].槽名[0] != 0 && 守卫表[庚序].槽帧 >= 下界) 接子(包, 守卫条件析构(庚序));
    接子(包, 跳节);
    返 包;
}
静 整 号寅(整 结) { /* 接入 2026-08-28 机制层 #8 RAII 真修复: 返回 包块 { 活跃守卫析构(LIFO); 返回 } — 析构在 返回 前可达 (原 块() 块尾析构被 返回 跳过 → 资源泄漏, feat_raii 只测落出路径没暴露); 每个 返回 各有自己的析构副本, 运行时只走被选路径 → 无双发 */ /* 2026-08-28 阶段一 #24 所有权转移返回: 返回 局部 → 局部所有权转移给调用者, 返回变量的析构跳过 (返回路径不执行被返回变量的守卫 — 否则析构后调用者拿到的是已释放资源) */
    字 宽叁一[64] = ""; 字 前丙[64] = "";
    若 (结 >= 0 && 子0[结] >= 0 && 节型表[子0[结]] == 1) 复制字符串(宽叁一, (字*)(节名表 + 子0[结])); /* 返回 x 单值: 子0=返回表达式 (简单变量时记名) */
    若 (结 >= 0 && 节值表[结] == 9001 && 子1[结] >= 0 && 节型表[子1[结]] == 1) 复制字符串(前丙, (字*)(节名表 + 子1[结])); /* 返回(a,b) 多值: 子1=第二值 */
    整 域序一 = 0;
    遍 (整 庚序 = 0; 庚序 < 逆汇; 庚序++) 若 (守卫表[庚序].槽名[0] != 0) { 域序一 = 1; 断; }
    若 (!域序一) { /* 无 RAII 守卫 — 仍可能有 块级/函数级 延迟 待刷新 (阶段C-1 #53, 2026-09-01) */
        若 (标繁 >= 0 && 名捌[标繁] > 0) { 整 单回 = 建节(5); 字 临名K[64]; 格式化到串(临名K, "__rret_%d", 结); 整 临构K = 表达式构序(结); 若 (临构K >= 0) 构返临(临名K, 临构K); 否 若 (表达式是否浮(结)) 变浮(临名K); 否 若 (表达式是否长(结)) 余乙(临名K); 否 变量偏移(临名K); 整 临声K = 建节(7); 复制内存((字*)(节名表 + 临声K), 临名K, 32); 若 (子0[结] >= 0) 接子(临声K, 子0[结]); 接子(单回, 临声K); 遍 (整 丁序 = 名捌[标繁] - 1; 丁序 >= 0; 丁序--) 若 (末伴[标繁][丁序] > 0) 接子(单回, 末伴[标繁][丁序]); 整 临读K = 建节(1); 复制内存((字*)(节名表 + 临读K), 临名K, 32); 整 新返K = 建节(6); 接子(新返K, 临读K); 接子(单回, 新返K); 返 单回; } /* C7 (2026-09-11): 不清零 — 一个 延迟 需 服务 每 一条 返回 路径 (清零 会让 第二 个 返回 与 块尾/长复 的 副本 消失); 双发 风险 由 "两 份 副本 各 在 不同 控制流 路径" 消解 */
        返 结;
    }
    整 单回 = 建节(5);
    守卫冲刷(单回); /* BatchB2: 返回路径 先冲刷 (返 语句内 移动/武装 落定 F, 再条件析构) */
    遍 (整 庚序 = 逆汇 - 1; 庚序 >= 0; 庚序--) { 若 (守卫表[庚序].槽名[0] != 0) { /* 返回 路径 全守卫 (武装与否 由 F 运行时定 — BatchB) */
        若 (宽叁一[0] && !比较字符串(守卫表[庚序].槽名, 宽叁一)) 续; /* #24: 所有权转移 — 被返回变量的守卫跳过 (资源归调用者) */
        若 (前丙[0] && !比较字符串(守卫表[庚序].槽名, 前丙)) 续; /* #24: 多值返回同样跳过 */
        接子(单回, 守卫条件析构(庚序));
    } }
    遍 (整 丁序 = 名捌[标繁] - 1; 丁序 >= 0; 丁序--) 若 (标繁 >= 0 && 末伴[标繁][丁序] > 0) 接子(单回, 末伴[标繁][丁序]); /* C7: 同上 不清零 */ /* 阶段C-1 #53 块级延迟 (2026-09-01): 返路径 LIFO 刷新剩余延迟 (块级+函数级, 长复 跳过已清除) */
    接子(单回, 结);
    返 单回;
}
静 空 副轮(常 字 *值) { /* 2026-08-28 阶段一 #15 丢弃 标记: 赋值初始化 → 守卫 就绪 (块退出才析构) */
    整 武基 = 查活变量(值); 遍 (整 计 = 0; 计 < 逆汇; 计++) 若 (!比较字符串(守卫表[计].槽名, 值) && (武基 < 0 || 守卫表[计].槽基 < 0 || 守卫表[计].槽基 == 武基)) { 若 (守卫表[计].型.tag == 槽型_数组槽) 续; /* B1 (2026-09-06): 数组槽 逐元素 F (元素写由 语句级 元素分支 武装单元素, 不整组武装) */ 守卫表[计].槽串 = 1; 触记(计); } /* BatchB2: 武装事件 记冲刷 */
}
静 整 查活变量(常 字 *名) { 遍 (整 计 = 变量总数() - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 名) && 变量码生成可见(计)) 返 计; 返 -1; } /* 所有权 (2026-09-05 虾米 S2): 解析期可见变量反查 — 变量码生成可见 滤 块退条目 (旧零>0) → 嵌套块同名 移动状态 天然隔离; 仿 借查名 但带可见性 */
静 整 后子(常 字 *值) { 整 计活 = 查活变量(值); 若 (计活 >= 0) 返 移标[计活].tag; 遍 (整 计 = 0; 计 < 正次; 计++) 若 (!比较字符串(域六[计].路径, 值)) 返 1; 返 0; } /* 所有权 #5 (2026-09-05 改造): 0/1 已移 — 主状态 查 移标 (真每变量状态); 域六 兜底 = 路径部分移动 (s.x/a[0] 非变量名, 查活变量 找不到) + 全局普通 (解析基 下不可见) */
静 整 后子字段(整 基序, 常 字 *字段名) { 遍 (整 计 = 0; 计 < 正次; 计++) 若 (域六[计].别.tag == 域路型_域路成 && 域六[计].基 == 基序 && !比较字符串(域六[计].字段, 字段名)) 返 1; 返 0; } /* t8c (2026-09-07): 字段路径 符号化已移判定 — 基=变量表条目序 (作用域感知, 遮蔽同名隔离), 字段名 符号匹配 */
静 整 域六含(整 基序, 常 字 *路径) { 遍 (整 计 = 0; 计 < 正次; 计++) 若 (!比较字符串(域六[计].路径, 路径)) { 若 (基序 >= 0 && 域六[计].别.tag != 域路型_域路简 && 域六[计].基 != 基序) 续; 返 1; } 返 0; } /* 2026-09-09 遮蔽读端: 字符串路径匹配 基名作用域感知 — 只认 当前可见基 的登记; 遮蔽同名外层登记 不误拦 (sp_shadow_arr_inner 纯内层误拦实锤) */
静 空 邻未(常 字 *值) { 整 计活 = 查活变量(值); 若 (计活 >= 0) { 移标[计活].tag = 移态_可用; 遍 (整 计 = 0; 计 < 正次; 计++) 若 (域六[计].别.tag != 域路型_域路简 && 域六[计].基 == 计活) { 域六[计].路径[0] = 0; 域六[计].别.tag = 域路型_域路简; 域六[计].基 = -1; 域六[计].字段[0] = 0; } /* t8 (2026-09-07): 基重赋值 清除其字段路径 (部分移动隔离 — s.x 随 s 重赋值恢复可用) */ } { 字 邻基[96]; 整 邻基长 = 0; 遍 (整 邻扫 = 0; 值[邻扫] && 值[邻扫] != '.' && 值[邻扫] != '['; 邻扫++) { 邻基[邻扫] = 值[邻扫]; 邻基长++; } 邻基[邻基长] = 0; 整 邻基序 = 邻基长 ? 查活变量(邻基) : -1; /* 2026-09-09 遮蔽写端: 拆基名 (s.子 → s) 查活变量 = 当前作用域可见基; 域路成/域路元 条目 只清 同基 (遮蔽同名外层不动, H 漏拦实锤修复; E 误拦同源) */ 遍 (整 计 = 0; 计 < 正次; 计++) 若 (!比较字符串(域六[计].路径, 值)) { 若 (邻基序 >= 0 && 域六[计].别.tag != 域路型_域路简 && 域六[计].基 != 邻基序) 续; 域六[计].路径[0] = 0; 域六[计].别.tag = 域路型_域路简; 域六[计].基 = -1; 域六[计].字段[0] = 0; 返; } } } /* 所有权 #5 (2026-09-05 改造): 重新赋值 = 恢复可用 — 清 移标 (整变量) + 域六 (路径/兜底) */

静 空 错待加(常 字 *名, 整 深) { 若 (!名 || !名[0]) 返; 遍 (整 计 = 0; 计 < 错待数; 计++) 若 (!比较字符串(错待名[计], 名)) { 错待深[计] = 深; 返; } 若 (错待数 < 512) { 复制字符串(错待名[错待数], 名); 错待深[错待数] = 深; 错待数++; } }
静 字 环移旧[128][64]; 静 整 环移旧数 = 0; 静 整 环移变基 = 0; /* P3-15 (2026-09-10): 循环体 前置 已移集合 + 变量数 快照 (循环携带移动 判定) */
静 空 移环开(空) { 环移旧数 = 0; 环移变基 = 变量数; 遍 (整 计 = 0; 计 < 正次 && 环移旧数 < 128; 计++) 若 (域六[计].路径[0]) 复制字符串(环移旧[环移旧数++], 域六[计].路径); 遍 (整 计 = 0; 计 < 变量数 && 环移旧数 < 128; 计++) 若 (移标[计].tag == 移态_已移 && 变量表[计].名[0]) 复制字符串(环移旧[环移旧数++], 变量表[计].名); } /* 快照 源: 域六 (路径部分移动) + 移标 (整变量移动) — 移源 对 有效槽变量 只置移标 不写域六 */
静 整 环移旧有(常 字 *名) { 遍 (整 计 = 0; 计 < 环移旧数; 计++) 若 (!比较字符串(环移旧[计], 名)) 返 1; 返 0; }
静 空 移环查(空) { /* P3-15 (2026-09-10): 循环体内 移出 外部变量 → 回边 (下一轮) 会读已移变量; 循环只解析一遍 → 保守近似: 体尾 报. 体内声明 (变量序 >= 快照) 排除 */
    遍 (整 计 = 0; 计 < 正次; 计++) {
        若 (!域六[计].路径[0] || 环移旧有(域六[计].路径)) 续;
        若 (查活变量(域六[计].路径) < 0) 续; /* 路径名 (a.p / 容器[i]) → 非整变量移动 */
        若 (查活变量(域六[计].路径) >= 环移变基) 续; /* 体内声明 → 每轮重建 */
        格式化到串(错缓冲, "所有权错误: 循环体内 移动 外部变量 '%s' — 循环可能多轮, 下一轮 会读已移变量 (循环携带移动; 若确实只移一次, 请在循环外移, 或每轮重建源)", 域六[计].路径);
        发错误("A3102", 错缓冲);
    }
    遍 (整 计 = 解析基; 计 < 变量数; 计++) {
        若 (计 >= 环移变基 || 移标[计].tag != 移态_已移 || !变量表[计].名[0] || 变量表[计].名[0] == '_') 续;
        若 (环移旧有(变量表[计].名)) 续; /* 循环前 已移 → 与本轮无关 */
        格式化到串(错缓冲, "所有权错误: 循环体内 移动 外部变量 '%s' — 循环可能多轮, 下一轮 会读已移变量 (循环携带移动; 若确实只移一次, 请在循环外移, 或每轮重建源)", 变量表[计].名);
        发错误("A3102", 错缓冲);
    }
}
静 整 错待查(常 字 *名) { 若 (!名 || !名[0]) 返 0; 遍 (整 计 = 0; 计 < 错待数; 计++) 若 (!比较字符串(错待名[计], 名)) 返 1; 返 0; }
静 整 错误转存标[65536]; /* A1 (2026-09-11): 变量 曾 转存 错误函数 结果 (错误联合值) — 在 错误函数 内 裸返 该变量 会 丢 错误 tag → 上游 尝试 静默 吞错; 本表 供 诊断 */
静 空 错误转存加(常 字 *名) { 整 序 = 查活变量(名); 若 (序 >= 0 && 序 < 65536) 错误转存标[序] = 1; }
静 整 错误转存查(常 字 *名) { 整 序 = 查活变量(名); 返 (序 >= 0 && 序 < 65536 && 错误转存标[序]) ? 1 : 0; }
静 整 错联字段源(整 节点) { /* R411: 解构 源 是否「错误联合**存储**」—— 变量 或 一级成员 (`s.值`); 纯查表 不发射 (与 `内存地址` 不同, 后者会污染码生成全局态) */ 若 (节点 < 0) 返 0; 若 (节型别[节点] == 节点_变量) 返 错联查名((字*)(节名表 + 节点)); 若 (节型别[节点] == 节点_成员 || 节型别[节点] == 节点_箭头) { 整 基R411 = 子0[节点]; 若 (基R411 < 0) 返 0; 整 构R411 = 序七(基R411); /* R421 (2026-09-30): 基类型推导 由「必须 变量节点」放宽到 `序七` —— 后者已覆盖 变量 / 下标(数组元素 `阵[0].值`) / 成员链 / 解引用 / 取址 / 调用 / 三元 六族（L5211 定义, 早于本函数）⟹ 数组元素源 与 变量源/字段源 **同构** 拆包. 原判据 `节型别[基R411] != 节点_变量` 把 `阵[0].值` 静默挡在门外（f5 实测 `t=-77` 保持初值）*/ 若 (构R411 < 0) 返 0; 整 序R411 = 字段序(构R411, (字*)(节名表 + 节点)); 返 (序R411 >= 0 && 类型表[构R411].字段[序R411].错联标) ? 1 : 0; } 若 (节型别[节点] == 节点_下标) { /* R425: **数组元素本身是错误联合** (`错误 整 阵[2]; 解构(v,t) = 阵[0];`) —— 根变量带变量级 `错联标` 即判为元素承载错误联合. ⚠️ 不设 `变量指深查 == 0` 守卫: 数组变量的指深本就是 1（插桩实测 `pd=1`）⟹ 该守卫会恒假 */ 整 根R425 = 子0[节点]; 若 (根R425 >= 0 && 节型别[根R425] == 节点_变量) 返 错联查名((字*)(节名表 + 根R425)); 返 0; } 返 0; }
静 整 错联查名(常 字 *名) { 整 序 = 查活变量(名); 返 (序 >= 0 && 序 < 65536 && 错联标[序]) ? 1 : 0; }
静 整 变量错载宽(常 字 *名)
{ /* R438b (2026-09-30 虾米 · 第 438 站 · D-10 收口): 错误联合 变量 的 **载荷宽度**(字节).
     「tag 高32 | 值 低32」同槽 packed 约定 只覆盖 **≤4B 标量** (值槽 8B 装得下 值+tag);
     更宽 的 载荷 (长整/双精度/指针 8B · 构值 sret · 宽元素数组) tag **无载体** ⟹ 解构 必须 拒绝.
     实测 (第 438 站 载荷矩阵): `错误 整` ✅ / `错误 长 长` t=232 v=垃圾 / `错误 构 S` v.x=0 / 16B 构 t=2 —— 全 静默错值. */
    整 序R438b = 查活变量(名);
    若 (序R438b < 0) 返 4;
    若 (变量表[序R438b].数组尺寸 > 0) { 整 元R438b = 变量表[序R438b].数组元素尺寸; 返 元R438b > 0 ? 元R438b : 4; }
    若 (变量表[序R438b].构尺寸 > 0) 返 8; /* 构值载荷: 走 sret/rax 约定, 同槽 packed 不适用 (半宽 构 亦 实测错值) */
    若 (变量表[序R438b].是否长标 || 变量表[序R438b].是否浮标) 返 8;
    若 (变量表[序R438b].指元素尺寸 >= 8 || 变量表[序R438b].指深 > 0) 返 8;
    返 4;
}


静 整 本声明错联(常 字 *名)
{ /* R438 (2026-09-30 虾米 · 第 438 站 · D-10 根治): **按「本声明 名 词元序」回查 `错误` 前缀** ——
     取代 R425 的纯按名字回查 (`预扫错误名`). 纯名字 判据 会 把 **同名 但 别处** 的 `错误 X 名`
     (乃至 预置 头文件/运行库里 同名的 局部 a) 也算到 本声明 头上 —— 第十轮 插桩 铁证:
     用户写的 `错误 构 S a` 让 prelude 里 另一个 `a` 的 登记点 `错联待=1` (跨声明 污染).
     本判据 三点 收紧:
       ① 从 `词位` 反向 找 **本声明 的 名词元** (反向 越过 `;`/`{`/`}` ⟹ 放弃 = 本声明 无名);
       ② 该 名词元 之前 1..5 词元 内 必须 有 `错误` 词元 (`错误位[]` 权威, **绝对词元序**,
          不随 解析进度 漂移 —— R425 已证 词位窗口 对 `[N]` 之后的 数组声明 失效);
       ③ 二者 之间 不得有 `;` `=` `(` `{` `}` (必须 是 同一 声明 的 类型前缀).
     自校验: 名词元 文本 必须 == 名 ⟹ 生成临时名 (`__dp_0_` 等) / 查不到 一律 返 0 (安全侧). */
    若 (!名 || !名[0] || 名[0] == '_') 返 0;
    整 名序R438 = -1;
    遍 (整 探R438 = 词位 - 1; 探R438 >= 0 && 探R438 > 词位 - 40; 探R438--) {
        若 (词型表[探R438] == 分号 || 词型表[探R438] == 左花 || 词型表[探R438] == 右花) 断;
        若 (词型表[探R438] == 词变量 && !比较字符串(词名表[探R438], 名)) { 名序R438 = 探R438; 断; }
    }
    若 (名序R438 < 0) 返 0;
    遍 (整 乙R438 = 0; 乙R438 < 错误位数; 乙R438++) {
        整 错R438 = 错误位[乙R438];
        若 (错R438 >= 名序R438 || 名序R438 - 错R438 > 5) 续;
        整 净R438 = 1;
        遍 (整 转R438 = 错R438 + 1; 转R438 < 名序R438; 转R438++)
            若 (词型表[转R438] == 分号 || 词型表[转R438] == 赋号 || 词型表[转R438] == 左括 || 词型表[转R438] == 左花 || 词型表[转R438] == 右花) 净R438 = 0;
        若 (净R438) 返 1;
    }
    返 0;
}
静 空 新条目名(常 字 *数)
{ /* R438 (D-10 根治 · **变量表 新条目 单点收口**): 名 复制 + 错误联合标记 落位.
     病灶: 原 15 个 建条目点 里 **只有** `变量偏移`(标量) 与 `末午`(定长数组) 两处 写 `错联标`
     ⟹ `变构`(构值) `余乙`(长整) `变浮`(浮) `变偏指`(指针) `变量静态`(静态) `半一`(外部)
     `隔排`/`中退`(静态聚合) `变参`(形参) 诸路径 一律 缺登记 → 解构判据 `错联查名` 恒 0
     → 拆包路径 不命中 → `错待消` 不执行 → 作用域退出 报 A9001「转存未检查」.
     载荷宽度矩阵 实测 (第 438 站): `错误 整`(4B) ✅ / `错误 长 长`(8B) ❌ / `错误 构 S`(4B/8B/16B) ❌
     —— 全部倒在同一 缺标记. */
    复制字符串(变量表[变量数].名, 数);
    外壹(数);
    错联标[变量数] = 错联待;
    错联待 = 0;
}
静 整 预扫错误名(常 字 *名) { /* R425 (2026-09-30): 变量声明通道 —— 「本声明是否 `错误 T 名`」= 遍历**全局预扫描** `错误位[]`, 在 `错误` 之后 1..5 词元内找**同名 词变量**（遇 `左括` 提前停）. 与 `预扫错误函` 同构（后者服务 函数返回类型）；**不依赖解析进度** ⟹ 数组/指针声明同样有效 */ 若 (!名 || !名[0] || 名[0] == '_') 返 0; 遍 (整 乙N = 0; 乙N < 错误位数; 乙N++) { 整 基N = 错误位[乙N]; 遍 (整 步N = 1; 步N <= 5; 步N++) { 整 位N = 基N + 步N; 若 (位N < 0 || 位N >= 词容量) 断; 若 (词型表[位N] == 左括) 断; 若 (词型表[位N] == 词变量 && !比较字符串(词名表[位N], 名)) 返 1; } } 返 0; }
静 空 错待消(常 字 *名) { 若 (!名 || !名[0]) 返; 遍 (整 计 = 0; 计 < 错待数; ) { 若 (!比较字符串(错待名[计], 名)) { 遍 (整 乙 = 计; 乙 < 错待数 - 1; 乙++) { 复制字符串(错待名[乙], 错待名[乙 + 1]); 错待深[乙] = 错待深[乙 + 1]; } 错待数--; } 否 计++; } } 静 整 预扫错误函(常 字 *名) { 若 (!名 || !名[0]) 返 0; 遍 (整 乙 = 0; 乙 < 错误位数; 乙++) { 整 基 = 错误位[乙]; 遍 (整 步 = 1; 步 <= 5; 步++) { 整 位 = 基 + 步; 若 (位 < 0 || 位 >= 词容量) 断; 若 (词型表[位] == 左括) 断; 若 (词型表[位] == 词变量 && !比较字符串(词名表[位], 名)) 返 1; } } 返 0; } 静 整 根节点可复制(整 根节) { 若 (根节 < 0) 返 1; 字 根型名丙[64]; 变量类型名((字*)(节名表 + 根节), 根型名丙); 若 (查类型(根型名丙) < 0) 返 1; 返 类型可复制(根型名丙); } /* R306 (2026-09-26 启元 · 第 364 站 round 36) **Copy 语义 × 部分移动 的一致性补齐**: 登记端 简单变量分支 (L12434) 有 `!类型可复制(源类型名)` 门控 (#9 Copy 类型豁免源失效), 而 **字段分支 (L12439 本体) 与 下标分支 (L12460)** 都没有 —— 同族路径不对称。实测 (探针 m36a-m36g, 编译器 02C713C0): 同一个 **全标量构 (自动 Copy)** 变量 `p`: 整体移动 后 读源 **放行** (m36c), 而 字段移动 后 读该字段 **报 A3101** (m36e) ⟹ 同一原则 两态不一致。 权威判据 = 既有锚 `feat_zh_copy_semantics9.c` 头注释:「#9 拷贝语义 Copy: 复制 T; 标记类型可拷贝 — 移入 目标, 源 对 Copy 类型 不失效源 (Rust Copy trait; C 按位复制默认)」+ `feat_zh_copy_semantics9_neg.c` 注释「自动派生 #16 后 全标量构 自动 Copy」。 修法 = 给 字段/下标 两个分支 补同款门控 (用 本 helper 把「根变量类型名 → 类型可复制」包成一行谓词, 避免 长行内 嵌套 插入 括号)。 非 Copy 类型 (含指针/显式析构) 行为 **完全不变** (helper 返 0 ⟹ `!0` 为真 ⟹ 原逻辑照走; 实测 m36b/m36g/m36d 都不变)。 查不到类型时 返 1 (视为 Copy ⟹ 跳过登记) —— 保守方向 = 放宽, 不会产生新误报。 */ /* R305 (2026-09-26 启元 · 第 364 站 round 35) **错误联合 应拒面 补全**: 被调函数 **定义在 调用点 之后** 时 函数表 尚未登记 ⟹ 下组() (L3421, 查 函数表.返错) 返假 ⟹ 调用点 L7895 不标记 结果_错 ⟹ 三个 A9001 消费点 (元得 L3439 / 实参 L7872 / 返回 L11695) 全不触发 = 漏。 实测矩阵 (2x2, 探针 m35a-m35d): f 前置定义 x {转存, 不转存} 两形态 都报 A9001; f 后置定义 两形态 都漏 ⟹ 唯一变量 = 定义位置, **与转存无关** (原 锚注释 把它 归于「转存」路径 是 定性错误)。 修法 = 复用 词法器 **全文件预扫** 的 错误位[] (L2825 声明 / L6786 填充; 函数定义处 L19589 早就在用 同一张表 做窗口匹配) 按 **名字** 回查 ⟹ **无需第二遍解析**。 窗口 = 错误 词之后 1..5 词元 内 命中 同名 词变量 (容 错误 整数 f / 错误 长 长 f / 错误 结构体 X *f 等); 遇 左括 提前停。 位置 约束: 本 helper 必须在 词型枚举 (L4657: 左括/词变量) 之后 —— 首版 误放 L3421 旁 ⟹ 单遍编译器报「未声明标识符 '左括'」⟹ 第 1 代 编译失败 (本轮 实测踩坑)。 纯 C 语料 (git/zlib/lua) 无 错误 关键字 ⟹ 错误位数=0 ⟹ 本判据 恒假 ⟹ 零影响。 */
静 空 错待转(整 节点, 常 字 *目标) { /* P3-14: 错误结果 转存 (声明初始化 / 赋值) — 结果 带"未检查"标记 → 目标变量 转 待检查态; 源是 待检查变量 → 状态转移 (转存不丢检查义务, k 转存 后检查 仍算数) */
    若 (!目标 || !目标[0]) 返;
    若 (节点 >= 0 && 节型别[节点] == 节点_变量) { 字 *源名 = (字*)(节名表 + 节点); 若 (错待查(源名)) { 错待消(源名); 错待加(目标, 净丙); 错误转存加(目标); 返; } }
    若 (节点 >= 0 && 实重[节点].tag == 结果_错) { 错待加(目标, 净丙); 实重[节点].tag = 结果_值; 错误转存加(目标); } 若 (节点 >= 0 && 节型别[节点] != 节点_变量 && 错联字段源(节点)) { 错待加(目标, 净丙); 错误转存加(目标); } /* R423 (2026-09-30): **第三条路径 —— 源是「非变量的错误联合存储」**（字段 `s.值` / 数组元素 `阵[0].值`）. 原两条路径只覆盖「变量源」与「**调用**源」（后者靠 L7995 给调用节点打 `结果_错`）⟹ `错误 整 tmp = s.值;` 既非变量源、RHS 又非调用 ⟹ 目标**无「待检查」义务** ⟹ 后续裸消费（`长 长 w = tmp;`）静默丢 tag 而不报 A9001（对照: `错误 整 e = 造(-1);` 被正确拒绝）. 判据复用 `错联字段源`（R411/R421 建立 —— 「该存储位类型是错误联合」），范围**收窄到非变量**：变量源已由路径①按「是否已检查」精确处理 ⟹ 本刀对「已检查过的变量再复制」零影响 */
}
静 空 错待退(整 深) { /* P3-14: 作用域退出 — 本作用域内 转存 却 从未检查的 错误结果 → A9001 (严格面: 纪律要求 必须检查) */
    遍 (整 计 = 0; 计 < 错待数; ) {
        若 (错待深[计] > 深) { 若 (序集) { 格式化到串(错缓冲, "错误 联合: 变量 '%s' 转存了错误函数结果 但从未检查 (可能错误码 未判) — 用 若 (%s == 码) 显式判断, 或 尝试 f(); 传播 (类型根治②, 号合.0 #72)", 错待名[计], 错待名[计]); 发错误("A9001", 错缓冲); }
            遍 (整 乙 = 计; 乙 < 错待数 - 1; 乙++) { 复制字符串(错待名[乙], 错待名[乙 + 1]); 错待深[乙] = 错待深[乙 + 1]; } 错待数--;
        } 否 计++;
    }
}

静 空 移标记(整 计活, 整 型); /* 前向: 分支精确 移动日志 (定义在 参移动 后) */
静 空 移源(常 字 *名, 整 型); /* 前向: 移动源统一 (置移标+注销守卫) */
静 空 源移动(整 末凶, 整 数) { /* 所有权 S4 (2026-09-05 虾米): 赋值 = 默认移动 (Rust 式) — RHS 非 Copy 拥有型变量 → 源置已移 (后续读 A3101); 自赋值 a=a 豁免; Copy 类型/标量/指针 豁免 (类型可复制); 仅 甲言模式 + 默认移动开 (宏门) */
    若 (!默认移动开 || !甲言模式 || 末凶 < 0 || 节型别[末凶] != 节点_变量) 返;
    若 (数 >= 0 && 节型别[数] == 节点_变量 && !比较字符串((字*)(节名表 + 数), (字*)(节名表 + 末凶))) 返; /* 自赋值 a=a 豁免 */
    { 字 源型名[64]; 变量类型名((字*)(节名表 + 末凶), 源型名); 若 (变量指深查((字*)(节名表 + 末凶)) > 0) 返; 若 (类型可复制(源型名)) 返; 移源((字*)(节名表 + 末凶), 0); } /* 第83站 C299: **指针豁免** —— 指针赋值/传参 = 拷贝; `变量类型名` 丢 `*` ⟹ `类型可复制` 误判非 Copy ⟹ 指针被标已移动 ⟹ 后续读 A3101 (prelude `qcc_deflate_state *st` 实测) */
}
静 空 参移动(整 实节) { /* 所有权 S4 (2026-09-05 虾米): 传参 = 默认移动 — 非 Copy 拥有型实参变量按值传入 → 源置已移 (所有权进函数); 指针/标量/Copy 类型豁免 */
    若 (!默认移动开 || (!甲言模式 && !(单粗 >= 0 && 单粗 < 65536 && 借模式[单粗])) || 实节 < 0 || 节型别[实节] != 节点_变量) 返; /* 2026-09-10 E4: 判据加 借模式[单粗] — 英文 struct + 中文借用 (借用语句激活函数级) 场景 甲言模式=0 但借模式=1, 原漏所有权传参移动 */
    { 字 源型名[64]; 变量类型名((字*)(节名表 + 实节), 源型名); 若 (变量指深查((字*)(节名表 + 实节)) > 0) 返; 若 (类型可复制(源型名)) 返; 若 (当繁((字*)(节名表 + 实节)) >= 0) { 格式化到串(错缓冲, "借用检查: 变量 '%s' 被借用, 不能按值传参 (借用期所有权不可转移, 号合.0 #10)", (字*)(节名表 + 实节)); 发错误("A3004", 错缓冲); } 移源((字*)(节名表 + 实节), 0); }
}
/* 所有权 分支精确 (2026-09-05 虾米): 若/否则 兄弟分支移动隔离 + 汇合毒化 (Rust 语义) — 移标置点统一走 移标记(计活,型) 记 分支事件; 普通移动(0) 汇合后毒化 (任一分支移过即 A3101), 返移动(1) 分支内撤销 (返路径不达汇合); else 入口撤销 then 移动 (兄弟隔离); 循环体 不设范围 (Rust 保守: 循环可能迭代 → 体移动 毒化循环后, 线性天然满足) */
静 整 移支顶 = 0; 静 整 移事A数[128]; 静 整 移事B数[128]; 静 字 移已转[128];
静 构 { 整 序; 字 型; 整 终; } 移支表A[128][256]; 静 构 { 整 序; 字 型; } 移支表B[128][256]; /* A3-e2 (2026-09-12): 移事A/移型A/移事A终 与 移事B/移型B 平行数组 → 结构体数组 (分支移动撤销日志) */
静 空 移标记(整 计活, 整 型) { /* 置移标 + 分支事件日志 (型 0=普通 1=返) */
    若 (计活 < 0 || 计活 >= 65536) 返;
    移标[计活].tag = 移态_已移;
    若 (移支顶 <= 0 || 移支顶 > 128) 返;
    整 层 = 移支顶 - 1;
    若 (移已转[层]) { 若 (移事B数[层] < 256) { 移支表B[层][移事B数[层]].序 = 计活; 移支表B[层][移事B数[层]].型 = 型; 移事B数[层]++; } }
    否 若 (移事A数[层] < 256) { 移支表A[层][移事A数[层]].序 = 计活; 移支表A[层][移事A数[层]].型 = 型; 移事A数[层]++; }
}
静 空 移源(常 字 *名, 整 型) { /* 移动源 统一: 置移标/日志 + 注销守卫 (所有权移走 → 作用域退出不得再析构源; 防同值双析构) */
    借用 名;
    若 (!名 || !名[0]) { 放还 名; 返; }
    { 整 静标 = 0; 遍 (整 计 = 变量总数() - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 名) && 变量码生成可见(计) && 变量表[计].是否静态标) { 静标 = 1; 断; } 若 (静标) { 放还 名; 返; } } /* 修复 2026-09-08 (mutex2 A3101): 静态/全局 非函数所有, 永不移动 — 原 置移标 于 全局槽 跨函数泄漏 (return 静态 → 后续函数读 误 A3101 已移动) */
    若 (接口引用冻结(名)) { 格式化到串(错缓冲, "接口: 目标对象 '%s' 被接口引用冻结, 不能移动 (接口引用持有目标 的槽地址, 移走后 经接口调用 读的已是移出的旧内存; #195 动态多态)", 名); 发错误("A3001", 错缓冲); } /* P3-6b (2026-09-10): 原 冻结只拦'写'(L5785), 移动源 未查 → 接口引用 持有的对象 被移走后 经接口调用 仍读旧槽 (use-after-move 漏拦) */
    { 整 变槽6 = 查活变量(名); 若 (变槽6 >= 0) { 整 部移6 = 0; 遍 (整 域扫6 = 0; 域扫6 < 正次; 域扫6++) 若 (域六[域扫6].别.tag != 域路型_域路简 && 域六[域扫6].基 == 变槽6) { 部移6 = 1; 断; } 若 (部移6) { 格式化到串(错缓冲, "所有权错误: 变量 '%s' 的部分字段已移出, 不能整体移动 (部分移动后整对象不可再用 — Rust E0382 精神; 先重新赋值恢复, 或只移动其余字段)", 名); 发错误("A3102", 错缓冲); } } } /* P3-1 (2026-09-10): 部分移动 (移入 q, a.p) 后 整变量移动/按值传参/返回 原静默放行 → 读悬垂/双所有权; 域六 成员条目 (基序 = 该变量) 存在 即 部分已移出; 路径名 (a.p) 查活变量 得 -1 → 天然跳过 */
    { 整 计活 = 查活变量(名); 若 (计活 >= 0) 移标记(计活, 型); 否 若 (正次 < 2048) { 复制字符串(域六[正次++].路径, 名); 域六[正次 - 1].别.tag = 域路型_域路简; 域六[正次 - 1].基 = -1; 域标记(名, 型); } }
    整 撤基 = 查活变量(名); 遍 (整 庚序 = 0; 庚序 < 逆汇; 庚序++) 若 (守卫表[庚序].槽名[0] != 0 && !比较字符串(守卫表[庚序].槽名, 名) && (撤基 < 0 || 守卫表[庚序].槽基 < 0 || 守卫表[庚序].槽基 == 撤基)) { 守卫表[庚序].槽串 = 0; 触记(庚序); } /* 注销守卫 (攻坚 G6 2026-09-06: 只撤就绪位保留槽 — 重赋值可 副轮 重新武装; 块退出强制清 未就绪同层槽) */ /* BatchB2: 撤就绪事件 记冲刷 (语句边界 F=0, 覆盖 调用传参移动 等) */
    放还 名;
}
静 整 节点判(整 暂) { 若 (暂 == 0) 返 节点_常数; 若 (暂 == 1) 返 节点_变量; 若 (暂 == 2) 返 节点_二元; 若 (暂 == 3) 返 节点_块; 若 (暂 == 4) 返 节点_调用; 若 (暂 == 5) 返 节点_作用域块; 若 (暂 == 6) 返 节点_返节; 若 (暂 == 7) 返 节点_声明节; 若 (暂 == 8) 返 节点_条件; 若 (暂 == 9) 返 节点_循环节; 若 (暂 == 10) 返 节点_赋值; 若 (暂 == 11) 返 节点_取址; 若 (暂 == 12) 返 节点_解引用; 若 (暂 == 13) 返 节点_箭头; 若 (暂 == 14) 返 节点_下标; 若 (暂 == 15) 返 节点_成员; 若 (暂 == 16) 返 节点_中断节; 若 (暂 == 17) 返 节点_非节; 若 (暂 == 18) 返 节点_十八; 若 (暂 == 19) 返 节点_转型; 若 (暂 == 20) 返 节点_标号; 若 (暂 == 21) 返 节点_继续节; 若 (暂 == 22) 返 节点_三元; 若 (暂 == 23) 返 节点_增减; 若 (暂 == 24) 返 节点_循环后判; 若 (暂 == 25) 返 节点_跳转节; 若 (暂 == 26) 返 节点_前置增减; 若 (暂 == 27) 返 节点_窄转型; 若 (暂 == 28) 返 节点_借语义; 若 (暂 == 29) 返 节点_串词; 若 (暂 == 65) 返 节点_双字面量; 返 节点_其他; } /* E1e (2026-09-06): 全节点类型映射 (0..28 + 串词29 + 双字面量65) */
静 整 节点含变(整 节, 常 字 *名) { /* 子树扫描: RHS 是否引用 目标变量 (drop-on-overwrite 需先求值后析构, 引用目标则放弃覆写析构) */
    若 (节 < 0 || !名 || !名[0]) 返 0;
    若 (节型别[节] == 节点_变量 && !比较字符串((字*)(节名表 + 节), 名)) 返 1;
    遍 (整 计 = 0; 计 < 23; 计++) { 整 子 = 取子(节, 计); 若 (子 >= 0 && 节点含变(子, 名)) 返 1; }
    返 0;
}
静 整 调用被调者(整 呼) { /* A6 (2026-09-06): 取 call 节点 末子 = 被调者 (实参 0..N-1, 被调者 末; 建节(4) 结构) */
    整 被调 = -1;
    { 整 子 = 节末子(呼); 若 (子 >= 0) 被调 = 取子(呼, 子); } /* A44: 23 槽 硬上限 -> 真末子 */
    若 (被调 >= 0 && 节型别[被调] == 节点_变量) 返 被调;
    返 -1;
}
静 整 表达式内覆写查(整 节) { /* A1 (2026-09-06): 表达式内 (非语句尾) 覆写守卫/析构变量 → 编译期拒 A3110 (防静默漏析构旧值) */
    若 (节 < 0) 返 0;
    若 (节型别[节] == 节点_赋值 && 子0[节] >= 0 && 节型别[子0[节]] == 节点_变量 && 守卫槽找((字*)(节名表 + 子0[节])) >= 0) 返 1;
    遍 (整 计 = 0; 计 < 23; 计++) { 整 子 = 取子(节, 计); 若 (子 >= 0 && 表达式内覆写查(子)) 返 1; }
    返 0;
}
静 空 移动开(空) { 若 (移支顶 < 128) { 移事A数[移支顶] = 0; 移事B数[移支顶] = 0; 移已转[移支顶] = 0; 移支顶++; } }
静 构 { 字 路径[64]; 字 型; 整 基; } 移支域A[128][256]; 静 构 { 字 路径[64]; 字 型; 整 基; } 移支域B[128][256]; 静 整 移事域A数[128]; 静 整 移事域B数[128]; /* A3-e2 (2026-09-12): 移事域A/B + 移型域A/B + 移事域A/B基 平行数组 → 结构体数组 (分支部分移动撤销日志) */ /* 2026-09-09 分支撤销遮蔽修复: 基序 平行表 — 撤销/重投 精确按登记基 (遮蔽同名外层不动) */
静 空 域六清(常 字 *路径, 整 基序) { 借用 路径; 遍 (整 计 = 0; 计 < 正次; 计++) 若 (!比较字符串(域六[计].路径, 路径)) { 若 (基序 >= 0 && 域六[计].别.tag != 域路型_域路简 && 域六[计].基 != 基序) 续; 域六[计].路径[0] = 0; 域六[计].别.tag = 域路型_域路简; 域六[计].基 = -1; 域六[计].字段[0] = 0; 放还 路径; 返; } 放还 路径; } /* 2026-09-09: 基过滤 — 遮蔽分支 内层撤销 不清外层同名 (sp_shadow_branch3 漏拦实锤) */
静 空 域标记(常 字 *路径, 整 型) { /* 部分移动 (域六 路径) 分支日志; 实际登记已在调用处完成 */
    借用 路径;
    若 (!路径 || !路径[0] || 移支顶 <= 0 || 移支顶 > 128) { 放还 路径; 返; }
    整 层 = 移支顶 - 1; 整 记基 = -1; 遍 (整 扫 = 正次 - 1; 扫 >= 0; 扫--) 若 (!比较字符串(域六[扫].路径, 路径)) { 记基 = 域六[扫].基; 断; } /* 2026-09-09: 记基 = 刚登记条目 域六基 (倒序同路径最近; 撤销/重投 按此精确) */
    若 (移已转[层]) { 若 (移事域B数[层] < 256) { 复制字符串(移支域B[层][移事域B数[层]].路径, 路径); 移支域B[层][移事域B数[层]].型 = 型; 移支域B[层][移事域B数[层]].基 = 记基; 移事域B数[层]++; } }
    否 若 (移事域A数[层] < 256) { 复制字符串(移支域A[层][移事域A数[层]].路径, 路径); 移支域A[层][移事域A数[层]].型 = 型; 移支域A[层][移事域A数[层]].基 = 记基; 移事域A数[层]++; }
    放还 路径;
}
静 空 移动转(空) { /* else 入口: 捕获 then 各事件变量终态 + 撤销 then 移动 (兄弟分支隔离, 含 部分移动路径) */
    若 (移支顶 <= 0) 返; 整 层 = 移支顶 - 1; 移已转[层] = 1;
    遍 (整 计 = 0; 计 < 移事A数[层]; 计++) { 整 槽 = 移支表A[层][计].序; 移支表A[层][计].终 = 移标[槽].tag; 移标[槽].tag = 移态_可用; }
    遍 (整 计 = 0; 计 < 移事域A数[层]; 计++) 域六清(移支域A[层][计].路径, 移支域A[层][计].基); /* 撤销 then 部分移动路径 (基感知) */
}
静 空 移动合(空) { /* 若 汇合: then 普通移动 恢复毒化 (终态=移标于 then 结束时); 返移动 保持撤销; else 返移动 撤销; 弹层 */
    若 (移支顶 <= 0) 返; 整 层 = 移支顶 - 1;
    遍 (整 计 = 0; 计 < 移事A数[层]; 计++) { 整 槽 = 移支表A[层][计].序;
        若 (移支表A[层][计].型 == 1) 移标[槽].tag = 移态_可用;
        否 { 若 (!移已转[层]) 移支表A[层][计].终 = 移标[槽].tag; 移标[槽].tag = 移支表A[层][计].终; }
    }
    遍 (整 计 = 0; 计 < 移事B数[层]; 计++) { 整 槽 = 移支表B[层][计].序; 若 (移支表B[层][计].型 == 1) 移标[槽].tag = 移态_可用; }
    若 (移已转[层]) 遍 (整 计 = 0; 计 < 移事域A数[层]; 计++) { 若 (移支域A[层][计].型 == 0 && 正次 < 2048) { 常 字 *重投路径 = 移支域A[层][计].路径; 复制字符串(域六[正次].路径, 重投路径); 字 重投字段[64]; 重投字段[0] = 0; 整 重投末点 = -1; 整 重投含点 = 0; 整 重投含括 = 0; 遍 (整 重投扫 = 0; 重投路径[重投扫]; 重投扫++) { 若 (重投路径[重投扫] == '.') { 重投含点 = 1; 重投末点 = 重投扫; } 否 若 (重投路径[重投扫] == '[') 重投含括 = 1; } 若 (重投含点) { 复制字符串(重投字段, 重投路径 + 重投末点 + 1); 域六[正次].别.tag = 域路型_域路成; } 否 若 (重投含括) 域六[正次].别.tag = 域路型_域路元; 否 域六[正次].别.tag = 域路型_域路简; 域六[正次].基 = 移支域A[层][计].基; 复制字符串(域六[正次].字段, 重投字段); 正次++; } } /* 汇合: then 普通部分移动 重投毒化 — 还原 别(路径推导)/基/字段 (遮蔽读端符号化需) */
    遍 (整 计 = 0; 计 < 移事域B数[层]; 计++) 若 (移支域B[层][计].型 == 1) 域六清(移支域B[层][计].路径, 移支域B[层][计].基); /* else 返移动 撤销 (基感知) */
    移支顶--;
}
静 空 返移节(整 节) { /* 返回=移动 (2026-09-05): 返 简单变量 → 源置移标 (kind=1: 分支内返 不毒化汇合) */
    若 (!甲言模式 && !(单粗 >= 0 && 单粗 < 65536 && 借模式[单粗])) 返; /* P0-15 (2026-09-14): **C 兼容模式 豁免** —— 与 源移动/参移动 门控 一致. 原 本 函数 **无门控** → C 源 `return <聚合变量>;` 也 被 标 已移 → 同函数 后续分支 (含 goto 目标) 读该变量 → A3101 假阳. 实测 git `attr.c` 的 `struct match_attr *res` (parse_attr_line: `return res;` + `fail_return:` 分支 `free(res)`) 卡此. A29 只修了 **非聚合**(标量/指针) 豁免, 聚合 仍 误伤 (本 站 补 模式维度). */
    若 (节 < 0 || 节型别[节] != 节点_变量) 返;
    { 字 源型名[64]; 变量类型名((字*)(节名表 + 节), 源型名); 整 型序 = 查类型(源型名);
      若 (型序 < 0 || 类型表[型序].函 <= 0) 返; /* A29 (2026-09-13): **非聚合豁免** — `return 标量/指针;` 不是所有权移动 (C 与 Rust 一致). 原 一律 置移标 → 循环体内 `return 标量;` 使 循环外 变量 被标已移 → A3102「循环携带移动」假阳 (csmith 差分 11/20 编译失败 全 此 因). ⚠️ 此处 **刻意不调 类型可复制**: 它 会 写 类型表.可复制 缓存位, 对 后续 注册析构 的类型 → 误标 → A3110 (Copy+Drop) 假阳 (实测: feat_zh_typedrop_borrow_ok 回归). 聚合类型 保持 原 置移标 行为 不变. */
    }
    移源((字*)(节名表 + 节), 1);
}

静 整 副酉一(常 字 *串值, 整 尾柒) { /* 过程宏 #172: 生成代码文本 词元 化 → 落位 [于, 于+n); 返回生成 词元 数 (失败 -1) */
    整 丙 = 尾柒; 常 字 *指 = 串值;
    循环 (*指) {
        循环 (*指 == ' ' || *指 == '\t' || *指 == '\n' || *指 == '\r') 指++;
        若 (!*指) 断;
        若 (丙 + 1 >= 词容量) 返 -1;
        内存设置(词名表[丙], 0, 64);
        词行表[丙] = 0; 词无符号表[丙] = 0; 词长表[丙] = 0; 段属[丙] = 0;
        若 ((*指 >= 'A' && *指 <= 'Z') || (*指 >= 'a' && *指 <= 'z') || *指 == '_') { /* 标识符 */
            整 乙 = 0;
            循环 (乙 < 63 && ((*指 >= 'A' && *指 <= 'Z') || (*指 >= 'a' && *指 <= 'z') || (*指 >= '0' && *指 <= '9') || *指 == '_')) 词名表[丙][乙++] = *指++;
            词型表[丙] = 词变量; 词值表[丙] = 0; 丙++;
        } 否 若 (*指 >= '0' && *指 <= '9') { /* 数字 */
            整 值 = 0; 整 域厚 = 0;
            若 (指[0] == '0' && (指[1] == 'x' || 指[1] == 'X')) { 域厚 = 1; 指 += 2; }
            循环 ((*指 >= '0' && *指 <= '9') || (域厚 && ((*指 >= 'a' && *指 <= 'f') || (*指 >= 'A' && *指 <= 'F')))) {
                整 元 = (*指 >= 'a') ? (*指 - 'a' + 10) : (*指 >= 'A') ? (*指 - 'A' + 10) : (*指 - '0');
                值 = 值 * (域厚 ? 16 : 10) + 元; 指++;
            }
            词型表[丙] = 常数; 词值表[丙] = 值; 丙++;
        } 否 若 (*指 == '"') { /* 字符串字面量 */
            指++; 字 间聚[4096]; 整 乙 = 0;
            循环 (*指 && *指 != '"' && 乙 < 4095) { 若 (*指 == '\\' && 指[1]) { 指++; 若 (*指 == 'n') 间聚[乙++] = '\n'; 否 若 (*指 == 't') 间聚[乙++] = '\t'; 否 若 (*指 == '0') 间聚[乙++] = 0; 否 间聚[乙++] = *指; } 否 间聚[乙++] = *指; 指++; }
            若 (*指 == '"') 指++;
            间聚[乙] = 0;
            若 (串数 >= 65536) 返 -1;
            若 (!串表[串数]) 串表[串数] = 短六();
            复制字符串(串表[串数], 间聚);
            词型表[丙] = 串词; 词值表[丙] = 串数; 串数++; 丙++;
        } 否 { /* 运算符 */
            字 字符 = *指;
            字 字符二 = 指[1];
            整 暂;
            若 (字符 == '+' ) { 若 (字符二 == '+') { 暂 = 增增; 指++; } 否 若 (字符二 == '=') { 暂 = 加等; 指++; } 否 暂 = 加; }
            否 若 (字符 == '-') { 若 (字符二 == '>') { 暂 = 箭头; 指++; } 否 若 (字符二 == '-') { 暂 = 减减; 指++; } 否 若 (字符二 == '=') { 暂 = 减等; 指++; } 否 暂 = 减; }
            否 若 (字符 == '*') { 若 (字符二 == '=') { 暂 = 乘等; 指++; } 否 暂 = 乘; }
            否 若 (字符 == '/') { 若 (字符二 == '=') { 暂 = 除等; 指++; } 否 暂 = 除; }
            否 若 (字符 == '%') { 若 (字符二 == '=') { 暂 = 隔伍; 指++; } 否 暂 = 取余; }
            否 若 (字符 == '&') { 若 (字符二 == '&') { 暂 = 逻辑与; 指++; } 否 暂 = 点; }
            否 若 (字符 == '|') { 若 (字符二 == '|') { 暂 = 逻辑或; 指++; } 否 暂 = 或; }
            否 若 (字符 == '^') { 若 (字符二 == '=') { 暂 = 异或等; 指++; } 否 暂 = 异或; }
            否 若 (字符 == '!') { 若 (字符二 == '=') { 暂 = 顺八; 指++; } 否 暂 = 总零; }
            否 若 (字符 == '=') { 若 (字符二 == '=') { 暂 = 高平; 指++; } 否 暂 = 赋号; }
            否 若 (字符 == '<') { 若 (字符二 == '<') { 暂 = 左移; 指++; } 否 若 (字符二 == '=') { 暂 = 元九; 指++; } 否 暂 = 下双; }
            否 若 (字符 == '>') { 若 (字符二 == '>') { 暂 = 右移; 指++; } 否 若 (字符二 == '=') { 暂 = 首降; 指++; } 否 暂 = 终附; }
            否 若 (字符 == '(') 暂 = 左括;
            否 若 (字符 == ')') 暂 = 右括;
            否 若 (字符 == '[') 暂 = 左方;
            否 若 (字符 == ']') 暂 = 右方;
            否 若 (字符 == '{') 暂 = 左花;
            否 若 (字符 == '}') 暂 = 右花;
            否 若 (字符 == ';') 暂 = 分号;
            否 若 (字符 == ',') 暂 = 逗号;
            否 若 (字符 == '.') 暂 = 句点;
            否 若 (字符 == ':') 暂 = 冒号;
            否 若 (字符 == '?') 暂 = 问号;
            否 若 (字符 == '~') 暂 = 按位非;
            否 返 -1;
            词型表[丙] = 暂; 词值表[丙] = 0; 词名表[丙][0] = 字符; 丙++; 指++;
        }
    }
    返 丙 - 尾柒;
}
静 空 尾逃逸(整 目节) { /* I2-③ 余项 (2026-09-10): &expr 取地址 = 潜在写 → 按 成员路径 字段级登记 (原 只认 裸变量 → &s.a 后 读 s.a 误 A4001 假阳); 裸变量/纯下标/解引用 仍 整体保守 (未初始化移除) */ 若 (目节 < 0) 返; 整 逃基 = 目节; 整 逃跳 = 0; 整 逃深 = 0; 整 逃直 = -1; 循环 (逃基 >= 0 && 逃跳 < 8 && (节型别[逃基] == 节点_下标 || 节型别[逃基] == 节点_成员 || 节型别[逃基] == 节点_箭头 || 节型别[逃基] == 节点_解引用)) { 若 (节型别[逃基] == 节点_成员) { 逃直 = 逃基; 逃深++; } 逃基 = 子0[逃基]; 逃跳++; } 若 (逃基 < 0 || 节型别[逃基] != 节点_变量) 返; 若 (逃跳 == 0) { 未初始化移除((字*)(节名表 + 逃基)); 返; } 若 (尾索((字*)(节名表 + 逃基)) < 0) { 若 (尾阵索((字*)(节名表 + 逃基)) >= 0) 尾阵触((字*)(节名表 + 逃基), -1); 返; } /* A76 (2026-09-14): 数组 变量 **只** 进 「就绪阵丙」(元素级) 而 **不** 进 「就绪丙」(标量) ⇒ 原 早退 ⇒ `&arr[i]` (取地址 = 潜在写) 被 忽略 ⇒ 后续 读 `arr[i]` 误 A4001 (实测 r3: `init_tree_desc(&t[0]); t[1] = t[0];` 报 t[0] 未初始化). 修: 数组 改走 `尾阵触(名, -1)` —— “动态下标 降 不追踪”, 整个 数组 视为 已触 (保守豁免). */ 若 (逃深 <= 1) { 若 (逃直 >= 0) 尾写字段((字*)(节名表 + 逃基), (字*)(节名表 + 逃直)); 否 未初始化移除((字*)(节名表 + 逃基)); } 否 { 字 逃径[48]; 逃径[0] = 0; 整 逃游 = 目节; 整 逃游跳 = 0; 循环 (逃游 >= 0 && 逃游跳 < 8 && (节型别[逃游] == 节点_下标 || 节型别[逃游] == 节点_成员 || 节型别[逃游] == 节点_箭头 || 节型别[逃游] == 节点_解引用)) { 若 (节型别[逃游] == 节点_成员) { 若 (逃径[0]) { 字 逃新[48]; 格式化到串(逃新, "%s.%s", (字*)(节名表 + 逃游), 逃径); 复制字符串(逃径, 逃新); } 否 { 复制字符串(逃径, (字*)(节名表 + 逃游)); } } 逃游 = 子0[逃游]; 逃游跳++; } 尾写路径((字*)(节名表 + 逃基), 逃径); } 若 (尾阵索((字*)(节名表 + 逃基)) >= 0) { 整 阵游2 = 目节; 整 阵跳2 = 0; 循环 (阵游2 >= 0 && 阵跳2 < 8 && 子0[阵游2] != 逃基) { 阵游2 = 子0[阵游2]; 阵跳2++; } 若 (阵游2 >= 0 && 节型别[阵游2] == 节点_下标) { 整 阵索2 = 子1[阵游2]; 若 (阵索2 >= 0 && 节型别[阵索2] == 节点_常数) 尾阵触((字*)(节名表 + 逃基), 节值表[阵索2]); 否 尾阵触((字*)(节名表 + 逃基), -1); } } } /* I2-③: 与 赋值目标 登记同构 (读写两侧同构 — 成员深度 + 路径 + 元素 touched) */
静 整 后缀链(整 底) { /* A13 合一 (2026-09-15): **后缀链 唯一权威** — 下标 [i] / 成员 .f / 箭头 ->f / 可选链 ?. / 自增减 ++-- / 调用 (..) 三处 平行副本 (主后缀 L7926-8079 / 转型副本 L8189-8203 / 括号副本 L8253-8299) 合一于此. 原 三副本 差异巨大 (主后缀 ~150 行 含 越界/借用/未初始化/类型检查/接口展开/契约审判; 转型 ~15 行 极简; 括号 ~45 行 中等) ⟹ 「同一语义 多条路径 改一漏一」温床. 合一后 副作用 靠 `节型别[底]==节点_变量/调用` 等 守卫 自然 区分 上下文 (转型/括号 上下文 的 变量基 后缀 同样 获得 检查 ⟹ 补齐 历史 遗漏; 非变量基 自然 跳过). 底 = 被后缀的 表达式节点; 返 = 链头 节点. */
