                    整 新浅 = (链退 + 7) / 8;
                    若 (素系((字*)(节名表 + 字符))) {
                        移寄存器帧64(10, 元平 - 当前帧大小); /* r10 = 拷贝 指针 (参数 槽位 持有 该 地址) */
                    } 否 若 (短弊一) {
                        码生成免解引用 = 1; 码生成(字符); 码生成免解引用 = 0; /* 堆九 = &h[i] (结构体 数组 元素) */
                        移64(10, 0); /* r10 = &h[i] */
                    } 否 若 (变量是否静态((字*)(节名表 + 字符))) {
                        度一(静态位移(元平, 1) - 1); 移64(10, 0); /* 静态 结构体 变量 → r10 = .数据 地址 (修复 2026-08-07) */
                    } 否 {
                        取帧址(10, 变量基((字*)(节名表 + 字符), 元平) - 当前帧大小); /* r10 = &局部 结构体 数据 */
                    }
                    槽高[槽数] = 总计数 + 新浅 * 8; /* 该 地址 槽位 sits 以上 该 拷贝 块 */
                    若 (取环境("QCC_DBG_ARG")) 输出到文件(错误流, "[ARG] bigsz=%d slot_h[%d]=%d total_h=%d fname=%s\n", 链退, 槽数, 槽高[槽数], 总计数, 串升);
                    遍 (整 顺戊 = 新浅 - 1; 顺戊 >= 0; 顺戊--) {
                        汇发("    取64 r0, [r10+%d]\n", (字*)(长 长)(顺戊 * 8), (字*)(长 长)0, (字*)(长 长)0); /* 移动 堆九, [r10+顺戊*8] (修复 2026-08-03: bare 发射 已有 无 -S 文本 → 计简一 已压 uninit 堆九) */
                        发字节(0x49); 发字节(0x8B); 发字节(0x42); 发字节(顺戊 * 8); /* 移动 堆九, [r10 + 顺戊*8] */
                        压栈寄存器(0);
                    }
                    汇发("    取址 r0, [rsp+0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x8D); 模字节(1, 0, 4); 发字节(0x24); 发字节(0); /* 取址 堆九, [rsp+0] = 拷贝 开始 (修复 2026-08-03: bare 取址 堆九,[rsp] 已有 无 -S 文本; disp8 form 匹配 中文汇编 取址) */
                    压栈寄存器(0); /* 实参 槽位 = 地址 的 该 拷贝 */
                    总计数 += (新浅 + 1) * 8;
                } 否 {
                    /* 修复 2026-08-21 #25: 参数是 列败 调用 (>8B 结构体 返回, 非指针) — 栈上分配临时,
                       列败 写入, 按 链退 传地址 (原走普通 32 位压栈 → 被调者 写垃圾 rcx 崩) */
                    整 双退 = -1, 长三 = 0;
                    若 (节型别[字符] == 节点_调用) {
                        字 *内壹 = NULL;
                        遍 (整 外劣 = 19; 外劣 >= 0; 外劣--) { 整 堆散 = 取子(字符, 外劣); 若 (堆散 >= 0 && 节型别[堆散] == 节点_变量) { 内壹 = (字*)(节名表 + 堆散); 断; } }
                        若 (内壹) { 双退 = 查返回名(内壹); 长三 = 查返回名指(内壹); }
                        若 (双退 < 0) 双退 = 调用构返(字符); /* H1t (2026-09-11): 接口 分派 调用 实参 — 被调 是 隐藏方法槽 (名 查不到) → 用 解析期 返回型 标 (原 静默 按 标量 传 → 收点(调用 接口 取(i)) = 垃圾) */
                    } 否 若 (构值三目(字符)) 双退 = 节值表[字符] - 1; /* H1q (2026-09-11): 构值 三目 实参 (>8B) — 栈 临时 + sret 目标, 被调 直写 该 临时, 传 其 地址 */
                    若 (双退 >= 0 && 类型表[双退].尺寸 > 8 && !长三) {
                        整 号午 = 类型表[双退].尺寸;
                        整 首联一 = (号午 + 7) / 8;
                        减栈即(首联一 * 8);      /* 腾出 结构体 副本区 */
                        总计数 += 首联一 * 8;
                        整 间深 = -当前帧大小 - 首联一 * 8; /* rbp 相对临时地址 */
                        整 存返偏 = 码生成结构返偏移, 存返静 = 码生成结构返静态, 存返间 = 码生成结构返间接; /* H1q (2026-09-11): 保存 外层 调用 的 sret 目标 — 上游 形如 f(g()) (两 处 都 是 >8B 构值) 时, 本 块 原 无条件 码生成结构返偏移 = 0 → 外层 调用 的 rcx 目标 丢 失 → 读 [rbp+0] 垃圾 作 返回缓冲 → 0xC0000005; 构值 三目 实参 同理 */
                        码生成结构返偏移 = 间深; 码生成结构返静态 = 0; 码生成结构返间接 = 0; /* 修复 2026-08-30: 临时非 静态 重置 */
                        码生成(字符);                           /* 例-4 列败 调用 / 构值 三目: rcx=&暂存, 被调/分支 写入 */
                        码生成结构返偏移 = 存返偏; 码生成结构返静态 = 存返静; 码生成结构返间接 = 存返间; /* H1q: 恢复 外层 目标 */
                        取帧址(0, 间深);         /* 堆九 = &暂存 */
                        压栈寄存器(0);                       /* 实参 槽位 = 地址 的 该 临时 */
                        槽高[槽数] = 总计数;
                        总计数 += 8;
                        槽数++;
                        续;
                    }
                    槽高[槽数] = 总计数;
                    若 (节浮标[字符] || 查函数浮(串升, 槽数) || (终陆(串升) >= 0 && !(隔成 && 槽数 >= 1))) { 码生成浮(字符); 中发(栈置, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示; 修复 2026-08-25 步四: frexp/ldexp/modf 第二参非 双精度, 按 整数/指针压栈 */
                    否 若 (节长标[字符] || 查函数长(串升, 槽数)) { 码生成(字符); 若 (!节长标[字符]) 扩32(字符); 中发(中压栈64rax, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示; 修复 2026-08-25 缺陷#30: 整数 实参→邻辰 形参符号扩展 (add5(1,255,255,255,-5) 的 -5) */
                    否 { 码生成(字符); 中发(中压栈rax, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 */
                    总计数 += 8;
                }
                槽数++;
            }
            /* 修复 2026-08-30 生成器 s16: 已丢弃 列败 调用 (无 赋值 目标) --
               分配 a 临时 隐藏-指针 区域 于 该 栈; 被调者 写入 彼处,
               reclaimed 由 该 调用's add_rsp. 偏移 包含 总计数 故 它 点 于
               该 临时 底 (sarg 路径 缺失 总计数 是 a separate latent 缺陷). */
            若 (结构返丢弃) {
                整 单申 = ((类型表[结构返型序].尺寸 + 7) / 8) * 8;
                减栈即(单申);
                总计数 += 单申;
                码生成结构返偏移 = -当前帧大小 - 总计数 + 参基; /* 修复 2026-09-03: 丢弃 sret 临时 原落 rsp 下 16B (未含 参基 影子区) → 被调者 写结果 覆盖 返回地址 崩 0xC0000005; 缓冲 上移 参基 置于 影子/参数 区 之上 */
                码生成结构返静态 = 0;
            }
            /* 修复 2026-08-07 门-1: 六十四位窗口 应用二进制接口 调用点 rsp≡0(mod16)。基帧已 ≡0，
               压入 总计数/8 个槽后奇偶 = (总计数/8 + 额外) & 1，奇数补 8 对齐。
               列败/user 的参数槽读取发生在 影子 减 之后 → 参基 须随 填充 下移。 */
            整 素利 = 0;
            若 (源子) 素利 = 8 * (((总计数 / 8) + 结构返额外) & 1);
            否 若 (双玖) 素利 = 8 * (((总计数 / 8) + 上亥) & 1);
            否 若 (函数指) 素利 = 8 * (((总计数 / 8) + (参数个数 > 4 ? 参数个数 - 4 : 0)) & 1);
            若 (源子 || (双玖 && !函数指)) 参基 += 素利;
            若 (源子) {
                若 (结构返额外 > 0) 中发(顺七, 32 + 8 * 结构返额外 + 素利, 0, 0); 否 中发(顺七, 32 + 素利, 0, 0); 中刷(); /* 第三阶段-中间表示 */
            } 否 若 (双玖 && !函数指) {
                若 (上亥 > 0) 中发(顺七, 32 + 8 * 上亥 + 素利, 0, 0); 否 中发(顺七, 32 + 素利, 0, 0); 中刷(); /* 第三阶段-中间表示 */
            }
            /* 加载 寄存器 + 栈 实参 自 该 已压 槽位 (偏移 = 总计数 - 槽高[k] - 8 自 rsp) */
            若 (源子) { /* rcx = &目标; 实参零..2 -> rdx/r8/r9 (整数) 或 xmm0/xmm1/xmm2 (双精度); 实参三+ -> [rsp+32+8k] — 中间表示 */
                若 (码生成结构返间接) { 移寄存器帧64(1, 结构返指偏移 - 当前帧大小); } /* G2b 补 (2026-09-11): sret 透传 — rcx = *(本函数 返回指针 槽) */ 否 若 (码生成结构返静态) { 度一(静态位移(码生成结构返偏移, 1) - 1); 移64(1, 0); } 否 { 中发(副失, 1, 码生成结构返偏移, 0); } /* 修复 2026-08-30 生成器: 静态 列败 目标 指令指针 (s16) */
                中刷(); /* rcx = &目标 */
                遍 (整 键 = 0; 键 < 参数个数 && 键 < 3; 键++) {
                    整 标丁;
                    若 (键 == 0) 标丁 = 2; 否 若 (键 == 1) 标丁 = 8; 否 标丁 = 9;
                    若 (查函数浮(串升, 键)) { 中发(中巳, 键, 参基 + 总计数 - 槽高[键] - 8, 0); }
                    否 { 中发(中取栈寄存器, 标丁, 参基 + 总计数 - 槽高[键] - 8, 0); }
                    中刷();
                }
                遍 (整 键 = 3; 键 < 参数个数; 键++) {
                    若 (查函数浮(串升, 键)) { 中发(中巳, 键, 参基 + 总计数 - 槽高[键] - 8, 0); 中刷(); 末未(32 + 8 * (键 - 3), 0); }
                    否 { 中发(中取栈寄存器, 0, 参基 + 总计数 - 槽高[键] - 8, 0); 中刷(); 移栈寄存器64(32 + 8 * (键 - 3), 0); }
                }
            } 否 若 (双玖 && 己序 >= 0) {
                /* user 调用 带 双精度 实参 (六十四位窗口): 位置 k goes 在 xmm[k], 整数 在 标丁[k] — 中间表示 */
                遍 (整 键 = 0; 键 < 参数个数 && 键 < 4; 键++) {
                    整 标丁;
                    若 (键 == 0) 标丁 = 1; 否 若 (键 == 1) 标丁 = 2; 否 若 (键 == 2) 标丁 = 8; 否 标丁 = 9;
                    若 (查函数浮(串升, 键)) { 中发(中巳, 键, 参基 + 总计数 - 槽高[键] - 8, 0); }
                    否 { 中发(中取栈寄存器, 标丁, 参基 + 总计数 - 槽高[键] - 8, 0); }
                    中刷();
                }
            } 否 若 (函数指) {
                /* 函数指 调用: 位置 k 加载 xmm[k] 遍 双精度 实参 (节浮标), 标丁[k] 遍 整数.
                   槽高[] 是 indexed 由 实参 位置 (该 被调者 是 已跳 在 双
                   该 压栈 循环 且 此处), 故 walk 计庚 skipping 函 到 查找 每 实参 节点. */
                整 实丑 = 0;
                整 构返一 = (码生成结构返偏移 != 0 || 码生成结构返静态 || 码生成结构返间接) ? 1 : 0; /* H1m (2026-09-11): 间接调用 + 构值返回 (sret) → rcx = 返回缓冲, 实参 顺移 一 位 (镜像 源子 分支; 原 只 认 直接调用 → 接口 方法 返回 >8B 构值 时 rcx 被 当 self → 被调 把 结构体 写进 对象内存/垃圾 → 0xC0000005 或 全 0) */
                若 (构返一) { 若 (码生成结构返间接) { 移寄存器帧64(1, 结构返指偏移 - 当前帧大小); } 否 若 (码生成结构返静态) { 度一(静态位移(码生成结构返偏移, 1) - 1); 移64(1, 0); } 否 { 中发(副失, 1, 码生成结构返偏移, 0); } 中刷(); }
                遍 (整 计 = 0; 计 <= 末位 && 实丑 < 4 - 构返一; 计++) { /* A44 */
                    整 字符 = 计庚[计];
                    若 (字符 == 函 || 字符 < 0) 续;
                    整 位九 = 实丑 + 构返一;
                    整 标丁;
                    若 (位九 == 0) 标丁 = 1; 否 若 (位九 == 1) 标丁 = 2; 否 若 (位九 == 2) 标丁 = 8; 否 标丁 = 9;
                    若 (节点浮性(字符, -1)) 主二(位九, 参基 + 总计数 - 槽高[实丑] - 8);
                    否 { 移寄存器栈64(0, 参基 + 总计数 - 槽高[实丑] - 8); 移64(标丁, 0); }
                    实丑++;
                }
            } 否 {
            /* 内置 (格式化打印/复制内存/...): 堆平/整数 实参 加载 rcx/rdx/r8/r9; 双精度 读取 该 已压 槽位 经 r13 */
            若 (参数个数 >= 1) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[0] - 8); 移64(1, 0); }
            若 (参数个数 >= 2) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[1] - 8); 移64(2, 0); }
            若 (参数个数 >= 3) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[2] - 8); 移64(8, 0); }
            若 (参数个数 >= 4) { 移寄存器栈64(0, 参基 + 总计数 - 槽高[3] - 8); 移64(9, 0); }
            }
            /* 真 应用二进制接口: arg5 于 [rsp+32]. USER 调用 仅: builtins/函数指 读取 该 已压
               槽位 directly (缺对 经 r13), 且 [rsp+32..] overlaps 该 已压
               实参一/实参二/实参三 槽位 �?relocating 将 销毁 e.g. a 5+-实参 输出到文件's 堆平. */
            若 (双玖 && !函数指) 遍 (整 键 = 4; 键 < 参数个数; 键++) {
                若 (己序 >= 0 && 查函数浮(串升, 键)) {
                    主二(0, 参基 + 总计数 - 槽高[键] - 8);
                    末未(32 + 8 * (键 - 4), 0); /* arg5+ 于 调用-rsp+32 (六十四位窗口 影子 32B; 被调者读 [rbp+0x38+8*(k-5)] 因 rbp=call_rsp-24) */
                } 否 { 移寄存器栈64(0, 参基 + 总计数 - 槽高[键] - 8); 移栈寄存器64(32 + 8 * (键 - 4), 0); }
            }

            若 (源子) {
                原肆(函数表[己序].名); /* -图 bypass: 调用 记录 */
                    中发(中调用标号, 函数表[己序].标号一, 参基 + 总计数, 0); 中刷(); /* 第三阶段-中间表示 */
                    若 (查返宽(串升) == 1) { /* t11 (2026-09-25 启元): 调用表达式 返回值 按 返回类型 窄化 — 赋值路径(存储期截断)已对, 调用表达式 路径原缺. 只在 宽 1/2 生效, 4/8 一律不动 (影响面锁死) */
                        汇发("    掩码字节 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x25); 发四(0xFF); 若 (!查返无符(串升)) { 汇发("    符号扩展字节 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBE); 发字节(0xC0); }
                    } 否 若 (查返宽(串升) == 2) {
                        汇发("    掩码字 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x25); 发四(0xFFFF); 若 (!查返无符(串升)) { 汇发("    符号扩展字 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBF); 发字节(0xC0); }
                    }
                    若 (结构返丢弃) { 码生成结构返偏移 = 0; 码生成结构返静态 = 0; } /* 修复 2026-08-30 生成器 s16: 丢弃 临时 reclaimed 由 add_rsp; 零 stale 偏移 故 下一 丢弃 调用 reallocates */
            } 否 若 (函数指) { /* 函数指 优先于 双玖 (修复 2026-08-15: write_block 未定义) */
                /* 函数 指针 indirect 调用: 参数 已 在 rcx/rdx/r8/r9 */
                整 首轮 = 参数个数 > 4 ? 参数个数 - 4 : 0;
                若 (首轮 > 0) 中发(顺七, 32 + 8 * 首轮 + 素利, 0, 0); 否 中发(顺七, 32 + 素利, 0, 0); 中刷(); /* 第三阶段-中间表示 */
                /* relocate 5th+ 实参 到 它们的 真 应用二进制接口 槽位 ([rsp+32+8k]): 它们 曾 已压
                   于 [rsp+0..], 现在 shifted down 由 该 影子 减 */
                遍 (整 键 = 4; 键 < 参数个数; 键++) {
                    移寄存器栈64(0, 32 + 8 * 首轮 + 素利 + 8 * (参数个数 - 1 - 键)); /* 修复 2026-08-07: +填充 */
                    移栈寄存器64(32 + 8 * (键 - 4), 0);
                }
                若 (保解引一) { 整 存强一 = 强制解引宽8; 强制解引宽8 = 1; 码生成(函); 强制解引宽8 = 存强一; } 否 码生成(函); /* 函数指针 值 — 首子 (L-15 第二十四轮: 保留解引用时 强制 8 字节加载) */
                中发(序调用函数指, 32 + 8 * 首轮 + 素利 + 总计数, 0, 0); 中刷(); /* 第三阶段-中间表示 */
                /* 第三阶段-中间表示: 移动 r10,堆九; 调用 r10; add_rsp 由 序调用函数指 落码 */
                /* (原三行删除) */
            } 否 若 (双玖 && 己序 >= 0) {
                原肆(函数表[己序].名); /* -图 旁路: 调用关系记录 */
                    中发(中调用标号, 函数表[己序].标号一, 参基 + 总计数, 0); 中刷(); /* 第三阶段-中间表示 */
                    若 (查返宽(串升) == 1) { /* t11 (2026-09-25 启元): 调用表达式 返回值 按 返回类型 窄化 (同 L23559) */
                        汇发("    掩码字节 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x25); 发四(0xFF); 若 (!查返无符(串升)) { 汇发("    符号扩展字节 eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBE); 发字节(0xC0); }
                    } 否 若 (查返宽(串升) == 2) {
