                中发(隔得一, 高巳一, 0, 0); 中刷();
            }
        } 断;
        例 节点_块: 遍 (整 计 = 0; 计 < 256; 计++) { 整 字符 = 取子(数, 计); 若 (字符 > 0) 码生成(字符); } 断;
        例 节点_调用: { /* 函数 调用 */
            码生成丢弃结果 = 0; /* 阶段D DCE (2026-09-05 虾米): 函数调用有副作用, 参数/被调者结果被使用, 阻断传递死 */
            整 函 = -1;
            整 保解引一 = 0; /* L-15 (第二十四轮): 被调者是「需真加载一次的解引用」—— 供 下方 函数指 分支 置 强制解引宽8 */
