              若 (根R453 >= 0 && 节型别[根R453] == 节点_变量 && !链接模式) {
                  字 *目名R453 = (字*)(节名表 + 根R453); 整 目偏R453 = 0; 整 目找R453 = 0;
                  遍 (整 计R453 = 变量总数() - 1; 计R453 >= 0; 计R453--) 若 (!比较字符串(变量表[计R453].名, 目名R453)) { 目偏R453 = 变量表[计R453].栈偏移; 目找R453 = 1; 断; }
                  若 (目找R453 && 目偏R453 < 0) { 格式化到串(错缓冲, "外部 变量 '%s' 无定义 — 单文件编译无法解析 (多文件请用 编译器 -c + 链接器 链接; 号合.0)", 目名R453); 发错误("A1001", 错缓冲); }
              }
            }
            码生成丢弃结果 = 0; /* 阶段D DCE (2026-09-05 虾米): 赋值有副作用, 左右操作数结果被使用, 阻断传递死 */
            若 (节型表[子0[数]] == 13 || 节型表[子0[数]] == 15) {
                /* 结构体 成员 赋值: 变量.字段 = 表达式 (亦 指针->字段, 数组[i].字段) */
                整 微码 = 子0[数]; /* 成员 访问 节点 */
                整 计排 = (节型别[微码] == 节点_成员 && 节值表[微码] == 1);
                字 *串升 = (字*)(节名表 + 微码);     /* 字段 名 */
