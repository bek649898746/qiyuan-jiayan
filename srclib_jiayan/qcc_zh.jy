    变量表[变量数].栈又 = -1; 变量表[变量数].值丙 = -1;
    变量表[变量数].型序标 = -1; 变量表[变量数].构尺寸 = 0; 变量表[变量数].数组尺寸 = 0; 变量表[变量数].数组元素尺寸 = 0;
    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0; 变量表[变量数].指元素尺寸 = 指元素; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = -1; 变量表[变量数].是否浮标 = 0; 变量表[变量数].指浮 = 0; 变量表[变量数].是否字符标 = 0; 变量表[变量数].无符号标 = 0; 变量表[变量数].是否长标 = 0; 变量表[变量数].是否静态标 = 1;
    静态关键[变量数] = (解析基 > 0) ? 1 : 0; /* 修复 2026-08-06: 函数内 静态 变量 → scl=3 局部符号 */
    变量表[变量数].可空值标 = 可空值静; 变量表[变量数].变可空.tag = (变可空待 ? 可空值_无值 : 可空值_有值); 变可空待 = 0; /* S2a 挂账修复 (2026-09-09): 静态可空落位 (原 变量静态 只 外壹 置待 不落 → 待 漏给下一条声明); S2b-3 (2026-09-09): 可空值类型 落 可空值标 (判空/解包/写包 走 tag; 指针可空 0哨兵 不标) */
    变量末序 = 变量数;
