    移寄存器帧(0, 临时基 - 当前帧大小 + 212); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8F); 发四(0); 补标号(码位-4, 精正, 10); /* 比较 首子,0; jg 精正 (>0 保留) */
