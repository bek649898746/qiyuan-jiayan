                    整 满转 = 新壹;
                    循环 (词型表[词位] == 乘) { 若 (实伴一) 指元素 = 1; 否 指元素 = 副劣 ? 2 : (虚细 ? 8 : (双回 ? 8 : (值午 > 0 ? 值午 : 4))); 满转++; 词位++; }
                    若 (满转 > 1 && 实伴一) 指元素 = 8; /* char** -> 8-byte elements */
                    整 全局数 = 0; /* array element count (0 = not array) */
                    整 隔列 = 0; /* first dimension (row count) */
                    整 堆降 = 0; /* saw any [..] brackets (empty [] unsized array vs scalar struct var) */
                    整 中伴 = 0; /* fix step26: 第一维为空 (char CHARR[][4]) — 未定长推断不能被后续维度 gcnt≠0 跳过 */
                    整 半降[8]; 遍 (整 剩陆 = 0; 剩陆 < 8; 剩陆++) 半降[剩陆] = 0; 整 正双 = 0; /* per-dim sizes → frows (fix 2026-08-05: global 3D arrays had no frows → nested scale fell back to scalar) */
                    循环 (词型表[词位] == 左方) {
                        词位++;
                        堆降 = 1;
                        整 池降 = 词位; 整 反置 = 0;
                        若 (常量表达式求值(&反置)) { /* 通用常量维度 (fix 2026-08-15: filter_bit['Z'+1]) */
                            若 (全局数 == 0) { 隔列 = 反置; 全局数 = 1; }
                            全局数 *= 反置;
                            若 (正双 < 8) { 半降[正双] = 反置; 正双++; }
                        } 否 {
                            词位 = 池降;
                            若 (词型表[词位] == 常数) {
                                若 (全局数 == 0) { 隔列 = 词值表[词位]; 全局数 = 1; }
                                全局数 *= 词值表[词位];
                                若 (正双 < 8) { 半降[正双] = 词值表[词位]; 正双++; }
                                词位++;
                            } 否 若 (词型表[词位] == 词变量) {
                                整 评测数 = 全回(词名表[词位]); 若 (评测数 == 0x80000000) 评测数 = 域零(词名表[词位]);
                                若 (评测数 != 0x80000000) {
                                    若 (全局数 == 0) { 隔列 = 评测数; 全局数 = 1; }
                                    全局数 *= 评测数;
                                    若 (正双 < 8) { 半降[正双] = 评测数; 正双++; }
                                    词位++;
                                } 否 词位++;
                            } 否 若 (词型表[词位] == 左括) {
                                整 右回 = 0;
                                若 (常量表达式求值(&右回)) {
                                    若 (全局数 == 0) { 隔列 = 右回; 全局数 = 1; }
                                    全局数 *= 右回;
                                    若 (正双 < 8) { 半降[正双] = 右回; 正双++; }
                                } 否 词位++;
                            } 否 {
                                若 (正双 == 0 && 词型表[词位] == 右方) 中伴 = 1; /* fix step26: 第一维空 (char CHARR[][4]) */
                                词位++;
                            }
                        }
                        若 (词型表[词位] == 右方) 词位++;
                    }
                    /* fix 2026-08-05: unsized GLOBAL array `int a[] = {1,2,3}` /
                       `char *names[] = {...}` → infer count from the brace init list
                       (was: gcnt=0 → registered as scalar, `= {` fell into expr()
                       which can't eat '{' → parse() aborted → no main → entry crash). */
                    若 (堆降 && (全局数 == 0 || 中伴) && 词型表[词位] == 赋号 && 词型表[词位 + 1] == 左花) {
                        整 主戌 = 词位;
                        整 串捌 = 全局数; /* 第二维及以后乘积 — 未定长第一维需保留 (fix step26: char CHARR[][4] = {"ab","cd"} → gcnt 原本=4(第二维), 原推断条件 gcnt==0 跳过 → 当一维 4 元素 → 布局/访问全错) */
                        词位 += 2; /* skip '=' '{' */
                        整 数 = 1, 深度 = 0, 主四 = 0, 终转 = -1, 余升 = 0;
                        循环 (词位 < 词容量 && !(词型表[词位] == 右花 && 深度 == 0)) {
                            主四 = 0;
                            若 (词型表[词位] == 左花 || 词型表[词位] == 左括 || 词型表[词位] == 左方) { 深度++; 若 (词型表[词位] == 左方) 余升 = 1; }
                            否 若 (词型表[词位] == 右花 || 词型表[词位] == 右括 || 词型表[词位] == 右方) { 深度--; 若 (词型表[词位] == 右方 && 余升) 余升 = 0; }
                            否 若 (词型表[词位] == 逗号 && 深度 == 0) { 数++; 主四 = 1; }
                            否 若 (词型表[词位] == 常数 && 余升 && 深度 >= 1) { 若 (词值表[词位] > 终转) 终转 = 词值表[词位]; }
                            词位++;
                        }
                        若 (主四) 数--; /* C99 trailing comma — 只当最后一个 token 是逗号才减 (fix step26: 原 last_comma 被 {7,8} 的 } 残留 → 无尾逗号也 n-- → SA[] 推断 2 非 3 → 槽不足覆盖邻变量) */
                        若 (终转 >= 0) 数 = 终转 + 1; /* sparse designated init: size = max_index+1 (C99) */
                        若 (中伴 && 正双 > 0) { 遍 (整 庚序 = 正双; 庚序 >= 1; 庚序--) 半降[庚序] = 半降[庚序 - 1]; 半降[0] = 数; 正双++; } /* fix step26: 保留第二维 (char CHARR[][4] → gdims=[3,4], gdim_n=2 — 原只设 [3] → brace_arr_init 按一维 3 元素初始化错位) */
                        否 { 正双 = 1; 半降[0] = 数; }
                        全局数 = (串捌 > 0) ? 数 * 串捌 : 数; 隔列 = 数; /* fix step26: 保留第二维 (CHARR 3×4=12) */
                        
                        词位 = 主戌; /* rewind to '=' */
                    }
                    若 (堆降 && 全局数 == 0 && 词型表[词位] == 赋号 && 词型表[词位 + 1] == 串词) {
