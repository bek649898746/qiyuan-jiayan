    整 符伴 = 新标号(), 总细 = 新标号(); /* fix 2026-08-23 t35g: %d 符号提前输出 */
    整 后九 = 新标号(); /* fix 2026-08-23 t35g: 宽度后非数字 — 长度前缀回 lflag */
    整 副壹 = 新标号(), 实壬 = 新标号(), 空八二 = 新标号(), 域丑 = 新标号(), 单回一 = 新标号(); /* fix 2026-08-23 t35h: %s 宽度填充 */
    整 当散 = 新标号(), 缺布 = 新标号(); /* fix 2026-08-23 t35h: 左对齐 %-s 尾部 pad */
    整 元粗 = 新标号(), 首甲 = 新标号(), 池伴 = 新标号(), 现卯 = 新标号(); /* fix 2026-08-18: %.*s 星号精度 */
    整 高复 = 新标号(), 列组 = 新标号(), 满寅三 = 新标号(), 高聚 = 新标号(), 元甲 = 新标号(), 尾利 = 新标号(); /* fix 2026-08-06: %lld/%llu/%llx/%llX 64 位 (ll_cnt=计数, *32=32 位回退; lxU=%X 大写) */
    整 半得 = 新标号(); /* %z (size_t) → 64 位 (fix 2026-08-23 t35d) */
    整 目浅 = 新标号(); /* %*s 宽度参数 (fix 2026-08-23 t35e) */
    整 实己 = 新标号(), 列柒 = 新标号(), 下序 = 新标号(), 链叁 = 新标号();
    整 反挂一 = 新标号(); /* %u unsigned decimal (fix 2026-08-05) */
    整 链劣 = 新标号(); /* %o unsigned octal (fix 2026-08-22 t47) */
    整 局部序 = 新标号(); /* Windows I64 modifier %I64u (fix 2026-08-22 t47) */
    整 单薄 = 新标号(); /* %p pointer hex (fix 2026-08-19) */
    整 宽组 = 新标号(); /* %.0f: no '.' when N==0 */
    整 段卯 = 新标号(); /* %% -> literal '%' (root-cause 2026-08-03: was swallowed) */
    整 主又一 = 新标号(), 全甲 = 新标号(), 初寅 = 新标号(), 暂双一 = 新标号(), 计低一 = 新标号(); /* %d width padding */
    整 全劣 = 新标号(), 缺亥二 = 新标号(), 实又 = 新标号(), 号柒 = 新标号(); /* '-' 左对齐 flag + 数字后 padding (fix 2026-08-06) */
    整 尾五 = 新标号(), 外繁 = 新标号(), 外败 = 新标号(); /* fix 2026-08-23 t35e: %0Nd zero-pad */
    整 标列 = 新标号(), 满粗 = 新标号(); /* fix 2026-08-09 审计#7: %#x 前缀 + %0Nx 零填充 */
    设标号(容低);
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 段辰, 1);
    移即(0, '%'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 素二, 1);
    现午(); /* mov [r12], cl */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 容低, 2);
    设标号(素二);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past '%') */
    /* specifier-prefix parse: flags/width/precision must NOT be emitted as literals
       (root-cause 2026-08-03: %.1f printed literal "1f"). Default precision = 6, width = 0. */
    移即(0, 6); 移帧寄存器(临时基 - 当前帧大小 + 224, 0);
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 232, 0); /* width W = 0 */
    移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* explicit-precision flag = 0 (fix 2026-08-05) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 244, 0); /* LL counter = 0 (fix 2026-08-06: %lld 64位取参; mov_mbrp_reg 第二参是寄存器号，必须先清零 eax) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 252, 0); /* '-' 左对齐 flag = 0 (fix 2026-08-06) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 260, 0); /* '#' 前缀 flag = 0 (fix 2026-08-09 审计#7) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 264, 0); /* '0' 零填充 flag = 0 (fix 2026-08-09 审计#7) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 0, 0); /* '+' 恒正 flag = 0 (fix 2026-08-23 t35g) */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 4, 0); /* sign_done = 0 (fix 2026-08-23 t35g) */
    设标号(终回);
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] */
    移即(0, '-'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 全劣, 1); /* '-' flag: 左对齐 (fix 2026-08-06) */
    移即(0, '+'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 宽附, 1); /* fix 2026-08-23 t35g: '+' flag → sc+268 */
    移即(0, ' '); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 满劣, 1);
    移即(0, '0'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 满粗, 1); /* fix 2026-08-09: '0' flag → 置位 sc+264 */
    移即(0, '#'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 标列, 1); /* fix 2026-08-09: '#' flag → 置位 sc+260 */
    移即(0, 'l'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 高复, 1); /* length prefix: count 'l' (fix 2026-08-06) */
    移即(0, 'I'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 局部序, 1); /* Windows I64 modifier (fix 2026-08-22 t47: %I64u 当 unknown spec 跳过 → cat-file -s 输出 "64u" 不打印 size; PRIuMAX="I64u") */
    移即(0, 'z'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 半得, 1); /* %z (size_t) → 64 位 (fix 2026-08-23 t35d: 原当未知格式跳过 'z' → 'u' 原样打印 → git "%zu" 输出 'u'; attr.c report_invalid_attr 等 size_t 打印全乱) */
    移即(0, 'h'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 满劣, 1);
    移即(0, 'L'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 满劣, 1);
    相对跳转(-1); 补标号(码位-4, 旁简, 2);
    设标号(局部序); /* 'I' → 64-bit (I64); skip '6' '4' 修饰符避免当宽度 */
    移即(0, 2); 移帧寄存器(临时基 - 当前帧大小 + 244, 0); /* ll_cnt = 2 (64-bit) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past 'I') */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] */
    移即(0, '6'); 算寄存器(比等, 1, 0); 非零跳(-1); 补标号(码位-4, 满劣, 1); /* not '6' → back to flag loop */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past '6') */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] */
    移即(0, '4'); 算寄存器(比等, 1, 0); 非零跳(-1); 补标号(码位-4, 满劣, 1); /* not '4' → back */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past '4') */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(半得); /* 'z' (size_t) → 64 位无符号; 后面直接是格式符 (u/d/x/o...) */
    移即(0, 2); 移帧寄存器(临时基 - 当前帧大小 + 244, 0); /* ll_cnt = 2 (64-bit) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past 'z') */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(标列); /* '#' flag: sc+260 = 1 (fix 2026-08-09 审计#7: %#x → 0x 前缀) */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 260, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(宽附); /* '+' flag: sc+268 = 1 (fix 2026-08-23 t35g) */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 0, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(满粗); /* '0' flag: sc+264 = 1 (fix 2026-08-09 审计#7: %08x 零填充) */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 264, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(高复); /* 'l' length prefix: sc+244++ (fix 2026-08-06) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 244); /* eax = ll_cnt */
    移即(1, 1); 算寄存器(高拾, 0, 1); /* eax++ */
    移帧寄存器(临时基 - 当前帧大小 + 244, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(全劣); /* '-' 左对齐 flag: sc+252 = 1 (fix 2026-08-06) */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 252, 0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(满劣); /* skip a flag char */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 终回, 2);
    设标号(旁简); /* width digits: accumulate into sc+232 (%5d -> 5) - root-cause 2026-08-03 */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] - RE-READ (fix 2026-08-03: was looping on the stale char) */
    移即(0, '*'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 目浅, 1); /* %*s: 宽度参数 (fix 2026-08-23 t35e) */
    移即(0, '0'); 算寄存器(比等, 1, 0); 发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位-4, 后九, 8); /* cmp cl,'0'; jb lwd_nondigit (fix 2026-08-23 t35g: 非数字含 l/h/z/I 长度前缀) */
    移即(0, '9'); 算寄存器(比等, 1, 0); 发字节(0x0F); 发字节(0x87); 发四(0); 补标号(码位-4, 后九, 9); /* cmp cl,'9'; ja lwd_nondigit */
    汇发("    减字节 r1, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xE9); 发字节('0'); /* sub cl, '0' -> digit */
    移寄存器帧(0, 临时基 - 当前帧大小 + 232); /* eax = W */
    移寄存器(2, 0);                                       /* edx = W */
    汇发("    左移 r0, 3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 0); 发字节(3);    /* shl eax, 3 -> W*8 */
    汇发("    左移 r2, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 2); 发字节(1);    /* shl edx, 1 -> W*2 */
    算寄存器(高拾, 0, 2);                                 /* eax = W*10 */
    算寄存器(高拾, 0, 1);                                 /* eax += digit */
    移帧寄存器(临时基 - 当前帧大小 + 232, 0); /* W = eax */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 旁简, 2);
    设标号(后九); /* fix 2026-08-23 t35g: 宽度后非数字 — 长度前缀(l/h/z/I)继续, '.' 精度, 其余转换符 */
    移即(0, 'l'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 高复, 1);
    移即(0, 'h'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 满劣, 1);
    移即(0, 'z'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 半得, 1);
    移即(0, 'I'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 局部序, 1);
    移即(0, '.'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 元粗, 1);
    相对跳转(-1); 补标号(码位-4, 池伴, 2);
    设标号(直子);
    移即(0, '.'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 元粗, 1);
    相对跳转(-1); 补标号(码位-4, 池伴, 2);
    设标号(元粗); /* .N / .* - precision (fix 2026-08-18: %.*s star — 原 `.` 后只认数字, `*` 当未知说明符跳过 → 后续参数错位 → 下一个 %s 把 int 精度当指针 strlen → SEGV; git vadvise "%shint:%s%.*s%s" 崩) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past '.') */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] */
    移即(0, '*'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 现卯, 1); /* fix 2026-08-18: .* 星号精度 → 从参数表取 */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 224, 0);
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* explicit-precision flag for %s (fix 2026-08-05) */
    相对跳转(-1); 补标号(码位-4, 首甲, 2); /* 数字精度: 跳过 lstar 块 (fix 2026-08-18: lstar 原放 ldig 后 → %.1f 数字路径落入 lstar → 精度错 → 浮点除零 0xC0000094) */
    设标号(目浅); /* %*s 宽度参数 (fix 2026-08-23 t35e): 从参数表读 int, 存 sc+232 (W) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past '*') */
    行退(); /* eax = [r13] = width int */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* add r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* sub r13, 8 */ }
    移帧寄存器(临时基 - 当前帧大小 + 232, 0); /* W = arg */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] */
    相对跳转(-1); 补标号(码位-4, 终回, 2); /* 继续解析 (fix 2026-08-23: 返 lflag 直接检查 - lflags 会 inc r11 跳过 'I' 导致 %*I64u 的 '6''4' 被当宽度数字, ll_cnt 为失) */
    设标号(现卯); /* .* 星号精度 (fix 2026-08-18): 从参数表取 int, 参数表前移 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past '*') */
    行退(); /* eax = [r13] = precision int */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* add r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* sub r13, 8 */ }
    移帧寄存器(临时基 - 当前帧大小 + 224, 0); /* precision = arg */
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* explicit-precision */
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] - 转换字符 */
    相对跳转(-1); 补标号(码位-4, 池伴, 2);
    设标号(首甲);
    汇发("    零扩展 ecx, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 3); /* movzx ecx, byte[r11] */
    移即(0, '0'); 算寄存器(比等, 1, 0); 发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位-4, 池伴, 8);
    移即(0, '9'); 算寄存器(比等, 1, 0); 发字节(0x0F); 发字节(0x87); 发四(0); 补标号(码位-4, 池伴, 9);
    /* ecx -= '0'; N = N*10 + digit */
    汇发("    减字节 r1, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xE9); 发字节('0'); /* sub cl, '0' */
    移寄存器帧(0, 临时基 - 当前帧大小 + 224); /* eax = N */
    移寄存器(2, 0);                                       /* edx = N */
    汇发("    左移 r0, 3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 0); 发字节(3);    /* shl eax, 3 -> N*8 */
    汇发("    左移 r2, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 2); 发字节(1);    /* shl edx, 1 -> N*2 */
    算寄存器(高拾, 0, 2);                                 /* eax = N*10 */
    算寄存器(高拾, 0, 1);                                 /* eax += digit */
    移帧寄存器(临时基 - 当前帧大小 + 224, 0); /* N = eax */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 */
    相对跳转(-1); 补标号(码位-4, 首甲, 2);
    设标号(池伴); /* dispatch on the conversion char (ecx) */
    移即(0, 'd'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 符组, 1);
    移即(0, 's'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 暂双, 1);
    移即(0, 'c'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 首戊, 1);
    移即(0, 'f'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 高癸, 1);
    移即(0, 'e'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 小于等, 1); /* %e 科学计数法 (fix 2026-08-25 支持矩阵补全) */
    移即(0, 'E'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 净二, 1); /* %E 大写科学计数法 */
    移即(0, 'g'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 初陆, 1); /* %g 通用浮点 (fix 2026-08-25 支持矩阵补全) */
    移即(0, 'G'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 局部全局, 1); /* %G 大写通用浮点 */
    移即(0, 'x'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 首又一, 1); /* %x hex (fix 2026-08-05) */
    移即(0, 'X'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 元甲, 1); /* %X uppercase hex (fix 2026-08-06) */
    移即(0, 'u'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 反挂一, 1); /* %u unsigned decimal (fix 2026-08-05) */
    移即(0, 'o'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 链劣, 1); /* %o unsigned octal (fix 2026-08-22 t47: 原当未知说明符跳过不消费参数 → git ls-files -s "%s%06o %s %d" 后续 %s 读到 mode 当指针 strlen SEGV) */
    移即(0, 'p'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 单薄, 1); /* %p pointer hex (fix 2026-08-19: 原 %p 当未知说明符跳过不消费参数 → 后续 %d/%u/%s 参数错位一格 → t_zin gz.z.avail_in 读到指针值; git 源码大量 %p) */
    移即(0, '%'); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 段卯, 1); /* %% -> literal % */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11: unknown spec, skip */
