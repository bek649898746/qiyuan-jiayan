            计庚[0] = 子0[数]; 计庚[1] = 子1[数]; 计庚[2] = 子2[数]; 计庚[3] = 子3[数]; 计庚[4] = 子4[数];
            计庚[5] = 子5[数]; 计庚[6] = 子6[数]; 计庚[7] = 子7[数]; 计庚[8] = 子8[数]; 计庚[9] = 子9[数];
            计庚[10] = 子10[数]; 计庚[11] = 子11[数]; 计庚[12] = 子12[数]; 计庚[13] = 子13[数]; 计庚[14] = 子14[数];
            计庚[15] = 子15[数]; 计庚[16] = 子16[数]; 计庚[17] = 子17[数]; 计庚[18] = 子18[数]; 计庚[19] = 子19[数];
            整 参数个数 = 0;
            遍 (整 计 = 0; 计 < 20; 计++) { 整 字符 = 计庚[计]; 若 (字符 == 函 || 字符 < 0) 续; 参数个数++; }
            /* 内建 __asm(args...): 发射任意字节到代码流 (内核 sti/cli/lidt/iretq, fix 2026-08-08) */
            若 (节型表[函] == 1 && !比较字符串(串升, "__asm") && 满双) {
                遍 (整 计 = 0; 计 < 20; 计++) {
                    整 字符 = 计庚[计];
                    若 (字符 == 函 || 字符 < 0) 续;
