        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "typeof") || !比较字符串(词名表[词位], "类型取"))) { /* C23 typeof 类型查询 (2026-09-01): typeof(x) y = init; — 复制变量/类型 的类型标志声明 (接入即中文化: 类型取 双认) */
            词位++; /* typeof */
            若 (词型表[词位] == 左括) 词位++;
            字 目标[64] = "";
            若 (词型表[词位] == 词变量 || 词型表[词位] == 型词) 复制字符串(目标, 词名表[词位]);
            若 (词型表[词位] == 型词) 词位++;
            否 若 (词型表[词位] == 词变量) 词位++;
            若 (词型表[词位] == 右括) 词位++;
            /* 求类型标志: 变量名 → 变量表查询; 非变量 → 类型关键字兜底 */
            整 当丙 = 变量是否浮(目标);
            整 是否长标 = 变量是否长(目标);
            整 是否字符标 = 变量是否字符(目标);
            整 是否短标 = 变量是否短(目标);
            整 无符号标 = 变量是否无符号(目标);
            整 指深 = 变量指深(目标); 循环 (词型表[词位] == 乘) { 指深++; 词位++; } /* C4-C族 刀1 (2026-09-24 启元 · 第 275 站): **typeof(...) 之后 消费 指针星号** —— 病灶: `typeof(双精度) *p = d;` 的 `*` **从未被消费** ⟹ L10334 `变节 = 词名表[词位]` 取到的是 `*` 的 词名 (**空串**) ⟹ 登记 一个 空名 浮点变量 (QCC_DUMP 铁证: 变[360] 名字空 浮=1) 且 `指深` 取自 `目标`("双精度" 不是变量 ⟹ 0) ⟹ L10336 指针分支 不成立 ⟹ 走 L10342 `变浮("")` ⟹ 后续 `p[1]` 用 不存在 的 变量 ⟹ **崩 0xC0000005** (探针 c4c2: 甲言崩 / gcc P1=2.50). 修: 在 求类型标志 之前 循环 消费 `乘` 并 累加 指深 ⟹ 声明 回归 正常 指针路径. */
            若 (查变量(目标) < 0) { /* 类型关键字 */
                若 (!比较字符串(目标, "整") || !比较字符串(目标, "int")) { /* 默认 int: 无标志 */ }
                否 若 (!比较字符串(目标, "双") || !比较字符串(目标, "double")) 当丙 = 1;
                否 若 (!比较字符串(目标, "字") || !比较字符串(目标, "char") || !比较字符串(目标, "字节")) 是否字符标 = 1;
                否 若 (!比较字符串(目标, "短") || !比较字符串(目标, "short")) 是否短标 = 1;
                否 若 (!比较字符串(目标, "长") || !比较字符串(目标, "long")) 是否长标 = 1;
                否 若 (!比较字符串(目标, "无") || !比较字符串(目标, "unsigned")) 无符号标 = 1;
