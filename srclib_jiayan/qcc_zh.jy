否 若 (高巳 == 2) { 若 (字段是否无符号(类型表[串值].名, 函)) { 汇发("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB7); 模字节(0, 0, 0); } 否 { 汇发("    符号扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBF); 模字节(0, 0, 0); } } /* 大-参数 短整 (修复 2026-08-30 生成器 s172: int16_t 字段 符号扩展 — 原恒 零扩展) */
