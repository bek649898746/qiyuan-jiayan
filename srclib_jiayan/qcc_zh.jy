/* 泛型定义预扫描 (接入 2026-08-28 机制层 #96): lex 前扫源码 "泛型 名字(params) = body;" → 注册 fn_macro
   (fn_macro_expand 在 lex 前文本展开调用, 中文 fn_macro 调用按实参类型天然多类型) */
静 空 净集(常 字 *串值) {
    常 字 *指 = 串值;
    循环 (*指) {
        若 (指[0] == '/' && 指[1] == '/') { 循环 (*指 && *指 != '\n') 指++; 续; }
        若 (指[0] == '/' && 指[1] == '*') { 指 += 2; 循环 (*指 && !(指[0] == '*' && 指[1] == '/')) 指++; 若 (*指) 指 += 2; 续; }
        若 (指[0] == '"') { 指++; 循环 (*指 && *指 != '"') { 若 (*指 == '\\') 指++; 指++; } 若 (*指) 指++; 续; }
        若 (指[0] == '\'') { 指++; 循环 (*指 && *指 != '\'') { 若 (*指 == '\\') 指++; 指++; } 若 (*指) 指++; 续; }
        若 (指[0] == '\xe6' && 指[1] == '\xb3' && 指[2] == '\x9b' && 指[3] == '\xe5' && 指[4] == '\x9e' && 指[5] == '\x8b') { /* "泛型" */
            常 字 *寻 = 指 + (*寻 == 'd' ? 6 : 9);
            循环 (*寻 == ' ' || *寻 == '\t') 寻++;
            字 名存[64]; 整 净优 = 0; 循环 ((判字母数字((无 字)*寻) || *寻 == '_' || (无 字)*寻 >= 0x80) && 净优 < 63) 名存[净优++] = *寻++;
            名存[净优] = 0;
            若 (名存[0]) {
                整 源癸 = 0; 遍 (整 计 = 0; 计 < 函数宏数; 计++) 若 (!比较字符串(函数宏表[计].名, 名存)) { 源癸 = 1; 断; }
                若 (!源癸 && 函数宏数 < 2048) {
                    复制字符串(函数宏表[函数宏数].名, 名存);
                    余简[函数宏数] = 0;
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                    若 (*寻 == '(') { 寻++; 整 圆周率 = 0; 循环 (*寻 && *寻 != ')' && 圆周率 < 16) { 循环 (*寻==' '||*寻=='\t'||*寻==',') 寻++; 若 (*寻==')') 断; 整 寻二=0; 循环 ((判字母数字((无 字)*寻)||*寻=='_') && 寻二<63) 函数宏表[函数宏数].容败[圆周率][寻二++]=*寻++; 函数宏表[函数宏数].容败[圆周率][寻二]=0; 圆周率++; /* fix 2026-08-28: 每次参数后 ++ (pn 少 1 → 只替换第一个参数) */ 若 (*寻==')') 断; } 若 (*寻==')') 寻++; 函数宏表[函数宏数].参数数=圆周率; }
                    否 函数宏表[函数宏数].参数数 = 0;
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                    若 (*寻 == '=') { 寻++; 循环 (*寻==' '||*寻=='\t') 寻++; }
                    整 发字节 = 0; 循环 (*寻 && *寻 != '\n' && *寻 != ';' && 发字节 < 16383) 函数宏表[函数宏数].体[发字节++] = *寻++; /* body 到 ; 停 (fix 2026-08-28: 含 ; 展开后双分号 → 结果 0) */
                    函数宏表[函数宏数].体[发字节] = 0;
                    函数宏数++;
                }
            }
            指 = 寻;
            续;
        }
        指++;
    }
}
静 字 *计进二(常 字 *串值) {
    净集(串值); /* lex 前: 预扫描 泛型 定义注册 fn_macro (查重防重复) */
    整 容量 = (整)取字长(串值) * 2 + 1024;
    字 *出 = 内存分配(容量);
    整 丙 = 0;
    栈凶一 = 0; /* fix 2026-08-13: 重置展开栈 */
    副组(串值, &出, &丙, &容量, -1);
    若 (丙 + 1 > 容量) { 容量 = 丙 + 1; 出 = 重分配(出, 容量); }
    出[丙] = 0;
    返 出;
}
/* conditional compilation stack (fix 2026-08-05) */
静 整 后排[64]; 静 整 下劣[64]; 静 整 条件计数; 静 整 顺一;
/* #if expression evaluator: defined(X), numbers, macro values, !, &&, ||, comparisons */
静 整 预处求值(常 字 *终) {
    /* 剥离表达式内块注释/行注释 → 空白 (C 预处理语义: 注释在求值前已是空白; luaconf.h 浮点检查 #if 行尾块注释混入表达式 → 操作数解析失败, fix 2026-08-26) */
    字 号薄[520]; 整 旁拆 = 0;
    遍 (整 计 = 0; 终[计] && 旁拆 < 500; 计++) {
        若 (终[计] == '/' && 终[计 + 1] == '*') { 循环 (终[计] && !(终[计] == '*' && 终[计 + 1] == '/')) 计++; 若 (终[计]) 计++; 号薄[旁拆++] = ' '; 续; }
        若 (终[计] == '/' && 终[计 + 1] == '/') { 循环 (终[计] && 终[计] != '\n') 计++; 号薄[旁拆++] = ' '; 续; }
        号薄[旁拆++] = 终[计];
    }
    号薄[旁拆] = 0;
    终 = 号薄;
    /* strip outer parens — only if the FIRST ( matches the LAST ) (fix 2026-08-06 M7:
       原只看首尾字符，(1<2)&&(2<3) 被误剥成 1<2)&&(2<3 → 括号失衡) */
    循环 (*终 == ' ') 终++;
    整 长度一 = (整)取字长(终);
    循环 (长度一 > 0 && 终[长度一-1] == ' ') 长度一--;
    若 (长度一 >= 2 && 终[0] == '(') {
        整 元 = 0, 央 = -1;
        遍 (整 计 = 0; 计 < 长度一; 计++) {
            若 (终[计] == '(') 元++;
            否 若 (终[计] == ')') { 元--; 若 (元 == 0) { 央 = 计; 断; } }
        }
        若 (央 == 长度一 - 1) {
            字 末属[512]; 复制内存(末属, 终+1, 长度一-2); 末属[长度一-2] = 0;
