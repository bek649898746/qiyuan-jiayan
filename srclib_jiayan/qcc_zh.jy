静 整 返回型序表[8192]; /* return-struct index per func index; survives gen_code's func_n=0 reset (fix 2026-08-07: 512→1024 对齐 func_tbl; fix 2026-08-16 根因E3: 1024→8192 对齐 func_tbl 新容量) */
静 整 素二一[8192]; /* 函数返回 struct 指针（不是 sret）标记 */
