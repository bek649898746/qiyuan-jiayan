        若 (判载元s <= 0) 判载元s = (判载码 == 3 || 判载码 == 7) ? 1 : ((判载码 == 2 || 判载码 == 6) ? 2 : ((判载码 == 1 || 判载码 == 4 || 判载码 == 8) ? 8 : 4));
        若 (判载层 > 1) 判载元s = 8;
        判载素p[变节][判载数p[变节]] = 判载元s;
        判载层p[变节][判载数p[变节]] = 判载层;
        判载码 = 9;
    }
    若 (词型表[词位] == 词变量) { 判载名p[变节][判载数p[变节]] = 词名表[词位]; 词位++; }
