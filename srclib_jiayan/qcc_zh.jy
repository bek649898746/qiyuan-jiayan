    若 (数[0] != '_' && 是保留函名(数)) { 格式化到串(错缓冲, "变量名 '%s' 是 保留词/内建名, 不能作 变量名 (声明会被静默吞掉 ⟹ 静默错值 或 死循环; 请改名) (号合.0, 撞词家族 R434 2026-09-30)", 数); 发错误("A9001", 错缓冲); }
