                            若 (正双 >= 1) { 变量表[变量数 - 1].域行数[正双 - 1] = 类型表[首深].尺寸; 遍 (整 己序 = 正双 - 2; 己序 >= 0; 己序--) 变量表[变量数 - 1].域行数[己序] = 变量表[变量数 - 1].域行数[己序 + 1] * 半降[己序 + 1]; }
                            若 (隔列 > 0 && 全局数 > 隔列 && 满转 <= 0) 变量表[变量数 - 1].数组元素尺寸 = 全局数 / 隔列 * 类型表[首深].尺寸; /* 2D+: ROW byte size */
                        } 否 {
                            /* multi-dim: the first index's element is the inner array (row). e.g.
