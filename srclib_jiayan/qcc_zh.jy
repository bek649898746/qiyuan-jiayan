                断; /* 跳过正常调用逻辑 */
            }
            若 (己序 >= 0 && 查函数浮返(串升)) 节浮标[数] = 1; /* double-returning call: node yields xmm0 */
            /* ?????????? ??rcx, rdx, r8, r9 ??arg5+ on stack at [rsp+40+8k]
