                        若 (变量是否静态(变名)) { 中发(缺捌, 偏移, 1, 0); 中刷(); } 否 { 中发(副失, 0, 变量基(变名, 偏移) - 当前帧大小, 0); 中刷(); } /* Phase3-IR case10: b=*p 拷贝 */
