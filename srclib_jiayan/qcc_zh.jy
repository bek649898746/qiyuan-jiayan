                    汇发("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,0,3); 发字节(7); /* add r11d, 7 */
