                        若 (捕引序 >= 0 && 标退 == 2) { 格式化到串(错缓冲, "闭包: 接口引用 '%s' 不支持 可变捕获 (接口值 = 对象指针 + N 方法槽, 可变捕获 需 单槽取址; 改 捕获 移动)", 词名表[词位]); 发错误("A9005", 错缓冲); }
                        若 (捕引序 >= 0 && 标退 == 1) { /* A2 (2026-09-11): 接口引用 移动捕获 — 逐槽 快照 (__ir_快基_数 + __ir_快基_m{k}) 并 登记 快基 为 接口引用 → 调用点 展引 路径 自动 展 N+1 实参 (#195 接口引用 实参 展开); 原 单条 快照 = 整数4B槽 引用 幻影名 'i' → 码生成 查变量 未命中 → [ERR] 未定义函数 'i' 不能取地址 */
                            字 捕接口[64]; 复制字符串(捕接口, 接口引用表[捕引序].接口名);
                            整 捕接序 = 满对(捕接口); 整 捕方数 = (捕接序 >= 0) ? 接口表[捕接序].槽数 : 0;
