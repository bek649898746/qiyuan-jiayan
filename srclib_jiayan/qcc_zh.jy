    返 子19[数];
    }
}

/* parse-time double-expression predicate (root-cause 2026-08-03): `(int)expr` cast
   creation relied on ndbl[ce], which for a double-returning CALL is only set at
   CODEGEN (case-4) — so `(int)dadd(2.5,3.5)` was a NO-OP at parse, the call stayed
   double-typed, and printf %d read the raw xmm0 low bits (0). Detect double-ness
   here at parse: ndbl covers FP/double-var/double-member/double-binary; calls need
   the callee signature (mirror of case-4 ndbl logic). */
静 整 表达式是否浮(整 数) {
    
    若 (数 < 0) 返 0;
    若 (节浮标[数]) 返 1;
    若 (节型表[数] == 1) {
        字 *变节二 = (字*)(节名表 + 数);
        若 (变量数组(变节二) != 0) 返 0; /* 数组名衰减为地址, 不是 double 值 (fix 2026-08-25 step15: double 数组名 var_is_dbl=true → (char*)arr+n 走浮点加法 → 基址丢失; 同 L4319 ndbl 守卫) */
        返 变量是否浮(变节二) ? 1 : 0;
    } /* fix 2026-08-25 bug#27: double 变量标识符 (原 ndbl 未设置 → 0-v1 走整数路径 → 负 double 全错) */
    若 (节型表[数] == 4) { /* function call */
        整 函 = 子0[数];
        若 (函 < 0) 返 0;
        若 (节型表[函] == 1) { /* named callee: function or fnptr var */
            字 *存分 = (字*)(节名表 + 函);
            若 (查函数浮返(存分)) 返 1; /* known double-returning function */
            若 (变量指浮(存分)) 返 1;       /* double-returning fnptr variable */
            返 0;
        }
        若 (节型表[函] == 12) 函 = 子0[函]; /* (*fp): deref decays to the pointer var */
        若 (节型表[函] == 1) 返 变量指浮((字*)(节名表 + 函)) ? 1 : 0;
        { 整 位非标 = 原庚(函); /* expression callee (tbl[i], arr[i].f): base's p_dbl */
          若 (位非标 >= 0 && 节型表[位非标] == 1 && 变量指浮((字*)(节名表 + 位非标))) 返 1; }
    }
    返 0;
}

静 整 建节(整 暂) { 若 (接子数 >= 节容量) { 输出到文件(错误流, "[ERR] AST overflow (%d) (fix 2026-08-17 审计: 满则硬退, 绝不返 -1 — 原返 -1 调用方 nv[-1] 越界写)\n", 节容量); 退出(1); } 整 计 = 接子数++; 节型表[计] = 暂; 节值表[计] = 0; 子0[计] = 子1[计] = 子2[计] = 子3[计] = 子4[计] = 子5[计] = 子6[计] = 子7[计] = 子8[计] = 子9[计] = 子10[计] = 子11[计] = 子12[计] = 子13[计] = 子14[计] = 子15[计] = 子16[计] = 子17[计] = 子18[计] = 子19[计] = 目属[计] = 后双[计] = 号得一[计] = 缓七[计] = 域癸[计] = 半丙[计] = 首厚[计] = 高拆一[计] = 副败一[计] = 前低一[计] = 外八一[计] = 虚吉[计] = 栈七[计] = 计午一[计] = 外对[计] = 度叁[计] = 主申[计] = 元六[计] = 度丁[计] = 长薄[计] = 主退一[计] = 主轮[计] = 现降[计] = 外辰[计] = 内己[计] = 副进一[计] = 末拆[计] = 缺利[计] = 域进[计] = 全戌[计] = 右十[计] = 存一[计] = 首辛[计] = 目壹[计] = 栈退[计] = 源己一[计] = 副申[计] = 旧回[计] = 邻丑[计] = 链凶[计] = 直厚[计] = 目丁一[计] = 帧升[计] = 末升[计] = 度捌[计] = 正六[计] = 序对一[计] = 元戌[计] = 右组[计] = 段庚[计] = 列未[计] = 栈又一[计] = 单再[计] = 末双[计] = 末子一[计] = 毛得[计] = 中七[计] = 值劣一[计] = 全聚[计] = 行午[计] = 满联二[计] = 整低[计] = 隔卯[计] = 目甲一[计] = 缓退[计] = 宽分[计] = 全聚一[计] = 满丑[计] = 缺午[计] = 帧凶[计] = 尾置[计] = 原八[计] = 终降[计] = 半厚[计] = 主三[计] = 行凶[计] = 池肆[计] = 暂辛[计] = 号系[计] = 余利[计] = 间次[计] = 新酉[计] = 左壬[计] = 符寅[计] = 计子一[计] = 计细[计] = 暂叁[计] = 虚肆[计] = 名癸[计] = 源重[计] = 列六[计] = 外丙[计] = 帧卯[计] = 下重[计] = 长成[计] = 源进[计] = 半利[计] = 符置[计] = 目六[计] = 前又[计] = 上平[计] = 尾五一[计] = 深重[计] = 全贰[计] = 整退[计] = 深叁[计] = 素乙[计] = 串败[计] = 左降[计] = 宽九[计] = 池又[计] = 逆合[计] = 正癸[计] = 高又[计] = 初伍[计] = 反双[计] = 深丙[计] = 末辰[计] = 存陆一[计] = 素降[计] = 隔叁[计] = 源转[计] = 名次[计] = 间双[计] = 容未[计] = 标复[计] = 计粗[计] = 栈巳[计] = 目乙[计] = 暂联[计] = 双环[计] = 旧降[计] = 实弊[计] = 尾辰一[计] = 缺联[计] = 号子[计] = 缓平一[计] = 满升[计] = 缺双[计] = 正回[计] = 虚失[计] = 符得[计] = 号复[计] = 尾对[计] = 实集[计] = 顺五一[计] = 余戌[计] = 逆八[计] = 中凶[计] = 元失[计] = 尾次[计] = 计庚一[计] = 初七[计] = 右弊[计] = 深汇[计] = 正伴[计] = 半退一[计] = 短深[计] = 满午[计] = 顺高[计] = 原子一[计] = 源退[计] = 串二[计] = 后吉[计] = 逆系[计] = 缺聚一[计] = 逆陆[计] = 缺丙一[计] = 剩凶[计] = 目酉[计] = 存简[计] = 终挂[计] = 隔捌[计] = 剩列[计] = 堆双一[计] = 值陆[计] = 素再[计] = 副伴[计] = 虚四[计] = 隔置[计] = 名子[计] = 旁低[计] = 净戌[计] = 副败[计] = 新壹一[计] = 总戌[计] = 剩戊[计] = 高卯[计] = 空亥[计] = 逆零[计] = 间弊[计] = 总丙一[计] = 半平一[计] = 初七一[计] = 邻肆[计] = 内深[计] = 后联[计] = 素七[计] = 池贰[计] = 中合[计] = 串陆[计] = 度浅[计] = 初挂[计] = 虚贰[计] = 尾劣[计] = 外简[计] = 值从[计] = 标巳[计] = 度排[计] = 现排[计] = 空属[计] = 高弊[计] = 深零一[计] = 标集[计] = 整得一[计] = 上组[计] = 初成一[计] = 缺贰[计] = 余散[计] = 整未[计] = 原厚[计] = 首亥[计] = 现弊[计] = 间得[计] = 缺粗[计] = 空凶[计] = 整集一[计] = 中聚[计] = 短得[计] = 实序[计] = 主聚[计] = 标寅[计] = 栈凶二[计] = 存丁[计] = 净双[计] = 后拾[计] = -1; 指元素[计] = 0; 节链[计] = -1; 返 计; } /* fix 2026-08-18: 新节点溢出链指针初始 -1 */
静 空 接子(整 指, 整 字符);
静 整 表达式(空);
/* Brace initializer: walk struct si's fields, consuming values from the token
   stream ({ a, b, c }) and emitting assignments against the base expression
   (a Nd(1) var or a Nd(15) nested-member node). Nested struct fields recurse;
   array fields expand per element. Returns a block of assignment nodes. */
静 整 值布(整 构序, 整 基) {
    整 块 = 建节(5);
    整 域序 = 0;
    /* C99 aggregate init zeroes every member not explicitly initialized. qcc only
       emitted the listed fields, so `struct strvec blank = STRVEC_INIT` left nr/alloc
       as stack garbage and strvec_clear looped over a garbage count. Zero all scalar
       fields first; the explicit initializer below then overwrites the listed ones.
       (fix 2026-08-15 git_jiayan --version crash in strvec_clear) */
    遍 (整 零 = 0; 零 < 类型表[构序].函; 零++) {
        整 域型 = 类型表[构序].毛利[零];
        整 域尺寸 = 类型表[构序].现捌[零];
        整 行 = 类型表[构序].域行数[零];
        若 ((域型 >= 0 && 类型表[域型].尺寸 == 域尺寸) || (行 > 0 && 域尺寸 > 行)) {
            /* nested struct/array field: memset(&base.field, 0, fsz) — 设计化初始化器未覆盖的
               嵌套字段必须清零 (C 语义; fix 2026-08-19: REV_INFO_INIT 的 prune_data 等嵌套字段
               原跳过 → 垃圾 → setup_revisions 读垃圾 nr → status 崩) */
            字 满寅一[64]; 内存设置(满寅一, 0, 64); 复制字符串(满寅一, 类型表[构序].正辰[零]); /* 2026-08-28 编译DAG: memset 清零 — strcpy 尾部栈垃圾 → memcpy(nn,zf,32) 使 nn 哈希非确定 */
            整 素巳 = 建节(15); 复制内存((字*)(节名表 + 素巳), 满寅一, 32); 节值表[素巳] = 0;
            接子(素巳, 基);
            整 宽甲 = 建节(11); 接子(宽甲, 素巳); /* &base.field */
            整 素又 = 建节(4);
            整 旁降 = 建节(1); 复制内存((字*)(节名表 + 旁降), "memset", 7);
            接子(素又, 宽甲);                       /* arg0 = &field */
            整 长柒 = 建节(0); 节值表[长柒] = 0; 接子(素又, 长柒); /* arg1 = 0 */
            整 旧附 = 建节(0); 节值表[旧附] = 域尺寸; 接子(素又, 旧附); /* arg2 = fsz */
            接子(素又, 旁降);                     /* callee LAST */
            接子(块, 素又);
            续; /* nested struct/array: not scalar */
        }
        字 串升[64]; 复制字符串(串升, 类型表[构序].正辰[零]);
        整 内存 = 建节(15); 复制内存((字*)(节名表 + 内存), 串升, 32); 节值表[内存] = 0;
        接子(内存, 基);
        整 零值 = 建节(0); 节值表[零值] = 0;
        整 赋值 = 建节(10); 接子(赋值, 内存); 接子(赋值, 零值); 接子(块, 赋值);
    }
    循环 (词型表[词位] != 右花 && 词型表[词位] != 词终) { /* until } — fidx may exceed fn for out-of-order designators (fix 2026-08-05) */
        若 (词型表[词位] == 逗号 || 词型表[词位] == 分号) { 词位++; 续; } /* skip comma between values */
        若 (词型表[词位] == 右花) 断;
        若 (词型表[词位] == 句点 && 词型表[词位 + 1] == 词变量) { /* designated initializer: .field = expr */
            词位++; /* . */
            字 栈得[64]; 复制字符串(栈得, 词名表[词位]); 词位++; /* field name */
            若 (词型表[词位] == 赋号) 词位++; /* = */
            整 顺败 = -1;
            遍 (整 乙 = 0; 乙 < 类型表[构序].函; 乙++) 若 (!比较字符串(类型表[构序].正辰[乙], 栈得)) { 顺败 = 乙; 断; }
            若 (顺败 < 0) { 整 剩申 = 0; 循环 (词位 < 词容量 && 词型表[词位] != 词终) { 若 (词型表[词位] == 左花) 剩申++; 否 若 (词型表[词位] == 右花) { 若 (剩申 == 0) 断; 剩申--; 若 (剩申 == 0) { 词位++; 断; } } 否 若 (词型表[词位] == 逗号 && 剩申 == 0) 断; 词位++; } 续; } /* fix 2026-08-16 根因G: 未知字段跳过需花括号配平且 _bd=0 的 } 是外层闭合(不消费) — 原遇任意 UK 就停(嵌套 {2} 截断) → 元素边界错乱 → 数组层 leaf 死循环 */
            域序 = 顺败; /* jump to the designated field (may go BACK) */
            /* fix 2026-08-19: 嵌套设计器链 .field.member = val — 设计器分支只设 fidx 就 continue,
               loop-top 会把 .member 当外层字段查 → tgt<0 → 吞掉 (REV_INFO_INIT 的 .pruning.flags.recursive
               等嵌套设计器失效 → rev_info 未初始化 → status 崩)。沿链直走: .in.x → 下钻到最内层字段,
               expr() 取末值, 自然停在顶层逗号 (不能用 brace_fields 递归 — 会吞掉后续逗号字段)。 */
            若 (词型表[词位] == 句点 && 类型表[构序].毛利[顺败] >= 0 &&
                类型表[构序].现捌[顺败] == 类型表[类型表[构序].毛利[顺败]].尺寸) {
                整 函数数一 = 类型表[构序].毛利[顺败];
                整 暂细 = 建节(15); 复制内存((字*)(节名表 + 暂细), 类型表[构序].正辰[顺败], 32); 节值表[暂细] = 0;
                接子(暂细, 基);
                循环 (词型表[词位] == 句点 && 词型表[词位 + 1] == 词变量) {
                    词位++; /* . */
                    字 主玖[64]; 内存设置(主玖, 0, 64); 复制字符串(主玖, 词名表[词位]); 词位++; /* member — 2026-08-28 编译DAG: memset 清零 (同 zf/vn, 栈缓冲尾部不置零 → memcpy(32) 拷垃圾 → nn 哈希非确定) */
                    若 (词型表[词位] == 赋号) 词位++; /* = */
                    整 余繁 = -1;
                    若 (函数数一 >= 0) 遍 (整 乙 = 0; 乙 < 类型表[函数数一].函; 乙++) 若 (!比较字符串(类型表[函数数一].正辰[乙], 主玖)) { 余繁 = 乙; 断; }
                    若 (余繁 < 0) { 整 剩申 = 0; 循环 (词位 < 词容量 && 词型表[词位] != 词终) { 若 (词型表[词位] == 左花) 剩申++; 否 若 (词型表[词位] == 右花) { 若 (剩申 == 0) 断; 剩申--; 若 (剩申 == 0) { 词位++; 断; } } 否 若 (词型表[词位] == 逗号 && 剩申 == 0) 断; 词位++; } 断; }
                    整 行对 = 建节(15); 复制内存((字*)(节名表 + 行对), 主玖, 32); 节值表[行对] = 0;
                    接子(行对, 暂细);
                    暂细 = 行对;
                    函数数一 = (余繁 >= 0) ? 类型表[函数数一].毛利[余繁] : -1; /* 下钻: 若成员是标量 (fty=-1) 链到此为止 */
                    若 (词型表[词位] == 赋号) 词位++; /* = */
                }
                整 赋值 = 建节(10); 接子(赋值, 暂细); 接子(赋值, 表达式()); 接子(块, 赋值);
                续;
            }
            /* fix 2026-08-16 根因G: 成员设计器链 .value.update = {...} — 当前字段是匿名 union/struct 8字节近似 (无类型链接无法下钻), 后续 .member 段整体 opaque 消费 (原下一轮 loop-top 设计器分支把 .update 当本层字段查 → tgt<0 → 边界错乱 → 数组层 leaf 死循环 AST 溢出 merged_test.c) */
            若 (词型表[词位] == 句点 && 类型表[构序].毛利[域序] < 0 && 类型表[构序].现捌[域序] == 8 && 类型表[构序].域行数[域序] == 8) {
                整 剩申 = 0;
                循环 (词位 < 词容量 && 词型表[词位] != 词终) {
                    若 (词型表[词位] == 左花) 剩申++;
                    否 若 (词型表[词位] == 右花) { 若 (剩申 == 0) 断; 剩申--; 若 (剩申 == 0) { 词位++; 断; } } /* _bd=0 的 } 是外层闭合(元素结束, 不消费); 值自身的 } 使 _bd 1→0 消费后停 (fix 2026-08-16: 原把元素闭合也消费 → 边界错乱) */
                    否 若 (词型表[词位] == 逗号 && 剩申 == 0) 断;
                    词位++;
                }
            }
            续;
        }
        若 (域序 >= 类型表[构序].函) { 整 源系 = 词位; 表达式(); 若 (词位 == 源系) { 循环 (词位 < 词容量 && 词型表[词位] != 逗号 && 词型表[词位] != 分号 && 词型表[词位] != 右花 && 词型表[词位] != 词终) 词位++; } /* expr 未推进 → 手动跳分隔符 (fix 2026-08-16: color.c attrs[] sizeof("..")-1 漏 ) 卡 KK → fidx 空转 2^31 溢出 INT_MIN 越界崩) */ 域序++; 续; } /* all fields consumed: drop extra values */
        字 串升[64]; 复制字符串(串升, 类型表[构序].正辰[域序]);
        整 域型 = 类型表[构序].毛利[域序];
        整 主复 = 类型表[构序].现捌[域序];
        整 新退 = 类型表[构序].域行数[域序];
        整 内存 = 建节(15); 复制内存((字*)(节名表 + 内存), 串升, 32); 节值表[内存] = 0;
        接子(内存, 基);
        /* fix 2026-08-07: 指针字段 (ftype=指向的 struct, 但 fsz=8 ≠ struct size) 不递归 —
           自引用结构体 struct LNode { int v; struct LNode *next; } 的 next 若递归 → 无限递归死循环 */
        整 正零 = (域型 >= 0 && 类型表[域型].尺寸 != 主复);
        若 (域型 >= 0 && !正零) { /* nested struct field */
            若 (词型表[词位] == 左花) { /* explicit nested braces { ... }: recurse into fields */
                词位++;
                整 减法 = 值布(域型, 内存);
                若 (词型表[词位] == 右花) 词位++; /* skip closing } */
                遍 (整 键 = 0; 键 < 256; 键++) { 整 字符 = 取子(减法, 键); 若 (字符 > 0) 接子(块, 字符); }
            } 否 若 (词型表[词位] == 句点) { /* 成员设计器链 .value.update = {...}: 递归进嵌套 struct 处理 (fix 2026-08-16 根因G: merged_test.c .value.update = { .old_hash = { 2 }, .name = "..." } — 原 expr() 卡 DT 不推进 → 元素边界错乱 → 数组层 leaf 死循环 AST 溢出) */
                整 减法 = 值布(域型, 内存);
                若 (词型表[词位] == 右花) 词位++; /* skip closing } */
                遍 (整 键 = 0; 键 < 256; 键++) { 整 字符 = 取子(减法, 键); 若 (字符 > 0) 接子(块, 字符); }
            } 否 { /* struct VALUE expr (e.g. .needle = *want): copy whole struct (fix 2026-08-14: 原递归 brace_fields 误把 *want 当字段 → 死循环/崩溃) */
                整 评值 = 表达式();
                整 赋值 = 建节(10); 接子(赋值, 内存); 接子(赋值, 评值); 接子(块, 赋值);
            }
        } 否 若 (新退 > 0 && 主复 > 新退) { /* array field: per element */
            整 净浅一 = 主复 / 新退;
            整 末浅 = (词型表[词位] == 左花); /* explicit array braces { a, b } (fix 2026-08-14: 原不消费 { → expr() 卡 FK 死循环) */
            若 (末浅) 词位++;
            遍 (整 戊序 = 0; 戊序 < 净浅一; 戊序++) {
                若 (词型表[词位] == 逗号 || 词型表[词位] == 分号) 词位++;
                若 (词型表[词位] == 右花 || 词型表[词位] == 词终) 断;
                整 毛进二 = 戊序;
                若 (词型表[词位] == 左方) { /* [idx] = value 指定下标 (fix 2026-08-14: .colors = { [GREP_COLOR_CONTEXT] = "..." } 原 [ 无分支 → expr() 返回 -1 死循环/崩溃) */
                    词位++;
                    若 (词型表[词位] == 常数) { 毛进二 = 词值表[词位]; 词位++; }
                    否 若 (词型表[词位] == 词变量) { 整 评测数 = 全回(词名表[词位]); 若 (评测数 == 0x80000000) 评测数 = 域零(词名表[词位]); 若 (评测数 != 0x80000000 && 评测数 != -1) 毛进二 = 评测数; 词位++; }
                    若 (词型表[词位] == 右方) 词位++;
                    若 (词型表[词位] == 赋号) 词位++;
                }
                整 实伴 = 建节(14); 接子(实伴, 内存);
                整 序标 = 建节(0); 节值表[序标] = 毛进二; 接子(实伴, 序标);
                整 赋值 = 建节(10); 接子(赋值, 实伴); 接子(赋值, 表达式()); 接子(块, 赋值);
            }
            若 (末浅) { 循环 (词型表[词位] == 逗号 || 词型表[词位] == 分号) 词位++; 若 (词型表[词位] == 右花) 词位++; } /* skip matching } (trailing comma inside array braces) */
        } 否 若 (词型表[词位] == 左花) { /* opaque nested brace (union field .u = { ... } 且 fty=-1): 跳过配平 (fix 2026-08-14: expr() 遇 { 崩溃) */
            整 元二 = 1; 词位++;
            循环 (词位 < 词容量 && 元二 > 0) { 若 (词型表[词位] == 左花) 元二++; 否 若 (词型表[词位] == 右花) { 元二--; 若 (元二 <= 0) { 词位++; 断; } } 词位++; }
        } 否 若 (域型 < 0 && 主复 == 8 && 新退 == 8 && 词型表[词位] == 句点) { /* 匿名 union/struct 8字节近似的成员设计器链 (防御: 正常路径由设计器分支 blob-consumer 处理) */
            整 剩申 = 0;
            循环 (词位 < 词容量 && 词型表[词位] != 词终) {
                若 (词型表[词位] == 左花) 剩申++;
                否 若 (词型表[词位] == 右花) { 若 (剩申 == 0) 断; 剩申--; 若 (剩申 == 0) { 词位++; 断; } }
                否 若 (词型表[词位] == 逗号 && 剩申 == 0) 断;
                词位++;
            }
        } 否 { /* scalar field */
            整 评值 = 表达式();
            整 赋值 = 建节(10); 接子(赋值, 内存); 接子(赋值, 评值); 接子(块, 赋值);
        }
        域序++;
    }
    返 块;
}

静 整 逆低一(常 字 *串值) {
    /* 甲言中文关键字已在 lexer 改写成英文 (tn), 此处只认英文 */
    /* 改层 (2026-08-31): 中文关键字第一等 — 直接认中文, 不经过英文改写 */
    若 (!比较字符串(串值, "断")) 返 标利; /* break */
    若 (!比较字符串(串值, "例")) 返 案例; /* case */
    若 (!比较字符串(串值, "字") || !比较字符串(串值, "字节")) 返 型词; /* char */
    若 (!比较字符串(串值, "常")) 返 型词; /* const */
    若 (!比较字符串(串值, "续") || !比较字符串(串值, "继续")) 返 下退一; /* continue */
    若 (!比较字符串(串值, "缺")) 返 缺省; /* default */
    若 (!比较字符串(串值, "做")) 返 副丁; /* do */
    若 (!比较字符串(串值, "双")) 返 型词; /* double */
    若 (!比较字符串(串值, "否") || !比较字符串(串值, "否则")) 返 虚伍; /* else */
    若 (!比较字符串(串值, "枚")) 返 枚词; /* enum */
    若 (!比较字符串(串值, "单")) 返 型词; /* float */
    若 (!比较字符串(串值, "遍")) 返 净吉; /* for */
    若 (!比较字符串(串值, "跳")) 返 大于; /* goto */
    若 (!比较字符串(串值, "若")) 返 顺轮; /* if */
    若 (!比较字符串(串值, "整")) 返 型词; /* int */
    若 (!比较字符串(串值, "长") || !比较字符串(串值, "长整")) 返 型词; /* long */
    若 (!比较字符串(串值, "返") || !比较字符串(串值, "返回")) 返 后甲; /* return */
    若 (!比较字符串(串值, "短")) 返 型词; /* short */
    若 (!比较字符串(串值, "大小")) 返 度序; /* sizeof */
    若 (!比较字符串(串值, "静")) 返 型词; /* static */
    若 (!比较字符串(串值, "构")) 返 结构词; /* struct */
    若 (!比较字符串(串值, "择")) 返 开关; /* switch */
    若 (!比较字符串(串值, "联")) 返 结构词; /* union */
    若 (!比较字符串(串值, "无")) 返 型词; /* unsigned */
    若 (!比较字符串(串值, "空")) 返 型词; /* void */
    若 (!比较字符串(串值, "易失")) 返 型词; /* volatile */
    若 (!比较字符串(串值, "循环")) 返 下得一; /* while */

    若 (!比较字符串(串值, "struct") || !比较字符串(串值, "union")) 返 结构词; /* union shares the struct machinery (offset-0 fields) */
    若 (!比较字符串(串值, "extern")) 返 型词;
    若 (!比较字符串(串值, "static")) 返 型词; /* treat as type modifier */
    若 (!比较字符串(串值, "const")) 返 型词;
    若 (!比较字符串(串值, "volatile")) 返 型词; /* 类型修饰符（fix 2026-08-06: 内核 MMIO 需要; 当普通 VK 跳过, 语义同 int） */
    若 (!比较字符串(串值, "restrict")) 返 型词; /* C99 类型修饰符 (优化提示; qcc 无优化器, 忽略语义正确 — fix 2026-08-25 支持矩阵补全) */
    若 (!比较字符串(串值, "_Atomic")) 返 型词; /* C11 类型修饰符 (单线程下当普通类型, 无原子语义 — fix 2026-08-25 支持矩阵补全) */
    若 (!比较字符串(串值, "void")) 返 型词;
    若 (!比较字符串(串值, "FILE") || !比较字符串(串值, "long")) 返 型词; /* builtin types used by self-host */
    若 (!比较字符串(串值, "enum")) 返 枚词;
    若 (!比较字符串(串值, "return")) 返 后甲;
    若 (!比较字符串(串值, "if")) 返 顺轮;
    若 (!比较字符串(串值, "else")) 返 虚伍;
    若 (!比较字符串(串值, "while")) 返 下得一;
    若 (!比较字符串(串值, "do")) 返 副丁;
    若 (!比较字符串(串值, "goto")) 返 大于;
    若 (!比较字符串(串值, "for")) 返 净吉;
    若 (!比较字符串(串值, "break")) 返 标利;
    若 (!比较字符串(串值, "continue")) 返 下退一;
    若 (!比较字符串(串值, "switch")) 返 开关;
    若 (!比较字符串(串值, "case")) 返 案例;
    若 (!比较字符串(串值, "default")) 返 缺省;
    若 (!比较字符串(串值, "signed")) 返 型词; /* fix 2026-08-15: signed char const cq_lookup[] — signed 未识别为关键字 */
    若 (!比较字符串(串值, "unsigned")) 返 型词;
    若 (!比较字符串(串值, "int") || !比较字符串(串值, "double")) 返 型词;
    若 (!比较字符串(串值, "char")) 返 型词;
    若 (!比较字符串(串值, "_Bool")) 返 型词;
    若 (!比较字符串(串值, "inline")) 返 型词;
    若 (!比较字符串(串值, "short")) 返 型词; /* fix 2026-08-06: short 缺词法分类 → struct 字段被当标识符注册成幻影字段, 布局错乱 (回归测试 regress_struct_align 暴露) */
    若 (!比较字符串(串值, "void")) 返 型词;
    若 (!比较字符串(串值, "sizeof")) 返 度序;
    若 (!比较字符串(串值, "_Alignof")) 返 容吉一; /* C11 对齐查询 (fix 2026-08-25 支持矩阵补全 step1) */
    若 (!比较字符串(串值, "_Noreturn")) 返 型词; /* C11 函数修饰符 (fix 2026-08-25 支持矩阵补全 step2: 函数定义 VK 循环自然跳过) */
    若 (!比较字符串(串值, "_Generic")) 返 满酉; /* C11 泛型选择 (fix 2026-08-25 支持矩阵补全 step6) */
    返 常数;
}

/* C11 _Alignof: 解析 (类型) 返回对齐值 — 与 sizeof 同族但语义不同 (fix 2026-08-25 支持矩阵补全 step1) */
静 整 净乙一(空) {
    整 累加低 = 4; /* default: int 对齐 */
    若 (词型表[词位] == 型词) { /* 基本类型 (含 unsigned/signed/long 修饰符链) */
        整 初成 = 0;
        遍 (;;) {
            若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) { 累加低 = 1; 词位++; }
            否 若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) { 累加低 = 2; 词位++; }
            否 若 ((!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) { 初成++; 累加低 = (初成 >= 2) ? 8 : 4; 词位++; }
            否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) { 累加低 = 8; 词位++; }
            否 若 ((!比较字符串(词名表[词位], "unsigned") || !比较字符串(词名表[词位], "无")) || !比较字符串(词名表[词位], "signed") || (!比较字符串(词名表[词位], "int") || !比较字符串(词名表[词位], "整")) || (!比较字符串(词名表[词位], "void") || !比较字符串(词名表[词位], "空"))) { 词位++; }
            否 断;
        }
        循环 (词型表[词位] == 乘) { 累加低 = 8; 词位++; } /* 指针 → 8 */
    } 否 若 (词型表[词位] == 结构词) { /* struct/union: 用 st_field_sz_r 维护的最大对齐 algn */
        词位++;
        若 (词型表[词位] == 词变量) {
            整 构序 = 查类型(词名表[词位]);
            若 (构序 >= 0 && (类型表[构序].函 > 0 || 类型表[构序].尺寸 > 0)) 累加低 = 类型表[构序].满卯; /* 已定义结构体用最大对齐 (全 char 结构 algn=1 也是真值); 前向声明保持默认 */
            词位++;
        }
    } 否 若 (词型表[词位] == 枚词) { /* enum → int 对齐 4 */
        词位++; 若 (词型表[词位] == 词变量) 词位++;
    } 否 若 (词型表[词位] == 词变量) { /* typedef 名 */
        整 型定序 = 型定查(词名表[词位]);
        若 (型定序 >= 0) {
            若 (型定表[型定序].是否构标) {
                整 构序 = 查类型(型定表[型定序].构名一);
                若 (构序 >= 0 && (类型表[构序].函 > 0 || 类型表[构序].尺寸 > 0)) 累加低 = 类型表[构序].满卯;
            } 否 {
                整 容薄 = 型定表[型定序].尺寸;
                若 (容薄 >= 8) 累加低 = 8; 否 若 (容薄 >= 4) 累加低 = 4; 否 若 (容薄 >= 2) 累加低 = 2; 否 累加低 = 1;
            }
        }
        词位++;
    }
    循环 (词型表[词位] == 左方) { /* 数组 T[N]: 对齐=元素对齐(已算), 消费 [N] */
        词位++;
        若 (词型表[词位] == 常数 || 词型表[词位] == 词变量) 词位++;
        若 (词型表[词位] == 右方) 词位++;
    }
    返 累加低;
}

/* _Generic 控制表达式类型判定 (fix 2026-08-25 step6): 0=int 1=char 2=short 3=ll 4=double 5=uns 6=ptr 7=struct 8=other */
静 整 旁系(整 数) {
    若 (数 < 0) 返 8;
    整 暂 = 节型表[数];
    若 (暂 == 终简) 返 4; /* double literal */
    若 (暂 == 0) { 若 (指元素[数] > 0) 返 6; 若 (节浮标[数]) 返 4; 若 (节长标[数]) 返 3; 若 (节无符号[数]) 返 5; 返 0; } /* int literal — fix 2026-08-27 特性#5: LL 字面量节点标记是 nll[n] (原 tll[n] 是 lexer token 数组, 恒 0 → 42LL 选成 int); fix 2026-08-27 特性#concepts: ndbl[n] → (double)0 cast 后字面量节点判 double; pesz[n]>0 → (T*)0 cast 后字面量判指针 */
    若 (暂 == 1) {
        字 *变节 = (字*)(节名表 + 数);
        若 (变量是否浮(变节)) 返 4;
        若 (变量是否长(变节)) 返 3;
        若 (变量是否无符号(变节)) 返 5;
        若 (变量是否字符(变节)) 返 1;
        若 (变量是否短(变节)) 返 2;
        若 (变量指元素(变节) > 0) 返 6;   /* pointer */
        若 (变量数组(变节) > 0) 返 6; /* fix 2026-08-27 特性#5: 数组名衰减为指针 (_Generic 匹配 char* 分支) */
        若 (变量型序(变节) >= 0) 返 7; /* struct var */
        返 0;
    }
    若 (暂 == 4) { /* call: callee 节点 n0 是函数名 */
        整 号对 = 子0[数]; 若 (号对 < 0) 返 8;
        字 *函 = (字*)(节名表 + 号对);
        若 (查函数浮返(函) || 终陆(函) >= 0 || 序贰(函) == 2) 返 4;
        若 (查函数长返(函) || 序贰(函) == 1) 返 3;
        返 0;
    }
    若 (暂 == 19) { 若 (指元素[数] > 0) 返 6; 若 (节浮标[数]) 返 4; 若 (节长标[数]) 返 3; 若 (节无符号[数]) 返 5; 返 0; } /* cast — fix 2026-08-27 特性#concepts: ndbl[n] → (double) cast 判 double; pesz[n]>0 → (T*) cast 判指针 */
    若 (暂 == 10) 返 旁系(子0[数]); /* assign: lhs 类型 */
    若 (暂 == 14) 返 旁系(子0[数]); /* arr[i]: 元素类型 (近似) */
    若 (暂 == 2) { /* binop 结果类型 */
        整 算子 = 节值表[数];
        若 (算子 == 逻辑与 || 算子 == 逻辑或 || 算子 == 比等 || 算子 == 名庚 || 算子 == 比小 || 算子 == 外三 || 算子 == 隔系 || 算子 == 宽排) 返 0; /* 比较/逻辑 → int */
        若 (算子 == 帧寅 || 算子 == 号庚) 返 旁系(子0[数]); /* 移位: 左操作数 */
        整 暂利 = 旁系(子0[数]), 符拾 = 旁系(子1[数]);
        若 (暂利 == 4 || 符拾 == 4) 返 4;
        若 (暂利 == 3 || 符拾 == 3) 返 3;
        若 (暂利 == 5 || 符拾 == 5) 返 5;
        若 (暂利 == 6 || 符拾 == 6) 返 6;
        返 0;
    }
    返 8;
}
/* _Generic 关联类型解析 → 同上 id; -1 解析失败 */
静 整 中十(空) {
    若 (词型表[词位] == 乘) { 循环 (词型表[词位] == 乘) 词位++; 返 6; } /* 指针 */
    若 (词型表[词位] == 型词) {
        若 ((!比较字符串(词名表[词位], "int") || !比较字符串(词名表[词位], "整"))) { 词位++; 若 (词型表[词位] == 乘) { 循环 (词型表[词位] == 乘) 词位++; 返 6; } 返 0; }
        若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) { 词位++; 若 (词型表[词位] == 乘) { 循环 (词型表[词位] == 乘) 词位++; 返 6; } 返 1; }
        若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) { 词位++; 若 (词型表[词位] == 乘) { 循环 (词型表[词位] == 乘) 词位++; 返 6; } 返 2; }
        若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) { 词位++; 若 (词型表[词位] == 乘) { 循环 (词型表[词位] == 乘) 词位++; 返 6; } 返 4; }
        若 ((!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) { 词位++; 若 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) 词位++; 若 (词型表[词位] == 乘) { 循环 (词型表[词位] == 乘) 词位++; 返 6; } 返 3; }
        若 ((!比较字符串(词名表[词位], "unsigned") || !比较字符串(词名表[词位], "无"))) { 词位++; 若 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) 词位++; 若 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) 词位++; 若 (词型表[词位] == 乘) { 循环 (词型表[词位] == 乘) 词位++; 返 6; } 返 5; }
        若 ((!比较字符串(词名表[词位], "void") || !比较字符串(词名表[词位], "空"))) { 词位++; 返 8; }
        若 ((!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常")) || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")) || !比较字符串(词名表[词位], "restrict")) { 词位++; 返 中十(); } /* 限定符跳过 */
        词位++; 返 8; /* 其他 VK */
    }
    若 (词型表[词位] == 结构词) { 词位++; 若 (词型表[词位] == 词变量) 词位++; 返 7; } /* struct */
    若 (词型表[词位] == 枚词) { 词位++; 若 (词型表[词位] == 词变量) 词位++; 返 0; } /* enum → int */
    若 (词型表[词位] == 词变量) { /* typedef */
        整 型定序 = 型定查(词名表[词位]);
        若 (型定序 >= 0) {
            若 (型定表[型定序].是否构标) { 词位++; 返 7; }
            若 (型定表[型定序].是否浮标) { 词位++; 返 4; }
            若 (型定表[型定序].尺寸 == 8) { 词位++; 返 3; }
            若 (型定表[型定序].尺寸 == 1) { 词位++; 返 1; }
            若 (型定表[型定序].尺寸 == 2) { 词位++; 返 2; }
        }
        词位++;
        返 8;
    }
    返 -1;
}

静 空 词法(常 字 *串值) {
    整 计 = 0; 词序 = 0; 词位 = 0; 整 半壬 = 0; 整 当前行 = 1; /* fix 2026-08-05: 未知字符计数, lex 结束汇报; 接入 2026-08-28: 行号追踪 (tline[ti]=cur_line) */
    循环 (串值[计] && 词序 < 词容量) {
        循环 (串值[计] == ' ' || 串值[计] == '\n' || 串值[计] == '\t' || 串值[计] == '\r' || 串值[计] == '\f' || 串值[计] == '\v') { 若 (串值[计] == '\n') 当前行++; 计++; } /* fix 2026-08-13 Phase3: \f/\v 是合法空白 — 漏掉会落入 switch default 发射 tt=0(EK) 幽灵 token, 中间截断 parse (regex_internal.c 第40行 \f); 接入 2026-08-28: 数换行更新 cur_line */
        若 (!串值[计]) 断;
        若 (顺一 && 串值[计] != '#') { 若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) { 若 (串值[计] == '\n') 当前行++; 计++; } 若 (串值[计]) 计 += 2; 续; } /* fix 2026-08-26 cpython: 跳过区内块注释整体跳到闭合符 — pyconfig.h 注释里含条件指令示例文本, 逐行跳过会把注释内容当真指令 → 条件栈失衡 → 守卫 endif 关错层; 接入 2026-08-28: 块注释内换行数 cur_line (loc.line 精确) */ 循环 (串值[计] && 串值[计] != '\n') 计++; 续; } /* false branch: skip whole code lines (fix 2026-08-05) */
        若 (串值[计] == '/' && 串值[计 + 1] == '/') { 循环 (串值[计] && 串值[计] != '\n') 计++; 续; }
        若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) { 若 (串值[计] == '\n') 当前行++; 计++; } 若 (串值[计]) 计 += 2; 续; } /* 接入 2026-08-28: 块注释内换行数 cur_line (loc.line 精确) */
