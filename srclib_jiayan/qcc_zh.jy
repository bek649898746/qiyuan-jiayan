    汇发("    自增 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,0); 发字节(0xFF); 模字节(3, 0, 2); /* inc rdx \xe2\x80\x94 REX.W=1 (fix 2026-08-23 t35h) */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9d */
