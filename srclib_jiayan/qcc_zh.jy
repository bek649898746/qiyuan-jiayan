    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "解构")) { /* 接入 2026-08-28 解构赋值 (同时赋值): 解构(a, b, c) = (e1, e2, e3); → { __dc_0=e1; __dc_1=e2; __dc_2=e3; a=__dc_0; b=__dc_1; c=__dc_2; } — RHS 先整体求值 (临时变量), 再逐个写 LHS; 变量数 2-N */
        词位++; /* 解构 */
