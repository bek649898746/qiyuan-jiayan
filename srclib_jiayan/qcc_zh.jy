        遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && 变量码生成可见(计)) { 若 (变量表[计].栈偏移 < 0) { 变量表[计].栈偏移 = 静态数; 静态数 += ((变量表[计].可空值标 || 指元素 > 0) ? 2 : 1); } 变量末序 = 计; 变可空待 = 0; 返 变量表[计].栈偏移; } /* 修复 2026-08-14: 外部 声明后的暂定定义 整数 x; 应把 外部 槽升级为定义 (原直接返回负槽 → x 永远 未定义 → strbuf_slopbuf 未定义); S2a 挂账修复: 复用旧条目不回溯重标, 清 待 防漏 */
    若 (变量数 >= 65536 || 静态数 >= 0x20000000) { 输出到文件(错误流, "[ERR] 变量表满 变量数=%d\n", 变量数); 退出(1); } /* 修复 2026-08-26 数据库: 静态数 上限 0x4000000→0x20000000 — 串表 扩到 32768 槽 (256兆字节) 后静态槽数顶满旧 67M 上限 */
