                        压栈寄存器(0); /* &b */
                        若 (变量是否静态(源计数)) { 中发(缺捌, 容伍, 1, 0); 中刷(); } 否 { 中发(副失, 0, 变量基(源计数, 容伍) - 当前帧大小, 0); 中刷(); } /* Phase3-IR case10: 大结构拷贝 &a */
