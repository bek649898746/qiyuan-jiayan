    判载码p[变节][判载数p[变节]] = 判载码;
    判载数p[变节] = 判载数p[变节] + 1;
    若 (词型表[词位] == 逗号) { 词位++; 续; }
    断;
    }
    若 (词型表[词位] == 右括) 词位++;
    }
    }
