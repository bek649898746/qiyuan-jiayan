                否 若 (调宽 == 2) { 汇发("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(1); }
