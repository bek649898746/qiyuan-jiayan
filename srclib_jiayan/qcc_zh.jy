            否 若 (是否长标) { 余乙(变节); 若 (无符号标) 变量表[变量数 - 1].无符号标 = 1; }
            否 { 变量偏移(变节); 若 (是否字符标) 变量表[变量数 - 1].是否字符标 = 1; 若 (是否短标) 变量表[变量数 - 1].是否短标 = 1; 若 (无符号标) 变量表[变量数 - 1].无符号标 = 1; }
            复制内存((字*)(节名表 + 元), 变节, 32);
            可空零值注入(元, 变节, 0); /* S2a (2026-09-09): 可空 typeof 无初始化器 → 注入 0 */
            若 (词型表[词位] == 赋号) { 词位++; 未初始化移除(变节); 接子(元, 赋值级()); } /* #78: 声明带初始化 */
            若 (词型表[词位] == 分号) 词位++;
            接子(发字节, 元); 字节计数++;
            续;
        }
        /* 第 207 站 (2026-09-21 真接入) · R26-余 d: **裸标签名 的 指针数组** (`点 *c[2];`)**。
           第 206 站 那支 刻意 排除了 数组形态 (结尾 `[`)—— 但 排除并 不 等于 原路径正确:
           实测 `点 *c[2]; c[0] = &u; c[0]->x;` → **v=0** (而 `结构体 点 *c[2];` 同形 → v=5)。
           QCC_DUMP=vars 铁证: 裸标签名的 `c` 被 登记为 **纯标量** (数组=0 指深=0)
           而 typedef 形态同名变量 正常 —— 两者 差在 **标降一** (型定判断)。
