            }
            /* 情形2: a = &对象 → 重指向 + 槽重填 (找槽函数 按新类型 绑定) */
            字 类型名[64] = ""; { 整 对节 = 值; 若 (对节 >= 0 && 节型别[对节] == 节点_取址) 对节 = 子0[对节]; 若 (对节 >= 0 && 节型别[对节] == 节点_变量) { 整 型序 = 变量型序((字*)(节名表 + 对节)); 若 (型序 >= 0) 复制字符串(类型名, 类型表[型序].名); } }
            若 (!类型名[0] || 找实序(接口名, 类型名) < 0) { 格式化到串(错缓冲, "接口: 类型 %s 未实现接口 %s (接口引用重绑定需 实现 绑定; #195)", 类型名[0] ? 类型名 : "?", 接口名); 发错误("A9005", 错缓冲); }
            { 字 名数[80]; 格式化到串(名数, "__ir_%s_数", 引用名);
              整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 名数, 32); 整 赋 = 建节(10); 接子(赋, 左); 接子(赋, 值); 接子(块, 赋); }
            遍 (整 槽 = 0; 槽 < 方法数; 槽++) {
                字 函数名[64]; 找槽函数(接口序, 类型名, 槽, 函数名);
                若 (!函数名[0]) { 格式化到串(错缓冲, "接口: 类型 %s 未绑定接口 %s 方法 %s (槽 %d; 重绑定 #195)", 类型名, 接口名, 接口表[接口序].槽名[槽], 槽); 发错误("A9005", 错缓冲); }
                { 字 名槽[80]; 格式化到串(名槽, "__ir_%s_m%d", 引用名, 槽);
                  整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 名槽, 32); 整 赋 = 建节(10); 接子(赋, 左); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 函数名, 64); 接子(赋, 函); } 接子(块, 赋); }
            }
            返 块;
        }
    }
    若 (词型表[词位] == 分号) { 词位++; 返 建节(5); } /* 空语句 ; — 返回空块节点 (码生成器 无输出). 修复 2026-08-19: 原落 赋值级() 兜底返回 -1 (不消费) → 语句() 挂 -1 给 若 空体 → 例-8 码生成器 子1=-1 错乱 → `若 (c) ; 否则 ...` 否则 链无条件执行 (提交.c handle_ignored_arg 比较字符串(空) 段错误) */
    
    /* F3 (2026-09-14): 原 此处 置 `语句表达式丢弃 = 1` —— 该标 过粗 (整 语句 级), 使 裸 表达式语句 内 **所有** 子表达式
       (函数 实参 / 下标 / 二元 操作数 / 转型) 的 除法 **全部 失去 除零 检查** (实测 `printf("%d\n", a / z);` 硬件崩 0xC0000094,
       而 `int r = f(a, a / z);` 正常 —— 因 赋值() 里有 B8 先例 先清 该标)。C 语义: "表达式语句 的 值 丢弃" ≠ "其 子表达式 不执行" —
       除零 陷阱 仍 会 发生, 故 检查 必须 保留; 真 死代码 (控制流 不可达) 由 码生成器 的 DCE (`本弃`) 处理, 与 本标 无关。 */
    { 整 终 = 表达式(); 元得(终); /* A9-余账 #3 (2026-09-14): 表达式语句 改 用 **真 表达式()** (含 逗号层) —— 原 赋值级() 使 顶层 逗号 的 后半段
       **逃出 语句体**: 实测 `若 (0) i = 1, j = 2;` 的 `j = 2` 被 当 独立 语句 **无条件 执行** (gcc `0 0` / 甲言 `0 2`; `当 (0) ...` 同).
       C 语义 6.8.3: 表达式语句 = expression (含 逗号运算符). 语句体 (若/当/循环 的单语句体) 走 本 分支 ⟹ 本 处 是 唯一 收口点. */
      若 (终 >= 0 && 节型别[终] == 节点_赋值 && 子0[终] >= 0 && 子1[终] >= 0 && (节型别[子0[终]] == 节点_成员 || 节型别[子0[终]] == 节点_箭头 || (节型别[子0[终]] == 节点_下标 && 子0[子0[终]] >= 0 && (节型别[子0[子0[终]]] == 节点_成员 || 节型别[子0[子0[终]]] == 节点_箭头)))) { /* #195 存储面 下标基/数组列 赋值: 目标=接口字段 (叶 15/13 或 14 盖接口数组列) → 整组槽写; 原泛型只写槽0 静默错 */
          字 场基[64]; 字 场名[64]; 整 场接口序 = -1; 整 场箭 = 0;
          若 (域接口信息(子0[终], 场基, 场名, &场接口序, &场箭)) {
              整 块 = 建节(5);
              域接口赋值叶(块, 子0[终], 子1[终], 场接口序); { 整 尾钩 = 子0[终]; 整 钩直 = -1; 整 钩跳 = 0; 整 钩深 = 0; 循环 (尾钩 >= 0 && 钩跳 < 8 && (节型别[尾钩] == 节点_下标 || 节型别[尾钩] == 节点_成员 || 节型别[尾钩] == 节点_箭头 || 节型别[尾钩] == 节点_解引用)) { 若 (节型别[尾钩] == 节点_成员) { 钩直 = 尾钩; 钩深++; } 尾钩 = 子0[尾钩]; 钩跳++; } 若 (钩深 <= 1) { 若 (钩直 >= 0) 尾写字段(场基, (字*)(节名表 + 钩直)); 否 尾写字段(场基, 场名); } 否 { 字 钩径[48]; 钩径[0] = 0; 整 尾钩2 = 子0[终]; 整 钩跳2 = 0; 循环 (尾钩2 >= 0 && 钩跳2 < 8 && (节型别[尾钩2] == 节点_下标 || 节型别[尾钩2] == 节点_成员 || 节型别[尾钩2] == 节点_箭头 || 节型别[尾钩2] == 节点_解引用)) { 若 (节型别[尾钩2] == 节点_成员) { 若 (钩径[0]) { 字 钩新[48]; 格式化到串(钩新, "%s.%s", (字*)(节名表 + 尾钩2), 钩径); 复制字符串(钩径, 钩新); } 否 { 复制字符串(钩径, (字*)(节名表 + 尾钩2)); } } 尾钩2 = 子0[尾钩2]; 钩跳2++; } 尾写路径(场基, 钩径); } } /* I2-③ (2026-09-10): 接口字段写经此路径 → 直接字段=整初始化; 嵌套 (a.内.s) → 路径登记 (读同叶放行) */
              词位++; 返 块;
          }
      }
       若 (终 >= 0 && 节型别[终] == 节点_赋值 && 子0[终] >= 0 && 节型别[子0[终]] == 节点_变量) { /* BatchB (2026-09-06): 语句级赋值覆写守卫目标 — 目标槽 F 条件析构旧值 + 赋值 + F=1; RHS 整变量源槽 (本语句被 移源 撤就绪, 串寅=0) → F=0 (Rust drop-on-overwrite/move-out; 路径精确) */
           字 目标名[64]; 复制字符串(目标名, (字*)(节名表 + 子0[终]));
           整 槽目 = 守卫槽找(目标名);
           字 外流基[64]; 外流基[0] = 0;
           若 (守卫外流拒(子1[终], 外流基)) { 格式化到串(错缓冲, "所有权错误: 守卫变量 '%s' 的非Copy字段 不可拷贝外流 (RHS = %s.字段 赋值会双所有权; 用 移入 整个 %s 或先 丢弃; Rust E0509)", 外流基, 外流基, 外流基); 发错误("A3106", 错缓冲); } /* G9 (2026-09-06): 守卫基 字段拷贝外流 编译期拒 */
           整 块 = 建节(5);
           整 构序目 = (槽目 >= 0) ? 变量型序(目标名) : -1;
           若 (构序目 >= 0) { /* A2 (2026-09-06): 先求值 RHS 入临时槽 → 析构旧值 → 搬入目标 (Rust drop 顺序: RHS 副作用先于析构; 含 自引用 a=f(a) 正确) */
               字 临时名[64]; 格式化到串(临时名, "__td_tmp_%d", 临析数); 临析数 = 临析数 + 1; 变构(临时名, 构序目);
               整 赋1 = 建节(10); { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 临时名, 64); 接子(赋1, 左); } 接子(赋1, 子1[终]);
               接子(块, 赋1); /* 临时 = RHS (RHS 副作用先跑) */
               接子(块, 守卫条件析构(槽目)); /* 析构旧值 */
               整 赋2 = 建节(10); { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 目标名, 64); 接子(赋2, 左); } { 整 右 = 建节(1); 复制内存((字*)(节名表 + 右), 临时名, 64); 接子(赋2, 右); }
               接子(块, 赋2); /* 目标 = 临时 */
               接子(块, 守卫置F(槽目, 1)); /* 目标 现持新值 → 武装 */
            } 否 {
               若 (槽目 >= 0 && !节点含变(子1[终], 目标名)) 接子(块, 守卫条件析构(槽目)); /* 析构旧值 (F 判, 路径精确) */
               接子(块, 终);
               若 (槽目 >= 0) 接子(块, 守卫置F(槽目, 1)); /* 目标 现持新值 → 武装 */
            }
           若 (子1[终] >= 0 && 节型别[子1[终]] == 节点_变量) { 整 槽源 = 守卫槽找((字*)(节名表 + 子1[终])); 若 (槽源 >= 0 && !守卫表[槽源].槽串) 接子(块, 守卫置F(槽源, 0)); } /* RHS 整变量 被本语句移动 (移源 撤就绪) → F=0; Copy/自赋值 不撤 → 不动 */
           词位++; 返 块;
       }
      若 (终 >= 0 && 节型别[终] == 节点_赋值 && 子0[终] >= 0 && 节型别[子0[终]] == 节点_下标 && 子1[子0[终]] >= 0 && (节型别[子1[子0[终]]] == 节点_常数 || 节型别[子1[子0[终]]] == 节点_变量)) { /* B1/B1b (2026-09-06): 数组元素 常量/变量下标 覆写赋值 (a[c]=RHS / a[i]=RHS) → 析构旧元素(若已武装) + 赋值 + F[索引]=1 */
          整 下标节 = 子0[终]; 整 基 = 子0[下标节]; 整 索 = 子1[下标节];
          若 (基 >= 0 && 节型别[基] == 节点_变量) {
              字 基名[64]; 复制字符串(基名, (字*)(节名表 + 基));
              整 槽 = 守卫槽找(基名);
              若 (槽 >= 0 && 守卫表[槽].型.tag == 槽型_数组槽) {
                  若 (节型别[索] == 节点_常数) { /* 常量下标 */
                      整 宽k = 节值表[索];
                      若 (宽k >= 0 && 宽k < 守卫表[槽].型.p0) {
                          整 块 = 建节(5);
                          若 (!节点含变(子1[终], 基名)) 接子(块, 守卫元素析构(槽, 宽k)); /* 析构旧元素 (若已武装; RHS 引用数组基则跳过) */
                          接子(块, 终);
                          接子(块, 守卫置F元素(槽, 宽k, 1)); /* 元素武装 */
                          词位++; 返 块;
                      }
                  } 否 { /* B1b: 变量下标 (动态 F[i]) */
                      整 块 = 建节(5);
                      若 (!节点含变(子1[终], 基名)) 接子(块, 守卫元素析构动(槽, 索)); /* 析构旧元素 (动态下标) */
                      接子(块, 终);
                      接子(块, 守卫置F元素动(槽, 索, 1)); /* 元素武装 (动态 F[i]=1) */
                      词位++; 返 块;
                  }
              }
          }
      }
      若 (终 >= 0 && 节型别[终] == 节点_调用) { /* A6 (2026-09-06): 裸调用 返回析构类型 (丢弃返回值) → 临时 移入本地 + 自动析构 (Rust: 丢弃临时仍 drop) */
          整 被调 = 调用被调者(终);
          若 (被调 >= 0) {
              整 构序 = 查返回名((字*)(节名表 + 被调));
              若 (构序 >= 0 && (型析查序(构序) || 类型含析构字段(构序))) {
                  字 临时名[64]; 格式化到串(临时名, "tdret_%d", 临析数); 临析数 = 临析数 + 1; 变构(临时名, 构序);
                  整 块 = 建节(5);
                  整 赋 = 建节(10); { 整 左 = 建节(1); 复制内存((字*)(节名表 + 左), 临时名, 64); 接子(赋, 左); } 接子(赋, 终);
                  接子(块, 赋); /* 临时 = 裸调用 (sret 落临时) */
                  接子(块, 类型析构自动(临时名, 构序, 1)); /* 登记守卫 + F=1 → 块尾析构 */
                  词位++; 返 块;
              }
          }
      }
      若 (表达式内覆写查(终)) { 格式化到串(错缓冲, "所有权错误 (TypeDrop A1): 析构类型变量覆写赋值须语句级 — 表达式内覆写会漏析构旧值; 请拆出语句 b = 新X(2);"); 发错误("A3110", 错缓冲); } /* A1 (2026-09-06): 表达式语句 内嵌 覆写守卫/析构目标 拒 (wrapper 已包 语句尾赋值, 本行前已返) */
      词位++; 返 终; }
}
/* 常量整数表达式求值 (数组维度用): 支持整数/枚举/宏常量、括号、+-*\/%<>^&| 与一元 +-~。
   左到右求值 (维度表达式几乎都是单运算符, 优先级差异可忽略)。成功置 *数值 并推进 词位, 返回 1; 失败不推进, 返回 0。
   (修复 2026-08-14: hash_algos[GIT_HASH_NALGOS] 展开成 [(2 + 1)] — 原数组维度只认单 常数/词变量 词元, `(` 卡住 → 维度=0 → 后续 null_oid 定义被吞 未定义) */
静 整 常量表达式求值(整 *数值); /* 前向 */
静 整 常无符号 = 0; /* D 位运算族 (2026-09-13): 常量表达式 求值 中 当前 值 是否 带 无符号 属性 — `0u`/`~0u` 折叠 后 右移 必须 逻辑移 (gcc: (~0u)>>1 = 2147483647; 原 一律 算术移 → 4294967295 错) */
静 整 末列(整 *数值) {
    若 (词型表[词位] == 常数) { *数值 = 词值表[词位]; 若 (词无符号表[词位]) 常无符号 = 1; 词位++; 返 1; }
    若 (词型表[词位] == 容吉一) { /* _Alignof 常量求值 (修复 2026-08-25 支持矩阵补全 步一) */
        词位++; 若 (词型表[词位] == 左括) 词位++;
        *数值 = 净乙一();
        若 (词型表[词位] == 右括) 词位++;
        返 1;
    }
    若 (词型表[词位] == 度序) { /* 尺寸 常量维度: 字符 暂存[尺寸 "..."] (修复 2026-08-15: inet_ntop.c tp 未注册 未定义) */
        词位++; 若 (词型表[词位] == 左括) 词位++; /* 尺寸( */
        整 尺寸 = 4;
        /* 修复 2026-08-17: 尺寸((数组)[序标]) — 括号数组元素 (ARRAY_SIZE(paths) 展开成
           尺寸(paths)/尺寸((paths)[0])): (paths) 括号后跟 [0] 下标, 原代码既不进
           词变量 分支也不被 左括 分支消费 → 尺寸 错 + 词元 残留 → 数组维度求值错 →
           左升 越界崩 (差异-无-索引.c to_free 0xC0000005). */
        若 (词型表[词位] == 左括 && 词型表[词位 + 1] == 词变量 && 词型表[词位 + 2] == 右括 && 词型表[词位 + 3] == 左方) {
            整 半再一 = 变量元素(词名表[词位 + 1]); 若 (半再一 > 0) 尺寸 = 半再一;
            词位 += 4; 循环 (词位 < 词容量 && 词型表[词位] != 右方 && 词型表[词位] != 词终) 词位++; 若 (词型表[词位] == 右方) 词位++;
            若 (词型表[词位] == 右括) 词位++; /* 末尾 ) */
            *数值 = 尺寸; 返 1;
        }
        若 (词型表[词位] == 串词) { 尺寸 = (整)取字长(串表[词值表[词位]]) + 1; 词位++; }
        否 若 (词型表[词位] == 型词) { 若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节"))||!比较字符串(词名表[词位],"_Bool")) 尺寸=1; 否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) 尺寸=8; 否 若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) 尺寸=2; 词位++; 循环 (词型表[词位] == 乘) { 尺寸 = 8; 词位++; } }
        否 若 (词型表[词位] == 结构词) { 词位++; 若 (词型表[词位] == 词变量) { 整 构序 = 查类型(词名表[词位]); 若 (构序 >= 0) 尺寸 = 类型表[构序].尺寸; 词位++; } }
        否 若 (词型表[词位] == 乘) { 尺寸 = 8; 词位++; 若 (词型表[词位] == 词变量) 词位++; }
        否 若 (词型表[词位] == 词变量) { 整 构序 = 变量型序(词名表[词位]);
            若 (构序 < 0 && 型定判断(词名表[词位])) { 整 型定序 = 型定查(词名表[词位]); 若 (型定序 >= 0 && 型定表[型定序].尺寸 > 0) { 尺寸 = 型定表[型定序].尺寸; 词位++; } } /* 修复 2026-08-20: 类型定义 名 尺寸 (尺寸(uint64_t) 原 4 → csprng_bytes(&v,尺寸(v)) 只填低 4 字节 → mkstemp 随机后缀高 4 字节垃圾 → 乱码文件名) */
            否 词位++;
            若 ((词型表[词位] == 箭头 || 词型表[词位] == 句点) && 词型表[词位 + 1] == 词变量) { 若 (构序 >= 0) { 整 直弊 = 字段尺寸直(构序, 词名表[词位 + 1]); 若 (直弊 > 0) 尺寸 = 直弊; } 词位 += 2; }
            /* 修复 2026-08-17: 尺寸(裸数组名) 返回数组总字节数 (数组尺寸 * 元素尺寸) — 原默认 4 →
               ARRAY_SIZE(数组) 展开 尺寸(数组) 除错 → 数组维度求值错 (差异-无-索引.c to_free).
               仅当是数组变量 (数组尺寸>0) 才覆盖, 普通变量保持默认 4. */
            否 { 整 深六 = 长壹(词名表[词位 - 1]); 若 (深六 > 0) 尺寸 = 深六; } } /* 修复 2026-08-20: 普通变量 尺寸 (长整 长整 v → 8; 原 4); 修复 2026-08-28: 数组总字节统一走 长壹 (2D 用标量元素大小, 尺寸(整数[2][2])=16 非 32) */
        若 (词型表[词位] == 右括) 词位++;
