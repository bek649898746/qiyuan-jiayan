            整 后成功 = (判字母数字((无 字)串值[乙]) || 串值[乙] == '_' || ((无 字)串值[乙] >= 0x80));
            字 名存[64]; 整 段玖 = 乙 - 计;
            若 (段玖 < 63) { 复制内存(名存, 串值 + 计, 段玖); 名存[段玖] = 0; } 否 段玖 = 0; /* 修复 2026-08-15: 32→64, FIND_BISECTION_FIRST_PARENT_ONLY (32 字符) 原 段玖>=31 被丢弃不展开 → 未定义 */
             
            若 (!前成功 && !后成功 && 段玖 > 0) {
                常 字 *数值 = 双繁一(名存);
                 
                整 号八 = 0;
                循环 (数值 && 号八 < 32 && (整)取字长(数值) < 4000) {
                    常 字 *值二 = 双繁一(数值);
                    若 (!值二 || 值二 == 数值) 断;
                    /* 链式: 数值 本身也是对象宏名 → 继续替换 */
                    整 变节 = 0; 循环 (判字母数字((无 字)数值[变节]) || 数值[变节] == '_' || ((无 字)数值[变节] >= 0x80)) 变节++;
                    若 (数值[变节] != 0) 断; /* 值含非标识符 → 不再链式 */
                    数值 = 值二;
                    号八++;
                }
                若 (数值) {
                    整 虚合;
                    若 (正四 < 32 && 数值[0]) { /* 修复 2026-08-13 第三阶段: 递归展开宏值 — BITSET_WORDS=(SBC_MAX/BITSET_WORD_BITS) 内层宏原不展开 */
                        正四++;
                        字 *宽捌一 = 实退一(数值);
                        正四--;
                        虚合 = (整)取字长(宽捌一);
                        若 (丙 + 虚合 < 容量 - 4) { 复制内存(出 + 丙, 宽捌一, 虚合); 丙 += 虚合; }
                        释放内存(宽捌一);
                    } 否 { 虚合 = (整)取字长(数值); 若 (丙 + 虚合 < 容量 - 4) { 复制内存(出 + 丙, 数值, 虚合); 丙 += 虚合; } }
                    计 = 乙; 续;
                }
            }
            循环 (计 < 乙) 出[丙++] = 串值[计++];
            续;
        }
        出[丙++] = 串值[计++];
        若 (丙 >= 容量 - 4) { 容量 *= 2; /* 修复 2026-08-13 第三阶段: 倍增替代 +32768 (提升 重分配 泄漏) */; 出 = 重分配(出, 容量); }
    }
    出[丙] = 0;
    返 出;
}/* 字符串 #定义 终复: #定义 名 "值" — 修复 2026-08-03: 仅 数
   终复 曾 supported, 故 route_learn's LOG_DIR/WEIGHTS_FILE 已编译 到
   空 → scan_logs(空) 已崩 在 该 格式化限长 %s 拷贝 循环. 该 已解码
   值 是 已存 此处 且 已拷贝 入 串表 于 该 使用 段次 (assigning 该
   末丙 在 源-引用 顺序), 故 该 .字串 末丙 顺序 == 全伴 placement 顺序
   且 该 3-阶段 首利二==计简一 字符串 layout stays identical. */
静 构 { 字 名[64]; 字 数值[2048]; } 净深[4096]; /* 修复 2026-08-06; Phase1-L3: 64->1024 */ 静 整 串宏数;
静 字 *源亥(常 字 *数) { 遍 (整 计 = 0; 计 < 串宏数; 计++) 若 (!比较字符串(净深[计].名, 数)) 返 净深[计].数值; 返 0; }
/* 修复 2026-08-07: 包含 展开阶段收集 #定义 名字 — 使 包含 守卫 (#若无定义 X ... #endif) 在
   缓卯 内生效, 重复 #包含 的头不再重复展开其内部 #包含 (防指数膨胀) */
静 字 单肆[8192][64]; 静 整 毛复[8192]; 静 整 虚五; /* 修复 2026-08-13: 128→2048 (目录.c 头文件链满 → CONFIG_H 注册被丢 → 重复 包含 重复展开 → 同名 函数宏 重复收集 → 副组 互递归栈溢出); P1 静默根治 (2026-09-15): 2048→8192 + 满则 原得 响亮拒绝 (原 静默 返 ⟹ 对象宏 登记 丢失) */
静 整 邻细(常 字 *数); /* 前向: 定义在下方 (外合 用到) */
静 空 首丙一(常 字 *数, 整 值) { 若 (虚五 >= 8192) 原得("对象宏表 单肆/毛复", 8192); 遍 (整 计 = 0; 计 < 虚五; 计++) 若 (!比较字符串(单肆[计], 数)) { 毛复[计] = 值; 返; } 复制字符串(单肆[虚五], 数); 毛复[虚五] = 值; 虚五++; }
静 空 缺得(常 字 *数) { 遍 (整 计 = 0; 计 < 虚五; 计++) 若 (!比较字符串(单肆[计], 数)) { 遍 (整 乙 = 计; 乙 < 虚五 - 1; 乙++) 复制字符串(单肆[乙], 单肆[乙 + 1]); 虚五--; 返; } }
静 整 外合(常 字 *数) { 若 (邻细(数)) 返 1; 遍 (整 计 = 0; 计 < 虚五; 计++) 若 (!比较字符串(单肆[计], 数)) 返 1; 返 0; }
静 整 前利(常 字 *数) { 遍 (整 计 = 0; 计 < 虚五; 计++) 若 (!比较字符串(单肆[计], 数)) 返 毛复[计]; 返 0; }
/* 解析 #定义 名 [值] — 名字 + 数值 (未解析到 → 0; 支持 -N / 0xN / (N)) */
静 空 毛简(常 字 *指, 字 *名存, 整 *数值) {
    常 字 *寻 = 指 + 1; 循环 (*寻 == ' ' || *寻 == '\t') 寻++; 寻 += (寻[0] == 'd' ? 6 : 9); /* 跳过 #  定义 (修复 2026-08-13 第三阶段: # 后空白 — glibc 缩进指令) */
    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
    整 名序 = 0;
    循环 (判字母数字((无 字)*寻) || *寻 == '_' || ((无 字)*寻 >= 0x80)) { 若 (名序 < 63) 名存[名序++] = *寻; 寻++; }
    名存[名序] = 0;
    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
    长 长 值 = 0; 整 负 = 0; /* 修复 2026-08-09 审计 缺陷-3: 整数 v 累加 3000000000 有符号溢出 UB → 长整 长整 */
    若 (*寻 == '-') { 负 = 1; 寻++; }
    循环 (*寻 == '(') 寻++; /* (N) 括号包 (修复 2026-08-07) */
    若 (*寻 == '-') { 负 = 1; 寻++; } /* A107b (2026-09-14): 括号内 再 负号 —— C 标准头 的 最小值宏 一律 `(-MAX - 1)` 形式 */
    若 (*寻 == '0' && (寻[1] == 'x' || 寻[1] == 'X')) {
        寻 += 2; 循环 (判十六进制((无 字)*寻)) { 整 字符 = *寻; 值 = 值 * 16 + (字符 >= '0' && 字符 <= '9' ? 字符 - '0' : (字符 >= 'a' && 字符 <= 'f' ? 字符 - 'a' + 10 : 字符 - 'A' + 10)); 寻++; }
    } 否 若 (*寻 == '0' && 寻[1] >= '0' && 寻[1] <= '7') { /* 八进制 0170000 = 61440 (修复 2026-08-17: 原无八进制分支 → 版本库 S_IFMT 0170000 存成十进制 170000 → S_IS* 模式检查全错, is_directory 恒 假) */
        循环 (*寻 >= '0' && *寻 <= '7') { 值 = 值 * 8 + (*寻 - '0'); 寻++; }
    } 否 若 (*寻 >= '0' && *寻 <= '9') {
        循环 (*寻 >= '0' && *寻 <= '9') { 值 = 值 * 10 + (*寻 - '0'); 寻++; }
    }
    { 循环 (*寻 == ' ' || *寻 == '\t') 寻++; 若 (*寻 == '-') { 寻++; 循环 (*寻 == ' ' || *寻 == '\t') 寻++; 若 (*寻 >= '0' && *寻 <= '9') { 长 长 尾值 = 0; 循环 (*寻 >= '0' && *寻 <= '9') { 尾值 = 尾值 * 10 + (*寻 - '0'); 寻++; } 值 = 值 + 尾值; } } } /* A107b (2026-09-14): `(-MAX - 1)` 的 减法尾巴 —— 原 只 认 `-N` / `(N)`, 遇 多 词元 表达式 得 0 ⇒ A107 (limits.h 改 表达式 形式) 后 `object-file.c` 崩 (0xC0000005). 现 支持 `- ` + 数值 ⇒ 值 = MAX + 1, 再 按 负号 取反 */
    *数值 = (整)(负 ? -值 : 值);
}
静 整 预处求值(常 字 *终); /* 前向: 定义在 函数宏 区之后 (行申 的条件编译感知用) */
静 整 剩辰(常 字 *新厚) { /* 修复 2026-08-26 解析器: 关系比较无符号感知 — 操作数是单个已注册无符号宏 (长十一=1, 值被 整数 截断为负) 时, 比较按 32 位无符号 */
    整 长度一 = (整)取字长(新厚);
    循环 (长度一 > 0 && (新厚[长度一 - 1] == ' ' || 新厚[长度一 - 1] == '\t')) 长度一--;
    整 串值 = 0; 循环 (串值 < 长度一 && (新厚[串值] == ' ' || 新厚[串值] == '\t')) 串值++;
    整 段玖 = 长度一 - 串值;
    若 (段玖 <= 0 || 段玖 > 63) 返 0;
    字 名存[64]; 复制内存(名存, 新厚 + 串值, 段玖); 名存[段玖] = 0;
    遍 (整 计 = 0; 计 < 宏数; 计++) 若 (!比较字符串(终复[计].名, 名存) && 长十一[计]) 返 1;
    返 0;
}

/* 函数-像 终复: #定义 名(p1,满列) 函数体 — collected, 调用 expanded 由 计进二 之前 lexing (修复 2026-08-05: 曾 已跳 → 调用 堆丑 曾 未定义-函数 调用) */
静 构 { 字 名[64]; 字 容败[16][64]; 整 参数数; 字 体[16384]; 字 约束[64]; } 函数宏表[2048]; 静 整 函数宏数; 静 字 变参名[2048][64]; /* 阶段C-1 #72 变参模板 (2026-09-01): 泛型 名(x, 尾...) — 变参收集参数名 (副组展开 余参逗号连接; 独立数组防结构体布局变更) */ /* 修复 2026-08-15: 1024→2048 — 松.c 等大文件 包含 链函数宏超 1024, strbuf_reset 未收集 → 未定义 */ /* 约束 (阶段C-1 #45 2026-09-01): 泛型 名: 接口(参数) — 参数类型须实现接口 */
静 字 余简[2048]; /* 修复 2026-08-15: #未定义 只删多行函数宏(展开会爆 抽象语法树); 单行 检查(x) 保留以便展开 */
静 字 内联宏标[2048]; /* P0-6 (2026-09-14): #93 内联 英文 inline 特性 注册的条目 标记 — 该特性 (L1176) 把用户可见的
   `inline 类型 名(参数) { 返 expr; }` **注册进 函数宏表**, 使 邻细()/外合() (即 `defined(名)` / `#ifdef 名`) **误判**
   "名已定义" (实测: `static inline int nm(void){...}` 后 `defined(nm)` 为真, 而 `static int nm(void){...}` 为假;
   根因 = #93 把 函数定义 当 宏定义)。⇒ `邻细` 第三 循环 跳过 标记条目 (保留 #93 的 展开 能力, 只 关掉 它对
   "是否已定义" 判定 的 污染)。⚠️ 触发 15/20 git 文件 的 `namespace conflict` 即 此。 */
静 整 缺三[1024]; 静 整 序对[1024]; 静 整 条件编译数; /* Phase1-L4: 64->1024 */ 静 整 外系; /* 行申 的条件编译栈 (修复 2026-08-07) */
静 整 邻细(常 字 *数) { /* 修复 2026-08-06: 区分「未找到」(-1) 与「负值宏」— 域零 的 -1 哨兵与负值混淆, 序布(取负) 判假 */
    遍 (整 计 = 0; 计 < 宏数; 计++) 若 (!比较字符串(终复[计].名, 数)) 返 1;
    遍 (整 计 = 0; 计 < 串宏数; 计++) 若 (!比较字符串(净深[计].名, 数)) 返 1;
    遍 (整 计 = 0; 计 < 函数宏数; 计++) 若 (!内联宏标[计] && !比较字符串(函数宏表[计].名, 数)) 返 1; /* P0-6: 跳过 #93 内联 注册的条目 (见 内联宏标 注释) */
    返 0;
}
/* #未定义: 移除 名 自 numeric/字符串/函数 宏 表 (修复 2026-08-05) */
静 空 半从(常 字 *数) {
    遍 (整 计 = 0; 计 < 宏数; 计++) 若 (!比较字符串(终复[计].名, 数)) { 遍 (整 乙 = 计; 乙 < 宏数 - 1; 乙++) 终复[乙] = 终复[乙 + 1]; 宏数--; 返; }
    遍 (整 计 = 0; 计 < 串宏数; 计++) 若 (!比较字符串(净深[计].名, 数)) { 遍 (整 乙 = 计; 乙 < 串宏数 - 1; 乙++) 净深[乙] = 净深[乙 + 1]; 串宏数--; 返; }
    遍 (整 计 = 0; 计 < 函数宏数; 计++) 若 (!比较字符串(函数宏表[计].名, 数)) { 遍 (整 乙 = 计; 乙 < 函数宏数 - 1; 乙++) { 函数宏表[乙] = 函数宏表[乙 + 1]; 余简[乙] = 余简[乙 + 1]; } 函数宏数--; 返; }
}

/* 对象宏收集 (词法 前): #定义 A <表达式/标识符> — 非函数宏非字符串宏非纯数字 (修复 2026-08-13) */
静 空 原从(常 字 *串值) {
    栈凶 = 0;
    条件编译数 = 0; 外系 = 0; /* 修复 2026-08-13 第三阶段: 条件编译感知 — 假分支里的 #定义 不收 (否则 #否则 里的 标签 "C" 覆盖 #若 里的 "A") */
    虚五 = 0; /* 修复 2026-08-13 第三阶段: 自建顺序定义表 — 复用 行申 的全表会误判文件后部的 #定义 已定义 (RE_TRANSLATE_TYPE 在 #若无定义 处被误判) */
    遍 (整 计 = 0; 串值[计]; 计++) {
        若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) 计++; 计++; 续; }
        若 (串值[计] == '/' && 串值[计 + 1] == '/') { 循环 (串值[计] && 串值[计] != '\n') 计++; 续; }
        若 (串值[计] == '"') { 计++; 循环 (串值[计] && 串值[计] != '"') { 若 (串值[计] == '\\') 计++; 计++; } 续; }
        若 (串值[计] == '\'') { 计++; 循环 (串值[计] && 串值[计] != '\'') { 若 (串值[计] == '\\') 计++; 计++; } 续; }
        若 (串值[计] == '#') {
            整 深乙 = 计 + 1; 循环 (串值[深乙] == ' ' || 串值[深乙] == '\t') 深乙++; /* 修复 2026-08-13 第三阶段: 跳过 # 后空白 — glibc 缩进指令 #  定义 */
             
            整 是否条件编译 = ((!比前n(串值 + 深乙, "ifdef", 5) && (串值[深乙 + 5] == 0 || 串值[深乙 + 5] == ' ' || 串值[深乙 + 5] == '\t' || 串值[深乙 + 5] == '\r' || 串值[深乙 + 5] == '\n')) || (!比前n(串值 + 深乙, "若有定义", 12) && (串值[深乙 + 12] == 0 || 串值[深乙 + 12] == ' ' || 串值[深乙 + 12] == '\t' || 串值[深乙 + 12] == '\r' || 串值[深乙 + 12] == '\n')));
            整 外二 = ((!比前n(串值 + 深乙, "ifndef", 6) && (串值[深乙 + 6] == 0 || 串值[深乙 + 6] == ' ' || 串值[深乙 + 6] == '\t' || 串值[深乙 + 6] == '\r' || 串值[深乙 + 6] == '\n')) || (!比前n(串值 + 深乙, "若无定义", 12) && (串值[深乙 + 12] == 0 || 串值[深乙 + 12] == ' ' || 串值[深乙 + 12] == '\t' || 串值[深乙 + 12] == '\r' || 串值[深乙 + 12] == '\n')));
            整 序粗 = !比前n(串值 + 深乙, "if", 2) && !是否条件编译 && !外二 && (串值[深乙 + 2] == 0 || 串值[深乙 + 2] == ' ' || 串值[深乙 + 2] == '\t' || 串值[深乙 + 2] == '\r' || 串值[深乙 + 2] == '\n');
            整 下环 = !比前n(串值 + 深乙, "elif", 4) && (串值[深乙 + 4] == 0 || 串值[深乙 + 4] == ' ' || 串值[深乙 + 4] == '\t' || 串值[深乙 + 4] == '\r' || 串值[深乙 + 4] == '\n');
            整 短再 = !比前n(串值 + 深乙, "else", 4) && (串值[深乙 + 4] == 0 || 串值[深乙 + 4] == ' ' || 串值[深乙 + 4] == '\t' || 串值[深乙 + 4] == '\r' || 串值[深乙 + 4] == '\n');
            整 短叁 = ((!比前n(串值 + 深乙, "endif", 5) && (串值[深乙 + 5] == 0 || 串值[深乙 + 5] == ' ' || 串值[深乙 + 5] == '\t' || 串值[深乙 + 5] == '\r' || 串值[深乙 + 5] == '\n')) || (!比前n(串值 + 深乙, "结束若", 9) && (串值[深乙 + 9] == 0 || 串值[深乙 + 9] == ' ' || 串值[深乙 + 9] == '\t' || 串值[深乙 + 9] == '\r' || 串值[深乙 + 9] == '\n')));
            整 内戊 = ((!比前n(串值 + 深乙, "define", 6) && (串值[深乙 + 6] == 0 || 串值[深乙 + 6] == ' ' || 串值[深乙 + 6] == '\t' || 串值[深乙 + 6] == '\r' || 串值[深乙 + 6] == '\n')) || (!比前n(串值 + 深乙, "定义词", 9) && (串值[深乙 + 9] == 0 || 串值[深乙 + 9] == ' ' || 串值[深乙 + 9] == '\t' || 串值[深乙 + 9] == '\r' || 串值[深乙 + 9] == '\n')));
            整 高属 = (!比前n(串值 + 深乙, "undef", 5) && (串值[深乙 + 5] == 0 || 串值[深乙 + 5] == ' ' || 串值[深乙 + 5] == '\t' || 串值[深乙 + 5] == '\r' || 串值[深乙 + 5] == '\n')) || (!比前n(串值 + 深乙, "未定义", 9) && (串值[深乙 + 9] == 0 || 串值[深乙 + 9] == ' ' || 串值[深乙 + 9] == '\t' || 串值[深乙 + 9] == '\r' || 串值[深乙 + 9] == '\n')); /* #未定义 9 字节 (2026-09-01 双认) */ /* 修复 2026-08-21: 对象宏收集阶段识别 #未定义 — 原完全忽略 → #未定义 后对象宏仍被文本层展开 */
            若 (序粗 || 是否条件编译 || 外二 || 下环 || 短再 || 短叁) {
                整 父节 = 外系; 整 条件 = 0;
                若 (是否条件编译 || 外二) {
                    字 名存[64]; 整 名序 = 0; 整 寻 = 深乙; 循环 (判字母数字((无 字)串值[寻]) || 串值[寻] == '_' || ((无 字)串值[寻] >= 0x80)) 寻++;
