            }
            若 (外系) { /* 假分支: #定义/#未定义 一律不收 */
                循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) { 计++; } 若 (串值[计]) 计 += 2; 续; } 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') 计 += 2; 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') 计 += 3; 否 计++; } /* 修复 2026-08-26 脚本语言: 续行感知 (同上) */
                续;
            }
            若 (高属) { /* 修复 2026-08-07: 顺序定义表删除 (收集 阶段 #未定义 生效) */
                整 寻 = 元 + (串值[元] == 'u' ? 5 : 9); /* #undef 5 / #未定义 9 字节 */
                循环 (串值[寻] == ' ' || 串值[寻] == '\t') 寻++;
                字 存申[64]; 整 逆肆 = 0;
                循环 (判字母数字((无 字)串值[寻]) || 串值[寻] == '_') { 若 (逆肆 < 63) 存申[逆肆++] = 串值[寻]; 寻++; }
                存申[逆肆] = 0;
                若 (逆肆 > 0) { 缺得(存申); 整 终低 = -1; 遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (!比较字符串(函数宏表[键].名, 存申)) { 终低 = 键; 断; } 若 (终低 >= 0 && 余简[终低] && 函数宏表[终低].体[0] == '{') 半从(存申); } /* 修复 2026-08-15: 多行 做 语句宏保留 (color.c 出 定义后使用再 #未定义); 多行 { 初始化宏仍删 (userdiff.c PATTERNS/IPATTERN 超时) */
                循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) { 计++; } 若 (串值[计]) 计 += 2; 续; } 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') 计 += 2; 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') 计 += 3; 否 计++; } /* 修复 2026-08-26 脚本语言: 续行感知 (同上) */
                续;
            }
            若 (内戊) {
            { 字 旁又[64]; 整 度戌 = 0; 毛简(串值 + 计, 旁又, &度戌); 若 (旁又[0]) 首丙一(旁又, 度戌); } /* 修复 2026-08-07: 任何 #定义 都记入顺序表 (含数值, #若 模式==2 用真值) */
            整 指 = 元 + (串值[元] == 'd' ? 6 : 9);
            循环 (串值[指] == ' ' || 串值[指] == '\t') 指++;
            字 名存[64]; 整 名序 = 0;
            循环 (判字母数字((无 字)串值[指]) || 串值[指] == '_' || ((无 字)串值[指] >= 0x80)) { 若 (名序 < 63) 名存[名序++] = 串值[指]; 指++; }
            名存[名序] = 0;
            若 (串值[指] == '(' && 函数宏数 < 2048 && 比较字符串(名存, "_va_alloc")) { /* 修复 2026-08-13: 函数宏需 ( 紧贴名字无空格 — #定义 A (x) 是表达式宏 (版本库 哈希-邻辰.h GIT_HASH_NALGOS/HEXSZ) */
                复制字符串(函数宏表[函数宏数].名, 名存);
                余简[函数宏数] = 0;
                指++;
