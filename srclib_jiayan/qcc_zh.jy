            若 (词型表[词位] == 分号) 词位++;
        }
        否 若 (词型表[词位] == 词变量 && (型定判断(词名表[词位]) || 查类型(词名表[词位]) >= 0) && 词型表[词位 + 1] != 箭头 && 词型表[词位 + 1] != 句点 && 词型表[词位 + 1] != 左方 && 词型表[词位 + 1] != 赋号 && !(词型表[词位 + 1] == 左括 && !型定判断(词名表[词位]) && 查类型(词名表[词位]) >= 0)) { /* 类型定义 或 结构体 类型 (直肆: ->/./[ = 表达式; 修复 2026-08-15: combine-差异 sline[j].标志 被当 结构体 声明 → 标志 泄漏 未定义; 修复 2026-08-18: `见 = xstrfmt(...)` — 见 恰是 版本库 的 结构体 标签 (结构体 见) → 被当类型名吞掉 → 赋值语句整个消失 → create_reference_database 的 见 未初始化 → 检查引用名格式(垃圾) → 版本库 初始化 崩) */
            整 中己 = 0; 整 名分 = 型定查(词名表[词位]); 若 (名分 >= 0 && 型定表[名分].是否浮标) 中己 = 1;
            整 内双一 = (名分 >= 0 && 型定表[名分].是否函数指); /* 类型定义'd 函数指: 8-字节 元素 (修复 2026-08-03) */
            词位++; /* 跳过 类型 名 */
            整 暂构序 = 查类型(词名表[词位-1]); 若 (暂构序 < 0) 暂构序 = 容成(词名表[词位-1]);
            整 是否构标 = (暂构序 >= 0);
            整 是否指标 = 0;
            若 (词型表[词位] == 乘) { 是否指标 = 1; 词位++; } /* 指针 */
            整 元 = 建节(7);
            若 (词型表[词位] == 词变量) {
                字 变节二[64]; 复制字符串(变节二, 词名表[词位]);
                若 (词型表[词位+1] == 左方) { /* 类型定义 结构体 数组: P 数组[3]; — 修复 2026-08-03: 曾 单-元素 */
                    整 扫描计数 = 1; 词位++; /* 消费 词变量 */
                    循环 (词型表[词位] == 左方) {
                        词位++; 若 (词型表[词位] == 常数) { 扫描计数 *= 词值表[词位]; 词位++; }
                        若 (词型表[词位] == 右方) 词位++;
                    }
                    若 (内双一 && !是否指标) { 末午(变节二, 扫描计数, 8); 若 (名分 >= 0 && 型定表[名分].函数指浮) 变量表[变量数 - 1].指浮 = 1; }
                    否 若 (是否构标 && !是否指标 && 扫描计数 > 1) { 末午(变节二, 扫描计数, 类型表[暂构序].尺寸); 定类型(暂构序, 0, -1, -1); 若 (扫描计数 <= 31) 尾阵登(变节二, 净丙); } /* I2-③ 元素级: 类型定义'd 结构体 值数组 登记 */
