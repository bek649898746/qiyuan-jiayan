    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 整 值; 复制内存(&值, &类型表[构序].字段[计].间次一, 4); 返 值; }
    返 0;
}
静 整 暂进(常 字 *符号数, 常 字 *函) { /* 位 偏移 之内 该 槽位 (修复 2026-08-05) */
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 整 值; 复制内存(&值, &类型表[构序].字段[计].高玖, 4); 返 值; }
    返 0;
}
静 整 字段是否无符号(常 字 *符号数, 常 字 *函) { /* 1 = 无符号 位-字段 (无 符号-扩展 于 读取) (修复 2026-08-05) */
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 整 值 = 0; 复制内存(&值, &类型表[构序].字段[计].值劣, 1); 返 值 != 0; }
    返 0;
}
静 整 原细(常 字 *符号数, 常 字 *函) { /* 1 = 有符号 字符 字段 (int8_t) — 字符 字段读 符号扩展 (修复 2026-08-29 生成器: 剩十/s137 联合/结构体 八位整数 字段零扩展静默) */
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) { 整 值 = 0; 复制内存(&值, &类型表[构序].字段[计].副戌, 1); 返 值 != 0; }
    返 0;
}
静 整 构尺寸(常 字 *符号数) { 整 构序 = 查类型(符号数);  返 构序 >= 0 ? 类型表[构序].尺寸 : 0; }
静 整 字段尺寸(常 字 *符号数, 常 字 *函) {
    整 构序 = 查类型(符号数); 若 (构序 < 0) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) {
            整 值; 复制内存(&值, &类型表[构序].字段[计].现捌, 4);
            若 (类型表[构序].字段[计].原进 && 值 < 8) 返 8; /* 修复 2026-08-20: 指针字段 (空 **队列 等) 跨 .o 注册 现捌=4 → 存储 32 位 → 高位残留栈垃圾 (DIFF_QUEUE_CLEAR outq.队列=空 → 版本库 状态 diff_queued_diff 分配=936 nr=32765 → diff_resolve_rename_copy 段错误) */
            返 值;
        }
    返 0;
}
静 整 字段尺寸直(整 构序, 常 字 *函) { /* G1-1a (2026-09-12): 构序 直查版 (匿名 类型 名="" 撞 第一条目 → 嵌套链 8B 成员 长标记 漏) */
    若 (构序 < 0 || 构序 >= 4096) 返 0;
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].字段[计].正辰, 函)) {
            整 值; 复制内存(&值, &类型表[构序].字段[计].现捌, 4);
            若 (类型表[构序].字段[计].原进 && 值 < 8) 返 8;
            返 值;
        }
    返 0;
}

