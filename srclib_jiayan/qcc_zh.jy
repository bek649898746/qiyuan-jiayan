静 空 内丙(整 位移, 整 寄存器) { /* movsd [rbp+disp], xmmN */
    汇发("    浮存帧 [rbp%+d], xmm%d\n", (字*)(长 长)(位移), (字*)(长 长)(寄存器), (字*)(长 长)0);
    发字节(0xF2); 发字节(0x0F); 发字节(0x11);
