                整 取验一 = 子0[函];
                若 (取验一 >= 0 && 节型别[取验一] == 节点_变量 && 查变量((字*)(节名表 + 取验一)) < 0 && 查函数纯((字*)(节名表 + 取验一)) >= 0) 函 = 取验一;
                否 { 格式化到串(错缓冲, "`&` 取址结果 不是 函数指针, 不可调用 (C 6.5.2.2: 被调者须为指向函数的指针; 函数名取址 请写 `f(...)`, 函数指针变量 请写 `(*p)(...)`) (号合.0 L-15)"); 发错误("A9010", 错缓冲); 函 = -1; 断; }
