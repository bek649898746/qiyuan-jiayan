            名存[名序] = 0;
            整 名始 = 计 - 名序; /* 宏名起始下标 — 必须在此处保存, 后面跳过空白到 ( 后 i 已移动 (fix 2026-08-15: obstack_free 原型带空格被误展开) */
            整 素散 = -1;
            遍 (整 键 = 0; 键 < 函数宏数; 键++) 若 (键 != 列陆 && !比较字符串(函数宏表[键].名, 名存)) { 素散 = 键; 断; } /* 自引用宏不重入 (fix 2026-08-07: #define A(x) A(x) 防死递归) */
            若 (素散 < 0) { /* fix 2026-08-27 ffmpeg pcmenc: fn 宏体替换时展开 obj 宏 — PCMDEF 嵌套宏 `CONFIG_PCM_ ## uppercase ## _MUXER` 拼接产物是 obj 宏, C 标准要求宏展开完成前展开; 原 fn pass 不查 obj → 拼接固化 `PCMDEF_CONFIG_PCM_U8_MUXER` → parse 挂死 */
                常 字 *直戊一 = 双繁一(名存);
                若 (直戊一 && 直戊一[0] && 余厚 < 24) { 余厚++; 副组(直戊一, 出指, 丙, 容量, -1); 余厚--; 续; }
            }
            若 (素散 >= 0) { 整 隔得 = 计; 循环 (段[隔得] == ' ' || 段[隔得] == '\t' || 段[隔得] == '\r' || 段[隔得] == '\n') 隔得++; 若 (段[隔得] == '(') 计 = 隔得; } /* fix 2026-08-13 Phase3: 函数宏调用允许名称与 ( 之间空白 — 仅真调用才跳过空白, 否则保留 (同名变量/函数指针不吞空白) */
            若 (素散 >= 0 && 段[计] == '(' && 缺亥一[素散]) { /* fix 2026-08-26 sqlite: fn_active 位置门控 — #define 之前的调用不展开 */
