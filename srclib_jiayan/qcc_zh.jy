                    移寄存器(11, 0); /* r11d = 旧 计数器 (对齐) */
                    汇发("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,0,3); 发字节(7); /* 加 r11d, 7 */
                    汇发("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,4,3); 发字节(0xF8); /* 且 r11d, 0xFFFFFFF8 — 提升 分配器 8 字节对齐 (修复 2026-08-22 t44: 原 计数器 不对齐 → xdl_malloc recs 数组未对齐 → xrecord_t* 未对齐读 → rec=0 → 提交 摘要 差异 段错误) */
