            若 (串数 >= 65536) { 输出到文件(错误流, "[STR-OVERFLOW]\n"); 终止程序(); }
            若 (!串表[串数]) 串表[串数] = 短六();
            整 计卯 = (整)读取(串表[串数], 1, 12287, 名厚); /* 槽上限 12KB (大文件后续 char[] 初始化补) */
            关文件(名厚);
            串表[串数][计卯] = 0;
            整 原属 = 串数; 串数++;
            变量静态(初联, 1); 未初始化移除(初联); /* char *数据 */
            变量静态(当降, 4); 未初始化移除(当降); /* int 长度 */
            整 整系 = 建节(5);
            { 整 值 = 建节(1); 复制内存((字*)(节名表 + 值), 初联, 32);
              整 符号数 = 建节(0); 节值表[符号数] = 原属; 节型表[符号数] = 串词;
              整 赋节 = 建节(10); 接子(赋节, 值); 接子(赋节, 符号数); 接子(整系, 赋节); } /* 数据 = 字符串槽; */
            { 整 值 = 建节(1); 复制内存((字*)(节名表 + 值), 当降, 32);
              整 计数一 = 建节(0); 节值表[计数一] = 计卯;
              整 赋节 = 建节(10); 接子(赋节, 值); 接子(赋节, 计数一); 接子(整系, 赋节); } /* 长度 = nread; */
            若 (全局初始化数 < 16384) 后凶[全局初始化数++] = 整系; /* main 入口执行 */
            续;
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "过程宏")) { /* 接入 2026-08-29 P2 #172 过程宏: 过程宏 函数名; — 前置注册代码生成宏 (须在函数定义之前; 定义体只进 CTFE 表, 不做代码生成) */
            词位++; /* 过程宏 */
            字 宏名[64]; 复制字符串(宏名, 词名表[词位]); 词位++; /* 函数名 */
            若 (词型表[词位] == 分号) 词位++;
            若 (计凶 < 256 && !首申(宏名)) { 复制字符串(顺得[计凶], 宏名); 计凶++; }
            续;
        }
        /* struct definition: struct Name { fields; }; or struct { fields; } var; */
        若 (词型表[词位] == 结构词 || (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "static") || !比较字符串(词名表[词位], "静")) && 词型表[词位 + 1] == 结构词)) {
            整 旧四 = (词型表[词位] == 型词); /* fix 2026-08-15: static struct X {...} */
            整 尾九 = 词位;
            若 (旧四) 词位++;
            整 间庚 = 词位;
            整 源高 = (!比较字符串(词名表[词位], "union") || !比较字符串(词名表[词位], "联"));
            词位++; /* skip struct */
            若 (词型表[词位] == 词变量 || (词型表[词位] == 型词 && !比较字符串(词名表[词位], "FILE"))) { /* tagged: keep the tag as the struct name (FILE 被 kw() 归为 VK, 但 `struct FILE;` 前向声明必须识别 — fix 2026-08-15: transport_connect undefined 根因) */
                整 构序 = 查类型(词名表[词位]); 若 (构序 < 0) 构序 = 构加(词名表[词位]); /* fix 2026-08-05: `struct S s;` (no body) re-added an EMPTY S → st_find later hit the wrong index → global struct field reads/writes broke */
                若 (取环境("QCC_DBG_NS")) 若 (!比较字符串(词名表[词位], "ref_namespace_info")) { 输出到文件(错误流, "[NS] main-parser struct tag='%s' si=%d next_tt=%d next='%s'\n", 词名表[词位], 构序, 词位 + 1 < 词容量 ? 词型表[词位 + 1] : -1, 词位 + 1 < 词容量 ? 词名表[词位 + 1] : "-"); 遍 (整 目又 = 词位 + 1; 目又 < 词位 + 12 && 目又 < 词容量; 目又++) 输出到文件(错误流, "[NS]   tok[%d] tt=%d '%s'\n", 目又, 词型表[目又], 词名表[目又]); }
                词位++; /* struct name */
                若 (词型表[词位] == 分号) { 词位++; 续; } /* struct X; 前向声明 (无 body 无变量) — 原回退到 decl 分支后落函数检测 break 截断 parse (fix 2026-08-13 Phase3: regex_internal.h struct re_dfa_t;) */
                若 (词型表[词位] == 左花) { /* { */
                    词位++;
                    整 函数表一 = 0; /* unsigned bit-field marker (fix 2026-08-05) */
                    整 域尺寸 = 4; 整 行 = 1; 整 值肆 = 0; 整 标一 = 0; 整 符聚 = 0; 整 间五 = 4; 整 满七 = -1; /* fix 2026-08-16 根因E: 字段类型状态提循环外 — 逗号声明 `char p_dbl, is_char, is_uns, is_ll;` 的后续字段必须继承类型 (原每次迭代重置 fsz=4 → char 字段算成 int → vars 结构 136 算成 152 → 变量表步长错位 → Git 大文件崩); fpel_persist: 逗号继承的指针指向元素大小 (fix 2026-08-17); sty_persist: 逗号续行 struct 字段继承类型索引 (fix 2026-08-18: struct list_head *next, *prev — 续行 *prev 原缺 st_field_ty → st_field_ty_idx=-1 → mem_addr 链 head.prev->next 失败 → 存储丢弃+无配对 push → git init list_add_tail 崩) */
                    整 副戌 = 0; 整 单又 = 0; /* fix 2026-08-29 csmith: 字段 signed char 标记 (int8_t/signed char 字段读 movsx — 原 char 字段恒 movzx → 0xB3 零扩展 179 非 -77, s3/s137 静默); fcsgn_pend: signed 前缀暂存 (signed char 组合) */
                    循环 (词位 < 词容量 && 词型表[词位] != 右花) {
                        若 (词型表[词位] == 直联) { 旁联 = 词值表[词位]; 词位++; 续; } /* fix 2026-08-25 step21: 字段 _Alignas(N) → st_field_sz_r 消费 */
                        若 (取环境("QCC_DBG_NS")) 若 (类型表[构序].名[0] == 0 || 查找子串(类型表[构序].名, "ref_namespace")) 输出到文件(错误流, "[NS]  body-tok %d tt=%d '%s'\n", 词位, 词型表[词位], 词名表[词位]);
                        整 串再 = 词位; /* 安全前进守卫: 未识别字段类型时强制 +1, 防死循环 (fix 2026-08-13) */
                        整 维数表 = 0; 整 首 = 1; /* dims/first 数组维度每次迭代独立 */
                        整 右进 = -1; /* fix 2026-08-19: typedef struct 字段的 struct 类型索引 (z_stream z; → 注册后 st_field_ty) — 原缺 → 嵌套链 gz.z.avail_in 断 */
                        整 缓拾 = 0; /* fix 2026-08-17: 本次迭代是否确定新类型 (char* 的 pointee 捕获依据) */
                        整 域未一 = 0; /* fix 2026-08-19: 本次迭代是否消费过类型关键字 — 已见基类型时后续 VR 是字段名 (char *ref; 的 ref 撞 remote.h struct ref 标签被当类型吞掉) */
                        若 (词型表[词位] == 型词) { 循环 (词型表[词位] == 型词 && ((!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常")) || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")))) 词位++;
                            /* fix 2026-08-29 csmith round2: 修饰符后跟 typedef 名 (`volatile int64_t f0`) — 跳修饰符后是 VR typedef 时 不设 tkw/不消费, 交 typedef 分支 (L12541) 解析; 原无条件 tkw=1 + 非 struct/enum 即 tk++ → int64_t 被吞当字段名 → f0 注册 4B → 读取只取低 32 位 (seed64/18 静默). 修饰符后是真类型关键字 (int/char/...) 才设 tkw */
                            整 整壹 = !(词型表[词位] == 词变量 && (型定判断(词名表[词位]) || 查类型(词名表[词位]) >= 0) && !(词位 + 1 < 词容量 && 词型表[词位 + 1] == 冒号));
                            若 (整壹) 域未一 = 1;
                            若 ((!比较字符串(词名表[词位], "unsigned") || !比较字符串(词名表[词位], "无"))) { 函数表一 = 1; } 若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) { 域尺寸 = 1; 行 = 1; 缓拾 = 1; 若 (单又) 副戌 = 1; } 否 若 (!比较字符串(词名表[词位], "signed")) { 单又 = 1; 函数表一 = 0; } 否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) { 域尺寸 = 8; 行 = 8; 值肆 = 1; 缓拾 = 1; } 否 若 ((!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) { 若 (词型表[词位+1] == 型词 && (!比较字符串(词名表[词位+1], "long") || !比较字符串(词名表[词位+1], "长") || !比较字符串(词名表[词位+1], "长整"))) { 域尺寸 = 8; 行 = 8; 标一 = 1; } 缓拾 = 1; } 否 若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) { 域尺寸 = 2; 行 = 2; 缓拾 = 1; } 若 (整壹 && !(词型表[词位] == 结构词 || 词型表[词位] == 枚词)) 词位++; /* fix 2026-08-18: const 后跟 struct/enum (`const struct ref_storage_be *be`) 不能吞关键字 — 原无条件 tk++ 吃掉 struct → 字段类型索引丢失 (ty_idx=-1) → 多级成员链 (refs->be->init_db) 断 → call *refs SEGV; 让 5114 ST 分支正常解析 */
                            若 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) { 若 (标一 == 0 && 词型表[词位+1] == 型词 && (!比较字符串(词名表[词位+1], "long") || !比较字符串(词名表[词位+1], "长") || !比较字符串(词名表[词位+1], "长整"))) { 域尺寸 = 8; 行 = 8; 标一 = 1; } 词位++; } /* 第二个 long: unsigned long long 场景 — unsigned 后第一个 long 未设 8B, 第二个 long 补设 (fix 2026-08-17: 原只消费不设 → unsigned long long 字段 4B) */ }
                        整 实丁 = 0; /* 指针地块数 (指针字段标记, fix 2026-08-18: ctx->argv++ char** 需按 8 缩放) */
                        整 下失 = 缓拾 ? 域尺寸 : 间五; /* fix 2026-08-17: 指针字段的指向元素大小 (char *buf → 1); 逗号继承 (char *p, *q) 用 fpel_persist */
                        整 余再 = 域尺寸; /* fix 2026-08-18: 指针字段前的基类型大小 (unsigned *seen, x → x 是 unsigned 4B 非 8B) — 逗号续行用 fsz_base 恢复 */
                        { 循环 (词型表[词位] == 乘) { 域尺寸 = 8; 行 = 8; 实丁++; 词位++; 循环 (词型表[词位] == 型词 && ((!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常")) || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")))) 词位++; } 若 (实丁 > 1) 下失 = 8; } /* pointer field (fix 2026-08-16: frow=8 — 逗号后指针字段继承); 多级指针 → pointee 8; fix 2026-08-19: 每级指针后吞 const/volatile (`const char * const key`) — 原 const 残留 → 字段名被当类型吞掉 → trace_key key 字段丢失 → get_trace_fd 错位 → git add getenv(NULL) 崩 */
                        若 (取环境("QCC_DBG_NS")) 若 (类型表[构序].名[0] == 0 || 查找子串(类型表[构序].名, "ref_namespace")) 输出到文件(错误流, "[NS]  post-ptr tok=%d tt=%d '%s' fsz=%d frow=%d npel=%d is_union=%d\n", 词位, 词型表[词位], 词名表[词位], 域尺寸, 行, 实丁, 源高);
                        若 (词型表[词位] == 结构词) { /* nested struct field: struct Inner in; (or struct Node *next — self ref) */
                            整 逆吉 = (!比较字符串(词名表[词位], "union") || !比较字符串(词名表[词位], "联"));
                            词位++; /* struct */
                            若 (词型表[词位] == 左花) { /* 匿名 struct/union body: union { ... } u; — 解析字段到匿名类型 (fix 2026-08-18: 原跳过 body 注册 8 字节近似 → config_source union{FILE*; struct config_buf{...}buf;}u 记 8B 无类型 → conf->u.file 链无类型可查 → config_file_fgetc 丢函数体返 0 → git config 解析全 0 → "bad config line 1"/SEGV) */
                                整 高四一 = 逆吉;
                                字 缺未[64]; 格式化到串(缺未, "__anon_%d", 类型数);
                                整 深进 = 构加(缺未);
                                词位++; /* { */
                                循环 (词位 < 词容量 && 词型表[词位] != 右花) {
                                    整 隔叁一 = 词位;
                                    整 原升 = 4, 目薄一 = 0, 现贰 = 0, 列酉 = 0;
                                    若 (词型表[词位] == 型词) {
                                        循环 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常"))) 词位++; /* fix 2026-08-18: `const char *buf` — 原只消费第一个 VK (const) → char 留在 token 流 → 字段名丢失 → config_buf 布局错 */
                                        若 ((!比较字符串(词名表[词位], "unsigned") || !比较字符串(词名表[词位], "无"))) { /* ignore */ }
                                        否 若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) { 原升 = 1; }
                                        否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) { 原升 = 8; 目薄一 = 1; }
                                        否 若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) { 原升 = 2; }
                                        否 若 ((!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) { 原升 = 8; 现贰 = 1; }
                                        若 (!(词型表[词位] == 结构词 || 词型表[词位] == 枚词)) 词位++; /* fix 2026-08-18: const 后跟 struct/enum 不能吞关键字 */
                                        若 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) 词位++;
                                    }
                                    循环 (词型表[词位] == 乘) { 原升 = 8; 列酉++; 词位++; }
                                    整 串简 = -1; 整 堆八 = 0;
                                    若 (词型表[词位] == 结构词) { /* 嵌套 struct/union 成员 (含内联 body): struct config_buf {...} buf; / struct align align; */
                                        堆八 = (!比较字符串(词名表[词位], "union") || !比较字符串(词名表[词位], "联"));
                                        词位++;
                                        若 (词型表[词位] == 词变量) { 串简 = 查类型(词名表[词位]); 词位++; }
                                        循环 (词型表[词位] == 乘) { 原升 = 8; 列酉++; 词位++; } /* fix 2026-08-23 t35d: `struct X *name` — struct 类型后指针原被拆成两次迭代 (第二次 u2_si 重置 -1) → union 成员 ftypes 未设 → mem_addr 链 (ma->u.attr->attr_nr) 失败 → diff 崩 */
                                        若 (词型表[词位] == 左花) { /* 内联 body: 解析到新匿名类型 (完整成员语法: enum/位域/typedef/嵌套结构) */
                                            字 满序[64]; 格式化到串(满序, "__anon_%d", 类型数);
                                            整 行散 = 构加(满序);
                                            词位++; /* { */
                                                整 净五 = -1; /* fix 2026-08-24 t35v: 逗号续行 struct 字段继承类型 (struct object_id ooid, noid; — v2t_si 每次迭代重置 → 续行 noid 无类型 → 布局 36+4 错 → git reflog 无输出) */
                                            循环 (词位 < 词容量 && 词型表[词位] != 右花) {
                                                整 度六 = 词位;
                                                整 邻升 = 4, 末进一 = 0, 下进 = 0;
                                                若 (词型表[词位] == 型词) {
                                                    循环 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常"))) 词位++; /* fix 2026-08-18: `const char *` — 原只消费第一个 VK (const) → char 留在 token 流 → 字段名丢失 → config_buf 布局错 (config_source u.buf.len/pos 偏移错) */
                                                    若 ((!比较字符串(词名表[词位], "unsigned") || !比较字符串(词名表[词位], "无"))) { /* ignore */ }
                                                    否 若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) { 邻升 = 1; }
                                                    否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) { 邻升 = 8; 末进一 = 1; }
                                                    否 若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) { 邻升 = 2; }
                                                    否 若 ((!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) { 邻升 = 8; 下进 = 1; }
                                                    若 (!(词型表[词位] == 结构词 || 词型表[词位] == 枚词)) 词位++; /* fix 2026-08-18: const 后跟 struct/enum 不能吞关键字 */
                                                    若 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整"))) 词位++;
                                                }
                                                否 若 (词型表[词位] == 词变量 && 型定判断(词名表[词位])) { 整 满再 = 型定查(词名表[词位]); 若 (满再 >= 0 && 型定表[满再].尺寸 > 0) { 邻升 = 型定表[满再].尺寸; } 词位++; } /* typedef 成员 (size_t=8B) */
                                                循环 (词型表[词位] == 乘) { 邻升 = 8; 词位++; }
                                                整 终成 = -1;
                                                若 (词型表[词位] == 结构词) { /* 嵌套 struct/union 成员 */
