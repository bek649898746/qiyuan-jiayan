                    }
                    若 (名集 > 0) {
                        /* 堆九 已是 &目标 (探测 内存地址 已 发射), 压栈 保存后补 &源 */
                        压栈寄存器(0); /* &目标 */
                        若 (节型表[子1[数]] == 1) {
                            字 *中散 = (字*)(节名表 + 子1[数]);
                            整 暂序 = 查变量(中散);
                            若 (暂序 >= 0) { 若 (变量是否静态(中散)) { 中发(缺捌, 暂序, 1, 0); 中刷(); } 否 { 中发(副失, 0, 变量基(中散, 暂序) - 当前帧大小, 0); 中刷(); } } /* 第三阶段-中间表示 例十: 嵌套链大结构 右操作数 取址 */
                            否 移即(0, 0);
                        } 否 {
                            整 终平 = 0, 满七二 = -1;
