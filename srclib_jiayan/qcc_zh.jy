        循环 (词型表[词位] == 词变量 && 度转 < 16) { 复制字符串(符成[度转], 词名表[词位]); 度转++; 词位++; 若 (词型表[词位] == 逗号) 词位++; 否 断; }
        若 (词型表[词位] == 右括) 词位++; /* ) */
