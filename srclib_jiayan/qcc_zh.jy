                汇发("    零扩展空 eax, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,0);发字节(0x0F);发字节(0xB6);发字节(0xC0); /* 零扩展 首子, 累加低 */
                汇发("    零扩展空 edx, dl\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,0);发字节(0x0F);发字节(0xB6);发字节(0xD2); /* 零扩展 edx, 链弊 */
                汇发("    减无 r0, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x29);模字节(3,2,0); /* 减 首子, edx */
