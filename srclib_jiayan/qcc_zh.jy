    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "取消")) { /* 接入 2026-08-29 P2 #67 协作式取消: 取消 标记 t; → int t=0 (声明标志); 取消 t; → t=1 (触发) */
        词位++; /* 取消 */
