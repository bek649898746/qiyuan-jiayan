                    否 { 中发(副失, 0, 偏移 - 当前帧大小, 0); 中刷(); } /* 第三阶段-中间表示: &局部变量 */
                }
            } 否 若 (链接模式 && 偏移 < -1 && 变量是否静态(变名)) {
                度一(静态位移(偏移, 1) - 1); /* 外部 全局: &变量 -> 取址 指令指针 + 三十二位相对 (链接器 解析) */
            }}
        } 断;
        例 节点_解引用: { /* *指针 — 字节 加载 (字符*), 双字 (整数*), 64-位 (函数指 / 字符** / 整数**) */
            若 (子0[数] >= 0 && 表达式层级(子0[数]) == 0) { /* L-15 根因 (C 6.5.3.2): `*X` 中 X 是**函数指针值** (层级 0) ⟹ 结果是 **函数指示符**, 值 = X 的值, **不读内存**。
