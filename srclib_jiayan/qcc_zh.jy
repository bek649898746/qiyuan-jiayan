静 空 尾实名(常 字 *入, 字 *出) { 出[0] = 0; 若 (!入) 返; 若 (入[0] != '_' || 入[1] != '_' || 入[2] != 'i' || 入[3] != 'f' || 入[4] != '_') { 复制字符串(出, 入); 返; } 整 末 = -1; 遍 (整 乙 = 0; 入[乙]; 乙++) 若 (入[乙] == '_') 末 = 乙; 若 (末 > 5) { 整 丙 = 0; 遍 (整 乙 = 5; 乙 < 末 && 丙 < 63; 乙++) { 出[丙++] = 入[乙]; } 出[丙] = 0; } 若 (!出[0]) 复制字符串(出, 入); } /* I2-③: 接口隐藏槽名 __if_s_mK → 声明字段名 s (接口字段写展开为隐藏槽写) */
静 空 尾登记(常 字 *值, 整 深, 整 基序) { 整 尾构 = (基序 >= 0 && 基序 < 65536) ? 变量表[基序].型序标 : -1; 整 尾大 = (基序 >= 0 && 基序 < 65536) ? 变量表[基序].构尺寸 : 0; 若 (尾构 < 0 && 尾大 > 0) 返; /* I2-③: 构值 无 型序标 (接口槽类 结构体) → 不登记 — 无法字段级, 粗粒度会误伤 (接口槽写 由编译器展开, 名称非用户面; 已知限制) */ 整 尾可 = (尾构 >= 0) ? 尾可见字段(尾构) : 0; 若 (尾构 >= 0 && (尾可 <= 0 || 尾接口构(尾构))) 返; /* I2-③: 无可见字段 / 含接口隐藏槽的构值 → 不登记 (无法字段级; 接口槽写不经常规赋值路径, 粗粒度会误伤 — 已知限制) */
