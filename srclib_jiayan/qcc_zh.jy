                                        若 (甲序 > 首组) { 暂存[词序二++] = ','; 若 (词序二 < 16381) 暂存[词序二++] = ' '; }
                                        遍 (整 键 = 0; 新回[甲序 * 4096 + 键] && 词序二 < 16380; 键++) 暂存[词序二++] = 新回[甲序 * 4096 + 键];
                                    }
                                } 否 若 (首组 >= 0 && 首组 < 匿数) {
                                    遍 (整 键 = 0; 新回[首组 * 4096 + 键] && 词序二 < 16380; 键++) 暂存[词序二++] = 新回[首组 * 4096 + 键];
                                } 否 {
                                    遍 (整 键 = 0; 键 < 外伴 && 词序二 < 16382; 键++) 暂存[词序二++] = 直辛[键];
                                }
                            } 否 {
                                若 (词序二 < 16382) 暂存[词序二++] = 体[发字节++];
                            }
                        }
                        若 (函数宏表[素散].约束[0] && 匿数 >= 1) { 若 (词序二 < 16382) 暂存[词序二++] = ')'; } /* 阶段C-1 #45: 逗号表达式前缀闭合 — (__受约束(接口, 实参), 体) */
                    }
                } 否 { /* 单版本: 原路径 */
                    若 (函数宏表[素散].约束[0] && 匿数 >= 1) { /* 阶段C-1 #45 泛型约束检查注入 (2026-09-01): (__受约束(接口, 实参), 体) — 逗号表达式前缀, 表达式层解析器识别检查 实参类型实现接口 (A9006); 检查零运行时代码 */
                        复制字符串(暂存, "(__受约束("); 词序二 = (整)取字长("(__受约束(");
                        常 字 *约束名 = 函数宏表[素散].约束;
                        遍 (整 键 = 0; 约束名[键] && 词序二 < 16380; 键++) 暂存[词序二++] = 约束名[键];
                        暂存[词序二++] = ',';
                        常 字 *源 = 段吉;
                        整 反五 = 0; 循环 (源[反五] && (源[反五] == ' ' || 源[反五] == '\t')) 反五++;
                        整 槽长 = 0; 循环 (源[反五 + 槽长]) 槽长++; 循环 (槽长 > 0 && (源[反五 + 槽长 - 1] == ' ' || 源[反五 + 槽长 - 1] == '\t')) 槽长--;
                        遍 (整 键 = 反五; 键 < 反五 + 槽长 && 词序二 < 16380; 键++) 暂存[词序二++] = 源[键];
                        暂存[词序二++] = ')'; 暂存[词序二++] = ','; 暂存[词序二++] = ' ';
                    }
                    常 字 *体 = 函数宏表[素散].体;
                    遍 (整 发字节 = 0; 体[发字节] && 词序二 < 16382; ) {
                        若 (体[发字节] == '/' && 体[发字节 + 1] == '/') { /* A2 根治 同族: 行注释 整体复制 (C 语义: 注释 先于 宏替换 化为空白) */
                            循环 (体[发字节] && 词序二 < 16382) 暂存[词序二++] = 体[发字节++];
                            续;
                        }
                        若 (体[发字节] == '/' && 体[发字节 + 1] == '*') { /* A2 根治 同族: 块注释 整体复制 (防 注释内 引号/参数名 干扰替换) */
                            若 (词序二 < 16381) { 暂存[词序二++] = 体[发字节++]; 暂存[词序二++] = 体[发字节++]; }
                            循环 (体[发字节]) {
                                若 (词序二 >= 16382) 断;
                                若 (体[发字节] == '*' && 体[发字节 + 1] == '/') { 暂存[词序二++] = 体[发字节++]; 若 (词序二 < 16382) 暂存[词序二++] = 体[发字节++]; 断; }
                                暂存[词序二++] = 体[发字节++];
