            { 整 反弊 = 0; /* fix 2026-08-30 csmith B族: 窄类型 cast 截断 — (int16_t)x 原 no-op 保留 32 位垃圾 (s62 g_1143 存 0x3ae35569 应 0x5568; s182/s83/s121 同族) */
              若 (深己 == 0) {
                若 (转型型 && (!比较字符串(转型型, "char") || !比较字符串(转型型, "_Bool"))) 反弊 = 1;
                否 若 (转型型 && !比较字符串(转型型, "short")) 反弊 = 2;
                否 若 (转型型二 && (!比较字符串(转型型二, "char") || !比较字符串(转型型二, "_Bool"))) 反弊 = 1;
                否 若 (转型型二 && !比较字符串(转型型二, "short")) 反弊 = 2;
                否 若 (素双) { 整 栈进一 = 型定查(素双); 若 (栈进一 >= 0 && !型定表[栈进一].是否构标 && !型定表[栈进一].是否函数指 && !型定表[栈进一].是否浮标 && (型定表[栈进一].尺寸 == 1 || 型定表[栈进一].尺寸 == 2)) 反弊 = 型定表[栈进一].尺寸; }
                若 (反弊 && 常式 >= 0 && 子0[常式] != -2) { 整 央 = 建节(27); 接子(央, 常式); 节值表[央] = 反弊; 节无符号[央] = 0; 若 (素双) { 整 隔利一 = 型定查(素双); 若 (隔利一 >= 0 && 型定表[隔利一].无符号标) 节无符号[央] = 1; } 否 若 (转型型 && !比较字符串(转型型, "unsigned")) 节无符号[央] = 1; 否 若 (转型型二 && !比较字符串(转型型二, "unsigned")) 节无符号[央] = 1; 常式 = 央; } /* fix 2026-08-30 csmith s62: 窄 cast 的 nuns 按目标类型 — 原 nuns[m]=nuns[ce] 继承源 ((int16_t)(uint64_t)x 源 unsigned → nuns=1 → case 27 掩码不符号扩展 → int64 变量写零扩展 0x0000ABCD 应 0xFFFFABCD; g_1143 静默 diff) */
              } }
            返 常式; /* cast 截断节点: 窄类型不再 no-op (fix 2026-08-30 csmith B族) */
        }
        词位++; 整 数 = 表达式();
        /* comma operator inside parens: (a, b, c) �?needed for (i++, PP) in the
           lexer's switch ternaries. NOT added to expr() itself: function args
           (f(a, b)) must stay separate (the call parser consumes the CK). */
        循环 (词型表[词位] == 逗号) { 词位++; 整 甲 = 建节(2); 节值表[甲] = 逗号; 接子(甲, 数); 接子(甲, 表达式()); 数 = 甲; }
        词位++;
        /* 后缀链: (expr)->field / (expr)[i] / (expr)(args) (fix 2026-08-06: 原只处理 (expr)(args), ((T*)0)->i 的 ->i 悬空 → offsetof 惯用法 &((T*)0)->m 错) */
        循环 (1) {
            若 (词型表[词位] == 左方) { 词位++; 整 央 = 建节(14); 接子(央, 数); 接子(央, 表达式()); 若 (词型表[词位] == 右方) 词位++; 数 = 央; }
            否 若 (词型表[词位] == 句点 || 词型表[词位] == 箭头) {
                整 暂聚 = (词型表[词位] == 箭头); 词位++;
                若 (词型表[词位] == 词变量) { 整 央 = 建节(15); 接子(央, 数); 节值表[央] = 暂聚; 复制内存((字*)(节名表 + 央), 词名表[词位], 64); 词位++; 数 = 央; } 否 断;
            } 否 若 (词型表[词位] == 长粗) { /* 接入 2026-08-28 可选链 a?.b → (a != 0) ? a->b : 0 — 三目 Nd(22), 空指针短路 (a 为变量时安全) */
                词位++;
                若 (词型表[词位] == 词变量) {
                    字 串升[64]; 复制字符串(串升, 词名表[词位]); 词位++;
                    整 比较 = 建节(2); 节值表[比较] = 名庚; 接子(比较, 数); { 整 零 = 建节(0); 节值表[零] = 0; 接子(比较, 零); } /* a != 0 */
                    整 内存 = 建节(15); 若 (节型表[数] == 1) { 整 值二 = 建节(1); 复制内存((字*)(节名表 + 值二), (字*)(节名表 + 数), 32); 接子(内存, 值二); } 否 接子(内存, 数); /* 真分支 base 用新节点 (防多父共享) */
                    节值表[内存] = 1; 复制内存((字*)(节名表 + 内存), 串升, 64); /* a->b */
                    整 首丙 = 建节(0); 节值表[首丙] = 0;
                    整 三元 = 建节(22); 接子(三元, 比较); 接子(三元, 内存); 接子(三元, 首丙); /* (a!=0) ? a->b : 0 */
                    数 = 三元;
                } 否 断;
            } 否 若 (词型表[词位] == 左括) { 整 被调者 = 数; 词位++; 整 字符 = 建节(4);
                整 参数个数[256]; 整 副双[256]; 整 匿数 = 0; 整 左捌 = (节型表[被调者] == 1) ? 净挂((字*)(节名表 + 被调者)) : -1; 若 (左捌 >= 0) { 遍 (整 尾优 = 0; 尾优 < 栈捌[左捌] && 匿数 < 250; 尾优++) { 整 字值; 若 (间二[左捌] == 2) { 字值 = 建节(11); 整 前低 = 建节(1); 复制内存((字*)(节名表 + 前低), 行退一[左捌][尾优], 32); 接子(字值, 前低); } 否 { 字值 = 建节(1); 复制内存((字*)(节名表 + 字值), 行退一[左捌][尾优], 32); } 参数个数[匿数] = 字值; 副双[匿数] = -1; 匿数++; } 复制内存((字*)(节名表 + 被调者), 半布[左捌], 64); } /* type-root-9 #211 closure */ /* 2026-08-28 P1 #32: by-mut (mode 2) 捕获传地址 Nd(11) */ /* 真具名参数: 收集后重排 (同主调用) */
                循环 (词型表[词位] != 右括 && 词型表[词位] != 词终) { 整 暂零 = 词位; 若 (词型表[词位] == 逗号) 词位++; 整 位 = -1; 若 (词型表[词位] == 词变量 && 词型表[词位 + 1] == 冒号) { 位 = (节型表[被调者] == 1) ? 函参位((字*)(节名表 + 被调者), 词名表[词位]) : -1; 词位 += 2; } 整 评值 = 表达式(); 若 (词位 == 暂零) 断; 若 (匿数 < 256) { 参数个数[匿数] = 评值; 副双[匿数] = 位; 匿数++; } }
                若 (词型表[词位] == 右括) 词位++;
                { 整 深进一 = 0; 遍 (整 计 = 0; 计 < 匿数; 计++) 若 (副双[计] >= 0) { 深进一 = 1; 断; }
                  若 (深进一 && 节型表[被调者] == 1) { 整 己序 = 存陆((字*)(节名表 + 被调者)); 整 参数数 = (己序 >= 0) ? 度伍[己序].参数数 : 0;
                    若 (参数数 > 0) { 整 列细[256]; 遍 (整 计 = 0; 计 < 256; 计++) 列细[计] = -1; 整 成功 = 1;
                        遍 (整 计 = 0; 计 < 匿数 && 成功; 计++) { 整 指 = 副双[计];
                            若 (指 >= 0) { 若 (指 >= 参数数 || 列细[指] >= 0) { 成功 = 0; 断; } 列细[指] = 参数个数[计]; }
                            否 { 整 寻 = 0; 循环 (寻 < 参数数 && 列细[寻] >= 0) 寻++; 若 (寻 >= 参数数) { 成功 = 0; 断; } 列细[寻] = 参数个数[计]; } }
                        若 (成功) { 遍 (整 乙 = 0; 乙 < 参数数; 乙++) { 整 短次; 若 (列细[乙] >= 0) 短次 = 列细[乙]; 否 { 短次 = 建节(0); 节值表[短次] = 0; } 接子(字符, 短次); } }
                        否 { 遍 (整 计 = 0; 计 < 匿数; 计++) 接子(字符, 参数个数[计]); } }
                    否 { 遍 (整 计 = 0; 计 < 匿数; 计++) 接子(字符, 参数个数[计]); } }
                  否 { 遍 (整 计 = 0; 计 < 匿数; 计++) 接子(字符, 参数个数[计]); } }
                接子(字符, 数); 数 = 字符;
                若 (节型表[被调者] == 1 && (查函数浮返((字*)(节名表 + 被调者)) || 终陆((字*)(节名表 + 被调者)) >= 0 || 序贰((字*)(节名表 + 被调者)) == 2)) 节浮标[字符] = 1; /* fix 2026-08-06: double 返回调用 parse 时标记 (镜像 2737); math21/step5 time 同 L4233 */
                若 (节型表[被调者] == 1 && (查函数长返((字*)(节名表 + 被调者)) || 序贰((字*)(节名表 + 被调者)) == 1 || !比较字符串((字*)(节名表 + 被调者), "复数") || !比较字符串((字*)(节名表 + 被调者), "复加"))) 节长标[字符] = 1; /* fix 2026-08-21 #27: 64-bit-return call → node is ll; 2026-08-28: 复数/复加 builtin 64 位打包返回 */
            } 否 若 (词型表[词位] == 增增 || 词型表[词位] == 减减) { /* fix 2026-08-08: (expr)++ 后缀被吞 → fn_macro `out[(*o)++]` 的 *o 不推进 (展开为空). 与变量后缀链一致 */
                整 高拆 = (词型表[词位] == 减减); 词位++;
                串弊(数); /* 借用自动化 (2026-08-28 完善): (expr)++ = 写 → 借用策略 */
                整 央 = 建节(23); 节值表[央] = 高拆;
                接子(央, 数); 数 = 央;
            }
            否 断;
        }
        返 数;
    }
    若 (词型表[词位] == 点) { 词位++; 整 中高二 = 宽低; 宽低 = 1; 整 数 = 建节(11); 接子(数, 原级()); 宽低 = 中高二; 返 数; } /* fix 2026-08-30 探雷雷6: &x 取地址不读值 — 操作数解析期 addr_of_parsing=1 豁免 A4001 (未初始化取地址合法: int x; int *p=&x; 后写 *p) */
    若 (词型表[词位] == 乘) { 词位++; 整 数 = 建节(12); 整 域布 = 原级(); /* 类型根治① (2026-08-28): 前缀 *p 解引用 — 操作数在星后, 解析后查可空 (原 L5145 只查变量在解引用符前的 AR/LB 路径, *p 漏拦) */
        若 (域布 >= 0 && 节型表[域布] == 1) { /* 2026-08-28 P2 #257 解引用重载: 重载 * 类型 = fn; → *obj → fn(obj) */
            整 余升二 = 变量型序((字*)(节名表 + 域布));
            若 (余升二 >= 0 && 初甲 > 0) { 字 *帧叁一 = 类型表[余升二].名; 遍 (整 键 = 0; 键 < 初甲; 键++) 若 (满属[键] == 乘 && !比较字符串(总复[键], 帧叁一)) { 整 字符 = 建节(4); 接子(字符, 域布); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 栈聚[键], 64); 接子(字符, 函); } 返 字符; } }
        }
        若 (域布 >= 0 && 节型表[域布] == 1 && 串壬((字*)(节名表 + 域布))) { 格式化到串(错缓冲, "可空类型: 变量 '%s' 未解包就解引用 (星号) — 先 解包 %s; (类型根治①, v3.0 #75)", (字*)(节名表 + 域布), (字*)(节名表 + 域布)); 发错误("A8001", 错缓冲); }
        接子(数, 域布);
        若 (域布 >= 0 && 节型表[域布] == 1 && 变量指浮((字*)(节名表 + 域布))) 节浮标[数] = 1; /* *double-p → xmm0 */
        返 数; }
    若 (词型表[词位] == 总零) { 词位++; 整 数 = 建节(17); 接子(数, 原级()); 返 数; }
    若 (词型表[词位] == 按位非) { 词位++; 整 数 = 建节(18); 接子(数, 原级()); 返 数; } /* ~expr */
    若 (词型表[词位] == 加) { 词位++; 返 原级(); } /* unary plus: +expr = expr — fix 2026-08-30 csmith s140/s153: 原无 PK 分支 → +x 落回 -1 → add() 当二元加 → 值翻倍 ((+0xFE3FL) → 2×0xFE3F, s140 g_373.f0) */
    若 (词型表[词位] == 减) { /* unary minus: -expr */
        词位++;
        /* -double-literal: flip the IEEE sign bit at PARSE time (keeps -0.0 as a
           real negative zero; a runtime 0.0 - x would round -0.0 to +0.0) */
        若 (词型表[词位] == 终简) {
            整 序标 = 词值表[词位];
            若 (浮数 < 1024) { 现退[浮数] = 现退[序标]; 逆组[浮数] = 逆组[序标]; 现退[浮数] ^= 0x80000000; } /* fix 2026-08-07: 512→1024 对齐镜像 (dbl_n∈[512,1024) 时原静默不写却 dbl_n++ → 垃圾 double) */
            若 (浮数 >= 8192) { 输出到文件(错误流, "[ERR] double 字面量表满 (fix 2026-08-06 M3)\n"); 退出(1); }
            整 数 = 建节(终简); 节值表[数] = 浮数; 节浮标[数] = 1; 浮数++; 词位++; /* -double-literal: must be marked ndbl (fix 2026-08-06) */
            返 数;
        }
        整 数 = 建节(2); 节值表[数] = 减; 接子(数, 建节(0)); 节值表[子0[数]] = 0; 整 首从一 = 原级(); 接子(数, 首从一); 若 (首从一 >= 0 && 节长标[首从一]) 节长标[数] = 1; 返 数; /* fix 2026-08-21 #28: 一元负传播 ll 标记 — 否则 -0x7fffffffffffffffLL - 1 的后续减按 32 位 (INT64_MIN 宏错) */
    }
    若 (词型表[词位] == 串词) { 整 数 = 建节(0); 节值表[数] = 词值表[词位]; /* str index → treated as immediate for codegen */ 节型表[数] = 串词; 词位++;
        循环 (词型表[词位] == 左方) { /* 字符串字面量下标 "abc"[i] (fix 2026-08-06: 原 STR 分支无 suffix chain → 实参 `f("A"[0])` 解析卡在 `[` 死循环; 赋值场景留下未消费的 `[` 生成垃圾值) */
            词位++; /* [ */
            整 央 = 建节(14); 接子(央, 数); 接子(央, 表达式()); 若 (词型表[词位] == 右方) 词位++; /* ] */
            数 = 央;
        }
        返 数; }
    返 -1;
}

静 整 乘法(空) { 整 数 = 原级(); 循环 (词型表[词位] == 乘 || 词型表[词位] == 除 || 词型表[词位] == 取余 || 词型表[词位] == 左移 || 词型表[词位] == 右移) { 整 丙 = 词型表[词位++]; 整 甲 = 建节(2); 节值表[甲] = 丙; 整 结 = 原级(); 接子(甲, 数); 接子(甲, 结); 若 ((丙 == 乘 || 丙 == 除) && 数 >= 0 && 节型表[数] == 0 && 结 >= 0 && 节型表[结] == 0 && 节值表[结] == 0) { 格式化到串(错缓冲, "编译期除零: 常量除数为 0 (探雷雷5)"); 发错误("A2001", 错缓冲); } /* fix 2026-08-30 探雷雷5: 常量除零编译期拦截 — 仅分子分母都是字面量 (1/0, x 变量/表达式分母 0 放行: csmith 生成大量 /0 UB 在死代码/未执行路径, gcc 不拦, 拦截误伤 59 种子; 分子常量 = 必然执行, 拦) */ 若 ((丙 == 乘 || 丙 == 除) && ((数 >= 0 && 节浮标[数]) || (结 >= 0 && 节浮标[结]))) 节浮标[甲] = 1; 若 (丙 == 左移 || 丙 == 右移) { 若 (表达式是否长(数)) 节长标[甲] = 1; } /* fix 2026-08-29 csmith: 移位结果宽度=左操作数 — 原 expr_is_ll(r) 也传播 → `x << (int8_t)uint64` 被标 LL → 64 位移位 mod64 错 (s137 静默) */ 否 若 (表达式是否长(数) || (结 >= 0 && 表达式是否长(结))) 节长标[甲] = 1; /* fix 2026-08-22 #31: 64-bit result nll at parse time */ 数 = 甲; } 返 数; }
静 整 加法(空) { 整 数 = 乘法(); 循环 (词型表[词位] == 加 || 词型表[词位] == 减) { 整 丙 = 词型表[词位++]; 整 正退 = -1; 若 (初甲 > 0 && 节型表[数] == 1) { /* 接入 2026-08-27 运算符重载: 左操作数是 struct 变量且注册过该运算符+类型 → 生成函数调用 (重载表空则零影响原路径) */ 整 构序 = 变量型序((字*)(节名表 + 数)); 若 (构序 >= 0) { 字 *行排 = 类型表[构序].名; 遍 (整 键 = 0; 键 < 初甲; 键++) 若 (满属[键] == (字)丙 && !比较字符串(总复[键], 行排)) { 正退 = 键; 断; } } } 若 (正退 >= 0) { 整 结 = 乘法(); 整 字符 = 建节(4); 接子(字符, 数); 接子(字符, 结); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 栈聚[正退], 64); 接子(字符, 函); } 数 = 字符; } 否 { 整 甲 = 建节(2); 节值表[甲] = 丙; 整 结 = 乘法(); 接子(甲, 数); 接子(甲, 结); 若 ((丙 == 加 || 丙 == 减) && ((数 >= 0 && 节浮标[数]) || (结 >= 0 && 节浮标[结]))) 节浮标[甲] = 1; 数 = 甲; } } 返 数; } /* t35m 2026-08-24: 按位 & ^ | 从加减层拆出 — C 优先级 (| 最低, ^ 中, & 最高; htonl(x) = (x&0xff)<<24 | (x>>24)&0xff 原 & 与 | 同级左结合 → 整体 &0xff → pack idx 魔数检查失败 → pack 对象读取失败) */
静 整 宽捌(空) { 整 数 = 加法(); 循环 (词型表[词位] == 点) { 词位++; 整 甲 = 建节(2); 节值表[甲] = 点; 整 结 = 加法(); 接子(甲, 数); 接子(甲, 结); 数 = 甲; } 返 数; }
静 整 深序(空) { 整 数 = 宽捌(); 循环 (词型表[词位] == 异或) { 词位++; 整 甲 = 建节(2); 节值表[甲] = 异或; 整 结 = 宽捌(); 接子(甲, 数); 接子(甲, 结); 数 = 甲; } 返 数; }
静 整 余巳(空) { 整 数 = 深序(); 循环 (词型表[词位] == 或) { 词位++; 整 甲 = 建节(2); 节值表[甲] = 或; 整 结 = 深序(); 接子(甲, 数); 接子(甲, 结); 数 = 甲; } 返 数; }
静 整 比较(空) { 整 数 = 余巳(); 循环 (词型表[词位] == 下双 || 词型表[词位] == 终附 || 词型表[词位] == 高平 || 词型表[词位] == 顺八 || 词型表[词位] == 元九 || 词型表[词位] == 首降) { 整 丙 = 词型表[词位++]; 整 甲 = 建节(2); 节值表[甲] = 丙; 接子(甲, 数); 接子(甲, 余巳()); 数 = 甲; } 返 数; }
静 整 逻辑与链(空) { 整 数 = 比较(); 循环 (词型表[词位] == 逻辑与) { 词位++; 整 甲 = 建节(2); 节值表[甲] = 逻辑与; 接子(甲, 数); 接子(甲, 比较()); 数 = 甲; } 返 数; }
静 整 逻辑或链(空) { 整 数 = 逻辑与链(); 循环 (词型表[词位] == 逻辑或) { 词位++; 整 甲 = 建节(2); 节值表[甲] = 逻辑或; 接子(甲, 数); 接子(甲, 逻辑与链()); 数 = 甲; } 返 数; }
静 整 三元(空) { 整 数 = 逻辑或链(); 若 (词型表[词位] == 问号) { 词位++; 整 暂 = 逻辑或链(); 若 (词型表[词位] == 冒号) 词位++; 整 文件 = 三元(); 整 甲 = 建节(22); 接子(甲, 数); 接子(甲, 暂); 接子(甲, 文件); 返 甲; } 返 数; }
静 整 赋值(空) { 目凶一 = 0; 旧辛 = 0; 顺深 = 0; 目系 = 1; 整 数 = 三元(); 若 (!当申) 元得(数); /* 2026-08-28 type-root-2: try-branch exempt */ 目系 = 0; 若 (词型表[词位] == 赋号) { 词位++; 若 (数 >= 0 && 目肆[数]) { 格式化到串(错缓冲, "常量: 常量不可赋值 (常量 名 = 值 声明后只读, v3.0 #278)"); 发错误("A9006", 错缓冲); } 若 (数 >= 0 && 节型表[数] == 1) { 字 *变名 = (字*)(节名表 + 数); 遍 (整 实退 = 0; 实退 < 现进; 实退++) 若 (!比较字符串(暂拆一[实退], 变名)) { 格式化到串(错缓冲, "不可变: 变量 '%s' 是 不变 声明, 不能赋值 (v3.0 #209)", 变名); 发错误("A9006", 错缓冲); } /* 2026-08-28 P1 #209: 不变变量只读 */ 串弊(数); /* 借用自动化 (2026-08-28 完善): 只读借用写=自动放还, 可变借用写=[ERR] — 原: bm>=0 一律 [ERR] 需手动 放还 */ 若 (后子(变名)) 邻未(变名); /* 接入 2026-08-28 机制层 #5: 写已移动变量 = 重新赋值/重新初始化 → 恢复可用 (Rust 式 move 后重绑定) */ 未初始化移除(变名); 副轮(变名); 副降一(变名); /* 类型根治① (2026-08-28): 赋值 = 重新绑定 → 清除可空标记 */ /* 接入 2026-08-28 机制层 #78: 赋值 = 已初始化 */ } 否 { 整 返回值 = 数; 循环 (返回值 >= 0 && (节型表[返回值] == 14 || 节型表[返回值] == 15 || 节型表[返回值] == 13 || 节型表[返回值] == 12)) 返回值 = 子0[返回值]; /* fix 2026-08-30 探雷雷4 大哥定位: 回溯补 nt==12 (解引用) — 原漏 *p=99 的 rv 停在解引用节点回溯不下去 → borrow_write_policy 不调用 → 借用追别名检查是死代码 (L4743 nt==12 逻辑永不触发); 补后 *p 回溯到指针名 p (nt==1) → 借用策略生效 */ 若 (返回值 >= 0 && 节型表[返回值] == 1) { 串弊(数); /* 借用自动化 (2026-08-28 完善): 成员/数组写 → 基础变量借用策略 (s.v=5 触发 s 的只读借用自动放还; 箭头链写指向对象跳过) */ 若 (后子((字*)(节名表 + 返回值))) 邻未((字*)(节名表 + 返回值)); 未初始化移除((字*)(节名表 + 返回值)); 副轮((字*)(节名表 + 返回值)); 副降一((字*)(节名表 + 返回值)); /* 类型根治①: 成员/数组写 = 重新绑定 → 清除可空标记 */ /* 接入 2026-08-28 机制层 #78: 成员/数组赋值 = 基础变量已初始化 */ } 顺深 = 0; /* 2026-08-28 P1 #33/#34/#17: 成员/数组写目标 — 路径缓冲清除 (写策略已处理路径借用) */ { 整 中粗 = 数; 整 列利一 = 0; 循环 (中粗 >= 0 && 列利一 < 8 && (节型表[中粗] == 14 || (节型表[中粗] == 15 && 节值表[中粗] == 0))) 中粗 = 子0[中粗]; 若 (数 >= 0 && 节型表[数] == 15 && 节值表[数] == 0 && 中粗 >= 0 && 节型表[中粗] == 1) { 字 行置[160]; 格式化到串(行置, "%s.%s", (字*)(节名表 + 中粗), (字*)(节名表 + 数)); 邻未(行置); } 否 若 (数 >= 0 && 节型表[数] == 14 && 子1[数] >= 0 && 节型表[子1[数]] == 0 && 中粗 >= 0 && 节型表[中粗] == 1) { 字 行置[160]; 格式化到串(行置, "%s[%d]", (字*)(节名表 + 中粗), 节值表[子1[数]]); 邻未(行置); } } /* #17: 字段/元素写 = 重新初始化 → 解除路径 moved (Rust 式 move 后重绑定) */ } 整 甲 = 建节(10); 接子(甲, 数); 整 末凶 = 赋值(); 若 (数 >= 0 && 节型表[数] == 1) { 若 (池繁((字*)(节名表 + 数)) >= 0) { 格式化到串(错缓冲, "%s", "常量: 变量 %s 是 常量 不可赋值 (常量 名 = 值 声明后不可变, v3.0 #278)"); 发错误("A9006", 错缓冲); } 直丁(末凶, (字*)(节名表 + 数)); 整 毛肆 = 缓又((字*)(节名表 + 数)); 若 (毛肆 >= 0) { 整 计未 = 0; 长 长 正申 = 目弊(末凶, NULL, NULL, 0, &计未); 若 (计未 && (正申 < 串十[毛肆] || 正申 > 虚成[毛肆])) { 格式化到串(错缓冲, "%s", "区间类型: 赋值 %lld 超出区间 [%d, %d] - 区间类型变量只能赋界内值 (v3.0 #101)"); 发错误("A9003", 错缓冲); } } } 接子(甲, 末凶); 若 (数 >= 0 && 节型表[数] == 1 && 末凶 >= 0 && 节型表[末凶] == 11 && 子0[末凶] >= 0 && 节型表[子0[末凶]] == 1) { 总布((字*)(节名表 + 数), (字*)(节名表 + 子0[末凶])); } /* fix 2026-08-30 探雷雷4: p = &x 登记别名 (借用追指针) */ 返 甲; }
    若 (词型表[词位] == 加等 || 词型表[词位] == 减等 || 词型表[词位] == 乘等 || 词型表[词位] == 除等 || 词型表[词位] == 或等 || 词型表[词位] == 与等 || 词型表[词位] == 异或等 || 词型表[词位] == 右移一 || 词型表[词位] == 左移一 || 词型表[词位] == 隔伍) {
        若 (旧辛 > 0) { 格式化到串(错缓冲, "明确初始化: 变量 '%s' 未初始化就读取 (复合赋值隐含读, 声明须初始化或先赋值, v3.0 #78)", 容进[0]); 发错误("A4001", 错缓冲); } /* 接入 2026-08-28 机制层 #78: x += 3 等价 x = x + 3 (读 x) — 未初始化复合赋值拦截 */
        若 (顺深 > 0) { 若 (下列[0]) { 格式化到串(错缓冲, "借用检查: 字段/元素 '%s' 被可变借用 (独占), 不能读取 (v3.0 #33/#34)", 值八[0]); 发错误("A3001", 错缓冲); } 否 { 格式化到串(错缓冲, "所有权错误: 字段/元素 '%s' 已移动 (部分移动后源字段失效, v3.0 #17)", 值八[0]); 发错误("A3101", 错缓冲); } } /* 2026-08-28 P1 #33/#34/#17: 复合赋值隐含读 — 路径缓冲拦截 */
        串弊(数); /* 借用自动化 (2026-08-28 完善): 复合赋值=写 → 只读借用自动放还, 可变借用 [ERR] (原此路径无借用检查, 与 = 不一致) */
        整 丙 = 词型表[词位++];
        整 算子 = (丙 == 加等) ? 加 : (丙 == 减等) ? 减 : (丙 == 乘等) ? 乘 : (丙 == 除等) ? 除 : (丙 == 或等) ? 或 : (丙 == 与等) ? 与 : (丙 == 异或等) ? 异或 : (丙 == 右移一) ? 右移 : (丙 == 隔伍) ? 取余 : 左移; /* fix 2026-08-05: MS=%= → MD (remainder); was SA→DV so %= divided */
        整 满戊 = -1; /* 2026-08-28 P1 #260 复合赋值重载: a op= b → 重载函数(a, b) 若注册 */
        若 (初甲 > 0 && 数 >= 0 && 节型表[数] == 1) { 整 构序二 = 变量型序((字*)(节名表 + 数)); 若 (构序二 >= 0) { 字 *主轮一 = 类型表[构序二].名; 遍 (整 键 = 0; 键 < 初甲; 键++) 若 (满属[键] == (字)算子 && !比较字符串(总复[键], 主轮一)) { 满戊 = 键; 断; } } }
        若 (满戊 >= 0) { 整 计分一 = 赋值(); 整 旧组 = 建节(4); 接子(旧组, 数); 接子(旧组, 计分一); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 栈聚[满戊], 64); 接子(旧组, 函); } 整 计轮 = 建节(10); 接子(计轮, 数); 接子(计轮, 旧组); 返 计轮; } /* a = 重载函数(a, b) */
        整 甲 = 建节(10); 整 左退一 = 建节(2); 节值表[左退一] = 算子;
        接子(甲, 数); 接子(左退一, 数); 接子(左退一, 赋值()); 接子(甲, 左退一); /* a op= b → a = a op b */
        返 甲;
    } 若 (!首己 && 目凶一 > 0) { 格式化到串(错缓冲, "所有权错误: 变量 '%s' 已移动 (move 后源失效), 不能读取 (v3.0 #5)", 毛玖[0]); 发错误("A3101", 错缓冲); } /* 接入 2026-08-28 机制层 #5: 非赋值场景左值即右值读取 — 缓冲里的 moved 变量报错; 移入 dst 解析期跳过 (dst 是写目标, 可为已移动变量) */ 若 (!首己 && 旧辛 > 0) { 格式化到串(错缓冲, "明确初始化: 变量 '%s' 未初始化就读取 (声明须初始化或先赋值, v3.0 #78)", 容进[0]); 发错误("A4001", 错缓冲); } /* 接入 2026-08-28 机制层 #78: 非赋值场景左值即右值读取 — 缓冲里的未初始化变量报错; 移入 dst 解析期跳过 (移入=初始化, fix 2026-08-28 #78回归: 移入 b,a 的 b 未初始化被误伤) */ 若 (!首己 && 顺深 > 0) { 若 (下列[0]) { 格式化到串(错缓冲, "借用检查: 字段/元素 '%s' 被可变借用 (独占), 不能读取 (v3.0 #33/#34)", 值八[0]); 发错误("A3001", 错缓冲); } 否 { 格式化到串(错缓冲, "所有权错误: 字段/元素 '%s' 已移动 (部分移动后源字段失效, v3.0 #17)", 值八[0]); 发错误("A3101", 错缓冲); } } /* 2026-08-28 P1 #33/#34/#17: 成员/元素路径读检查 — asgn 对所有表达式设 lhs=1, 路径读=非写目标时事后判定 (写目标已在 AK 分支清缓冲+写策略处理) */ 返 数; }
静 整 管道链(空) { 整 数 = 赋值(); 循环 (词型表[词位] == 满再一) { 词位++; 整 文件 = 赋值(); 整 呼 = 建节(4); 接子(呼, 数); 接子(呼, 文件); 数 = 呼; } 返 数; } /* 接入 2026-08-27 管道操作符: a |> f = f(a) — call 节点 callee 是最后 Nc (case 4 L11080 反向找), 参数先挂 (fix 2026-08-27: 原 f 先挂 n0 → callee 变 a 字面量 → 垃圾函数名崩) */
静 整 表达式(空) { 解析深++; 若 (解析深 > 350) 原得("表达式递归深度", 350); 整 全又 = 管道链(); 解析深--; 返 全又; } /* 资源护栏 9b (2026-08-28): 深括号/三元/嵌套调用递归护栏 — 实测每层 expr 链烧 10-20 栈帧, 崩溃点 ~500-800, 护栏 350 安全线下; 超限 A5001 确定性拒绝 (防栈溢出 0xC0000005) */

/* fix 2026-08-24 t35t: 循环条件顶层逗号表达式 — `} while (prev_ch = p_ch, (p_ch = *++p) != ']')`
   原 expr() 对顶层逗号 (非括号内) 只取第一部分 → 条件后半 (p_ch=*++p)!=']' 丢成循环后孤立表达式
   → do-while 循环体永不更新 p_ch → wildmatch dowild '[' 字符类死循环.
   逗号列表包成 block: 顺序执行各表达式, 最后表达式结果 = 条件值 (与 for-step 逗号列表同法). */
静 整 逗号表达式(空) {
    整 数 = 表达式();
    若 (词型表[词位] == 逗号) {
        整 主酉 = 建节(5); 接子(主酉, 数);
        循环 (词型表[词位] == 逗号) { 词位++; 接子(主酉, 表达式()); }
        数 = 主酉;
    }
    返 数;
}

/* local ARRAY brace init: int a[3]={1,2,3}; -> a[0]=1; a[1]=2; a[2]=3; */
静 整 现双[8];  /* 全局多维初始化游标 (fix 2026-08-05) */
静 整 串行 = 0; /* string-init row counter: char rows filled in order (fix 2026-08-05) */

静 整 满联 = -1; 静 整 栈肆 = -1; 静 整 缺丙 = 0; /* fix 2026-08-06: 数组初始化器块链（每块 ≤200 赋值, 链子块; arr_blk_root=首块） */
静 空 序寅(整 赋值) {
    若 (满联 < 0) { 满联 = 建节(5); 栈肆 = 满联; 缺丙 = 0; }
    若 (缺丙 >= 200) { 整 新三 = 建节(5); 接子(满联, 新三); 满联 = 新三; 缺丙 = 0; }
    接子(满联, 赋值);
    缺丙++;
}
静 空 左升(整 发字节, 整 元, 整 *维数表, 整 主己, 整 深度, 整 元素尺寸) {
    /* 递归初始化器: int a[2][3] = {1,2,3,4,5,6} 或 {{1,2,3},{4,5,6}}
       gi_idx[0..nd-1] = 完整多维游标。遇 { 下钻深度, 遇值生成 a[i][j]... = expr。
       顶层扁平(无内层 {)用低位进位; 嵌套行递归只推进本层列, 行由外层 FK 推进。
       本函数自管 { } 配平 (fix 2026-08-05) */
    若 (深度 == 0) {
        满联 = -1; 栈肆 = -1; 缺丙 = 0;
        /* fix 2026-08-23 t49f: C99 aggregate init zeroes unlisted elements -- brace_fields
           did this for structs but brace_arr_init did not; `struct ce *src[9] = { NULL, }`
           left src[1..8] as stack garbage -> git status crashed (oneway_diff tree=src[1]=garbage).
           memset whole array first; explicit initializers below override. */
        整 宽甲 = 建节(11); 接子(宽甲, 元);
        整 素又 = 建节(4);
        整 旁降 = 建节(1); 复制内存((字*)(节名表 + 旁降), "memset", 7);
        接子(素又, 宽甲);
        整 长柒 = 建节(0); 节值表[长柒] = 0; 接子(素又, 长柒);
        整 半三 = 元素尺寸;
        遍 (整 旧辛一 = 0; 旧辛一 < 主己; 旧辛一++) 半三 *= 维数表[旧辛一];
        整 旧附 = 建节(0); 节值表[旧附] = 半三; 接子(素又, 旧附);
        接子(素又, 旁降);
        序寅(素又);
    }
    若 (词型表[词位] == 左花) 词位++; /* 本层 '{' */
    整 新复 = (词型表[词位] == 左花); /* 本层是否为嵌套行模式 */
    循环 (词型表[词位] != 右花) {
        若 (词型表[词位] == 逗号 || 词型表[词位] == 分号) { 词位++; 续; }
        若 (词型表[词位] == 右花) 断;
        若 (词型表[词位] == 左方) { /* Phase 2: designated initializer [idx] = expr (fix 2026-08-11) */
            整 首进一[8]; 整 链从 = 0;
            循环 (词型表[词位] == 左方) { /* 支持多维 [i][j] 设计器 */
                词位++; /* [ */
                整 计十 = 表达式();
                整 尾属 = (计十 > 0 && 节型表[计十] == 0) ? 节值表[计十] : -1; /* 常量下标: expr() 返回 Nd(0) 节点, nv 存值 */
                若 (尾属 < 0) { 循环 (词型表[词位] != 逗号 && 词型表[词位] != 右花 && 词型表[词位] != 词终) 词位++; 续; }
                若 (词型表[词位] == 右方) 词位++; /* ] */
                若 (链从 < 8) 首进一[链从++] = 尾属;
            }
            若 (词型表[词位] == 赋号) 词位++; /* = */
            /* 跳到指定下标: 顶层扁平 → gi_idx[0..dn_cnt-1]=dsubs (其余维清零); 嵌套行 → 本层 depth */
            若 (深度 == 0) {
                遍 (整 计 = 0; 计 < 主己; 计++) 现双[计] = 0;
                遍 (整 计 = 0; 计 < 链从; 计++) 现双[计] = 首进一[计];
            } 否 {
                现双[深度] = 首进一[0];
            }
            /* 落 leaf 消费值 (C99: [2]=9 后随值落 a[3] — leaf 的 ++ 推进保持语义) */
        }
        若 (词型表[词位] == 左花 && 深度 < 主己 - 1) { /* nested row { ... } */
            现双[深度 + 1] = 0; /* reset the child cursor (fix: next row continued from the previous row's column) */
            左升(发字节, 元, 维数表, 主己, 深度 + 1, 元素尺寸); /* 递归开头统一吃 '{' (fix 2026-08-05: FK also tk++'d → double-ate on 3D) */
            现双[深度]++; /* 行推进 */
            续;
        }
        若 (词型表[词位] == 串词 && 元素尺寸 <= 1) { /* char 行 = 字符串: char s[2][4] = {"ab","cd"} — copy the string BYTES into the row (fix 2026-08-05: was stored as a string ADDRESS → garbage); fix 2026-08-13: 指针数组 char *arr[] = {"A"} esz=8 → 走 leaf 存地址 (原 copy bytes → 元素=字符 → 解引用崩溃) */
            整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), (字*)(节名表 + 元), 32);
            字 *单细一 = 串表[词值表[词位]]; 词位++;
            整 行尺寸 = 维数表[主己 - 1] ? 维数表[主己 - 1] : 1;
            /* 行号 → 前 nd-1 维索引（从次内层展开，独立于嵌套 depth） */
            整 段浅 = 串行;
            整 池薄[8];
            遍 (整 计 = 主己 - 2; 计 >= 0; 计--) { 池薄[计] = 段浅 % (维数表[计] ? 维数表[计] : 1); 段浅 /= (维数表[计] ? 维数表[计] : 1); }
            整 堆零 = 标识序;
            遍 (整 计 = 0; 计 < 主己 - 1; 计++) {
                整 实伴 = 建节(14); 接子(实伴, 堆零);
                整 序标 = 建节(0); 节值表[序标] = 池薄[计];
                接子(实伴, 序标);
                堆零 = 实伴;
            }
            整 长度一 = (整)取字长(单细一);
            若 (长度一 > 行尺寸) 长度一 = 行尺寸;
            遍 (整 键 = 0; 键 < 长度一; 键++) {
                整 实伴 = 建节(14); 接子(实伴, 堆零);
                整 序标 = 建节(0); 节值表[序标] = 键;
                接子(实伴, 序标);
                整 赋值 = 建节(10); 接子(赋值, 实伴);
                整 计数一 = 建节(0); 节值表[计数一] = (无 字)单细一[键];
                接子(赋值, 计数一);
                序寅(赋值);
            }
            若 (长度一 < 行尺寸) { /* NUL-terminate (C: the rest of the char row is zeroed) */
                整 实伴 = 建节(14); 接子(实伴, 堆零);
                整 序标 = 建节(0); 节值表[序标] = 长度一;
                接子(实伴, 序标);
                整 赋值 = 建节(10); 接子(赋值, 实伴);
                整 计数一 = 建节(0); 节值表[计数一] = 0;
                接子(赋值, 计数一);
                序寅(赋值);
            }
            串行++;
            续;
        }
        /* leaf: a[gi_idx[0]][gi_idx[1]]...[gi_idx[nd-1]] = expr */
        若 (词型表[词位] == 左花) { /* struct element initializer { ... }: parse into elem fields (fix 2026-08-15: commands[] global array of structs was skipped -> get_builtin found nothing) */
            整 构序 = 变量型序((字*)(节名表 + 元)); /* local struct arrays now take this path too (fix 2026-08-16: help.c cmd_version local options[] was skipped -> opts->argh garbage -> strcspn(NULL-ish) crash) */
            若 (构序 >= 0) {
                整 副系 = 建节(1); 复制内存((字*)(节名表 + 副系), (字*)(节名表 + 元), 32);
                整 末戌 = 副系;
                遍 (整 计 = 0; 计 < 主己; 计++) {
                    整 下重一 = 建节(14); 接子(下重一, 末戌);
                    整 序标二 = 建节(0); 节值表[序标二] = 现双[计];
                    接子(下重一, 序标二);
                    末戌 = 下重一;
                }
                词位++; /* skip { */
                整 减法 = 值布(构序, 末戌);
                若 (减法 >= 0) { 遍 (整 键 = 0; 键 < 256; 键++) { 整 字符 = 取子(减法, 键); 若 (字符 > 0) 序寅(字符); } }
                若 (词型表[词位] == 右花) 词位++; /* closing } */
                若 (深度 == 0 && !新复) { 遍 (整 计 = 主己 - 1; 计 >= 0; 计--) { 现双[计]++; 若 (现双[计] < 维数表[计]) 断; 现双[计] = 0; } } 否 { 现双[深度]++; }
                续;
            }
            整 元二 = 1; 词位++;
            循环 (词位 < 词容量 && 元二 > 0) { 若 (词型表[词位] == 左花) 元二++; 否 若 (词型表[词位] == 右花) { 元二--; 若 (元二 <= 0) { 词位++; 断; } } 词位++; }
            若 (深度 == 0 && !新复) { 遍 (整 计 = 主己 - 1; 计 >= 0; 计--) { 现双[计]++; 若 (现双[计] < 维数表[计]) 断; 现双[计] = 0; } } 否 { 现双[深度]++; }
            续;
        }
        整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), (字*)(节名表 + 元), 32);
        整 堆零 = 标识序;
        遍 (整 计 = 0; 计 < 主己; 计++) {
            整 实伴 = 建节(14); 接子(实伴, 堆零);
            整 序标 = 建节(0); 节值表[序标] = 现双[计];
            接子(实伴, 序标);
            堆零 = 实伴;
        }
        整 赋值 = 建节(10); 接子(赋值, 堆零); 接子(赋值, 表达式());
        序寅(赋值);
        /* advance: top-level flat → little-endian carry; nested rows → this row's column */
        若 (深度 == 0 && !新复) {
            遍 (整 计 = 主己 - 1; 计 >= 0; 计--) {
                现双[计]++;
                若 (现双[计] < 维数表[计]) 断;
                现双[计] = 0;
            }
        } 否 {
            现双[深度]++;
        }
    }
    若 (词型表[词位] == 右花) 词位++; /* 本层 '}' */
    若 (深度 == 0 && 栈肆 >= 0) 接子(发字节, 栈肆); /* fix 2026-08-06: 根块挂到顶层块 */
}

/* C99 compound literal: (T){ init } — 匿名自动存储期临时对象 (fix 2026-08-11 Phase 2-3).
   cast 分支在 ')' 后见 FK 时调用。注册 _cl<N> 临时变量, 复用 brace_fields/brace_arr_init 填充,
   初始化块挂到 cl_blk (blk() 当前块), 返回临时对象的地址节点 (Nd(1)). */
静 整 新集一 = 0; /* 2026-08-28 可重入修复: 复合字面量临时名计数器 — reset_compile_state 每编译重置 */
静 整 余陆 = 0; /* 2026-08-28 可重入修复: for-range 临时名计数器 — reset_compile_state 每编译重置 (原函数内静态跨编译累积 → 第 2 次编译临时名漂移) */
静 整 行巳 = 0; /* 2026-08-28 可重入修复: 错 union 临时名计数器 — reset_compile_state 每编译重置 */
静 整 存伍(整 是否构标, 整 构序, 整 初柒, 整 数组数一, 整 数组元素尺寸) {
    字 变节[64]; 内存设置(变节, 0, 64); 格式化限长(变节, 32, "_cl%d", 新集一++); /* 2026-08-28 编译DAG: memset 清零 — snprintf 尾部不置零, memcpy(nn,vn,32) 拷栈垃圾 → nn 哈希非确定 (功能无害, 过程级哈希须确定性) */
    整 发字节 = 建节(5); /* block: decl + init assigns */
    整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 变节, 32); /* decl node */
    整 右丙 = 建节(5); /* init assignments (挂到 cl_blk) */
    若 (初柒) {
        若 (数组数一 <= 0) { /* (T[]){} : 数 FK 内顶层元素数推断 dims */
            整 存词位 = 词位; 整 计数二 = 0; 整 前合一 = 1; 词位++; /* skip { */
            循环 (词位 < 词容量 && 前合一 > 0) {
                若 (词型表[词位] == 左花) 前合一++;
                否 若 (词型表[词位] == 右花) { 前合一--; 若 (前合一 == 0) 断; }
                否 若 (词型表[词位] == 逗号 && 前合一 == 1) 计数二++;
                词位++;
            }
            数组数一 = 计数二 + 1;
            词位 = 存词位;
        }
        末午(变节, 数组数一, 数组元素尺寸);
        接子(发字节, 元); /* declare */
        整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), 变节, 32);
        整 维数表[1]; 维数表[0] = 数组数一;
        词位++; /* skip { */
        左升(右丙, 标识序, 维数表, 1, 0, 数组元素尺寸);
    } 否 若 (是否构标) {
        变构(变节, 构序);
        接子(发字节, 元);
        整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), 变节, 32);
        词位++; /* skip { 先跳 FK (brace_fields 从 FK 后开始) */
        整 乙序 = 值布(构序, 标识序);
        接子(右丙, 乙序);
        若 (词型表[词位] == 右花) 词位++; /* } */
    } 否 { /* scalar: (T){5} → 临时 = 5 (C99: 标量 compound literal 是值, 非地址) */
        词位++; /* skip { */
        整 数值 = 表达式(); /* { 后的表达式值 */
        若 (词型表[词位] == 右花) 词位++; /* } */
        /* 标量不需要临时变量 — 直接返回值 */
        返 数值;
    }
    /* 声明挂当前块, 初始化挂 cl_blk (compound literal 语义: 初始化在包含语句前执行) */
    若 (虚三 >= 0) 接子(虚三, 发字节);
    若 (虚三 >= 0) 接子(虚三, 右丙);
    整 数 = 建节(1); 复制内存((字*)(节名表 + 数), 变节, 32); /* 返回临时对象地址 */
    返 数;
}
静 整 常量表达式求值(整 *数值); /* fwd (fix 2026-08-15: blk 内局部数组维度用常量表达式) */
静 整 块(空) {
    整 发字节 = 建节(5); 词位++;
    解析深++; 若 (解析深 > 350) 原得("块递归深度", 350); /* 资源护栏 9b (2026-08-28): 深块嵌套 {{{{...}}}} 递归护栏 (块每层 2-3 帧, 与表达式共用计数, 上限统一 350 安全线下) */
    计贰++; /* 接入 2026-08-28 机制层 #4: 生命周期=词法块作用域 — 进入块深度+1, 块内借用记 scope, 块退出自动放还 */
    净丙++; /* 接入 2026-08-28 机制层 #78: 未初始化变量表块深度 — 块退出清除本块声明 */
    整 末重 = 发字节;  /* first block = sequence root; extra blocks chain as children */
    整 缓申 = 变量数; /* fix 2026-08-19: 本块直接声明的变量起点 — 结束时给未标记 blk_start/blk_end 的变量 (本块直接声明) 打上本块范围, 嵌套块的变量已由嵌套 blk() 标记, 不会被覆盖 */
    副子[末重] = 缓申; /* codegen 作用域判定: 本块 var 下界 */
    整 终降一 = 虚三; 虚三 = 发字节; /* compound literal 初始化挂当前块 (fix 2026-08-11) */
    整 字节计数 = 0;   /* children attached to current block (keep 256-slot headroom) */
    
    循环 (词型表[词位] != 右花 && 词型表[词位] != 词终) { /* fix 2026-08-07: 缺 } 时 EK 防死循环 (原 while != UK 遇 EOF 转空 + tk 越界崩溃) */
        旁联 = 0; 名散 = 0; /* fix 2026-08-25 step21: 每块语句清残留 — 变量前 _Alignas 不消费也不毒害后续声明; step25: ag_struct 同步清 */
        若 (词型表[词位] == 直联) { 整 首酉 = 词值表[词位]; 词位++; 若 (词型表[词位] == 结构词) { 名散 = 首酉; 旁联 = 0; } 否 旁联 = 首酉; } /* fix 2026-08-25 step21: 块级 _Alignas(N) — struct 前修饰 struct 变量 (step25), 否则给变量 (下一轮清理) */
        
        若 (字节计数 >= 200) { /* block near its 256 child slots: chain a new sub-block
                               (cg case 5 recurses into nested blocks). main()'s body
                               has ~270 statements �?without this, Nc() silently drops
                               everything past the 256th. */
            整 新三 = 建节(5);
            接子(发字节, 新三);
            发字节 = 新三;
            字节计数 = 0;
        }
        若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "__asm__") || !比较字符串(词名表[词位], "__asm"))) { /* 内联汇编: 跳过 (fix 2026-08-14: malloc.c.h/sha1.c 的 __asm__ 内存屏障 → undefined symbol) */
            词位++; /* __asm__ */
            若 (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "__volatile__") || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")))) 词位++; /* __volatile__ */
            若 (词型表[词位] == 左括) { 整 元 = 1; 词位++; 循环 (词位 < 词容量 && 元 > 0) { 若 (词型表[词位] == 左括) 元++; 否 若 (词型表[词位] == 右括) { 元--; 若 (元 <= 0) { 词位++; 断; } } 词位++; } } /* 跳过 (asm body) */
            若 (词型表[词位] == 分号) 词位++; /* ; */
            续;
        }
        若 (词型表[词位] == 结构词 || (词型表[词位] == 型词 && ((!比较字符串(词名表[词位], "static") || !比较字符串(词名表[词位], "静")) || (!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常")) || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失"))) && 词型表[词位 + 1] == 结构词) || (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "register") && 词型表[词位 + 1] == 结构词) || (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "static") || !比较字符串(词名表[词位], "静")) && 词型表[词位 + 1] == 型词 && ((!比较字符串(词名表[词位 + 1], "const") || !比较字符串(词名表[词位 + 1], "常")) || (!比较字符串(词名表[词位 + 1], "volatile") || !比较字符串(词名表[词位 + 1], "易失"))) && 词型表[词位 + 2] == 结构词)) {
            /* function-local struct var: [static] [const] [volatile] [register] struct C c; (fix 2026-08-15: static const struct opentry; register struct _obstack_chunk *chunk; fix 2026-08-29 csmith: volatile struct S0 **l_299 原不认 volatile → 声明跳过 → 未定义函数) */
            
            整 是否静态标 = (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "static") || !比较字符串(词名表[词位], "静")));
            若 (是否静态标) 词位++; /* static */
            若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "register")) 词位++; /* register 存储类忽略 (fix 2026-08-15: obstack.c _obstack_begin chunk undefined) */
            循环 (词型表[词位] == 型词 && ((!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常")) || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")))) 词位++; /* const/volatile */
            词位++; /* struct */
            整 构序 = -1;
            若 (词型表[词位] == 词变量) { 构序 = 查类型(词名表[词位]); 词位++; } /* tag name C */
            /* fix 2026-08-17: 无 body 的局部 struct 变量声明 — 指针/指针数组/struct 数组/逗号.
               blk() 原仅「有 body」注册变量 (struct P {...} p), 无 body 漏 → 变量未注册 →
               外部符号 UND (cat-file.c cmd, add-patch.c colored, show-branch.c rev/commit,
               upload-pack.c pfd). */
            若 (词型表[词位] != 左花 && (词型表[词位] == 乘 || (词型表[词位] == 词变量 && (词型表[词位 + 1] == 左方 || 词型表[词位 + 1] == 逗号 || 词型表[词位 + 1] == 赋号)))) {
                整 是否指标 = (词型表[词位] == 乘);
                整 指深一 = 0;
                循环 (词型表[词位] == 乘) { 是否指标 = 1; 指深一++; 词位++; 循环 (词型表[词位] == 型词 && ((!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常")) || (!比较字符串(词名表[词位], "volatile") || !比较字符串(词名表[词位], "易失")))) 词位++; } /* fix 2026-08-20: 数指针层级 — struct X ** 原只消费一个 * → 第二个 * 残留 → VR 检查失败 → 声明被跳过 → 变量走隐式注册 p_esz=4 → prune_directory src/dst 步进/缩放全错 → add 丢文件; fix 2026-08-30 csmith t5: 指针链中间 const/volatile (struct S0 ** volatile * volatile *volatile *l — s116/s162 原残留 → 变量未注册 → 未定义函数) */
                若 (词型表[词位] == 左括 && 词型表[词位 + 1] == 词变量 && (词型表[词位 + 2] == 左方 || 词型表[词位 + 2] == 右括)) {
                    /* struct X *(name[N]) paren-array (fix 2026-08-23: builtin_diff_tree oid[2] unregistered) */
                    词位++; /* ( */
                    字 深辰[64]; 复制字符串(深辰, 词名表[词位]); 词位++; /* name */
                    整 行五 = 1;
                    循环 (词型表[词位] == 左方) {
                        词位++; 若 (词型表[词位] == 常数) { 行五 = 词值表[词位]; 词位++; }
                        否 若 (词型表[词位] == 词变量) { 整 评测数二 = 全回(词名表[词位]); 若 (评测数二 == 0x80000000) 评测数二 = 域零(词名表[词位]); 若 (评测数二 != 0x80000000 && 评测数二 != -1) 行五 = 评测数二; 词位++; }
                        若 (词型表[词位] == 右方) 词位++;
                    }
                    若 (词型表[词位] == 右括) 词位++; /* ) */
                    整 双组 = 是否指标 ? 8 : (构序 >= 0 ? 类型表[构序].尺寸 : 4);
                    若 (是否静态标) 隔排(深辰, 0, 双组, 行五);
                    否 末午(深辰, 行五, 双组);
                    变量表[变量数 - 1].型序标 = 构序;
                    若 (是否指标) { 变量表[变量数 - 1].指深 = 指深一; 变量表[变量数 - 1].指内 = 构序 >= 0 ? 类型表[构序].尺寸 : 4; }
                    整 反劣 = 建节(7); 复制内存((字*)(节名表 + 反劣), 深辰, 32);
                    接子(发字节, 反劣); 字节计数++;
                    循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++;
                    若 (词型表[词位] == 分号) 词位++;
                    续;
