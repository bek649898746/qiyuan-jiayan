        { 整 符号数 = 建节(0); 节值表[符号数] = 串数; 节型表[符号数] = 串词; 节型别[符号数] = 节点_串词; 接子(呼, 符号数); }
        串数++;
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "throw_ex", 9); 接子(呼, 函); } /* 被调者 最后 */
        若 (当前捕获标签[0]) { /* #55: 试 块内 抛出 → { throw_ex; 跳转 捕获标签; } */
            整 试抛块 = 建节(5);
            接子(试抛块, 呼);
            若 (行有值) { 整 试值赋 = 建节(10); { 整 试值名 = 建节(1); 复制内存((字*)(节名表 + 试值名), "ex_val", 7); 接子(试值赋, 试值名); } 接子(试值赋, 行值); 接子(试抛块, 试值赋); } /* #80: ex_val = 值 */
            { 整 试抛跳 = 建节(25); 复制内存((字*)(节名表 + 试抛跳), 当前捕获标签, 64);
              { 整 试抛段 = 元败(当前捕获标签); 若 (试抛段 < 0) 试抛段 = 暂回(当前捕获标签); 节值表[试抛跳] = 试抛段 + 1; }
              接子(试抛块, 试抛跳); }
            返 试抛块;
        }
        若 (行有值) { /* #80: 非试块 抛出 码, 值 → { throw_ex; ex_val = 值; } */
            整 抛块 = 建节(5);
            接子(抛块, 呼);
            { 整 试值赋 = 建节(10); { 整 试值名 = 建节(1); 复制内存((字*)(节名表 + 试值名), "ex_val", 7); 接子(试值赋, 试值名); } 接子(试值赋, 行值); 接子(抛块, 试值赋); }
            返 抛块;
        }
        返 呼;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "若错")) { /* 接入 2026-08-27 异常传播检查: 若错 <语句>; → 若 (待定异常) <语句>; — 中间层传播 (C 模拟栈回卷) */
        词位++; /* 若错 */
        整 若序 = 建节(8);
        { 整 值子 = 建节(1); 复制内存((字*)(节名表 + 值子), "ex_pending", 11); 接子(若序, 值子); } /* 若 (待定异常) 非零即真 */
        接子(若序, 语句()); /* 传播语句 */
        返 若序;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "捕获")) { /* 接入 2026-08-27 异常捕获吞掉: 捕获; → 若 (待定异常) { 待定异常 = 0; } — 清除异常状态继续执行 (catch-全 吞异常, 异常码留 cur_ex.代码 供判断); 配合 抛出/若错 形成异常链 */
        词位++; /* 捕获 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        整 值子 = 建节(1); 复制内存((字*)(节名表 + 值子), "ex_pending", 11);
        整 若序 = 建节(8); 接子(若序, 值子);
        整 块 = 建节(5);
        { 整 零 = 建节(0); 节值表[零] = 0; 整 赋节 = 建节(10); 接子(赋节, 值子); 接子(赋节, 零); 接子(块, 赋节); } /* 待定异常 = 0 */
