                循环 (串值[指] && 串值[指] != ')' && 圆周率 < 16) { /* 修复 2026-08-07: 圆周率<16 防垃圾输入死循环 (原无界 → `...` 死转) */
                    循环 (串值[指] == ' ' || 串值[指] == '\t' || 串值[指] == ',') 指++;
                    循环 ((串值[指] == '\\' && 串值[指 + 1] == '\n') || (串值[指] == '\\' && 串值[指 + 1] == '\r' && 串值[指 + 2] == '\n')) { /* 修复 2026-08-15: 参数列表续行 \ (mergesort.h DEFINE_LIST_SORT_DEBUG 参数跨两行 — 原把 on_get_next,on_set_next 当 函数体 泄漏) */
                        指 += (串值[指 + 1] == '\r' ? 3 : 2);
                        循环 (串值[指] == ' ' || 串值[指] == '\t') 指++;
                    }
                    若 (串值[指] == ')') 断;
                    若 (串值[指] == '.' && 串值[指 + 1] == '.' && 串值[指 + 2] == '.') { /* 变参 ... → __VA_ARGS__ 参数 (修复 2026-08-07: #定义 F(x, ...) 支持) */
                        复制字符串(函数宏表[函数宏数].容败[圆周率], "__VA_ARGS__");
                        圆周率++; 指 += 3;
                        循环 (串值[指] == ' ' || 串值[指] == '\t') 指++;
                        断;
                    }
                    整 初细 = 0;
                    循环 (判字母数字((无 字)串值[指]) || 串值[指] == '_' || ((无 字)串值[指] >= 0x80)) { 若 (初细 < 63) 函数宏表[函数宏数].容败[圆周率][初细++] = 串值[指]; 指++; } /* A25 (2026-09-11): 补 >=0x80 中文 形参名 — 原 缺 此 判据 → 形参名 读成 空串, 且 因 0xE6 != ')' 不 退出 → 填 满 16 空参 → 展开 乱替换 (括号不匹配) */
                    函数宏表[函数宏数].容败[圆周率][初细] = 0;
                    圆周率++;
                }
                函数宏表[函数宏数].参数数 = 圆周率;
                若 (串值[指] == ')') 指++;
                循环 (串值[指] == ' ' || 串值[指] == '\t') 指++;
                整 乙序 = 0;
                循环 (串值[指] && 串值[指] != '\n' && 乙序 < 16383) {
                    若 (串值[指] == '\\' && (串值[指 + 1] == '\n' || (串值[指 + 1] == '\r' && 串值[指 + 2] == '\n'))) { /* 多行 函数体: \ 续行 → 空格 (修复 2026-08-05) */
                        余简[函数宏数] = 1;
                        若 (乙序 < 16383) 函数宏表[函数宏数].体[乙序++] = ' ';
                        指++;
                        若 (串值[指] == '\r') 指++;
                        若 (串值[指] == '\n') 指++;
                        续;
                    }
                    函数宏表[函数宏数].体[乙序++] = 串值[指++];
                }
                函数宏表[函数宏数].体[乙序] = 0;
                函数宏数++;
            }
        }
    }
    }
}

静 整 反八[64]; 静 整 栈凶一; /* 修复 2026-08-13: 展开栈 — 防宏互递归 A→B→A (列陆 只防直接自递归: 展开 A 时 函数体 调 B → B 展开时 A 又可入 → 无限; 版本库 hashmap_for_each_entry 嵌套链 + 修订.c) */
静 整 缺亥一[2048]; 静 整 余厚; /* 修复 2026-08-26 数据库: 函 宏位置语义 — 只有 #定义 之后的调用才展开 (sqlite3Utf8Read 原型在 #定义 之前被误展开成 (*((*A)++)) → 声明变表达式 → 参数 循环死锁) */

/* 展开 函-宏 调用 之内 段 (递归 遍 嵌套 终复) 入 *出 于 *o (增长).
   修复 2026-08-07: #x 字符串化 / ## 拼接 / __VA_ARGS__ 变参 / 自引用防递归 / 字符串字面量内不展开 / 参数扫描不拆串内逗号 */
静 字 *外午[64]; 静 整 符捌; 静 字 *当联; 静 字 *宽凶; /* 修复 2026-08-26 解析器/数据库: 副组 的 实参/新回 大缓冲从栈移到堆竞技场 — 16×4096×2=128素繁/层 × 递归嵌套 (sqlite3.c 深展开) 爆 1兆字节 栈 (0xC00000FD); 实参/新回 只在 暂存 构建前存活, 递归前可释放复用. 块链表: 块永不移动, 存活帧的 实参/新回 裸指针不过期 (单块 重分配 移动基址 → 旧指针失效 → 复制内存 写已释放块 → sqlite3.c 0xC0000005); 释放后区域复用, 峰值=最大并发嵌套 */
静 空 *净戌二(整 数) {
    若 (!符捌) {
        外午[0] = 内存分配(4 << 20);
        若 (!外午[0]) { 输出到文件(错误流, "[ERR] 内存不足 函数竞技场\n"); 退出(1); }
        当联 = 外午[0];
        宽凶 = 外午[0] + (4 << 20);
        符捌 = 1;
    }
    若 (当联 + 数 > 宽凶) {
        若 (符捌 >= 64) { 输出到文件(错误流, "[ERR] 函数竞技场 块 溢出\n"); 退出(1); }
        整 新三 = 8 << 20;
        外午[符捌] = 内存分配(新三);
        若 (!外午[符捌]) { 输出到文件(错误流, "[ERR] 内存不足 函数竞技场\n"); 退出(1); }
        当联 = 外午[符捌];
        宽凶 = 当联 + 新三;
        符捌++;
    }
    空 *结 = 当联; 当联 += 数;
    返 结;
}
静 空 直亥(字 *记) { 当联 = 记; } /* LIFO: 释放到 记 (块链表块永不移动, 裸指针永有效); 首建场景 记=空 → 下轮 分配 新建块 (一次性 4兆字节 浪费, 可接受) */

静 空 副组(常 字 *段, 字 **出指, 整 *丙, 整 *容量, 整 列陆) {
    字 *出 = *出指;
    若 (余厚 == 0) 遍 (整 键 = 0; 键 < 函数宏数; 键++) 缺亥一[键] = 0; /* 修复 2026-08-26 数据库: 顶层扫描从空激活集开始, 遇 #定义 激活, 遇 #未定义 停用 */
    余厚++;
    整 入串 = 0; /* 顶层串内逐字复制 (修复 2026-08-07: 字符串字面量里的 名( 不展开) */
    遍 (整 计 = 0; 段[计]; ) {
        /* 修复 2026-09-01 (泛型激活 UB): 原 `寻三 = 计 + (段[计]=='d' ? 6 : 9)` — 泛型 2 汉字 6 字节, 直接 +6 */
        若 (!入串 && 段[计] == '\xe7' && 段[计+1] == '\xb1' && 段[计+2] == '\xbb' && 段[计+3] == '\xe5' && 段[计+4] == '\x9e' && 段[计+5] == '\x8b' && !(判字母数字((无 字)段[计+6]) || 段[计+6] == '_' || (无 字)段[计+6] >= 0x80)) { /* "类型" — 阶段C-1 #46 泛型类型别名 (2026-09-01): 类型 名(T) = 类型体; 仅 名( 才当泛型 typedef, 普通 typedef 落回; 词边界: 类型字段/类型表 等以类型开头函数名排除 */
            整 寻三 = 计 + 6; 循环 (段[寻三] == ' ' || 段[寻三] == '\t') 寻三++;
            字 域一[64]; 整 主未 = 0;
            循环 (判字母数字((无 字)段[寻三]) || 段[寻三] == '_' || ((无 字)段[寻三] >= 0x80)) { 若 (主未 < 63) 域一[主未++] = 段[寻三]; 寻三++; }
            域一[主未] = 0;
