    行退(); /* eax = [r13] */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* add r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* sub r13, 8 */ }
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    相对跳转(-1); 补标号(码位-4, 容低, 2);
    /* %s: copy string arg — fix 2026-08-23 t35h: %Ns/%*s 宽度填充 (swidth) */
    设标号(暂双);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* inc r11 (past spec char) */
    长劣(); /* rax = [r13] (64-bit ptr) */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* add r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* sub r13, 8 */ }
    移64(8, 0); /* r8 = string */
