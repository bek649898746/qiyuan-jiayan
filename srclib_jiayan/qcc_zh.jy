            /* 内建 __asm_byte(v): 发射一个字节到 bin_hdr (Multiboot header/手写内核, fix 2026-08-08) */
            若 (节型表[函] == 1 && !比较字符串(串升, "__asm_byte") && 满双) {
                整 参值 = 子0[数]; /* 第一个实参 (子节点) */
                若 (参值 >= 0 && 节型表[参值] == 0) {
                    若 (容重一 < 256) 上子[容重一++] = 节值表[参值] & 0xFF;
