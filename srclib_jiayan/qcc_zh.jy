            若 (左陆 < 64) {
                整 短进 = 宽捌(); /* 模式值用 band() (不含 | 位或) — expr() 会把 `1 | 2` 的 | 当位或吃掉 → or 模式失效 */
                整 值二 = -1; 整 直肆 = -1;
                整 池平 = 0; 字 左布[64]; 左布[0] = 0; /* 2026-08-28 P2 #138 引用模式: 对照 引用 v: 结果 → 臂内绑定 v */
                若 (短进 >= 0 && 节型表[短进] == 1 && !比较字符串((字*)(节名表 + 短进), "引用")) {
                    池平 = 1;
                    复制字符串(左布, 词名表[词位]); 词位++; /* 绑定变量名 */
                    若 (查变量(左布) < 0) 变量偏移(左布);
                    未初始化移除(左布); /* 运行时臂内绑定初始化 — 解析期免未初始化误报 */
