                    汇发("    加 r11, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,0,3); 发字节(8); /* 数据区 (fix 2026-08-22 t45: single-file 同 coff header) */
