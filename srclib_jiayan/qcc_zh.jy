                    循环 (串值[寻] == ' ' || 串值[寻] == '\t') 寻++;
                    循环 (判字母数字((无 字)串值[寻]) || 串值[寻] == '_' || ((无 字)串值[寻] >= 0x80)) { 若 (名序 < 63) 名存[名序++] = 串值[寻]; 寻++; }
                    名存[名序] = 0;
