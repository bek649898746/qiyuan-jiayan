        循环 (词型表[词位] != 右括 && 词型表[词位] != 分号 && 词型表[词位] != 词终 && 邻轮 < 16) { 帧优[邻轮] = 表达式(); 邻轮++; 若 (词型表[词位] == 逗号) 词位++; 否 断; }
        若 (词型表[词位] == 右括) 词位++; /* ) */
        若 (词型表[词位] == 分号) 词位++; /* ; */
