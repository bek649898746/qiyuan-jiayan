                整 内四 = 4, 缺二 = 0, 左利 = 0;
                循环 (词型表[词位] == 型词) {
                    若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) 内四 = 1;
                    否 若 ((!比较字符串(词名表[词位], "short") || !比较字符串(词名表[词位], "短"))) 内四 = 2;
                    否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) { 缺二 = 1; 内四 = 8; }
                    否 若 ((!比较字符串(词名表[词位], "unsigned") || !比较字符串(词名表[词位], "无") || !比较字符串(词名表[词位], "无整"))) 左利 = 1;
                    否 若 ((!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整")) && 词型表[词位 + 1] == 型词 && (!比较字符串(词名表[词位 + 1], "long") || !比较字符串(词名表[词位 + 1], "长") || !比较字符串(词名表[词位 + 1], "长整"))) 内四 = 8;
                    词位++;
