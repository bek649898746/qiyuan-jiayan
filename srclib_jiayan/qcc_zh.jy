/* ========== 编译期执行完整 编译期求值 (2026-08-28 类型-根-16 #76): 编译期 f(常量...) — 用户纯函数编译期求值 ========== */
静 构 { 字 名[64]; 整 短亥; 整 隔子; } 计序[2048]; 静 整 计丁 = 0; /* 函数体 词元 范围 (函数定义时记录) */
静 整 宽庚(常 字 *数) { 遍 (整 计 = 0; 计 < 计丁; 计++) 若 (!比较字符串(计序[计].名, 数)) 返 计; 返 -1; }
静 字 余布[64][64]; 静 整 双午[64]; 静 整 宽劣 = 0; /* 编译期求值 求值帧 (参数+局部, 栈式嵌套) */
静 整 中劣(常 字 *数) { 遍 (整 计 = 宽劣 - 1; 计 >= 0; 计--) 若 (!比较字符串(余布[计], 数)) 返 双午[计]; 返 0x80000000; }
静 字 当解析函[64]; /* 2026-08-28 阶段一 #11: 当前解析的函数名 (悬垂引用检测用) */
/* ========== 过程宏 (2026-08-29 阶段二 #172): 编译期跑函数生成代码 — 编译期求值 字符串返回 + 调用点 词元 拼接 ==========
   语义: 过程宏 函数名; 注册 (函数须先定义, 编译期求值 需函数体 词元 范围); 调用点 宏名(常量...)
   → 毛重 解释函数体得生成代码串 → 副酉一 落位 → 移动内存 就地拼接 → 续解析。 */
静 字 顺得[256][64]; 静 整 计凶 = 0; /* 已注册过程宏函数名表 (解析 重置) */
静 整 首申(常 字 *数) { 遍 (整 计 = 0; 计 < 计凶; 计++) 若 (!比较字符串(顺得[计], 数)) 返 1; 返 0; }
静 字 源利[64]; /* 编译期求值 帧槽是否存字符串 (整数/串 双态) */
静 字 外薄[64][4096]; /* 编译期求值 字符串帧值 (并行 到 余布/双午) */
静 字 外退[8192]; /* 编译期求值 字符串返回缓冲 */
静 整 净十 = 0; /* 最近一次 返回 是否字符串 (毛重 读取) */
静 空 栈吉一(常 字 *数, 常 字 *值);
静 整 初进(常 字 *数, 字 *出, 整 剩繁);
静 整 首进(常 字 *数);
静 整 序置(字 *出, 整 剩繁); /* 前向: 字符串表达式求值 (池分 用) */
静 整 毛重(常 字 *串升, 字 *出, 整 剩繁); /* 前向: 字符串版 编译期求值 调用 (过程宏展开用) */
静 整 副酉一(常 字 *串值, 整 尾柒); /* 前向: 生成代码 词元 化 */
静 整 旧序[8192]; /* 接入 2026-08-29 阶段二 #152 TCO (重试): 每函数参数复制点标签 (尾递归 跳转 目标, 跳过 前奏 栈分配) */
静 字 当前函数尾调[65536]; /* #152 TCO: 当前函数是否显式 尾调用优化; (编译器 自身源码不用 → 自举不触发 TCO → 收敛稳定) */
静 整 中属(常 字 *串升, 整 *出); /* 前向: 编译期 f(常量...) 求值 (定义在 const_expr 区, 原级 需前向) */
静 整 *词无符号表; /* 每-词元 无符号-后缀 标志 (0xFFFFFFFFu) — 修复 2026-08-05 */
静 整 *词长表; /* 每-词元 长整-长整-后缀 标志 (1000000000邻辰) — 修复 2026-08-05 */
静 整 *段属; /* 每-词元 高 32 符弊 的 a 长整-长整 字面量 (修复 2026-08-05) */

静 整 *节型表, *节型别, *节值表, *子0, *子1, *子2, *子3, *子4, *子5, *子6, *子7, *子8, *子9, *子10, *子11, *子12, *子13, *子14, *子15, *子16, *子17, *子18, *子19, *目属, *后双, *号得一, *缓七, *域癸, *半丙, *首厚, *高拆一, *副败一, *前低一, *外八一, *虚吉, *栈七, *计午一, *外对, *度叁, *主申, *元六, *度丁, *长薄, *主退一, *主轮, *现降, *外辰, *内己, *副进一, *末拆, *缺利, *域进, *全戌, *右十, *存一, *首辛, *目壹, *栈退, *源己一, *副申, *旧回, *邻丑, *链凶, *直厚, *目丁一, *帧升, *末升, *度捌, *正六, *序对一, *元戌, *右组, *段庚, *列未, *栈又一, *单再, *末双, *末子一, *毛得, *中七, *值劣一, *全聚, *行午, *满联二, *整低, *隔卯, *目甲一, *缓退, *宽分, *全聚一, *满丑, *缺午, *帧凶, *尾置, *原八, *终降, *半厚, *主三, *行凶, *池肆, *暂辛, *号系, *余利, *间次, *新酉, *左壬, *符寅, *计子一, *计细, *暂叁, *虚肆, *名癸, *源重, *列六, *外丙, *帧卯, *下重, *长成, *源进, *半利, *符置, *目六, *前又, *上平, *尾五一, *深重, *全贰, *整退, *深叁, *素乙, *串败, *左降, *宽九, *池又, *逆合, *正癸, *高又, *初伍, *反双, *深丙, *末辰, *存陆一, *素降, *隔叁, *源转, *名次, *间双, *容未, *标复, *计粗, *栈巳, *目乙, *暂联, *双环, *旧降, *实弊, *尾辰一, *缺联, *号子, *缓平一, *满升, *缺双, *正回, *虚失, *符得, *号复, *尾对, *实集, *顺五一, *余戌, *逆八, *中凶, *元失, *尾次, *计庚一, *初七, *右弊, *深汇, *正伴, *半退一, *短深, *满午, *顺高, *原子一, *源退, *串二, *后吉, *逆系, *缺聚一, *逆陆, *缺丙一, *剩凶, *目酉, *存简, *终挂, *隔捌, *剩列, *堆双一, *值陆, *素再, *副伴, *虚四, *隔置, *名子, *旁低, *净戌, *副败, *新壹一, *总戌, *剩戊, *高卯, *空亥, *逆零, *间弊, *总丙一, *半平一, *初七一, *邻肆, *内深, *后联, *素七, *池贰, *中合, *串陆, *度浅, *初挂, *虚贰, *尾劣, *外简, *值从, *标巳, *度排, *现排, *空属, *高弊, *深零一, *标集, *整得一, *上组, *初成一, *缺贰, *余散, *整未, *原厚, *首亥, *现弊, *间得, *缺粗, *空凶, *整集一, *中聚, *短得, *实序, *主聚, *标寅, *栈凶二, *存丁, *净双, *后拾, 接子数;

/* 修复 2026-08-30 探雷雷2: 明显类型错配检查 — 字符串/整数/指针/字符 赋值 (声明初始化+赋值共用).
   只查字面量级错配 (报告三用例: 整 x="字符串" / 整数 *p=12345 / 字 c="字符串"), 表达式/显式 转型
   天然豁免 (节型表 非 串词/0/1), 运行时库 豁免 (序集 在调用方). C 惯例: 0/空 赋指针合法,
   字符[] 收字符串合法. */
判别 节点 于 { 常数, 变量, 二元, 块, 调用, 作用域块, 返节, 声明节, 条件, 循环节, 赋值, 取址, 解引用, 箭头, 下标, 成员, 中断节, 非节, 十八, 转型, 标号, 继续节, 三元, 增减, 循环后判, 跳转节, 前置增减, 窄转型, 借语义, 串词, 双字面量, 其他 }; /* E1a-E1e (2026-09-06): AST 节点判别化 — E1e 扩全节点类型 (码生成器迁移基础; 序=节点类型 0..28 + 串词29 + 双字面量65); 关键字变体加 节 后缀防 lexer 改写 (返回/声明/循环/中断/继续/跳转 是关键字) */
静 空 序平(整 右侧, 常 字 *顺挂, 整 变序) {
    若 (右侧 < 0 || 变序 < 0 || 变序 >= 变量数 || 右侧 >= 接子数 || 右侧 >= 节容量 || !顺挂) 返;
    整 链附 = (变量表[变序].指深 > 0) || (变量表[变序].数组元素尺寸 == 8 && 变量表[变序].数组尺寸 == 0);
    若 (节型别[右侧] == 节点_串词 && !链附 && 变量表[变序].数组尺寸 == 0) {
        格式化到串(错缓冲, "类型错配: 字符串字面量赋给 '%s' — 字符串只能赋给 字符*/字符[] (探雷雷2)", 顺挂);
        发错误("A2001", 错缓冲);
    }
    若 (节型别[右侧] == 节点_常数 && 链附 && 节值表[右侧] != 0 && !暂合[右侧]) {
        格式化到串(错缓冲, "类型错配: 整数 %d 赋给指针 '%s' — 指针只能用地址或 空(0) (探雷雷2)", 节值表[右侧], 顺挂);
        发错误("A2001", 错缓冲);
    }
    若 (节型别[右侧] == 节点_变量 && !链附 && !变量表[变序].是否浮标 && !变量表[变序].是否长标) {
        整 栈厚 = 查变量((字*)(节名表 + 右侧));
        若 (栈厚 >= 0 && (变量表[栈厚].指深 > 0 || (变量表[栈厚].数组元素尺寸 == 8 && 变量表[栈厚].数组尺寸 == 0))) {
            格式化到串(错缓冲, "类型错配: 指针赋给整数变量 '%s' — 指针不能隐式转整数 (探雷雷2)", 顺挂);
            发错误("A2001", 错缓冲);
        }
    }
    若 (节型别[右侧] == 节点_变量 && !暂合[右侧] && !链附) { 整 左槽 = 查活变量(顺挂); 整 右槽 = 查活变量((字*)(节名表 + 右侧)); 若 (左槽 >= 0 && 右槽 >= 0 && 变量表[左槽].无符号标 != 变量表[右槽].无符号标 && !变量表[左槽].是否浮标 && !变量表[右槽].是否浮标 && !变量表[左槽].是否字符标 && !变量表[右槽].是否字符标 && !变量表[左槽].是否短标 && !变量表[右槽].是否短标) { 格式化到串(错缓冲, "无隐式转换: %s 变量 '%s' 赋给 %s 变量 '%s' (符号位语义变化) — 用 转 显式转换 (类型根治④, 号合.0 #74)", 变量表[右槽].无符号标 ? "无符号" : "有符号", (字*)(节名表 + 右侧), 变量表[左槽].无符号标 ? "无符号" : "有符号", 顺挂); 发错误("A9002", 错缓冲); } } /* 2026-09-10 C1: 无符号/有符号 隐式转换 (公共路径: 直丁/标量声明 都经 序平; 暂合=显式转型豁免) */
}
静 空 构初校验(整 右侧, 常 字 *顺挂) { /* P2-18 (2026-09-10): 构值 变量 声明初始化式 类型校验 — 原 无检查 → 构 X b = 42; 编译过 + 运行 0xC0000005; 构 X b = 未定义名; 静默置零 (合法代码被静默错值); 本函数 = 直丁 尾调, 节点判别常量 可见 (在 L3809 判别 之后) */ 若 (!序集 || 首己 || 右侧 < 0 || !顺挂 || 顺挂[0] == '_') 返; 若 (右侧 >= 接子数 || 右侧 >= 节容量) 返; 整 查栈 = 查变量(顺挂); 若 (查栈 < 0) 返; 整 槽二 = -1; 遍 (整 _k = 变量总数() - 1; _k >= 解析基; _k--) 若 (变量表[_k].栈偏移 == 查栈 && 变量码生成可见(_k)) { 槽二 = _k; 断; } 若 (槽二 < 0 || 变量表[槽二].型序标 < 0 || 变量表[槽二].指深 != 0 || 变量表[槽二].数组尺寸 != 0) 返; /* 非 构值标量/指针/数组 → 不查 */ 整 初型 = 节型别[右侧]; 若 ((初型 == 节点_常数 || 初型 == 节点_串词 || 初型 == 节点_双字面量 || 初型 == 节点_非节) || (初型 == 节点_二元 && 表达式构序(右侧) < 0)) { /* R535-e5: `节点_二元` 原**无条件**当标量 ⟹ 逗号表达式 (`(z=5,s)`) 被误报「标量表达式」; 改为「二元 **且** 非构值」才报 —— 真二元运算 表达式构序 返 -1 ⟹ 行为不变 */ 格式化到串(错缓冲, "类型错配: 结构体值变量 '%s' 不能用 标量表达式 初始化 (需 同型构值/构值函数/花括初始化 { }; 无隐式转换)", 顺挂); 发错误("A9002", 错缓冲); } 否 若 (初型 == 节点_变量) { 字 *源名 = (字*)(节名表 + 右侧); 整 源栈 = 查变量(源名); 整 源槽 = -1; 若 (源栈 >= 0) { 遍 (整 _m = 变量总数() - 1; _m >= 解析基; _m--) 若 (变量表[_m].栈偏移 == 源栈 && 变量码生成可见(_m)) { 源槽 = _m; 断; } } 否 { 遍 (整 _g = 解析基 - 1; _g >= 0; _g--) 若 (!比较字符串(变量表[_g].名, 源名) && 变量表[_g].是否静态标) { 源槽 = _g; 断; } } /* 全局/静态 回退 (同 计得 L3176 全局回退) — 原 只查 函数内可见变量 → 文件级 静态/全局 构值 (g8) 被当"未定义" 误报 A9002 (en 链 regress_static_struct_assign) */ 若 (源槽 < 0) { 格式化到串(错缓冲, "类型错配: 结构体值变量 '%s' 的初始化式 '%s' 未定义 (既非已声明变量/全局, 也非本文件函数 — 函数名不能初始化构值)", 顺挂, 源名); 发错误("A9002", 错缓冲); } 否 若 (变量表[源槽].指深 != 0 || 变量表[源槽].数组尺寸 != 0 || 变量表[源槽].型序标 != 变量表[槽二].型序标) { 格式化到串(错缓冲, "类型错配: 结构体值变量 '%s' 不能用另一类型的值初始化 (源 '%s' 类型不同/为指针/数组 — 需同型构值)", 顺挂, 源名); 发错误("A9002", 错缓冲); } } }

/* walk 一 数组-访问/成员 链 (例-14/15 节点) down 到 该 基 名 节点.
   遍 m[i][j] 该 外层 节点's 子0 是 一 末属 例-14 节点, 非 a 名 节点 —
   (字符*)(节名表 + 子0[n]) 将 读取 垃圾. 返回 该 基 节点 索引. */
静 整 链根变量(整 节) { /* C132 (2026-09-19 第 126 站): 沿 下标/成员/箭头/解引用/取址 链 向下 找 **变量节点**; 找不到 返 -1.
   供 表达式基 的 属性 推导 —— `原庚` 只跳过 下标/成员, 在 解引用/三元/调用 基 上 会 停在 非变量节点
   ⟹ `变节` 取到 垃圾名 ⟹ 查变量 = -1 ⟹ 写路径 落 指针参数分支 (第 126 站 预分析 §5.1). */
    整 游 = 节; 整 深 = 0;
    循环 (游 >= 0 && 深 < 16) {
        若 (节型别[游] == 节点_变量) 返 游;
        若 (节型别[游] == 节点_二元 || 节型别[游] == 节点_三元) { /* C134 (2026-09-19 第 127 站): **表达式基 (三元 / 逗号 / 加减)** —— 该 表达式 的 值 (指针) 由 操作数 之一 决定: 三元 = 真分支 (子1), 二元 = 左 (子0, 加减) 否则 右 (子1, 逗号). 原 链 到此 即 返 -1 ⟹ 宽度 落 默认 4 ⟹ `(1 ? gp : hp)[1]` / `(0, gp)[1]` / `(gp + 0)[1]` 的 元素 缩放 错 (矩阵 W3/W5/W6/R2/R3/R4). */
            若 (节型别[游] == 节点_三元) 返 链根变量(子1[游]);
            整 甲 = 链根变量(子0[游]);
            若 (甲 >= 0) 返 甲;
            返 链根变量(子1[游]);
        }
        若 (节型别[游] == 节点_下标 || 节型别[游] == 节点_成员 || 节型别[游] == 节点_箭头 || 节型别[游] == 节点_解引用 || 节型别[游] == 节点_取址) { 游 = 子0[游]; 深++; 续; }
        返 -1;
    }
    返 -1;
}
静 整 链含成员(整 节) { /* R253 (2026-09-22) 虾米: 沿 子0 链 向下, 是否 经过 **成员/箭头** 节点 —— 供 「解引用基 元素宽」 的 `堆次(链根名)` 分流. `堆次(链根名)` 描述 链根变量 **自身** 的 指针语义 (链根 T** 时 恰是「(*X)[i] 的元素」); 链 上 隔 成员/箭头 字段时 该 语义 不适用 (实测 `(*pF->pp)[1]` 步长 8 应 4), 此时 元素 尺寸 由 `表达式内重` 给出. */
    整 游 = 节; 整 深 = 0;
    循环 (游 >= 0 && 深 < 16) { 整 型 = 节型别[游]; 若 (型 == 节点_成员 || 型 == 节点_箭头) 返 1; 若 (型 == 节点_下标 || 型 == 节点_解引用 || 型 == 节点_取址) { 游 = 子0[游]; 深++; 续; } 返 0; }
    返 0;
}
静 整 变量基登(常 字 *数); /* R248 (2026-09-22): 前向声明 —— `表达式基浮` 需 按 A22 基类码 判 变量链 浮性 (定义 在 L6165 之后) */
静 整 序七(整 数); /* R248 (2026-09-22): 前向声明 —— `表达式基浮` 需 按 成员链 求 构序 (序七 定义 在 L5067, 晚于 本处) */
静 整 表达式基浮(整 节) { /* C142 (2026-09-19 第 132 站): **「表达式基」指向元素 的 浮性** —— 统一 覆盖 变量链 与 调用链.
    · 变量链 (下标/成员/箭头/解引用/取址/三元/二元 穿透后 落到 变量) ⟹ 链根 的 一级 指浮 (`变量指浮`);
    · 调用, 或 含调用的 二元 ⟹ `查函数浮指返` (第 129 站 C139b 的「返回 指针 指向 双精度」登记位).
    供 下标路径 的 C134 分支 使用 —— 原 判据 只写 `根伍 >= 0 && 变量指浮(根伍)` ⟹ 基 是 调用/含调用 二元 时 恒 0
    ⟹ 走 整数读 (矩阵 r130a 的 F5: `(getp() + 1)[0]` 得 0.00). 这是 第 131 站 A5 的**同族第二个消费点**
    (那里 修 的 是 二元加法 的 缩放白名单; 这里 修 的 是 下标 的 浮性判据 —— 同一「链根不认调用」的两个出口). */
    若 (节 < 0) 返 0;
    整 根 = 链根变量(节);
    若 (根 >= 0) {
        整 游浮 = 节; 整 经标Z = 0; /* R248 (2026-09-22) 虾米: **成员基** —— 链 上 遇 成员/箭头 节点 时, 「基 指向 元素」的 浮性 由 **字段 元数据**
           (`终捌指` = 数据指针字段 的 指向元素 是否 双精度) 判; 原 一律 取 **链根 变量** 的 `变量指浮`,
           而 成员基 (`bx.pp`) 的 链根 是 **结构体 值 变量** `bx` ⟹ 恒 0 ⟹ 成员 指针 字段 的 元素 浮性 全丢
           (实测 `(*bx.pp)[1]` 的 C132 浮伍=0 / `bx.pp[0][1]` 的 嵌套 元浮一=0).
           只 在 链 上 **确有** 成员 节点 时 改道 ⟹ 纯 变量链/调用链 逐字 等价 (零回归). */
        循环 (游浮 >= 0 && 游浮 != 根) {
            整 型浮 = 节型别[游浮];
            若 (型浮 == 节点_成员 || 型浮 == 节点_箭头) { 整 基浮二 = 序七(子0[游浮]); 若 (基浮二 >= 0) { 若 (终捌指(基浮二, (字*)(节名表 + 游浮))) 返 1; 若 (经标Z && 副优查(基浮二, (字*)(节名表 + 游浮))) 返 1; 返 0; } 返 0; } /* R5 刀1 (2026-09-24 启元 · 第 296 站): **成员 是 数组 时 元素 浮性 丢失** —— 原 无条件 `返 终捌指(...)`, 而 终捌指 对 非指针 字段 (原进==0) **直接 返 0** (它 的 语义 是「数据指针字段 的 指向元素 是否 双精度」) ⟹ `结构体{double a[1];} s0; s0.a[0]` 的 表达式基浮 恒 0 ⟹ 外层 走 整数 提升 `cvtsi2sd %eax,%xmm0` 覆盖 浮点 路径 已加载 的 xmm0 ⟹ 打印 出 `&s0` 的 地址 值 (实测 4370352.0 = 0x42AFB0). `经标Z` 恰 可 判别: 链 自外向内 遍历, 遇 下标/解引用 即 置 1 (下一行), 故 走到 成员节点 时 经标Z==1 ⟺ 该成员 正是 被 索引 的 数组基. 插桩 铁证 [R5] 构序=0 字段=a 副优=1 原进=0 现捌=8 域行数=8 经标Z=1. */
            若 (型浮 == 节点_下标 || 型浮 == 节点_解引用 || 型浮 == 节点_取址) { 若 (型浮 == 节点_下标 || 型浮 == 节点_解引用) 经标Z = 1; 游浮 = 子0[游浮]; 续; }
            断;
        }
        返 (变量基登((字*)(节名表 + 根)) - 1 == 4 || 变量指浮((字*)(节名表 + 根)) || (经标Z && 变量是否浮((字*)(节名表 + 根)))) ? 1 : 0; /* R254 刀5 (2026-09-23) 虾米: **浮点 数组** —— 原 判据 只认 链根 **变量名** 的 基类码/指浮, 数组名 (`static double dbuf[4]`) 不算 ⟹ `表达式基浮(dbuf[1])` 恒 0 ⟹ 刀1 的 8 字节整数 分支 **误命中** ⟹ `码生成(dbuf[1])` 读 double + `cvtsi2sd` 把 位模式 当 整数 (实测 `(双精度)dbuf[1]` = 4427744). `经标Z` = 链上 经过 **下标/解引用** (确实在 取元素) ⟹ 此时 链根 变量 本身 是 浮点 (是否浮标) ⟹ 元素 是 浮点; **标量 变量** 不 经标 ⟹ 逐字 不变 (零回归). */ /* R248: 变量链 判据 = A22 基类码 4 (双精度) **或** 指浮 登记位 —— 原 只 用 变量指浮,
           而 文件级 static 指针 (如 `静 单精度 **全单二`) 的 指浮 位 未登记 ⟹ 判 0 (实测 `[R248i] 全单二 基浮=0` 而 基类码 恰为 4). 与 C135 的 链根判据 同源, 此处 收口. */
    }
    整 内 = 节;
    若 (节型别[节] == 节点_二元) { 若 (子0[节] >= 0 && 节型别[子0[节]] == 节点_调用) 内 = 子0[节]; 否 若 (子1[节] >= 0 && 节型别[子1[节]] == 节点_调用) 内 = 子1[节]; 否 返 0; }
    若 (节型别[内] != 节点_调用) 返 0;
    整 末乙 = 节末子(内); 整 函乙 = (末乙 >= 0) ? 取子(内, 末乙) : -1;
    若 (函乙 >= 0 && 节型别[函乙] == 节点_变量 && 查函数浮指返((字*)(节名表 + 函乙))) 返 1;
    返 0;
}
静 整 原庚(整 数) {
    整 发字节 = 数;
    循环 (发字节 >= 0 && (节型别[发字节] == 节点_下标 || 节型别[发字节] == 节点_成员)) 发字节 = 子0[发字节];
    返 发字节;
}
/* 做 此 表达式 子树 产出 一 无符号 值? (修复 2026-08-05) */
静 整 表达式是否无符号(整 数) {
    若 (数 < 0) 返 0;
    若 (节型别[数] == 节点_窄转型 && !cast32[数] && !节长标[数] && !号汇一[数] && !首甲二[数]) 返 0; /* 例27 纯窄转型结果 ≤16 位 → C 整数提升为 有符号 int (修复 2026-09-03 p218: -(uint16_t)1 被当无符号 0-1 回绕 0xFFFFFFFF 比较假; 同 0f88d5b 变量小无符号; 但外层 (uint32_t)/(uint64_t)/(int64_t) cast 重标(cast32/节长标/号汇一/首甲二)时 不提升 — 交给外层语义) */
    若 (节型别[数] == 节点_变量 && 变量是否小无符号((字*)(节名表 + 数))) 返 0; /* C 整数提升: uint8/uint16 变量提升为 有符号 int (修复 2026-09-02, 优先于 节无符号) */
    若 (首甲二[数]) 返 0; /* 修复 2026-08-30 生成器 s168: 有符号 64 转型 ((int64_t)x) 类型 有符号 — 值转换保留源 节无符号 但类型判定按 转型 后 (除法 120/-1 应 -120) */
    若 (号汇一[数]) 返 1; /* 修复 2026-08-31 生成器 s11: 无符号 64 转型 ((uint64_t)x) 结果 无符号 (比较/除法无符号) */
    若 (节无符号[数]) 返 1; /* 修复 2026-08-30 生成器 s61: 转型/类型定义 设的 节无符号 标记优先 (uint32_t)X 原只字面量 节型表==0 看 节无符号 → 比较仍按有符号 小于置位 分支翻转) */
    若 (节型别[数] == 节点_变量) { 若 (暂合[数]) 返 节无符号[数]; 若 (变量是否小无符号((字*)(节名表 + 数))) 返 0; 返 变量是否无符号((字*)(节名表 + 数)); } /* 无符号 变量; 小无符号(uint8/16) 提升有符号 int (C 整数提升, 修复 2026-09-02); A71-续6 (2026-09-15): **显式 转型 过的 变量节点 以 标记 为准** — 转型 不换节点 只打 暂合/节无符号, 原 一律 查 变量声明 ⟹ (整数)<无符号 变量> 仍判 无符号 → 比较 走 无符号 小于置位 → `整数 a=-1; 无符号 b=1; a < (整数)b` 得 假 (应 真); 与 上方 首甲二/号汇一/节无符号 三条 转型标记 优先 同 风格 */
    若 (节型别[数] == 节点_常数) 返 节无符号[数];                       /* 0xFFFFFFFFu 字面量 */
    若 (节型别[数] == 节点_二元) { /* 二进制 算子: 结果类型按 C 通常算术转换 (修复 2026-08-06 M1 传播: (u-1)>0 判 无符号) */
        整 丙 = 节值表[数];
        若 (丙 == 逗号) 返 表达式是否无符号(子1[数]); /* 逗号结果类型 = 右操作数 (修复 2026-09-03 p218: 原 OR 两边 → 左 uint32 使逗号误判无符号 → (uint, 比较1) >= -1 误走无符号比较 判假) */
        若 (丙 == 比小 || 丙 == 外三 || 丙 == 比等 || 丙 == 名庚 || 丙 == 隔系 || 丙 == 宽排) 返 0; /* 比较 -> 整数 0/1 */
        若 (丙 == 逻辑与 || 丙 == 逻辑或) 返 0; /* && || -> 整数 */
        若 (丙 == 帧寅 || 丙 == 号庚) 返 表达式是否无符号(子0[数]); /* 移位: 结果类型=左操作数 */
        /* 修复 2026-09-03 p291: + - * / % & | ^ 结果无符号性按 C 通常算术转换层级 — 原"任一无符号→无符号"错:
           (int64 | uint32) C 中 uint32 转 int64(能全表示) → 结果 有符号64; 探针 r1/r2/r4 (65535|..)<=-1 应假 */
        { 整 长L = (子0[数] >= 0) ? 表达式是否长(子0[数]) : 0; 整 长R = (子1[数] >= 0) ? 表达式是否长(子1[数]) : 0;
          整 无L = (子0[数] >= 0) ? 表达式是否无符号(子0[数]) : 0; 整 无R = (子1[数] >= 0) ? 表达式是否无符号(子1[数]) : 0;
          若 ((无L && 长L) || (无R && 长R)) 返 1; /* 任一 无符号64 (号汇一/UL大值) 支配 → 无符号 */
          若 ((!长L && !长R) && (无L || 无R)) 返 1; /* 纯 32 位域: 任一无符号 → 无符号32 */
          返 0; } /* 有符号64 + 小无符号(≤32) → 小无符号 转 有符号64 → 有符号 (C 转换规则) */
    }
    若 (节型别[数] == 节点_增减 || 节型别[数] == 节点_前置增减) 返 表达式是否无符号(子0[数]); /* ++/-- 前缀后缀: 结果类型=操作数类型 — 修复 2026-08-31 生成器 s11: (--(*l_20)) 三十二位无符号 前自减被当 有符号 → 三十二位整数<三十二位无符号 比较按有符号 小于置位 → g_577|= 条件分支翻转 → 除零崩 */
    若 (节型别[数] == 节点_下标) 返 表达式是否无符号(子0[数]); /* 数组[i]: 结果类型=数组元素类型 */
    若 (节型别[数] == 节点_解引用) 返 表达式是否无符号(子0[数]); /* *p: 元素类型 — 修复 2026-08-30 生成器 s9/s52/s61: 六十四位无符号 双解引用被当有符号 → 大于置位 替 高于置位 → 分支翻转 (**g_2263 > (...)^1 恒真路径未执行) */
    若 (节型别[数] == 节点_赋值) 返 表达式是否无符号(子0[数]); /* 赋值/复合赋值 表达式: 值类型 = LHS 类型 (修复 2026-09-03 p235: ((*g_537)=l_1293 uint32)>1 原默认0 有符号 → -1>1 假, 应无符号真; LHS 小无符号经 变量小无符号 规则已提升有符号 int 正确) */
    返 0;
}

/* 做 此 表达式 子树 产出 a 64-位 (长整 长整) 值?
   静态 类型 检查: 做 非 rely 于 该 码生成器-时间 节长标[] 数组, 故 a
   父 二进制 算子 可 见 a 64-位 子 (e.g. (长整 长整)x << 32) 那
   hasn't 曾是 码生成器'd yet (修复 2026-08-22 #31: ((长整 长整)度附 << 32) + 链劣
   已编译 该 外层 + 作为 32-位 -> 高 32 符弊 lost -> 版本库 --date=相对
   现在=2009 "在 该 future"). */
静 整 表达式是否长(整 数) {
    若 (数 < 0) 返 0;
    若 (cast32[数]) 返 0; /* 修复 2026-08-31 生成器 s61: 32 位类型 转型 结果非 64 位 - 阻断递归到子表达式 64 位字面量 */
    若 (节点长性(数, -1)) 返 1; /* 转型 (长整 长整)x / 字面量 / 目辰-marked */
    若 (节型别[数] == 节点_变量) { 字 *副寅 = (字*)(节名表 + 数); 遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 副寅) && 变量表[计].数组尺寸 == 0 && 变量码生成可见(计)) 返 变量表[计].是否长标; 返 0; } /* 长整 长整 变量 — 修复 2026-08-30 生成器 s61: 变量是否长 返回 栈偏移 (局部负偏移) → 表达式是否长 返回负判假 → 局部 六十四位整数 比较误走 32 位路径 */
    若 (节型别[数] == 节点_常数) 返 节长标[数]; /* 字面量节点: 长标已在 prim 常数分支设置 (2026-09-03 账② 修复: 原读 词长表[节点索引] 数组错位) */
    若 (节型别[数] == 节点_调用) { /* 函数 调用 返回 长整 长整 (修复 #27) */
            遍 (整 外劣 = 0; 外劣 < 20; 外劣++) {
                整 堆散 = -1; 择 (外劣) { 例 0: 堆散 = 子0[数]; 断; 例 1: 堆散 = 子1[数]; 断; 例 2: 堆散 = 子2[数]; 断; 例 3: 堆散 = 子3[数]; 断; 例 4: 堆散 = 子4[数]; 断; 例 5: 堆散 = 子5[数]; 断; 例 6: 堆散 = 子6[数]; 断; 例 7: 堆散 = 子7[数]; 断; 例 8: 堆散 = 子8[数]; 断; 例 9: 堆散 = 子9[数]; 断; 例 10: 堆散 = 子10[数]; 断; 例 11: 堆散 = 子11[数]; 断; 例 12: 堆散 = 子12[数]; 断; 例 13: 堆散 = 子13[数]; 断; 例 14: 堆散 = 子14[数]; 断; 例 15: 堆散 = 子15[数]; 断; 例 16: 堆散 = 子16[数]; 断; 例 17: 堆散 = 子17[数]; 断; 例 18: 堆散 = 子18[数]; 断; 缺: 堆散 = 子19[数]; 断; }
            若 (堆散 >= 0 && 节型别[堆散] == 节点_变量) 返 查函数长返((字*)(节名表 + 堆散));
        }
        返 0;
    }
    若 (节型别[数] == 节点_二元) {
        整 丙 = 节值表[数];
        若 (丙 == 逗号) 返 表达式是否长(子1[数]); /* 逗号结果类型 = 右操作数 (修复 2026-09-03 p218, 镜像无符号侧) */
        若 (丙 == 比小 || 丙 == 外三 || 丙 == 比等 || 丙 == 名庚 || 丙 == 隔系 || 丙 == 宽排 || 丙 == 逻辑与 || 丙 == 逻辑或) 返 0;
        若 (是32位无(数)) 返 0; /* 第 168 站: 收口 */ /* 修复 2026-08-30 生成器 s61: (无符号)转型 32 位值 (节无符号=1, 节长标 清) — 原递归到 64 位字面量 (-6L) 判 邻辰 → & 传播 节长标 → 三十二位无符号<六十四位整数 比较误判无符号 */
        若 (丙 == 帧寅 || 丙 == 号庚) 返 表达式是否长(子0[数]); /* 移位: 结果 类型 = 左操作数 */
        返 表达式是否长(子0[数]) || 表达式是否长(子1[数]); /* + - * / % & | ^ */
    }
    若 (节型别[数] == 节点_下标) 返 表达式是否长(子0[数]); /* 数组[i]: 结果 = 元素 类型 */
    若 (节型别[数] == 节点_成员) { /* 成员 字段: 结果 = 字段 类型 (2026-09-04 虾米: 原漏 type15 → 8B 整成员算术一律按 32 位截断) */
        整 链根 = 子0[数];
        整 链构 = -1;
        若 (链根 >= 0 && 节型别[链根] == 节点_变量) 链构 = 变量型序((字*)(节名表 + 链根));
        若 (链构 >= 0) {
            字 *末字段 = (字*)(节名表 + 数);
            若 (字段尺寸直(链构, 末字段) == 8 && !终捌(链构, 末字段)) 返 1; /* 8B 整/指针 字段 */
        }
        返 0;
    }
    若 (节型别[数] == 节点_解引用) { 整 邻丙 = 子0[数]; 若 (邻丙 >= 0 && 节点指元素(邻丙) == 8) 返 1; /* *p: 元素 类型 — 修复 2026-08-30 生成器 s61: int64_t* 解引用原递归到指针 是否长标=0 → 64 位比较误走 32 位 (三十二位无符号<六十四位整数 g_143 分支翻转) */
        /* 修复 2026-09-02 p202: **X/***X 链按剩余层级判宽 (镜像 码生成 例12) — 原递归 表达式是否长(邻丙)
           继承中间指针 8B → 最外层 int32 解引用误判 64 位 → 比较误走 64 位有符号 (uint32除法结果 <= ****l_3165 int32 -1 判假, p202 WRONG) */
        若 (邻丙 >= 0 && 节型别[邻丙] == 节点_解引用) {
            整 深 = 1, 寻 = 邻丙;
            循环 (寻 >= 0 && 节型别[寻] == 节点_解引用) { 深++; 寻 = 子0[寻]; 若 (寻 >= 0 && (节型别[寻] == 节点_增减 || 节型别[寻] == 节点_前置增减)) 寻 = 子0[寻]; }
            若 (寻 >= 0 && 节型别[寻] == 节点_变量) {
                整 元 = 变量指深((字*)(节名表 + 寻));
                若 (元 > 深) 返 1; /* 解后仍是指针: 8 字节值 */
                若 (元 == 深) 返 (正己((字*)(节名表 + 寻)) == 8 ? 1 : 0); /* 解到基类型: 宽度 = 正己 */
                返 0;
            }
        }
        返 表达式是否长(邻丙); }
    若 (节型别[数] == 节点_赋值) 返 表达式是否长(子0[数]); /* 赋值/复合赋值: 值宽 = LHS 宽 (修复 2026-09-03 p235, 镜像无符号侧) */
    返 0;
}


/* helper: 访问 抽象语法树 节点 子 i (replaces (整数[]){...}[i] 复合 字面量) */
/* 生成 堆九 = 地址 的 a 成员 链 (o.a.b / p->x.y), 处理 `->` 由
   dereferencing 该 指针 于 那 点 (子1.下一->数值 加载 子1.下一's 指针
   值, 则 偏移 数值). *中酉 = 最终 字段 字节 尺寸; *构序出 = 该
   链's resulting 结构体 类型 (遍 further 字段 查找). 0 于 成功. */
静 空 码生成(整 数); /* 向前 声明: 内存地址 recurses 经 数组-访问 码生成器 (例-14 基) */
/* 类型-仅 链 resolver: 结构体 索引 的 该 值 于 节点 n (无 码生成器).
   Mirrors 内存地址's 结构体 resolution. -1 若 非 a 结构体 值.
   修复 2026-08-22 #41: &p->父[i].oid 的 内存地址 例-14 基是成员链
   (节型表[子0[n]]==15), 原用 变量型序(基名字) 把字段名 "父" 当变量查 → -1 →
   地址表达式静默丢弃 → oidcpy 目标=残留寄存器 → 根 提交 摘要 emit_path 崩. */
/* 第0刀 报警器 (2026-09-12 虾米): 静默兜底 计数 + 按需可观测 —— 「解析失败 被 兜底 吞掉」 每次 计数。   用途: 把「哪条路径漏登记/漏解析」从猜测变实测 (QCC_DBG_SILENT=1 逐次 stderr + 编译尾 汇总)。   刻意 不 硬报错: 现存 程序 已 依赖兜底 行为, 硬报错 会 误伤 —— 第0刀 只 装 报警器, 不 改判据。 */静 整 静默计数[8];静 字 静默名[8][64];静 空 静默计(整 静槽, 常 字 *静名) {    若 (静槽 < 0 || 静槽 > 7) 返;    若 (静默名[静槽][0] == 0) 复制字符串(静默名[静槽], 静名);    静默计数[静槽]++;    若 (取环境("QCC_DBG_SILENT")) 输出到文件(错误流, "[静默兜底] %s (第 %d 次)\n", 静默名[静槽], 静默计数[静槽]);}静 空 静默报告(空) {    若 (!取环境("QCC_DBG_SILENT")) 返; /* 默认 零输出: 不 影响 任何 现存 测试 的 stdout/stderr */    整 静总 = 0; 遍 (整 静扫 = 0; 静扫 < 8; 静扫++) 静总 += 静默计数[静扫];    若 (静总 <= 0) 返;    输出到文件(错误流, "[静默兜底 汇总] 本编译 共 %d 次\n", 静总);    遍 (整 静扫 = 0; 静扫 < 8; 静扫++) 若 (静默计数[静扫] > 0) 输出到文件(错误流, "    槽%d: %s x%d\n", 静扫, 静默名[静扫], 静默计数[静扫]);}
静 整 序七(整 数) {
    若 (数 < 0) 返 -1;
    若 (节转序[数] != 0) 返 节转序[数] - 1; /* A71-续 (2026-09-15): 转型 结果 的 目标 构序 — 优先于 变量声明类型 (((结构体 S*)o)->f: o 声明类型 可能 是 别 的); 打标 在 转型 解析 处 (后缀链() 之前) */
    若 (节型别[数] == 节点_变量) 返 变量型序((字*)(节名表 + 数));
    若 (节型别[数] == 节点_取址) 返 序七(子0[数]); /* A71-续 (2026-09-15): (&s)->f / (&s).f — 取址 不 改 类型 (指针 目标 = 操作数 类型); 原 缺 此 分支 ⟹ 取址基 成员 访问 全 漏检 */
    若 (节型别[数] == 节点_解引用) 返 序七(子0[数]);
    若 (节型别[数] == 节点_赋值) 返 序七(子0[数]); /* A71-续2 (2026-09-15): 赋值 表达式 的 值 = LHS 类型 ((s = t).字段 — 与 表达式是否无符号/是否长 同 判据, 见 L4167/L4223) */
    若 (节型别[数] == 节点_调用) { 整 呼返 = 调用构返(数); 若 (呼返 >= 0) 返 呼返; 返 调用构指(数); } /* A71-续2 (2026-09-15): 调用 作 成员基 — 按值返回构体 (f().字段, H1i 已 物化 __mret 帧临时) 用 调用构返; 返回指针 (f()->字段 / (*f()).字段) 退 调用构指 */
    若 (节型别[数] == 节点_三元 && 节值表[数] > 0) 返 节值表[数] - 1; /* H1q (2026-09-11): 构值 三目 作 链基 (k?甲:乙).字段 — 类型 取 解析期 已 标 结构体序 */
    若 (节型别[数] == 节点_箭头 || 节型别[数] == 节点_成员) {
        整 减法 = 序七(子0[数]);
        若 (减法 < 0) 返 -1;
        返 字段类型序直(减法, (字*)(节名表 + 数));
    }
    若 (节型别[数] == 节点_下标) {
        整 发字节 = 子0[数];
        若 (发字节 >= 0 && (节型别[发字节] == 节点_成员 || 节型别[发字节] == 节点_箭头 || 节型别[发字节] == 节点_解引用 || 节型别[发字节] == 节点_下标))
            返 序七(发字节);      /* 成员链基 (p->父[i]): 元素 结构体 = 基字段的 结构体 */
        若 (发字节 >= 0) 返 变量型序((字*)(节名表 + 发字节)); /* 普通数组/指针变量基 */
    }
    返 -1;
}
/* 第三阶段-中间表示 例十五: 内存地址 前置 中间表示 前向声明 (骨架区 9139 定义, 相同值重复定义安全) */
静 空 中发(整 算子, 整 甲, 整 发字节, 整 字符);
静 空 中刷(空);
#ifndef 缺捌
#define 缺捌 18
#define 副失 23
#define 缓劣 28
#define 尾浅 27
#endif
#ifndef 列失
#define 列失 58   /* 静态 32 位 写: 移动 [指令指针+位移], 首子 (与 阶段3 定义同值) */
#define 容重 41   /* 帧 32 位 写: 移动 [rbp+位移], 堆九 (与 阶段3 定义同值) */
#endif
静 空 可空标存名(常 字 *名, 整 值) { /* H1e (2026-09-11): 分离 tag 槽 写 tag (0=有值 / 1=空) — 帧槽 用 容重 (rbp 相对), 静态槽 用 列失 (槽号 相对 .数据); H1g: 名 经 可空标名 (函数级静态 tag 带 函数序 前缀) */
    字 标名戌[96]; 可空标名(名, 标名戌);
    整 标偏 = 查变量(标名戌);
    若 (标偏 < 0) 返;
    移即(0, 值);
    若 (变量是否静态(标名戌)) { 中发(列失, 标偏, 0, 0); 中刷(); }
    否 { 中发(容重, 标偏 - 当前帧大小, 0, 0); 中刷(); }
}
静 整 内存地址(整 数, 整 *中酉, 整 *构序出) { 
    若 (节型别[数] == 节点_二元 && 节值表[数] == 逗号 && 子1[数] >= 0) { /* R535-e5: 逗号 作 地址源 = 右操作数 */
        若 (子0[数] >= 0) { 码生成丢弃结果 = 1; 码生成(子0[数]); 码生成丢弃结果 = 0; }
        返 内存地址(子1[数], 中酉, 构序出);
    }
    若 (节型别[数] == 节点_作用域块 || 节型别[数] == 节点_返节) { /* 加(+) / 减(-): 指针算术表达式回收操作数元素大小 (t49c4 修复: (recs+nrec)-1 外层 -1 应缩放) */
        整 末 = 节点指元素(子0[数]);
        若 (末 > 0) 返 末;
        返 节点指元素(子1[数]);
    }
    若 (节型别[数] == 节点_调用) { /* H1i (2026-09-11): 构值 返回调用 作 链基 (f().字段 / f().buf[i]) — 物化 帧 临时 (解析期 由 成员访问 处 构返临 分配, 名 __mret_<调用节点序>), 调用 直写 临时, 堆九 = &临时 */
        整 返序九 = 调用构返(数);
        若 (返序九 < 0) { /* C111 (2026-09-18): 返回 **指针** 的 调用 作 链基 (f()->字段) — 求值 得 指针 值 (堆九), 物化 8 字节 帧 临时 (解析期 由 成员访问 处 构指临 分配, 名 __cret_<节点序>), 堆九 = &临时; 外层 计排 再 解引用 取 该 指针 值. 原 只 处理 按值 返回构体 ⟹ 返回指针 落 返 -1 ⟹ 外层 成员访问 整段 不发射 (静默 0 + 运行错值, c294 m3). */
            整 指序九 = 调用构指(数);
            若 (指序九 < 0) 返 -1;
            字 临指九[64]; 格式化到串(临指九, "__cret_%d", 数);
            整 偏指九 = 查变量(临指九);
            若 (偏指九 < 0) 返 -1;
            码生成(数);
            反附(变量基(临指九, 偏指九) - 当前帧大小, 0);
            取帧址(0, 变量基(临指九, 偏指九) - 当前帧大小);
            *中酉 = 8;
            *构序出 = 指序九;
            返 0;
        }
        若 (返序九 < 0) 返 -1;
        字 临名九[64]; 格式化到串(临名九, "__mret_%d", 数);
        整 偏九 = 查变量(临名九);
        若 (偏九 < 0) 返 -1;
        整 尺九 = 类型表[返序九].尺寸;
        若 (尺九 > 8) { /* sret: 被调 直写 临时 缓冲 */
            码生成结构返偏移 = 变量基(临名九, 偏九) - 当前帧大小; 码生成结构返静态 = 0;
            码生成(数);
            码生成结构返偏移 = 0;
            取帧址(0, 变量基(临名九, 偏九) - 当前帧大小);
        } 否 { /* 小 构值 (<=8B): rax 返回 → 存 临时 (反附 = 64 位 存, 移帧寄存器 只 存 32 位 → 8B 构体 丢 高半) */
            码生成(数);
            反附(变量基(临名九, 偏九) - 当前帧大小, 0);
            取帧址(0, 变量基(临名九, 偏九) - 当前帧大小);
        }
        *中酉 = 尺九;
        *构序出 = 返序九;
        返 0;
    }
    若 (节型别[数] == 节点_三元 && 节值表[数] > 0) { /* H1q (2026-09-11): 构值 三目 作 链基 ((k?甲:乙).字段 / [i]) — 解析期 已 分配 帧 临时 __tern_<节点序>; 求 三目 (直写 临时), 堆九 = &临时 */
        整 构序三 = 节值表[数] - 1;
        字 临名三[64]; 格式化到串(临名三, "__tern_%d", 数);
        整 偏三 = 查变量(临名三);
        若 (偏三 < 0) 返 -1;
        整 尺三 = 类型表[构序三].尺寸;
        *中酉 = 尺三; *构序出 = 构序三;
        若 (尺三 > 8) {
            码生成结构返偏移 = 变量基(临名三, 偏三) - 当前帧大小; 码生成结构返静态 = 0;
            码生成(数);
            码生成结构返偏移 = 0;
            取帧址(0, 变量基(临名三, 偏三) - 当前帧大小);
        } 否 {
            码生成(数); /* 小 构值: 值 已 在 堆九 */
            反附(变量基(临名三, 偏三) - 当前帧大小, 0);
            取帧址(0, 变量基(临名三, 偏三) - 当前帧大小);
        }
        返 0;
    }
    若 (节型别[数] == 节点_变量) { /* 根 标识符 */
        字 *变节 = (字*)(节名表 + 数);
        整 偏移 = 查变量(变节);
        若 (偏移 < 0 && !(链接模式 && 变量是否静态(变节))) 返 -1; /* 修复 2026-08-18: 外部 全局 (偏移<0 负槽) 允许 — 目标文件 符号重定位 (变量是否静态=1); 原拒绝对外引用 → 嵌套链 the_repository->hash_algo->null_oid 根节点失败 → 返回 表达式静默丢弃 → null_oid() 返垃圾 → 版本库 初始化 创建符号引用 崩 (简单箭头 例-15 早已允许, 内存地址 缺) */
        *中酉 = 4;
        *构序出 = 变量型序(变节);
        若 (变量是否静态(变节)) { 中发(缺捌, 偏移, 1, 0); 中刷(); } /* 第三阶段-中间表示 例十五: 内存地址 根 静态地址 */
        否 若 (素系(变节)) { 中发(中取帧64, 0, 偏移 - 当前帧大小, 0); 中刷(); } /* H1f (2026-09-11): 大结构体 值 形参 (素系) 槽 存 调用方 拷贝 指针 → 堆九 = [槽] = &结构体; 原 走 下面 指元素>0 分支 → 堆九 = &槽 (槽 地址 当 结构体本体) → 嵌套成员 链 (值.内层.b) 读 垃圾 (预存缺陷, 一级 成员 走 例_成员 的 素系 分支 正常, 只 链式 经 内存地址 时 错) */
        否 若 (变量指元素(变节) > 0) { 中发(副失, 0, 偏移 - 当前帧大小, 0); 中刷(); } /* 第三阶段-中间表示 例十五: 内存地址 根 指针变量 */
        否 { 中发(副失, 0, 变量基(变节, 偏移) - 当前帧大小, 0); 中刷(); } /* 第三阶段-中间表示 例十五: 内存地址 根 局部 */
        返 0;
    }
    若 (节型别[数] == 节点_下标) { /* 数组[i]: 堆九 = &数组[i]; 元素 结构体 类型 自 该 数组 变量 (修复 2026-08-03: 嵌套 成员 链 带 一 数组 根, e.g. 项[i].p.x, 先前 已返回 -1 → 存储/加载 静默 已丢 → 栈 损坏) */
        /* 修复 2026-08-22 #41: 成员链基 (p->父[i]) 的元素 结构体 类型用 序七 解析
           (原 变量型序(基名字) 把字段名当变量 → -1 → 地址表达式静默丢弃) */
        整 构序 = 序七(数);
        若 (构序 < 0) 返 -1;
        整 免解旧 = 码生成免解引用; 码生成免解引用 = 1; 码生成(数); 码生成免解引用 = 免解旧; /* A2-prereq (2026-09-12): 原 末尾 硬置 0 丢弃 调用者(例15 嵌套链) 的 免解引用 语义 → 上层 误判「要值」多发射 解引用 → 表[0].字段.名[0] 基址 被读成 *(元素+偏移) → 运行期 0xC0000005; 保存/恢复 修 */
        *中酉 = 类型表[构序].尺寸;
        *构序出 = 构序;
        返 0;
    }
    若 (节型别[数] == 节点_解引用 || 节型别[数] == 节点_箭头) { /* *指针 作链基 (e.g. (*e)->下一): 委托 + 一次解引用取操作数值 — 外层 计排 再解引用得到 *e (修复 2026-08-18: 原只委托不解引用 → 少一层 → &(*e)->下一 编成 &e 的值 → hashmap 链遍历死循环 → 版本库 初始化 读取 配置 挂起) */
        若 (内存地址(子0[数], 中酉, 构序出) < 0) 返 -1;
        /* 修复 2026-08-22 t46: *指针 作 结构体 值 (目标 = *指针 / p->dm = *指针) — 解引用 后 域尺寸 应为指向 结构体 的大小
           (原保持基变量的默认 4 → 赋值 当肆一 检查 前从==域四 失败 → 落标量存储只存 4 字节 → 见->objectname=*oid 只存 哈希 前 4 字节 → 版本库 分支 "缺失 对象") */
        若 (*构序出 >= 0 && 类型表[*构序出].尺寸 > 8 && *中酉 == 4) *中酉 = 类型表[*构序出].尺寸;
        中发(缓劣, 0, 0, 0); 中刷(); /* 第三阶段-中间表示 例十五: 内存地址 *指针 解引用 — 堆九 = [堆九] = 操作数值 */
        返 0;
    }
    若 (节型别[数] == 节点_赋值) { /* A71-续3 (2026-09-15): 赋值表达式 作 左值基 ((s = t).字段) — C 语义: (s = t) 是 「修改后 s」 的 左值 ⟹ 先 发射 赋值 副作用, 再 取 LHS 的 地址. 原 无 此 分支 → 落 兜底 -1 → 上层 回退 标量读 (值 读 垃圾, 且 赋值 副作用 从未 发射: 实测 `int x = (s = t).a;` 得 x=90 (= t.b 值) 且 s.a 仍 0) */
        码生成(数);
        返 内存地址(子0[数], 中酉, 构序出);
    }
    若 (节型别[数] == 节点_成员) {
        字 *函 = (字*)(节名表 + 数);
        整 计排 = (节型别[数] == 节点_成员 && 节值表[数] == 1);
        整 减构序 = -1, 符四 = 4;
        若 (内存地址(子0[数], &符四, &减构序) < 0) 返 -1;
        { 整 转序基 = (节转序[子0[数]] != 0) ? 序七(子0[数]) : -1; 若 (转序基 >= 0) 减构序 = 转序基; } /* A2004 (2026-09-16): 基节点 是 **转型 结果** (节转序 非 0) 时, 字段查找 必须 用 转型目标 构序。原 一律 用 递归给出 的 「基 自身 声明类型」⟹ ((结构体 标签*)指针变量)->字段 的 字段序 查 错 类型 ⟹ 静默计(2) 返 -1 ⟹ 地址表达式 被丢弃 ⟹ 读 落 未初始化 / 写 丢失 (git builtin/merge.c 同族) */
        若 (减构序 < 0) { 静默计(1, "内存地址.成员.基类型序=-1"); 返 -1; }
        若 (计排) { 中发(缓劣, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十五: 内存地址 箭头解引用 — 堆九 = [堆九] (该 结构体 指针) */
        整 域字段 = 字段序(减构序, 函); /* A26-② (2026-09-11): 改 按 **构序** 查 字段 —— 匿名 聚合 类型 名 为 空串, 三个 按名 访问器 内部 查类型("") 会 命中 错 类型 → 偏移/尺寸/类型 全 错 (嵌套链 写 失效 根因) */
        若 (域字段 < 0) { 静默计(2, "内存地址.成员.字段缺失"); 返 -1; }
        整 域偏移 = 类型表[减构序].字段[域字段].正聚;
        若 (域偏移 != 0) { 中发(尾浅, 域偏移, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十五: 内存地址 字段偏移 */
        整回 = 减构序; /* 最终字段所在结构体 (修复 2026-08-18: 指针字段作数组基判定需要 containing 结构体) */
        *中酉 = 类型表[减构序].字段[域字段].现捌;
        若 (类型表[减构序].字段[域字段].原进 && *中酉 < 8) *中酉 = 8; /* 镜像 字段尺寸 的 指针字段 宽化 */
        *构序出 = 类型表[减构序].字段[域字段].毛利;
        若 (*构序出 < 0 && 类型表[减构序].字段[域字段].间次一 > 0) *构序出 = 减构序; /* 位-字段: report 该 CONTAINING 结构体 故 callers 可 解压/存储 (修复 2026-08-05) */
        剩未(减构序, 函); /* 修复 2026-08-19: 原只设 长卯 不重置 中系/上薄[] — 陈旧全局污染数组缩放 (目录->内部.排除组[i] 的 16 被前置 码生成器 的 1/4/8 覆盖 → 组 垃圾指针 → 版本库 状态 match_pathname 崩); 剩未 设新鲜 中系=0/上薄[0]=行/上薄[1]=元素/长卯=元素 */
        返 0;
    }
    { 静默计(3, "内存地址.链未解析(兜底-1)"); 返 -1; }
}

