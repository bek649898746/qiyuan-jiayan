          整 变初二 = 建节(1); 复制内存((字*)(节名表 + 变初二), 内名, 32);
          整 目卯 = 建节(1); 复制内存((字*)(节名表 + 目卯), 数组数, 32);
          整 序标序 = 建节(14); 接子(序标序, 目卯); 接子(序标序, 变初二); /* 数组[__md_i] */
          整 间对 = 建节(2); 节值表[间对] = 比小; 接子(间对, 宽弊); 接子(间对, 序标序); /* 数组[j] < 数组[i] */
          整 值局部 = 建节(1); 复制内存((字*)(节名表 + 值局部), 标伍, 32);
          整 加法 = 建节(2); 节值表[加法] = 加; 接子(加法, 值局部); 接子(加法, 间对);
          整 赋节 = 建节(10); 接子(赋节, 值局部); 接子(赋节, 加法); 接子(块节乙, 赋节); }
        { /* __md_e += (数组[__md_j] == 数组[__md_i]); */
          整 双肆 = 建节(1); 复制内存((字*)(节名表 + 双肆), 跳名, 32);
          整 度附一 = 建节(1); 复制内存((字*)(节名表 + 度附一), 数组数, 32);
          整 隔进 = 建节(14); 接子(隔进, 度附一); 接子(隔进, 双肆);
          整 列合 = 建节(1); 复制内存((字*)(节名表 + 列合), 内名, 32);
          整 短复 = 建节(1); 复制内存((字*)(节名表 + 短复), 数组数, 32);
          整 域合 = 建节(14); 接子(域合, 短复); 接子(域合, 列合);
          整 初丁 = 建节(2); 节值表[初丁] = 比等; 接子(初丁, 隔进); 接子(初丁, 域合); /* 数组[j] == 数组[i] */
          整 符升一 = 建节(1); 复制内存((字*)(节名表 + 符升一), 符败, 32);
          整 加法 = 建节(2); 节值表[加法] = 加; 接子(加法, 符升一); 接子(加法, 初丁);
          整 赋节 = 建节(10); 接子(赋节, 符升一); 接子(赋节, 加法); 接子(块节乙, 赋节); }
        { 整 实辰 = 建节(1); 复制内存((字*)(节名表 + 实辰), 跳名, 32);
          整 加节 = 建节(2); 节值表[加节] = 加; 接子(加节, 实辰); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(加节, 壹节); }
          整 赋节 = 建节(10); 接子(赋节, 实辰); 接子(赋节, 加节); 接子(块节乙, 赋节); } /* __md_j++; */
        { 整 拷长 = 新标号(); 整 置小 = 建节(20); 节值表[置小] = 拷长 + 1; 接子(块节乙, 置小); 节值表[计浅] = 拷长 + 1; }
        接子(计浅, 块节乙);
        接子(块节序, 计浅);
        { /* 若 (更少 <= k && 更少+相等 > k) { m = 数组[i]; } */
          整 目劣 = 建节(1); 复制内存((字*)(节名表 + 目劣), 标伍, 32);
          整 变键 = 建节(1); 复制内存((字*)(节名表 + 变键), 键名, 32);
          整 串联 = 建节(2); 节值表[串联] = 隔系; 接子(串联, 目劣); 接子(串联, 变键); /* 更少 <= k */
          整 直浅 = 建节(1); 复制内存((字*)(节名表 + 直浅), 标伍, 32);
          整 双粗 = 建节(1); 复制内存((字*)(节名表 + 双粗), 符败, 32);
          整 加法 = 建节(2); 节值表[加法] = 加; 接子(加法, 直浅); 接子(加法, 双粗); /* 更少+相等 */
          整 变键二 = 建节(1); 复制内存((字*)(节名表 + 变键二), 键名, 32);
          整 邻厚 = 建节(2); 节值表[邻厚] = 外三; 接子(邻厚, 加法); 接子(邻厚, 变键二); /* 更少+相等 > k */
          整 帧吉 = 建节(2); 节值表[帧吉] = 逻辑与; 接子(帧吉, 串联); 接子(帧吉, 邻厚); /* && */
          整 若序 = 建节(8); 接子(若序, 帧吉);
          整 增节 = 建节(5);
          { 整 容贰 = 建节(1); 复制内存((字*)(节名表 + 容贰), 内名, 32);
            整 顺三一 = 建节(1); 复制内存((字*)(节名表 + 顺三一), 数组数, 32);
            整 正薄 = 建节(14); 接子(正薄, 顺三一); 接子(正薄, 容贰); /* 数组[__md_i] */
            整 变右 = 建节(1); 复制内存((字*)(节名表 + 变右), 余吉, 32);
            整 赋节 = 建节(10); 接子(赋节, 变右); 接子(赋节, 正薄); 接子(增节, 赋节); } /* m = 数组[i]; */
          接子(若序, 增节);
          接子(块节序, 若序); }
        { 整 中附一 = 建节(1); 复制内存((字*)(节名表 + 中附一), 内名, 32);
          整 加节 = 建节(2); 节值表[加节] = 加; 接子(加节, 中附一); { 整 壹节 = 建节(0); 节值表[壹节] = 1; 接子(加节, 壹节); }
          整 赋节 = 建节(10); 接子(赋节, 中附一); 接子(赋节, 加节); 接子(块节序, 赋节); } /* __md_i++; */
        { 整 拷长 = 新标号(); 整 置小 = 建节(20); 节值表[置小] = 拷长 + 1; 接子(块节序, 置小); 节值表[度寅] = 拷长 + 1; }
        接子(度寅, 块节序);
        接子(块, 度寅);
        糖后标(块, 0);
        返 块;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "判别")) { 判别解析(); 返 建节(5); } /* 判别语句 (函数内) */
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "依据")) { /* 接入 2026-08-28 开关 表达式 (有值, 蓝图 §二): 依据 r, x 对照 1: a, 2: b, 其他: c; → { __sw=x; __sr=(其他或0); 若(__sw==1){__sr=a;} 若(__sw==2){__sr=b;} r=__sr; } — 多路等值分发 (选择 指令试吞) */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 依据 */
        字 余吉[64]; 复制字符串(余吉, 词名表[词位]); 词位++; /* 结果变量 */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 值巳 = 赋值级(); /* 选择表达式 */
        /* R1-B 锤B (2026-09-04): 判别 载荷绑定 — 选择器须 `X.tag` 形 (基 变量 = 载荷读取源) */
        字 判基名[64]; 判基名[0] = 0;
        若 (值巳 >= 0 && 节型别[值巳] == 节点_成员 && 节值表[值巳] == 0 && !比较字符串((字*)(节名表 + 值巳), "tag")) {
            整 判子根 = 子0[值巳];
            若 (判子根 >= 0 && 节型别[判子根] == 节点_变量) 复制字符串(判基名, (字*)(节名表 + 判子根));
        }
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 长陆一 = -1; 字 标亥[64]; 标亥[0] = 0; /* 穷尽检查标记 (接入 2026-08-28 #141): 依据 r, x 穷尽 Shape 对照 ... — 例 覆盖判别所有变体 */
        整 判型序 = -1; /* 直寅/荷布 判别序 (载荷绑定查表) */
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "穷尽")) {
            糖目标放行(词位 + 1); /* D12R456 */
            词位++; 复制字符串(标亥, 词名表[词位]); 词位++; /* 判别类型名 */
            长陆一 = 深薄(标亥);
            遍 (整 判型找 = 0; 判型找 < 链平; 判型找++) 若 (判型序 < 0 && !比较字符串(直寅[判型找].名, 标亥)) 判型序 = 判型找; /* 直寅 序 = 荷布 序 */
            若 (词型表[词位] == 逗号) 词位++; /* , */
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "对照")) 词位++; /* 对照 */
        静 整 池丙 = 0; 字 内名[64]; 格式化到串(内名, "__sw_%d_", 池丙++);
        静 整 深陆 = 0; 字 外肆[64]; 格式化到串(外肆, "__sr_%d_", 深陆++);
        变量偏移(内名);
        若 (变量是否浮(余吉)) 变浮(外肆); 否 若 (长名(余吉)) 余乙(外肆); 否 变量偏移(外肆); /* R1-B 锤B: 结果变量是 双 → __sr 双 (原恒 int → 双 载荷匹配结果截断) */
        整 池对[64]; 整 帧分[64]; 整 左陆 = 0; 整 末子 = 0; 整 原失 = 0;
        整 链高[64]; 整 域退[64]; 整 正戌[64]; 整 值深[64]; 整 深弊[64]; 字 列一[64][64]; /* 2026-08-28 阶段一 #132 或模式 (短进|值二) + #133 守卫模式 (v 若 条件) + 阶段二 #144 区间模式 (范围 链劣 到 度附) + 阶段二 #138 引用模式 (引用 v) */
        整 判绑变[64]; 整 判绑数[64]; 字 判绑名[64][4][64]; /* R1-B 锤B: 变体-载荷 臂 (判绑变=变体序, 绑定名表) */
        遍 (整 判绑清 = 0; 判绑清 < 64; 判绑清++) { 判绑变[判绑清] = -1; 判绑数[判绑清] = 0; }
        循环 (1) {
            若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "其他")) { /* 缺省分支 (可选, 须在最后) */
                词位++; 若 (词型表[词位] == 冒号) 词位++; /* : */
                原失 = 赋值级(); 末子 = 1;
                若 (词型表[词位] == 分号) 词位++; /* ; */
                断;
            }
            若 (左陆 < 64) {
                整 短进 = -1; 整 值二 = -1; 整 直肆 = -1;
                整 池平 = 0; 字 左布[64]; 左布[0] = 0; /* 2026-08-28 阶段二 #138 引用模式: 对照 引用 v: 结果 → 臂内绑定 v */
                若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "_")) {
                    池平 = 2; /* #136 通配符: 匹配任何值, 不绑定 (深弊==2 → 恒真比较路径, 同引用模式) */
                    词位++;
                } 否 若 (判型序 >= 0 && 判基名[0] != 0 && 词型表[词位] == 词变量 && 词位 + 1 < 词容量 && 词型表[词位 + 1] == 左括) { /* R1-B 锤B: 判别 变体 载荷 臂 圆(半径): — 穷尽 类型化判别 + X.tag 选择器 + 变体名( 才走 */
                    /* 变体名 = 标亥_圆 常量序 (尾辰 0..N-1); 须在 荷布 登记 范围内 (类型化判别) */
                    字 判变常[160]; 格式化到串(判变常, "%s_%s", 标亥, 词名表[词位]);
                    整 判序数 = 全回(判变常);
                    若 (判序数 == 0x80000000 || 判序数 < 0 || 判序数 >= 荷布[判型序].变体数) { 输出到文件(错误流, "[ERR] 依据 变体模式: '%s' 不是 判别 %s 的载荷变体 (穷尽 需 类型化判别 的 变体名; 锤B #98)\n", 词名表[词位], 标亥); 退出(1); }
                    词位++; /* 变体名 */
                    词位++; /* ( */
                    整 判荷起点 = 荷布[判型序].载荷序;
                    整 判荷扫描 = 判荷起点;
                    循环 (判荷扫描 < 判载数 && 变载[判荷扫描].变体 != 判序数) 判荷扫描++; /* 本变体载荷项起点 */
                    判绑变[左陆] = 判序数;
                    池平 = 1; /* 第 173 站 (#157 真接入): 载荷臂 也是 **绑定臂** —— 与 引用模式 (L14229 `池平 = 1`) 同款. 原 未设 ⟹ 深弊 = 0 ⟹ 守卫 走「并入外层条件」路径, 在 **绑定之前** 求值 ⟹ 读到未绑定变量 (静默错值); 设 池平 = 1 后 走 L14317「绑定后守卫 → 内层 若」路径 ⟹ 语义正确. 这是 变体载荷臂 + 守卫 能工作的关键一刀. */
                    判绑数[左陆] = 0;
                    循环 (词型表[词位] == 词变量 && 判绑数[左陆] < 4) {
                        复制字符串(判绑名[左陆][判绑数[左陆]], 词名表[词位]); 词位++;
                        /* 载荷项类型码 = 变载[判荷扫描+判绑数] 的类型序 (变体载荷项顺序与 锤A 登记序一致) */
                        若 (判荷扫描 + 判绑数[左陆] < 判载数 && 变载[判荷扫描 + 判绑数[左陆]].变体 == 判序数) { /* 载荷项存在 */
                            整 判荷码 = 变载[判荷扫描 + 判绑数[左陆]].类型序;
                            字 *判绑当前 = 判绑名[左陆][判绑数[左陆]];
                            若 (判荷码 == 1 || 判荷码 == 10) 变浮(判绑当前); /* 第 185 站: 单精度载荷 绑定 → 浮点变量 (读到 double, 单精度 已被 cvtss2sd 提升) */
                            否 若 (判荷码 == 2) { 变量偏移(判绑当前); 若 (变量数 > 0) 变量表[变量数 - 1].是否短标 = 1; }
                            否 若 (判荷码 == 6) { 变量偏移(判绑当前); 若 (变量数 > 0) { 变量表[变量数 - 1].是否短标 = 1; 变量表[变量数 - 1].无符号标 = 1; } }
                            否 若 (判荷码 == 3) { 变量偏移(判绑当前); 若 (变量数 > 0) 变量表[变量数 - 1].是否字符标 = 1; } /* 第 175 站 (#97): 字符 载荷 绑定 → 字 标记 */
                            否 若 (判荷码 == 4) { 变量偏移(判绑当前); 若 (变量数 > 0) 变量表[变量数 - 1].是否长标 = 1; } /* 第 176 站 (#97 真接入): 长 长 载荷 绑定 → 长 标记 (原落 默认分支 ⟹ 无标记 ⟹ 8B 值 写 4B 槽 高位截断) */
                            否 若 (判荷码 == 8) { 变量偏移(判绑当前); 若 (变量数 > 0) { 变量表[变量数 - 1].是否长标 = 1; 变量表[变量数 - 1].无符号标 = 1; } } /* 无 长 长 载荷 绑定 */
                            否 若 (判荷码 == 7) { 变量偏移(判绑当前); 若 (变量数 > 0) { 变量表[变量数 - 1].是否字符标 = 1; 变量表[变量数 - 1].无符号标 = 1; } } /* 无符号 字 载荷 */
                            否 若 (判荷码 == 5) { 变量偏移(判绑当前); 若 (变量数 > 0) 变量表[变量数 - 1].无符号标 = 1; }
                            否 若 (判荷码 == 9) { 变量偏移(判绑当前); 若 (变量数 > 0) { 变量表[变量数 - 1].是否长标 = 1; 变量表[变量数 - 1].指元素尺寸 = 变载[判荷扫描 + 判绑数[左陆]].载荷元素; 变量表[变量数 - 1].指深 = 变载[判荷扫描 + 判绑数[左陆]].指层; 变量表[变量数 - 1].指内 = 变载[判荷扫描 + 判绑数[左陆]].载荷元素; 若 (变载[判荷扫描 + 判绑数[左陆]].载荷构序 >= 0) 变量表[变量数 - 1].型序标 = 变载[判荷扫描 + 判绑数[左陆]].载荷构序; } } /* 第 179 站: 指向 结构体 → 绑定变量 带 型序标 (供 p->字段) */ /* 第 178 站 (#97 v2 指针载荷): 指针 载荷 绑定 → 长(8B) + 元素尺寸/层级/终极元素 (下标 缩放 用; 同 普通指针变量 先例) */
                            否 变量偏移(判绑当前);
                            未初始化移除(判绑当前); /* 运行时臂内绑定 — 解析期免误报 */
                            判绑数[左陆] = 判绑数[左陆] + 1;
                        } 否 { 输出到文件(错误流, "[ERR] 依据 变体模式: %s 载荷绑定名 多于 载荷项 (锤B #98)\n", 判变常); 退出(1); }
                        若 (词型表[词位] == 逗号) { 词位++; 续; }
                        断;
                    }
                    若 (词型表[词位] == 右括) 词位++; /* ) */
                    整 判变项数 = 0;
                    循环 (判荷扫描 >= 判荷起点 && 判荷扫描 < 判载数 && 变载[判荷扫描].变体 == 判序数) { 判变项数++; 判荷扫描++; } /* 变体载荷项总数 */
                    若 (判变项数 != 判绑数[左陆]) { 输出到文件(错误流, "[ERR] 依据 变体模式: %s 载荷 %d 项, 绑定名给 %d 个 (锤B #98)\n", 判变常, 判变项数, 判绑数[左陆]); 退出(1); }
                    短进 = 建节(0); 节值表[短进] = 判序数; /* 判别值 常量模式 (穷尽/冗余 检查共用) */
                } 否 {
                    短进 = 宽捌(); /* 模式值用 宽捌() (不含 | 位或) — 赋值级() 会把 `1 | 2` 的 | 当位或吃掉 → 或 模式失效 */
                }
                若 (短进 >= 0 && 节型别[短进] == 节点_变量 && !比较字符串((字*)(节名表 + 短进), "引用")) {
                    池平 = 1;
                    复制字符串(左布, 词名表[词位]); 词位++; /* 绑定变量名 */
                    若 (查变量(左布) < 0) 变量偏移(左布);
                    未初始化移除(左布); /* 运行时臂内绑定初始化 — 解析期免未初始化误报 */
                    短进 = -1; /* 引用模式不比较值 */
                }
