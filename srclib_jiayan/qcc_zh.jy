    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "判别")) { /* 接入 2026-08-28 机制层: ADT (sum type, v3.0 #97) — 判别 Shape 于 { 圆(半径), 方(边长), 点() }; → 宏注册 Shape_圆=0/Shape_方=1/Shape_点=2 + struct Shape { int tag; int p0; int p1; } (tag+payload, 配合 依据 模式匹配) */
        词位++; /* 判别 */
