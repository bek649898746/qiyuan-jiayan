        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 内名, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(块, 元); } /* int __md_i = 0; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 跳名, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(块, 元); } /* int __md_j = 0; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 标伍, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(块, 元); } /* int __md_l = 0; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 符败, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(块, 元); } /* int __md_e = 0; */
