        汇发("    比较64 r12, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 1, 0, 1); 发字节(0x39); 模字节(3, 1, 4); /* cmp r12, r9 */
        发字节(0x0F); 发字节(0x83); 发四(0); 补标号(码位-4, 容低, 7); /* jae lfmt (高于等跳): r12 >= 界 -> stop */
    }
    汇发("    零扩展 eax, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 0); /* movzx eax, byte[r8] */
    测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 当散, 1);
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 当散, 1); /* count exhausted */
    存字节十二(); /* mov [r12], al */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* inc r12 */
    汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 0); /* inc r8 */
    汇发("    自减 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC9); /* dec ecx */
    相对跳转(-1); 补标号(码位-4, 半拆, 2);
