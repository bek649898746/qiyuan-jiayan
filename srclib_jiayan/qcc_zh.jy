                    整 构序 = 查类型(标); 若 (构序 < 0) 构序 = 构加(标); 计午 = 构序; /* 修复 2026-08-18: 原无条件 构加 → 外部 结构体 X *p 每次新建空 结构体 副本 → 计午 指空壳 → 外部 指针变量 型序标=空壳 → 内存地址 嵌套链 (the_repository->hash_algo->null_oid) 类型偏移(空壳) 失败 → 返回 表达式静默丢弃 → null_oid() 返垃圾 → 版本库 初始化 创建符号引用 崩; 已定义的类型必须 查类型 命中真实条目 */
                    若 (词型表[词位] == 左花) { 词位++; /* { */
                        整 序E2 = -1; 字 标E2[64]; 标E2[0] = 0; /* P0-21: 类型序 / 标签名 —— 必须**跨逗号续行继承** (主路径用 `满七` 正是为此); 分号处 重置 */
                        循环 (词位 < 词容量 && 词型表[词位] != 右花) {
                            若 (词型表[词位] == 直联) { 旁联 = 词值表[词位]; 词位++; 续; } /* 修复 2026-08-25 步二十一: 外部 结构体 函数体 字段 _Alignas */
                            整 串再 = 词位; 整 域尺寸 = 4, 行 = 1; 整 实丁E = 0; /* P0-21: 指针地块数 (每字段 重置) */
                            若 (词型表[词位] == 型词) { 若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) 域尺寸 = 1; 否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) 域尺寸 = 8; 词位++; }
                            循环 (词型表[词位] == 乘) { 域尺寸 = 8; 行 = 8; 实丁E++; 词位++; } /* P0-21: 计数 */
                            若 (词型表[词位] == 结构词 || 词型表[词位] == 枚词) { 整 词E2 = 词型表[词位]; 词位++; 若 (词型表[词位] == 词变量) { 若 (词E2 == 结构词) { 序E2 = 查类型(词名表[词位]); 若 (序E2 < 0) 复制字符串(标E2, 词名表[词位]); 若 (序E2 >= 0 && 类型表[序E2].尺寸 > 0) { 域尺寸 = 类型表[序E2].尺寸; 行 = 域尺寸; } } 词位++; } 若 (词型表[词位] == 左花) { 整 元 = 1; 词位++; 循环 (词位 < 词容量 && 元 > 0) { 若 (词型表[词位] == 左花) 元++; 否 若 (词型表[词位] == 右花) { 元--; 若 (元 <= 0) { 词位++; 断; } } 词位++; } } }
                            循环 (词型表[词位] == 乘) { 域尺寸 = 8; 行 = 8; 实丁E++; 词位++; } /* P0-21 **关键**: `结构体 X *a` 的 `*` 在 **结构词分支之后**, 而 上面 那个 前置 `循环 (乘)` 在它 **之前** ⟹ 原 代码 里 `*` 掉进 末尾 的「兜底推进 `若 (词位 == 串再) 词位++`」被 **丢掉** ⟹ 指针计数 恒 0 ⟹ `原进` 无从设 (前两次 补 4 处 仍失败 的真因) */
                            若 (词型表[词位] == 冒号) { 词位++; 若 (词型表[词位] == 常数 || 词型表[词位] == 词变量) 词位++; } /* 位域 */
                            若 (词型表[词位] == 词变量) { 字 正壹[64]; 复制字符串(正壹, 词名表[词位]); 词位++; 字段尺寸递归(构序, 正壹, 域尺寸, 行, 行); 若 (实丁E > 0) { 整 序E = 类型表[构序].函 - 1; 类型表[构序].字段[序E].原进 = 1; 类型表[构序].字段[序E].符肆 = 实丁E > 1 ? 8 : (序E2 >= 0 && 类型表[序E2].尺寸 > 0 ? 类型表[序E2].尺寸 : 4); 类型表[构序].字段[序E].内联 = 8; 类型表[构序].字段[序E].主挂 = 类型表[构序].字段[序E].符肆; 类型表[构序].字段[序E].高贰 = (字)实丁E; } 若 (序E2 >= 0) 字段类型(构序, 正壹, 序E2); 否 若 (实丁E > 0 && 标E2[0]) 堆丁(标E2, 构序, 正壹); /* P0-21 (2026-09-14): 本路径 (extern 结构体 X { ... } 变量;) 原**只调 字段尺寸递归** —— 漏主路径 的 原进/符肆/高贰/毛利; 且 **结构体标签 从未 查类型**; 且 `*` 被 兜底 丢掉. 实测 git notes.h `extern struct notes_tree { struct non_note *first_non_note, *prev_non_note; ... } default_notes_tree;` ⟹ `default_notes_tree.first_non_note->next` 报 A9001 (报错点 L7963, 判据 = 字段 毛利 < 0). 又一例「同一语义 多条路径 改一漏一」. */ 循环 (词型表[词位] == 左方) { 词位++; 若 (词型表[词位] == 常数 || 词型表[词位] == 词变量) 词位++; 若 (词型表[词位] == 右方) 词位++; } }
                            若 (词型表[词位] == 逗号) 词位++;
                            若 (词型表[词位] == 分号) { 词位++; 序E2 = -1; 标E2[0] = 0; } /* P0-21: 字段结束 → 类型序/标签名 重置 (逗号 不重置 = 继承) */
                            若 (词位 == 串再) 词位++;
                        }
                        若 (词型表[词位] == 右花) 词位++; /* } */
                        类型定型(构序);
                    }
                }
            }
            若 (词型表[词位] == 枚词 || (词型表[词位] == 词变量 && (!比较字符串(词名表[词位], "enum") || !比较字符串(词名表[词位], "枚")))) { /* 外部 枚举 类型 变量; — 跳过 枚举 类型名 (修复 2026-08-20: 原 外部 分支不认 枚举 → 整行跳到分号丢弃 → 对象创建模式 未注册 外部 → 查变量=-1 → 当函数取地址 移动 $地址 → 版本库 finalize_object_file 对象创建模式 读成地址 → rename 分支错 → 对象不落盘) */
                词位++; /* 枚举 */
                若 (词型表[词位] == 词变量) 词位++; /* 枚举 标签 */
                若 (词型表[词位] == 左花) { /* 枚举 函数体 跳过 */
                    整 行壬二 = 1; 词位++;
                    循环 (词位 < 词容量 && 行壬二 > 0) { 若 (词型表[词位] == 左花) 行壬二++; 否 若 (词型表[词位] == 右花) { 行壬二--; 若 (行壬二 <= 0) { 词位++; 断; } } 词位++; }
                }
            }
            若 (词型表[词位] == 词变量 && 词型表[词位 + 1] == 左括) { /* 函数声明 外部 整数 递增(整数); — 记录返回类型后跳过 */
                若 (计繁) 标分(词名表[词位], 1); /* 外部 双精度-返回 函数: 调用 堆丑 需 此 */
                若 (高八) 右捌(词名表[词位], 1); /* 修复 2026-08-21 #27: 外部 64-位-返回 函数 (长整 长整) */
                循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++;
                若 (词位 < 词容量 && 词型表[词位] == 分号) 词位++;
                续;
            }
            若 (词型表[词位] == 左括 && 词型表[词位 + 1] == 乘) { /* A95 (2026-09-14): **extern 函数指针变量** —— `extern void (*名字)(参数);` (git packfile.h L66 `extern void (*report_garbage)(unsigned seen_bits, const char *path);`)
               病灶: 外部 分支 原 **不认** 该形态 —— 型词 循环 消费 `void` 后 词位 落 `(`, 三个 分支 (结构词 / 枚词 / 「词变量 + 左括」函数声明) 全不命中,
                 前厚 循环 的 `循环 (乘)` 也 不命中 (`(` 非 `*`) ⇒ 整条 声明 被 末尾「跳到分号」静默 跳过 ⇒ 名字 未登记 ⇒ 调用处 报 A1001「未声明函数 'report_garbage'」.
               修法: 照 **同语义 的 非-extern 文件级 路径 L18185** (`整数 (*gfp)(整数);` → `变量静态(变节, 4)` + 数组元素尺寸 8) —— 本条 走 extern 登记 `半一` (外部 符号), 再 设 指针元素 尺寸.
               最小复现 p3: `extern void (*fp)(int);` + 调用 `fp(3);` → 修前 A1001; p2 (后面 另有 非-extern 定义) 修前 已 OK ⇒ 差异 只在 声明形态. */
                词位 += 2; /* ( * */
                若 (词型表[词位] == 词变量) {
                    字 变节E[64]; 复制字符串(变节E, 词名表[词位]); 词位++;
                    若 (词型表[词位] == 右括) 词位++; /* ) */
                    若 (词型表[词位] == 左括) { 整 深E = 0; 循环 (词位 < 词容量 && 词型表[词位] != 词终) { 若 (词型表[词位] == 左括) 深E++; 否 若 (词型表[词位] == 右括) { 深E--; 若 (深E <= 0) { 词位++; 断; } } 词位++; } } /* 跳过 参数 类型 列表 */
                    解析基 = 0; 半一(变节E, 0, 0, 8, 0); /* A95c (2026-09-16): 改回 **外部符号** — A95b 曾用 `变量静态` (.数据 槽 = 定义) 绕过「调用侧不认外部符号」, 代价是 **每个 include 的 .o 都导出符号** ⟹ 链接 duplicate symbol (审计包 2026-09-16 实证: git packfile.h L66 + path.c 调用). 本 修法 = 回归外部符号 + 把调用侧判据修对 (见 外部符号查) */ /* A95b (2026-09-14): 与 **非-extern 文件级路径 L18185 完全对齐** —— 用 `变量静态` (.数据 槽, 函数指 = 指针 8B) 而 非 `半一` (外部符号): 实测 `半一` 登记的外部符号 在 调用侧 不 被 当 可调用对象 (最小复现 p6 仍 报 A1001) */
                    变量表[变量数 - 1].数组元素尺寸 = 8; 若 (计繁) 变量表[变量数 - 1].指浮 = 1;
                }
                循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++;
                若 (词位 < 词容量 && 词型表[词位] == 分号) 词位++;
                续;
            }
            满联一 = 0;
            遍 (;;) { /* 修复 2026-08-23 t49e: 外部 前厚-声明 循环, 曾: 仅 1构一 变量 已登记 */
                满联一 = 0;
                循环 (词型表[词位] == 乘) { 满联一 = 满联一 ? 满联一 : 4; 词位++; } /* 指针 */
                若 (词型表[词位] == 词变量) {
                    字 符升[64]; 复制字符串(符升, 词名表[词位]); 词位++;
                    整 评值 = 半一(符升, 列劣, 计繁, 满联一, 高八);
                遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--) 若 (!比较字符串(变量表[变序].名, 符升) && 变量表[变序].栈偏移 == 评值) {
                    若 (计午 >= 0) 变量表[变序].型序标 = 计午;
                    若 (词型表[词位] == 左方) { /* 外部 数组: sane_ctype[256] 等. — 曾 已登记 作为 标量 外部 字符, 例-14 fell 入 参数 加载 且 已崩 */
                        整 满巳 = 列劣 ? 1 : (计繁 || 高八 ? 8 : 4);
                        若 (满联一 > 0) 满巳 = 8;
                        否 若 (计午 >= 0) 满巳 = 构尺寸(类型表[计午].名);
                        整 现庚 = 1;
                        整 元捌 = 0; /* 修复 2026-08-15: 外部 字符 strbuf_slopbuf[] 未定长数组 — 原 现庚==1 不置 数组尺寸 → 码生成 按标量读 .数据 前 4 字节而非取地址 → STRBUF_INIT 初始化成 0x3a → setenv("路径", 0x3a) 崩 */
                        循环 (词型表[词位] == 左方) {
                            元捌 = 1;
                            词位++; 整 维数 = 0;
                            若 (常量表达式求值(&维数)) 现庚 *= 维数;
                            否 若 (词型表[词位] == 常数) { 现庚 *= 词值表[词位]; 词位++; }
                            否 若 (词型表[词位] == 词变量) { 整 号薄 = 全回(词名表[词位]); 若 (号薄 != 0x80000000 && 号薄 != -1) 现庚 *= 号薄; 词位++; }
                            若 (词型表[词位] == 右方) 词位++;
                        }
                        若 (现庚 > 1) { 变量表[变序].数组尺寸 = 现庚; 变量表[变序].数组元素尺寸 = 满巳; }
                        否 若 (元捌) { 变量表[变序].数组尺寸 = -1; 变量表[变序].数组元素尺寸 = 满巳; }
                        若 (取环境("QCC_DBG_NS")) 若 (查找子串(符升, "ref_namespace")) 输出到文件(错误流, "[NS] extern '%s' e_stidx=%d e_esz=%d e_cnt=%d arr_sz=%d arr_esz=%d\n", 符升, 计午, 满巳, 现庚, 变量表[变序].数组尺寸, 变量表[变序].数组元素尺寸);
                    }
                        断;
                    }
                } 否 {
                    断;
                }
                若 (词型表[词位] == 逗号) { 词位++; 续; } /* 前厚 -> 下一 外部 变量 */
                断;
            }
            循环 (词位 < 词容量 && 词型表[词位] != 分号 && 词型表[词位] != 词终) 词位++;
            若 (词位 < 词容量 && 词型表[词位] == 分号) 词位++;
            续;
        }
         /* R3-匿 (2026-09-13): `类型 名 = 构/联合/枚 { ... };` —— 匿名体 中文 类型别名.
            原文: 文件级 → 解析中断「未找到 主 入口」; 函数体 → 静默 4 字节 或 运行时 崩 (8 字节体 当 4 用).
            正解 = 词元级 **等长** 就地重写 → `typedef 构 名 { ... } 名 ;` (具名标签+体+别名 → 复用 ③ 解析器 16824 路径):
              词位: 类型→typedef, 词位+1: 名→构, 词位+2: =→名, 原 构 与 {..} 各 左移 1 格.
            等长 + 只动 本语句 区间 内 词元 ⇒ 语句 之后 词元 位置 **不变** (宏体/函数体 词元区间 记录 不失效). */
         若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "类型") && 词型表[词位 + 1] == 词变量 && 词型表[词位 + 2] == 赋号
             && (词型表[词位 + 3] == 结构词 || 词型表[词位 + 3] == 枚词) && 词型表[词位 + 4] == 左花) {
             整 名匿一 = 词位 + 1; 字 别名匿[64]; 复制字符串(别名匿, 词名表[名匿一]);
             整 键型匿 = 词型表[名匿一 + 2], 键值匿 = 词值表[名匿一 + 2]; 字 键名匿[64]; 复制字符串(键名匿, 词名表[名匿一 + 2]); /* 构/联合/枚 词元 (词位+3) */
             整 体深匿 = 0; 整 终匿 = 名匿一 + 3;
             循环 (终匿 < 词容量 && 词型表[终匿] != 词终) { 若 (词型表[终匿] == 左花) 体深匿++; 否 若 (词型表[终匿] == 右花) { 体深匿--; 若 (体深匿 <= 0) 断; } 终匿++; }
             若 (终匿 < 词容量 && 词型表[终匿] == 右花 && 终匿 + 1 < 词容量 && 词型表[终匿 + 1] == 分号) {
                 整 行匿 = 词行表[词位];
                 遍 (整 搬匿 = 词位 + 3; 搬匿 < 终匿; 搬匿++) { /* { ... } 左移 1 (前向 拷贝, 目<源 安全) */
                     词型表[搬匿] = 词型表[搬匿 + 1]; 词值表[搬匿] = 词值表[搬匿 + 1];
                     复制字符串(词名表[搬匿], 词名表[搬匿 + 1]);
                     词行表[搬匿] = 词行表[搬匿 + 1]; 词无符号表[搬匿] = 词无符号表[搬匿 + 1]; 词长表[搬匿] = 词长表[搬匿 + 1]; 段属[搬匿] = 段属[搬匿 + 1];
                 }
                 词型表[词位] = 词变量; 复制字符串(词名表[词位], "typedef"); 词值表[词位] = 0; 词无符号表[词位] = 0; 词长表[词位] = 0; 词行表[词位] = 行匿;
                 词型表[词位 + 1] = 键型匿; 复制字符串(词名表[词位 + 1], 键名匿); 词值表[词位 + 1] = 键值匿;
                 词型表[词位 + 2] = 词变量; 复制字符串(词名表[词位 + 2], 别名匿); 词值表[词位 + 2] = 0; 词无符号表[词位 + 2] = 0; 词长表[词位 + 2] = 0;
                 词型表[终匿] = 词变量; 复制字符串(词名表[终匿], 别名匿); 词值表[终匿] = 0; 词无符号表[终匿] = 0; 词长表[终匿] = 0; 词行表[终匿] = 行匿;
             续; /* 命中 即 重写完毕 → 回 顶 由 类型定义 解析器 接管 (等长, 词位 不变) */
             }
