#define 直布 70       /* a=算子(25/46=且,47=或,48=异或): 弹栈 r64; 且/或/异或 堆九, rbx */
#define 目拾 71  /* 乘 rbx, rcx (rex1;0F 左辛;模字节(3,3,1)) — 邻辰 指针缩放 */
#define 剩分 72      /* a=算子, b=长属: 弹栈 r64; 加/减/乘/除/模 堆九, rbx (含除/取模) */
#define 标粗 73         /* 弹栈寄存器(3): rbx = [rsp] — 32位指针缩放路径 */
#define 中卯 74    /* a=首从: 移动 r10d,首子; 移动 首子,立即数; 乘 首子,r10 — 32位指针缩放 */
#define 暂重 75     /* a=算子, b=长属: g_uns设置; 算寄存器(算子,3,0); 移寄存器(0,3) — 缩放/除/移位后 */
#define 隔得一 76        /* a=高巳一: 移动 ecx,立即数; 符号扩展; 除 ecx — 指针差除元素大小 */
#define 旧玖 77      /* a=右卯: 移动 rcx,立即数; cqo; 除 rcx — 64位指针差除元素大小 */
/* ==== 阶段 3 阶段C: 通过 框架 + 定律接口位 ==== */
静 空 (*深双)(整 *算子, 整 *甲, 整 *发字节, 整 *字符) __attribute__((原粗)) = 0; /* 通过 回调, 默认不激活 (0=直译全等) */
#define 单次 1  /* 定律接口位: 线性资源 (移动/借用/生命周期) — 不激活 */
#define 末伴一 2     /* 定律接口位: 和类型 (已标记 联合) — 不激活 */
#define 实序一 4 /* 定律接口位: 类型格 (上下界/约束) — 不激活 */
静 整 正己一[256] __attribute__((原粗)); /* 定律接口位 每-结构体 (位掩码, 全 0=不激活 → 编译产物不变) */
静 空 中刷(空) {
    若 (深双) { 遍 (整 计 = 0; 计 < 空失; 计++) 深双(&短次一[计], &中参数a[计], &中参数b[计], &中参数c[计]); } /* 第三阶段-C: 通过 遍历 (默认空) */
    遍 (整 计 = 0; 计 < 空失; 计++) {
        择 (短次一[计]) {
            例 序移立即数: 移即(中参数a[计], 中参数b[计]); 断;
            例 当利一: 计升(((长 长)(无 整)中参数b[计]) | (((长 长)(无 整)中参数c[计]) << 32)); 断;
            例 中跳标号: 相对跳转(-1); 补标号(码位 - 4, 中参数a[计], 2); 断;
            例 中标号: 设标号(中参数a[计]); 断;
            例 中测零跳: 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 中参数a[计], 1); 断;
            例 虚丙: 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 中参数a[计], 3); 断;
            例 中压栈rax: 压栈寄存器(0); 断;
            例 中取帧: 移寄存器帧(中参数a[计], 中参数b[计]); 若 (中参数c[计]) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } 断;
            例 中压栈64rax: 压栈64(0); 断;
            例 首分: 移64(3, 0); 断;
            例 堆庚: 移帧寄存器(中参数a[计], 0); 断;
            例 栈置: 压浮0(); 断;
            例 标零: 移eax内存(静态位移(中参数a[计], 中参数b[计])); 若 (中参数c[计]) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } 断;
            例 满丁: 移rax内存64(静态位移(中参数a[计], 中参数b[计]) - 1); 断;
            例 缺捌: 度一(静态位移(中参数a[计], 中参数b[计]) - 1); 断;
            例 中调用标号: 相对调用(0); 补标号(码位 - 4, 中参数a[计], 0); 加栈即(中参数b[计]); 断;
            例 顺七: 减栈即(中参数a[计]); 断;
            例 中取栈寄存器: 移寄存器栈64(0, 中参数b[计]); 移64(中参数a[计], 0); 断;
            例 中巳: 主二(中参数a[计], 中参数b[计]); 断;
            例 副失: 取帧址(中参数a[计], 中参数b[计]); 断;
