                    否 若 (中附) { 变量静态(毛寅, 4); 变量表[变量末序].数组元素尺寸 = 8; 若 (原分) 变量表[变量数 - 1].指浮 = 1; } /* typedef'd fnptr var: 8-byte .data slot */
