                    否 { 汇发("    符号扩展字 eax, ax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBF); 发字节(0xC0); } /* 符号扩展 首子, ax */
