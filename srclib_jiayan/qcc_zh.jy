        否 若 (深 == 0 && 终[计] == '>' && 终[计+1] != '>' && (计 == 0 || 终[计-1] != '>')) { 算子 = 6; 现伍一 = 1; }
        若 (算子) {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 现伍一);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            整 亥 = 预处求值(甲), 寅 = 预处求值(发字节);
            若 (算子 >= 3 && (剩辰(甲) || 剩辰(发字节))) { /* 修复 2026-08-26 解析器: 无符号感知比较 — UINT32_MAX=4294967295 截断 整数 为 -1, `OUTPUT_BUFFER_MAX_BLOCK_SIZE > UINT32_MAX` (268M > 4G 应假) 误判真 → zlibmodule.c #错误; 操作数是无符号宏时按 32 位无符号比较 */
                无 内得 = (无)亥, 隔布 = (无)寅;
                若 (算子 == 3) 返 内得 <= 隔布;
                若 (算子 == 4) 返 内得 >= 隔布;
                若 (算子 == 5) 返 内得 < 隔布;
                若 (算子 == 6) 返 内得 > 隔布;
            }
            若 (算子 == 1) 返 亥 == 寅;
            若 (算子 == 2) 返 亥 != 寅;
            若 (算子 == 3) 返 亥 <= 寅;
            若 (算子 == 4) 返 亥 >= 寅;
            若 (算子 == 5) 返 亥 < 寅;
            若 (算子 == 6) 返 亥 > 寅;
        }
    }
    /* 移位 << >> (优先级高于关系比较, 低于加减) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (深 == 0 && 终[计] == '<' && 终[计+1] == '<') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 2);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            整 移位 = 预处求值(发字节); 返 移位 >= 0 && 移位 < 32 ? 预处求值(甲) << 移位 : 0;
        } 否 若 (深 == 0 && 终[计] == '>' && 终[计+1] == '>') {
            字 甲[512], 发字节[512]; 复制内存(甲, 终, 计); 甲[计] = 0; 复制字符串(发字节, 终 + 计 + 2);
            整 标址 = (整)取字长(甲); 循环 (标址 > 0 && (甲[标址-1] == ' ' || 甲[标址-1] == '\t')) 甲[--标址] = 0;
            整 标号 = (整)取字长(发字节); 循环 (标号 > 0 && (发字节[标号-1] == ' ' || 发字节[标号-1] == '\t')) 发字节[--标号] = 0;
            整 移位 = 预处求值(发字节); 返 移位 >= 0 && 移位 < 32 ? 预处求值(甲) >> 移位 : 0;
        }
    }
    /* 算术 +/- (修复 2026-08-13: 版本库-兼容-工具.h 的 __STDC_VERSION__ - 0 < 199901L;
       原整串当宏名 → 0 → #错误. 优先级低于比较: 比较先拆, 算术在更内层;
       修复 2026-08-26 解析器: 循环从 i=0 起数括号 — 原 i=1 漏数首 '(' → (A-1)&B 的 - 被当顶层拆分 → 求值错) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (计 >= 1 && 深 == 0 && (终[计] == '-' || 终[计] == '+')) {
            字 甲[512], 发字节[512];
            整 标址 = 计;
            循环 (标址 > 0 && (终[标址-1] == ' ' || 终[标址-1] == '\t')) 标址--;
            复制内存(甲, 终, 标址); 甲[标址] = 0;
            复制字符串(发字节, 终 + 计 + 1);
            整 亥 = 预处求值(甲), 寅 = 预处求值(发字节);
            返 终[计] == '-' ? 亥 - 寅 : 亥 + 寅;
        }
    }
    /* 算术 * / % (修复 2026-08-26 pngtest: png.h 版本检查 #若 PNG_LIBPNG_VER != PNG_LIBPNG_VER_MAJOR * 10000 + ... 
       — 原无乘除拆解 → `PNG_LIBPNG_VER_MAJOR * 10000` 整串当宏名 → 0 → 10643!=0 误报 #错误 "Inconsistent 版本 numbers".
       在 +/- 之后拆分 (乘除优先级高于加减; 递归内层自然生效); 除零返回 0 防 UB; 修复 2026-08-26 解析器: 同 +/- 括号计数) */
    遍 (整 计 = 0, 深 = 0; 终[计]; 计++) {
        若 (终[计] == '(') 深++;
        否 若 (终[计] == ')') 深--;
        若 (计 >= 1 && 深 == 0 && (终[计] == '*' || 终[计] == '/' || 终[计] == '%')) {
            字 甲[512], 发字节[512];
            整 标址 = 计;
            循环 (标址 > 0 && (终[标址-1] == ' ' || 终[标址-1] == '\t')) 标址--;
            复制内存(甲, 终, 标址); 甲[标址] = 0;
            复制字符串(发字节, 终 + 计 + 1);
            整 亥 = 预处求值(甲), 寅 = 预处求值(发字节);
            若 (终[计] == '*') 返 亥 * 寅;
            若 (终[计] == '/') 返 寅 ? 亥 / 寅 : 0;
            返 寅 ? 亥 % 寅 : 0;
        }
    }
    /* 数 或 宏 名 (修复 2026-08-06: 支持负数字面量 #若 -5 < 0; 原 -5 落到 域零 失败 → 0) */
    整 负 = 0;
    若 (终[0] == '-') { 负 = 1; 终++; }
    若 (终[0] == '0' && (终[1] == 'x' || 终[1] == 'X')) {
        整 值 = 0, 指 = 2; 循环 (判十六进制((无 字)终[指])) { 整 字符 = 终[指]; 值 = 值 * 16 + (字符 >= '0' && 字符 <= '9' ? 字符 - '0' : (字符 >= 'a' && 字符 <= 'f' ? 字符 - 'a' + 10 : 字符 - 'A' + 10)); 指++; }
        返 负 ? -值 : 值;
    }
    若 (终[0] == '0' && 终[1] >= '0' && 终[1] <= '7') { 整 值 = 0, 指 = 0; 循环 (终[指] >= '0' && 终[指] <= '7') 值 = 值 * 8 + (终[指++] - '0'); 返 负 ? -值 : 值; } /* 修复 2026-08-26 解析器: 八进制字面量 — fileutils.c `#若 _S_IREAD != 0400` 原 0400 按十进制 400 求值 → 256!=400 真 → #错误 "不支持 C library"; 必须在十进制之前 (0 开头优先) */
    若 (判数字((无 字)终[0])) { 整 值 = 0, 指 = 0; 循环 (判数字((无 字)终[指])) 值 = 值 * 10 + (终[指++] - '0'); 返 负 ? -值 : 值; }
    若 (负) 返 0; /* -名字: 不支持 */
    若 (!比前n(终, "defined", 7) && 终[7] == '(') { /* 序布(X) 原子: 逻辑/比较拆分后到达 (修复 2026-08-15: 序布(A)||序布(B) 原早退只算 A) */
        字 名存[64]; 整 名序 = 0; 整 指 = 8;
        循环 (判字母数字((无 字)终[指]) || 终[指] == '_' || ((无 字)终[指] >= 0x80)) { 若 (名序 < 63) 名存[名序++] = 终[指]; 指++; }
        名存[名序] = 0;
        返 (邻细(名存) || 外合(名存)) ? 1 : 0; /* 修复 2026-08-06: 原 域零>=0 对负值宏判假; 2026-08-07: 顺序定义表也算 */
    }
    { 常 字 *素挂 = 双繁一(终); 若 (素挂 && 素挂[0] && 行分 < 24) { 行分++; 整 返二 = 预处求值(素挂); 行分--; 返 返二; } } /* 修复 2026-08-26 pngtest: 对象宏别名在 #若 里递归求值 (#定义 PNG_LIBPNG_VER_SONUM PNG_LIBPNG_VER_SHAREDLIB — 词法器 把非数值宏也注册成数值宏=0 → 邻细 恒真 → 别名永不展开 → 16!=0 误报 #错误); 必须在 邻细 之前查 双繁一 — 别名宏在 终复[] 里的值是垃圾 0; 深度上限防 #定义 A A 自引用死循环 */
    若 (邻细(终)) 返 域零(终); /* 修复 2026-08-06: 原 mv>=0 把负值宏当未找到 → 0 */
    返 前利(终); /* 修复 2026-08-07: 顺序定义表的值 (#定义 模式 2 → #若 模式==1 用真值而非存在性) */
}

/* 包含 目录栈: #包含 "x.h" 先相对当前源文件所在目录搜索, 再相对 cwd (修复 2026-08-13 第三阶段) */
静 字 空七[16][512]; 静 整 净厚;
静 字 命头目[64][512]; 静 整 命头目数; /* P0-4 (2026-09-14): 命令行 -I <目录> 的 头文件 搜索目录表 —
   原 `-I` 语义 是 "预包含该文件" (读文件 + 前插, = GCC 的 -include), **没有 搜索目录 概念**;
   而 真实 多目录 项目 (git/zlib/lua/curl) 的 构建 **全部 依赖 `-I<dir>`** ⟹ 原语义下 这些项目 无法编译
   (实测 `-I scratch_gl\inc` 对 `#include "myhdr.h"` 报 "找不到文件", 对 `#include <myhdr.h>` **静默忽略**)。
   ⚠️ 本表 **不参与 任何 复位** (与 `命宏` 同族: 命令行 输入, 跨编译 持久)。 */
静 字 序己[512]; /* 修复 2026-08-26 媒体库: 元低 实际找到文件的目录 (父链回溯命中时记录), 缓卯 用它建 空七 — 原按 串升 子目录拼接导致头内相对 包含 解析错 */
静 字 标寅一[512]; /* 顶层源文件目录 */
静 空 邻繁(常 字 *路径, 字 *出, 整 容量) {
    整 计 = 0, 末一 = -1;
    循环 (路径[计]) { 若 (路径[计] == '/' || 路径[计] == '\\') 末一 = 计; 计++; }
    若 (末一 > 0) { 整 数 = 末一 < 容量 - 1 ? 末一 : 容量 - 1; 复制内存(出, 路径, 数); 出[数] = 0; }
    否 出[0] = 0;
}
静 字 *元低(常 字 *串升);

/* #包含 "文件" — 预处理器包含展开（词法 前；条件编译感知；修复 2026-08-06） */
静 字 *源乙(常 字 *路径) {
    FILE *文件 = 打开文件(路径, "rb");
    若 (!文件) 返 0;
    定位文件(文件, 0, 2); 长 尺寸 = 取文件位置(文件); 定位文件(文件, 0, 0); /* SEEK 宏定义在本函数之后，自宿主不处理真实 <单繁一.h>；用字面量 0/1/2 避开先使用后定义 (修复 2026-08-16 自举回归) */
    若 (尺寸 < 0) { 关文件(文件); 返 0; }
    若 (尺寸 > 16 * 1024 * 1024) { 关文件(文件); 输出到文件(错误流, "[ERR] #包含 文件超过 16兆字节 上限 (修复 2026-08-06 M8: 原无大小上限，编译不可信源码=任意大文件读取面)\n"); 退出(1); }
    字 *缓 = 内存分配((size_t)尺寸 + 1);
    若 (!缓) { 关文件(文件); 返 0; }
    size_t 半列 = 读取(缓, 1, (size_t)尺寸, 文件);
    缓[半列] = 0; 关文件(文件);
    返 缓;
}
静 字 *元低(常 字 *串升) {
    序己[0] = 0; /* 修复 2026-08-26 媒体库: 每次搜索前清空, 成功点记录实际目录 */
    若 (!比较字符串(串升, "accctrl.h") || !比较字符串(串升, "aclapi.h")) {
        /* 前巳一 SDK 头文件不在源码树内; compat_prelude.h 已提供 ipc-win32.c 所需的类型/宏/API 半未 (修复 2026-08-15: ipc_get_active_state 未定义) */
        字 *半未 = 内存分配(2);
        若 (半未) 半未[0] = 0;
        返 半未;
    }
    若 (!比较字符串(串升, "limits.h")) {
        /* 修复 2026-08-26 脚本语言: <限制.h> 被跳过 → LLONG_MAX 等未定义 → luaconf.h `#若 序布(LLONG_MAX)` 假
           → 整数类型链落到 #错误 "编译器 做 非 support '长整 长整'". 内建 限制.h: 标准整数极值
           (值同 png_compat.h, 已验证; 负值不括号 — 毛简 只认 -N / (N)) */
        常 字 *构一 = "#define CHAR_BIT 8\n"
            "#define SCHAR_MIN -128\n#define SCHAR_MAX 127\n#define UCHAR_MAX 255\n"
            "#define CHAR_MIN 0\n#define CHAR_MAX 255\n"
            "#define SHRT_MIN -32768\n#define SHRT_MAX 32767\n#define USHRT_MAX 65535\n"
            /* A107 (2026-09-14): **最小值 用 表达式** `(-MAX - 1)` —— 原 写 `-2147483647`(少 1!) / `-2147483648L` / `-9223372036854775808LL`:
               ① `INT_MIN` 直接 少 一 (实测 `printf("%d", INT_MIN)` 与 gcc 差 1);
               ② 即使 写全, 字面量 绝对值 也 超 该类型 的 正 上限 ⇒ 常量解析 会 饱和/溢出.
               表达式 形式 与 C 标准头 (`(-2147483647 - 1)` 等) **逐字一致**, 无 溢出 风险. */
            "#define INT_MIN (-2147483647 - 1)\n#define INT_MAX 2147483647\n#define UINT_MAX 4294967295u\n"
            "#define LONG_MIN (-2147483647L - 1L)\n#define LONG_MAX 2147483647L\n#define ULONG_MAX 4294967295UL\n"
            "#define LLONG_MIN (-9223372036854775807LL - 1LL)\n#define LLONG_MAX 9223372036854775807LL\n#define ULLONG_MAX 18446744073709551615ULL\n";
        size_t 槽长 = 取字长(构一);
        字 *尾联 = 内存分配(槽长 + 1);
        若 (尾联) { 复制内存(尾联, 构一, 槽长); 尾联[槽长] = 0; }
        返 尾联;
    }
    若 (!比较字符串(串升, "stdint.h")) {
        /* 修复 2026-08-29 生成器 崩溃族根因: <深丑.h> 系统头被跳过 (角括号 包含 找不到即弃)
           → uint64_t/int64_t/size_t/intptr_t 无 类型定义 注册 → 类型尺寸落默认 4 (错)
           → crc32_8bytes(uint64_t 数值) 参数 32 位 → (数值>>32) 在 x86 移位计数 mod32 环绕成 >>0
           → 字节重复 → 校验和错 + 多维指针/易失 崩溃族 (生成器 20 种子 17 崩)。
           内置 深丑.h: 标准整数类型 (x86_64 六十四位窗口), 值同 mingw; 已有 限制.h/单八.h 同款先例。
           注意 custom_stdint_x86.h 的 #定义 uint64_t 多 词元 值 编译器 宏系统不支持 → 死宏, 无冲突。 */
        常 字 *构一 =
            "typedef signed char int8_t;\n"
            "typedef unsigned char uint8_t;\n"
            "typedef short int16_t;\n"
            "typedef unsigned short uint16_t;\n"
            "typedef int int32_t;\n"
            "typedef unsigned int uint32_t;\n"
            "typedef long long int64_t;\n"
            /* A15-余 (2026-09-13) **撤销 本 预置**: MSVC 类型族 (`__int8/__int16/__int32/__int64`) 别名
               已 从 此处 **移除** —— 根治 落 在 **词法层** (见 标识符 分支 `__int64` 展开). 4 个 名字 现在
               直接 展开 为 甲言 类型词 (`有符号 字` / `短` / `整` / `长 长`), 任何 源 (含 与 不含 `<stdint.h>`)
               一律 生效. ⚠️ 若 保留 本 预置: 词法展开 先于 解析 → 会 变成 `typedef signed char 有符号 字;`
               = 语法错 —— 故 必须 删. (原 e028897 的 4 行 typedef 只 在 显式 include 时 生效, 对 不 include 的
               `feat_i64.c` 无效 = 挂账 的 由来) */
            "typedef unsigned long long uint64_t;\n"
            "typedef long long intptr_t;\n"
            "typedef unsigned long long uintptr_t;\n"
            "typedef unsigned long long size_t;\n"
            "typedef long long ssize_t;\n"
            "typedef long long ptrdiff_t;\n"
            "typedef long long intmax_t;\n"
            "typedef unsigned long long uintmax_t;\n"
            "typedef long long int_least64_t;\n"
            "typedef unsigned long long uint_least64_t;\n"
            "typedef int int_least32_t;\n"
            "typedef unsigned int uint_least32_t;\n"
            "typedef long long int_fast64_t;\n"
            "typedef unsigned long long uint_fast64_t;\n"
            "typedef int int_fast32_t;\n"
            "typedef unsigned int uint_fast32_t;\n"
            /* A51 (2026-09-13): C99 7.18.2 整数 极值 宏 —— 本 预置 原 **只有 typedef, 完全 无 极值宏** ⟹
               `INT64_MAX` / `UINT64_MAX` 等 报「未声明标识符」(实测 `scripts/feat_si.c` 编译失败);
               而 内建 `<限制.h>` 只 提供 `LLONG_MAX` 系 的 **另一套 名字** ⟹ 用 `INT64_MAX` 的 标准 C 代码 死。
               负值 **不 括号** (同 内建 限制.h 既有 风格: 毛简 只认 `-N` / `(N)`); 命名的 宽度 与 上面 typedef 一致. */
            "#define INT8_MIN -128\n#define INT8_MAX 127\n#define UINT8_MAX 255\n"
            "#define INT16_MIN -32768\n#define INT16_MAX 32767\n#define UINT16_MAX 65535\n"
            "#define INT32_MIN -2147483648\n#define INT32_MAX 2147483647\n#define UINT32_MAX 4294967295u\n"
            "#define INT64_MIN -9223372036854775808LL\n#define INT64_MAX 9223372036854775807LL\n#define UINT64_MAX 18446744073709551615ULL\n"
            "#define INTPTR_MIN -9223372036854775808LL\n#define INTPTR_MAX 9223372036854775807LL\n#define UINTPTR_MAX 18446744073709551615ULL\n"
            "#define PTRDIFF_MIN -9223372036854775808LL\n#define PTRDIFF_MAX 9223372036854775807LL\n"
            "#define SIZE_MAX 18446744073709551615ULL\n"
            "#define INTMAX_MIN -9223372036854775808LL\n#define INTMAX_MAX 9223372036854775807LL\n#define UINTMAX_MAX 18446744073709551615ULL\n";
        size_t 槽长 = 取字长(构一);
        字 *尾联 = 内存分配(槽长 + 1);
        若 (尾联) { 复制内存(尾联, 构一, 槽长); 尾联[槽长] = 0; }
        返 尾联;
    }
    若 (!比较字符串(串升, "stdarg.h")) {
        /* 修复 2026-08-23 t35e: <单八.h> 是 已跳 由 编译器 (angle-bracket 包含 是
           已丢), 故 mingw's __builtin_va_start/__builtin_va_arg become 未定义-函数
           调用 那 静默 返回 0, 且 va_list 退化 到 a 4-字节 整数 (truncating 该
           64-位 家-地址) -> 该 整体 va_list 链 失败 (版本库 strbuf_addf/vsnprintf
           发射 nothing). 内置 单八.h: va_list=字符*, va_start->__qcc_va_start()
           (返回 该 六十四位窗口 家-区域 地址), va_arg->pure C 指针 算术. */
        常 字 *构一 = "typedef char *va_list;\n"
            "#define _INTSIZEOF(n) ((sizeof(n) + 7) & ~7)\n"
            "#define va_start(ap, last) ((ap) = __qcc_va_start())\n"
            "#define va_arg(ap, type) (*(type *)(((ap) += _INTSIZEOF(type)) - _INTSIZEOF(type)))\n"
            "#define va_end(ap) ((ap) = 0)\n"
            "#define va_copy(d, s) ((d) = (s))\n";
        size_t 槽长 = 取字长(构一);
        字 *尾联 = 内存分配(槽长 + 1);
        若 (尾联) { 复制内存(尾联, 构一, 槽长); 尾联[槽长] = 0; }
        返 尾联;
    }
    若 (!比较字符串(串升, "time.h")) {
        /* R5c (2026-09-09): <time.h> 内置 — 原系统头被跳过 → sizeof(struct tm)=0 →
           用户代码 lt->tm_year 字段偏移全 0 读 0 (map7 只过 strftime 未碰字段); 仿 stdint.h 先例.
           布局 = MinGW (compat_prelude.h L2591, 9 int = 36B, tm_year@20); time_t=long long 64位
           (x86_64 LLP64, msvcrt _time64 系) */
        常 字 *构一 =
            "typedef long long time_t;\n"
            "typedef long long clock_t;\n"
            "struct tm { int tm_sec; int tm_min; int tm_hour; int tm_mday; int tm_mon; int tm_year; int tm_wday; int tm_yday; int tm_isdst; };\n"
            "time_t time(time_t *t);\n"
            "clock_t clock(void);\n"
            "double difftime(time_t a, time_t b);\n"
            "time_t mktime(struct tm *tm);\n"
            "char *asctime(const struct tm *tm);\n"
            "char *ctime(const time_t *t);\n"
            "struct tm *gmtime(const time_t *t);\n"
            "struct tm *localtime(const time_t *t);\n"
            "size_t strftime(char *s, size_t n, const char *fmt, const struct tm *tm);\n";
        size_t 槽长 = 取字长(构一);
        字 *尾联 = 内存分配(槽长 + 1);
        若 (尾联) { 复制内存(尾联, 构一, 槽长); 尾联[槽长] = 0; }
        返 尾联;
    }
    若 (净厚 > 0 && 空七[净厚 - 1][0]) {
        字 整布[1024];
        复制字符串(整布, 空七[净厚 - 1]);
        拼接(整布, "/");
        拼接(整布, 串升);
        字 *容复 = 源乙(整布);
        若 (容复) { 复制字符串(序己, 空七[净厚 - 1]); 返 容复; }
        /* 修复 2026-08-16 根治: #包含 只搜当前源文件目录 — 版本库 头文件在根目录 (版本库-兼容-工具.h/内置.h),
           子目录源文件 包含 不到 → 224 文件全部 [错误] 找不到。向上回溯父目录链。 */
        字 号得[1024];
        复制字符串(号得, 空七[净厚 - 1]);
        遍 (;;) {
            字 *槽长 = 反向查(号得, '/');
            字 *余庚 = 反向查(号得, '\\');
            若 (余庚 > 槽长) 槽长 = 余庚; /* 前巳一 路径反斜杠分隔 (修复 2026-08-16: 原只找 '/' 回溯永不触发) */
            若 (!槽长) 断;
            *槽长 = 0;
            若 (!号得[0]) 断;
            字 间八[1024];
            复制字符串(间八, 号得);
            拼接(间八, "/");
            拼接(间八, 串升);
            字 *反繁 = 源乙(间八);
            若 (反繁) { 复制字符串(序己, 号得); 返 反繁; }
        }
    }
    遍 (整 头序 = 0; 头序 < 命头目数; 头序++) { /* P0-4 (2026-09-14): 命令行 -I <目录> 搜索 — 插在 源文件目录/父链回溯 之后、cwd 之前 (与 GCC 的 -I 顺序直觉一致) */
        字 头八[1024];
        复制字符串(头八, 命头目[头序]);
        拼接(头八, "/");
        拼接(头八, 串升);
        字 *反头 = 源乙(头八);
        若 (反头) { 复制字符串(序己, 命头目[头序]); 返 反头; }
    }
    返 源乙(串升);
}
/* 第N行: 计算源码 位 处的行号 (修复 2026-08-06 任务 5.3 中文诊断) */
静 整 反进 = 0; /* 前插 的 运行时库.c 行数 (用户源码行号校正) */
静 整 旁亥(常 字 *串值, 整 位) {
    整 度转 = 1;
    遍 (整 键 = 0; 键 < 位 && 串值[键]; 键++) 若 (串值[键] == '\n') 度转++;
    返 度转 - 反进;
}
静 字 宽布[65] = ""; /* #expect (阶段 4 哈希审判) */
静 字 列附[65] = ""; /* Phase4 --自检 */
静 空 深伴(常 字 *数据, 整 长度一, 字 出[65]); /* 前向: 定义在资源护栏区 (契约哈希/描述符需在 解析 期用) */
静 字 长退弃[1]; /* A3-契约指纹 (2026-09-12): 原 名键侧表 整伴[64][64]/长退[64][65] 退役, 迁入 类型表.契约印[65] (真结构: 契约 是 结构体 的 属性, 键 = 构序) */
静 整 总六一(常 字 *数); 静 整 深散(常 字 *数); /* 前向 */
静 整 总置 = 0; 静 字 内吉[65]; 静 字 素细[65]; 静 字 直八[65]; 静 空 内巳(空); 静 空 暂卯(空); /* 接入 2026-08-28 可吞清单 阶段零-9: 编译 DAG 重放证明 — 阶段哈希链 (定义在资源护栏区) */
静 整 整再 = 0; 静 字 元零[512]; 静 整 帧又 = 0; 静 整 素凶 = 0; 静 空 段弊(常 字 *行一); 静 空 存重(常 字 *函); /* 接入 2026-08-28 可吞清单 阶段一: 编译黑匣子 — 每函数代码增量哈希帧 (定义在资源护栏区) */
静 整 邻联 = 0; /* 接入 2026-08-28 可吞清单 阶段一: 编译服务器 qccd — --服务 长驻 输入流/输出流 数据格式-行 (可重入核心+增量缓存, 甲序 迭代毫秒级; 定义在 主 前) */
静 整 高劣 = 0; /* 兼容/stat.c 兼容开关 — 2026-08-28 挪文件作用域 (号进 键签名要用, 原 主 局部) */
静 整 新六 = 0; 静 空 标进(常 字 *数, 整 行一); 静 空 总升一(空);
静 整 出注 = 0; /* #173 --annotations: 导出注解表 */ /* 接入 2026-08-28 可吞清单 阶段一: 引用收集 --引用 — 谁引用了 X (导航补引用, 甲序 读代码定位; 定义在资源护栏区) */
静 构 { 字 函[64]; 整 空再; 整 存集; 整 左陆一; 整 源庚; 整 源甲; 整 返宽; } 段分[256]; /* 返宽: 后置 返回占位槽 通道 0=4B 整数 1=8B 整数 2=双精度 (xmm0) */ 静 整 左五; 静 整 末从; 静 整 中柒(常 字 *函); 静 长 长 目弊(整 数, 常 字 **副进, 常 长 长 *当壬, 整 首合, 整 *高癸一); /* 接入 2026-08-28 可吞清单 阶段零-7/阶段一: 契约表 + 编译期常量前置审判 (声明在此, 原级/调用点用; 函数定义在契约表区) */
#define 单伴 "43B4EBE5" /* 接入 2026-08-28 甲序原生 #5: 文件级哈希增量编译 — 缓存键版本签名 (每站与不动点同号 提升, 编译器升级→旧缓存自动失效) */
静 整 逆薄 = 0; 静 整 域组 = 0; 静 字 双降[65] = ""; /* --缓存 / --缓存-验证: sidecar 式增量缓存 — 键=SHA256(版本+选项签名+宏表+源码), 命中跳过编译; <输出文件>.qcckey 记录键, 输出文件即缓存 */
静 整 堆低一 = 0; 静 字 暂寅[512] = ""; /* 接入 2026-08-28 甲序原生 #6 (可吞清单 阶段零-6): 编译检查点 — 崩溃尸检快照 (词法/每函数解析/每函数码生成器/已做) */
静 空 长叁(常 字 *行一); /* 前向: 崩溃尸检快照落盘 (定义在资源护栏区) */
静 字 *缓卯(常 字 *源, 整 深度) {
    若 (深度 > 32) { 输出到文件(错误流, "[ERR] #包含 嵌套超过 32 层\n"); 退出(1); } /* 修复 2026-08-26 媒体库: 8→32 — 媒体库 头链深 (配置.h→libavutil/xxx.h→公共.h→内存.h→... 15+ 层), 原 8 层爆 */
    若 (深度 == 0) { 虚五 = 0; 净厚 = 0; 若 (标寅一[0]) { 复制字符串(空七[净厚], 标寅一); 净厚++; } } /* 修复 2026-08-13 第三阶段: 顶层源文件目录入栈 */
    整 容量 = (整)取字长(源) + 16384;
    字 *出 = 内存分配(容量); 若 (!出) { 输出到文件(错误流, "[ERR] 内存不足 内存分配\n"); 退出(1); } 整 出序 = 0;
    常 字 *指 = 源;
    整 顺一 = 0, 条件计数 = 0;
    整 后排[64], 下劣[64];
    循环 (*指) {
        常 字 *小于等 = 指; 循环 (*小于等 && *小于等 != '\n') 小于等++;
        整 计属 = (整)(小于等 - 指);
        若 (*指 == '#') {
            常 字 *指深度 = 指 + 1; 循环 (*指深度 == ' ' || *指深度 == '\t') 指深度++; /* 修复 2026-08-26 libpng: 缩进指令 #  包含 "pngconf.h" (png.h) — 原不跳 # 后空白 → 包含 未处理 → pngconf.h 宏定义全缺 → PNG_EXPORT/PNG_CALLBACK 未展开 → 解析挂死 */
            整 是否条件编译 = ((!比前n(指深度, "ifdef", 5) && (指深度[5] == 0 || 指深度[5] == ' ' || 指深度[5] == '\t' || 指深度[5] == '\r' || 指深度[5] == '\n')) || (!比前n(指深度, "若有定义", 12) && (指深度[12] == 0 || 指深度[12] == ' ' || 指深度[12] == '\t' || 指深度[12] == '\r' || 指深度[12] == '\n')));
            整 外二 = ((!比前n(指深度, "ifndef", 6) && (指深度[6] == 0 || 指深度[6] == ' ' || 指深度[6] == '\t' || 指深度[6] == '\r' || 指深度[6] == '\n')) || (!比前n(指深度, "若无定义", 12) && (指深度[12] == 0 || 指深度[12] == ' ' || 指深度[12] == '\t' || 指深度[12] == '\r' || 指深度[12] == '\n')));
            整 序粗 = !比前n(指深度, "if", 2) && !是否条件编译 && !外二 && (指深度[2] == 0 || 指深度[2] == ' ' || 指深度[2] == '\t' || 指深度[2] == '\r' || 指深度[2] == '\n');
            整 下环 = !比前n(指深度, "elif", 4) && (指深度[4] == 0 || 指深度[4] == ' ' || 指深度[4] == '\t' || 指深度[4] == '\r' || 指深度[4] == '\n');
            整 短再 = !比前n(指深度, "else", 4) && (指深度[4] == 0 || 指深度[4] == ' ' || 指深度[4] == '\t' || 指深度[4] == '\r' || 指深度[4] == '\n');
            整 短叁 = ((!比前n(指深度, "endif", 5) && (指深度[5] == 0 || 指深度[5] == ' ' || 指深度[5] == '\t' || 指深度[5] == '\r' || 指深度[5] == '\n')) || (!比前n(指深度, "结束若", 9) && (指深度[9] == 0 || 指深度[9] == ' ' || 指深度[9] == '\t' || 指深度[9] == '\r' || 指深度[9] == '\n')));
            整 右附一 = ((!比前n(指深度, "include", 7) && (指深度[7] == 0 || 指深度[7] == ' ' || 指深度[7] == '\t' || 指深度[7] == '\r' || 指深度[7] == '\n')) || (!比前n(指深度, "包含", 6) && (指深度[6] == 0 || 指深度[6] == ' ' || 指深度[6] == '\t' || 指深度[6] == '\r' || 指深度[6] == '\n')));
            整 主布 = !比前n(指深度, "expect", 6) && (指深度[6] == 0 || 指深度[6] == ' ' || 指深度[6] == '\t' || 指深度[6] == '\r' || 指深度[6] == '\n'); /* Phase4 期望原语: #expect <sha256> 声明产物哈希 */
            若 (序粗 || 是否条件编译 || 外二 || 下环 || 短再 || 短叁) {
                整 父节 = 顺一; 整 条件 = 0;
                若 (是否条件编译 || 外二) {
                    字 名存[64]; 整 名序 = 0; 常 字 *寻 = 指深度; 循环 (判字母数字(*寻) || *寻 == '_' || ((无 字)*寻 >= 0x80)) 寻++;
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                    循环 (判字母数字(*寻) || *寻 == '_' || ((无 字)*寻 >= 0x80)) { 若 (名序 < 63) 名存[名序++] = *寻; 寻++; }
                    名存[名序] = 0;
                    整 定义 = 外合(名存); /* 修复 2026-08-07: 原 邻细 在 包含 阶段为空 → 守卫永远假 → 重复头重复展开内部 #包含 */
                    条件 = 是否条件编译 ? 定义 : !定义;
                } 否 若 (序粗 || 下环) {
                    字 表达式[512]; 整 戊序 = 0; 常 字 *寻 = 指深度 + (序粗 ? 2 : 4);
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                    循环 (*寻 && 戊序 < 510) { 若 (*寻 == '\\' && (寻[1] == '\n' || (寻[1] == '\r' && 寻[2] == '\n'))) { 寻 += (寻[1] == '\r' ? 3 : 2); 表达式[戊序++] = ' '; 续; } 若 (*寻 == '\n') 断; 表达式[戊序++] = *寻++; } /* 修复 2026-08-26 pngtest: #若 表达式反斜杠续行 (同 词法器/收集 — pngtest.c 版本检查跨 5 行, 原只读首行 → 尾反斜杠进表达式 → 条件求值错) */
                    循环 (戊序 > 0 && (表达式[戊序-1] == ' ' || 表达式[戊序-1] == '\t' || 表达式[戊序-1] == '\r')) 戊序--; /* C103: +'\r' — CRLF 下 #if 表达式 尾部带 \r ⟹ 预处求值 失败 静默判假 (lvm.c `#if LUA_USE_JUMPTABLE` 真实载体) */
                    表达式[戊序] = 0;
