    若 (序集 && 数[0] != '_') { 尾登记(数, 净丙, 变量数); } /* 接入 2026-08-28 机制层 #78 明确初始化: 用户代码(主 后)局部变量声明登记 (跳过 _ 前缀编译器内部变量/运行时库 运行时); 读取未初始化 → L5014 [错误] */
    就绪未标(数); /* G3 2026-09-06: 用户局部声明 守卫就绪判定 登记(未初始化) */
    返 变量表[变量数++].栈偏移;
}
