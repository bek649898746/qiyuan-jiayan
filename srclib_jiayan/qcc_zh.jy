   一 字节 further). 非-目标文件 仅 (修复 2026-08-05: 全局 字符 数组 = "lit"). */
静 空 原弊一(整 位移, 整 立即数) {
    汇发("    存静字节 [rip%+d], %d\n", (字*)(长 长)(位移), (字*)(长 长)(立即数), (字*)(长 长)0);
    发字节(0xC6); 发字节(0x05); 发四(位移); 发字节(立即数 & 0xFF);
}
/* 加 堆九, 八位立即数 (64-位 �?遍 指针+偏移) */
静 空 后弊一(整 值) {
    汇发("    加指针 rax, %d\n", (字*)(长 长)(值), (字*)(长 长)0, (字*)(长 长)0);
    若 (值 >= -128 && 值 <= 127) { 前缀字节(1, 0, 0, 0); 发字节(0x83); 模字节(3, 0, 0); 发字节(值 & 0xff); }
    否 { 前缀字节(1, 0, 0, 0); 发字节(0x05); 发四(值); } /* 加 堆九, 三十二位立即数 (偏移 > 127, e.g. 类型表[构序].函 于 736) */
}
/* 移动 三十二位寄存器, [reg64] ??解引用 */
静 空 移寄存器内存(整 寄存器, 整 号挂) {
    汇发("    取值 r%d, [r%d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(号挂), (字*)(长 长)0);
    前缀字节(0, 寄存器 & 8, 0, 号挂 & 8); 发字节(0x8B);
    若 (号挂 == 4 || 号挂 == 12) { 模字节(0, 寄存器 & 7, 号挂 & 7); 发字节(0x24); }
    否 模字节(0, 寄存器 & 7, 号挂 & 7);
}
/* 移动 reg64, [reg64] �?满-宽度 解引用 (字符** 整劣[i] �?8-字节 指针) */
静 空 移寄存器内存64(整 寄存器, 整 号挂) {
    汇发("    取64 r%d, [r%d]\n", (字*)(长 长)(寄存器), (字*)(长 长)(号挂), (字*)(长 长)0);
    前缀字节(1, 寄存器 & 8, 0, 号挂 & 8); 发字节(0x8B);
    若 (号挂 == 4 || 号挂 == 12) { 模字节(0, 寄存器 & 7, 号挂 & 7); 发字节(0x24); }
    否 模字节(0, 寄存器 & 7, 号挂 & 7);
}
