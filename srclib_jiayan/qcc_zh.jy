                    断;
                }
                若 (子0[数] >= 0 && 子0[子0[数]] >= 0 && (节型别[子0[子0[数]]] == 节点_三元 || 节型别[子0[子0[数]]] == 节点_二元)) { /* C134 (2026-09-19 第 127 站): **三元 / 逗号 / 加减 表达式基 写** —— `(1 ? gp : hp)[i] = 值` / `(0, gp)[i] = 值` / `(gp + 0)[i] = 值`.
                    原 落 最终兜底: `变节` 取 表达式节点 的 节名表 (垃圾) ⟹ 查变量 = -1 ⟹ 落 指针参数分支 ⟹ 静默错写 (矩阵 W3/W5/W6).
                    地址 = 码生成(基); 宽度 = 堆次(链根名) (链根 穿透 三元/二元, 见 `链根变量` C134); 存法 由 **值** 的 浮性 决定 (含 浮点字面量 的 解析期 标记 终简, 见 C132 注释). */
                    整 根伍 = 链根变量(子0[子0[数]]);
                    整 宽伍 = (根伍 >= 0) ? 堆次((字*)(节名表 + 根伍)) : 节点指元素(子0[子0[数]]); /* C142 (2026-09-19 第 132 站): 无链根 (调用 / 含调用 的 二元) ⟹ 用 `节点指元素` (C140 已 使其 支持 调用) */
                    若 (宽伍 <= 0) 宽伍 = 4;
                    整 浮伍 = (子1[数] >= 0 && (节浮标[子1[数]] || 节型表[子1[数]] == 终简 || 表达式是否浮(子1[数]))) ? 1 : 0;
                    { 整 值回 = 码生成免解引用; 码生成免解引用 = 0; 码生成(子1[子0[数]]); 码生成免解引用 = 值回; }
                    移寄存器(11, 0);
                    若 (宽伍 == 4) { 汇发("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(2); }
                    否 若 (宽伍 == 2) { 汇发("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(1); }
                    否 若 (宽伍 == 1) { }
                    否 { 移即(0, 宽伍); 移寄存器(9, 0); 汇发("    乘 r11, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 1, 0, 1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 3, 1); }
                    压栈寄存器(11);
                    码生成(子0[子0[数]]);
                    弹栈寄存器(11);
                    符号扩展r11();
                    汇发("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 1, 0, 0); 发字节(0x01); 模字节(3, 3, 0);
                    压栈寄存器(0);
                    若 (浮伍) 码生成浮(子1[数]); 否 码生成(子1[数]);
                    弹栈寄存器(3);
                    若 (浮伍 && 宽伍 == 4) { 中发(栈丁单, 0, 0, 0); 中刷(); } /* R252 (2026-09-22) 虾米: **解引用基写 的 单精度存** —— 原 浮点存 一律 `中发(前八一)` (movsd 8 字节) ⟹ `**float**变量 = 8.5f` 写 8 字节: 低 4 字节 0 (读 float 得 0.0) + 高 4 字节 溢到 下一元素 (实测 `(*pp)[0]` 读 2.406250 = 6.5f 的 double 高 4 字节). 与 R251 修好的 **读侧** 同型. */ 否 若 (浮伍) { 中发(前八一, 0, 0, 0); 中刷(); }
                    否 若 (宽伍 == 1) { 中发(素癸, 0, 0, 0); 中刷(); }
                    否 若 (宽伍 == 2) { 中发(计贰一, 0, 0, 0); 中刷(); }
                    否 若 (宽伍 == 8) { 扩32(子1[数]); 中发(中存栈64, 0, 0, 0); 中刷(); }
                    否 { 中发(中存栈32, 0, 0, 0); 中刷(); }
                    断;
                }
                若 (子0[数] >= 0 && 子0[子0[数]] >= 0 && 节型表[子0[子0[数]]] == 4) { /* C138c (2026-09-19 第 128 站): **函数调用基 写** —— `(f())[i] = 值`.
                    原 落 最终兜底 (`变节` 取 调用节点 的 节名表 垃圾名) ⟹ 静默错写 (矩阵 W8).
                    判据 与 读路径 C138b 相同 (窄: 只认「单级 浮点 指针 返回」) —— 调宽 为 0 时 不 生成, 自然 落回 原 路径 (零回归). */
                    整 调宽三 = 0; 整 调浮三 = 0;
                    { 整 末调三 = 节末子(子0[子0[数]]); 整 函调三 = (末调三 >= 0) ? 取子(子0[子0[数]], 末调三) : -1;
                      若 (函调三 >= 0 && 节型别[函调三] == 节点_变量) { 字 *调名三 = (字*)(节名表 + 函调三); 调浮三 = 查函数浮指返(调名三); 若 (调浮三) 调宽三 = 8; } } /* C139b: 改 用「返回 指针 指向 双精度」登记位 (同 读路径) */
                    若 (调宽三 > 0) {
                        整 宽伍 = 调宽三;
                        整 浮伍 = (子1[数] >= 0 && (节浮标[子1[数]] || 节型表[子1[数]] == 终简 || 表达式是否浮(子1[数]))) ? 1 : 0;
                        { 整 值回 = 码生成免解引用; 码生成免解引用 = 0; 码生成(子1[子0[数]]); 码生成免解引用 = 值回; }
                        移寄存器(11, 0);
                        若 (宽伍 == 4) { 汇发("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(2); }
                        否 若 (宽伍 == 2) { 汇发("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(1); }
                        否 若 (宽伍 == 1) { }
                        否 { 汇发("    左移 r11, 3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(3); }
                        压栈寄存器(11);
                        码生成(子0[子0[数]]);
                        弹栈寄存器(11);
                        符号扩展r11();
                        汇发("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 1, 0, 0); 发字节(0x01); 模字节(3, 3, 0);
                        压栈寄存器(0);
                        若 (浮伍) 码生成浮(子1[数]); 否 码生成(子1[数]);
                        弹栈寄存器(3);
                        若 (浮伍 && 宽伍 == 4) { 中发(栈丁单, 0, 0, 0); 中刷(); } /* R252 (2026-09-22) 虾米: **解引用基写 的 单精度存** —— 原 浮点存 一律 `中发(前八一)` (movsd 8 字节) ⟹ `**float**变量 = 8.5f` 写 8 字节: 低 4 字节 0 (读 float 得 0.0) + 高 4 字节 溢到 下一元素 (实测 `(*pp)[0]` 读 2.406250 = 6.5f 的 double 高 4 字节). 与 R251 修好的 **读侧** 同型. */ 否 若 (浮伍) { 中发(前八一, 0, 0, 0); 中刷(); }
                        否 若 (宽伍 == 1) { 中发(素癸, 0, 0, 0); 中刷(); }
                        否 若 (宽伍 == 2) { 中发(计贰一, 0, 0, 0); 中刷(); }
                        否 若 (宽伍 == 8) { 扩32(子1[数]); 中发(中存栈64, 0, 0, 0); 中刷(); }
                        否 { 中发(中存栈32, 0, 0, 0); 中刷(); }
                        断;
                    }
                }
                整 名一 = 子0[数]; 字*变节=(字*)(节名表+原庚(名一));

                整 副癸 = 变量型序(变节);
                /* 结构体 数组元素赋值 班级[j] = 班级[j+1] (修复 2026-08-06).
                   守卫: 仅当 左操作数 是直接 数组[i] (子0[n] 的基是名字节点 节型表==1)。
                   栈散[0].名[0] = 'X' 的基是 例-15 字段链 → 不能当整结构体拷贝 (修复 2026-08-06: probe_sg 崩)。
                   尺寸>=8: 8 字节 结构体 元素拷贝同样要整块 (原 >8 走标量路径 → 存的是元素地址, 修复 2026-08-06) */
                整 逆平 = 0; /* 2026-09-04 虾米 挂账5: 局部结构体数组 (larr[2]) 注册 型序标 缺失 (typedef/声明路径) → 副癸=-1 原漏整块拷贝 → 16B 元素只拷低8B/拷地址; 兜底: 数组元素>8B (标量不可能) 即按结构体拷贝 */
                若 (副癸 >= 0) { 若 (变量指元素(变节) == 0 && !(变量数组(变节) > 0 && 变量指深查(变节) >= 1) && 变量元素(变节) == 类型表[副癸].尺寸 && 类型表[副癸].尺寸 >= 8) 逆平 = 类型表[副癸].尺寸; /* R296 (2026-09-26 启元 · 第 364 站 round 26): **补「不是指针数组」守卫** —— 靶子: `变量元素(变节) == 类型表[副癸].尺寸` 在 **结构体尺寸恰 == 指针宽 8** 时巧合成立 (全局 `隔排(变节, 0, 8, 计数二)` ⟹ 元素=8; `构 点` 尺寸=8) ⟹ 指针数组 `构 点 *gsp[2]` 被误判为**结构体值数组** ⟹ `逆平=8` ⟹ 走 `深利(8)` 结构体块拷贝 ⟹ 对取址 RHS (`gsp[i] = &gsa[j]`) 取「该表达式地址处的 8 字节」= `gsa[j]` 的**内容**(=0) 而**非地址** ⟹ `gsp[i]=0`. 插桩 [R296] 实证: 全局 副癸=2 逆平=8 指元=0 元素=8 指深=1 数组=2 (错) / 全局 构三 元素=8≠12 ⟹ 逆平=0 (对) / 局部 指元=8≠0 ⟹ 逆平=0 (对). ⟹ 2026-08-17 的守卫 `变量指元素==0` **假设指针数组的 指元素尺寸>0**, 而 `隔排` 那条**全局登记路径**传 0 ⟹ 守卫失效 (同 §9.0「局部/全局走不同登记路径」同族). 本条用 `指深` (R281 局部 / R290 全局已确保为 1) —— 与 `指元指针` (L6278) 判据逐字同式. 安全: 结构体**值**数组 `sa[4]` 指深=0 ⟹ 不受影响; 浮点值数组 `da[4]` 指深=0 ✓. */ }
                否 若 (变量指元素(变节) == 0 && 变量数组(变节) > 0 && 变量元素(变节) > 8) 逆平 = 变量元素(变节); 整 成员基辰 = 0; 若 (逆平 == 0 && 子0[数] >= 0 && 节型表[子0[数]] == 14 && 子0[子0[数]] >= 0) { 整 基辰 = 子0[子0[数]]; 若 (节型表[基辰] == 15) { 整 根辰 = (子0[基辰] >= 0) ? 序七(子0[基辰]) : -1; 若 (根辰 >= 0 && !字段是否指(根辰, (字*)(节名表 + 基辰))) { 整 元序 = 字段类型序直(根辰, (字*)(节名表 + 基辰)); 若 (元序 >= 0 && 类型表[元序].函 > 0 && 类型表[元序].尺寸 >= 8) { 逆平 = 类型表[元序].尺寸; 成员基辰 = 1; } } } } /* R347: 成员链数组元素 整块拷贝 (原守卫 只认 名字节点基 -> 结构体数组字段 被 误伤; 收窄到 基字段 是数组(内联>0) 且 元素>=8) */
                若 (逆平 >= 8 && 子0[数] >= 0 && 子0[子0[数]] >= 0 && (节型表[子0[子0[数]]] == 1 || 成员基辰) && !(子1[数] >= 0 && 节型表[子1[数]] == 4)) { /* 结构体 数组元素赋值 班级[j] = 班级[j+1] (修复 2026-08-06; 修复 2026-08-16 根因J: 子0[n]>=0 && 子0[子0[n]]>=0 守卫; 修复 2026-08-17: 变量指元素==0 排除指针数组 结构体 T *数组[] — 元素是指针(8B) 非结构体值, 原当 结构体 拷贝 → 空 元素从地址 0 拷 → 崩; P2-19 (2026-09-10): RHS 是 调用 → 本分支 排除, 交 标量分支 (调用结果 在 寄存器/sret 临时, 直接"取调用地址" = 崩溃; 标量分支 已有 sret 临时机制) */
                    码生成免解引用 = 1; 码生成(子0[数]); 码生成免解引用 = 0; /* 堆九 = &数组[i] (目标) */
                    压栈寄存器(0);
                    若 (子1[数] >= 0 && 节型表[子1[数]] == 1) { 构值源可址 = 1; /* 源是变量: &变量 (例 1 码生成免解引用 会读值非地址!) (修复 2026-08-16: 子1[n]>=0 守卫 — 解析 失败时缺源 子1=-1, 原直接读 节型表[-1] 越界) */
                        字 *首联 = (字*)(节名表 + 子1[数]);
                        整 目伴 = 查变量(首联);
                        若 (变量是否静态(首联)) { 中发(缺捌, 目伴, 1, 0); 中刷(); } 否 { 中发(副失, 0, 变量基(首联, 目伴) - 当前帧大小, 0); 中刷(); } /* 第三阶段-中间表示 例十: 大结构 右操作数 取址 */
                    } 否 {
                        整 前从411 = -1; 整 主得411 = -1; 构值源可址 = (子1[数] >= 0 && 内存地址(子1[数], &前从411, &主得411) == 0) ? 1 : 0; 若 (构值源可址) { 码生成免解引用 = 1; 码生成(子1[数]); 码生成免解引用 = 0; } 否 { 移即(0, 0); } /* 堆九 = &右侧 (源) */
                    }
                    弹栈寄存器(3); /* rbx = 目标, 堆九 = 源 */
                    若 (构值源可址) 深利(逆平); /* R401: 源 不可取址 ⟹ 不发射 块拷贝 */
                } 否 {
                /* 双精度 数组, 或 双精度* 指针 变量 (指浮). 非 函数指 数组: 指浮 彼处
                   means 双精度-返回, 元素 是 指针 (64-位 存储). */
                整 数组浮 = (变量是否浮(变节) || (变量指浮(变节) && 变量数组(变节) == 0)) && !(变量数组(变节) > 0 && 变量指深查(变节) >= 1); /* C1 第三层 (2026-09-26 启元 · round 40): 指针数组的元素**自身**是指针 ⟹ 写路径不得走浮点通道 —— `static float *arr[2]` 的 `变量是否浮`=1 是「元素**指向**的类型是浮点」的语义, 原判据据此走浮点值准备+浮动存 ⟹ `arr[0] = buf` 被编成 `cvtsi2sd`+`cvtsd2ss`+`movss`(**只写 4 字节**) ⟹ 槽内高 4 字节丢失 ⟹ 读 `mov (%rax),%rax` 得垃圾 ⟹ `arr[0][1]` 崩 (事件日志偏移 0x23dff = 该 movss). 区分符 = 第 356 站补的 `指深` (值数组=0 / 指针数组=1). 零误伤: `float buf[4]`/`double dbuf[4]` 指深=0 ⟹ 仍走浮点 ✓; 指针变量 `float *fp` 数组=0 ⟹ 不排除 ✓ */
                整 指元浮 = 0; /* C133c (2026-09-19 第 127 站): **成员 指针 字段 指向 元素 的 浮性** —— `s.p[i] = 值` (成员基 下标) 的 存法/值准备 判据.
                    原 只 看 `变量是否浮(变节)` (变节 = 链根 结构体 名) ⟹ 恒 0 ⟹ 走 整数存 (堆柒) ⟹ 浮点 值 (在 xmm0) 未落地 ⟹ 分型 M4 得 0.00. */
                若 (节型表[子0[名一]] == 15 && 子0[名一] >= 0 && 子0[子0[名一]] >= 0) { 整 指构 = 序七(子0[子0[名一]]); /* R253 (2026-09-22) 虾米: 同第四刀 —— `子0[子0[名一]]` 可能 是 **下标节点** (`sArr[0].pp`), 其 名字 是 垃圾 ⟹ 变量型序(垃圾) 可能 碰巧命中 ⟹ 指元浮 错 ⟹ 写 走 整数存 ⟹ 浮点值 留 xmm0 未落地 (实测 r253l L1 = 0.000000 应 8.5). `序七` 对 变量基 逐字等价. */ 若 (指构 >= 0 && 终捌指(指构, (字*)(节名表 + 子0[名一]))) 指元浮 = 1; }
                若 (!指元浮 && 子0[名一] >= 0) { /* C135b (2026-09-19 第 128 站): **下标 / 解引用 链基 的 元素 浮性** (写侧 镜像 读侧 C135) —— `(gpp[0])[i] = 值` 一类.
                    原 判据 只 认「成员 指针 字段」⟹ 对 下标基 走 整数存 (堆柒) ⟹ 浮点 值 留在 xmm0 未落地 (矩阵 W10 得 0.00). */
                    整 根指 = 链根变量(子0[名一]);
                    若 (取环境("QCC_DBG_C135")) 输出到文件(错误流, "[C135b] 基型=%d 根指=%d 基登=%d 深=%d 名=%s\n", 节型表[子0[名一]], 根指, (根指 >= 0 ? 变量基登((字*)(节名表 + 根指)) : -9), 表达式指深(子0[名一]), (根指 >= 0 ? (字*)(节名表 + 根指) : (字*)"?")); /* 暂存 diag (零影响: 环境变量 守卫) */
                    若 (根指 >= 0 && 变量基登((字*)(节名表 + 根指)) - 1 == 4 && 表达式指深(子0[名一]) == 1) 指元浮 = 1;
                }
                若 (指元浮) 数组浮 = 1;
