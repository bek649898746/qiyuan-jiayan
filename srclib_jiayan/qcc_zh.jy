                否 若 (元素 == 4) { 汇发("    存零 [r0], r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x89); 模字节(0, 3, 0); } /* 移动 [堆九], ebx */
