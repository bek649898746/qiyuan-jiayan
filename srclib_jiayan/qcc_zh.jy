        例 节点_非节: /* !表达式 */
            码生成(子0[数]); 中发(中戊, 0, 0, 0); 中刷(); /* 第三阶段-中间表示: !表达式 */
        断;
        例 节点_十八: { /* ~表达式 — 修复 2026-09-02 p218: 长标 上下文 补符号扩展 (64位操作数走 REX.W NOT) */
            整 元宽 = (子0[数] >= 0 && 表达式是否长(子0[数])) ? 1 : 0; /* 码生成前算 (防 节长标 污染) */
            整 元扩 = (子0[数] >= 0 && 表达式是否无符号(子0[数])) ? 0 : 1; /* 结果 有符号 (32位) → 64位上下文 需 movsxd */
            码生成(子0[数]); 中发(元置, 元宽, (节长标[数] && 元扩 && !元宽) ? 1 : 0, 0); 中刷();
        } 断;
        例 节点_赋值: { /* 赋值 — 处理 双 变量=表达式 且 变量.字段=表达式 */
            /* R453 (2026-10-01 · 第 439 站续四十九): **外部符号赋值 静默丢弃 根治** ——
               单文件模式 (`extern 整 g; g = 5;`) 原生成 `mov $0x5,%eax` 后 **无 store**:
               赋值目标地址的既有判据 (如 L25515 `偏移 >= 0 || (链接模式 && …)`) 对 extern 变量
               (栈偏移 为 **负**) 为假 ⟹ **整段赋值被跳过**, 且 **无任何诊断** ⟹ 用户代码被静默吞掉.
               反汇编实证: 局部 `整 局 = 7;` 有 `mov %eax,-0x111c(%rbp)`, 而 `外部数 = 5;` 无对应 store.
               与「读」对称: 读走 `静态位移()` 的 `序标 < 0` 检查 ⟹ 报 A1001 拒绝.
               现给「写」补**同一收口** (在赋值节点入口, 覆盖 变量 / 成员 / 下标 三种目标形态的根变量);
               链接模式下外部符号走重定位 (见 L25515 的 2026-08-17 修复) ⟹ 放行. */
            { 整 根R453 = 子0[数]; 整 跳R453 = 0;
              循环 (根R453 >= 0 && 跳R453 < 8 && 节型别[根R453] != 节点_变量) {
                  若 (节型别[根R453] == 节点_成员 || 节型别[根R453] == 节点_箭头 || 节型别[根R453] == 节点_下标) 根R453 = 子0[根R453];
                  否 断;
                  跳R453++;
