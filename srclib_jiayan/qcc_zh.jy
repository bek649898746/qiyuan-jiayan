        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 宏名, 32); 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); 接子(块, 元); } /* int __sm = 0; 已匹配标志 (2026-08-28 P1 #133: 防守卫命中后后续臂覆盖) */
        { 整 计;
