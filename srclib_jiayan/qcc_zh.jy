                压栈寄存器(15); 移64(15, 4);
                汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                减栈即(32);
                调导入(11); /* CreateFiber */
                加栈即(32);
                移64(4, 15); 弹栈寄存器(15);
                加栈即(总计数);
                元子 = 1;
            } 否 若 (!比较字符串(串升, "SwitchToFiber")) { /* 2026-08-28 类型-根-15 #41: 切换纤程(lpFiber=rcx) — 上下文切换 (保存当前寄存器+栈, 载入目标纤维) */
                压栈寄存器(15); 移64(15, 4);
                汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                减栈即(32);
                调导入(12); /* 切换纤程 */
                加栈即(32);
                移64(4, 15); 弹栈寄存器(15);
                加栈即(总计数);
                元子 = 1;
