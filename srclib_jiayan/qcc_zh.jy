静 整 整再 = 0; 静 字 元零[512]; 静 整 帧又 = 0; 静 整 素凶 = 0; 静 空 段弊(常 字 *行一); 静 空 存重(常 字 *函); /* 接入 2026-08-28 可吞清单 P1: 编译黑匣子 — 每函数代码增量哈希帧 (定义在资源护栏区) */
静 整 邻联 = 0; /* 接入 2026-08-28 可吞清单 P1: 编译服务器 qccd — --serve 长驻 stdin/stdout JSON-lines (可重入核心+增量缓存, AI 迭代毫秒级; 定义在 main 前) */
静 整 高劣 = 0; /* compat/stat.c 兼容开关 — 2026-08-28 挪文件作用域 (cache_try_hit 键签名要用, 原 main 局部) */
静 整 新六 = 0; 静 空 标进(常 字 *数, 整 行一); 静 空 总升一(空); /* 接入 2026-08-28 可吞清单 P1: 引用收集 --refs — 谁引用了 X (导航补引用, AI 读代码定位; 定义在资源护栏区) */
