    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "依据")) { /* 接入 2026-08-28 switch 表达式 (有值, 蓝图 §二): 依据 r, x 对照 1: a, 2: b, 其他: c; → { __sw=x; __sr=(其他或0); if(__sw==1){__sr=a;} if(__sw==2){__sr=b;} r=__sr; } — 多路等值分发 (select 指令试吞) */
        词位++; /* 依据 */
        字 余吉[64]; 复制字符串(余吉, 词名表[词位]); 词位++; /* 结果变量 */
