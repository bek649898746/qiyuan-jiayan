            { 整 数 = 建节(0); 节值表[数] = 0; 返 数; } /* 检查通过: 常量 0 占位 (逗号表达式首操作数, 零语义) */
        }
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "__特化") && 查变量(词名表[词位]) < 0) { /* 阶段C-1 #50 泛型特化 (2026-09-01): __特化(接口, 实参) — 软检查 (实现接口 → 常量 1, 否则 常量 0); 分派三元 编译期选体, 不报错 */
            词位++; /* __特化 */
