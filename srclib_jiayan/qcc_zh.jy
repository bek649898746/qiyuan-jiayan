                    }
                    若 (全局数 > 0) {
                        若 (中附) {
                            /* typedef'd fnptr array: 8-byte pointer elements (matches int (*g[3])(int)) */
                            隔排(毛寅, 0, 8, 全局数);
                            变量表[变量数 - 1].指元素尺寸 = 8;
                            若 (原分) 变量表[变量数 - 1].指浮 = 1;
                        } 否 若 (首深 >= 0 && 满转 > 0) {
