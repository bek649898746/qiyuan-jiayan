            若 (词型表[词位] == 赋号) {
                词位++;
                未初始化移除(变丙);
                若 (词型表[词位] == 型词 && !比较字符串(词名表[词位], "空")) {
                    若 (可空本) { 词位++; 整 零丙 = 建节(0); 节值表[零丙] = 0; 接子(元丙, 零丙); }
                    否 { 格式化到串(错缓冲, "「= 空」只能 用于 可空 变量 (变量 '%s' 非可空; 空 与 void 类型词 撞词, 号合.0 #75)", 变丙); 发错误("A8002", 错缓冲); }
                } 否 { 接子(元丙, 赋值级()); }
