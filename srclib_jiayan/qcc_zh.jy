            } 否 若 (是否静态标) {
                
                若 (当丙 || 单丙) { 变量静态(变节, 是否指标 ? (当丙 ? 8 : 4) : 4); 若 (是否指标) { 变量表[变量末序].指浮 = 1; 若 (单丙) 变量表[变量末序].指单 = 1; 指针登记(变量数 - 1, -1, 当丙 ? 8 : 4, 0, -1, 指深一, 变节, 4); } /* R244 (2026-09-22) 刀1: **补 变量基登写 (A22 基类码)** —— 「指针声明」6 条路径 里 **唯此一条** 漏 (对照 非 static 浮点指针 L10672 的同名调用); 漏 则 基类码 = 0 ⟹ 解析期 节指元[*pp] 不登记 ⟹ 多级浮点指针 的 浮性 判据链 断 */ /* R236: 补 指单 —— 原 此 处 只设 单标(值变量标记), 指针 需 指单 ⟹ fp[i] 按 双精度 8B 读 (实测 8.000002) */ 否 { 变量表[变量末序].是否浮标 = 1; } 若 (单丙) 变量表[变量末序].单标 = 1; 若 (变量表[变量末序].变可空.tag == 可空值_无值) 静宽标登(变节, 变量末序); } /* R235: 浮点指针 与 浮点标量 **分岔** —— 指针 走 元数据收口 (指浮/指深/指内; 原 完全漏 ⟹ static double *dp; dp[1] 崩), 标量 保持 是否浮标 */ /* 静态 双精度/单精度: 8-字节 .数据 槽位 (R4a-2: float 单标); H1g: 可空 双 静态 → 分离 tag 槽 */
