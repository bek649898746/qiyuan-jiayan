                        整 计辛一 = 字段类型序直(串值二, 串升);
                        /* 修复 2026-08-22 t48: 数组[i].字段 = 结构体 — 大结构字段整体赋值 (tx[i].d = t[i])
                           traverse_trees 里 `tx[i].d = t[i]` 原 域尺寸>8 落标量 否则 存首 4 字节地址 → tx[i].d 只写
                           &t[i] 低 32 位 → tree_desc 拷贝失败 → 遍历 树 全空 → 状态 误报 已暂存. */
                        整 中环 = (子1[数] >= 0 ? 成员写宽(串值二, 串升, 计辛一) : 0);
                        若 (中环 > 0 && (中环 > 8 || !(子1[数] >= 0 && 节型表[子1[数]] == 4))) { /* R457 (2026-09-26): 原 守卫 (R445 为 H17 崩溃所加) 把「调用 RHS 的整块拷贝」**一并关掉** ⟹ 12B/16B 字段 = 调用 落 标量路径, 而 R446 的宽度支 只 覆盖 **8B** (堆柒 只能 存 8 字节) ⟹ 只写 4 字节 (hb3 实测 541238208 0 0; r394 反而 41 42 43 = **真回归**). 修法: **> 8 一律 走 整块拷贝** (深利(中环)), 8B 保持原路 (宽度支) */
                            码生成免解引用 = 1; 码生成(子0[微码]); 码生成免解引用 = 0; /* 堆九 = &数组[i] */
                            若 (域偏移一 != 0) { 中发(尾浅, 域偏移一, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: &数组[i].字段 = &目标 */
                            压栈寄存器(0);                                    /* &目标 */
                            若 (节型表[子1[数]] == 1) {                          /* 堆九 = &源 (结构体 变量) */
                                字 *邻回 = (字*)(节名表 + 子1[数]);
                                整 存辛 = 查变量(邻回);
                                若 (存辛 >= 0) { 若 (变量是否静态(邻回)) { 中发(缺捌, 存辛, 1, 0); 中刷(); } 否 { 中发(副失, 0, 变量基(邻回, 存辛) - 当前帧大小, 0); 中刷(); } } /* 第三阶段-中间表示 例十: 大结构 右操作数 取址 */
                                否 移即(0, 0);
                            } 否 若 (子1[数] >= 0 && 节型表[子1[数]] == 4) { 整 哑B = 0, 哑B2 = -1; 内存地址(子1[数], &哑B, &哑B2); } /* R457: 调用 RHS — 走 内存地址 以 正确 设置 sret 隐藏指针 (调用 直写 帧临时 __mret_) 并 置 堆九 = &临时 = &源; 原 裸 码生成 ⟹ sret 指针 未设 ⟹ 崩/写错 */ 否 { 码生成免解引用 = 1; 码生成(子1[数]); 码生成免解引用 = 0; } /* 堆九 = &右操作数 (数组元素/成员链取址) */
                            弹栈寄存器(3); /* rbx = &目标, 堆九 = &源 */
                            深利(中环);
                        } 否 若 (终捌(串值二, 串升)) { /* 修复 2026-08-07: 双精度 字段走 码生成浮+压浮0+双精度移动 — 原用 压栈寄存器 只存 4/8 字节 堆九, 双精度 值在 xmm0 → 存垃圾 */
                            码生成浮(子1[数]); 压浮0();
                            码生成免解引用 = 1; 码生成(子0[微码]); 码生成免解引用 = 0; /* 堆九 = &数组[i] */
                            若 (域偏移一 != 0) { 中发(尾浅, 域偏移一, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 数组[i].字段 偏移 (双精度) */
                            弹浮0(); /* xmm0 = 右侧 */
                            若 (终捌单(串值二, 串升)) { 中发(栈丁单, 0, 0, 0); 中刷(); } 否 { 中发(栈丁, 0, 0, 0); 中刷(); } /* R4a-0b: 数组[i].字段 4B float 单存 */
                        } 否 {
                        码生成(子1[数]); 若 (域尺寸 == 8 && !(子1[数] >= 0 && 节型表[子1[数]] == 4)) 扩32(子1[数]); 压栈寄存器(0); /* 保存 右侧 - 修复 2026-09-03 p103: 数组[i].64位字段 = 32位整常数 RHS 符号扩展 (镜像 静态/局部字段 s13) */
                        码生成免解引用 = 1; /* 数组[i] 必须 产出 该 地址 (结构体* 参数 / 结构体 数组) */
                        码生成(子0[微码]); /* 堆九 = &数组[i] */
                        码生成免解引用 = 0;
                        若 (计排) { 中发(缓劣, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 数组[i]->字段 写回取指针值 */
                        若 (域偏移一 != 0) { 中发(尾浅, 域偏移一, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 数组[i].字段 偏移 */
                        弹栈寄存器(3); /* ebx = 右侧 */
                        若 (存壬(类型表[串值二].名, 串升)) { /* 位-字段 RMW 存储 (修复 2026-08-05) */ }
                        否 若 (域尺寸 == 1) { 中发(整集, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 数组[i].字段 存 字符 */
                否 若 (域尺寸 == 2) { 中发(旁辰, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 数组[i].字段 存 短整 */
                        否 若 (域尺寸 == 8 || (计辛一 >= 0 && 类型表[计辛一].尺寸 == 8 && 子1[数] >= 0 && 节型表[子1[数]] == 4)) { 中发(堆柒, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 数组[i].字段 存 64; R446: 结构体字段(=8B) + 调用 RHS 也 8 字节存 */
                        否 { 中发(前序, 0, 0, 0); 中刷(); } /* 第三阶段-中间表示 例十: 数组[i].字段 存 32 */
                        移寄存器(0, 3); /* 首子 = 已存 值 (链式 赋值) */
                        }
                    }
                } 否 若 (节型表[子0[微码]] == 13 || 节型表[子0[微码]] == 15) {
                    /* 嵌套 成员 写入: o.在.a = 表达式 / 子1.下一->数值 = 表达式 */
                    整 域尺寸 = 4, 构序出 = -1;
                    整 名集 = 0; /* 修复 2026-08-22 #34b: 嵌套 成员 结构体 字段整体赋值 (p->dm = t / o.在.a = s) — 原 域尺寸=16 落 否则 只存首4字节 */
                    若 (子1[数] >= 0 && (节型表[子1[数]] == 1 || 节型表[子1[数]] == 12 || 节型表[子1[数]] == 15 || 节型表[子1[数]] == 4 || 节型表[子1[数]] == 22 || (节型表[子1[数]] == 节点_二元 && 节值表[子1[数]] == 逗号))) { /* R535-e5: 两层链 (`o2.内.内 = (z=5, s)`) 实测走 **嵌套成员写入** 分支（S1+S5 命中）⟹ 守卫补 逗号 */ /* R450 (2026-09-26): 补 调用 RHS — 原 守卫 缺 4 ⟹ 探测块 整段 不执行 ⟹ 域尺寸/构序出 保持 初值 (4/-1) ⟹ 名集 恒 0 ⟹ >8B 深链 无 兜底 */
                        若 (内存地址(微码, &域尺寸, &构序出) == 0) {
                            若 (域尺寸 >= 8 && 构序出 >= 0 && 类型表[构序出].尺寸 >= 8) {
                                若 (节型表[子1[数]] == 1) {
                                    若 (变量型序((字*)(节名表 + 子1[数])) == 构序出 && 变量指元素((字*)(节名表 + 子1[数])) == 0) 名集 = 类型表[构序出].尺寸;
                                } 否 若 (节型表[子1[数]] == 4) {
                                    /* R450: 调用 RHS — 此处 **不** 探测 (内存地址(调用) 会 发射 调用 一次, 下方 再 发射 ⟹ 调用 执行 两次);
                                       改用 零副作用 的 调用构返() 拿 返回类型序, 与 链末 字段 类型 比对 ⟹ 供 >8B (sret) 情形 进 名集路径 */
                                    整 返序C = 调用构返(子1[数]);
                                    若 (返序C >= 0 && 类型表[返序C].尺寸 == 类型表[构序出].尺寸) 名集 = 类型表[构序出].尺寸;
                                } 否 若 (节型表[子1[数]] == 22) { /* R532: **构值三目 RHS** —— 零副作用 判定 (构序 已 记 在 节值表, 不 需 探测发射 ⟹ 避免 三目 求值 两次; 对照 R450 对 调用 RHS 用 调用构返 同旨) */
                                    整 三构T = 节值表[子1[数]] - 1;
                                    若 (三构T >= 0 && 三构T < 类型数 && 类型表[三构T].尺寸 == 类型表[构序出].尺寸) 名集 = 类型表[构序出].尺寸;
                                } 否 若 (子1[数] >= 0 && 节型表[子1[数]] == 节点_二元 && 节值表[子1[数]] == 逗号) { /* R535-e5: 逗号 RHS 零副作用判定 */
                                    整 逗构G = 表达式构序(子1[数]);
                                    若 (逗构G >= 0 && 类型表[逗构G].尺寸 == 类型表[构序出].尺寸) 名集 = 类型表[构序出].尺寸;
                                } 否 {
                                    整 高捌 = 0, 号简 = -1;
                                    若 (内存地址(子1[数], &高捌, &号简) == 0 && 高捌 == 类型表[构序出].尺寸) 名集 = 类型表[构序出].尺寸;
                                }
