                整 计丙 = 1;
                循环 (词型表[词位] == 左方) { 词位++; 整 维丙 = 0; 若 (常量表达式求值(&维丙)) { 计丙 *= 维丙 > 0 ? 维丙 : 1; } 否 { 循环 (词位 < 词容量 && 词型表[词位] != 右方 && 词型表[词位] != 词终) 词位++; } 若 (词型表[词位] == 右方) 词位++; }
                末午(变丙, 计丙, 8);
                定类型(构丙, 0, -1, -1);
                若 (变量数 > 0) 变量表[变量数 - 1].指元素尺寸 = 8; /* C76 (第 76 站) 同坑: 1D 非静态 指针数组 必须 显式 设 指元素尺寸 —— 否则 结构体元素 赋值卫士 把它当「值数组」走深拷贝 ⇒ c[0] 收到的是对象内容而非地址 ⇒ 空解引用 0xC0000005 */
                若 (可空本) { 整 序丙 = 查活变量(变丙); 若 (序丙 >= 0) { 变量表[序丙].变可空.tag = 可空值_有值; } } /* 指针数组 = 8B 槽 数组, 不走 可空 打包 */
