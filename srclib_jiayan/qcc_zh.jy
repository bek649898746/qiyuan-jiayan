        整 源辰 = 0;
        若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "register")) { 词位++; /* 存储类 寄存器: 忽略——局部变量本就放内存 (修复 2026-08-05: 曾 一 未定义 标识符 → 变量 永不 已登记 → 读取 0) */ }
