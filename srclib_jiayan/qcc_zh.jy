    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].正辰[计], 函)) { 整 值 = 0; 复制内存(&值, &类型表[构序].副优[计], 1); 返 值 != 0; } /* fix 2026-08-05: `int v; memcpy(&v,...,1)` left 3 garbage bytes → self-host flagged plain fields as double → comparisons went fp; v=0 zeroes the slot first */
