        标指浮(数, 域布, (字*)(节名表 + 域布)); /* *双精度-p → xmm0 */
        若 (域布 >= 0 && 节型别[域布] == 节点_变量 && 变量指深((字*)(节名表 + 域布)) >= 2) { /* C132 (2026-09-19 第 126 站): **解引用 结果 的 精确 类型码** —— `*pp` (pp 为 多级 指针) 的 值 仍 是 指针 ⟹ 按 A22 编码 记 其 指向: 基类 + 16*(指深-1) + 1.
           例: 双精度** ⟹ 节指元[*pp] = 4 + 16*1 + 1 = 21 (正是 C129 认「单级双精度指针」的码) ⟹ 消费端 ((*pp)[i]) 可判 浮. */
            整 基登子 = 变量基登((字*)(节名表 + 域布));
            若 (基登子 > 0) 节指元[数] = (基登子 - 1) + 16 * (变量指深((字*)(节名表 + 域布)) - 1) + 1;
        }
        返 数; }
    若 (词型表[词位] == 总零) { 词位++; 整 数 = 建节(17); 接子(数, 原级()); 返 数; }
    若 (词型表[词位] == 按位非) { 词位++; 整 数 = 建节(18); 接子(数, 原级()); 若 (子0[数] >= 0 && 节无符号[子0[数]]) 节无符号[数] = 1; /* D 位运算族 (2026-09-13): ~ 继承 操作数 无符号性 — 原 丢失 → (~0u)>>1 走 算术右移 (4294967295, gcc 2147483647). C 语义: ~x 类型 = 提升后 类型, 所以 继承. */ 返 数; } /* ~表达式 */
    若 (词型表[词位] == 加) { 词位++; 返 原级(); } /* unary plus: +表达式 = 表达式 — 修复 2026-08-30 生成器 s140/s153: 原无 加 分支 → +x 落回 -1 → 加() 当二元加 → 值翻倍 ((+0xFE3FL) → 2×0xFE3F, s140 g_373.末深) */
    若 (词型表[词位] == 减) { /* unary minus: -表达式 */
        词位++;
        /* -双精度-字面量: flip 该 IEEE 符号 位 于 解析 时间 (keeps -0.0 作为 a
           真 负 零; a 运行时 0.0 - x 将 轮 -0.0 到 +0.0) */
        若 (词型表[词位] == 终简) {
            整 序标 = 词值表[词位];
            若 (浮数 < 1024) { 现退[浮数] = 现退[序标]; 逆组[浮数] = 逆组[序标]; 现退[浮数] ^= 0x80000000; } /* 修复 2026-08-07: 512→1024 对齐镜像 (浮数∈[512,1024) 时原静默不写却 浮数++ → 垃圾 双精度) */
            若 (浮数 >= 8192) { 输出到文件(错误流, "[ERR] 双精度 字面量表满 (修复 2026-08-06 M3)\n"); 退出(1); }
            整 数 = 建节(终简); 节值表[数] = 浮数; 节浮标[数] = 1; 浮数++; 词位++; /* -双精度-字面量: 必须 是 marked 节浮标 (修复 2026-08-06) */
            返 数;
        }
        整 数 = 建节(2); 节值表[数] = 减; 接子(数, 建节(0)); 节值表[子0[数]] = 0; 整 首从一 = 原级(); 接子(数, 首从一); 若 (首从一 >= 0 && 节长标[首从一]) 节长标[数] = 1; 返 数; /* 修复 2026-08-21 #28: 一元负传播 邻辰 标记 — 否则 -0x7fffffffffffffffLL - 1 的后续减按 32 位 (INT64_MIN 宏错) */
    }
    若 (词型表[词位] == 串词) { 整 数 = 建节(0); 节值表[数] = 词值表[词位]; /* 字符串 索引 → treated 作为 立即数 遍 码生成器 */ 节型表[数] = 串词; 节型别[数] = 节点_串词; 词位++;
        循环 (词型表[词位] == 左方) { /* 字符串字面量下标 "abc"[i] (修复 2026-08-06: 原 串词 分支无 后缀 链 → 实参 `f("A"[0])` 解析卡在 `[` 死循环; 赋值场景留下未消费的 `[` 生成垃圾值) */
            词位++; /* [ */
            整 央 = 建节(14); 接子(央, 数); 整 阵玖乙 = 赋值级(); 接子(央, 阵玖乙); 若 (节型别[数] == 节点_变量 && 阵玖乙 >= 0 && 节型别[阵玖乙] == 节点_常数 && 闭包阵找((字*)(节名表 + 数)) >= 0) { /* A3: 括号/转型 副本 同 主后缀 */ 字 阵名乙[96]; 格式化到串(阵名乙, "%s[%d]", (字*)(节名表 + 数), 节值表[阵玖乙]); 整 阵拐乙 = 净挂(阵名乙); 若 (阵拐乙 >= 0) { 整 变央乙 = 建节(1); 复制内存((字*)(节名表 + 变央乙), 阵名乙, 64); 央 = 变央乙; } 否 { 格式化到串(错缓冲, "闭包数组: 槽 '%s' 未绑定 — 先 %s = 函 捕获 移动 (...); (号合.0 #211)", 阵名乙, 阵名乙); 发错误("A9005", 错缓冲); }  若 (节型别[数] == 节点_变量 && 阵玖乙 >= 0 && 节型别[阵玖乙] != 节点_常数 && 闭包阵找((字*)(节名表 + 数)) >= 0) { 格式化到串(错缓冲, "闭包数组: 下标 必须 是 编译期常量 (解析期 展开 无 运行时 闭包值) — '%s' (号合.0 #211)", (字*)(节名表 + 数)); 发错误("A9005", 错缓冲); } } 若 (词型表[词位] == 右方) 词位++; /* ] */
            数 = 央;
        }
        返 数; }
    返 -1;
}

静 整 乘法(空) { 整 数 = 原级(); 循环 (词型表[词位] == 乘 || 词型表[词位] == 除 || 词型表[词位] == 取余 || 词型表[词位] == 左移 || 词型表[词位] == 右移) { 整 丙 = 词型表[词位++]; 整 甲 = 建节(2); 节值表[甲] = 丙; 整 结 = 原级(); 接子(甲, 数); 接子(甲, 结); 若 ((丙 == 除 || 丙 == 取余) && 节点常量零(数) && 结 >= 0 && !表达式是否长(结) && !节浮标[结]) { 整 零节 = 建节(0); 节值表[零节] = 0; 节值表[甲] = 逗号; 子0[甲] = 结; 子1[甲] = 零节; } /* 阶段D 折叠 (2026-09-04 虾米): 0/X=0, 0%X=0 (X≠0; X=0 UB 同 gcc 折叠, 副作用保留经逗号 (X,0); 仅 32 位整数) */ 若 (丙 == 除 && 节点是否布尔(数) && !表达式是否长(数) && !节浮标[数] && 结 >= 0 && !表达式是否长(结) && !节浮标[结]) { 长 长 常量 = 0; 若 (节点常量值(结, &常量) && 常量 >= 2) { 整 左逗 = 建节(2); 节值表[左逗] = 逗号; 接子(左逗, 数); 接子(左逗, 结); 整 零节 = 建节(0); 节值表[零节] = 0; 节值表[甲] = 逗号; 子0[甲] = 左逗; 子1[甲] = 零节; } } /* 阶段D 折叠 (2026-09-05 虾米): (布尔0/1)/常量 = 0 (常量>=2, 整数除截断恒0) */ 若 (丙 == 右移 && 节点是否布尔(数) && !表达式是否长(数)) { 长 长 移位量 = 0; 若 (节点常量值(结, &移位量) && 移位量 >= 1) { 整 零节 = 建节(0); 节值表[零节] = 0; 节值表[甲] = 逗号; 子0[甲] = 数; 子1[甲] = 零节; } } /* 阶段D 折叠 (2026-09-05 虾米): 布尔(0/1) >> N = 0 (N>=1, 同 gcc 代数简化, 死除法链 商喂比较>>N 被掩码) */ 若 ((丙 == 乘 || 丙 == 除) && 数 >= 0 && 节型别[数] == 节点_常数 && 结 >= 0 && 节型别[结] == 节点_常数 && 节值表[结] == 0) { /* 2026-09-02 移除报错: 常量/0 按 C 语义发运行时除法(x86 陷阱, 同 gcc); 原探雷雷5 拦截误伤 csmith */ } /* 修复 2026-08-30 探雷雷5: 常量除零编译期拦截 — 仅分子分母都是字面量 (1/0, x 变量/表达式分母 0 放行: 生成器 生成大量 /0 UB 在死代码/未执行路径, 编译器 不拦, 拦截误伤 59 种子; 分子常量 = 必然执行, 拦) */ 若 (丙 == 乘 && 数 >= 0 && 节型别[数] == 节点_常数 && 结 >= 0 && 节型别[结] == 节点_常数 && !节长标[数] && !节长标[结] && !节无符号[数] && !节无符号[结]) { 长 长 结果 = (长 长)节值表[数] * (长 长)节值表[结]; 若 (结果 > 2147483647LL || 结果 < -2147483648LL) { /* 2026-09-02 移除报错: 常量乘法溢出按 C 回绕语义 (codegen 目标宽度截断, 同 gcc); 原 #33 拦截误伤 csmith */ } } /* 接入 2026-09-01 #33 溢出检查: 常量乘法溢出编译期拦截 — 仅双方纯有符号 32 位字面量 (无符号/64位/表达式 放行) */ 若 ((丙 == 乘 || 丙 == 除) && ((数 >= 0 && 节浮标[数]) || (结 >= 0 && 节浮标[结]))) 节浮标[甲] = 1; 若 (丙 == 左移 || 丙 == 右移) { 若 (表达式是否长(数)) 节长标[甲] = 1; } /* 修复 2026-08-29 生成器: 移位结果宽度=左操作数 — 原 表达式是否长(r) 也传播 → `x << (int8_t)六十四位无符号` 被标 邻辰 → 64 位移位 mod64 错 (s137 静默) */ 否 若 (表达式是否长(数) || (结 >= 0 && 表达式是否长(结))) 节长标[甲] = 1; /* 修复 2026-08-22 #31: 64-位 结果 节长标 于 解析 时间 */ 若 (右陆 && !语句表达式丢弃 && (丙 == 除 || 丙 == 取余) && !节浮标[甲] && 节值表[甲] == 丙 && !(结 >= 0 && 节型别[结] == 节点_常数 && 节值表[结] != 0)) {
    /* 第 221 站 (2026-09-21 · **C3 定案落地**): **错误联合函数内** 除零 ⟹ **返回固定错误码** (不终止).
       定案: 「除零 → 错误联合函数内 = 固定错误码; 普通函数内 = 保持终止」.
       构造: `{ 长整 __dz_N = <除数>; 若 (__dz_N == 0) 返回 打包{码=2147483647, tag=1}; <左> / __dz_N }`
         —— 块末表达式 = 块值 (L23574); 返回节点构造 镜像 `返 错 N;` (L11096: 建节(6) + 节值表=9001 + child1=tag).
       固定码 2147483647 (INT_MAX): 用户错码是「小池编号」, 不撞. 除数只求值一次 (经 __dz 变量). */
    整 行庚 = 行巳++;
    字 内庚[64]; 格式化到串(内庚, "__dz_%d_", 行庚);
    余乙(内庚);
    整 块庚 = 建节(5);
    { 整 元庚 = 建节(7); 复制内存((字*)(节名表 + 元庚), 内庚, 32); 接子(元庚, 结); 接子(块庚, 元庚); } /* 长整 __dz = 除数 */
    { 整 若庚 = 建节(8);
      { 整 条庚 = 建节(2); 节值表[条庚] = 高平;
        { 整 左庚 = 建节(1); 复制内存((字*)(节名表 + 左庚), 内庚, 32); 接子(条庚, 左庚); }
        { 整 零庚 = 建节(0); 节值表[零庚] = 0; 接子(条庚, 零庚); }
        接子(若庚, 条庚); }
      { 整 返庚 = 建节(6);
        { 整 码庚 = 建节(0); 节值表[码庚] = 2147483647; 接子(返庚, 码庚); }
        节值表[返庚] = 9001;
        { 整 壹庚 = 建节(0); 节值表[壹庚] = 1; 接子(返庚, 壹庚); }
        接子(若庚, 返庚); }
      接子(块庚, 若庚); }
    { 整 除庚 = 建节(1); 复制内存((字*)(节名表 + 除庚), 内庚, 32); 子1[甲] = 除庚; } /* 除法 的 除数 ⟹ __dz 变量 */
    接子(块庚, 甲);
    甲 = 块庚;
} 否 若 (!语句表达式丢弃 && (丙 == 除 || 丙 == 取余) && !节浮标[甲] && 节值表[甲] == 丙 && !(结 >= 0 && 节型别[结] == 节点_常数 && 节值表[结] != 0)) { 整 呼 = 建节(4); 接子(呼, 结); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 表达式是否长(结) ? "__qcc_div_check64" : "__qcc_div_check", 24); 接子(呼, 函); } 子1[甲] = 呼; } /* F2 根治 (2026-09-14): 原 逗号 包装 (检查(结), 甲) 致 除数 表达式 求值 两次 (副作用 双跑); 改 用 检查 返回 的 除数 本身 (单次 求值) */ /* F2 (2026-09-07): 运行时除零检查 — 整数除/取余 + 非丢弃 + 除数非编译期非零常数 → __qcc_div_check; 浮点除不查 (0.0 得 inf/nan 非陷阱) */ 数 = 甲; } 返 数; }
静 整 加法(空) { 整 数 = 乘法(); 循环 (词型表[词位] == 加 || 词型表[词位] == 减) { 整 丙 = 词型表[词位++]; 整 正退 = -1; 若 (初甲 > 0 && 节型别[数] == 节点_变量) { /* 接入 2026-08-27 运算符重载: 左操作数是 结构体 变量且注册过该运算符+类型 → 生成函数调用 (重载表空则零影响原路径) */ 整 构序 = 变量型序((字*)(节名表 + 数)); 若 (构序 >= 0) { 字 *行排 = 类型表[构序].名; 遍 (整 键 = 0; 键 < 初甲; 键++) 若 (重载表[键].符 == (字)丙 && !比较字符串(重载表[键].型名, 行排)) { 正退 = 键; 断; } } } 若 (正退 >= 0) { 整 结 = 乘法(); 整 字符 = 建节(4); 接子(字符, 数); 接子(字符, 结); { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), 重载表[正退].函名, 64); 接子(字符, 函); } 数 = 字符; } 否 { 整 甲 = 建节(2); 节值表[甲] = 丙; 整 结 = 乘法(); 接子(甲, 数); 接子(甲, 结); 若 ((丙 == 加 || 丙 == 减) && 数 >= 0 && 节型别[数] == 节点_常数 && 结 >= 0 && 节型别[结] == 节点_常数 && !节长标[数] && !节长标[结] && !节无符号[数] && !节无符号[结]) { 长 长 结果 = (丙 == 加) ? (长 长)节值表[数] + (长 长)节值表[结] : (长 长)节值表[数] - (长 长)节值表[结]; 若 (结果 > 2147483647LL || 结果 < -2147483648LL) { /* 2026-09-02 移除报错: 常量加减溢出按 C 回绕语义 */ } } /* 接入 2026-09-01 #33 溢出检查: 常量加减溢出编译期拦截 — 仅双方纯有符号 32 位字面量 */ 若 ((丙 == 加 || 丙 == 减) && ((数 >= 0 && 节浮标[数]) || (结 >= 0 && 节浮标[结]))) 节浮标[甲] = 1; 若 (表达式是否长(数) || (结 >= 0 && 表达式是否长(结))) 节长标[甲] = 1; /* 2026-09-04 虾米: 加减结果长标传播 (镜像 乘法; 原缺 → 8B 成员算术按 32 截断) */ 数 = 甲; } } 返 数; } /* t35m 2026-08-24: 按位 & ^ | 从加减层拆出 — C 优先级 (| 最低, ^ 中, & 最高; htonl(x) = (x&0xff)<<24 | (x>>24)&0xff 原 & 与 | 同级左结合 → 整体 &0xff → pack 序标 魔数检查失败 → pack 对象读取失败) */
静 整 宽捌(空) { 整 数 = 加法(); 循环 (词型表[词位] == 点) { 词位++; 整 甲 = 建节(2); 节值表[甲] = 点; 整 结 = 加法(); 接子(甲, 数); 接子(甲, 结); 若 (节点常量零(结) && !表达式是否长(数) && !节浮标[数]) { 整 零节 = 建节(0); 节值表[零节] = 0; 节值表[甲] = 逗号; 子0[甲] = 数; 子1[甲] = 零节; } /* 阶段D 折叠 (2026-09-04 虾米): X & 0 = 0 (X 副作用保留经逗号 (X,0), 同 gcc 代数简化) */ 数 = 甲; } 返 数; }
