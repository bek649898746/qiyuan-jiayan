    } 否 若 (块延迟深 > 0) { 块延迟深--; } /* 函数体块: 弹出不刷 (长复 统一执行, 返 号寅 刷新) */
    节值表[末重] = 变量数 + 1; /* 块 结束 变量 边界 遍 码生成器 作用域 (修复 2026-08-16: 兄弟-块 局部 影子 earlier 块) */
    遍 (整 邻挂 = 缓申; 邻挂 < 变量数; 邻挂++) 若 (变量表[邻挂].旧零 == 0) { 变量表[邻挂].内薄 = 缓申; 变量表[邻挂].旧零 = 变量数; } /* 修复 2026-08-19: 本块直接声明的变量 块 范围 = 本块 [开始,结束) (嵌套块变量已标记, 保持其块内作用域) */
    虚三 = 终降一; /* 恢复外层块 (复合 字面量, 修复 2026-08-11) */
    解析深--; /* 资源护栏 9b (2026-08-28): 块递归深度出栈 */
    型定数 = 型定旧; 深平 = 深平旧; /* P3-7b (2026-09-11): 类型别名 作用域 — 出块 截断 本块内注册的别名 (块外 不可见; 同名 不再 被 内层 长期 顶替) */
    返 末重;
}

/* 接入 2026-08-28 可吞清单 阶段零-7: 契约审判 — 前置/后置 子句表 (函 名键, 声明在顶部) + 检查语句构建器
   前置=入口检查 (解析期脱糖成 若(!目辰){格式化打印;出口;} 包函数体首), 后置=出口检查 (代码生成期 尾声 注入, 返回 占位=返回值) */
静 整 中柒(常 字 *函) { 遍 (整 计 = 0; 计 < 左五; 计++) 若 (!比较字符串(段分[计].函, 函)) 返 计; 返 -1; }
/* 接入 2026-08-28 可吞清单 阶段零-8: 结构契约审判 — 接口级哈希 (Turn 接口级审判 编译器 版): 契约 结构体 名 → 规范描述符 SHA256 (确定性接口指纹, 外部数据过 Schema 才能绑定) */
静 整 总六一(常 字 *数) { 整 构序一 = 查类型(数); 返 (构序一 >= 0 && 类型表[构序一].契约印[0]) ? 构序一 : -1; } /* A3-契约指纹 (2026-09-12): 键 = 构序 (真结构), 指纹非空 即 已登记; 原 线性扫 名键侧表 整伴[] */
静 整 深散(常 字 *数) { /* 契约 P; — 登记 结构体 P 为契约类型 + 计算描述符哈希 (名:总大小:字段名:偏移:大小[:指针/数组], 声明序, 确定性) */
    若 (总六一(数) >= 0) 返 0;
    整 构序 = 查类型(数);
    若 (构序 < 0) { 输出到文件(错误流, "[ERR] 契约: 未知结构体 '%s' (须先定义 结构体 %s)\n", 数, 数); 返 -1; }
    字 主回[4096]; 整 丁序 = 0;
    丁序 += 格式化到串(主回 + 丁序, "%s:%d:", 数, 类型表[构序].尺寸);
    遍 (整 文件 = 0; 文件 < 类型表[构序].函 && 丁序 < 3900; 文件++) {
        丁序 += 格式化到串(主回 + 丁序, "%s:%d:%d%s,", 类型表[构序].字段[文件].正辰, 类型表[构序].字段[文件].正聚, 类型表[构序].字段[文件].现捌, 类型表[构序].字段[文件].原进 ? ":p" : "");
    }
    字 首一[65]; 深伴(主回, 丁序, 首一);
    复制字符串(类型表[构序].契约印, 首一); /* A3-契约指纹: 写 真结构 (容量 由 类型表 4096 天然 限, 原 64 条 上限 + 静默/报错 分支 一并 消失) */
    返 0;
}
静 整 现再(整 空高, 整 消息串) { /* 若(!条件){ 格式化打印(消息); 出口(1); } — 复用 保证/断言 右对 模式 */
    整 右对 = 建节(2); 节值表[右对] = 比等; 接子(右对, 空高); { 整 零 = 建节(0); 节值表[零] = 0; 接子(右对, 零); }
    整 若序 = 建节(8); 接子(若序, 右对);
    整 体 = 建节(5);
    整 呼参 = 建节(4); { 整 符号数 = 建节(0); 节值表[符号数] = 消息串; 节型表[符号数] = 串词; 节型别[符号数] = 节点_串词; 接子(呼参, 符号数); } { 整 缓进 = 建节(1); 复制内存((字*)(节名表 + 缓进), "printf", 7); 接子(呼参, 缓进); }
    接子(体, 呼参);
