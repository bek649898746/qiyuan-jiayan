                    否 若 (缺伍 < 0) { 缺伍 = 赋值级(); /* 修复 步三十一: 真 变长数组 — 维度表达式转 抽象语法树 节点, 声明处求值动态分配 (原跳过维度名当 1 元素数组 → 越界) */ }
                    否 { 循环 (词位 < 词容量 && 词型表[词位] != 右方 && 词型表[词位] != 词终) 词位++; } /* 多维 变长数组 第二维+: 跳过 (记录限制) */
                    若 (词型表[词位] == 右方) 词位++;
                }
                /* 修复 2026-08-05: 空玖 数组 `整数 a[] = {1,2,3}` / `字符 *名[] = {...}`
