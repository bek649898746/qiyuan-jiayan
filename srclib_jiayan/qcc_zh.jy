              整 邮箱标 = 建节(14); 接子(邮箱标, 邮箱值B); 接子(邮箱标, 邮箱暂);
              整 邮箱赋 = 建节(10); 接子(邮箱赋, 邮箱标); 接子(邮箱赋, 邮箱值); 接子(邮箱增, 邮箱赋); } /* buf[t] = v */
            { 整 邮箱壹 = 建节(1); 复制内存((字*)(节名表 + 邮箱壹), 邮箱T, 32);
              整 邮箱壹节 = 建节(0); 节值表[邮箱壹节] = 1;
              整 邮箱加 = 建节(2); 节值表[邮箱加] = 加; 接子(邮箱加, 邮箱壹); 接子(邮箱加, 邮箱壹节);
              整 邮箱堆 = 建节(1); 复制内存((字*)(节名表 + 邮箱堆), 邮箱Cap, 32);
              整 邮箱号 = 建节(2); 节值表[邮箱号] = 取余; 接子(邮箱号, 邮箱加); 接子(邮箱号, 邮箱堆);
              整 邮箱赋 = 建节(10); 接子(邮箱赋, 邮箱壹); 接子(邮箱赋, 邮箱号); 接子(邮箱增, 邮箱赋); } /* t = (t+1)%cap */
            { 整 邮箱高 = 建节(1); 复制内存((字*)(节名表 + 邮箱高), 邮箱C, 32);
              整 邮箱壹节 = 建节(0); 节值表[邮箱壹节] = 1;
              整 邮箱加 = 建节(2); 节值表[邮箱加] = 加; 接子(邮箱加, 邮箱高); 接子(邮箱加, 邮箱壹节);
              整 邮箱赋 = 建节(10); 接子(邮箱赋, 邮箱高); 接子(邮箱赋, 邮箱加); 接子(邮箱增, 邮箱赋); } /* c++ */
            接子(邮箱若, 邮箱增);
            接子(邮箱块, 邮箱若);
            返 邮箱块;
        }
        整 初厚 = 赋值级(); /* 邮箱表达式 (回退 actor_send) */
        若 (词型表[词位] == 逗号) 词位++; /* , */
        整 间壹 = 赋值级(); /* 消息表达式 */
        若 (词型表[词位] == 分号) 词位++; /* ; */
        整 呼 = 建节(4);
        { 整 地址 = 建节(11); 接子(地址, 初厚); 接子(呼, 地址); } /* &m */
        接子(呼, 间壹); /* v */
        { 整 函 = 建节(1); 复制内存((字*)(节名表 + 函), "actor_send", 11); 接子(呼, 函); } /* 被调者 最后 */
        返 呼;
    }
    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "接收")) { /* 接入 2026-08-27 actor 消息接收; 2026-09-01 #19 语言级邮箱: 接收 名, v; → 内联出队 (若 __ac_名_buf 已声明), 否则回退 actor_recv(&m, &v) */
        糖目标放行(词位 + 1); /* D12R456 */
        词位++; /* 接收 */
        字 邮箱名[64]; 复制字符串(邮箱名, 词名表[词位]);
        字 邮箱Buf[80]; 格式化到串(邮箱Buf, "__ac_%s_buf", 邮箱名);
        若 (查变量(邮箱Buf) >= 0) { /* #19: actor 邮箱已声明 → 内联出队 (仿 收 通道) */
            词位++; /* 邮箱名 */
            若 (词型表[词位] == 逗号) 词位++; /* , */
