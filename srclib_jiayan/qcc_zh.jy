                循环 (字节一 > 0 && 段[字节一] == '*') { 字节一--; 循环 (字节一 > 0 && (段[字节一] == ' ' || 段[字节一] == '\t' || 段[字节一] == '\r' || 段[字节一] == '\n')) 字节一--; } /* 跳过指针返回类型 char *_(...) — 否则 gettext.h 的 static inline _ 被当宏调用展开 (fix 2026-08-15: undefined symbol '_') */
                整 整伍 = 0;
