            返 1;
        }
    若 (词型表[词位] == 词变量 && 词型表[词位 + 1] == 左括) { /* #68 模板元编程: 编译期求值 函数调用 — 递归/嵌套调用 (阶乘/斐波那契 等纯函数) */
        字 升升[64]; 复制字符串(升升, 词名表[词位]);
        整 存位 = 词位;
        词位 += 2; /* 跳过 名 ( — 中属 期望 词位 在实参开始 */
        整 值 = 0;
        若 (中属(升升, &值)) { *数值 = 值; 返 1; } /* 成功: 词位 已在 ) 后 */
