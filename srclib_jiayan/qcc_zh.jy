静 空 尾写路径(常 字 *值, 常 字 *路径) { 若 (!路径 || !路径[0]) 返; 整 计 = 尾索(值); 若 (计 < 0 || 变量表[计].就绪全 <= 0) 返; 若 (!尾路径有(计, 路径)) 若 (变量表[计].就绪路数 < 4) { 复制字符串(变量表[计].就绪路[变量表[计].就绪路数], 路径); 变量表[计].就绪路数++; } 否 静默计(0, "字段路径.表满(4)-该路径未登记-读侧已保守放行"); /* R241: 溢出 报警 (原 静默丢弃) */ 整 点一 = -1; 遍 (整 检 = 0; 路径[检]; 检++) 若 (路径[检] == '.') { 点一 = 检; 断; } 若 (点一 <= 0 || 点一 >= 31) 返; 字 父名[32]; 遍 (整 检 = 0; 检 < 点一; 检++) 父名[检] = 路径[检]; 父名[点一] = 0; 整 序构 = (计 >= 0 && 计 < 65536) ? 变量表[计].型序标 : -1; 若 (序构 < 0) 返; 整 子序 = 字段类型序直(序构, 父名); 若 (子序 < 0) 返; 整 子全 = 尾可见字段(子序); 若 (子全 <= 0) 返; 若 (类型表[子序].是否联) { 尾写字段(值, 父名); 返; } /* H1o: 父 字段 是 联合 → 任 一 成员 写 即 该 字段 整体 完成 (成员 重叠) */ 整 子数 = 0; 遍 (整 检 = 0; 检 < 变量表[计].就绪路数; 检++) { 字 *路 = 变量表[计].就绪路[检]; 整 齐 = 1; 遍 (整 检四 = 0; 父名[检四]; 检四++) 若 (路[检四] == 0 || 路[检四] != 父名[检四]) { 齐 = 0; 断; } 若 (!齐 || 路[点一] != '.') 续; 整 层 = 0; 遍 (整 检三 = 点一 + 1; 路[检三]; 检三++) 若 (路[检三] == '.') 层 = 1; 若 (!层) 子数++; } 若 (子数 >= 子全) 尾写字段(值, 父名); } /* I2-③ 嵌套: 记成员路径 + 子结构完成判定 (f.* 覆盖 f 型 全部可见字段 → f 视为整写; 支持 逐字段写满子结构 后 整体使用/移出) */
