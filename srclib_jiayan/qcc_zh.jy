                            { 整 计活 = 查活变量(词名表[词位]); 若 (计活 >= 0) 移标[计活].tag = 移态_已移; 否 若 (正次 < 2048) { 复制字符串(域六[正次++].路径, 词名表[词位]); 域六[正次 - 1].别.tag = 域路型_域路简; 域六[正次 - 1].基 = -1; } }
                        }
