静 字 *外午[64]; 静 整 符捌; 静 字 *当联; 静 字 *宽凶; /* fix 2026-08-26 cpython/sqlite: fn_macro_expand_to 的 args/exp_args 大缓冲从栈移到堆竞技场 — 16×4096×2=128KB/层 × 递归嵌套 (sqlite3.c 深展开) 爆 1MB 栈 (0xC00000FD); args/exp_args 只在 tmp 构建前存活, 递归前可释放复用. 块链表: 块永不移动, 存活帧的 args/exp_args 裸指针不过期 (单块 realloc 移动基址 → 旧指针失效 → memcpy 写已释放块 → sqlite3.c 0xC0000005); 释放后区域复用, 峰值=最大并发嵌套 */
静 空 *净戌二(整 数) {
    若 (!符捌) {
        外午[0] = 内存分配(4 << 20);
        若 (!外午[0]) { 输出到文件(错误流, "[ERR] OOM fn_arena\n"); 退出(1); }
        当联 = 外午[0];
        宽凶 = 外午[0] + (4 << 20);
        符捌 = 1;
    }
    若 (当联 + 数 > 宽凶) {
        若 (符捌 >= 64) { 输出到文件(错误流, "[ERR] fn_arena blocks overflow\n"); 退出(1); }
        整 新三 = 8 << 20;
        外午[符捌] = 内存分配(新三);
        若 (!外午[符捌]) { 输出到文件(错误流, "[ERR] OOM fn_arena\n"); 退出(1); }
        当联 = 外午[符捌];
        宽凶 = 当联 + 新三;
        符捌++;
    }
    空 *结 = 当联; 当联 += 数;
    返 结;
}
静 空 直亥(字 *记) { 当联 = 记; } /* LIFO: 释放到 mark (块链表块永不移动, 裸指针永有效); 首建场景 mark=NULL → 下轮 alloc 新建块 (一次性 4MB 浪费, 可接受) */

静 空 副组(常 字 *段, 字 **出指, 整 *丙, 整 *容量, 整 列陆) {
    字 *出 = *出指;
    若 (余厚 == 0) 遍 (整 键 = 0; 键 < 函数宏数; 键++) 缺亥一[键] = 0; /* fix 2026-08-26 sqlite: 顶层扫描从空激活集开始, 遇 #define 激活, 遇 #undef 停用 */
    余厚++;
    整 入串 = 0; /* 顶层串内逐字复制 (fix 2026-08-07: 字符串字面量里的 NAME( 不展开) */
    遍 (整 计 = 0; 段[计]; ) {
