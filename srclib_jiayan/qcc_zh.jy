        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 净繁, 32); 接子(元, 行粗); 接子(块, 元); } /* int __cl = cols; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 内名, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(块, 元); } /* int __fl = 0; */
        { 整 元 = 建节(7); 复制内存((字*)(节名表 + 元), 链排, 32); { 整 零 = 建节(0); 节值表[零] = 0; 接子(元, 零); } 接子(块, 元); } /* int __fr = 0; */
        整 环节 = 建节(9);
