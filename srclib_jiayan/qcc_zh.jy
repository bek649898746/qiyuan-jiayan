/* 平台符号桥 (批3b/3c): 中文名 = DLL 符号 — 机器码层面的地址数据, 预处理层展开
   (词法器反向条目供用户程序使用) */
#define 错误流 stderr
#define 输出流 stdout
#define 输入流 stdin
#define 跳过于 若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "于")) 词位++; /* R559 (2026-09-30) 批次 B 第二簇**收口**: 6 处「关键字 `于` 消费」抽为**文本宏**; 纯文本展开 ⟹ 与原文逐字相同 ⟹ 产物哈希恒等（同 R558 手法） */
#define 型词尺寸壹 若 (词型表[词位] == 型词) { 循环 (词型表[词位] == 型词 && (!比较字符串(词名表[词位], "const") || !比较字符串(词名表[词位], "常"))) 词位++; 若 ((!比较字符串(词名表[词位], "char") || !比较字符串(词名表[词位], "字") || !比较字符串(词名表[词位], "字节")) || !比较字符串(词名表[词位], "_Bool")) 新尺寸 = 1; 否 若 ((!比较字符串(词名表[词位], "double") || !比较字符串(词名表[词位], "双"))) { 新尺寸 = 8; 字段浮待 = 1; } 否 若 ((!比较字符串(词名表[词位], "float") || !比较字符串(词名表[词位], "单"))) { 字段浮待 = 1; } /* A62 */ 否 若 ((!比较字符串(词名表[词位], "long") || !比较字符串(词名表[词位], "长") || !比较字符串(词名表[词位], "长整")) && 词型表[词位 + 1] == 型词 && (!比较字符串(词名表[词位 + 1], "long") || !比较字符串(词名表[词位 + 1], "长") || !比较字符串(词名表[词位 + 1], "长整"))) 新尺寸 = 8; 若 (!(词型表[词位] == 结构词 || 词型表[词位] == 枚词)) 词位++; 新基 = 新尺寸; 循环 (词型表[词位] == 乘) { 新尺寸 = 8; 指元素二++; 词位++; } } /* R558 (2026-09-30) 批次 B「类型词 ⟹ 尺寸」**收口**: 6 处逐字相同**平衡块**（L4837/4873/18677/18804/18841/19178 · 679 字符）抽为**文本宏** —— ⚠️ 417/418 已证「抽成**函数调用**」在解析期**不等价**；本刀用 `#定义`（纯文本展开，展开后与原文逐字相同）⟹ 零行为变更。⚠️ 段必须**括号平衡**（417 的 578 字符段不平衡 ⟹ 括号配对崩）*/
#define 取环境 getenv
#define 判十六进制 isxdigit
#define 格式化限长 snprintf
#define 取指数 exp



/* 可执行格式 魔数（工程化：语义等价 #定义，不动点 哈希 不变；修复 2026-08-05） */
#define 单亥 0x200
#define 号己 0x400000
/* BSS 分离 (修复 2026-08-25): .数据 文件只需写导入表+堆 计数器 (~0x2B0), 
   堆/栈/未初始化 静态 全由 加载器 按 虚拟尺寸 清零 (BSS 语义) — 可执行 从 454兆字节→3.2兆字节.
   原始数据尺寸 固定一页 (0x1000) 覆盖导入表; 虚拟尺寸 不变 (兼容所有虚拟地址). */
#define 首厚一 0x2000
#define 名聚 0x1100 /* 静态 起点后移：给扩展导入区（导入表 128+ILT 128+主回+名 至 ~0x810）让位（2026-08-28 类型-根-15 #41: 0x800→0x900 — 内核库 15 槽 名 区 0x80B 溢出 11B 压 静态 → DLL_NOT_FOUND; 修复 2026-08-06 缺陷-1; 2026-08-25 math21 0x300→0x400; 步五 0x400→0x600; 步九 0x600→0x800） */
#define 半九 0x300000
#define 码缓容量 0x2000000
