                整 寻 = 深乙 + 5;
                循环 (串值[寻] == ' ' || 串值[寻] == '\t') 寻++;
                字 存申[64]; 整 逆肆 = 0;
                循环 (判字母数字((无 字)串值[寻]) || 串值[寻] == '_' || ((无 字)串值[寻] >= 0x80)) { 若 (逆肆 < 63) 存申[逆肆++] = 串值[寻]; 寻++; }
                存申[逆肆] = 0;
                若 (逆肆 > 0) { 缺得(存申); 列伴(存申); }
                循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') 计 += 2; 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') 计 += 3; 否 计++; } /* fix 2026-08-26 lua: 续行感知 (同上) */
                续;
            }
            若 (内戊) {
                { 字 帧薄[64]; 整 段伴 = 0; 毛简(串值 + 计, 帧薄, &段伴); 若 (帧薄[0]) 首丙一(帧薄, 段伴); } /* 顺序定义表: #ifdef 判断用 */
                整 指 = 深乙 + 6;
                循环 (串值[指] == ' ' || 串值[指] == '\t') 指++;
                字 名存[64]; 整 名序 = 0;
                循环 (判字母数字((无 字)串值[指]) || 串值[指] == '_' || ((无 字)串值[指] >= 0x80)) { 若 (名序 < 63) 名存[名序++] = 串值[指]; 指++; }
                名存[名序] = 0;
                 
                若 (名存[0] && 串值[指] != '(') { /* 非函数宏 → 对象宏候选; fix 2026-08-13 Phase3: ( 必须紧贴名字才算函数宏 */
                    循环 (串值[指] == ' ' || 串值[指] == '\t') 指++;
