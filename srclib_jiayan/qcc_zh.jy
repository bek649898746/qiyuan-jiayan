    若 (块延迟深 > 1 && 标繁 >= 0) { /* 阶段C-1 #53 块级延迟 (2026-09-01): 嵌套块自然退出 → LIFO 追加本块延迟到块体 + 清除 (返 由 号寅 刷新, 长复 跳过已清除) */
        整 入 = 块延迟栈[--块延迟深];
