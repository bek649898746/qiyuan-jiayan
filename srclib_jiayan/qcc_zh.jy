                    }
                }
                循环 (串值[指] && 串值[指] != '\n') { 若 (串值[指] == '\\' && 串值[指 + 1] == '\n') 指 += 2; 否 若 (串值[指] == '\\' && 串值[指 + 1] == '\r' && 串值[指 + 2] == '\n') 指 += 3; 否 指++; } /* fix 2026-08-26 lua: 续行感知 — #define 反斜杠续行整逻辑行跳过 (值含 " 的宏体不被泄漏进 scan) */
                计 = 指;
            }
        }
    }
}

静 空 行申(常 字 *串值) {
    函数宏数 = 0;
    条件编译数 = 0; 外系 = 0; /* 条件编译栈重置 (fix 2026-08-07) */
