    /* %llX: 64-位 大写 十六进制 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 244); /* 首子 = 高复 */
    移即(1, 2); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8C); 发四(0); 补标号(码位-4, 尾利, 10); /* 比较 首子,2; jl 尾利 */
    长劣(); /* 堆九 = [r13] (64-位) */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移64(3, 0); /* rbx = 64-位 值 */
    实厚(容低, 1); /* %llX 大写 */
    设标号(尾利);
    行退(); /* 首子 = [r13] */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移寄存器(3, 0); /* ebx = 值 */
    首升(容低, 1, 'X'); /* 修复 2026-08-09 审计#7: %#X 前缀 + 宽度填充 */
    设标号(反挂一); /* %u: 无符号 十进制 (修复 2026-08-05) */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 规格 字符) */
    /* %llu: 64-位 无符号 十进制（修复 2026-08-06）— 域+244 >= 2 → 64 位路径 */
    移寄存器帧(0, 临时基 - 当前帧大小 + 244); /* 首子 = 高复 */
    移即(1, 2); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8C); 发四(0); 补标号(码位-4, 满寅三, 10); /* 比较 首子,2; jl 满寅三 (小跳) */
    长劣(); /* 堆九 = [r13] (64-位) */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移64(3, 0); /* rbx = 64-位 值 */
    堆轮(容低); /* %llu: 打印 rbx 64 位 无符号, 返回 到 堆平 循环 */
    设标号(满寅三);
    行退(); /* 首子 = [r13] */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移寄存器(3, 0); /* ebx = 值 */
    宽七(容低);
    /* %o: 无符号 八进制 (修复 2026-08-22 t47: 原当未知说明符跳过不消费参数 → 版本库 暂双-文件 -s 参数错位 段错误) */
    设标号(链劣);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 'o') */
    行退(); /* 首子 = [r13] */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    移寄存器(3, 0); /* ebx = 值 */
    池组(容低);
    /* %f: 双精度 实参 -> 整数 部分 经 ldnum, 则 '.' + 6 小数 数字 */
    设标号(高癸);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 'f') */
    逆排(); /* 双精度移动 xmm0, [r13] (扩展前缀.B - [rbp+0] 将 读取 该 已存 rbp!) */
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); /* 加 r13, 8 */ }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); /* 减 r13, 8 */ }
    {
        整 域 = 临时基 - 当前帧大小;
        余申(域 + 192);      /* 保存 v */
        移即(0, 0); 移帧寄存器(域 + 20, 0); /* A38: 清 延后 符号 槽 (否则 上 一 次 %f 的 '-' 会 泄漏 到 本 次 正数) */
        /* 负 v (incl. -0.0): 打印 '-' 则 negate. comisd treats -0.0==0.0, 故
           检查 该 IEEE 符号 位 而: movq 堆九,xmm0; 位测试 堆九,63 -> CF = 符号 */
        逆厚(域 + 192);      /* xmm0 = v */
        汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq 堆九, xmm0 */
        汇发("    测试位 r0, 63\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,0); 发字节(0x0F); 发字节(0xBA); 发字节(0xE0); 发字节(0x3F); /* 位测试 堆九, 63 */
        发字节(0x0F); 发字节(0x83); 发四(0); 补标号(码位 - 4, 旧分, 7); /* jae 旧分: 符号 明确, 保持 */
        移即(0, 45); 移帧寄存器(域 + 20, 0); /* A38: 记 符号 '-' (45) — 符号 延后 到 填充 阶段 打 (C 语义: 空格 填充 要 在 符号 之前) */
        移即(0, 1); 移帧寄存器(域 + 4, 0); /* A38: 符号完成 = 1 — 域重一 见 此 即 只 打 数字 */ /* 递增 r12 */
        堆双(域 + 192);       /* xmm1 = v */
        移即(0, 0); 旧挂(); /* xmm0 = 0.0 */
        整进();               /* xmm0 = 0.0 - v = -v */
        余申(域 + 192);       /* 保存 |v| */
        设标号(旧分);
        移寄存器帧(0, 域 + 4); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 壬符, 1); /* A38: 已 打 '-' → 不 再 加 '+' */
        移寄存器帧(0, 域 + 0); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬符, 1);   /* A38: plus 标志 未 置 → 跳过 */
        移即(0, 43); 移帧寄存器(域 + 20, 0); /* A38: 记 符号 '+' (43), 延后 打 */
        移即(0, 1); 移帧寄存器(域 + 4, 0); /* 符号完成 = 1 */
        设标号(壬符);
        /* 修复 2026-08-26: %f 的 无穷/非数 检测 — 原 cvttsd2si 对 无穷/非数 返回 INT_MIN 输出垃圾;
           统一输出 "无穷"/"nan". 指数位全 1 → 内寅; 正常值 回落-经 (xmm0 未 破坏). */
        汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq 堆九, xmm0 */
        发字节(0x48); 发字节(0xC1); 发字节(0xE8); 发字节(52);                /* 右移 堆九, 52 */
        发字节(0x25); 发四(0x7FF);                              /* 且 首子, 0x7FF */
        发字节(0x3D); 发四(0x7FF);                              /* 比较 首子, 0x7FF */
        发字节(0x0F); 发字节(0x84); 发四(0); 补标号(码位 - 4, 内寅, 8); /* 等跳 内寅 (无穷/非数) */
        长对();                            /* A37 (2026-09-12): 堆九 = (六十四位整数)|v| — 原 32 位 cvttsd2si → |v| >= 2^31 时 得 INT32_MIN → 整数 部分/分数 全 垃圾 (实测 %f 打印 -2147483647.000000) */
        移64(3, 0);                        /* rbx = 整数 部分 (64 位) */
        移64(0, 3); 发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2A); 发字节(0xC0); /* xmm0 = (双精度)整数 (64 位 → 双) */
        /* A38 (2026-09-12): 总 长度 = 符号(0/1) + 整数 位数 + (N>0 ? 1+N : 0), 再 按 W 打 前缀 填充 (零/空格) */
        移64(0, 3); 移即(1, 1); 移帧寄存器(域 + 16, 1);       /* rax = |整数|; 长度 初值 = 1 (0 也 是 一 位) */
        设标号(壬位);
        移即(1, 10);         汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2);  汇发("    除64 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 发字节(0xF1); /* div rcx: 堆九 = 堆九/10 */
        汇发("    测试64 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x85); 模字节(3, 0, 0); 零跳(-1); 补标号(码位 - 4, 壬毕, 1); /* 商 == 0 → 数完 */
        移寄存器帧(1, 域 + 16); 移即(2, 1); 算寄存器(高拾, 1, 2); 移帧寄存器(域 + 16, 1); /* 长度++ */
        相对跳转(-1); 补标号(码位 - 4, 壬位, 2);
        设标号(壬毕);
        移寄存器帧(0, 域 + 16); 移寄存器帧(1, 域 + 4); 算寄存器(高拾, 0, 1); 移帧寄存器(域 + 16, 0); /* + 符号 */
        移寄存器帧(0, 域 + 224); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬小, 1); /* N == 0 → 无 小数 部分 */
        移寄存器帧(0, 域 + 16); 移寄存器帧(1, 域 + 224); 移即(2, 1); 算寄存器(高拾, 1, 2); 算寄存器(高拾, 0, 1); 移帧寄存器(域 + 16, 0); /* + '.' + N */
        设标号(壬小);
        移寄存器帧(0, 域 + 232); 移寄存器帧(1, 域 + 16); 算寄存器(旧肆, 0, 1); 移帧寄存器(域 + 24, 0); /* pad = W - 长度 */
        移寄存器帧(0, 域 + 252); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬右, 1); /* A40e (2026-09-12): 非 左对齐 → 壬右 (三段式 填充); 左对齐 → 先 打 符号 再 数字 (原 直接 跳 壬填 → 左对齐 负数 丢 符号: "[%-8.2f]" of -3.14 得 "[3.14   ]" 应 "[-3.14   ]") */
        移寄存器帧(0, 域 + 20); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬填, 1); /* 无 延后 符号 → 直接 数字 */
        存字节十二();         汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
        移即(0, 1); 移帧寄存器(域 + 4, 0); /* 符号完成 = 1 */
        相对跳转(-1); 补标号(码位 - 4, 壬填, 2);
        设标号(壬右);
        /* ① 空格 填充 (未 置 零填充): 打 在 符号 之前 (C 语义 "    +2.5") */
        移寄存器帧(0, 域 + 264); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 壬符二, 3); /* 零填充 → 跳过 本 阶段 */
        移寄存器帧(0, 域 + 24); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位 - 4, 壬符二, 6); /* pad <= 0 → 跳过 */
        设标号(壬环);
        移即(0, ' '); 存字节十二();         汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
        移寄存器帧(1, 域 + 24); 移即(2, 1); 算寄存器(旧肆, 1, 2); 移帧寄存器(域 + 24, 1); /* pad-- */
        移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 壬环, 3);
        设标号(壬符二);
        /* ② 符号 (若 有) */
        移寄存器帧(0, 域 + 20); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬零二, 1);
        存字节十二();         汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
        设标号(壬零二);
        /* ③ 零填充: 打 在 符号 之后 (C 语义 "+0002.5") */
        移寄存器帧(0, 域 + 264); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬填, 1); /* 未 置 零填充 → 完 */
        设标号(壬零);
        移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬填, 1); /* pad == 0 → 完 */
        移即(0, '0'); 存字节十二();         汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
        移寄存器帧(1, 域 + 24); 移即(2, 1); 算寄存器(旧肆, 1, 2); 移帧寄存器(域 + 24, 1); /* pad-- */
        相对跳转(-1); 补标号(码位 - 4, 壬零, 2);
        设标号(壬填);

        短弊();               /* xmm1 = (双精度)整数 */
        逆厚(域 + 192);       /* xmm0 = v */
        整进();               /* xmm0 = v - 整数 = 分数 (有符号) */
        余申(域 + 200);       /* 保存 分数 */
        移即(0, 0); 旧挂(); /* xmm0 = 0.0 */
        短弊();               /* xmm1 = 0.0 */
        逆厚(域 + 200);       /* xmm0 = 分数 */
        值凶();              /* 标志: 分数 长简 0 (CF = 分数 < 0) */
        发字节(0x0F); 发字节(0x83); 发四(0); 补标号(码位 - 4, 首分一, 7); /* jae 首分一: 分数 >= 0, 保持 */
        新劣();               /* xmm0 = 0.0 */
        堆双(域 + 200);       /* xmm1 = 分数 */
        整进();               /* xmm0 = -分数 */
        设标号(首分一);
        余申(域 + 200);       /* 保存 |分数| */
        /* 已舍入 N-数字 小数: 分数编号 = trunc(|分数|*毛简一 + 0.5); 毛简一 = 10^N 带
           N 自 域+224 (缺省 6) - 根-因 2026-08-03: 曾 hardcoded 1e6. */
        逆厚(域 + 200);
        移即(0, 1); 反附(域 + 8, 0); /* A37: 毛简一 = 1 (64 位) — 槽 从 域+228 (32 位, 8 字节 会 压 宽度槽 域+232) 改 域+8 (该 路径 空闲; 与 正败 的 毛简一 同址, 两条 路径 不 同时 活) */
        移寄存器帧(1, 域 + 224); /* ecx = N */
        设标号(实己);
        测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 列柒, 1);
        移寄存器帧64(0, 域 + 8); 移即(2, 10); 汇发("    乘64 r0, r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 发字节(0xE2); /* A37: 64 位 乘 rdx → 10^N 可 到 10^18 (原 32 位: N>=10 即 溢出 0) */
        反附(域 + 8, 0); /* 毛简一 = 堆九 (64 位) */
        汇发("    自减 r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC9); /* 递减 ecx */
        相对跳转(-1); 补标号(码位-4, 实己, 2);
        设标号(列柒);
        移寄存器帧64(0, 域 + 8); 汇发("    长转浮 xmm1, 堆九\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2A); 发字节(0xC8); /* A37: xmm1 = (双精度)毛简一 (64 位) */
        容甲();
        余申(域 + 208);       /* 保存 scaled */
        移即(0, 1); 旧挂();   /* xmm0 = 1.0 */
        移即(0, 2); 余十();   /* xmm1 = 2.0 */
        末一一();               /* xmm0 = 0.5 */
        余申(域 + 216);       /* 保存 0.5 */
        逆厚(域 + 208);
        堆双(域 + 216);
        总辛一();
        长对();                            /* A37: 堆九 = 分数编号 (64 位 — 原 32 位 cvttsd2si: N>=10 时 分数编号 > 2^31 → 0x80000000, 实测 %.10f 输出 0.2147483648) */
        移寄存器帧64(1, 域 + 8);       /* rcx = 毛简一 (64 位) */
        汇发("    比较无64 r0, r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x39); 模字节(3, 1, 0);         /* A37: 64 位 比较 首子, rcx (CF = 首子 < rcx -> jb = 无 进位) */
        发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 毛七, 8); /* jb 毛七: 无 进位 */
        移即(0, 0);                 /* frac6 = 0 */
        汇发("    自增64 r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xFF); 发字节(0xC3);  /* A37: 递增 rbx (整数 部分 + 1, 64 位 — 原 inc ebx 清 高 32 位) */
        设标号(毛七);
        反附(域 + 208, 0);       /* A37: 保存 分数编号 (64 位) */
        域重一(帧序二);              /* 打印 整数 部分 -> 小数 路径 */
        /* 小数 路径: '.' 则 N 数字 的 分数编号 (前导 zeros) - 根-因
           2026-08-03: 曾 6 unrolled divs; 现在 循环 N 次 带 除数 = 毛简一/10. */
        设标号(帧序二);
        移寄存器帧(0, 域 + 224); /* 首子 = N */
        测寄存器(0, 0); 零跳(-1); 补标号(码位-4, 宽组, 1); /* N==0: 无 小数 数字, 跳过 '.' */
        移即(0, '.'); 存字节十二();
        汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
        设标号(宽组);
        移寄存器帧64(0, 域 + 8); 移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); 汇发("    除64 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 发字节(0xF1); /* A37: 64 位 除 rcx: 堆九 = 毛简一/10 */
        移64(8, 0);                    /* r8 = 除数 (64 位) */
        移寄存器帧(9, 域 + 224);       /* r9d = N (数字 计数) */
        设标号(下序);
        测寄存器(9, 9); 零跳(-1); 补标号(码位-4, 链叁, 1);
        移寄存器帧64(0, 域 + 208);       /* 堆九 = 分数编号 (64 位) */
        汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2);                /* 异或 edx, edx */
        汇发("    除64 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1); 发字节(0xF7); 模字节(3, 6, 0); /* A37: 64 位 除 r8: 堆九=数字, rdx=段浅 */
        汇发("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC0); 发字节(0x30); 存字节十二(); /* 加 累加低,'0'; 移动 [r12], 累加低 - 数字 是 在 首子 (修复 2026-08-03) */
        汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
        反附(域 + 208, 2);       /* A37: 分数编号 = rdx (段浅, 64 位) */
        移64(0, 8); 移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); 汇发("    除64 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0xF7); 发字节(0xF1); /* A37: 64 位 除 rcx: 堆九 = 除数/10 */
        移64(8, 0);                    /* r8 = 除数/10 (64 位) */
        汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9d */
        相对跳转(-1); 补标号(码位-4, 下序, 2);
        设标号(链叁);
        /* A38: 左对齐 尾 补 空格 (pad 仍 在 域+24). ⚠️ 必须 先 判 pad > 0 — 负 pad (W < 长度, 常态) 若 进 循环
           会 从 负数 一路 自减 (永不 归零) → 无限 写 内存 (实测 崩 0xC0000005) */
        移寄存器帧(0, 域 + 24); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位 - 4, 壬尾, 6);
        移寄存器帧(0, 域 + 252); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬尾, 1);
        设标号(壬尾环);
        移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 壬尾, 1);
        移即(0, ' '); 存字节十二();         汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4);
        移寄存器帧(1, 域 + 24); 移即(2, 1); 算寄存器(旧肆, 1, 2); 移帧寄存器(域 + 24, 1);
        相对跳转(-1); 补标号(码位 - 4, 壬尾环, 2);
        设标号(壬尾);
        相对跳转(-1); 补标号(码位 - 4, 容低, 2);
    }
    /* %e/%E/%g/%G: 科学/通用浮点 — 分发存根设 字母(域+236)+is_g(域+24)+跳共享核心 (修复 2026-08-25
       支持矩阵补全; 必须每 格式化打印 只发射一份核心, 4 个 调用 段次 各自发射会标签爆炸 标号一-溢出) */
    设标号(小于等);
    移即(0, 'e'); 移帧寄存器(临时基 - 当前帧大小 + 236, 0); /* 字母 */
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 24, 0);    /* is_g = 0 */
    相对跳转(-1); 补标号(码位 - 4, 当再, 2);
    设标号(净二);
    移即(0, 'E'); 移帧寄存器(临时基 - 当前帧大小 + 236, 0);
    移即(0, 0); 移帧寄存器(临时基 - 当前帧大小 + 24, 0);
    相对跳转(-1); 补标号(码位 - 4, 当再, 2);
    设标号(初陆);
    移即(0, 'e'); 移帧寄存器(临时基 - 当前帧大小 + 236, 0);
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 24, 0);    /* is_g = 1 */
    相对跳转(-1); 补标号(码位 - 4, 当再, 2);
    设标号(局部全局);
    移即(0, 'E'); 移帧寄存器(临时基 - 当前帧大小 + 236, 0);
    移即(0, 1); 移帧寄存器(临时基 - 当前帧大小 + 24, 0);
    相对跳转(-1); 补标号(码位 - 4, 当再, 2);
    设标号(当再);
    正败(容低);
/* ---- %f 的 无穷/非数 输出 (修复 2026-08-26): 符号已输出, 只输出 "无穷"/"nan" ---- */
    设标号(内寅);
    { 整 目进 = 临时基 - 当前帧大小; /* 重新加载 |v| (%f 路径已改 xmm0) */
      逆厚(目进 + 192);
      汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq 堆九, xmm0 */
      发字节(0x48); 发字节(0xC1); 发字节(0xE0); 发字节(12);                   /* 左移 堆九, 12: 尾数移高, 符号+指数移出 */
      发字节(0x48); 发字节(0x85); 发字节(0xC0);                          /* 测试 堆九, 堆九: 尾数非 0 → 非数 */
      发字节(0x0F); 发字节(0x85); 发四(0); 补标号(码位 - 4, 副合, 9); /* 非零跳 副合 */
      移即(0, 'i'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, 'n'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, 'f'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      相对跳转(-1); 补标号(码位 - 4, 容低, 2);
      设标号(副合);
      移即(0, 'n'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, 'a'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, 'n'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, '('); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, 'i'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, 'n'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, 'd'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      移即(0, ')'); 存字节十二();
      汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
      相对跳转(-1); 补标号(码位 - 4, 容低, 2);
    }
/* %d->容低, %f->小数 路径 */
    返 段辰;
}

/* %e/%E/%g/%G: scientific / 通用 单精度 formatting (修复 2026-08-25 支持矩阵补全).
   is_g(域+24) 与 字母(域+236) 由 度壬 分发存根在运行时设置.
   已发射 机器 代码 shares 该 %f 符号/舍入 patterns but 加 十进制-指数
   normalization. 毛简一/分数编号 使用 64-位 算术 故 %.16g/%.17g (数据库) 工作.
   精度 N 自 域+224 (缺省 6). 宽度/零-填充 已忽略 遍 单精度 formats.
   槽位 映射 (全 之内 该 格式化打印 暂存 区域, 域 = 临时基 - 当前帧大小):
     域+8:   毛简一 (六十四位整数)          域+192: |v| (双精度)
     域+16:  剥离 计数器 (三十二位整数)  域+200: 尾数/分数 (双精度)
     域+20:  样式 标志 (0=f-样式 1=e-样式)   域+208: 分数编号 (六十四位整数)
     域+24:  is_g (0=%e/%E 1=%g/%G)  域+216: 0.5 (双精度)
     域+224: 分数编号 (三十二位整数)         域+228: 取指数 (三十二位整数)
     域+236: 指数 字母        域+240: 10.0 (双精度, 8字节 域+240..247 — 勿与其他槽重叠)
   寄存器 discipline: 后辰=堆平 r12=目标 r13=实参; r8/r9 暂存; 短组
   数字 临时 spans ~域+242..259 (向下 自 [rbp+域+260]), 故 nothing 以下
   域+240 可能 是 live 跨 a 调用 到 它 (样式 标志 于 域+20 / is_g 于 域+24 因此安全). */
静 空 正败(整 号分) {
    整 容伴 = 新标号(), 链伍一 = 新标号(), 值轮 = 新标号();
    整 邻陆 = 新标号(), 左属一 = 新标号(); /* 修复 2026-08-26: 无穷/非数 特殊输出 (原归一化循环死循环) */
    整 容叁 = 新标号(), 栈附 = 新标号(), 素附 = 新标号();
    整 正聚一 = 新标号(), 副子一 = 新标号();
    整 双挂 = 新标号(), 存寅 = 新标号(), 满申 = 新标号();
    整 旁散 = 新标号(), 双六 = 新标号(), 短劣 = 新标号();
    整 局部数 = 新标号(), 段拾 = 新标号(), 存系一 = 新标号(), 尾序 = 新标号();
    整 计退二 = 新标号();
    整 前轮 = 新标号(), 左深 = 新标号(), 段属一 = 新标号(), 外汇 = 新标号();
    整 局部全局成功 = 新标号(), 容成一 = 新标号(), 直属 = 新标号();
    整 目从 = 新标号(), 新十 = 新标号(), 域寅 = 新标号(), 下一 = 新标号();
    整 下挂 = 新标号();
    整 域 = 临时基 - 当前帧大小;

    /* 消费 该 双精度 实参 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (已过 规格 字符) */
    逆排();
    若 (素组) { 汇发("    增即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 0, 5); 发字节(8); }
    否 { 汇发("    减即 r13, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3, 5, 5); 发字节(8); }

    /* ---- 符号 (相同 模式 作为 %f: IEEE 符号 位) ---- */
    余申(域 + 192);       /* 保存 v */
    逆厚(域 + 192);
    汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq 堆九, xmm0 */
    汇发("    测试位 r0, 63\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,0); 发字节(0x0F); 发字节(0xBA); 发字节(0xE0); 发字节(0x3F); /* 位测试 堆九, 63 */
    发字节(0x0F); 发字节(0x83); 发四(0); 补标号(码位 - 4, 容伴, 7); /* jae 容伴: 符号 明确, 保持 */
    移即(0, '-'); 存字节十二(); /* 移动 [r12], '-' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    堆双(域 + 192);       /* xmm1 = v */
    移即(0, 0); 旧挂(); /* xmm0 = 0.0 */
    整进();               /* xmm0 = 0.0 - v = -v */
    余申(域 + 192);       /* 保存 |v| */
    设标号(容伴);

    /* 修复 2026-08-26: 无穷/非数 检测 — 原归一化循环对 无穷 (v/10 恒 无穷) 与 非数 (comisd 无序 CF=1, 非数<1 恒真) 死循环。
       指数位全 1 (0x7FF) → 跳 邻陆 输出 "无穷"/"nan"; 正常值 回落-经 (xmm0 未被 破坏). */
    汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq 堆九, xmm0 */
    发字节(0x48); 发字节(0xC1); 发字节(0xE8); 发字节(52);                /* 右移 堆九, 52 */
    发字节(0x25); 发四(0x7FF);                              /* 且 首子, 0x7FF */
    发字节(0x3D); 发四(0x7FF);                              /* 比较 首子, 0x7FF */
    发字节(0x0F); 发字节(0x84); 发四(0); 补标号(码位 - 4, 邻陆, 8); /* 等跳 邻陆 (无穷/非数) */

    /* 取指数 = 0 */
    移即(0, 0); 移帧寄存器(域 + 228, 0);

    /* 零 检查 (normalization 将 循环 forever 于 0) */
    移即(0, 0); 余十(); /* xmm1 = 0.0 */
    值凶();
    发字节(0x0F); 发字节(0x84); 发四(0); 补标号(码位 - 4, 链伍一, 1); /* 等跳 链伍一: v == 0 */

    /* ---- normalize |v| 到 [1,10): 取指数 counts powers 的 10 ---- */
    移即(0, 10); 余十();  /* xmm1 = 10.0 */
    新劣(); 余申(域 + 240); /* [域+240] = 10.0 (8字节 域+240..247 — is_g 在 域+24 不重叠) */
    逆厚(域 + 192);          /* 恢复 xmm0 = v (新劣 已破坏 它) */
    设标号(值轮);
    值凶();                 /* CF = (v < 10) */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 容叁, 8); /* jb 容叁: v < 10 */
    末一一();                  /* v /= 10 */
    移寄存器帧(0, 域 + 228); 移即(1, 1); 算寄存器(高拾, 0, 1); 移帧寄存器(域 + 228, 0); /* 取指数++ */
    相对跳转(-1); 补标号(码位 - 4, 值轮, 2);
    设标号(容叁);
    设标号(栈附);
    移即(0, 1); 余十();  /* xmm1 = 1.0 (重载 每 迭代 — mulsd 破坏 它 带 10.0) */
    值凶();                 /* CF = (v < 1) */
    发字节(0x0F); 发字节(0x83); 发四(0); 补标号(码位 - 4, 素附, 7); /* jae 素附: v >= 1 */
    堆双(域 + 240);          /* xmm1 = 10.0 */
    容甲();                  /* v *= 10 */
    移寄存器帧(0, 域 + 228); 移即(1, 1); 算寄存器(旧肆, 0, 1); 移帧寄存器(域 + 228, 0); /* 取指数-- */
    相对跳转(-1); 补标号(码位 - 4, 栈附, 2);
    设标号(素附);
    /* xmm0 = 尾数 在 [1,10), 取指数 于 域+228, |v| 于 域+192 — 运行时 is_g(域+24) 分支 */
    移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 正聚一, 3); /* is_g==0 → 直接 e-样式 */
    /* %g: 精度 0 -> 1 (C standard: 零 精度 treated 作为 一) */
    移寄存器帧(0, 域 + 224); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 局部全局成功, 3);
    移即(0, 1); 移帧寄存器(域 + 224, 0);
    设标号(局部全局成功);
    /* %g 样式 decision: e-样式 iff 取指数 < -4 或 取指数 >= N (缺省 N=6) */
    移寄存器帧(0, 域 + 228); 移即(1, -4); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8C); 发四(0); 补标号(码位 - 4, 正聚一, 10); /* 比较 首子,-4; jl 正聚一 */
    移寄存器帧(1, 域 + 224); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位 - 4, 正聚一, 5); /* 比较 首子,ecx; jge 正聚一 */
    /* ---- f-样式 ---- */
    移寄存器帧(0, 域 + 224);
    移即(1, 1); 算寄存器(旧肆, 0, 1);           /* 首子 = N-1 */
    移寄存器帧(1, 域 + 228); 算寄存器(旧肆, 0, 1); /* 首子 = N-1-取指数 */
    移帧寄存器(域 + 224, 0);                     /* 分数编号 */
    移即(0, 0); 移帧寄存器(域 + 20, 0);     /* 样式 = 0 (f-样式) */
    逆厚(域 + 192);                     /* xmm0 = v */
    长对();                          /* 堆九 = (六十四位整数)v */
    移64(3, 0);                                /* rbx = 整数 部分 */
    移64(0, 3); 发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2A); 发字节(0xC0); /* cvtsi2sd xmm0, 堆九 */
    短弊();                             /* xmm1 = (双精度)整数 */
    逆厚(域 + 192);
    整进();                             /* xmm0 = v - 整数 */
    余申(域 + 200);                     /* 分数 */
    相对跳转(-1); 补标号(码位 - 4, 双挂, 2);
    设标号(链伍一);
    /* v == 0: 取指数 stays 0, 尾数 = 0 — jump 回 经 该 %g 样式 decision
       (取指数=0 -> f-样式 -> "0"/"-0"; %e/%E is_g==0 跳转 直 到 正聚一 anyway) */
    相对跳转(-1); 补标号(码位 - 4, 素附, 2);
    设标号(正聚一);
    /* ---- e-样式 ---- */
    余申(域 + 200);                         /* 保存 尾数 (0 或 [1,10)) */
    /* 运行时 is_g: %g e-样式 用 N-1 位小数 (%e 保持 N) */
    移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 容成一, 3);
    移寄存器帧(0, 域 + 224); 移即(1, 1); 算寄存器(旧肆, 0, 1); 移帧寄存器(域 + 224, 0); /* 分数编号 = N-1 */
    设标号(容成一);
    /* 直肆 分数编号 >= 0 */
    移寄存器帧(0, 域 + 224); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位 - 4, 副子一, 5); /* 比较 首子,0; jge 副子一 */
    移即(0, 0); 移帧寄存器(域 + 224, 0);
    设标号(副子一);
    /* 尾数 整数 数字 (0-9) */
    逆厚(域 + 200);
    现简();
    移寄存器(3, 0);                                      /* ebx = 数字 */
    移寄存器(0, 3); 旧挂();                 /* xmm0 = (双精度)数字 */
    短弊();
    逆厚(域 + 200);
    整进();                                 /* xmm0 = 尾数 - 数字 */
    余申(域 + 200);                         /* 分数 */
    移即(0, 1); 移帧寄存器(域 + 20, 0);         /* 样式 = 1 (e-样式) */
    设标号(双挂);
    /* ---- 共享: 毛简一 = 10^分数编号 (64-位) ---- */
    移即(0, 1); 反附(域 + 8, 0);        /* 毛简一 = 1 */
    移寄存器帧(9, 域 + 224);                         /* r9d = 分数编号 */
    设标号(存寅);
    测寄存器(9, 9); 零跳(-1); 补标号(码位 - 4, 满申, 1);
    移寄存器帧64(0, 域 + 8);                         /* 堆九 = 毛简一 */
    移即(1, 10);                                  /* ecx = 10 */
    发字节(0x48); 发字节(0xF7); 发字节(0xE1);                         /* 乘 rcx: rdx:堆九 = 毛简一*10 */
    反附(域 + 8, 0);                         /* 毛简一 = 堆九 */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9d */
    相对跳转(-1); 补标号(码位 - 4, 存寅, 2);
    设标号(满申);
    /* ---- 共享: 分数编号 = trunc(分数 * 毛简一 + 0.5) ---- */
    移即(0, 1); 旧挂();              /* xmm0 = 1.0 */
    移即(0, 2); 余十();              /* xmm1 = 2.0 */
    末一一();                                 /* xmm0 = 0.5 (1.0/2.0) */
    余申(域 + 216);                         /* 保存 0.5 */
    移寄存器帧64(0, 域 + 8);                         /* 堆九 = 毛简一 */
    发字节(0xF2); 发字节(0x48); 发字节(0x0F); 发字节(0x2A); 发字节(0xC8);       /* cvtsi2sd xmm1, 堆九 (毛简一) */
    逆厚(域 + 200);                         /* xmm0 = 分数 */
    容甲();                                 /* xmm0 = 分数*毛简一 */
    堆双(域 + 216);                         /* xmm1 = 0.5 */
    总辛一();                                 /* xmm0 = 分数*毛简一 + 0.5 */
    长对();                              /* 堆九 = 分数编号 */
    /* 进位: 分数编号 >= 毛简一 -> 分数编号 = 0, adjust 尾数/整数 */
    移寄存器帧64(1, 域 + 8);                         /* rcx = 毛简一 */
    发字节(0x48); 发字节(0x39); 模字节(3, 1, 0);                  /* 比较 堆九, rcx */
    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 短劣, 8); /* jb 短劣: 分数编号 < 毛简一 */
    移寄存器帧(0, 域 + 20); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 旁散, 3); /* 样式 0? */
    发字节(0xFF); 发字节(0xC3);                                  /* 递增 ebx (f-样式 整数 部分) */
    相对跳转(-1); 补标号(码位 - 4, 双六, 2);
    设标号(旁散);
    发字节(0xFF); 发字节(0xC3);                                  /* 递增 ebx (尾数 数字) */
    移即(1, 10); 算寄存器(比等, 3, 1);              /* 比较 ebx, 10 */
    发字节(0x0F); 发字节(0x8C); 发四(0); 补标号(码位 - 4, 双六, 10); /* jl 双六: 数字 < 10 */
    移即(3, 1);                                   /* ebx = 1 */
    移寄存器帧(0, 域 + 228); 移即(1, 1); 算寄存器(高拾, 0, 1); 移帧寄存器(域 + 228, 0); /* 取指数++ */
    设标号(双六);
    移即(0, 0);                                   /* 分数编号 = 0 */
    设标号(短劣);
    反附(域 + 208, 0);                       /* 保存 分数编号 */
    /* ---- 剥离 尾随 zeros (仅 %g; 运行时 is_g 判断) ---- */
    移寄存器帧(0, 域 + 24); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 直属, 3);
    {
        移即(0, 0); 移帧寄存器(域 + 16, 0);     /* 剥离 = 0 */
        设标号(目从);
        移寄存器帧64(0, 域 + 208);                   /* 堆九 = 分数编号 */
        发字节(0x48); 发字节(0x85); 发字节(0xC0);                     /* 测试 堆九, 堆九 */
        非零跳(-1); 补标号(码位 - 4, 新十, 3);
        移即(0, 0); 移帧寄存器(域 + 224, 0);    /* N_eff = 0 */
        相对跳转(-1); 补标号(码位 - 4, 下一, 2);
        设标号(新十);
        移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
        发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1);              /* 除 rcx: 堆九=分数编号/10, rdx=段浅 */
        测寄存器(2, 2); 非零跳(-1); 补标号(码位 - 4, 域寅, 3); /* 段浅 != 0 -> 已做 */
        反附(域 + 208, 0);                   /* 分数编号 /= 10 */
        移寄存器帧(0, 域 + 16); 移即(1, 1); 算寄存器(高拾, 0, 1); 移帧寄存器(域 + 16, 0); /* 剥离++ */
        相对跳转(-1); 补标号(码位 - 4, 目从, 2);
        设标号(域寅);
        /* N_eff = N - 剥离 */
        移寄存器帧(0, 域 + 16); 移寄存器帧(1, 域 + 224); 算寄存器(旧肆, 1, 0); 移帧寄存器(域 + 224, 1);
        /* scale_eff = 毛简一 / 10^剥离 (64-位) */
        移寄存器帧64(0, 域 + 8); 移寄存器帧(1, 域 + 16); /* 堆九=毛简一, ecx=剥离 */
        设标号(下挂);
        测寄存器(1, 1); 零跳(-1); 补标号(码位 - 4, 下一, 1);
        移即(2, 10); 移寄存器(8, 2);                /* r8 = 10 (除数 — 不能放 毛简一 自身, 会 毛简一/毛简一=1) */
        汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
        发字节(0x49); 发字节(0xF7); 发字节(0xF0);                     /* 除 r8: 堆九 = 毛简一/10 */
        反附(域 + 8, 0);                     /* 毛简一 /= 10 */
        移寄存器帧(1, 域 + 16); 发字节(0xFF); 发字节(0xC9); 移帧寄存器(域 + 16, 1); /* 剥离-- */
        相对跳转(-1); 补标号(码位 - 4, 下挂, 2);
        设标号(下一);
    }
    设标号(直属);  /* is_g==0: 跳过 剥离, 分数编号/N/毛简一 原样 */
    /* ---- 打印 尾数/整数 部分 (样式 标志 域+20 运行时分支) ---- */
    移寄存器帧(0, 域 + 20); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 计退二, 3);
    短组(域 + 260, 局部数);              /* f-样式: 打印 rbx (整数), 跳转 局部数 */
    设标号(计退二);
    /* e-样式: 单 尾数 数字 (0-9) */
    移寄存器(0, 3);
    汇发("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC0); 发字节(0x30); /* 加 累加低, '0' */
    存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    相对跳转(-1); 补标号(码位 - 4, 局部数, 2);
    /* ---- 小数 数字: '.' + N_eff 数字 的 分数编号, 除数 = 毛简一/10 ---- */
    设标号(局部数);
    移寄存器帧(0, 域 + 224); 测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 段拾, 1); /* N==0: 跳过 '.' */
    移即(0, '.'); 存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    设标号(段拾);
    移寄存器帧64(0, 域 + 8);                         /* 堆九 = 毛简一 */
    移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1);                  /* 除 rcx: 堆九 = 毛简一/10 */
    移64(8, 0);                                    /* r8 = 除数 */
    移寄存器帧(9, 域 + 224);                         /* r9d = N (数字 计数) */
    设标号(存系一);
    测寄存器(9, 9); 零跳(-1); 补标号(码位 - 4, 尾序, 1);
    移寄存器帧64(0, 域 + 208);                       /* 堆九 = 分数编号 */
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    发字节(0x49); 发字节(0xF7); 发字节(0xF0);                         /* 除 r8: 堆九=数字, rdx=段浅 */
    汇发("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC0); 发字节(0x30); /* 加 累加低, '0' */
    存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    反附(域 + 208, 2);                       /* 分数编号 = rdx */
    移64(0, 8);                                    /* 堆九 = 除数 */
    移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1);                  /* 除 rcx: 堆九 = 除数/10 */
    移64(8, 0);                                    /* r8 = 除数/10 */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9d */
    相对跳转(-1); 补标号(码位 - 4, 存系一, 2);
    设标号(尾序);
    /* 出口: 样式 0 -> 尾, 样式 1 -> 前轮 (指数 打印) */
    移寄存器帧(0, 域 + 20); 测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 前轮, 3);
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
    /* ---- 指数: 字母(域+236) + 符号 + 于 最少 2 数字 ---- */
    设标号(前轮);
    移寄存器帧(0, 域 + 236); 存字节十二();           /* 字母 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移寄存器帧(0, 域 + 228); 移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位 - 4, 左深, 5); /* 比较 首子,0; jge 左深 */
    移即(0, '-'); 存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移寄存器帧(0, 域 + 228); 移即(1, 0); 算寄存器(旧肆, 1, 0); 移帧寄存器(域 + 228, 1); /* 取指数 = 0 - 取指数 */
    相对跳转(-1); 补标号(码位 - 4, 段属一, 2);
    设标号(左深);
    移即(0, '+'); 存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    设标号(段属一);
    移寄存器帧(0, 域 + 228); 移即(1, 10); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位 - 4, 外汇, 5); /* 比较 首子,10; jge 外汇 */
    移即(0, '0'); 存字节十二();                   /* 填充 '0' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移寄存器帧(0, 域 + 228);
    汇发("    加字节 r0, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC0); 发字节(0x30); /* 加 累加低, '0' */
    存字节十二();
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
    设标号(外汇);
    /* multi-数字 指数 (>= 2 数字): rbx = |取指数| */
    移寄存器帧(0, 域 + 228); 移64(3, 0);
    短组(域 + 260, 号分);

    /* ---- 无穷/非数 输出 (修复 2026-08-26): 符号已由符号处理输出 '-' — 只输出 "无穷"/"nan" ---- */
    设标号(邻陆);
    逆厚(域 + 192);                          /* 重新加载 |v| (归一化循环已改 xmm0) */
    汇发("    取浮标 r0, xmm0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x66); 发字节(0x48); 发字节(0x0F); 发字节(0x7E); 发字节(0xC0); /* movq 堆九, xmm0 */
    发字节(0x48); 发字节(0xC1); 发字节(0xE0); 发字节(12);                   /* 左移 堆九, 12: 尾数移到高 52 位 (符号+指数移出) */
    发字节(0x48); 发字节(0x85); 发字节(0xC0);                          /* 测试 堆九, 堆九: 尾数非 0 → 非数 */
    发字节(0x0F); 发字节(0x85); 发四(0); 补标号(码位 - 4, 左属一, 9); /* 非零跳 左属一 */
    移即(0, 'i'); 存字节十二();                    /* 'i' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, 'n'); 存字节十二();                    /* 'n' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, 'f'); 存字节十二();                    /* 'f' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
    设标号(左属一);
    移即(0, 'n'); 存字节十二();                    /* 'n' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, 'a'); 存字节十二();                    /* 'a' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, 'n'); 存字节十二();                    /* 'n' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, '('); 存字节十二();                    /* '(' (修复 步二十九: 对齐 msvcrt/编译器 "nan(ind)") */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, 'i'); 存字节十二();                    /* 'i' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, 'n'); 存字节十二();                    /* 'n' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, 'd'); 存字节十二();                    /* 'd' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    移即(0, ')'); 存字节十二();                    /* ')' */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
}

/* 打印 rbx (无符号 64-位) 作为 十进制 到 [r12], 则 跳转 尾.
   数字 临时 缓冲 于 [rbp+暂终-12 .. 暂终] (12 字节, plenty 遍 64-位).
   修复 2026-08-25 支持矩阵补全: 共享 由 正败 (整数 部分 + 指数). */
静 空 短组(整 暂终, 整 号分) {
    整 首甲 = 新标号(), 间寅 = 新标号();
    取帧址(8, 暂终);               /* r8 = 临时 结束 */
    移64(9, 8);                        /* r9 = 临时 结束 (推进) */
    设标号(首甲);
    移64(0, 3);                        /* 堆九 = 值 */
    汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
    移即(1, 10);
    发字节(0x48); 发字节(0xF7); 模字节(3, 6, 1);      /* 除 rcx: 堆九=quot, rdx=段浅 */
    移64(3, 0);                        /* rbx = quot */
    汇发("    加字节 r2, 0x30\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x80); 发字节(0xC2); 发字节(0x30); /* 加 链弊, '0' */
    汇发("    自减 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 1, 1); /* 递减 r9 */
    汇发("    写字节 [r9], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x88); 模字节(0, 2, 1); /* 移动 [r9], 链弊 */
    发字节(0x48); 发字节(0x85); 模字节(3, 3, 3);      /* 测试 rbx, rbx */
    非零跳(-1); 补标号(码位 - 4, 首甲, 3);
    设标号(间寅);
    汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x8A); 模字节(0, 0, 1); /* 移动 累加低, [r9] */
    存字节十二();
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* 递增 r9 */
    汇发("    自增 r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 4); /* 递增 r12 */
    汇发("    比较64 r9, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,1); 发字节(0x39); 模字节(3, 0, 1); /* 比较 r9, r8 */
    非零跳(-1); 补标号(码位 - 4, 间寅, 3);
    相对跳转(-1); 补标号(码位 - 4, 号分, 2);
}

/* 格式化到串(目标=rcx, 堆平=rdx, 实参...): 格式 入 目标 缓冲, 返回 旧粗 已写.
   无 内核库 调用, 故 无 栈 对齐 juggling. r14=目标 后辰=堆平 r12=adv r13=实参.
   邻回一 = 索引 的 该 首 值 实参 在 该 已压 栈 (2 遍 格式化到串,
   3 遍 格式化限长 哪 carries a 尺寸 实参). */
静 空 源回(整 参数个数, 整 邻回一) {
    左壬一(13, 8 * (参数个数 - 1 - 邻回一)); /* r13 = &首 值 实参 */
    移64(14, 1);  /* r14 = 目标 (rcx = 实参零) */
    移64(11, 2);  /* 后辰 = 堆平 (rdx = 实参一) */
    移64(12, 14); /* r12 = 目标 推进 */
    整 段辰 = 度壬(0); /* 格式化到串/格式化限长：用户缓冲，不设界（标准语义） */
    设标号(段辰);
    /* 空字符-终止 该 目标 缓冲 — 格式化到串 必须 写入 该 终止符 (修复 2026-08-03: 度壬
       叶 它 偏移 因 格式化打印/输出到文件 写入 a 高癸一-长度 blob; 自身-宿主 -S 文本 曾 已损坏
       带 stale-缓冲 residue 之后 该 首 汇发 调用). */
    汇发("    存字节0r12\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xC6); 发字节(0x04); 发字节(0x24); 发字节(0); /* 移动 字节 [r12], 0 */
    移64(0, 12); 汇发("    减64 r0, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3, 6, 0); /* 堆九 = r12 - r14 = 计数 */
}

/* vsnprintf(缓=rcx, 尺寸=rdx, 堆平=r8, ap=r9): 内置 - 格式 该 varargs pointed 到 由
   va_list ap 入 一 内部 缓冲, 拷贝 于 最多 尺寸-1 字节 入 缓 (空字符-已终止),
   且 返回 该 长度 那 将 已 曾是 已写. 修复 2026-08-23 t35e: vsnprintf 曾
   未登记 (无 msvcrt 导入表 导入) -> 未定义-函数 回退 已返回 0 -> 版本库's
   strbuf_addf/vsnprintf 链 静默 已发射 nothing (差异 头 lost 其 余散一 等.).
   va_list 是 字符* (custom 单八.h 半未), r13=ap 匹配 度壬's 8-字节 实参 表. */
静 空 现七一(空) {
    整 满败一 = 新标号();
    移64(3, 1);  /* rbx = 缓 (rcx) */
    移64(15, 2); /* r15 = 尺寸 (rdx) */
    压栈寄存器(3);        /* 保存 缓 */
    压栈寄存器(15);       /* 保存 尺寸 */
    移64(11, 8);  /* 后辰 = 堆平 (r8) */
    移64(13, 9);  /* r13 = ap (r9) = va_list; 素组 制造 fmt_loop walk UP */
    素组 = 1;
    取帧址(12, 临时基 - 当前帧大小 - 4096); /* r12 = 内部 缓冲 */
    移64(14, 12); /* r14 = 缓冲 开始 */
    整 段辰 = 度壬(-272);
    素组 = 0;
    设标号(段辰);
    /* 长度 = r12 - r14 */
    移64(0, 12); 汇发("    减64 rax, r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,1,0,0); 发字节(0x29); 模字节(3, 6, 0);
    移帧寄存器(临时基 - 当前帧大小 + 224, 0); /* 保存 长度 (域+224 释放 之后 fmt_loop) */
    弹栈寄存器(15); /* 尺寸 */
    弹栈寄存器(3);  /* 缓 */
    /* r9 = 最小(长度, 尺寸-1) */
    移64(9, 15); 移即(1, 1); 算寄存器(旧肆, 9, 1); /* r9d = 尺寸 - 1 */
    移寄存器帧(1, 临时基 - 当前帧大小 + 224); /* ecx = 长度 */
    算寄存器(比等, 9, 1); 发字节(0x0F); 发字节(0x8E); 发四(0); 补标号(码位-4, 满败一, 6); /* 比较 r9d,ecx; jle 满败一 */
    移64(9, 1); /* r9 = 长度 */
    设标号(满败一);
    /* rep movsb: rcx=计数, 实卯=源, rdi=缓 */
    移64(1, 9);  /* rcx = 计数 */
    移64(6, 14); /* 实卯 = r14 (内部 缓冲 开始; r8 已破坏 由 fmt_loop) */
    移64(7, 3);  /* rdi = 缓 */
    汇发("    块复制 (rep movsb)\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF3); 发字节(0xA4);
    汇发("    写字节 [rdi], 0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xC6); 发字节(0x07); 发字节(0); /* 移动 字节 [rdi], 0 (rdi=7, 无 扩展前缀 所需) */
    移寄存器帧(0, 临时基 - 当前帧大小 + 224); /* 首子 = 长度 (所需 长度) */
}

/* _va_alloc(尺寸=rcx) �?VirtualAlloc(空, 尺寸, MEM_RESERVE|MEM_COMMIT, PAGE_READWRITE) */
静 空 满六(空) {
    移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 对齐 */
    减栈即(32); /* 影子 空间 仅 (4 实参, rsp%16==0 于 调用) — 修复 2026-08-03: 曾 40 (rsp%16==8) */
    移64(2, 1);       /* rdx = 尺寸 */
    移即扩(1, 0);     /* rcx = lpAddress 空 */
    移即扩(8, 0x3000); /* r8 = MEM_RESERVE|MEM_COMMIT */
    移即扩(9, 0x4);   /* r9 = PAGE_READWRITE */
    调导入(4);          /* VirtualAlloc */
    加栈即(32);
    移64(4, 15);
}

/* _setpos(句柄=rcx, 位=rdx, 方法=r8) �?SetFilePointer(句柄, 位, 空, 方法) */
静 空 直丁一(空) {
    移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
    减栈即(32);
    移64(9, 8);  /* r9 = 方法 */
    移即扩(8, 0); /* r8 = 空 (lpDistanceToMoveHigh) */
    调导入(5);     /* SetFilePointer */
    加栈即(32);
    移64(4, 15);
}

/* _getpos(句柄=rcx) �?SetFilePointer(句柄, 0, 空, FILE_CURRENT=1) */
静 空 缺排(空) {
    移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
    减栈即(32);
    移即扩(2, 0); /* rdx = 0 */
    移即扩(8, 0); /* r8 = 空 */
    移即扩(9, 1); /* r9 = FILE_CURRENT */
    调导入(5);
    加栈即(32);
    移64(4, 15);
}

/* _exit_proc(代码=rcx) �?ExitProcess(代码) �?永不 返回 */
静 空 现戊(空) {
    移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
    减栈即(32);
    调导入(6); /* ExitProcess */
}

/* 打开文件/读取/写入: 真 文件 I/O 经 内核库 (CreateFileA/ReadFile/WriteFile).
   实参 arrive 在 rcx/rdx/r8/r9 (调用 machinery). 全 内核库 调用 需 rsp 16-已对齐
   且 该 5th+ 实参 于 [rsp+32+8k] �?对齐 带 r15 且 恢复. */
静 空 堆吉(常 字 *串升) {
    若 (!比较字符串(串升, "fopen")) {
        /* 打开文件(路径=rcx, 模式=rdx): 解析 模式[0], 调用 CreateFileA */
        移64(10, 1); /* r10 = 路径 */
        移64(11, 2); /* 后辰 = 模式 */
        移64(15, 4); /* 移动 r15, rsp */
        汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp, -16 */
        减栈即(64); /* 影子 32 + 3 栈 实参 24 + 填充 8  �? rsp%16==0 于 调用 */
        /* defaults 遍 'w': GENERIC_WRITE (rdx = 实参二!) + CREATE_ALWAYS */
        移即(0, 3); 移寄存器(8, 0);   /* r8 = 共享 3 (读取|写入) */
        移即(0, 0); 移寄存器(9, 0);   /* r9 = 安全 空 */
        移即(0, 2); 移栈寄存器64(32, 0);  /* [rsp+32] = CREATE_ALWAYS */
        移即(0, 0x80); 移栈寄存器64(40, 0); /* [rsp+40] = FILE_ATTRIBUTE_NORMAL */
        移即(0, 0); 移栈寄存器64(48, 0);  /* [rsp+48] = template 空 */
        移即(2, 0x40000000);              /* rdx = GENERIC_WRITE (缺省) */
        /* 模式[0] */
        汇发("    零扩展 eax, [r11]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 3); /* 零扩展 首子, 字节[后辰] */
        整 短高 = 新标号(), 标址 = 新标号(), 段辰 = 新标号();
        汇发("    比较字节即 r0, 0x72\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x3C); 发字节('r'); 零跳(-1); 补标号(码位-4, 短高, 1); /* 'r' �?读取 */
        汇发("    比较字节即 r0, 0x61\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x3C); 发字节('a'); 零跳(-1); 补标号(码位-4, 标址, 1); /* 'a' �?追加 */
        相对跳转(-1); 补标号(码位-4, 段辰, 2); /* 'w' defaults 已 集 */
        设标号(短高);
        移即(2, 0x80000000);              /* rdx = GENERIC_READ */
        移即(0, 3); 移栈寄存器64(32, 0);  /* [rsp+32] = OPEN_EXISTING */
        相对跳转(-1); 补标号(码位-4, 段辰, 2);
        设标号(标址);
        移即(2, 0x4);                 /* rdx = FILE_APPEND_DATA �?闁告劖鐟﹀鍫熸交濠婂棙鍎?文件尾 */
        移即(0, 4); 移栈寄存器64(32, 0);  /* [rsp+32] = OPEN_ALWAYS */
        设标号(段辰);
        移64(1, 10); /* rcx = 路径 */
        调导入(2);     /* CreateFileA */
        加栈即(64);
        移64(4, 15); /* 移动 rsp, r15 */
        /* 修复 2026-08-18: CreateFileA 失败返回 INVALID_HANDLE_VALUE(-1) 而非 0!
           调用方 的 若(函数指针) 只判 0 → 打开失败被当成功 → 对不存在的 .版本库/配置 启动
           解析 → 版本库 初始化 "坏 配置 行 1"。将 -1 归一为 空(0)。 */
        { 整 反丑 = 新标号();
          汇发("    比较 rax, -1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xF8); 发字节(0xFF);
          非零跳(-1); 补标号(码位 - 4, 反丑, 1);
          移即(0, 0); /* 堆九 = 空 */
          设标号(反丑); }
    } 否 若 (!比较字符串(串升, "fread")) {
        /* 读取(指针=rcx, 尺寸=rdx, nmemb=r8, 流=r9): ReadFile */
        移64(10, 9); /* r10 = 句柄 */
        移64(11, 1); /* 后辰 = 指针 */
        移64(14, 2); /* r14 = 尺寸 (rdx) — 保存用于返回值 字节/尺寸 (修复 2026-08-24 t35v) */
        移64(0, 2);  /* 堆九 = 尺寸 */
        汇发("    乘64 r0, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 0, 0); /* 乘 堆九, r8 */
        移64(8, 0);  /* r8 = 计数 */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &读取 */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 对齐 */
        减栈即(48); /* 影子 32 + 1 栈 实参 8 + 填充 8  �? rsp%16==0 于 调用 */
        移64(1, 10); /* rcx = 句柄 */
        移64(2, 11); /* rdx = 指针 */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 空 */
        调导入(3);     /* ReadFile */
        加栈即(48);
        移64(4, 15);
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* 首子 = 字节 读取 */
        /* 修复 2026-08-24 t35v: C 读取 返回元素数 = 字节/尺寸 (原返回字节数 → 文件-backend.c 计卯=读取(缓,计数二,1,f) 得 403≠1 → "不能 读取 403 字节" → rev-解析 头@{1} 失败) */
        移寄存器(9, 14); /* r9d = 尺寸 */
        汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); /* 异或 edx, edx */
        汇发("    无符号除 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xF7); 模字节(3, 6, 1); /* 除 r9d */
    } 否 若 (!比较字符串(串升, "fwrite")) {
        /* 写入(指针=rcx, 尺寸=rdx, nmemb=r8, 流=r9): WriteFile
           流==0 → 输出流 (版本库 的 文件* 输出流/错误流 值为 0; 修复 2026-08-20:
           版本库 暂双-文件 write_name 写行/输出流 全打进无效句柄 0 → 无输出) */
        整 整零 = 新标号(), 终捌一 = 新标号();
        移帧寄存器(临时基 + 224 - 当前帧大小, 1); /* 保存 指针(rcx) — GetStdHandle 破坏 rcx (修复 2026-08-20: 原 GetStdHandle 后 移动 rcx→后辰 读到垃圾 → 取字长/WriteFile 错) */
        移64(11, 9); 测寄存器(11, 11); 零跳(-1); 补标号(码位 - 4, 整零, 1);
        移64(10, 11); /* r10 = 流 (句柄) */
        相对跳转(-1); 补标号(码位 - 4, 终捌一, 2);
        设标号(整零);
        移即(1, -11); 减栈即(32); 调导入(0); 加栈即(32); /* GetStdHandle(STD_OUTPUT) */
        移64(10, 0); /* r10 = 句柄 */
        设标号(终捌一);
        移寄存器帧(11, 临时基 + 224 - 当前帧大小); /* 恢复 指针 */
        移64(0, 2);  /* 堆九 = 尺寸 */
        汇发("    乘64 r0, r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 0, 0); /* 乘 堆九, r8 */
        移64(8, 0);  /* r8 = 计数 */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &已写 */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48); /* 影子 32 + 栈 实参 8 + 填充 8 (rsp%16==0 于 调用) — 修复 2026-08-03: 曾 40, 应用二进制接口 未对齐 */
        移64(1, 10); 移64(2, 11);
        移即(0, 0); 移栈寄存器64(32, 0);
        调导入(1);     /* WriteFile */
        加栈即(48);
        移64(4, 15);
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* 首子 = 字节 已写 */
    } 否 若 (!比较字符串(串升, "__qcc_mfence")) { 发字节(0x0F); 发字节(0xAE); 发字节(0xF0); } /* 阶段C-1 #21 内存屏障 (2026-09-01): 屏障() → 真 mfence (0F AE F0 全序栅栏, 原子路径同款) */
    否 若 (!比前n(串升, "atomic_load", 11)) {
        /* 接入 2026-08-28 机制层 #44 内存序: 真原子读 — atomic_load(指针=rcx) → 移动 堆九, [rcx]; 获取/全序 加 内存栅栏 */
        发字节(0x48); 发字节(0x8B); 发字节(0x01); /* 移动 堆九, [rcx] (扩展前缀.W=48 + 8B + 模字节 01=[rcx]/堆九) */
        若 (!比较字符串(串升, "atomic_load") || 查找子串(串升, "_acquire")) { 发字节(0x0F); 发字节(0xAE); 发字节(0xF0); } /* 内存栅栏 (0F AE 末深): 默认 全序 / 获取 */
    } 否 若 (!比前n(串升, "atomic_store", 12)) {
        /* 接入 2026-08-28 机制层 #44 内存序: 真原子写 — atomic_store(指针=rcx, v=rdx) → [版本/全序 前 内存栅栏]; 移动 [rcx], rdx */
        若 (!比较字符串(串升, "atomic_store") || 查找子串(串升, "_release")) { 发字节(0x0F); 发字节(0xAE); 发字节(0xF0); } /* 内存栅栏: 默认 全序 / 版本 */
        发字节(0x48); 发字节(0x89); 发字节(0x11); /* 移动 [rcx], rdx (扩展前缀.W=48 + 89 + 模字节 11=[rcx]/rdx) */
    } 否 若 (!比较字符串(串升, "atomic_compare_exchange")) {
        /* 接入 2026-08-28 机制层: 真原子 CAS — atomic_compare_exchange(指针=rcx, 期望=rdx, 新=r8)
           → 移动 堆九, rdx (期望); 锁 比较交换 [rcx], r8; 堆九 = 旧值 (比较交换 语义: [rcx]==堆九 则 [rcx]=r8, 否则 堆九=[rcx]) */
        移64(0, 2); /* 堆九 = rdx (期望) */
        汇发("    比较交换 [rcx], r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0xF0); 发字节(0x4C); 发字节(0x0F); 发字节(0xB1); 发字节(0x01); /* 锁 比较交换 [rcx], r8 (扩展前缀.W+R=4C + 0F 计从 + 模字节 01=[rcx]/r8) */
    } 否 若 (!比较字符串(串升, "atomic_fetch_add")) {
        /* 接入 2026-08-28 机制层: 真原子 拉取-加 — atomic_fetch_add(指针=rcx, delta=rdx)
           → 符号扩展64 堆九, edx (delta 32 位符号扩展 — 修复 2026-08-28 阶段一 #7: 原 移64 高 32 位垃圾,
           64 位 锁 xadd 写 8 字节污染相邻 数据 (Arc 计数+数据 布局 → 数据+1 污染));
           锁 xadd [rcx], 堆九; 堆九 = 旧值, [rcx] += delta */
        发字节(0x48); 发字节(0x63); 发字节(0xC2); /* 符号扩展64 堆九, edx (符号扩展 32→64) */
        汇发("    原子交换加 [rcx], rax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0xF0); 发字节(0x48); 发字节(0x0F); 发字节(0xC1); 发字节(0x01); /* 锁 xadd [rcx], 堆九 (扩展前缀.W=48 + 0F 域转 + 模字节 01) */
    } 否 若 (!比较字符串(串升, "atomic_exchange")) {
        /* 接入 2026-08-28 机制层: 真原子交换 — atomic_exchange(指针=rcx, v=rdx)
           → 移动 堆九, rdx; 交换 [rcx], 堆九; 堆九 = 旧值, [rcx] = v (交换 天然原子, 无需 锁) */
        移64(0, 2); /* 堆九 = rdx (v) */
        汇发("    交换 [rcx], rax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0x48); 发字节(0x87); 发字节(0x01); /* 交换 [rcx], 堆九 (扩展前缀.W=48 + 87 + 模字节 01) */
    } 否 若 (!比较字符串(串升, "fgetc")) {
        /* 读字符(流=rcx): ReadFile(句柄, &字节, 1, &读取, 空) → 首子 = 字节; 文件尾 → -1
           (修复 2026-08-18: 原非数学 内置 落 否则 → 移即(0,0) 恒返 0 → 版本库 配置 读取全 0
           → "坏 配置 行 1"; 编译器 打开文件 返回 CreateFileA 句柄, 必须用 ReadFile 而非 msvcrt 读字符) */
        移64(10, 1); /* r10 = 句柄 */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
        减栈即(48); /* 影子 32 + 1 栈 实参 8 + 填充 8 */
        移64(1, 10); /* rcx = 句柄 */
        取帧址(2, 临时基 + 232 - 当前帧大小); /* rdx = &字节 */
        移即扩(8, 1); /* r8 = 1 字节 */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &读取 */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 空 */
        调导入(3);     /* ReadFile */
        加栈即(48);
        移64(4, 15);
        { 整 余五 = 新标号(), 帧序一 = 新标号();
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* 首子 = 字节 读取 */
        测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 余五, 1); /* 读取==0 → 文件尾 */
        /* 修复 2026-08-18: 读到的字节须 8 位零扩展 (零扩展字节 首子, 字节 [暂存+232]) — 原 32 位 移寄存器帧
           把 字节 缓冲的高 24 位栈残留一并返回 (ReadFile 只写 1 字节) → 高字节垃圾 (如 0x0b30d10a) →
           get_next_char 返回垃圾字符 → 配置 解析 isspace 查表越界 段错误 (版本库 初始化 0xC0000005) */
        { 整 元 = 临时基 + 232 - 当前帧大小;
          若 (元 >= -128 && 元 <= 127) { 发字节(0x0F); 发字节(0xB6); 发字节(0x45); 发字节((无 字)元); }
          否 { 发字节(0x0F); 发字节(0xB6); 发字节(0x85); 发四(元); } }
        相对跳转(-1); 补标号(码位 - 4, 帧序一, 2);
        设标号(余五);
        移即(0, -1); /* 文件尾 */
        设标号(帧序一); }
    } 否 若 (!比较字符串(串升, "fseek")) {
        /* 定位文件(流=rcx, 偏移=rdx, 起源=r8) → SetFilePointer(句柄, 偏移, 空, 起源)
           流==0 (输入流/输出流) → 返回 0 (修复 2026-08-24 t35t: reflog 反向读取 定位文件(句柄)
           原走 msvcrt 需 文件* 而 堆吉 打开文件 返回 句柄 → reflog 崩) */
        整 外繁一 = 新标号(), 满辛 = 新标号();
        移64(10, 1); 测寄存器(10, 10); 零跳(-1); 补标号(码位 - 4, 外繁一, 1);
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移64(1, 10); /* rcx = 句柄 */
        /* rdx = 偏移 (参数原样) */
        移64(9, 8); /* r9 = 起源 — 必须在 r8 覆盖前保存 (修复 2026-08-24 t35v: 原 r8 先被 高=空 覆盖 → r9=0 (文件头) → 定位文件(右得) 移到文件头 → 取文件位置=0 → reflog 反向读取空 → rev-解析 头@{1} "日志 是 空") */
        移即扩(8, 0); /* r8 = 高 = 空 (修复 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; 移即 不支持 r8-r15, 用 移即扩) */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 空 (高) */
        调导入(5); /* SetFilePointer */
        加栈即(48);
        移64(4, 15);
        移即(0, 0); /* 返回 0 */
        相对跳转(-1); 补标号(码位 - 4, 满辛, 2);
        设标号(外繁一);
        移即(0, 0); /* 流==0 → 0 */
        设标号(满辛);
    } 否 若 (!比较字符串(串升, "ftell")) {
        /* 取文件位置(流=rcx) → SetFilePointer(句柄, 0, 空, FILE_CURRENT=1)
           (修复 2026-08-24 t35t: 原走 msvcrt 拿句柄当 文件* 崩) */
        整 半丑 = 新标号(), 原辛 = 新标号();
        移64(10, 1); 测寄存器(10, 10); 零跳(-1); 补标号(码位 - 4, 半丑, 1);
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移64(1, 10);
        移即(2, 0);
        移即扩(8, 0); /* r8 = 高 = 空 (修复 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; 移即 不支持 r8-r15, 用 移即扩) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 1); /* r9 方法 (移即 不支持 r9, 修复 2026-08-24 t35t) */ /* FILE_CURRENT */
        调导入(5);
        加栈即(48);
        移64(4, 15);
        相对跳转(-1); 补标号(码位 - 4, 原辛, 2);
        设标号(半丑);
        移即(0, 0);
        设标号(原辛);
    } 否 若 (!比较字符串(串升, "feof")) {
        /* feof(流=rcx): 当=SetFilePointer(h,0,空,当); 尺寸=SetFilePointer(h,0,空,结束);
           恢复 当; 返回 (当 >= 尺寸) — 句柄语义下无缓冲 文件尾 标志, 用位置比较
           (修复 2026-08-24 t35t: strbuf_getwholeline 的 feof(句柄) 原走 msvcrt 崩) */
        整 名薄 = 新标号(), 上劣 = 新标号();
        移64(10, 1); 测寄存器(10, 10); 零跳(-1); 补标号(码位 - 4, 名薄, 1);
        移帧寄存器(临时基 + 256 - 当前帧大小, 10); /* 存 句柄 到栈 (修复 2026-08-28: r10 是 易失, SetFilePointer 调用后破坏 → 尺寸 查询用垃圾 句柄 返 0xFFFFFFFF → feof 恒 0) */
        /* 当 */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移寄存器帧(1, 临时基 + 256 - 当前帧大小); 移即(2, 0);
        移即扩(8, 0); /* r8 = 高 = 空 (修复 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; 移即 不支持 r8-r15, 用 移即扩) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 1); /* r9 方法 (移即 不支持 r9, 修复 2026-08-24 t35t) */ 调导入(5);
        加栈即(48); 移64(4, 15);
        移帧寄存器(临时基 + 240 - 当前帧大小, 0); /* 存 当 */
        /* 尺寸 */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移寄存器帧(1, 临时基 + 256 - 当前帧大小); 移即(2, 0);
        移即扩(8, 0); /* r8 = 高 = 空 (修复 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; 移即 不支持 r8-r15, 用 移即扩) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 2); /* r9 方法 (移即 不支持 r9) */ 调导入(5); /* FILE_END */
        加栈即(48); 移64(4, 15);
        移帧寄存器(临时基 + 248 - 当前帧大小, 0); /* 存 尺寸 */
        /* 恢复 当 */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移寄存器帧(1, 临时基 + 256 - 当前帧大小);
        移寄存器帧(2, 临时基 + 240 - 当前帧大小);
        移即扩(8, 0); /* r8 = 高 = 空 (修复 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; 移即 不支持 r8-r15, 用 移即扩) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 0); /* r9 方法 (移即 不支持 r9) */ 调导入(5); /* 文件头 */
        加栈即(48); 移64(4, 15);
        /* 返回 (当 >= 尺寸) */
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* 首子 = 当 */
        压栈寄存器(0);
        移寄存器帧(0, 临时基 + 248 - 当前帧大小); /* 首子 = 尺寸 */
        弹栈寄存器(3); /* ebx = 当 */
        汇发("    比较 r3, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x39); 模字节(3, 0, 3); /* 比较 rbx, 堆九 → rbx-堆九 = 当-尺寸 */
        发字节(0x0F); 发字节(0x93); 模字节(3, 0, 0); /* setae 累加低 (当 >= 尺寸 → 文件尾) */
        中失();
        相对跳转(-1); 补标号(码位 - 4, 上劣, 2);
        设标号(名薄);
        移即(0, 0); /* 流==0 → 0 (非 文件尾) */
        设标号(上劣);
    } 否 若 (!比较字符串(串升, "fputc")) {
        /* 写字符(c=rcx, 流=rdx): WriteFile(句柄, &字节, 1, &已写, 空)
           流==0 → 输出流 (修复 2026-08-20) */
        整 缓合 = 新标号(), 右置 = 新标号();
        移帧寄存器(临时基 + 232 - 当前帧大小, 1); /* 先存 c(rcx) — GetStdHandle 破坏 rcx (修复 2026-08-20: 原 GetStdHandle 后存 c 读到垃圾字节) */
        移64(11, 2); 测寄存器(11, 11); 零跳(-1); 补标号(码位 - 4, 缓合, 1);
        移64(10, 11); /* r10 = 流 */
        相对跳转(-1); 补标号(码位 - 4, 右置, 2);
        设标号(缓合);
        移即(1, -11); 减栈即(32); 调导入(0); 加栈即(32); /* GetStdHandle(STD_OUTPUT) */
        移64(10, 0); /* r10 = 句柄 */
        设标号(右置);
        /* [暂存+232] 已存 c */
        取帧址(11, 临时基 + 232 - 当前帧大小); /* 后辰 = &字节 */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 对齐 */
        减栈即(48); /* 影子 32 + 栈 实参 8 + 填充 8 */
        移64(1, 10); /* rcx = 句柄 */
        移64(2, 11); /* rdx = &字节 */
        移即扩(8, 1); /* r8 = 1 字节 (移即 可't 地址 高 计浅一!) */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &已写 */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 空 */
        调导入(1);     /* WriteFile */
        加栈即(48);
        移64(4, 15);
        移即(0, 1); /* 返回 c (正) */
    } 否 若 (!比较字符串(串升, "fputs")) {
        /* 写行(字符串=rcx, 流=rdx): WriteFile(句柄, 字符串, 取字长(字符串), &已写, 空)
           流==0 → 输出流 (修复 2026-08-20) */
        整 外繁一 = 新标号(), 满辛 = 新标号();
        移帧寄存器(临时基 + 224 - 当前帧大小, 1); /* 先存 字符串(rcx) — GetStdHandle 破坏 rcx (修复 2026-08-20: 原 GetStdHandle 后 移动 rcx→后辰 读到垃圾 → 取字长 扫描垃圾地址 → WriteFile 失败) */
        移64(11, 2); 测寄存器(11, 11); 零跳(-1); 补标号(码位 - 4, 外繁一, 1);
        移64(10, 11); /* r10 = 流 */
        相对跳转(-1); 补标号(码位 - 4, 满辛, 2);
        设标号(外繁一);
        移即(1, -11); 减栈即(32); 调导入(0); 加栈即(32); /* GetStdHandle(STD_OUTPUT) */
        移64(10, 0); /* r10 = 句柄 */
        设标号(满辛);
        移寄存器帧(11, 临时基 + 224 - 当前帧大小); /* 恢复 字符串 */
        移64(8, 11); /* r8 = scan */
        移即(0, 0); /* 首子 = 长度 */
        整 现陆 = 新标号(), 串排 = 新标号();
        设标号(现陆);
        汇发("    零扩展 ecx, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 0); /* 零扩展 ecx,字节[r8] */
        测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 串排, 1);
        汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1);发字节(0xFF);模字节(3,0,0); /* ③ REX.W=1: 原 0 ⟹ inc r8d ⟹ 指针 32 位回绕 */ /* 递增 r8 */
        汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC0); /* 递增 首子 */
        相对跳转(-1); 补标号(码位-4, 现陆, 2);
        设标号(串排);
        移64(8, 0); /* r8 = 长度 */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 对齐 */
        减栈即(48);
        移64(1, 10); /* rcx = 句柄 */
        移64(2, 11); /* rdx = 字符串 */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* r9 = &已写 */
        移即(0, 0); 移栈寄存器64(32, 0); /* [rsp+32] = 空 */
        调导入(1);     /* WriteFile */
        加栈即(48);
        移64(4, 15);
        移即(0, 0); /* 返回 0 */
    } 否 若 (!比较字符串(串升, "fflush")) {
        /* 刷新缓冲(流): 句柄 IO 无缓冲 → 无-算子 (修复 2026-08-24 t35t) */
        移即(0, 0);
    } 否 若 (!比较字符串(串升, "ferror")) {
        /* 判文件错误(流): 句柄语义无错误跟踪 → 0 (修复 2026-08-24 t35t) */
        移即(0, 0);
    } 否 若 (!比较字符串(串升, "rewind")) {
        /* 倒带(流) = 定位文件(流, 0, 号汇=0) (修复 2026-08-24 t35t) */
        整 左薄 = 新标号(), 首拾二 = 新标号();
        移64(10, 1); 测寄存器(10, 10); 零跳(-1); 补标号(码位 - 4, 左薄, 1);
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移64(1, 10);
        移即(2, 0);
        移即扩(8, 0); /* r8 = 高 = 空 (修复 2026-08-24 t35t: SetFilePointer 4 参数 r8 漏设 → 垃圾指针崩; 移即 不支持 r8-r15, 用 移即扩) */
        移即(0, 0); 移栈寄存器64(32, 0);
        移即扩(9, 0); /* r9 方法 (移即 不支持 r9) */ /* 文件头 */
        调导入(5);
        加栈即(48);
        移64(4, 15);
        移即(0, 0);
        相对跳转(-1); 补标号(码位 - 4, 首拾二, 2);
        设标号(左薄);
        移即(0, 0);
        设标号(首拾二);
    } 否 若 (!比较字符串(串升, "fclose")) {
        /* 关文件(流): 流==0 (输入流/输出流) → 0; 否则无 CloseHandle 导入表 槽 →
           先 无-算子 (句柄由进程退出回收; 修复 2026-08-24 t35t: 原走 msvcrt 拿句柄当 文件* 崩) */
        移即(0, 0);
    } 否 若 (!比较字符串(串升, "fgets")) {
        /* 读行(字符串=rcx, 尺寸=rdx, 流=r8): 逐字符 ReadFile 到 '\n'/文件尾/容量; 返回 字符串/空
           流==0 → 输入流 (修复 2026-08-24 t35t: 原走 msvcrt 拿句柄当 文件* 崩; mailmap/浅 读文件行触发) */
        整 元列二 = 新标号(), 余繁一 = 新标号(), 列午 = 新标号(), 段辰 = 新标号(), 剩进 = 新标号(), 目二 = 新标号();
        移64(10, 1); /* r10 = 字符串 */
        移64(11, 2); /* 后辰 = 尺寸 */
        反附(临时基 + 220 - 当前帧大小, 10); /* 原始 字符串 */
        反附(临时基 + 224 - 当前帧大小, 10); /* 当前 字符串 */
        /* 尺寸-1 → 暂存+236 */
        移64(0, 11);
        汇发("    减 r0, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x83); 模字节(3, 5, 0); 发字节(1); /* 减 首子,1 */
        移帧寄存器(临时基 + 236 - 当前帧大小, 0);
        /* 句柄: r13 = 流==0 ? STD_INPUT : 流 */
        移64(13, 8); 测寄存器(13, 13); 零跳(-1); 补标号(码位 - 4, 元列二, 1);
        相对跳转(-1); 补标号(码位 - 4, 余繁一, 2);
        设标号(元列二);
        移即(1, -10); 减栈即(32); 调导入(0); 加栈即(32); /* GetStdHandle(STD_INPUT) */
        移64(13, 0);
        设标号(余繁一);
        反附(临时基 + 244 - 当前帧大小, 13); /* 句柄 */
        移即(0, 0); 移帧寄存器(临时基 + 252 - 当前帧大小, 0); /* 计数 = 0 */
        设标号(列午);
        /* 计数 >= 尺寸-1 → 已做 */
        移寄存器帧(0, 临时基 + 252 - 当前帧大小); 压栈寄存器(0);
        移寄存器帧(0, 临时基 + 236 - 当前帧大小); 弹栈寄存器(3);
        汇发("    比较 r3, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x39); 模字节(3, 0, 3);
        发字节(0x0F); 发字节(0x93); 模字节(3, 0, 0); 中失(); /* 计数 >= 尺寸-1 */
        测寄存器(0, 0); 非零跳(-1); 补标号(码位 - 4, 段辰, 1);
        /* ReadFile(句柄, &字节, 1, &读取, 空) */
        移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
        减栈即(48);
        移寄存器帧64(1, 临时基 + 244 - 当前帧大小); /* rcx = 句柄 */
        取帧址(2, 临时基 + 232 - 当前帧大小); /* &字节 */
        移即扩(8, 1); /* r8 = 1 */
        取帧址(9, 临时基 + 240 - 当前帧大小); /* &读取 */
        移即(0, 0); 移栈寄存器64(32, 0);
        调导入(3); /* ReadFile */
        加栈即(48); 移64(4, 15);
        移寄存器帧(0, 临时基 + 240 - 当前帧大小); /* 读取 */
        测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 剩进, 1); /* 读取==0 → 文件尾 */
        /* 字符串[计数] = 字节; 首子 符号扩展 字节 (零扩展) */
        移寄存器帧64(3, 临时基 + 224 - 当前帧大小); /* rbx = 当前 字符串 */
        { 整 元 = 临时基 + 232 - 当前帧大小;
          若 (元 >= -128 && 元 <= 127) { 发字节(0x0F); 发字节(0xB6); 发字节(0x45); 发字节((无 字)元); }
          否 { 发字节(0x0F); 发字节(0xB6); 发字节(0x85); 发四(元); } } /* 零扩展 首子, 字节[暂存+232] */
        移帧寄存器(临时基 + 232 - 当前帧大小, 0); /* 保存 字节 值 (供 '\n' 检查) */
        汇发("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0x88); 模字节(0, 0, 3); /* 移动 [rbx], 累加低 */
        /* 字符串++ */
        移寄存器帧64(0, 临时基 + 224 - 当前帧大小);
        汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xFF); 模字节(3, 0, 0);
        反附(临时基 + 224 - 当前帧大小, 0);
        /* 计数++ */
        移寄存器帧(0, 临时基 + 252 - 当前帧大小);
        汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC0);
        移帧寄存器(临时基 + 252 - 当前帧大小, 0);
        /* 字节 == '\n' → 已做 */
        移寄存器帧(0, 临时基 + 232 - 当前帧大小);
        汇发("    比较字节即 r0, 0x0a\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x3C); 发字节(0x0A);
        零跳(-1); 补标号(码位 - 4, 段辰, 1);
        相对跳转(-1); 补标号(码位 - 4, 列午, 2);
        设标号(段辰);
        /* *字符串 = 0 */
        移寄存器帧64(3, 临时基 + 224 - 当前帧大小);
        移即(0, 0);
        汇发("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0x88); 模字节(0, 0, 3);
        移寄存器帧64(0, 临时基 + 220 - 当前帧大小); /* 返回 原始 字符串 */
        相对跳转(-1); 补标号(码位 - 4, 目二, 2);
        设标号(剩进);
        /* 文件尾: 有字符 → 返回 字符串 (需先 *字符串=0), 无字符 → 空 */
        移寄存器帧(0, 临时基 + 252 - 当前帧大小);
        测寄存器(0, 0); 零跳(-1); 补标号(码位 - 4, 目二, 1); /* 计数==0 → 0 */
        移寄存器帧64(3, 临时基 + 224 - 当前帧大小);
        移即(0, 0);
        汇发("    存字节 [r3], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 0); 发字节(0x88); 模字节(0, 0, 3);
        移寄存器帧64(0, 临时基 + 220 - 当前帧大小);
        相对跳转(-1); 补标号(码位 - 4, 目二, 2);
        设标号(目二);
    }
}

/* 结构体 逐块拷贝: 堆九=源地址, rbx=目标地址, 逆平 字节 (8/4 块; 修复 2026-08-06 结构体 值赋值)
   每步带 汇发 文本 —— 否则 -S 缺指令, 首利二==计简一 崩 (修复 2026-08-06 route_learn 四核验证抓到) */
静 整 构值源可址 = 1; /* R401 (2026-09-29): **结构体值块拷贝** 的「源 是否 可取址」标记 —— 默认 1 (允许); 源 为 常量 (如 `空` 退化的 0) 时 置 0 ⟹ **消费端 `深利` 也 不发射** (第 400 站教训: 只守 求值端 不够, 消费端 必须 同受约束) */
静 空 深利(整 逆平) {
    整 键 = 0;
    循环 (逆平 - 键 >= 8) {
        移寄存器内存64(1, 0); /* rcx = [堆九] */
        汇发("    存64 [r3], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        前缀字节(1, 0, 0, 0); 发字节(0x89); 模字节(0, 1, 3); /* 移动 [rbx], rcx */
        后弊一(8);
        汇发("    加即64 r3, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        前缀字节(1, 0, 0, 0); 发字节(0x83); 模字节(3, 0, 3); 发字节(8); /* 加 rbx, 8 (64 位) */
        键 += 8;
    }
    若 (逆平 - 键 >= 4) {
        移寄存器内存(1, 0); /* ecx = [堆九] */
        汇发("    存零 [r3], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0x89); 模字节(0, 1, 3); /* 移动 [rbx], ecx (去冗余 扩展前缀 0x40, 与存零文本一致) */
        后弊一(4);
        汇发("    加即64 r3, 4\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        前缀字节(1, 0, 0, 0); 发字节(0x83); 模字节(3, 0, 3); 发字节(4);
        键 += 4;
    }
}

/* 整数 右操作数 → 64 位目标: 有符号 32 位值符号扩展 符号扩展64 堆九,首子
   (修复 2026-08-06: 长整 长整 v=-7 存 64 位槽时零扩展 → 4294967289; 正数/无符号/已 邻辰 不动) */
静 空 扩32(整 右侧) {
    若 (右侧 >= 0 && !节长标[右侧] && !节无符号[右侧] && !表达式是否无符号(右侧)) {
        若 (节型别[右侧] == 节点_变量 && (变量指元素((字*)(节名表+右侧)) > 0 || 变量数组((字*)(节名表+右侧)) > 0)) 返; /* 指针/数组值不扩展 */
        若 (节点指元素(右侧) > 0) 返; /* 启元 Q10 (2026-09-23): 值 是 指针/数组/成员数组 地址 ⟹ 64 位 ⟹ 免 符号扩展. 同 R27 家族 — 值是 64 位地址却被 movsxd 截高32. 载体 ctx->buf + ctx->blen (jylib sha256_final L147): mov ctx,rax / add         若 (节型别[右侧] == 节点_取址) 返;x28,rax / movslq %eax,%rax ⟹ 基址高32清零 ⟹ memset 写崩 0xC0000005. 甲言 已让 该 成员数组+整数 走 64 位路径 (C141 插桩实证 子0型=15 旧乙=1), 路径内 却 对 左操作数 无条件 扩32. 判据 节点指元素 对 成员/箭头/下标/二元 已能正确返 元素尺寸; 对 标量 返 0 ⟹ 本行 纯追加. */
        若 (节型别[右侧] == 节点_取址) 返; /* 第 213 站 R27 (2026-09-21 真接入): **取址结果 是 64 位指针值**, 与 上一条 同族语义 —— 必须 一并豁免.
           原 豁免 只认 节点_变量(指针/数组) ⟹ `h.a = &t;` 的 `&t`(节点_取址) 被当「32 位有符号值」补 movsxd:
           反汇编 铁证 `lea rax,[rbp-0x1140]` 紧跟 `movsxd rax,eax` ⟹ (a) 低 32 位 >= 0x80000000 时 填 0xFFFFFFFF 前缀;
           (b) 只要 原地址 **高 32 位 非 0** 就 被 清零 ⟹ 指针 破坏 (当前 用户态 栈地址 高 32 位 通常 = 0 ⟹ 暂未 暴雷, 但属 真缺陷).
           判据 用 节点类型 (取址 ⟹ 结果 必 64 位), 不依赖 节长标 —— 比在 取址节点 处 补 节长标=1 影响面更窄 (后者 会被 其他 读到 节长标 的判据 消费). */
        汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        发字节(0x48); 发字节(0x63); 模字节(3, 0, 0);
    }
}

/* 修复 2026-08-11 汇编本身: __asm("指令") 字符串汇编编码器 (满双).
   支持内核常用指令: 停机/空操作/返回/开中断/关中断/断点/iretq + 压栈/弹栈 + 移动/加/减/比较 寄存器/立即数.
   Intel 语法 "移动 堆九, 0x10" / "移动 堆九, rbx". */
静 整 栈八(常 字 *串值) {
    构 { 常 字 *数; 整 末丙; } 计浅一[] = {
        {"rax",0},{"rcx",1},{"rdx",2},{"rbx",3},{"rsp",4},{"rbp",5},{"rsi",6},{"rdi",7},
        {"eax",0},{"ecx",1},{"edx",2},{"ebx",3},{"esp",4},{"ebp",5},{"esi",6},{"edi",7},
        {"al",0},{"cl",1},{"dl",2},{"bl",3},{"spl",4},{"bpl",5},{"sil",6},{"dil",7},
        {"r8",8},{"r9",9},{"r10",10},{"r11",11},{"r12",12},{"r13",13},{"r14",14},{"r15",15},
        {"r8d",8},{"r9d",9},{"r10d",10},{"r11d",11},{"r12d",12},{"r13d",13},{"r14d",14},{"r15d",15},
    };
    遍 (整 计 = 0; 计 < (整)(大小(计浅一)/大小((计浅一)[0])); 计++) 若 (!比较字符串(串值, 计浅一[计].数)) 返 计浅一[计].末丙;
    返 -1;
}
静 空 值壹(常 字 *计肆) {
    字 缓[256]; 拷贝前n(缓, 计肆, 255); 缓[255] = 0;
    字 *算子 = 缓; 循环 (*算子 == ' ' || *算子 == '\t') 算子++;
    字 *缺聚 = 算子; 循环 (*缺聚 && *缺聚 != ' ' && *缺聚 != '\t' && *缺聚 != ',') 缺聚++;
    字 算子码[64]; 整 右利 = 缺聚 - 算子; 若 (右利 > 31) 右利 = 31; 复制内存(算子码, 算子, 右利); 算子码[右利] = 0;
    /* 接入 2026-08-29 阶段二 指令词表 短进.1: 中文指令等价 — __asm("移动 堆九, 0x10") == __asm("移动 堆九, 0x10") (用户可写中文汇编) */
    若 (!比较字符串(算子码, "停机")) 复制字符串(算子码, "hlt");
    否 若 (!比较字符串(算子码, "空操作")) 复制字符串(算子码, "nop");
    否 若 (!比较字符串(算子码, "返回")) 复制字符串(算子码, "ret");
    否 若 (!比较字符串(算子码, "开中断")) 复制字符串(算子码, "sti");
    否 若 (!比较字符串(算子码, "关中断")) 复制字符串(算子码, "cli");
    否 若 (!比较字符串(算子码, "断点")) 复制字符串(算子码, "int3");
    否 若 (!比较字符串(算子码, "中断返回")) 复制字符串(算子码, "iretq");
    否 若 (!比较字符串(算子码, "压栈")) 复制字符串(算子码, "push");
    否 若 (!比较字符串(算子码, "弹栈")) 复制字符串(算子码, "pop");
    否 若 (!比较字符串(算子码, "移动")) 复制字符串(算子码, "mov");
    否 若 (!比较字符串(算子码, "加法")) 复制字符串(算子码, "add");
    否 若 (!比较字符串(算子码, "减法")) 复制字符串(算子码, "sub");
    否 若 (!比较字符串(算子码, "比较")) 复制字符串(算子码, "cmp");
    循环 (*缺聚 == ' ' || *缺聚 == '\t' || *缺聚 == ',') 缺聚++;
    字 *整凶 = 缺聚; 循环 (*整凶 == ' ' || *整凶 == '\t') 整凶++;
    /* 单操作数或无操作数指令 */
    若 (!比较字符串(算子码, "hlt")) { 发字节(0xF4); 返; }
    若 (!比较字符串(算子码, "nop")) { 发字节(0x90); 返; }
    若 (!比较字符串(算子码, "ret") || !比较字符串(算子码, "retq")) { 发字节(0xC3); 返; }
    若 (!比较字符串(算子码, "sti")) { 发字节(0xFB); 返; }
    若 (!比较字符串(算子码, "cli")) { 发字节(0xFA); 返; }
    若 (!比较字符串(算子码, "int3")) { 发字节(0xCC); 返; }
    若 (!比较字符串(算子码, "iretq")) { 发字节(0x48); 发字节(0xCF); 返; }
    /* 压栈/弹栈 寄存器 */
    若 (!比较字符串(算子码, "push") || !比较字符串(算子码, "pop")) {
        字 *前简 = 整凶; 循环 (*前简 == '%') 前简++;
        整 结 = 栈八(前简);
        若 (结 >= 0) {
            若 (结 < 8) {
                若 (!比较字符串(算子码, "push")) 发字节(0x50 + 结); 否 发字节(0x58 + 结);
            } 否 {
                整 链劣 = 结 - 8;
                若 (!比较字符串(算子码, "push")) { 发字节(0x41); 发字节(0x50 + 链劣); }
                否 { 发字节(0x41); 发字节(0x58 + 链劣); }
            }
            返;
        }
    }
    /* 双操作数: 移动/加/减/比较 目标, 源 */
    字 *前厚 = 整凶; 循环 (*前厚 && *前厚 != ',') 前厚++;
    若 (*前厚 == ',') {
        *前厚 = 0; 前厚++;
        循环 (*前厚 == ' ' || *前厚 == '\t') 前厚++;
        字 *目标 = 整凶; 循环 (*目标 == '%') 目标++;
        字 *源 = 前厚; 循环 (*源 == '%') 源++;
        整 左集 = 栈八(目标), 计一 = 栈八(源);
        /* 立即数: 0xNN 或 数字 */
        整 立即数 = 0; 整 域伴 = (源[0] == '$') || (源[0] >= '0' && 源[0] <= '9');
        若 (域伴) {
            若 (源[0] == '$') 源++;
            若 (源[0] == '0' && (源[1] == 'x' || 源[1] == 'X')) 立即数 = (整)字符串转长整(源, 0, 16);
            否 立即数 = 转整数(源);
            若 (左集 >= 0) {
                整 下利 = 目标[0] == 'r';
                若 (!比较字符串(算子码, "mov")) {
                    若 (左集 < 8) { 若 (下利) 发字节(0x48); 发字节(0xC7); 发字节(0xC0 + 左集); 发四(立即数); }
                    否 { 发字节(0x49); 发字节(0xC7); 发字节(0xC0 + 左集 - 8); 发四(立即数); }
                    返;
                }
                若 (!比较字符串(算子码, "add")) {
                    若 (左集 < 8) { 若 (下利) 发字节(0x48); 发字节(0x81); 发字节(0xC0 + 左集); 发四(立即数); }
                    否 { 发字节(0x49); 发字节(0x81); 发字节(0xC0 + 左集 - 8); 发四(立即数); }
                    返;
                }
                若 (!比较字符串(算子码, "sub")) {
                    若 (左集 < 8) { 若 (下利) 发字节(0x48); 发字节(0x81); 发字节(0xE8 + 左集); 发四(立即数); }
                    否 { 发字节(0x49); 发字节(0x81); 发字节(0xE8 + 左集 - 8); 发四(立即数); }
                    返;
                }
                若 (!比较字符串(算子码, "cmp")) {
                    若 (左集 < 8) { 若 (下利) 发字节(0x48); 发字节(0x81); 发字节(0xF8 + 左集); 发四(立即数); }
                    否 { 发字节(0x49); 发字节(0x81); 发字节(0xF8 + 左集 - 8); 发四(立即数); }
                    返;
                }
            }
        }
        /* 寄存器, 寄存器 */
        若 (左集 >= 0 && 计一 >= 0) {
            整 隔庚 = 目标[0] == 'r';
            若 (!比较字符串(算子码, "mov")) {
                若 (左集 < 8 && 计一 < 8) {
                    若 (隔庚) 发字节(0x48);
                    发字节(0x89); 发字节(0xC0 + 计一 * 8 + 左集);
                } 否 若 (左集 >= 8 && 计一 < 8) { 发字节(0x4D); 发字节(0x89); 发字节(0xC0 + 计一 * 8 + (左集 - 8)); }
                否 若 (左集 < 8 && 计一 >= 8) { 发字节(0x4C); 发字节(0x89); 发字节(0xC0 + (计一 - 8) * 8 + 左集); }
                否 { 发字节(0x4D); 发字节(0x89); 发字节(0xC0 + (计一 - 8) * 8 + (左集 - 8)); }
                返;
            }
            若 (!比较字符串(算子码, "add") || !比较字符串(算子码, "sub") || !比较字符串(算子码, "cmp")) {
                整 基 = !比较字符串(算子码, "add") ? 0x01 : (!比较字符串(算子码, "sub") ? 0x29 : 0x39);
                若 (左集 < 8 && 计一 < 8) { 若 (隔庚) 发字节(0x48); 发字节(基); 发字节(0xC0 + 计一 * 8 + 左集); }
                否 若 (左集 >= 8 && 计一 < 8) { 发字节(0x4D); 发字节(基); 发字节(0xC0 + 计一 * 8 + (左集 - 8)); }
                否 若 (左集 < 8 && 计一 >= 8) { 发字节(0x4C); 发字节(基); 发字节(0xC0 + (计一 - 8) * 8 + 左集); }
                否 { 发字节(0x4D); 发字节(基); 发字节(0xC0 + (计一 - 8) * 8 + (左集 - 8)); }
                返;
            }
        }
    }
    输出到文件(错误流, "[ERR] __asm 未编码: %s\n", 计肆);
}

/* 指针表达式节点的元素大小 (T* → 尺寸(T); 数组名 → 元素宽; 非指针 → 0)
   修复 2026-08-20: 成员访问 p->字段 也是指针 — 原指针运算只识别 转型/纯变量名,
   `d.入口 + 1` 不缩放 (步进 1 字节 → 全错位), `目标 - d.入口` 不识别 →
   prune_directory `目录->nr = 目标 - 目录->入口` 算错 → 版本库 加 丢全部文件. */
静 整 源辰一(整 数) { /* 查询 成员-链 字段 结构体 构序 (pure 查询, 无 码生成器) - t49e 修复 */
    若 (数 < 0) 返 -1;
    整 暂 = 节型表[数];
    若 (暂 == 1) { 字 *变节 = (字*)(节名表 + 数); 返 变量型序(变节); }
    若 (暂 == 13 || 暂 == 15) {
        整 基 = 源辰一(子0[数]);
        若 (基 < 0) 返 -1;
        字 *函 = (字*)(节名表 + 数);
        返 字段类型序直(基, 函);
    }
    若 (暂 == 11) 返 源辰一(子0[数]); /* &表达式 */
    若 (暂 == 12) 返 源辰一(子0[数]); /* *指针 */
    返 -1;
}
静 整 节点指元素(整 数) {
    若 (数 < 0) 返 0;
    若 (节型别[数] == 节点_调用) { /* C140 (2026-09-19 第 130 站): **调用 返回指针 的 元素 尺寸** —— `f() + 1` / `*(f() + N)` / `f()[i]` 的 缩放 依据.
        原 无本分支 ⟹ `getp() + 1` 按 **字节** 加 (反汇编实证: `add %rbx,%rax` 且 无 `imul`, 对照 `gp + 1` 有 `mov $8 / imul`) ⟹ 解引用 读到 g[0] 的 首字节 (矩阵 A5 得 0.00).
        判据 复用 C139b 的 `查函数浮指返` (返回 指针 指向 双精度 ⟹ 元素 必 8); 其余 返回型 (字符 指针/整数 指针) 仍 返 0 — 与 C138 的窄判据 一致, 不猜. */
        整 末本 = 节末子(数); 整 函本 = (末本 >= 0) ? 取子(数, 末本) : -1;
        若 (取环境("QCC_DBG_C140")) 输出到文件(错误流, "[C140] 末子=%d 函=%d 型=%d 名=%s 浮指=%d\n", 末本, 函本, (函本 >= 0 ? 节型别[函本] : -9), (函本 >= 0 ? (字*)(节名表 + 函本) : (字*)"?"), (函本 >= 0 ? 查函数浮指返((字*)(节名表 + 函本)) : -9)); /* 暂存 diag */
        若 (函本 >= 0 && 节型别[函本] == 节点_变量) { 字 *名本 = (字*)(节名表 + 函本); 若 (查函数浮指返(名本)) 返 8; }
        否 { /* 兜底: 逐子 反向 找 变量节点 (被调者 = 末子; `节末子` 对 某些 调用节点 布局 可能 非 末位) */
            遍 (整 帧甲 = 19; 帧甲 >= 0; 帧甲--) { 整 符甲 = 取子(数, 帧甲); 若 (符甲 >= 0 && 节型别[符甲] == 节点_变量) { 字 *名甲 = (字*)(节名表 + 符甲); 若 (查函数浮指返(名甲)) 返 8; 断; } }
        }
        返 0;
    }
    若 (节型别[数] == 节点_解引用 && 子0[数] >= 0 && 节型别[子0[数]] == 节点_二元) { /* C9b 刀6: **衰减后 类型 必须 传播** —— `*(指针到数组 + n)` 已 衰减 为 元素指针, 其 元素 尺寸 应 是 最内层 标量; 原 无本分支 ⟹ 落 `指元素[数]` 拿到 解析期 登记的 **整体数组尺寸** (整数(*)[3] ⟹ 12) ⟹ 外层 `X + 2` 按 ×12 缩放 ⟹ 越界 读 0 (探针 g2: `*((*(pm+1)) + 2)` 得 0, 应 6). `表达式内重` 的 二元穿透 (C9 刀1) 保证 它 给 4. */
        整 内十 = 表达式内重(数); 若 (内十 > 0) 返 内十;
    }
    若 (节型别[数] == 节点_二元) { /* 二进制 算子 节点: 指针 +/- 表达式 (t49c4 修复) */
        若 (节值表[数] == 5 || 节值表[数] == 6) {
            整 末 = 节点指元素(子0[数]);
            若 (末 > 0) 返 末;
            返 节点指元素(子1[数]);
        }
    }
    若 (指元素[数] < 0) 返 0; /* t35k 2026-08-23: 非指针整数 转型 (uintptr_t/size_t) 哨兵 → 指针算术不缩放 (原 (uintptr_t)p-1 按 节点指元素=4 缩放 → cb_node_of p-4 → cbtree 崩) */
    若 (指元素[数] > 0) 返 指元素[数]; /* (T*) 转型 元素大小 (修复 2026-08-19) — 必须先于 节型表==11 结构推断: (字符*)&数组[i] 的 转型 在操作数上写 指元素=1, 取址推断不得覆盖 (修复 2026-08-25 步二十 回归: regress_cmdlist/结构对齐回归) */
    若 (节型别[数] == 节点_取址) { /* &表达式: 取址数组元素 → 指针元素大小 = 基数组元素大小 (修复 2026-08-25 步二十: &数组[i]-&数组[j] 缩放; 变量指针差 p-q 已修, 取址下标差值是最后缺口; 只有下标操作数才缩放, 其他取址返回 0 保持原行为) */
        整 算子 = 子0[数];
        若 (算子 >= 0 && 节型别[算子] == 节点_下标) { 整 内一 = 节点指元素(子0[算子]); 若 (内一 > 0) 返 内一; 整 内二 = 表达式内重(算子); 若 (内二 > 0) 返 内二; } /* &数组[i] → 数组/指针基元素大小 (整数 数组→4, 双精度 da→8, 结构体 宽升→尺寸, 字符→1 无缩放). ★C12b (2026-09-28 虾米 · 批次 A 第二刀): 插桩 [C12B] 实录 `数=5023 型数=11 子0=5027 型0=14 递归=0` ⟹ `&farr[1][1]` 是【取址】节点(型11)、子0 是【下标】(型14)，而 `节点指元素(下标节点)` **返 0**（`指元素[下标]` 解析期未登记）⟹ 原判据落 `返 0` ⟹ `&farr[1][1] - &farr[0][1]` 不缩放（实测甲言 8 / gcc 2）。故补【降级链】：先 `节点指元素(基)`，再 `表达式内重(下标本身)`。 */
        若 (算子 >= 0 && 节型别[算子] == 节点_解引用) { 整 内子 = 节点指元素(算子); 若 (内子 > 0) 返 内子; } /* C12b: `&*X` 形态 —— 子0 是解引用时递归取指元素 */
        返 0;
    }
    若 (节型别[数] == 节点_赋值) 返 节点指元素(子0[数]); /* 复合赋值 (p += N): 返回左操作数元素大小 (修复 2026-08-25 步十七: ((p+=8)-8) 减法 满一一 原=0 无缩放 → 整数 指针/双精度 指针差错位; 字符 指针碰巧对) */
    若 (节型别[数] == 节点_变量) { /* 变量名: 数组名→元素宽, T** 指针→数组元素尺寸(8), T*→指元素尺寸 */
        字 *变节 = (字*)(节名表 + 数);
        遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--)
            若 (!比较字符串(变量表[变序].名, 变节) && 变量码生成可见(变序)) {
                若 (取环境("QCC_DBG_NS")) 输出到文件(错误流, "[NPSZ] var '%s' arr_sz=%d arr_esz=%d p_esz=%d\n", 变节, 变量表[变序].数组尺寸, 变量表[变序].数组元素尺寸, 变量表[变序].指元素尺寸); /* 暂存 diag */
                若 (变量表[变序].数组元素尺寸 > 0) 返 变量表[变序].数组元素尺寸; /* 数组行/T** 元素 (T** 的 数组元素尺寸=8, 指元素尺寸=4 — 修复 2026-08-20: 原优先 指元素尺寸 → 目标-入口 按 4 缩放错) */
                返 变量表[变序].指元素尺寸;
            }
        返 0;
    }
    若 (节型别[数] == 节点_箭头 || 节型别[数] == 节点_成员) { /* s.字段 / p->字段: 指针字段的元素大小 */
        整 微码 = 数;
        字 *函 = (字*)(节名表 + 微码);
        整 构序二 = 源辰一(子0[微码]); /* 修复 2026-08-23 t49e: (&表达式)->字段 基 */
        若 (构序二 >= 0) {
            整 域序 = 字段序(构序二, 函);
            若 (域序 >= 0 && 类型表[构序二].字段[域序].原进)
                返 类型表[构序二].字段[域序].符肆 ? 类型表[构序二].字段[域序].符肆 : 8;
            /* 修复 2026-08-22 #42d: 数组字段的指针算术缩放 — 整数 lens[320] + n 原返回 0
               → 不缩放 → 构一->lens+hlit 步进 1 字节 → 解压 动态表 dist 表指针错位
               → 垃圾 maxbits 崩. 数组字段 (内联!=现捌 或 flex) 返回元素大小. */
            若 (域序 >= 0 && 末凶一(构序二, 函))
                返 构域元素(构序二, 函);
        }
        返 0;
    }
    返 0;
}

/* ==== 阶段 3 中间表示 骨架 号合 (阶段B) ==== */
#define 高散 2000000
静 整 短次一[高散], 中参数a[高散], 中参数b[高散], 中参数c[高散];
静 整 空失;
静 空 原肆(常 字 *尾捌); /* -图 旁路: 调用关系记录 (定义在 主 前, 前向声明供 例四 使用) */
静 空 中发(整 算子, 整 甲, 整 发字节, 整 字符) {
    若 (空失 >= 高散) { 输出到文件(错误流, "[IR-OVERFLOW] ir_n=%d\n", 空失); 退出(1); }
    短次一[空失] = 算子; 中参数a[空失] = 甲; 中参数b[空失] = 发字节; 中参数c[空失] = 字符; 空失++;
}
