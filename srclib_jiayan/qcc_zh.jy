                    否 若 (节长标[字符] || 查函数长(串升, 槽数)) { 码生成(字符); 若 (!节长标[字符]) 扩32(字符); 中发(中压栈64rax, 0, 0, 0); 中刷(); } /* Phase3-IR; fix 2026-08-25 bug#30: int 实参→ll 形参符号扩展 (add5(1,255,255,255,-5) 的 -5) */
