                        整 存系 = (整)取字长(容子一);
                        若 (出序 + 存系 + 2 >= 容量) { 容量 = 出序 + 存系 + 16384; 出 = 重分配(出, 容量); }
                        复制内存(出 + 出序, 容子一, 存系); 出序 += 存系;
                        出[出序++] = '\n';
                        释放内存(容子一);
                    } 否 {
                        复制内存(出 + 出序, 指, 计属 + 1); 出序 += 计属 + 1; /* 非 已找到: 跳过 */
                    }
                }
                否 {
                    字 串升[512]; 整 己序 = 0;
                    寻++; 循环 (*寻 && *寻 != '"' && 己序 < 510) 串升[己序++] = *寻++;
                    串升[己序] = 0;
                    若 (己序 > 0) {
                        字 *容复 = 元低(串升);
                        若 (!容复) { 输出到文件(错误流, "[ERR] 第%d行 #包含: 找不到文件 '%s'\n", 旁亥(源, (整)(指 - 源)), 串升); 退出(1); } /* 修复 2026-08-06 任务 5.3: 行号定位 */
                        字 双零[512]; 邻繁(串升, 双零, 大小(双零)); /* 修复 2026-08-13 第三阶段: 子目录 包含 相对当前源文件目录 */
                        字 满利[1024]; 满利[0] = 0;
                        复制字符串(满利, 序己); /* 修复 2026-08-26 媒体库: 基于实际找到的目录 (父链回溯命中), 再拼 串升 子目录 — 原从 空七 拼接 (父链找到的头记错位置 → 头内相对 包含 解析错); libavutil/公共.h 经父链在根找到, 实际目录=根+libavutil */
                        若 (双零[0]) { 拼接(满利, "/"); 拼接(满利, 双零); }
                        若 (净厚 < 16) { 复制字符串(空七[净厚], 满利); 净厚++; } 否 原得("包含目录栈 inc_dir", 16);
                        字 *取指数 = 缓卯(容复, 深度 + 1);
                        净厚--;
                        释放内存(容复);
                        整 元素 = (整)取字长(取指数);
                        若 (出序 + 元素 + 2 >= 容量) { 容量 = 出序 + 元素 + 16384; 出 = 重分配(出, 容量); }
                        复制内存(出 + 出序, 取指数, 元素); 出序 += 元素;
                        出[出序++] = '\n';
                        释放内存(取指数);
                    }
                }
            } 否 {
                /* 修复 2026-08-07: 注册 #定义 名 → 包含 守卫生效; #未定义 移除 */
                整 内戊 = ((!比前n(指深度, "define", 6) && (指深度[6] == 0 || 指深度[6] == ' ' || 指深度[6] == '\t' || 指深度[6] == '\r' || 指深度[6] == '\n')) || (!比前n(指深度, "定义词", 9) && (指深度[9] == 0 || 指深度[9] == ' ' || 指深度[9] == '\t' || 指深度[9] == '\r' || 指深度[9] == '\n')));
                整 高属 = (!比前n(指深度, "undef", 5) && (指深度[5] == 0 || 指深度[5] == ' ' || 指深度[5] == '\t' || 指深度[5] == '\r' || 指深度[5] == '\n')) || (!比前n(指深度, "未定义", 9) && (指深度[9] == 0 || 指深度[9] == ' ' || 指深度[9] == '\t' || 指深度[9] == '\r' || 指深度[9] == '\n'));
                若 (内戊 && !顺一) {
                    字 新升一[64]; 整 现二 = 0;
                    毛简(指, 新升一, &现二); /* 修复 2026-08-07: 名字+数值都记 */
                    若 (新升一[0]) 首丙一(新升一, 现二);
                } 否 若 (高属) {
                    常 字 *寻 = 指深度 + 5;
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                    字 新升一[64]; 整 宏序 = 0;
                    循环 (判字母数字((无 字)*寻) || *寻 == '_' || ((无 字)*寻 >= 0x80)) { 若 (宏序 < 63) 新升一[宏序++] = *寻; 寻++; }
                    新升一[宏序] = 0;
                    若 (宏序 > 0) 缺得(新升一);
                }
                复制内存(出 + 出序, 指, 计属 + 1); 出序 += 计属 + 1;
            }
        } 否 {
            复制内存(出 + 出序, 指, 计属 + 1); 出序 += 计属 + 1;
        }
        若 (出序 >= 容量 - 4096) { 容量 *= 2; /* 修复 2026-08-13 第三阶段: 倍增替代 +32768 (提升 重分配 泄漏) */; 出 = 重分配(出, 容量); }
        指 = *小于等 ? 小于等 + 1 : 小于等;
    }
    出[出序] = 0;
    返 出;
}

