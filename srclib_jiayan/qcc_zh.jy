                            否 若 (变量指元素(变名) > 0) { 中发(容重, 偏移 - 当前帧大小, 0, 0); 中刷(); } /* Phase3-IR case10 */
                            否 若 (变量是否长(变名)) { 中发(容重, 偏移 - 当前帧大小, 0, 0); 中刷(); } /* Phase3-IR case10 */
                            否 若 (宽复(变名)) { 中发(容重, 变量基(变名, 偏移) - 当前帧大小, 0, 0); 中刷(); } /* Phase3-IR case10 */
                            否 若 (变量是否字符(变名)) { 中发(终九, 偏移 - 当前帧大小, 0, 0); 中刷(); } /* Phase3-IR case10 */
否 若 (变量是否短(变名)) { 中发(外玖, 偏移 - 当前帧大小, 0, 0); 中刷(); } /* Phase3-IR case10: short 2 字节截断存 */
                            否 { 中发(堆庚, 偏移 - 当前帧大小, 0, 0); 中刷(); }
                        }
                    }
                } 否 {
                若 (子1[数] >= 0 && 节浮标[子1[数]] && 变量指元素(变名) == 0 && !变量指浮(变名)) { 码生成浮(子1[数]); 现简(); } /* double RHS → int target; POINTER targets take the ADDRESS (fix 2026-08-16: n1[n]=-1 守卫) */
                否 码生成(子1[数]);
