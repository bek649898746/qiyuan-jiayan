                    前缀字节(0, 0, 0, 1); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 r11d */
                    前缀字节(0, 0, 0, 1); 发字节(0xFF); 模字节(3, 1, 2); /* 递减 r10d — 扩展前缀.B(r10=rdx), 寄存器=1(/1=递减) */
                    相对跳转(-1); 补标号(码位 - 4, 标属, 2);
                    设标号(深高);
                    移寄存器(0, 8); } /* 清零循环用 首子 存 0 覆盖了返回地址 — 恢复 r8 到 堆九 (修复 2026-08-20) */
