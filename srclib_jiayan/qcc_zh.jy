            数组数一 = 计数二 + 1;
            词位 = 存词位;
        }
        末午(变节, 数组数一, 数组元素尺寸);
        接子(发字节, 元); /* 声明 */
        整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), 变节, 32);
        整 维数表[1]; 维数表[0] = 数组数一;
        词位++; /* 跳过 { */
        左升(右丙, 标识序, 维数表, 1, 0, 数组元素尺寸);
    } 否 若 (是否构标) {
        变构(变节, 构序);
        接子(发字节, 元);
        整 标识序 = 建节(1); 复制内存((字*)(节名表 + 标识序), 变节, 32);
        词位++; /* 跳过 { 先跳 左花 (值布 从 左花 后开始) */
