                    字 中粗[64]; 整 中进 = 字节一 - 副高 + 1; 若 (中进 < 63) { 复制内存(中粗, 段 + 副高, 中进); 中粗[中进] = 0; } 否 中粗[0] = 0;
                    若 (!比较字符串(中粗, "int") || !比较字符串(中粗, "void") || !比较字符串(中粗, "char") || !比较字符串(中粗, "double") || !比较字符串(中粗, "long") || !比较字符串(中粗, "short") || !比较字符串(中粗, "unsigned") || !比较字符串(中粗, "const") || !比较字符串(中粗, "FILE")) 整伍 = 1; /* fix 2026-08-14: 去掉 static/extern — 它们是存储类不是类型, static GIT_PATH_FUNC(...) 宏生成函数被误判声明不展开 → 参数 STR 卡死 */
