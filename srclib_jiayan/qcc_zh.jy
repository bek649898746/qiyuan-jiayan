                    汇发("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,4,3); 发字节(0xF8);
                    移寄存器(8, 11);                        /* r8d = 对齐起始 (头) */
                    汇发("    加 r11, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,0,3); 发字节(8); /* 数据区 */
                    移寄存器(10, 2);                        /* r10d = 尺寸 (rdx) */
                    汇发("    加 r11, r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,1,0,1); 发字节(0x01); 模字节(3,2,3); /* 加 r11d, r10d */
                    汇发("    加 r11, 7\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,0,3); 发字节(7);
                    汇发("    与 r11, -8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0x83); 模字节(3,4,3); 发字节(0xF8);
                    移寄存器(0, 11);                        /* 首子 = 新 计数器 */
                    整 序三 = 数据基址 - 0x1000 - 码位 - 6;
                    终拆(序三);
                    汇发("    存32 [r8], r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,0); 发字节(0x89); 模字节(0,2,0); /* 移动 [r8], edx — 头 = 尺寸 */
                    移寄存器(0, 8);                         /* 返回 头 */
                    汇发("    加 r0, 8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x83); 模字节(3,0,0); 发字节(8); /* 数据区 */
                    设标号(宽辰一);
                    }
                }
            } 否 若 (!比较字符串(串升, "free")) {
                移即(0, 0);
            } 否 若 (!比较字符串(串升, "fclose")) {
                /* 修复 2026-08-19: msvcrt fdopen 的 运行库 文件* → 提取 fd@+28 → msvcrt _close(fd)。
                   原 关文件 恒 无-算子 → close_tempfile_gently 不关锁文件 fd →
                   qcc_rename_impl 的 _unlink(头.锁) 因文件占用失败 → 头.锁 残留。
                   目标文件 模式: 函数指针≥0x10000 (运行库 文件*) 走 _close; 函数指针<0x10000 (编译器 打开文件 句柄)
                   或 函数指针==0 → 无-算子 (无 CloseHandle 导入, 沿用旧行为; 自身-宿主 只走此路)。 */
                若 (链接模式) {
                    整 初优 = 新标号();
                    移64(10, 1); /* r10 = 函数指针 (实参零) */
                    测寄存器(10, 10); 零跳(-1); 补标号(码位 - 4, 初优, 1);
                    汇发("    比较64 r10, 0x10000\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x49); 发字节(0x81); 发字节(0xFA); 发四(0x10000); /* 比较 r10, 0x10000 */
                    发字节(0x0F); 发字节(0x82); 发四(0); 补标号(码位 - 4, 初优, 1); /* jb 初优 (句柄 无-算子) */
                    发字节(0x41); 发字节(0x8B); 发字节(0x42); 发字节(28); /* 移动 首子, [r10+28] = 运行库 _file (fd) */
                    移64(1, 0); /* rcx = fd */
                    减栈即(32);
                    发字节(0xE8); 发四(0); 缺亥(码位 - 4, 0x0004, 新又("_close"), 0);
                    加栈即(32);
                    设标号(初优);
                    移即(0, 0); /* 返回 0 */
                } 否 {
                    移即(0, 0); /* 无-算子 (自身-宿主 打开文件 句柄 模型) */
                }
            } 否 若 (!比较字符串(串升, "fseek")) {
                /* 定位文件(流=rcx, 偏移=rdx, 起源=r8): SetFilePointer(句柄, 偏移, 空, 起源)
                   (修复 2026-08-24 t35v: 原 无-算子 → 定位文件 不生效 → files_for_each_reflog_ent_reverse 用
                   定位文件/取文件位置 反向读 reflog 全空 → read_ref_at reccnt=0 → rev-解析 头@{1} "日志 是 空";
                   仿 取文件位置 实现) */
                移64(10, 1); /* r10 = 句柄 */
                移64(11, 2); /* 后辰 = 偏移 (rdx 参数) */
                移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                减栈即(0x30); /* 影子 32 + 填充 16 */
                移64(1, 10); /* rcx = 句柄 */
                移64(2, 11); /* rdx = 偏移 */
                移64(9, 8);  /* r9 = 起源 (先保存, 因 r8 随后被 高 覆盖) */
                移即扩(8, 0); /* r8 = 空 (lpDistanceToMoveHigh) */
                调导入(5); /* SetFilePointer */
                加栈即(0x30);
                移64(4, 15);
            } 否 若 (!比较字符串(串升, "rewind")) {
                /* 倒带(流=rcx) = 定位文件(流, 0, 号汇) */
                移64(10, 1); /* r10 = 句柄 */
                移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
                减栈即(0x30);
                移64(1, 10);
                移即(2, 0);  /* rdx = 0 */
                移即扩(8, 0); /* r8 = 空 (高) */
                移即扩(9, 0); /* r9 = 文件头 (0) */
                调导入(5); /* SetFilePointer */
                加栈即(0x30);
                移64(4, 15);
            } 否 若 (!比较字符串(串升, "ftell")) {
                /* 取文件位置(流=rcx): SetFilePointer((句柄)流, 0, 空, FILE_CURRENT) — 返回文件当前位置
                   (修复 2026-08-18: 原恒返回 0 → 配置 do_event 偏移 = 0-1 = -1 → store_aux_event
                   开始/结束 全 -1 → 存储.已解析 垃圾 → git_config_set 写入循环 拷贝 错位 → .版本库/配置 写坏
                   ("[\n" 开头) → "非法 节 名 ''" → 版本库 初始化 失败) */
                移64(10, 1); /* r10 = 句柄 */
                移64(15, 4); 汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
                减栈即(0x30); /* 影子 32 + 填充 16 */
                移64(1, 10); /* rcx = 句柄 */
                移即(2, 0); /* rdx = 0 (距离 到 移动) */
                移即扩(8, 0); /* r8 = 空 (无 lpDistanceToMoveHigh) */
                移即扩(9, 1); /* r9 = FILE_CURRENT (1) */
                调导入(5); /* SetFilePointer */
                加栈即(0x30);
                移64(4, 15);
            } 否 若 (!比较字符串(串升, "exit")) {
                现戊(); /* ExitProcess(rcx) — C 出口() 必须 非 返回 */
            } 否 若 (!比较字符串(串升, "strcpy") || !比较字符串(串升, "strncpy")) {
                移寄存器(10, 8); 移64(9, 2); 移64(8, 1); /* ③: r10=n(保持 32位, 清零高32); 源/目标 指针 64位 */
                整 邻细一=新标号(), 前高=新标号();
                设标号(邻细一);
                测寄存器(10,10);零跳(-1);补标号(码位-4,前高,1);
                汇发("    读字节 r0, [r9]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0x8A);模字节(0,0,1); /* 移动 累加低, [r9] */
                汇发("    写字节 [r8], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0x88);模字节(0,0,0); /* 移动 [r8], 累加低 */
                汇发("    测试al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x84);发字节(0xC0);零跳(-1);补标号(码位-4,前高,1);
                汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1);发字节(0xFF);模字节(3,0,0); /* ③ REX.W=1: 原 0 ⟹ inc r8d ⟹ 指针 32 位回绕 */
                汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1,0,0,1);发字节(0xFF);模字节(3,0,1); /* ③ REX.W=1: 同上 */
                汇发("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0xFF);模字节(3,1,2);
                相对跳转(-1);补标号(码位-4,邻细一,2);
                设标号(前高);移寄存器(0,1);
            } 否 若 (!比较字符串(串升, "isalpha") || !比较字符串(串升, "isalnum")) {
                /* 正确实现: 字母 (判字母) / 字母数字 (判字母数字) 判断
                   (修复 2026-08-18: 原 移即(0,1) 恒 真 → 版本库 配置 解析器
                   `若 (!判字母(c)) 中断` 对 文件尾(-1) 不触发 → 空文件/读取失败报
                   "坏 配置 行 1" — 本地 配置 从未被正确读取) */
                移寄存器(1, 0); /* ecx = c (比较 用) */
                /* 大写 A-Z */
                移即(0, 'A'); 算寄存器(比等, 1, 0); 顺深一(宽排); 中失(); 移寄存器(10, 0);
                移即(0, 'Z'); 算寄存器(比等, 1, 0); 顺深一(隔系); 中失(); 算寄存器(25, 10, 0);
                移寄存器(11, 10); /* r11d = 大写 */
                /* 小写 a-z */
                移即(0, 'a'); 算寄存器(比等, 1, 0); 顺深一(宽排); 中失(); 移寄存器(10, 0);
                移即(0, 'z'); 算寄存器(比等, 1, 0); 顺深一(隔系); 中失(); 算寄存器(25, 10, 0);
                算寄存器(47, 11, 10); /* r11d |= 小写 */
                若 (!比较字符串(串升, "isalnum")) {
                    /* 数字 0-9 */
                    移即(0, '0'); 算寄存器(比等, 1, 0); 顺深一(宽排); 中失(); 移寄存器(10, 0);
                    移即(0, '9'); 算寄存器(比等, 1, 0); 顺深一(隔系); 中失(); 算寄存器(25, 10, 0);
                    算寄存器(47, 11, 10);
                }
                移寄存器(0, 11); /* 首子 = 结果 */
            } 否 若 (!比较字符串(串升, "tolower")) {
                /* tolower(c): ASCII 大写转小写 (修复 2026-08-18: 原外部 msvcrt tolower 未链接 →
                   恒返 0 → git_config_parse_key 的 存储键 全 0 → is_keys_section 匹配失败
                   → 存储.seen 空 → git_config_set 写入循环 拷贝 错位 → .版本库/配置 写坏) */
                移寄存器(1, 0); /* ecx = c (比较 用) */
                /* 大写标志 r10 = (c>='A') && (c<='Z') */
                移即(0, 'A'); 算寄存器(比等, 1, 0); 顺深一(宽排); 中失(); 移寄存器(10, 0);
                移即(0, 'Z'); 算寄存器(比等, 1, 0); 顺深一(隔系); 中失(); 算寄存器(25, 10, 0);
                /* 结果 = c + 0x20 * 标志 */
                移寄存器(11, 1); /* r11d = c */
                移即(0, 0x20); 算寄存器(下得, 0, 10); /* 首子 = 0x20 * 标志 */
                算寄存器(高拾, 11, 0); /* 后辰 += 首子 */
                移寄存器(0, 11); /* 首子 = 结果 */
            } 否 若 (!比较字符串(串升, "strlen")) {
                移64(8, 1); /* r8 = 指针 (rcx=实参零) — 修复 2026-08-22 t45: 原 移寄存器(8,1) 32 位移动 → 高 32 位清零 → 取字长(高地址指针) 零扩展 崩 (版本库 分支 used_atom[i].名.缓) */
                移即(0, 0); /* 首子 = 0 (计数) */
                整 暂双 = 新标号(), 符组 = 新标号();
                设标号(暂双);
                汇发("    零扩展 ecx, [r8]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0x0F); 发字节(0xB6); 模字节(0, 1, 0); /* 零扩展 ecx,字节[r8] */
                测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 符组, 1);
                汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 1); 发字节(0xFF); 模字节(3, 0, 0); /* 递增 r8 (64位 — 修复 2026-08-22 t45: 原 扩展前缀.W=0 递增 r8d 32位 → 高地址指针 (0xc0xxxxxx 栈) 低 32 位回绕 → 取字长 扫错内存 → strbuf_add 长度 错 → 版本库 初始化 路径损坏) */
                汇发("    自增 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xFF); 发字节(0xC0); /* 递增 首子 */
                相对跳转(-1); 补标号(码位-4, 暂双, 2);
                设标号(符组);
            } 否 若 (!比较字符串(串升, "复数")) { /* 接入 2026-08-28 复数 (蓝图 §一 数值类型族): 复数(a,b) → 堆九 = (长整 长整)b << 32 | a (64 位打包, 复用多返回值方案); 实部=低32 虚部=高32 */
                移64(0, 2); /* 堆九 = rdx = b (实参一, 32 位参数高 32 已清 0) */
                汇发("    左移64 r0, 32\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 0); 发字节(32); /* 左移一 堆九, 32 (域转 /4=左移一) */
                汇发("    或64 r0, r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x09); 模字节(3, 1, 0); /* 或 堆九, rcx (a=实参零 低 32, rcx 高 32 已清 0; 不用 后辰 避 扩展前缀 坑) */
            } 否 若 (!比较字符串(串升, "实部")) { /* 实部(z) → z 低 32 */
                移寄存器(0, 1); /* 首子 = ecx = z 低 32 */
            } 否 若 (!比较字符串(串升, "虚部")) { /* 虚部(z) → z 高 32 */
                移64(0, 1); /* 堆九 = rcx = z */
                汇发("    逻辑右移64 r0, 32\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xC1); 模字节(3, 5, 0); 发字节(32); /* 右移一 堆九, 32 (域转 /5=右移一 逻辑) */
            } 否 若 (!比较字符串(串升, "复加")) { /* 复加(a,b): a=rcx b=rdx → (反粗+栈进)<<32 | (ra+总五) */
                移寄存器(0, 1); /* 首子 = ecx (a 实部) */
                移寄存器(11, 2); /* r11d = edx (b 实部) */
                算寄存器(高拾, 0, 11); /* 首子 += r11d (ra+总五) */
                移寄存器(3, 0); /* ebx = 实部和 (低寄存器, 避 扩展前缀) */
                移64(0, 1); /* 堆九 = rcx (a) */
                汇发("    逻辑右移64 r0, 32\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xC1); 模字节(3, 5, 0); 发字节(32); /* 右移一 堆九, 32 */
                移寄存器(10, 0); /* r10d = 反粗 */
                移64(0, 2); /* 堆九 = rdx (b) */
                汇发("    逻辑右移64 r0, 32\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xC1); 模字节(3, 5, 0); 发字节(32); /* 右移一 堆九, 32 */
                算寄存器(高拾, 0, 10); /* 首子 += r10d (反粗+栈进) */
                汇发("    左移64 r0, 32\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0xC1); 模字节(3, 4, 0); 发字节(32); /* 左移一 堆九, 32 */
                汇发("    或64 r0, r3\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x09); 模字节(3, 3, 0); /* 或 堆九, rbx (实部和; 低寄存器无 扩展前缀.B) */
            } 否 若 (!比较字符串(串升, "inb")) {
                /* inb(端口): 端口 在 rcx; 返回 首子 = 累加低 (键盘 0x60/0x64) */
                移寄存器(2, 1);   /* 移动 edx, ecx (端口) */
                汇发("    读端口 al, dx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xEC); /* 在 累加低, dx */
                中失(); /* 零扩展 首子, 累加低 */
            } 否 若 (!比较字符串(串升, "outb")) {
                /* outb(端口, 数值): 端口 在 rcx, 数值 在 rdx */
                移寄存器(0, 2);   /* 移动 首子, edx (数值) */
                移寄存器(2, 1);   /* 移动 edx, ecx (端口) */
                汇发("    写端口 dx, al\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xEE); /* 出 dx, 累加低 */
                移即(0, 0);
            } 否 若 (!比较字符串(串升, "inl")) {
                /* inl(端口): 32-位 端口 读取, 端口 在 rcx, 返回 首子 */
                移64(2, 1); /* 移动 edx, ecx (端口) */
                汇发("    读端口32 eax, dx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xED); /* 在 首子, dx */
            } 否 若 (!比较字符串(串升, "outl")) {
                /* outl(端口, 数值): 32-位 端口 写入, 端口 在 rcx, 数值 在 rdx */
                移64(0, 2);  /* 移动 首子, edx (保存 数值) */
                移64(2, 1);  /* 移动 edx, ecx (端口) */
                汇发("    写端口32 dx, eax\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xEF); /* 出 dx, 首子 */
