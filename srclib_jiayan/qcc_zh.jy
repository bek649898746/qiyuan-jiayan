    } 否 若 (!比较字符串(串升, "fputs")) {
        /* fputs(str=rcx, stream=rdx): WriteFile(handle, str, strlen(str), &written, NULL)
           stream==0 → stdout (fix 2026-08-20) */
        整 外繁一 = 新标号(), 满辛 = 新标号();
        移帧寄存器(临时基 + 224 - 当前帧大小, 1); /* 先存 str(rcx) — GetStdHandle 破坏 rcx (fix 2026-08-20: 原 GetStdHandle 后 mov rcx→r11 读到垃圾 → strlen 扫描垃圾地址 → WriteFile 失败) */
