    码 = 内存分配(码缓容量); /* 4兆字节 目辰-分配: 自身-宿主 永不 reallocs (kills 该 提升-leak) */ 若 (!码) { 输出到文件(错误流, "qcc_x86: 初始化内存不足\n"); 返 1; } 码位 = 0; 初成 = 0;
    下退 = 256; 全伴 = 内存分配(下退); 反高 = 0; 段简 = 0;
    内存设置(邻拾, -1, 大小(邻拾));

    整 外癸 = 解析(源); /* 函数宏 收集+展开已在 解析 内 包含 展开之后执行 (修复 2026-08-07: 头文件函数宏可见) */
    暂卯(); /* 编译 DAG (可吞清单 阶段零-9): 抽象语法树 阶段哈希 (节型表/节值表/节名表/子0/子1 入链) */
    若 (总置 && !内吉[0]) { 整 双细 = (整)取字长(源); 深伴(源, 双细, 内吉); } /* 修复 2026-08-28: 源码阶段哈希 — 原在 主 缓存块算, 服务 不经过 主 → dag 载荷 源 空 */
    若 (外癸 < 0) { 输出到文件(错误流, "qcc_x86: 解析失败\n"); 返 1; }
    转储(); /* G0-4 (2026-09-11): QCC_DUMP 门控 结构化 转储 — 必须 在 生成码 之前 (生成码 重置 表) */
    若 (暂厚) { 容一(); 返 0; } /* 接口文件 (可吞清单 阶段一): 只解析导出, 不产码 (生成码 会重置 函数数 等表) */
    若 (新六) { 总升一(); 返 0; } /* 引用收集 (可吞清单 阶段一): 只解析导出引用表, 不产码 */
    若 (出注) { 遍 (整 计 = 0; 计 < 注解数; 计++) 输出到文件(错误流, "注解: %s = %s\n", 注解表[计].名, 注解表[计].值); 返 0; } /* #173: 注解表导出 */
    隔伍一 = 外癸;


    /* 二-通过 代: 通过 1 estimates 文本 尺寸 �?.数据 基; 通过 2 真 */
    净成 = 初成; 现降一 = 栈用量;
    数据基址 = 0x2000;
    若 (满双) {
        /* -左退一 模式: 裸二进制 (内核). 数据基址 动态=代码后对齐 (指令指针 相对 位移 位置无关),
           迭代稳定 (数据紧跟代码, 任意加载基址正确) */
        数据基址 = 0x2000;
        遍 (整 符平一 = 0; 符平一 < 8; 符平一++) {
            汇编遍 = 2;
            最终生成 = (符平一 == 7);
            生成码();
            最终生成 = 0;
            整 新三 = (0x1000 + 码位 + 4095) & ~4095;
            若 (新三 < 0x2000) 新三 = 0x2000;
            若 (新三 == 数据基址) 断;
            数据基址 = 新三;
        }
        汇编遍 = 0;
    } 否 若 (链接模式) {
        /* -c 模式：对象可重定位，只跑 通过 2（避免重定位/数据重复记录） */
        汇编遍 = 2;
        生成码();
        汇编遍 = 0;
    } 否 {
        汇编遍 = 1;
        生成码();
        数据基址 = (0x1000 + 码位 + 4095) & ~4095;
        若 (数据基址 < 0x2000) 数据基址 = 0x2000;
        汇编遍 = 2;
        最终生成 = 0;
        生成码();
        /* 修复 2026-08-05: 通过-2 代码 可 GROW 已过 该 通过-1 估计 (数据-见
           encodings 移位 带 该 .数据 基), 舍入 文本 已过 数据基址 →
           .文本/.数据 overlap → 非法可执行格式 193. Recompute 该 基 自
           该 通过-2 码位 且 re-生成 至 稳定. Intermediate 通过 是
           silent (最终生成=0) 故 该 -S 汇编 文件 持有 exactly 一 代码 拷贝. */
        遍 (整 符平一 = 0; 符平一 < 8; 符平一++) {
            整 新三 = (0x1000 + 码位 + 4095) & ~4095;
            若 (新三 < 0x2000) 新三 = 0x2000;
            若 (新三 == 数据基址) 断;
            数据基址 = 新三;
            生成码();
        }
        若 (汇编名[0]) { /* 修复 2026-08-24 Phase2: -S 模式需要 最终 (写 汇编 文本) — 最终生成=1 时 汇发 才写 */
            最终生成 = 1;
            生成码();
            最终生成 = 0;
            遍 (整 符平一 = 0; 符平一 < 8; 符平一++) {
                整 新三 = (0x1000 + 码位 + 4095) & ~4095;
                若 (新三 < 0x2000) 新三 = 0x2000;
                若 (新三 == 数据基址) 断;
                数据基址 = 新三;
                生成码();
                最终生成 = 1;
                若 (汇编输出) { 关文件(汇编输出); 汇编输出 = 打开文件(汇编名, "wb"); }
                生成码();
                最终生成 = 0;
            }
        } 否 {
            /* 修复 2026-08-24 Phase2 (飞轮提速): 非 -S 模式跳过 最终 — pass2 稳定代即可写 可执行,
               最终生成 仅影响 -S 文本, 不影响机器码正确性. 省 1/3 生成码 时间.
               实验: 跳过 最终 产物能自举, 自举不动点收敛到同一值. */
        }
        汇编遍 = 0;
    }

    /* ??可执行格式 / 目标文件 对象 */
    /* 修复 2026-08-10 门 9: �������������ڴ� (���ļ�ϵͳ) */
    整 段退 = 0;
    无 字 *素挂 = (无 字*)现陆一;
    整 出序 = 0;
    若 (计挂) {
        若 (容重一 > 0) {
            复制内存(素挂, 上子, 容重一); 出序 = 容重一;
        } 否 {
            整 码偏 = 0x1000;
            若 (出序 < 码偏) { 内存设置(素挂+出序, 0, 码偏-出序); 出序 = 码偏; }
            复制内存(素挂+出序, 码, 码位); 出序 += 码位;
            若 (出序 < 数据基址) { 内存设置(素挂+出序, 0, 数据基址-出序); 出序 = 数据基址; }
            /* 堆 计数器 / 导入表 半未 / ��̬�� */
            *(整*)(素挂+出序) = 0; 出序 += 4;
            *(整*)(素挂+出序) = 0; 出序 += 4;
            整 池戊 = 数据基址 + 0x300 + 4 + 4 * 静态数;
            整 净乙二 = 0x100000 + 池戊;
            遍 (整 计 = 8; 计 < 0x300; 计 += 8) { *(整*)(素挂+出序) = 净乙二; *(整*)(素挂+出序+4) = 0; 出序 += 8; }
            遍 (整 计 = 0; 计 < 静态数; 计++) { *(整*)(素挂+出序) = 0; 出序 += 4; }
            素挂[出序++] = 0xEB; 素挂[出序++] = 0xFE;
        }
        段退 = 出序;
        *(整*)后拆一 = 段退;
        格式化打印("OK: bin -> mem (code=%d out=%d)\n", 码位, 段退);
    } 否 {
        FILE *文件 = 打开文件(输出文件, "wb");
        若 (!文件) { 输出到文件(错误流, "qcc_x86: 无法写入 %s\n", 输出文件); 返 1; }
        若 (满双) {
            若 (容重一 > 0) {
                写入(上子, 1, 容重一, 文件);
            } 否 {
                整 码偏 = 0x1000;
                整 当 = 0;
                若 (当 < 码偏) { 遍 (整 计 = 当; 计 < 码偏; 计++) 写字符(0, 文件); 当 = 码偏; }
                写入(码, 1, 码位, 文件);
                当 += 码位;
                若 (当 < 数据基址) { 遍 (整 计 = 当; 计 < 数据基址; 计++) 写字符(0, 文件); }
                /* .数据: 堆 计数器 / 导入表 / ��̬�� */
                写四(文件, 0); 写四(文件, 0);
                整 满巳一 = 数据基址 + 0x300 + 4 + 4 * 静态数;
                整 新升二 = 0x100000 + 满巳一;
                遍 (整 计 = 8; 计 < 0x300; 计 += 8) { 写四(文件, 新升二); 写四(文件, 0); }
                遍 (整 计 = 0; 计 < 静态数; 计++) 写四(文件, 0);
                写字符(0xEB, 文件); 写字符(0xFE, 文件);
            }
        } 否 若 (链接模式) {
            空伴(文件);
        } 否 {
            实三(文件, 下集一);
        }
        若 (刷新缓冲(文件) != 0 || 判文件错误(文件)) { 输出到文件(错误流, "qcc_x86: 写入 %s 出错 (磁盘满? 句柄丢失?)\n", 输出文件); 关文件(文件); 返 1; } /* 修复 2026-08-11 长粗-1: 写入 不检查返回值 → 值二 截断静默成功 */
        关文件(文件);
    }

    若 (汇编输出) { 关文件(汇编输出); 汇编输出 = NULL; }
    若 (旧又二) 副寅一(); /* -图 旁路导出 (产物写完后, 2026-08-25) */

    若 (汇编模式) { 若 (!邻联) 格式化打印("OK: %s + %s.asm (%d bytes code)\n", 输出文件, 输出文件, 码位); } 否 { 若 (!邻联) 格式化打印("OK: %s (%d bytes code)\n", 输出文件, 码位); } /* 服务 模式抑制 左括 打印 (输出流 是响应通道, 诊断走 错误流) */
    若 (列附[0]) { /* Phase4 哈希审判: 编译产物 SHA256 对账不动点, fail-已闭 */
        字 移位[65]; 链伍(输出文件, 移位);
        若 (比较字符串(移位, 列附) != 0) {
            输出到文件(错误流, "[SELFCHECK] FAIL: %s != %s (不动点对账失败, 哈希审判 fail-已闭)\n", 移位, 列附);
            返 1;
        }
        若 (剩深) { 输出到文件(错误流, "{\"diagnostics\":[],\"selfcheck\":\"%s\"}\n", 移位); } /* 接入 2026-08-28 甲序原生 #1 净乙三.1: 哈希审判随 数据格式 诊断同出 (甲言独有卖点) */
        否 输出到文件(错误流, "[SELFCHECK] OK: %s\n", 移位);
    }
    若 (宽布[0]) { /* #expect 源码内期望原语: 产物哈希对账 (Phase4), 与 --自检 同级 */
        字 空贰[65]; 链伍(输出文件, 空贰);
        若 (比较字符串(空贰, 宽布) != 0) {
            输出到文件(错误流, "[EXPECT] FAIL: %s != %s (期望原语对账失败)\n", 空贰, 宽布);
            返 1;
        }
        输出到文件(错误流, "[EXPECT] OK: %s\n", 空贰);
    }
    若 (堆低一) { 字 计分[65]; 链伍(输出文件, 计分); 字 目次[128]; 格式化到串(目次, "{\"cp\":\"done\",\"artifact\":\"%.8s\"}", 计分); 长叁(目次); } /* 编译检查点 (2026-08-28 甲序原生 #6): 完成快照 (产物哈希前 8 位) */
    若 (总置) { 字 副辰[65]; 链伍(输出文件, 副辰); 格式化打印("{\"dag\":{\"version\":\"%s\",\"stages\":{\"source\":\"%s\",\"tokens\":\"%s\",\"ast\":\"%s\",\"artifact\":\"%s\"}}}\n", 单伴, 内吉, 素细, 直八, 副辰); } /* 编译 DAG 重放证明 (可吞清单 阶段零-9): 过程级哈希链 — 同输入+同编译器 → 同链; 修复 2026-08-28: 挪进 现退一 (服务 模式 主 不执行 → dag 载荷丢失 → 客户端死等) */
    返 0;
}

/* 接入 2026-08-28 甲序原生 #5: 文件级哈希增量编译 — sidecar 式缓存 (可吞清单 阶段零-5, MoonBit #3 + 生态 D5)
   键 = SHA256(版本 + 选项签名 + 宏表 + 源码); 命中=跳过编译 (输出文件即缓存); <输出文件>.qcckey 记录键
   --缓存-验证: 命中时新鲜编译到 <输出文件>.qccfresh + 对账复验 (增量结果纳入不动点链); 汇编模式/--重复 不缓存
   修复 2026-08-28: 抽成函数 — 服务/关中断 共用 (原缓存逻辑只在 主, 服务 设置 逆薄 但不走键/命中 → 缓存死代码) */
静 整 号进(常 字 *源, 常 字 *输出文件, 整 汇编模式) { /* 命中→1 (跳过编译), miss→0, 失败→2/3 */
    字 目辰[3600]; 整 圆周率 = 0;
    字 标二[65] = ""; 整 段玖一 = 0;
    若 (列附[0]) { 段玖一 = (整)取字长(列附); 复制内存(标二, 列附, 段玖一); }
    否 { 字 逆环[1024]; 双字 高己 = GetModuleFileNameA(NULL, 逆环, 1023); 若 (高己 > 0) { 字 计柒[65]; 链伍(逆环, 计柒); 若 (计柒[0]) { 复制内存(标二, 计柒, 64); 段玖一 = 64; } } }
    若 (段玖一 == 0) { 段玖一 = (整)取字长(单伴); 复制内存(标二, 单伴, 段玖一); }
    复制内存(目辰 + 圆周率, 标二, 段玖一); 圆周率 += 段玖一;
    目辰[圆周率++] = 链接模式 ? 'c' : (满双 ? 'b' : 'x');
    若 (计挂) 目辰[圆周率++] = 'B';
    若 (高劣) 目辰[圆周率++] = 'C';
    遍 (整 宏序 = 0; 宏序 < 宏数 && 圆周率 < 3500; 宏序++) { 整 段玖 = (整)取字长(终复[宏序].名); 若 (圆周率 + 段玖 + 12 < 3590) { 复制内存(目辰 + 圆周率, 终复[宏序].名, 段玖); 圆周率 += 段玖; 目辰[圆周率++] = '='; 整 堆深 = 终复[宏序].数值; 字 长简[16]; 整 变序 = 0; 若 (堆深 == 0) 长简[变序++] = '0'; 循环 (堆深 > 0) { 长简[变序++] = (字)('0' + 堆深 % 10); 堆深 /= 10; } 循环 (变序 > 0) 目辰[圆周率++] = 长简[--变序]; 目辰[圆周率++] = ';'; } }
    整 槽长 = (整)取字长(源);
    字 *素繁 = 内存分配(圆周率 + 槽长 + 1);
    复制内存(素繁, 目辰, 圆周率); 复制内存(素繁 + 圆周率, 源, 槽长); 素繁[圆周率 + 槽长] = 0;
    深伴(素繁, 圆周率 + 槽长, 双降);
    释放内存(素繁);
    若 (!旧三(输出文件)) 返 0;
    若 (列附[0]) { 字 末薄[65]; 链伍(输出文件, 末薄); 若 (比较字符串(末薄, 列附) != 0) { 输出到文件(错误流, "[CACHE] 自检-FAIL 缓存产物 %s != %s (不动点对账失败)\n", 末薄, 列附); 返 2; } 输出到文件(错误流, "[CACHE] 自检 左括 %s (缓存产物对账不动点)\n", 末薄); }
    若 (域组) { 字 目布[560]; 复制字符串(目布, 输出文件); 拼接(目布, ".qccfresh"); 若 (现退一(源, 目布, 汇编模式)) { 输出到文件(错误流, "[CACHE] 验证 新鲜编译失败\n"); 返 3; } 字 内繁[65], 左系一[65]; 链伍(输出文件, 内繁); 链伍(目布, 左系一); 若 (比较字符串(内繁, 左系一) == 0) { 输出到文件(错误流, "[CACHE] 验证 左括 %s (增量产物==新鲜编译)\n", 内繁); } 否 { 输出到文件(错误流, "[CACHE] 验证-MISMATCH %s != %s (缓存失效, 已用新鲜产物刷新)\n", 内繁, 左系一); 池薄一(目布, 输出文件); 满贰一(输出文件); } }
    若 (!邻联) 格式化打印("OK: %s (cached)\n", 输出文件);
    输出到文件(错误流, "[CACHE] hit %.8s\n", 双降);
    返 1;
}

/* 接入 2026-08-28 可吞清单 阶段一 (甲言化: 编译服务器 qccd — 甲序 专用中文编译器的长驻核心): --服务 输入流/输出流 数据格式-行 协议
   请求: {"全重":"编译","源":"...","出":"a.可执行","缓存":真} / {"全重":"编译","文件":"foo.c"} / {"全重":"ping"} / {"全重":"quit"}
   响应(输出流): {"成功":真,"全重":"编译","出":"a.可执行","artifact":"<sha16>"} — 诊断走 错误流 (与 关中断 一致), 客户端双流读取
   价值: 长驻进程免冷启动 (可重入核心重复调用) + 增量缓存命中免重编 — 甲序 迭代循环从秒级变毫秒级 (邻联 声明在顶部) */
静 整 净浅(常 字 *行一, 常 字 *键二, 字 *出, 整 长五) { /* 最小 数据格式: "键":"值" (值去转义) */
    字 目优[64]; 格式化到串(目优, "\"%s\":\"", 键二);
    常 字 *指 = 查找子串(行一, 目优);
    若 (!指) 返 0;
    指 += 取字长(目优);
    整 出序 = 0;
    循环 (*指 && *指 != '"' && 出序 < 长五 - 1) {
        若 (*指 == '\\' && 指[1]) { 指++;
            若 (*指 == 'n') 出[出序++] = '\n';
            否 若 (*指 == 'r') 出[出序++] = '\r';
            否 若 (*指 == 't') 出[出序++] = '\t';
            否 若 (*指 == '\\') 出[出序++] = '\\';
            否 若 (*指 == '"') 出[出序++] = '"';
            否 出[出序++] = *指;
            指++;
        } 否 出[出序++] = *指++;
    }
    出[出序] = 0;
    返 1;
}
静 整 上分(常 字 *行一, 常 字 *键二) { 字 目优[64]; 格式化到串(目优, "\"%s\":true", 键二); 返 查找子串(行一, 目优) != NULL; }
静 空 半利一(空) {
    字 行一[1048576]; /* 单请求一行; 内嵌 源 换行须 \n 转义 (大文件用 文件 模式) */
    输出到文件(错误流, "[SERVE] 甲言编译服务器就绪 (甲序 专用中文编译器 qccd, 可重入核心 + 增量缓存)\n");
    循环 (读行(行一, 大小(行一), 输入流)) {
        字 全重[32] = ""; 净浅(行一, "cmd", 全重, 大小(全重));
        若 (!比较字符串(全重, "quit") || 上分(行一, "quit")) { 输出到文件(错误流, "[SERVE] 退出\n"); 刷新缓冲(输出流); 返; } /* 修复 2026-08-28: quit 协议 — 支持 {"全重":"quit"} (原只查 "quit":真 → 客户端永远退不出) */
        若 (!比较字符串(全重, "compile")) {
            字 源[786432]; 字 函[512] = ""; 字 输出文件[512] = "a.exe";
            字 短薄[32] = ""; /* 空=产码; 接口/引用/dag=只解析导出 (输出流 即载荷) */
            整 序弊二 = 净浅(行一, "file", 函, 大小(函));
            净浅(行一, "out", 输出文件, 大小(输出文件));
            净浅(行一, "mode", 短薄, 大小(短薄));
            整 满轮 = 上分(行一, "cache");
            字 *链六 = NULL;
            若 (序弊二) { 链六 = 逆平一(函); 若 (!链六) { 格式化打印("{\"ok\":false,\"cmd\":\"compile\",\"err\":\"cannot open %s\"}\n", 函); 刷新缓冲(输出流); 续; } }
            否 { 若 (!净浅(行一, "src", 源, 大小(源))) { 格式化打印("{\"ok\":false,\"cmd\":\"compile\",\"err\":\"no src/file\"}\n"); 刷新缓冲(输出流); 续; } 链六 = 源; }
            整 缺五一 = 逆薄; 逆薄 = 满轮 ? 1 : 0;
            整 长叁一 = 暂厚, 左伍 = 新六, 上高 = 总置, 号又 = 域组;
            暂厚 = !比较字符串(短薄, "interface") ? 1 : 0;
            新六 = !比较字符串(短薄, "refs") ? 1 : 0;
            总置 = !比较字符串(短薄, "dag") ? 1 : 0;
            整 顺拆 = 0;
            若 (逆薄 && !暂厚 && !新六 && !总置) {
                宏数 = 0; /* 修复 2026-08-28: 服务 键计算前清宏表 — 缓存键含宏表, 而上次编译的 运行时 宏 (QCC_RT_PREPENDED 等) 残留 → 同源两次键不同 → 缓存永不命中 (主 路径键在编译前算、宏表干净) */
                整 行弊 = 号进(链六, 输出文件, 0); /* 真缓存 (修复 2026-08-28: 原 服务 缓存死代码 — 键/命中逻辑只在 主) */
                若 (行弊 == 1) { 格式化打印("{\"ok\":true,\"cmd\":\"compile\",\"out\":\"%s\",\"cached\":true}\n", 输出文件); 刷新缓冲(输出流); 跳 暂贰一; }
                若 (行弊 == 2 || 行弊 == 3) { 格式化打印("{\"ok\":false,\"cmd\":\"compile\",\"err\":\"cache-fail\"}\n"); 刷新缓冲(输出流); 跳 暂贰一; }
            }
            顺拆 = 现退一(链六, 输出文件, 0);
            若 (顺拆 == 0 && 逆薄 && !暂厚 && !新六 && !总置) { 满贰一(输出文件); 输出到文件(错误流, "[CACHE] miss %.8s\n", 双降); } /* 编译成功 → 落缓存键 (服务 同 主) */
            若 (暂厚 || 新六 || 总置) {
                /* 载荷模式: 现退一 的 输出流 已输出接口/引用/DAG 数据格式 (服务 抑制 左括 打印) — 它即响应 */
                若 (顺拆 != 0) 格式化打印("{\"ok\":false,\"cmd\":\"compile\",\"mode\":\"%s\"}\n", 短薄);
            } 否 若 (顺拆 == 0) { 字 正又[65]; 链伍(输出文件, 正又); 格式化打印("{\"ok\":true,\"cmd\":\"compile\",\"out\":\"%s\",\"artifact\":\"%.16s\"}\n", 输出文件, 正又); }
            否 格式化打印("{\"ok\":false,\"cmd\":\"compile\",\"out\":\"%s\"}\n", 输出文件);
            刷新缓冲(输出流);
暂贰一:
            逆薄 = 缺五一; 暂厚 = 长叁一; 新六 = 左伍; 总置 = 上高; 域组 = 号又;
            若 (序弊二) 释放内存(链六);
        } 否 若 (!比较字符串(全重, "ping")) {
            格式化打印("{\"成功\":真,\"全重\":\"ping\",\"lang\":\"甲言 编译器\",\"服务\":真}\n"); 刷新缓冲(输出流);
        } 否 {
            格式化打印("{\"ok\":false,\"cmd\":\"%s\",\"err\":\"unknown command\"}\n", 全重); 刷新缓冲(输出流);
        }
    }
}

/* 接入 2026-08-28 甲序原生 #可嵌入: 直排 模式跳过 主 — 编译器以库形式被调用 (现退一 暴露为嵌入式 API) */
#ifndef 直排
整 main(整 首合, 字 **整劣) {
    常 字 *源 = "int main() { return 42; }";
    常 字 *输出文件 = NULL;
    整 参序 = 1;
    整 汇编模式 = 0;
    字 *暂贰 = NULL; 整 当次 = 0, 链败 = 0;
    字 *串回 = NULL; 整 串重 = 0;

    /* 修复 2026-08-10 门 9: ������ "__bare__" ��Ǳ������������ */
    遍 (整 乙序 = 1; 乙序 < 首合; 乙序++) { 若 (整劣[乙序] && !比较字符串(整劣[乙序], "__bare__")) { 计挂 = 1; 断; } }
    循环 (首合 > 参序) {
        若 (比较字符串(整劣[参序], "--help") == 0) {
            格式化打印("甲言 qcc_x86 v5.0 · 铸基 郑宇和 · 自举 郑启元 · 审计 郑启灵 · 种子 828\nUsage: qcc_x86 [-S] [-I header.h] [-o out.exe] 文件.c [file2.c ...]\n  -S  输出 汇编 文本\n  --缓存 / --缓存-验证  文件级哈希增量编译 (甲序原生 #5, 可吞清单 阶段零-5)\n  --budget  编译期资源水位报告 (甲序原生 #9b, 可吞清单 阶段零-9b)\n  --diagnostics=json | --深乙  数据格式 诊断输出\n  --自检 <sha256>  产物哈希对账不动点\n  --重复 <N>  同进程连续编译验证可重入\n");
            返 0;
        }
        若 (比较字符串(整劣[参序], "--test") == 0) { 格式化打印("qcc_x86 selftest 通过 · 铸基 郑宇和 · 自举 郑启元 · 审计 郑启灵 · 种子 828\n"); 返 0; }
        若 (比较字符串(整劣[参序], "-S") == 0) { 汇编模式 = 1; 参序++; 续; }
    若 (比较字符串(整劣[参序], "-g") == 0) { 调试开关 = 1; 参序++; 续; } /* #289 DWARF (2026-09-01): 生成调试信息 */
        若 (比较字符串(整劣[参序], "-c") == 0) { 链接模式 = 1; 参序++; 续; }
        若 (比较字符串(整劣[参序], "-bin") == 0) { 满双 = 1; 参序++; 续; } /* 修复 2026-08-08: 裸二进制 (内核) */
        若 (比较字符串(整劣[参序], "-o") == 0 && 首合 > 参序 + 1) { 输出文件 = 整劣[参序 + 1]; 参序 += 2; 续; }
        { 常 字 *劣一 = 整劣[参序]; /* P0-3 (2026-09-14): 上收 当前 实参 到 中间变量 —— 规避 既存缺陷 A71
              (指针变量 的 两跳 下标 / 把 `整劣[参序]` 直接 当 基址 时 少 一次 加载: 实测 argv[1][0] 取到
               指针 自身 低字节, 而 `p = argv[1]; p[0]` 正确); 详见 挂账 A71 */
          若 ((比较字符串(劣一, "-D") == 0 && 首合 > 参序 + 1) || (*(劣一) == '-' && *(劣一 + 1) == 'D' && *(劣一 + 2) != 0)) { /* -D 名=值 (修复 2026-08-13: 版本库 编译需要 C99 环境宏 __STDC_VERSION__ 等); P0-3 (2026-09-14): ① 补 紧凑形 -D名=值 (GCC 惯例 — 原 只认 分离形, 版本库 Makefile 的 -DFOO=bar 被当 输入文件 报 无法打开) ② 改走 命令行宏 通道 (原 直写 数值宏表 → 被 终子 清空 + 不参与 文本替换) ③ 值 以 文本 传递 (原 转整数 → 字符串值/表达式值 一律 变 0) */
            整 跨一 = (比较字符串(劣一, "-D") == 0) ? 2 : 1;
            常 字 *深 = (跨一 == 2) ? 整劣[参序 + 1] : 劣一 + 2;
            常 字 *相等 = 深;
            循环 (*相等 && *相等 != '=') 相等++;
            若 (相等 > 深 && 相等 - 深 < 64) {
                字 名存[64]; 整 链弊 = (整)(相等 - 深);
                复制内存(名存, 深, 链弊); 名存[链弊] = 0;
                若 (*相等 == '=') 命宏加(名存, 相等 + 1); 否 命宏加(名存, "1");
            }
            参序 += 跨一; 续;
        } }
        若 (比较字符串(整劣[参序], "--selfcheck") == 0 && 首合 > 参序 + 1) { 拷贝前n(列附, 整劣[参序 + 1], 64); 列附[64] = 0; 参序 += 2; 续; }
        若 (比较字符串(整劣[参序], "--diagnostics=json") == 0 || 比较字符串(整劣[参序], "--dj") == 0) { 剩深 = 1; 参序++; 续; } /* 接入 2026-08-28 甲序原生 #1: 数据格式 诊断模式 — 报错输出 {代码,severity,消息}, 甲序 程序化消费 */
        若 (比较字符串(整劣[参序], "--repeat") == 0 && 首合 > 参序 + 1) { 前劣 = 转整数(整劣[参序 + 1]); 若 (前劣 < 1) 前劣 = 1; 参序 += 2; 续; } /* 接入 2026-08-28 甲序原生 #6: 同进程连续编译 N 次验证可重入 */
        若 (比较字符串(整劣[参序], "--cache") == 0) { 逆薄 = 1; 参序++; 续; } /* 接入 2026-08-28 甲序原生 #5: 文件级哈希增量编译 (可吞清单 阶段零-5) — sidecar 式, 命中跳过编译 */
        若 (比较字符串(整劣[参序], "--cache-verify") == 0) { 域组 = 1; 逆薄 = 1; 参序++; 续; } /* 命中时新鲜编译+对账复验 (增量结果纳入不动点链) */
        若 (比较字符串(整劣[参序], "--lenient") == 0) { 宽松转换 = 1; 参序++; 续; } /* C12: 兼容档 (放宽 A9002 等 显式转换 要求) */
    若 (比较字符串(整劣[参序], "--budget") == 0) { 初汇 = 1; 参序++; 续; } /* 资源护栏 9b (可吞清单 阶段零-9b): 编译期水位报告 (甲序 可读 数据格式) */
        若 (比较字符串(整劣[参序], "--checkpoint") == 0 && 首合 > 参序 + 1) { 堆低一 = 1; 拷贝前n(暂寅, 整劣[参序 + 1], 511); 暂寅[511] = 0; 参序 += 2; 续; } /* 编译检查点 (可吞清单 阶段零-6): 崩溃尸检 — 进度快照落盘 (词法/每函数解析/每函数码生成器/已做), 崩溃现场可查 */
        若 (比较字符串(整劣[参序], "--dag") == 0) { 总置 = 1; 参序++; 续; } /* 编译 DAG 重放证明 (可吞清单 阶段零-9): 过程级哈希链 (源码→词元→抽象语法树→产物), 编译过程可重放可验证 */
        若 (比较字符串(整劣[参序], "--interface") == 0) { 暂厚 = 1; 参序++; 续; } /* 接口文件/语义导航 (可吞清单 阶段一, MoonBit #4 参考, 甲言化: 接口文件/导航 — 解析后导出 API 表面 数据格式 + 函数定义行号, 甲序 读接口不读实现) */
        若 (比较字符串(整劣[参序], "--recorder") == 0 && 首合 > 参序 + 1) { 整再 = 1; 拷贝前n(元零, 整劣[参序 + 1], 511); 元零[511] = 0; 参序 += 2; 续; } /* 编译黑匣子 (可吞清单 阶段一, Agint flight-recorder 参考, 甲言化: 黑匣子) — 每函数代码增量哈希帧, 分歧逐帧定位 */
        若 (比较字符串(整劣[参序], "--serve") == 0) { 邻联 = 1; 参序++; 续; } /* 编译服务器 qccd (甲言化, 可吞清单 阶段一): 长驻 输入流/输出流 数据格式-行 — 甲序 迭代循环毫秒级 */
        若 (比较字符串(整劣[参序], "--refs") == 0) { 新六 = 1; 参序++; 续; }
         若 (比较字符串(整劣[参序], "--annotations") == 0) { 出注 = 1; 参序++; 续; } /* #173 注解导出 (元数据标注可观测) */ /* 引用收集 (可吞清单 阶段一): 谁引用了 X — 解析期记录 (名, 行) 表, 数据格式 导出 */
若 (比较字符串(整劣[参序], "-graph") == 0 && 首合 > 参序 + 1) { 旧又二 = 1; 拷贝前n(末高, 整劣[参序 + 1], 511); 末高[511] = 0; 参序 += 2; 续; } /* -图 旁路导出 (阶段零 工具侧) */
        若 (比较字符串(整劣[参序], "-I") == 0 && 首合 > 参序 + 1) {
            字 *右七 = 逆平一(整劣[参序 + 1]);
            若 (右七) {
                /* 能读到 ⟹ 是文件 ⟹ 原语义: 预包含 (前插) —— 保持完全兼容 (GCC -include 等价) */
                整 双又 = (整)取字长(右七);
                若 (当次 + 双又 + 2 >= 链败) { 链败 = 当次 + 双又 + 4096; 暂贰 = 重分配(暂贰, 链败); }
                复制内存(暂贰 + 当次, 右七, 双又); 当次 += 双又;
                暂贰[当次++] = '\n'; 暂贰[当次] = 0;
                释放内存(右七);
            } 否 {
                /* P0-4 (2026-09-14): 读不到 ⟹ 当 目录 处理 ⟹ 加入 头文件 搜索表 (GCC `-I<dir>` 语义)。
                   判据 = "能否读到" 天然区分 文件/目录, 两种语义 **零冲突 共存**。 */
                若 (命头目数 < 64) { 复制字符串(命头目[命头目数], 整劣[参序 + 1]); 命头目数++; }
                否 原得("命令行头目录 命头目", 64);
            }
            参序 += 2; 续;
        }
        /* 输入 文件 */
        拷贝前n(全局源名, 整劣[参序], 511); 全局源名[511] = 0; /* 数据格式 诊断 位置.文件 */
        字 *宽叁 = 逆平一(整劣[参序]);
        若 (!宽叁) { 输出到文件(错误流, "qcc_x86: 无法打开 %s\n", 整劣[参序]); 返 1; }
        邻繁(整劣[参序], 标寅一, 大小(标寅一)); /* 修复 2026-08-13 第三阶段: 记录源文件目录, 供子目录 #包含 相对搜索 */
        { 常 字 *空简一 = 整劣[参序];
          若 (查找子串(空简一, "compat/stat.c") || 查找子串(空简一, "compat\\stat.c")) 高劣 = 1; }
        整 净巳 = (整)取字长(宽叁);
        串回 = 重分配(串回, (串重 + 净巳 + 5) & ~3); /* 修复 2026-08-12 UB-清理: 重分配 是 a 真 提升 分配 (非 无-算子)! 串重+净巳+2 非-4-multiple -> 词型表..词长表 未对齐 -> 词长表[词位] 垃圾 -> spurious 节长标=1; +5=(所需+3)&~3: +4 under-分配 1 字节 当 (串重+净巳)%4==3 -> 串回[串重]=0 OOB */
        复制内存(串回 + 串重, 宽叁, 净巳); 串重 += 净巳;
        串回[串重++] = '\n'; 串回[串重] = 0;
        释放内存(宽叁);
        参序++;
    }
    若 (邻联) { 半利一(); 返 0; } /* 编译服务器 qccd: 长驻循环 (输入流 请求 → 输出流 响应, 诊断走 错误流) — 可重入核心 + 增量缓存, 甲序 迭代毫秒级 */
    若 (高劣) 命宏加("QCC_COMPAT_STAT_C", "1"); /* 兼容/stat.c 禁用 prelude 的 stat/lstat/fstat 自映射; P0-3 (2026-09-14): 原 宏加 → 同样 被 终子 清空 (与 -D 同族受害点), 改 命令行宏 通道 */
    若 (串重 > 0) {
        整 链玖 = 当次 + 串重 + 2;
        字 *名回 = 内存分配((链玖 + 3) & ~3); /* 修复 2026-08-11 阻塞-3: 轮 到 4 */
        整 位 = 0;
        若 (当次 > 0) { 复制内存(名回, 暂贰, 当次); 位 = 当次; }
        复制内存(名回 + 位, 串回, 串重); 位 += 串重;
        名回[位] = 0;
        源 = 名回;
        释放内存(串回);
    }
    释放内存(暂贰);
    若 (!输出文件) {
        静 字 源简[512]; 复制字符串(源简, "a.exe"); 输出文件 = 源简;
    }

    若 (汇编模式) {
        字 左辛[512]; 复制字符串(左辛, 输出文件);
        拼接(左辛, ".asm"); /* 修复 2026-08-05: 曾 stripping ".可执行" 则 appending → `编译器 -S f.c` wrote a.汇编 but printed a.可执行.汇编 (misleading); 现在 总是 输出文件+".汇编" */
        复制字符串(汇编名, 左辛); /* 修复 2026-08-06: 最终代越界重稳定时需截断重开 汇编 文件 */
        汇编输出 = 打开文件(左辛, "wb");
    }

    /* 前插 该 自身-宿主 运行时 (运行时库.c): 堆 重分配, 定位文件/取文件位置/倒带,
       出口/中止, 复制字符串/比前n/判数字/判字母 影子 该 broken 内联 stubs.
       每 已编译 program 获取 它, 故 stage2 是 自身-contained. */
    /* 修复 2026-08-28: 运行时 拼接已移入 现退一 内部 (复位 之后, 避免 宏数=0 清 QCC_RT_PREPENDED → 运行时 剃光 → 嵌入产物崩); 主 传纯用户源码 */

    /* 接入 2026-08-28 可吞清单 阶段零-9: 编译 DAG 重放证明 — 源码阶段哈希 (独立于缓存, 每次 --dag 都算) */
    若 (总置) { 整 双细 = (整)取字长(源); 深伴(源, 双细, 内吉); }
    /* 接入 2026-08-28 甲序原生 #5: 文件级哈希增量编译 — sidecar 式缓存 (可吞清单 阶段零-5, MoonBit #3 + 生态 D5)
       键 = SHA256(版本 + 选项签名 + 宏表 + 源码); 命中=跳过编译 (输出文件即缓存); <输出文件>.qcckey 记录键
       --缓存-验证: 命中时新鲜编译到 <输出文件>.qccfresh + 对账复验 (增量结果纳入不动点链); 汇编模式/--重复 不缓存 */
    若 (逆薄 && !汇编模式 && 前劣 <= 1 && 串重 > 0) {
        整 列捌 = 号进(源, 输出文件, 汇编模式); /* 抽成共享函数 (服务 复用, 修复 2026-08-28) */
        若 (列捌 == 1) 返 0;
        若 (列捌 == 2 || 列捌 == 3) 返 1;
    }
    /* 接入 2026-08-28 甲序原生 #6: 编译核心函数化 — 同进程可重复调用 (可重入无状态核心) */
    整 深系 = 现退一(源, 输出文件, 汇编模式);
    若 (深系) 返 深系;
    若 (逆薄 && !汇编模式 && 前劣 <= 1 && 输出文件 && 双降[0]) { 满贰一(输出文件); 输出到文件(错误流, "[CACHE] miss %.8s\n", 双降); } /* 编译成功 → 落缓存键 (miss 记键, 下次命中) */
    字 栈酉[65] = ""; 若 (前劣 > 1) 链伍(输出文件, 栈酉); /* 修复 2026-08-28 可重入盲点: 记录第 1 次产物哈希 — 原只验 2..N 自洽, 漏"首 长简 次" (节长标 残留 缺陷 因此存活) */
    遍 (整 实属一 = 1; 实属一 < 前劣; 实属一++) { /* --重复: 同进程连续编译验证可重入 (每次独立分配数组, 产物应一致) */
        若 (现退一(源, 输出文件, 汇编模式)) { 输出到文件(错误流, "[REPEAT] 第 %d 次编译失败 (可重入验证失败)\n", 实属一 + 1); 返 1; }
        若 (栈酉[0]) { 字 首申一[65]; 链伍(输出文件, 首申一); 若 (比较字符串(栈酉, 首申一) != 0) { 输出到文件(错误流, "[REPEAT-FAIL] 第 %d 次编译产物 != 第 1 次 (可重入失败: %s != %s)\n", 实属一 + 1, 首申一, 栈酉); 返 1; } } /* 产物哈希对账: 首次 长简 每次 — 任何跨编译状态泄漏立即暴露 */
    }
    若 (前劣 > 1) 输出到文件(错误流, "[REPEAT] 连续编译 %d 次一致 (含首次对账, 可重入无状态核心验证通过)\n", 前劣);
    若 (初汇) 存八();
    静默报告(); /* 第0刀 报警器: 静默兜底 汇总 (仅 QCC_DBG_SILENT=1 时 输出) */ /* 资源护栏 9b: 编译期水位报告 (甲序 可读 数据格式, 编译成功后) */
    返 0;

}
#endif /* 直排 */
