                    { 整 旧乙 = 节点指元素(子0[数]); 若 (旧乙 <= 0 && 子0[数] >= 0 && 节型别[子0[数]] == 节点_下标 && 表达式指深(子0[数]) > 0) { /* R274 (2026-09-26 启元 · 第 364 站 round 13): **乘法侧 同源缺口补齐** —— `节点指元素` 无 `节点_下标` 分支 ⟹ `pa[0] + 1` 的 左操作数 落兜底返 0 ⟹ 不缩放 (实测 `*q1` 读 335544320 应 20 · `*q2` 读 1310720 应 30). ⚠️ 判据必须含 `表达式指深 > 0` —— 否则**值数组** `buf[1] + 2` 也会被缩放 (它本来就不该缩放). 复用 R273 的两态来源, 只改本消费点. */ 整 序乙甲 = 序七(子0[数]); 若 (序乙甲 >= 0) 旧乙 = 类型表[序乙甲].尺寸; 若 (旧乙 <= 0 && 子0[子0[数]] >= 0 && 节型别[子0[子0[数]]] == 节点_变量) 旧乙 = 堆次((字*)(节名表 + 子0[子0[数]])); 若 (旧乙 <= 0) 旧乙 = 表达式内重(子0[数]); }
                      若 (取环境("QCC_DBG_C141")) 输出到文件(错误流, "[C141-64] 子0型=%d 子1型=%d 旧乙=%d 丙=%d\n", (子0[数] >= 0 ? 节型表[子0[数]] : -9), (子1[数] >= 0 ? 节型表[子1[数]] : -9), 旧乙, 丙); /* 暂存 diag */
