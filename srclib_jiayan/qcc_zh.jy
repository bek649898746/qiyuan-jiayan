                    整 初得 = 子0[子1[数]];
                    若 (初得 >= 0 && (节型表[初得] == 23 || 节型表[初得] == 26)) 初得 = 子0[初得]; /* *p++ / *++p 透传到指针操作数 */
                    整 旁伴 = (初得 >= 0 && 节型表[初得] == 1) ? 变量型序((字*)(节名表 + 初得)) : -1;
                    若 (旁伴 == 直九 && 初得 >= 0 && 节型表[初得] == 1 && 变量指元素((字*)(节名表 + 初得)) > 0) {
