    若 (词型表[词位] == 减) { 词位++; 若 (!末列(数值)) 返 0; *数值 = -*数值; 返 1; }
    若 (词型表[词位] == 加) { 词位++; 返 末列(数值); }
    若 (词型表[词位] == 按位非) { 词位++; 若 (!末列(数值)) 返 0; *数值 = ~*数值; 返 1; }
    若 (词型表[词位] == 总零) { 词位++; 若 (!末列(数值)) 返 0; *数值 = !*数值; 返 1; } /* parenbang 根治 (2026-09-15): 常量求值 缺 一元 逻辑非 `!` —— `sizeof(char [!(1)])` 的 维度 `!(1)` 求值失败 且 词位 停在 `!` ⇒ sizeof 的 `]` 未消费 ⇒ 后续 AST 错乱 ⇒ printf 调用 被调者/实参 变 1 ⇒ 运行 0xC0000005 (gcc 正常 -1). 修: 与 正常表达式解析 L8300 (原级 总零 → 建节17 逻辑非) 对齐, 补 常量求值 的 一元 `!` 分支. */
    返 0;
