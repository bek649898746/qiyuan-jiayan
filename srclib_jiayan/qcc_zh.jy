静 空 发错误(常 字 *码, 常 字 *消息) { /* 定义在 tk/tline 可见处 (var_offset 前) — 2026-08-28 大哥评估: loc.line 真值 = tline[tk]-rt_line_skip (用户源码行号) */
    若 (剩深) {
        /* fix 2026-08-28 真接入③: 修复建议按具体错误码精确给出 (原只按 A3/A4 族粗分, "查看错误码文档" 占位) */
        常 字 *半再 = "查看错误码文档 (error_codes/README.md)";
        若 (!比较字符串(码, "A3001")) 半再 = "解除借用后再写/读: 可变借用先 放还; 只读借用写=自动放还 (借用自动化)";
        否 若 (!比较字符串(码, "A3002")) 半再 = "已有借用时不能再 可变借用: 先 放还 全部借用 (独占互斥)";
        否 若 (!比较字符串(码, "A3003")) 半再 = "借用中不能再 可变借用: 先 放还 (只读借用挡独占)";
        否 若 (!比较字符串(码, "A3004")) 半再 = "借用期间不能移动: 先 放还 再 移入 (所有权不可转)";
        否 若 (!比较字符串(码, "A3101")) 半再 = "move 后源失效: 读取前重新赋值恢复, 或改用其他变量 (#5)";
        否 若 (!比较字符串(码, "A3102")) 半再 = "已移动不能再移动: 先重新赋值恢复所有权 (#5)";
        否 若 (!比较字符串(码, "A3103")) 半再 = "已移动变量不能借用: 先重新赋值 (#10)";
        否 若 (!比较字符串(码, "A4001")) 半再 = "声明时初始化, 或先赋值再读取 (明确初始化 #78)";
        否 若 (!比较字符串(码, "A5001")) 半再 = "扩容对应容量宏或减小输入规模 (资源护栏 9b)";
        否 若 (!比较字符串(码, "A6002")) 半再 = "调用前保证前置条件成立: 修正常量参数, 或加调用点守卫 (#7 编译期审判)";
        否 若 (!比较字符串(码, "A7001")) 半再 = "先 契约 P; 登记契约类型, 或改用已定义结构体 (#8)";
        否 若 (!比较字符串(码, "A8001")) 半再 = "可空类型δ解包就解引用: 先 解包 变量; (或判空后ʹ用, 类型根治①)";
        否 若 (!比较字符串(码, "A9001")) 半再 = "错误函数结果必须检查: 用 尝试 f(); 传播, 或显式判断后使用 (类型根治②)";
        否 若 (!比较字符串(码, "A9002")) 半再 = "无隐式转换: double 赋整型用 转 int(...) 显式转换 (类型根治④)";
        否 若 (!比较字符串(码, "A9004")) 半再 = "接口未声明: 先 接口 名 { 方法列表 }; (v3.0 #114)";
        否 若 (!比较字符串(码, "A9006")) 半再 = "常量不可赋值: 常量 名 = 值 声明后只读 (v3.0 #278)";
        否 若 (!比较字符串(码, "A9005")) 半再 = "类型未实现接口方法: 用 实现 名 于 类型 { 方法 = 函数 } 绑定 (v3.0 #114)";
        否 若 (!比较字符串(码, "A9004")) 半再 = "接口未声明: 先 接口 名 { 方法列表 }; (v3.0 #114)";
        否 若 (!比较字符串(码, "A9005")) 半再 = "类型未实现接口方法: 用 实现 名 于 类型 { 方法 = 函数 } 绑定 (v3.0 #114)";
        否 若 (!比较字符串(码, "A9003")) 半再 = "区间类型变量只能赋界内值: 赋值前检查或夹取修正 (类型根治⑦ #101)";
        否 若 (码[0] == 'A' && 码[1] == '3') 半再 = "检查借用/所有权规则: 先放还/重新赋值恢复, 再读/写/移动";
        否 若 (码[0] == 'A' && 码[1] == '4') 半再 = "声明时初始化, 或先赋值再读取";
        否 若 (码[0] == 'A' && 码[1] == '1') 半再 = "检查语法/解析结构";
        否 若 (码[0] == 'A' && 码[1] == '2') 半再 = "检查类型/声明/语义";
        字 名厚[600]; 整 目十 = 0; 遍 (整 丙序 = 0; 全局源名[丙序] && 目十 < 590; 丙序++) { 若 (全局源名[丙序] == '\\') { 名厚[目十++] = '\\'; 名厚[目十++] = '\\'; } 否 名厚[目十++] = 全局源名[丙序]; } 名厚[目十] = 0;
        字 缺重[1100]; 整 原戊 = 0; 遍 (整 丙序 = 0; 消息[丙序] && 原戊 < 1090; 丙序++) { 若 (消息[丙序] == '\\') { 缺重[原戊++] = '\\'; 缺重[原戊++] = '\\'; } 否 若 (消息[丙序] == '"') { 缺重[原戊++] = '\\'; 缺重[原戊++] = '"'; } 否 缺重[原戊++] = 消息[丙序]; } 缺重[原戊] = 0;
        整 段未 = (词行表 && 词位 >= 0 && 词位 < 1000000) ? 词行表[词位] - (剩伴 ? 剩伴 : 反进) : 0; 若 (段未 < 1) 段未 = 1; /* 用户源码行号 (tline[tk]-rt_exp_lines) */
        字 计得一[220] = ""; 若 (全局源名[0] && 段未 >= 1) { FILE *间伍 = 打开文件(全局源名, "rb"); 若 (间伍) { 整 首拾 = 1; 整 旧伍 = 0; 循环 (首拾 < 段未 && 旧伍 != -1) { 旧伍 = 读字符(间伍); 若 (旧伍 == '\n') 首拾++; } 整 源伴 = 0; 若 (首拾 == 段未) { 循环 ((旧伍 = 读字符(间伍)) != -1 && 旧伍 != '\n' && 源伴 < 190) { 字 条件码 = (字)旧伍; 若 (条件码 == '\\') { 计得一[源伴++] = '\\'; 计得一[源伴++] = '\\'; } 否 若 (条件码 == '"') { 计得一[源伴++] = '\\'; 计得一[源伴++] = '"'; } 否 计得一[源伴++] = 条件码; } } 计得一[源伴] = 0; 关文件(间伍); } } /* codeLine: 从用户源文件读 loc.line 行 (AI 直接看到出错代码; 用 -1 替代 EOF — qcc 不识别 stdio.h 的 EOF 宏) */
