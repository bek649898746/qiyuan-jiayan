    变量表[变量数].型序标 = -1; 变量表[变量数].构尺寸 = 0; 变量表[变量数].数组尺寸 = 0; 变量表[变量数].数组元素尺寸 = 0;
    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0; 变量表[变量数].指元素尺寸 = 0; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = 0; 变量表[变量数].是否浮标 = 0; 变量表[变量数].指浮 = 0; 变量表[变量数].是否字符标 = 0; 变量表[变量数].无符号标 = 0; 变量表[变量数].是否静态标 = 0;
