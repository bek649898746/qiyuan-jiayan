                汇发("    自增 r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0xFF);模字节(3,0,0); /* inc r8 */
                汇发("    自减 r10\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1);发字节(0xFF);模字节(3,1,2); /* dec r10 */
