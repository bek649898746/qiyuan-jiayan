                若 (节型别[被调者] == 节点_变量 && (查函数浮返((字*)(节名表 + 被调者)) || 终陆((字*)(节名表 + 被调者)) >= 0 || 序贰((字*)(节名表 + 被调者)) == 2)) 节浮标[字符] = 1; /* 修复 2026-08-06: 解析 时标记 双精度 返回调用 (被调者 节点, 非 n=c 后) — 参数 压栈 判断在 码生成 前 → 跨 .o 声明时参数按 整数 压栈 (avg 返回 0.0); 2026-08-25 math21: 外部 math 函数 双精度 返回; 步五 时间: difftime 双精度 返回 */
                若 (节型别[被调者] == 节点_变量 && (查函数长返((字*)(节名表 + 被调者)) || 查返回名指((字*)(节名表 + 被调者)) || 序贰((字*)(节名表 + 被调者)) == 1 || !比较字符串((字*)(节名表 + 被调者), "复数") || !比较字符串((字*)(节名表 + 被调者), "复加"))) 节长标[字符] = 1; /* 修复 2026-08-21 #27: 64-位-返回 调用 → 节点 是 邻辰, 故 扩32 won't 截断; 步五 时间: 时间/mktime 64 位返回; 2026-08-28: 复数/复加 内置 64 位打包返回 */
            } 否 断;
        }
        返 底;
}
静 整 原级(空) {
        若 (词型表[词位] == 型词 && !比较字符串(词名表[词位], "空") && 右陆) { /* 第 215 站 (2026-09-21) **C2 定案落地·第一刀**: `错误 可空 T` 的**「空」态**.
           三态单标记 (C2 定案): `tag = 0` 有值 · `tag = 2` **空** · `tag = 1` 出错 (码 在 低 32).
           事实面: `错 N;` 打包 {码(低32), tag=1(高32)} (L12566); `解构(v,t)` 拆 64 位取 tag (L14578); **`tag == 0` = 成功 ⟹ 0 被占用** ⟹ 故 空 = **2**.
           本支 与 下方「雷2」判据相对: `右陆` (当前函数是错误函数) 时 优先 构造 打包, 否 则 照旧 响亮报错. */
            词位++; /* 空 */
            整 结空二 = 建节(6); /* 打包 {码, tag} —— 镜像 `错 N;` (L12567) */
            { 整 零码节 = 建节(0); 节值表[零码节] = 0; 接子(结空二, 零码节); } /* child0 = 码 0 (低 32) */
            节值表[结空二] = 9001; { 整 贰节 = 建节(0); 节值表[贰节] = 2; 接子(结空二, 贰节); } /* child1 = tag=2 (高 32) — 运行时判别 (rax>>32)==2 即「空」;
               ⚠️ 必须复用 **9001** —— 这是码生成识别的「打包 {child0=码/值, child1=tag}」语义标记 (见 L12578 `错 N;`, L23580/L23637 的处理点);
