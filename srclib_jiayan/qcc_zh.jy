型, 盒接口, 接口表[盒接序].槽名[槽], 槽); 发错误("A9005", 错缓冲); } { 整 函节 = 建节(1); 复制内存((字*)(节名表 + 函节), 函数名, 64); 参数个数[匿数] = 函节; 副双[匿数] = -1; 匿数++; } } } 否 { 参数个数[匿数] = 评值; 副双[匿数] = 位; 匿数++; } } } /* #195 接口引用实参展开 (2026-09-05) */
                若 (词型表[词位] == 右括) 词位++;
                若 (序集 && !宽松转换 && 节型别[被调者] == 节点_变量 && 净挂((字*)(节名表 + 被调者)) < 0 && 变参取((字*)(节名表 + 被调者)) < 0) { 整 己序M = 存陆((字*)(节名表 + 被调者)); 若 (己序M >= 0) { 整 命名实参M = 0; 遍 (整 计M = 0; 计M < 匿数; 计M++) 若 (副双[计M] >= 0) { 命名实参M = 1; 断; } 若 (!命名实参M) { 整 参数数M = 度伍[己序M].参数数; 若 (参数数M > 0 && 匿数 < 参数数M) { 格式化到串(错缓冲, "实参个数不足: 函数 %s 需要 %d 个实参, 调用处只给了 %d 个 (C99 6.5.2.2; 号合.0)", (字*)(节名表 + 被调者), 参数数M, 匿数); 发错误("A9007", 错缓冲); } /* C11 收窄 (2026-09-24 启元 · 第 300 站): **只保留 too few, 去掉 too many** —— 实测 too many 分支在 ① K&R 空参声明 `int get() { }` (甲言 参数数=0/1, C 语义「未指定参数」= 接受任意实参; tests/qcc/call_noparam.c 与 call_1param.c **故意** 调 get(1,2,3,4) 期望 exit=0) 与 ② **内建函数** (`pow` 登记 参数数=0; tests/qcc/math_call_test.c) 上 双双 **误报** ⟹ full 套件 3 新失败. too few 在 参数数 > 0 时 语义确定 (原型已声明 N 参, 少给必错) ⟹ 零误报; C11 的核心症状正是 too few (`f(1,2)` 对 三参原型 静默取栈垃圾). */ } } } { 整 计实 = 0; 若 (节型别[被调者] == 节点_变量 && 净挂((字*)(节名表 + 被调者)) < 0) 遍 (计实 = 0; 计实 < 匿数; 计实++) 参移动(参数个数[计实]); } /* 所有权 S4 (2026-09-05): 传参默认移动 — 非 Copy 实参按值传入源失效; 闭包调用排除 (捕获移动由 捕获 移动 语句处理, 快照可重复用); 2026-09-10 A5-2: 原 !下组 误排除错误函数传参移动 → 借用期 move 进错误函数漏拦, 改 净挂<0 真闭包排除 */
                若 (节型别[被调者] == 节点_变量 && 初甲 > 0) { /* 2026-08-28 阶段二 #258 调用运算符重载: 重载 () 类型 = 函; → 符挂(实参) → 函(符挂, 实参...) */
                    整 右附 = 变量型序((字*)(节名表 + 被调者));
                    若 (右附 >= 0) { 字 *目陆 = 类型表[右附].名; 遍 (整 键 = 0; 键 < 初甲; 键++) 若 (重载表[键].符 == 左括 && !比较字符串(重载表[键].型名, 目陆)) {
                        整 中重 = 建节(1); 复制内存((字*)(节名表 + 中重), (字*)(节名表 + 被调者), 64); /* 符挂 独立副本 (防改名污染) */
                        遍 (整 串申 = 匿数; 串申 > 0; 串申--) { 参数个数[串申] = 参数个数[串申 - 1]; 副双[串申] = 副双[串申 - 1]; }
                        参数个数[0] = 中重; 副双[0] = -1; 匿数++; /* 符挂 前置为 实参零 */
