            }

            若 (源子) {
                原肆(函数表[己序].名); /* -graph bypass: call record */
                    中发(中调用标号, 函数表[己序].标号一, 参基 + 总计数, 0); 中刷(); /* Phase3-IR */
                    若 (结构返丢弃) { 码生成结构返偏移 = 0; 码生成结构返静态 = 0; } /* fix 2026-08-30 csmith s16: discard temp reclaimed by add_rsp; zero stale offset so next discard call reallocates */
