                    否 若(元素尺寸==1){ 中发(整集, 0, 0, 0); 中刷(); } /* Phase3-IR case10 */
                    否 若(元素尺寸==8){ 中发(堆柒, 0, 0, 0); 中刷(); } /* Phase3-IR case10 */
                    否 若(元素尺寸==2){ 中发(旁辰, 0, 0, 0); 中刷(); } /* Phase3-IR case10 */
