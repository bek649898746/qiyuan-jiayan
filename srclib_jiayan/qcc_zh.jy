静 整 节无符号[节容量]; /* per-node flag: expression is unsigned (u suffix literal / unsigned var) — >> must be logical SHR (fix 2026-08-05) */

/* ==================== COFF 对象输出（-c 模式） ==================== */
静 整 主升(整 序标);
静 构 { 字 名[64]; 整 标号一; 整 序布; 整 返构序; 整 间拆; } 函数表[65536]; /* fix 2026-08-06: 512 满 → main 等后注册函数被拒 (func_find 返 -1) → 编译产物无 main 崩; 2026-08-09 审计#2: 1024→2048; 2026-08-15 name 32→64 长函数名截断碰撞 (reftable min_update_index/_void); fix 2026-08-16 根因E3: 1024→2048 时 func_find 守卫漏改仍为 1024 → attr.c 等大文件超 1024 函数名 → func_find 返 -1 → func_tbl[-1].ret_si 越界写崩; 2048→8192 覆盖 Git 全量 + 守卫满则 [ERR] 硬退 (绝不返 -1); declared (接入 2026-08-28 declare 声明先行): 声明 名字(参数) 返回 类型; 注册签名, 未实现生成 stub (缺失=警告非错误, AI 渐进补全) */
/* static 函数名映射 (gen_code 重置 func_n, 用名字; fix 2026-08-06 Task 5.3: 多 .o 时 static 函数应 scl=3 局部符号, 否则 jystd 等头库每 .o 重复导出冲突) */
静 字 净深一[512][64]; 静 整 帧叁;
静 空 函数静态标(常 字 *数) { 遍 (整 计 = 0; 计 < 帧叁; 计++) 若 (!比较字符串(净深一[计], 数)) 返; 若 (帧叁 < 512) { 复制字符串(净深一[帧叁++], 数); } 否 原得("static函数表 fn_static", 512); }
静 整 函数是否静态(常 字 *数) { 遍 (整 计 = 0; 计 < 帧叁; 计++) 若 (!比较字符串(净深一[计], 数)) 返 1; 返 0; }
静 空 隔凶(常 字 *数) { 遍 (整 计 = 0; 计 < 帧叁; 计++) 若 (!比较字符串(净深一[计], 数)) { 遍 (整 乙 = 计; 乙 < 帧叁 - 1; 乙++) 复制字符串(净深一[乙], 净深一[乙 + 1]); 帧叁--; 返; } }
静 整 函数数 = 0;
静 字 串升一[256][64]; 静 整 声明数; 静 字 邻捌[256]; /* fix 2026-08-30: C prototypes (int foo(void);) live in decl_names with flag=1: A1001 gate only, NO stub in -c mode (definition may be in another .o - jyld duplicate symbol) */ /* 接入 2026-08-28 declare 声明先行: 独立声明表 (func_n 在 gen_code 重置, 故不依赖 func_tbl.declared) — 声明 名字(参数); 注册, 未实现生成 stub */
静 整 链接模式 = 0;
静 /* fix 2026-08-10 Gate 9: ������� (bare_metal) + �ڴ�����/�����ַ */
整 计挂 = 0; /* Gate 9: ��������������� (main ��� __bare__ ��������) */
#define 剩薄 0x3800000
#define 宽贰 0x3900000
#define 现陆一 0x3A00000
#define 后拆一 0x3B00000
整 满双 = 0; /* -bin: 裸二进制输出 (内核: 无 PE 头/无 CRT/无 .data), fix 2026-08-08 */
静 整 满柒一 = 0; /* -c: ginit emitted once per object */
静 整 链丑 = -1; /* fix 2026-08-17: coff ginit 运行时守卫标志的 .data 槽 (首个被调函数触发一次) */
静 整 单平 = -1; /* fix 2026-08-17: ginit 专用子程序标签 (正文只在 .text 末尾一次) */
#define 首寅 131072
#define 正二 0x30000000 /* .data 重定位 site 哨兵：write_coff_obj 按 rsec=3 分组 */
静 构 { 整 段次; 整 型; 整 半退; 整 现重; 整 高亥; 整 标号一; } 实凶[首寅];
静 整 总得;
#define 空置 16384
静 构 { 字 名[64]; 整 值一; 整 缓癸; 整 域; 整 型; } 符退[空置];
静 整 满己;
静 uint8_t *列叁; 静 整 单利, 左进一;
静 uint8_t *列己; 静 整 副酉, 间退;
静 整 值升, 毛薄, 素戊, 外浅;

静 整 满合(常 字 *名) {
    遍 (整 计 = 0; 计 < 满己; 计++) 若 (!比较字符串(符退[计].名, 名)) 返 计;
    返 -1;
}
静 整 首利(常 字 *名, 整 值一, 整 缓癸, 整 域, 整 型) {
    若 (满己 >= 空置) { 输出到文件(错误流, "qcc: csym overflow\n"); 终止程序(); }
    整 计 = 满己++;
    拷贝前n(符退[计].名, 名, 63); 符退[计].名[63] = 0;
    符退[计].值一 = 值一; 符退[计].缓癸 = 缓癸; 符退[计].域 = 域; 符退[计].型 = 型;
    返 计;
}
静 空 缺亥(整 段次, 整 型, 整 半退, 整 现重) {
    若 (总得 >= 首寅) { 输出到文件(错误流, "qcc: crel overflow\n"); 终止程序(); }
    实凶[总得].段次 = 段次; 实凶[总得].型 = 型;
    实凶[总得].半退 = 半退; 实凶[总得].现重 = 现重;
    实凶[总得].高亥 = 0; 实凶[总得].标号一 = -1;
    总得++;
}
/* .data 槽重定位：site 以 COFF_DATA_SITE_BASE 为基（write_coff_obj 识别为 secs[3]） */
静 空 序深(整 数据偏, 整 型, 整 半退, 整 现重) {
    缺亥(正二 + 数据偏, 型, 半退, 现重);
}
静 整 列挂 = -1;
静 整 净拾(空) {
    若 (列挂 < 0) 列挂 = 首利("__qcc_heap_counter", 0, 0, 2, 0);
    返 列挂;
}
静 空 下平(空) {
    汇发("    读堆计数器 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x8B); 发字节(0x05); 发四(0); /* mov eax, [rip+0] */
    缺亥(码位 - 4, 0x0004, 净拾(), 0);
}
静 空 堆环(空) {
    汇发("    写堆计数器 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    发字节(0x89); 发字节(0x05); 发四(0); /* mov [rip+0], eax */
    缺亥(码位 - 4, 0x0004, 净拾(), 0);
}
静 空 正浅(常 uint8_t *指, 整 数) {
    若 (单利 + 数 > 左进一) {
        整 接子数 = 左进一 ? 左进一 * 2 : 4096;
        循环 (接子数 < 单利 + 数) 接子数 *= 2;
        列叁 = 重分配(列叁, 接子数); 左进一 = 接子数;
    }
    复制内存(列叁 + 单利, 指, 数); 单利 += 数;
}
静 空 短十(常 uint8_t *指, 整 数) {
    若 (副酉 + 数 > 间退) {
        整 接子数 = 间退 ? 间退 * 2 : 4096;
        循环 (接子数 < 副酉 + 数) 接子数 *= 2;
        列己 = 重分配(列己, 接子数); 间退 = 接子数;
    }
    复制内存(列己 + 副酉, 指, 数); 副酉 += 数;
}
静 整 双成(整 槽) {
    遍 (整 计 = 变量数 - 1; 计 >= 0; 计--) { /* fix 2026-08-15: 原 vs_n()=vs_end 限制导致文件级 static slot 找不到 */
        若 (变量表[计].栈偏移 == 槽) {
            整 串值 = 满合(变量表[计].名);
            若 (串值 < 0) {
                若 (槽 < 0) 串值 = 首利(变量表[计].名, 0, 0, 2, 0); /* extern: sec=0 未定义, scl=2 全局 (fix 2026-08-06 多 .o 链接) */
                否 串值 = 首利(变量表[计].名, 4 * 槽, 4, (静态关键[计] || 逆酉[计]) ? 3 : 2, 0); /* fix 2026-08-06: 函数内 static → scl=3; fix 2026-08-14: 文件级 static 也 scl=3 */
            }
            返 串值;
        }
    }
    返 -1;
}
静 整 主薄(常 字 *数); /* 前向声明 (fix 2026-08-06) */
静 整 段丑(整 标号一) {
    遍 (整 计 = 0; 计 < 函数数; 计++) {
        若 (函数表[计].标号一 == 标号一) {
            整 串值 = 满合(函数表[计].名);
            若 (串值 < 0) {
                整 净升 = (函数是否静态(函数表[计].名) || 主薄(函数表[计].名)) ? 3 : 2; /* fix 2026-08-06: static/内建 → 局部符号 */
                串值 = 首利(函数表[计].名, 函数表[计].序布 ? 标号位[标号一] : 0,
                             函数表[计].序布 ? 1 : 0, 净升, 0x20);
            }
            返 串值;
        }
    }
    返 -1;
}
静 整 新又(常 字 *名) {
    整 串值 = 满合(名);
    若 (串值 < 0) 串值 = 首利(名, 0, 0, 2, 0x20);
    返 串值;
}
/* -c 模式：builtin 名（编译器内联发射，不是外部函数） */
静 整 主薄(常 字 *数) {
    静 常 字 *位非标[] = { "printf", "fprintf", "vfprintf", "sprintf", "snprintf", "vsnprintf", "_vsnprintf", "putstr", "scanf",
        "fopen", "fread", "fwrite", "fputc", "fputs", "fgetc", "fclose", "fseek", "ftell", "rewind", "feof", "fflush", "ferror", "fgets", /* fix 2026-08-18: fgetc 缺 → coff 模式当用户函数链到 msvcrt fgetc, 拿 HANDLE 当 FILE* 崩 (git config 读取); fix 2026-08-24 t35t: feof/fflush/ferror 补内置 — 否则当用户函数外部调用 msvcrt, 句柄当 FILE* 崩 (reflog/strbuf_getwholeline) */
        "_va_alloc", "host_va_alloc", "_setpos", "_getpos", "_exit_proc", "__qcc_va_start",
        "memset", "memcpy", "strlen", "strcmp", "strcpy", "strncpy",
        "malloc", "calloc", "free", "realloc", "isalnum", "isalpha", "exit", "abort", "inb", "outb", "inl", "outl", "__asm", "thread_create", "thread_join" }; /* 2026-08-28 type-root-14 #45: 线程内建 (CreateThread/WaitForSingleObject IAT 调用) */
    遍 (整 计 = 0; 计 < (整)(大小(位非标)/大小((位非标)[0])); 计++) 若 (!比较字符串(位非标[计], 数)) 返 1;
    返 0;
}
静 整 满进(常 字 *数) { /* qcc 专用 builtin: 无 CRT 对应, 取地址无法链接 (fix 2026-08-19: 其余 builtin (strcmp/memset...) 取地址 → coff 符号引用 → jyld 解析 msvcrt 导入 — git string_list `cmp = list->cmp ? list->cmp : strcmp` 原编成 NULL → call *0 → status SEGV) */
    静 常 字 *初细[] = { "putstr", "_va_alloc", "host_va_alloc", "_setpos", "_getpos", "_exit_proc", "__qcc_va_start", "inb", "outb", "inl", "outl", "__asm" };
    遍 (整 计 = 0; 计 < (整)(大小(初细)/大小((初细)[0])); 计++) 若 (!比较字符串(初细[计], 数)) 返 1;
    返 0;
}
静 整 静态位移(整 序标, 整 键) {
    若 (链接模式) {
        整 串值 = 双成(序标);
        若 (串值 >= 0) 缺亥(码位 + 2 + 键, 0x0004, 串值, 0);
        返 键;
    }
    若 (序标 < 0) { /* extern 无定义: 单文件编译无法解析 (fix 2026-08-06) */
        遍 (整 计 = 变量总数() - 1; 计 >= 0; 计--) 若 (变量表[计].栈偏移 == 序标) { 输出到文件(错误流, "[ERR] extern 变量 '%s' 无定义 — 多文件请用 qcc -c + jyld 链接\n", 变量表[计].名); 退出(1); }
        输出到文件(错误流, "[ERR] extern 变量无定义\n"); 退出(1);
    }
    返 主升(序标);
}

静 整 新标号(空) { 若 (初成 >= 短繁) { 输出到文件(错误流, "[LABEL-OVERFLOW] lc=%d\n", 初成); 终止程序(); } 整 末 = 初成++; 标号设[末] = 0; 返 末; }
静 空 设标号(整 末) { 标号位[末] = 码位; 标号设[末] = 1; 汇发(".L%d:\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0); }
静 空 补标号(整 尾柒, 整 末, 整 全附) {
    若 (链接模式) {
        整 直弊 = 段丑(末);
        若 (直弊 >= 0) {
            缺亥(尾柒, 0x0004, 直弊, 0);
        } 否 {
            若 (!值升) 值升 = 首利(".text", 0, 1, 3, 0);
            缺亥(尾柒, 0x0004, 值升, 0);
            实凶[总得 - 1].高亥 = 1;
            实凶[总得 - 1].标号一 = 末;
        }
        返;
    }
    若 (计利一 >= 262144) { 输出到文件(错误流, "[PATCH-OVERFLOW] patch_n=%d (at label %d)\n", 计利一, 末); 终止程序(); }
    /* Emit the jump mnemonic into the asm text using the REAL label id (l),
       not the placeholder rel value. Fix 2026-08-03: -S output previously
       used jz_rel's rel (always 1 for forward refs), so asm_zh could never
       resolve jump targets -> H1!=H2. */
    若 (全附 == 0) 汇发("    调用 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 1) 汇发("    为零跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 2) 汇发("    跳转 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 3) 汇发("    非零跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 4) 汇发("    非负跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 5) 汇发("    大于等跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 6) 汇发("    小于等跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 7) 汇发("    高于等跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 8) 汇发("    低于跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 9) 汇发("    高于跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0);
    否 若 (全附 == 10) 汇发("    小跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0); /* jl (fix 2026-08-06 %lld) */
    否 若 (全附 == 11) 汇发("    大跳 .L%d\n", (字*)(长 长)(末), (字*)(长 长)0, (字*)(长 长)0); /* jg (fix 2026-08-06) */
    全败[计利一].旁退 = 尾柒;
    全败[计利一].单低 = 末;
    全败[计利一].全附 = 全附;
    计利一++;
}
静 空 解析补丁(空) {
    遍 (整 计 = 0; 计 < 计利一; 计++) {
        整 尾柒 = 全败[计].旁退;
        整 空平 = 标号位[全败[计].单低];
        整 全附 = 全败[计].全附;

        若 (全附 == 0) {
            /* CALL rel32: E8 already emitted, at points to rel32 bytes */
            整 顺败 = 空平 - (尾柒 + 4);
            隔贰(尾柒, 顺败);
        } 否 若 (全附 == 2) {
            /* JMP rel32 */
            整 顺败 = 空平 - (尾柒 + 4);
            隔贰(尾柒, 顺败);
        } 否 若 (全附 == 1 || (全附 >= 3 && 全附 <= 11)) {
            /* Jcc rel32 (jz/jnz/jns/jge/jle/jae/jb/ja/jl/jg) */
            整 顺败 = 空平 - (尾柒 + 4);
            码[尾柒] = 顺败 & 0xff;
            码[尾柒 + 1] = (顺败 >> 8) & 0xff;
            码[尾柒 + 2] = (顺败 >> 16) & 0xff;
            码[尾柒 + 3] = (顺败 >> 24) & 0xff;
        }
    }
}
/* codegen-time var visibility (root-cause 2026-08-03): during codegen, lookups run
   with parse_base=0 over [0, fve[gfn]), so a name that is BOTH a file-scope static
   AND an earlier function's local would resolve to the LOCAL (later index) — e.g.
   gen_code's `lc = g_lc_save` picked up cg()'s local `lc`, emitting a frame access
   whose rsp_off lay ~1KB below gen_code's frame. The global frame hid this (the
   write stayed in-frame); local frames expose it (stack corruption). The parse-time
   rule is: non-static vars are visible only within their own function
   [fvb[gfn], fve[gfn]); statics are visible everywhere. Enforce it during codegen. */
静 整 变量码生成可见(整 计) {
    若 (变量表[计].是否静态标) {
        若 (!净乙) 返 1;            /* parse: statics visible (parse_base floor already blocks prior fns) */
        若 (满伴) 返 1;       /* ginit: emitted at main entry, ALL statics visible (fix 2026-08-11 BLOCKER-3) */
        若 (静态关键[计]) 返 (计 >= 新寅[剩回]); /* fn-local static: ONLY its own function (fix 2026-08-11 BLOCKER-3) */
        返 1;                         /* global static: visible from any function */
    }
    若 (!净乙) 返 (计 >= 解析基 && (变量表[计].旧零 == 0 || 变量表[计].旧零 == -1)); /* parse phase: ONLY current function body (parse_base floor).
                                              fix 2026-08-11 BLOCKER-1: 原 return 1 导致跨函数同名变量泄漏 —
                                              var_is_dbl 等从其他函数找到同名变量 → ndbl[] 误标 → codegen 差异 (布局敏感根因)
                                              fix 2026-08-28 type-root-13 #277: 块已退出的变量 (blk_end>0) 不可见 — 块内同名遮蔽外层, 块外恢复外层 (原 parse 期无视块标记 → 块内变量泄漏出块遮蔽外层) */
    若 (满伴) 返 0; /* fix 2026-08-17: ginit 只初始化静态; 跨函数非静态同名变量 (char *suffix 遮蔽 static char *suffix[]) 在 ginit 子程序发射点 fvb[gfn]/cg_blk_end 未正确设置时全可见 → 数组元素赋值错编成指针解引用+字节存储 → 崩 */
    /* fix 2026-08-19: 嵌套块同名变量只在块内可见 — 当前 codegen 块 [cg_blk_start, cg_blk_end)
       必须被该变量的声明块 [blk_start, blk_end) 包含. 否则 `struct strbuf gitdir` 之后嵌套块
       `const char *gitdir = ...` 的独立条目会让外层 &gitdir 解析到 char* 条目 (p_esz=1) →
       case 11 跳过 off-=sizeof(strbuf) → 地址错位 → strbuf 崩. 参数 (is_param) 全函数可见. */
    { 整 返二 = (计 >= 新寅[剩回] && 计 < 旁得 && (变量表[计].素三 || 变量表[计].旧零 == -1 || (变量表[计].内薄 <= 值序 && 变量表[计].旧零 >= 旁得))); 返 返二; } /* codegen: this function's locals/params, and only up to the current block end — later sibling-block locals must not shadow earlier blocks (fix 2026-08-16). blk_end==-1: 复用条目标记函数级可见 (fix 2026-08-19) */
}
静 整 变量是否浮(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].是否浮标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否浮标; /* 全局 double (fix 2026-08-13: parse 期 parse_base 排除全局 → 全局 double 算术丢 64 位) */
    返 0;
}
/* long long var: 64-bit int loads/stores (fix 2026-08-05) */
静 整 变量是否长(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].是否长标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否长标; /* 全局 long long (fix 2026-08-13: 全局 LL 算术被当 32 位, b_global 6000000000→低32) */
    返 0;
}
/* char var: 1-byte loads/stores (fix 2026-08-25 bug#28b: 局部 char 变量 32 位读/写 → 负值/高位非零值错 —
   qcc char=unsigned 约定, 读用 movzx 零扩展, 存用 mov byte 截断) */
静 整 变量是否字符(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].是否字符标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否字符标; /* 全局 char */
    返 0;
}
/* signed char var: movsx 符号扩展读 (fix 2026-08-29 csmith: signed char x=0xB3 须返回 -77 非 179) */
静 整 整丙(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].深成;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].深成;
    返 0;
}
/* short var: 2-byte loads/stores (fix 2026-08-25 bug#31b: 局部 short/uint16_t 32 位读/写 → 16 位值高位污染) */
静 整 变量是否短(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].是否短标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].是否短标; /* 全局 short */
    返 0;
}
/* unsigned variable: >> must use SHR (logical), not SAR (fix 2026-08-05) */
静 整 变量是否无符号(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].无符号标;
    遍 (整 计 = 解析基 - 1; 计 >= 0; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && !静态关键[计]) 返 变量表[计].无符号标; /* 全局 unsigned (fix 2026-08-13) */
    返 0;
}
/* pointer-to-double (double *p): p[i] reads/writes 8-byte doubles (movsd) */
静 整 变量指浮(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量码生成可见(计)) 返 变量表[计].指浮;
    返 0;
}
/* 8-byte frame slot for a local double */
静 整 余乙(常 字 *数) { /* long long: 8-byte int slot (fix 2026-08-05) */
    
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].数组尺寸 == 0 && 变量码生成可见(计)) {  变量表[计].是否长标 = 1; 变量表[计].旧零 = -1; 返 变量表[计].栈偏移; } /* fix 2026-08-19: 复用条目标记函数级可见 */
    若 (变量数 >= 65536) { 输出到文件(错误流, "[ERR] 变量表满 vcnt=%d\n", 变量数); 退出(1); }
    复制字符串(变量表[变量数].名, 数);
    栈用量 += 8; 栈用量 = (栈用量 + 15) & ~15;
    变量表[变量数].栈偏移 = 栈用量 - 8;
    变量表[变量数].素三 = 0;
    变量表[变量数].栈又 = -1; 变量表[变量数].值丙 = -1;
    变量表[变量数].型序标 = -1; 变量表[变量数].构尺寸 = 0; 变量表[变量数].数组尺寸 = 0; 变量表[变量数].数组元素尺寸 = 0;
    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0; 变量表[变量数].指元素尺寸 = 0; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = 0; 变量表[变量数].是否浮标 = 0; 变量表[变量数].指浮 = 0; 变量表[变量数].是否字符标 = 0; 变量表[变量数].无符号标 = 0; 变量表[变量数].是否静态标 = 0;
    变量表[变量数].是否长标 = 1;
    
    返 变量表[变量数++].栈偏移;
}
静 整 变浮(常 字 *数) {
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].数组尺寸 == 0 && 变量码生成可见(计)) { 变量表[计].是否浮标 = 1; 变量表[计].旧零 = -1; 返 变量表[计].栈偏移; } /* fix 2026-08-19: 复用条目标记函数级可见 */
    若 (变量数 >= 65536) { 输出到文件(错误流, "[ERR] 变量表满 vcnt=%d\n", 变量数); 退出(1); }
    复制字符串(变量表[变量数].名, 数);
    栈用量 += 8; 栈用量 = (栈用量 + 15) & ~15;
    变量表[变量数].栈偏移 = 栈用量 - 8;
    变量表[变量数].素三 = 0;
    变量表[变量数].栈又 = -1; 变量表[变量数].值丙 = -1;
    变量表[变量数].型序标 = -1; 变量表[变量数].构尺寸 = 0; 变量表[变量数].数组尺寸 = 0; 变量表[变量数].数组元素尺寸 = 0;
    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0; 变量表[变量数].指元素尺寸 = 0; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = 0; 变量表[变量数].是否浮标 = 0; 变量表[变量数].指浮 = 0; 变量表[变量数].是否字符标 = 0; 变量表[变量数].无符号标 = 0; 变量表[变量数].是否静态标 = 0;
    变量表[变量数].是否浮标 = 1;
    返 变量表[变量数++].栈偏移;
}
/* _Alignas(N) 变量级存储对齐 (fix 2026-08-25 step25): 全局对齐 stc_n (.data 4 字节槽, N 任意 — 基址页对齐);
   返回 pending 值供调用方调整局部槽 (var_offset 标量 8 字节槽 → 地址自动 8/16 对齐). 
   无条件消费 alignas_pending 防污染后续变量. */
静 整 左回(空) {
    整 宽升 = 旁联;
    旁联 = 0;
    若 (宽升 > 4) {
        静态数 = (静态数 + 宽升 / 4 - 1) & ~(宽升 / 4 - 1);
    }
    返 宽升;
}
