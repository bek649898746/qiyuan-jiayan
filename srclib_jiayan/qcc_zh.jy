                整 直九 = 变量型序(变名);
                
                整 结构返目标 = 0; 整 现弊一 = 0;
                若 (直九 >= 0 && 类型表[直九].尺寸 > 8 && 变量指元素(变名) == 0 && 子1[数] >= 0 && 节型表[子1[数]] == 4) { 若 (变量是否静态(变名)) { 结构返目标 = 偏移; 现弊一 = 1; } 否 { 结构返目标 = 变量基(变名, 偏移) - 当前帧大小; } } /* fix 2026-08-10: exclude ptr vars; fix 2026-08-30 csmith: static sret 用 off 槽号 (s16) */
                若 (结构返目标) { /* big-struct assign: sret call writes straight into the target */
