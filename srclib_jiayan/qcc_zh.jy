    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "展平")) { /* 接入 2026-08-28 二维展平一维 (flatten): 展平 dst, src, rows, cols; → { __cl=cols; __fl=0; __fr=0; while(__fr<rows){ __fc=0; while(__fc<__cl){ dst[__fl]=src[__fr][__fc]; __fl++; __fc++; } __fr++; } } — 行主序展平 (两级下标, 复用 qcc 原生多维数组机制) */
        词位++; /* 展平 */
