            整 存词位 = 词位; 整 计数二 = 0; 整 前合一 = 1; 词位++; /* 跳过 { */
            循环 (词位 < 词容量 && 前合一 > 0) {
                若 (词型表[词位] == 左花) 前合一++;
                否 若 (词型表[词位] == 右花) { 前合一--; 若 (前合一 == 0) 断; }
                否 若 (词型表[词位] == 逗号 && 前合一 == 1) 计数二++;
                词位++;
