            出[(*丙)++] = 段[计++]; /* opening ' */
            循环 (段[计] && (段[计] != '\'' || 帧再(段, 计))) {
                若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] OOM realloc\n"); 退出(1); } 出 = *出指; }
                出[(*丙)++] = 段[计++];
            }
            若 (段[计]) { 若 (*丙 + 1 > *容量) { *容量 *= 2; *出指 = 重分配(出, *容量); 若 (!*出指) { 输出到文件(错误流, "[ERR] OOM realloc\n"); 退出(1); } 出 = *出指; } 出[(*丙)++] = 段[计++]; }
