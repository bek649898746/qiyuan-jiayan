                    净深[串宏数].数值[乙] = 0;
                    若 (串值[计] == '"') 计++;
                    复制字符串(净深[串宏数].名, 宏名);
                    串宏数++;
                    循环 (串值[计] && 串值[计] != '\n') 计++; /* skip rest of line */
                    续;
                }
                整 半癸 = 1;
                若 (串值[计] == '-') { 半癸 = -1; 计++; } /* fix 2026-08-06: #define NEG -5 负号被丢弃 → NEG 注册为 0 (#if NEG < 0 假) */
                若 (串值[计] == '0' && (串值[计 + 1] == 'x' || 串值[计 + 1] == 'X')) { 计 += 2; 循环 (判十六进制(串值[计])) { 整 字符 = 串值[计]; 若 (字符 >= '0' && 字符 <= '9') 现二 = 现二 * 16 + (字符 - '0'); 否 若 (字符 >= 'a' && 字符 <= 'f') 现二 = 现二 * 16 + (字符 - 'a' + 10); 否 现二 = 现二 * 16 + (字符 - 'A' + 10); 计++; } }
                否 若 (串值[计] == '0' && 串值[计 + 1] >= '0' && 串值[计 + 1] <= '7') { /* 八进制 0170000 = 61440 (fix 2026-08-17: 原无八进制 → git S_IFMT 0170000 存成十进制 170000 → S_IS* 模式检查全错, is_directory 恒 false) */
                    循环 (串值[计] >= '0' && 串值[计] <= '7') { 现二 = 现二 * 8 + (串值[计++] - '0'); }
                }
                否 { 循环 (判数字(串值[计])) { 现二 = 现二 * 10 + (串值[计++] - '0'); } }
                { 整 尾六 = 0, 直肆一 = 0;
                  若 (串值[计] == 'u' || 串值[计] == 'U') { 尾六 = 1; 计++; 循环 (串值[计] == 'l' || 串值[计] == 'L') { 直肆一 = 1; 计++; } }
                  否 若 (串值[计] == 'l' || 串值[计] == 'L') { 循环 (串值[计] == 'l' || 串值[计] == 'L') { 直肆一 = 1; 计++; } 若 (串值[计] == 'u' || 串值[计] == 'U') { 尾六 = 1; 计++; } }
                  外零(宏名, 半癸 * (整)现二, 尾六, 直肆一, (整)(现二 >> 32)); }
            }
            循环 (串值[计] && 串值[计] != '\n') { 若 (串值[计] == '/' && 串值[计 + 1] == '*') { 计 += 2; 循环 (串值[计] && !(串值[计] == '*' && 串值[计 + 1] == '/')) 计++; 若 (串值[计]) 计 += 2; 续; } 若 (串值[计] == '/' && 串值[计 + 1] == '/') { 循环 (串值[计] && 串值[计] != '\n') 计++; 续; } 若 (串值[计] == '\\' && 串值[计 + 1] == '\n') { 计 += 2; 续; } 否 若 (串值[计] == '\\' && 串值[计 + 1] == '\r' && 串值[计 + 2] == '\n') { 计 += 3; 续; } 计++; } /* skip directive line incl. backslash continuations and multi-line block comments (fix 2026-08-15) */
            续;
        }
        若 (串值[计] == '\'') { /* char literal 'c' */
