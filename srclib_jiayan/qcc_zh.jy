静 整 毛重(常 字 *串升, 字 *出, 整 剩繁); /* fwd: 字符串版 CTFE 调用 (过程宏展开用) */
静 整 副酉一(常 字 *串值, 整 尾柒); /* fwd: 生成代码 token 化 */
静 整 旧序[8192]; /* 接入 2026-08-29 P2 #152 TCO (重试): 每函数参数复制点标签 (尾递归 jmp 目标, 跳过 prologue 栈分配) */
静 字 当前函数尾调[65536]; /* #152 TCO: 当前函数是否显式 尾调用优化; (qcc 自身源码不用 → 自举不触发 TCO → 收敛稳定) */
静 整 中属(常 字 *串升, 整 *出); /* fwd: 编译期 f(常量...) 求值 (定义在 const_expr 区, prim 需前向) */
静 整 *词无符号表; /* per-token unsigned-suffix flag (0xFFFFFFFFu) — fix 2026-08-05 */
