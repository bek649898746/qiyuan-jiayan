            若 (!命中一) { /* T1 (2026-09-13) 零静默: 既 非 可见变量, 也 非 类型定义 (型定判断 在上方 已 分流); 若 是 已注册 结构体/联合 标签 → 响亮 报错, 提示 写 `构 X`. A15 (2026-09-13): **再 加 一 层** — 既 非 标签 也 非 任何已注册名字 ⟹ 名字 根本 不存在, 原 静默 返 4 (假尺寸 同 样 是 堆溢出 炸弹, 与 T1 同 危害). */
                整 函序A = 查函数纯(词名表[词位]); /* A67 (2026-09-14): 函数名 —— 本 分支 原 只 认 变量表 (枚举 常量 靠 `全回` 旁路), **函数名 落 到 这里 却 无人 管** (两种 后果 见 下). */
                若 (词型表[词位 + 1] == 左括) { /* 大小(名(...)): C11 6.5.3.4 —— 值 = 名字 所 指 函数 的 返回 类型 大小. 原 词位 只 消费 名字 (L7574 `词位++`) 后 即 走到 末尾, **`(` 实参表 完全 不 消费** → 词位 残留 → 后续 解析 错乱 → 产物 0xC0000005 (既 有 缺陷: 未改动 的 seed 同 样 崩, 与 A15-b 无关). ⚠️ 条件 取 "后 跟 `(`" 而 非 "已 注册 函数" —— 未 注册 的 函数名 同 样 会 残留 `(`, 故 一律 消费. */
                    字 函名A[64]; 复制字符串(函名A, 词名表[词位]);
                    词位++; /* 函数名 */
                    整 深A = 0;
                    循环 (词位 < 词容量 && 词型表[词位] != 词终) { /* 消费 实参表 (括号 平衡 —— 支持 嵌套 调用 / 括号 表达式 / 数组 下标) */
                        若 (词型表[词位] == 左括 || 词型表[词位] == 左方) 深A++;
                        否 若 (词型表[词位] == 右括 || 词型表[词位] == 右方) { 深A--; 若 (深A <= 0) { 词位++; 断; } }
                        词位++;
                    }
                    整 宽A = 查返宽(函名A); /* A67 附 (2026-09-14): **解析期** 返回 宽度表 (返宽表, 由 主循环 解析 函数头 时 `登返宽`) —— 原 用 `半次一` (中细/间浅) 但 那 只 在 **码生成器 阶段** 登记, 解析期 查 恒 0 → char/double 返回 函数 的 `大小(函(...))` 都 得 兜底 4 */
                    若 (宽A <= 0) 宽A = 4; /* 未登记 (函数 声明 在 使用 点 之后 / 完全 未 注册) → 4 (LLP64) */
                    若 (外乙 && 词型表[词位] == 右括) 词位++; /* 大小 自身 的 ) */
                    整 数A = 建节(0); 节值表[数A] = 宽A; 返 数A;
                }
                整 裸标序 = 查类型(词名表[词位]);
                若 (裸标序 >= 0 && 类型表[裸标序].尺寸 > 0) {
                    格式化到串(错缓冲, "大小: '%s' 是 结构体/联合 标签, 不是 类型名 — 请写 `大小(构 %s)` (T1 零静默 2026-09-13)", 词名表[词位], 词名表[词位]);
                    发错误("A1001", 错缓冲);
                } 否 若 (裸标序 < 0 && 函序A < 0 && 词型表[词位 + 1] != 左括 && 全回(词名表[词位]) == 0x80000000) { /* A15-b 根治 (2026-09-14): 既 非 可见变量, 非 类型定义 (L7487 已 分流), 非 裸 结构体/联合 标签, **非 函数名 (函序A, A67 姊妹 修正)**, 非 枚举 常量 (全回), 且 后 不 跟 `(` ⟹ 该 名字 根本 不存在. 原 静默 保持 尺寸=4 并 返 出 (L7539 `整 尺寸 = 4;`), `大小(拼错的名字)` 得 4 → 进 `分配内存(n * 大小(X))` = 假尺寸 → 堆溢出 炸弹 (与 T1/A54 同 危害 类). 落点 由 无条件探针 铁证 (名=NoSuchThing 型定=0 下=18) — 交接 里 "度序 只有 L7209/L15201 两 处理点 且 探针 不触发" 的 矛盾点, 实为 探针 插错 分支 (L7385 在 `大小((X)[0])` 括号 分支 内, 与 本 路径 无关). ⚠️ `函序A < 0` 是 补 的: 首版 判据 漏 了 `大小(函数名)` (无 调用) 形态 → 误报 "未声明" (闸 无此 锚 故 未 拦下). */
                    格式化到串(错缓冲, "大小: '%s' 未声明 — 既 不是 变量/类型名/结构体标签, 也 不是 枚举 常量 (A15-b 2026-09-14)", 词名表[词位]);
                    发错误("A1001", 错缓冲);
                }
            }
            词位++; /* 跳过 变量名 */
            循环 (词型表[词位] == 句点 || 词型表[词位] == 箭头) { /* -> / . 成员 链: 尺寸(e->p->名) — 跟随后续成员直到最后字段 (修复 2026-08-15: precompose_utf8 尺寸(prec_dir->dirent_nfc->d_name) 原只跟一级 → d_name 泄漏 未定义) */
                词位++; /* 跳过 ->/. */
                若 (词型表[词位] == 词变量) {
                    若 (基构序 >= 0) { 整 直弊 = 字段尺寸直(基构序, 词名表[词位]); 若 (直弊 > 0) 尺寸 = 直弊; 整 符凶 = 构域元素(基构序, 词名表[词位]); 若 (符凶 > 0) 元素尺寸 = 符凶; 整 域型 = 字段类型序直(基构序, 词名表[词位]); 若 (域型 >= 0) 基构序 = 域型; 否 基构序 = -1; }
                    词位++;
                }
            }
            若 (词型表[词位] == 左方) { /* D6 (2026-09-13): 多下标 消费 + 域行数 递推. 原 只 吃 一个 [0] → 尺寸 = 元素尺寸 (行=16) 且 第二个 [0] 残留 → postfix 下标 作用 常量 节点 → 0xC0000005 (c_array_2d: sizeof(a[0][0])). 现: 下标 层数 k → 取 域行数[k-1] (整 a[3][4]: k=1 → 16 行, k=2 → 4 元素; 一维 整 b[5]: k=1 → 域行数[0] = 元素). */
                整 d6下 = 0;
                循环 (词型表[词位] == 左方) {
                    词位++; 若 (词型表[词位] == 常数 || 词型表[词位] == 词变量) 词位++; 若 (词型表[词位] == 右方) 词位++; 否 断;
                    d6下++;
                }
                尺寸 = 元素尺寸;
                若 (d6下 >= 2 && 基变序 >= 0 && d6下 <= 8) { 整 d6缓 = 变量表[基变序].域行数[d6下 - 1]; 若 (d6缓 > 0) 尺寸 = d6缓; }
            }
            若 (词型表[词位] == 右括) 词位++; /* ) */
            整 数 = 建节(0); 节值表[数] = 尺寸; 返 数;
        }
        若 (词型表[词位] == 乘) { /* 尺寸(*指针) — 指针 解引用: 指向类型大小 (修复 2026-08-13: 原 返回 -1 → 词元 错位, 镜像 v4 0xC0000005; 哈希-邻辰.h 克隆 复制内存(目标,源,尺寸(*目标))) */
            词位++; /* * */
            整 尺寸 = 8;
            整 构序 = -1;
            整 逆集 = 0;
            循环 (词型表[词位] == 左括) { 逆集++; 词位++; } /* 修复 2026-08-19: 宏展开冗余括号 尺寸(*((源->项))) — COPY_ARRAY 的 尺寸(*(源)) 代入实参带括号 → 原见 ( 不解析直接返 8 → 乘 收到 8 → 状态 崩 */
            若 (词型表[词位] == 词变量) {
                遍 (整 变序 = 变量总数() - 1; 变序 >= 0; 变序--)
                    若 (!比较字符串(变量表[变序].名, 词名表[词位]) && 变量码生成可见(变序)) {
                        若 (变量表[变序].指元素尺寸 > 0) 尺寸 = 变量表[变序].指元素尺寸;
                        构序 = 变量表[变序].型序标;
                        断;
                    }
                词位++; /* 变量 名 */
                /* 修复 2026-08-19: 尺寸(*源->项) — 成员链解引用 (COPY_ARRAY(目标->项, 源->项, 目标->nr)
                   → 复制内存(..., 乘(尺寸(*源->项), n)))。原只处理 *变量名, 源->项 悬空 →
                   解析 错位 → 乘 收到垃圾 → 状态 崩。沿链解析: 指针字段 → 指向大小; 结构体 字段 → 下钻 */
                循环 (词型表[词位] == 句点 || 词型表[词位] == 箭头) {
                    词位++; /* -> / . */
                    若 (词型表[词位] == 词变量) {
                        若 (构序 >= 0) {
                            整 域型 = 字段类型序直(构序, 词名表[词位]);
                            若 (字段是否指(构序, 词名表[词位])) {
                                整 高二 = 字段指元素(构序, 词名表[词位]);
                                若 (高二 > 0) 尺寸 = 高二; /* 指针字段: 尺寸(*p->字段) = 指向元素/结构大小 */
                                构序 = 域型 >= 0 ? 域型 : -1;
                            } 否 若 (域型 >= 0) {
                                构序 = 域型; 尺寸 = 类型表[构序].尺寸; /* 结构体 字段: 下钻, 中间值=结构大小 */
                            } 否 {
                                整 虚八 = 字段尺寸直(构序, 词名表[词位]);
                                若 (虚八 > 0) 尺寸 = 虚八; /* 标量字段: 尺寸(*p->行弊) = 1 */
                                构序 = -1;
                            }
                        }
                        词位++;
                    } 否 断;
                }
            }
            循环 (词型表[词位] == 右括 && 逆集 > 0) { 逆集--; 词位++; } /* 内层闭合括号 (计数配对 — 修复 2026-08-19) */
            若 (词型表[词位] == 右括) 词位++; /* 尺寸 自身的外层 ) */
            整 数 = 建节(0); 节值表[数] = 尺寸; 返 数;
        }
        若 (词型表[词位] == 常数) { /* 尺寸(字面量): 整数常量类型大小 (2026-09-03 账② 修复: 原缺分支 → 返-1 → 未定义行为, 尺寸(1)=1) */
            整 尺寸 = 4; /* 整数/长整(4字节 LLP64)/无符号整数 均 4 */
            若 (词长表[词位] >= 2) 尺寸 = 8; /* 邻辰 字面量 → 8 */
            词位++;
            若 (外乙 && 词型表[词位] == 右括) 词位++; /* 尺寸(1) 的 ) */
            整 数 = 建节(0); 节值表[数] = 尺寸; 返 数;
        }
        若 (词型表[词位] == 终简) { /* 尺寸(1.5): 双精度 字面量 → 8 (2026-09-03 账② 修复); A50 (2026-09-14): `1.5f` 单精度 → **4** (词长表 3 标记, 原 一律 8) */
            整 宽简 = (词长表[词位] == 3) ? 4 : 8;
            词位++;
            若 (外乙 && 词型表[词位] == 右括) 词位++;
            整 数 = 建节(0); 节值表[数] = 宽简; 返 数;
        }
        返 -1;
    }
    若 (词型表[词位] == 常数) { 整 数 = 建节(0); 节值表[数] = 词值表[词位]; 若 (词无符号表[词位]) 节无符号[数] = 1; 若 (词长表[词位] >= 2) { 节长标[数] = 1; 节长高[数] = 段属[词位]; } 否 若 (段属[词位] != 0 || (!词无符号表[词位] && (无 整)词值表[词位] > 0x7FFFFFFF)) { 节长标[数] = 1; 节长高[数] = 段属[词位]; } 词位++; 返 数; } /* u-/邻辰-后缀 字面量 → 标志 (2026-09-03 账② 修复: LL=长标8字节; 十进制无/L后缀超int/long范围提升long long; 范围内长(1)按4字节) */
    若 (词型表[词位] == 终简) { 整 数 = 建节(0); 节值表[数] = 词值表[词位]; 节型表[数] = 终简; 节型别[数] = 节点_双字面量; 节浮标[数] = 1; 词位++; 返 数; } /* 双精度 字面量; E1f 前置修复: 节型表=终简 覆写后同步 节型别 (原 节型别 陈旧=节点_常数 0 → 码生成 双字面量 派发错) */
    若 (词型表[词位] == 词变量) {
        /* 过程宏调用 (2026-08-29 阶段二 #172): 注册名 + ( → 编译期执行函数 → 生成代码文本 → 词元 化就地拼接 → 续解析表达式 */
        若 (首申(词名表[词位]) && 词型表[词位 + 1] == 左括) {
            整 缓子 = 词位;
            字 净组[64]; 复制字符串(净组, 词名表[词位]);
            词位 += 2; /* 跳过 宏名 ( — 毛重 期望 词位 在实参开始 */
            静 字 全列[65536]; /* ⚠️ 静态缓冲 (修复 2026-08-29 #172): 64素繁 栈局部会让 原级 帧 +64素繁 — 解析 深递归叠加 半利一 1.75兆字节 栈帧 → 栈溢出 0xC00000FD (服务 崩基线不崩) */
            全列[0] = 0;
            若 (!毛重(净组, 全列, 大小(全列))) {
                循环 (词位 < 词容量 && 词型表[词位] != 右括 && 词型表[词位] != 词终) { 词位++; } 若 (词型表[词位] == 右括) 词位++;
                格式化到串(错缓冲, "过程宏: %s 展开失败 (函数须已定义且返回字符串, 参数须编译期常量, 函数体须 编译期求值 可解释纯函数)", 净组);
                发错误("A9101", 错缓冲);
                整 旁退一 = 建节(0); 节值表[旁退一] = 0; 返 旁退一;
            }
            整 指终 = 词位; /* ) 之后 */
            整 号分 = 词序 - 指终;
            /* ⚠️ 拼接顺序 (修复 2026-08-29 #172): 尾部 [指终, 指终+尾) 必须先备份 —
               副酉一 落位 [缓子, 缓子+泛数) 在 泛数 大于消费区时会覆盖尾部源,
               (平方和(3,4)→'(3*3)+(4*4)' 11>6 词元 → 尾部读成 '(' '4' → 表达式错乱成 调用) */
            静 整 前重[4096]; 静 整 上五[4096]; 静 整 缺深[4096];
            静 整 前转[4096]; 静 整 池巳[4096]; 静 整 虚申[4096];
            静 字 首高一[4096][64];
            整 全成 = 号分; 若 (全成 > 4096) 全成 = 4096;
            遍 (整 暂隐 = 0; 暂隐 < 全成; 暂隐++) { 前重[暂隐] = 词型表[指终 + 暂隐]; 上五[暂隐] = 词值表[指终 + 暂隐]; 缺深[暂隐] = 词行表[指终 + 暂隐]; 前转[暂隐] = 词无符号表[指终 + 暂隐]; 池巳[暂隐] = 词长表[指终 + 暂隐]; 虚申[暂隐] = 段属[指终 + 暂隐]; 复制内存(首高一[暂隐], 词名表[指终 + 暂隐], 64); }
            整 泛数 = 副酉一(全列, 缓子); /* 生成代码落位 [缓子, 缓子+泛数) */
            若 (泛数 <= 0) {
                格式化到串(错缓冲, "过程宏: %s 生成代码含非法字符 (词元 化失败)", 净组);
                发错误("A9102", 错缓冲);
                整 后子一 = 建节(0); 节值表[后子一] = 0; 返 后子一;
            }
            整 目标 = 缓子 + 泛数;
            若 (目标 + 号分 >= 词容量) { 输出到文件(错误流, "[ERR] 过程宏展开后 词元 溢出\n"); 退出(1); }
            遍 (整 暂隐 = 0; 暂隐 < 全成; 暂隐++) { 词型表[目标 + 暂隐] = 前重[暂隐]; 词值表[目标 + 暂隐] = 上五[暂隐]; 词行表[目标 + 暂隐] = 缺深[暂隐]; 词无符号表[目标 + 暂隐] = 前转[暂隐]; 词长表[目标 + 暂隐] = 池巳[暂隐]; 段属[目标 + 暂隐] = 虚申[暂隐]; 复制内存(词名表[目标 + 暂隐], 首高一[暂隐], 64); }
            词序 = 目标 + 号分;
            词位 = 缓子;
            返 原级(); /* 递归解析生成代码 (作表达式) */
        }
        /* 空 = 0 (修复 2026-08-03: 该 自身-宿主 词法器 已 无 preprocessor, 故
           <stddef.h>'s #定义 空 永不 reaches 该 解析器 — 它 fell 经 到
           一 未定义 标识符 且 已编译 到 a stale-寄存器 存储) */
        若 (!比较字符串(词名表[词位], "NULL") || !比较字符串(词名表[词位], "nullptr") || !比较字符串(词名表[词位], "空指针")) { 词位++; 整 数 = 建节(0); 节值表[数] = 0; 返 数; } /* 阶段C-1 #C23 nullptr (2026-09-01): 空指针字面量 — nullptr/空指针 双认, 与 NULL 同值 0 节点 (赋任意指针/与指针比较) */
        若 (!比较字符串(词名表[词位], "__builtin_constant_p")) { /* 编译器 内置: 编译期常量判断 → 返回 0 走运行时分支 (修复 2026-08-14: bswap.h 用, 原当函数调用 → 未定义 符号) */
            词位++; /* 函数名 */
            若 (词型表[词位] == 左括) { 整 元 = 1; 词位++; 循环 (词位 < 词容量 && 元 > 0) { 若 (词型表[词位] == 左括) 元++; 否 若 (词型表[词位] == 右括) { 元--; 若 (元 <= 0) { 词位++; 断; } } 词位++; } } /* 跳过 (实参) */
            整 数 = 建节(0); 节值表[数] = 0; 返 数;
        }
        若 (!比较字符串(词名表[词位], "__builtin_types_compatible_p")) { /* 编译器 内置: 类型兼容判断 → 返回 0 (保守: 不兼容 → copyable=1 → BARF_UNLESS_COPYABLE 通过) (修复 2026-08-20: COPY_ARRAY 宏的 copyable 用 — 原当函数调用 → 括号/参数解析错乱 → copy_array 调用只压 1 参 → preprocess_options 复制内存 参数错位 → 版本库 日志 崩) */
            词位++; /* 函数名 */
            若 (词型表[词位] == 左括) { 整 元 = 1; 词位++; 循环 (词位 < 词容量 && 元 > 0) { 若 (词型表[词位] == 左括) 元++; 否 若 (词型表[词位] == 右括) { 元--; 若 (元 <= 0) { 词位++; 断; } } 词位++; } } /* 跳过 (typeof(...), 字符) — 不解析 typeof, 防括号配对破坏 */
