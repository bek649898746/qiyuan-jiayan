    若 (词型表[词位] == 词变量 && !比较字符串(词名表[词位], "去重")) { /* 接入 2026-08-27 去重 (unique 相邻去重): 去重 dst, src, n; → { __uq=0; __k=0; while(__uq<n){ if(__k==0 || dst[__k-1]!=src[__uq]){ dst[__k]=src[__uq]; __k++; } __uq++; } } — 去除相邻重复 (须排序后), 双指针 */
