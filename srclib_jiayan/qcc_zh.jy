                       ALLOC_GROW 的 st_mult(sizeof(*items)=0xfff7ffff) → status 崩 */
                    码生成免解引用 = 1; 码生成(指节); 码生成免解引用 = 0; /* rax = &dst (case-12 no_deref 给指针值=结构体地址) */
                    压栈寄存器(0);
                    若 (节型表[子1[数]] == 12 || 节型表[子1[数]] == 15 || 节型表[子1[数]] == 13) { 码生成免解引用 = 1; 码生成(子1[数]); 码生成免解引用 = 0; } /* rax = &src (*src 解引用 / desc->entry 成员链取址, fix 2026-08-22 t47) */
                    否 { 字 *首联 = (字*)(节名表 + 子1[数]); 整 目伴 = 查变量(首联); 若 (变量是否静态(首联)) { 中发(缺捌, 目伴, 1, 0); 中刷(); } 否 { 中发(副失, 0, 变量基(首联, 目伴) - 当前帧大小, 0); 中刷(); } } /* Phase3-IR case10: *dst=*src RHS 取址 */
