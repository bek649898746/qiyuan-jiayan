                        复制字符串(满利, 序己); /* fix 2026-08-26 ffmpeg: 基于实际找到的目录 (父链回溯命中), 再拼 fname 子目录 — 原从 inc_dir_stack 拼接 (父链找到的头记错位置 → 头内相对 include 解析错); libavutil/common.h 经父链在根找到, 实际目录=根+libavutil */
                        若 (双零[0]) { 拼接(满利, "/"); 拼接(满利, 双零); }
                        若 (净厚 < 16) { 复制字符串(空七[净厚], 满利); 净厚++; } 否 原得("include目录栈 inc_dir", 16);
                        字 *取指数 = 缓卯(容复, 深度 + 1);
                        净厚--;
                        释放内存(容复);
                        整 元素 = (整)取字长(取指数);
                        若 (出序 + 元素 + 2 >= 容量) { 容量 = 出序 + 元素 + 16384; 出 = 重分配(出, 容量); }
                        复制内存(出 + 出序, 取指数, 元素); 出序 += 元素;
                        出[出序++] = '\n';
                        释放内存(取指数);
                    }
                }
            } 否 {
                /* fix 2026-08-07: 注册 #define 名 → include 守卫生效; #undef 移除 */
                整 内戊 = ((!比前n(指深度, "define", 6) && (指深度[6] == 0 || 指深度[6] == ' ' || 指深度[6] == '\t' || 指深度[6] == '\r' || 指深度[6] == '\n')) || (!比前n(指深度, "定义词", 9) && (指深度[9] == 0 || 指深度[9] == ' ' || 指深度[9] == '\t' || 指深度[9] == '\r' || 指深度[9] == '\n')));
                整 高属 = !比前n(指深度, "undef", 5) && (指深度[5] == 0 || 指深度[5] == ' ' || 指深度[5] == '\t' || 指深度[5] == '\r' || 指深度[5] == '\n');
                若 (内戊 && !顺一) {
                    字 新升一[64]; 整 现二 = 0;
                    毛简(指, 新升一, &现二); /* fix 2026-08-07: 名字+数值都记 */
                    若 (新升一[0]) 首丙一(新升一, 现二);
                } 否 若 (高属) {
                    常 字 *寻 = 指深度 + 5;
                    循环 (*寻 == ' ' || *寻 == '\t') 寻++;
                    字 新升一[64]; 整 宏序 = 0;
                    循环 (判字母数字((无 字)*寻) || *寻 == '_' || ((无 字)*寻 >= 0x80)) { 若 (宏序 < 63) 新升一[宏序++] = *寻; 寻++; }
                    新升一[宏序] = 0;
                    若 (宏序 > 0) 缺得(新升一);
                }
                复制内存(出 + 出序, 指, 计属 + 1); 出序 += 计属 + 1;
            }
        } 否 {
            复制内存(出 + 出序, 指, 计属 + 1); 出序 += 计属 + 1;
        }
        若 (出序 >= 容量 - 4096) { 容量 *= 2; /* fix 2026-08-13 Phase3: 倍增替代 +32768 (bump realloc 泄漏) */; 出 = 重分配(出, 容量); }
        指 = *小于等 ? 小于等 + 1 : 小于等;
    }
    出[出序] = 0;
    返 出;
}

静 整 栈用量;           /* ????????? */

/* ?????? struct ??????????? */
静 构 { 字 名[64]; 字 正辰[1024][64]; 整 正聚[1024]; 整 现捌[1024]; 整 域行数[1024]; 整 毛利[1024]; 整 间次一[1024]; 整 高玖[1024]; 字 副优[1024]; 字 值劣[1024]; 整 内联[1024]; 整 符肆[1024]; 字 原进[1024]; 整 主挂[1024]; 字 高贰[1024]; 字 副戌[1024]; 整 函; 整 尺寸; 整 满卯; } 类型表[4096]; /* fels: 数组字段元素大小 (fix 2026-08-07) */ 静 整 类型数; /* algn: struct 最大对齐（fix 2026-08-06）; fix 2026-08-13 字段表 64→128 (diff_options 71 字段); fix 2026-08-14 128→256 (rev_info 130+ 字段); ffins/fdeep (fix 2026-08-22 t41b): 指针字段最终元素大小 + 指针层级 — T** 双指针字段双层下标 (slab[i][j]) 第二维缩放; fcsgn (fix 2026-08-29 csmith): signed char 字段标记 (int8_t 字段读 movsx, s3/s137 静默) */

静 整 查类型(常 字 *数) {
    遍 (整 计 = 0; 计 < 类型数; 计++) 若 (!比较字符串(类型表[计].名, 数)) { 若 (取环境("QCC_DBG_NS")) 若 (查找子串(数, "ref_namespace")) 输出到文件(错误流, "[NS] st_find '%s' -> %d sz=%d algn=%d fn=%d\n", 数, 计, 类型表[计].尺寸, 类型表[计].满卯, 类型表[计].函); 返 计; }
    若 (取环境("QCC_DBG_NS")) 若 (查找子串(数, "ref_namespace")) 输出到文件(错误流, "[NS] st_find '%s' -> -1\n", 数);
    返 -1;
}
静 整 位槽 = -1, 位位 = 0;  /* bit-field packing state: current int-slot foffs + bit offset inside it */
静 空 类型定型(整 构序) { /* fix 2026-08-06: struct 总大小按最大对齐 round up — 原只记 algn 未应用, SC{int,char}=5 应为 8 (数组 stride/sret 一致性) */
    若 (构序 >= 0 && 类型表[构序].满卯 > 1 && 类型表[构序].尺寸 % 类型表[构序].满卯)
        类型表[构序].尺寸 += 类型表[构序].满卯 - (类型表[构序].尺寸 % 类型表[构序].满卯);
}
静 空 实重一(整 新构序); /* fwd: 前向声明 struct Tag *field 的类型回填 (fix 2026-08-18) */
静 整 标合 = 1; /* fix 2026-08-19: struct 类型成员的对齐暂存 — 注册处设, st_field_sz_r 消费 (FILETIME=4 → WIN32_FIND_DATAW 布局对齐 Windows SDK) */
静 整 旁联 = 0; /* fix 2026-08-25 step21: _Alignas(N) 显式对齐暂存 — parser 在 AG token 处设, st_field_sz_r 消费 (字段级对齐, 并抬升 struct 最大对齐) */
静 整 名散 = 0; /* fix 2026-08-25 step25: _Alignas(N) struct 前 — 修饰 struct 变量 (gcc: `_Alignas(16) struct S v;` 对齐 v, 不修饰类型/字段); var_struct 消费 */
静 整 构加(常 字 *数) {
    若 (类型数 >= 4096) { 输出到文件(错误流, "[ERR] struct 表满 4096 (fix 2026-08-17 审计: 满则硬退, 绝不返 -1 — 原返 -1 调用方未检查 → stypes[-1] 越界写)\n"); 退出(1); }
    复制字符串(类型表[类型数].名, 数); 类型表[类型数].函 = 0; 类型表[类型数].尺寸 = 0; 类型表[类型数].满卯 = 1;
    位槽 = -1; 位位 = 0; /* reset bit-field packing for the new struct */
    标合 = 1; /* fix 2026-08-20: 新 struct 开始时重置 struct 对齐暂存 — 原跨 struct 泄漏 (eg_a algn=8 残留 → eg_b 字段被 8 对齐 → di_b 数组字段偏移 8 错 (应 4)) */
    整 半捌 = 类型数++;
    若 (取环境("QCC_DBG_NS")) 若 (1) 输出到文件(错误流, "[NS] st_add name='%s' ns=%d\n", 数, 半捌); /* tmp diag ALL */
    若 (查找子串(数, "pathspec")) 输出到文件(错误流, "[NSA!] st_add name='%s' ns=%d\n", 数, 半捌); /* tmp diag */
    实重一(半捌); /* 新结构体定义 (或首次引用即创建) → 回填引用它的 pending 指针字段 (fix 2026-08-18) */
    返 半捌;
}
静 空 字段尺寸递归(整 构序, 常 字 *函, 整 域尺寸, 整 行) {
    若 (类型表[构序].函 >= 1024) { 输出到文件(错误流, "[ERR] struct '%s' 字段超过 1024 上限\n", 类型表[构序].名); 退出(1); }
     
    若 (取环境("QCC_DBG_NS")) 若 (!比较字符串(类型表[构序].名, "gz3") || !比较字符串(类型表[构序].名, "z_stream_s") || !比较字符串(类型表[构序].名, "git_zstream") || 查找子串(类型表[构序].名, "z_stream") || !比较字符串(类型表[构序].名, "config_set") || !比较字符串(类型表[构序].名, "hashmap") || !比较字符串(类型表[构序].名, "configset_list") || !比较字符串(类型表[构序].名, "string_list")) 输出到文件(错误流, "[FLD] struct '%s' fld='%s' fsz=%d frow=%d idx=%d\n", 类型表[构序].名, 函, 域尺寸, 行, 类型表[构序].函); /* tmp diag */
    整 序标 = 类型表[构序].函;
    /* fix 2026-08-06: struct 字段对齐填充（char+int 应 8 非 5）。对齐单位由 frow（元素/行大小）推导:
       frow>=8 → 8 (double/LL/指针); frow>=4 → 4 (int/float); frow>=2 → 2 (short)。数组字段 frow=元素大小。
       fix 2026-08-07: fsz>=8 也 8 对齐 — 指针字段 (struct LNode* next) 调用传 frow=1 → 原 align=1 → 偏移错位 (读 [&b+4] 而非 +8) */
    整 深庚 = 1;
    若 (标合 > 1) { 深庚 = 标合; 标合 = 1; } /* fix 2026-08-19: struct 类型成员按结构体自身对齐 (FILETIME=4 非按大小 8 → WIN32_FIND_DATAW cFileName@44 非 48 — Windows SDK 布局) */
    否 若 (行 != 域尺寸) { /* 数组字段: 对齐按元素大小 (frow), 非总大小 — fix 2026-08-19: wchar_t cFileName[260] fsz=520 → 原 align=8 → 偏移 48 错 (应 44, wchar_t 对齐 2) */
        若 (行 >= 8) 深庚 = 8;
        否 若 (行 >= 4) 深庚 = 4;
        否 若 (行 >= 2) 深庚 = 2;
    }
    否 若 (行 >= 8 || 域尺寸 >= 8) 深庚 = 8;
    否 若 (行 >= 4 || 域尺寸 >= 4) 深庚 = 4;
    否 若 (行 >= 2 || 域尺寸 >= 2) 深庚 = 2;
    若 (旁联 > 0) { /* fix 2026-08-25 step21: _Alignas(N) 显式对齐覆盖自然对齐 (只增不减); 消费后清零 — struct A1 {_Alignas(8) char} → sizeof 8, A4 {char,_Alignas(8) int} → i@8 sizeof 16 */
        若 (旁联 > 深庚) 深庚 = 旁联;
        旁联 = 0;
    }
    若 (类型表[构序].尺寸 % 深庚) 类型表[构序].尺寸 += 深庚 - (类型表[构序].尺寸 % 深庚); /* pad 字段偏移到对齐 */
    复制字符串(类型表[构序].正辰[序标], 函);
    类型表[构序].正聚[序标] = 类型表[构序].尺寸;
    类型表[构序].现捌[序标] = 域尺寸;
    复制内存(&类型表[构序].域行数[序标], &行, 4); /* fix 2026-08-05: direct frows[idx]=frow made nested-store scale read the OLD st_field_row -> self-referential garbage on self-host; &arr[i] scales by the fixed element size */
    类型表[构序].毛利[序标] = -1; /* not a struct field by default */
    类型表[构序].间次一[序标] = 0; 类型表[构序].高玖[序标] = 0; /* non bit-field */
    类型表[构序].值劣[序标] = 0; /* non bit-field: signedness irrelevant (fix 2026-08-05) */
    类型表[构序].原进[序标] = 0; /* 指针字段标记: 字段解析处按 npel 设置 (fix 2026-08-18) */
    位槽 = -1; 位位 = 0; /* a non-bit-field ends any pending bit run */
    类型表[构序].尺寸 += 域尺寸;
    若 (深庚 > 类型表[构序].满卯) 类型表[构序].满卯 = 深庚; /* 记录 struct 最大对齐（总大小 round up） */
    若 (取环境("QCC_DBG_NS")) 若 (类型表[构序].名[0] == 0 || 查找子串(类型表[构序].名, "ref_namespace") || 查找子串(类型表[构序].名, "pathspec")) 输出到文件(错误流, "[NS] fld '%s' field='%s' si=%d idx=%d foffs=%d fsz=%d frow=%d\n", 类型表[构序].名, 函, 构序, 序标, 类型表[构序].正聚[序标], 域尺寸, 行);
    若 (查找子串(类型表[构序].名, "pathspec")) 输出到文件(错误流, "[NS!] fld '%s' field='%s' si=%d idx=%d foffs=%d fsz=%d frow=%d\n", 类型表[构序].名, 函, 构序, 序标, 类型表[构序].正聚[序标], 域尺寸, 行); /* tmp diag */
    类型表[构序].函 = 类型表[构序].函 + 1;
}
静 整 字段序(整 构序, 常 字 *函) { 遍 (整 计 = 0; 计 < 类型表[构序].函; 计++) 若 (!比较字符串(类型表[构序].正辰[计], 函)) 返 计; 返 -1; }
静 整 构域元素(整 构序, 常 字 *函) { 整 序标 = 字段序(构序, 函); 返 (序标 >= 0 && 类型表[构序].内联[序标] > 0) ? 类型表[构序].内联[序标] : (序标 >= 0 ? 类型表[构序].域行数[序标] : 1); } /* 数组字段元素大小; 未设置→frow (标量) */
静 整 字段指元素(整 构序, 常 字 *函) { 整 序标 = 字段序(构序, 函);  若 (序标 >= 0 && 类型表[构序].符肆[序标] > 0) 返 类型表[构序].符肆[序标]; /* fix 2026-08-21: fpels 未设置/为 0 — 前向声明 struct T *field 的指向元素大小未回填 (L5634 inner_si>=0 分支用未完成 struct 的 sz=0, 且不注册 pend) → fallback 到字段类型的 st_sz (config_set* → 72) */ 若 (序标 >= 0) { 整 暂构序 = -1; 复制内存(&暂构序, &类型表[构序].毛利[序标], 4); 若 (暂构序 >= 0 && 暂构序 < 4096) { 整 容薄 = 类型表[暂构序].尺寸; 若 (容薄 > 0) 返 容薄; } } 返 4; } /* 指针字段的指向元素大小 (fix 2026-08-17: char *buf → 1, int * → 4; 未设置→4) */
静 整 上己(整 构序, 常 字 *函) { /* fix 2026-08-22 t41b: 指针字段最终元素大小 — T** 双层下标第二维 (slab[i][j] 元素 sizeof(T)); 单指针 T* 返回 sizeof(T) 等同 fpels */ 整 序标 = 字段序(构序, 函); 若 (序标 >= 0 && 类型表[构序].主挂[序标] > 0) 返 类型表[构序].主挂[序标]; 若 (序标 >= 0) { 整 暂构序 = -1; 复制内存(&暂构序, &类型表[构序].毛利[序标], 4); 若 (暂构序 >= 0 && 暂构序 < 4096) { 整 容薄 = 类型表[暂构序].尺寸; 若 (容薄 > 0) 返 容薄; } } 返 字段指元素(构序, 函); }
静 整 反二(整 构序, 常 字 *函) { /* fix 2026-08-22 t41b: 指针字段层级 (T*=1, T**=2) — 决定数组基的最大下标层数 */ 整 序标 = 字段序(构序, 函); 若 (序标 >= 0 && 类型表[构序].高贰[序标] > 0) 返 类型表[构序].高贰[序标]; 若 (序标 >= 0 && 类型表[构序].原进[序标] != 0) 返 1; 返 0; }
静 整 字段是否指(整 构序, 常 字 *函) { 整 序标 = 字段序(构序, 函); 返 序标 >= 0 && 类型表[构序].原进[序标] != 0; } /* 指针字段标记 (struct X 星号 等; fix 2026-08-18: 指针字段作数组基判定 — 原 fty==-1 漏判 struct 指针字段) */
静 整 末凶一(整 构序, 常 字 *函) { 整 序标 = 字段序(构序, 函); 若 (序标 >= 0 && 类型表[构序].原进[序标]) 返 0; 若 (序标 < 0) 返 0; 若 (类型表[构序].内联[序标] > 0) 返 类型表[构序].内联[序标] != 类型表[构序].现捌[序标]; 返 类型表[构序].现捌[序标] == 0; } /* 数组字段: fels>0 且 fels(元素大小) != fsizes(总大小); fels==0 时 fsizes==0 → flex/空数组 char name[0] 也是数组 → 成员访问取地址 (fix 2026-08-20: dir_entry.name[FLEX_ARRAY=0] fsz=0 原落 4 字节标量加载 → "hell" 当地址 → add_files %s 崩); fnptr 字段 fels==0, 标量 fels==fsize (fix 2026-08-16); fix 2026-08-19: 指针字段 (fptrs=1) 的 fels=指向元素大小≠fsizes=指针大小 → 被误判为内联数组 → s->next_out[i] 保留字段地址+按 frow(8) 缩放 → qcc_deflate_emit 拷贝写坏 z_stream (next_out=7a/avail_out=-1) */
静 整 构域行(常 字 *符号数, 常 字 *函); /* fwd */
静 整 字段是否浮(常 字 *符号数, 常 字 *函); /* fwd */
静 空 剩未(整 构序, 常 字 *函) { /* fix 2026-08-07: struct 数组字段 → 布好 2D 深度状态 (第一维行大小, 第二维元素大小) */
    整 行二 = 构域行(类型表[构序].名, 函);
    整 元素 = 构域元素(构序, 函);
    长卯 = 元素;                /* deref 用元素大小 */
    中系 = 0;
    上薄[0] = 行二;               /* 第一维 (行) 缩放 */
    上薄[1] = 元素;                /* 第二维 (列) 缩放 */
    标拾 = (行二 > 元素) ? 2 : 1; /* 2D 字段: 第二维后才 deref; 1D: 第一维后 */
    码生成内存浮 = 字段是否浮(类型表[构序].名, 函) ? 1 : 0;
}
静 空 构域位(整 构序, 常 字 *函, 整 域尺寸, 整 行, 整 位宽, 整 长属) {
    /* real bit-field semantics: pack consecutive bit-fields into shared int slots.
       foffs = slot byte offset; fbitof = bit offset inside the slot; fbits = width.
       uns = 1 for `unsigned` bit-fields (no sign extension on read); int → signed. */
    若 (类型表[构序].函 >= 1024) { 输出到文件(错误流, "[ERR] struct 字段超过 1024 上限\n"); 退出(1); }
    整 序标 = 类型表[构序].函;
    复制字符串(类型表[构序].正辰[序标], 函);
    若 (位槽 < 0 || 位位 + 位宽 > 32) { 位槽 = 类型表[构序].尺寸; 类型表[构序].尺寸 += 4; 位位 = 0; }
    类型表[构序].正聚[序标] = 位槽;
    类型表[构序].现捌[序标] = 域尺寸;
    复制内存(&类型表[构序].域行数[序标], &行, 4);
    类型表[构序].毛利[序标] = -1;
    类型表[构序].间次一[序标] = 位宽;
    类型表[构序].高玖[序标] = 位位;
    类型表[构序].值劣[序标] = 长属;
    位位 += 位宽;
    若 (取环境("QCC_DBG_NS")) 若 (类型表[构序].名[0] == 0 || 查找子串(类型表[构序].名, "ref_namespace")) 输出到文件(错误流, "[NS] bit '%s' field='%s' si=%d idx=%d foffs=%d bitof=%d bw=%d uns=%d\n", 类型表[构序].名, 函, 构序, 序标, 类型表[构序].正聚[序标], 类型表[构序].高玖[序标], 位宽, 长属);
    类型表[构序].函 = 类型表[构序].函 + 1;
}
静 空 半四(整 构序, 整 位宽) {
    /* unnamed bit-field ": N" — occupies bits but registers no field (fix 2026-08-05).
       : 0 forces the next named bit-field into a fresh int slot (C rule). */
    若 (位宽 > 0) {
        若 (位槽 < 0 || 位位 + 位宽 > 32) { 位槽 = 类型表[构序].尺寸; 类型表[构序].尺寸 += 4; 位位 = 0; }
        位位 += 位宽;
    } 否 {
        位槽 = -1; 位位 = 0; /* zero-width: next field starts a new slot */
    }
}
静 空 字段类型(整 构序, 常 字 *函, 整 现高) {
    遍 (整 计 = 0; 计 < 类型表[构序].函; 计++)
        若 (!比较字符串(类型表[构序].正辰[计], 函)) { 类型表[构序].毛利[计] = 现高; 返; }
}
/* 前向声明 struct Tag *field 的标签回填 (fix 2026-08-18):
   ref_iterator 的 vtable 字段 — struct ref_iterator_vtable 定义在后 (git refs-internal.h 320 vs 478) →
   字段解析时 inner_si=-1 走"未知标签指针字段"分支 (无 st_field_ty) → st_field_ty_idx=-1 →
   mem_addr 链 iter->vtable->advance 断 → 函数指针调用目标塌缩成 iter → call *iter → git init SEGV.
   Tag 结构体定义时 (st_add / 定义体完成) 回填 ftypes 索引 (字段大小/偏移早已按 8 字节指针就位). */
静 字 余对[4096][64]; 静 整 目凶[4096]; 静 字 段对[4096][64]; 静 整 满失;
静 空 堆丁(常 字 *标, 整 构序, 常 字 *函) {
    若 (满失 >= 4096) { 输出到文件(错误流, "[ERR] pending 结构体标签表满 4096\n"); 退出(1); }
    复制字符串(余对[满失], 标); 目凶[满失] = 构序; 复制字符串(段对[满失], 函); 满失++;
}
静 空 实重一(整 新构序) {
    整 逆复 = 类型表[新构序].尺寸;
    遍 (整 计 = 0; 计 < 满失; 计++)
        若 (!比较字符串(余对[计], 类型表[新构序].名)) {
            字段类型(目凶[计], 段对[计], 新构序);
