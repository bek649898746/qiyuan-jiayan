/* 静态 数组: N 连续 .数据 槽位 (4 字节 每), 数组尺寸 记录 元素 计数 */
/* S4 收口 (2026-09-18): 隔排/末午 之后的「类型信息 补齐」单点收口。
   原先 多个调用点 **各自手补** 型序标/指元素尺寸/指深/指内 —— 漏补即 成为 下一批挂账
   (C72/C74/C75/C76 正是「忘了手补」的四次)。
   约定 (哨兵): 型序 < 0 不改类型序标; 元尺寸 <= 0 不改; 深 < 0 不改; 内 <= 0 不改 ——
   调用点只传它知道的; **不额外设置 构尺寸** (与原手补点严格等价)。 */
/* R233 (2026-09-22): **指针变量 的 类型元数据** 单点收口 ——
   由来: 「局部变量声明」的 static 与非 static 两条分支**各写一遍** 指元素尺寸/指深/指内/型序标。
   第 82 站给非 static 补了「别名 指向构序」而 static 没跟上 ⟹
   `static HP SHP; SHP->p`（函数内 static + typedef 结构体指针别名）型序标 恒 -1 ⟹
   箭头读落「按字段名搜遍全部类型」兜底分支 ⟹ 猜错宿主 ⟹ 静默错值（插桩实证: r233a.c 形态④ 读到 1）。
   本收口: 「尺寸怎么算」「元数据怎么补」各**单一出处**, 两条分支只调不改 —— 漏改在结构上不可能。 */
静 整 指针元尺寸(整 整得, 整 型定指元素, 整 指深一, 整 是否字符标, 整 是否短标, 整 目辛, 整 是否长标) {
    若 (型定指元素 > 0) 返 型定指元素;
    若 (指深一 <= 1 && 整得 >= 0 && 类型表[整得].尺寸 > 0) 返 类型表[整得].尺寸;
    若 (是否字符标) 返 1;
    若 (是否短标) 返 2;
    若 (目辛) 返 1;
    若 (是否长标) 返 8;
    返 4;
}
静 空 指针元补(整 序, 整 整得, 整 元尺寸, 整 型定指元素, 整 型定指构序, 整 指深一) {
    若 (序 < 0 || 序 >= 变量数) 返;
    若 (指深一 >= 1) 变量表[序].指深 = 指深一;
    若 (指深一 >= 2) 变量表[序].数组元素尺寸 = 8; /* R235: 多级指针 的 元素 是 8B 指针 (原 仅 非 static 路径 手写) */
    若 (型定指元素 > 0) 变量表[序].指内 = 型定指元素;
    否 若 (整得 >= 0) 变量表[序].指内 = 类型表[整得].尺寸;
    否 变量表[序].指内 = 元尺寸;
    若 (整得 >= 0) 变量表[序].型序标 = 整得;
    否 若 (型定指构序 >= 0) 变量表[序].型序标 = 型定指构序;
}
静 空 定类型(整 型序, 整 元尺寸, 整 深, 整 内) {
    若 (变量数 <= 0) 返;
    整 序 = 变量数 - 1;
    若 (型序 >= 0) 变量表[序].型序标 = 型序;
    若 (元尺寸 > 0) 变量表[序].指元素尺寸 = 元尺寸;
    若 (深 >= 0) 变量表[序].指深 = 深;
    若 (内 > 0) 变量表[序].指内 = 内;
}
静 整 隔排(常 字 *数, 整 指元素, 整 元素尺寸, 整 数一) {
    弃可空待(数); /* S2a 挂账修复: 静态数组 不支持可空 → 弃 pending */
    变可空待 = 0; /* H1e (2026-09-11): 弃后 清 待定 (防 漏给 下一 声明) */
    左回(); /* 修复 步二十五: _Alignas 变量级 */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && 变量码生成可见(计)) { 若 (取环境("QCC_DBG_NS")) 若 (查找子串(数, "ref_namespace")) 输出到文件(错误流, "[NS] vsa '%s' HIT i=%d rsp=%d pesz=%d esz=%d count=%d\n", 数, 计, 变量表[计].栈偏移, 指元素, 元素尺寸, 数一); 若 (变量表[计].栈偏移 < 0) { 变量表[计].栈偏移 = 静态数; 整 名午一 = (数一 * 元素尺寸 + 3) / 4; 静态数 += 名午一; 变量表[计].数组尺寸 = 数一; 变量表[计].数组元素尺寸 = 元素尺寸; } 变量末序 = 计; 返 变量表[计].栈偏移; }
    整 中退二 = (数一 * 元素尺寸 + 3) / 4; /* 4-字节 槽位 — 按字节数算槽 (修复 2026-08-26 自举: 字符/短整 数组原 槽位=计数 4倍膨胀 — 串表[32768][12288] 4.03亿槽=1.6旁败 → 缓粗 2.06旁败 超 2旁败 可执行格式 加载上限 → 自举 短进.可执行 无效; 正确槽数=总字节/4) */
    若 (变量数 >= 65536 || 静态数 + 中退二 >= 0x20000000) { 输出到文件(错误流, "[ERR] 变量表满 变量数=%d\n", 变量数); 退出(1); } /* 修复 2026-08-26 数据库: 上限 0x4000000→0x20000000 (串表 32768 槽后自宿主逼近旧上限) */
    新条目名(数); /* R438: 建条目 单点收口 */
    变量表[变量数].栈偏移 = 静态数; 静态数 += 中退二; /* 连续 槽位 */
    变量表[变量数].素三 = 0;
    变量表[变量数].栈又 = -1; 变量表[变量数].值丙 = -1;
    变量表[变量数].型序标 = -1; 变量表[变量数].构尺寸 = 0; 变量表[变量数].数组尺寸 = 数一; 变量表[变量数].数组元素尺寸 = 元素尺寸;
    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0; 变量表[变量数].指元素尺寸 = 指元素; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = -1; 变量表[变量数].是否浮标 = 0; 变量表[变量数].指浮 = 0; 变量表[变量数].是否字符标 = 0; 变量表[变量数].无符号标 = 0; 变量表[变量数].是否静态标 = 1;
    静态关键[变量数] = (解析基 > 0) ? 1 : 0; /* 修复 2026-08-11 阻塞-3: 函-局部 静态 数组 记 */
    变量末序 = 变量数;
    返 变量表[变量数++].栈偏移;
}
/* 静态 结构体: 连续 槽位 sized 到 该 结构体 (计数 = 数组 元素), 记录 型序标 */
静 整 中退(常 字 *数, 整 构序, 整 数一) {
    若 (数[0] != '_' && 是保留函名(数)) { 格式化到串(错缓冲, "变量名 '%s' 是 保留词/内建名, 不能作 变量名 (声明会被静默吞掉 ⟹ 静默错值 或 死循环; 请改名) (号合.0, 撞词家族 R434 2026-09-30)", 数); 发错误("A9001", 错缓冲); }
    整 中退可空 = (变可空待 && 解析基 == 0 && 数一 == 1) ? 1 : 0; /* H1e (2026-09-11): 文件作用域 单个 构值 全局 的 可空 意向 (原 弃可空待 静默丢/A6003 误报) — 数组/函数内 静态 不标 */
    若 (中退可空) { 若 (可空针 < 可空槽数 && 可空槽表[可空针] < 词位) 可空针++; } 否 弃可空待(数); /* S2a 挂账修复: 静态结构体 非可空 → 弃 pending */
    变可空待 = 0; /* H1e: 弃后 清 待定 (防 漏给 下一 声明) */
    左回(); /* 修复 步二十五: _Alignas 变量级 */
    遍 (整 计 = 变量总数() - 1; 计 >= 解析基; 计--) 若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && 变量码生成可见(计)) { 若 (取环境("QCC_DBG_NS")) 若 (查找子串(数, "ref_namespace")) 输出到文件(错误流, "[NS] vss '%s' HIT i=%d rsp=%d si=%d sz=%d count=%d\n", 数, 计, 变量表[计].栈偏移, 构序, 类型表[构序].尺寸, 数一); 若 (变量表[计].栈偏移 < 0) { 变量表[计].栈偏移 = 静态数; 整 行排一 = (类型表[构序].尺寸 + 3) / 4; 若 (行排一 < 1) 行排一 = 1; 整 链午一 = 数一 > 0 ? 数一 : 1; 静态数 += 行排一 * 链午一; 变量表[计].构尺寸 = 行排一 * 4; 变量表[计].数组尺寸 = (数一 > 1) ? 数一 : 0; 变量表[计].数组元素尺寸 = 类型表[构序].尺寸; 变量表[计].型序标 = 构序; } 变量末序 = 计; 返 变量表[计].栈偏移; }
    整 中退二 = (类型表[构序].尺寸 + 3) / 4; 若 (中退二 < 1) 中退二 = 1;
    整 链玖 = 中退二 * 数一;
    若 (取环境("QCC_DBG_NS")) 若 (查找子串(数, "ref_namespace")) 输出到文件(错误流, "[NS] vss '%s' NEW si=%d sz=%d count=%d slots=%d total=%d stc_n=%d\n", 数, 构序, 类型表[构序].尺寸, 数一, 中退二, 链玖, 静态数);
    若 (变量数 >= 65536 || 静态数 + 链玖 >= 0x20000000) { 输出到文件(错误流, "[ERR] 变量表满 变量数=%d\n", 变量数); 退出(1); } /* 修复 2026-08-26 数据库: 上限同步 0x20000000 */
    新条目名(数); /* R438: 建条目 单点收口 */
    变量表[变量数].栈偏移 = 静态数; 静态数 += 链玖;
    变量表[变量数].素三 = 0;
    变量表[变量数].栈又 = -1; 变量表[变量数].值丙 = -1;
    变量表[变量数].型序标 = 构序; 变量表[变量数].构尺寸 = 中退二 * 4; 变量表[变量数].数组尺寸 = (数一 > 1) ? 数一 : 0; 变量表[变量数].数组元素尺寸 = 类型表[构序].尺寸; /* 修复 2026-08-06: 计数==1 是普通 结构体 变量不是数组 → 数组尺寸=0, 否则 宽复 拒认 → 静态 结构体 赋值变 32 位/取址 崩 */
    变量表[变量数].域行数[0] = 0; 变量表[变量数].域行数[1] = 0; 变量表[变量数].域行数[2] = 0; 变量表[变量数].域行数[3] = 0; 变量表[变量数].指元素尺寸 = 0; 变量表[变量数].指深 = 0; 变量表[变量数].指内 = 0; 变量表[变量数].宽系 = 0; 变量表[变量数].长酉 = -1; 变量表[变量数].是否浮标 = 0; 变量表[变量数].指浮 = 0; 变量表[变量数].是否字符标 = 0; 变量表[变量数].无符号标 = 0; 变量表[变量数].是否静态标 = 1;
    静态关键[变量数] = (解析基 > 0) ? 1 : 0; /* 修复 2026-08-11 阻塞-3: 函-局部 静态 结构体 记 */
    变量表[变量数].变可空.tag = 中退可空 ? 可空值_无值 : 可空值_有值; /* H1e (2026-09-11): 显式 落位 (原 不写 → 阵列残留 风险); 可空值标 由 site 注册处 置 2 */ 变量表[变量数].可空值标 = 0;
    返 变量表[变量数++].栈偏移;
}
/* 指令指针-相对 偏移 到 .数据 静态 槽位 (首重 数据基址 + 名聚 + 4*序标) 自 instr 于 0x1000+码位 */
静 整 数据基址 = 0x2000; /* .数据 首重 (临时; 文本 可能 grow) */
静 字 汇编名[512]; /* -S 模式 汇编 文件名 (最终代越界重稳定时截断重开用, 修复 2026-08-06) */
静 整 主升(整 序标) { 返 (数据基址 + 名聚 + 4 * 序标) - (0x1000 + 码位 + 6); }
/* 导入表 入口 (内核库): 槽位 0=GetStdHandle 于 .数据+8, 1=WriteFile 于 .数据+0x10 */
静 整 栈轮(整 尾柒, 整 槽) { 整 总午 = 槽 < 64 ? (8 + 8 * 槽) : (0x210 + 8 * (槽 - 64)); 返 (数据基址 + 总午) - (0x1000 + 尾柒 + 6); } /* 双四@+0x08 内核库(17) / 总升@+0x98 msvcrt (2026-08-28 阶段一 #246: 内核库 15→17, 总升 0x88→0x98) */ /* 双四@+0x08 内核库(15) / 总升@+0x88 msvcrt (2026-08-28 类型-根-15 #41: 内核库 11→15 槽) */
静 空 调导入(整 槽) {
    汇发("    调系统 %d\n", (字*)(长 长)(槽), (字*)(长 长)0, (字*)(长 长)0);
    整 尾柒 = 码位; /* 指令 开始 (半十 15 + 三十二位位移 = 6 字节) */
    发字节(0xFF); 发字节(0x15);
    若 (链接模式) {
                静 常 字 *左己[124] = { 
"__imp_GetStdHandle", 
