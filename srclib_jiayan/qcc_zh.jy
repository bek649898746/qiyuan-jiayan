            整 长属 = 0;
            若 (丙 == 帧寅) 长属 = 表达式是否无符号(子0[数]); /* 无符号 >> → 右移一 (修复 2026-08-05) */
            否 若 (丙 == 行降 || 丙 == 度未) 长属 = 表达式是否无符号(子0[数]) || 表达式是否无符号(子1[数]); /* 修复 2026-08-06 M1 */
            若 (本弃 && (丙 == 行降 || 丙 == 度未)) { /* 阶段D DCE (2026-09-04 虾米): 死除法(行降=/度未=%) 结果丢弃 → 标粗已弹栈, 跳过 暂重 不发射 idiv/div (同 gcc -O0 死值消除, 除零 UB 不崩) */ }
