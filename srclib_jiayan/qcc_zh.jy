    移即扩(9, 0); /* r9d = 0 (length) */
    移寄存器(0, 3); /* eax = value */
    移即(1, 0); 算寄存器(比等, 0, 1); 发字节(0x0F); 发字节(0x8D); 发四(0); 补标号(码位-4, 主又一, 5); /* cmp eax,0; jge lcnt */
    汇发("    取反 r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xD8); /* neg eax (fix 2026-08-23 t35g: len 不含符号, 符号提前输出) */
    设标号(主又一);
    移寄存器(8, 0); /* r8d = |value| */
    设标号(全甲); /* do-while: value 0 counts 1 digit (fix 2026-08-03: jz-guard gave len=0 for 0) */
    移寄存器(0, 8); 移即(1, 10); 汇发("    清零 r2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x31); 发字节(0xD2); 汇发("    除32 ecx\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF7); 发字节(0xF1); /* div ecx: eax = temp/10 */
    移寄存器(8, 0); /* r8 = quotient */
    汇发("    自增 r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0,0,0,1); 发字节(0xFF); 模字节(3, 0, 1); /* inc r9d */
    测寄存器(8, 8); 非零跳(-1); 补标号(码位-4, 全甲, 3); /* temp != 0 -> loop */
    设标号(初寅);
