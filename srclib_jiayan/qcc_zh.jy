                            元素尺寸 = 变量表[变序].数组元素尺寸;
                            前八 = (变量表[变序].指元素尺寸 > 0 && 变量表[变序].数组元素尺寸 > 变量表[变序].指元素尺寸); /* 2D+ 数组: a[i] 是 a 行 (数组), 退化 到 地址 (修复 2026-08-16: secnames[i] 源被当 8 字节值 加载 → 复制内存 源 0) */
                            { 整 内重 = 变量表[变序].指内 ? 变量表[变序].指内 : (变量表[变序].是否字符标 ? 1 : (变量表[变序].是否长标 ? 8 : (变量表[变序].是否浮标 ? 8 : 4))); 长卯 = (变量表[变序].数组元素尺寸 == 8 && !变量表[变序].是否长标 && !变量表[变序].是否浮标 && 变量表[变序].型序标 < 0) ? 内重 : (变量表[变序].指元素尺寸 ? 变量表[变序].指元素尺寸 : (变量表[变序].数组元素尺寸 <= 8 ? 变量表[变序].数组元素尺寸 : 8)); 虚叁 = 变量表[变序].深成 ? 1 : (变量表[变序].是否短标 && !变量表[变序].无符号标 ? 2 : 0); 右亥 = 变量表[变序].无符号标; } /* 元素 字节 尺寸 遍 外层 [j] 毛简一; 修复 2026-08-18: 静态指针数组 (整数 *顺分[8]) 外维 [j] 按指向元素缩放; 修复 2026-08-23 t35j: 指内 优先; 修复 2026-08-29: 虚叁/右亥 元素 有符号/无符号 标记 */
                            /* 地址 遍: 结构体 数组, 2D 行 (元素尺寸>8), 且 2D 行 何处
                               数组元素尺寸 > 元素 尺寸 (字符 缓[4][8]: 元素尺寸=8, 元素=1).
                               8-字节 指针 数组 (字符 *名[3]: 元素尺寸=8, 元素=8) 加载 64-位. */
                            若 (元素尺寸 > 4 && (变量表[变序].型序标 >= 0 || 元素尺寸 > 8 || 变量表[变序].数组元素尺寸 > 变量表[变序].指元素尺寸 || 变量表[变序].指元素尺寸 == 0)) 正玖 = 1;
                            若 (码生成免解引用 && 变量表[变序].数组元素尺寸 == 8 && (变量表[变序].指元素尺寸 > 0 || !变量表[变序].是否长标) && (!变量表[变序].是否浮标 || 变量表[变序].指深 >= 1) && 变量表[变序].型序标 < 0 && !前八 && 变量表[变序].域行数[1] == 0) 码生成内存指 = 1; /* R257 回归修 (2026-09-23): 同 刀4 (静态 路径 同源副本) —— 见 局部 路径 处 长注释 */ /* R255 刀3 (2026-09-23) 虾米: **判据 由「!是否长标 && !是否浮标」改为「指元素尺寸 > 0」** —— 原 两个 否定守卫 的 本意 是「排除 元素 为 长整长整/双精度 **标量** 的 数组」, 但 它们 连 「元素 是 **指向** 长整长整/双精度 的 **指针**」也 一起 排除了 —— 因为 文件级 数组 分支 的 `若 (虚细) 是否长标 = 1` / `若 (双回||单回) 是否浮标 = 1` 是 **按 声明 中 的 类型词** 置位, 不区分「词 修饰 元素」还是「词 是 指针 的 基类型」⟹ `static 长整长整 *gparr[2];` 的 `是否长标` 被 置 1 ⟹ 守卫 落空 ⟹ **外层 [j] 不 加载 该 8 字节 指针槽** ⟹ 内层 产出 的 `&gparr[i]` 被 直接 当基址 ⟹ `mov rax,[rax]` 读到 的 是 **元素 指针值 本身** (实测 r255al/an: `gparr[1][0]` 得 4370360 = 指针对 33 的地址; 而 `int *gpi[2]` / 局部 `int *lpi[2]` / `double *gpd[2]` 全对 ⟹ 只有 `长整长整 *` 元素 暴露, 因为 double 版 被 `是否浮标` 挡掉 后 走 **浮点通道** 侥幸 正确 —— 同一 缺陷 的 两面). 新 判据 `数组元素尺寸 == 8 && 指元素尺寸 > 0` 恰好 表达「元素 是 8 字节 指针」: 指针数组 ✓ 命中 (指元 4 或 8), 标量数组 (指元 0) ✗ 不变, 2D 数组 由 `域行数[1] == 0` 守住. */ /* 静态指针数组元素 (整数 *顺分[8]): 嵌套 基 返回槽地址, 外层 [j] 先加载指针 (修复 2026-08-18: 原缺 → 第二维索引进指针数组槽本身, 自举 代码生成-坏; 修复 步二十六: !前八 — 整数 M2D[2][2] 的 数组元素尺寸=8 是行大小非指针数组, 原误判 → 外层 移动 (%堆九),%堆九 读行内容当指针 → 2D 数组写地址=4 崩; 修复 2026-08-30 生成器 t5: +域行数[1]==0 排除 2D 内维=1 指针数组 (g_135[2][1] 数组元素尺寸==指元素尺寸==8 → 前八 失效 → 误解引用写穿 空, 串值二)) */
                            码生成内存浮 = (浮名(变名)) ? 1 : 0; /* 静态 双精度 数组 基 → 外层 [i] 双精度移动 */
                    码生成内存单 = (变量表[变序].单标 && 变量表[变序].数组尺寸 > 0) ? 1 : 0; /* R4a-6: 静态 float 数组基 */
                            中系 = 1; 遍 (整 栈庚 = 0; 栈庚 < 4; 栈庚++) 上薄[栈庚] = 变量表[变序].域行数[栈庚]; /* 每-维度 行: 静态 数组 亦 (修复 2026-08-05: 剩余 fdepth/域行数 polluted 嵌套 字段-数组 毛简一) */
                            标拾 = 1; 遍 (整 栈庚 = 0; 栈庚 < 4; 栈庚++) 若 (变量表[变序].域行数[栈庚] > 0) 标拾 = 栈庚 + 1; /* 维度 计数 */
                            断;
                        }
                    移寄存器(11, 0); /* r11d = 索引 */
                    若 (元素尺寸 == 2) { 汇发("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(1); }
                    否 若 (元素尺寸 == 4) { 汇发("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(2); }
                    否 若 (元素尺寸 == 1) { } /* 1 字节行宽不缩放 */
                    否 { 移即(0, 元素尺寸); 移寄存器(9, 0); 汇发("    乘 r11, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 1, 0, 1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 3, 1); } /* 乘 r11d, r9d — 修复 2026-08-29 生成器: 元素尺寸=3 (八位整数 2D 行宽) 原不匹配 2/4/>4 不缩放 → g[1] 偏移 1 应 3 (2D 八位整数 数组寻址错, s137/ginit2d) */
                    度一(静态位移(偏移, 1) - 1); /* 堆九 = &静态[0] (取址 是 7 字节: 主升 assumes 6) */
                    符号扩展r11(); /* 32 位索引符号扩展 (修复 2026-08-19: 负索引零扩展 → 指针+4旁败 → 段错误) */
                汇发("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 1, 0, 0); 发字节(0x01); 模字节(3, 3, 0); /* 加 堆九, 后辰 */
                    若 (!码生成免解引用) {
                        若 (变量表[变序].指深 >= 1 && 元素尺寸 == 8 && 计双 == 0) { 移寄存器内存64(0, 0); 节长标[数] = 1; } 否 若 (变量是否浮(变名)) { 若 (变量表[变序].单标) { 发字节(0xF3); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); 发字节(0xF3); 发字节(0x0F); 发字节(0x5A); 发字节(0xC0); } 否 { 汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); } } /* R4a-5: 静态 float 数组元素 movss+cvt (单标); double movsd — 双精度 数组 元素 → xmm0 (非 函数指 数组) */
                        否 若 (前八) { /* 2D+ 行: leave 地址 (C 退化) — don't 解引用 该 行 字节 (修复 2026-08-16) */ }
                        否 若 (正玖) { /* 地址 模式 遍 成员 访问 */
                            若 (元素尺寸 <= 8) { 若 (元素尺寸 == 8) { 移寄存器内存64(0, 0); } 否 { 移寄存器内存(0, 0); } } /* 修复 2026-08-06: ≤8 字节 结构体 元素作值 → 解引用 (原留地址 → x = 数组[1] 存地址 4207368) */
                        } 否 若 (元素尺寸 == 1) { 若 (虚叁 == 1) { 汇发("    符号扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBE); 模字节(0, 0, 0); 若 (节点长性(数, -1)) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } } 否 { 汇发("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 0); } 若 (右亥) 节无符号[数] = 1; } /* 2026-09-04 虾米: 静态 i8 数组元素 ll上下文 movsxd */ /* 修复 2026-08-29 生成器: int8_t 静态数组元素符号扩展 (虚叁); 修复 2026-08-30 生成器 t5: +节无符号 传播 (uint8 数组元素传 六十四位无符号 参数零扩展) */
                        否 若 (元素尺寸 == 8) { 移寄存器内存64(0, 0); 节长标[数] = 1; 若 (右亥) 节无符号[数] = 1; } /* 字符* / 指针 元素: 64-位 — 修复 2026-08-30 生成器 t5: 补 节长标 (1D 静态数组 64 位元素原不设 → 传 六十四位无符号 参数被 扩32 符号扩展64 截断, s25/s31/s32) */
                        否 若 (元素尺寸 == 2) { 若 (虚叁 == 2) { 汇发("    符号扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xBF); 模字节(0, 0, 0); 若 (节点长性(数, -1)) { 汇发("    符号扩展 r0, r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x63); 模字节(3, 0, 0); } } 否 { 汇发("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB7); 模字节(0, 0, 0); } 若 (右亥) 节无符号[数] = 1; } /* 2026-09-04 虾米: 静态 i16 数组元素 ll上下文 movsxd */ /* 修复 2026-08-29 生成器: int16_t 静态数组元素符号扩展; 修复 2026-08-30: +节无符号 */
                        否 { 移寄存器内存(0, 0); 若 (右亥) 节无符号[数] = 1; } /* 修复 2026-08-30 生成器 t5: 1D 静态数组 uint 元素 节无符号 (s17/s22/s28/s35 传 六十四位无符号 参数被 符号扩展64 符号扩展) */
                    }
                    堆己 = 1;
                }
            } 否 {
                /* 指针 参数 数组[i] 或 泛型 基 (地址-的 / 转型 表达式):
                   索引 在 后辰 (r9 可能 是 该 参数 寄存器).
                   修复 2026-08-09: (&缓[0])[2] 已崩 — a 节点-11 基 fell 入
                   取参值("") → 垃圾 指针. 泛型 基: 码生成 该 基 到 get
                   其 地址, 元素 尺寸 自 指元素 (转型) 或 长卯 (集 由
                   该 地址-的 子's 例-14 码生成). */
                整 存粗 = (节型表[子0[数]] == 11 || 变名[0] == 0);
                整 满寅 = 4;
                若 (存粗) {
                    /* 元素 尺寸 自 该 地址-的 子 (修复 2026-08-09:
                       长卯 是 指元素尺寸-based → 4 遍 字符 数组; 变量元素 是 右) */
                    若 (节型表[子0[数]] == 11) {
                        整 原回 = 子0[子0[数]];
                        若 (节型别[原回] == 节点_下标) 满寅 = 变量元素((字*)(节名表 + 子0[原回])); /* &数组[i]: 元素 = 数组's 数组元素尺寸 */
                        否 若 (节型别[原回] == 节点_变量) 满寅 = 变量元素((字*)(节名表 + 原回)); /* &变量 */
                        否 满寅 = 长卯 ? 长卯 : 4;
                        整 源九 = 码生成免解引用; 码生成(子0[数]); 码生成免解引用 = 源九; /* 例 11 破坏 该 标志; 恢复 (修复 2026-08-09: 存储 路径 wrote 到 该 值 非 该 地址) */
                        压栈寄存器(0);
                    } 否 {
                        /* 先 码生成 基址 (例-12 解引用设 长卯=元素宽度), 再取 满寅 (修复 2026-08-20:
                           原先读陈旧 长卯 → (*整劣)[1] 缩放 4 + 4字节加载 → 取到 0 → strchr(空) 版本库 -c 崩) */
                        整 源九 = 码生成免解引用; 码生成(子0[数]); 码生成免解引用 = 源九;
                        满寅 = 长卯 ? 长卯 : 4;
                        压栈寄存器(0);
                    }
                }
                否 满寅 = 变量元素(变名);
                { 整 值回 = 码生成免解引用; 码生成免解引用 = 0; 码生成(子1[数]); 码生成免解引用 = 值回; } /* 索引 → 首子 */
                移寄存器(11, 0); /* r11d = 索引 */
                若 (满寅 == 4) { 汇发("    左移 r11, 2\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(2); }
                否 若 (满寅 == 2) { 汇发("    左移 r11, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 0, 0, 1); 发字节(0xC1); 模字节(3, 4, 3); 发字节(1); }
                否 若 (满寅 > 4) { 移即(0, 满寅); 移寄存器(9, 0); 汇发("    乘 r11, r9\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(0, 1, 0, 1); 发字节(0x0F); 发字节(0xAF); 模字节(3, 3, 1); } /* 乘 r11d, r9d */
                若 (存粗) { 弹栈寄存器(0); } /* 堆九 = 基 地址 (已存) */
                否 取参值(变名); /* 首子 = 指针 (寄存器 或 [rbp+位移]) */
                符号扩展r11(); /* 32 位索引符号扩展 (修复 2026-08-19: 负索引零扩展 → 指针+4旁败 → 段错误) */
                汇发("    加64 r0, r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 1, 0, 0); 发字节(0x01); 模字节(3, 3, 0); /* 加 堆九, 后辰 */
                若 (!码生成免解引用) {
                    若 (变量指浮(变名)) { 若 (变量指单(变名)) { 发字节(0xF3); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); 发字节(0xF3); 发字节(0x0F); 发字节(0x5A); 发字节(0xC0); } 否 { 汇发("    浮取 xmm0, [r0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0xF2); 发字节(0x0F); 发字节(0x10); 模字节(0,0,0); } } /* R4a-6-3: float* 参数 元素 movss+cvt / double* movsd */
                    否 若 (满寅 == 1) { 汇发("    零扩展 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB6); 模字节(0, 0, 0); } /* 零扩展 首子,字节[堆九] */
                    否 若 (满寅 > 4) { 移寄存器内存64(0, 0); }         /* 移动 堆九,[堆九] (字符** ?指针 / 结构体*) */
                    否 若 (满寅 == 2) { 汇发("    零扩展字 eax, [rax]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x0F); 发字节(0xB7); 模字节(0, 0, 0); } /* 零扩展 首子, 字 [堆九] 修复 2026-08-08 */
                    否 { 移寄存器内存(0, 0); } /* 移动 首子, [堆九] */
                }
            }
        } 断;
    }
}
/* 字符串 */
/* 字符串 数据 */
静 无 字 *全伴; 静 整 反高, 下退;

静 整 目甲[1024]; /* 字节 偏移 的 每 双精度 字面量 在 全伴; -1 = 非 列细 */
静 整 标劣(整 序标) {
    若 (目甲[序标] >= 0) 返 目甲[序标];
    循环 (反高 % 8 != 0) { 若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); } 全伴[反高++] = 0; }
    目甲[序标] = 反高;
    整 链劣 = 逆组[序标], 度附 = 现退[序标];
    遍 (整 键 = 0; 键 < 4; 键++) { 若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); } 全伴[反高++] = (无 字)((链劣 >> (8 * 键)) & 0xff); }
    遍 (整 键 = 0; 键 < 4; 键++) { 若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); } 全伴[反高++] = (无 字)((度附 >> (8 * 键)) & 0xff); }
    返 目甲[序标];
}

静 整 外陆一(整 序标) {
    若 (邻拾[序标] >= 0) 返 邻拾[序标];
    邻拾[序标] = 反高;
    常 字 *串值 = 串表[序标];
    循环 (*串值) { 若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); } 全伴[反高++] = (无 字)*串值++; }
    若 (反高 >= 下退 - 4) { 下退 += 256; 全伴 = 重分配(全伴, 下退); }
    全伴[反高++] = 0; /* 空字符 终止符 */
    返 邻拾[序标];
}
静 空 写四(FILE *文件, 整 值) { 写字符(值 & 0xff, 文件); 写字符((值 >> 8) & 0xff, 文件); 写字符((值 >> 16) & 0xff, 文件); 写字符((值 >> 24) & 0xff, 文件); }
静 空 串丙(FILE *文件, 整 值) { 写四(文件, 值); 写四(文件, 0); } /* 64-位 写入: 高 字 总是 0. 该 自身-宿主 已 无 真 长整 长整; `v >> 32` 于 a 32-位 值 掩码 该 移位 计数 到 0 且 re-写入 v, 故 全 串丙 callers 通过 <4旁败 值. */
静 空 下布(FILE *文件, 整 值) { 写字符(值 & 0xff, 文件); 写字符((值 >> 8) & 0xff, 文件); }
静 空 容吉(FILE *文件, 整 数) { 循环 (数-- > 0) 写字符(0, 文件); }

/* 修复 2026-08-12: 分块写零替代逐字节 写字符 — 自宿主的 写字符 内置 每字节一次 WriteFile
   系统调用, 52兆字节 .数据 填充 85s; 写入 整块写 → 4素繁 块 ≈ 20ms (快 ~4000 倍). */
静 空 净系(FILE *文件, 整 数) {
    字 旁布[4096]; 内存设置(旁布, 0, 大小(旁布));
    循环 (数 > 0) { 整 字符 = 数 > 4096 ? 4096 : 数; 写入(旁布, 1, 字符, 文件); 数 -= 字符; }
}

/* 修复 2026-08-12 自举收敛 (根因): .数据 覆盖范围必须 ≥ 静态 + 提升 堆 + 自切栈.
   旧公式 最大(码位*84, 0x800000) 只按输出代码量估算 — 自举时 码位*84≈83.7兆字节,
   但 静态 ≈46兆字节 + 提升 堆 ≈42兆字节 (词型表/词值表/词名表/节名表/词无符号表/词长表/段属 34兆字节 + 代码 4兆字节 + 源缓冲 ~1.5兆字节 + 全伴/misc ~3兆字节)
   ≈ 88兆字节 > 83.7兆字节 → 存子一 落进 段属 (短进: 0x52B15D8 = 实低+33.6兆字节, 段属 在 +33.2..+35.2兆字节)
   → 栈帧向下写穿 词元 数组 → 运行时 词长表 垃圾 → 伪 节长标=1 → 628 绝对移动 → 短进≠值二 2-周期.
   新公式: 静态 终点 (名聚 + 4*静态数 + 2560) 之上加 0x4800000
   (堆上限 0x4000000=64兆字节 + 栈余量 0x800000=8兆字节; 实测栈深 ≥2兆字节, 递归 解析/码生成器 取 8兆字节),
   修复 2026-08-13: 44兆字节 不够 — 编译 修订.c (版本库) 时 提升 堆实测 55.2兆字节 (词元 35兆字节
   + 源/宏展开缓冲 ~15兆字节 + 符挂 出 1.5兆字节), 越界 ~2兆字节 写穿栈帧 → 实退一 局部 s
   被覆盖 → 0xC0000005. 提到 64兆字节 留 ~9兆字节 余量,
   与 码位*84 取大者 — 小程序的 8兆字节 地板不变. */
静 整 上利(空) {
    整 终 = 码位 * 84 > 0x800000 ? 码位 * 84 : 0x800000;
    /* 修复 2026-08-16 别名.c: 提升 堆 所需 0x490626D (> 0x4800000) 循环
       expanding 函-宏 实参, 故 该 计数器 walked 已过 该 image 结束 且 该
       very 下一 字节 存储 faulted (0xC0000005). Give 该 共享 堆+栈
       region 128MiB 而 的 72MiB. */
    /* 修复 2026-08-16 根因E 属性.c: 函-宏 展开实测把 提升 堆推到 165MiB+136MiB≈300MiB,
       超 128MiB 预算 → 计数器 越过 堆 终点+image 末尾 (0x11E98000) → 内存分配 指针越界写崩。
       预算 128→192MiB 留余量 (属性.c 需 ~136MiB)。image 相应增大 (短进 ~+64兆字节)。 */
    /* 修复 2026-08-16 根因E 属性.c: 函-宏 展开实测把 提升 堆推到 165MiB+136MiB≈300MiB,
       超 128MiB 预算 → 计数器 越过 堆 终点+image 末尾 (0x11E98000) → 内存分配 指针越界写崩。
       预算 128→192MiB 留余量 (属性.c 需 ~136MiB)。image 相应增大 (短进 ~+64兆字节)。 */
    /* 修复 2026-08-17 块-sha1/sha1.c: 80 轮宏展开 (SHA_ROUND×80) 全量展开需 >192MiB
       (踩坑库: sha1.c 编译需 214兆字节 堆) → 计数器 走穿镜像尾 → 出 指针越界写崩。
       预算 192→256MiB (0xC000000→0x10000000)。 */
    /* 修复 2026-08-27 步七 (短进.2 §二B): 串表 分块动态化后 静态数 不再含 384兆字节 静态
       串表 (4 亿槽), 总伴 从 ~658兆字节 跌到 ~257兆字节 → 自举新编译器运行时 存子一
       过低, 自切栈区与 提升 堆/代码 缓冲 重叠 → 编 编译器 自身 段错误 (0x5f1937 跳栈区).
       预算 256→512MiB (0x10000000→0x20000000) 恢复 存子一 高位, 与布局解耦. */
    整 总伴 = 名聚 + 4 * 静态数 + 2560 + 0x20000000;
    返 终 > 总伴 ? 终 : 总伴;
}

静 空 调试生成(空); /* fwd: 定义在 空伴 前 (实三 调用于此) */
静 空 实三(FILE *文件, 整 内九) {
    若 (调试开关) { 调试生成(); }
    整 调存[3]; /* #289: debug 节 raw 指针 (节头写入时填充, 数据写入时定位) */
    整 隔简一 = 0x1000, 代码尺寸 = ((码位 + 4095) & ~4095);
    若 (代码尺寸 < 512) 代码尺寸 = 512;
    /* 修复 2026-08-03: 该 前巳一 加载器 拒绝 a 可执行格式 whose .文本 结束 做 非
       abut .数据 (非法可执行格式 193). 数据基址 是 sized 自 通过-1
       码位, 哪 可 轮 一 页 已过 该 通过-2 最终 码位 -> a 0x1000 hole.
       Make .文本 总是 结束 exactly 何处 .数据 开始. */
    整 逆厚一 = 数据基址 - 隔简一;
    若 (代码尺寸 < 逆厚一) 代码尺寸 = 逆厚一;
    整 顺再 = 调试开关 ? 0x400 : 单亥; /* #289: 5 节头超 0x200, .text 偏移需加大 */
    整 源组 = 数据基址; /* dynamic .数据 基 (文本 可能 exceed 4素繁) */
    整 缓粗 = (上利() + 0x100000 + 4095) & ~4095; /* 修复 2026-08-12: 随 范围 动态 — 自举 存子一≈97兆字节 超旧固定 96兆字节; +1兆字节 余量, 覆盖栈底之下 */
    若 (缓粗 < 0x6000000) 缓粗 = 0x6000000; /* 保持旧 96兆字节 地板 (修复 2026-08-11: 串表 2048 后 静态 46兆字节 + 提升 43兆字节 ≈ 89兆字节 > 80兆字节 → 扩容到 96兆字节) */
    整 全癸 = 源组 + 缓粗 + 0x1000; /* 映像尺寸 */

    /* DOS 头 (64 字节) */
    写字符('M', 文件); 写字符('Z', 文件); 容吉(文件, 58);
    写四(文件, 64); /* e_lfanew = 64 */

    /* 可执行格式 签名 */
    写字符('P', 文件); 写字符('E', 文件); 写字符(0, 文件); 写字符(0, 文件);

    /* 目标文件 头 (20 字节) */
    下布(文件, 0x8664);  /* 机器: x86-64 */
    下布(文件, 调试开关 ? 5 : 2);       /* NumberOfSections */
    写四(文件, 0);       /* TimeDateStamp */
    写四(文件, 0);       /* PointerToSymbolTable (#289: 调试时末尾回填) */
    写四(文件, 调试开关 ? 4 : 0); /* NumberOfSymbols (#289: 3 节符号 + 1 文件符号) */
    下布(文件, 0xF0);    /* SizeOfOptionalHeader = 240 (PE32+ 带 16 数据 dirs) */
    下布(文件, 调试开关 ? 0x2E : 0x22E);   /* Characteristics: -g 去掉 DEBUG_STRIPPED(0x200) (与 debug 节矛盾 → 加载拒绝) */

    /* 可选 头 PE32+ (112 字节 + 16*8 数据 dirs = 240) */
    下布(文件, 0x020B);  /* Magic: PE32+ */
    写字符(0, 文件); 写字符(0, 文件); /* LinkerVersion */
    写四(文件, 代码尺寸); /* SizeOfCode */
    写四(文件, 8);       /* SizeOfInitializedData �?堆 计数器 */
    写四(文件, 0);       /* SizeOfUninitializedData */
    写四(文件, 内九); /* AddressOfEntryPoint */
    写四(文件, 隔简一);  /* BaseOfCode */
    串丙(文件, 号己); /* ImageBase �?低 地址 遍 32-位 指针 */
    写四(文件, 0x1000);  /* SectionAlignment */
    写四(文件, 单亥);   /* FileAlignment */
    下布(文件, 6); 下布(文件, 0); /* OSVersion */
    下布(文件, 0); 下布(文件, 0); /* ImageVersion */
    下布(文件, 6); 下布(文件, 0); /* SubsystemVersion */
    写四(文件, 0);       /* Win32VersionValue */
    { 整 调虚 = 调试开关 ? ((调试缓冲位 + 0xfff) & ~0xfff) : 0;
      若 (调虚 > 0) 全癸 += 调虚 + 0x3000; } /* #289: 映像尺寸含 .debug 节 (3 节 VA 对齐损失 ≤2 页, 冗余 0x3000) */
    写四(文件, 全癸); /* 映像尺寸 */
    写四(文件, 调试开关 ? 0x400 : 单亥);   /* SizeOfHeaders */
    写四(文件, 0);       /* 校验和 */
    下布(文件, 3);       /* Subsystem: CONSOLE */
    下布(文件, 0x8100);  /* DllCharacteristics: 顺分 + TERMINAL_SERVER_AWARE (无 DYNAMIC_BASE) */
    串丙(文件, 0x400000); /* SizeOfStackReserve — 自举递归需>64素繁; 必须>=StackCommit (丙序 前巳一-latest 严格校验) */
    串丙(文件, 0x400000); /* SizeOfStackCommit */
    串丙(文件, 0x100000); /* SizeOfHeapReserve */
    串丙(文件, 0x1000);   /* SizeOfHeapCommit */
    写四(文件, 0);       /* LoaderFlags */
    写四(文件, 16);      /* NumberOfRvaAndSizes */
    /* 数据 目录 0: 导出 (none) */
    写四(文件, 0); 写四(文件, 0);
    /* 数据 目录 1: 导入 表 (内核库) */
    写四(文件, 数据基址 + 0x7E8); 写四(文件, 60); /* 首重 的 导入 descriptors + 尺寸 (2026-08-28 阶段一 #246: 主回@+0x4E8 内核库 17 槽; A30: msvcrt 59→60 槽 → 源六 0x4E8→0x4F8) */
    /* 数据 directories 2-15: none */
    遍 (整 丁序 = 2; 丁序 < 16; 丁序++) { 写四(文件, 0); 写四(文件, 0); }

    /* 节 头 (40 字节) */
    写入(".text", 1, 5, 文件); 容吉(文件, 3); /* 8-字节 节 名 ".文本\0\0\0" — 分裂 写入: 该 \0 escape 是 已丢 由 外陆一 (循环(*s) stops 于 该 embedded 空), 故 a 单 8-字节 字面量 将 是 已截断 (修复 2026-08-03) */
    写四(文件, 代码尺寸);  /* 虚拟尺寸 */
    写四(文件, 隔简一);   /* VirtualAddress */
    写四(文件, 代码尺寸);  /* 原始数据尺寸 */
    写四(文件, 顺再);  /* PointerToRawData */
    写四(文件, 0);          /* 重定位指针 */
    写四(文件, 0);          /* PointerToLinenumbers */
    下布(文件, 0);          /* NumberOfRelocations */
    下布(文件, 0);          /* NumberOfLinenumbers */
    写四(文件, 0x60000020); /* .文本: 代码 + 执行 + 读取 */

    /* .数据 节 头 */
    整 元丙 = 顺再 + 代码尺寸; /* 必须 follow .文本 �?曾 0x400, 哪 重叠 代码 �?12B */
    写入(".data", 1, 5, 文件); 容吉(文件, 3); /* ".数据\0\0\0" — 分裂 写入 (见 .文本 注意) */
    写四(文件, 缓粗);  /* 虚拟尺寸 �?80兆字节: 静态 + 提升 堆 */
    写四(文件, 源组);    /* VirtualAddress */
    写四(文件, 首厚一);  /* 原始数据尺寸 — BSS分离: 只写导入表+堆 计数器, 堆/栈由 加载器 清零 (修复 2026-08-25) */
    写四(文件, 元丙);   /* PointerToRawData */
    写四(文件, 0); 写四(文件, 0); 下布(文件, 0); 下布(文件, 0);
    写四(文件, 0xC0000040);  /* 已初始化 数据 + 读取 + 写入 */

    若 (调试开关) { /* #289 DWARF: 3 个调试节 (数据段虚拟区后, 文件末尾) */
        { 常 字 *调名[3] = { "/4", "/18", "/30" }; /* #289 长节名: 指向符号表后字符串表偏移 (BFD 标准节名) */
          整 调虚址 = (源组 + 缓粗 + 0xfff) & ~0xfff;  /* VA 必须 0x1000 对齐 (PE 加载器硬校验, 2026-09-01 修复) */
          整 调数据 = (元丙 + 首厚一 + 0x1ff) & ~0x1ff; /* raw 指针必须 0x200 对齐 (FileAlignment 硬校验) */
          整 调尺寸[3]; 调尺寸[0] = 调试节abbrev尺寸; 调尺寸[1] = 调试节info尺寸; 调尺寸[2] = 调试节line尺寸;
          遍 (整 调计 = 0; 调计 < 3; 调计++) {
              若 (调尺寸[调计] <= 0) 调尺寸[调计] = 1;
              调存[调计] = 调数据; /* 记录 raw 指针 (写入数据时定位用) */
              写入(调名[调计], 1, 取字长(调名[调计]), 文件); 容吉(文件, 8 - 取字长(调名[调计])); /* 节名足 8 字节 */
              写四(文件, 调尺寸[调计]);                          /* VirtualSize = 实际尺寸 */
              写四(文件, 调虚址);                                 /* VA 0x1000 对齐 */
              写四(文件, (调尺寸[调计] + 0x1ff) & ~0x1ff);       /* SizeOfRawData 0x200 对齐 */
              写四(文件, 调数据);                                 /* PointerToRawData 0x200 对齐 */
              写四(文件, 0); 写四(文件, 0); 下布(文件, 0); 下布(文件, 0);
              写四(文件, 0x42000040); /* DISCARDABLE + READONLY + INITIALIZED_DATA (BFD 拒 NOT_CACHED 0x04000000, 2026-09-01 修复) */
              调虚址 += (调尺寸[调计] + 0xfff) & ~0xfff;          /* 每节独占页, VA 保持对齐 */
              调数据 += (调尺寸[调计] + 0x1ff) & ~0x1ff;          /* 下一节 raw 0x200 对齐 */
          } }
    }

    /* 填充 到 文本 文件 偏移 */
    整 位 = (整)取文件位置(文件);
    循环 (位 < 顺再) { 写字符(0, 文件); 位++; }

    /* 写入 .文本 */
    写入(码, 1, 码位, 文件);

    /* 填充 节 到 度肆 尺寸 */
    整 终一 = 顺再 + 代码尺寸;
    位 = (整)取文件位置(文件);
    循环 (位 < 终一) { 写字符(0, 文件); 位++; }

    /* .数据 节: 写入 堆 计数器, 则 导入 表
       布局（修复 2026-08-06 缺陷-1）：每个 DLL 的 导入表/ILT 独立且以 0 终止
       双四@+0x08 (8 内核库 + term=72B) 总升@+0x50 (59 msvcrt + term=480B)
       长伍@+0x230 (9*8B=72B) 号吉@+0x278 (60*8B=480B) 主回@+0x458 (3*20=60B) 名@+0x4B0
       (修复 2026-08-19: 总升 16→17; math21: 17→22; math24: 22→25; 步五: 25→34; 步八: 34→46; 步九: 46→54; 步十: 54→59 加 strcoll/strxfrm/拼前n/拷贝前n/strtod; ILT thunk 8B 按 PE64 计) */
    定位文件(文件, 元丙, 号汇);
    整 实低 = 号己 + 源组 + 名聚 + 4 * 静态数 + 2560; /* 整劣[64]+词元 则 堆 */
    实低 = (实低 + 7) & ~7; /* 修复 2026-08-12 阻塞-3: 提升 堆 基 8-字节 已对齐 — 布局变化 (数据基址/__pad0 尺寸) 不得影响堆对齐 (词长表[词位] 错位读 → 伪 节长标=1 → 2-周期) */
    写四(文件, 实低); /* 堆 计数器 已初始化 */
    写四(文件, 0);          /* 填充 */
        静 常 字 *主亥[64] = { 
"GetStdHandle", 
"WriteFile", 
"CreateFileA", 
"ReadFile", 
"VirtualAlloc", 
"SetFilePointer", 
"ExitProcess", 
"GetCommandLineA",
        
"CreateThread", 
"WaitForSingleObject", 
"CloseHandle", 
"CreateFiber", 
"SwitchToFiber", 
"DeleteFiber", 
"ConvertThreadToFiber", 
"LoadLibraryA",
        
"GetProcAddress", 
"GetLastError", 
"SetLastError", 
"GetModuleHandleA", 
"GetModuleFileNameA", 
"GetModuleFileNameW", 
"FreeLibrary", 
"LoadLibraryW",
        
"LoadLibraryExA", 
"FormatMessageA", 
"WideCharToMultiByte", 
"MultiByteToWideChar", 
"GetFileAttributesA", 
"GetFileAttributesW", 
"GetFileAttributesExA", 
"GetFileAttributesExW",
        
"SetFileAttributesW", 
"CreateFileW", 
"DeleteFileW", 
"FindFirstFileW", 
"FindNextFileW", 
"FindClose", 
"GetFileType", 
"GetFileInformationByHandle",
        
"SetFileTime", 
"GetLongPathNameW", 
"GetFullPathNameW", 
"GetFinalPathNameByHandleW", 
"GetEnvironmentStringsW", 
"FreeEnvironmentStringsW", 
"GetEnvironmentVariableW", 
"SetEnvironmentVariableW",
        
"Sleep", 
"GetSystemTimeAsFileTime", 
"GetProcessHeap", 
"HeapAlloc", 
"HeapFree", 
"CreateProcessW", 
"OpenProcess", 
"TerminateProcess",
        
"GetCurrentProcessId", 
"GetVersion", 
"SetConsoleCtrlHandler", 
"GetHandleInformation", 
"CreatePipe", 
"PeekNamedPipe", 
"GetNamedPipeInfo", 
"InitializeProcThreadAttributeList" }; /* 2026-08-28 类型-根-15 #41: +CreateFiber/切换纤程/DeleteFiber/ConvertThreadToFiber; 2026-08-28 阶段一 #246: +LoadLibraryA/GetProcAddress (动态库加载, 15→17 槽) */
    静 常 字 *栈降[60] = { "pow", "atan2", "fmod", "sqrt", "cos", "sin", "tan", "acos", "asin", "atan", "log", "log10", "exp", "floor", "ceil", "fabs", "cosh", "sinh", "tanh", "_copysign", "_hypot", "frexp", "ldexp", "modf", "_write", "_time64", "difftime", "_localtime64", "_gmtime64", "_mktime64", "strftime", "clock", "asctime", "ctime", "strtok", "strrchr", "strnlen", "strpbrk", "memcmp", "toupper", "isalnum", "isxdigit", "isspace", "rand", "srand", "abs", "islower", "isupper", "iscntrl", "isgraph", "isprint", "ispunct", "labs", "atof", "strcoll", "strxfrm", "strncat", "strncpy", "strtod", "getenv" }; /* A30 (2026-09-11): +getenv (msvcrt 槽 76 = 栈降[59]) */
    整 双四 = 0x08, 总升 = 0x210, 长伍 = 0x3F8, 号吉 = 0x600, 源六 = 0x7E8, 名偏 = 0x824; /* 2026-08-28 阶段一 #246: 内核库 15→17 槽 (18*8=144=0x90); A30: msvcrt 59→60 槽 — 双四@0x08(144B→0x98), 总升@0x98(488B→0x280), 长伍@0x280(144B→0x310), 号吉@0x310(488B→0x4F8), 主回@0x4F8(60B→0x534), 名@0x534 (至 ~0x8E7 < 名聚 0x900) */
    整 数偏[124];
    /* 导入表/ILT 占位 */
    定位文件(文件, 元丙 + 双四, 号汇); 遍 (整 计 = 0; 计 < 65; 计++) 串丙(文件, 0);
    定位文件(文件, 元丙 + 总升, 号汇); 遍 (整 计 = 0; 计 < 61; 计++) 串丙(文件, 0);
    定位文件(文件, 元丙 + 长伍, 号汇); 遍 (整 计 = 0; 计 < 65; 计++) 串丙(文件, 0);
    定位文件(文件, 元丙 + 号吉, 号汇); 遍 (整 计 = 0; 计 < 61; 计++) 串丙(文件, 0);
    /* 名（提示 2B + 名 + \0） */
    定位文件(文件, 元丙 + 名偏, 号汇);
    遍 (整 计 = 0; 计 < 64; 计++) { 数偏[计] = (整)取文件位置(文件) - 元丙; 下布(文件, 0); 写行(主亥[计], 文件); 写字符(0, 文件); }
    遍 (整 计 = 0; 计 < 60; 计++) { 数偏[64 + 计] = (整)取文件位置(文件) - 元丙; 下布(文件, 0); 写行(栈降[计], 文件); 写字符(0, 文件); }
    整 短甲 = (整)取文件位置(文件) - 元丙; 写行("kernel32.dll", 文件); 写字符(0, 文件);
    整 深辛 = (整)取文件位置(文件) - 元丙; 写行("msvcrt.dll", 文件); 写字符(0, 文件);
    /* 回填 双四（17 + term） */
    定位文件(文件, 元丙 + 双四, 号汇);
    遍 (整 计 = 0; 计 < 64; 计++) 串丙(文件, 数据基址 + 数偏[计]);
    串丙(文件, 0);
    /* 回填 总升（60 + term） */
    定位文件(文件, 元丙 + 总升, 号汇);
    遍 (整 计 = 0; 计 < 60; 计++) 串丙(文件, 数据基址 + 数偏[64 + 计]);
    串丙(文件, 0);
    /* 回填 长伍/号吉 */
    定位文件(文件, 元丙 + 长伍, 号汇);
    遍 (整 计 = 0; 计 < 64; 计++) 串丙(文件, 数据基址 + 数偏[计]);
    串丙(文件, 0);
    定位文件(文件, 元丙 + 号吉, 号汇);
    遍 (整 计 = 0; 计 < 60; 计++) 串丙(文件, 数据基址 + 数偏[64 + 计]);
    串丙(文件, 0);
    /* 导入 descriptors: 内核库 (双四/长伍), msvcrt (总升/号吉) */
    定位文件(文件, 元丙 + 源六, 号汇);
    写四(文件, 数据基址 + 长伍);  /* 内核库 OriginalFirstThunk */
    写四(文件, 0); 写四(文件, 0);
    写四(文件, 数据基址 + 短甲);  /* 名 */
    写四(文件, 数据基址 + 双四);  /* FirstThunk */
    写四(文件, 数据基址 + 号吉);  /* msvcrt OriginalFirstThunk */
    写四(文件, 0); 写四(文件, 0);
    写四(文件, 数据基址 + 深辛);  /* 名 */
    写四(文件, 数据基址 + 总升);  /* FirstThunk */
    遍 (整 丁序 = 0; 丁序 < 5; 丁序++) 写四(文件, 0); /* 终止符 descriptor */
    /* 填充 .数据 到 度肆 尺寸 */
    定位文件(文件, 元丙 + 名聚, 号汇);
    位 = (整)取文件位置(文件);
    整 数据终 = 元丙 + 首厚一; /* BSS分离: 只写导入表+堆 计数器 (修复 2026-08-25) */
    净系(文件, 数据终 - 位); /* 修复 2026-08-12: 原逐字节 写字符, 自宿主 52兆字节 填充 85s → 分块 写入 */
    若 (调试开关 && 调试缓冲位 > 0) { /* #289: 写调试数据到文件末尾 (按节定位到 调存[调计], raw 指针已 0x200 对齐) */
        { 整 调散 = 调试节abbrev起;
          整 调终 = 调散 + 调试节abbrev尺寸;
          定位文件(文件, 调存[0], 号汇);
          循环 (调散 < 调终) { 写字符(调试缓冲[调散], 文件); 调散++; } }
        { 整 调散 = 调试节info起;
          整 调终 = 调散 + 调试节info尺寸;
          定位文件(文件, 调存[1], 号汇);
          循环 (调散 < 调终) { 写字符(调试缓冲[调散], 文件); 调散++; } }
        { 整 调散 = 调试节line起;
          整 调终 = 调散 + 调试节line尺寸;
          定位文件(文件, 调存[2], 号汇);
          循环 (调散 < 调终) { 写字符(调试缓冲[调散], 文件); 调散++; } }
        /* 文件末尾填充: 最后一节 SizeOfRawData 已 0x200 对齐, 数据只写实际尺寸 (0xC1 修复) */
        { 整 调尾 = 调存[2] + ((调试节line尺寸 + 0x1ff) & ~0x1ff);
          整 调位 = (整)取文件位置(文件);
          循环 (调位 < 调尾) { 写字符(0, 文件); 调位++; } }
    }
    若 (调试开关) { /* #289 长节名: COFF 符号表 + 字符串表 (gdb/BFD 需要标准 .debug_* 节名) */
        { 整 符号起 = (整)取文件位置(文件);
          { 常 字 *符号名[3] = { ".debug_abbrev", ".debug_info", ".debug_line" };
            遍 (整 调计 = 0; 调计 < 3; 调计++) {
                /* COFF 符号 18 字节: Name[8] + Value[4] + Section[2] + Type[2] + SClass[1] + Aux[1] */
                { 整 名长 = 0; 循环 (符号名[调计][名长] && 名长 < 8) 名长++;
                  写入(符号名[调计], 1, 名长, 文件);
                  若 (名长 < 8) 容吉(文件, 8 - 名长); }
                写四(文件, 0); /* Value */
                下布(文件, 调计 + 3); /* SectionNumber: .debug_a=3, .debug_i=4, .debug_l=5 */
                下布(文件, 0); /* Type */
                写字符(3, 文件); /* StorageClass: IMAGE_SYM_CLASS_STATIC */
                写字符(0, 文件); /* NumberOfAuxSymbols */
            } }
          /* 文件符号 (IMAGE_SYM_CLASS_FILE = 103) */
          容吉(文件, 8); 写四(文件, 0); 下布(文件, 0); 下布(文件, 0); 写字符(103, 文件); 写字符(0, 文件);
          /* 字符串表: 4 字节大小 + 3 长节名 */
          写四(文件, 4 + 14 + 12 + 12);
          写入(".debug_abbrev", 1, 13, 文件); 写字符(0, 文件);
          写入(".debug_info", 1, 11, 文件); 写字符(0, 文件);
          写入(".debug_line", 1, 11, 文件); 写字符(0, 文件);
          /* 回填 PE 头 (e_lfanew=64: COFF 头@68, PointerToSymbolTable@+8=76=0x4C, NumberOfSymbols@+12=80=0x50) */
          定位文件(文件, 0x4C, 号汇); 写四(文件, 符号起);
          定位文件(文件, 0x50, 号汇); 下布(文件, 4);
        }
    }
}

/* ?????? ??????????? */
/* 移动 r32, 三十二位立即数 遍 高 寄存器 (r8-r15): 反挂+寄存器 仅 编码 0-7, 故 余散一 扩展前缀.B. */
静 空 移即扩(整 寄存器, 整 立即数) { 汇发("    移动 r%d, %d\n", (字*)(长 长)(寄存器), (字*)(长 长)(立即数), (字*)(长 长)0); 若 (寄存器 & 8) 发字节(0x41); 发字节(0xB8 | (寄存器 & 7)); 发四(立即数); }

/* Mini-运行库 入口 半未 (hand-已发射): GetCommandLineA �?拷贝-词法 整劣 入 a
   静态 .数据 区域 (整劣[64] 于 静态, 词元 字符串 右 之后) �?调用
   主(首合, 整劣) �?ExitProcess.
   寄存器: r10=cmdline 后辰=scan 序标 r12=&整劣[0] r13=&token_area(推进)
   r14=首合 r8=token_start r15=已存 rsp. 每 词元 是 空字符-已终止 在 该 拷贝. */
静 空 序置二(空) {
    整 顺辛 = 号己 + 数据基址 + 名聚 + 4 * 静态数; /* .数据 静态 区域 遍 整劣[64] */
    顺高一 = 码位; /* 入口 点 = 开始 的 此 半未 */
    /* 自切栈：立即�?rsp 切到 .数据 内的高地址区（62兆字节 偏移处），完全脱�?加载器 �?
       （加载器 把主线程栈放在镜�?映像尺寸 内部 ~91.6-92.6兆字节，页面不可靠 �?
       深 解析 帧读 段错误）。固�?62兆字节 偏移：栈向下 1兆字节 仍在 .数据 段内�?
       且高�?堆 终点（~48兆字节）；被编译程序没�?__stack 静态，不能用静态末尾�?*/
    整 存子一 = 号己 + 数据基址 + 上利(); /* 修复 2026-08-12 自举收敛根因: 栈顶必须在 提升 堆终点之上 — 旧 最大(码位*84,8兆字节) 自举时落进 段属 → 栈帧写穿 词元 数组 → 2-周期. 实测 v1g: 存子一=0x52B15D8=实低+33.6兆字节, 段属 在 +33.2..+35.2兆字节. 上利 = statics_end + 堆44兆字节 + 栈8兆字节 */
    移64(3, 4);         /* rbx = rsp (保存 加载器 栈 — 修复 2026-08-17 丙序 根因: Server 2025 ntdll LdrShutdownProcess 清理路径 _chkstk 按 TEB 栈探测, 自切栈 rsp 脱离 TEB → 段错误; 退出前切回 加载器 栈) */
    移即扩(4, 存子一);     /* 移动 rsp, 存子一 (32位 立即数，零扩展) */
    /* 修复 2026-08-25 步五: TEB 栈边界改为自切栈 — msvcrt _tzset/_setjmpex/_chkstk 按 TEB 栈探测,
       自切栈 rsp 脱离 加载器 栈 → localtime/gmtime 段错误 (_setjmpex: 测试 %r11b,(%后辰)).
       x64 TEB 基址=gs:0, StackBase=TEB+0x08 (高地址), StackLimit=TEB+0x10 (低地址) */
    移即扩(0, 存子一);     /* 堆九 = 存子一 */
    汇发("    改 TEB 栈基\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x65); 发字节(0x48); 发字节(0x89); 发字节(0x04); 发字节(0x25); 发四(0x08); /* 移动 gs:[0x08], 堆九 */
    移即扩(0, 存子一 - 0x1000000); /* 堆九 = 存子一 - 16兆字节 (栈向下预算) */
    汇发("    改 TEB 栈限\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x65); 发字节(0x48); 发字节(0x89); 发字节(0x04); 发字节(0x25); 发四(0x10); /* 移动 gs:[0x10], 堆九 */
    移即扩(12, 顺辛);          /* r12 = &整劣[0] */
    移即扩(13, 顺辛 + 512);    /* r13 = 词元 区域 开始 */
    /* GetCommandLineA() */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
    减栈即(32);
    调导入(7);            /* GetCommandLineA �?堆九 */
    加栈即(32);
    移64(10, 0);        /* r10 = cmdline */
    移即扩(4, 存子一); /* rsp = 存子一 (自切栈顶 — 不用 r15, r15 已让位) */
    移即扩(11, 0);      /* 后辰 = i (scan 序标) */
    移即扩(14, 0);      /* r14 = 首合 */
    移即扩(15, 0);      /* r15 = 在-quote 标志 (修复 2026-08-19: 整劣 tokenizer 引号支持 — 原只按空格分割, 版本库 提交 -m "首 提交" 被拆成 "首 + 提交" → pathspec '提交"' 错) */
    整 目再 = 新标号(), 缺置 = 新标号(), 缺挂 = 新标号(), 满升一 = 新标号(), 首拾一 = 新标号(), 外八 = 新标号(), 段辰 = 新标号(), 素贰 = 新标号(), 主进 = 新标号(), 深组 = 新标号();
    设标号(目再);
    汇发("    零扩展 SIB\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x43); 发字节(0x0F); 发字节(0xB6); 发字节(0x04); 发字节(0x1A);
    移寄存器(1, 0);           /* ecx = c */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 段辰, 1);
    移即(0, 0x20); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 外八, 1); /* 比较 ecx,' ' */
    移即(0, 0x22); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 素贰, 1); /* 比较 ecx,'"' → 引号 词元 起点 */
    移64(8, 13);        /* r8 = token_start (r13) */
    设标号(缺置);
    汇发("    零扩展 SIB\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x43); 发字节(0x0F); 发字节(0xB6); 发字节(0x04); 发字节(0x1A); /* 零扩展 首子, 字节 [r10+后辰] */
    移寄存器(1, 0);           /* ecx = c */
    测寄存器(1, 1); 零跳(-1); 补标号(码位-4, 满升一, 1);
    移即(0, 0x22); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 主进, 1); /* 比较 ecx,'"' → 翻转引号状态 */
    移即(0, 0x20); 算寄存器(比等, 1, 0); 零跳(-1); 补标号(码位-4, 深组, 1); /* 比较 ecx,' ' */
    汇发("    存字节帧 [r13+0], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0x88); 模字节(1, 1, 5); 发字节(0);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3);
    汇发("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 5);
    相对跳转(-1); 补标号(码位-4, 缺置, 2);
    设标号(素贰); /* 引号 词元 起点: 跳过 "，置 在-quote=1，词元 从当前位置开始 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (跳过 ") */
    移即扩(15, 1); /* 在-quote = 1 */
    移64(8, 13);    /* r8 = token_start */
    相对跳转(-1); 补标号(码位-4, 缺置, 2);
    设标号(深组); /* 空格: 引号内复制, 引号外结束 词元 */
    测寄存器(15, 15); 零跳(-1); 补标号(码位-4, 缺挂, 1); /* 在-quote==0 → 结束 */
    汇发("    存字节帧 [r13+0], r1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0x88); 模字节(1, 1, 5); 发字节(0); /* 引号内空格: 复制 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3);
    汇发("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 5);
    相对跳转(-1); 补标号(码位-4, 缺置, 2);
    设标号(主进); /* 翻转引号状态: 跳过 "，不写入 词元 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3); /* 递增 后辰 (跳过 ") */
    汇发("    异或 r15, 1\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0x83); 发字节(0xF7); 发字节(0x01); /* 异或 r15d, 1 */
    相对跳转(-1); 补标号(码位-4, 缺置, 2);
    设标号(缺挂); /* 词元 已结束 于 a 空间: 空字符-终止, 跳过 该 空间 */
    汇发("    存字节0 [r13+0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xC6); 模字节(1, 0, 5); 发字节(0); 发字节(0);
    汇发("    自增 r13\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 5);
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3);
    相对跳转(-1); 补标号(码位-4, 首拾一, 2);
    设标号(满升一); /* 词元 已结束 于 空字符: 终止; 外层 循环 将 完成 */
    汇发("    存字节0 [r13+0]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xC6); 模字节(1, 0, 5); 发字节(0); 发字节(0);
    设标号(首拾一);
    汇发("    存栈索引 [r12+r14*8], r8\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x4F); 发字节(0x89); 发字节(0x04); 发字节(0xF4);
    汇发("    自增 r14\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 6);
    相对跳转(-1); 补标号(码位-4, 目再, 2);
    设标号(外八); /* 空间 之间 词元 */
    汇发("    自增 r11\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x41); 发字节(0xFF); 模字节(3, 0, 3);
    相对跳转(-1); 补标号(码位-4, 目再, 2);
    设标号(段辰);
    移64(1, 14);        /* rcx = 首合 */
    移64(2, 12);        /* rdx = &整劣[0] */
    移即扩(4, 存子一); /* rsp = 存子一 (自切栈顶; 整劣 lives 在 .数据; 帧 可能 grow over 旧 栈) */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0); /* 且 rsp,-16 */
    减栈即(32);        /* 影子 空间 */
    {
        整 宏序 = 查函数("main");
        若 (宏序 < 0 || !函数表[宏序].序布) 宏序 = 查函数("主"); /* 甲言: 主() = 主() */
        若 (宏序 < 0 || !函数表[宏序].序布) { 输出到文件(错误流, "[ERR] 未找到 主 入口 — 顶层 解析 可能 中断 (常见: 顶层 用 未注册 标识符/非类型词 开头 的 声明, 或 函数 花括 未 闭合; 请 用 已 注册 类型词 声明, 并 检查 此 文件 是否 有 语法 错)\n"); 退出(1); }
        相对调用(0);
        补标号(码位 - 4, 函数表[宏序].标号一, 0); /* 调用 主 */
    }
    加栈即(32);
    移寄存器(1, 0);           /* ecx = 主's 返回 代码 */
    移64(4, 3);         /* rsp = rbx (加载器 栈 — Server 2025 ntdll LdrShutdownProcess _chkstk 需 TEB 栈区) */
    汇发("    对齐栈\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 发字节(0x48); 发字节(0x83); 发字节(0xE4); 发字节(0xF0);
    减栈即(32);
    调导入(6);            /* ExitProcess �?永不 返回 */
}

/* 二-通过 代 support: 隔伍一/净成/现降一/下集一 于 文件 作用域 */
空 生成码(空) {
    /* 复位 码生成器 状态 遍 二-通过 (通过 1 estimates .数据 基, 通过 2 真) */
    若 (调试开关) { 调试行数 = 0; 调试上次行 = 0; 当前节行 = 0; 当前函文 = 0; } /* #289: 每 pass 重置行表, 最后一次 pass 数据保留; ★ 当前节行/当前函文 必须 同 复位 —— 否则 本遍 首字节 带 上一遍 末值 (实测 首址 出现 一条 末语句行) */
    码位 = 0; 计利一 = 0; 段简 = 0; 主又 = 0; 暂拆 = 0; 反高 = 0; 剩回 = 0;
    满柒一 = 0;
    正五 = 0; 码生成内存浮 = 0; 码生成内存指 = 0; 整回 = -1; 计双 = 0; 中系 = 0; 标拾 = 0; 初壹 = 0; 码生成免解引用 = 0; 值序 = 0; 满伴 = 0; /* 修复 2026-08-28 可重入: cg_* 码生成器 状态标志跨编译残留 → 进程内第 2 次编译首个函数代码不同 (--重复 只验 2..N 自洽, 漏首 长简 次) */
    若 (整再) { 帧又 = 0; 素凶++; 字 列再[80]; 格式化到串(列再, "{\"pass\":%d,\"start\":true}", 素凶); 段弊(列再); } /* 编译黑匣子: 每 通过 起始帧 (生成码 多遍, 每遍独立帧序) */
    函数数 = 0; /* 必须 re-寄存器 全 函数 在 通过 2 带 FRESH labels �?
                   否则 通过-2 新标号() numbers overlap 该 通过-1 函数
                   labels 且 尾声/返回 跳转 解析 到 该 错误 函数. */
    初成 = 净成; 栈用量 = 现降一;
    遍 (整 计 = 0; 计 < 串数; 计++) { 邻拾[计] = -1; } /* 修复 2026-08-11: 镜像 1090 字符串 > 1024, 邻拾 扩容 2048; 修复 2026-08-27 步七: 清 串数 全量 (原 2048 残留 — 邻拾 扩 65536 后 串数>2048 时旧值残留 → 字符串地址错) */
    遍 (整 计 = 0; 计 < 1024; 计++) { 目甲[计] = -1; } /* 修复 2026-08-03: 曾 512 — 字符串 带 末丙>=512 kept 通过-1 偏移, 故 通过-2 pool missed 它们 且 字符串 引用 pointed 已过 该 pool */
    遍 (整 计 = 0; 计 < 短繁; 计++) { 标号位[计] = 0; 标号设[计] = 0; }
    /* 目辰-处 全 字符串 且 双精度 在 末丙 顺序 (修复 2026-08-03): 外陆一/
       标劣 是 normally lazy (首-引用 顺序), 哪 可 deviate 自
       词法 顺序 (a "" 字面量 lexed 早 but referenced 晚, 静态-初始化
       字符串, 等.) → 首利二's 全伴 layout ≠ 该 .字串/.浮点 末丙-顺序 发射 →
       route_learn's 字符串/双精度 pool drifted 且 首利二≠计简一. 目辰-placing 在 末丙 顺序
       制造 该 全伴 layout 确定 且 末丙-有序, matching 中文汇编. */
    遍 (整 计 = 0; 计 < 串数; 计++) 外陆一(计);
    遍 (整 计 = 0; 计 < 浮数; 计++) 标劣(计);

    /* 生成 代码 */
    /* 目辰-记 全 函数 labels 作为 序布 故 调用 之前 该 定义
       (向前 声明) 解析 作为 user 调用, 非 builtins */
    遍 (整 计 = 0; 计 < 函数定义数; 计++) {
        整 字符 = 函数定义表[计];
        若 (字符 <= 0) 续;
        { 静 整 单简 = 0; 单简++; (空)单简; }
        整 己序 = 查函数((字*)(节名表 + 字符));
        函数表[己序].序布 = 1;
    }
    主又 = 0;
    解析基 = 0; /* 码生成器 查找 使用 净乙 (=总甲[剩回]), 非 该 解析-时间 下限 */
    /* 每-函数 局部 frames (根-因 2026-08-03): recomputed 在 该 循环 以下 */

    遍 (整 计 = 0; 计 < 函数定义数; 计++) {
        整 字符 = 函数定义表[计];
        若 (字符 <= 0) 续;

        /* 函数 定义 */
        字 *串升 = (字*)(节名表 + 字符);
        整 己序 = 查函数(串升);
        复制字符串(当前函数名, 串升); /* 遍 例-6 双精度-返回 路由 */
        { 字 目次[96]; 格式化到串(目次, "{\"cp\":\"codegen\",\"func\":\"%s\",\"idx\":%d}", 串升, 计); 长叁(目次); } /* 编译检查点 (2026-08-28 甲序原生 #6): 每函数代码生成快照 */
        设标号(函数表[己序].标号一);
        若 (调试开关 && 己序 >= 0 && 己序 < 8192) { /* #289: 记录函数起点 (覆盖式: 己序 跨 pass 稳定, 保留最后一次 pass 值) */
            { 整 现起 = 标号位[函数表[己序].标号一];
              复制字符串(调试函数表[己序].名, 串升);
              调试函数表[己序].起 = 现起;
              调试函数表[己序].止 = 0;
              { 整 调词 = -1; /* 词名表正向搜函数名 (取声明/定义首次出现, 非调用点) */
                遍 (整 词查 = 0; 词查 < 词容量; 词查++) {
                    若 (词型表[词查] == 词变量 && !比较字符串(词名表[词查], 串升)) { 调词 = 词查; 断; } }
                调试函数表[己序].行 = 0; 调试函数表[己序].文件 = 1;
                若 (调词 >= 0) { 整 函文 = 0; 整 函行 = 0; 调试归属(词行表[调词], &函文, &函行); /* #289: 归属校正 */
                    调试函数表[己序].行 = 函行; 调试函数表[己序].文件 = 函文;
                    当前节行 = 词行表[调词]; 当前函文 = 函文; /* #289 (第 453 站): 函数入口 行/文件 —— 防 序言 字节 沿用 上一函数 */
                } 否 { 当前节行 = 0; 当前函文 = 0; }
                } }
        }
        汇发("\n; === %s ===\n%s:\n", 串升, 串升, (字*)(长 长)0);
        函数表[己序].序布 = 1;
        当前返回型序 = 查返回名(串升);
        若 (当前返回型序 < 0 && !返回名有(串升) && 己序 >= 0 && 己序 < 8192) 当前返回型序 = 返回型序表[己序]; /* 修复 2026-08-18: 名表优先 (同上 — 整数 返回函数名表有记录, 不得回退错位索引表) */
        { 整 当返指 = 查返回名指(串升);
          当前函数结构返 = (当前返回型序 >= 0 && 类型表[当前返回型序].尺寸 > 8 && !当返指); } /* 列败 函: 参数 移位 (rcx = 隐藏 指针); 结构体 指针 返回 是 非 列败 */
        列重 = 变参取(串升);

        /* 局部 帧 — 单 源 的 真值: `偏移` 是 该 全局 解析-时间 栈偏移,
           段进[剩回] 此 函数's baseline. 位移 = 偏移 - 当前帧大小
           = (偏移 - 段进) - 段三, 故 每 变量 lands 于 [rsp + (偏移 - 段进)]
           右 之后 `减 rsp, 段三`. 反细-段进 是 总是 16-已对齐 且
           272 = 17*16, 故 段三 keeps 应用二进制接口 对齐 于 OS-调用 堆丑. */
        整 段三 = (反细[剩回] - 段进[剩回]) + 4368 + 8; /* 修复 2026-08-07 门-1: +8 → 段三≡8(mod16)。入口 rsp≡8(标准) → 2 压栈(rbp,rbx) 仍 ≡8 → 帧后 rsp≡0 → 调用点 六十四位窗口 应用二进制接口 16 对齐（编译器 sqlite3 混链 movaps 崩溃根因）。反细-段进 恒 16 对齐 */
        当前帧大小 = 段进[剩回] + 段三; /* 51 堆丑 `偏移 - 当前帧大小` untouched */
        临时基 = 当前帧大小 - 272; /* 状态区 [rbp-272..]，格式化打印 缓冲在其下 [rbp-4368..rbp-273]（缺对 里 取址 -4096） */
        结构返指偏移 = 当前帧大小 - 4376; /* 列败 槽位 于 [rbp-4376] — 内联 格式化打印 格式解释器把 [rbp-8] 当 '#' 标志/清零 暂存 (缺对 状态位), 与 列败 槽冲突 → 列败 函数内调 格式化打印 后返回指针被毁 → rcx 垃圾写崩 (修复 2026-08-27 第三批#2: feat_sret10 makeA 崩 0xC0000005). 移入局部区与 格式化打印 缓冲间的恒空闲 +8 填充 (段三 必含 +8), 局部区顶 [rbp-4376) 永不被占用 */

        /* 修复 2026-08-08 -左退一: _start 设裸机栈 + 正常序言 (完整帧, 函数体帧访问有效) */
        整 深劣 = (满双 && 计 == 0 && !比较字符串(串升, "_start"));
        整 邻拾一 = (满双 && !比前n(串升, "__isr_", 6)); /* __isr_xxx: 裸中断函数 — 无帧、iretq */
        若 (深劣) {
            移即扩(4, 0x200000); /* 移动 rsp, 0x200000 — 内核栈 (裸机无栈) */
            移64(15, 4);         /* r15 = rsp */
            压栈寄存器(5);  /* 压栈 rbp */
            压栈寄存器(3);  /* 压栈 rbx */
            移64(5, 4); /* 移动 rbp, rsp */
            减栈即(段三); /* 完整帧 */
        } 否 若 (邻拾一) {
            /* 裸中断函数: 无栈帧, iretq 退出 (CPU 已压入 SS:RSP:RFLAGS:CS:指令指针) */
            (空)0; /* 无 前奏 */
        } 否 {
            压栈寄存器(5);  /* 压栈 rbp */
            压栈寄存器(3);  /* 压栈 rbx */
            移64(5, 4); /* 移动 rbp, rsp */
            减栈即(段三); /* 影子 空间 + 局部 */
        }
        若 (当前函数结构返) 反附(结构返指偏移 - 当前帧大小, 1); /* 保存 该 隐藏 列败 指针 (rcx) — 末属 调用 破坏 它 */

        /* 拷贝 incoming 参数 入 帧 槽位 (寄存器 参数 自 rcx/rdx/r8/r9,
           栈 参数 自 [rbp+长酉]) �?参数 live 在 槽位, 故 递归 /
           嵌套 调用 可't 破坏 该 参数 寄存器.
           指针 参数 (指元素尺寸>0) 是 已拷贝 64-位 到 保持 满 地址.
           仅 此 函数's 变量 [新寅[剩回], 总甲[剩回]) �?全 109 函数 共享
           变量[], copying 每 参数 入 每 前奏 将 破坏 live 槽位. */
        整 当重 = 新寅[剩回], 宽乙 = 总甲[剩回];
        净乙 = 宽乙; /* 作用域 变量 查找 到 此 函数 期间 码生成器 */
        旁得 = 宽乙; /* 缺省 块 边界 = 整体 函数; 嵌套 例-5 块 tighten 它 (修复 2026-08-16) */
        值序 = 宽乙; /* 修复 2026-08-19: 默认块下界 = 函数末尾 (宽松, 顶层块变量可见; 例-5 进入块时收紧) */
        整 上己一 = (满双 && 计 == 0) || 邻拾一; /* -左退一 入口函数或 中断服务: 跳过参数复制 */
        旧序[己序] = 新标号(); 设标号(旧序[己序]); /* #152 TCO: 参数复制点 (尾递归 跳转 目标) */
        遍 (整 变序 = 当重; 变序 < 宽乙; 变序++) {
            若 (变量表[变序].素三 && !上己一) {
                若 (变量表[变序].是否浮标) {
                    /* 双精度 参数: xmm[值丙→xmm] (寄存器) 或 [rbp+长酉] (栈). 8 字节. */
                    若 (变量表[变序].宽系) { 逆厚(变量表[变序].长酉); 余申(变量表[变序].栈偏移 - 当前帧大小); }
                    否 若 (当前函数结构返) 内丙(变量表[变序].栈偏移 - 当前帧大小, 变量表[变序].栈又); /* 列败 函: 双精度 参数 k lives 在 xmm[k] */
                    否 内丙(变量表[变序].栈偏移 - 当前帧大小, 短六一(变量表[变序].值丙));
                } 否 若 (变量表[变序].宽系) {
                    若 (变量表[变序].指元素尺寸 > 0 || (变量表[变序].型序标 >= 0 && 变量表[变序].构尺寸 > 0 && 变量表[变序].构尺寸 <= 8) || 变量表[变序].是否长标) { 移寄存器帧64(0, 变量表[变序].长酉); 反附(变量表[变序].栈偏移 - 当前帧大小, 0); }
                    否 { 移寄存器帧(0, 变量表[变序].长酉); 移帧寄存器(变量表[变序].栈偏移 - 当前帧大小, 0); }
                } 否 若 (变量表[变序].指元素尺寸 > 0 || (变量表[变序].型序标 >= 0 && 变量表[变序].构尺寸 > 0 && 变量表[变序].构尺寸 <= 8) || 变量表[变序].是否长标) 反附(变量表[变序].栈偏移 - 当前帧大小, 变量表[变序].值丙);
                否 移帧寄存器(变量表[变序].栈偏移 - 当前帧大小, 变量表[变序].值丙);
            }
        }

        /* 修复 步三十: 局部 _Alignas(>16) 数组 — 固定 rbp 帧 rbp%N ∈ {8,24} 编译期未知, 静态 [rbp+位移]
           无法保证 >16 对齐; 候选区运行时对齐, 对齐地址存地址槽 (码生成 case1 数组 退化 读槽). */
        遍 (整 变序 = 当重; 变序 < 宽乙 && !上己一; 变序++) {
            若 (变量表[变序].元列 > 0 && 变量表[变序].双伍 <= 0) { /* 修复 步三十一: 变长数组 的 元列=1 只是地址槽标记, 不是 _Alignas 对齐数组 — 跳过, 动态分配在声明处 */
                整 池汇 = 变量表[变序].元列;
                
                取帧址(0, 变量表[变序].首贰 - 当前帧大小);  /* 堆九 = 候选区基址 */
                发字节(0x48); 发字节(0x81); 发字节(0xC0); 发四(池汇 - 1);             /* 加 堆九, N-1 */
                发字节(0x48); 发字节(0x25); 发四(-池汇);                         /* 且 堆九, -N */
                反附(变量表[变序].栈偏移 - 当前帧大小, 0); /* 地址槽 = 对齐地址 */
            }
        }

        /* 变参 函数: spill 该 四 整数-实参 寄存器 入 该
           六十四位窗口 家 区域 故 va_start/va_arg (且 msvcrt _vsnprintf) 可 walk a
           连续 vararg 列表. 家 基 = rbp+24 (见 变参 长酉 math).
           已修 命名 参数 是 仍 已拷贝 以上; 该 spill 仅 加 该
           家-区域 view 所需 由 va_list. */
        若 (列重 >= 0 && !上己一) {
            反附(24, 1); /* rcx -> 家[0] */
            反附(32, 2); /* rdx -> 家[1] */
            反附(40, 8); /* r8  -> 家[2] */
            反附(48, 9); /* r9  -> 家[3] */
        }

        /* 尾声 标号一: 返回 跳转 此处 */
        长复 = 新标号();

        若 (链接模式 && 全局初始化数 > 0) { /* 修复 2026-08-17: 目标文件 模式 后凶 用专用子程序 + 每函数守卫调用 —
                                            原只在最后一个函数内联发射, 若该函数不被调用 (版本库 装配.o
                                            validate_ref_storage_format --help 路径不调) 则初始化永不执行;
                                            初版每函数内联 后凶 函数体 → 大 .o 代码缓冲溢出 (序列器.o) */
            若 (链丑 < 0) { 链丑 = 变量静态("__qcc_ginit_flag", 0); 逆酉[变量数 - 1] = 1; } /* 每 .o 独立局部符号 (scl=3), 防链接重复 */
            若 (单平 < 0) 单平 = 新标号();
            整 初陆 = 新标号();
            移eax内存(静态位移(链丑, 0)); /* 标志 已置位? */
            测寄存器(0, 0);
            非零跳(-1); 补标号(码位 - 4, 初陆, 3);            /* 已初始化 → 跳过 */
            相对调用(0); 补标号(码位 - 4, 单平, 0); /* 调用 后凶 子程序 (目标文件 前向重定位) */
            设标号(初陆);
            满柒一 = 1;
        } 否 若 ((!链接模式 && (!比较字符串(串升, "main") || !比较字符串(串升, "主"))) || (满双 && !比较字符串(串升, "_start"))) { /* 左退一 模式: 后凶 在 _start 发射 (裸机无 运行库) */
            满伴 = 1; /* 后凶 decls 必须 非 是 已跳 由 例-7's 局部-静态 检查 */
            遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) 码生成(后凶[庚序]);
            满伴 = 0;
            满柒一 = 1;
        }

        码生成(子0[字符]); /* 函数 函数体 */

        /* 尾声 标号一: 返回 跳转 此处 — 提前到 剩回++ 前 (延迟 码生成 需当前函数 净乙, 原 剩回++ 后 净乙 指向下一函数 → 延迟 变量"不能取地址" 修复 2026-08-27 延迟 接入) */
        设标号(长复);
        若 (调试开关 && 己序 >= 0 && 己序 < 8192) 调试函数表[己序].止 = 码位; /* #289: 函数终点 (尾声标号处, high_pc, 覆盖式) */
        若 (子1[字符] >= 0) { /* 延迟: 延迟语句 LIFO 逆序执行 — 返回 跳这里先清理再 尾声; 堆九 保存/恢复 — 延迟 内调用会 破坏 返回 值 (修复 2026-08-27 延迟 接入) */
            减栈即(16); /* 对齐 + 临时槽 */
            汇发("    存指64 [rsp], r0\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x89); 模字节(0, 0, 4); 发字节(0x24); /* 移动 [rsp], 堆九 */
            码生成(子1[字符]);
            汇发("    取指64 r0, [rsp]\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0); 前缀字节(1, 0, 0, 0); 发字节(0x8B); 模字节(0, 0, 4); 发字节(0x24); /* 移动 堆九, [rsp] */
            加栈即(16);
        }
        { 整 上四 = 中柒(串升); 若 (上四 >= 0 && 段分[上四].源甲) { 整 上系 = 查变量("__qcc_ret"); /* 注意: 查变量 返 的 是 栈偏移 (非 表索引) — 通道 宽度 不能 由 变量表[上系] 反查, 用 契约表 解析期 记 的 返宽 */ 整 上浮 = (段分[上四].返宽 == 2); 整 上宽 = (段分[上四].返宽 == 1); 若 (上系 >= 0) { 若 (上浮) 余申(上系 - 当前帧大小); 否 若 (上宽) 反附(上系 - 当前帧大小, 0); 否 移帧寄存器(上系 - 当前帧大小, 0); } 码生成(现再(段分[上四].左陆一, 段分[上四].源庚)); 若 (上系 >= 0) { 若 (上浮) 逆厚(上系 - 当前帧大小); 否 若 (上宽) 移寄存器帧64(0, 上系 - 当前帧大小); 否 移寄存器帧(0, 上系 - 当前帧大小); } } } /* 契约后置 (2026-08-28 可吞清单 阶段零-7): 尾声 处 __qcc_ret=返回值; 若(!后置){格式化打印;出口;} — 每个 返回 都跳 长复, 在此统一检查; 检查后恢复 堆九=返回值 (码生成 求值会踩 堆九); 修复 2026-08-28: RAII 回滚误删此检查 (回归, _verify_contract ⑤ 后置违反不拦) */
        剩回++; /* 下一 函数's 变量 范围 */

        若 (邻拾一) {
            /* iretq: 从中断返回 (CPU 自动弹出 指令指针:CS:RFLAGS:RSP:SS) */
            汇发("    中断返回\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
            发字节(0x48); 发字节(0xCF);
        } 否 {
            整 后伍 = 0; /* 修复 步三十一: 变长数组 动态 减 rsp 后 rsp 不在 rbp-段三 — 用 移动 rsp,rbp 直接丢弃 变长数组 栈区 */
            遍 (整 素壬 = 当重; 素壬 < 宽乙; 素壬++) 若 (变量表[素壬].双伍 > 0) { 后伍 = 1; 断; }
            若 (后伍) 移64(4, 5); /* 移动 rsp, rbp */
            否 加栈即(段三);
            弹栈寄存器(3); /* 弹栈 rbx */
            弹栈寄存器(5); /* 弹栈 rbp */
            返一();
        }
        存重(串升); /* 编译黑匣子: 每函数代码增量哈希帧 (定位分歧: 差异 两黑匣子, 首个不同 delta 即首个分歧函数) */
    }
    /* 接入 2026-08-28 声明 声明先行: 已声明的未实现函数 → 半未 (移动 首子,0; 返回), 缺失=警告非错误 (甲序 渐进补全) */
    遍 (整 丁序 = 0; 丁序 < 声明数; 丁序++) {
        若 (链接模式 && 邻捌[丁序]) 续; /* 修复 2026-08-30: C proto 无 半未 在 -c (定义 可能 是 在 另一 .o - 链接器 重复 符号) */
        整 当退 = 查函数(串升一[丁序]);
        若 (!函数表[当退].序布) {
            设标号(函数表[当退].标号一);
            发字节(0xB8); 发字节(0x00); 发字节(0x00); 发字节(0x00); 发字节(0x00); /* 移动 首子, 0 (返回 0 的骨架) */
            发字节(0xC3); /* 返回 */
            函数表[当退].序布 = 1;
        }
    }
    若 (链接模式 && 单平 >= 0) { /* 修复 2026-08-17: 后凶 专用子程序 (每函数守卫调用, 正文只在末尾一次) */
        设标号(单平);
        /* 修复 2026-08-19: 集 标志=1 之前 运行 该 初始化 函数体 故 该
           后凶 函数体 可 safely 调用 guarded 函数 在 该 相同 .o (userdiff.c
           builtin_drivers 初始化 调用 该 IPATTERN/PATTERNS stubs). 带 该 标志
           集 仅 于 该 结束, 该 被调者's 直肆 sees 标志==0 且 调用 该
           后凶 减 再 -> A<->B mutual 递归 -> 栈 溢出 0xC00000FD. */
        移即(0, 1); 终拆(静态位移(链丑, 0)); /* 标志 = 1 首: 后凶 re-entrant */
        满伴 = 1;

        遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) 码生成(后凶[庚序]);
        满伴 = 0;
        发字节(0xC3); /* 返回 */
    }
    若 (链接模式) {
        /* -c 模式：跳过 运行库 与补丁烘焙；字符串/函/浮 补丁改为 目标文件 重定位 */
        遍 (整 计 = 0; 计 < 段简; 计++) {
            整 构序 = 宽伍[计].串序标;
            若 (!毛薄) 毛薄 = 首利(".rdata$str", 0, 2, 3, 0);
            整 偏移 = 邻拾[构序];
            隔贰(宽伍[计].旁退, 偏移);
            缺亥(宽伍[计].旁退, 0x0004, 毛薄, 偏移); /* 启元修复①: ADDR32→REL32 */
        }
        遍 (整 计 = 0; 计 < 主又; 计++) {
            整 直弊 = 段丑(新五[计].标号一);
            若 (直弊 >= 0) {
                隔贰(新五[计].旁退, 0);
                缺亥(新五[计].旁退, 0x0004, 直弊, 0); /* 启元修复②: ADDR32→REL32 */
            }
        }
        /* 计算字符串数据总大小 — 目甲 值包含 全伴 前缀（字符串）偏移，
           但 目标文件 .rdbl 节只有 双精度 数据（从 0 开始），reloc 现重 必须减去前缀。 */
        整 元再 = 0;
        遍 (整 计 = 0; 计 < 串数; 计++) 若 (邻拾[计] >= 0) {
            整 尺寸 = (整)取字长(串表[计]) + 1;
            若 (邻拾[计] + 尺寸 > 元再) 元再 = 邻拾[计] + 尺寸;
        }
        若 (元再 > 反高) 元再 = 反高;
        遍 (整 计 = 0; 计 < 暂拆; 计++) {
            整 丁序 = 号集一[计].浮序标;
            若 (!素戊) 素戊 = 首利(".rdata$dbl", 0, 3, 3, 0);
            整 偏移 = 目甲[丁序] - 元再; /* .rdbl 节内偏移（去掉字符串前缀） */
            隔贰(号集一[计].旁退, 偏移);
            缺亥(号集一[计].旁退, 0x0004, 素戊, 偏移);
        }
        若 (反高 > 0) {
            正浅(全伴, 元再);
            若 (反高 > 元再) 短十(全伴 + 元再, 反高 - 元再);
        }
        /* 内部跳转重定位的 现重 = 最终 标号位（前向跳转在 补丁 时未知）。
           目标文件 现重 在指令字节中（链接器 从指令读），必须写回最终值。 */
        遍 (整 计 = 0; 计 < 总得; 计++) 若 (实凶[计].高亥) {
            实凶[计].现重 = 标号位[实凶[计].标号一];
            隔贰(实凶[计].段次, 标号位[实凶[计].标号一]);
        }
        返;
    }

    /* mini-运行库 入口 半未: provides 首合/整劣, 调用 主, 出口 带 其 代码.
       已发射 在 双 通过 (通过 2 overwrites 通过 1 identically).
       -左退一 模式: 无 运行库 (内核自备 Multiboot2 头 + 入口, 修复 2026-08-08) */
    若 (!满双) {
        汇发("\n; === 运行库 ===\n_入口:\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        序置二();
    }

    /* ????????? */
    解析补丁();

    /* ??????????? 补丁 三十二位立即数 在 移即 ??实际 VA (ImageBase + 首重) */
    整 码终 = 码位;
    遍 (整 计 = 0; 计 < 段简; 计++) {
        整 构序 = 宽伍[计].串序标;
        整 偏移 = 邻拾[构序]; /* 字节 偏移 之内 字符串 数据 */
        整 首重 = (满双 ? 0x104000 : 号己) + 0x1000 + 码终 + 偏移; /* 左退一: 内核加载基址 0x104000 (拼接引导后) + 代码区 + 偏移 */
        隔贰(宽伍[计].旁退, 首重 - ((满双 ? 0x104000 : 号己) + 0x1000 + 宽伍[计].旁退 + 4)); /* 启元修复①: lea RIP-relative */
    }
    /* 补丁 函数-地址 imm32s (函 指针 赋值) 到 实际 VA */
    遍 (整 计 = 0; 计 < 主又; 计++) {
        整 首重 = (满双 ? 0x104000 : 号己) + 0x1000 + 标号位[新五[计].标号一];
        隔贰(新五[计].旁退, 首重 - ((满双 ? 0x104000 : 号己) + 0x1000 + 新五[计].旁退 + 4)); /* 启元修复②: lea RIP-relative */
    }
    /* 补丁 双精度-字面量 指令指针-相对 disp32s: 目标 VA = 隔简一 + 码终 + dbl_off.
       双精度移动 xmm0,[指令指针+三十二位位移] 是 8 字节 (F2 0F 10 05 + disp4); 位移 sits 于 旁退
       (4 字节 入 该 指令), 故 该 指令指针 基 是 旁退+4 (结束 的 指令). */
    遍 (整 计 = 0; 计 < 暂拆; 计++) {
        整 丁序 = 号集一[计].浮序标;
        整 偏移 = 目甲[丁序];
        整 基 = (满双 ? 0x104000 : 号己);
        整 首重 = 基 + 0x1000 + 码终 + 偏移;
        隔贰(号集一[计].旁退, 首重 - (基 + 0x1000 + 号集一[计].旁退 + 4));
    }
    /* ????????????????????*/
    若 (反高 > 0) {
        循环 (码位 + 反高 >= 码缓容量) { 无 字 *接子数 = 重分配(码, 码缓容量+4096); /* 代码 缓冲上限（修复 2026-08-06: 误用 号己 语义，首利二） */ 若 (!接子数) { 输出到文件(错误流, "qcc_x86: 代码缓冲内存不足 %d 字节\n", 号己+4096); 退出(1); } 码 = 接子数; }
        复制内存(码 + 码位, 全伴, 反高);
        码位 += 反高;
    }

    /* 数据 节 汇编 directives 遍 轮-trip */
    汇发("\n; === .data ===\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
    整 虚捌 = 0;
    /* .字串 在 末丙 顺序 (= 全伴 placement 顺序), .浮点 INTERLEAVED 于 其 全伴
       位置 - 编译器 放置 双精度 中-全伴 期间 码生成器, 故 dumping 全
       .浮点 于 该 结束 made 中文汇编's 字符串-pool layout differ. */
    遍 (整 计 = 0; 计 < 串数; 计++) {
        整 偏移 = 邻拾[计];
        循环 (虚捌 < 浮数) {
            整 满散 = 目甲[虚捌];
            若 (满散 < 0) { 虚捌++; 续; }
            若 (偏移 >= 0 && 满散 < 偏移) {
                整 链劣 = 逆组[虚捌], 度附 = 现退[虚捌];
                无 字 栈甲[8];
                栈甲[0]=链劣&0xff;栈甲[1]=(链劣>>8)&0xff;栈甲[2]=(链劣>>16)&0xff;栈甲[3]=(链劣>>24)&0xff;
                栈甲[4]=度附&0xff;栈甲[5]=(度附>>8)&0xff;栈甲[6]=(度附>>16)&0xff;栈甲[7]=(度附>>24)&0xff;
                双 值; 复制内存(&值, 栈甲, 8);
                汇发浮(".浮点 %f\n", 值);
                虚捌++;
            } 否 断;
        }
        若 (偏移 >= 0) {
            /* escape quotes/backslashes/newlines: 字符串 像 "%s":" 开始 带 a
               quote, 哪 中文汇编's .字串 解析器 took 作为 该 关闭 quote */
            汇发(".字串 \"", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
            遍 (常 字 *条件码 = 串表[计]; *条件码; 条件码++) {
                若 (*条件码 == '"') 汇发("\\\"", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*条件码 == '\\') 汇发("\\\\", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*条件码 == '\n') 汇发("\\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 若 (*条件码 == '\t') 汇发("\\t", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
                否 汇发("%c", (字*)(长 长)(*条件码), (字*)(长 长)0, (字*)(长 长)0);
            }
            汇发("\"\n", (字*)(长 长)0, (字*)(长 长)0, (字*)(长 长)0);
        }
    }
    循环 (虚捌 < 浮数) {
        若 (目甲[虚捌] >= 0) {
            整 链劣 = 逆组[虚捌], 度附 = 现退[虚捌];
            无 字 栈甲[8];
            栈甲[0]=链劣&0xff;栈甲[1]=(链劣>>8)&0xff;栈甲[2]=(链劣>>16)&0xff;栈甲[3]=(链劣>>24)&0xff;
            栈甲[4]=度附&0xff;栈甲[5]=(度附>>8)&0xff;栈甲[6]=(度附>>16)&0xff;栈甲[7]=(度附>>24)&0xff;
            双 值; 复制内存(&值, 栈甲, 8);
            汇发浮(".浮点 %f\n", 值);
        }
        虚捌++;
    }
    /* 静态-槽位 计数 遍 该 堆 计数器 (中文汇编 不能 know 静态数) */
    汇发("\n.堆计 %d\n", (字*)(长 长)(静态数), (字*)(长 长)0, (字*)(长 长)0);
    /* tell 中文汇编 该 精确 码终 (之前 全伴) 故 它 可 对齐 其 layout */
    汇发(".布局 码终=%d data_base=0x%X\n", (字*)(长 长)(码位 - 反高), (字*)(长 长)(数据基址), (字*)(长 长)0);
    /* 修复 2026-08-12 计简一 对等: 告诉 中文汇编 直发的 .数据 段尺寸 (上利 修复后 vsize/度肆 是动态的,
       中文汇编 旧写死 0x5000000/0x4000 → 计简一 产物 .数据 段 ≠ 直发 → 计简一 对等失败) */
    { 整 串得 = (上利() + 0x100000 + 4095) & ~4095; 若 (串得 < 0x6000000) 串得 = 0x6000000; /* 96兆字节 地板 (实三 同) */
      汇发(".段 缓粗=0x%X data_raw=0x%X\n", (字*)(长 长)串得, (字*)(长 长)(首厚一), (字*)(长 长)0); }

    /* ??主 ???????? �?mini-运行库 半未 是 该 真 入口 (它 调用 主) */
    整 内九 = 0x1000 + 顺高一;
    若 (满双) {
        /* -左退一 入口 = _start (用户主函数) 的 标号一 偏移, 非 运行库 半未 (左退一 跳过 运行库) — 修复 2026-08-08 */
        整 构序 = 查函数("_start");
        若 (构序 < 0 || !函数表[构序].序布) 构序 = 查函数("主");
        若 (构序 >= 0 && 函数表[构序].序布) 内九 = 0x1000 + 标号位[函数表[构序].标号一]; /* 左退一 偏移 = 代码区(0x1000) + 函数偏移 */
        输出到文件(错误流, "[BIN] _start entry offset: 0x%X (code=%d)\n", 内九, 码位);
    }
    下集一 = 内九;
}

/* 读取 a 文件 入 a 内存分配'd 空字符-已终止 字符串 (空 于 失败).
   真 函数, 非 a 宏: 该 词法器 跳过 函数-像 宏 定义
   (#定义 F(x) ...), 故 a 宏 调用 将 编译 作为 一 未定义 函数
   且 该 自身-hosted 编译器 可 永不 读取 其 输入. */
静 字 *逆平一(常 字 *路径) {
    若 (计挂) { /* 修复 2026-08-10 门 9: ������ļ�ϵͳ -> �ڴ�� */
        若 (!比较字符串(路径, "srclib/qcc_rt.c") || !比较字符串(路径, "qcc_rt.c")) {
            返 (字 *)宽贰; /* ����ʱ */
        }
        返 (字 *)剩薄;  /* ��Դ�� */
    }

    字 *发字节 = NULL;
    FILE *文件;
    整 尺寸;
    文件 = 打开文件(路径, "rb");
    若 (文件) {
        定位文件(文件, 0, 2); /* 右得 */
        尺寸 = 取文件位置(文件);
        倒带(文件);
        若 (尺寸 < 0) { 关文件(文件); 返 NULL; } /* 修复 2026-08-09 缺陷-12: 取文件位置 失败(-1L 非 seekable)显式检查 */
        若 (尺寸 > 0 && 尺寸 <= 16777216) { /* 修复 2026-08-24 t35u: 1048576→2097152 — qcc_x86.c 自身 t35u 后 1.05兆字节 超 1兆字节 上限 → 首利二 链自举编译自身 "不能 open" */
            发字节 = 内存分配((尺寸 + 4) & ~3); /* 修复 2026-08-11 阻塞-3: 轮 到 4 — 未对齐 提升 尺寸 misalign 词型表..词长表 -> 词长表[词位] 垃圾 -> spurious 节长标=1 -> 2-周期 */
            读取(发字节, 1, 尺寸, 文件);
            发字节[尺寸] = 0;
            /* 跳过 UTF-8 BOM (名厚 宽戌 源捌): 编译器 lexed 它 作为 a CJK 标识符
               (e.g. "主"), corrupting 该 首 词元 且 swallowing 主
               (修复 2026-08-06: `无符号 a>=b; 若(...){格式化打印;返回;}` 已崩) */
            若 (尺寸 >= 3 && (无 字)发字节[0] == 0xEF && (无 字)发字节[1] == 0xBB && (无 字)发字节[2] == 0xBF) {
                移动内存(发字节, 发字节 + 3, 尺寸 - 3);
                发字节[尺寸 - 3] = 0;
            }
            /* 2026-09-05 S5 修正: 甲言模式判据 移到词法器 L4688 (中文标识符 token) — 原字节扫描误伤: 编译纯英文 C 时附加运行时含中文即置位 → 英文 struct 被默认移动误伤; 词法级只认标识符 token (注释/字符串不激活) */
        }
        关文件(文件);
    }
    返 发字节;
}

/* 自切栈：加载器 把主线程栈放在镜�?映像尺寸 内部（~91.6-92.6兆字节），页面不可�?
   （深 解析 帧读 段错误）。本数组必须是【最后一个文件级静态】：运行库 半未 入口
   �?rsp 切到这里，栈�?= 堆 起点，栈向下增长、堆 向上增长，背靠背互不侵犯�?*/
__attribute__((原粗))
静 字 主二一[0x100000];

/* ---------- 目标文件 对象写入（-c 模式） ---------- */
静 空 逆辰一(FILE *文件, 整 值) { 写字符(值 & 0xFF, 文件); 写字符((值 >> 8) & 0xFF, 文件); }
静 空 值庚(FILE *文件, 整 值) { 写字符(值 & 0xFF, 文件); 写字符((值 >> 8) & 0xFF, 文件); 写字符((值 >> 16) & 0xFF, 文件); 写字符((值 >> 24) & 0xFF, 文件); }

/* 全局 花括 初始化器静态落盘：把 左升/值布 生成的
   常量赋值（sane_ctype[256]、commands[] 等）直接写进 .数据，多文件链接时
   后凶 不会执行，不能依赖运行时代码。左值必须是文件级/函数级 静态。 */
静 字 *旧劣(整 数) {
    循环 (数 >= 0 && (节型别[数] == 节点_下标 || 节型别[数] == 节点_成员 || 节型别[数] == 节点_箭头)) 数 = 子0[数];
    若 (数 >= 0 && 节型别[数] == 节点_变量) 返 (字*)(节名表 + 数);
    返 NULL;
}
静 整 段陆(常 字 *数) {
    遍 (整 计 = 变量数 - 1; 计 >= 0; 计--)
        若 (!比较字符串(变量表[计].名, 数) && 变量表[计].是否静态标 && 变量表[计].栈偏移 >= 0)
            返 计;
    返 -1;
}
/* 计算 静态 左值表达式在 .数据 内的字节偏移（相对其基变量槽）。
   *帧布 = 该位置要写入的字节数；*构序出 = 结构体类型（成员链续接用，-1 表示非结构体）。 */
静 整 隔拆(整 数, 整 *基槽出, 整 *帧布, 整 *构序出) {
    若 (数 < 0) 返 -1;
    若 (节型别[数] == 节点_变量) {
        整 序标 = 段陆((字*)(节名表 + 数));
        若 (序标 < 0) 返 -1;
        *基槽出 = 变量表[序标].栈偏移;
        整 构序 = 变量表[序标].型序标;
        整 元素尺寸 = 4;
        若 (变量表[序标].数组元素尺寸 > 0) 元素尺寸 = 变量表[序标].数组元素尺寸;
        否 若 (变量表[序标].指元素尺寸 > 0) 元素尺寸 = 8;
        否 若 (变量表[序标].是否长标 || 变量表[序标].是否浮标) 元素尺寸 = 8;
        否 若 (构序 >= 0) 元素尺寸 = 类型表[构序].尺寸;
        *帧布 = 元素尺寸;
        *构序出 = 构序;
        返 0;
    }
    若 (节型别[数] == 节点_下标) {
        整 字符 = 子1[数]; /* 修复 2026-08-16 根治: 数组访问节点索引子节点可能为 -1 (非法/解析产物), 节型表[-1]/节值表[-1] 越界读 — 编译器 三元急切求值两分支都算, 宿主(编译器 分支式) 靠布局侥幸不崩, 短进 必崩 (加-补丁.c 0xC0000005) */
        整 序标 = (字符 >= 0 && 节型别[字符] == 节点_常数) ? 节值表[字符] : -1;
        若 (序标 < 0) 返 -1;
        整 余庚 = 0, 元素尺寸 = 0, 构序 = -1;
        整 宽戌 = 隔拆(子0[数], &余庚, &元素尺寸, &构序);
        若 (宽戌 < 0 || 元素尺寸 <= 0) 返 -1;
        整 内双 = 元素尺寸;
        整 出构序 = 构序;
        若 (构序 < 0) { /* 数组元素：下一层的字节大小取数组基变量的标量元素大小 */
            字 *外癸 = 旧劣(数);
            整 容排 = 外癸 ? 段陆(外癸) : -1;
            若 (容排 >= 0) {
                内双 = 变量表[容排].指元素尺寸 > 0 ? 变量表[容排].指元素尺寸 :
                          (变量表[容排].数组元素尺寸 > 0 ? 变量表[容排].数组元素尺寸 : 4);
            }
        }
        *基槽出 = 余庚;
        *帧布 = 内双;
        *构序出 = 出构序;
        返 宽戌 + 序标 * 元素尺寸;
    }
    若 (节型别[数] == 节点_成员 || 节型别[数] == 节点_箭头) {
        若 (节值表[数] != 0) 返 -1; /* 指针箭头成员（->）不在全局静态初始化器中出现 */
        字 *函 = (字*)(节名表 + 数);
        整 余庚 = 0, 元素尺寸 = 0, 构序 = -1;
        整 宽戌 = 隔拆(子0[数], &余庚, &元素尺寸, &构序);
        若 (宽戌 < 0 || 构序 < 0) 返 -1;
        整 域偏移 = 类型偏移(类型表[构序].名, 函);
        若 (域偏移 < 0) 返 -1;
        整 域尺寸 = 字段尺寸直(构序, 函);
        整 域型 = 字段类型序直(构序, 函);
        若 (域型 >= 0 && 类型表[域型].尺寸 != 域尺寸) 域型 = -1; /* 结构体 指针字段：不是值嵌入 */
        *基槽出 = 余庚;
        *帧布 = 域尺寸;
        *构序出 = 域型;
        返 宽戌 + 域偏移;
    }
    返 -1;
}
/* 修复 2026-08-21: 全局 常量 初始化器的常量表达式 (GIT_SHA1_HEXSZ=(2*度肆) 等) 编译期折叠 —
   原 缺组一 只认 常数 字面量, 表达式节点走 后凶 运行时赋值 → 跨 .o 时 后凶 触发晚
   (对象-名.o 读 hash_algos 时 对象-文件.o 的 后凶 未跑) → cat-文件/提交 oid 解析失败 (非 a 合法 对象 名) */
静 整 帧汇(整 数, 整 *成功) {
    若 (数 < 0) { *成功 = 0; 返 0; }
    若 (节型别[数] == 节点_常数) { *成功 = 1; 返 节值表[数]; }
    若 (节型别[数] == 节点_二元) {
        整 丙 = 节值表[数];
        整 缓六 = 0, 中寅 = 0;
        整 甲 = 帧汇(子0[数], &缓六);
        整 发字节 = 帧汇(子1[数], &中寅);
        若 (!缓六 || !中寅) { *成功 = 0; 返 0; }
        若 (丙 == 下得) { *成功 = 1; 返 甲 * 发字节; }
        若 (丙 == 高拾) { *成功 = 1; 返 甲 + 发字节; }
        若 (丙 == 旧肆) { *成功 = 1; 返 甲 - 发字节; }
        若 (丙 == 行降) { 若 (发字节 == 0) { *成功 = 0; 返 0; } *成功 = 1; 返 甲 / 发字节; }
        若 (丙 == 度未) { 若 (发字节 == 0) { *成功 = 0; 返 0; } *成功 = 1; 返 甲 % 发字节; }
        *成功 = 0; 返 0;
    }
    *成功 = 0; 返 0;
}
静 空 缺组一(uint8_t *反汇, 整 数据偏, 整 元素尺寸, 整 右侧) {
    若 (右侧 < 0) 返;
    若 (节型别[右侧] == 节点_常数) {
        整 值 = 节值表[右侧];
        若 (元素尺寸 == 1) { 反汇[数据偏] = (无 字)值; }
        否 若 (元素尺寸 == 2) { 反汇[数据偏] = (无 字)(值 & 0xff); 反汇[数据偏 + 1] = (无 字)((值 >> 8) & 0xff); }
        否 若 (元素尺寸 == 4) { 复制内存(反汇 + 数据偏, &值, 4); }
        否 若 (元素尺寸 == 8) {
            长 长 直繁 = (长 长)(无 整)值;
            若 (节点长性(右侧, -1)) 直繁 |= ((长 长)(无 整)节长高[右侧]) << 32;
            复制内存(反汇 + 数据偏, &直繁, 8);
        }
        返;
    }
    若 (节型别[右侧] == 节点_二元) { /* 常量表达式编译期折叠: (2 * GIT_SHA1_RAWSZ) → 40 (修复 2026-08-21: 原跳过 → .数据 槽 0 → 跨 .o 后凶 未跑时读 0) */
        整 成功 = 0;
        整 值 = 帧汇(右侧, &成功);
        若 (!成功) 返;
        若 (元素尺寸 == 1) { 反汇[数据偏] = (无 字)值; }
        否 若 (元素尺寸 == 2) { 反汇[数据偏] = (无 字)(值 & 0xff); 反汇[数据偏 + 1] = (无 字)((值 >> 8) & 0xff); }
        否 若 (元素尺寸 == 4) { 复制内存(反汇 + 数据偏, &值, 4); }
        否 若 (元素尺寸 == 8) { 长 长 直繁 = (长 长)值; 复制内存(反汇 + 数据偏, &直繁, 8); }
        返;
    }
    若 (节型别[右侧] == 节点_取址 && 子0[右侧] >= 0 && 节型表[子0[右侧]] == 1) { /* &目标: 8 字节指针槽 ADDR64 重定位 (修复 2026-08-21: 花括 初始化 的 & 自引用 (tempfile_list = {&列表,&列表}) 原跳过 → .数据 槽 0 → volatile_list_del 头=垃圾 → 提交 崩) */
        字 *顺败 = (字*)(节名表 + 子0[右侧]);
        整 邻戌 = 查变量(顺败);
        整 顺合 = 邻戌 >= 0 ? 双成(邻戌) : -1;
        若 (顺合 >= 0) { 内存设置(反汇 + 数据偏, 0, 8); 序深(数据偏, 0x0001, 顺合, 0); }
        返;
    }
    若 (节型别[右侧] == 节点_串词) {
        整 构序 = 节值表[右侧];
        若 (!毛薄) 毛薄 = 首利(".rstr", 0, 2, 3, 0);
        整 现重 = (构序 >= 0 && 构序 < 串数 && 邻拾[构序] >= 0) /* 修复 2026-08-27 步七: 构序<串数 (原 2048 残留 — 邻拾 扩 65536 配套) */ ? 邻拾[构序] : 0;
        
        内存设置(反汇 + 数据偏, 0, 8);
        序深(数据偏, 0x0001, 毛薄, 现重); /* 启元修复③: ADDR32→ADDR64 (8字节指针槽), 照抄 &目标 分支 */
        返;
    }
    若 (节型别[右侧] == 节点_变量) {
        字 *词名表 = (字*)(节名表 + 右侧);
        整 串值 = 满合(词名表);
        若 (串值 < 0) 串值 = 首利(词名表, 0, 0, 2, 0x20);
        内存设置(反汇 + 数据偏, 0, 8);
        序深(数据偏, 0x0001, 串值, 0); /* 启元修复③: ADDR32→ADDR64 (外部符号 8字节槽) */
        返;
    }
}
静 空 名十一(整 泛数, uint8_t *反汇) {
    若 (泛数 < 0) 返;
    若 (节型别[泛数] == 节点_作用域块) {
        遍 (整 键 = 0; 键 < 256; 键++) {
            整 字符 = 取子(泛数, 键);
            若 (字符 > 0) 名十一(字符, 反汇);
        }
        返;
    }
    若 (节型别[泛数] == 节点_赋值) {
        整 直繁 = 子0[泛数], 右侧 = 子1[泛数];
        
        若 (直繁 < 0 || 右侧 < 0) 返;
        整 余庚 = 0, 元素尺寸 = 0, 构序 = -1;
        整 首转 = 隔拆(直繁, &余庚, &元素尺寸, &构序);
        
        若 (首转 < 0 || 余庚 < 0) 返;
        整 数据偏 = 4 * 余庚 + 首转;
        若 (数据偏 < 0 || 元素尺寸 <= 0 || 数据偏 + (元素尺寸 > 4 ? 8 : 元素尺寸) > 静态数 * 4) 返;
        缺组一(反汇, 数据偏, 元素尺寸, 右侧);
    }
}

/* #289 DWARF 编码 (2026-09-01): 独立缓冲, 只读 调试行表/函数表/码位, 不碰共享状态 */

静 空 调写字节(整 *位置, 无 字 值) { 若 (*位置 < 1048576) 调试缓冲[(*位置)++] = 值; } /* 上限 = 调试缓冲 尺寸 (#289: 131072→1048576) */
静 空 调写四(整 *位置, 整 值) { 调写字节(位置, 值 & 0xff); 调写字节(位置, (值 >> 8) & 0xff); 调写字节(位置, (值 >> 16) & 0xff); 调写字节(位置, (值 >> 24) & 0xff); }
静 空 调写ULEB(整 *位置, 整 值) { 循环 (1) { 无 字 乙 = (无 字)(值 & 0x7f); 值 >>= 7; 若 (值) 乙 |= 0x80; 调写字节(位置, 乙); 若 (!值) 断; } }
静 空 调写SLEB(整 *位置, 整 值) { /* #289 (第 453 站): 有符号 LEB128 —— DW_LNS_advance_line 的 操作数;
      换文件 后 行号 可 回退 (原 用 ULEB 写 负增量 = 死循环/垃圾)。 */
    循环 (1) { 无 字 乙 = (无 字)(值 & 0x7f); 值 >>= 7;
        若 ((值 == 0 && !(乙 & 0x40)) || (值 == -1 && (乙 & 0x40))) { 调写字节(位置, 乙); 断; }
        调写字节(位置, 乙 | 0x80); } }
静 空 调发行(整 *位置, 整 码, 整 行, 整 文, 整 *上码, 整 *上行, 整 *上文件) { /* #289 (第 453 站): 发 一条 行表行 (定义 必须 晚于 调写SLEB —— 单遍编译, 声明 晚于 使用者 = 隐式符号) */
    若 (码 < *上码 || 行 <= 0) 返;
    若 (文 != *上文件) { 调写字节(位置, 4); 调写ULEB(位置, 文); *上文件 = 文; } /* DW_LNS_set_file */
    调写字节(位置, 2); 调写ULEB(位置, 码 - *上码); /* advance_pc */
    调写字节(位置, 3); 调写SLEB(位置, 行 - *上行); /* advance_line (有符号) */
    调写字节(位置, 1); /* copy */
    *上码 = 码; *上行 = 行;
}
静 空 调写串(整 *位置, 常 字 *串值) { 若 (串值) 循环 (*串值) 调写字节(位置, *串值++); 调写字节(位置, 0); }

静 空 调试生成(空) {
    整 pos = 0; /* 局部缓冲位 (qcc 全局计数器跨函数未刷内存: 函数内 5028 返回后 0) */
    /* 源码名 (取 全局源名 最后段) */
    字 源短名[256]; 源短名[0] = 0;
    若 (全局源名[0]) { 整 末反 = -1; 遍 (整 计 = 0; 全局源名[计]; 计++) 若 (全局源名[计] == '/' || 全局源名[计] == '\\') 末反 = 计; 复制字符串(源短名, 全局源名 + 末反 + 1); }
    若 (!源短名[0]) 复制字符串(源短名, "?");
    /* 运行时代码基址 = ImageBase(0x400000) + BaseOfCode(0x1000) + 码位偏移 */
    长 长 代码基 = (长 长)(号己 + 0x1000); /* BaseOfCode 固定 0x1000 */

    /* ===== .debug_abbrev ===== */
    调试节abbrev起 = pos;
    调写字节(&pos, 1); 调写ULEB(&pos, 0x11); 调写ULEB(&pos, 1); /* compile_unit, children */
    调写ULEB(&pos, 0x03); 调写ULEB(&pos, 0x08); /* name, string */
    调写ULEB(&pos, 0x1b); 调写ULEB(&pos, 0x08); /* comp_dir, string */
    调写ULEB(&pos, 0x25); 调写ULEB(&pos, 0x08); /* producer, string */
    调写ULEB(&pos, 0x13); 调写ULEB(&pos, 0x05); /* language, data2 (form 0x05) */
    调写ULEB(&pos, 0x11); 调写ULEB(&pos, 0x01); /* low_pc, addr */
    调写ULEB(&pos, 0x10); 调写ULEB(&pos, 0x06); /* stmt_list, data4 (form 0x06) */
    调写ULEB(&pos, 0); 调写ULEB(&pos, 0);
    调写字节(&pos, 2); 调写ULEB(&pos, 0x2e); 调写ULEB(&pos, 0); /* subprogram, no children */
    调写ULEB(&pos, 0x03); 调写ULEB(&pos, 0x08); /* name */
    调写ULEB(&pos, 0x11); 调写ULEB(&pos, 0x01); /* low_pc */
    调写ULEB(&pos, 0x12); 调写ULEB(&pos, 0x07); /* high_pc, data8 (form 0x07) */
    调写ULEB(&pos, 0x3b); 调写ULEB(&pos, 0x0f); /* decl_line, udata (form 0x0f) */
    调写ULEB(&pos, 0x3a); 调写ULEB(&pos, 0x0f); /* decl_file, udata (form 0x0f) (#289 第 453 站: 文件归属) */
    调写ULEB(&pos, 0); 调写ULEB(&pos, 0);
    调写ULEB(&pos, 0); 调写ULEB(&pos, 0);
    调试节abbrev尺寸 = pos - 调试节abbrev起;

    /* ===== .debug_info ===== */
    调试节info起 = pos;
    整 信息内容起 = pos + 4; /* 跳过 unit_length 占位 */
    调写四(&pos, 0); /* unit_length 占位 */
    调写字节(&pos, 4); 调写字节(&pos, 0); /* version 4 (half, 2 字节 — 原调写四致 header 错位 2 字节, gdb addr_size=0) */
    调写四(&pos, 0); /* abbrev_offset */
    调写字节(&pos, 8); /* addr_size */
    调写ULEB(&pos, 1); /* abbrev 1: compile_unit */
    调写串(&pos, 源短名);
    调写串(&pos, ".");
    调写串(&pos, "qcc_x86 v5.0");
    调写字节(&pos, 1); 调写字节(&pos, 0); /* language: C89 (data2, 2 字节) */
    长 长 低pc = 代码基;
    调写字节(&pos, (无 字)(低pc & 0xff)); 调写字节(&pos, (无 字)((低pc >> 8) & 0xff)); 调写字节(&pos, (无 字)((低pc >> 16) & 0xff)); 调写字节(&pos, (无 字)((低pc >> 24) & 0xff));
    调写字节(&pos, (无 字)((低pc >> 32) & 0xff)); 调写字节(&pos, (无 字)((低pc >> 40) & 0xff)); 调写字节(&pos, (无 字)((低pc >> 48) & 0xff)); 调写字节(&pos, (无 字)((低pc >> 56) & 0xff));
    调写四(&pos, 0); /* stmt_list = 0 (第一个 .debug_line 单元) */
    /* 函数 subprograms (覆盖式函数表: 遍历函数定义表, 己序 索引 调试函数表) */
    遍 (整 计 = 0; 计 < 函数定义数; 计++) {
        整 字符 = 函数定义表[计];
        若 (字符 <= 0) 续;
        字 *调名 = (字*)(节名表 + 字符);
        整 调序 = 查函数(调名);
        若 (调序 < 0 || 调序 >= 8192) 续;
        若 (调试函数表[调序].止 <= 调试函数表[调序].起) 续; /* 未完成函数跳过 */
        调写ULEB(&pos, 2); /* abbrev 2: subprogram */
        调写串(&pos, 调试函数表[调序].名);
        长 长 函低 = 代码基 + (长 长)调试函数表[调序].起;
        调写字节(&pos, (无 字)(函低 & 0xff)); 调写字节(&pos, (无 字)((函低 >> 8) & 0xff)); 调写字节(&pos, (无 字)((函低 >> 16) & 0xff)); 调写字节(&pos, (无 字)((函低 >> 24) & 0xff));
        调写字节(&pos, (无 字)((函低 >> 32) & 0xff)); 调写字节(&pos, (无 字)((函低 >> 40) & 0xff)); 调写字节(&pos, (无 字)((函低 >> 48) & 0xff)); 调写字节(&pos, (无 字)((函低 >> 56) & 0xff));
        长 长 函高 = (长 长)(调试函数表[调序].止 - 调试函数表[调序].起);
        调写字节(&pos, (无 字)(函高 & 0xff)); 调写字节(&pos, (无 字)((函高 >> 8) & 0xff)); 调写字节(&pos, (无 字)((函高 >> 16) & 0xff)); 调写字节(&pos, (无 字)((函高 >> 24) & 0xff));
        调写字节(&pos, (无 字)((函高 >> 32) & 0xff)); 调写字节(&pos, (无 字)((函高 >> 40) & 0xff)); 调写字节(&pos, (无 字)((函高 >> 48) & 0xff)); 调写字节(&pos, (无 字)((函高 >> 56) & 0xff));
        调写ULEB(&pos, 调试函数表[调序].行);
        调写ULEB(&pos, 调试函数表[调序].文件); /* #289: decl_file (1=用户源 / 2=前插运行时) */
    }
    调写ULEB(&pos, 0); /* CU children 结束标记 (compile_unit has_children=1, 缺失致 gdb abbrev 错乱) */
    /* 回填 unit_length */
    整 信息尺寸 = pos - 信息内容起;
    调试节info尺寸 = 信息尺寸 + 4;
    调写四(&pos, 0); /* 占位 (随后覆盖) */
    { 整 信息终 = pos;
      pos = 信息内容起 - 4;
      调写四(&pos, 信息尺寸);
      pos = 信息终; }

    /* ===== .debug_line ===== */
    调试节line起 = pos;
    整 行内容起 = pos + 4;
    调写四(&pos, 0); /* unit_length 占位 */
    调写字节(&pos, 4); 调写字节(&pos, 0); /* version 4 (half, 2 字节 — header 含 max_ops_per_inst) */
    整 行头起 = pos;
    调写四(&pos, 0); /* header_length 占位 */
    调写字节(&pos, 1); /* min_inst_length */
    调写字节(&pos, 1); /* max_ops_per_inst */
    调写字节(&pos, 1); /* default_is_stmt */
    调写字节(&pos, 0xfb); /* line_base = -5 (255-256) */
    调写字节(&pos, 14); /* line_range */
    调写字节(&pos, 13); /* opcode_base */
    { 静 无 字 标准长度[12] = {0,1,1,1,1,0,0,0,1,0,0,1};
      遍 (整 计 = 0; 计 < 12; 计++) 调写字节(&pos, 标准长度[计]); }
    调写字节(&pos, 0); /* include dirs 结束 */
    调写串(&pos, 源短名); 调写ULEB(&pos, 0); 调写ULEB(&pos, 0); 调写ULEB(&pos, 0); /* file_names[1]: 用户源, dir=0, time=0, size=0 */
    调写串(&pos, 调试预名); 调写ULEB(&pos, 0); 调写ULEB(&pos, 0); 调写ULEB(&pos, 0); /* file_names[2]: 前插运行时 (#289 第 453 站) */
    调写字节(&pos, 0); /* file_names 结束 */
    /* 回填 header_length */
    { 整 行头尺寸 = pos - 行头起 - 4;
      整 行头终 = pos;
      pos = 行头起;
      调写四(&pos, 行头尺寸);
      pos = 行头终; }
    /* 行号程序: 函数起点 (gdb info line) 与 调试行表 按 地址 归并 ——
       #289 (第 453 站) 修正: 原 两段 串行 (先 发 全部 函数起点, 再 发 调试行表), 第二段 沿用 第一段
       结束时的 `上码` ⟹ 单调守卫 (码 < 上码 续) 把 行表行 几乎 全数 丢弃 (实测 修复前 锚产物
       file=1 仅 4 行)。两源 各自 按 地址 递增 (码生成序 = 地址序) ⟹ 归并 即 正确 序列。 */
    整 函起码[8192]; 整 函起行[8192]; 整 函起文[8192]; 整 函起数 = 0;
    遍 (整 计 = 0; 计 < 函数定义数; 计++) {
        整 字符 = 函数定义表[计];
        若 (字符 <= 0) 续;
        字 *调名 = (字*)(节名表 + 字符);
        整 调序 = 查函数(调名);
        若 (调序 < 0 || 调序 >= 8192) 续;
        若 (调试函数表[调序].止 <= 调试函数表[调序].起) 续;
        若 (调试函数表[调序].行 <= 0) 续;
        若 (函起数 < 8192) { 函起码[函起数] = (整)(代码基 + (长 长)调试函数表[调序].起); 函起行[函起数] = 调试函数表[调序].行; 函起文[函起数] = 调试函数表[调序].文件; 函起数++; }
    }
    整 上码 = 0; 整 上行 = 1; 整 上文件 = 1; 整 函针 = 0;
    遍 (整 计 = 0; 计 < 调试行数; 计++) {
        整 码 = (整)(代码基 + (长 长)调试行表[计][0]); 整 行 = 调试行表[计][1]; 整 文 = 调试行表[计][2]; /* 绝对 VA */
        循环 (1) { 若 (函针 >= 函起数 || 函起码[函针] > 码) 断;
            调发行(&pos, 函起码[函针], 函起行[函针], 函起文[函针], &上码, &上行, &上文件); 函针++; }
        调发行(&pos, 码, 行, 文, &上码, &上行, &上文件);
    }
    循环 (1) { 若 (函针 >= 函起数) 断;
        调发行(&pos, 函起码[函针], 函起行[函针], 函起文[函针], &上码, &上行, &上文件); 函针++; }
    { 整 末码 = (整)(代码基 + (长 长)码位); /* end_sequence 在代码末尾, 不覆盖最后函数起点 */
      若 (末码 > 上码) { 调写字节(&pos, 2); 调写ULEB(&pos, 末码 - 上码); } }
    调写字节(&pos, 0); 调写字节(&pos, 1); 调写字节(&pos, 1); /* DW_LNE_end_sequence */
    /* 回填 unit_length */
    整 行尺寸 = pos - 行内容起;
    调试节line尺寸 = 行尺寸 + 4;
    { 整 行终 = pos;
      pos = 行内容起 - 4;
      调写四(&pos, 行尺寸);
      pos = 行终; }
    调试缓冲位 = pos; /* 一次性写回全局 (qcc 全局计数器跨函数 bug) */
}

静 空 空伴(FILE *文件) {
    /* 节内容 */
    构 { 字 名[16]; 整 尺寸一; uint8_t *数据; 整 旧粗; } 标叁[4];
    内存设置(标叁, 0, 大小(标叁));
    复制字符串(标叁[0].名, ".text"); 标叁[0].尺寸一 = 码位; 标叁[0].数据 = 码; 标叁[0].旧粗 = 0x60000020;
    复制字符串(标叁[1].名, ".rstr"); 标叁[1].尺寸一 = 单利; 标叁[1].数据 = 列叁; 标叁[1].旧粗 = 0x40300040;
    复制字符串(标叁[2].名, ".rdbl"); 标叁[2].尺寸一 = 副酉; 标叁[2].数据 = 列己; 标叁[2].旧粗 = 0x40300040;
    /* 任务 5.1 (修复 2026-08-06): 全局初始值入 .数据 — 原 .bss 无内容, 常量初始值 (后凶) 在 -c 多 .o 链接时
       挂在第一个函数入口不执行 → 计数器=100 丢成 0。改 .数据 段含初始值; 未初始化全局写 0 (语义等价 .bss 清零) */
    复制字符串(标叁[3].名, ".data"); 标叁[3].尺寸一 = 静态数 * 4; 标叁[3].旧粗 = 0xC0300080;
    uint8_t *反汇 = (uint8_t*)内存分配((静态数 ? 静态数 : 1) * 4);
    内存设置(反汇, 0, (静态数 ? 静态数 : 1) * 4); /* 修复 2026-08-17: 提升 清零分配 做 非 零; 空伴 .数据 需 清 缓冲 */

    标叁[3].数据 = 反汇;
    遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) { /* 常量全局初始值 (g = 立即数) 直接写 .数据 — 例 7 声明+初始化 (值在 子0), 例 10 赋值 (值在 子1) */
        整 泛数 = 后凶[庚序];
        整 虚败 = -1;
        若 (泛数 >= 0 && 节型别[泛数] == 节点_声明节 && 子0[泛数] >= 0 && 节型表[子0[泛数]] == 0) 虚败 = 子0[泛数];
        否 若 (泛数 >= 0 && 节型别[泛数] == 节点_赋值 && 子1[泛数] >= 0 && 节型表[子1[泛数]] == 0) 虚败 = 子1[泛数];
        /* 修复 2026-08-17: &变量 地址常量 → .数据 ADDR32 重定位 (目标文件 多 .o 时 后凶 子程序不被 主 所在 .o 调用 → 全局指针 = &x 保持 0 崩; 单文件非 目标文件 走 后凶 正常) */
        否 若 (链接模式 && 泛数 >= 0 && 节型别[泛数] == 节点_声明节 && 子0[泛数] >= 0 && 节型表[子0[泛数]] == 11 && 子0[子0[泛数]] >= 0 && 节型表[子0[子0[泛数]]] == 1) 虚败 = 子0[泛数];
        否 若 (链接模式 && 泛数 >= 0 && 节型别[泛数] == 节点_赋值 && 子1[泛数] >= 0 && 节型表[子1[泛数]] == 11 && 子0[子1[泛数]] >= 0 && 节型表[子0[子1[泛数]]] == 1) 虚败 = 子1[泛数];
        /* 修复 2026-08-21: 字符串字面量初始化器 (常量 字符 *g = "字符串") → .数据 槽写字符串地址 reloc。
           原只匹配数值/&变量 节点, 串词 节点 (节型表=串词) 跳过 → 槽 0 → blob_type/commit_type 等 空 → 哈希-对象/提交 崩 */
        否 若 (链接模式 && 泛数 >= 0 && 节型别[泛数] == 节点_声明节 && 子0[泛数] >= 0 && 节型表[子0[泛数]] == 串词) 虚败 = 子0[泛数];
        否 若 (链接模式 && 泛数 >= 0 && 节型别[泛数] == 节点_赋值 && 子1[泛数] >= 0 && 节型表[子1[泛数]] == 串词) 虚败 = 子1[泛数];
        若 (虚败 >= 0) {
            字 *变节 = (字*)(节名表 + 泛数);
            整 偏移 = 查变量(变节);
            若 (偏移 >= 0 && 偏移 < 静态数) {
                若 (节型别[虚败] == 节点_取址) { /* &目标: 8 字节指针槽 0 占位 + ADDR64 重定位 (修复 2026-08-17: 原 4 字节 + REL32_3(0x0006) 错类型 → 链接后垃圾地址) */
                    字 *顺败 = (字*)(节名表 + 子0[虚败]);
                    整 邻戌 = 查变量(顺败);
                    整 顺合 = 邻戌 >= 0 ? 双成(邻戌) : -1;
                    若 (顺合 >= 0) { 内存设置(反汇 + 4 * 偏移, 0, 8); 序深(4 * 偏移, 0x0001, 顺合, 0); }
                } 否 若 (节型别[虚败] == 节点_串词) { /* 字符串字面量: 8 字节指针槽 → .rstr 段 ADDR32 重定位 */
                    内存设置(反汇 + 4 * 偏移, 0, 8);
                    缺组一(反汇, 4 * 偏移, 8, 虚败);
                } 否 {
                    整 值 = 节值表[虚败];
                    若 (变量是否长(变节)) { 长 长 直繁 = (长 长)值; 复制内存(反汇 + 4 * 偏移, &直繁, 8); } /* 邻辰 全局常量: 符号扩展 8 字节 (修复 2026-08-06: 原 4 字节 → 高 4 字节 0, -5 变 4294967291) */
                    否 若 (计得(变节) == 1) { 无 字 逆未 = (无 字)值; 复制内存(反汇 + 4 * 偏移, &逆未, 1); } /* 修复 2026-08-30 生成器 t6: 8 位标量 .数据 初始化窄化 — 静态 uint8_t g=-17 原写 0xFFFFFFEF → 32 位读 4294967279 (s88 族根治) */
                    否 若 (计得(变节) == 2) { 无 短 帧属 = (无 短)值; 复制内存(反汇 + 4 * 偏移, &帧属, 2); } /* 修复 2026-08-30 生成器 t6: 16 位标量 .数据 初始化窄化 — 静态 uint16_t g=-1 原写 0xFFFFFFFF → 读 4294967295 */
                    否 复制内存(反汇 + 4 * 偏移, &值, 4);
                }
            }
        }
    }
    若 (!值升) 值升 = 首利(".text", 0, 1, 3, 0);
    若 (!毛薄) 毛薄 = 首利(".rstr", 0, 2, 3, 0);
    若 (!素戊) 素戊 = 首利(".rdbl", 0, 3, 3, 0);
    若 (!外浅) 外浅 = 首利(".data", 0, 4, 3, 0); /* 修复 2026-08-06: .bss→.数据 (全局初始值入 .数据) */
    遍 (整 计 = 0; 计 < 函数数; 计++) {
        若 (函数表[计].序布) {
            整 净升 = (函数是否静态(函数表[计].名) || 函数是否私有(函数表[计].名) || 主薄(函数表[计].名)) ? 3 : 2; /* 静态/内建 → 局部符号 scl=3 (修复 2026-08-06: 多 .o 头库不冲突) */
            整 串值 = 满合(函数表[计].名);
            若 (串值 < 0) {
                串值 = 首利(函数表[计].名, 标号位[函数表[计].标号一], 1, 净升, 0x20);
            } 否 {
                /* 修复 2026-08-15: 同名未定义符号先入表（函数体之前被引用）→ 定义被跳过，符号值停在 0 → strbuf_add 跳到对象首函数 */
                符退[串值].值一 = 标号位[函数表[计].标号一];
                符退[串值].缓癸 = 1;
                符退[串值].域 = 净升;
                符退[串值].型 = 0x20;
            }
        }
    }
    遍 (整 计 = 0; 计 < 变量数; 计++) {
        若 (变量表[计].是否静态标 && 变量表[计].栈偏移 >= 0) { /* 外部 (栈偏移<0) 不生成 .bss 定义符号 — 由 双成 生成 缓癸=0 未定义 (修复 2026-08-06) */
            整 上丙 = (静态关键[计] || 逆酉[计]) ? 3 : 2;
            整 串值 = 满合(变量表[计].名);
            若 (串值 < 0) 串值 = 首利(变量表[计].名, 4 * 变量表[计].栈偏移, 4, 上丙, 0); /* 修复 2026-08-06: 函数内 静态 → scl=3 局部; 修复 2026-08-14: 文件级 静态 也 scl=3 */
            否 {
                /* 修复 2026-08-15: 同名符号先以未定义/错误值入表 → 更新为真实 .数据 槽 */
                符退[串值].值一 = 4 * 变量表[计].栈偏移;
                符退[串值].缓癸 = 4;
                符退[串值].域 = 上丙;
                符退[串值].型 = 0;
            }
        }
    }

    /* -c 多 .o 链接: 把「函数/全局变量地址」类静态初始化器直接落成 .数据 ADDR32 重定位。
       否则它们只存在于 后凶 运行时代码，而 后凶 只挂在对象最后一个函数入口，
       多文件链接后不会执行 → 静态函数指针槽保持 0（usage_routine/die_routine 崩）。 */
    遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) {
        整 泛数 = 后凶[庚序];
        若 (泛数 < 0 || 节型别[泛数] != 节点_声明节 || 子0[泛数] < 0) 续;
        若 (节型表[子0[泛数]] != 1) 续; /* 仅处理函数/全局变量地址初始化 */
        字 *变节 = (字*)(节名表 + 泛数);
        整 偏移 = -1;
        遍 (整 变序 = 变量数 - 1; 变序 >= 0; 变序--)
            若 (!比较字符串(变量表[变序].名, 变节) && 变量表[变序].是否静态标 && 变量表[变序].栈偏移 >= 0) { 偏移 = 变量表[变序].栈偏移; 断; }
        若 (偏移 < 0) 续;
        字 *词名表 = (字*)(节名表 + 子0[泛数]);
        整 串值 = 满合(词名表);
        若 (串值 < 0) 续;
        内存设置(反汇 + 4 * 偏移, 0, 8);
        序深(4 * 偏移, 0x0001, 串值, 0); /* 启元修复③: ADDR32→ADDR64 (函数/全局地址 8字节槽) */
    }

    /* 全局 花括 数组/结构体初始化：把静态可确定的元素/字段值写入 .数据。
       覆盖 sane_ctype[256]、commands[] 等（修复 2026-08-16: 多文件链接 后凶 不执行，
       原 .数据 全零 → isspace/判字母数字 宏全假、命令分发表空）。 */
    遍 (整 庚序 = 0; 庚序 < 全局初始化数; 庚序++) {
        整 泛数 = 后凶[庚序];
        若 (泛数 >= 0 && 节型别[泛数] == 节点_作用域块) 名十一(泛数, 反汇);
    }

    /* 每节重定位 */
    整 下布一[4] = {0,0,0,0};
    遍 (整 计 = 0; 计 < 总得; 计++) {
        /* 重定位按 段次 所在节分组（不是目标符号的节） */
        整 段次 = 实凶[计].段次;
        整 帧三 = 0;
        若 (段次 >= 正二) 帧三 = 3;
        否 若 (段次 >= 码位) {
            若 (段次 < 码位 + 单利) 帧三 = 1;
            否 帧三 = 2;
        }
        下布一[帧三]++;
    }
    整 *首重[4], *初巳[4], *上柒一[4];
    整 容排[4] = {0,0,0,0};
    遍 (整 计 = 0; 计 < 4; 计++) {
        首重[计] = 清零分配(下布一[计] ? 下布一[计] : 1, 4);
        初巳[计] = 清零分配(下布一[计] ? 下布一[计] : 1, 4);
        上柒一[计] = 清零分配(下布一[计] ? 下布一[计] : 1, 4);
    }
    遍 (整 计 = 0; 计 < 总得; 计++) {
        整 段次 = 实凶[计].段次;
        整 帧三 = 0;
        若 (段次 >= 正二) 帧三 = 3;
        否 若 (段次 >= 码位) {
            若 (段次 < 码位 + 单利) 帧三 = 1;
            否 帧三 = 2;
        }
        整 满分 = 容排[帧三]++;
        首重[帧三][满分] = (帧三 == 3) ? (实凶[计].段次 - 正二) : 实凶[计].段次;
        初巳[帧三][满分] = 实凶[计].半退;
        上柒一[帧三][满分] = 实凶[计].型;
    }

    /* 修复 2026-08-18: ADDR32/ADDR64 .数据 重定位的 现重 必须写进 .数据 站点 —
       目标文件 的 现重 存在节数据里 (链接器读站点字节加符号地址); 原只记 reloc 表不写 现重
       → 全局指针 = 字符串 (special_refs[]={"FETCH_HEAD",...}) 的 现重 全 0 →
       指针指向 .rstr 偏移 0 ("SUDO_UID") → is_special_ref 比较字符串 垃圾 → 版本库 初始化 段错误 */
    遍 (整 计 = 0; 计 < 总得; 计++) {
        若 (实凶[计].段次 >= 正二 && (实凶[计].型 == 0x0002 || 实凶[计].型 == 0x0001)) {
            整 偏移 = 实凶[计].段次 - 正二;
            
            若 (偏移 >= 0 && 偏移 + 8 <= 静态数 * 4) {
                整 甲 = 实凶[计].现重;
                若 (实凶[计].型 == 0x0001) { 长 长 标址 = (长 长)(无 整)甲; 复制内存(反汇 + 偏移, &标址, 8); }
                否 复制内存(反汇 + 偏移, &甲, 4);
            }
        }
    }

    /* 目标文件 头 */
    逆辰一(文件, 0x8664); 逆辰一(文件, 4); 值庚(文件, 0);
    整 余九 = (整)取文件位置(文件);
    值庚(文件, 0); 值庚(文件, 0);
    逆辰一(文件, 0); 逆辰一(文件, 0);

    /* 节表 + 计算 度肆 偏移 */
    整 逆玖 = 20 + 40 * 4;
    整 度序一[4];
    遍 (整 计 = 0; 计 < 4; 计++) {
        字 名存[9]; 内存设置(名存, 0, 9); 复制内存(名存, 标叁[计].名, 8);
        写入(名存, 1, 8, 文件);
        值庚(文件, 0); 值庚(文件, 0);
        值庚(文件, 标叁[计].尺寸一);
        值庚(文件, 逆玖); 逆玖 += 标叁[计].尺寸一;
        /* reloc 偏移 先占位，写完数据后回填 */
        度序一[计] = -1;
        值庚(文件, 0); 值庚(文件, 0);
        逆辰一(文件, 下布一[计]); 逆辰一(文件, 0);
        值庚(文件, 标叁[计].旧粗);
    }

    /* 节数据 */
    遍 (整 计 = 0; 计 < 4; 计++) {
        若 (标叁[计].数据 && 标叁[计].尺寸一 > 0) 写入(标叁[计].数据, 1, 标叁[计].尺寸一, 文件);
    }
    /* 重定位表（对象重定位偏移 = 文件绝对偏移） */
    整 堆凶 = (整)取文件位置(文件);
    遍 (整 计 = 0; 计 < 4; 计++) {
        度序一[计] = 下布一[计] ? 堆凶 : 0;
        遍 (整 乙 = 0; 乙 < 下布一[计]; 乙++) {
            值庚(文件, 首重[计][乙]);
            值庚(文件, 初巳[计][乙]);
            逆辰一(文件, 上柒一[计][乙]);
        }
        堆凶 += 下布一[计] * 10;
    }
    /* 回填节表 重定位指针（第 i 项 +24） */
    遍 (整 计 = 0; 计 < 4; 计++) {
        定位文件(文件, 20 + 40 * 计 + 24, 号汇);
        值庚(文件, 度序一[计]);
    }

    /* 符号表 */
    整 虚酉 = 堆凶 + (下布一[0] + 下布一[1] + 下布一[2] + 下布一[3]) * 10;
    定位文件(文件, 虚酉, 号汇);
    整 元丁 = 4;
    遍 (整 计 = 0; 计 < 满己; 计++) 若 ((整)取字长(符退[计].名) > 8) 元丁 += (整)取字长(符退[计].名) + 1;
    遍 (整 计 = 0; 计 < 满己; 计++) {
        常 字 *名存 = 符退[计].名;
        整 长度一 = (整)取字长(名存);
        若 (长度一 <= 8) {
            字 容拾[8]; 内存设置(容拾, 0, 8); 复制内存(容拾, 名存, 长度一);
            写入(容拾, 1, 8, 文件);
        } 否 {
            整 丙 = 4;
            遍 (整 键 = 0; 键 < 计; 键++) 若 ((整)取字长(符退[键].名) > 8) 丙 += (整)取字长(符退[键].名) + 1;
            写字符(0,文件); 写字符(0,文件); 写字符(0,文件); 写字符(0,文件); /* 4 零 + 4 偏移 = 8 字节名字段 */
            值庚(文件, 丙);
        }
        值庚(文件, 符退[计].值一);
        逆辰一(文件, 符退[计].缓癸);
        逆辰一(文件, 符退[计].型);
        写字符(符退[计].域, 文件);
        写字符(0, 文件);
    }
    /* 字符串表 */
    值庚(文件, 元丁);
    遍 (整 计 = 0; 计 < 满己; 计++) {
        若 ((整)取字长(符退[计].名) > 8) { 写行(符退[计].名, 文件); 写字符(0, 文件); }
    }
    /* 回填符号表指针 */
    定位文件(文件, 余九, 号汇);
    值庚(文件, 虚酉);
    值庚(文件, 满己);
}

/* ==== 阶段 3 阶段 C: 中间表示 工程预埋区 (短进.4 §11.2 定义态 · 宏门内零占用) ====
   语义依据: 《甲言_逆向定律库_IR工程预埋全景.号集》§12 优先级 (类型宽度第一)
   纪律: 前亥一 未定义 → 结构定义不参与编译 → 产物零影响 → 自举不变 (85af2ba4)
   激活: 阶段 7 打开宏 + 引用 → 必须过预埋尺 (短进.4 §7.2) + 差异测试双闸 */
#define 前亥一 1  /* 阶段C-0 IR 激活 (2026-09-01 大哥: 开炮): 结构位真实落位 (BSS 分离加载, 产物文件大小不变); 关闭删此行 */
#ifdef 前亥一
/* 1. 实薄 三地址码 (短进.4 §2.1, LLVM 值模型定律 §6) — 类型宽度第一优先 */
/* 决策史: 优化器需统一中间表示 = 前端出口 H1==H2 载体 (定稿 §1.3); 现高 宽度第一 (逆向定律库 §12) */
typedef 构 { 整 算子; 整 现高; 整 元; 整 首利一; 整 串值二; 整 剩十; } 实薄;
/* 现高 编码: 低 8 位类型 (i8=1 i16=2 i32=3 i64=4 u8=5 u16=6 u32=7 u64=8 f32=9 f64=10 指针=11),
   高 8 位值级属性位 (单次/和/LATTICE) */
#define 缓集 1000000  /* 预埋初始值: 激活前按编译 版本库 全量最坏规模实测校准 (2026-08-25 启元审计) */
静 实薄 暂弊[缓集]; 静 整 现序一;

/* 2. 块表/CFG (短进.4 §3, LLVM CFG 定律 §7) — 只存 succ 反向算 pred (LLVM 定律 2) */
/* 决策史: 循环优化/控制流分析需 CFG; 只存 succ 省一半 (LLVM 定律 2) */
typedef 构 { 整 始; 整 终一; 整 列丁; 整 副肆; 整 尾序一[8]; 整 末辛[8]; 整 回边; } 剩系;
#define 剩伴一 100000  /* 预埋初始值: 激活前按 版本库 全量函数数 × 最坏基本块数实测校准 (2026-08-25 启元审计) */
静 剩系 末一二[剩伴一]; 静 整 上退;

/* 3. 值级 侧-表 (短进.4 §10.1, 逆向定律库 §1-3/§5) */
/* 决策史: 吞所有权/借用产生生命周期数据, 吞 ADT/Option 产生判别式, 吞泛型/impl Trait 产生类型变量 (定稿 §5.3③) */
/* 注: 总子/源粗/空对/计肆一 定义移至 借用检查区前 (R1 2026-09-03, 见上) — 此处仅 段双 */
静 整 段双[首吉];         /* 截断标记: 0=无 1=赋值截断 2=转型 截断 3=扩展 */

/* 4. 类型级 侧-表 (逆向定律库 §4, 不内联 类型表 — §11.1 冻结) */
/* 决策史: 吞区间类型产生范围数据; 与 类型表 对齐, 扩容时同步 */
#define 目低 4096  /* 与 类型表[4096] 对齐; 类型表 扩容时同步 (2026-08-25 启元审计) */
静 整 左戊一[目低];    /* 范围下界 (-1=无界) */
静 整 半退三[目低];    /* 范围上界 (-1=无界) */
静 整 度散[目低]; /* 父类型 末丙 (-1=无) */

/* 5. 分析结果缓存 (逆向定律库 §8, LLVM NewPM 定律 2) — 任意变换后全失效 (实战定) */
/* 决策史: pass 框架雏形; 吞元编程(宏/CTFE)时产生分析数据 (定稿 §5.3③) */
typedef 构 { 整 末丙; 整 *结果一; 整 结果数; 整 净合; } 间再;
#define 尾午一 64 /* 预埋初始值: 激活前按 版本库 全量 通过/分析类型数实测校准 (2026-08-25 启元审计) */
静 间再 隔系一[尾午一]; 静 整 暂组;
静 整 左癸[尾午一][64]; /* 结果 指向 存储 行 (固定容量, 无 内存分配) */

/* 6. loopback 回边标记 (逆向定律库 §11) — 大哥 2026-09-01 拍板: 已加进 剩系 (循环回边标记, 优化器找循环) */
/* 决策史: 循环回边标记 — 大哥拍板后加进 剩系, 方便 AI 找循环 */

/* 7. EGraph 等价类映射 (定稿 §3.5①, egg/egglog POPL2021) — 哈希等价审判的正式化 */
/* 决策史: 哈希等价审判正式化 (egg/egglog); 中文重写规则驱动, 第三地基激活 */
#define 等类 100000  /* 预埋初始值: 激活前实测校准 */
静 整 等目[等类]; /* 值→等价类 id (union-find 风格) */
静 整 等点[等类];  /* 等价类→节点列表头 */

/* 8. 方言分层 (定稿 §3.5②, MLIR dialect) — 甲言三层 = 三层方言; 激活时实薄加方言字段按层下放 */
/* 决策史: 甲言三层架构 = 三层方言; 按层下放与三地基咬合 */
#define 方言 16
静 整 方层[方言]; /* 方言 id: 0=高级 1=中级 2=低级 */

/* 9. 结构化控制流 (定稿 §3.5③, MLIR scf) — 循环/条件保持结构化到后期下放 */
/* 决策史: 循环优化(LICM/展开)的结构地基; 循环后期下放不提前压平 */
#define 构控 100000
静 整 控式[构控]; /* 0=普通 1=循环 2=条件 3=分支 */

/* 10. 逐遍 IR 快照 (定稿 §3.6④) — 哈希审判从端到端 → 逐遍 */
/* 决策史: AI 写优化器 10 分钟试错 → 30 秒定位 (哈希审判逐遍化) */
#define 照容 64  /* 预埋初始值: 激活前实测校准 */
静 字 照散[照容][65];  /* 每个遍后的 IR 哈希 (64 十六进制) */

/* 11. IR 不变量断言表 (定稿 §3.6⑤) — IR 层借用检查器 */
/* 决策史: 结构位不变量写成可检查断言 — AI 改 IR 立即反馈 (IR 层借用检查器) */
#define 变容 64
typedef 构 { 整 (*检查)(空); 常 字 *名; } 不变构;
静 不变构 不变表[变容]; 静 整 不变数;

/* 12. IR 语义导航 (定稿 §3.6⑥) — AI 的结构位地图 */
/* 决策史: 结构位地图 + 决策记忆可查询 (定稿 §3.6⑥ + §5.4.5③) */
#define 导容 64
typedef 构 { 常 字 *名; 整 定义行; 整 用次; 常 字 *决策因; } 导构;
静 导构 导表[导容]; 静 整 导数;

/* 13. IR 等价性查询 (定稿 §3.7⑦) — 改对了没判断器 */
/* 决策史: LLM 改 pass 立即验证语义等价 (改对了没判断器) */
#define 等容 64
typedef 构 { 整 甲号; 整 乙号; 整 是否等; 整 差数; } 等构;
静 等构 等表[等容]; 静 整 等价数;

/* 14. 错误信息 IR 增强 (定稿 §3.7⑧) — 调试回路压缩 */
/* 决策史: 错误带 IR 上下文 + 修复建议 — LLM debug 回路 5 次→1-2 次 */
#define 错容 64
typedef 构 { 整 错码; 整 块号; 整 指序; 常 字 *提示; } 错构;
静 错构 错表[错容]; 静 整 错数;

/* 15. 中文 IR 双语导出 (定稿 §3.7⑨) — 心智切换归零 */
/* 决策史: 中文 IR ↔ 英文 IR 一键切换 = token 效率设计指标 (定稿 §5.4.2) */
#define 双语 256
typedef 构 { 常 字 *中; 常 字 *英; } 双构;
静 双构 双表[双语]; 静 整 双录;

/* ==== R0 缺口补齐 (2026-09-03 虾米, 依据《IR层预埋方案_特性对比》修订版 P0/P1/P2 12 项) ====
   纪律: 纯结构位 + 零引用 → BSS 分离加载不落盘 → 自举 fixpoint hash 不变 = 零占用守锚 */
/* 16. 类型表达式侧表 (P0-1, #52 依赖类型/#74 类型级编程 IR 化) — 类型即值: 节点 {算子, 类型序, 左右子} */
#define 型达容 65536
typedef 构 { 整 算子; 整 型序; 整 子达一; 整 子达二; 整 求值; } 型达节;
静 型达节 型达[型达容]; 静 整 型达数;
/* 17. 现高 属性位扩容常量 (P0-2, 溢出/#88 COW/#9 Copy) — 高8位值级属性位掩码, 激活时并入 现高 */
#define 满裂位 8   /* 溢出检查位 (特性 #33) */
#define 写时位 16  /* COW 位 (特性 #88) */
#define 拷贝位 32  /* Copy 位 (特性 #9) */
/* 18. sum type 变体布局表 (P0-3, #39 ADT 真独立布局) — 定义已移前至 借用检查区 (R1-B 锤A 2026-09-04 真激活, 判载名 并行) */
/* 19. fiber 实例池 (P1-1, #13/18 协程/#56 生成器/#20 异步 共用根) — 动态分配+回收+嵌套 */
#define 纤则容 1024
typedef 构 { 整 状态; 整 栈基; 整 栈顶; 整 回点; 整 帧序; 整 让出数; } 纤则录;
静 纤则录 纤则[纤则容]; 静 整 纤则数; 静 整 纤空闲;
/* 20. 异常表 + 帧回卷检查点 (P1-2, #55/#80 异常 + #8 RAII + #53 defer 共用) — try 区域→捕获 + unwind 清理 */
#define 卸台容 4096
typedef 构 { 整 区始; 整 区终; 整 捕获块; 整 清理序; 整 帧深; } 卸台录;
静 卸台录 卸台[卸台容]; 静 整 卸台数;
/* 21. 通道/邮箱对象表 (P1-3, #14 通道/#19 actor) — 类型参数化 + close + 锁 */
#define 道腔容 1024
typedef 构 { 整 元素尺寸; 整 容量; 整 头; 整 尾; 整 关闭标; 整 锁标; 整 端类型; } 道腔录;
静 道腔录 道腔[道腔容]; 静 整 道腔数;
/* 22. 调度器就绪队列 (P1-4, #20 异步/#24 select) — 就绪队列替代手动 pump */
#define 待列容 4096
typedef 构 { 整 任务序; 整 优先级; 整 状态; 整 通道序; } 待列目;
静 待列目 待列[待列容]; 静 整 待列头; 静 整 待列尾; 静 整 待列数;
/* 23. 别名分析 points-to 图 (P2-1, #36 restrict) — 源变量 → 目标集 (借用检查别名表 已覆盖 #3, 此为 IR 层 points-to) */
#define 达集容 65536
typedef 构 { 整 源变; 整 目标变; 整 下一; 整 场域; } 达集录;
静 达集录 达集[达集容]; 静 整 达集头[4096]; 静 整 达集数;
/* 24. IR attribute 表 (P2-2, #94 属性: packed/aligned/noreturn/format 落 IR 元数据) */
#define 性录容 1024
typedef 构 { 整 目标; 整 类型序; 整 名序; 整 参值; 整 参二; } 性录目;
静 性录目 性录[性录容]; 静 整 性录数;
/* 25. IR 元组类型 (P2-3, #58 多返回值) — 成员类型索引链 */
#define 组达容 4096
typedef 构 { 整 成员数; 整 首成员; 整 总尺寸; 整 对齐; } 组达录;
typedef 构 { 整 类型序; 整 下一; } 组成员;
静 组达录 组达[组达容]; 静 组成员 组成员表[组达容 * 4]; 静 整 组达数;
/* 26. 资源登记统一表 (P2-4, #86 泄漏检测 覆盖 arena/Rc/mmap) */
#define 资录容 1024
typedef 构 { 整 资源类型; 整 指针; 整 清理序; 整 栈深; 整 活动标; } 资录目;
静 资录目 资录[资录容]; 静 整 资录数;
/* 27. 模式匹配决策树/跳表 (P2-5, #40) — 判别字段→跳表/决策链 (文本级 对照 脱糖 if 链的 IR 化) */
#define 跃表容 65536
typedef 构 { 整 判别序; 整 值低; 整 值高; 整 载荷偏; 整 目标块; 整 下一; } 跃表目;
静 跃表目 跃表[跃表容]; 静 整 跃表数;
#endif /* 前亥一 */

/* ==== -图 旁路导出 (阶段零 工具侧闭环: graph_query.py 查询, 2026-08-25) ====
   旁路: 不插桩不影响编译行为, 仅编译完成后遍历 函数表/类型表 + 调用记录导出 数据格式 */
静 整 旧又二 = 0; 静 字 末高[512] = "";
#define 空丙 20000
静 字 副薄[空丙][64]; 静 字 中二[空丙][64]; 静 整 外平;
静 空 原肆(常 字 *尾捌) {
    若 (!旧又二 || !当前函数名[0] || 外平 >= 空丙) 返;
    遍 (整 计 = 0; 计 < 外平; 计++) /* 去重: 同一 自→到 只记一次 (防 4000 上限被重复调用占满截断, 2026-08-25) */
        若 (!比较字符串(副薄[计], 当前函数名) && !比较字符串(中二[计], 尾捌)) 返;
    复制字符串(副薄[外平], 当前函数名);
    复制字符串(中二[外平], 尾捌);
    外平++;
}
静 空 副寅一(空) {
    若 (!旧又二 || !末高[0]) 返;
    FILE *文件 = 打开文件(末高, "wb");
    若 (!文件) { 输出到文件(错误流, "qcc_x86: 无法写入图 %s\n", 末高); 返; }
    整 首 = 1;
    输出到文件(文件, "{\n\"entities\": [\n");
    遍 (整 计 = 0; 计 < 函数数; 计++) { 若 (!首) { 输出到文件(文件, ",\n"); } 首 = 0; 输出到文件(文件, "{\"id\":\"fn:%s\",\"name\":\"%s\",\"kind\":\"function\",\"line\":0}", 函数表[计].名, 函数表[计].名); }
    遍 (整 计 = 0; 计 < 类型数; 计++) {
        若 (!首) { 输出到文件(文件, ",\n"); } 首 = 0;
        输出到文件(文件, "{\"id\":\"st:%s\",\"name\":\"%s\",\"kind\":\"struct\",\"line\":0,\"fields\":[", 类型表[计].名, 类型表[计].名);
        遍 (整 乙 = 0; 乙 < 类型表[计].函; 乙++)
            输出到文件(文件, "\"%s\"%s", 类型表[计].字段[乙].正辰, 乙 + 1 < 类型表[计].函 ? "," : "");
        输出到文件(文件, "]}");
    }
    输出到文件(文件, "\n],\n\"relations\": [\n");
    首 = 1;
    遍 (整 计 = 0; 计 < 外平; 计++) { 若 (!首) { 输出到文件(文件, ",\n"); } 首 = 0; 输出到文件(文件, "{\"from\":\"fn:%s\",\"to\":\"fn:%s\",\"kind\":\"calls\"}", 副薄[计], 中二[计]); }
    输出到文件(文件, "\n],\n\"layout_sensitive\": [\n");
    首 = 1;
    遍 (整 计 = 0; 计 < 类型数; 计++) {
        若 (!首) { 输出到文件(文件, ",\n"); } 首 = 0;
        常 字 *缺分; /* 缺分 阈值 (2026-08-25 审计定): 字段≥8 或 大小≥64 = 高; 字段≥4 或 大小≥32 = medium; 否则 低 */
        若 (类型表[计].函 >= 8 || 类型表[计].尺寸 >= 64) 缺分 = "high";
        否 若 (类型表[计].函 >= 4 || 类型表[计].尺寸 >= 32) 缺分 = "medium";
        否 缺分 = "low";
        输出到文件(文件, "{\"type\":\"st:%s\",\"name\":\"%s\",\"fields\":%d,\"risk\":\"%s\"}", 类型表[计].名, 类型表[计].名, 类型表[计].函, 缺分);
    }
    输出到文件(文件, "\n]\n}\n");
    关文件(文件);
    输出到文件(错误流, "[graph] %s 导出完成 (函:%d 构一:%d 调用:%d)\n", 末高, 函数数, 类型数, 外平);
}

/* ==== 阶段 4 哈希审判: 哈希-256 自举自证 (编译器编译完自动算产物哈希对账不动点, fail-已闭; 补记13 法官上岗) ==== */
静 无 整 计零[64] = {0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
静 无 整 顺又(无 整 亥, 整 数) { 返 (亥 >> 数) | (亥 << (32 - 数)); }
静 空 右序(无 整 首一[8], 常 无 字 *指) {
    无 整 戌[64], 甲, 发字节, 字符, 元, 终, 文件, 庚, 初肆, 计, 虚利, 串七;
    遍 (计 = 0; 计 < 16; 计++) 戌[计] = ((无 整)指[计*4] << 24) | ((无 整)指[计*4+1] << 16) | ((无 整)指[计*4+2] << 8) | 指[计*4+3];
    遍 (计 = 16; 计 < 64; 计++) 戌[计] = 戌[计-16] + (顺又(戌[计-15], 7) ^ 顺又(戌[计-15], 18) ^ (戌[计-15] >> 3)) + 戌[计-7] + (顺又(戌[计-2], 17) ^ 顺又(戌[计-2], 19) ^ (戌[计-2] >> 10));
    甲 = 首一[0]; 发字节 = 首一[1]; 字符 = 首一[2]; 元 = 首一[3]; 终 = 首一[4]; 文件 = 首一[5]; 庚 = 首一[6]; 初肆 = 首一[7];
    遍 (计 = 0; 计 < 64; 计++) {
        虚利 = 初肆 + (顺又(终, 6) ^ 顺又(终, 11) ^ 顺又(终, 25)) + ((终 & 文件) ^ (~终 & 庚)) + 计零[计] + 戌[计];
        串七 = (顺又(甲, 2) ^ 顺又(甲, 13) ^ 顺又(甲, 22)) + ((甲 & 发字节) ^ (甲 & 字符) ^ (发字节 & 字符));
        初肆 = 庚; 庚 = 文件; 文件 = 终; 终 = 元 + 虚利; 元 = 字符; 字符 = 发字节; 发字节 = 甲; 甲 = 虚利 + 串七;
    }
    首一[0] += 甲; 首一[1] += 发字节; 首一[2] += 字符; 首一[3] += 元; 首一[4] += 终; 首一[5] += 文件; 首一[6] += 庚; 首一[7] += 初肆;
}
静 空 链伍(常 字 *路径, 字 出[65]) {
    无 整 首一[8]; 无 字 缓[64], 容吉[128]; 整 计, 乙, 数, 参数数;
    无 长 长 链玖 = 0, 符弊; FILE *文件 = 打开文件(路径, "rb");
    首一[0]=0x6a09e667; 首一[1]=0xbb67ae85; 首一[2]=0x3c6ef372; 首一[3]=0xa54ff53a; 首一[4]=0x510e527f; 首一[5]=0x9b05688c; 首一[6]=0x1f83d9ab; 首一[7]=0x5be0cd19;
    若 (!文件) { 出[0] = 0; 返; }
    循环 ((数 = (整)读取(缓, 1, 64, 文件)) == 64) { 右序(首一, 缓); 链玖 += 64; }
    复制内存(容吉, 缓, 数); 参数数 = 数; 容吉[参数数++] = 0x80;
    循环 ((参数数 & 63) != 56) 容吉[参数数++] = 0;
    符弊 = (链玖 + (无 长 长)数) * 8;
    遍 (计 = 0; 计 < 8; 计++) 容吉[参数数++] = (无 字)(符弊 >> (56 - 8 * 计));
    遍 (计 = 0; 计 < 参数数; 计 += 64) 右序(首一, 容吉 + 计);
    关文件(文件);
    遍 (计 = 0; 计 < 8; 计++) 遍 (乙 = 0; 乙 < 4; 乙++) {
        无 整 反挂 = (首一[计] >> (24 - 8 * 乙)) & 0xFF;
        出[计 * 8 + 乙 * 2] = "0123456789abcdef"[反挂 >> 4];
        出[计 * 8 + 乙 * 2 + 1] = "0123456789abcdef"[反挂 & 15];
    }
    出[64] = 0;
}

/* 接入 2026-08-28 甲序原生 #5: 文件级哈希增量编译 — 内存 SHA256 (缓存键) + 文件拷贝 + sidecar 缓存读写 */
静 空 深伴(常 字 *数据, 整 长度一, 字 出[65]) {
    无 整 首一[8]; 无 字 容吉[128]; 整 计, 乙, 数, 参数数; 无 长 长 链玖 = 0, 符弊;
    首一[0]=0x6a09e667; 首一[1]=0xbb67ae85; 首一[2]=0x3c6ef372; 首一[3]=0xa54ff53a; 首一[4]=0x510e527f; 首一[5]=0x9b05688c; 首一[6]=0x1f83d9ab; 首一[7]=0x5be0cd19;
    循环 (长度一 >= 64) { 右序(首一, (常 无 字 *)数据); 数据 += 64; 长度一 -= 64; 链玖 += 64; }
    数 = 长度一; 复制内存(容吉, 数据, 数); 参数数 = 数; 容吉[参数数++] = 0x80;
    循环 ((参数数 & 63) != 56) 容吉[参数数++] = 0;
    符弊 = (链玖 + (无 长 长)数) * 8;
    遍 (计 = 0; 计 < 8; 计++) 容吉[参数数++] = (无 字)(符弊 >> (56 - 8 * 计));
    遍 (计 = 0; 计 < 参数数; 计 += 64) 右序(首一, 容吉 + 计);
    遍 (计 = 0; 计 < 8; 计++) 遍 (乙 = 0; 乙 < 4; 乙++) {
        无 整 反挂 = (首一[计] >> (24 - 8 * 乙)) & 0xFF;
        出[计 * 8 + 乙 * 2] = "0123456789abcdef"[反挂 >> 4];
        出[计 * 8 + 乙 * 2 + 1] = "0123456789abcdef"[反挂 & 15];
    }
    出[64] = 0;
}
静 整 池薄一(常 字 *堆乙, 常 字 *整汇) { 字 *元 = 逆平一(堆乙); 若 (!元) 返 0; 整 数 = (整)取字长(元); FILE *文件 = 打开文件(整汇, "wb"); 若 (!文件) { 释放内存(元); 返 0; } 整 戌 = (整)写入(元, 1, 数, 文件); 关文件(文件); 释放内存(元); 返 戌 == 数; }
静 空 短浅(常 字 *输出文件, 字 *缓, 整 终凶) { 拷贝前n(缓, 输出文件, 终凶 - 8); 缓[终凶 - 8] = 0; 拼接(缓, ".qcckey"); }
静 整 旧三(常 字 *输出文件) { 字 缓甲[540]; 短浅(输出文件, 缓甲, 大小(缓甲)); 字 *键 = 逆平一(缓甲); 若 (!键) 返 0; 整 央 = !比较字符串(键, 双降); 释放内存(键); 返 央; }
静 空 满贰一(常 字 *输出文件) { 字 缓甲[540]; 短浅(输出文件, 缓甲, 大小(缓甲)); FILE *文件 = 打开文件(缓甲, "wb"); 若 (文件) { 写入(双降, 1, 64, 文件); 关文件(文件); } }

/* 接入 2026-08-28 甲序原生 #6 (可吞清单 阶段零-6): 编译检查点 — 崩溃尸检 post-mortem (进度快照落盘, 数据留底不死不灭; Turn 阶段零-4 快照的 编译器 版) */
静 空 长叁(常 字 *行一) { 若 (!堆低一 || !暂寅[0]) 返; FILE *文件 = 打开文件(暂寅, "ab"); 若 (!文件) 返; 写入(行一, 1, 取字长(行一), 文件); 写字符('\n', 文件); 刷新缓冲(文件); 关文件(文件); } /* 每条快照独立开/写/刷/关 — 崩溃时已刷盘的行即现场 (缓冲丢失=尸检失效) */

/* 接入 2026-08-28 甲序原生 9b: 编译器资源护栏 — 编译期水位报告 (甲序 可读 数据格式, 可吞清单 阶段零-9b) */
静 整 初汇 = 0; /* --budget */
/* 接入 2026-08-28 可吞清单 阶段零-9: 编译 DAG 重放证明 — 过程级哈希 (源码→词元→抽象语法树→产物 每阶段哈希入链, 编译过程可重放可验证; 自举证明从产物级升级为过程级) */
静 空 内巳(空) { 若 (!总置) 返; 字 首利二[65], 计简一[65], 反对一[65], 计低[65], 终再[300]; 若 (词序 > 0) 深伴((常 字*)词型表, 词序 * 4, 首利二); 否 复制字符串(首利二, "0"); 若 (词序 > 0) 深伴((常 字*)词值表, 词序 * 4, 计简一); 否 复制字符串(计简一, "0"); 若 (词序 > 0) 深伴((常 字*)词名表, 词序 * 64, 反对一); 否 复制字符串(反对一, "0"); 若 (词序 > 0) 深伴((常 字*)词行表, 词序 * 4, 计低); 否 复制字符串(计低, "0"); 格式化到串(终再, "%s%s%s%s", 首利二, 计简一, 反对一, 计低); 深伴(终再, 256, 素细); }
静 空 暂卯(空) { 若 (!总置) 返; 字 首利二[65], 计简一[65], 反对一[65], 计低[65], 满肆[65], 终再[340];
    若 (接子数 > 0) 深伴((常 字*)节型表, 接子数 * 4, 首利二); 否 复制字符串(首利二, "0");
    若 (接子数 > 0) 深伴((常 字*)节值表, 接子数 * 4, 计简一); 否 复制字符串(计简一, "0");
    若 (接子数 > 0) { 字 *新三 = 内存分配((长 长)接子数 * 64 + 16); 整 直失 = 0; 遍 (整 计 = 0; 计 < 接子数 && 直失 < (整)((长 长)接子数 * 64 - 16); 计++) { 整 段玖 = (整)取字长((字*)(节名表 + 计)); 复制内存(新三 + 直失, (字*)(节名表 + 计), 段玖); 直失 += 段玖; 新三[直失++] = 0x1F; } 深伴(新三, 直失, 反对一); 释放内存(新三); } 否 复制字符串(反对一, "0"); /* 节名表 按名哈希 (截 空字符): 节点名槽内部有 ASLR 相关历史尾字节 (功能无害, 码生成器 按 空字符 读) — 语义内容才入链, 保证确定性 */
    若 (接子数 > 0) 深伴((常 字*)子0, 接子数 * 4, 计低); 否 复制字符串(计低, "0");
    若 (接子数 > 0) 深伴((常 字*)子1, 接子数 * 4, 满肆); 否 复制字符串(满肆, "0");
    格式化到串(终再, "%s%s%s%s%s", 首利二, 计简一, 反对一, 计低, 满肆); 深伴(终再, 320, 直八);
}
/* 接入 2026-08-28 可吞清单 阶段一 (MoonBit #4 接口文件 + Agint #14 结构化工件): 接口文件导出 — --接口 解析后导出 API 表面 数据格式 (甲序 读接口不读实现, 直击 SWE-AGI '读代码瓶颈') */
静 整 暂厚 = 0; /* --接口 */
静 常 字 *帧得(整 变序) { 若 (变量表[变序].是否浮标) 返 "double"; 若 (变量表[变序].是否长标) 返 "longlong"; 若 (变量表[变序].是否字符标) 返 "char"; 若 (变量表[变序].无符号标) 返 "unsigned"; 若 (变量表[变序].指元素尺寸 > 0) 返 "ptr"; 若 (变量表[变序].型序标 >= 0) 返 "struct"; 若 (变量表[变序].数组尺寸 > 0) 返 "array"; 返 "int"; }
静 常 字 *现序(常 字 *函) { 整 实卯 = 查返回名(函); 若 (实卯 >= 0) { 静 字 总五[96]; 格式化到串(总五, "struct %s", 类型表[实卯].名); 返 总五; } 若 (查返回名指(函)) 返 "ptr"; 若 (查函数长返(函)) 返 "longlong"; 若 (查函数浮返(函)) 返 "double"; 返 "int"; }
静 空 容一(空) { /* 接口文件 (甲序 可消费 数据格式): 函数签名/参数/返回 + 结构体/类型定义/全局/枚举 — 解析期表导出, 不产码 */
    格式化打印("{\"interface\":{");
    格式化打印("\"functions\":[");
    整 总柒 = 1;
    遍 (整 计 = 0; 计 < 函数定义数; 计++) {
        整 字符 = 函数定义表[计];
        若 (字符 <= 0) 续;
        字 *函 = (字*)(节名表 + 字符);
        整 净乙三 = (计 < 65536) ? 新寅[计] : 0, 短进 = (计 < 65536) ? 总甲[计] : 0;
        格式化打印("%s{\"name\":\"%s\",\"defined\":true,\"line\":%d,\"params\":[", 总柒 ? "" : ",", 函, (计 < 1024) ? 号平[计] : 0);
        整 余系 = 0;
        遍 (整 变序 = 净乙三; 变序 < 短进 && 变序 >= 0; 变序++) 若 (变量表[变序].素三) { 格式化打印("%s{\"name\":\"%s\",\"type\":\"%s\"}", 余系 ? "," : "", 变量表[变序].名, 帧得(变序)); 余系++; }
        格式化打印("],\"ret\":\"%s\"}", 现序(函));
        总柒 = 0;
    }
    遍 (整 丁序 = 0; 丁序 < 声明数; 丁序++) { 整 余细 = 0; 遍 (整 计 = 0; 计 < 函数定义数; 计++) 若 (函数定义表[计] > 0 && !比较字符串((字*)(节名表 + 函数定义表[计]), 串升一[丁序])) { 余细 = 1; 断; } 若 (!余细) { 格式化打印("%s{\"name\":\"%s\",\"defined\":false}", 总柒 ? "" : ",", 串升一[丁序]); 总柒 = 0; } } /* 声明 声明未实现的骨架 */
    格式化打印("]");
    格式化打印(",\"structs\":[");
    整 反伴 = 1;
    遍 (整 构序 = 0; 构序 < 类型数; 构序++) {
        若 (类型表[构序].名[0] == 0 || 类型表[构序].尺寸 <= 0) 续;
        格式化打印("%s{\"name\":\"%s\",\"size\":%d,\"fields\":[", 反伴 ? "" : ",", 类型表[构序].名, 类型表[构序].尺寸);
        遍 (整 文件 = 0; 文件 < 类型表[构序].函; 文件++) 格式化打印("%s{\"name\":\"%s\",\"off\":%d,\"size\":%d%s}", 文件 ? "," : "", 类型表[构序].字段[文件].正辰, 类型表[构序].字段[文件].正聚, 类型表[构序].字段[文件].现捌, 类型表[构序].字段[文件].原进 ? ",\"ptr\":true" : "");
        格式化打印("]}");
        反伴 = 0;
    }
    格式化打印("]");
    格式化打印(",\"typedefs\":[");
    整 满庚 = 1;
    遍 (整 词序 = 0; 词序 < 型定数; 词序++) { 格式化打印("%s{\"name\":\"%s\",\"sz\":%d%s}", 满庚 ? "" : ",", 型定表[词序].名, 型定表[词序].尺寸, 型定表[词序].是否构标 ? ",\"struct\":true" : ""); 满庚 = 0; }
    格式化打印("]");
    格式化打印(",\"globals\":[");
    整 隔列 = 1;
    遍 (整 变序 = 0; 变序 < 变量数; 变序++) 若 (变量表[变序].是否静态标 && !静态关键[变序]) { 格式化打印("%s{\"name\":\"%s\",\"type\":\"%s\",\"size\":%d}", 隔列 ? "" : ",", 变量表[变序].名, 帧得(变序), 变量表[变序].指元素尺寸 > 0 ? 8 : (变量表[变序].数组尺寸 > 0 ? 变量表[变序].数组尺寸 : (变量表[变序].是否长标 || 变量表[变序].是否浮标) ? 8 : 变量表[变序].是否字符标 ? 1 : 4)); 隔列 = 0; }
    格式化打印("]");
    格式化打印(",\"enums\":[");
    整 主联 = 1;
    遍 (整 戊序 = 0; 戊序 < 暂肆; 戊序++) { 格式化打印("%s{\"name\":\"%s\",\"val\":%d}", 主联 ? "" : ",", 堆九一[戊序].名, 堆九一[戊序].数值); 主联 = 0; }
    格式化打印("]");
    格式化打印("}}\n");
}
/* 接入 2026-08-28 可吞清单 阶段一 (参考 MoonBit 语义导航, 甲言化: 引用收集): --引用 谁引用了 X — 原级 词变量 名 词元 处记录 (名, 用户行), 读/写/调用全覆盖; 甲序 查调用点/使用点不翻全文件 */
静 整 双贰 = 0; 静 构 { 字 名[64]; 整 堆丑[64]; 整 数; } refs[4096];
静 空 标进(常 字 *数, 整 行一) { /* 引用登记 (按名去重, 行去重) */
    若 (!新六 || !数 || !数[0]) 返;
    整 度转 = 行一 - (剩伴 ? 剩伴 : 反进); 若 (度转 < 1) 度转 = 1;
    遍 (整 计 = 0; 计 < 双贰; 计++) 若 (!比较字符串(refs[计].名, 数)) {
        遍 (整 键 = 0; 键 < refs[计].数; 键++) 若 (refs[计].堆丑[键] == 度转) 返;
        若 (refs[计].数 < 64) refs[计].堆丑[refs[计].数++] = 度转;
        返;
    }
    若 (双贰 < 4096) { 复制字符串(refs[双贰].名, 数); refs[双贰].堆丑[0] = 度转; refs[双贰].数 = 1; 双贰++; }
}
静 空 总升一(空) { /* 引用表导出 (甲序 可消费 数据格式): {"引用":[{"名":"X","堆丑":[行,...]},...]} */
    格式化打印("{\"refs\":[");
    遍 (整 计 = 0; 计 < 双贰; 计++) {
        格式化打印("%s{\"name\":\"%s\",\"sites\":[", 计 ? "," : "", refs[计].名);
        遍 (整 键 = 0; 键 < refs[计].数; 键++) 格式化打印("%s%d", 键 ? "," : "", refs[计].堆丑[键]);
        格式化打印("]}");
    }
    格式化打印("]}\n");
}
/* 接入 2026-08-28 可吞清单 阶段一 (Agint flight-recorder 参考, 甲言化: 编译黑匣子): 每函数代码增量哈希帧 — 自举分歧时逐帧 差异 定位首个分歧函数 (黑匣子只读记录, 数据留底不死不灭); 全局声明在顶部 (生成码 用) */
静 空 段弊(常 字 *行一) { 若 (!整再 || !元零[0]) 返; FILE *文件 = 打开文件(元零, "ab"); 若 (!文件) 返; 写入(行一, 1, 取字长(行一), 文件); 写字符('\n', 文件); 刷新缓冲(文件); 关文件(文件); } /* 独立开/写/刷/关 — 崩溃时已刷盘行即现场 */
静 空 存重(常 字 *函) { /* 每函数代码增量哈希帧: sha256(代码[帧又..码位)) — 增量 O(n) 总量, 分歧定位到函数级 */
    若 (!整再) 返;
    整 目壹一 = 码位;
    若 (目壹一 > 帧又) {
        字 首一[65]; 深伴((常 字*)码 + 帧又, 目壹一 - 帧又, 首一);
        字 原降[160]; 格式化到串(原降, "{\"pass\":%d,\"fn\":\"%s\",\"delta\":\"%.16s\",\"cp\":%d}", 素凶, 函, 首一, 目壹一);
        段弊(原降);
    }
    帧又 = 目壹一;
}

/* 接入 2026-08-28 甲序原生 9b: 编译器资源护栏 — 编译期水位报告 (甲序 可读 数据格式, 可吞清单 阶段零-9b) */
静 空 存八(空) {
    格式化打印("{\"budget\":["
      "{\"name\":\"macros\",\"used\":%d,\"cap\":4096},"
      "{\"name\":\"fn_macros\",\"used\":%d,\"cap\":2048},"
      "{\"name\":\"obj_macros\",\"used\":%d,\"cap\":8192},"
      "{\"name\":\"funcs\",\"used\":%d,\"cap\":65536},"
      "{\"name\":\"vars\",\"used\":%d,\"cap\":65536},"
      "{\"name\":\"tokens\",\"used\":%d,\"cap\":%d},"
      "{\"name\":\"ast_nodes\",\"used\":%d,\"cap\":%d},"
      "{\"name\":\"labels\",\"used\":%d,\"cap\":131072},"
      "{\"name\":\"strings\",\"used\":%d,\"cap\":65536},"
      "{\"name\":\"typedefs\",\"used\":%d,\"cap\":512},"
      "{\"name\":\"discriminants\",\"used\":%d,\"cap\":256},"
      "{\"name\":\"borrowed\",\"used\":%d,\"cap\":256},"
      "{\"name\":\"moved\",\"used\":%d,\"cap\":256},"
      "{\"name\":\"declares\",\"used\":%d,\"cap\":256}"
      "]}\n",
      宏数, 函数宏数, 栈凶, 函数数, 变量数, 词序, 词容量, 接子数, 节容量, 初成, 串数, 深平, 链平, 素寅, 正次, 声明数);
}

/* 接入 2026-08-28 甲序原生编译器 #6 可重入无状态核心 (大哥定 地基打桩第二桩): 编译核心函数化 — 每次调用独立分配 词元/抽象语法树 数组 + 独立编译, 同进程可多次调用 (编译服务器/增量/并行前置) */
字 *堆辛(常 字 *源) { /* 可嵌入: 运行时 拼接封装 (修复 2026-08-28 大哥验收: 复位 清宏 + 时序 → 运行时 守卫失效 → 运行时 实现剃光 → 嵌入产物缺代码段崩) — 主 与 qcc_embed_driver 共用; 多路径搜索: 相对 cwd + 可执行文件目录 (前巳一 GetModuleFileName) */
    字 *度退 = 逆平一("srclib/qcc_rt.c");
    若 (!度退) 度退 = 逆平一("qcc_rt.c");
    若 (!度退) { 字 标未[1024]; 双字 邻壬 = GetModuleFileNameA(NULL, 标未, 1023); 若 (邻壬 > 0) { 字 *槽长 = 反向查(标未, '/'); 字 *余庚 = 反向查(标未, '\\'); 字 *末一 = 槽长 && 余庚 ? (槽长 > 余庚 ? 槽长 : 余庚) : (槽长 ? 槽长 : 余庚); 若 (末一) { *末一 = 0; 字 外庚[1024]; 复制字符串(外庚, 标未); 拼接(外庚, "/srclib/qcc_rt.c"); 度退 = 逆平一(外庚); 若 (!度退) { 复制字符串(外庚, 标未); 拼接(外庚, "/qcc_rt.c"); 度退 = 逆平一(外庚); } } } }
    若 (!度退) { /* C138 (2026-09-20 第 138 站): 环境变量 QCC_RT_PATH 显式指定 (最高 优先 于 路径 猜测) */
        字 *环庚 = 取环境("QCC_RT_PATH");
        若 (环庚 && 环庚[0]) 度退 = 逆平一(环庚);
    }
    若 (!度退) { /* C138: **命令行 首词** 取 可执行文件 路径 ⟹ exe 目录 下 找 运行库.
   病灶 (第 137 站 追到底): `GetModuleFileNameA` **未 在 内核库 导入槽 表** (`左己[34]`, 槽号 = 表索引) ⟹ 调用 它 落到 错误 槽 ⟹ 恒 失败 ⟹ **cwd 不在 仓库目录 时 运行库 静默 不 prepend** (实测 产物 7592 字节 vs 149507 字节) ⟹ 变量除法 缺 `__qcc_div_check64` ⟹ 0xC0000094 除零崩.
   改用 **已 有 槽 7** 的 `GetCommandLineA` (Windows 命令行 首词 = 可执行文件 路径, 带引号 时 剥引号). */
        字 *命一 = GetCommandLineA();
        若 (命一) {
            字 路一[1024]; 整 键五 = 0; 整 明五 = 0;
            循环 (命一[键五] == ' ' || 命一[键五] == '\t') 键五++;
            若 (命一[键五] == '"') { 键五++; 循环 (命一[键五] && 命一[键五] != '"' && 明五 < 1023) 路一[明五++] = 命一[键五++]; }
            否 { 循环 (命一[键五] && 命一[键五] != ' ' && 命一[键五] != '\t' && 明五 < 1023) 路一[明五++] = 命一[键五++]; }
            路一[明五] = 0;
            若 (明五 > 0) {
                字 *末二 = 反向查(路一, '/'); 字 *末三 = 反向查(路一, '\\');
                字 *末四 = 末二 && 末三 ? (末二 > 末三 ? 末二 : 末三) : (末二 ? 末二 : 末三);
                若 (末四) {
                    *末四 = 0;
                    字 外辛[1100]; 复制字符串(外辛, 路一); 拼接(外辛, "/srclib/qcc_rt.c");
                    度退 = 逆平一(外辛);
                    若 (!度退) { 复制字符串(外辛, 路一); 拼接(外辛, "/qcc_rt.c"); 度退 = 逆平一(外辛); }
                }
            }
        }
    }
    若 (!度退) { 输出到文件(错误流, "[警告] 运行库 qcc_rt.c 未找到 (cwd / exe 目录 均 无) —— 除法除零检查 (__qcc_div_check64) / 异常 / 所有权 等 运行时特性 将 缺失; 设 环境变量 QCC_RT_PATH 指向 该文件 可 修复 (第 138 站 C138)\n"); 返 NULL; }
    整 旁戊 = (整)取字长(度退);
    串双 = 旁戊; /* 2026-08-28 位置.行: 运行时 长度 (解析 前算 剩伴) */
    整 累加低 = (整)取字长(源);
    宏加("QCC_RT_PREPENDED", 1); /* 标记 运行时 已预置 — 运行时库.c 守卫认此宏 */
    反进 = 1; 遍 (整 原排 = 0; 原排 < 旁戊; 原排++) 若 (度退[原排] == '\n') 反进++; /* 行号校正 */
    字 *元二一 = 内存分配((旁戊 + 累加低 + 5 + 16) & ~3);
    复制内存(元二一, 度退, 旁戊);
    元二一[旁戊] = '\n';
    复制内存(元二一 + 旁戊 + 1, 源, 累加低);
    元二一[旁戊 + 1 + 累加低] = 0;
    释放内存(度退);
    返 元二一;
}
静 空 终子(空) { /* 接入 2026-08-28 甲序原生 #6: 重置跨编译累积的静态全局表 (解析 已重置 词位/变量数/函数定义数/词型表 等; 这里补宏/类型/字符串/函数/机制层/静态槽/位域/声明/枚举/类型定义/判别/双精度表) */
    宏数 = 0; 函数宏数 = 0; 栈凶 = 0; 全局初始化数 = 0; 函数数 = 0; 串数 = 0; 虚五 = 0; 类型数 = 0;
    静态数 = 0; 位槽 = -1; 位位 = 0; /* 静态 槽计数 + 位域打包状态 — 跨编译累积必须重置 */
    声明数 = 0; 深平 = 0; 暂肆 = 0; 链平 = 0; 型定数 = 0; 浮数 = 0; /* 声明声明表 + 类型定义名 + 枚举常量 + 判别表 + 类型定义定义 + 双精度常量表 */
    顺一 = 0; 条件计数 = 0; 外系 = 0; 条件编译数 = 0; /* 词法 预处理条件编译栈 */
    净乙 = 0; /* 修复 2026-08-28 可重入根因: 变量总数() = 净乙?净乙:变量数 — 净乙 残留(上次 码生成器 的 总甲[剩回]) → 第二次 解析 期 变量偏移 REUSE 搜索越界 → 复用 变量[169] 超出 变量数 → 码生成器 DCL-MISS。解析 期必须 净乙=0 (变量总数()=变量数) */
    素寅 = 0; 计贰 = 0; 正次 = 0; 首己 = 0; 目系 = 0; 目凶一 = 0; 遍 (整 首戌 = 0; 首戌 < 256; 首戌++) 借用表[首戌].末用 = -1; /* 2026-08-28 类型-根-3 节长标: 复位 */
    净丙 = 0; 旧辛 = 0; 序集 = 0; 逆汇 = 0; 遍 (整 序 = 0; 序 < 65536; 序++) { 变量表[序].就绪丙 = 0; 变量表[序].就绪阵丙 = 0; } /* A3-4a/4b: 尾进/尾阵 簇 退役 → 就绪丙/就绪阵丙 哨兵 全清 (替代 原 顺汇=0/尾阵数 计数重置; 防 跨编译 残留) */ 内存设置(静默计数, 0, 大小(静默计数)); /* 第0刀 报警器: 每编译 清零 */
    虚陆 = 0; 缺五 = 0; 直十 = 0; 实二 = -1; 可空槽数 = 0; 可空针 = 0;
    错误函数 = 0; 外优 = 0; 满从 = -1; 右陆 = 0; 当申 = 0; 内存设置(实重, 0, 大小(实重)); 长八 = 0; /* 类型-根-7 #101 */ 列散 = 0; 实现数 = 0; /* 类型-根-8 #114 */ 计退 = 0; 内存设置(目肆, 0, 大小(目肆)); /* 类型-根-10 #278 */ 列散 = 0; 实现数 = 0; /* 类型-根-8 #114 */ /* 2026-08-28 类型-根-2 */ /* 2026-08-28 类型-根-修复: 复位 待定 tok 亦 */ /* 类型根治① (2026-08-28): 可空表每编译重置 */
    内乙 = 2; 新集一 = 0; 余陆 = 0; 行巳 = 0; /* 修复 2026-08-28 可重入漏洞: 临时名/外部 槽计数器跨编译累积 — 外部 负偏移地址泄漏 + 临时名后缀漂移 → 进程内第 2 次编译产物 ≠ 第 1 次 (--重复 只验 2..N 自洽, 漏首 长简 次) */
    素凶 = 0; 帧又 = 0; /* 黑匣子: 通过 帧序每编译重置 (跨编译累积 → 分歧定位错帧) */
    虚己 = 0; 函浮数 = 0; 函返名数 = 0; 内丑一 = 0; 帧叁 = 0; 帧肆 = 0; 错误位数 = 0; 返宽数 = 0; 源午 = 0; 函返尺寸数 = 0; 支溢 = 0; /* 修复 2026-08-28 可重入: 函数签名名表跨编译累积 → 查函数长 命中旧条目 → 参数压栈选错 (中压栈rax 长简 中压栈64rax) → 进程内第 2 次编译产物 ≠ 第 1 次; P1 静默根治 (2026-09-15): 补 返宽/当利(变参)/中细(返回宽度) 三个 同族 名-keyed 表 的 每编译重置 — 原 漏重置 ⟹ 跨编译 只增 ⟹ 容量墙 被 推远 而 非 根治; 支溢 同 类 可重入 清零 */
    空失 = 0; 总得 = 0; 满己 = 0; /* 修复 2026-08-28 可重入: 中间表示 指令缓冲/目标文件 重定位残留 — 中刷 只在表达式末尾清, 若上次编译末尾有未 冲刷 中间表示 → 下次首个 冲刷 发射残留指令 (首个函数代码多指令) */
    双贰 = 0; /* 引用表每编译重置 */
    复制数 = 0; 行未 = 0; 线性数 = 0; 后劣 = 0; 枚底数 = 0; 标签循环数 = 0; 限止数 = 0; 结构化深度 = 0; 内存设置(结构化线程数, 0, 大小(结构化线程数)); /* A3-子表 清剿 (2026-09-12): 标签循环 / restrict 占用 / 结构化线程 三 个 登记表 同 上 可重入 类 —— 原 无 每编译 重置, 同 进程 第 二 次 编译 会 把 上次 的 标记 当 本次 的 */ /* A3-类型属性 可重入 (2026-09-12): T 标注 注册表 (复制/密封/线性/线程不安全/枚举底层) 跨编译 残留 — 第二次 编译 会 把 上次 的 标注 当 本次 的 (同 符转/契约指纹 的 可重入 类; 原 只 有 计数器 声明处 的 初值 0, 从无 重置) */
    左五 = 0; 末从 = -1; /* 修复 2026-08-28 可重入 (节长标 同类): 契约表/契约结构表跨编译残留 — 服务 多次请求同进程 → 上次注册的 前置 契约在本次误触发常量审判 → 假 A6002 → 编译失败 (e2e ⑤ 用户程序无库却带 整数除法 契约); A3-契约指纹 (2026-09-12): 契约指纹 已 迁 真结构 类型表[构序].契约印 → 本 处 的 符转=0 删除, 改 由 构加() 建新条目 时 置 空 (逐条目 清零, 位置 更 准) */
    内存设置(节浮标, 0, 大小(节浮标)); 内存设置(节长标, 0, 大小(节长标)); 内存设置(节长高, 0, 大小(节长高)); 内存设置(节无符号, 0, 大小(节无符号)); 内存设置(窄无符号, 0, 大小(窄无符号)); 内存设置(暂合, 0, 大小(暂合)); 内存设置(首甲二, 0, 大小(首甲二)); 内存设置(号汇一, 0, 大小(号汇一)); /* 修复 2026-08-31 生成器 s11: 转型 类型标记跨编译残留防护 (同 节长标/节无符号 可重入) */ /* 修复 2026-08-28 可重入根因: 逐节点类型标志静态数组 (节浮标/节长标/节长高/节无符号) 跨编译残留 — 接子数 每编译重置但数组内容不清 → run2 节点索引复用 run1 的 邻辰/双/无符号标志 → 整数 表达式被当 邻辰 (压栈64 替代 压栈寄存器) → 进程内第 2 次编译产物 ≠ 第 1 次 (历史同款: 注释 L17181 节长标 残留 → 绝对移动 → 短进≠值二 2-周期); 2026-08-30 暂合 同清; 2026-09-03 窄无符号 同清 */
}
/* ==================== G0-4 (2026-09-11) 编译期 结构化 转储 ====================
   门控: 环境变量 QCC_DUMP — 阶段 列表 (逗号/空格 分隔): 词元 / AST / 型 / 变量 / 函数 / 全
   输出: 错误流 — 调用示例: $env:QCC_DUMP="全"; qcc_zh_seed.exe x.c -o x.exe 2>dump.txt
   目的 (地2 G0-4): 替代 「插桩 print + 隐式新变量 陷阱」 老 调试法; 判据 = 任意源 可 dump 可读 结构。 */
静 整 转储含(常 字 *阶段) {
    字 *列 = 取环境("QCC_DUMP");
    若 (!列 || !列[0]) 返 0;
    若 (查找子串(列, "all") != NULL) 返 1; /* 注意: 查找子串 = strstr → 返 **指针** (未命中 返 空), 必须 用 != NULL 判 命中; `>= 0` 对 指针 恒真 (2026-09-11 教训: 首版 用 >= 0 → 阶段 过滤 失效, 全 阶段 恒 dump)。 阶段名 用 ASCII (中文 环境变量 经 msvcrt getenv 出来 是 ANSI 字节, 与 源码 UTF-8 字面量 比 不 相等) */
    若 (查找子串(列, 阶段) != NULL) 返 1;
    返 0;
}
静 空 转储词元(空) {
    输出到文件(错误流, "==== 词元流 %d 个 ====\n", 词序);
    遍 (整 计 = 0; 计 < 词序; 计++) {
        整 该行 = 词行表 ? 词行表[计] : 0;
        输出到文件(错误流, "词[%d] 行=%d 词型=%d 词值=%lld 名=%s\n", 计, 该行, 词型表[计], (长 长)词值表[计], 词名表[计]);
    }
}
静 空 转储AST节(整 节, 整 深) {
    若 (节 < 0 || 深 > 40) 返;
    整 该名 = 0; 若 ((字*)(节名表 + 节)) 该名 = 1;
    输出到文件(错误流, "节[%d] 深=%d 节型=%d 节型别=%d 值=%lld 浮=%d 长=%d 无符=%d 指元素=%d 名=%s\n", 节, 深, 节型表[节], 节型别[节], (长 长)节值表[节], 节浮标[节], 节长标[节], 节无符号[节], 指元素[节], 该名 ? (字*)(节名表 + 节) : "");
    遍 (整 支 = 0; 支 < 20; 支++) { 整 当子 = 取子(节, 支); 若 (当子 >= 0) 转储AST节(当子, 深 + 1); }
}
静 空 转储AST(空) {
    输出到文件(错误流, "==== 抽象语法树 (根=%d 节点数=%d 顶层函数=%d) ====\n", 副丑, 接子数, 函数定义数);
    转储AST节(副丑, 0);
    遍 (整 器 = 0; 器 < 函数定义数 && 器 < 1024; 器++) { 输出到文件(错误流, "-- 函数定义[%d] 节=%d\n", 器, 函数定义表[器]); 转储AST节(函数定义表[器], 1); }
}
静 空 转储型(空) {
    输出到文件(错误流, "==== 类型表 %d 条 ====\n", 类型数);
    遍 (整 计 = 0; 计 < 类型数; 计++) {
        输出到文件(错误流, "型[%d] %s 尺寸=%d 对齐=%d 字段数=%d 联=%d 打包=%d 可复制=%d\n", 计, 类型表[计].名, 类型表[计].尺寸, 类型表[计].满卯, 类型表[计].函, 类型表[计].是否联, 类型表[计].是否打包, 类型表[计].可复制);
        遍 (整 域 = 0; 域 < 类型表[计].函 && 域 < 1024; 域++) 输出到文件(错误流, "    域[%d] %s 偏移=%d 宽=%d 型序=%d 指针=%d 位引=%d 位宽=%d\n", 域, 类型表[计].字段[域].正辰, 类型表[计].字段[域].正聚, 类型表[计].字段[域].现捌, (整)类型表[计].字段[域].毛利, (整)类型表[计].字段[域].原进, 类型表[计].字段[域].间次一, (整)类型表[计].字段[域].符肆);
    }
}
静 空 转储变量(空) {
    输出到文件(错误流, "==== 变量表 %d 条 (解析基=%d 函数数=%d) ====\n", 变量数, 解析基, 函数数);
    遍 (整 计 = 0; 计 < 变量数; 计++) 输出到文件(错误流, "变[%d] %s 型序=%d 帧偏移=%d 数组=%d 元素=%d 指元素=%d 指深=%d 指内=%d 浮=%d 单=%d 字=%d 短=%d 无符=%d 长=%d 静=%d 可空=%d\n",
        计, 变量表[计].名, 变量表[计].型序标, 变量表[计].栈偏移, 变量表[计].数组尺寸, 变量表[计].数组元素尺寸, 变量表[计].指元素尺寸, 变量表[计].指深, 变量表[计].指内,
        变量表[计].是否浮标, 变量表[计].单标, 变量表[计].是否字符标, 变量表[计].是否短标, 变量表[计].无符号标, 变量表[计].是否长标, 变量表[计].是否静态标, 变量表[计].可空值标);
}
静 空 转储函数(空) {
    输出到文件(错误流, "==== 函数表 %d 条 ====\n", 函数数);
    遍 (整 计 = 0; 计 < 函数数; 计++) 输出到文件(错误流, "函[%d] %s 标号=%d 序布=%d 返构序=%d 间拆=%d 返接口=%d 返错=%d 返错码=%d 错码起=%d 错码数=%d\n",
        计, 函数表[计].名, 函数表[计].标号一, 函数表[计].序布, 函数表[计].返构序, 函数表[计].间拆, 函数表[计].返接口, 函数表[计].返错, 函数表[计].返错码, 函数表[计].错误码起点, 函数表[计].错误码数);
}
静 空 转储(空) {
    若 (!取环境("QCC_DUMP")) 返;
    若 (转储含("tokens")) 转储词元();
    若 (转储含("ast")) 转储AST();
    若 (转储含("types")) 转储型();
    若 (转储含("vars")) 转储变量();
    若 (转储含("funcs")) 转储函数();
    输出到文件(错误流, "==== 转储 完 (QCC_DUMP=%s) ====\n", 取环境("QCC_DUMP"));
}
整 现退一(常 字 *源, 常 字 *输出文件, 整 汇编模式) { /* 可嵌入: 直排 模式被外部驱动调用, 见 qcc_embed_driver.c; 非 静态 暴露为库 API */
    终子(); /* 可重入: 每次编译重置静态表 (数组在下方重新分配) */
    若 (!链接模式) { 字 *暂浅 = 堆辛(源); 若 (暂浅) 源 = 暂浅; } /* 运行时 拼接在 复位 之后 (修复 2026-08-28: 复位 的 宏数=0 清提前设的 QCC_RT_PREPENDED → 运行时 剃光 → 嵌入产物缺代码段崩); -c 模式不拼 运行时; 源 传纯用户源码 */
    若 (命宏数 > 0) 源 = 命宏前插(源); /* P0-3 根治 (2026-09-14): 命令行 -D 宏 于 终子() 复位 之后 前插 — 原 直写 数值宏表, 既 被 复位 清空 又 不参与 文本替换 (详见 命宏加 注释); -c 模式 同样 生效 (独立于 运行时拼接) */
    词型表 = 清零分配(词容量, 4); 词值表 = 清零分配(词容量, 4); 词名表 = 清零分配(词容量, 64); 节名表 = 清零分配(节容量, 64); 词行表 = 清零分配(词容量, 4); /* 词元 行号表 (接入 2026-08-28: 数据格式 诊断 位置.行) */
    词无符号表 = 清零分配(词容量, 4); /* 无符号-后缀 标志 (修复 2026-08-05) */
    词长表 = 清零分配(词容量, 4); /* 长整-长整-后缀 标志 (修复 2026-08-05) */
    段属 = 清零分配(词容量, 4); /* 长整-长整 字面量 高 32 符弊 (修复 2026-08-05) */
    节型表 = _va_alloc(节容量 * 4); 节型别 = _va_alloc(节容量 * 4); 节值表 = _va_alloc(节容量 * 4); 子0 = _va_alloc(节容量 * 4); 子1 = _va_alloc(节容量 * 4);
    遍 (整 短丑 = 0; 短丑 < 256; 短丑++) 顺分[短丑] = _va_alloc(节容量 * 4); /* 扩展子槽 n256..n511 (修复 2026-08-18: 大型函数体 > 256 语句) */
    节链 = _va_alloc(节容量 * 4); 遍 (整 丙序 = 0; 丙序 < 节容量; 丙序++) 节链[丙序] = -1; /* 溢出链指针 (修复 2026-08-18) */
    子2 = _va_alloc(节容量 * 4); 子3 = _va_alloc(节容量 * 4); 子4 = _va_alloc(节容量 * 4); 子5 = _va_alloc(节容量 * 4);
    子6 = _va_alloc(节容量 * 4); 子7 = _va_alloc(节容量 * 4); 子8 = _va_alloc(节容量 * 4); 子9 = _va_alloc(节容量 * 4);
    子10 = _va_alloc(节容量 * 4); 子11 = _va_alloc(节容量 * 4); 子12 = _va_alloc(节容量 * 4); 子13 = _va_alloc(节容量 * 4);
    子14 = _va_alloc(节容量 * 4); 子15 = _va_alloc(节容量 * 4); 子16 = _va_alloc(节容量 * 4); 子17 = _va_alloc(节容量 * 4);
