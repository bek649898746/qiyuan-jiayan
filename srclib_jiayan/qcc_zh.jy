                    变量表[变量数 - 1].指元素尺寸 = 元素尺寸; /* 元素 字节 尺寸 遍 2D 外层 毛简一 (长卯) */
                    若 (是否字符标) { 变量表[变量数 - 1].是否字符标 = 1; } 若 (是否短标) { 变量表[变量数 - 1].是否短标 = 1; } 若 (深成) { 变量表[变量数 - 1].深成 = 1; } /* 修复 2026-08-29 生成器: 全局数组元素 有符号 标记 — 原缺失 → 数组元素读全 零扩展 零扩展 (int8_t/int16_t 数组 校验和 错, s94) */
                    若 (是否长标) 变量表[变量数 - 1].是否长标 = 1; /* 静态 长整 长整 数组 (修复 2026-08-06) */
                    若 (栈布) 变量表[变量数 - 1].指浮 = 1; /* 双精度-返回 函数指 数组 (修复 2026-08-05) */
                    若 (维数表 > 1 && 首 > 0) 变量表[变量数 - 1].数组元素尺寸 = (计数二 / 首) * 元素尺寸; /* 行 字节 尺寸 遍 2D+ */
                    若 (是否指标 && 元素尺寸 == 8 && 整得 < 0) 变量表[变量数 - 1].指内 = 是否字符标 ? 1 : (是否短标 ? 2 : ((当丙 || 是否长标) ? 8 : 4)); 若 (是否指标) 变量表[变量数 - 1].指深 = 1; /* C1 第三层·载体补齐 (2026-09-26 启元 · round 42): 第 356 站给指针数组补 `指深=1` 时**漏了「函数内 static 数组」这条登记路径** —— 实测 `double *dp[2]` (函数内 static) 的 指深=0, 而文件级 (c7e) 与 局部非 static (c6d) 都是 1 ⟹ 下游 补加载/解引用判据全部落空 ⟹ `dp[1][0]` 读成地址 (R=4374456.00, gcc 2.50). 只影响 本 static 分支; 值数组 `是否指标` 假 ⟹ 不动. */ /* C6 根治 (2026-09-24 启元 · 第 268 站): **函数内 static 指针数组 补 指内**. 病灶(探针 c6b + QCC_DUMP=vars 铁证): 全局 `static 整数 *gp[2]` 指内=4, 而 **函数内** `static 整数 *parr[2]` / `static 双精度 *dparr[2]` **指内=0** — 本 static 数组分支 只设 指元素尺寸, **漏设 指内**; 非 static 局部数组 由下方 L10769 (R255 刀5) 设了, 两分支不对称. 后果: 指内=0 ⟹ (a) 表达式内重/长卯 回退默认; (b) **A9 刀的「指针到数组」判据 `变量指内查 > 0` 不命中** ⟹ 该形态回到残留依赖; 实测 parr[1][1] 得 0 (应 4), dparr[1][0] 得 4386808.00 垃圾 (应 2.50). 修: 镜像 L10769 的判据 (并补 `当丙` 分派 ⟹ `双精度 *p[2]` 得 8 而非 4). */
                    若 (维数表 >= 1) { 变量表[变量数 - 1].域行数[维数表 - 1] = 元素尺寸; 遍 (整 己序 = 维数表 - 2; 己序 >= 0; 己序--) 变量表[变量数 - 1].域行数[己序] = 变量表[变量数 - 1].域行数[己序 + 1] * 余又[己序 + 1]; } /* 3D 每-维度 行 (修复 2026-08-05) */
                    若 (当丙 || 单丙) { 变量表[变量数 - 1].是否浮标 = 1; 若 (单丙) 变量表[变量数 - 1].单标 = 1; } /* 静态 双精度/单精度 数组 (R4a-5: float 数组元素 4B 单标) */
                    若 (无符号标) 变量表[变量数 - 1].无符号标 = 1; /* 无符号 数组: u[i] >> n 逻辑 (修复 2026-08-05) */
                    若 (整得 >= 0) 变量表[变量数 - 1].型序标 = 整得;
                } 否 {
                    若 (缺伍 >= 0) { 初弊(变节, (维数表 > 0 ? 计数二 : 1) * 元素尺寸, 缺伍); } /* 修复 步三十一: 变长数组 — 运行时大小, 地址槽间接; 多维时 数组元素尺寸=行大小 (计数二=后续 常量 维度乘积) */ 否 { 末午(变节, 计数二, 元素尺寸); 若 (是否指标) 变量表[变量数 - 1].指深 = 1; }
                    若 (是否指标) 变量表[变量数 - 1].指元素尺寸 = 8; /* C76 (2026-09-17 第 76 站): **补 指元素尺寸** —— 本 局部数组分支 里 它 只有 静态分支 (上) 与 2D+ 分支 (下) 会设, **1D 非静态 指针数组** 落空 ⟹ 结构体元素赋值守卫 以 `变量指元素尺寸 == 0` 判为「结构体值数组」⟹ `typedef 结构体 T; T *c[2]; c[0] = &u;` 走 深拷贝 → c[0] 收 u 的内容而非地址 → c[0]->字段 空解引用崩 0xC0000005 (静默 0, 静默闸看不见). 最小复现 c220.py t4_noparen. 同族: L8839 (结构体标签 分支) / C74 (括号 分支). */
                    若 (是否字符标) { 变量表[变量数 - 1].是否字符标 = 1; } 若 (是否短标) { 变量表[变量数 - 1].是否短标 = 1; } 若 (深成) { 变量表[变量数 - 1].深成 = 1; } /* 修复 2026-08-29 生成器: 局部数组元素 有符号 标记 — 原缺失 → 数组元素读 零扩展 零扩展 */
                    若 (是否长标) 变量表[变量数 - 1].是否长标 = 1; /* 长整 长整 数组: 8-字节 元素 (修复 2026-08-06) */
                    若 (栈布) 变量表[变量数 - 1].指浮 = 1; /* 双精度-返回 函数指 数组 (修复 2026-08-05) */
                    若 (整得 >= 0) 变量表[变量数 - 1].型序标 = 整得; 否 若 (型定指构序 >= 0) 变量表[变量数 - 1].型序标 = 型定指构序; /* R16 刀2 (2026-09-23): **别名 作 数组元素类型 (局部路径)** —— `整得` 经 `容成()` 解析, 而 `typedef S *SP;` 的 `型定表[SP].是否构标 = 0` (定义体是 `S *`, 非 struct/union) ⟹ 容成 返 -1 ⟹ `型序标` 未设 ⟹ `组八[0]->字段` 的偏移算错 (r16c 实测: 槽宽度 off1=8 ✅ 且 `组八[0]` 值 = &a ✅, 但 `组八[0]->y` = 4404111 应 &b; `组八[0]->v` = 4404206 应 1 ⟹ 基类型序 缺). 对照 非别名 `S *组十一[2]` 走 L10392 `查类型` 直接得 S ⟹ 正确. C54/C291 已把「别名指向的构序」存进 `型定指构序`, 本刀接到 `型序标` 即可. */ /* 结构体 数组 元素 类型 */
                    若 (维数表 > 1 && 首 > 0) {
                        /* 局部 2D+ 数组: 数组元素尺寸 = 行 字节 尺寸 (m[i] 缩放 由 它),
