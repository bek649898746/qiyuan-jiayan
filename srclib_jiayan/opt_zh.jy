/* opt_zh.jy —— 甲言 IR 优化器（与 srclib\asm_zh.jy 同族：甲言源 · 独立可编译 · 命令行工具）
 *
 * 用法: opt_zh in.ir -o out.ir
 *
 * IR 文本格式（每行一条指令，`#` 起首为注释）:
 *     常量 tN V           —— tN = 常量 V
 *     加   tN a b         —— tN = a + b      （减/乘 同形）
 *     返回 x
 *
 * 做两件**语义等价**的变换（不改程序行为）:
 *   ① 常量折叠: 加/减/乘 的两个操作数**都是常量** ⟹ 直接算出常量写回
 *   ② 死代码消除: 定义了却**未被任何后续指令引用**的纯定义 ⟹ 删除该行
 *
 * ★ 写法纪律（照抄同族 asm_zh.jy 已验证的调用集合）:
 *   · 读文件 = fopen + fseek/ftell/fread（**不用 fgets**）
 *   · 不依赖 sscanf/sprintf/atoi —— 解析与数↔串 全部**手写**（qcc 的格式串支持有限）
 *   · 排序/比较用 strcmp（同族已在用）
 * 设计: 核心变换是**纯逻辑单元**（只读写内存中的指令表），文件 I/O 集中在 主() 的薄壳里。
 */
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define 行上限 512
#define 名上限 64

静 字 目[行上限][名上限];
静 字 码[行上限][名上限];
静 字 甲[行上限][名上限];
静 字 乙[行上限][名上限];
静 整 是常量[行上限];
静 整 常值[行上限];
静 整 活[行上限];
静 整 数;
静 整 折数;
静 整 删数;

/* ---- 手写: 串 → 整（支持负号） ---- */
静 整 串转整(字 *p) {
    整 v = 0; 整 负 = 0;
    若 (p[0] == '-') { 负 = 1; p = p + 1; }
    循环 (p[0] >= '0' && p[0] <= '9') { v = v * 10 + (p[0] - '0'); p = p + 1; }
    若 (负) 返 -v;
    返 v;
}

/* ---- 手写: 整 → 串，返回 写入 长度 ---- */
静 整 整转串(字 *出, 整 v) {
    字 缓[32]; 整 n = 0; 整 i;
    无 整 uv;
    若 (v < 0) { 出[0] = '-'; n = 1; uv = (无 整)(-v); } 否 { uv = (无 整)v; }
    整 起 = n;
    若 (uv == 0) { 缓[0] = '0'; n = 1; } 否 {
        n = 0;
        循环 (uv > 0) { 缓[n] = (字)('0' + (uv % 10)); n = n + 1; uv = uv / 10; }
    }
    遍 (i = 0; i < n; i = i + 1) 出[起 + i] = 缓[n - 1 - i];
    出[起 + n] = 0;
    返 起 + n;
}

/* ---- 手写: 串 拷贝 ---- */
静 空 拷串(字 *到, 常 字 *从) {
    整 i = 0;
    循环 (从[i] != 0 && i < 名上限 - 1) { 到[i] = 从[i]; i = i + 1; }
    到[i] = 0;
}

/* ---- 手写: 取 一行 的 第 n 个 词（0 基），写入 出；返 1=有词 ---- */
静 整 取词(常 字 *行, 整 序, 字 *出) {
    整 i = 0; 整 k = 0; 整 n = 0;
    循环 (行[i] != 0) {
        若 (行[i] == ' ' || 行[i] == '\t' || 行[i] == '\r' || 行[i] == '\n') { i = i + 1; 续; }
        若 (k == 序) {
            n = 0;
            循环 (行[i] != 0 && 行[i] != ' ' && 行[i] != '\t' && 行[i] != '\r' && 行[i] != '\n' && n < 名上限 - 1) {
                出[n] = 行[i]; n = n + 1; i = i + 1;
            }
            出[n] = 0;
            返 1;
        }
        /* 跳过 本词 */
        循环 (行[i] != 0 && 行[i] != ' ' && 行[i] != '\t' && 行[i] != '\r' && 行[i] != '\n') i = i + 1;
        k = k + 1;
    }
    出[0] = 0;
    返 0;
}

/* ---- 解析 一行 ---- */
静 空 解析行(常 字 *p) {
    字 w1[名上限]; 字 w2[名上限]; 字 w3[名上限]; 字 w4[名上限];
    若 (p[0] == 0 || p[0] == '#' || p[0] == '\n' || p[0] == '\r') 返;
    若 (!取词(p, 0, w1)) 返;
    若 (strcmp(w1, "返回") == 0) {
        若 (!取词(p, 1, w2)) 返;
        拷串(码[数], "返回"); 拷串(甲[数], w2); 目[数][0] = 0; 数 = 数 + 1; 返;
    }
    若 (strcmp(w1, "常量") == 0) {
        若 (!取词(p, 1, w2) || !取词(p, 2, w3)) 返;
        拷串(码[数], "常量"); 拷串(目[数], w2); 拷串(甲[数], w3); 乙[数][0] = 0;
        是常量[数] = 1; 常值[数] = 串转整(w3);
        数 = 数 + 1; 返;
    }
    若 (strcmp(w1, "加") == 0 || strcmp(w1, "减") == 0 || strcmp(w1, "乘") == 0) {
        若 (!取词(p, 1, w2) || !取词(p, 2, w3) || !取词(p, 3, w4)) 返;
        拷串(码[数], w1); 拷串(目[数], w2); 拷串(甲[数], w3); 拷串(乙[数], w4);
        数 = 数 + 1; 返;
    }
}

/* 返回 pos **之前** 该名的**最近**定义行号（最近定义生效；未定义 返 -1）。
   ⚠️ 必须带 pos: 仅取「首个定义」会让重定义输入被误折叠
   （反例 `常量 t1 1 / 常量 t1 2 / 加 t2 t1 t1` 真值 t2=4，取首定义会折成 2）。 */
静 整 找行(常 字 *名, 整 pos) {
    整 i;
    遍 (i = pos - 1; i >= 0; i = i - 1) 若 (目[i][0] != 0 && strcmp(目[i], 名) == 0) 返 i;
    返 -1;
}

静 整 求值(常 字 *名, 整 pos, 整 *出) {
    整 r = 找行(名, pos);
    若 (r < 0) 返 0;
    若 (是常量[r]) { *出 = 常值[r]; 返 1; }
    返 0;
}

/* ① 常量折叠（纯逻辑） */
静 空 折叠一遍(空) {
    整 i;
    折数 = 0;
    遍 (i = 0; i < 数; i = i + 1) {
        若 (strcmp(码[i], "加") == 0 || strcmp(码[i], "减") == 0 || strcmp(码[i], "乘") == 0) {
            整 a = 0; 整 b = 0;
            若 (求值(甲[i], i, &a) && 求值(乙[i], i, &b)) {
                整 v = 0;
                若 (strcmp(码[i], "加") == 0) v = a + b;
                否 若 (strcmp(码[i], "减") == 0) v = a - b;
                否 v = a * b;
                拷串(码[i], "常量");
                整转串(甲[i], v);
                乙[i][0] = 0;
                是常量[i] = 1; 常值[i] = v;
                折数 = 折数 + 1;
            }
        }
    }
}

/* ② 死代码消除（纯逻辑） */
静 空 消除死码(空) {
    整 i; 整 j;
    删数 = 0;
    遍 (i = 0; i < 数; i = i + 1) 活[i] = 1;
    遍 (i = 0; i < 数; i = i + 1) {
        若 (strcmp(码[i], "返回") == 0) 续;
        若 (目[i][0] == 0) 续;
        整 被引 = 0;
        遍 (j = 0; j < 数; j = j + 1) {
            若 (j == i) 续;
            若 (strcmp(码[j], "返回") == 0) {
                若 (strcmp(甲[j], 目[i]) == 0) 被引 = 1;
            } 否 {
                若 (甲[j][0] != 0 && strcmp(甲[j], 目[i]) == 0) 被引 = 1;
                若 (乙[j][0] != 0 && strcmp(乙[j], 目[i]) == 0) 被引 = 1;
            }
        }
        若 (!被引) { 活[i] = 0; 删数 = 删数 + 1; }
    }
}

静 空 写行(FILE *fo, 整 i) {
    若 (strcmp(码[i], "返回") == 0) { fprintf(fo, "返回 %s\n", 甲[i]); 返; }
    若 (strcmp(码[i], "常量") == 0) { fprintf(fo, "常量 %s %s\n", 目[i], 甲[i]); 返; }
    fprintf(fo, "%s %s %s %s\n", 码[i], 目[i], 甲[i], 乙[i]);
}

静 整 主(整 argc, 字 **argv) {
    常 字 *inf = 0; 常 字 *outf = 0;   /* 两者 皆 必填（"—" 不再 作 stdout 哨兵: 甲的 stdout 在 FILE* 语境 取 0）*/
    整 i;
    遍 (i = 1; i < argc; i = i + 1) {
        若 (strcmp(argv[i], "-o") == 0 && i + 1 < argc) { outf = argv[i + 1]; i = i + 1; }
        否 inf = argv[i];
    }
    若 (inf == 0 || outf == 0) { 输出("Usage: opt_zh in.ir -o out.ir   (-o 必填)\n"); 返 1; }

    FILE *fi = fopen(inf, "rb");
    若 (fi == 0) { 输出("opt_zh: cannot open input\n"); 返 1; }
    fseek(fi, 0, 2); 整 sz = ftell(fi); fseek(fi, 0, 0);
    字 *src = malloc(sz + 1);
    若 (src == 0) { 输出("opt_zh: OOM\n"); fclose(fi); 返 1; }
    fread(src, 1, sz, fi); src[sz] = 0; fclose(fi);

    /* 切行并解析 */
    数 = 0;
    整 s = 0;
    循环 (s < sz) {
        整 e = s;
        循环 (e < sz && src[e] != '\n') e = e + 1;
        字 末 = src[e];
        src[e] = 0;
        若 (数 < 行上限) 解析行(src + s);
        src[e] = 末;
        s = e + 1;
    }

    折叠一遍();
    消除死码();

    FILE *fo = fopen(outf, "wb");
    若 (fo == 0) { 输出("opt_zh: cannot write output\n"); free(src); 返 1; }
    fprintf(fo, "# opt_zh 优化结果（常量折叠 %d 条 · 死码消除 %d 条）\n", 折数, 删数);
    整 ii;
    遍 (ii = 0; ii < 数; ii = ii + 1) 若 (活[ii]) 写行(fo, ii);
    fclose(fo);
free(src);
    返 0;
}
