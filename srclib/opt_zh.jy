/* opt_zh.jy — 中文汇编层优化器（甲言版）
 * R599c-T10b / T10-2 ｜ 输入 .asm 文本 → 输出优化后的 .asm 文本
 * 用法: opt_zh <in.asm> [-o <out.asm>]
 *
 * 五条 pass（局部可证 · 语义完全等价）:
 *   ① 减栈 8  + 存栈64 [rsp+0], rX   ==>   压栈 rX        (省 11 或 10 字节/处)
 *   ② 取栈64 rX, [rsp+0] + 加栈 8     ==>   弹栈 rX        (省 11 或 10 字节/处)
 *   ③ 加栈 N  + 减栈 N（操作数逐字同） ==>   两条都删       (省 14 字节/处)
 *   ④ 跳转 X  后紧跟 跳转 Y / 返回     ==>   删后条（不可达） (省 5 / 1 字节/处)
 *   ⑤ 移64 rX,rY / 移64 rZ,rX / 移64 rX,存 ==> 移64 rZ,rY  (省 3 字节/处)
 *   ⑥ 跳转 .Lx 紧跟标号 .Lx:          ==>   删跳转（目标即下一行）(省 5 或 2 或 6 字节/处)
 * 逐点缩短量以 `.缩 N` 标注（累加即 `.缩总`），供中文汇编器把「代码区终点」与 rip 位移同步下移。
 * 纪律: 不认识的形态 一律 原样保留（宁可不动，绝不丢弃）；每条 pass 配负向用例。
 */

静 字 **行起;
静 字 **行止;
静 整 行数;
静 字 *出行;
静 整 出长, 出容;
/* 各类 pass 命中条数 —— 可复算读数（每轮直接印在收尾行, 便于第三方核对） */
静 整 类1, 类2, 类3, 类4, 类4乙, 类5, 类6, 类7, 类8, 类9, 类11, 类12, 类13;
/* 标号计数表 —— 判定「目标标号唯一」：asm_zh 对**重名标号**取最后一次定义的位置,
   故「跳到紧跟其后的标号」只有在目标标号唯一时才能真正删掉（否则原跳转其实飞向别处）。 */
静 整 *标槽; 静 字 **标名; 静 整 *标长; 静 整 *标数; 静 整 标n;

静 空 出初始化(整 n) { 出容 = n + 4096; 出行 = malloc(出容); 出长 = 0; }
静 空 出字(字 c) { 若 (出长 + 4 >= 出容) { 出容 = 出容 * 2; 出行 = realloc(出行, 出容); } 出行[出长] = c; 出长 = 出长 + 1; }
静 空 出区(字 *p, 字 *q) { 循环 (p < q) { 出字(p[0]); p = p + 1; } }
静 空 出串(常 字 *s) { 整 i = 0; 循环 (s[i] != 0) { 出字(s[i]); i = i + 1; } }
静 空 出数(整 v) { 字 b[16]; 整 n = 0; 若 (v == 0) { 出字('0'); 返; } 循环 (v > 0) { b[n] = (字)('0' + v % 10); v = v / 10; n = n + 1; } 循环 (n > 0) { n = n - 1; 出字(b[n]); } }

静 空 切行(字 *t, 整 n) {
    行起 = malloc(8 * 4200000); 行止 = malloc(8 * 4200000); 行数 = 0;
    整 i = 0; 整 s = 0;
    遍 (i = 0; i < n; i = i + 1) 若 (t[i] == 10) { 行起[行数] = t + s; 行止[行数] = t + i; 行数 = 行数 + 1; s = i + 1; }
    若 (s < n) { 行起[行数] = t + s; 行止[行数] = t + n; 行数 = 行数 + 1; }
}

静 空 去白(字 *s, 字 *e, 字 **a, 字 **b) {
    循环 (s < e && (s[0] == ' ' || s[0] == 9)) s = s + 1;
    循环 (e > s && (e[-1] == ' ' || e[-1] == 9)) e = e - 1;
    *a = s; *b = e;
}

静 整 等于(字 *s, 字 *e, 常 字 *p) {
    整 i = 0;
    循环 (p[i] != 0) { 若 (s + i >= e || s[i] != p[i]) 返 0; i = i + 1; }
    返 (s + i == e);
}

静 整 前缀(字 *s, 字 *e, 常 字 *p) {
    整 i = 0;
    循环 (p[i] != 0) { 若 (s + i >= e || s[i] != p[i]) 返 0; i = i + 1; }
    返 1;
}
静 整 后缀(字 *s, 字 *e, 常 字 *p) { /* R599c-T10b: 操作数必须精确匹配, 否则误替换 (如 [rsp+16] 被当 [rsp+0]) */
    整 n = 0; 循环 (p[n] != 0) n = n + 1;
    若 (e - s < n) 返 0;
    整 i = 0;
    循环 (i < n) { 若 (s[e - s - n + i] != p[i]) 返 0; i = i + 1; }
    返 1;
}

静 字 *到空格(字 *p, 字 *e) { 循环 (p < e && p[0] != ' ') p = p + 1; 返 p; }
静 字 *到逗号(字 *p, 字 *e) { 循环 (p < e && p[0] != ',') p = p + 1; 返 p; }
静 字 *过空格(字 *p, 字 *e) { 循环 (p < e && p[0] == ' ') p = p + 1; 返 p; }
静 字 *尾白(字 *p, 字 *q) { 循环 (q > p && q[-1] == ' ') q = q - 1; 返 q; } /* 去尾空 */

/* `助记符 操作数` 形式：取出「第一个空格之后」的操作数区间（用于比对两个助记符的操作数是否相同） */
静 整 操作数同(字 *a1, 字 *b1, 字 *a2, 字 *b2) {
    字 *s1 = 过空格(到空格(a1, b1), b1); 字 *e1 = 尾白(s1, b1);
    字 *s2 = 过空格(到空格(a2, b2), b2); 字 *e2 = 尾白(s2, b2);
    若 (e1 - s1 != e2 - s2) 返 0;
    整 i = 0; 循环 (i < e1 - s1) { 若 (s1[i] != s2[i]) 返 0; i = i + 1; }
    返 1;
}
/* `移64 rX, rY` 形式：取第 n 个寄存器区间的 [起,止)。n=1 取第一个、n=2 取第二个。找到返 1。 */
静 整 取寄(字 *a, 字 *b, 整 n, 字 **rs, 字 **re) {
    字 *p = 过空格(到空格(a, b), b);          /* 跳到第一个寄存器 */
    整 c = 1;
    循环 (1) {
        若 (p >= b) 返 0;
        *rs = p;
        循环 (p < b && p[0] != ',' && p[0] != ' ') p = p + 1;
        *re = p;
        若 (c == n) 返 1;
        c = c + 1;
        循环 (p < b && (p[0] == ',' || p[0] == ' ')) p = p + 1;
    }
    返 0;
}
静 整 寄等(字 *s1, 字 *e1, 字 *s2, 字 *e2) { /* 两段寄存器名是否相同 */
    若 (e1 - s1 != e2 - s2) 返 0;
    整 i = 0; 循环 (i < e1 - s1) { 若 (s1[i] != s2[i]) 返 0; i = i + 1; }
    返 1;
}
/* 行首助记符（到首个空白为止）是否恰好等于 t */
静 整 名同(字 *a, 字 *b, 常 字 *t) {
    整 i = 0;
    循环 (a + i < b && a[i] != ' ' && a[i] != 9 && t[i] != 0) { 若 (a[i] != t[i]) 返 0; i = i + 1; }
    返 ((a + i == b || a[i] == ' ' || a[i] == 9) && t[i] == 0);
}
/* 跳转类**匹配谓词**（不含任何字节常量 —— 缩短量一律由汇编器实测）。
   排除 环跳/环等跳/环不等跳（有递减计数寄存器副作用）与 调用（需压返回地址）。 */
静 整 跳类(字 *a, 字 *b) {
    若 (名同(a, b, "跳转") || 名同(a, b, "跳转短")) 返 1;
    若 (名同(a, b, "为零跳") || 名同(a, b, "非零跳") || 名同(a, b, "非负跳") || 名同(a, b, "非溢出跳")) 返 1;
    若 (名同(a, b, "负跳") || 名同(a, b, "大跳") || 名同(a, b, "小跳") || 名同(a, b, "溢跳") || 名同(a, b, "不溢跳")) 返 1;
    若 (名同(a, b, "奇跳") || 名同(a, b, "偶跳") || 名同(a, b, "大于等跳") || 名同(a, b, "小于等跳")) 返 1;
    若 (名同(a, b, "高于等跳") || 名同(a, b, "低于跳") || 名同(a, b, "高于跳")) 返 1;
    返 0;
}
/* 控制流助记符 = **块终止子**（其后不是落空，或落空不可信）。
   与 `跳类`（只覆盖「可落空的条件跳 + 跳转」）不同，这里把「不落空/落空不可知」的全算上：
   `间跳`（目标在寄存器里）/ `环跳·环等跳·环不等跳`（循环指令，自带计数副作用）/
   `中断`（陷入，落空不可信）/ `中断返`（不回）/ `陷阱`（int3）。
   **唯一真源**：asm_zh 的助记符表；`check_opt_per_pass.py` 的「结构终止闸」逐名验一遍
   （每个名字造一件：块数必须 +1、野控流不许跨块转发、条件跳仍须转发；`无操作` 作正控块数不变）
   ⟹ 表里新增跳转类助记符而这里没跟上时，判据当场变红。 */
/* 「野」控制流：**目标不可静态确定**（或落空不可信）⟹ 一切「块内直线 / 前驱唯一」的推理都必须停。
   `跳转/跳转短/条件跳` 不在内：它们的边由 `结建` 求出，是结构事实；`返回` 也不在内（它不产生边）。 */
静 整 野控流(字 *a, 字 *b) {
    若 (名同(a, b, "间跳") || 名同(a, b, "环跳")) 返 1;
    若 (名同(a, b, "环等跳") || 名同(a, b, "环不等跳")) 返 1;
    若 (名同(a, b, "中断") || 名同(a, b, "中断返") || 名同(a, b, "陷阱")) 返 1;
    返 0;
}
静 整 控流令(字 *a, 字 *b) {
    若 (名同(a, b, "跳转") || 名同(a, b, "跳转短") || 名同(a, b, "返回")) 返 1;
    若 (野控流(a, b)) 返 1;
    返 (跳类(a, b) > 0);
}
静 整 标希(字 *s, 字 *e) { 整 h = 0; 循环 (s < e) { h = h * 37 + s[0]; s = s + 1; } 返 (h & 4194303); }
静 整 标查(字 *s, 字 *e) {   /* 命中 返 下标, 未命中 返 -1 */
    整 h = 标希(s, e); 整 g = 0;
    循环 (g < 4194304) {
        若 (标槽[h] == 0) 返 -1;
        整 j = 标槽[h] - 1;
        若 (标长[j] == (e - s) && 寄等(标名[j], 标名[j] + 标长[j], s, e)) 返 j;
        h = h + 1; 若 (h >= 4194304) h = 0;
        g = g + 1;
    }
    返 -1;
}
静 空 标增(字 *s, 字 *e) {
    整 j = 标查(s, e);
    若 (j >= 0) { 标数[j] = 标数[j] + 1; 返; }
    整 h = 标希(s, e);
    循环 (标槽[h] != 0) { h = h + 1; 若 (h >= 4194304) h = 0; }
    若 (标n >= 600000) { 输出("opt_zh: 标号表 溢出\n"); exit(1); }   /* 不静默丢弃 */
    标槽[h] = 标n + 1; 标名[标n] = s; 标长[标n] = (e - s); 标数[标n] = 1; 标n = 标n + 1;
}
静 整 无空格段(字 *s, 字 *e) { 循环 (s < e) { 若 (s[0] == ' ' || s[0] == 9 || s[0] == '"') 返 0; s = s + 1; } 返 1; }
/* ---- 寄存器号判定（供 ⑤ 的「第三行是否读 rX」守卫用；名字写法与数字写法同号）---- */
静 整 甲字母(字 c) { 返 ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')); }
/* 寄存器命名空间 = `r<数字>[bwd]` + 固定别名（rax..rdi / rip）。别的字母串一律是**符号**
   （`.L410` / `STR18` / `FN:xxx`）—— 把符号当「可疑寄存器」会让 每个含跳转的行 都「认不出」。 */
静 整 寄形(字 *s, 字 *e) {
    若 (e - s < 2) 返 0;
    若 (s[0] != 'r' && s[0] != 'e') 返 0;
    若 (s[1] >= '0' && s[1] <= '9') 返 1;
    若 (甲字母(s[1])) 返 1;          /* 大小写都算「寄存器式」⟹ 认不出就保守拒绝（
XX 不许放过） */
    返 0;
}
静 整 名等(字 *s, 字 *e, 常 字 *t) { 整 i = 0; 循环 (s + i < e && t[i] != 0) { 若 (s[i] != t[i]) 返 0; i = i + 1; } 返 ((s + i == e) && t[i] == 0); }
静 整 寄号(字 *s, 字 *e) {   /* 单 token 的寄存器号；非寄存器 / 认不出 返 -1 */
    若 (e - s < 2) 返 -1;
    若 (!(s[0] == 'r' || s[0] == 'e')) 返 -1;
    若 (s[0] == 'r' && s[1] >= '0' && s[1] <= '9') {
        整 v = 0; 整 i = 1;
        循环 (i < e - s && s[i] >= '0' && s[i] <= '9') { v = v * 10 + (s[i] - '0'); i = i + 1; }
        若 (i < e - s && (s[i] == 'b' || s[i] == 'w' || s[i] == 'd')) i = i + 1;   /* r8b/r8w/r8d 同号 */
        返 (i == e - s && v <= 15) ? v : -1;
    }
    若 (名等(s, e, "rip")) 返 16;   /* rip 不是 GPR，但也不是「认不出的寄存器写法」 */
    若 (名等(s, e, "rax") || 名等(s, e, "eax") || 名等(s, e, "ax") || 名等(s, e, "al")) 返 0;
    若 (名等(s, e, "rcx") || 名等(s, e, "ecx") || 名等(s, e, "cx") || 名等(s, e, "cl")) 返 1;
    若 (名等(s, e, "rdx") || 名等(s, e, "edx") || 名等(s, e, "dx") || 名等(s, e, "dl")) 返 2;
    若 (名等(s, e, "rbx") || 名等(s, e, "ebx") || 名等(s, e, "bx") || 名等(s, e, "bl")) 返 3;
    若 (名等(s, e, "rsp") || 名等(s, e, "esp") || 名等(s, e, "sp")) 返 4;
    若 (名等(s, e, "rbp") || 名等(s, e, "ebp") || 名等(s, e, "bp")) 返 5;
    若 (名等(s, e, "rsi") || 名等(s, e, "esi") || 名等(s, e, "si")) 返 6;
    若 (名等(s, e, "rdi") || 名等(s, e, "edi") || 名等(s, e, "di")) 返 7;
    返 -1;
}
/* 段内是否**引用**寄存器号 want：返 1 = 引用；0 = 确定不引用；-1 = 存在认不出的「寄存器式」token ⟹ 保守拒绝 */
静 整 含寄(字 *s, 字 *e, 整 want) {
    整 bad = 0; 整 hit = 0;
    循环 (s < e) {
        循环 (s < e && !(甲字母(s[0]) || (s[0] >= '0' && s[0] <= '9'))) s = s + 1;
        字 *t = s;
        循环 (s < e && (甲字母(s[0]) || (s[0] >= '0' && s[0] <= '9'))) s = s + 1;
        若 (s > t) { 整 r = 寄号(t, s); 若 (r < 0) { 若 (寄形(t, s)) bad = 1; } 否 若 (r == want) hit = 1; }
    }
    若 (hit) 返 1;
    若 (bad) 返 -1;
    返 0;
}
静 空 标建表(空) {   /* 扫一遍行表, 统计每个标号出现次数 */
    标槽 = malloc(4 * 4194304); 标名 = malloc(8 * 600000); 标长 = malloc(4 * 600000); 标数 = malloc(4 * 600000);
    整 i = 0;
    循环 (i < 4194304) { 标槽[i] = 0; i = i + 1; }
    标n = 0; i = 0;
    循环 (i < 行数) {
        字 *a; 字 *b; 去白(行起[i], 行止[i], &a, &b);
        若 (b - a > 1 && b[-1] == ':' && 无空格段(a, b - 1)) 标增(a, b - 1);
        i = i + 1;
    }
}
/* ⑥ 判定: 第 k 行是「跳到紧跟其后标号」的跳转 ⟹ 返 该跳转编码字节数(>0 = 已删并已输出)。
   安全前提: 目标标号**唯一**（重名时 asm_zh 取最后定义 ⟹ 原跳转其实飞向别处 ⟹ 不可删）。 */
静 整 跳落删(整 k) {
    若 (k + 1 >= 行数) 返 0;
    字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
    若 (跳类(a, b) == 0) 返 0;
    字 *c; 字 *d; 去白(行起[k + 1], 行止[k + 1], &c, &d);
    若 (d - c <= 1 || d[-1] != ':') 返 0;
    字 *tg = 过空格(到空格(a, b), b);
    若 (tg >= b) 返 0;
    若 (寄等(c, d - 1, tg, b) == 0) 返 0;
    整 j = 标查(c, d - 1);
    若 (j < 0 || 标数[j] != 1) 返 0;
    出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
    出区(行起[k + 1], 行止[k + 1]); 出字(10);   /* 标号必须原样保留（其它跳转仍指向它） */
    返 1;
}

/* ⑦ 帧/栈「存 → 取 同址相邻」：存已把值写进 [基±N]，紧接的取若读同一地址即为冗余。
   同寄 ⟹ 删「取」；异寄 ⟹ 删「取」并换成 `移<宽> rY, rX`（低 N 位等价；宽度必须相同，否则上界字节不同）。
   **只声明删/替，字节数由汇编器实测**（该形态编码长度随位移分档变化：disp8=4B / disp32=7B）。
   安全前提：族/宽/基址/位移逐字相同 · 两行紧邻（无标号介入）。返 1 = 已处理并已输出。 */
静 整 存取同址(整 k) {
    字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
    字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
    常 字 *w = 0;
    若 (前缀(a, b, "存帧32 ") && 前缀(a2, b2, "取帧32 ")) w = "32";
    否 若 (前缀(a, b, "存帧64 ") && 前缀(a2, b2, "取帧64 ")) w = "64";
    否 若 (前缀(a, b, "存栈32 ") && 前缀(a2, b2, "取栈32 ")) w = "32";
    否 若 (前缀(a, b, "存栈64 ") && 前缀(a2, b2, "取栈64 ")) w = "64";
    否 返 0;
    字 *p1 = 过空格(到空格(a, b), b);          /* 存: 指向 '['
                                                   取(与存同助记符长度) 的对应位置见 p2 */
    字 *p2 = a2 + (p1 - a);
    若 (p1 >= b || p1[0] != '[' || p2 >= b2) 返 0;
    字 *c1 = 到逗号(p1, b);                    /* 存: 内存操作数 之后的逗号 */
    字 *m1s = p1; 字 *m1e = 尾白(p1, c1);
    字 *r1s = 过空格(c1 + 1, b); 字 *r1e = 尾白(r1s, b);
    字 *c2 = 到逗号(p2, b2);                   /* 取: 寄存器 之后的逗号 */
    字 *r2s = p2; 字 *r2e = 尾白(p2, c2);
    字 *m2s = 过空格(c2 + 1, b2); 字 *m2e = 尾白(m2s, b2);
    若 (m2s >= b2 || m2s[0] != '[') 返 0;
    若 (r1s >= r1e || r2s >= r2e) 返 0;
    若 (!寄等(m1s, m1e, m2s, m2e)) 返 0;       /* 同址（含基址与位移，逐字相同） */
    出区(行起[k], 行止[k]); 出字(10);                       /* 存 原样 */
    出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);  /* 删 取：长度由汇编器实测 */
    若 (!寄等(r1s, r1e, r2s, r2e)) {
        出串(".替"); 出字(10);                              /* 下一条是替换体 ⟹ 其长度扣回 */
        出串("    移"); 出串(w); 出串(" "); 出区(r2s, r2e); 出串(", "); 出区(r1s, r1e); 出字(10);
    }
    返 1;
}

/* 「纯写」助记符白名单：其**目的即全部效果**（不是读-改-写）。
   ⚠ 关键：`乘32 rX,rY` / `加 rX,N` / `左移 rX,N` / `自增 rX` 等目的同时是**隐式源** ⟹ 不能当纯覆盖！
   故此处用白名单（宁可不动），而不是「目的==rX 且显式源不含 rX」的宽松判据。 */
静 整 纯写名(字 *a, 字 *b) {
    若 (名同(a, b, "移动") || 名同(a, b, "移即") || 名同(a, b, "移64") || 名同(a, b, "移32")) 返 1;
    若 (名同(a, b, "取帧32") || 名同(a, b, "取帧64") || 名同(a, b, "取栈32") || 名同(a, b, "取栈64")) 返 1;
    若 (名同(a, b, "取静32") || 名同(a, b, "取静64") || 名同(a, b, "取静址") || 名同(a, b, "取帧址")) 返 1;
    若 (名同(a, b, "零扩展") || 名同(a, b, "零扩展32") || 名同(a, b, "零扩展64")) 返 1;
    若 (名同(a, b, "符号扩展") || 名同(a, b, "符号扩展64") || 名同(a, b, "符号扩展字节")) 返 1;
    若 (名同(a, b, "取静零8") || 名同(a, b, "取静符8") || 名同(a, b, "取静零16") || 名同(a, b, "取静符16")) 返 1;
    返 0;
}

/* ⑧ 死值写覆盖：`<mov 类> rX, …` 紧跟 `<纯写 rX，且源不读 rX>` ⟹ 前条写的是死值，删之。
   安全判据（按**寄存器号**、含 rbp/rsp 别名）：
     ① 第一行助记符 ∈ {移动, 移即, 移64, 移32}（mov 类 ⟹ **不置标志位**，删掉不改变后续 flags）；
     ② 第一行目的 = 纯寄存器 rX（非内存形态）；
     ③ 第二行目的 = 纯寄存器且号 == rX；
     ④ 第二行源**不得引用** rX 的号（含别名；认不出的寄存器式 token 一律保守拒绝）；
     ⑤ 两行紧邻、第二行不是标号行（标号落点亦安全：进入点只是少执行一次将被覆盖的写）。
   只声明 `.删`，字节由汇编器实测（能长随位移/寄存器分档变化）。 */
静 整 死写删(整 k) {
    若 (k + 1 >= 行数) 返 0;
    字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
    若 (!(名同(a, b, "移动") || 名同(a, b, "移即") || 名同(a, b, "移64") || 名同(a, b, "移32"))) 返 0;
    字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
    若 (b2 > a2 && b2[-1] == ':') 返 0;
    若 (!纯写名(a2, b2)) 返 0;                   /* 第二行必须是**纯写**（非读-改-写）*/
    字 *p = 过空格(到空格(a, b), b);
    若 (p >= b || p[0] == '[') 返 0;
    字 *pe = 尾白(p, 到逗号(p, b));
    整 xn = 寄号(p, pe);
    若 (xn < 0) 返 0;
    字 *q = 过空格(到空格(a2, b2), b2);
    若 (q >= b2 || q[0] == '[') 返 0;
    字 *qc = 到逗号(q, b2);
    若 (qc >= b2) 返 0;                         /* 无逗号 ⟹ 无法判定源 ⟹ 不动 */
    字 *qe = 尾白(q, qc);
    若 (寄号(q, qe) != xn) 返 0;
    字 *s2s = 过空格(qc + 1, b2); 字 *s2e = 尾白(s2s, b2);
    若 (s2s >= s2e) 返 0;
    若 (含寄(s2s, s2e, xn) != 0) 返 0;          /* 源读 rX（含别名）/ 认不出 ⟹ 原样保留 */
    出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
    返 1;
}

/* ==================== R880: IR→优化器 元数据 通道（消费者侧） ====================
   输入: `-S` 产出的 .asm 末尾 追加 `; @QCCMETA …` 附录（发射侧 = qcc_zh 的 元写附录）。
   本侧做四件事（真解析 · 真校验 · 真消费）:
     ① 解析 四张表: 指令→节点/函数/循环/类型码 · def-use 用户数 · 循环区间
     ② 良构校验: 覆盖率 100%（每条指令都有 @I）· 无悬挂（节点/用户/循环 均在域内）·
        循环区间 s<=e 且 在 [0,ins) · 类型码 k∈[0,31] 且 t>=-1。校验失败 **响亮 报错 退出 1**（不静默降级）
     ③ 不把 附录 写进 输出（那是 -S 侧 通道，不是 汇编）
     ④ 消费: **G-DCE**（跨基本块 全局死定义 消除）—— 纯写 def + 用户数 0 + 目的 非 r4/r5 ⟹ `.删`
   负控: 把 附录 整段 擦掉 后 `元在=0` ⟹ G-DCE 一次 也 不 触发（判据 `check_opt_meta_consume.py`）。 */
静 整 元在 = 0, 元n = 0, 元函数数 = 0, 元环数 = 0, 元节点数 = 0;
静 整 *元I节, *元I函, *元I环, *元I层, *元I型, *元I构;
静 整 *元Def, *元用数, *元行序, *元Z;
静 整 *元Ls, *元Le, *元Ld;
静 整 类10 = 0;

静 整 元数取(字 **pp, 字 *e, 整 *出) {
    字 *p = *pp; 整 v = 0; 整 负 = 0;
    若 (p < e && p[0] == '-') { 负 = 1; p = p + 1; }
    若 (p >= e || p[0] < '0' || p[0] > '9') 返 0;
    循环 (p < e && p[0] >= '0' && p[0] <= '9') { v = v * 10 + (p[0] - '0'); p = p + 1; }
    *pp = p;
    *出 = 负 ? -v : v;
    返 1;
}
静 整 元是元行(字 *a, 字 *b) {
    若 (b - a >= 3 && a[0] == ';' && a[1] == ' ') 返 1;
    返 0;
}
/* 一条 4-空格 起首 且 非 ';' 注释 的 行 = 指令 */
静 整 元是令(字 *a, 字 *b) {
    若 (b - a < 5 || a[0] != ' ' || a[1] != ' ' || a[2] != ' ' || a[3] != ' ') 返 0;
    字 *s = a + 4;
    若 (s < b && s[0] == ';') 返 0;
    若 (s < b && s[0] == '#') 返 0;
    返 1;
}
静 整 元纯写行(字 *a, 字 *b) {
    字 *s = a;
    循环 (s < b && s[0] == ' ') s = s + 1;
    字 *m = s;
    循环 (s < b && s[0] != ' ') s = s + 1;
    若 (名同(m, s, "移动") || 名同(m, s, "移即") || 名同(m, s, "移64") || 名同(m, s, "移32")) 返 1;
    若 (名同(m, s, "取帧32") || 名同(m, s, "取帧64") || 名同(m, s, "取帧址")) 返 1;
    若 (名同(m, s, "取栈32") || 名同(m, s, "取栈64")) 返 1;
    若 (名同(m, s, "取静32") || 名同(m, s, "取静64") || 名同(m, s, "取静址")) 返 1;
    若 (名同(m, s, "取静零8") || 名同(m, s, "取静符8") || 名同(m, s, "取静零16") || 名同(m, s, "取静符16")) 返 1;
    若 (名同(m, s, "零扩展") || 名同(m, s, "零扩展32") || 名同(m, s, "零扩展64")) 返 1;
    若 (名同(m, s, "符号扩展") || 名同(m, s, "符号扩展64") || 名同(m, s, "符号扩展字节")) 返 1;
    若 (名同(m, s, "取参值") || 名同(m, s, "取址")) 返 1;
    返 0;
}
/* 指令 **编码长度** 模型（R880d）——只覆盖 G-DCE 允许删除的 pure-write 形态；
   常量全部 由 `asm_zh` 的 `.删` 干跑 **实测导出**（判据 `check_opt_per_pass.py` 会 用 `.text` 差 反查 模型是否漂移）。
   认不出的形态 返 -1 ⟹ 该条 **不删**（宁可少优化，也不许 自报量 与 实测 不一致）。 */
静 整 元位移(字 *s, 字 *e) {
    /* `[rbp-4380]` / `[rsp+8]` / `[rip+100]` ⟹ 取 位移 绝对值；认不出 返 -99999 */
    字 *p = s; 整 v = 0; 整 有 = 0;
    循环 (p < e && p[0] != '+') { 若 (p[0] == '-') { p = p + 1; 断; } p = p + 1; }
    若 (p >= e || p[0] == '+') { 若 (p < e) p = p + 1; }
    循环 (p < e && p[0] >= '0' && p[0] <= '9') { v = v * 10 + (p[0] - '0'); p = p + 1; 有 = 1; }
    返 有 ? v : -99999;
}
静 整 结跳目标(字 *a, 字 *b, 字 **ts, 字 **te);
静 整 行长(字 *a, 字 *b);
静 整 结提一(整 id);
静 空 环提(空);
/* ==================== R881: 控制流结构（块 / 前驱 / 后继 / 活集） ====================
   目标：把「逐指令元数据」升到**控制流级** —— 基本块、前驱/后继、活集（liveness），
   并在其上落**循环级**优化（循环槽提升 LSP：帧槽 → 寄存器，见下）。
   结构**可校验**（不静默降级）：
     · 跳转目标 解析不到 ⟹ 结块错 > 0 ⟹ main() 响亮拒绝（rc=1）
     · 环区间 必须由 CFG **独立验证**（等价「头块支配全部成员」的可达判据）：
         ① 头块沿环内边 可达 区间内全部块（区间闭合）
         ② 区间内块的出边 指向同一个块，且该块标号在区间之后（唯一出口）
         ③ 出口块的**全部前驱**都在区间内（否则出口回写会覆盖旁路写进槽的值）
         ④ 区间尾块 必须回跳头块（真回边）
       ⟹ 任一条不成立 记 结环拒 并跳过（不猜、不放行）
     · 只在 `-S` 产物（带 `; @QCCMETA` 附录）上启用 ⟹ 无附录 ⟹ 块表为空 ⟹ 循环级 pass 0 命中（负控） */
静 整 结在 = 0, 结块数 = 0, 结块错 = 0, 结边数 = 0;
静 整 *结首, *结末, *结标行, *结后一, *结后二;
静 字 **结标起, **结标止;
静 整 *结前起, *结前列;                    /* 前驱 CSR: 结前列[结前起[i] .. 结前起[i+1]) */
静 整 *结用, *结定, *结活入, *结活出;      /* 活集 位掩码（bit r = 第 r 号寄存器） */
静 整 结活轮 = 0, 结环拒 = 0;
静 整 *环员 = 0, *环是 = 0, *环见 = 0, *环队 = 0;

静 整 结块含(整 行);
静 整 结槽取(字 *a, 字 *b, 字 **ss, 字 **se, 整 *w, 整 *是存);
静 整 结纯写于(字 *a, 字 *b, 整 r);
静 整 结寄死(整 从行, 整 r);
静 整 槽长(字 *p);
静 空 结建前(空);
静 空 结活算(空);
静 整 结提一(整 id);
静 空 环提(空);

静 整 结是标号(字 *a, 字 *b) {
    若 (b - a < 2 || b[-1] != ':') 返 0;   /* `.Lx:` 也是 标号（跳转目标）；指令 行 不以 ':' 结尾 */
    若 (a[0] == ';') 返 0;
    返 1;
}
静 整 结块找(字 *s, 字 *e) {
    整 i = 0;
    循环 (i < 结块数) {
        若 (结标起[i] && (结标止[i] - 结标起[i]) == (e - s)) {
            整 j = 0; 整 同 = 1;
            循环 (j < e - s) { 若 (结标起[i][j] != s[j]) { 同 = 0; 断; } j = j + 1; }
            若 (同) 返 i;
        }
        i = i + 1;
    }
    返 -1;
}
静 整 结跳目标(字 *a, 字 *b, 字 **ts, 字 **te) {
    字 *p = a;
    若 (跳类(a, b) <= 0) 返 0;
    循环 (p < b && p[0] != ' ') p = p + 1;
    循环 (p < b && p[0] == ' ') p = p + 1;
    若 (p >= b) 返 0;
    *ts = p; *te = b;
    返 1;
}
静 空 结建(空) {
    整 k; 整 起; 整 n; 整 bi; 整 q; 整 last;
    若 (元在 != 1) { 结在 = 0; 返; }
    n = 行数 + 1;
    结首 = malloc(4 * n); 结末 = malloc(4 * n); 结标行 = malloc(4 * n);
    结后一 = malloc(4 * n); 结后二 = malloc(4 * n);
    结标起 = malloc(8 * n); 结标止 = malloc(8 * n);
    结块数 = 0;
    k = 0;
    循环 (k < 行数) {
        字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
        起 = 0;
        若 (k == 0) 起 = 1;
        若 (结是标号(a, b)) 起 = 1;
        若 (k > 0) {
            字 *pa; 字 *pb; 去白(行起[k - 1], 行止[k - 1], &pa, &pb);
            若 (控流令(pa, pb)) 起 = 1;
        }
        若 (起) {
            若 (结块数 > 0) 结末[结块数 - 1] = k - 1;
            结首[结块数] = k; 结标行[结块数] = -1; 结标起[结块数] = 0; 结标止[结块数] = 0;
            结后一[结块数] = -1; 结后二[结块数] = -1;
            若 (结是标号(a, b)) { 结标行[结块数] = k; 结标起[结块数] = a; 结标止[结块数] = b - 1; }
            结块数 = 结块数 + 1;
        }
        k = k + 1;
    }
    若 (结块数 == 0) { 结在 = 0; 返; }
    结末[结块数 - 1] = 行数 - 1;
    结边数 = 0;
    bi = 0;
    循环 (bi < 结块数) {
        last = -1; q = 结末[bi];
        循环 (q >= 结首[bi]) {
            字 *a; 字 *b; 去白(行起[q], 行止[q], &a, &b);
            若 (b - a > 0 && !结是标号(a, b) && a[0] != ';') { last = q; 断; }
            q = q - 1;
        }
        若 (last >= 0) {
            字 *a; 字 *b; 去白(行起[last], 行止[last], &a, &b);
            整 无条 = 名同(a, b, "跳转") || 名同(a, b, "跳转短");
            整 有条 = (跳类(a, b) > 0) && !无条;
            整 有返 = 名同(a, b, "返回");
            字 *ts; 字 *te;
            若 (无条 || 有条) {
                若 (结跳目标(a, b, &ts, &te)) {
                    整 tb = 结块找(ts, te);
                    若 (tb < 0) { 结块错 = 结块错 + 1; }
                    否 { 结后一[bi] = tb; 结边数 = 结边数 + 1; }
                } 否 若 (无条) { 结块错 = 结块错 + 1; }
            }
            若 (!无条 && !有返) {
                若 (bi + 1 < 结块数) { 结后二[bi] = bi + 1; 结边数 = 结边数 + 1; }
            }
        }
        bi = bi + 1;
    }
    结在 = 1;
}

/* ---- 前驱表（CSR）：块 i 的前驱 = 结前列[结前起[i] .. 结前起[i+1]) ---- */
静 空 结建前(空) {
    整 i; 整 s; 整 边 = 0; 整 *游;
    若 (结块数 <= 0) 返;
    结前起 = malloc(4 * (结块数 + 1));
    游 = malloc(4 * (结块数 + 1));
    i = 0;
    循环 (i <= 结块数) { 结前起[i] = 0; i = i + 1; }
    i = 0;
    循环 (i < 结块数) {
        s = 结后一[i]; 若 (s >= 0 && s < 结块数) { 结前起[s + 1] = 结前起[s + 1] + 1; 边 = 边 + 1; }
        s = 结后二[i]; 若 (s >= 0 && s < 结块数) { 结前起[s + 1] = 结前起[s + 1] + 1; 边 = 边 + 1; }
        i = i + 1;
    }
    i = 0;
    循环 (i < 结块数) { 结前起[i + 1] = 结前起[i + 1] + 结前起[i]; i = i + 1; }
    结前列 = malloc(4 * (边 + 1));
    i = 0;
    循环 (i < 结块数) { 游[i] = 结前起[i]; i = i + 1; }
    i = 0;
    循环 (i < 结块数) {
        s = 结后一[i]; 若 (s >= 0 && s < 结块数) { 结前列[游[s]] = i; 游[s] = 游[s] + 1; }
        s = 结后二[i]; 若 (s >= 0 && s < 结块数) { 结前列[游[s]] = i; 游[s] = 游[s] + 1; }
        i = i + 1;
    }
}

/* ---- 寄存器 掩码（寄形 的判据 见 甲字母 之后 的 定义）---- */
静 整 寄掩(字 *s, 字 *e) {   /* 本行 提及的 全部 寄存器；-1 = 有认不出的「寄存器式」token */
    整 掩 = 0; 整 bad = 0; 整 r; 字 *t;
    循环 (s < e) {
        循环 (s < e && !(甲字母(s[0]) || (s[0] >= '0' && s[0] <= '9'))) s = s + 1;
        t = s;
        循环 (s < e && (甲字母(s[0]) || (s[0] >= '0' && s[0] <= '9'))) s = s + 1;
        若 (s > t) {
            r = 寄号(t, s);
            若 (r >= 0) { 若 (r < 16) 掩 = 掩 | (1 << r); }
            否 若 (寄形(t, s)) bad = 1;
        }
    }
    若 (bad) 返 -1;
    返 掩;
}
/* 单行 读/写 掩码。读 **一律保守**（提及即读，含目的）；写 只认 纯写 指令 的第一操作数
   （读-改-写 一律当「只读」⟹ 活集只会更大，不会把活值误判成死值）。 */
静 空 行用定(字 *a, 字 *b, 整 *u, 整 *d) {
    整 m; 整 r; 字 *o1s; 字 *o1e;
    *u = 0; *d = 0;
    若 (名同(a, b, "调用") || 名同(a, b, "中调用") || 名同(a, b, "调系统") || 名同(a, b, "间调用")) {
        /* 调用者保存寄存器 在调用点**必定已死**（值已被踩）；参数由调用点前的显式 `移64 r1/r2, ...`
           写进 r1/r2 ⟹ 那些写 本身就是读集。故 callsite 读集 = 0。
           写集 = 调用者不保的 r0/r1/r2/r6..r11（r3=rbx 被调者保存：prologue `压栈 r3`；r5=rbp 同理）。 */
        *u = 0;
        *d = 1 + 2 + 4 + 64 + 128 + 256 + 512 + 1024 + 2048;
        返;
    }
    m = 寄掩(a, b);
    若 (m < 0) { *u = 65535; 返; }        /* 认不出 ⟹ 最保守（全活） */
    *u = m;
    若 (纯写名(a, b) && 元操(a, b, 1, &o1s, &o1e)) {
        r = 寄号(o1s, o1e);
        若 (r >= 0 && r < 16) *d = 1 << r;
    }
}
/* 块级 活集 不动点: 活入 = 用 ∪ (活出 − 定); 活出 = ∪ 后继·活入 */
静 空 结活算(空) {
    整 b; 整 k; 整 变; 整 u; 整 d; 整 o; 整 s; 字 *a; 字 *b2;
    若 (结块数 <= 0) 返;
    结用 = malloc(4 * 结块数); 结定 = malloc(4 * 结块数);
    结活入 = malloc(4 * 结块数); 结活出 = malloc(4 * 结块数);
    b = 0;
    循环 (b < 结块数) {
        结用[b] = 0; 结定[b] = 0; 结活入[b] = 0; 结活出[b] = 0;
        k = 结首[b];
        循环 (k <= 结末[b]) {
            去白(行起[k], 行止[k], &a, &b2);
            u = 0; d = 0;
            若 (b2 - a > 0 && !结是标号(a, b2) && a[0] != ';') 行用定(a, b2, &u, &d);
            结用[b] = 结用[b] | u;
            结定[b] = 结定[b] | d;
            k = k + 1;
        }
        b = b + 1;
    }
    变 = 1; 结活轮 = 0;
    循环 (变 && 结活轮 < 200) {
        变 = 0; 结活轮 = 结活轮 + 1;
        b = 结块数 - 1;
        循环 (b >= 0) {
            o = 0;
            s = 结后一[b]; 若 (s >= 0 && s < 结块数) o = o | 结活入[s];
            s = 结后二[b]; 若 (s >= 0 && s < 结块数) o = o | 结活入[s];
            若 (o != 结活出[b]) { 结活出[b] = o; 变 = 1; }
            o = 结用[b] | (o & (65535 - 结定[b]));
            若 (o != 结活入[b]) { 结活入[b] = o; 变 = 1; }
            b = b - 1;
        }
    }
}

/* ---- 环验证（CFG 独立重建；等价于「头块 支配 全部成员」的可达判据）---- */
静 整 环验(整 hl, 整 tl, 整 头块, 整 *出块) {
    整 i; 整 b; 整 s; 整 队头; 整 队尾; 整 员数;
    *出块 = -1;
    若 (环员 == 0) {
        环员 = malloc(4 * 结块数); 环是 = malloc(4 * 结块数);
        环见 = malloc(4 * 结块数); 环队 = malloc(4 * 结块数);
    }
    i = 0;
    循环 (i < 结块数) { 环是[i] = 0; 环见[i] = 0; i = i + 1; }
    员数 = 0;
    i = 0;
    循环 (i < 结块数) {
        若 (结首[i] <= tl && 结末[i] >= hl) { 环是[i] = 1; 环员[员数] = i; 员数 = 员数 + 1; }
        i = i + 1;
    }
    若 (员数 <= 0 || !环是[头块]) 返 0;
    /* ① 无中途入口：除头块外，每个成员的**全部前驱**都在区间内
       （否则 从环外 跳进环体 会绕过「头前载入」，寄存器值 未初始化） */
    i = 0;
    循环 (i < 员数) {
        b = 环员[i];
        若 (b != 头块) {
            s = 结前起[b];
            循环 (s < 结前起[b + 1]) { 若 (!环是[结前列[s]]) 返 0; s = s + 1; }
        }
        i = i + 1;
    }
    i = 0;
    循环 (i < 员数) {
        b = 环员[i];
        s = 结后一[b];
        若 (s >= 0 && s < 结块数 && !环是[s]) { 若 (*出块 < 0) *出块 = s; 否 若 (*出块 != s) 返 0; }
        s = 结后二[b];
        若 (s >= 0 && s < 结块数 && !环是[s]) { 若 (*出块 < 0) *出块 = s; 否 若 (*出块 != s) 返 0; }
        i = i + 1;
    }
    若 (*出块 < 0) 返 0;                                            /* ② 唯一出口 */
    若 (结首[*出块] <= tl) 返 0;
    i = 结前起[*出块];
    循环 (i < 结前起[*出块 + 1]) { 若 (!环是[结前列[i]]) 返 0; i = i + 1; }   /* ③ 出口无旁路前驱 */
    b = 环员[员数 - 1];                                             /* ④ 尾块回跳头块 */
    s = 结后一[b];
    若 (s != 头块) { s = 结后二[b]; 若 (s != 头块) 返 0; }
    /* ⑥ 头块 的**环外前驱** 必须 经「落空」进入：载入指令 插在头标号之前，
       若有环外 `跳转` 直达头标号（不是落空），载入被绕过 ⟹ 寄存器 未初始化 ⟹ 语义错。 */
    s = 结前起[头块];
    循环 (s < 结前起[头块 + 1]) {
        b = 结前列[s];
        若 (!环是[b]) { 若 (结后二[b] != 头块) 返 0; }
        s = s + 1;
    }
    /* ⑤ 尾块 从 头块 可达（区间里允许有「早退后」的死块，但尾块必须在真环上） */
    环队[0] = 头块; 队头 = 0; 队尾 = 1; 环见[头块] = 1;
    循环 (队头 < 队尾) {
        s = 环队[队头]; 队头 = 队头 + 1;
        整 t2 = 结后一[s];
        若 (t2 >= 0 && t2 < 结块数 && 环是[t2] && !环见[t2]) { 环见[t2] = 1; 环队[队尾] = t2; 队尾 = 队尾 + 1; }
        t2 = 结后二[s];
        若 (t2 >= 0 && t2 < 结块数 && 环是[t2] && !环见[t2]) { 环见[t2] = 1; 环队[队尾] = t2; 队尾 = 队尾 + 1; }
    }
    若 (!环见[b]) 返 0;
    返 1;
}

/* ==================== R881 循环槽提升（LSP）—— 循环级真优化 ====================
   对**叶子环**（区间内不含其它环）把帧槽提升到寄存器 r8/r9/r10（每环最多 3 个槽）：
     · 头标号前 插 `取帧<w> rF, [槽]`（`.增` 让汇编器实测记账）
     · 环内 每个 `取帧<w> rX,[槽]` → `移<w> rX, rF`；`存帧<w> [槽], rY` → `移<w> rF, rY`
     · 出口标号后 插 `存帧<w> [槽], rF`（标号之后；且出口前驱全在环内 ⟹ 不会毒化旁路）
   安全前提（机械校验，任一不满足即跳过该槽）：
     ① 环内 无 调用（寄存器被踩）/ 无 取址·取帧址（槽可能被别名写）
     ② 该槽 在环内只以**同一宽度**出现（混宽 ⟹ 整个环跳过，不猜）；
        槽的地址 在本函数内从未被取（取帧址 ⟹ 指针写可能绕过寄存器）
     ③ rF 在环内**完全未提及**；活集证明 rF 既不在头块活入、也不在出口块活入
     ④ 环内 至少 2 次访问（否则收益为负） */
静 整 *元序行 = 0;
静 整 提槽数 = 0, 提净字节 = 0;
静 整 *行动作 = 0, *行动类 = 0, *行动宽 = 0, *行动寄一 = 0, *行动寄二 = 0;
静 字 **插前槽 = 0, **插后槽 = 0;
静 整 *插前宽 = 0, *插前寄 = 0, *插后宽 = 0, *插后寄 = 0;

静 整 插前加(整 行, 字 *槽, 整 w, 整 r) {
    整 i = 0; 整 b = 行 * 3;
    循环 (i < 3) {
        若 (插前槽[b + i] == 0) { 插前槽[b + i] = 槽; 插前宽[b + i] = w; 插前寄[b + i] = r; 返 1; }
        i = i + 1;
    }
    返 0;
}
静 整 插后加(整 行, 字 *槽, 整 w, 整 r) {
    整 i = 0; 整 b = 行 * 3;
    循环 (i < 3) {
        若 (插后槽[b + i] == 0) { 插后槽[b + i] = 槽; 插后宽[b + i] = w; 插后寄[b + i] = r; 返 1; }
        i = i + 1;
    }
    返 0;
}
静 整 结块含(整 行) {
    整 i = 0;
    循环 (i < 结块数) { 若 (行 >= 结首[i] && 行 <= 结末[i]) 返 i; i = i + 1; }
    返 -1;
}
静 整 结槽取(字 *a, 字 *b, 字 **ss, 字 **se, 整 *w, 整 *是存) {
    字 *p; 字 *q;
    *ss = 0; *se = 0; *w = 0; *是存 = 0;
    若 (前缀(a, b, "取帧32 ") || 前缀(a, b, "存帧32 ")) *w = 32;
    否 若 (前缀(a, b, "取帧64 ") || 前缀(a, b, "存帧64 ")) *w = 64;
    否 返 0;
    *是存 = 前缀(a, b, "存帧32 ") || 前缀(a, b, "存帧64 ");
    p = a; 循环 (p < b && p[0] != '[') p = p + 1;
    若 (p >= b) 返 0;
    q = p; 循环 (q < b && q[0] != ']') q = q + 1;
    若 (q >= b) 返 0;
    *ss = p; *se = q + 1;
    返 1;
}
静 整 结纯写于(字 *a, 字 *b, 整 r) {
    字 *os; 字 *oe; 字 *s2; 字 *e2;
    若 (!纯写名(a, b)) 返 0;
    若 (!元操(a, b, 1, &os, &oe)) 返 0;
    若 (寄号(os, oe) != r) 返 0;
    若 (元操(a, b, 2, &s2, &e2)) { 若 (含寄(s2, e2, r) != 0) 返 0; }
    返 1;
}
静 整 结寄死(整 从行, 整 r) {
    整 k = 从行; 整 m;
    循环 (k < 行数) {
        字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
        若 (b - a == 0) { k = k + 1; 续; }
        若 (结是标号(a, b)) { 若 (a[0] != '.') 返 1; k = k + 1; 续; }
        m = 含寄(a, b, r);
        若 (m == 0) { k = k + 1; 续; }
        若 (m < 0) 返 0;
        若 (结纯写于(a, b, r)) 返 1;
        返 0;
    }
    返 1;
}
/* 槽洁净：环内 [hl, tl] 里凡是**提及该槽**的行，都必须是「同宽的 取帧32/64 或 存帧32/64」。
   别的形态（浮存帧 / 单存帧 / 存8帧 / 存16帧 / 存字节帧 / 取帧址 …）即使只是写一个字节，
   提升后的寄存器也不会被更新（我们只改写认得的那两种），出口又会把旧值回写 ⟹ 语义被改。
   所以判据反转：不认识的写法 ⟹ 该槽不提升。 */
静 整 槽洁净(整 hl, 整 tl, 字 *ss, 字 *se, 整 w) {
    整 k; 整 w2; 整 存2; 整 可;
    字 *a; 字 *b2; 字 *s2; 字 *e2;
    k = hl;
    循环 (k <= tl) {
        去白(行起[k], 行止[k], &a, &b2);
        若 (b2 - a > 0 && !结是标号(a, b2) && a[0] != ';') {
            若 (含区(a, b2, ss, se)) {
                可 = 0; w2 = 0; 存2 = 0;
                若 (结槽取(a, b2, &s2, &e2, &w2, &存2)) { 若 (w2 == w) 可 = 1; }
                若 (!可) 返 0;
            }
        }
        k = k + 1;
    }
    返 1;
}
/* 帧槽 存取 形态 的 编码长度（与 行长 同源同公式；只用于**自报**，正确性由汇编器实测） */
静 整 槽长(字 *p) {
    整 i = 0; 整 d;
    循环 (p[i] != 0) i = i + 1;
    d = 元位移(p, p + i);
    若 (d < 0) 返 -1;
    返 4 + (d >= 128 ? 3 : 0);
}
/* 本函数范围（以 非 `.` 标号 为界） */
静 空 函界(整 行, 整 *起, 整 *止) {
    整 k = 行; 字 *a; 字 *b;
    *起 = 0; *止 = 行数 - 1;
    循环 (k >= 0) {
        去白(行起[k], 行止[k], &a, &b);
        若 (结是标号(a, b) && a[0] != '.') { *起 = k; 断; }
        k = k - 1;
    }
    k = *起 + 1;
    循环 (k < 行数) {
        去白(行起[k], 行止[k], &a, &b);
        若 (结是标号(a, b) && a[0] != '.') { *止 = k - 1; 返; }
        k = k + 1;
    }
}
/* `s..e` 里是否含 区间 [t, te)（槽文本不是 NUL 结尾，必须按区间比） */
静 整 含区(字 *s, 字 *e, 字 *t, 字 *te) {
    整 n = te - t; 整 i = 0; 整 j; 整 同;
    若 (n <= 0 || e - s < n) 返 0;
    循环 (s + i + n <= e) {
        j = 0; 同 = 1;
        循环 (j < n) { 若 (s[i + j] != t[j]) { 同 = 0; 断; } j = j + 1; }
        若 (同) 返 1;
        i = i + 1;
    }
    返 0;
}
/* `s..e` 是否含 NUL 结尾串 t */
静 整 含文(字 *s, 字 *e, 字 *t) {
    整 n = 0; 整 i = 0; 整 j; 整 同;
    循环 (t[n] != 0) n = n + 1;
    若 (n <= 0 || e - s < n) 返 0;
    循环 (s + i + n <= e) {
        j = 0; 同 = 1;
        循环 (j < n) { 若 (s[i + j] != t[j]) { 同 = 0; 断; } j = j + 1; }
        若 (同) 返 1;
        i = i + 1;
    }
    返 0;
}
/* 槽的地址 是否在 本函数内 被取（取帧址 形态含槽文本）；槽文本按**区间**给（不是 NUL 结尾） */
静 整 槽址泄区(整 起, 整 止, 字 *槽, 字 *槽e) {
    整 k = 起; 字 *a; 字 *b;
    循环 (k <= 止) {
        去白(行起[k], 行止[k], &a, &b);
        若 (前缀(a, b, "取帧址 ") && 含区(a, b, 槽, 槽e)) 返 1;
        k = k + 1;
    }
    返 0;
}
静 整 槽址泄(整 起, 整 止, 字 *槽) {
    整 n = 0;
    循环 (槽[n] != 0) n = n + 1;
    返 槽址泄区(起, 止, 槽, 槽 + n);
}
静 整 结提一(整 id) {
    整 头序; 整 尾序; 整 头行; 整 尾行; 整 头块; 整 出块; 整 出标行;
    整 k; 整 w; 整 rF; 整 c; 整 槽N; 整 best; 整 bn; 整 i3; 整 j3;
    整 槽宽[8]; 整 取数[8]; 整 存数[8]; 整 提过[8]; 整 取行[8][64]; 整 存行[8][64];
    字 *槽文[8];
    整 起; 整 止; 整 已提; 整 寄用; 整 混宽; 整 干; 整 死; 整 等; 整 槽L;
    整 偏; 整 净;
    字 *ss; 字 *se; 整 存; 整 f; 整 i2; 整 j2; 整 同;
    字 *a; 字 *b; 字 *ts; 字 *te; 整 tb; 整 无条;
    字 *ds; 字 *de; 字 *os; 字 *oe; 整 dr; 整 sr;
    若 (id < 1 || id > 元环数) 返 0;
    若 (!元序行 || !结前起 || !结活入) 返 0;
    头序 = 元Ls[id]; 尾序 = 元Le[id];
    若 (头序 < 0 || 尾序 < 头序 || 尾序 >= 元n) 返 0;
    头行 = 元序行[头序]; 尾行 = 元序行[尾序];
    若 (头行 < 0 || 尾行 < 头行) 返 0;
    头块 = 结块含(头行);
    若 (头块 < 0 || 结标行[头块] < 0) 返 0;
    若 (环验(头行, 尾行, 头块, &出块) == 0) { 结环拒 = 结环拒 + 1; 返 0; }
    若 (结标行[出块] >= 0) {
        出标行 = 结标行[出块];
        若 (出标行 <= 尾行) 返 0;
    } 否 {
        出标行 = 结首[出块] - 1;                /* 落空出口: 尾块条件跳回、落空出去 ⟹ 回写点在 尾行之后 */
        若 (出标行 < 尾行 || 出标行 < 0) 返 0;
    }
    函界(头行, &起, &止);
    /* ---- 扫环内：拒绝 调用 / 取址；收集 槽 ---- */
    槽N = 0;
    k = 头行;
    循环 (k <= 尾行) {
        去白(行起[k], 行止[k], &a, &b);
        若 (名同(a, b, "调用") || 名同(a, b, "中调用") || 名同(a, b, "调系统") || 名同(a, b, "间调用")) 返 0;
        若 (野控流(a, b)) 返 0;                    /* 环内 间跳/中断/陷阱 ⟹ 真出口可能绕过回写 */
        若 (名同(a, b, "取址") || 名同(a, b, "取帧址")) 返 0;
        若 (结槽取(a, b, &ss, &se, &w, &存)) {
            f = -1;
            i2 = 0;
            循环 (i2 < 槽N) {
                同 = 1;
                若 (槽宽[i2] != w) 同 = 0;
                否 若 (槽文[i2] == 0) 同 = 0;
                否 { j2 = 0; 循环 (j2 < se - ss) { 若 (槽文[i2][j2] != ss[j2]) 同 = 0; j2 = j2 + 1; } 若 (槽文[i2][se - ss] != 0) 同 = 0; }
                若 (同) f = i2;
                i2 = i2 + 1;
            }
            若 (f < 0 && 槽N < 8) {
                f = 槽N;
                槽文[f] = malloc(se - ss + 1);
                复制内存(槽文[f], ss, se - ss);
                槽文[f][se - ss] = 0;
                槽宽[f] = w; 取数[f] = 0; 存数[f] = 0; 提过[f] = 0;
                槽N = 槽N + 1;
            }
            若 (f >= 0 && 槽宽[f] == w) {
                若 (存) { 若 (存数[f] < 64) { 存行[f][存数[f]] = k; 存数[f] = 存数[f] + 1; } }
                否 { 若 (取数[f] < 64) { 取行[f][取数[f]] = k; 取数[f] = 取数[f] + 1; } }
            }
        }
        k = k + 1;
    }
    若 (槽N <= 0) 返 0;
    /* ---- 混宽 / 未知写形态：逐槽查「槽洁净」（同一槽文本两种宽度 ⟹ 后出现的那个槽 必然不洁净） ---- */
    混宽 = 0;
    /* ---- 逐槽提升（按访问数降序，最多 3 个，寄存器 r8/r9/r10）---- */
    已提 = 0; 寄用 = 0; 净 = 0;
    循环 (已提 < 3) {
        best = -1; bn = 0;
        c = 0;
        循环 (c < 槽N) {
            若 (!提过[c]) {
                i3 = 取数[c] + 存数[c];
                若 (i3 > bn) { bn = i3; best = c; }
            }
            c = c + 1;
        }
        若 (best < 0 || bn < 2) 断;
        提过[best] = 1;
        w = 槽宽[best];
        若 (槽址泄(起, 止, 槽文[best])) 续;
        槽L = 0;
        循环 (槽文[best][槽L] != 0) 槽L = 槽L + 1;
        若 (!槽洁净(头行, 尾行, 槽文[best], 槽文[best] + 槽L, w)) 续;   /* 环内有别的写法碰这个槽 ⟹ 不提升 */
        rF = -1;
        c = 8;
        循环 (c <= 10) {
            干 = 0;
            若 ((寄用 & (1 << c)) != 0) 干 = 1;
            若 (!干) {
                k = 头行;
                循环 (k <= 尾行) {
                    若 (!干) {
                        去白(行起[k], 行止[k], &a, &b);
                        若 (含寄(a, b, c) != 0) 干 = 1;
                    }
                    k = k + 1;
                }
            }
            死 = 0;
            若 ((结活入[头块] & (1 << c)) != 0) 死 = 1;
            若 ((结活入[出块] & (1 << c)) != 0) 死 = 1;
            若 (!干 && !死) { rF = c; 断; }
            c = c + 1;
        }
        若 (rF < 0) 断;
        寄用 = 寄用 | (1 << rF);
        若 (插前加(结标行[头块], 槽文[best], w, rF) == 0) 断;
        若 (插后加(出标行, 槽文[best], w, rF) == 0) 断;
        偏 = 槽长(槽文[best]);
        若 (偏 < 0) 偏 = 7;
        净 = 净 - 偏 - 偏;
        i3 = 0;
        循环 (i3 < 取数[best]) {
            k = 取行[best][i3];
            去白(行起[k], 行止[k], &a, &b);
            若 (元操(a, b, 1, &ds, &de)) {
                dr = 寄号(ds, de);
                若 (dr < 0) { 行动作[k] = 0; }
                否 若 (dr == rF) { 行动作[k] = 1; }
                否 { 行动作[k] = 2; 行动类[k] = 0; 行动宽[k] = w; 行动寄一[k] = dr; 行动寄二[k] = rF; 净 = 净 + 行长(a, b) - 3; }
            }
            i3 = i3 + 1;
        }
        i3 = 0;
        循环 (i3 < 存数[best]) {
            k = 存行[best][i3];
            去白(行起[k], 行止[k], &a, &b);
            若 (元操(a, b, 2, &os, &oe)) {
                sr = 寄号(os, oe);
                若 (sr < 0) { 行动作[k] = 0; }
                否 若 (sr == rF) { 行动作[k] = 1; }
                否 { 行动作[k] = 2; 行动类[k] = 1; 行动宽[k] = w; 行动寄一[k] = sr; 行动寄二[k] = rF; 净 = 净 + 行长(a, b) - 3; }
            }
            i3 = i3 + 1;
        }
        提槽数 = 提槽数 + 1;
        已提 = 已提 + 1;
    }
    提净字节 = 提净字节 + 净;
    返 已提;
}

/* ==================== R881b 跨基本块：存→取 转发 ====================
   块 p 末条是 `存帧w [S], rX`、p 不跳（落空进入 块 b）、b 的**前驱恰好只有 p**、
   b 首条是 `取帧w rY, [S]`（同槽同宽）⟹ b 的取 直接换成 `移w rY, rX`（rY==rX 则整条删）。
   这条优化**必须**用前驱信息：多一个入口，rX 就不保证还是那个值。 */
静 整 跨转数 = 0, 跨转字节 = 0;

静 整 块首令(整 b) {
    整 k = 结首[b]; 字 *a; 字 *b2;
    循环 (k <= 结末[b]) {
        去白(行起[k], 行止[k], &a, &b2);
        若 (b2 - a > 0 && !结是标号(a, b2) && a[0] != ';') 返 k;
        k = k + 1;
    }
    返 -1;
}
静 整 块末令(整 b) {
    整 k = 结末[b]; 字 *a; 字 *b2;
    循环 (k >= 结首[b]) {
        去白(行起[k], 行止[k], &a, &b2);
        若 (b2 - a > 0 && !结是标号(a, b2) && a[0] != ';') 返 k;
        k = k - 1;
    }
    返 -1;
}
静 整 块前令(整 b, 整 k) {
    整 q = k - 1; 字 *a; 字 *b2;
    循环 (q >= 结首[b]) {
        去白(行起[q], 行止[q], &a, &b2);
        若 (b2 - a > 0 && !结是标号(a, b2) && a[0] != ';') 返 q;
        q = q - 1;
    }
    返 -1;
}
/* ==================== R881b 跨基本块：存→取 转发 ====================
   块 b 的**前驱恰好一个** p，且 p 有一条边到 b；取 p 里**最后一条** `存帧w [S], rX`；
   p 中该存**之后**的尾巴不得再提及 [S]、不得写 rX、不得有调用；
   b 的首条是 `取帧w rY, [S]`（同槽同宽）⟹ 换成 `移w rY, rX`（rY==rX 整条删）。
   依据：基本块 + 前驱表 + 块内写集 文本判据 —— 全是结构事实，不猜。 */
静 整 跨块转(空) {
    整 b; 整 p; 整 l1; 整 l2; 整 w1; 整 w2; 整 存1; 整 存2; 整 i; 整 q; 整 干; 整 函起; 整 函止;
    字 *ss1; 字 *se1; 字 *ss2; 字 *se2; 字 *a; 字 *b2;
    字 *d2s; 字 *d2e; 字 *s1s; 字 *s1e; 字 *o1s; 字 *o1e;
    整 rX; 整 rY; 整 同;
    若 (!结在 || !结前起) 返 0;
    b = 1;
    循环 (b < 结块数) {
        若 (结前起[b + 1] - 结前起[b] == 1) {
            p = 结前列[结前起[b]];
            干 = 0;
            若 (结后一[p] == b || 结后二[p] == b) 干 = 1;
            若 (干) {
                l2 = 块首令(b);
                若 (l2 < 0 || 行动作[l2] != 0) 干 = 0;
            }
            若 (干) {
                l1 = -1;
                q = 块末令(p);
                循环 (q >= 结首[p] && l1 < 0) {
                    去白(行起[q], 行止[q], &a, &b2);
                    若 (b2 - a > 0 && !结是标号(a, b2) && a[0] != ';') {
                        存1 = 0; w1 = 0;
                        若 (结槽取(a, b2, &ss1, &se1, &w1, &存1)) { 若 (存1) l1 = q; }
                    }
                    q = q - 1;
                }
                若 (l1 < 0 || 行动作[l1] != 0) 干 = 0;
            }
            若 (干) {
                存1 = 0; w1 = 0;
                去白(行起[l1], 行止[l1], &a, &b2);
                若 (结槽取(a, b2, &ss1, &se1, &w1, &存1)) {
                    若 (!存1) 干 = 0;
                } 否 干 = 0;
            }
            若 (干) {
                /* 槽地址在本函数内被取过 ⟹ p 尾巴里可能 `存址 [rX], …`（不含槽文本，文本扫描抓不到）⟹ 不转发 */
                函界(结首[b], &函起, &函止);
                若 (槽址泄区(函起, 函止, ss1, se1)) 干 = 0;
            }
            若 (干) {
                rX = -1;
                去白(行起[l1], 行止[l1], &a, &b2);
                若 (元操(a, b2, 2, &s1s, &s1e)) rX = 寄号(s1s, s1e);
                若 (rX < 0) 干 = 0;
            }
            若 (干) {
                q = l1 + 1;
                循环 (q <= 结末[p] && 干) {
                    去白(行起[q], 行止[q], &a, &b2);
                    若 (b2 - a > 0 && !结是标号(a, b2) && a[0] != ';') {
                        若 (含区(a, b2, ss1, se1)) {
                            /* 只有**写**该槽 才破；读 不影响。写形态不枚举：
                               助记符里含「存」的一律当写（存帧32/64 · 浮存帧 · 单存帧 · 存8帧 · 存16帧 · 存字节帧 · 存帧址 …） */
                            若 (含文(a, b2, "存")) 干 = 0;
                            若 (干) {
                                若 (名同(a, b2, "取帧址")) 干 = 0;   /* 地址逃逸：可能有别的路径写 */
                            }
                        }
                        若 (干) {
                            若 (名同(a, b2, "调用") || 名同(a, b2, "中调用") || 名同(a, b2, "调系统") || 名同(a, b2, "间调用")) 干 = 0;
                        }
                        若 (干) {
                            若 (野控流(a, b2)) 干 = 0;   /* 目标不可静态确定 ⟹ 补出来的落空边不可信 */
                        }
                        若 (干) {
                            若 (元操(a, b2, 1, &o1s, &o1e)) { 若 (寄号(o1s, o1e) == rX) 干 = 0; }
                        }
                    }
                    q = q + 1;
                }
            }
            若 (干) {
                存2 = 0; w2 = 0; 同 = 0;
                去白(行起[l2], 行止[l2], &a, &b2);
                若 (结槽取(a, b2, &ss2, &se2, &w2, &存2)) {
                    若 (!存2) { 若 (w1 == w2) {
                        同 = ((se1 - ss1) == (se2 - ss2)) ? 1 : 0;
                        若 (同) { i = 0; 循环 (i < se1 - ss1) { 若 (ss1[i] != ss2[i]) 同 = 0; i = i + 1; } }
                    } }
                }
                若 (!同) 干 = 0;
            }
            若 (干) {
                rY = -1;
                去白(行起[l2], 行止[l2], &a, &b2);
                若 (元操(a, b2, 1, &d2s, &d2e)) rY = 寄号(d2s, d2e);
                若 (rY < 0) 干 = 0;
            }
            若 (干) {
                若 (rX == rY) {
                    行动作[l2] = 1;
                    跨转字节 = 跨转字节 + 行长(行起[l2], 行止[l2]);
                } 否 {
                    行动作[l2] = 2; 行动类[l2] = 0; 行动宽[l2] = w2;
                    行动寄一[l2] = rY; 行动寄二[l2] = rX;
                    跨转字节 = 跨转字节 + 行长(行起[l2], 行止[l2]) - 3;
                }
                跨转数 = 跨转数 + 1;
            }
        }
        b = b + 1;
    }
    返 跨转数;
}

/* 叶子环：没有其它 @L 区间 严格落在 [头行, 尾行] 内（内外环会同槽竞争同一个寄存器） */
静 整 结是叶环(整 id) {
    整 j; 整 hl; 整 tl; 整 hj; 整 tj;
    hl = 元序行[元Ls[id]]; tl = 元序行[元Le[id]];
    若 (hl < 0 || tl < 0) 返 0;
    j = 1;
    循环 (j <= 元环数) {
        若 (j != id && 元Ls[j] >= 0 && 元Le[j] >= 元Ls[j]) {
            hj = 元序行[元Ls[j]]; tj = 元序行[元Le[j]];
            若 (hj >= 0 && tj >= hj && hl <= hj && tj <= tl && (tj - hj) < (tl - hl)) 返 0;
        }
        j = j + 1;
    }
    返 1;
}
静 空 环提(空) {
    整 i;
    若 (!结在 || 元环数 <= 0 || !元序行 || !结活入) 返;
    i = 1;
    循环 (i <= 元环数) {
        若 (元Ls[i] >= 0 && 元Le[i] >= 元Ls[i]) { 若 (结是叶环(i)) 结提一(i); }
        i = i + 1;
    }
}

静 整 行长(字 *a, 字 *b) {
    字 *s = a; 字 *m; 字 *me; 字 *o1s; 字 *o1e; 字 *o2s; 字 *o2e;
    整 r1;
    循环 (s < b && s[0] == ' ') s = s + 1;
    m = s; 循环 (s < b && s[0] != ' ') s = s + 1; me = s;
    若 (!元操(a, b, 1, &o1s, &o1e)) 返 -1;
    若 (!元操(a, b, 2, &o2s, &o2e)) { o2s = o1e; o2e = o1e; }
    r1 = 寄号(o1s, o1e);
    若 (名等(m, me, "移动") || 名等(m, me, "移即")) 返 5 + (r1 >= 8 ? 1 : 0);
    若 (名等(m, me, "移64") || 名等(m, me, "移32")) 返 3;
    若 (名等(m, me, "零扩展")) {
        若 (名等(o1s, o1e, "eax") && 名等(o2s, o2e, "al")) 返 3;
        返 2 + (r1 >= 8 ? 1 : 0);
    }
    若 (名等(m, me, "符号扩展")) 返 3;
    若 (名等(m, me, "存帧32") || 名等(m, me, "存帧64")) {
        整 d1 = 元位移(o1s, o1e);   /* R881: 存的**内存操作数是第 1 个**（原按第 2 个=源寄存器 ⟹ 位移恒 -99999 ⟹ 大位移存 低估 3 字节） */
        若 (d1 < 0 && d1 != -99999) 返 -1;
        返 4 + (d1 >= 128 ? 3 : 0);
    }
    若 (名等(m, me, "取帧32") || 名等(m, me, "取帧64") || 名等(m, me, "取帧址")) {
        整 d = 元位移(o2s, o2e);
        若 (d < 0 && d != -99999) 返 -1;
        返 4 + (d >= 128 ? 3 : 0);
    }
    若 (名等(m, me, "取栈32") || 名等(m, me, "取栈64")) {
        整 d = 元位移(o2s, o2e);
        若 (d < 0 && d != -99999) 返 -1;
        返 5 + (d >= 128 ? 3 : 0);
    }
    若 (名等(m, me, "取静32")) 返 6;
    若 (名等(m, me, "取静64") || 名等(m, me, "取静址")) 返 7;
    若 (名等(m, me, "取址")) {
        整 d = 元位移(o2s, o2e);
        若 (d < 0 && d != -99999) 返 -1;
        返 5 + (d >= 128 ? 3 : 0);
    }
    返 -1;
}
静 整 元Dce字节 = 0;

/* @I 行: `; @I <序> f=… n=… k=… t=… l=… d=…` */
静 空 元吃I(字 *a, 字 *b) {
    字 *p = a + 5; 整 序 = -1; 整 v; 整 有 = 0;
    循环 (p < b && p[0] == ' ') p = p + 1;
    若 (!元数取(&p, b, &序)) 返;
    若 (序 < 0 || 序 >= 元n) { 元在 = -2; 返; }
    若 (元I函[序] != -2) { 元在 = -2; 返; }  /* 重复 归属 */
    元I函[序] = 0; 元I节[序] = 0; 元I环[序] = -1; 元I层[序] = 0; 元I型[序] = -1; 元I构[序] = -1;
    循环 (p < b) {
        循环 (p < b && p[0] == ' ') p = p + 1;
        若 (p + 2 <= b && p[1] == '=') {
            字 c = p[0]; p = p + 2;
            若 (元数取(&p, b, &v)) {
                若 (c == 'f') 元I函[序] = v;
                否 若 (c == 'n') 元I节[序] = v;
                否 若 (c == 'k') 元I型[序] = v;
                否 若 (c == 't') 元I构[序] = v;
                否 若 (c == 'l') 元I环[序] = v;
                否 若 (c == 'd') 元I层[序] = v;
                有 = 1;
            }
        } 否 { 循环 (p < b && p[0] != ' ') p = p + 1; }
    }
    若 (!有) 元在 = -2;
}
/* @U 行: `; @U <序> r=<寄号> u=<a,b,c>` ⟹ 只 记 用户数（DCE 只 需 0/非0；完整列表 留在 .asm 供 人 读） */
静 空 元吃U(字 *a, 字 *b) {
    字 *p = a + 5; 整 序 = -1; 整 v; 整 寄 = -1; 整 用 = 0;
    循环 (p < b && p[0] == ' ') p = p + 1;
    若 (!元数取(&p, b, &序)) 返;
    若 (序 < 0 || 序 >= 元n) { 元在 = -2; 返; }
    循环 (p < b) {
        循环 (p < b && p[0] == ' ') p = p + 1;
        若 (p + 2 <= b && p[1] == '=') {
            字 c = p[0]; p = p + 2;
            若 (c == 'r') { 若 (元数取(&p, b, &v)) 寄 = v; }
            否 若 (c == 'z') { 若 (元数取(&p, b, &v)) { 若 (v != 0) 元Z[序] = 1; } }
            否 若 (c == 'u') {
                /* 列表: 空 ⟹ 0；否则 逗号数 + 1；**每个 索引 必须 0 < u < ins 且 u > 序**（悬挂 判红） */
                若 (p < b && p[0] >= '0' && p[0] <= '9') {
                    用 = 1;
                    循环 (p < b && p[0] != ' ') {
                        若 (p[0] >= '0' && p[0] <= '9') {
                            整 uv = 0;
                            循环 (p < b && p[0] >= '0' && p[0] <= '9') { uv = uv * 10 + (p[0] - '0'); p = p + 1; }
                            若 (uv <= 序 || uv >= 元n) 元在 = -2;
                        } 否 若 (p[0] == ',') { 用 = 用 + 1; p = p + 1; }
                        否 { 元在 = -2; p = p + 1; }
                    }
                }
            }
        } 否 { 循环 (p < b && p[0] != ' ') p = p + 1; }
    }
    元Def[序] = 寄;
    元用数[序] = 用;
}
/* @L 行: `; @L <id> s=<起> e=<止> d=<深>` */
静 空 元吃L(字 *a, 字 *b) {
    字 *p = a + 5; 整 id = -1; 整 v; 整 s = -1; 整 e = -1; 整 d = 0;
    循环 (p < b && p[0] == ' ') p = p + 1;
    若 (!元数取(&p, b, &id)) 返;
    循环 (p < b) {
        循环 (p < b && p[0] == ' ') p = p + 1;
        若 (p + 2 <= b && p[1] == '=') {
            字 c = p[0]; p = p + 2;
            若 (元数取(&p, b, &v)) {
                若 (c == 's') s = v;
                否 若 (c == 'e') e = v;
                否 若 (c == 'd') d = v;
            }
        } 否 { 循环 (p < b && p[0] != ' ') p = p + 1; }
    }
    若 (id < 1 || id > 元环数) { 元在 = -2; 返; }
    若 (s < 0 || e < s || e >= 元n) { 元在 = -2; 返; }
    若 (d < 1) { 元在 = -2; 返; }
    元Ls[id] = s; 元Le[id] = e; 元Ld[id] = d;
}
/* 行表（每行的 槽提升动作 / 两处插入槽）——**无附录时也要有**：变换里的钩子会读它。
   负数控制（擦掉附录）走 `元解` 的早退分支，同样必须备好，否则 解引用 空指针。 */
静 空 行表备(空) {
    整 i = 0;
    行动作 = malloc(4 * (行数 + 1)); 行动类 = malloc(4 * (行数 + 1));
    行动宽 = malloc(4 * (行数 + 1)); 行动寄一 = malloc(4 * (行数 + 1)); 行动寄二 = malloc(4 * (行数 + 1));
    插前槽 = malloc(8 * 3 * (行数 + 1)); 插后槽 = malloc(8 * 3 * (行数 + 1));
    插前宽 = malloc(4 * 3 * (行数 + 1)); 插前寄 = malloc(4 * 3 * (行数 + 1));
    插后宽 = malloc(4 * 3 * (行数 + 1)); 插后寄 = malloc(4 * 3 * (行数 + 1));
    循环 (i < 行数) {
        行动作[i] = 0; 行动类[i] = 0; 行动宽[i] = 0; 行动寄一[i] = 0; 行动寄二[i] = 0;
        插前槽[i * 3] = 0; 插前槽[i * 3 + 1] = 0; 插前槽[i * 3 + 2] = 0;
        插后槽[i * 3] = 0; 插后槽[i * 3 + 1] = 0; 插后槽[i * 3 + 2] = 0;
        插前宽[i * 3] = 0; 插前寄[i * 3] = 0; 插后宽[i * 3] = 0; 插后寄[i * 3] = 0;
        插前宽[i * 3 + 1] = 0; 插前寄[i * 3 + 1] = 0; 插后宽[i * 3 + 1] = 0; 插后寄[i * 3 + 1] = 0;
        插前宽[i * 3 + 2] = 0; 插前寄[i * 3 + 2] = 0; 插后宽[i * 3 + 2] = 0; 插后寄[i * 3 + 2] = 0;
        i = i + 1;
    }
}

静 整 元解(空) {
    整 i; 整 序;
    /* 第一遍: 找 头 行 */
    i = 0;
    循环 (i < 行数) {
        字 *a; 字 *b; 去白(行起[i], 行止[i], &a, &b);
        若 (b - a > 12 && 前缀(a, b, "; @QCCMETA 1 ")) {
            字 *p = a + 12; 整 v;
            循环 (p < b) {
                字 *k0; 字 *k1;
                循环 (p < b && p[0] == ' ') p = p + 1;
                k0 = p;
                循环 (p < b && p[0] != '=' && p[0] != ' ') p = p + 1;
                k1 = p;
                若 (p < b && p[0] == '=') {
                    p = p + 1;
                    若 (元数取(&p, b, &v)) {
                        若 (名等(k0, k1, "ins")) 元n = v;
                        否 若 (名等(k0, k1, "funcs")) 元函数数 = v;
                        否 若 (名等(k0, k1, "loops")) 元环数 = v;
                        否 若 (名等(k0, k1, "nodes")) 元节点数 = v;
                    }
                } 否 { 循环 (p < b && p[0] != ' ') p = p + 1; }
            }
            元在 = 1;
            断;
        }
        i = i + 1;
    }
    若 (!元在) { 行表备(); 类10 = 0; 返 0; }   /* 无 附录 ⟹ 不做 元数据 通道（负控 走 这里） */
    若 (元n <= 0 || 元n > 1200000) { 输出("ERROR: 元数据 ins 非法 (%d)\n", 元n); 返 1; }
    元I节 = malloc(4 * (元n + 1)); 元I函 = malloc(4 * (元n + 1)); 元I环 = malloc(4 * (元n + 1));
    元I层 = malloc(4 * (元n + 1)); 元I型 = malloc(4 * (元n + 1)); 元I构 = malloc(4 * (元n + 1));
    元Def = malloc(4 * (元n + 1)); 元用数 = malloc(4 * (元n + 1)); 元Z = malloc(4 * (元n + 1));
    元行序 = malloc(4 * (行数 + 1));
    元序行 = malloc(4 * (元n + 1));
    行表备();
    元Ls = malloc(4 * (元环数 + 2)); 元Le = malloc(4 * (元环数 + 2)); 元Ld = malloc(4 * (元环数 + 2));
    i = 0;
    循环 (i <= 元n) { 元I函[i] = -2; 元I节[i] = -1; 元I环[i] = -1; 元I层[i] = 0; 元I型[i] = -1; 元I构[i] = -1; 元Def[i] = -1; 元用数[i] = 0; 元Z[i] = 0; i = i + 1; }
    i = 0;
    循环 (i <= 元环数) { 元Ls[i] = -1; 元Le[i] = -1; 元Ld[i] = 0; i = i + 1; }
    i = 0;
    循环 (i < 行数) { 元行序[i] = -1; i = i + 1; }
    i = 0;
    循环 (i <= 元n) { 元序行[i] = -1; i = i + 1; }
    /* 第二遍: 指令 序号 映射 + 吃 @I/@U/@L */
    序 = 0;
    i = 0;
    循环 (i < 行数) {
        字 *a; 字 *b; 去白(行起[i], 行止[i], &a, &b);
        若 (元是令(行起[i], 行止[i])) { 元行序[i] = 序; 若 (序 <= 元n) 元序行[序] = i; 序 = 序 + 1; }
        否 若 (前缀(a, b, "; @I ")) 元吃I(a, b);
        否 若 (前缀(a, b, "; @U ")) 元吃U(a, b);
        否 若 (前缀(a, b, "; @L ")) 元吃L(a, b);
        i = i + 1;
    }
    /* 良构 校验 */
    若 (序 != 元n) { 输出("ERROR: 元数据 覆盖率 不符: 指令行=%d 头行 ins=%d\n", 序, 元n); 返 1; }
    若 (元在 == -2) { 输出("ERROR: 元数据 记录 越界/重复（悬挂 引用 或 格式 破损）\n"); 返 1; }
    i = 0;
    循环 (i < 元n) {
        若 (元I函[i] == -2) { 输出("ERROR: 元数据 覆盖率 缺口: 指令 %d 无 @I 归属\n", i); 返 1; }
        若 (元I节[i] < 0 || 元I节[i] >= 元节点数) { 输出("ERROR: 元数据 悬挂 节点: 指令 %d node=%d（域 [0,%d)）\n", i, 元I节[i], 元节点数); 返 1; }
        若 (元I型[i] < 0 || 元I型[i] > 31) { 输出("ERROR: 元数据 类型码 越界: 指令 %d k=%d\n", i, 元I型[i]); 返 1; }
        若 (元I构[i] < -1 || 元I构[i] >= 元节点数) { 输出("ERROR: 元数据 构序 越界: 指令 %d t=%d\n", i, 元I构[i]); 返 1; }
        若 (元I环[i] < -1 || 元I环[i] > 元环数) { 输出("ERROR: 元数据 循环 引用 越界: 指令 %d l=%d\n", i, 元I环[i]); 返 1; }
        若 (元Def[i] < -1 || 元Def[i] > 15) { 输出("ERROR: 元数据 定义 寄存器 越界: 指令 %d r=%d\n", i, 元Def[i]); 返 1; }
        i = i + 1;
    }
    输出("[元数据] ins=%d funcs=%d loops=%d nodes=%d 覆盖率 全 悬挂 0 循环区间 良构 类型码 合法\n",
         元n, 元函数数, 元环数, 元节点数);
    返 0;
}

/* 取第 n 个操作数（1 起；按逗号切，去两端空白）。返 1 = 取到。 */
静 整 元操(字 *a, 字 *b, 整 n, 字 **os, 字 **oe) {
    字 *p = a; 整 计 = 1;
    /* 与 asm 的逐操作数读法同构：SK（**只**空格/Tab）；n>1 时再吃一个**可选**逗号 + SK；然后取一个 token。
       旧版把逗号也当分隔符 ⟹ `压栈 ,r0` 会取到 "r0"（asm 的 RG 却是 -1 ⟹ 该行 NOEMIT）⟹ ⑫/⑪ 误命中、
       产出 `.删 压栈 ,r0` ⟹ 汇编器报「.删/.增 实测长度非正」⟹ 优化产物不可汇编（R881R）。 */
    循环 (p < b && p[0] != ' ' && p[0] != 9) p = p + 1;
    循环 (p < b) {
        循环 (p < b && (p[0] == ' ' || p[0] == 9)) p = p + 1;
        若 (计 > 1) {
            若 (p < b && p[0] == ',') p = p + 1;
            循环 (p < b && (p[0] == ' ' || p[0] == 9)) p = p + 1;
        }
        *os = p;
        循环 (p < b && p[0] != ',' && p[0] != ' ' && p[0] != 9) p = p + 1;
        *oe = p;
        若 (计 == n) 返 (p > *os) ? 1 : 0;
        计 = 计 + 1;
    }
    返 0;
}
静 整 元立即(字 *s, 字 *e) {
    若 (s < e && s[0] == '-') s = s + 1;
    若 (s >= e) 返 0;
    循环 (s < e) { 若 (s[0] < '0' || s[0] > '9') 返 0; s = s + 1; }
    返 1;
}
/* 按 asm_zh `NUM` 的**同一份语法**解析一个立即数 token：可选前导 '-'；`0x…` 十六进制（大小写）；
   否则十进制；要求整段被吃掉；>2^24 视作溢出 ⟹ 失败（不猜）。
   为什么必须同源：`减栈 N` 与 `[rsp±d]` 的位移都由这套语法决定，两边口径不一致就会把
   `减栈 -8`（实为 rsp+=8）与 `[rsp-22]` 误配（R881M 打回：未优化 7 / 优化 5）。 */
静 整 元数值(字 *s, 字 *e, 整 *v) {
    整 sg = 1; 整 r = 0; 整 有 = 0; 整 d;
    *v = 0;
    若 (s < e && s[0] == '-') { sg = -1; s = s + 1; }
    若 (s + 1 < e && s[0] == '0' && s[1] == 'x') {   /* 只认小写 `0x`：asm_zh NUM 就是只认小写 */
        s = s + 2;
        循环 (s < e) {
            d = -1;
            若 (s[0] >= '0' && s[0] <= '9') d = s[0] - '0';
            否 若 (s[0] >= 'a' && s[0] <= 'f') d = s[0] - 'a' + 10;
            否 若 (s[0] >= 'A' && s[0] <= 'F') d = s[0] - 'A' + 10;
            若 (d < 0) 返 0;
            r = r * 16 + d; 有 = 1;
            若 (r > 16777216) 返 0;
            s = s + 1;
        }
    } 否 {
        循环 (s < e) {
            若 (s[0] < '0' || s[0] > '9') 返 0;
            r = r * 10 + (s[0] - '0'); 有 = 1;
            若 (r > 16777216) 返 0;
            s = s + 1;
        }
    }
    若 (!有) 返 0;
    *v = sg * r;
    返 1;
}
/* ⑫ 算术-立即数 融合：`压栈 r0 / 移动 r0,K / 弹栈 rX / <op> rX,r0 / 移32 r0,rX`
   ==> `<op> r0, K`（6 条 → 1 条）。K 必须 立即数；op 限 32/64 位 加/减/与/或/异或。
   语义: rX = 旧 r0；`op rX, K` 与 `op rX, r0(=K)` 同；末尾 移回 r0 ⟹ 结果落 r0。 */
/* ===== asm_zh 文法端口：**按位置**的操作数游标 =====
   asm 的 `SK()` 只吞空格与 Tab；`RG/NUM` 就从这个位置开始读，**从不跳逗号**。
   优化器若用 `元操`（按逗号/空格切）取操作数，就会把 `减栈 ,40` 读成 40（asm 读成 0）、
   把 `压栈 ,r0` 读成「压了 r0」（asm 的 RG 返 -1 ⟹ 根本不压）⟹ 误折（R881Q 打回：89/7、57/7）。 */
静 字 *令后(字 *a, 字 *b) {
    字 *p = a;
    循环 (p < b && p[0] != ' ' && p[0] != 9) p = p + 1;      /* 跳过助记符 */
    循环 (p < b && (p[0] == ' ' || p[0] == 9)) p = p + 1;    /* 只吞空格/Tab（不吞逗号） */
    返 p;
}
/* `RG` 端口：从 p 起按 asm 的**前缀**规则认一个寄存器（`r<数字>`、8/16/32/64 位别名、al/cl/dl/bl）。
   认不出（含逗号开头、`rip`、`ax` 之类 RG 不接受的拼写）⟹ 返 0。 */
静 整 元寄(字 *p, 字 *e, 整 *r, 字 **pe) {
    字 *q; 整 v;
    *r = -1; *pe = p;
    循环 (p < e && (p[0] == ' ' || p[0] == 9)) p = p + 1;
    若 (p < e && p[0] == '[') p = p + 1;
    若 (p + 1 < e && p[0] == 'r' && p[1] >= '0' && p[1] <= '9') {
        v = 0; q = p + 1;
        循环 (q < e && q[0] >= '0' && q[0] <= '9') { v = v * 10 + (q[0] - '0'); q = q + 1; }
        若 (v > 15) 返 0;
        *r = v; *pe = q; 返 1;
    }
    若 (前缀(p, e, "eax") || 前缀(p, e, "rax")) { *r = 0; *pe = p + 3; 返 1; }
    若 (前缀(p, e, "ecx") || 前缀(p, e, "rcx")) { *r = 1; *pe = p + 3; 返 1; }
    若 (前缀(p, e, "edx") || 前缀(p, e, "rdx")) { *r = 2; *pe = p + 3; 返 1; }
    若 (前缀(p, e, "ebx") || 前缀(p, e, "rbx")) { *r = 3; *pe = p + 3; 返 1; }
    若 (前缀(p, e, "esp") || 前缀(p, e, "rsp")) { *r = 4; *pe = p + 3; 返 1; }
    若 (前缀(p, e, "ebp") || 前缀(p, e, "rbp")) { *r = 5; *pe = p + 3; 返 1; }
    若 (前缀(p, e, "esi") || 前缀(p, e, "rsi")) { *r = 6; *pe = p + 3; 返 1; }
    若 (前缀(p, e, "edi") || 前缀(p, e, "rdi")) { *r = 7; *pe = p + 3; 返 1; }
    若 (前缀(p, e, "al")) { *r = 0; *pe = p + 2; 返 1; }
    若 (前缀(p, e, "cl")) { *r = 1; *pe = p + 2; 返 1; }
    若 (前缀(p, e, "dl")) { *r = 2; *pe = p + 2; 返 1; }
    若 (前缀(p, e, "bl")) { *r = 3; *pe = p + 2; 返 1; }
    返 0;
}
/* ===== asm_zh 文法端口：基址 token 的**闭表** =====
   asm 的 `RG`（srclib/asm_zh.jy:182）按**前缀**消费：`r4b` 只吃 `r4`，剩下的 `b` 交给后面的 `NUM`
   （⟹ 位移 0）；而 `取栈64/存栈64`（asm_zh.jy:469-470）**丢弃** MEM 解析出的基址、固定编码 rsp+SIB。
   ⟹ 优化器判「[rsp+N]」只有一条稳的路：基址按**整 token** 只认闭表；表外一律 opaque（不折）。
   闭表 = asm RG 里映射到 4 的三个拼写：`rsp` / `esp` / `r4`（`sp` 不在 RG 表里 ⟹ 故意不收）。
   表外必须拒：`check_opt_per_pass.py` 的「基址闭表闸」逐名验（表内 ⟹ 折、表外 ⟹ 不折）。 */
静 整 基号(字 *s, 字 *e) {
    若 (名等(s, e, "rsp") || 名等(s, e, "esp") || 名等(s, e, "r4")) 返 4;
    返 -1;
}
/* 取形如 `[基 ± 位移]` 的内存操作数 ⟹ 返 1，并给出 基=寄号、移=位移（无符号位按 0）。
   **fail-closed**：基址整 token 认闭表（`基号`）；位移走 `元数值`（＝asm NUM 端口）；
   操作数必须**恰好**以 `]` 收尾（任何多余字节 ⟹ 返 0）。
   容忍的空白：`[r4+40]` / `[r4 + 40]` / `[r4<TAB>+<TAB>40]` / `[ rsp + 40 ]` 同判。 */
静 整 栈取(字 *a, 字 *b, 整 *基, 整 *移, 整 *目) {
    字 *p; 字 *q; 字 *e; 整 v; 整 sg;
    *基 = -1; *移 = 0; *目 = -1;
    /* 与 asm 的 `取栈64` handler 同构：SK；RG（目的）；SK；可选 ','；SK；MEM（**只在这里**接受 '['）。 */
    p = 令后(a, b);
    若 (!元寄(p, b, 目, &p)) 返 0;
    循环 (p < b && (p[0] == ' ' || p[0] == 9)) p = p + 1;
    若 (p < b && p[0] == ',') p = p + 1;
    循环 (p < b && (p[0] == ' ' || p[0] == 9)) p = p + 1;
    若 (p >= b || p[0] != '[') 返 0;
    p = p + 1;
    循环 (p < b && (p[0] == ' ' || p[0] == 9)) p = p + 1;
    q = p;
    循环 (q < b && (甲字母(q[0]) || (q[0] >= '0' && q[0] <= '9') || q[0] == '_')) q = q + 1;
    若 (q <= p) 返 0;
    *基 = 基号(p, q);
    若 (*基 < 0) 返 0;
    循环 (q < b && (q[0] == ' ' || q[0] == 9)) q = q + 1;
    sg = 1;
    若 (q < b && q[0] == '+') q = q + 1;
    否 若 (q < b && q[0] == '-') { sg = -1; q = q + 1; }
    循环 (q < b && (q[0] == ' ' || q[0] == 9)) q = q + 1;
    e = q;
    循环 (e < b && e[0] != ']' && e[0] != ' ' && e[0] != 9) e = e + 1;
    若 (e > q) {
        若 (!元数值(q, e, &v)) 返 0;
        *移 = sg * v;
        q = e;
    }
    循环 (q < b && (q[0] == ' ' || q[0] == 9)) q = q + 1;
    若 (q >= b || q[0] != ']') 返 0;
    q = q + 1;
    循环 (q < b && (q[0] == ' ' || q[0] == 9)) q = q + 1;
    若 (q != b) 返 0;
    返 1;
}
/* ⑮ 压栈回读消冗（R881L · 根治版）：`压栈 rX / 减栈 N / 取栈64 rY,[rsp+N]`
   ⟹ 前两行**原样发射**，只把回读换成寄存器搬移（rY == rX ⟹ 整条删；否则 `移64 rY, rX`）。
   **本 pass 永不删/改内存写** ⟹ 内存逐字节不变 ⟹ callee（`调用`/`调系统`/间接跳…）、别名、
   取址逃逸、生命周期、控制流**全都不需要证明**。只剩两条机械前提：
     ① rX != rsp、rY != rsp（`减栈` 之后 rsp 已变；`压栈 rsp` 存的是旧 rsp）；
     ② 回读操作数解析出「基址 = rsp 族 且 位移 = N」，N 取自上一条 `减栈` 的立即数
        （`栈取` 容忍任意空白/Tab）。
   为什么等价：A=[R+N] 的内容 = 刚压进去的 rX；`减栈` 不写寄存器 ⟹ 回读拿到的就是 rX ⟹ 换成
   寄存器搬移逐位相同；而**没有任何一条内存写被删/改** ⟹ 谁也观察不到差异。
   历史（R881b–R881k，评审七轮全部打在同一处）：旧版**删掉 `压栈`**（省 1 字节 + 省一次写），
   于是必须证明「以后没人读那一格」；但 A 在调用点恰好落在**调用者的 outgoing 区**
   （A = 调用点 rsp + 40），callee 一条 `取栈64 rX,[rsp+48]` 就能读到（复现：scripts/callee_read.py，
   未优化 7 / 优化 0）。改成「不删写者」后，这条原理上做不干净的证明**整个消失**；
   代价是 fib 少一档收益（28.1% → 23.6%，仍过 23% 门槛）。 */
静 整 压栈回读(整 k) {
    字 *a1; 字 *b1; 字 *a2; 字 *b2; 字 *a3; 字 *b3;
    字 *xs; 字 *xe; 字 *vs; 字 *ve;
    整 n; 整 基; 整 移; 整 rx; 整 ry;
    若 (k + 2 >= 行数) 返 0;
    去白(行起[k], 行止[k], &a1, &b1);
    去白(行起[k + 1], 行止[k + 1], &a2, &b2);
    去白(行起[k + 2], 行止[k + 2], &a3, &b3);
    若 (!前缀(a1, b1, "压栈 ")) 返 0;
    若 (!前缀(a2, b2, "减栈 ")) 返 0;
    若 (!前缀(a3, b3, "取栈64 ")) 返 0;
    /* 三个操作数**按位置**取（与 asm 的 SK/RG/NUM 同构；`元操` 会跳逗号 ⟹ 不许用） */
    若 (!元寄(令后(a1, b1), b1, &rx, &xs)) 返 0;
    若 (rx == 4) 返 0;                        /* ① 压栈源 = rsp */
    vs = 令后(a2, b2); ve = vs;
    循环 (ve < b2 && ve[0] != ',' && ve[0] != ' ' && ve[0] != 9) ve = ve + 1;
    若 (ve <= vs) 返 0;                       /* `减栈 ,40` ⟹ 位置上是逗号 ⟹ 不认 */
    若 (!元数值(vs, ve, &n)) 返 0;              /* 与汇编器 NUM 同源：符号 + 十六进制 */
    基 = -1; 移 = 0; ry = -1;
    若 (!栈取(a3, b3, &基, &移, &ry)) 返 0;
    若 (ry == 4) 返 0;                        /* ① 回读目的 = rsp */
    若 (基 != 4 || 移 != n) 返 0;             /* ② 地址不是 [rsp+N] */
    /* 发射：写者两行原样输出（内存不变）；回读整条删，目的 != 源 时补一条 `移64` */
    出区(行起[k], 行止[k]); 出字(10);
    出区(行起[k + 1], 行止[k + 1]); 出字(10);
    出串(".删 "); 出区(行起[k + 2], 行止[k + 2]); 出字(10);
    若 (rx != ry) {
        出串(".替"); 出字(10);
        出串("    移64 r"); 出数(ry); 出串(", r"); 出数(rx); 出字(10);
    }
    返 1;
}
静 整 算立(整 k) {
    字 *a0; 字 *b0; 字 *a1; 字 *b1; 字 *a2; 字 *b2; 字 *a3; 字 *b3; 字 *a4; 字 *b4;
    字 *s0; 字 *e0; 字 *ks; 字 *ke; 字 *xs; 字 *xe; 字 *t; 字 *te;
    字 *c1s; 字 *c1e; 字 *c2s; 字 *c2e;
    常 字 *op = 0;
    若 (k + 4 >= 行数) 返 0;
    去白(行起[k], 行止[k], &a0, &b0);
    去白(行起[k + 1], 行止[k + 1], &a1, &b1);
    去白(行起[k + 2], 行止[k + 2], &a2, &b2);
    去白(行起[k + 3], 行止[k + 3], &a3, &b3);
    去白(行起[k + 4], 行止[k + 4], &a4, &b4);
    若 (!前缀(a0, b0, "压栈 ")) 返 0;
    若 (!(前缀(a1, b1, "移动 ") || 前缀(a1, b1, "移即 "))) 返 0;
    若 (!前缀(a2, b2, "弹栈 ")) 返 0;
    若 (前缀(a3, b3, "加 ")) op = "加";
    否 若 (前缀(a3, b3, "减 ")) op = "减";
    否 若 (前缀(a3, b3, "与 ")) op = "与";
    否 若 (前缀(a3, b3, "或 ")) op = "或";
    否 若 (前缀(a3, b3, "异或 ")) op = "异或";
    否 若 (前缀(a3, b3, "加64 ")) op = "加64";
    否 若 (前缀(a3, b3, "减64 ")) op = "减64";
    否 若 (前缀(a3, b3, "与64 ")) op = "与64";
    否 若 (前缀(a3, b3, "或64 ")) op = "或64";
    否 若 (前缀(a3, b3, "异或64 ")) op = "异或64";
    否 返 0;
    若 (!前缀(a4, b4, "移32 ") && !前缀(a4, b4, "移64 ")) 返 0;
    若 (!元操(a0, b0, 1, &s0, &e0)) 返 0;
    若 (!名等(s0, e0, "r0")) 返 0;
    若 (!元操(a1, b1, 1, &t, &te)) 返 0;
    若 (!名等(t, te, "r0")) 返 0;
    若 (!元操(a1, b1, 2, &ks, &ke)) 返 0;
    若 (!元立即(ks, ke)) 返 0;
    若 (!元操(a2, b2, 1, &xs, &xe)) 返 0;
    若 (寄号(xs, xe) < 0) 返 0;
    若 (名等(xs, xe, "r0")) 返 0;   /* R880c: 弹栈 目的 == r0 ⟹ 覆盖 K ⟹ 语义 变成 V op V，不能融合 */
    若 (!元操(a3, b3, 1, &c1s, &c1e) || !元操(a3, b3, 2, &c2s, &c2e)) 返 0;
    若 (!寄等(c1s, c1e, xs, xe) || !名等(c2s, c2e, "r0")) 返 0;
    若 (!元操(a4, b4, 1, &c1s, &c1e) || !元操(a4, b4, 2, &c2s, &c2e)) 返 0;
    若 (!名等(c1s, c1e, "r0") || !寄等(c2s, c2e, xs, xe)) 返 0;
    整 计 = 0;
    循环 (计 < 5) { 出串(".删 "); 出区(行起[k + 计], 行止[k + 计]); 出字(10); 计 = 计 + 1; }
    出串(".替"); 出字(10);
    出串("    "); 出串(op); 出串(" r0, "); 出区(ks, ke); 出字(10);
    返 1;
}


/* ⑪ 比较-分支 融合：命中 返 1 并 已 输出；否则 返 0。 */
静 整 比合(整 k) {
    字 *a0; 字 *b0; 字 *a1; 字 *b1; 字 *a2; 字 *b2; 字 *a3; 字 *b3;
    字 *a4; 字 *b4; 字 *a5; 字 *b5; 字 *a6; 字 *b6; 字 *a7; 字 *b7;
    字 *s; 字 *e;
    字 *as; 字 *ae; 字 *ks; 字 *ke; 字 *bs; 字 *be;
    字 *c1s; 字 *c1e; 字 *c2s; 字 *c2e;
    字 *t; 字 *lt; 常 字 *逆 = 0;
    去白(行起[k], 行止[k], &a0, &b0);
    去白(行起[k + 1], 行止[k + 1], &a1, &b1);
    去白(行起[k + 2], 行止[k + 2], &a2, &b2);
    去白(行起[k + 3], 行止[k + 3], &a3, &b3);
    去白(行起[k + 4], 行止[k + 4], &a4, &b4);
    去白(行起[k + 5], 行止[k + 5], &a5, &b5);
    去白(行起[k + 6], 行止[k + 6], &a6, &b6);
    去白(行起[k + 7], 行止[k + 7], &a7, &b7);
    若 (!前缀(a0, b0, "压栈 ")) 返 0;
    若 (!(前缀(a1, b1, "移动 ") || 前缀(a1, b1, "移即 "))) 返 0;
    若 (!前缀(a2, b2, "弹栈 ")) 返 0;
    若 (!前缀(a3, b3, "比较 ")) 返 0;
    若 (!(前缀(a4, b4, "置") && 后缀(a4, b4, " al"))) 返 0;
    若 (!等于(a5, b5, "零扩展 eax, al")) 返 0;
    若 (!等于(a6, b6, "测试 r0, r0")) 返 0;
    若 (!前缀(a7, b7, "为零跳 ")) 返 0;
    /* A = 压栈 源；K = 移动 第二操作数（立即数）；B = 弹栈 目的 */
    若 (!元操(a0, b0, 1, &as, &ae)) 返 0;
    若 (!元操(a1, b1, 1, &t, &lt)) 返 0;
    若 (!名等(t, lt, "r0")) 返 0;
    若 (!元操(a1, b1, 2, &ks, &ke)) 返 0;
    若 (!元立即(ks, ke)) 返 0;
    若 (!元操(a2, b2, 1, &bs, &be)) 返 0;
    若 (寄号(as, ae) < 0 || 寄号(bs, be) < 0) 返 0;
    若 (名等(bs, be, "r0")) 返 0;   /* R880c: 弹栈 目的 == r0 ⟹ 覆盖 K ⟹ 原序列 比较 V,V，不能融合 */
    /* 比较 B, r0 */
    若 (!元操(a3, b3, 1, &c1s, &c1e) || !元操(a3, b3, 2, &c2s, &c2e)) 返 0;
    若 (!寄等(c1s, c1e, bs, be) || !名等(c2s, c2e, "r0")) 返 0;
    /* 置X al ⟹ 逆 条件 跳 */
    字 *mn = a4; 字 *mne = b4 - 3;   /* 去掉 " al" */
    若 (名等(mn, mne, "置小")) 逆 = "大于等跳";
    否 若 (名等(mn, mne, "置小等")) 逆 = "大跳";
    否 若 (名等(mn, mne, "置大")) 逆 = "小于等跳";
    否 若 (名等(mn, mne, "置大等")) 逆 = "小跳";
    否 若 (名等(mn, mne, "置等")) 逆 = "非零跳";
    否 若 (名等(mn, mne, "置不等")) 逆 = "为零跳";
    否 若 (名等(mn, mne, "置低")) 逆 = "高于等跳";
    否 若 (名等(mn, mne, "置低等")) 逆 = "高于跳";
    否 返 0;
    /* 目标 标号 */
    s = a7 + 9; 循环 (s < b7 && s[0] == ' ') s = s + 1;
    e = b7; 若 (e <= s) 返 0;
    整 计 = 0;
    循环 (计 < 8) { 出串(".删 "); 出区(行起[k + 计], 行止[k + 计]); 出字(10); 计 = 计 + 1; }
    出串(".替"); 出字(10);
    出串("    比较 "); 出区(as, ae); 出串(", "); 出区(ks, ke); 出字(10);
    出串(".替"); 出字(10);
    出串("    "); 出串(逆); 出串(" "); 出区(s, e); 出字(10);
    返 1;
}

/* 跨行模式的**消耗范围**内 不得有 槽提升动作（否则 提升后的寄存器 不再被写 ⟹ 语义错）。
   逐个模式 传 自己的 行数 —— 全局窗口 会误伤 紧随其后的 ⑪/⑫（实测 循环条件 退回 9 条）。 */
静 整 行动区(整 k, 整 n) {
    整 i = k;
    循环 (i < k + n) {
        若 (i >= 行数) 返 0;
        若 (行动作[i] != 0) 返 1;
        i = i + 1;
    }
    返 0;
}

/* 主变换：原地扫描行表，输出优化后文本。返 变换条数。
   注: **不再输出任何字节数** —— 一切缩短量由汇编器对 `.删`/`.替` 实测（单源真相在编码器）。 */
静 整 变换(空) {
    整 k = 0; 整 次 = 0;
    循环 (k < 行数) {
        字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
        /* R880: 元数据 附录 行 不是 汇编 —— 原样 吞掉（不写进 输出） */
        若 (元是元行(a, b)) { k = k + 1; 续; }
        /* R881 结构级：插前（头前载入）/ 槽提升动作 / 插后（出口回写）
           插入指令 用 `.增` 让汇编器**实测**记账（否则其后的 [rip+N] 全部错位）；
           替换 仍走 `.删`+`.替` 实测通道。自报字节 只用于判据反查（.text 差 == 自报）。 */
        若 (插前槽[k * 3] != 0 || 插前槽[k * 3 + 1] != 0 || 插前槽[k * 3 + 2] != 0) {
            整 q;
            q = 0;
            循环 (q < 3) {
                若 (插前槽[k * 3 + q] != 0) {
                    出串(".增   取帧"); 出数(插前宽[k * 3 + q]); 出串(" r"); 出数(插前寄[k * 3 + q]);
                    出串(", "); 出串(插前槽[k * 3 + q]); 出字(10);
                    出串("    取帧"); 出数(插前宽[k * 3 + q]); 出串(" r"); 出数(插前寄[k * 3 + q]);
                    出串(", "); 出串(插前槽[k * 3 + q]); 出字(10);
                }
                q = q + 1;
            }
        }
        若 (行动作[k] == 1) {
            出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
            k = k + 1; 续;
        }
        若 (行动作[k] == 2) {
            出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
            出串(".替"); 出字(10);
            若 (行动类[k] == 0) { 出串("    移"); 出数(行动宽[k]); 出串(" r"); 出数(行动寄一[k]); 出串(", r"); 出数(行动寄二[k]); 出字(10); }
            否 { 出串("    移"); 出数(行动宽[k]); 出串(" r"); 出数(行动寄二[k]); 出串(", r"); 出数(行动寄一[k]); 出字(10); }
            k = k + 1; 续;
        }
        若 (插后槽[k * 3] != 0 || 插后槽[k * 3 + 1] != 0 || 插后槽[k * 3 + 2] != 0) {
            整 q2;
            出区(行起[k], 行止[k]); 出字(10);      /* 先发射 出口标号 本身，回写必须在它之后 */
            q2 = 0;
            循环 (q2 < 3) {
                若 (插后槽[k * 3 + q2] != 0) {
                    出串(".增   存帧"); 出数(插后宽[k * 3 + q2]); 出串(" "); 出串(插后槽[k * 3 + q2]);
                    出串(", r"); 出数(插后寄[k * 3 + q2]); 出字(10);
                    出串("    存帧"); 出数(插后宽[k * 3 + q2]); 出串(" "); 出串(插后槽[k * 3 + q2]);
                    出串(", r"); 出数(插后寄[k * 3 + q2]); 出字(10);
                }
                q2 = q2 + 1;
            }
            k = k + 1; 续;
        }
        /* R880: G-DCE（跨基本块 · 全局死定义）—— 依据 发射侧 def-use:
           纯写 指令 + 其定义 寄存器 在 本函数内 用户数 0 + 目的 非 r4/r5(rsp/rbp) ⟹ 删除。
           负控: 附录 被 擦掉 时 元在=0 ⟹ 本分支 永不 进入。 */
        若 (元在 == 1 && 元行序[k] >= 0) {
            整 序k = 元行序[k];
            整 长k = 行长(a, b);
            若 (序k < 元n && 元Def[序k] >= 0 && 元Def[序k] != 4 && 元Def[序k] != 5 && 元用数[序k] == 0
                && 元Z[序k] == 1 && 元纯写行(a, b) && 长k >= 0) {
                出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                类10 = 类10 + 1;
                元Dce字节 = 元Dce字节 + 长k;
                次 = 次 + 1; k = k + 1; 续;
            }
        }
        /* ① 减栈 8 / 存栈64 [rsp+0], rX  ==>  压栈 rX */
        若 (等于(a, b, "减栈 8") && k + 1 < 行数 && !行动区(k, 2)) {
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            若 (前缀(a2, b2, "存栈64 [rsp+0], ")) {
                字 *r = a2; 循环 (r + 1 < b2 && !(r[0] == ',' && r[1] == ' ')) r = r + 1; r = r + 2;
                /* 只声明删/替：字节数一律由汇编器**实测**（原手写常量已删除） */
                出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                出串(".替"); 出字(10);
                出串("    压栈 "); 出区(r, b2); 出字(10);
                类1 = 类1 + 1;
                次 = 次 + 1; k = k + 2; 续;
            }
        }
        /* ② 取栈64 rX, [rsp+0] / 加栈 8  ==>  弹栈 rX  (操作数必须精确为 [rsp+0]) */
        若 (前缀(a, b, "取栈64 ") && 后缀(a, b, ", [rsp+0]") && k + 1 < 行数 && !行动区(k, 2)) {
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            若 (等于(a2, b2, "加栈 8")) {
                字 *rs = 过空格(到空格(a, b), b);   /* 跳过 "取栈64" 到寄存器名 */
                字 *re = 到逗号(rs, b);
                字 *re2 = 尾白(rs, re);
                /* 只声明删/替：字节由汇编器实测（原手写常量已删除） */
                出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                出串(".替"); 出字(10);
                出串("    弹栈 "); 出区(rs, re2); 出字(10);
                类2 = 类2 + 1;
                次 = 次 + 1; k = k + 2; 续;
            }
        }
        /* ③ 加栈 N 紧跟 减栈 N ==> 两条都删（先释放后分配, 净效果 0, 且不触发 guard 探测） */
        若 (前缀(a, b, "加栈 ") && k + 1 < 行数 && !行动区(k, 2)) {
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            若 (前缀(a2, b2, "减栈 ") && 操作数同(a, b, a2, b2)) {
                /* 两条都删（只声明删，无替换体 ⟹ 无需 .替）；字节由汇编器实测 */
                出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                类3 = 类3 + 1;
                次 = 次 + 1; k = k + 2; 续;   /* 两条都不输出 */
            }
        }
        /* ⑮ 压栈回读折叠：`压栈 rX / 减栈 N / 取栈64 rY,[rsp+N+8]` ⟹ `减栈 N+8`（+移64） */
        若 (k + 2 < 行数 && !行动区(k, 3) && 压栈回读(k) != 0) { 类13 = 类13 + 1; 次 = 次 + 1; k = k + 3; 续; }
        /* ⑨ 零栈调整：`加栈 0` / `减栈 0` 是 **no-op**（栈指针 加减 0）。
           真实来源：编译器 对 无本地变量 的 调用前后 会 发 `加栈 0`（实测 序言/运行时 段 有 5 处）。
           保守判据：整行 **逐字** 等于 `加栈 0` 或 `减栈 0`（不认 其它操作数，也 不认 空格 变体）。
           只声明 `.删`，字节 由 汇编器 干跑 实测（与 ①–⑧ 同口径）。 */
        若 (等于(a, b, "加栈 0") || 等于(a, b, "减栈 0")) {
            出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
            类9 = 类9 + 1;
            次 = 次 + 1; k = k + 1; 续;
        }
        /* ④ 跳转 紧跟 跳转/返回 ==> 后条不可达, 删之（跳转 5B / 返回 1B）
           注: 「跳转」带操作数, 故用 前缀 判定 —— 曾误用 整行相等 ⟹ 该 pass 从未触发 */
        若 (前缀(a, b, "跳转 ") && k + 1 < 行数 && !行动区(k + 1, 1)) {
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            若 (前缀(a2, b2, "跳转 ")) {
                出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                类4 = 类4 + 1;
                次 = 次 + 1; k = k + 2; 续;
            }
            若 (等于(a2, b2, "返回")) {
                出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                类4乙 = 类4乙 + 1;
                次 = 次 + 1; k = k + 2; 续;
            }
        }
        /* ⑤ 复制传播 + 死值: 移64 rX,rY / 移64 rZ,rX / 移64 rX,*  ==>  移64 rZ,rY / 移64 rX,* */
        若 ((前缀(a, b, "移64 ") || 前缀(a, b, "移32 ")) && k + 2 < 行数 && !行动区(k, 2)) {
            常 字 *op = 前缀(a, b, "移64 ") ? "移64 " : "移32 ";
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            字 *a3; 字 *b3; 去白(行起[k + 2], 行止[k + 2], &a3, &b3);
            若 (前缀(a2, b2, op) && 前缀(a3, b3, op)) {
                字 *x1s; 字 *x1e; 字 *y1s; 字 *y1e;
                字 *z2s; 字 *z2e; 字 *x2s; 字 *x2e;
                字 *x3s; 字 *x3e; 字 *s3s; 字 *s3e;
                若 (取寄(a, b, 1, &x1s, &x1e) && 取寄(a, b, 2, &y1s, &y1e) &&
                    取寄(a2, b2, 1, &z2s, &z2e) && 取寄(a2, b2, 2, &x2s, &x2e) &&
                    取寄(a3, b3, 1, &x3s, &x3e) && 取寄(a3, b3, 2, &s3s, &s3e)) {
                    /* 判据:
                       ① 第二行的源 == 第一行的目的（寄等）；
                       ② 第三行的目的也是 rX（寄等 ⟹ 逐字同）；
                       ③ 第三行必须是**纯写** rX：目的是寄存器（不以 '[' 开头 ⟹ 不是内存写）；
                       ④ 第三行**不得读 rX**：源操作数里不得出现 rX 的号（含 rbp/rsp 等**别名**，
                          认不出的寄存器式 token 一律保守拒绝）⟹ 原实现只查「第一个寄存器 == rX」，
                          会把 `移64 rX,[rX+8]` / `移64 rX,rX` 这类**仍在读 rX** 的第三行误判为死值 ⟹ 误编译。 */
                    整 xn = 寄号(x1s, x1e);
                    若 (xn >= 0 && 寄等(x1s, x1e, x2s, x2e) && 寄等(x1s, x1e, x3s, x3e) &&
                        x3s[0] != '[' && 寄号(x3s, x3e) == xn && 含寄(s3s, s3e, xn) == 0) {
                        出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                        出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                        出串(".替"); 出字(10);
                        出串("    "); 出串(op); 出区(z2s, z2e); 出串(", "); 出区(y1s, y1e); 出字(10);
                        类5 = 类5 + 1;
                        次 = 次 + 1; k = k + 2; 续;
                    }
                }
            }
        }
        /* ⑥ 跳转 .Lx 紧跟标号 .Lx:  ==>  目标即下一行, 删跳转（省 该跳转编码长度; 标号原样保留）
           安全前提: 目标标号唯一（重名标号下 asm_zh 取最后定义 ⟹ 原跳转其实飞向别处 ⟹ 不可删）。 */
        若 (k + 1 < 行数) {
            若 (跳落删(k) > 0) { 类6 = 类6 + 1; 次 = 次 + 1; k = k + 2; 续; }
        }
        /* ⑪ 比较-分支 融合（R880）: `压栈 rA / 移动 r0,K / 弹栈 rB / 比较 rB,r0 / 置X al /
           零扩展 eax,al / 测试 r0,r0 / 为零跳 L`  ==>  `比较 rA,K` + 逆条件跳 L
           （9 条 → 2 条；K 必须是 立即数；逆向 条件 = 置X 的 补集）。字节数 一律 由汇编器 实测。 */
        若 (k + 4 < 行数 && !行动区(k, 5) && 算立(k) != 0) { 类12 = 类12 + 1; 次 = 次 + 1; k = k + 5; 续; }
        若 (k + 7 < 行数 && !行动区(k, 8) && 比合(k) != 0) { 类11 = 类11 + 1; 次 = 次 + 1; k = k + 8; 续; }
        /* ⑦ 帧/栈「存→取 同址相邻」⟹ 删取 / 删取+换移（字节数由汇编器**实测**） */
        若 (k + 1 < 行数 && !行动区(k, 2) && 存取同址(k) != 0) { 类7 = 类7 + 1; 次 = 次 + 1; k = k + 2; 续; }
        /* ⑧ 死值写覆盖（紧跟纯写覆盖 ⟹ 前条死值；只吃第一行，第二行仍要发射；字节由汇编器实测） */
        若 (k + 1 < 行数 && 死写删(k) != 0) { 类8 = 类8 + 1; 次 = 次 + 1; k = k + 1; 续; }
        出区(行起[k], 行止[k]); 出字(10);
        k = k + 1;
    }
    返 次;
}

静 整 main(整 argc, 字 **argv) {
    常 字 *inf = 0; 常 字 *outf = 0;
    整 i; 遍 (i = 1; i < argc; i = i + 1) { 若 (strcmp(argv[i], "-o") == 0 && i + 1 < argc) { outf = argv[i + 1]; i = i + 1; } 否 inf = argv[i]; }
    若 (inf == 0 || outf == 0) { 输出("Usage: opt_zh <in.asm> -o <out.asm>\n"); 返 1; }
    FILE *fi = fopen(inf, "rb"); 若 (fi == 0) { 输出("Cannot open %s\n", inf); 返 1; }
    fseek(fi, 0, 2); 整 n = ftell(fi); fseek(fi, 0, 0);
    字 *t = malloc(n + 1); fread(t, 1, n, fi); t[n] = 0; fclose(fi);
    切行(t, n);
    若 (元解() != 0) { 输出("优化器 拒绝: 元数据 良构 校验 失败（不静默降级）\n"); 返 1; }
    若 (元在 == 1) {
        结建();
        若 (结块错 > 0) { 输出("ERROR: 控制流结构 破损: 跳转目标 解析不到 (%d 处) — 拒绝 编译\n", 结块错); 返 1; }
        结建前();
        结活算();
        输出("[结构] 块=%d 边=%d 前驱表 良构 活集 迭代=%d\n", 结块数, 结边数, 结活轮);
        环提();
        跨块转();
    }
    标建表();   /* 标号计数表（pass ⑥ 的「目标标号唯一」守卫要用） */
    出初始化(n);
    整 次 = 变换();
    FILE *fo = fopen(outf, "wb"); 若 (fo == 0) { 输出("Cannot write %s\n", outf); 返 1; }
    fwrite(出行, 1, 出长, fo); fclose(fo);
    若 (元在 == 1) 输出("[元数据] G-DCE 删字节=%d（自报，行长模型；只删可定长形态）\n", 元Dce字节);
    若 (元在 == 1) 输出("[循环] LSP 槽=%d 净减字节=%d 环验证拒=%d（自报；取帧/存帧→移，头前载入、出口回写）\n", 提槽数, 提净字节, 结环拒);
    若 (元在 == 1) 输出("[跨块] 存→取 转发 条=%d 净减字节=%d（自报；前驱唯一 + 落空边 锁定）\n", 跨转数, 跨转字节);
    输出("OK: %s 优化 %d 处 [栈spill %d / 栈合并 %d / 抵消对 %d / 不可达 跳转 %d 返回 %d / 复制传播 %d / 跳落到下一行 %d / 帧栈存取同址 %d / 死值写覆盖 %d / 零栈调整 %d / G-DCE %d / 比较分支融合 %d / 算术立即融合 %d / 跨块转发 %d / 压栈回读 %d]  （字节数不在此报：由汇编器对 .删/.替 实测）  行数 %d -> 字节 %d -> %d\n", outf, 次, 类1, 类2, 类3, 类4, 类4乙, 类5, 类6, 类7, 类8, 类9, 类10, 类11, 类12, 跨转数, 类13, 行数, n, 出长);
    返 0;
}
