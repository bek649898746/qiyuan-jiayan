/* opt_zh.jy — 中文汇编层优化器（甲言版）
 * R599c-T10b / T10-2 ｜ 输入 .asm 文本 → 输出优化后的 .asm 文本
 * 用法: opt_zh <in.asm> [-o <out.asm>]
 *
 * 五条 pass（局部可证 · 语义完全等价）:
 *   ① 减栈 8  + 存栈64 [rsp+0], rX   ==>   压栈 rX        (省 11 或 10 字节/处)
 *   ② 取栈64 rX, [rsp+0] + 加栈 8     ==>   弹栈 rX        (省 11 或 10 字节/处)
 *   ③ 加栈 N  + 减栈 N（操作数逐字同） ==>   两条都删       (省 14 字节/处)
 *   ④ 跳转 X  后紧跟 跳转 Y / 返回     ==>   删后条（不可达） (省 5 / 1 字节/处)
 *   ⑤ 移64 rX,rY / 移64 rZ,rX / 移64 rX,存 ==> 移64 rZ,rY  (省 3 字节/处)
 *   ⑥ 跳转 .Lx 紧跟标号 .Lx:          ==>   删跳转（目标即下一行）(省 5 或 2 或 6 字节/处)
 * 逐点缩短量以 `.缩 N` 标注（累加即 `.缩总`），供中文汇编器把「代码区终点」与 rip 位移同步下移。
 * 纪律: 不认识的形态 一律 原样保留（宁可不动，绝不丢弃）；每条 pass 配负向用例。
 */

静 字 **行起;
静 字 **行止;
静 整 行数;
静 字 *出行;
静 整 出长, 出容;
/* 各类 pass 命中条数 —— 可复算读数（每轮直接印在收尾行, 便于第三方核对） */
静 整 类1, 类2, 类3, 类4, 类4乙, 类5, 类6, 类7, 类8, 类9;
/* 标号计数表 —— 判定「目标标号唯一」：asm_zh 对**重名标号**取最后一次定义的位置,
   故「跳到紧跟其后的标号」只有在目标标号唯一时才能真正删掉（否则原跳转其实飞向别处）。 */
静 整 *标槽; 静 字 **标名; 静 整 *标长; 静 整 *标数; 静 整 标n;

静 空 出初始化(整 n) { 出容 = n + 4096; 出行 = malloc(出容); 出长 = 0; }
静 空 出字(字 c) { 若 (出长 + 4 >= 出容) { 出容 = 出容 * 2; 出行 = realloc(出行, 出容); } 出行[出长] = c; 出长 = 出长 + 1; }
静 空 出区(字 *p, 字 *q) { 循环 (p < q) { 出字(p[0]); p = p + 1; } }
静 空 出串(常 字 *s) { 整 i = 0; 循环 (s[i] != 0) { 出字(s[i]); i = i + 1; } }
静 空 出数(整 v) { 字 b[16]; 整 n = 0; 若 (v == 0) { 出字('0'); 返; } 循环 (v > 0) { b[n] = (字)('0' + v % 10); v = v / 10; n = n + 1; } 循环 (n > 0) { n = n - 1; 出字(b[n]); } }

静 空 切行(字 *t, 整 n) {
    行起 = malloc(8 * 4200000); 行止 = malloc(8 * 4200000); 行数 = 0;
    整 i = 0; 整 s = 0;
    遍 (i = 0; i < n; i = i + 1) 若 (t[i] == 10) { 行起[行数] = t + s; 行止[行数] = t + i; 行数 = 行数 + 1; s = i + 1; }
    若 (s < n) { 行起[行数] = t + s; 行止[行数] = t + n; 行数 = 行数 + 1; }
}

静 空 去白(字 *s, 字 *e, 字 **a, 字 **b) {
    循环 (s < e && (s[0] == ' ' || s[0] == 9)) s = s + 1;
    循环 (e > s && (e[-1] == ' ' || e[-1] == 9)) e = e - 1;
    *a = s; *b = e;
}

静 整 等于(字 *s, 字 *e, 常 字 *p) {
    整 i = 0;
    循环 (p[i] != 0) { 若 (s + i >= e || s[i] != p[i]) 返 0; i = i + 1; }
    返 (s + i == e);
}

静 整 前缀(字 *s, 字 *e, 常 字 *p) {
    整 i = 0;
    循环 (p[i] != 0) { 若 (s + i >= e || s[i] != p[i]) 返 0; i = i + 1; }
    返 1;
}
静 整 后缀(字 *s, 字 *e, 常 字 *p) { /* R599c-T10b: 操作数必须精确匹配, 否则误替换 (如 [rsp+16] 被当 [rsp+0]) */
    整 n = 0; 循环 (p[n] != 0) n = n + 1;
    若 (e - s < n) 返 0;
    整 i = 0;
    循环 (i < n) { 若 (s[e - s - n + i] != p[i]) 返 0; i = i + 1; }
    返 1;
}

静 字 *到空格(字 *p, 字 *e) { 循环 (p < e && p[0] != ' ') p = p + 1; 返 p; }
静 字 *到逗号(字 *p, 字 *e) { 循环 (p < e && p[0] != ',') p = p + 1; 返 p; }
静 字 *过空格(字 *p, 字 *e) { 循环 (p < e && p[0] == ' ') p = p + 1; 返 p; }
静 字 *尾白(字 *p, 字 *q) { 循环 (q > p && q[-1] == ' ') q = q - 1; 返 q; } /* 去尾空 */

/* `助记符 操作数` 形式：取出「第一个空格之后」的操作数区间（用于比对两个助记符的操作数是否相同） */
静 整 操作数同(字 *a1, 字 *b1, 字 *a2, 字 *b2) {
    字 *s1 = 过空格(到空格(a1, b1), b1); 字 *e1 = 尾白(s1, b1);
    字 *s2 = 过空格(到空格(a2, b2), b2); 字 *e2 = 尾白(s2, b2);
    若 (e1 - s1 != e2 - s2) 返 0;
    整 i = 0; 循环 (i < e1 - s1) { 若 (s1[i] != s2[i]) 返 0; i = i + 1; }
    返 1;
}
/* `移64 rX, rY` 形式：取第 n 个寄存器区间的 [起,止)。n=1 取第一个、n=2 取第二个。找到返 1。 */
静 整 取寄(字 *a, 字 *b, 整 n, 字 **rs, 字 **re) {
    字 *p = 过空格(到空格(a, b), b);          /* 跳到第一个寄存器 */
    整 c = 1;
    循环 (1) {
        若 (p >= b) 返 0;
        *rs = p;
        循环 (p < b && p[0] != ',' && p[0] != ' ') p = p + 1;
        *re = p;
        若 (c == n) 返 1;
        c = c + 1;
        循环 (p < b && (p[0] == ',' || p[0] == ' ')) p = p + 1;
    }
    返 0;
}
静 整 寄等(字 *s1, 字 *e1, 字 *s2, 字 *e2) { /* 两段寄存器名是否相同 */
    若 (e1 - s1 != e2 - s2) 返 0;
    整 i = 0; 循环 (i < e1 - s1) { 若 (s1[i] != s2[i]) 返 0; i = i + 1; }
    返 1;
}
/* 行首助记符（到首个空白为止）是否恰好等于 t */
静 整 名同(字 *a, 字 *b, 常 字 *t) {
    整 i = 0;
    循环 (a + i < b && a[i] != ' ' && a[i] != 9 && t[i] != 0) { 若 (a[i] != t[i]) 返 0; i = i + 1; }
    返 ((a + i == b || a[i] == ' ' || a[i] == 9) && t[i] == 0);
}
/* 跳转类**匹配谓词**（不含任何字节常量 —— 缩短量一律由汇编器实测）。
   排除 环跳/环等跳/环不等跳（有递减计数寄存器副作用）与 调用（需压返回地址）。 */
静 整 跳类(字 *a, 字 *b) {
    若 (名同(a, b, "跳转") || 名同(a, b, "跳转短")) 返 1;
    若 (名同(a, b, "为零跳") || 名同(a, b, "非零跳") || 名同(a, b, "非负跳") || 名同(a, b, "非溢出跳")) 返 1;
    若 (名同(a, b, "负跳") || 名同(a, b, "大跳") || 名同(a, b, "小跳") || 名同(a, b, "溢跳") || 名同(a, b, "不溢跳")) 返 1;
    若 (名同(a, b, "奇跳") || 名同(a, b, "偶跳") || 名同(a, b, "大于等跳") || 名同(a, b, "小于等跳")) 返 1;
    若 (名同(a, b, "高于等跳") || 名同(a, b, "低于跳") || 名同(a, b, "高于跳")) 返 1;
    返 0;
}
静 整 标希(字 *s, 字 *e) { 整 h = 0; 循环 (s < e) { h = h * 37 + s[0]; s = s + 1; } 返 (h & 4194303); }
静 整 标查(字 *s, 字 *e) {   /* 命中 返 下标, 未命中 返 -1 */
    整 h = 标希(s, e); 整 g = 0;
    循环 (g < 4194304) {
        若 (标槽[h] == 0) 返 -1;
        整 j = 标槽[h] - 1;
        若 (标长[j] == (e - s) && 寄等(标名[j], 标名[j] + 标长[j], s, e)) 返 j;
        h = h + 1; 若 (h >= 4194304) h = 0;
        g = g + 1;
    }
    返 -1;
}
静 空 标增(字 *s, 字 *e) {
    整 j = 标查(s, e);
    若 (j >= 0) { 标数[j] = 标数[j] + 1; 返; }
    整 h = 标希(s, e);
    循环 (标槽[h] != 0) { h = h + 1; 若 (h >= 4194304) h = 0; }
    若 (标n >= 600000) { 输出("opt_zh: 标号表 溢出\n"); exit(1); }   /* 不静默丢弃 */
    标槽[h] = 标n + 1; 标名[标n] = s; 标长[标n] = (e - s); 标数[标n] = 1; 标n = 标n + 1;
}
静 整 无空格段(字 *s, 字 *e) { 循环 (s < e) { 若 (s[0] == ' ' || s[0] == 9 || s[0] == '"') 返 0; s = s + 1; } 返 1; }
/* ---- 寄存器号判定（供 ⑤ 的「第三行是否读 rX」守卫用；名字写法与数字写法同号）---- */
静 整 甲字母(字 c) { 返 ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')); }
静 整 名等(字 *s, 字 *e, 常 字 *t) { 整 i = 0; 循环 (s + i < e && t[i] != 0) { 若 (s[i] != t[i]) 返 0; i = i + 1; } 返 ((s + i == e) && t[i] == 0); }
静 整 寄号(字 *s, 字 *e) {   /* 单 token 的寄存器号；非寄存器 / 认不出 返 -1 */
    若 (e - s < 2) 返 -1;
    若 (!(s[0] == 'r' || s[0] == 'e')) 返 -1;
    若 (s[0] == 'r' && s[1] >= '0' && s[1] <= '9') {
        整 v = 0; 整 i = 1;
        循环 (i < e - s && s[i] >= '0' && s[i] <= '9') { v = v * 10 + (s[i] - '0'); i = i + 1; }
        返 (i == e - s && v <= 15) ? v : -1;
    }
    若 (名等(s, e, "rax") || 名等(s, e, "eax") || 名等(s, e, "ax") || 名等(s, e, "al")) 返 0;
    若 (名等(s, e, "rcx") || 名等(s, e, "ecx") || 名等(s, e, "cx") || 名等(s, e, "cl")) 返 1;
    若 (名等(s, e, "rdx") || 名等(s, e, "edx") || 名等(s, e, "dx") || 名等(s, e, "dl")) 返 2;
    若 (名等(s, e, "rbx") || 名等(s, e, "ebx") || 名等(s, e, "bx") || 名等(s, e, "bl")) 返 3;
    若 (名等(s, e, "rsp") || 名等(s, e, "esp") || 名等(s, e, "sp")) 返 4;
    若 (名等(s, e, "rbp") || 名等(s, e, "ebp") || 名等(s, e, "bp")) 返 5;
    若 (名等(s, e, "rsi") || 名等(s, e, "esi") || 名等(s, e, "si")) 返 6;
    若 (名等(s, e, "rdi") || 名等(s, e, "edi") || 名等(s, e, "di")) 返 7;
    返 -1;
}
/* 段内是否**引用**寄存器号 want：返 1 = 引用；0 = 确定不引用；-1 = 存在认不出的「寄存器式」token ⟹ 保守拒绝 */
静 整 含寄(字 *s, 字 *e, 整 want) {
    整 bad = 0; 整 hit = 0;
    循环 (s < e) {
        循环 (s < e && !(甲字母(s[0]) || (s[0] >= '0' && s[0] <= '9'))) s = s + 1;
        字 *t = s;
        循环 (s < e && (甲字母(s[0]) || (s[0] >= '0' && s[0] <= '9'))) s = s + 1;
        若 (s > t) { 整 r = 寄号(t, s); 若 (r < 0) { 若 (甲字母(t[0])) bad = 1; } 否 若 (r == want) hit = 1; }
    }
    若 (hit) 返 1;
    若 (bad) 返 -1;
    返 0;
}
静 空 标建表(空) {   /* 扫一遍行表, 统计每个标号出现次数 */
    标槽 = malloc(4 * 4194304); 标名 = malloc(8 * 600000); 标长 = malloc(4 * 600000); 标数 = malloc(4 * 600000);
    整 i = 0;
    循环 (i < 4194304) { 标槽[i] = 0; i = i + 1; }
    标n = 0; i = 0;
    循环 (i < 行数) {
        字 *a; 字 *b; 去白(行起[i], 行止[i], &a, &b);
        若 (b - a > 1 && b[-1] == ':' && 无空格段(a, b - 1)) 标增(a, b - 1);
        i = i + 1;
    }
}
/* ⑥ 判定: 第 k 行是「跳到紧跟其后标号」的跳转 ⟹ 返 该跳转编码字节数(>0 = 已删并已输出)。
   安全前提: 目标标号**唯一**（重名时 asm_zh 取最后定义 ⟹ 原跳转其实飞向别处 ⟹ 不可删）。 */
静 整 跳落删(整 k) {
    若 (k + 1 >= 行数) 返 0;
    字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
    若 (跳类(a, b) == 0) 返 0;
    字 *c; 字 *d; 去白(行起[k + 1], 行止[k + 1], &c, &d);
    若 (d - c <= 1 || d[-1] != ':') 返 0;
    字 *tg = 过空格(到空格(a, b), b);
    若 (tg >= b) 返 0;
    若 (寄等(c, d - 1, tg, b) == 0) 返 0;
    整 j = 标查(c, d - 1);
    若 (j < 0 || 标数[j] != 1) 返 0;
    出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
    出区(行起[k + 1], 行止[k + 1]); 出字(10);   /* 标号必须原样保留（其它跳转仍指向它） */
    返 1;
}

/* ⑦ 帧/栈「存 → 取 同址相邻」：存已把值写进 [基±N]，紧接的取若读同一地址即为冗余。
   同寄 ⟹ 删「取」；异寄 ⟹ 删「取」并换成 `移<宽> rY, rX`（低 N 位等价；宽度必须相同，否则上界字节不同）。
   **只声明删/替，字节数由汇编器实测**（该形态编码长度随位移分档变化：disp8=4B / disp32=7B）。
   安全前提：族/宽/基址/位移逐字相同 · 两行紧邻（无标号介入）。返 1 = 已处理并已输出。 */
静 整 存取同址(整 k) {
    字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
    字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
    常 字 *w = 0;
    若 (前缀(a, b, "存帧32 ") && 前缀(a2, b2, "取帧32 ")) w = "32";
    否 若 (前缀(a, b, "存帧64 ") && 前缀(a2, b2, "取帧64 ")) w = "64";
    否 若 (前缀(a, b, "存栈32 ") && 前缀(a2, b2, "取栈32 ")) w = "32";
    否 若 (前缀(a, b, "存栈64 ") && 前缀(a2, b2, "取栈64 ")) w = "64";
    否 返 0;
    字 *p1 = 过空格(到空格(a, b), b);          /* 存: 指向 '['
                                                   取(与存同助记符长度) 的对应位置见 p2 */
    字 *p2 = a2 + (p1 - a);
    若 (p1 >= b || p1[0] != '[' || p2 >= b2) 返 0;
    字 *c1 = 到逗号(p1, b);                    /* 存: 内存操作数 之后的逗号 */
    字 *m1s = p1; 字 *m1e = 尾白(p1, c1);
    字 *r1s = 过空格(c1 + 1, b); 字 *r1e = 尾白(r1s, b);
    字 *c2 = 到逗号(p2, b2);                   /* 取: 寄存器 之后的逗号 */
    字 *r2s = p2; 字 *r2e = 尾白(p2, c2);
    字 *m2s = 过空格(c2 + 1, b2); 字 *m2e = 尾白(m2s, b2);
    若 (m2s >= b2 || m2s[0] != '[') 返 0;
    若 (r1s >= r1e || r2s >= r2e) 返 0;
    若 (!寄等(m1s, m1e, m2s, m2e)) 返 0;       /* 同址（含基址与位移，逐字相同） */
    出区(行起[k], 行止[k]); 出字(10);                       /* 存 原样 */
    出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);  /* 删 取：长度由汇编器实测 */
    若 (!寄等(r1s, r1e, r2s, r2e)) {
        出串(".替"); 出字(10);                              /* 下一条是替换体 ⟹ 其长度扣回 */
        出串("    移"); 出串(w); 出串(" "); 出区(r2s, r2e); 出串(", "); 出区(r1s, r1e); 出字(10);
    }
    返 1;
}

/* 「纯写」助记符白名单：其**目的即全部效果**（不是读-改-写）。
   ⚠ 关键：`乘32 rX,rY` / `加 rX,N` / `左移 rX,N` / `自增 rX` 等目的同时是**隐式源** ⟹ 不能当纯覆盖！
   故此处用白名单（宁可不动），而不是「目的==rX 且显式源不含 rX」的宽松判据。 */
静 整 纯写名(字 *a, 字 *b) {
    若 (名同(a, b, "移动") || 名同(a, b, "移即") || 名同(a, b, "移64") || 名同(a, b, "移32")) 返 1;
    若 (名同(a, b, "取帧32") || 名同(a, b, "取帧64") || 名同(a, b, "取栈32") || 名同(a, b, "取栈64")) 返 1;
    若 (名同(a, b, "取静32") || 名同(a, b, "取静64") || 名同(a, b, "取静址") || 名同(a, b, "取帧址")) 返 1;
    若 (名同(a, b, "零扩展") || 名同(a, b, "零扩展32") || 名同(a, b, "零扩展64")) 返 1;
    若 (名同(a, b, "符号扩展") || 名同(a, b, "符号扩展64") || 名同(a, b, "符号扩展字节")) 返 1;
    若 (名同(a, b, "取静零8") || 名同(a, b, "取静符8") || 名同(a, b, "取静零16") || 名同(a, b, "取静符16")) 返 1;
    返 0;
}

/* ⑧ 死值写覆盖：`<mov 类> rX, …` 紧跟 `<纯写 rX，且源不读 rX>` ⟹ 前条写的是死值，删之。
   安全判据（按**寄存器号**、含 rbp/rsp 别名）：
     ① 第一行助记符 ∈ {移动, 移即, 移64, 移32}（mov 类 ⟹ **不置标志位**，删掉不改变后续 flags）；
     ② 第一行目的 = 纯寄存器 rX（非内存形态）；
     ③ 第二行目的 = 纯寄存器且号 == rX；
     ④ 第二行源**不得引用** rX 的号（含别名；认不出的寄存器式 token 一律保守拒绝）；
     ⑤ 两行紧邻、第二行不是标号行（标号落点亦安全：进入点只是少执行一次将被覆盖的写）。
   只声明 `.删`，字节由汇编器实测（能长随位移/寄存器分档变化）。 */
静 整 死写删(整 k) {
    若 (k + 1 >= 行数) 返 0;
    字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
    若 (!(名同(a, b, "移动") || 名同(a, b, "移即") || 名同(a, b, "移64") || 名同(a, b, "移32"))) 返 0;
    字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
    若 (b2 > a2 && b2[-1] == ':') 返 0;
    若 (!纯写名(a2, b2)) 返 0;                   /* 第二行必须是**纯写**（非读-改-写）*/
    字 *p = 过空格(到空格(a, b), b);
    若 (p >= b || p[0] == '[') 返 0;
    字 *pe = 尾白(p, 到逗号(p, b));
    整 xn = 寄号(p, pe);
    若 (xn < 0) 返 0;
    字 *q = 过空格(到空格(a2, b2), b2);
    若 (q >= b2 || q[0] == '[') 返 0;
    字 *qc = 到逗号(q, b2);
    若 (qc >= b2) 返 0;                         /* 无逗号 ⟹ 无法判定源 ⟹ 不动 */
    字 *qe = 尾白(q, qc);
    若 (寄号(q, qe) != xn) 返 0;
    字 *s2s = 过空格(qc + 1, b2); 字 *s2e = 尾白(s2s, b2);
    若 (s2s >= s2e) 返 0;
    若 (含寄(s2s, s2e, xn) != 0) 返 0;          /* 源读 rX（含别名）/ 认不出 ⟹ 原样保留 */
    出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
    返 1;
}

/* 主变换：原地扫描行表，输出优化后文本。返 变换条数。
   注: **不再输出任何字节数** —— 一切缩短量由汇编器对 `.删`/`.替` 实测（单源真相在编码器）。 */
静 整 变换(空) {
    整 k = 0; 整 次 = 0;
    循环 (k < 行数) {
        字 *a; 字 *b; 去白(行起[k], 行止[k], &a, &b);
        /* ① 减栈 8 / 存栈64 [rsp+0], rX  ==>  压栈 rX */
        若 (等于(a, b, "减栈 8") && k + 1 < 行数) {
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            若 (前缀(a2, b2, "存栈64 [rsp+0], ")) {
                字 *r = a2; 循环 (r + 1 < b2 && !(r[0] == ',' && r[1] == ' ')) r = r + 1; r = r + 2;
                /* 只声明删/替：字节数一律由汇编器**实测**（原手写常量已删除） */
                出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                出串(".替"); 出字(10);
                出串("    压栈 "); 出区(r, b2); 出字(10);
                类1 = 类1 + 1;
                次 = 次 + 1; k = k + 2; 续;
            }
        }
        /* ② 取栈64 rX, [rsp+0] / 加栈 8  ==>  弹栈 rX  (操作数必须精确为 [rsp+0]) */
        若 (前缀(a, b, "取栈64 ") && 后缀(a, b, ", [rsp+0]") && k + 1 < 行数) {
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            若 (等于(a2, b2, "加栈 8")) {
                字 *rs = 过空格(到空格(a, b), b);   /* 跳过 "取栈64" 到寄存器名 */
                字 *re = 到逗号(rs, b);
                字 *re2 = 尾白(rs, re);
                /* 只声明删/替：字节由汇编器实测（原手写常量已删除） */
                出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                出串(".替"); 出字(10);
                出串("    弹栈 "); 出区(rs, re2); 出字(10);
                类2 = 类2 + 1;
                次 = 次 + 1; k = k + 2; 续;
            }
        }
        /* ③ 加栈 N 紧跟 减栈 N ==> 两条都删（先释放后分配, 净效果 0, 且不触发 guard 探测） */
        若 (前缀(a, b, "加栈 ") && k + 1 < 行数) {
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            若 (前缀(a2, b2, "减栈 ") && 操作数同(a, b, a2, b2)) {
                /* 两条都删（只声明删，无替换体 ⟹ 无需 .替）；字节由汇编器实测 */
                出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                类3 = 类3 + 1;
                次 = 次 + 1; k = k + 2; 续;   /* 两条都不输出 */
            }
        }
        /* ⑨ 零栈调整：`加栈 0` / `减栈 0` 是 **no-op**（栈指针 加减 0）。
           真实来源：编译器 对 无本地变量 的 调用前后 会 发 `加栈 0`（实测 序言/运行时 段 有 5 处）。
           保守判据：整行 **逐字** 等于 `加栈 0` 或 `减栈 0`（不认 其它操作数，也 不认 空格 变体）。
           只声明 `.删`，字节 由 汇编器 干跑 实测（与 ①–⑧ 同口径）。 */
        若 (等于(a, b, "加栈 0") || 等于(a, b, "减栈 0")) {
            出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
            类9 = 类9 + 1;
            次 = 次 + 1; k = k + 1; 续;
        }
        /* ④ 跳转 紧跟 跳转/返回 ==> 后条不可达, 删之（跳转 5B / 返回 1B）
           注: 「跳转」带操作数, 故用 前缀 判定 —— 曾误用 整行相等 ⟹ 该 pass 从未触发 */
        若 (前缀(a, b, "跳转 ") && k + 1 < 行数) {
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            若 (前缀(a2, b2, "跳转 ")) {
                出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                类4 = 类4 + 1;
                次 = 次 + 1; k = k + 2; 续;
            }
            若 (等于(a2, b2, "返回")) {
                出区(行起[k], 行止[k]); 出字(10);
                出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                类4乙 = 类4乙 + 1;
                次 = 次 + 1; k = k + 2; 续;
            }
        }
        /* ⑤ 复制传播 + 死值: 移64 rX,rY / 移64 rZ,rX / 移64 rX,*  ==>  移64 rZ,rY / 移64 rX,* */
        若 ((前缀(a, b, "移64 ") || 前缀(a, b, "移32 ")) && k + 2 < 行数) {
            常 字 *op = 前缀(a, b, "移64 ") ? "移64 " : "移32 ";
            字 *a2; 字 *b2; 去白(行起[k + 1], 行止[k + 1], &a2, &b2);
            字 *a3; 字 *b3; 去白(行起[k + 2], 行止[k + 2], &a3, &b3);
            若 (前缀(a2, b2, op) && 前缀(a3, b3, op)) {
                字 *x1s; 字 *x1e; 字 *y1s; 字 *y1e;
                字 *z2s; 字 *z2e; 字 *x2s; 字 *x2e;
                字 *x3s; 字 *x3e; 字 *s3s; 字 *s3e;
                若 (取寄(a, b, 1, &x1s, &x1e) && 取寄(a, b, 2, &y1s, &y1e) &&
                    取寄(a2, b2, 1, &z2s, &z2e) && 取寄(a2, b2, 2, &x2s, &x2e) &&
                    取寄(a3, b3, 1, &x3s, &x3e) && 取寄(a3, b3, 2, &s3s, &s3e)) {
                    /* 判据:
                       ① 第二行的源 == 第一行的目的（寄等）；
                       ② 第三行的目的也是 rX（寄等 ⟹ 逐字同）；
                       ③ 第三行必须是**纯写** rX：目的是寄存器（不以 '[' 开头 ⟹ 不是内存写）；
                       ④ 第三行**不得读 rX**：源操作数里不得出现 rX 的号（含 rbp/rsp 等**别名**，
                          认不出的寄存器式 token 一律保守拒绝）⟹ 原实现只查「第一个寄存器 == rX」，
                          会把 `移64 rX,[rX+8]` / `移64 rX,rX` 这类**仍在读 rX** 的第三行误判为死值 ⟹ 误编译。 */
                    整 xn = 寄号(x1s, x1e);
                    若 (xn >= 0 && 寄等(x1s, x1e, x2s, x2e) && 寄等(x1s, x1e, x3s, x3e) &&
                        x3s[0] != '[' && 寄号(x3s, x3e) == xn && 含寄(s3s, s3e, xn) == 0) {
                        出串(".删 "); 出区(行起[k], 行止[k]); 出字(10);
                        出串(".删 "); 出区(行起[k + 1], 行止[k + 1]); 出字(10);
                        出串(".替"); 出字(10);
                        出串("    "); 出串(op); 出区(z2s, z2e); 出串(", "); 出区(y1s, y1e); 出字(10);
                        类5 = 类5 + 1;
                        次 = 次 + 1; k = k + 2; 续;
                    }
                }
            }
        }
        /* ⑥ 跳转 .Lx 紧跟标号 .Lx:  ==>  目标即下一行, 删跳转（省 该跳转编码长度; 标号原样保留）
           安全前提: 目标标号唯一（重名标号下 asm_zh 取最后定义 ⟹ 原跳转其实飞向别处 ⟹ 不可删）。 */
        若 (k + 1 < 行数) {
            若 (跳落删(k) > 0) { 类6 = 类6 + 1; 次 = 次 + 1; k = k + 2; 续; }
        }
        /* ⑦ 帧/栈「存→取 同址相邻」⟹ 删取 / 删取+换移（字节数由汇编器**实测**） */
        若 (k + 1 < 行数 && 存取同址(k) != 0) { 类7 = 类7 + 1; 次 = 次 + 1; k = k + 2; 续; }
        /* ⑧ 死值写覆盖（紧跟纯写覆盖 ⟹ 前条死值；只吃第一行，第二行仍要发射；字节由汇编器实测） */
        若 (k + 1 < 行数 && 死写删(k) != 0) { 类8 = 类8 + 1; 次 = 次 + 1; k = k + 1; 续; }
        出区(行起[k], 行止[k]); 出字(10);
        k = k + 1;
    }
    返 次;
}

静 整 main(整 argc, 字 **argv) {
    常 字 *inf = 0; 常 字 *outf = 0;
    整 i; 遍 (i = 1; i < argc; i = i + 1) { 若 (strcmp(argv[i], "-o") == 0 && i + 1 < argc) { outf = argv[i + 1]; i = i + 1; } 否 inf = argv[i]; }
    若 (inf == 0 || outf == 0) { 输出("Usage: opt_zh <in.asm> -o <out.asm>\n"); 返 1; }
    FILE *fi = fopen(inf, "rb"); 若 (fi == 0) { 输出("Cannot open %s\n", inf); 返 1; }
    fseek(fi, 0, 2); 整 n = ftell(fi); fseek(fi, 0, 0);
    字 *t = malloc(n + 1); fread(t, 1, n, fi); t[n] = 0; fclose(fi);
    切行(t, n);
    标建表();   /* 标号计数表（pass ⑥ 的「目标标号唯一」守卫要用） */
    出初始化(n);
    整 次 = 变换();
    FILE *fo = fopen(outf, "wb"); 若 (fo == 0) { 输出("Cannot write %s\n", outf); 返 1; }
    fwrite(出行, 1, 出长, fo); fclose(fo);
    输出("OK: %s 优化 %d 处 [栈spill %d / 栈合并 %d / 抵消对 %d / 不可达 跳转 %d 返回 %d / 复制传播 %d / 跳落到下一行 %d / 帧栈存取同址 %d / 死值写覆盖 %d / 零栈调整 %d]  （字节数不在此报：由汇编器对 .删/.替 实测）  行数 %d -> 字节 %d -> %d\n", outf, 次, 类1, 类2, 类3, 类4, 类4乙, 类5, 类6, 类7, 类8, 类9, 行数, n, 出长);
    返 0;
}
