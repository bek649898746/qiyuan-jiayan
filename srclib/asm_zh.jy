若 (strcmp(mn, "位测置") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0xAB); modrm(3, s & 7, d & 7); } 返 1; } /* bts r32,r32（P0） */
若 (strcmp(mn, "位测置64") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(1, s & 8, 0, d & 8); b(0x0F); b(0xAB); modrm(3, s & 7, d & 7); } 返 1; } /* bts r64,r64（P0） */
若 (strcmp(mn, "位测清") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0xB3); modrm(3, s & 7, d & 7); } 返 1; } /* btr r32,r32（P0） */
若 (strcmp(mn, "位测清64") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(1, s & 8, 0, d & 8); b(0x0F); b(0xB3); modrm(3, s & 7, d & 7); } 返 1; } /* btr r64,r64（P0） */
若 (strcmp(mn, "位测翻") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0xBB); modrm(3, s & 7, d & 7); } 返 1; } /* btc r32,r32（P0） */
若 (strcmp(mn, "位测翻64") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(1, s & 8, 0, d & 8); b(0x0F); b(0xBB); modrm(3, s & 7, d & 7); } 返 1; } /* btc r64,r64（P0） */
若 (strcmp(mn, "扫零位") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0xBC); modrm(3, d & 7, s & 7); } 返 1; } /* bsf r32,r/m32（P0） */
若 (strcmp(mn, "扫零位64") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(1, s & 8, 0, d & 8); b(0x0F); b(0xBC); modrm(3, d & 7, s & 7); } 返 1; } /* bsf r64,r/m64（P0） */
若 (strcmp(mn, "扫置位") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0xBD); modrm(3, d & 7, s & 7); } 返 1; } /* bsr r32,r/m32（P0） */
若 (strcmp(mn, "扫置位64") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(1, s & 8, 0, d & 8); b(0x0F); b(0xBD); modrm(3, d & 7, s & 7); } 返 1; } /* bsr r64,r/m64（P0） */
    返 0;
}

/* ---- 分派函数 2：零扩展/字节/跳转/栈 ---- */
静 整 dispatch2(字 *mn) {
    若 (strcmp(mn, "零扩展") == 0) { SK(); 若 (strncmp(gp, "SIB", 3) == 0) { b(0x43); b(0x0F); b(0xB6); b(0x04); b(0x1A); } 否 { 整 dst = -1; 若 (strncmp(gp, "eax", 3) == 0) { dst = 0; gp = gp + 3; } 否 若 (strncmp(gp, "ecx", 3) == 0) { dst = 1; gp = gp + 3; } 否 若 (strncmp(gp, "edx", 3) == 0) { dst = 2; gp = gp + 3; } 若 (dst >= 0) { SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') { gp = gp + 1; 整 br = RG(); SK(); 若 (br >= 8) b(0x41); b(0x0F); b(0xB6); modrm(0, dst, br & 7); } 否 { 整 dd = dst; 若 (dd < 0 && gp[0] == 'r' && gp[1] >= '0' && gp[1] <= '9') { gp = gp + 1; dd = 0; 循环 (gp[0] >= '0' && gp[0] <= '9') { dd = dd * 10 + (gp[0] - '0'); gp = gp + 1; } } SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 sd = -1; 若 (gp[0] == 'r' && gp[1] >= '0' && gp[1] <= '9') { gp = gp + 1; sd = 0; 循环 (gp[0] >= '0' && gp[0] <= '9') { sd = sd * 10 + (gp[0] - '0'); gp = gp + 1; } 若 (gp[0] == 'b') gp = gp + 1; } 若 (dd >= 0 && sd >= 0) { 若 (dd >= 8 || sd >= 8) b(0x41); b(0x89); modrm(3, sd & 7, dd & 7); } 否 若 (dst == 0) movzx_eax_al(); 否 若 (dst == 1) { b(0x0F); b(0xB6); modrm(3, 1, 1); } 否 { b(0x0F); b(0xB6); modrm(3, 2, 2); } } } 否 若 (gp[0] == 'r' && gp[1] >= '0' && gp[1] <= '9') { 整 da = 0; gp = gp + 1; 循环 (gp[0] >= '0' && gp[0] <= '9') { da = da * 10 + (gp[0] - '0'); gp = gp + 1; } SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 sa = -1; 若 (gp[0] == 'r' && gp[1] >= '0' && gp[1] <= '9') { gp = gp + 1; sa = 0; 循环 (gp[0] >= '0' && gp[0] <= '9') { sa = sa * 10 + (gp[0] - '0'); gp = gp + 1; } 若 (gp[0] == 'b') gp = gp + 1; } 若 (da >= 8 || sa >= 8) b(0x41); b(0x89); modrm(3, sa & 7, da & 7); } 否 movzx_eax_al(); } 返 1; } /* R599c: 补 `零扩展 r3, r3b` ⟹ 89 DB (mov ebx,ebx) */
若 (strcmp(mn, "取符号字节") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0xBE); modrm(3, d & 7, s & 7); } 返 1; } /* movsx r32,r/m8（P0） */
若 (strcmp(mn, "取符号字") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0xBF); modrm(3, d & 7, s & 7); } 返 1; } /* movsx r32,r/m16（P0） */
    若 (strcmp(mn, "存字节帧") == 0) { b(0x41); b(0x88); modrm(1, 1, 5); b(0); 返 1; }
    若 (strcmp(mn, "存字节0") == 0) { b(0x41); b(0xC6); modrm(1, 0, 5); b(0); b(0); 返 1; }
    若 (strcmp(mn, "自增") == 0) { 整 r = RG(); 若 (r >= 8) b(0x41); 若 (r >= 0) { b(0xFF); modrm(3, 0, r & 7); } 返 1; }
    若 (strcmp(mn, "存32rax") == 0) { SK(); 若 (gp[0] == 'r' && gp[1] >= '0' && gp[1] <= '9') { 整 r = RG(); 若 (r >= 0) { rex(0, r & 8, 0, 0); b(0x89); modrm(0, r & 7, 0); } } 否 { b(0x40); b(0x89); b(0x18); } 返 1; } /* MOV [rax],r32 — 位域 RMW 存32rax r10 → 44 89 10 (fix 2026-08-12) */
    若 (strcmp(mn, "存64") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 disp = 0; 整 has_disp = 0; 若 (gp[0] == '-' || gp[0] == '+' || (gp[0] >= '0' && gp[0] <= '9')) { has_disp = 1; disp = NUM(); } SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 v = RG(); 若 (has_disp == 1) { b(0x48); b(0x89); modrm(2, v & 7, m & 7); b4(disp); } 否 若 (m == 0 && v == 3) { b(0x48); b(0x89); modrm(0, 3, 0); } 否 若 (m == 3 && v == 1) { b(0x48); b(0x89); modrm(0, 1, 3); } 否 若 (m == 3) { b(0x48); b(0x89); modrm(0, 0, 3); } 否 若 (m >= 0 && v >= 0) { rex(1, v & 8, 0, m & 8); b(0x89); modrm(0, v & 7, m & 7); } 返 1; } /* mov [rm+disp32],rv (emit_scanf 存64 [rbp+aoff],r0 — fix 2026-08-12) / mov [rax],rbx / mov [rbx],rcx / mov [rbx],rax / R599c: 通用 [rN], rM */
    若 (strcmp(mn, "存字节rax") == 0) { b(0x40); b(0x88); b(0x18); 返 1; }
    若 (strcmp(mn, "存字rax") == 0) { b(0x40); b(0x66); b(0x89); b(0x18); 返 1; } /* MOV [rax],bx (short field write fix 2026-08-06) */
    若 (strcmp(mn, "存栈索引") == 0) { b(0x4F); b(0x89); b(0x04); b(0xF4); 返 1; }
    若 (strcmp(mn, "跳转") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 1, li, 2); jmp_rel(0); } 返 1; }
若 (strcmp(mn, "跳转短") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 1, li, 3); b(0xEB); b(0); } 返 1; } /* jmp rel8（P0） */
若 (strcmp(mn, "环跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 1, li, 3); b(0xE2); b(0); } 返 1; } /* loop rel8（P0） */
若 (strcmp(mn, "环等跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 1, li, 3); b(0xE1); b(0); } 返 1; } /* loope rel8（P0） */
若 (strcmp(mn, "环不等跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 1, li, 3); b(0xE0); b(0); } 返 1; } /* loopne rel8（P0） */
若 (strcmp(mn, "间跳") == 0) { SK(); 整 r = RG(); 若 (r >= 0) { rex(1, 0, 0, r & 8); b(0xFF); modrm(3, 4, r & 7); } 返 1; } /* jmp r64（P0） */
若 (strcmp(mn, "无操作") == 0) { b(0x90); 返 1; } /* nop（P0） */
若 (strcmp(mn, "无操作3") == 0) { b(0x0F); b(0x1F); b(0x00); 返 1; } /* 3-byte nop（P1） */
若 (strcmp(mn, "无操作4") == 0) { b(0x0F); b(0x1F); b(0x40); b(0x00); 返 1; } /* 4-byte nop（P1） */
若 (strcmp(mn, "无操作9") == 0) { b(0x0F); b(0x1F); b(0x84); b(0x00); b(0x00); b(0x00); b(0x00); b(0x00); b(0x00); 返 1; } /* 9-byte nop（P1） */
    若 (strcmp(mn, "为零跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); jz_rel(0); } 返 1; }
    若 (strcmp(mn, "非零跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); jnz_rel(0); } 返 1; }
    若 (strcmp(mn, "调用") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 1, li, 0); call_rel(0); } 返 1; }
    若 (strcmp(mn, "减栈") == 0) { 整 v = NUM(); sub_rsp_imm(v); 返 1; }
    若 (strcmp(mn, "加栈") == 0) { 整 v = NUM(); add_rsp_imm(v); 返 1; }
    若 (strcmp(mn, "对齐栈") == 0) { b(0x48); b(0x83); b(0xE4); b(0xF0); 返 1; }
    若 (strcmp(mn, "调系统") == 0) { 整 s = NUM(); call_iat(s); 返 1; }
若 (strcmp(mn, "清进位") == 0) { b(0xF8); 返 1; } /* clc（P1） */
若 (strcmp(mn, "置进位") == 0) { b(0xF9); 返 1; } /* stc（P1） */
若 (strcmp(mn, "翻进位") == 0) { b(0xF5); 返 1; } /* cmc（P1） */
若 (strcmp(mn, "清方向") == 0) { b(0xFC); 返 1; } /* cld（P1） */
若 (strcmp(mn, "置方向") == 0) { b(0xFD); 返 1; } /* std（P1） */
若 (strcmp(mn, "取标志") == 0) { b(0x9F); 返 1; } /* lahf（P1） */
若 (strcmp(mn, "存标志") == 0) { b(0x9E); 返 1; } /* sahf（P1） */
若 (strcmp(mn, "压标志") == 0) { rex(1, 0, 0, 0); b(0x9C); 返 1; } /* pushfq（P1） */
若 (strcmp(mn, "弹标志") == 0) { rex(1, 0, 0, 0); b(0x9D); 返 1; } /* popfq（P1） */
若 (strcmp(mn, "中断") == 0) { SK(); 整 v = NUM(); b(0xCD); b(v & 0xff); 返 1; } /* int imm8（P1） */
若 (strcmp(mn, "中断返") == 0) { rex(1, 0, 0, 0); b(0xCF); 返 1; } /* iretq（P1） */
若 (strcmp(mn, "系统调用") == 0) { b(0x0F); b(0x05); 返 1; } /* syscall（P1） */
若 (strcmp(mn, "取Cpu") == 0) { b(0x0F); b(0xA2); 返 1; } /* cpuid（P1） */
若 (strcmp(mn, "取时钟") == 0) { b(0x0F); b(0x31); 返 1; } /* rdtsc（P1） */
    若 (strcmp(mn, "取参") == 0) { mov_eax_mr13(); 返 1; }
    /* R808 (2026-10-23 虾米 · -S 保真度普查): 原 `取参64` 处理器 **忽略操作数**, 一律发 `mov rax,[r13]`;
       而 qcc 的 -S 文本是 `取参64 rN, [r15+d]`（函数序言按 r15 帧基 + 位移读参数）
       ⟹ 文本看着对、汇编出来却是 `mov rax,[r13]`（位移/基址全丢）⟹ -S 链产物参数读错、启动即崩。
       实测对照 (指令级): 真编译器 `mov 0x8(%r15),%rax` vs -S 链 `mov 0x0(%r13),%rax`。 */
    若 (strcmp(mn, "取参64") == 0) {
        SK(); 整 目 = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK();
        若 (gp[0] == '[') {
            gp = gp + 1; 整 基 = RG(); SK(); 整 偏 = 0;
            若 (gp[0] == '+') gp = gp + 1; /* ⚠️ NUM() 只认 '-' 与 '0x'，不认 '+' ⟹ `[r15+8]` 的 位移 被吞成 0（实测: 四个实参 全读 [r15+0]） */
            若 (gp[0] == '-' || (gp[0] >= '0' && gp[0] <= '9')) 偏 = NUM();
            SK(); 若 (gp[0] == ']') gp = gp + 1;
            若 (目 >= 0 && 基 >= 0) {
                rex(1, 目 & 8, 0, 基 & 8); b(0x8B);
                若 ((基 & 7) == 4) { /* rsp/r12 基址 需 SIB（下标 无） */
                    若 (偏 >= -128 && 偏 <= 127) { modrm(1, 目 & 7, 4); b(0x24); b(偏 & 0xff); }
                    否 { modrm(2, 目 & 7, 4); b(0x24); b4(偏); }
                } 否 若 (偏 >= -128 && 偏 <= 127) { modrm(1, 目 & 7, 基 & 7); b(偏 & 0xff); } /* rbp/r13 + disp==0 走 mod=01 disp8=0（qcc 编码同款，4 字节；mod=00 才是 rip-相对） */
                否 { modrm(2, 目 & 7, 基 & 7); b4(偏); }
            }
        } 否 mov_rax_mr13();
        返 1;
    }
    若 (strcmp(mn, "写字节") == 0) { SK(); 若 (gp[0] == '[') { gp = gp + 1; 整 br = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 vr = RG(); 若 (vr < 0) vr = NUM() & 0xFF; 若 (br == 7) { b(0xC6); modrm(0, 0, 7); b(vr & 0xFF); } 否 若 (br == 8 && vr == 0) { b(0x41); b(0x88); modrm(0, 0, 0); } 否 若 (br == 9 && vr == 0) { b(0x41); b(0x88); modrm(0, 0, 1); } 否 若 (br == 8 && vr == 9) { b(0x45); b(0x88); modrm(0, 1, 0); } 否 若 (br == 9 && vr == 2) { b(0x41); b(0x88); modrm(0, 2, 1); } 否 mov_r12_cl(); } 否 mov_r12_cl(); 返 1; }
    若 (strcmp(mn, "读字节") == 0) { SK(); 整 vr = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') gp = gp + 1; 整 br = RG(); 若 (vr == 0 && br == 8) { b(0x41); b(0x8A); modrm(0, 0, 0); } 否 若 (vr == 2 && br == 9) { b(0x41); b(0x8A); modrm(0, 2, 1); } 否 若 (vr == 0 && br == 9) { b(0x41); b(0x8A); modrm(0, 0, 1); } 返 1; }
    若 (strcmp(mn, "比较字节") == 0) { b(0x38); modrm(3, 2, 0); 返 1; }
    若 (strcmp(mn, "自减") == 0) { 整 r = RG(); 若 (r >= 8) b(0x41); 若 (r >= 0) { b(0xFF); modrm(3, 1, r & 7); } 返 1; }
    若 (strcmp(mn, "写字符") == 0) { mov_r12_al(); 返 1; }
    若 (strcmp(mn, "非负跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x89); b4(0); } 返 1; }
若 (strcmp(mn, "非溢出跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x81); b4(0); } 返 1; } /* jno rel32 — R599c: 原 缺 此 名 ⟹ 整条 响亮 中断 */
若 (strcmp(mn, "负跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x88); b4(0); } 返 1; } /* js rel32（P0） */
若 (strcmp(mn, "大跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x8F); b4(0); } 返 1; } /* jg rel32（P0） */
若 (strcmp(mn, "小跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x8C); b4(0); } 返 1; } /* jl rel32（P0） */
若 (strcmp(mn, "溢跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x80); b4(0); } 返 1; } /* jo rel32（P0） */
若 (strcmp(mn, "不溢跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x81); b4(0); } 返 1; } /* jno rel32（P0） */
若 (strcmp(mn, "奇跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x8A); b4(0); } 返 1; } /* jp rel32（P0） */
若 (strcmp(mn, "偶跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x8B); b4(0); } 返 1; } /* jnp rel32（P0） */
    若 (strcmp(mn, "大于等跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x8D); b4(0); } 返 1; }
    若 (strcmp(mn, "小于等跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x8E); b4(0); } 返 1; }
    若 (strcmp(mn, "高于等跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x83); b4(0); } 返 1; }
    若 (strcmp(mn, "低于跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x82); b4(0); } 返 1; }
    若 (strcmp(mn, "高于跳") == 0) { 整 li = LR(); 若 (li >= 0) { patch_label(cp + 2, li, 1); b(0x0F); b(0x87); b4(0); } 返 1; }
    若 (strcmp(mn, "调") == 0) { SK(); 若 (strncmp(gp, "r10", 3) == 0) { gp = gp + 3; b(0x49); b(0xFF); b(0xD2); } 返 1; }
    若 (strcmp(mn, "零扩展空") == 0) { SK(); 若 (strncmp(gp, "eax", 3) == 0) { b(0x40); b(0x0F); b(0xB6); b(0xC0); } 否 { b(0x40); b(0x0F); b(0xB6); b(0xD2); } 返 1; }
    返 0;
}

/* ---- 分派函数 3：寻址/内存 ---- */
静 整 dispatch3(字 *mn) {
    若 (strcmp(mn, "取址") == 0) { SK(); 整 r = RG(); 若 (r >= 0) { 若 (gp[0] == ',' || gp[0] == '[') gp = gp + 1; MEM(); 整 v = mem_result; lea_r_mrsp(r, v); } 返 1; }
    若 (strcmp(mn, "取帧址") == 0) { SK(); 整 r = RG(); 若 (r >= 0) { 若 (gp[0] == ',' || gp[0] == '[') gp = gp + 1; MEM(); 整 v = mem_result; lea_r_mbrp(r, v); } 返 1; }
    若 (strcmp(mn, "取静址") == 0) { SK(); 若 (gp[0] == 'r') gp = gp + 3; SK(); 若 (gp[0] == ',') gp = gp + 1; RIPS(); 整 v = mem_result; lea_rax_rip(v); 返 1; }
    若 (strcmp(mn, "取静32") == 0) { SK(); 若 (strncmp(gp, "eax", 3) == 0) gp = gp + 3; SK(); 若 (gp[0] == ',') gp = gp + 1; RIPS(); 整 v = mem_result; mov_eax_rip(v); 返 1; }
    若 (strcmp(mn, "取静64") == 0) { SK(); 若 (strncmp(gp, "rax", 3) == 0) gp = gp + 3; SK(); 若 (gp[0] == ',') gp = gp + 1; RIPS(); 整 v = mem_result; mov_rax_rip64(v); 返 1; }
    若 (strcmp(mn, "存静64") == 0) { RIPS(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; mov_rip_rax64(v); 返 1; }
    若 (strcmp(mn, "存静32") == 0) { RIPS(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; mov_rip_eax(v); 返 1; }
若 (strcmp(mn, "存静字节") == 0) { RIPS(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; 整 im = NUM(); b(0xC6); b(0x05); b4r(v, 1); b(im & 0xFF); 返 1; } /* mov byte [rip+disp], imm8（fix 2026-08-05） */
    若 (strcmp(mn, "取值") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); 若 (r >= 0 && m >= 0) mov_reg_mreg(r, m); 返 1; }
    若 (strcmp(mn, "取32") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 dv = 0; 整 hd = 0; 若 (gp[0] == '+') gp = gp + 1; 若 (gp[0] == '-' || (gp[0] >= '0' && gp[0] <= '9')) { hd = 1; dv = NUM(); } SK(); 若 (gp[0] == ']') gp = gp + 1; 若 (r >= 0 && m >= 0) { 若 (hd) { 若 (r >= 8 || m >= 8) b(0x40 | ((r >= 8) ? 4 : 0) | ((m >= 8) ? 1 : 0)); b(0x8B); 若 (dv < 128 && dv >= -128) { modrm(1, r & 7, m & 7); b(dv); } 否 { modrm(2, r & 7, m & 7); b4(dv); } } 否 mov_reg_mreg(r, m); } 返 1; }
    若 (strcmp(mn, "取64") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') { gp = gp + 1; 若 (strncmp(gp, "r13", 3) == 0) { gp = gp + 3; SK(); 若 (gp[0] == '+') gp = gp + 1; 整 dv = NUM(); 若 (r >= 0) { b(0x49); b(0x8B); b(0x40 | ((r & 7) << 3) | 5); b(dv); } SK(); 若 (gp[0] == ']') gp = gp + 1; } 否 若 (strncmp(gp, "r10", 3) == 0) { gp = gp + 3; SK(); 若 (gp[0] == '+') gp = gp + 1; 整 dv = NUM(); 若 (r >= 0) { b(0x49); b(0x8B); b(0x40 | ((r & 7) << 3) | 2); b(dv); } SK(); 若 (gp[0] == ']') gp = gp + 1; } 否 { 整 m = RG(); 若 (r >= 0 && m >= 0) mov_reg_mreg64(r, m); } } 否 { 整 m = RG(); 若 (r >= 0 && m >= 0) mov_reg_mreg64(r, m); } 返 1; } /* fix 2026-08-12: 取64[r13]/[r10] 原硬编码 rax, 忽略 r */
    若 (strcmp(mn, "存值") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 r = RG(); 若 (r >= 0 && m >= 0) mov_mreg_reg(m, r); 返 1; }
    若 (strcmp(mn, "存帧64") == 0) { MEM(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; 整 r = RG(); mov_mbrp_reg64(v, r); 返 1; }
    若 (strcmp(mn, "取帧64") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; MEM(); 整 v = mem_result; 若 (r >= 0) mov_reg_mbrp64(r, v); 返 1; }
    若 (strcmp(mn, "存帧32") == 0) { MEM(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; 整 r = RG(); mov_mbrp_reg(v, r); 返 1; }
    若 (strcmp(mn, "取帧32") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; MEM(); 整 v = mem_result; 若 (r >= 0) mov_reg_mbrp(r, v); 返 1; }
    若 (strcmp(mn, "存栈64") == 0) { MEM(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; 整 r = RG(); mov_mrsp_reg64(v, r); 返 1; }
    若 (strcmp(mn, "取栈64") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; MEM(); 整 v = mem_result; 若 (r >= 0) mov_reg_mrsp64(r, v); 返 1; }
    若 (strcmp(mn, "存栈32") == 0) { MEM(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; 整 r = RG(); 若 (r >= 0) { rex(0, r & 8, 0, 0); b(0x89); 若 (v < 128 && v >= -128) { modrm(1, r & 7, 4); b(0x24); b(v); } 否 { modrm(2, r & 7, 4); b(0x24); b4(v); } } 返 1; }
    若 (strcmp(mn, "取栈32") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; MEM(); 整 v = mem_result; 若 (r >= 0) { rex(0, r & 8, 0, 0); b(0x8B); 若 (v < 128 && v >= -128) { modrm(1, r & 7, 4); b(0x24); b(v); } 否 { modrm(2, r & 7, 4); b(0x24); b4(v); } } 返 1; }
    若 (strcmp(mn, "取栈址") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; MEM(); 整 v = mem_result; 若 (r >= 0) lea_r_mrsp(r, v); 返 1; }
        若 (strcmp(mn, "存字节") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 disp = 0; 整 has_disp = 0; 若 (gp[0] == '-' || gp[0] == '+' || (gp[0] >= '0' && gp[0] <= '9')) { has_disp = 1; disp = NUM(); } SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == 'r' || (gp[0] == 'e' && (gp[1] == 'a' || gp[1] == 'c' || gp[1] == 'd' || gp[1] == 'b'))) { 整 s = RG(); 若 (m == 3 && s == 0) { b(0x40); b(0x88); modrm(0, 0, 3); } 否 若 (m >= 0 && s >= 0) { 若 (m >= 8 || s >= 8) b(0x41); b(0x88); modrm(0, s & 7, m & 7); } } 否 { 整 s8 = RG8(); 若 (s8 >= 0 && has_disp == 1) { 若 (m >= 8 || s8 >= 8) b(0x41); b(0x88); 若 (disp < 128 && disp >= -128) { modrm(1, s8 & 7, m & 7); b(disp); } 否 { modrm(2, s8 & 7, m & 7); b4(disp); } } 否 { 整 imm = NUM(); 若 (has_disp == 1) { b(0xC6); 若 (disp < 128 && disp >= -128) { modrm(1, 0, m & 7); b(disp); } 否 { modrm(2, 0, m & 7); b4(disp); } b(imm & 0xFF); } } } 返 1; } /* mov byte [rbp+disp],imm8 / mov [rbx],al (fix 2026-08-12 H2 对等) */
    若 (strcmp(mn, "存字") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == '-' || gp[0] == '+' || (gp[0] >= '0' && gp[0] <= '9')) { 整 sg = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sg = -1; gp = gp + 1; } 整 v = NUM() * sg; SK(); 若 (gp[0] == ']') gp = gp + 1; b(0x66); b(0x89); 若 (v < 128 && v >= -128) { modrm(1, 0, 5); b(v); } 否 { modrm(2, 0, 5); b4(v); } 返 1; } 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (m >= 0 && s >= 0) { 若 (m >= 8 || s >= 8) { rex(0, s & 8, 0, m & 8); } b(0x66); b(0x89); modrm(0, s & 7, m & 7); } 返 1; } /* mov word [rm],rs (fix 2026-08-12 H2 对等) + R599c: 补 `存字 [rbp+位移], ax` 帧形态 (原 被 静默 丢弃, 见串戊) */
    若 (strcmp(mn, "存字节0r12") == 0) { b(0x41); b(0xC6); b(0x04); b(0x24); b(0); 返 1; } /* mov byte[r12],0 (sprintf NUL) */
    若 (strcmp(mn, "存指16") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 sg = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sg = -1; gp = gp + 1; } 整 ov = NUM() * sg; SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 rr = RG(); 若 (m == 1 && rr == 0) { b(0x66); b(0x89); modrm(1, 0, 1); b(ov); } 返 1; } /* mov [rcx+disp8],ax */
    若 (strcmp(mn, "存指8") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 sg = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sg = -1; gp = gp + 1; } 整 ov = NUM() * sg; SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 rr = RG(); 若 (m == 1 && rr == 0) { b(0x88); modrm(1, 0, 1); b(ov); } 返 1; } /* mov [rcx+disp8],al */
    若 (strcmp(mn, "存指32") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 sg = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sg = -1; gp = gp + 1; } 整 ov = NUM() * sg; SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 rr = RG(); 若 (m == 1 && rr == 0) { b(0x89); modrm(1, 0, 1); b(ov); } 返 1; } /* mov [rcx+disp8],eax */
    若 (strcmp(mn, "存指64") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 sg = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sg = -1; gp = gp + 1; } 整 ov = NUM() * sg; SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 rr = RG(); 若 (m == 1 && rr == 0) { b(0x48); b(0x89); modrm(1, 0, 1); b(ov); } 否 若 (m == 4 && rr == 0) { b(0x48); b(0x89); modrm(0, 0, 4); b(0x24); } 返 1; } /* mov [rcx+disp8],rax (sret copy) */
    若 (strcmp(mn, "存浮") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (m >= 0) { b(0xF2); b(0x0F); b(0x11); modrm(0, 0, m & 7); } 返 1; } /* movsd [rm],xmm0 (fix 2026-08-12: 原只认 [rbx]) */
    若 (strcmp(mn, "浮取") == 0) { SK(); 整 rg = 0; 若 (strncmp(gp, "xmm1", 4) == 0) { rg = 1; gp = gp + 4; } 否 若 (strncmp(gp, "xmm0", 4) == 0) { gp = gp + 4; } SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; 若 (m >= 0) { b(0xF2); b(0x0F); b(0x10); modrm(0, rg, m & 7); } 返 1; } /* movsd xmmN, [rm] (fix 2026-08-12: double* 解引用) */
    若 (strcmp(mn, "零扩展字") == 0) { SK(); 若 (!strncmp(gp, "r0", 2)) { gp = gp + 2; SK(); 若 (gp[0] == ',') gp = gp + 1; 整 v = MEM(); b(0x0F); b(0xB7); b(0x85); b4(v); } 否 { 整 dst = -1; 若 (!strncmp(gp, "eax", 3)) { dst = 0; gp = gp + 3; } 否 若 (!strncmp(gp, "ecx", 3)) { dst = 1; gp = gp + 3; } 否 若 (!strncmp(gp, "edx", 3)) { dst = 2; gp = gp + 3; } SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') { gp = gp + 1; 整 br = RG(); SK(); 若 (br >= 8) b(0x41); b(0x0F); b(0xB7); modrm(0, dst, br & 7); } 否 { 整 s16 = RG16(); 若 (s16 >= 0 && dst >= 0) { b(0x0F); b(0xB7); modrm(3, dst, s16 & 7); } 否 { 整 v = MEM(); b(0x0F); b(0xB7); b(0x85); b4(v); } } } 返 1; } /* movzx eax,word[rbp+disp32]/eax,word[reg]/eax,ax (short field fix 2026-08-06; R599c 补 16 位 寄存器 形态) */
    若 (strcmp(mn, "符号扩展字") == 0) { SK(); 若 (!strncmp(gp, "r0", 2)) { gp = gp + 2; SK(); 若 (gp[0] == ',') gp = gp + 1; 整 v = MEM(); b(0x0F); b(0xBF); b(0x85); b4(v); } 否 { 整 d = RG(); SK(); 若 (gp[0] != ',') { 若 (d >= 0) { b(0x0F); b(0xBF); modrm(3, d & 7, d & 7); } 返 1; } gp = gp + 1; SK(); 若 (gp[0] == '[') { gp = gp + 1; 整 br = RG(); 若 (br >= 8) b(0x41); b(0x0F); b(0xBF); modrm(0, d & 7, br & 7); } 否 { 整 s = RG16(); 若 (s < 0) s = RG(); 若 (gp[0] == 'w') gp = gp + 1; 若 (d >= 0 && s >= 0) { b(0x0F); b(0xBF); modrm(3, d & 7, s & 7); } } } 返 1; } /* movsx r32,r/m16 — R599c: 原 缺 此 名 ⟹ qcc 的 `符号扩展字(位移)` 文本 令 汇编 响亮 中断 */
    若 (strcmp(mn, "零扩展字节") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') { 整 v = MEM(); b(0x0F); b(0xB6); b(0x85); b4(v); 返 1; } 整 s = RG8(); 若 (s < 0) s = RG(); 若 (gp[0] == 'b') gp = gp + 1; 若 (d >= 0 && s >= 0) { b(0x0F); b(0xB6); modrm(3, d & 7, s & 7); } 返 1; } /* movzx r32,r/m8: 帧 形态 ([rbp+disp32]) + 寄存器 形态 (R599c) */
    若 (strcmp(mn, "零扩展字节8") == 0) { SK(); RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') { 整 v = MEM(); b(0x0F); b(0xB6); b(0x45); b(v & 0xff); } 返 1; } /* movzx r32,[rbp+disp8]; R599c-T10b 补 (qcc disp8 形态) */

若 (strcmp(mn, "存32") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 dv = 0; 整 hd = 0; 若 (gp[0] == '+') gp = gp + 1; 若 (gp[0] == '-' || (gp[0] >= '0' && gp[0] <= '9')) { hd = 1; dv = NUM(); } SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 r = RG(); 若 (r >= 0 && m >= 0) { 若 (hd) { 若 (r >= 8 || m >= 8) b(0x40 | ((r >= 8) ? 4 : 0) | ((m >= 8) ? 1 : 0)); b(0x89); 若 (dv < 128 && dv >= -128) { modrm(1, r & 7, m & 7); b(dv); } 否 { modrm(2, r & 7, m & 7); b4(dv); } } 否 { rex(0, r & 8, 0, m & 8); b(0x89); 若 (m == 4 || m == 12) { modrm(0, r & 7, m & 7); b(0x24); } 否 modrm(0, r & 7, m & 7); } } 返 1; }
    若 (strcmp(mn, "存零") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 r = RG(); 若 (r >= 0 && m >= 0) { b(0x89); modrm(0, r & 7, m & 7); } 返 1; }
    /* ==== R599c (2026-10-16 虾米 · 中文汇编端到端): 中刷 侧 op 的 文本 落点 ====
       背景: 编译器 `中刷()` 有 34 个 `例` 分支 **只 发字节 不 汇发**（中码通道 无 文本），
       本 段 补 的 就是 那些 op 需要 的 助记符。 每个 助记符 的 字节 **逐字节 照抄**
       `srclib_jiayan/qcc_zh.jy` 中刷 对应 例 的 发射（见 `_zhongshua_gap.txt`）。 */
    若 (strcmp(mn, "存8") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 r = RG(); 若 (r >= 0 && m >= 0) { rex(0, r & 8, 0, m & 8); b(0x88); modrm(0, r & 7, m & 7); } 返 1; } /* 整集/素癸: 移动 [堆九/堆再], bl/al */
    若 (strcmp(mn, "存16") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 r = RG(); 若 (r >= 0 && m >= 0) { b(0x66); b(0x89); modrm(0, r & 7, m & 7); } 返 1; } /* 计贰一: 移动 字 [堆再], ax (无 扩展前缀) */
    若 (strcmp(mn, "存8帧") == 0) { MEM(); 整 v = mem_result; b(0x88); 若 (v < 128 && v >= -128) { modrm(1, 0, 5); b(v); } 否 { modrm(2, 0, 5); b4(v); } 返 1; } /* 终九: 移动 字节 [rbp+位移], 累加低 */
    若 (strcmp(mn, "存16帧") == 0) { MEM(); 整 v = mem_result; b(0x66); b(0x89); 若 (v < 128 && v >= -128) { modrm(1, 0, 5); b(v); } 否 { modrm(2, 0, 5); b4(v); } 返 1; } /* 外玖: 移动 字 [rbp+位移], ax */
    若 (strcmp(mn, "存单浮") == 0) { SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; 若 (m >= 0) { b(0xF2); b(0x0F); b(0x5A); b(0xC0); b(0xF3); b(0x0F); b(0x11); modrm(0, 0, m & 7); } 返 1; } /* 栈丁单/前八一单: cvtsd2ss+movss [rm],xmm0 */
    若 (strcmp(mn, "单存帧") == 0) { 整 v = 0; SK(); 若 (gp[0] == '[') { gp = gp + 1; SK(); RG(); SK(); 整 sg = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sg = -1; gp = gp + 1; } v = NUM() * sg; SK(); 若 (gp[0] == ']') gp = gp + 1; } b(0xF2); b(0x0F); b(0x5A); b(0xC0); b(0xF3); b(0x0F); b(0x11); 若 (v < 128 && v >= -128) { modrm(1, 0, 5); b(v); } 否 { modrm(2, 0, 5); b4(v); } 返 1; } /* 内酉单: cvtsd2ss+movss [rbp+位移],xmm0 */
    /* ==== R599c 第二批: qcc 文本 里 出现 的 另外 一批 助记符 ==== */
    若 (strcmp(mn, "取指64") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; 若 (r >= 0 && m == 4) { rex(1, 0, 0, r & 8); b(0x8B); modrm(0, r & 7, 4); b(0x24); } 返 1; }
    若 (strcmp(mn, "取") == 0) { SK(); 循环 (gp[0] && gp[0] != ' ') gp = gp + 1; SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') gp = gp + 1; 整 m = RG(); SK(); 整 dv = 0; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { gp = gp + 1; dv = -NUM(); } 若 (gp[0] >= '0' && gp[0] <= '9') dv = NUM(); SK(); 若 (gp[0] == ']') gp = gp + 1; 若 (r >= 0 && m >= 0) { rex(1, 0, 0, m & 8); b(0x8B); 若 (dv < 128 && dv >= -128) { modrm(1, r & 7, m & 7); b(dv); } 否 { modrm(2, r & 7, m & 7); b4(dv); } } 返 1; } /* qcc 文本 `取 64 r0, [r15+16]` (助记符里 带 空格) */
    若 (strcmp(mn, "增即") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 v = NUM(); 若 (r >= 0) { 若 (r >= 8) b(0x41); b(0x83); modrm(3, 0, r & 7); b(v & 0xff); } 返 1; }
    若 (strcmp(mn, "增") == 0) { SK(); 整 r = RG(); 若 (r >= 8) b(0x41); 若 (r >= 0) { b(0xFF); modrm(3, 0, r & 7); } 返 1; }
    若 (strcmp(mn, "陷阱") == 0) { b(0x0F); b(0x0B); 返 1; }
    若 (strcmp(mn, "读端口") == 0) { b(0xEC); 返 1; }
    若 (strcmp(mn, "写端口") == 0) { b(0xEE); 返 1; }
    若 (strcmp(mn, "读端口32") == 0) { b(0xED); 返 1; }
    若 (strcmp(mn, "写端口32") == 0) { b(0xEF); 返 1; }
    若 (strcmp(mn, "块复制") == 0) { b(0xF3); b(0xA4); 返 1; }
    若 (strcmp(mn, "除") == 0) { SK(); 整 r = RG(); 若 (r >= 0) { b(0x99); b(0xF7); modrm(3, 7, r & 7); } 返 1; }
    若 (strcmp(mn, "整转浮64") == 0) { SK(); 整 x = 0; 若 (strncmp(gp, "xmm1", 4) == 0) { x = 1; gp = gp + 4; } 否 若 (strncmp(gp, "xmm0", 4) == 0) gp = gp + 4; b(0xF2); b(0x48); b(0x0F); b(0x2A); modrm(3, x, 0); 返 1; } /* cvtsi2sd xmmN, rax — R599c: 原 恒 C0 */
    若 (strcmp(mn, "符号扩展64字节") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (gp[0] == '[') { gp = gp + 1; 整 m = RG(); SK(); 若 (gp[0] == ']') gp = gp + 1; 若 (d >= 0 && m >= 0) { b(0x48); b(0x0F); b(0xBE); modrm(0, d & 7, m & 7); } } 返 1; }
    若 (strcmp(mn, "存静8") == 0) { RIPS(); 整 v = mem_result; b(0x88); b(0x05); b4r(v, 0); 返 1; } /* 深未: 移动 字节 [rip+位移], 累加低 */
    若 (strcmp(mn, "存静16") == 0) { RIPS(); 整 v = mem_result; b(0x66); b(0x89); b(0x05); b4r(v, 0); 返 1; } /* 终六: 移动 字 [rip+位移], ax */
    若 (strcmp(mn, "取静零8") == 0) { RIPS(); 整 v = mem_result; b(0x0F); b(0xB6); b(0x05); b4r(v, 0); 返 1; } /* 栈复: 零扩展 首子, 字节 [rip+位移] */
    若 (strcmp(mn, "取静符8") == 0) { RIPS(); 整 v = mem_result; b(0x0F); b(0xBE); b(0x05); b4r(v, 0); 返 1; } /* 间三: 符号扩展 首子, 字节 [rip+位移] */
    若 (strcmp(mn, "取静零16") == 0) { RIPS(); 整 v = mem_result; b(0x66); b(0x0F); b(0xB7); b(0x05); b4r(v, 0); 返 1; } /* 原双: 零扩展 首子, 字 [rip+位移] */
    若 (strcmp(mn, "取静符16") == 0) { RIPS(); 整 v = mem_result; b(0x66); b(0x0F); b(0xBF); b(0x05); b4r(v, 0); 返 1; } /* 当肆: 符号扩展 首子, 字 [rip+位移] */
    若 (strcmp(mn, "乘32双") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0xAF); modrm(3, d & 7, s & 7); } 返 1; } /* 上柒: 乘 r11d, r9d (两 操作数 imul) */
    若 (strcmp(mn, "移即") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 v = NUM(); 若 (r >= 8) b(0x41); 若 (r >= 0) { b(0xB8 | (r & 7)); b4(v); } 返 1; } /* 内壹一: 移动 r9d, 立即数 (41 B9 imm32) */
    输出("[ERR] asm_zh: unknown instruction '%s' at line %d\n", mn, line_no); exit(1); /* fix 2026-08-05：未知助记符原静默丢弃 → 产物坏 exe */ 返 0;
}

/* ---- 分派函数 4：SSE 浮点/数据 ---- */
静 整 dispatch4(字 *mn) {
    若 (strcmp(mn, "浮取栈") == 0) { SK(); 整 rg = 0; 若 (strncmp(gp, "xmm1", 4) == 0) { rg = 1; gp = gp + 4; } 否 若 (strncmp(gp, "xmm0", 4) == 0) { gp = gp + 4; } SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); MEM(); 整 v = mem_result; b(0xF2); b(0x0F); b(0x10); 若 (v < 128 && v >= -128) { modrm(1, rg, 4); b(0x24); b(v); } 否 { modrm(2, rg, 4); b(0x24); b4(v); } 返 1; }
    若 (strcmp(mn, "浮存栈") == 0) { MEM(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 rg = 0; 若 (strncmp(gp, "xmm1", 4) == 0) { rg = 1; gp = gp + 4; } 否 若 (strncmp(gp, "xmm0", 4) == 0) { gp = gp + 4; } b(0xF2); b(0x0F); b(0x11); 若 (v < 128 && v >= -128) { modrm(1, rg, 4); b(0x24); b(v); } 否 { modrm(2, rg, 4); b(0x24); b4(v); } 返 1; }
    若 (strcmp(mn, "浮取静") == 0) { SK(); 若 (strncmp(gp, "xmm0", 4) == 0) gp = gp + 4; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (strncmp(gp, "[rip+DBL", 8) == 0) { gp = gp + 8; 整 di = NUM(); 若 (dpn2 < 2048) { b(0xF2); b(0x0F); b(0x10); b(0x05); b4(0); dbl_patches2[dpn2].at = cp - 4; dbl_patches2[dpn2].idx = di; dpn2 = dpn2 + 1; } } 否 { RIPS(); 整 v = mem_result; b(0xF2); b(0x0F); b(0x10); b(0x05); b4r(v, 0); } 返 1; }
    若 (strcmp(mn, "浮存静") == 0) { RIPS(); 整 v = mem_result; SK(); 若 (gp[0] == ',') gp = gp + 1; b(0xF2); b(0x0F); b(0x11); b(0x05); b4r(v, 0); 返 1; }
    若 (strcmp(mn, "浮取帧") == 0) { SK(); 整 rg = 0; 若 (strncmp(gp, "xmm1", 4) == 0) { rg = 1; gp = gp + 4; } 否 若 (strncmp(gp, "xmm0", 4) == 0) { gp = gp + 4; } SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); mem_result = 0; 若 (gp[0] == '[') { gp = gp + 1; SK(); RG(); SK(); 整 sign = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sign = -1; gp = gp + 1; } mem_result = NUM() * sign; SK(); 若 (gp[0] == ']') gp = gp + 1; } b(0xF2); b(0x0F); b(0x10); 若 (mem_result < 128 && mem_result >= -128) { modrm(1, rg, 5); b(mem_result); } 否 { modrm(2, rg, 5); b4(mem_result); } 返 1; }
    若 (strcmp(mn, "浮存帧") == 0) { 整 v = 0; SK(); 若 (gp[0] == '[') { gp = gp + 1; SK(); RG(); SK(); 整 sign = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sign = -1; gp = gp + 1; } v = NUM() * sign; SK(); 若 (gp[0] == ']') gp = gp + 1; } SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 rg = 0; 若 (strncmp(gp, "xmm1", 4) == 0) { rg = 1; gp = gp + 4; } 否 若 (strncmp(gp, "xmm2", 4) == 0) { rg = 2; gp = gp + 4; } 否 若 (strncmp(gp, "xmm3", 4) == 0) { rg = 3; gp = gp + 4; } 否 若 (strncmp(gp, "xmm0", 4) == 0) { gp = gp + 4; } b(0xF2); b(0x0F); b(0x11); 若 (v < 128 && v >= -128) { modrm(1, rg, 5); b(v); } 否 { modrm(2, rg, 5); b4(v); } 返 1; }
    若 (strcmp(mn, "浮移") == 0) { SK(); 若 (strncmp(gp, "xmm1", 4) == 0) { gp = gp + 4; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); movsd_xmm1_xmm0(); } 否 若 (strncmp(gp, "xmm0", 4) == 0) { gp = gp + 4; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (strncmp(gp, "xmm1", 4) == 0) { gp = gp + 4; movsd_xmm0_xmm1(); } 否 movsd_xmm1_xmm0(); } 返 1; }
    若 (strcmp(mn, "浮加") == 0) { addsd_xmm0_xmm1(); 返 1; }
    若 (strcmp(mn, "浮减") == 0) { subsd_xmm0_xmm1(); 返 1; }
    若 (strcmp(mn, "浮乘") == 0) { mulsd_xmm0_xmm1(); 返 1; }
    若 (strcmp(mn, "浮除") == 0) { divsd_xmm0_xmm1(); 返 1; }
    若 (strcmp(mn, "整转浮") == 0) { SK(); 若 (strncmp(gp, "xmm1", 4) == 0) { gp = gp + 4; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); b(0xF2); b(0x0F); b(0x2A); b(0xC8); } 否 { 若 (strncmp(gp, "xmm0", 4) == 0) gp = gp + 4; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); cvtsi2sd_xmm0_eax(); } 返 1; }
    若 (strcmp(mn, "浮转整") == 0) { cvttsd2si_eax_xmm0(); 返 1; }
    若 (strcmp(mn, "浮比较") == 0) { SK(); 整 a = 0; 整 b = 0; 若 (strncmp(gp, "xmm1", 4) == 0) { a = 1; gp = gp + 4; } 否 若 (strncmp(gp, "xmm0", 4) == 0) { gp = gp + 4; } SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 若 (strncmp(gp, "xmm1", 4) == 0) { b = 1; gp = gp + 4; } 否 若 (strncmp(gp, "xmm0", 4) == 0) { gp = gp + 4; } b(0x66); b(0x0F); b(0x2F); modrm(3, a, b); 返 1; } /* comisd — R599c: 按 操作数 顺序 出 modrm (qcc 文本 `浮比较 xmm1, xmm0` ⟹ 66 0F 2F C8; 原 恒 出 C1 操作数 反了) */
    若 (strcmp(mn, "压浮") == 0) { push_xmm0(); 返 1; }
    若 (strcmp(mn, "弹浮") == 0) { pop_xmm0(); 返 1; }
    若 (strcmp(mn, ".字串") == 0) { SK(); 若 (gp[0] == '"') { 若 (str_cnt2 < 8192) { str_offs2[str_cnt2] = sdp; str_cnt2 = str_cnt2 + 1; } gp = gp + 1; 循环 (gp[0] != 0 && gp[0] != '"') { 若 (sdp >= sdc - 4) { sdc = sdc + 256; sdat = realloc(sdat, sdc); } sdat[sdp] = gp[0]; sdp = sdp + 1; 若 (gp[0] == '\\' && gp[1] != 0 && gp[1] == 'n') { gp = gp + 1; sdp = sdp - 1; sdat[sdp] = 10; sdp = sdp + 1; } 否 若 (gp[0] == '\\' && gp[1] != 0 && gp[1] == 't') { gp = gp + 1; sdp = sdp - 1; sdat[sdp] = 9; sdp = sdp + 1; } 否 若 (gp[0] == '\\' && gp[1] != 0 && gp[1] == '"') { gp = gp + 1; sdp = sdp - 1; sdat[sdp] = 34; sdp = sdp + 1; } 否 若 (gp[0] == '\\' && gp[1] != 0 && gp[1] == '\\') { gp = gp + 1; sdp = sdp - 1; sdat[sdp] = 92; sdp = sdp + 1; } gp = gp + 1; } sdat[sdp] = 0; sdp = sdp + 1; 若 (gp[0] == '"') gp = gp + 1; } 返 1; }
    若 (strcmp(mn, "浮取参") == 0) { b(0xF2); b(0x41); b(0x0F); b(0x10); b(0x45); b(0x00); 返 1; }
    若 (strcmp(mn, "取浮标") == 0) { SK(); 若 (strncmp(gp, "r0", 2) == 0) { gp = gp + 2; SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); b(0x66); b(0x48); b(0x0F); b(0x7E); b(0xC0); } 返 1; }
    返 0;
}

/* 数据指令分派（.浮点 用 double 运算，隔离避免污染 dispatch4） */
静 整 data_dispatch(字 *mn) {
若 (strcmp(mn, ".浮点原") == 0) { SK(); 整 lo4 = NUM(); SK(); 整 hi4 = NUM(); 若 (sdp >= 8) { sdat[sdp-8] = lo4 & 0xff; sdat[sdp-7] = (lo4 >> 8) & 0xff; sdat[sdp-6] = (lo4 >> 16) & 0xff; sdat[sdp-5] = (lo4 >> 24) & 0xff; sdat[sdp-4] = hi4 & 0xff; sdat[sdp-3] = (hi4 >> 8) & 0xff; sdat[sdp-2] = (hi4 >> 16) & 0xff; sdat[sdp-1] = (hi4 >> 24) & 0xff; } 返 1; }
若 (strcmp(mn, ".浮点") == 0) { 循环 (sdp % 8 != 0) { 若 (sdp >= sdc - 4) { sdc = sdc + 256; sdat = realloc(sdat, sdc); } sdat[sdp] = 0; sdp = sdp + 1; } 若 (dbl_cnt2 < 1024) { dbl_offs2[dbl_cnt2] = sdp; dbl_cnt2 = dbl_cnt2 + 1; } SK(); 双 v = 0; 整 sign = 1; 若 (gp[0] == '-') { sign = -1; gp = gp + 1; } 循环 (gp[0] >= '0' && gp[0] <= '9') { v = v * 10 + (gp[0] - '0'); gp = gp + 1; } 若 (gp[0] == '.') { gp = gp + 1; 双 fr = 0; 双 sc = 1; 循环 (gp[0] >= '0' && gp[0] <= '9') { fr = fr * 10 + (gp[0] - '0'); sc = sc * 10; gp = gp + 1; } v = v + fr / sc; } /* fix 2026-08-06: 整数累加+单次除法，消除 fr*=0.1 累积误差（与 qcc fp_parse 同构） */ v = v * sign; 无 字 *db = (无 字 *)&v; 整 k; 遍 (k = 0; k < 8; k = k + 1) { 若 (sdp >= sdc - 4) { sdc = sdc + 256; sdat = realloc(sdat, sdc); } sdat[sdp] = db[k]; sdp = sdp + 1; } 返 1; }
若 (strcmp(mn, ".缩总") == 0) { SK(); 缩总 = NUM(); 返 1; } /* R599c-T10b: 文报通道总量（pass1 收集; pass2 作交叉校验） */
若 (strcmp(mn, ".缩") == 0) { SK(); 整 dv = NUM(); 缩移 = 缩移 + dv; 缩移文 = 缩移文 + dv; 返 1; } /* R599c-T10b: opt_zh 文报通道标记 */
若 (strcmp(mn, ".堆计") == 0) { stc_n = NUM(); 返 1; } /* 直写：qcc 丢"局部v→全局"赋值，改用 NUM() 直返 */
若 (strcmp(mn, ".布局") == 0) { SK(); 若 (strncmp(gp, "code_end=", 9) == 0) { gp = gp + 9; exp_code_end = NUM(); } 否 若 (strncmp(gp, "码终=", 7) == 0) { gp = gp + 7; exp_code_end = NUM(); } SK(); 若 (strncmp(gp, "data_base=0x", 12) == 0) { gp = gp + 10; exp_data_base = NUM(); } 返 1; } /* fix 2026-08-12: 解析 data_base (data_base= 10 字符 + 保留 0x) */
若 (strcmp(mn, ".段") == 0) { SK(); 若 (strncmp(gp, "data_vsize=0x", 13) == 0) { gp = gp + 11; exp_data_vsize = NUM(); SK(); } 否 若 (strncmp(gp, "缓粗=0x", 9) == 0) { gp = gp + 7; exp_data_vsize = NUM(); SK(); } 若 (strncmp(gp, "data_raw=0x", 11) == 0) { gp = gp + 9; exp_data_raw = NUM(); SK(); } 返 1; } /* fix 2026-08-12 H2 对等: data_vsize= 11 字符 + 保留 0x 给 NUM */
    返 0;
}

/* ---- 汇编主循环 ---- */
静 整 asm_assemble(常 字 *src, 整 base, 整 emit_data) {
    data_rva_base = base;
    stc_n = 0; /* 显式复位 */
    spn2 = 0; fnrn2 = 0; strrn2 = 0; str_cnt2 = 0; 整 i; 遍 (i = 0; i < 8192; i = i + 1) str_offs2[i] = 0;
    dpn2 = 0; dbl_cnt2 = 0; 遍 (i = 0; i < 1024; i = i + 1) dbl_offs2[i] = 0;
    cp = 0; pn = 0; ln = 0; 缩移 = 0; rg_n = 0; 缩移文 = 0; 缩移实 = 0; 替下一个 = 0; /* R599c-T10b: 两通道记账/rip 登记 每遍 重置 */
    遍 (i = 0; i < 1048576; i = i + 1) lh[i] = 0; /* R599c-T10b: 清 标签哈希（替代 原 labels[16384] 逐项清名） */
    sdc = 256; sdat = malloc(sdc); sdp = 0;
    gp = src;
    line_no = 1; /* fix 2026-08-05：错误行号（全局；每次 asm_assemble 重置） */
    while (gp[0] != 0) {
        while (gp[0] == ' ' || gp[0] == '\t' || gp[0] == '\n' || gp[0] == '\r') { 若 (gp[0] == '\n') line_no = line_no + 1; gp = gp + 1; } 若 (gp[0] == 0) break;
        若 (gp[0] == ';') { 循环 (gp[0] != 0 && gp[0] != '\n') gp = gp + 1; 续; }
        常 字 *ls = gp; 循环 (gp[0] != 0 && gp[0] != ':' && gp[0] != '\n') gp = gp + 1;
        若 (gp[0] == ':') {
            整 hasq = 0; 整 hsp = 0; 常 字 *qc = ls; 循环 (qc < gp) { 若 (qc[0] == '"') hasq = 1; 若 (qc[0] == ' ' || qc[0] == '\t') hsp = 1; qc = qc + 1; }
            若 (hasq == 0 && hsp == 0) {
                整 len = (gp - ls); 若 (len > 0 && len < 32 && ln < 600000) { 字 n[32]; 整 k; 遍 (k = 0; k < len; k = k + 1) n[k] = ls[k]; n[len] = 0; 整 li = LF(n); 若 (li < 0) { strcpy(labels[ln].name, n); labels[ln].pos = cp; labels[ln].defined = 1; labels[ln].line = line_no; lhins(ln); li = ln; ln = ln + 1; } 否 { labels[li].pos = cp; labels[li].defined = 1; } }
                gp = gp + 1; 循环 (gp[0] != 0 && gp[0] != '\n') gp = gp + 1; 若 (gp[0] == '\n') { gp = gp + 1; line_no = line_no + 1; } 续;
            }
        }
        gp = ls;
        字 mn[32]; 整 mi = 0; 循环 (gp[0] != 0 && gp[0] != ' ' && gp[0] != '\t' && gp[0] != '\r' && gp[0] != '\n' && mi < 31) { mn[mi] = gp[0]; mi = mi + 1; gp = gp + 1; } mn[mi] = 0;
        整 cpb = cp; 整 cpb_sdp = sdp; /* R599c-T10b: 零发射检测（静默丢弃的指令在 中文汇编→PE 链上是致命的） */
        /* R599c-T10b 实测通道: `.删 <指令>` ⟹ 干跑该指令**实测**其编码长度（长度随位移变化者也精确）;
           `.增 <指令>` ⟹ 同上，但记「变长」（R881: 优化器要插入指令时必须如实记账，否则 rip 位移错位）;
           `.替` ⟹ 下一条被发射的指令是「替换体」，其字节数从实测量里扣回。任何副作用/零长度 ⟹ 响亮失败。 */
        若 (strcmp(mn, ".删") == 0 || strcmp(mn, ".增") == 0) {
            整 是增 = (strcmp(mn, ".增") == 0);
            SK();
            字 mn2[32]; 整 mi2 = 0; 循环 (gp[0] != 0 && gp[0] != ' ' && gp[0] != '\t' && gp[0] != '\r' && gp[0] != '\n' && mi2 < 31) { mn2[mi2] = gp[0]; mi2 = mi2 + 1; gp = gp + 1; }
            mn2[mi2] = 0;
            整 pn0 = pn; 整 rgn0 = rg_n; 整 dp0 = dpn2; 整 sr0 = strrn2; 整 fr0 = fnrn2; 整 ln0 = ln; 整 lu0 = lh撤销n; 整 sd0 = sdp; 整 st0 = stc_n;
            干跑 = 1; 干跑长 = 0;
            若 (dispatch4(mn2) == 0) { 若 (data_dispatch(mn2) == 0) { 若 (dispatch1(mn2) == 0) { 若 (dispatch2(mn2) == 0) { dispatch3(mn2); } } } }
            干跑 = 0;
            /* 干跑必须**完全无副作用**：登记类（跳转补丁 / rip 登记 / 浮点·串·符号补丁 / 新建标签及其哈希槽）
               一律回滚；布局类（sdp / 堆计数）无法回滚 ⟹ 响亮失败（实测通道只承载普通指令）。 */
            若 (sdp != sd0 || stc_n != st0) { 输出("[ERR] asm_zh: .删 的形态改动了布局 (%s) — 不可用于实测通道\n", mn2); exit(1); }
            pn = pn0; rg_n = rgn0; dpn2 = dp0; strrn2 = sr0; fnrn2 = fr0; ln = ln0;
            循环 (lh撤销n > lu0) { lh撤销n = lh撤销n - 1; lh[lh撤销[lh撤销n]] = 0; }
            若 (干跑长 <= 0) { 输出("[ERR] asm_zh: .删/.增 实测长度非正 (%s)\n", mn2); exit(1); }
            若 (是增) { 缩移 = 缩移 - 干跑长; 缩移实 = 缩移实 - 干跑长; }
            否 { 缩移 = 缩移 + 干跑长; 缩移实 = 缩移实 + 干跑长; }
        } 否 若 (strcmp(mn, ".替") == 0) {
            替下一个 = 1;
        } 否 {
            若 (dispatch4(mn) == 0) { 若 (data_dispatch(mn) == 0) { 若 (dispatch1(mn) == 0) { 若 (dispatch2(mn) == 0) { dispatch3(mn); } } } }
            若 (替下一个) { 若 (cp >= cpb) { 缩移 = 缩移 - (cp - cpb); 缩移实 = 缩移实 - (cp - cpb); } 否 { 输出("[ERR] asm_zh: .替 之后发生了回退\n"); exit(1); } 替下一个 = 0; }
            若 (emit_data && cp == cpb && sdp == cpb_sdp && mn[0] != '.') { 输出("[NOEMIT] %s at line %d\n", mn, line_no); }
        }
        循环 (gp[0] != 0 && gp[0] != '\n') gp = gp + 1; 若 (gp[0] == '\n') { gp = gp + 1; line_no = line_no + 1; }
    }
    resolve_patches();
    /* R599c-T10b: 两通道交叉校验 —— 文报（Σ.缩）必须等于 .缩总; 且 `.替` 必须被消费。任何不一致 ⟹ 响亮失败 */
    若 (emit_data && 缩总 != 缩移文) { 输出("[ERR] asm_zh: 文报通道不一致 — .缩总=%d 而 Σ.缩=%d\n", 缩总, 缩移文); exit(1); }
    若 (emit_data && 替下一个 != 0) { 输出("[ERR] asm_zh: .替 未被消费\n"); exit(1); }
    /* pad to qcc's exact code_end before resolving data refs (优化链: 终点下移 = 两通道实测总量) */
    整 目标终 = exp_code_end - 缩移;
    若 (emit_data && 目标终 > cp) {
        循环 (cp + (目标终 - cp) + sdp >= code_cap) {
            code_cap = code_cap * 2;
            无 字 *nc = realloc(code, code_cap);
            若 (nc == 0) { 输出("asm_zh: OOM at pad\n"); exit(1); } code = nc;
        }
        循环 (cp < 目标终) { code[cp] = 0x90; cp = cp + 1; }
    }
    若 (emit_data && rg_n > 0) { /* R599c-T10b: [rip+N] 事后回填 —— 按 qcc 声明的布局区分两类目标 */
        整 cend = cp; 整 i6; 遍 (i6 = 0; i6 < rg_n; i6 = i6 + 1) {
            整 at = rg_at[i6]; 整 tg = rg_tg[i6]; 整 dp;
            若 (exp_code_end > 0 && tg >= exp_code_end && tg < exp_code_end + sdp) {
                dp = (cend + (tg - exp_code_end)) - at - 4; /* 甲: 数据块引用 — 目标随代码区终点下移 ⟹ 用实际落点 */
            } 否 {
                dp = tg - at - 4;                            /* 乙: 固定地址 — 目标不动, 只有 rip 前移 ⟹ dp = 原 dp + 缩移 */
            }
            b4_at(at, dp);
        }
    }
    若 (emit_data && spn2 > 0) {
        整 code_end = cp; 整 i2; 遍 (i2 = 0; i2 < spn2; i2 = i2 + 1) { 整 off = str_offs2[str_patches2[i2].idx]; 整 va = 0x400000 + 0x1000 + code_end + off; b4_at(str_patches2[i2].at, va); }
    }
    若 (emit_data && strrn2 > 0) { 整 i4; 遍 (i4 = 0; i4 < strrn2; i4 = i4 + 1) { 整 cend = cp; 整 off4 = str_offs2[strr_patches2[i4].idx]; 整 tva4 = 0x400000 + 0x1000 + cend + off4; b4_at(strr_patches2[i4].at, tva4 - (0x400000 + 0x1000 + strr_patches2[i4].at + 4)); } }
若 (emit_data && fnrn2 > 0) { 整 i3; 遍 (i3 = 0; i3 < fnrn2; i3 = i3 + 1) { 若 (labels[fnr_patches2[i3].label].defined == 0) { 输出("asm_zh: undefined fn label at %d\n", labels[fnr_patches2[i3].label].line); exit(1); } 整 tva = 0x400000 + 0x1000 + labels[fnr_patches2[i3].label].pos; b4_at(fnr_patches2[i3].at, tva - (0x400000 + 0x1000 + fnr_patches2[i3].at + 4)); } }
若 (emit_data && fnpn2 > 0) {
        整 i2; 遍 (i2 = 0; i2 < fnpn2; i2 = i2 + 1) { 若 (labels[fn_patches2[i2].label].defined == 0) { 输出("[ERR] asm_zh: undefined fn label '%s' at line %d\n", labels[fn_patches2[i2].label].name, labels[fn_patches2[i2].label].line); exit(1); } 整 va = 0x400000 + 0x1000 + labels[fn_patches2[i2].label].pos; b4_at(fn_patches2[i2].at, va); }
    }
    若 (emit_data && dpn2 > 0) {
        整 code_end = cp; 整 i2; 遍 (i2 = 0; i2 < dpn2; i2 = i2 + 1) { 整 off = dbl_offs2[dbl_patches2[i2].idx]; 整 at = dbl_patches2[i2].at; 整 disp = code_end + off - at - 4; b4_at(at, disp); }
    }
    若 (emit_data && sdp > 0) { 循环 (cp + sdp >= code_cap) { code_cap = code_cap * 2; 无 字 *nc = realloc(code, code_cap); 若 (nc == 0) { 输出("asm_zh: OOM at buffer\n"); exit(1); } code = nc; } 整 k; 遍 (k = 0; k < sdp; k = k + 1) { code[cp] = sdat[k]; cp = cp + 1; } }
    若 (emit_data == 0) { /* pass1: 预计算 data_base 存入 data_rva_base（qcc 对 edb 赋值 bug，跨函数读不可靠） */
        整 rb = ((0x1000 + cp + sdp + 4095) & ~4095);
        若 (rb < 0x2000) rb = 0x2000;
        data_rva_base = rb;
    }
    返 0;
}

/* 十六进制打印（qcc printf 不支持 %X） */
静 空 print_hex(整 v) {
    字 hexc[16]; hexc[0] = '0'; hexc[1] = '1'; hexc[2] = '2'; hexc[3] = '3'; hexc[4] = '4'; hexc[5] = '5'; hexc[6] = '6'; hexc[7] = '7'; hexc[8] = '8'; hexc[9] = '9'; hexc[10] = 'A'; hexc[11] = 'B'; hexc[12] = 'C'; hexc[13] = 'D'; hexc[14] = 'E'; hexc[15] = 'F';
    字 out[11]; out[0] = '0'; out[1] = 'x'; 整 i; 整 shifted; 整 j; 遍 (i = 0; i < 8; i = i + 1) { shifted = v; 遍 (j = 0; j < (7 - i); j = j + 1) shifted = shifted / 16; out[2 + i] = hexc[shifted & 15]; } out[10] = 0; 输出("%s", out);
}

静 整 main(整 argc, 字 **argv) {
    常 字 *inf = 0; 常 字 *outf = "a.exe";
    整 i; 遍 (i = 1; i < argc; i = i + 1) { 若 (strcmp(argv[i], "-o") == 0 && i + 1 < argc) { outf = argv[i + 1]; i = i + 1; } 否 inf = argv[i]; }
    若 (inf == 0) { 输出("Usage: asm_zh input.asm [-o out.exe]\n"); 返 1; }
    FILE *fi = fopen(inf, "rb"); 若 (fi == 0) { 输出("Cannot open %s\n", inf); 返 1; }
    fseek(fi, 0, 2); 整 sz = ftell(fi); fseek(fi, 0, 0);
    字 *src = malloc(sz + 1); fread(src, 1, sz, fi); src[sz] = 0; fclose(fi);
    code = malloc(0x400000); 若 (code == 0) { 输出("asm_zh: OOM at init\n"); 返 1; } cp = 0;
    整 r = asm_assemble(src, 0x2000, 0);
    若 (r < 0) { 输出("Assembly failed\n"); free(src); free(code); 返 1; }
    整 code_size = cp;
    free(sdat);
    整 real_base = exp_data_base ? exp_data_base : ((0x1000 + code_size + 4095) & ~4095); /* 同步 C: 用 .布局 data_base, 否则按 code_size 对齐 (fix 2026-08-12) */
    若 (real_base < 0x2000) real_base = 0x2000;
    r = asm_assemble(src, real_base, 1);
    若 (r < 0) { 输出("Assembly failed\n"); free(src); free(code); free(sdat); 返 1; }
    FILE *fo = fopen(outf, "wb"); 若 (fo == 0) { 输出("Cannot write %s\n", outf); 返 1; }
    整 entry = -1; 整 li; 遍 (li = 0; li < ln; li = li + 1) 若 (strcmp("_入口", labels[li].name) == 0) { entry = 0x1000 + labels[li].pos; break; }
    若 (entry < 0) { 输出("[ERR] asm_zh: no _入口 label\n"); fclose(fo); remove(outf); free(src); free(code); free(sdat); 返 1; } /* fix 2026-08-05 */
    若 (cp == 0) { 输出("[ERR] asm_zh: empty output\n"); fclose(fo); remove(outf); free(src); free(code); free(sdat); 返 1; } /* fix 2026-08-05 */
    缩总 = 0; /* R599c-T10b: 每次汇编前清, 由 pass1 的 .缩总 重新填入 */
    write_pe(fo, entry);
    fclose(fo);
    输出("OK: %s (%d bytes code, 实测缩=%d, 文报缩=%d, 总缩=%d, data_base=", outf, cp, 缩移实, 缩移文, 缩移); print_hex(real_base); 输出(")\n");
    free(src); free(code); free(sdat);
    返 0;
}
