/* asm_zh.jy — 中文 x86-64 汇编器（甲言版，4分派函数结构）
 * 解析 .asm 文本（qcc_x86 -S 产物）并输出 PE .exe
 * 用法: asm_zh input.asm [-o output.exe]
 * 支持命名寄存器(rbp,rsp,rax等)和数字(r0-r15)
 * seed=828 | 2026-08-03 | 全中文自治：汇编器源码甲言化，qcc_x86 编译
 * 结构：4 个分派函数（各~20分支）绕开 qcc 大函数编译 bug
 */

静 无 字 *code; 静 整 cp; 静 整 code_cap = 0x400000; /* fix 2026-08-14: 缓冲区容量 — 原 realloc 固定 0x400000+4096 死循环 */
静 整 data_rva_base = 0x2000;
静 整 exp_code_end;  /* from qcc .布局 */
整 exp_data_base;  /* from qcc .布局 data_base= — 非static (fix 2026-08-12) */
整 exp_data_vsize; /* from qcc .段 — 非static (qcc 静态变量跨函数读写地址错位, 同 stc_n) (fix 2026-08-12 H2 对等) */
整 exp_data_raw;   /* from qcc .段 */
整 stc_n = 0; /* from qcc .堆计；非static实验：qcc 静态变量读写地址错位 */
静 常 字 *gp; 静 整 mem_result;
静 整 缩移 = 0; /* R599c-T10b: 优化链累积位移（文报通道 + 实测通道 之和）; 每遍汇编重置 */
静 整 缩总 = 0; /* R599c-T10b: 优化器在 .缩总 里报的「文报通道总量」— 仅作交叉校验（不等即响亮失败） */
静 整 缩移文 = 0; /* 文报通道: Σ opt_zh 的 `.缩 N` 标记 */
静 整 缩移实 = 0; /* 实测通道: Σ(被删指令的**实测**编码长度) − Σ(替换体的实测长度) —— 长度随位移变化者也精确 */
静 整 干跑 = 0;  静 整 干跑长 = 0; /* 干跑: b() 只计数不发字节（用于实测被删指令的长度） */
静 整 lh撤销n = 0; 静 整 lh撤销[4096]; /* 干跑期间 lhins 写入的哈希槽 —— 干跑结束须回滚（否则标签表被污染） */
静 整 替下一个 = 0; /* `.替` 之后的那一条被发射指令是「替换体」⟹ 其字节数从实测量里扣回 */
/* R599c-T10b: [rip+N] 目标登记 —— 必须区分两类目标:
   (甲) 数据块引用: 目标落在「码终之后的数据块」内, 该块随代码区终点下移 ⟹ 用实际落点精确算 disp;
   (乙) 固定地址引用: 目标在 .data (如堆计数器, 地址由 qcc .布局 data_base 锚定) ⟹ 只需 +缩移。
   判定依据 = qcc 自己声明的布局: 原布局下的目标偏移 落在 [码终, 码终+数据块字节) ⟹ 甲类。
   记录 tg = 原布局(未优化)下的目标偏移 = 位移槽后 原 rip 偏移 + 原始 N。 */
静 整 rg_n = 0; 静 整 rg_at[300000]; 静 整 rg_tg[300000];

/* ---- x86-64 发射器 ---- */
静 空 b(无 字 v) { 若 (干跑) { 干跑长 = 干跑长 + 1; 返; } 若 (cp >= code_cap) { 循环 (cp >= code_cap) code_cap = code_cap * 2; 无 字 *nc = realloc(code, code_cap); 若 (nc == 0) { 输出("asm_zh: OOM at emit\n"); exit(1); } code = nc; } code[cp] = v; cp = cp + 1; } /* R599c-T10b: 补 容量检查; 干跑 计数不发 */
静 空 b4(整 v) { b(v & 0xff); b((v >> 8) & 0xff); b((v >> 16) & 0xff); b((v >> 24) & 0xff); }
静 空 modrm(整 mod, 整 reg, 整 rm) { b((mod << 6) | ((reg & 7) << 3) | (rm & 7)); }
静 空 rex(整 w, 整 r, 整 x, 整 bv) { b(0x40 | (w ? 8 : 0) | (r ? 4 : 0) | (x ? 2 : 0) | (bv ? 1 : 0)); }
静 空 b4_at(整 pos, 整 v) { code[pos] = v & 0xff; code[pos + 1] = (v >> 8) & 0xff; code[pos + 2] = (v >> 16) & 0xff; code[pos + 3] = (v >> 24) & 0xff; }
/* R599c-T10b: 写 4 字节 rip 位移「占位」并登记 (位移槽位置 at, 原布局目标偏移 tg) 供事后回填。
   tail = 本指令内 位移槽 之后 还有几字节 (通常 0; 「写静字节」的 imm8 为 1)。
   cp 此刻在位移槽之后 ⟹ 原布局的 rip 偏移 = cp + tail + 缩移, 加上原始 N 即得 tg。 */
静 空 b4r(整 d, 整 tail) { b4(0); 若 (rg_n < 300000) { rg_at[rg_n] = cp - 4; rg_tg[rg_n] = cp + tail + 缩移 + d; rg_n = rg_n + 1; } 否 { 输出("asm_zh: rip 登记表 溢出\n"); exit(1); } }
静 空 b_at(整 pos, 整 v) { code[pos] = v & 0xff; }

静 空 mov_rr64(整 d, 整 s) { rex(1, s & 8, 0, d & 8); b(0x89); modrm(3, s & 7, d & 7); }
静 空 mov_rr(整 d, 整 s) { rex(0, s & 8, 0, d & 8); b(0x89); modrm(3, s & 7, d & 7); }
静 空 mov_mbrp_reg(整 disp, 整 reg) { rex(0, reg & 8, 0, 0); b(0x89); 若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); } 否 { modrm(2, reg & 7, 5); b4(disp); } }
静 空 mov_reg_mbrp(整 reg, 整 disp) { rex(0, reg & 8, 0, 0); b(0x8B); 若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); } 否 { modrm(2, reg & 7, 5); b4(disp); } }
静 空 mov_mbrp_reg64(整 disp, 整 reg) { rex(1, reg & 8, 0, 0); b(0x89); 若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); } 否 { modrm(2, reg & 7, 5); b4(disp); } }
静 空 mov_reg_mbrp64(整 reg, 整 disp) { rex(1, reg & 8, 0, 0); b(0x8B); 若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 5); b(disp); } 否 { modrm(2, reg & 7, 5); b4(disp); } }
静 空 mov_mrsp_reg64(整 disp, 整 reg) { rex(1, reg & 8, 0, 0); b(0x89); 若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); } 否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); } }
静 空 mov_reg_mrsp64(整 reg, 整 disp) { rex(1, reg & 8, 0, 0); b(0x8B); 若 (disp < 128 && disp >= -128) { modrm(1, reg & 7, 4); b(0x24); b(disp); } 否 { modrm(2, reg & 7, 4); b(0x24); b4(disp); } }
静 空 mov_eax_rip(整 d) { b(0x8B); b(0x05); b4r(d, 0); }
静 空 mov_rip_eax(整 d) { b(0x89); b(0x05); b4r(d, 0); }
静 空 mov_rax_rip64(整 d) { rex(1, 0, 0, 0); b(0x8B); b(0x05); b4r(d, 0); }
静 空 mov_rip_rax64(整 d) { rex(1, 0, 0, 0); b(0x89); b(0x05); b4r(d, 0); }
静 空 mov_reg_mreg(整 r, 整 m) { rex(0, r & 8, 0, m & 8); b(0x8B); 若 (m == 4 || m == 12) { modrm(0, r & 7, m & 7); b(0x24); } 否 modrm(0, r & 7, m & 7); }
静 空 mov_reg_mreg64(整 r, 整 m) { rex(1, r & 8, 0, m & 8); b(0x8B); 若 (m == 4 || m == 12) { modrm(0, r & 7, m & 7); b(0x24); } 否 modrm(0, r & 7, m & 7); }
静 空 mov_mreg_reg(整 m, 整 r) { rex(0, r & 8, 0, m & 8); b(0x89); 若 (m == 4 || m == 12) { modrm(0, r & 7, m & 7); b(0x24); } 否 modrm(0, r & 7, m & 7); }
静 空 mov_eax_mr13(空) { b(0x41); b(0x8B); b(0x45); b(0); }
静 空 mov_rax_mr13(空) { b(0x49); b(0x8B); b(0x45); b(0); }
静 空 mov_r12_cl(空) { rex(0, 0, 0, 1); b(0x88); modrm(0, 1, 4); b(0x24); }
静 空 mov_r12_al(空) { rex(0, 0, 0, 1); b(0x88); modrm(0, 0, 4); b(0x24); }
静 空 movzx_eax_al(空) { b(0x0F); b(0xB6); modrm(3, 0, 0); }
静 空 lea_r_mrsp(整 r, 整 d) { rex(1, r & 8, 0, 0); b(0x8D); 若 (d < 128 && d >= -128) { modrm(1, r & 7, 4); b(0x24); b(d); } 否 { modrm(2, r & 7, 4); b(0x24); b4(d); } }
静 空 lea_r_mbrp(整 r, 整 d) { rex(1, r & 8, 0, 0); b(0x8D); 若 (d < 128 && d >= -128) { modrm(1, r & 7, 5); b(d); } 否 { modrm(2, r & 7, 5); b4(d); } }
静 空 lea_rax_rip(整 d) { rex(1, 0, 0, 0); b(0x8D); b(0x05); b4r(d, 0); }
静 空 alu_rr(整 op, 整 d, 整 s) {
    若 (op == 5) { rex(0, s & 8, 0, d & 8); b(0x01); modrm(3, s & 7, d & 7); }
    否 若 (op == 6) { rex(0, s & 8, 0, d & 8); b(0x29); modrm(3, s & 7, d & 7); }
    否 若 (op == 8) { rex(0, s & 8, 0, d & 8); b(0x39); modrm(3, s & 7, d & 7); }
    否 若 (op == 7) { rex(0, d & 8, 0, s & 8); b(0x0F); b(0xAF); modrm(3, d & 7, s & 7); } /* imul: REX.R=dst REX.B=src（对齐 C 版） */
}
静 空 test_rr(整 r1, 整 r2) { rex(0, r2 & 8, 0, r1 & 8); b(0x85); modrm(3, r2 & 7, r1 & 7); }
静 空 setcc(整 op) { 无 字 c = (op == 8) ? 0x94 : (op == 10) ? 0x95 : (op == 11) ? 0x9C : (op == 21) ? 0x9F : (op == 22) ? 0x9E : (op == 23) ? 0x9D : (op == 31) ? 0x92 : (op == 32) ? 0x97 : (op == 33) ? 0x96 : (op == 34) ? 0x93 : 0x94; b(0x0F); b(c); modrm(3, 0, 0); }
静 空 push_r(整 r) { 若 (r & 8) b(0x41); b(0x50 | (r & 7)); }
静 空 pop_r(整 r) { 若 (r & 8) b(0x41); b(0x58 | (r & 7)); }
静 空 ret(空) { b(0xC3); }
静 空 sub_rsp_imm(整 v) { b(0x48); b(0x81); b(0xEC); b4(v); }
静 空 add_rsp_imm(整 v) { b(0x48); b(0x81); b(0xC4); b4(v); }
静 空 movsd_xmm0_mbrp(整 d) { b(0xF2); b(0x0F); b(0x10); 若 (d < 128 && d >= -128) { modrm(1, 0, 5); b(d); } 否 { modrm(2, 0, 5); b4(d); } }
静 空 movsd_mbrp_xmm0(整 d) { b(0xF2); b(0x0F); b(0x11); 若 (d < 128 && d >= -128) { modrm(1, 0, 5); b(d); } 否 { modrm(2, 0, 5); b4(d); } }
静 空 movsd_xmm0_xmm1(空) { b(0xF2); b(0x0F); b(0x10); b(0xC1); }
静 空 movsd_xmm1_xmm0(空) { b(0xF2); b(0x0F); b(0x10); b(0xC8); }
静 空 addsd_xmm0_xmm1(空) { b(0xF2); b(0x0F); b(0x58); b(0xC1); }
静 空 subsd_xmm0_xmm1(空) { b(0xF2); b(0x0F); b(0x5C); b(0xC1); }
静 空 mulsd_xmm0_xmm1(空) { b(0xF2); b(0x0F); b(0x59); b(0xC1); }
静 空 divsd_xmm0_xmm1(空) { b(0xF2); b(0x0F); b(0x5E); b(0xC1); }
静 空 cvtsi2sd_xmm0_eax(空) { b(0xF2); b(0x0F); b(0x2A); b(0xC0); }
静 空 cvttsd2si_eax_xmm0(空) { b(0xF2); b(0x0F); b(0x2C); b(0xC0); }
静 空 comisd_xmm0_xmm1(空) { b(0x66); b(0x0F); b(0x2F); b(0xC1); }
静 空 push_xmm0(空) { sub_rsp_imm(8); b(0xF2); b(0x0F); b(0x11); modrm(0, 0, 4); b(0x24); }
静 空 pop_xmm0(空) { b(0xF2); b(0x0F); b(0x10); modrm(0, 0, 4); b(0x24); add_rsp_imm(8); }

/* 标签/补丁系统 */
构 { 字 name[32]; 整 pos, defined, line; } labels[600000]; 静 整 ln; /* line：错误信息行号（fix 2026-08-05）；R599c-T10b: 16384→600000（编译器本体实测 328951 标签） */
静 整 line_no; /* fix 2026-08-05：全局行号（LR 函数可见；asm_assemble 每次重置为 1） */
静 整 lh[1048576]; /* R599c-T10b: 标签名哈希（0=空，否则 labels 索引+1）—— 原 LF 线性扫描 O(n²)，对 33 万标签不可行 */
静 空 lhins(整 li) { 整 h = 0; 整 i = 0; 循环 (labels[li].name[i] != 0) { h = h * 37 + labels[li].name[i]; i = i + 1; } h = h & 1048575; 循环 (lh[h] != 0) { h = h + 1; 若 (h >= 1048576) h = 0; } lh[h] = li + 1; 若 (干跑) { 若 (lh撤销n >= 4096) { 输出("[ERR] asm_zh: 干跑撤销表溢出\n"); exit(1); } lh撤销[lh撤销n] = h; lh撤销n = lh撤销n + 1; } } /* R599c-T10b: 插入 labels[li] 的名字; 干跑时登记待撤销槽 */
构 { 整 at, target, is_jmp; } patches[800000]; 静 整 pn; /* R599c-T10b: 16384→800000（编译器本体实测 520203 跳转/调用） */
静 空 patch_label(整 at, 整 tl, 整 is_jmp) { 若 (pn < 800000) { patches[pn].at = at; patches[pn].target = tl; patches[pn].is_jmp = is_jmp; pn = pn + 1; } }
静 空 call_rel(整 rel) { b(0xE8); b4(rel); }
静 空 jmp_rel(整 rel) { b(0xE9); b4(rel); }
静 空 jz_rel(整 rel) { b(0x0F); b(0x84); b4(rel); }
静 空 jnz_rel(整 rel) { b(0x0F); b(0x85); b4(rel); }
静 空 call_iat(整 slot) { 整 at = cp; 整 iat_off = 0; 若 (slot < 64) { iat_off = 8 + 8 * slot; } 否 { iat_off = 0x210 + 8 * (slot - 64); } b(0xFF); b(0x15); b4((data_rva_base + iat_off) - (0x1000 + at + 6)); } /* IAT1@+0x08 / IAT2@+0x50 (fix 2026-08-12: 对齐 C) */
静 空 resolve_patches(空) { 整 i; 遍 (i = 0; i < pn; i = i + 1) { 整 t = labels[patches[i].target].pos; 整 at = patches[i].at; 若 (patches[i].is_jmp == 3) { 整 v = t - (at + 1); b_at(at, v & 0xff); } 否 { 整 v = t - (at + 4); b4_at(at, v); } } } /* 对齐 C 版 (fix 2026-08-13): 未定义标签 (如无 main 的库文件 CRT call main) 宽容解析为 0 占位, 不报错 */
静 无 字 *sdat; 静 整 sdp, sdc;
构 { 整 at; 整 idx; } str_patches2[16384]; 静 整 spn2; /* R599c-T10b: 2048→16384（编译器本体 STR 引用 7865） */
静 整 str_offs2[8192]; 静 整 str_cnt2; /* R599c-T10b: 1024→8192（编译器本体 .字串 3300） */
构 { 整 at; 整 idx; } dbl_patches2[2048]; 静 整 dpn2;
静 整 dbl_offs2[1024]; 静 整 dbl_cnt2;
构 { 整 at; 整 label; } fn_patches2[2048]; 静 整 fnpn2; 构 { 整 at; 整 label; } fnr_patches2[2048]; 整 fnrn2; 构 { 整 at; 整 idx; } strr_patches2[16384]; 整 strrn2; /* R599c: FN 的相对(lea rip) 补丁；R599c-T10b: 2048→16384 */

/* PE 写出 */
静 空 pad(FILE *f, 整 n) { 循环 (n > 0) { fputc(0, f); n = n - 1; } }
静 空 w4(FILE *f, 整 v) { fputc(v & 0xff, f); fputc((v >> 8) & 0xff, f); fputc((v >> 16) & 0xff, f); fputc((v >> 24) & 0xff, f); }
静 空 w8(FILE *f, 整 v) { w4(f, v); w4(f, 0); }
静 空 w2(FILE *f, 整 v) { fputc(v & 0xff, f); fputc((v >> 8) & 0xff, f); }

静 空 write_pe(FILE *f, 整 entry_rva) {
    整 ts = ((cp + 4095) & ~4095); 若 (ts < 512) ts = 512; /* SizeOfRawData = 实际(缩短后)尺寸 ⟹ 文件体积的真收益 */
    整 tf = 0x200; 整 dr = data_rva_base;
    /* R599c-T10b: .text 的 VirtualSize 必须覆盖到 .data 的起点 —— 优化链缩短代码后,
       .data 的 va 仍锚在 qcc 的 .布局 data_base (按未优化尺寸算死) ⟹ 若 vs 只写实际尺寸,
       镜像会在 .text 末尾与 .data 之间留出虚拟空隙 ⟹ Windows 加载器直接拒载 (ERROR_BAD_EXE_FORMAT 193)。
       实测: 空隙 / 重叠一律拒载, 只有「严密无缝」通过。故 vs 取 dr-0x1000 (与未优化布局同值),
       rs 仍取实际尺寸 —— 文件照样缩小, 且 .data 及代码中已写死的地址全部保持有效。 */
    整 tv = (dr > 0x1000) ? (dr - 0x1000) : ts;
    若 (tv < ts) tv = ts;
    整 dv = exp_data_vsize ? exp_data_vsize : 0x5000000; /* fix 2026-08-12 H2 对等: 用 qcc .段 的 .data vsize */
    整 isz = dr + dv + 0x1000; 整 df = tf + ts;
    整 pos; 整 i;
    fputc('M', f); fputc('Z', f); pad(f, 58); w4(f, 64);
    fputc('P', f); fputc('E', f); fputc(0, f); fputc(0, f);
    w2(f, 0x8664); w2(f, 2); w4(f, 0); w4(f, 0); w4(f, 0); w2(f, 0xF0); w2(f, 0x22E);
    w2(f, 0x020B); fputc(0, f); fputc(0, f); w4(f, ts); w4(f, 8); w4(f, 0); w4(f, entry_rva); w4(f, 0x1000);
    w8(f, 0x400000); w4(f, 0x1000); w4(f, 0x200); w2(f, 6); w2(f, 0); w2(f, 0); w2(f, 0); w2(f, 6); w2(f, 0);
    w4(f, 0); w4(f, isz); w4(f, 0x200); w4(f, 0); w2(f, 3); w2(f, 0x8100);
    w8(f, 0x400000); w8(f, 0x400000); w8(f, 0x100000); w8(f, 0x1000); w4(f, 0); w4(f, 16); /* StackReserve=StackCommit=0x400000 (同步 C) */
    w4(f, 0); w4(f, 0); w4(f, dr + 0x7E8); w4(f, 60); /* R599c: import dir: desc@+0x7E8 (同 qcc) */
    遍 (i = 2; i < 16; i = i + 1) { w4(f, 0); w4(f, 0); }
    /* 节名逐字节写出（qcc 字符串表截断内嵌 NUL，不能用 ".text\0\0\0" 字面量） */
    fputc('.', f); fputc('t', f); fputc('e', f); fputc('x', f); fputc('t', f); fputc(0, f); fputc(0, f); fputc(0, f); w4(f, tv); w4(f, 0x1000); w4(f, ts); w4(f, tf); w4(f, 0); w4(f, 0); w2(f, 0); w2(f, 0); w4(f, 0x60000020);
    fputc('.', f); fputc('d', f); fputc('a', f); fputc('t', f); fputc('a', f); fputc(0, f); fputc(0, f); fputc(0, f); w4(f, dv); w4(f, dr); w4(f, exp_data_raw ? exp_data_raw : 0x4000); w4(f, df); w4(f, 0); w4(f, 0); w2(f, 0); w2(f, 0); w4(f, 0xC0000040);
    pos = ftell(f); 循环 (pos < tf) { fputc(0, f); pos = pos + 1; } fwrite(code, 1, cp, f); pos = ftell(f); 循环 (pos < df) { fputc(0, f); pos = pos + 1; }
    /* R599c: .data 头 —— 与 编译器 直产 PE 同 布局 (heap counter@+0, IAT1 甲64@+0x08,
       IAT2 乙60@+0x210, ILT1@+0x3F8, ILT2@+0x600, desc@+0x7E8, dll 名@+0x824, hint/名@+0x83C)。 */
    w8(f, (0x400000 + dr + 0x1100 + 4 * stc_n + 2560 + 7) & ~7); /* heap counter (对齐); R599c-T10b: 0x300 → 0x1100 (qcc 宏 `名聚`) — 原仿真少 0xE00 ⟹ .data+0 差 3584 */
    字 *impall = "GetStdHandle\nWriteFile\nCreateFileA\nReadFile\nVirtualAlloc\nSetFilePointer\nExitProcess\nGetCommandLineA\nCreateThread\nWaitForSingleObject\nCloseHandle\nCreateFiber\nSwitchToFiber\nDeleteFiber\nConvertThreadToFiber\nLoadLibraryA\nGetProcAddress\nGetLastError\nSetLastError\nGetModuleHandleA\nGetModuleFileNameA\nGetModuleFileNameW\nFreeLibrary\nLoadLibraryW\nLoadLibraryExA\nFormatMessageA\nWideCharToMultiByte\nMultiByteToWideChar\nGetFileAttributesA\nGetFileAttributesW\nGetFileAttributesExA\nGetFileAttributesExW\nSetFileAttributesW\nCreateFileW\nDeleteFileW\nFindFirstFileW\nFindNextFileW\nFindClose\nGetFileType\nGetFileInformationByHandle\nSetFileTime\nGetLongPathNameW\nGetFullPathNameW\nGetFinalPathNameByHandleW\nGetEnvironmentStringsW\nFreeEnvironmentStringsW\nGetEnvironmentVariableW\nSetEnvironmentVariableW\nSleep\nGetSystemTimeAsFileTime\nGetProcessHeap\nHeapAlloc\nHeapFree\nCreateProcessW\nOpenProcess\nTerminateProcess\nGetCurrentProcessId\nGetVersion\nSetConsoleCtrlHandler\nGetHandleInformation\nCreatePipe\nPeekNamedPipe\nGetNamedPipeInfo\nInitializeProcThreadAttributeList\npow\natan2\nfmod\nsqrt\ncos\nsin\ntan\nacos\nasin\natan\nlog\nlog10\nexp\nfloor\nceil\nfabs\ncosh\nsinh\ntanh\n_copysign\n_hypot\nfrexp\nldexp\nmodf\n_write\n_time64\ndifftime\n_localtime64\n_gmtime64\n_mktime64\nstrftime\nclock\nasctime\nctime\nstrtok\nstrrchr\nstrnlen\nstrpbrk\nmemcmp\ntoupper\nisalnum\nisxdigit\nisspace\nrand\nsrand\nabs\nislower\nisupper\niscntrl\nisgraph\nisprint\nispunct\nlabs\natof\nstrcoll\nstrxfrm\nstrncat\nstrncpy\nstrtod\ngetenv";
    整 iatr[128];
    fseek(f, df + 0x08, 0); 遍 (i = 0; i < 65; i = i + 1) w8(f, 0);
    fseek(f, df + 0x210, 0); 遍 (i = 0; i < 61; i = i + 1) w8(f, 0);
    fseek(f, df + 0x3F8, 0); 遍 (i = 0; i < 65; i = i + 1) w8(f, 0);
    fseek(f, df + 0x600, 0); 遍 (i = 0; i < 61; i = i + 1) w8(f, 0);
    fseek(f, df + 0x824, 0);
    字 *q = impall; 整 kk; 字 imb[128];
    遍 (kk = 0; kk < 124; kk = kk + 1) {
        整 nb = 0; 循环 (*q != 0 && *q != '\n' && nb < 127) { imb[nb] = *q; nb = nb + 1; q = q + 1; }
        imb[nb] = 0;
        若 (*q == '\n') q = q + 1;
        iatr[kk] = ftell(f) - df; w2(f, 0); fputs(imb, f); fputc(0, f);
    }
    整 kdll = ftell(f) - df; fputs("kernel32.dll", f); fputc(0, f);
    整 mdll = ftell(f) - df; fputs("msvcrt.dll", f); fputc(0, f); /* R599c-T10b: 名字表 先于 dll 名 (同 qcc) — 原 顺序反 ⟹ IAT RVA 差 0x18 */
    遍 (kk = 0; kk < 64; kk = kk + 1) { fseek(f, df + 0x08 + 8 * kk, 0); w8(f, dr + iatr[kk]); }
    遍 (kk = 0; kk < 60; kk = kk + 1) { fseek(f, df + 0x210 + 8 * kk, 0); w8(f, dr + iatr[64 + kk]); }
    遍 (kk = 0; kk < 64; kk = kk + 1) { fseek(f, df + 0x3F8 + 8 * kk, 0); w8(f, dr + iatr[kk]); }
    遍 (kk = 0; kk < 60; kk = kk + 1) { fseek(f, df + 0x600 + 8 * kk, 0); w8(f, dr + iatr[64 + kk]); }
    fseek(f, df + 0x7E8, 0);
    w4(f, dr + 0x3F8); w4(f, 0); w4(f, 0); w4(f, dr + kdll); w4(f, dr + 0x08);
    w4(f, dr + 0x600); w4(f, 0); w4(f, 0); w4(f, dr + mdll); w4(f, dr + 0x210);
    遍 (i = 0; i < 5; i = i + 1) w4(f, 0);
    fseek(f, 0, 2);
    pos = ftell(f); 整 drend = df + (exp_data_raw ? exp_data_raw : 0x4000); 循环 (pos < drend) { fputc(0, f); pos = pos + 1; } fseek(f, 0, 2);
}

/* ---- 解析辅助 ---- */
静 整 LF(常 字 *n) { 整 h = 0; 整 i = 0; 循环 (n[i] != 0) { h = h * 37 + n[i]; i = i + 1; } h = h & 1048575; 整 p = 0; 循环 (p < 1048576) { 整 v = lh[h]; 若 (v == 0) 返 -1; 若 (strcmp(labels[v - 1].name, n) == 0) 返 v - 1; h = h + 1; 若 (h >= 1048576) h = 0; p = p + 1; } 返 -1; } /* R599c-T10b: 原 线性 O(n²) → 哈希 O(1) */
静 空 SK(空) { 循环 (gp[0] == ' ' || gp[0] == '\t' || gp[0] == '\r') gp = gp + 1; } /* fix 2026-08-05：\r 当空白（Windows CRLF 手写文件） */
静 整 NUM(空) { 整 s = 1; 整 v = 0; SK(); 若 (gp[0] == '-') { s = -1; gp = gp + 1; } 若 (gp[0] == '0' && gp[1] == 'x') { gp = gp + 2; 循环 ((gp[0] >= '0' && gp[0] <= '9') || (gp[0] >= 'a' && gp[0] <= 'f') || (gp[0] >= 'A' && gp[0] <= 'F')) { 若 (gp[0] <= '9') v = v * 16 + (gp[0] - '0'); 否 若 (gp[0] >= 'a') v = v * 16 + (gp[0] - 'a' + 10); 否 v = v * 16 + (gp[0] - 'A' + 10); gp = gp + 1; } } 否 { 循环 (gp[0] >= '0' && gp[0] <= '9') { v = v * 10 + (gp[0] - '0'); gp = gp + 1; } } 返 s * v; } /* fix 2026-08-12: hex 大写 A-F (qcc %X 输出, .段 data_raw=0x3403D00) */
静 整 RG8(空) { SK(); 若 (strncmp(gp, "al", 2) == 0) { gp = gp + 2; 返 0; } 若 (strncmp(gp, "cl", 2) == 0) { gp = gp + 2; 返 1; } 若 (strncmp(gp, "dl", 2) == 0) { gp = gp + 2; 返 2; } 若 (strncmp(gp, "bl", 2) == 0) { gp = gp + 2; 返 3; } 返 -1; } /* R599b: 8 位 寄存器 名 (qcc 文本 用 al/cl) — 未命中 不 消费 */
静 整 RG16(空) { SK(); 若 (strncmp(gp, "ax", 2) == 0) { gp = gp + 2; 返 0; } 若 (strncmp(gp, "cx", 2) == 0) { gp = gp + 2; 返 1; } 若 (strncmp(gp, "dx", 2) == 0) { gp = gp + 2; 返 2; } 若 (strncmp(gp, "bx", 2) == 0) { gp = gp + 2; 返 3; } 若 (strncmp(gp, "sp", 2) == 0) { gp = gp + 2; 返 4; } 若 (strncmp(gp, "bp", 2) == 0) { gp = gp + 2; 返 5; } 若 (strncmp(gp, "si", 2) == 0) { gp = gp + 2; 返 6; } 若 (strncmp(gp, "di", 2) == 0) { gp = gp + 2; 返 7; } 返 -1; } /* R599c: 16 位 寄存器 名 */
静 整 RG(空) { 整 r = -1; SK(); 若 (gp[0] == '[') gp = gp + 1; 若 (gp[0] == 'r' && gp[1] >= '0' && gp[1] <= '9') { gp = gp + 1; r = 0; 循环 (gp[0] >= '0' && gp[0] <= '9') { r = r * 10 + (gp[0] - '0'); gp = gp + 1; } } 否 若 (strncmp(gp, "eax", 3) == 0) { r = 0; gp = gp + 3; } 否 若 (strncmp(gp, "ecx", 3) == 0) { r = 1; gp = gp + 3; } 否 若 (strncmp(gp, "edx", 3) == 0) { r = 2; gp = gp + 3; } 否 若 (strncmp(gp, "ebx", 3) == 0) { r = 3; gp = gp + 3; } 否 若 (strncmp(gp, "esp", 3) == 0) { r = 4; gp = gp + 3; } 否 若 (strncmp(gp, "ebp", 3) == 0) { r = 5; gp = gp + 3; } 否 若 (strncmp(gp, "esi", 3) == 0) { r = 6; gp = gp + 3; } 否 若 (strncmp(gp, "edi", 3) == 0) { r = 7; gp = gp + 3; } 否 若 (strncmp(gp, "rax", 3) == 0) { r = 0; gp = gp + 3; } 否 若 (strncmp(gp, "rcx", 3) == 0) { r = 1; gp = gp + 3; } 否 若 (strncmp(gp, "rdx", 3) == 0) { r = 2; gp = gp + 3; } 否 若 (strncmp(gp, "rbx", 3) == 0) { r = 3; gp = gp + 3; } 否 若 (strncmp(gp, "rsp", 3) == 0) { r = 4; gp = gp + 3; } 否 若 (strncmp(gp, "rbp", 3) == 0) { r = 5; gp = gp + 3; } 否 若 (strncmp(gp, "rsi", 3) == 0) { r = 6; gp = gp + 3; } 否 若 (strncmp(gp, "rdi", 3) == 0) { r = 7; gp = gp + 3; } 否 若 (strncmp(gp, "r8", 2) == 0) { r = 8; gp = gp + 2; } 否 若 (strncmp(gp, "r9", 2) == 0) { r = 9; gp = gp + 2; } 否 若 (strncmp(gp, "r10", 3) == 0) { r = 10; gp = gp + 3; } 否 若 (strncmp(gp, "r11", 3) == 0) { r = 11; gp = gp + 3; } 否 若 (strncmp(gp, "r12", 3) == 0) { r = 12; gp = gp + 3; } 否 若 (strncmp(gp, "r13", 3) == 0) { r = 13; gp = gp + 3; } 否 若 (strncmp(gp, "r14", 3) == 0) { r = 14; gp = gp + 3; } 否 若 (strncmp(gp, "r15", 3) == 0) { r = 15; gp = gp + 3; } 否 若 (strncmp(gp, "al", 2) == 0) { r = 0; gp = gp + 2; } 否 若 (strncmp(gp, "cl", 2) == 0) { r = 1; gp = gp + 2; } 否 若 (strncmp(gp, "dl", 2) == 0) { r = 2; gp = gp + 2; } 否 若 (strncmp(gp, "bl", 2) == 0) { r = 3; gp = gp + 2; } 返 r; } /* R599b: 补 8 位 寄存器 名 (al/cl) — 原 静默 返 -1 ⟹ 整条 指令 被 丢弃 */
静 空 MEM(空) { 整 d = 0; SK(); 若 (gp[0] == '[') { gp = gp + 1; SK(); RG(); SK(); 整 sign = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sign = -1; gp = gp + 1; } d = NUM() * sign; SK(); 若 (gp[0] == ']') gp = gp + 1; } mem_result = d; }
静 整 缩移 = 0; /* R599c-T10b: 优化链累积位移 — opt_zh 缩短代码后, qcc 写死的 [rip+N] 需整体平移 */
静 空 RIPS(空) { 整 d = 0; SK(); 若 (gp[0] == '[') { gp = gp + 1; SK(); 若 (strncmp(gp, "rip", 3) == 0) gp = gp + 3; SK(); 整 sign = 1; 若 (gp[0] == '+') gp = gp + 1; 否 若 (gp[0] == '-') { sign = -1; gp = gp + 1; } d = NUM() * sign; SK(); 若 (gp[0] == ']') gp = gp + 1; } mem_result = d; } /* R599c-T10b: 返回 qcc 写的**原始**位移 N; 由 b4r 登记后统一回填 */
静 整 LR(空) { 字 lnm[32]; 整 li = 0; SK(); 循环 (gp[0] != 0 && gp[0] != ' ' && gp[0] != '\t' && gp[0] != '\r' && gp[0] != '\n' && gp[0] != ',' && li < 31) { lnm[li] = gp[0]; li = li + 1; gp = gp + 1; } lnm[li] = 0; 整 li2 = LF(lnm); 若 (li2 < 0 && lnm[0] != 0 && ln < 600000) { strcpy(labels[ln].name, lnm); labels[ln].pos = 0; labels[ln].defined = 0; labels[ln].line = line_no; lhins(ln); li2 = ln; ln = ln + 1; } 返 li2; }

/* ---- 分派函数 1：整数/栈/控制 ---- */
静 整 dispatch1(字 *mn) {
    若 (strcmp(mn, "压栈") == 0) { 整 r = RG(); 若 (r >= 0) push_r(r); 返 1; }
    若 (strcmp(mn, "弹栈") == 0) { 整 r = RG(); 若 (r >= 0) pop_r(r); 返 1; }
    若 (strcmp(mn, "返回") == 0) { ret(); 返 1; }
    若 (strcmp(mn, "扩字") == 0) { rex(1,0,0,0); b(0x98); 返 1; } /* cdqe（fix 2026-08-05） */
    若 (strcmp(mn, "扩八字") == 0) { rex(1,0,0,0); b(0x99); 返 1; } /* cqo */
    若 (strcmp(mn, "串拷") == 0) { b(0xF3); b(0xA4); 返 1; } /* rep movsb */
若 (strcmp(mn, "串比") == 0) { b(0xA6); 返 1; } /* cmpsb（P1） */
若 (strcmp(mn, "串比双") == 0) { b(0xA7); 返 1; } /* cmpsd（P1） */
若 (strcmp(mn, "串扫") == 0) { b(0xAE); 返 1; } /* scasb（P1） */
若 (strcmp(mn, "串扫双") == 0) { b(0xAF); 返 1; } /* scasd（P1） */
若 (strcmp(mn, "串载") == 0) { b(0xAC); 返 1; } /* lodsb（P1） */
若 (strcmp(mn, "串载双") == 0) { b(0xAD); 返 1; } /* lodsd（P1） */
若 (strcmp(mn, "串存") == 0) { b(0xAA); 返 1; } /* stosb（P1） */
若 (strcmp(mn, "串存双") == 0) { b(0xAB); 返 1; } /* stosd（P1） */
若 (strcmp(mn, "串拷双") == 0) { b(0xF3); b(0xA5); 返 1; } /* rep movsd（P1） */
    若 (strcmp(mn, "交还") == 0) { SK(); 整 m = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 r = RG(); 若 (m >= 0 && r >= 0) { b(0x0F); b(0xB1); modrm(3, r & 7, m & 7); } 返 1; } /* cmpxchg r/m32,r32 */
    若 (strcmp(mn, "条移等") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x44); modrm(3, d & 7, s & 7); } 返 1; } /* cmove */
    若 (strcmp(mn, "条移不等") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x45); modrm(3, d & 7, s & 7); } 返 1; } /* cmovne */
    若 (strcmp(mn, "条移低") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x42); modrm(3, d & 7, s & 7); } 返 1; } /* cmovb */
    若 (strcmp(mn, "条移低等") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x46); modrm(3, d & 7, s & 7); } 返 1; } /* cmovbe */
    若 (strcmp(mn, "条移高") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x47); modrm(3, d & 7, s & 7); } 返 1; } /* cmova */
    若 (strcmp(mn, "条移高等") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x43); modrm(3, d & 7, s & 7); } 返 1; } /* cmovae */
    若 (strcmp(mn, "条移小") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x4C); modrm(3, d & 7, s & 7); } 返 1; } /* cmovl */
    若 (strcmp(mn, "条移小等") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x4E); modrm(3, d & 7, s & 7); } 返 1; } /* cmovle */
    若 (strcmp(mn, "条移大") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x4F); modrm(3, d & 7, s & 7); } 返 1; } /* cmovg */
    若 (strcmp(mn, "条移大等") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; SK(); 整 s = RG(); 若 (d >= 0 && s >= 0) { 若 (d >= 8 || s >= 8) rex(0, s & 8, 0, d & 8); b(0x0F); b(0x4D); modrm(3, d & 7, s & 7); } 返 1; } /* cmovge */
若 (strcmp(mn, "条移负") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0x48); modrm(3, d & 7, s & 7); } 返 1; } /* cmovs（P0） */
若 (strcmp(mn, "条移非负") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0x49); modrm(3, d & 7, s & 7); } 返 1; } /* cmovns（P0） */
若 (strcmp(mn, "条移溢") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0x40); modrm(3, d & 7, s & 7); } 返 1; } /* cmovo（P0） */
若 (strcmp(mn, "条移不溢") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0x41); modrm(3, d & 7, s & 7); } 返 1; } /* cmovno（P0） */
若 (strcmp(mn, "条移奇") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0x4A); modrm(3, d & 7, s & 7); } 返 1; } /* cmovp（P0） */
若 (strcmp(mn, "条移偶") == 0) { SK(); 整 d = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 s = RG(); 若 (d >= 0 && s >= 0) { rex(0, s & 8, 0, d & 8); b(0x0F); b(0x4B); modrm(3, d & 7, s & 7); } 返 1; } /* cmovnp（P0） */
    若 (strcmp(mn, "移动64") == 0) { SK(); 整 r = RG(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 lo = NUM(); SK(); 若 (gp[0] == ',') gp = gp + 1; 整 hi = NUM(); 若 (r >= 0) { b(0x48); b(0xB8); b4(lo); b4(hi); } 返 1; } /* mov rax,imm64（LL；fix 2026-08-05） */
